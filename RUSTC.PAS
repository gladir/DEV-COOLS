{ ---- discriminants d'enum ---- }

function VariantDisc(v: Integer): Int64;
var
  par, i, vv: Integer;
  nextV: Int64;
  env: TEnv;
  ok: Boolean;
  nd: Integer;
begin
  if Defs[v].discDone then begin Result := Defs[v].disc; Exit; end;
  par := Defs[v].parent;
  nextV := 0;
  for i := 0 to Length(Defs[par].variants) - 1 do
  begin
    vv := Defs[par].variants[i];
    nd := Defs[vv].node;
    if Nodes[nd].a <> 0 then
    begin
      InitEnv(env);
      env.scope := Defs[par].scopeMod;
      ok := True;
      nextV := ConstEvalExpr(Nodes[nd].a, env, ok);
    end;
    Defs[vv].disc := nextV;
    Defs[vv].discDone := True;
    Inc(nextV);
  end;
  Result := Defs[v].disc;
end;

{ ---- operandes de HIR ---- }

function IsPureHir(h: Integer): Boolean;
var
  i: Integer;
begin
  case Hirs[h].k of
    hLitInt, hLitFloat, hLitBool, hLitChar, hLitStr, hLitByteStr, hLocal, hUpvar, hStatic, hFnRef, hConstVal:
      Result := True;
    hField, hDeref, hAddr, hCast, hUnary, hCoerce: Result := IsPureHir(Hirs[h].a);
    hBinary, hIndex: Result := IsPureHir(Hirs[h].a) and IsPureHir(Hirs[h].b);
    hTuple, hArray, hAdt:
      begin
        Result := True;
        for i := 0 to Length(Hirs[h].l) - 1 do
          if not IsPureHir(Hirs[h].l[i]) then begin Result := False; Exit; end;
        if Hirs[h].k = hAdt then if Hirs[h].a <> 0 then Result := False;
      end;
  else
    Result := False;
  end;
end;

function HirPlace(h: Integer): TPlace; forward;

function HirPlaceOrTemp(h: Integer): TPlace;
var
  t: TPlace;
begin
  if IsPlaceHir(h) then Result := HirPlace(h)
  else
  begin
    t := NewTemp(Hirs[h].ty);
    ExprInto(h, t);
    Result := t;
  end;
end;

function UpvarPlace(idx: Integer; ty: Integer): TPlace;
var
  env: TPlace;
  cid: Integer;
  envTy, fieldTy: Integer;
begin
  cid := BClosure;
  envTy := MirFns[BI].locals[1].ty;
  env := PLocal(1, envTy);
  Result := PProj(env, peDeref, 0, Tys[Shallow(envTy)].args[0]);
  if Closures[cid].isMove then
    Result := PProj(Result, peField, idx, ty)
  else
  begin
    Result := PProj(Result, peField, idx, MkRef(ty, True));
    Result := PProj(Result, peDeref, 0, ty);
  end;
end;

procedure PanicBoundsTerm(const idx, len: TOperand; h: Integer);
var
  t: TTerm;
  nb: Integer;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmAssertBounds;
  t.idx := idx;
  t.len := len;
  t.loc := LocName(Hirs[h].fi) + ':' + IntToStr(Hirs[h].line) + ':' + IntToStr(Hirs[h].col);
  nb := NewBB;
  t.target := nb;
  SetTerm(t);
  CurBB := nb;
end;

function HirPlace(h: Integer): TPlace;
var
  base, t: TPlace;
  ty, bty, idxT, lenT: Integer;
  idxOp, lenOp: TOperand;
  rv: TRvalue;
  il: TPlace;
begin
  ty := Hirs[h].ty;
  case Hirs[h].k of
    hLocal: Result := PLocal(VarLoc[Hirs[h].n], ty);
    hUpvar: Result := UpvarPlace(Hirs[h].n, ty);
    hStatic:
      begin
        Result := PLocal(0, ty);
        Result.glob := Hirs[h].def;
        RequestStatic(Hirs[h].def);
      end;
    hField:
      begin
        base := HirPlaceOrTemp(Hirs[h].a);
        Result := PProj(base, peField, Integer(Hirs[h].n), ty);
      end;
    hDeref:
      begin
        base := HirPlaceOrTemp(Hirs[h].a);
        Result := PProj(base, peDeref, 0, ty);
      end;
    hIndex:
      begin
        base := HirPlaceOrTemp(Hirs[h].a);
        idxOp := ExprOp(Hirs[h].b);
        { copie de l'indice dans un temporaire }
        il := NewTemp(TyUsize);
        AssignOp(il, idxOp);
        bty := Shallow(Hirs[Hirs[h].a].ty);
        if Tys[bty].k = tyArray then
          lenOp := OInt(TyUsize, Tys[Shallow(Tys[bty].args[1])].n)
        else
        begin
          t := NewTemp(TyUsize);
          rv := MkRv(rvLen, TyUsize);
          rv.place := base;
          EmitAssign(t, rv);
          lenOp := OCopyPlace(t);
        end;
        PanicBoundsTerm(OCopyPlace(il), lenOp, h);
        Result := PProj(base, peIndex, il.local, ty);
      end;
  else
    t := NewTemp(ty);
    ExprInto(h, t);
    Result := t;
  end;
end;

