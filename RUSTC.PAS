function NodeDesc(k: Integer): string;
begin
  case k of
    nFn: Result := 'Fn|ret|body|||generics|params|';
    nStruct: Result := 'Struct||||||fields|';
    nEnum: Result := 'Enum||||||variants|';
    nVariant: Result := 'Variant|discr|||||fields|';
    nImpl: Result := 'Impl|self|trait|||generics|items|';
    nTrait: Result := 'Trait||||generics|items|supertraits';
    nMod: Result := 'Mod||||||items|';
    nUse: Result := 'Use|';
    nConst: Result := 'Const|type|value|';
    nStatic: Result := 'Static|type|value|';
    nTypeAlias: Result := 'TypeAlias|type|||generics||bounds';
    nExternBlock: Result := 'ExternBlock||||||items|';
    nField: Result := 'Field|type|';
    nParam: Result := 'Param|pat|type|';
    nSelfParam: Result := 'SelfParam|type|';
    nGenParam: Result := 'GenericParam|default|type||bounds|';
    nWhere: Result := 'Where|type|||bounds|';
    nSeg: Result := 'Segment|ret|||args|bindings|';
    nAssocBind: Result := 'AssocBinding|type|';
    nConstArg: Result := 'ConstArg|expr|';
    nArm: Result := 'Arm|pat|guard|body|';
    nFieldInit: Result := 'FieldInit|expr|';
    tPath: Result := 'TyPath|qself|qtrait||segments|';
    tRef: Result := 'TyRef|inner|';
    tPtr: Result := 'TyPtr|inner|';
    tTuple: Result := 'TyTuple|||||elems|';
    tArray: Result := 'TyArray|elem|len|';
    tSlice: Result := 'TySlice|elem|';
    tFnPtr: Result := 'TyFnPtr|ret|||params|';
    tNever: Result := 'TyNever|';
    tInfer: Result := 'TyInfer|';
    tDyn: Result := 'TyDyn||||bounds|';
    tImplTrait: Result := 'TyImpl||||bounds|';
    pWild: Result := 'PatWild|';
    pIdent: Result := 'PatIdent|sub|';
    pLit: Result := 'PatLit|expr|';
    pRange: Result := 'PatRange|lo|hi|';
    pTuple: Result := 'PatTuple|||||elems|';
    pPath: Result := 'PatPath|path|';
    pTupleStruct: Result := 'PatTupleStruct|path|||elems|';
    pStruct: Result := 'PatStruct|path|||fields|';
    pRef: Result := 'PatRef|inner|';
    pOr: Result := 'PatOr||||alts|';
    pSlice: Result := 'PatSlice||||elems|';
    pRest: Result := 'PatRest|';
    pField: Result := 'PatField|pat|';
    eLit: Result := 'Lit|';
    ePath: Result := 'Path|path|';
    eUnary: Result := 'Unary|operand|';
    eBinary: Result := 'Binary|lhs|rhs|';
    eAssign: Result := 'Assign|lhs|rhs|';
    eAssignOp: Result := 'AssignOp|lhs|rhs|';
    eCall: Result := 'Call|callee|||args|';
    eMethod: Result := 'MethodCall|receiver|||args|turbofish|';
    eField: Result := 'Field|base|';
    eTupleField: Result := 'TupleField|base|';
    eIndex: Result := 'Index|base|index|';
    eCast: Result := 'Cast|expr|type|';
    eIf: Result := 'If|cond|then|else|';
    eLet: Result := 'Let|pat|expr|';
    eWhile: Result := 'While|cond|body|';
    eLoop: Result := 'Loop||body|';
    eFor: Result := 'For|pat|iter|body|';
    eMatch: Result := 'Match|scrutinee|||arms|';
    eBlock: Result := 'Block|tail|||stmts|';
    eReturn: Result := 'Return|value|';
    eBreak: Result := 'Break|value|';
    eContinue: Result := 'Continue|';
    eRange: Result := 'Range|lo|hi|';
    eTuple: Result := 'Tuple|||||elems|';
    eArray: Result := 'Array|||||elems|';
    eRepeat: Result := 'Repeat|elem|count|';
    eStruct: Result := 'StructLit|path|base||fields|';
    eClosure: Result := 'Closure|ret|body|||params|';
    eMacro: Result := 'MacroCall|a|b|c|args|';
    eTry: Result := 'Try|expr|';
    eParen: Result := 'Paren|expr|';
    eDeref: Result := 'Deref|expr|';
    eRef: Result := 'AddrOf|expr|';
    eNamedArg: Result := 'NamedArg|expr|';
    eUnderscore: Result := 'Underscore|';
    sLet: Result := 'Let|pat|type|init|else|';
    sExpr: Result := 'ExprStmt|expr|';
    sItem: Result := 'ItemStmt|item|';
  else
    Result := 'Node' + IntToStr(k) + '|';
  end;
end;

function DescField(const d: string; idx: Integer): string;
var
  i, k: Integer;
begin
  { champ numero idx (0 = nom) separe par | }
  k := 0;
  Result := '';
  for i := 1 to Length(d) do
  begin
    if d[i] = '|' then
    begin
      if k = idx then Exit;
      Inc(k);
      Result := '';
    end
    else Result := Result + d[i];
  end;
  if k <> idx then Result := '';
end;

procedure DumpNode(var b: TBuf; n, ind: Integer; const lbl: string);
var
  d, nm, extra: string;
  i: Integer;
  procedure Sub(c: Integer; const l: string);
  begin
    if c <> 0 then DumpNode(b, c, ind + 1, l);
  end;
  procedure SubL(const lst: TIntArr; const l: string);
  var
    j: Integer;
  begin
    for j := 0 to Length(lst) - 1 do
      if lst[j] <> 0 then DumpNode(b, lst[j], ind + 1, l);
  end;
begin
  if n = 0 then Exit;
  d := NodeDesc(Nodes[n].k);
  nm := DescField(d, 0);
  extra := '';
  with Nodes[n] do
  begin
    if s <> '' then extra := extra + ' ' + s;
    case k of
      eLit:
        case f of
          lkInt: extra := ' ' + UIntToStr(iv) + s2;
          lkFloat: extra := ' ' + s + s2;
          lkStr: extra := ' "' + s + '"';
          lkChar: extra := ' char(' + UIntToStr(iv) + ')';
          lkBool: if iv <> 0 then extra := ' true' else extra := ' false';
          lkByte: extra := ' b' + UIntToStr(iv);
          lkByteStr: extra := ' b"' + s + '"';
        end;
      eTupleField: extra := ' ' + UIntToStr(iv);
      eRef: if (f and 1) <> 0 then extra := extra + ' mut';
      pIdent: begin if (f and 1) <> 0 then extra := ' ref' + extra; if (f and 2) <> 0 then extra := ' mut' + extra; end;
      tRef, tPtr, pRef: if (f and 1) <> 0 then extra := extra + ' mut';
      nFn: begin if (f and fPub) <> 0 then extra := extra + ' pub'; if (f and fUnsafe) <> 0 then extra := extra + ' unsafe'; end;
      nSelfParam: begin if (f and 1) <> 0 then extra := extra + ' &'; if (f and 2) <> 0 then extra := extra + ' mut'; end;
      eClosure: if (f and 1) <> 0 then extra := extra + ' move';
      nUse: begin extra := ' ' + s; if s2 <> '' then extra := extra + ' as ' + s2; if (f and fGlob) <> 0 then extra := extra + '::*'; end;
    end;
    if (k = nStruct) or (k = nEnum) or (k = nImpl) or (k = nTrait) then
      if at <> '' then extra := extra + ' #[' + at + ']';
  end;
  BufAdd(b, Spaces(ind * 2));
  if lbl <> '' then BufAdd(b, lbl + ': ');
  BufLn(b, nm + extra + '  @' + IntToStr(Nodes[n].line) + ':' + IntToStr(Nodes[n].col));
  Sub(Nodes[n].a, DescField(d, 1));
  Sub(Nodes[n].b, DescField(d, 2));
  Sub(Nodes[n].c, DescField(d, 3));
  Sub(Nodes[n].d, DescField(d, 4));
  SubL(Nodes[n].l, DescField(d, 5));
  SubL(Nodes[n].l2, DescField(d, 6));
  SubL(Nodes[n].l3, DescField(d, 7));
end;

{ ============================================================ }
{ TABLE DE HACHAGE chaine -> entier                            }
{ ============================================================ }

Type
  THashSI = record
    keys: TStrArr;
    vals: TIntArr;
    used: array of Boolean;
    cap, cnt: Integer;
  end;

function HashStr(const s: string): Cardinal;
var
  i: Integer;
  h: Cardinal;
begin
  h := 2166136261;
  for i := 1 to Length(s) do
    h := (h xor Ord(s[i])) * 16777619;
  Result := h;
end;

procedure HInit(var h: THashSI);
begin
  h.cap := 0;
  h.cnt := 0;
  h.keys := nil;
  h.vals := nil;
  h.used := nil;
end;

procedure HGrow(var h: THashSI); forward;

function HFind(var h: THashSI; const k: string): Integer;
var
  i: Cardinal;
begin
  Result := -1;
  if h.cap = 0 then Exit;
  i := HashStr(k) and (h.cap - 1);
  while h.used[i] do
  begin
    if h.keys[i] = k then begin Result := h.vals[i]; Exit; end;
    i := (i + 1) and (h.cap - 1);
  end;
end;

procedure HPut(var h: THashSI; const k: string; v: Integer);
var
  i: Cardinal;
begin
  if (h.cap = 0) or (h.cnt * 2 >= h.cap) then HGrow(h);
  i := HashStr(k) and (h.cap - 1);
  while h.used[i] do
  begin
    if h.keys[i] = k then begin h.vals[i] := v; Exit; end;
    i := (i + 1) and (h.cap - 1);
  end;
  h.used[i] := True;
  h.keys[i] := k;
  h.vals[i] := v;
  Inc(h.cnt);
end;

procedure HGrow(var h: THashSI);
var
  old: THashSI;
  i: Integer;
  nc: Integer;
begin
  old := h;
  if h.cap = 0 then nc := 64 else nc := h.cap * 2;
  h.cap := nc;
  h.cnt := 0;
  h.keys := nil;
  h.vals := nil;
  h.used := nil;
  SetLength(h.keys, nc);
  SetLength(h.vals, nc);
  SetLength(h.used, nc);
  for i := 0 to old.cap - 1 do
    if old.used[i] then HPut(h, old.keys[i], old.vals[i]);
end;

{ ============================================================ }
{ TYPES SEMANTIQUES (internes) ET UNIFICATION                  }
{ ============================================================ }

Const
  tyErr = 0;
  tyBool = 1;
  tyChar = 2;
  tyInt = 3;        { n = bits, f bit0 = signe, bit1 = taille pointeur }
  tyFloat = 4;      { n = bits }
  tyStr = 5;
  tyNever = 6;
  tyTuple = 7;      { args }
  tyArray = 8;      { args[0]=element, args[1]=longueur (tyConst ou variable) }
  tySlice = 9;      { args[0] }
  tyRef = 10;       { f=1 mut ; args[0] }
  tyPtr = 11;       { f=1 mut ; args[0] }
  tyAdt = 12;       { def, args }
  tyFnPtr = 13;     { args = parametres + retour }
  tyFnDef = 14;     { def, args = arguments de types }
  tyClosure = 15;   { def = indice de fermeture }
  tyVar = 16;       { n = indice de variable }
  tyDyn = 17;       { def = trait, args = arguments du trait (sans Self) }
  tyConst = 18;     { n = valeur }
  tyOpaque = 19;    { type "impl Trait" retourne : def = indice }

Type
  TTy = record
    k: Integer;
    n: Int64;
    f: Integer;
    def: Integer;
    args: TIntArr;
  end;

Var
  Tys: array of TTy;
  NTys: Integer;
  TyMap: THashSI;
  VarBind: TIntArr;
  VarKind: TIntArr;     { 0 general, 1 entier, 2 flottant }
  VarTy: TIntArr;       { type interne representant la variable }
  NVars: Integer;
  Trail: TIntArr;
  NTrail: Integer;

  TyUnit, TyBoolT, TyCharT, TyStrT, TyNeverT, TyI8, TyI16, TyI32, TyI64, TyI128, TyIsize, TyU8, TyU16, TyU32,
  TyU64, TyU128, TyUsize, TyF32, TyF64, TyErrT, TyStrRef: Integer;

function TyKey(const t: TTy): string;
var
  i: Integer;
begin
  Result := IntToStr(t.k) + ':' + IntToStr(t.n) + ':' + IntToStr(t.f) + ':' + IntToStr(t.def);
  for i := 0 to Length(t.args) - 1 do
    Result := Result + ',' + IntToStr(t.args[i]);
end;

function InternTy(const t: TTy): Integer;
var
  key: string;
begin
  key := TyKey(t);
  Result := HFind(TyMap, key);
  if Result >= 0 then Exit;
  if NTys >= Length(Tys) then SetLength(Tys, Length(Tys) * 2 + 256);
  Result := NTys;
  Inc(NTys);
  Tys[Result] := t;
  HPut(TyMap, key, Result);
end;

function MkTy0(k: Integer; n: Int64; f: Integer; def: Integer): Integer;
var
  t: TTy;
begin
  t.k := k; t.n := n; t.f := f; t.def := def; t.args := nil;
  Result := InternTy(t);
end;

function MkTyArgs(k: Integer; n: Int64; f: Integer; def: Integer; const args: TIntArr): Integer;
var
  t: TTy;
begin
  t.k := k; t.n := n; t.f := f; t.def := def; t.args := ICopy(args);
  Result := InternTy(t);
end;

function MkInt(bits: Integer; signed, ptrsz: Boolean): Integer;
var
  f: Integer;
begin
  f := 0;
  if signed then f := 1;
  if ptrsz then f := f or 2;
  Result := MkTy0(tyInt, bits, f, 0);
end;

function MkRef(t: Integer; mut: Boolean): Integer;
var
  a: TIntArr;
  f: Integer;
begin
  SetLength(a, 1);
  a[0] := t;
  if mut then f := 1 else f := 0;
  Result := MkTyArgs(tyRef, 0, f, 0, a);
end;

function MkPtr(t: Integer; mut: Boolean): Integer;
var
  a: TIntArr;
  f: Integer;
begin
  SetLength(a, 1);
  a[0] := t;
  if mut then f := 1 else f := 0;
  Result := MkTyArgs(tyPtr, 0, f, 0, a);
end;

function MkSlice(t: Integer): Integer;
var
  a: TIntArr;
begin
  SetLength(a, 1);
  a[0] := t;
  Result := MkTyArgs(tySlice, 0, 0, 0, a);
end;

function MkConstTy(v: Int64): Integer;
begin
  Result := MkTy0(tyConst, v, 0, 0);
end;

function MkArray(t, len: Integer): Integer;
var
  a: TIntArr;
begin
  SetLength(a, 2);
  a[0] := t;
  a[1] := len;
  Result := MkTyArgs(tyArray, 0, 0, 0, a);
end;

function MkTuple(const args: TIntArr): Integer;
begin
  Result := MkTyArgs(tyTuple, 0, 0, 0, args);
end;

function MkAdt(def: Integer; const args: TIntArr): Integer;
begin
  Result := MkTyArgs(tyAdt, 0, 0, def, args);
end;

function MkFnPtr(const params: TIntArr; ret: Integer): Integer;
var
  a: TIntArr;
  i: Integer;
begin
  SetLength(a, Length(params) + 1);
  for i := 0 to Length(params) - 1 do a[i] := params[i];
  a[Length(params)] := ret;
  Result := MkTyArgs(tyFnPtr, 0, 0, 0, a);
end;

function MkFnDef(def: Integer; const args: TIntArr): Integer;
begin
  Result := MkTyArgs(tyFnDef, 0, 0, def, args);
end;

function MkClosureTy(id: Integer): Integer;
begin
  Result := MkTy0(tyClosure, 0, 0, id);
end;

function MkDyn(trait: Integer; const args: TIntArr): Integer;
begin
  Result := MkTyArgs(tyDyn, 0, 0, trait, args);
end;

function MkOpaque(id: Integer): Integer;
begin
  Result := MkTy0(tyOpaque, 0, 0, id);
end;

function NewTyVar(kind: Integer): Integer;
begin
  if NVars >= Length(VarBind) then
  begin
    SetLength(VarBind, NVars * 2 + 256);
    SetLength(VarKind, NVars * 2 + 256);
    SetLength(VarTy, NVars * 2 + 256);
  end;
  VarBind[NVars] := 0;
  VarKind[NVars] := kind;
  VarTy[NVars] := MkTy0(tyVar, NVars, 0, 0);
  Result := VarTy[NVars];
  Inc(NVars);
end;

procedure InitTypes;
begin
  NTys := 0;
  NVars := 0;
  NTrail := 0;
  HInit(TyMap);
  SetLength(Tys, 1024);
  TyErrT := MkTy0(tyErr, 0, 0, 0);
  TyBoolT := MkTy0(tyBool, 0, 0, 0);
  TyCharT := MkTy0(tyChar, 0, 0, 0);
  TyStrT := MkTy0(tyStr, 0, 0, 0);
  TyNeverT := MkTy0(tyNever, 0, 0, 0);
  TyUnit := MkTuple(nil);
  TyI8 := MkInt(8, True, False);
  TyI16 := MkInt(16, True, False);
  TyI32 := MkInt(32, True, False);
  TyI64 := MkInt(64, True, False);
  TyI128 := MkInt(128, True, False);
  TyIsize := MkInt(64, True, True);
  TyU8 := MkInt(8, False, False);
  TyU16 := MkInt(16, False, False);
  TyU32 := MkInt(32, False, False);
  TyU64 := MkInt(64, False, False);
  TyU128 := MkInt(128, False, False);
  TyUsize := MkInt(64, False, True);
  TyF32 := MkTy0(tyFloat, 32, 0, 0);
  TyF64 := MkTy0(tyFloat, 64, 0, 0);
  TyStrRef := MkRef(TyStrT, False);
end;

{ ---- resolution ---- }

function Shallow(t: Integer): Integer;
begin
  while (Tys[t].k = tyVar) and (VarBind[Tys[t].n] <> 0) do
    t := VarBind[Tys[t].n];
  Result := t;
end;

function IsIntTy(t: Integer): Boolean;
begin
  Result := Tys[t].k = tyInt;
end;

function IsSigned(t: Integer): Boolean;
begin
  Result := (Tys[t].k = tyInt) and ((Tys[t].f and 1) <> 0);
end;

function IsIntVar(t: Integer): Boolean;
begin
  Result := (Tys[t].k = tyVar) and (VarKind[Tys[t].n] = 1);
end;

function IsFloatVar(t: Integer): Boolean;
begin
  Result := (Tys[t].k = tyVar) and (VarKind[Tys[t].n] = 2);
end;

function IsUnboundVar(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := Tys[t].k = tyVar;
end;

function Snapshot: Integer;
begin
  Result := NTrail;
end;

procedure Rollback(s: Integer);
begin
  while NTrail > s do
  begin
    Dec(NTrail);
    VarBind[Trail[NTrail]] := 0;
  end;
end;

procedure BindVar(v: Integer; t: Integer);
begin
  VarBind[v] := t;
  if NTrail >= Length(Trail) then SetLength(Trail, NTrail * 2 + 256);
  Trail[NTrail] := v;
  Inc(NTrail);
end;

function OccursIn(v: Integer; t: Integer): Boolean;
var
  i: Integer;
begin
  t := Shallow(t);
  if Tys[t].k = tyVar then begin Result := Tys[t].n = v; Exit; end;
  Result := False;
  for i := 0 to Length(Tys[t].args) - 1 do
    if OccursIn(v, Tys[t].args[i]) then begin Result := True; Exit; end;
end;

function Unify(a, b: Integer): Boolean;
var
  i, va, vb: Integer;
begin
  a := Shallow(a);
  b := Shallow(b);
  if a = b then begin Result := True; Exit; end;
  Result := False;
  if (Tys[a].k = tyErr) or (Tys[b].k = tyErr) then begin Result := True; Exit; end;
  if Tys[a].k = tyVar then
  begin
    va := Tys[a].n;
    if Tys[b].k = tyVar then
    begin
      vb := Tys[b].n;
      { fusion : la variable generale se lie a la variable typee }
      if VarKind[va] = 0 then BindVar(va, b)
      else if VarKind[vb] = 0 then BindVar(vb, a)
      else if VarKind[va] = VarKind[vb] then BindVar(va, b)
      else Exit;
      Result := True;
      Exit;
    end;
    if VarKind[va] = 1 then
    begin
      if Tys[b].k <> tyInt then Exit;
    end
    else if VarKind[va] = 2 then
    begin
      if Tys[b].k <> tyFloat then Exit;
    end
    else if OccursIn(va, b) then Exit;
    BindVar(va, b);
    Result := True;
    Exit;
  end;
  if Tys[b].k = tyVar then
  begin
    Result := Unify(b, a);
    Exit;
  end;
  if (Tys[a].k <> Tys[b].k) or (Tys[a].n <> Tys[b].n) or (Tys[a].f <> Tys[b].f) or (Tys[a].def <> Tys[b].def) or
     (Length(Tys[a].args) <> Length(Tys[b].args)) then Exit;
  for i := 0 to Length(Tys[a].args) - 1 do
    if not Unify(Tys[a].args[i], Tys[b].args[i]) then Exit;
  Result := True;
end;

{ Unification dans un essai : annule les liaisons en cas d'echec }
function TryUnify(a, b: Integer): Boolean;
var
  s: Integer;
begin
  s := Snapshot;
  Result := Unify(a, b);
  if not Result then Rollback(s);
end;

{ Remplace toutes les variables liees par leur valeur }
function Zonk(t: Integer): Integer;
var
  tt: TTy;
  i: Integer;
  changed: Boolean;
begin
  t := Shallow(t);
  if Length(Tys[t].args) = 0 then begin Result := t; Exit; end;
  tt := Tys[t];
  tt.args := ICopy(tt.args);
  changed := False;
  for i := 0 to Length(tt.args) - 1 do
  begin
    tt.args[i] := Zonk(tt.args[i]);
    if tt.args[i] <> Tys[t].args[i] then changed := True;
  end;
  if changed then Result := InternTy(tt) else Result := t;
end;

function HasVars(t: Integer): Boolean;
var
  i: Integer;
begin
  t := Shallow(t);
  if Tys[t].k = tyVar then begin Result := True; Exit; end;
  Result := False;
  for i := 0 to Length(Tys[t].args) - 1 do
    if HasVars(Tys[t].args[i]) then begin Result := True; Exit; end;
end;

{ Remplace les variables d'entiers / flottants restantes par i32 / f64 }
function DefaultVars(t: Integer): Integer;
var
  tt: TTy;
  i: Integer;
  changed: Boolean;
begin
  t := Shallow(t);
  if Tys[t].k = tyVar then
  begin
    if VarKind[Tys[t].n] = 1 then begin Result := TyI32; Exit; end;
    if VarKind[Tys[t].n] = 2 then begin Result := TyF64; Exit; end;
    Result := t;
    Exit;
  end;
  if Length(Tys[t].args) = 0 then begin Result := t; Exit; end;
  tt := Tys[t];
  tt.args := ICopy(tt.args);
  changed := False;
  for i := 0 to Length(tt.args) - 1 do
  begin
    tt.args[i] := DefaultVars(tt.args[i]);
    if tt.args[i] <> Tys[t].args[i] then changed := True;
  end;
  if changed then Result := InternTy(tt) else Result := t;
end;

{ ============================================================ }
{ DEFINITIONS (items), MODULES ET RESOLUTION DE NOMS           }
{ ============================================================ }

Const
  dkMod = 1;
  dkStruct = 2;
  dkEnum = 3;
  dkVariant = 4;
  dkFn = 5;
  dkConst = 6;
  dkStatic = 7;
  dkTrait = 8;
  dkImpl = 9;
  dkTypeAlias = 10;

Type
  TDef = record
    kind: Integer;
    name: string;
    node: Integer;
    parent: Integer;
    crate: Integer;
    fi: Integer;
    pub: Boolean;
    isBlock: Boolean;
    gnames: TStrArr;
    gkinds: TIntArr;
    gnodes: TIntArr;
    nOwn: Integer;
    variants: TIntArr;
    vindex: Integer;
    disc: Int64;
    discDone: Boolean;
    globs: TIntArr;
    items: TIntArr;
    selfKind: Integer;       { fn : 0 aucun, 1 self, 2 &self, 3 &mut self, 4 self: Type }
    hasBody: Boolean;
    implTrait: Integer;      { impl : trait implemente (-1 aucun) }
    traitArgsNode: Integer;
    headKey: string;
    implDone: Boolean;
    scopeMod: Integer;       { module (ou bloc) de resolution de noms de l'item }
    isCtor: Boolean;
    trackCaller: Boolean;
    fieldCount: Integer;
    isExtern: Boolean;
    lang: string;
    impls: TIntArr;
  end;

  TImport = record
    mod_: Integer;
    path: string;
    alias: string;
    glob: Boolean;
    pub: Boolean;
    done: Boolean;
    node: Integer;
  end;

Var
  Defs: array of TDef;
  NDefs: Integer;
  ScopeMap: THashSI;
  Imports: array of TImport;
  NImports: Integer;
  StdRoot, UserRoot, PreludeMod: Integer;
  AllImpls: TIntArr;
  AllTraits: TIntArr;
  CurCrate: Integer;

function NewDef(kind: Integer; const name: string; node, parent: Integer): Integer;
begin
  if NDefs >= Length(Defs) then SetLength(Defs, NDefs * 2 + 256);
  Result := NDefs;
  Inc(NDefs);
  Defs[Result].kind := kind;
  Defs[Result].name := name;
  Defs[Result].node := node;
  Defs[Result].parent := parent;
  Defs[Result].crate := CurCrate;
  Defs[Result].implTrait := -1;
  Defs[Result].scopeMod := parent;
  if node > 0 then
  begin
    Defs[Result].fi := Nodes[node].fi;
    Defs[Result].pub := (Nodes[node].f and fPub) <> 0;
  end;
end;

function ScopeKey(m: Integer; ns: Char; const name: string): string;
begin
  Result := IntToStr(m) + ns + name;
end;

procedure DefSpanErr(code, msg: string; node: Integer; const lbl: string);
begin
  Report(True, code, msg, Nodes[node].fi, Nodes[node].line, Nodes[node].col, NodeLen(node), lbl);
end;

procedure AddMember(m: Integer; ns: Char; const name: string; d: Integer);
var
  old: Integer;
  kindName: string;
begin
  if name = '' then Exit;
  old := HFind(ScopeMap, ScopeKey(m, ns, name));
  if (old >= 0) and (old <> d) then
  begin
    if Defs[d].node > 0 then
    begin
      case Defs[d].kind of
        dkFn: kindName := 'value';
        dkConst, dkStatic: kindName := 'value';
      else
        kindName := 'type';
      end;
      Report(True, 'E0428', 'the name `' + name + '` is defined multiple times', Defs[d].fi, Nodes[Defs[d].node].line,
             Nodes[Defs[d].node].col, Length(name), '`' + name + '` redefined here');
      Note('`' + name + '` must be defined only once in the ' + kindName + ' namespace of this module');
    end;
    Exit;
  end;
  HPut(ScopeMap, ScopeKey(m, ns, name), d);
end;

{ Cherche un nom dans un module, y compris les imports glob }
function ScopeLookup(m: Integer; ns: Char; const name: string; depth: Integer): Integer;
var
  i, r: Integer;
begin
  Result := HFind(ScopeMap, ScopeKey(m, ns, name));
  if Result >= 0 then Exit;
  if depth > 8 then Exit;
  for i := 0 to Length(Defs[m].globs) - 1 do
  begin
    r := ScopeLookup(Defs[m].globs[i], ns, name, depth + 1);
    if r >= 0 then begin Result := r; Exit; end;
  end;
end;

function CrateRoot(d: Integer): Integer;
begin
  if Defs[d].crate = 1 then Result := StdRoot else Result := UserRoot;
end;

{ Module non-bloc le plus proche }
function NearestMod(m: Integer): Integer;
begin
  while Defs[m].isBlock do m := Defs[m].parent;
  Result := m;
end;

{ Recherche lexicale du premier segment d'un chemin }
function LookupLexical(scope: Integer; ns: Char; const name: string): Integer;
var
  m: Integer;
begin
  Result := -1;
  m := scope;
  while True do
  begin
    Result := ScopeLookup(m, ns, name, 0);
    if Result >= 0 then Exit;
    if Defs[m].isBlock then m := Defs[m].parent else Break;
  end;
  if (PreludeMod > 0) then Result := ScopeLookup(PreludeMod, ns, name, 0);
end;

{ ---- generiques ---- }

function IsLifetimeParam(g: Integer): Boolean;
begin
  Result := Nodes[g].f = 1;
end;

procedure AddGeneric(d: Integer; const name: string; kind, gnode: Integer);
var
  n: Integer;
begin
  n := Length(Defs[d].gnames);
  SetLength(Defs[d].gnames, n + 1);
  SetLength(Defs[d].gkinds, n + 1);
  SetLength(Defs[d].gnodes, n + 1);
  Defs[d].gnames[n] := name;
  Defs[d].gkinds[n] := kind;
  Defs[d].gnodes[n] := gnode;
end;

procedure ScanImplTraitParams(d, t: Integer);
var
  i: Integer;
begin
  if t = 0 then Exit;
  case Nodes[t].k of
    tImplTrait:
      begin
        Nodes[t].id := Length(Defs[d].gnames);
        AddGeneric(d, 'impl#' + IntToStr(Length(Defs[d].gnames)), 0, t);
        Inc(Defs[d].nOwn);
      end;
    tRef, tPtr, tSlice, tArray: ScanImplTraitParams(d, Nodes[t].a);
    tTuple: for i := 0 to Length(Nodes[t].l) - 1 do ScanImplTraitParams(d, Nodes[t].l[i]);
    tPath:
      for i := 0 to Length(Nodes[t].l) - 1 do
        if Length(Nodes[Nodes[t].l[i]].l) > 0 then
          ScanImplTraitParams(d, Nodes[Nodes[t].l[i]].l[0]);
  end;
end;

procedure GatherGenerics(d, parent, node: Integer);
var
  i, g: Integer;
begin
  { generiques herites du parent (impl / trait) }
  if parent >= 0 then
  begin
    for i := 0 to Length(Defs[parent].gnames) - 1 do
      AddGeneric(d, Defs[parent].gnames[i], Defs[parent].gkinds[i], Defs[parent].gnodes[i]);
  end;
  Defs[d].nOwn := 0;
  if node > 0 then
    for i := 0 to Length(Nodes[node].l) - 1 do
    begin
      g := Nodes[node].l[i];
      if Nodes[g].k = nGenParam then
      begin
        if Nodes[g].f = 1 then Continue;
        AddGeneric(d, Nodes[g].s, Nodes[g].f, g);
        Inc(Defs[d].nOwn);
      end;
    end;
end;

{ ---- collecte ---- }

procedure CollectItems(scope: Integer; const items: TIntArr); forward;
procedure CollectBody(scope: Integer; n: Integer); forward;

procedure CollectBodyList(scope: Integer; const l: TIntArr);
var
  i: Integer;
begin
  for i := 0 to Length(l) - 1 do CollectBody(scope, l[i]);
end;

{ Parcourt une expression / un bloc pour trouver les items declares dans des blocs }
procedure CollectBody(scope: Integer; n: Integer);
var
  i, m, st: Integer;
  items: TIntArr;
  hasItems: Boolean;
begin
  if n = 0 then Exit;
  case Nodes[n].k of
    eBlock:
      begin
        items := nil;
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          st := Nodes[n].l[i];
          if Nodes[st].k = sItem then IAdd(items, Nodes[st].a);
        end;
        m := scope;
        if Length(items) > 0 then
        begin
          m := NewDef(dkMod, '{block}', 0, scope);
          Defs[m].isBlock := True;
          Defs[m].fi := Nodes[n].fi;
          Nodes[n].id := m;
          CollectItems(m, items);
        end;
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          st := Nodes[n].l[i];
          if Nodes[st].k <> sItem then CollectBody(m, st);
        end;
        CollectBody(m, Nodes[n].a);
      end;
    nFn, nStruct, nEnum, nImpl, nTrait, nMod, nUse, nConst, nStatic, nTypeAlias: ;
  else
    CollectBody(scope, Nodes[n].a);
    CollectBody(scope, Nodes[n].b);
    CollectBody(scope, Nodes[n].c);
    CollectBody(scope, Nodes[n].d);
    CollectBodyList(scope, Nodes[n].l);
    CollectBodyList(scope, Nodes[n].l2);
  end;
end;

function IsTupleLike(node: Integer): Boolean;
begin
  Result := ((Nodes[node].f shr 8) and 3) = 1;
end;

function IsUnitLike(node: Integer): Boolean;
begin
  Result := ((Nodes[node].f shr 8) and 3) = 2;
end;

procedure CollectFn(scope: Integer; parent: Integer; it: Integer; var d: Integer);
var
  i: Integer;
  sp: Integer;
begin
  d := NewDef(dkFn, Nodes[it].s, it, parent);
  Defs[d].scopeMod := scope;
  GatherGenerics(d, parent, it);
  Defs[d].hasBody := Nodes[it].b <> 0;
  Defs[d].trackCaller := Pos('track_caller', Nodes[it].at) > 0;
  Defs[d].isExtern := (Nodes[it].f and fExtern) <> 0;
  if (parent >= 0) and (Defs[parent].kind = dkTrait) then Defs[d].crate := Defs[parent].crate;
  for i := 0 to Length(Nodes[it].l2) - 1 do
  begin
    sp := Nodes[it].l2[i];
    if Nodes[sp].k = nSelfParam then
    begin
      if Nodes[sp].a <> 0 then Defs[d].selfKind := 4
      else if (Nodes[sp].f and 1) = 0 then Defs[d].selfKind := 1
      else if (Nodes[sp].f and 2) <> 0 then Defs[d].selfKind := 3
      else Defs[d].selfKind := 2;
    end
    else ScanImplTraitParams(d, Nodes[sp].b);
  end;
  if Nodes[it].b <> 0 then CollectBody(scope, Nodes[it].b);
end;

procedure CollectItems(scope: Integer; const items: TIntArr);
var
  i, j, it, d, v, im: Integer;
  vn, fnode: Integer;
  tn: string;
  ns: Char;
  nextDisc: Int64;
begin
  for i := 0 to Length(items) - 1 do
  begin
    it := items[i];
    case Nodes[it].k of
      nMod:
        begin
          d := NewDef(dkMod, Nodes[it].s, it, scope);
          Defs[d].scopeMod := d;
          AddMember(scope, 'T', Nodes[it].s, d);
          CollectItems(d, Nodes[it].l2);
        end;
      nFn:
        begin
          CollectFn(scope, -1, it, d);
          AddMember(scope, 'V', Nodes[it].s, d);
        end;
      nStruct:
        begin
          d := NewDef(dkStruct, Nodes[it].s, it, scope);
          GatherGenerics(d, -1, it);
          Defs[d].fieldCount := Length(Nodes[it].l2);
          AddMember(scope, 'T', Nodes[it].s, d);
          if IsTupleLike(it) or IsUnitLike(it) then AddMember(scope, 'V', Nodes[it].s, d);
        end;
      nEnum:
        begin
          d := NewDef(dkEnum, Nodes[it].s, it, scope);
          GatherGenerics(d, -1, it);
          AddMember(scope, 'T', Nodes[it].s, d);
          for j := 0 to Length(Nodes[it].l2) - 1 do
          begin
            vn := Nodes[it].l2[j];
            v := NewDef(dkVariant, Nodes[vn].s, vn, d);
            Defs[v].vindex := j;
            Defs[v].pub := True;
            Defs[v].fieldCount := Length(Nodes[vn].l2);
            GatherGenerics(v, d, 0);
            Defs[v].scopeMod := scope;
            IAdd(Defs[d].variants, v);
            AddMember(d, 'T', Nodes[vn].s, v);
            AddMember(d, 'V', Nodes[vn].s, v);
          end;
        end;
      nTrait:
        begin
          d := NewDef(dkTrait, Nodes[it].s, it, scope);
          AddGeneric(d, 'Self', 0, 0);
          GatherGenerics(d, -1, it);
          { GatherGenerics ajoute apres Self }
          AddMember(scope, 'T', Nodes[it].s, d);
          IAdd(AllTraits, d);
          for j := 0 to Length(Nodes[it].l2) - 1 do
          begin
            fnode := Nodes[it].l2[j];
            case Nodes[fnode].k of
              nFn:
                begin
                  CollectFn(scope, d, fnode, v);
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'V', Nodes[fnode].s, v);
                end;
              nTypeAlias:
                begin
                  v := NewDef(dkTypeAlias, Nodes[fnode].s, fnode, d);
                  Defs[v].scopeMod := scope;
                  GatherGenerics(v, d, fnode);
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'T', Nodes[fnode].s, v);
                end;
              nConst:
                begin
                  v := NewDef(dkConst, Nodes[fnode].s, fnode, d);
                  Defs[v].scopeMod := scope;
                  GatherGenerics(v, d, 0);
                  Defs[v].hasBody := Nodes[fnode].b <> 0;
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'V', Nodes[fnode].s, v);
                end;
            end;
          end;
        end;
      nImpl:
        begin
          d := NewDef(dkImpl, '', it, scope);
          GatherGenerics(d, -1, it);
          IAdd(AllImpls, d);
          for j := 0 to Length(Nodes[it].l2) - 1 do
          begin
            fnode := Nodes[it].l2[j];
            case Nodes[fnode].k of
              nFn:
                begin
                  CollectFn(scope, d, fnode, v);
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'V', Nodes[fnode].s, v);
                end;
              nTypeAlias:
                begin
                  v := NewDef(dkTypeAlias, Nodes[fnode].s, fnode, d);
                  Defs[v].scopeMod := scope;
                  GatherGenerics(v, d, fnode);
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'T', Nodes[fnode].s, v);
                end;
              nConst:
                begin
                  v := NewDef(dkConst, Nodes[fnode].s, fnode, d);
                  Defs[v].scopeMod := scope;
                  GatherGenerics(v, d, 0);
                  Defs[v].hasBody := True;
                  IAdd(Defs[d].items, v);
                  AddMember(d, 'V', Nodes[fnode].s, v);
                end;
            end;
          end;
        end;
      nConst:
        begin
          d := NewDef(dkConst, Nodes[it].s, it, scope);
          Defs[d].hasBody := Nodes[it].b <> 0;
          if Nodes[it].s <> '_' then AddMember(scope, 'V', Nodes[it].s, d);
          CollectBody(scope, Nodes[it].b);
        end;
      nStatic:
        begin
          d := NewDef(dkStatic, Nodes[it].s, it, scope);
          Defs[d].hasBody := Nodes[it].b <> 0;
          AddMember(scope, 'V', Nodes[it].s, d);
          CollectBody(scope, Nodes[it].b);
        end;
      nTypeAlias:
        begin
          d := NewDef(dkTypeAlias, Nodes[it].s, it, scope);
          GatherGenerics(d, -1, it);
          AddMember(scope, 'T', Nodes[it].s, d);
        end;
      nExternBlock:
        begin
          for j := 0 to Length(Nodes[it].l2) - 1 do
          begin
            fnode := Nodes[it].l2[j];
            if Nodes[fnode].k = nFn then
            begin
              CollectFn(scope, -1, fnode, v);
              Defs[v].isExtern := True;
              AddMember(scope, 'V', Nodes[fnode].s, v);
            end
            else
            begin
              v := NewDef(dkStatic, Nodes[fnode].s, fnode, scope);
              Defs[v].isExtern := True;
              AddMember(scope, 'V', Nodes[fnode].s, v);
            end;
          end;
        end;
      nUse:
        begin
          if NImports >= Length(Imports) then SetLength(Imports, NImports * 2 + 64);
          Imports[NImports].mod_ := scope;
          Imports[NImports].path := Nodes[it].s;
          Imports[NImports].glob := (Nodes[it].f and fGlob) <> 0;
          Imports[NImports].pub := (Nodes[it].f and fPub) <> 0;
          Imports[NImports].done := False;
          Imports[NImports].node := it;
          tn := Nodes[it].s2;
          if tn = '' then
          begin
            { dernier segment }
            j := Length(Nodes[it].s);
            while (j > 0) and (Nodes[it].s[j] <> ':') do Dec(j);
            tn := Copy(Nodes[it].s, j + 1, Length(Nodes[it].s));
          end;
          Imports[NImports].alias := tn;
          Inc(NImports);
        end;
    end;
  end;
end;

{ ---- resolution de chemins ---- }

function SplitPath(const s: string): TStrArr;
var
  i, st: Integer;
begin
  Result := nil;
  st := 1;
  i := 1;
  while i <= Length(s) do
  begin
    if (s[i] = ':') and (i < Length(s)) and (s[i + 1] = ':') then
    begin
      SAdd(Result, Copy(s, st, i - st));
      Inc(i, 2);
      st := i;
    end
    else Inc(i);
  end;
  SAdd(Result, Copy(s, st, Length(s) - st + 1));
end;

{ Premier segment : defs speciaux self/super/crate/std }
function ResolveFirst(scope: Integer; const name: string; ns: Char): Integer;
var
  m: Integer;
begin
  Result := -1;
  if name = 'crate' then begin Result := CrateRoot(scope); Exit; end;
  if name = 'self' then begin Result := NearestMod(scope); Exit; end;
  if name = 'super' then
  begin
    m := NearestMod(scope);
    if Defs[m].parent >= 0 then Result := NearestMod(Defs[m].parent);
    Exit;
  end;
  Result := LookupLexical(scope, ns, name);
  if (Result < 0) and ((name = 'std') or (name = 'core') or (name = 'alloc')) then
    if StdRoot > 0 then Result := StdRoot;
end;

{ Resout segs[0..] a partir de scope. Retourne la definition du dernier segment atteint
  (module / enum / autre) ; used = nombre de segments consommes. ns = espace de noms du dernier segment. }
function ResolveSegs(scope: Integer; const segs: TStrArr; ns: Char; var used: Integer): Integer;
var
  cur, nx, i: Integer;
  nsi: Char;
begin
  used := 0;
  Result := -1;
  if Length(segs) = 0 then Exit;
  if Length(segs) = 1 then nsi := ns else nsi := 'T';
  cur := ResolveFirst(scope, segs[0], nsi);
  if (cur < 0) and (Length(segs) > 1) then Exit;
  if cur < 0 then Exit;
  used := 1;
  Result := cur;
  for i := 1 to Length(segs) - 1 do
  begin
    if (Defs[cur].kind <> dkMod) and (Defs[cur].kind <> dkEnum) then Exit;
    if i = Length(segs) - 1 then nsi := ns else nsi := 'T';
    if (segs[i] = 'super') and (Defs[cur].kind = dkMod) then
    begin
      if Defs[cur].parent < 0 then Exit;
      nx := NearestMod(Defs[cur].parent);
    end
    else if segs[i] = 'self' then nx := cur
    else nx := ScopeLookup(cur, nsi, segs[i], 0);
    if nx < 0 then Exit;
    cur := nx;
    used := i + 1;
    Result := cur;
  end;
end;

{ Resout les imports par iteration jusqu'a point fixe }
procedure ResolveImports;
var
  changed: Boolean;
  i, used, d, d2, rounds: Integer;
  segs: TStrArr;
  found: Boolean;
  nm: string;
begin
  rounds := 0;
  repeat
    changed := False;
    Inc(rounds);
    for i := 0 to NImports - 1 do
    begin
      if Imports[i].done then Continue;
      segs := SplitPath(Imports[i].path);
      if Imports[i].glob then
      begin
        d := ResolveSegs(Imports[i].mod_, segs, 'T', used);
        if (d >= 0) and (used = Length(segs)) and ((Defs[d].kind = dkMod) or (Defs[d].kind = dkEnum)) then
        begin
          IAdd(Defs[Imports[i].mod_].globs, d);
          Imports[i].done := True;
          changed := True;
        end;
        Continue;
      end;
      found := False;
      nm := Imports[i].alias;
      { import de self dans un groupe, segment final self }
      if segs[Length(segs) - 1] = 'self' then
      begin
        SetLength(segs, Length(segs) - 1);
      end;
      d := ResolveSegs(Imports[i].mod_, segs, 'T', used);
      if (d >= 0) and (used = Length(segs)) then
      begin
        if nm <> '_' then AddMember(Imports[i].mod_, 'T', nm, d);
        found := True;
      end;
      d2 := ResolveSegs(Imports[i].mod_, segs, 'V', used);
      if (d2 >= 0) and (used = Length(segs)) then
      begin
        if nm <> '_' then AddMember(Imports[i].mod_, 'V', nm, d2);
        found := True;
      end;
      if found then
      begin
        Imports[i].done := True;
        changed := True;
      end;
    end;
  until (not changed) or (rounds > 50);
  { imports non resolus }
  for i := 0 to NImports - 1 do
    if not Imports[i].done then
    begin
      DefSpanErr('E0432', 'unresolved import `' + Imports[i].path + '`', Imports[i].node, 'no `' +
                 Imports[i].alias + '` in the root');
    end;
end;

function PrimTy(const nm: string): Integer;
begin
  Result := -1;
  case Length(nm) of
    2: if nm = 'i8' then Result := TyI8 else if nm = 'u8' then Result := TyU8;
    3: begin
         if nm = 'i16' then Result := TyI16
         else if nm = 'i32' then Result := TyI32
         else if nm = 'i64' then Result := TyI64
         else if nm = 'u16' then Result := TyU16
         else if nm = 'u32' then Result := TyU32
         else if nm = 'u64' then Result := TyU64
         else if nm = 'f32' then Result := TyF32
         else if nm = 'f64' then Result := TyF64
         else if nm = 'str' then Result := TyStrT;
       end;
    4: if nm = 'i128' then Result := TyI128
       else if nm = 'u128' then Result := TyU128
       else if nm = 'bool' then Result := TyBoolT
       else if nm = 'char' then Result := TyCharT;
    5: if nm = 'isize' then Result := TyIsize
       else if nm = 'usize' then Result := TyUsize;
  end;
  if (nm = 'i128') then Result := TyI128;
  if (nm = 'u128') then Result := TyU128;
  if (nm = 'bool') then Result := TyBoolT;
  if (nm = 'char') then Result := TyCharT;
end;

{ Retrouve le trait ou le type parent d'une definition (impl/trait) }
function DefParentKind(d: Integer): Integer;
begin
  if Defs[d].parent < 0 then Result := 0 else Result := Defs[Defs[d].parent].kind;
end;

function FindGeneric(d: Integer; const name: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := Length(Defs[d].gnames) - 1 downto 0 do
    if Defs[d].gnames[i] = name then begin Result := i; Exit; end;
end;

{ ============================================================ }
{ CONVERSION DES TYPES SYNTAXIQUES EN TYPES SEMANTIQUES        }
{ ============================================================ }

Type
  TEnv = record
    names: TStrArr;
    tys: TIntArr;
    selfTy: Integer;
    scope: Integer;
    infer: Boolean;
    implDef: Integer;
    traitDef: Integer;
    defn: Integer;
  end;

  TBound = record
    subj: Integer;
    trait: Integer;
    targs: TIntArr;        { Self en premiere position }
    bnames: TStrArr;
    btys: TIntArr;
    node: Integer;
  end;
  TBoundArr = array of TBound;

  TObl = record
    kind: Integer;         { 0 trait, 1 projection, 2 appelable }
    selfTy: Integer;
    trait: Integer;
    targs: TIntArr;
    name: string;
    res: Integer;
    done: Boolean;
    node: Integer;
  end;

Const
  oblTrait = 0;
  oblProj = 1;
  oblFn = 2;

Var
  Obls: array of TObl;
  NObls: Integer;
  { traits connus }
  LangCopy, LangClone, LangSized, LangDrop, LangDeref, LangDerefMut, LangFn, LangFnMut, LangFnOnce,
  LangIterator, LangIntoIterator, LangOption, LangResult, LangBox, LangString, LangVec, LangAdd, LangPartialEq,
  LangPartialOrd, LangIndex, LangIndexMut, LangNeg, LangNot, LangDisplay, LangDebug, LangDefault, LangFrom,
  LangRange, LangRangeInclusive, LangRangeFrom, LangRangeTo, LangRangeFull, LangRangeToInclusive, LangEq, LangOrd,
  LangOrdering, LangFormatter, LangSend, LangSync, LangUnpin, LangTuple, LangPhantom: Integer;
  MethodTraits: THashSI;     { nom de methode -> indice dans MethodTraitLists }
  MethodTraitLists: array of TIntArr;
  NMethodLists: Integer;
  HeadMap: THashSI;
  HeadLists: array of TIntArr;
  NHeadLists: Integer;
  ImplDepth: Integer;

function LowerTy(n: Integer; var env: TEnv): Integer; forward;
function ProjectAssoc(selfTy, trait: Integer; const targs: TIntArr; const name: string; errNode: Integer): Integer; forward;
function SelectImpl(trait: Integer; const targs: TIntArr; var impl: Integer; var iargs: TIntArr; commit: Boolean): Integer; forward;
function LowerConstExpr(n: Integer; var env: TEnv): Integer; forward;
procedure SolveObligations; forward;
function ResolveTraitRef(pathNode: Integer; var env: TEnv; selfTy: Integer; var targs: TIntArr;
  var bnames: TStrArr; var btys: TIntArr): Integer; forward;

procedure InitEnv(var env: TEnv);
begin
  env.names := nil;
  env.tys := nil;
  env.selfTy := 0;
  env.scope := UserRoot;
  env.infer := False;
  env.implDef := -1;
  env.traitDef := -1;
  env.defn := -1;
end;

function EnvLookup(var env: TEnv; const name: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := Length(env.names) - 1 downto 0 do
    if env.names[i] = name then
    begin
      if i < Length(env.tys) then Result := i;
      Exit;
    end;
end;

procedure EnvForDef(d: Integer; const args: TIntArr; var env: TEnv);
var
  p: Integer;
begin
  InitEnv(env);
  env.names := Defs[d].gnames;
  env.tys := ICopy(args);
  env.scope := Defs[d].scopeMod;
  env.defn := d;
  p := Defs[d].parent;
  case Defs[d].kind of
    dkImpl:
      begin
        env.implDef := d;
        if Defs[d].implTrait >= 0 then env.traitDef := Defs[d].implTrait;
        env.selfTy := LowerTy(Nodes[Defs[d].node].a, env);
      end;
    dkTrait:
      begin
        env.traitDef := d;
        if Length(args) > 0 then env.selfTy := args[0];
      end;
    dkVariant:
      begin
        if (p >= 0) and (Defs[p].kind = dkEnum) then
          env.selfTy := MkAdt(p, args);
      end;
    dkStruct, dkEnum:
      env.selfTy := MkAdt(d, args);
  else
    if p >= 0 then
    begin
      if Defs[p].kind = dkImpl then
      begin
        env.implDef := p;
        if Defs[p].implTrait >= 0 then env.traitDef := Defs[p].implTrait;
        env.selfTy := LowerTy(Nodes[Defs[p].node].a, env);
      end
      else if Defs[p].kind = dkTrait then
      begin
        env.traitDef := p;
        if Length(args) > 0 then env.selfTy := args[0];
      end;
    end;
  end;
end;

{ Cree des variables d'inference pour les generiques d'une definition }
function FreshArgs(d: Integer): TIntArr;
var
  i: Integer;
begin
  SetLength(Result, Length(Defs[d].gnames));
  for i := 0 to Length(Result) - 1 do Result[i] := NewTyVar(0);
end;

function TyHeadKey(t: Integer): string;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyBool: Result := 'bool';
    tyChar: Result := 'char';
    tyInt: Result := 'int' + IntToStr(Tys[t].n) + '_' + IntToStr(Tys[t].f);
    tyFloat: Result := 'f' + IntToStr(Tys[t].n);
    tyStr: Result := 'str';
    tyNever: Result := 'never';
    tyTuple: Result := 'tuple' + IntToStr(Length(Tys[t].args));
    tyArray: Result := 'array';
    tySlice: Result := 'slice';
    tyRef: Result := 'ref';
    tyPtr: Result := 'ptr';
    tyAdt: Result := 'adt' + IntToStr(Tys[t].def);
    tyFnPtr: Result := 'fnptr';
    tyFnDef: Result := 'fndef';
    tyClosure: Result := 'closure';
    tyDyn: Result := 'dyn' + IntToStr(Tys[t].def);
    tyVar: Result := 'var';
  else
    Result := 'other';
  end;
end;

function IsGenericName(const env: TEnv; const name: string): Boolean;
var
  i: Integer;
begin
  Result := False;
  for i := 0 to Length(env.names) - 1 do
    if env.names[i] = name then begin Result := True; Exit; end;
end;

{ Trait implemente par ce chemin ? retourne la definition du trait ou -1 }
function TraitOfPath(pathNode: Integer; scope: Integer): Integer;
var
  segs: TStrArr;
  i, used, d: Integer;
begin
  Result := -1;
  segs := nil;
  for i := 0 to Length(Nodes[pathNode].l) - 1 do
    SAdd(segs, Nodes[Nodes[pathNode].l[i]].s);
  d := ResolveSegs(scope, segs, 'T', used);
  if (d >= 0) and (used = Length(segs)) and (Defs[d].kind = dkTrait) then Result := d;
end;

{ Arguments generiques (types / constantes) d'un segment pour une definition }
procedure LowerGenericArgs(d: Integer; seg: Integer; var env: TEnv; var res: TIntArr; skipFirst: Integer;
  errNode: Integer);
var
  i, nown, first, given, g, t: Integer;
  sub: TEnv;
begin
  res := nil;
  first := Length(Defs[d].gnames) - Defs[d].nOwn;
  if skipFirst > first then first := skipFirst;
  nown := Length(Defs[d].gnames) - first;
  given := 0;
  if seg > 0 then given := Length(Nodes[seg].l);
  { arguments implicites : parent (aucun pour struct/enum) }
  for i := 0 to first - 1 do IAdd(res, 0);
  for i := 0 to nown - 1 do
  begin
    g := Defs[d].gnodes[first + i];
    if i < given then
    begin
      t := Nodes[seg].l[i];
      if Nodes[t].k = nConstArg then IAdd(res, LowerConstExpr(Nodes[t].a, env))
      else if Defs[d].gkinds[first + i] = 2 then
      begin
        { constante donnee sous forme de chemin }
        IAdd(res, LowerTy(t, env));
      end
      else IAdd(res, LowerTy(t, env));
    end
    else if (g > 0) and (Nodes[g].k = nGenParam) and (Nodes[g].a <> 0) and (Defs[d].gkinds[first + i] = 0) then
    begin
      { defaut du parametre }
      InitEnv(sub);
      sub.names := Defs[d].gnames;
      sub.tys := ICopy(res);
      sub.scope := Defs[d].scopeMod;
      sub.selfTy := env.selfTy;
      sub.infer := env.infer;
      IAdd(res, LowerTy(Nodes[g].a, sub));
    end
    else if env.infer then IAdd(res, NewTyVar(0))
    else
    begin
      if errNode > 0 then
        DefSpanErr('E0107', Defs[d].name + ' takes ' + IntToStr(nown) + ' generic argument' + 's' +
                   ' but ' + IntToStr(given) + ' generic arguments were supplied', errNode,
                   'expected ' + IntToStr(nown) + ' generic arguments');
      IAdd(res, TyErrT);
    end;
  end;
end;

{ Cherche l'item associe d'un type dans un impl }
function ImplAssocItem(impl: Integer; const name: string; kind: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to Length(Defs[impl].items) - 1 do
    if (Defs[Defs[impl].items[i]].name = name) and (Defs[Defs[impl].items[i]].kind = kind) then
    begin
      Result := Defs[impl].items[i];
      Exit;
    end;
end;

function TraitAssocItem(tr: Integer; const name: string; kind: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to Length(Defs[tr].items) - 1 do
    if (Defs[Defs[tr].items[i]].name = name) and (Defs[Defs[tr].items[i]].kind = kind) then
    begin
      Result := Defs[tr].items[i];
      Exit;
    end;
end;

{ super-traits d'un trait : liste des defs de traits }
function SuperTraits(tr: Integer): TIntArr;
var
  i, d: Integer;
  nd: Integer;
begin
  Result := nil;
  nd := Defs[tr].node;
  for i := 0 to Length(Nodes[nd].l3) - 1 do
  begin
    d := TraitOfPath(Nodes[nd].l3[i], Defs[tr].scopeMod);
    if d >= 0 then IAdd(Result, d);
  end;
  { clauses where Self: Trait }
  for i := 0 to Length(Nodes[nd].l) - 1 do
    if Nodes[Nodes[nd].l[i]].k = nWhere then
    begin
    end;
end;

{ Le trait possede-t-il (directement ou via ses super-traits) un type associe nomme name ? }
function FindTraitWithAssoc(tr: Integer; const name: string; depth: Integer): Integer;
var
  sup: TIntArr;
  i, r: Integer;
begin
  Result := -1;
  if depth > 6 then Exit;
  if TraitAssocItem(tr, name, dkTypeAlias) >= 0 then begin Result := tr; Exit; end;
  sup := SuperTraits(tr);
  for i := 0 to Length(sup) - 1 do
  begin
    r := FindTraitWithAssoc(sup[i], name, depth + 1);
    if r >= 0 then begin Result := r; Exit; end;
  end;
end;

function TraitIsA(tr, target: Integer; depth: Integer): Boolean;
var
  sup: TIntArr;
  i: Integer;
begin
  Result := tr = target;
  if Result or (depth > 6) then Exit;
  sup := SuperTraits(tr);
  for i := 0 to Length(sup) - 1 do
    if TraitIsA(sup[i], target, depth + 1) then begin Result := True; Exit; end;
end;

{ Trouve par nom un type associe pour le type base (selon les bornes du parametre ou les impls connus) }
function ProjectByName(base: Integer; var env: TEnv; const name: string; paramIdx: Integer; errNode: Integer): Integer;
var
  bnds: TIntArr;
  i, tr, g, k, found, nd: Integer;
  targs: TIntArr;
  tmpN: TStrArr;
  tmpT: TIntArr;
  bn: Integer;
begin
  Result := TyErrT;
  found := -1;
  { bornes declarees pour ce parametre }
  if (paramIdx >= 0) and (env.defn >= 0) and (paramIdx < Length(Defs[env.defn].gnodes)) then
  begin
    g := Defs[env.defn].gnodes[paramIdx];
    if g > 0 then
      for i := 0 to Length(Nodes[g].l) - 1 do
      begin
        tr := TraitOfPath(Nodes[g].l[i], env.scope);
        if tr >= 0 then
        begin
          k := FindTraitWithAssoc(tr, name, 0);
          if k >= 0 then begin found := k; Break; end;
        end;
      end;
    { clauses where T: Trait }
    nd := Defs[env.defn].node;
    if (found < 0) and (nd > 0) then
      for i := 0 to Length(Nodes[nd].l) - 1 do
        if Nodes[Nodes[nd].l[i]].k = nWhere then
        begin
          bn := Nodes[Nodes[nd].l[i]].a;
          if (Nodes[bn].k = tPath) and (Length(Nodes[bn].l) = 1) and (Nodes[Nodes[bn].l[0]].s = env.names[paramIdx]) then
          begin
            for k := 0 to Length(Nodes[Nodes[nd].l[i]].l) - 1 do
            begin
              tr := TraitOfPath(Nodes[Nodes[nd].l[i]].l[k], env.scope);
              if tr >= 0 then
              begin
                g := FindTraitWithAssoc(tr, name, 0);
                if g >= 0 then begin found := g; Break; end;
              end;
            end;
          end;
        end;
  end;
  { trait courant (Self::Name dans un trait) }
  if (found < 0) and (env.traitDef >= 0) and (paramIdx = 0) and (env.names[0] = 'Self') then
    found := FindTraitWithAssoc(env.traitDef, name, 0);
  if found < 0 then
  begin
    { recherche globale : tous les traits ayant un type associe de ce nom, que le type implemente }
    for i := 0 to Length(AllTraits) - 1 do
      if TraitAssocItem(AllTraits[i], name, dkTypeAlias) >= 0 then
      begin
        found := AllTraits[i];
        Break;
      end;
  end;
  if found < 0 then
  begin
    if errNode > 0 then
      DefSpanErr('E0220', 'associated type `' + name + '` not found', errNode, 'associated type `' + name + '` not found');
    Exit;
  end;
  SetLength(targs, Length(Defs[found].gnames));
  targs[0] := base;
  for i := 1 to Length(targs) - 1 do targs[i] := NewTyVar(0);
  Result := ProjectAssoc(base, found, targs, name, errNode);
end;

function LowerPathTy(n: Integer; var env: TEnv): Integer;
var
  segs: TStrArr;
  i, d, used, k, idx, selfT, tr, impl, item, seg: Integer;
  targs: TIntArr;
  bn: TStrArr;
  bt: TIntArr;
  args: TIntArr;
  sub: TEnv;
  nm: string;
  base: Integer;
begin
  Result := TyErrT;
  { chemin qualifie <T as Trait>::Name }
  if Nodes[n].a <> 0 then
  begin
    selfT := LowerTy(Nodes[n].a, env);
    nm := Nodes[Nodes[n].l[Length(Nodes[n].l) - 1]].s;
    if Nodes[n].b <> 0 then
    begin
      targs := nil;
      bn := nil;
      bt := nil;
      tr := ResolveTraitRef(Nodes[n].b, env, selfT, targs, bn, bt);
      if tr < 0 then Exit;
      Result := ProjectAssoc(selfT, tr, targs, nm, n);
    end
    else
      Result := ProjectByName(selfT, env, nm, -1, n);
    Exit;
  end;
  segs := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do SAdd(segs, Nodes[Nodes[n].l[i]].s);
  if Length(segs) = 0 then Exit;
  { parametre generique }
  if (Nodes[n].f = 0) then
  begin
    idx := EnvLookup(env, segs[0]);
    if idx >= 0 then
    begin
      base := env.tys[idx];
      for k := 1 to Length(segs) - 1 do
        base := ProjectByName(base, env, segs[k], idx, n);
      Result := base;
      Exit;
    end;
  end;
  if segs[0] = 'Self' then
  begin
    if env.selfTy = 0 then
    begin
      DefSpanErr('E0411', 'cannot find type `Self` in this scope', n, 'not found in this scope');
      Exit;
    end;
    base := env.selfTy;
    for k := 1 to Length(segs) - 1 do
    begin
      nm := segs[k];
      item := -1;
      if env.implDef >= 0 then
        item := ImplAssocItem(env.implDef, nm, dkTypeAlias);
      if item >= 0 then
      begin
        sub := env;
        base := LowerTy(Nodes[Defs[item].node].a, sub);
      end
      else
        base := ProjectByName(base, env, nm, 0, n);
    end;
    Result := base;
    Exit;
  end;
  d := ResolveSegs(env.scope, segs, 'T', used);
  if d < 0 then
  begin
    if Length(segs) = 1 then
    begin
      k := PrimTy(segs[0]);
      if k >= 0 then begin Result := k; Exit; end;
    end;
    if Length(segs) = 1 then
      DefSpanErr('E0412', 'cannot find type `' + segs[0] + '` in this scope', n, 'not found in this scope')
    else
      DefSpanErr('E0433', 'failed to resolve: use of undeclared type or module `' + segs[0] + '`', n,
                 'use of undeclared type or module `' + segs[0] + '`');
    Exit;
  end;
  seg := Nodes[n].l[used - 1];
  case Defs[d].kind of
    dkStruct, dkEnum:
      begin
        LowerGenericArgs(d, seg, env, args, 0, n);
        base := MkAdt(d, args);
      end;
    dkTypeAlias:
      begin
        LowerGenericArgs(d, seg, env, args, 0, n);
        InitEnv(sub);
        sub.names := Defs[d].gnames;
        sub.tys := args;
        sub.scope := Defs[d].scopeMod;
        sub.infer := env.infer;
        if Defs[d].parent >= 0 then
        begin
          sub.selfTy := env.selfTy;
        end;
        if Nodes[Defs[d].node].a = 0 then
        begin
          DefSpanErr('E0000', 'type alias without definition', n, '');
          Exit;
        end;
        base := LowerTy(Nodes[Defs[d].node].a, sub);
      end;
    dkTrait:
      begin
        { objet-trait sans dyn }
        LowerGenericArgs(d, seg, env, args, 1, n);
        targs := nil;
        for i := 1 to Length(args) - 1 do IAdd(targs, args[i]);
        base := MkDyn(d, targs);
      end;
    dkMod:
      begin
        DefSpanErr('E0573', 'expected type, found module `' + Defs[d].name + '`', n, 'not a type');
        Exit;
      end;
    dkVariant:
      begin
        DefSpanErr('E0573', 'expected type, found variant `' + Defs[d].name + '`', n, 'not a type');
        Exit;
      end;
  else
    DefSpanErr('E0573', 'expected type, found `' + Defs[d].name + '`', n, 'not a type');
    Exit;
  end;
  { segments restants : types associes }
  for k := used to Length(segs) - 1 do
    base := ProjectByName(base, env, segs[k], -1, n);
  Result := base;
end;

function LowerTy(n: Integer; var env: TEnv): Integer;
var
  i, t, tr, idx: Integer;
  a: TIntArr;
  targs: TIntArr;
  bn: TStrArr;
  bt: TIntArr;
  retT: Integer;
begin
  Result := TyErrT;
  if n = 0 then begin Result := TyUnit; Exit; end;
  case Nodes[n].k of
    tPath: Result := LowerPathTy(n, env);
    tRef: Result := MkRef(LowerTy(Nodes[n].a, env), (Nodes[n].f and 1) <> 0);
    tPtr: Result := MkPtr(LowerTy(Nodes[n].a, env), (Nodes[n].f and 1) <> 0);
    tTuple:
      begin
        SetLength(a, Length(Nodes[n].l));
        for i := 0 to Length(a) - 1 do a[i] := LowerTy(Nodes[n].l[i], env);
        Result := MkTuple(a);
      end;
    tArray:
      Result := MkArray(LowerTy(Nodes[n].a, env), LowerConstExpr(Nodes[n].b, env));
    tSlice: Result := MkSlice(LowerTy(Nodes[n].a, env));
    tFnPtr:
      begin
        SetLength(a, Length(Nodes[n].l));
        for i := 0 to Length(a) - 1 do a[i] := LowerTy(Nodes[n].l[i], env);
        if Nodes[n].a <> 0 then retT := LowerTy(Nodes[n].a, env) else retT := TyUnit;
        Result := MkFnPtr(a, retT);
      end;
    tNever: Result := TyNeverT;
    tInfer:
      begin
        if env.infer then Result := NewTyVar(0)
        else DefSpanErr('E0121', 'the placeholder `_` is not allowed within types on item signatures', n,
                        'not allowed in type signatures');
      end;
    tDyn:
      begin
        Result := TyErrT;
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          targs := nil; bn := nil; bt := nil;
          tr := ResolveTraitRef(Nodes[n].l[i], env, TyErrT, targs, bn, bt);
          if tr < 0 then Continue;
          if (tr = LangSend) or (tr = LangSync) or (tr = LangUnpin) then Continue;
          { enlever Self }
          a := nil;
          for t := 1 to Length(targs) - 1 do IAdd(a, targs[t]);
          Result := MkDyn(tr, a);
          Break;
        end;
      end;
    tImplTrait:
      begin
        idx := Nodes[n].id;
        if (idx >= 0) and (idx < Length(env.tys)) then Result := env.tys[idx]
        else DefSpanErr('E0562', '`impl Trait` is not allowed here', n, 'not allowed');
      end;
  end;
end;

{ ---- Resolution des references de trait ---- }
function ResolveTraitRef(pathNode: Integer; var env: TEnv; selfTy: Integer; var targs: TIntArr;
  var bnames: TStrArr; var btys: TIntArr): Integer;
var
  segs: TStrArr;
  i, used, d, seg, nown, k, g, t: Integer;
  sub: TEnv;
  args: TIntArr;
  b: Integer;
  nm: string;
begin
  Result := -1;
  segs := nil;
  for i := 0 to Length(Nodes[pathNode].l) - 1 do SAdd(segs, Nodes[Nodes[pathNode].l[i]].s);
  d := ResolveSegs(env.scope, segs, 'T', used);
  if (d < 0) or (used <> Length(segs)) or (Defs[d].kind <> dkTrait) then
  begin
    if (d >= 0) and (used = Length(segs)) then
      DefSpanErr('E0404', 'expected trait, found ' + Defs[d].name, pathNode, 'not a trait')
    else
      DefSpanErr('E0405', 'cannot find trait `' + segs[Length(segs) - 1] + '` in this scope', pathNode,
                 'not found in this scope');
    Exit;
  end;
  seg := Nodes[pathNode].l[Length(Nodes[pathNode].l) - 1];
  targs := nil;
  IAdd(targs, selfTy);
  if Nodes[seg].f = 1 then
  begin
    { sucre Fn(A, B) -> R : arguments = tuple ; liaison Output }
    args := nil;
    for i := 0 to Length(Nodes[seg].l) - 1 do IAdd(args, LowerTy(Nodes[seg].l[i], env));
    IAdd(targs, MkTuple(args));
    SAdd(bnames, 'Output');
    if Nodes[seg].a <> 0 then IAdd(btys, LowerTy(Nodes[seg].a, env)) else IAdd(btys, TyUnit);
    Result := d;
    Exit;
  end;
  nown := Length(Defs[d].gnames) - 1;
  for i := 0 to nown - 1 do
  begin
    g := Defs[d].gnodes[1 + i];
    if i < Length(Nodes[seg].l) then
    begin
      t := Nodes[seg].l[i];
      if Nodes[t].k = nConstArg then IAdd(targs, LowerConstExpr(Nodes[t].a, env))
      else IAdd(targs, LowerTy(t, env));
    end
    else if (g > 0) and (Nodes[g].a <> 0) then
    begin
      InitEnv(sub);
      sub.names := Defs[d].gnames;
      sub.tys := ICopy(targs);
      sub.scope := Defs[d].scopeMod;
      sub.selfTy := selfTy;
      sub.infer := env.infer;
      IAdd(targs, LowerTy(Nodes[g].a, sub));
    end
    else if env.infer then IAdd(targs, NewTyVar(0))
    else
    begin
      DefSpanErr('E0107', 'missing generics for trait `' + Defs[d].name + '`', pathNode, '');
      IAdd(targs, TyErrT);
    end;
  end;
  for i := 0 to Length(Nodes[seg].l2) - 1 do
  begin
    b := Nodes[seg].l2[i];
    SAdd(bnames, Nodes[b].s);
    IAdd(btys, LowerTy(Nodes[b].a, env));
  end;
  Result := d;
end;

{ Bornes (T: Trait, clauses where) d'une definition dans un environnement }
procedure LowerBoundsOf(d: Integer; var env: TEnv; var res: TBoundArr);
var
  i, j, g, w, tr, nd, p, pass: Integer;
  b: TBound;
  procedure AddB(subj, pathNode: Integer);
  begin
    b.subj := subj;
    b.targs := nil;
    b.bnames := nil;
    b.btys := nil;
    b.node := pathNode;
    tr := ResolveTraitRef(pathNode, env, subj, b.targs, b.bnames, b.btys);
    if tr < 0 then Exit;
    b.trait := tr;
    SetLength(res, Length(res) + 1);
    res[Length(res) - 1] := b;
  end;
begin
  res := nil;
  for i := 0 to Length(Defs[d].gnodes) - 1 do
  begin
    g := Defs[d].gnodes[i];
    if (g > 0) and (i < Length(env.tys)) then
      for j := 0 to Length(Nodes[g].l) - 1 do
      begin
        if Nodes[Nodes[g].l[j]].k <> tPath then Continue;
        AddB(env.tys[i], Nodes[g].l[j]);
      end;
  end;
  for pass := 0 to 1 do
  begin
    if pass = 0 then nd := Defs[d].node
    else
    begin
      p := Defs[d].parent;
      if (p >= 0) and ((Defs[p].kind = dkImpl) or (Defs[p].kind = dkTrait)) then nd := Defs[p].node else nd := 0;
    end;
    if nd = 0 then Continue;
    if not (Nodes[nd].k in [nFn, nImpl, nTrait, nStruct, nEnum, nTypeAlias]) then Continue;
    for i := 0 to Length(Nodes[nd].l) - 1 do
    begin
      w := Nodes[nd].l[i];
      if Nodes[w].k <> nWhere then Continue;
      for j := 0 to Length(Nodes[w].l) - 1 do
      begin
        if Nodes[Nodes[w].l[j]].k <> tPath then Continue;
        AddB(LowerTy(Nodes[w].a, env), Nodes[w].l[j]);
      end;
    end;
  end;
end;

{ ---- evaluation de constantes (longueurs de tableaux, etc.) ---- }

function ConstEvalExpr(n: Integer; var env: TEnv; var ok: Boolean): Int64; forward;

function LowerConstExpr(n: Integer; var env: TEnv): Integer;
var
  ok: Boolean;
  v: Int64;
  idx: Integer;
  p: Integer;
begin
  { parametre const generique ? }
  if Nodes[n].k = eBlock then
  begin
    if (Nodes[n].a <> 0) and (Length(Nodes[n].l) = 0) then begin Result := LowerConstExpr(Nodes[n].a, env); Exit; end;
  end;
  if (Nodes[n].k = eParen) then begin Result := LowerConstExpr(Nodes[n].a, env); Exit; end;
  if Nodes[n].k = ePath then
  begin
    p := Nodes[n].a;
    if (Length(Nodes[p].l) = 1) and (Nodes[p].a = 0) then
    begin
      idx := EnvLookup(env, Nodes[Nodes[p].l[0]].s);
      if idx >= 0 then begin Result := env.tys[idx]; Exit; end;
    end;
  end;
  if Nodes[n].k = eUnderscore then
  begin
    if env.infer then Result := NewTyVar(0) else Result := TyErrT;
    Exit;
  end;
  ok := True;
  v := ConstEvalExpr(n, env, ok);
  if not ok then
  begin
    DefSpanErr('E0435', 'attempt to use a non-constant value in a constant', n, 'non-constant value');
    Result := TyErrT;
    Exit;
  end;
  Result := MkConstTy(v);
end;

