{ HIR : representation de haut niveau typee et desucree        }
{ ============================================================ }

Const
  hLitInt = 1;       { n = valeur (non signee 64 bits) }
  hLitFloat = 2;     { fv }
  hLitBool = 3;      { n }
  hLitChar = 4;      { n }
  hLitStr = 5;       { s }
  hLitByteStr = 6;   { s }
  hLocal = 7;        { n = variable }
  hUpvar = 8;        { n = indice de capture }
  hStatic = 9;       { def }
  hFnRef = 10;       { def, targs }
  hCall = 11;        { a = appele ; l = arguments }
  hCallClosure = 12; { a = fermeture ; l = arguments }
  hField = 13;       { a = base ; n = indice du champ }
  hIndex = 14;       { a = base (tableau/tranche) ; b = indice }
  hDeref = 15;       { a }
  hAddr = 16;        { a ; n = 1 mut, 2 pointeur brut const, 3 pointeur brut mut }
  hCast = 17;        { a ; n = sorte }
  hUnary = 18;       { n = operateur (1 neg, 2 not) ; a }
  hBinary = 19;      { s = operateur ; a b }
  hAnd = 20;
  hOr = 21;
  hAssign = 22;      { a = place ; b = valeur }
  hAssignOp = 23;    { s = operateur ; a place ; b valeur }
  hIf = 24;          { a cond ; b alors ; c sinon }
  hLoop = 25;        { a = corps ; n = etiquette }
  hBreak = 26;       { n = etiquette ; a = valeur }
  hContinue = 27;    { n = etiquette }
  hReturn = 28;      { a }
  hBlock = 29;       { l = instructions ; a = expression finale }
  hLet = 30;         { n = motif ; a = init ; b = bloc else }
  hExprStmt = 31;    { a }
  hMatch = 32;       { a = scrutateur ; l = bras }
  hArm = 33;         { n = motif ; a = garde ; b = corps }
  hAdt = 34;         { def = struct ou variante ; l = valeurs des champs ; a = base ; n = index de variante }
  hTuple = 35;       { l }
  hArray = 36;       { l }
  hRepeat = 37;      { a = element ; n = nombre }
  hClosure = 38;     { n = indice de fermeture ; l = expressions capturees }
  hUnreachable = 39;
  hCoerce = 40;      { a ; n = sorte (1 jamais, 2 deref-reborrow, 3 dimensionnement, 4 pointeur de fonction, 5 objet-trait) }
  hLetCond = 41;     { n = motif ; a = expression : condition "let" }
  hConstVal = 42;    { def, targs : valeur d'une constante }
  hUnit = 43;
  hBlockLabel = 44;  { bloc etiquete : a = bloc ; n = etiquette }
  hTemp = 45;        { n = variable temporaire }

  { motifs }
  pkWild = 0;
  pkBind = 1;        { var ; a = sous-motif ; byRef }
  pkLit = 2;         { n / fv / s }
  pkRange = 3;       { n = bas ; m = haut ; incl }
  pkTuple = 4;       { l }
  pkAdt = 5;         { def ; vidx ; l = sous-motifs de tous les champs }
  pkDeref = 6;       { a }
  pkOr = 7;          { l }
  pkSlice = 8;       { l = prefixe ; a = reste (-1 si aucun) ; l2 = suffixe }
  pkConst = 9;       { def (constante non entiere) }

Type
  THir = record
    k, ty: Integer;
    a, b, c: Integer;
    l: TIntArr;
    n: Int64;
    fv: Double;
    s: string;
    def: Integer;
    targs: TIntArr;
    fi, line, col, len: Integer;
  end;

  TPat = record
    k: Integer;
    ty: Integer;
    n, m: Int64;
    fv: Double;
    s: string;
    a: Integer;
    l, l2: TIntArr;
    def: Integer;
    vidx: Integer;
    v: Integer;          { variable liee }
    byRef: Integer;      { 0 valeur, 1 ref, 2 ref mut }
    incl: Boolean;
    fi, line, col, len: Integer;
  end;

  TVarInfo = record
    name: string;
    ty: Integer;
    mut: Boolean;
    node: Integer;
    isParam: Boolean;
    used: Boolean;
    assigned: Boolean;
    declared: Boolean;
  end;

  TBody = record
    def: Integer;
    targs: TIntArr;
    key: string;
    params: TIntArr;       { variables des parametres }
    paramTys: TIntArr;
    ret: Integer;
    root: Integer;         { HIR }
    vars: array of TVarInfo;
    nvars: Integer;
    isClosure: Boolean;
    closure: Integer;
    done: Boolean;
    retExplicit: Integer;
    pats: TIntArr;
    unsafeFn: Boolean;
    fnNode: Integer;
  end;

Var
  Hirs: array of THir;
  NHirs: Integer;
  Pats: array of TPat;
  NPats: Integer;
  Bodies: array of TBody;
  NBodies: Integer;
  BodyMap: THashSI;

function NewHir(k, ty: Integer): Integer;
begin
  if NHirs >= Length(Hirs) then SetLength(Hirs, NHirs * 2 + 4096);
  Result := NHirs;
  Inc(NHirs);
  Hirs[Result].k := k;
  Hirs[Result].ty := ty;
end;

function NewPat(k, ty: Integer): Integer;
begin
  if NPats >= Length(Pats) then SetLength(Pats, NPats * 2 + 1024);
  Result := NPats;
  Inc(NPats);
  Pats[Result].k := k;
  Pats[Result].ty := ty;
  Pats[Result].a := -1;
  Pats[Result].v := -1;
  Pats[Result].vidx := 0;
end;

procedure HirPos(h, node: Integer);
begin
  if node > 0 then
  begin
    Hirs[h].fi := Nodes[node].fi;
    Hirs[h].line := Nodes[node].line;
    Hirs[h].col := Nodes[node].col;
    Hirs[h].len := NodeLen(node);
  end;
end;

procedure PatPos(p, node: Integer);
begin
  if node > 0 then
  begin
    Pats[p].fi := Nodes[node].fi;
    Pats[p].line := Nodes[node].line;
    Pats[p].col := Nodes[node].col;
    Pats[p].len := NodeLen(node);
  end;
end;

function HirAt(k, ty, node: Integer): Integer;
begin
  Result := NewHir(k, ty);
  HirPos(Result, node);
end;

{ La HIR est-elle une place (valeur-l) ? }
function IsPlaceHir(h: Integer): Boolean;
begin
  case Hirs[h].k of
    hLocal, hUpvar, hStatic, hDeref, hTemp: Result := True;
    hField, hIndex: Result := True;
  else
    Result := False;
  end;
end;

{ ---- affichage de types ---- }

function IntTyName(t: Integer): string;
begin
  if (Tys[t].f and 2) <> 0 then
  begin
    if (Tys[t].f and 1) <> 0 then Result := 'isize' else Result := 'usize';
  end
  else if (Tys[t].f and 1) <> 0 then Result := 'i' + IntToStr(Tys[t].n)
  else Result := 'u' + IntToStr(Tys[t].n);
end;

function TyToStr(t: Integer): string;
var
  i: Integer;
  s: string;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyErr: Result := '{type error}';
    tyBool: Result := 'bool';
    tyChar: Result := 'char';
    tyInt: Result := IntTyName(t);
    tyFloat: Result := 'f' + IntToStr(Tys[t].n);
    tyStr: Result := 'str';
    tyNever: Result := '!';
    tyTuple:
      begin
        if Length(Tys[t].args) = 0 then begin Result := '()'; Exit; end;
        s := '';
        for i := 0 to Length(Tys[t].args) - 1 do
        begin
          if i > 0 then s := s + ', ';
          s := s + TyToStr(Tys[t].args[i]);
        end;
        if Length(Tys[t].args) = 1 then s := s + ',';
        Result := '(' + s + ')';
      end;
    tyArray:
      begin
        if Tys[Shallow(Tys[t].args[1])].k = tyConst then
          Result := '[' + TyToStr(Tys[t].args[0]) + '; ' + IntToStr(Tys[Shallow(Tys[t].args[1])].n) + ']'
        else
          Result := '[' + TyToStr(Tys[t].args[0]) + '; _]';
      end;
    tySlice: Result := '[' + TyToStr(Tys[t].args[0]) + ']';
    tyRef:
      if (Tys[t].f and 1) <> 0 then Result := '&mut ' + TyToStr(Tys[t].args[0])
      else Result := '&' + TyToStr(Tys[t].args[0]);
    tyPtr:
      if (Tys[t].f and 1) <> 0 then Result := '*mut ' + TyToStr(Tys[t].args[0])
      else Result := '*const ' + TyToStr(Tys[t].args[0]);
    tyAdt, tyDyn, tyFnDef:
      begin
        s := Defs[Tys[t].def].name;
        if Tys[t].k = tyDyn then s := 'dyn ' + s;
        if Tys[t].k = tyFnDef then
        begin
          if (Defs[Tys[t].def].parent >= 0) and (Defs[Defs[Tys[t].def].parent].kind = dkImpl) then
            s := 'fn item {' + s + '}'
          else
            s := 'fn item {' + s + '}';
          Result := s;
          Exit;
        end;
        if Length(Tys[t].args) > 0 then
        begin
          s := s + '<';
          for i := 0 to Length(Tys[t].args) - 1 do
          begin
            if i > 0 then s := s + ', ';
            if Tys[Shallow(Tys[t].args[i])].k = tyConst then s := s + IntToStr(Tys[Shallow(Tys[t].args[i])].n)
            else s := s + TyToStr(Tys[t].args[i]);
          end;
          s := s + '>';
        end;
        Result := s;
      end;
    tyFnPtr:
      begin
        s := '';
        for i := 0 to Length(Tys[t].args) - 2 do
        begin
          if i > 0 then s := s + ', ';
          s := s + TyToStr(Tys[t].args[i]);
        end;
        Result := 'fn(' + s + ')';
        if Shallow(Tys[t].args[Length(Tys[t].args) - 1]) <> TyUnit then
          Result := Result + ' -> ' + TyToStr(Tys[t].args[Length(Tys[t].args) - 1]);
      end;
    tyClosure: Result := '{closure}';
    tyVar:
      case VarKind[Tys[t].n] of
        1: Result := '{integer}';
        2: Result := '{float}';
      else
        Result := '_';
      end;
    tyConst: Result := IntToStr(Tys[t].n);
    tyOpaque: Result := 'impl Trait';
  else
    Result := '?';
  end;
end;

{ ============================================================ }
{ VERIFICATION DES TYPES : contexte, variables, coercions      }
{ ============================================================ }

Type
  TLoopInfo = record
    lbl: string;
    id: Integer;
    breakTy: Integer;
    hasBreak: Boolean;
    isLoop: Boolean;
  end;

  TCtx = record
    body: Integer;
    sNames: TStrArr;
    sIds: TIntArr;
    nS: Integer;
    marks: TIntArr;
    nM: Integer;
    loops: array of TLoopInfo;
    nL: Integer;
    retTy: Integer;
    closure: Integer;
    unsafeDepth: Integer;
    env: TEnv;
    isConstCtx: Boolean;
  end;

  TValRes = record
    kind: Integer;
    def: Integer;
    targs: TIntArr;
    hir: Integer;
    selfTy: Integer;
    implDef: Integer;
  end;

Const
  vrNone = 0;
  vrLocal = 1;
  vrFn = 2;
  vrConst = 3;
  vrStatic = 4;
  vrStruct = 5;
  vrVariant = 6;
  vrTraitConst = 7;

Var
  Cxs: array of TCtx;
  CxTop: Integer;
  CxBase: Integer;
  LoopCounter: Integer;
  InstBodies: TIntArr;
  CheckDepth: Integer;
  WarnUnused: Boolean;

function Cx: Integer;
begin
  Result := CxTop;
end;

procedure PushCtx(bodyIdx: Integer; closure: Integer);
begin
  Inc(CxTop);
  if CxTop >= Length(Cxs) then SetLength(Cxs, CxTop * 2 + 8);
  Cxs[CxTop].body := bodyIdx;
  Cxs[CxTop].sNames := nil;
  Cxs[CxTop].sIds := nil;
  Cxs[CxTop].nS := 0;
  Cxs[CxTop].marks := nil;
  Cxs[CxTop].nM := 0;
  Cxs[CxTop].loops := nil;
  Cxs[CxTop].nL := 0;
  Cxs[CxTop].closure := closure;
  Cxs[CxTop].unsafeDepth := 0;
  Cxs[CxTop].isConstCtx := False;
  if (closure >= 0) and (CxTop > 0) then
  begin
    Cxs[CxTop].env := Cxs[CxTop - 1].env;
    Cxs[CxTop].unsafeDepth := Cxs[CxTop - 1].unsafeDepth;
  end;
end;

procedure PopCtx;
begin
  Dec(CxTop);
end;

procedure EnterScope;
begin
  if Cxs[CxTop].nM >= Length(Cxs[CxTop].marks) then SetLength(Cxs[CxTop].marks, Cxs[CxTop].nM * 2 + 8);
  Cxs[CxTop].marks[Cxs[CxTop].nM] := Cxs[CxTop].nS;
  Inc(Cxs[CxTop].nM);
end;

procedure LeaveScope;
begin
  Dec(Cxs[CxTop].nM);
  Cxs[CxTop].nS := Cxs[CxTop].marks[Cxs[CxTop].nM];
end;

function NewVarInfo(const name: string; ty: Integer; mut: Boolean; node: Integer): Integer;
var
  b: Integer;
begin
  b := Cxs[CxTop].body;
  if Bodies[b].nvars >= Length(Bodies[b].vars) then SetLength(Bodies[b].vars, Bodies[b].nvars * 2 + 16);
  Result := Bodies[b].nvars;
  Inc(Bodies[b].nvars);
  Bodies[b].vars[Result].name := name;
  Bodies[b].vars[Result].ty := ty;
  Bodies[b].vars[Result].mut := mut;
  Bodies[b].vars[Result].node := node;
  Bodies[b].vars[Result].isParam := False;
  Bodies[b].vars[Result].used := False;
  Bodies[b].vars[Result].assigned := False;
end;

procedure DeclareVar(const name: string; v: Integer);
begin
  with Cxs[CxTop] do
  begin
    if nS >= Length(sNames) then
    begin
      SetLength(sNames, nS * 2 + 16);
      SetLength(sIds, nS * 2 + 16);
    end;
    sNames[nS] := name;
    sIds[nS] := v;
    Inc(nS);
  end;
end;

function VarOf(v: Integer): Integer;
begin
  Result := v;
end;

function CurVars(v: Integer): Integer;
begin
  Result := v;
end;

function FindLocal(level: Integer; const name: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := Cxs[level].nS - 1 downto 0 do
    if Cxs[level].sNames[i] = name then begin Result := Cxs[level].sIds[i]; Exit; end;
end;

function BodyVarTy(level: Integer; v: Integer): Integer;
begin
  Result := Bodies[Cxs[level].body].vars[v].ty;
end;

{ ---- diagnostics du verificateur ---- }

procedure ErrAt(node: Integer; const code, msg, lbl: string);
begin
  if node > 0 then
    Report(True, code, msg, Nodes[node].fi, Nodes[node].line, Nodes[node].col, NodeLen(node), lbl)
  else
    Report(True, code, msg, -1, 0, 0, 0, lbl);
end;

procedure ErrAtHir(h: Integer; const code, msg, lbl: string);
begin
  if (h >= 0) and (Hirs[h].line > 0) then
    Report(True, code, msg, Hirs[h].fi, Hirs[h].line, Hirs[h].col, Hirs[h].len, lbl)
  else
    Report(True, code, msg, -1, 0, 0, 0, lbl);
end;

function TyStrZ(t: Integer): string;
begin
  Result := TyToStr(Zonk(t));
end;

procedure ErrMismatch(node: Integer; expected, found: Integer);
begin
  expected := Zonk(expected);
  found := Zonk(found);
  if (Tys[expected].k = tyErr) or (Tys[found].k = tyErr) then Exit;
  ErrAt(node, 'E0308', 'mismatched types', 'expected `' + TyToStr(expected) + '`, found `' + TyToStr(found) + '`');
end;

{ ---- fabrique de HIR ---- }

function HUnitOf(node: Integer): Integer;
begin
  Result := HirAt(hTuple, TyUnit, node);
end;

function HIntLit(ty: Integer; v: Int64; node: Integer): Integer;
begin
  Result := HirAt(hLitInt, ty, node);
  Hirs[Result].n := v;
end;

function HBool(v: Boolean; node: Integer): Integer;
begin
  Result := HirAt(hLitBool, TyBoolT, node);
  if v then Hirs[Result].n := 1;
end;

function HStrLit(const s: string; node: Integer): Integer;
begin
  Result := HirAt(hLitStr, TyStrRef, node);
  Hirs[Result].s := s;
end;

function HLocalOf(v: Integer; node: Integer): Integer;
begin
  Result := HirAt(hLocal, Bodies[Cxs[CxTop].body].vars[v].ty, node);
  Hirs[Result].n := v;
end;

function HBlockOf(const stmts: TIntArr; tail: Integer; ty: Integer; node: Integer): Integer;
begin
  Result := HirAt(hBlock, ty, node);
  Hirs[Result].l := stmts;
  Hirs[Result].a := tail;
end;

function HCallFn(def: Integer; const targs: TIntArr; const args: TIntArr; retTy: Integer; node: Integer): Integer;
var
  f: Integer;
begin
  f := HirAt(hFnRef, MkFnDef(def, targs), node);
  Hirs[f].def := def;
  Hirs[f].targs := targs;
  Result := HirAt(hCall, retTy, node);
  Hirs[Result].a := f;
  Hirs[Result].l := args;
end;

function HAddrOf(h: Integer; mut: Boolean; node: Integer): Integer;
var
  t: Integer;
begin
  t := MkRef(Hirs[h].ty, mut);
  Result := HirAt(hAddr, t, node);
  Hirs[Result].a := h;
  if mut then Hirs[Result].n := 1;
end;

function HDerefOf(h: Integer; node: Integer): Integer;
var
  t: Integer;
begin
  t := Shallow(Hirs[h].ty);
  if (Tys[t].k = tyRef) or (Tys[t].k = tyPtr) then t := Tys[t].args[0]
  else if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].lang = 'box') then t := Tys[t].args[0]
  else t := TyErrT;
  Result := HirAt(hDeref, t, node);
  Hirs[Result].a := h;
end;

{ ---- types : utilitaires ---- }

function IsNumericTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyInt) or (Tys[t].k = tyFloat) or ((Tys[t].k = tyVar) and (VarKind[Tys[t].n] <> 0));
end;

function IsIntegralTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyInt) or ((Tys[t].k = tyVar) and (VarKind[Tys[t].n] = 1));
end;

function IsFloatTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyFloat) or ((Tys[t].k = tyVar) and (VarKind[Tys[t].n] = 2));
end;

function IsPrimScalar(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := IsNumericTy(t) or (Tys[t].k = tyBool) or (Tys[t].k = tyChar);
end;

function IsBoxTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyAdt) and (Defs[Tys[t].def].lang = 'box');
end;

{ ============================================================ }
{ Signatures de fonctions                                      }
{ ============================================================ }

procedure FnDefSig(def: Integer; const args: TIntArr; var params: TIntArr; var ret: Integer);
var
  env: TEnv;
  nd, i, sp, p: Integer;
  sT: Integer;
  parent: Integer;
begin
  params := nil;
  case Defs[def].kind of
    dkStruct:
      begin
        EnvForDef(def, args, env);
        env.infer := True;
        nd := Defs[def].node;
        for i := 0 to Length(Nodes[nd].l2) - 1 do
          IAdd(params, LowerTy(Nodes[Nodes[nd].l2[i]].a, env));
        ret := MkAdt(def, args);
        Exit;
      end;
    dkVariant:
      begin
        EnvForDef(def, args, env);
        env.infer := True;
        nd := Defs[def].node;
        for i := 0 to Length(Nodes[nd].l2) - 1 do
          IAdd(params, LowerTy(Nodes[Nodes[nd].l2[i]].a, env));
        ret := MkAdt(Defs[def].parent, args);
        Exit;
      end;
    dkConst, dkStatic:
      begin
        EnvForDef(def, args, env);
        env.infer := True;
        nd := Defs[def].node;
        ret := LowerTy(Nodes[nd].a, env);
        Exit;
      end;
  end;
  EnvForDef(def, args, env);
  env.infer := True;
  nd := Defs[def].node;
  for i := 0 to Length(Nodes[nd].l2) - 1 do
  begin
    p := Nodes[nd].l2[i];
    if Nodes[p].k = nSelfParam then
    begin
      sT := SelfParamType(def, env.selfTy, env);
      IAdd(params, sT);
    end
    else IAdd(params, LowerTy(Nodes[p].b, env));
  end;
  if Nodes[nd].a = 0 then ret := TyUnit
  else if Nodes[Nodes[nd].a].k = tImplTrait then
  begin
    ret := MkTyArgs(tyOpaque, 0, 0, def, args);
  end
  else ret := LowerTy(Nodes[nd].a, env);
end;

{ Enregistre les bornes d'un appel generique comme obligations }
procedure RegisterBounds(def: Integer; const targs: TIntArr; node: Integer);
var
  env: TEnv;
  bs: TBoundArr;
  i, j, k: Integer;
  t: Integer;
  res: Integer;
  parms: TIntArr;
  name: string;
begin
  if Length(Defs[def].gnames) = 0 then Exit;
  EnvForDef(def, targs, env);
  env.infer := True;
  Inc(SuppressDiag);
  LowerBoundsOf(def, env, bs);
  Dec(SuppressDiag);
  for i := 0 to Length(bs) - 1 do
  begin
    if (bs[i].trait = LangSized) or (bs[i].trait = LangSend) or (bs[i].trait = LangSync) then Continue;
    if (bs[i].trait = LangFn) or (bs[i].trait = LangFnMut) or (bs[i].trait = LangFnOnce) then
    begin
      res := 0;
      for j := 0 to Length(bs[i].bnames) - 1 do
        if bs[i].bnames[j] = 'Output' then res := bs[i].btys[j];
      if res = 0 then res := NewTyVar(0);
      t := Shallow(bs[i].targs[1]);
      parms := nil;
      if Tys[t].k = tyTuple then parms := Tys[t].args;
      AddObl(oblFn, bs[i].subj, bs[i].trait, parms, '', res, node);
      Continue;
    end;
    AddObl(oblTrait, bs[i].subj, bs[i].trait, bs[i].targs, '', 0, node);
    for j := 0 to Length(bs[i].bnames) - 1 do
      AddObl(oblProj, bs[i].subj, bs[i].trait, bs[i].targs, bs[i].bnames[j], bs[i].btys[j], node);
  end;
end;

{ Cherche une obligation de type appelable pour une variable }
function FindFnObl(t: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  t := Shallow(t);
  for i := NObls - 1 downto 0 do
    if (not Obls[i].done) and (Obls[i].kind = oblFn) and (Shallow(Obls[i].selfTy) = t) then
    begin
      Result := i;
      Exit;
    end;
end;

{ ============================================================ }
{ Evaluation de constantes                                     }
{ ============================================================ }

var
  ConstDepth: Integer;

function ConstEvalExpr(n: Integer; var env: TEnv; var ok: Boolean): Int64;
var
  a, b: Int64;
  op: string;
  segs: TStrArr;
  i, used, d, p, idx: Integer;
  e2: TEnv;
  t: Integer;
begin
  Result := 0;
  if (n = 0) or (not ok) then begin ok := False; Exit; end;
  case Nodes[n].k of
    eLit:
      case Nodes[n].f of
        lkInt, lkChar, lkByte, lkBool: Result := Int64(Nodes[n].iv);
      else
        ok := False;
      end;
    eParen: Result := ConstEvalExpr(Nodes[n].a, env, ok);
    eBlock:
      if (Length(Nodes[n].l) = 0) and (Nodes[n].a <> 0) then Result := ConstEvalExpr(Nodes[n].a, env, ok)
      else ok := False;
    eUnary:
      begin
        a := ConstEvalExpr(Nodes[n].a, env, ok);
        if Nodes[n].s = '-' then Result := -a
        else if Nodes[n].s = '!' then Result := not a;
      end;
    eCast: Result := ConstEvalExpr(Nodes[n].a, env, ok);
    eBinary:
      begin
        a := ConstEvalExpr(Nodes[n].a, env, ok);
        b := ConstEvalExpr(Nodes[n].b, env, ok);
        op := Nodes[n].s;
        if not ok then Exit;
        if op = '+' then Result := a + b
        else if op = '-' then Result := a - b
        else if op = '*' then Result := a * b
        else if op = '/' then begin if b = 0 then ok := False else Result := a div b; end
        else if op = '%' then begin if b = 0 then ok := False else Result := a mod b; end
        else if op = '<<' then Result := a shl b
        else if op = '>>' then Result := a shr b
        else if op = '&' then Result := a and b
        else if op = '|' then Result := a or b
        else if op = '^' then Result := a xor b
        else if op = '==' then Result := Ord(a = b)
        else if op = '!=' then Result := Ord(a <> b)
        else if op = '<' then Result := Ord(a < b)
        else if op = '>' then Result := Ord(a > b)
        else if op = '<=' then Result := Ord(a <= b)
        else if op = '>=' then Result := Ord(a >= b)
        else if op = '&&' then Result := Ord((a <> 0) and (b <> 0))
        else if op = '||' then Result := Ord((a <> 0) or (b <> 0))
        else ok := False;
      end;
    eIf:
      begin
        a := ConstEvalExpr(Nodes[n].a, env, ok);
        if a <> 0 then Result := ConstEvalExpr(Nodes[n].b, env, ok)
        else if Nodes[n].c <> 0 then Result := ConstEvalExpr(Nodes[n].c, env, ok)
        else ok := False;
      end;
    ePath:
      begin
        p := Nodes[n].a;
        segs := nil;
        for i := 0 to Length(Nodes[p].l) - 1 do SAdd(segs, Nodes[Nodes[p].l[i]].s);
        if Length(segs) = 1 then
        begin
          idx := EnvLookup(env, segs[0]);
          if idx >= 0 then
          begin
            t := Shallow(env.tys[idx]);
            if Tys[t].k = tyConst then begin Result := Tys[t].n; Exit; end;
            ok := False;
            Exit;
          end;
        end;
        { constantes integrees des types primitifs }
        if (Length(segs) = 2) and (PrimTy(segs[0]) >= 0) then
        begin
          t := PrimTy(segs[0]);
          if (Tys[t].k = tyInt) then
          begin
            if segs[1] = 'MAX' then
            begin
              if (Tys[t].f and 1) <> 0 then Result := (Int64(1) shl (Tys[t].n - 1)) - 1
              else if Tys[t].n >= 64 then Result := -1
              else Result := (Int64(1) shl Tys[t].n) - 1;
              Exit;
            end;
            if segs[1] = 'MIN' then
            begin
              if (Tys[t].f and 1) <> 0 then Result := -(Int64(1) shl (Tys[t].n - 1)) else Result := 0;
              Exit;
            end;
            if segs[1] = 'BITS' then begin Result := Tys[t].n; Exit; end;
          end;
        end;
        d := ResolveSegs(env.scope, segs, 'V', used);
        if (d >= 0) and (used = Length(segs)) and (Defs[d].kind = dkConst) and (Nodes[Defs[d].node].b <> 0) and
           (ConstDepth < 30) then
        begin
          Inc(ConstDepth);
          InitEnv(e2);
          e2.scope := Defs[d].scopeMod;
          Result := ConstEvalExpr(Nodes[Defs[d].node].b, e2, ok);
          Dec(ConstDepth);
        end
        else ok := False;
      end;
    eMacro:
      ok := False;
  else
    ok := False;
  end;
end;

{ ============================================================ }
{ Coercions                                                     }
{ ============================================================ }

function WrapCoerce(h: Integer; ty: Integer; kind: Integer): Integer;
begin
  Result := NewHir(hCoerce, ty);
  Hirs[Result].a := h;
  Hirs[Result].n := kind;
  Hirs[Result].fi := Hirs[h].fi;
  Hirs[Result].line := Hirs[h].line;
  Hirs[Result].col := Hirs[h].col;
  Hirs[Result].len := Hirs[h].len;
end;

function CheckDerefCall(h: Integer; mutable: Boolean; node: Integer): Integer; forward;

{ Convertit une expression pour qu'elle ait le type cible, ou retourne -1 si impossible }
function TryCoerce(h: Integer; target: Integer): Integer;
var
  src, tgt, s0, t0, cur, k, nx, sn, tn: Integer;
  chain: Integer;
  curH: Integer;
  i: Integer;
  steps: Integer;
  elemS, elemT: Integer;
  params: TIntArr;
  ret: Integer;
  ok: Boolean;
  snap: Integer;
begin
  Result := -1;
  src := Shallow(Hirs[h].ty);
  tgt := Shallow(target);
  if src = tgt then begin Result := h; Exit; end;
  if (Tys[src].k = tyErr) or (Tys[tgt].k = tyErr) then begin Result := h; Exit; end;
  if Tys[src].k = tyNever then
  begin
    Result := WrapCoerce(h, target, 1);
    Exit;
  end;
  if TryUnify(src, tgt) then begin Result := h; Exit; end;
  { &mut T -> &T, deref coercion }
  if (Tys[src].k = tyRef) and (Tys[tgt].k = tyRef) then
  begin
    if ((Tys[src].f and 1) = 0) and ((Tys[tgt].f and 1) <> 0) then Exit;
    s0 := Tys[src].args[0];
    t0 := Shallow(Tys[tgt].args[0]);
    { tableau -> tranche }
    s0 := Shallow(s0);
    if (Tys[s0].k = tyArray) and (Tys[t0].k = tySlice) then
    begin
      if TryUnify(Tys[s0].args[0], Tys[t0].args[0]) then
      begin
        Result := WrapCoerce(h, target, 3);
        Exit;
      end;
    end;
    { objet-trait }
    if (Tys[t0].k = tyDyn) and (Tys[s0].k <> tyDyn) and (Tys[s0].k <> tyVar) then
    begin
      Result := WrapCoerce(h, target, 5);
      Exit;
    end;
    { deref successifs : &String -> &str, &Vec<T> -> &[T], &&T -> &T, &Box<T> -> &T }
    cur := s0;
    curH := HDerefOf(h, 0);
    Hirs[curH].line := Hirs[h].line; Hirs[curH].col := Hirs[h].col; Hirs[curH].fi := Hirs[h].fi; Hirs[curH].len := Hirs[h].len;
    for steps := 1 to 10 do
    begin
      cur := Shallow(cur);
      nx := DerefOnce(cur, k);
      if nx = 0 then Break;
      if k = 1 then
      begin
        curH := HDerefOf(curH, 0);
      end
      else
      begin
        curH := CheckDerefCall(curH, (Tys[tgt].f and 1) <> 0, 0);
      end;
      Hirs[curH].fi := Hirs[h].fi; Hirs[curH].line := Hirs[h].line; Hirs[curH].col := Hirs[h].col; Hirs[curH].len := Hirs[h].len;
      cur := nx;
      snap := Snapshot;
      if TryUnify(cur, t0) then
      begin
        Result := HAddrOf(curH, (Tys[tgt].f and 1) <> 0, 0);
        Hirs[Result].fi := Hirs[h].fi; Hirs[Result].line := Hirs[h].line; Hirs[Result].col := Hirs[h].col; Hirs[Result].len := Hirs[h].len;
        Hirs[Result].ty := target;
        Exit;
      end;
      { tableau derriere deref -> tranche }
      if (Tys[Shallow(cur)].k = tyArray) and (Tys[t0].k = tySlice) then
        if TryUnify(Tys[Shallow(cur)].args[0], Tys[t0].args[0]) then
        begin
          Result := HAddrOf(curH, (Tys[tgt].f and 1) <> 0, 0);
          Hirs[Result].fi := Hirs[h].fi; Hirs[Result].line := Hirs[h].line; Hirs[Result].col := Hirs[h].col; Hirs[Result].len := Hirs[h].len;
          Result := WrapCoerce(Result, target, 3);
          Exit;
        end;
    end;
    Exit;
  end;
  { &T / &mut T -> *const T / *mut T ; *mut T -> *const T }
  if (Tys[tgt].k = tyPtr) then
  begin
    if (Tys[src].k = tyRef) or (Tys[src].k = tyPtr) then
    begin
      if (Tys[src].k = tyPtr) and ((Tys[src].f and 1) = 0) and ((Tys[tgt].f and 1) <> 0) then Exit;
      if (Tys[src].k = tyRef) and ((Tys[src].f and 1) = 0) and ((Tys[tgt].f and 1) <> 0) then Exit;
      s0 := Shallow(Tys[src].args[0]);
      t0 := Shallow(Tys[tgt].args[0]);
      if TryUnify(s0, t0) then
      begin
        Result := WrapCoerce(h, target, 2);
        Exit;
      end;
      if (Tys[s0].k = tyArray) and (Tys[t0].k = tySlice) and TryUnify(Tys[s0].args[0], Tys[t0].args[0]) then
      begin
        Result := WrapCoerce(h, target, 3);
        Exit;
      end;
    end;
    Exit;
  end;
  { fonction / fermeture -> pointeur de fonction }
  if Tys[tgt].k = tyFnPtr then
  begin
    ok := False;
    if Tys[src].k = tyFnDef then
    begin
      FnDefSig(Tys[src].def, Tys[src].args, params, ret);
      ok := True;
    end
    else if Tys[src].k = tyClosure then
    begin
      params := Closures[Tys[src].def].params;
      ret := Closures[Tys[src].def].ret;
      ok := True;
    end;
    if ok then
    begin
      if Length(params) <> Length(Tys[tgt].args) - 1 then Exit;
      for i := 0 to Length(params) - 1 do
        if not TryUnify(params[i], Tys[tgt].args[i]) then Exit;
      if not TryUnify(ret, Tys[tgt].args[Length(Tys[tgt].args) - 1]) then Exit;
      Result := WrapCoerce(h, target, 4);
      Exit;
    end;
    Exit;
  end;
  { Box<T> -> Box<dyn Trait> }
  if IsBoxTy(src) and IsBoxTy(tgt) then
  begin
    s0 := Shallow(Tys[src].args[0]);
    t0 := Shallow(Tys[tgt].args[0]);
    if (Tys[t0].k = tyDyn) and (Tys[s0].k <> tyDyn) and (Tys[s0].k <> tyVar) then
    begin
      Result := WrapCoerce(h, target, 5);
      Exit;
    end;
    if (Tys[t0].k = tySlice) and (Tys[s0].k = tyArray) and TryUnify(Tys[s0].args[0], Tys[t0].args[0]) then
    begin
      Result := WrapCoerce(h, target, 3);
      Exit;
    end;
  end;
end;

{ Coerce ou signale une erreur de type }
function CoerceTo(h: Integer; target: Integer; node: Integer): Integer;
begin
  Result := TryCoerce(h, target);
  if Result < 0 then
  begin
    ErrMismatch(node, target, Hirs[h].ty);
    Result := h;
  end;
end;

procedure UnifyOrErr(a, b: Integer; node: Integer);
begin
  if not TryUnify(a, b) then ErrMismatch(node, a, b);
end;

