function CheckExpr(n: Integer; expected: Integer): Integer; forward;
function CheckExprCoerce(n: Integer; target: Integer): Integer; forward;
function CheckBlockExpr(n: Integer; expected: Integer): Integer; forward;
function CheckPat(n: Integer; expected: Integer; bm: Integer): Integer; forward;
function MakeMutPlace(h: Integer): Integer; forward;
function CheckMacroExpr(n: Integer; expected: Integer): Integer; forward;

function PathSegs(p: Integer): TStrArr;
var
  i: Integer;
begin
  Result := nil;
  for i := 0 to Length(Nodes[p].l) - 1 do SAdd(Result, Nodes[Nodes[p].l[i]].s);
end;

function PathSegsSub(const segs: TStrArr; count: Integer): TStrArr;
var
  i: Integer;
begin
  Result := nil;
  for i := 0 to count - 1 do SAdd(Result, segs[i]);
end;

function CurEnv: Integer;
begin
  Result := CxTop;
end;

function LowerInCtx(n: Integer): Integer;
begin
  Cxs[CxTop].env.infer := True;
  Result := LowerTy(n, Cxs[CxTop].env);
end;

{ Nombre de generiques "caches" (impl Trait) de la definition }
function HiddenGenerics(def: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to Length(Defs[def].gnames) - 1 do
    if StartsWith(Defs[def].gnames[i], 'impl#') then Inc(Result);
end;

{ Arguments complets d'une fonction : arguments du parent + generiques propres (turbofish ou variables) }
function BuildFnArgs(def: Integer; const parentArgs: TIntArr; seg: Integer): TIntArr;
var
  i, np, nexp, given, t: Integer;
begin
  Result := ICopy(parentArgs);
  np := Length(Defs[def].gnames) - Defs[def].nOwn;
  nexp := Defs[def].nOwn - HiddenGenerics(def);
  given := 0;
  if seg > 0 then given := Length(Nodes[seg].l);
  for i := 0 to Defs[def].nOwn - 1 do
  begin
    if (i < nexp) and (i < given) then
    begin
      t := Nodes[seg].l[i];
      if Nodes[t].k = nConstArg then
        IAdd(Result, LowerConstExpr(Nodes[t].a, Cxs[CxTop].env))
      else
        IAdd(Result, LowerInCtx(t));
    end
    else IAdd(Result, NewTyVar(0));
  end;
end;

function SynthPrefixPath(p: Integer; count: Integer): Integer;
var
  i: Integer;
begin
  Result := NewNode(tPath);
  Nodes[Result].fi := Nodes[p].fi;
  Nodes[Result].line := Nodes[p].line;
  Nodes[Result].col := Nodes[p].col;
  Nodes[Result].eline := Nodes[p].eline;
  Nodes[Result].ecol := Nodes[p].ecol;
  Nodes[Result].f := Nodes[p].f;
  Nodes[Result].a := Nodes[p].a;
  Nodes[Result].b := Nodes[p].b;
  for i := 0 to count - 1 do IAdd(Nodes[Result].l, Nodes[p].l[i]);
end;

{ Cherche un item associe (fonction ou constante) a un type }
function FindAssocItem(selfT: Integer; const name: string; seg: Integer; var r: TValRes): Boolean;
var
  t, idx, i, j, impl, item, tr: Integer;
  cands, trs: TIntArr;
  iargs, targs, parentArgs, ia: TIntArr;
  env: TEnv;
  hk: string;
  ok: Boolean;
  s: Integer;
  kind: Integer;
  rr: Integer;
begin
  Result := False;
  t := StructResolve(selfT);
  if Tys[t].k = tyErr then Exit;
  { variantes d'enum }
  if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkEnum) then
  begin
    item := ScopeLookup(Tys[t].def, 'V', name, 0);
    if (item >= 0) and (Defs[item].kind = dkVariant) then
    begin
      r.kind := vrVariant;
      r.def := item;
      r.targs := ICopy(Tys[t].args);
      Result := True;
      Exit;
    end;
  end;
  { impls inherents }
  if Tys[t].k <> tyVar then
  begin
    hk := TyHeadKey(t);
    idx := HFind(HeadMap, hk);
    if idx >= 0 then
    begin
      cands := HeadLists[idx];
      for i := 0 to Length(cands) - 1 do
      begin
        impl := cands[i];
        item := ImplAssocItem(impl, name, dkFn);
        kind := vrFn;
        if item < 0 then begin item := ImplAssocItem(impl, name, dkConst); kind := vrConst; end;
        if item < 0 then Continue;
        s := Snapshot;
        Inc(SuppressDiag);
        iargs := FreshArgs(impl);
        EnvForDef(impl, iargs, env);
        env.infer := True;
        ok := Unify(env.selfTy, t) and ImplBoundsHold(impl, env);
        Dec(SuppressDiag);
        if not ok then begin Rollback(s); Continue; end;
        r.kind := kind;
        r.def := item;
        r.implDef := impl;
        if kind = vrFn then r.targs := BuildFnArgs(item, iargs, seg)
        else r.targs := iargs;
        Result := True;
        Exit;
      end;
    end;
  end;
  { items de traits }
  if Tys[t].k = tyVar then
  begin
    if VarKind[Tys[t].n] = 0 then Exit;
  end;
  idx := HFind(MethodTraits, name);
  trs := nil;
  if idx >= 0 then trs := MethodTraitLists[idx];
  for j := 0 to Length(AllTraits) - 1 do
  begin
    tr := AllTraits[j];
    if (TraitAssocItem(tr, name, dkConst) >= 0) and (IIndexOf(trs, tr) < 0) then IAdd(trs, tr);
  end;
  for i := 0 to Length(trs) - 1 do
  begin
    tr := trs[i];
    item := TraitAssocItem(tr, name, dkFn);
    kind := vrFn;
    if item < 0 then begin item := TraitAssocItem(tr, name, dkConst); kind := vrTraitConst; end;
    if item < 0 then Continue;
    SetLength(targs, Length(Defs[tr].gnames));
    targs[0] := t;
    for j := 1 to Length(targs) - 1 do targs[j] := NewTyVar(0);
    s := Snapshot;
    Inc(SuppressDiag);
    rr := SelectImpl(tr, targs, impl, ia, True);
    Dec(SuppressDiag);
    if rr = 0 then begin Rollback(s); Continue; end;
    r.kind := kind;
    r.def := item;
    r.implDef := -1;
    r.selfTy := t;
    if kind = vrFn then r.targs := BuildFnArgs(item, targs, seg) else r.targs := targs;
    Result := True;
    Exit;
  end;
end;

{ Genere les arguments de type pour une definition ADT a partir des generiques d'un segment }
function AdtArgsFromSeg(d: Integer; seg: Integer): TIntArr;
var
  env: TEnv;
  args: TIntArr;
begin
  env := Cxs[CxTop].env;
  env.infer := True;
  LowerGenericArgs(d, seg, env, args, 0, 0);
  Result := args;
end;

function ValueDefResult(d: Integer; p: Integer; used: Integer; var r: TValRes): Boolean;
var
  seg, eseg: Integer;
  par: Integer;
  pargs: TIntArr;
begin
  Result := True;
  seg := Nodes[p].l[Length(Nodes[p].l) - 1];
  case Defs[d].kind of
    dkFn:
      begin
        r.kind := vrFn;
        r.def := d;
        r.targs := BuildFnArgs(d, nil, seg);
      end;
    dkConst:
      begin
        r.kind := vrConst;
        r.def := d;
        r.targs := nil;
      end;
    dkStatic:
      begin
        r.kind := vrStatic;
        r.def := d;
      end;
    dkStruct:
      begin
        r.kind := vrStruct;
        r.def := d;
        r.targs := AdtArgsFromSeg(d, seg);
      end;
    dkVariant:
      begin
        r.kind := vrVariant;
        r.def := d;
        par := Defs[d].parent;
        eseg := 0;
        if Length(Nodes[p].l) >= 2 then eseg := Nodes[p].l[Length(Nodes[p].l) - 2];
        if (eseg > 0) and (Length(Nodes[eseg].l) > 0) then r.targs := AdtArgsFromSeg(par, eseg)
        else if Length(Nodes[seg].l) > 0 then r.targs := AdtArgsFromSeg(par, seg)
        else r.targs := AdtArgsFromSeg(par, 0);
      end;
  else
    Result := False;
  end;
end;

function ResolveValuePath(p: Integer; var r: TValRes): Boolean;
var
  segs: TStrArr;
  n, used, d, i, k, seg, q, idx: Integer;
  selfT, tr: Integer;
  targs: TIntArr;
  bn: TStrArr;
  bt: TIntArr;
  name: string;
  v: Integer;
  lv: Integer;
  level: Integer;
  res: Integer;
  item: Integer;
  kind: Integer;
  pargs: TIntArr;
begin
  Result := False;
  r.kind := vrNone;
  r.targs := nil;
  r.implDef := -1;
  r.hir := 0;
  r.selfTy := 0;
  segs := PathSegs(p);
  n := Length(segs);
  if n = 0 then Exit;
  seg := Nodes[p].l[n - 1];
  name := segs[n - 1];
  { chemin qualifie }
  if Nodes[p].a <> 0 then
  begin
    selfT := LowerInCtx(Nodes[p].a);
    if Nodes[p].b <> 0 then
    begin
      targs := nil; bn := nil; bt := nil;
      tr := ResolveTraitRef(Nodes[p].b, Cxs[CxTop].env, selfT, targs, bn, bt);
      if tr < 0 then begin r.kind := vrNone; Result := True; Exit; end;
      item := TraitAssocItem(tr, name, dkFn);
      kind := vrFn;
      if item < 0 then begin item := TraitAssocItem(tr, name, dkConst); kind := vrTraitConst; end;
      if item < 0 then
      begin
        ErrAt(p, 'E0576', 'cannot find method or associated constant `' + name + '` in trait `' + Defs[tr].name + '`',
              'not found in `' + Defs[tr].name + '`');
        Result := True;
        Exit;
      end;
      r.kind := kind;
      r.def := item;
      if kind = vrFn then r.targs := BuildFnArgs(item, targs, seg) else r.targs := targs;
      r.selfTy := selfT;
      Result := True;
      Exit;
    end;
    if FindAssocItem(selfT, name, seg, r) then Result := True
    else
    begin
      ErrAt(p, 'E0599', 'no function or associated item named `' + name + '` found for type `' + TyStrZ(selfT) +
            '` in the current scope', 'function or associated item not found in `' + TyStrZ(selfT) + '`');
      Result := True;
    end;
    Exit;
  end;
  { variable locale }
  if (n = 1) and (Nodes[p].f = 0) and (Length(Nodes[seg].l) = 0) then
  begin
    level := CxTop;
    v := -1;
    res := 0;
    { recherche dans les contextes, en remontant les fermetures }
    level := CxTop;
    while True do
    begin
      v := FindLocal(level, name);
      if v >= 0 then Break;
      if (Cxs[level].closure >= 0) and (level > CxBase + 1) then Dec(level) else Break;
    end;
    if v >= 0 then
    begin
      r.kind := vrLocal;
      r.def := v;
      r.selfTy := level;
      Result := True;
      Exit;
    end;
  end;
  if (n = 1) and (name = 'Self') then
  begin
    selfT := Cxs[CxTop].env.selfTy;
    if (selfT <> 0) and (Tys[Shallow(selfT)].k = tyAdt) and (Defs[Tys[Shallow(selfT)].def].kind = dkStruct) then
    begin
      r.kind := vrStruct;
      r.def := Tys[Shallow(selfT)].def;
      r.targs := ICopy(Tys[Shallow(selfT)].args);
      Result := True;
      Exit;
    end;
  end;
  { constante / fonction par chemin }
  if (Nodes[p].f = 0) and (n = 1) and (EnvLookup(Cxs[CxTop].env, name) >= 0) then
  begin
    { parametre const generique utilise comme valeur }
    idx := EnvLookup(Cxs[CxTop].env, name);
    if Defs[Cxs[CxTop].env.defn].gkinds[idx] = 2 then
    begin
      r.kind := vrNone;
      r.def := -2;
      r.selfTy := Cxs[CxTop].env.tys[idx];
      Result := True;
      Exit;
    end;
  end;
  d := ResolveSegs(Cxs[CxTop].env.scope, segs, 'V', used);
  if (d >= 0) and (used = n) then
  begin
    if ValueDefResult(d, p, used, r) then begin Result := True; Exit; end;
  end;
  { prefixe de type + element associe }
  if n >= 2 then
  begin
    { le prefixe designe-t-il un trait ? }
    d := ResolveSegs(Cxs[CxTop].env.scope, PathSegsSub(segs, n - 1), 'T', used);
    if (d >= 0) and (used = n - 1) and (Defs[d].kind = dkTrait) then
    begin
      tr := d;
      item := TraitAssocItem(tr, name, dkFn);
      kind := vrFn;
      if item < 0 then begin item := TraitAssocItem(tr, name, dkConst); kind := vrTraitConst; end;
      if item = -1 then
      begin
        ErrAt(p, 'E0576', 'cannot find method or associated constant `' + name + '` in trait `' + Defs[tr].name + '`',
              'not found in `' + Defs[tr].name + '`');
        r.kind := vrNone;
        Result := True;
        Exit;
      end;
      SetLength(targs, Length(Defs[tr].gnames));
      for i := 0 to Length(targs) - 1 do targs[i] := NewTyVar(0);
      if Length(Nodes[Nodes[p].l[n - 2]].l) > 0 then
        for i := 1 to Length(targs) - 1 do
          if i - 1 < Length(Nodes[Nodes[p].l[n - 2]].l) then
            targs[i] := LowerInCtx(Nodes[Nodes[p].l[n - 2]].l[i - 1]);
      r.kind := kind;
      r.def := item;
      if kind = vrFn then r.targs := BuildFnArgs(item, targs, seg) else r.targs := targs;
      r.selfTy := targs[0];
      Result := True;
      Exit;
    end;
    q := SynthPrefixPath(p, n - 1);
    Inc(SuppressDiag);
    selfT := LowerInCtx(q);
    Dec(SuppressDiag);
    if (selfT <> TyErrT) and (selfT <> 0) then
    begin
      if FindAssocItem(selfT, name, seg, r) then begin Result := True; Exit; end;
      ErrAt(p, 'E0599', 'no function or associated item named `' + name + '` found for ' +
            'type `' + TyStrZ(selfT) + '` in the current scope', 'function or associated item not found in `' +
            TyStrZ(selfT) + '`');
      r.kind := vrNone;
      Result := True;
      Exit;
    end;
  end;
  { non trouve }
  if n = 1 then
    ErrAt(p, 'E0425', 'cannot find value `' + name + '` in this scope', 'not found in this scope')
  else
    ErrAt(p, 'E0433', 'failed to resolve: use of undeclared type or module `' + segs[0] + '`',
          'use of undeclared type or module `' + segs[0] + '`');
  r.kind := vrNone;
  Result := True;
end;

{ ============================================================ }
{ Verification des expressions (1) : litteraux, chemins,        }
{ operateurs, acces, appels                                     }
{ ============================================================ }

Var
  DerefFn, DerefMutFn, IndexFn, IndexMutFn: Integer;
  OpTraits: THashSI;
  FmtLocFile: string;

function FindStd(const path: string; ns: Char): Integer;
var
  used: Integer;
  d: Integer;
  segs: TStrArr;
begin
  segs := SplitPath(path);
  d := ResolveSegs(StdRoot, segs, ns, used);
  if (d >= 0) and (used = Length(segs)) then Result := d else Result := 0;
end;

function OpMethodName(const op: string): string;
begin
  if op = '+' then Result := 'add'
  else if op = '-' then Result := 'sub'
  else if op = '*' then Result := 'mul'
  else if op = '/' then Result := 'div'
  else if op = '%' then Result := 'rem'
  else if op = '&' then Result := 'bitand'
  else if op = '|' then Result := 'bitor'
  else if op = '^' then Result := 'bitxor'
  else if op = '<<' then Result := 'shl'
  else if op = '>>' then Result := 'shr'
  else Result := '';
end;

function OpTraitFor(const op: string; assign: Boolean): Integer;
var
  nm: string;
begin
  nm := OpMethodName(op);
  Result := 0;
  if nm = '' then Exit;
  if assign then Result := HFind(OpTraits, 'asg' + op) else Result := HFind(OpTraits, 'bin' + op);
  if Result < 0 then Result := 0;
end;

function IsUnsafeFn(def: Integer): Boolean;
begin
  Result := (Defs[def].kind = dkFn) and ((Nodes[Defs[def].node].f and fUnsafe) <> 0);
end;

procedure RequireUnsafe(node: Integer; const what: string);
begin
  if (Cxs[CxTop].unsafeDepth > 0) or (Defs[Cxs[CxBase + 1].env.defn].crate = 1) then Exit;
  if Cxs[CxBase + 1].env.defn >= 0 then
    if (Defs[Cxs[CxBase + 1].env.defn].kind = dkFn) and IsUnsafeFn(Cxs[CxBase + 1].env.defn) then Exit;
  ErrAt(node, 'E0133', what + ' is unsafe and requires unsafe function or block',
        'unsafe operation');
  Note('consult the Rustonomicon for information about unsafe code');
end;

{ ---- litteraux ---- }

function CheckLit(n: Integer; expected: Integer): Integer;
var
  ty, e, k: Integer;
  h: Integer;
  sfx: string;
begin
  case Nodes[n].f of
    lkInt:
      begin
        sfx := Nodes[n].s2;
        if sfx <> '' then
        begin
          ty := PrimTy(sfx);
          if (ty < 0) or not ((Tys[ty].k = tyInt) or (Tys[ty].k = tyFloat)) then
          begin
            ErrAt(n, '', 'invalid suffix `' + sfx + '` for number literal', 'invalid suffix `' + sfx + '`');
            ty := TyErrT;
          end;
        end
        else
        begin
          ty := NewTyVar(1);
          if expected <> 0 then
          begin
            e := Shallow(expected);
            if (Tys[e].k = tyInt) or IsIntVar(e) then Unify(ty, e);
          end;
        end;
        if (ty >= 0) and (Tys[ty].k = tyFloat) then
        begin
          h := HirAt(hLitFloat, ty, n);
          Hirs[h].fv := Nodes[n].iv;
        end
        else
        begin
          h := HirAt(hLitInt, ty, n);
          Hirs[h].n := Int64(Nodes[n].iv);
        end;
        Result := h;
      end;
    lkFloat:
      begin
        sfx := Nodes[n].s2;
        if sfx = 'f32' then ty := TyF32
        else if sfx = 'f64' then ty := TyF64
        else
        begin
          ty := NewTyVar(2);
          if expected <> 0 then
          begin
            e := Shallow(expected);
            if (Tys[e].k = tyFloat) or IsFloatVar(e) then Unify(ty, e);
          end;
        end;
        h := HirAt(hLitFloat, ty, n);
        Hirs[h].fv := Nodes[n].fv;
        Result := h;
      end;
    lkStr: Result := HStrLit(Nodes[n].s, n);
    lkChar:
      begin
        h := HirAt(hLitChar, TyCharT, n);
        Hirs[h].n := Int64(Nodes[n].iv);
        Result := h;
      end;
    lkBool:
      begin
        h := HirAt(hLitBool, TyBoolT, n);
        Hirs[h].n := Int64(Nodes[n].iv);
        Result := h;
      end;
    lkByte:
      begin
        h := HirAt(hLitInt, TyU8, n);
        Hirs[h].n := Int64(Nodes[n].iv);
        Result := h;
      end;
    lkByteStr:
      begin
        ty := MkRef(MkArray(TyU8, MkConstTy(Length(Nodes[n].s))), False);
        h := HirAt(hLitByteStr, ty, n);
        Hirs[h].s := Nodes[n].s;
        Result := h;
      end;
  else
    Result := HUnitOf(n);
  end;
end;

{ ---- derefs ---- }

function DerefTraitFn(mutable: Boolean): Integer;
begin
  if mutable then Result := DerefMutFn else Result := DerefFn;
end;

{ *Deref::deref(&h) : h est une place de type U implementant Deref }
function CheckDerefCall(h: Integer; mutable: Boolean; node: Integer): Integer;
var
  u, tgt, call, addr: Integer;
  targs: TIntArr;
  args: TIntArr;
  rt: Integer;
begin
  u := Hirs[h].ty;
  SetLength(targs, 1);
  targs[0] := u;
  tgt := ProjectAssoc(u, LangDeref, targs, 'Target', 0);
  addr := HAddrOf(h, mutable, node);
  SetLength(args, 1);
  args[0] := addr;
  rt := MkRef(tgt, mutable);
  call := HCallFn(DerefTraitFn(mutable), targs, args, rt, node);
  Result := HirAt(hDeref, tgt, node);
  Hirs[Result].a := call;
end;

{ Un pas d'auto-deref sur une place : retourne -1 si impossible }
function AutoDerefPlace(h: Integer; node: Integer): Integer;
var
  t, nx, k, f: Integer;
begin
  Result := -1;
  t := StructResolve(Hirs[h].ty);
  nx := DerefOnce(t, k);
  if nx = 0 then Exit;
  if k = 1 then
  begin
    if IsBoxTy(t) then
    begin
      { Box<T> : champ 0 = pointeur brut }
      f := HirAt(hField, MkPtr(nx, True), node);
      Hirs[f].a := h;
      Hirs[f].n := 0;
      Result := HirAt(hDeref, nx, node);
      Hirs[Result].a := f;
    end
    else
    begin
      Result := HirAt(hDeref, nx, node);
      Hirs[Result].a := h;
    end;
  end
  else Result := CheckDerefCall(h, False, node);
end;

{ Rend une place modifiable : remplace Deref/Index par DerefMut/IndexMut }
function MakeMutPlace(h: Integer): Integer;
var
  c, f, addr, base, t: Integer;
begin
  Result := h;
  case Hirs[h].k of
    hField, hIndex:
      begin
        MakeMutPlace(Hirs[h].a);
      end;
    hDeref:
      begin
        c := Hirs[h].a;
        if (Hirs[c].k = hCall) and (Hirs[Hirs[c].a].k = hFnRef) then
        begin
          f := Hirs[c].a;
          if Hirs[f].def = DerefFn then
          begin
            Hirs[f].def := DerefMutFn;
            Hirs[f].ty := MkFnDef(DerefMutFn, Hirs[f].targs);
            addr := Hirs[c].l[0];
            base := Hirs[addr].a;
            Hirs[addr].n := 1;
            Hirs[addr].ty := MkRef(Hirs[base].ty, True);
            Hirs[c].ty := MkRef(Hirs[h].ty, True);
            MakeMutPlace(base);
          end
          else if Hirs[f].def = IndexFn then
          begin
            Hirs[f].def := IndexMutFn;
            Hirs[f].ty := MkFnDef(IndexMutFn, Hirs[f].targs);
            addr := Hirs[c].l[0];
            base := Hirs[addr].a;
            Hirs[addr].n := 1;
            Hirs[addr].ty := MkRef(Hirs[base].ty, True);
            Hirs[c].ty := MkRef(Hirs[h].ty, True);
            MakeMutPlace(base);
          end;
        end
        else if (Hirs[c].k = hField) and IsBoxTy(Hirs[Hirs[c].a].ty) then
          MakeMutPlace(Hirs[c].a);
      end;
  end;
end;

{ Description d'une place pour les messages d'erreur }
function PlaceDesc(h: Integer): string;
begin
  case Hirs[h].k of
    hLocal: Result := Bodies[Cxs[CxTop].body].vars[Hirs[h].n].name;
    hField: Result := PlaceDesc(Hirs[h].a) + '.' + IntToStr(Hirs[h].n);
    hDeref: Result := '*' + PlaceDesc(Hirs[h].a);
  else
    Result := 'value';
  end;
end;

function VarNameOf(h: Integer): string;
begin
  case Hirs[h].k of
    hLocal: Result := Bodies[Cxs[CxTop].body].vars[Hirs[h].n].name;
    hUpvar: Result := Closures[Cxs[CxTop].closure].capKeys[Hirs[h].n];
    hField, hIndex: Result := VarNameOf(Hirs[h].a);
    hDeref: Result := VarNameOf(Hirs[h].a);
  else
    Result := '';
  end;
end;

{ Verifie qu'une place peut etre modifiee ; retourne le message d'erreur ou '' }
function PlaceMutError(h: Integer; var bad: Integer): string;
var
  t, b, v: Integer;
  nm: string;
begin
  Result := '';
  bad := h;
  case Hirs[h].k of
    hLocal:
      begin
        v := Hirs[h].n;
        if not Bodies[Cxs[CxTop].body].vars[v].mut then Result := 'local:' + Bodies[Cxs[CxTop].body].vars[v].name;
      end;
    hUpvar:
      begin
        Result := '';
      end;
    hStatic:
      begin
        if (Nodes[Defs[Hirs[h].def].node].f and fMutStatic) = 0 then Result := 'static:' + Defs[Hirs[h].def].name;
      end;
    hField, hIndex:
      Result := PlaceMutError(Hirs[h].a, bad);
    hDeref:
      begin
        b := Hirs[h].a;
        t := Shallow(Hirs[b].ty);
        case Tys[t].k of
          tyRef:
            if (Tys[t].f and 1) = 0 then Result := 'ref:' + PlaceDesc(b);
          tyPtr:
            if (Tys[t].f and 1) = 0 then Result := 'ptr:' + PlaceDesc(b);
        else
          { Deref via appel : examiner la base }
          if (Hirs[b].k = hCall) and (Hirs[Hirs[b].a].k = hFnRef) then
            Result := PlaceMutError(Hirs[Hirs[b].l[0]].a, bad)
          else if Hirs[b].k = hField then
            Result := PlaceMutError(Hirs[b].a, bad);
        end;
        if (Tys[t].k = tyRef) and ((Tys[t].f and 1) <> 0) then Result := '';
      end;
  end;
end;

procedure CheckMutable(h: Integer; node: Integer; assign: Boolean);
var
  r: string;
  bad: Integer;
  nm: string;
begin
  r := PlaceMutError(h, bad);
  if r = '' then Exit;
  nm := Copy(r, Pos(':', r) + 1, Length(r));
  if StartsWith(r, 'local:') then
  begin
    if assign then
    begin
      ErrAtHir(h, 'E0384', 'cannot assign twice to immutable variable `' + nm + '`',
               'cannot assign twice to immutable variable');
      Help('consider making this binding mutable: `mut ' + nm + '`');
    end
    else
    begin
      ErrAtHir(h, 'E0596', 'cannot borrow `' + nm + '` as mutable, as it is not declared as mutable',
               'cannot borrow as mutable');
      Help('consider changing this to be mutable: `mut ' + nm + '`');
    end;
  end
  else if StartsWith(r, 'static:') then
    ErrAtHir(h, 'E0594', 'cannot assign to immutable static item `' + nm + '`', 'cannot assign')
  else if StartsWith(r, 'ref:') then
  begin
    if assign then
      ErrAtHir(h, 'E0594', 'cannot assign to `' + nm + '`, which is behind a `&` reference',
               '`' + nm + '` is a `&` reference, so the data it refers to cannot be written')
    else
      ErrAtHir(h, 'E0596', 'cannot borrow `' + nm + '` as mutable, as it is behind a `&` reference',
               '`' + nm + '` is a `&` reference, so the data it refers to cannot be borrowed as mutable');
  end
  else
    ErrAtHir(h, 'E0594', 'cannot assign to data behind a `*const` raw pointer', 'cannot assign');
end;

{ ---- variables et captures ---- }

function LocalHir(level, v, node: Integer): Integer;
var
  lev, cid, idx, ty, srcH, i: Integer;
  key: string;
  nh: Integer;
begin
  ty := Bodies[Cxs[level].body].vars[v].ty;
  Bodies[Cxs[level].body].vars[v].used := True;
  if level = CxTop then
  begin
    Result := HirAt(hLocal, ty, node);
    Hirs[Result].n := v;
    Exit;
  end;
  srcH := HirAt(hLocal, ty, node);
  Hirs[srcH].n := v;
  key := IntToStr(level) + ':' + IntToStr(v);
  for lev := level + 1 to CxTop do
  begin
    cid := Cxs[lev].closure;
    idx := -1;
    for i := 0 to Length(Closures[cid].capKeys) - 1 do
      if Closures[cid].capKeys[i] = key then begin idx := i; Break; end;
    if idx < 0 then
    begin
      idx := Length(Closures[cid].capKeys);
      SAdd(Closures[cid].capKeys, key);
      IAdd(Closures[cid].capVars, srcH);
      IAdd(Closures[cid].capTys, ty);
    end;
    nh := HirAt(hUpvar, ty, node);
    Hirs[nh].n := idx;
    srcH := nh;
  end;
  Result := srcH;
end;

{ ---- chemin en position d'expression ---- }

function CtorFnTy(r: TValRes): Integer;
begin
  Result := MkFnDef(r.def, r.targs);
end;

function CheckPathExpr(n: Integer; expected: Integer): Integer;
var
  r: TValRes;
  p, h, ty, i: Integer;
  params: TIntArr;
  ret: Integer;
  names: TStrArr;
  isUnit: Boolean;
  pn: Integer;
begin
  p := Nodes[n].a;
  ResolveValuePath(p, r);
  case r.kind of
    vrLocal:
      begin
        Result := LocalHir(r.selfTy, r.def, n);
      end;
    vrFn:
      begin
        RegisterBounds(r.def, r.targs, n);
        Result := HirAt(hFnRef, MkFnDef(r.def, r.targs), n);
        Hirs[Result].def := r.def;
        Hirs[Result].targs := r.targs;
        if IsUnsafeFn(r.def) then ;
      end;
    vrConst:
      begin
        FnDefSig(r.def, r.targs, params, ret);
        Result := HirAt(hConstVal, ret, n);
        Hirs[Result].def := r.def;
        Hirs[Result].targs := r.targs;
      end;
    vrTraitConst:
      begin
        FnDefSig(r.def, r.targs, params, ret);
        Result := HirAt(hConstVal, ret, n);
        Hirs[Result].def := r.def;
        Hirs[Result].targs := r.targs;
      end;
    vrStatic:
      begin
        FnDefSig(r.def, nil, params, ret);
        Result := HirAt(hStatic, ret, n);
        Hirs[Result].def := r.def;
        if (Nodes[Defs[r.def].node].f and fMutStatic) <> 0 then RequireUnsafe(n, 'use of mutable static');
        if Defs[r.def].isExtern then RequireUnsafe(n, 'use of extern static');
      end;
    vrStruct, vrVariant:
      begin
        if r.kind = vrStruct then pn := Defs[r.def].node else pn := Defs[r.def].node;
        isUnit := IsUnitLike(pn);
        if r.kind = vrVariant then ty := MkAdt(Defs[r.def].parent, r.targs) else ty := MkAdt(r.def, r.targs);
        if isUnit then
        begin
          Result := HirAt(hAdt, ty, n);
          Hirs[Result].def := r.def;
          Hirs[Result].l := nil;
          if r.kind = vrVariant then Hirs[Result].n := Defs[r.def].vindex;
        end
        else if IsTupleLike(pn) then
        begin
          Result := HirAt(hFnRef, MkFnDef(r.def, r.targs), n);
          Hirs[Result].def := r.def;
          Hirs[Result].targs := r.targs;
        end
        else
        begin
          ErrAt(n, 'E0533', 'expected value, found struct variant `' + Defs[r.def].name + '`', 'not a value');
          Result := HirAt(hUnit, TyErrT, n);
        end;
      end;
  else
    if r.def = -2 then
    begin
      { parametre const generique : valeur }
      ty := Shallow(r.selfTy);
      Result := HIntLit(TyUsize, Tys[ty].n, n);
    end
    else
    begin
      Result := HirAt(hUnit, TyErrT, n);
    end;
  end;
end;

{ ---- operateurs ---- }

function StripRefs(h: Integer; node: Integer): Integer;
var
  t: Integer;
begin
  Result := h;
  while True do
  begin
    t := Shallow(Hirs[Result].ty);
    if Tys[t].k <> tyRef then Break;
    Result := HDerefOf(Result, node);
    Hirs[Result].line := Hirs[h].line; Hirs[Result].col := Hirs[h].col; Hirs[Result].fi := Hirs[h].fi; Hirs[Result].len := Hirs[h].len;
  end;
end;

function RefDepthPrim(t: Integer): Boolean;
begin
  t := Shallow(t);
  while Tys[t].k = tyRef do t := Shallow(Tys[t].args[0]);
  Result := IsPrimScalar(t);
end;

function CallTraitMethod(trait: Integer; const mname: string; const targs: TIntArr; const args: TIntArr;
  retTy: Integer; node: Integer): Integer;
var
  item: Integer;
begin
  item := TraitAssocItem(trait, mname, dkFn);
  Result := HCallFn(item, targs, args, retTy, node);
end;

function OpErrNode(n: Integer): Integer;
begin
  Result := n;
end;

function CheckBinary(n: Integer; expected: Integer): Integer;
var
  op: string;
  l, r, lt, rt, h, tr, i: Integer;
  isCmp, isShift, isBit, lprim, rprim, lcmp: Boolean;
  targs, args: TIntArr;
  outTy: Integer;
  mname: string;
  lhsE: Integer;
  e: Integer;
begin
  op := Nodes[n].s;
  { operateurs logiques paresseux }
  if (op = '&&') or (op = '||') then
  begin
    l := CheckExprCoerce(Nodes[n].a, TyBoolT);
    r := CheckExprCoerce(Nodes[n].b, TyBoolT);
    if op = '&&' then h := HirAt(hAnd, TyBoolT, n) else h := HirAt(hOr, TyBoolT, n);
    Hirs[h].a := l;
    Hirs[h].b := r;
    Result := h;
    Exit;
  end;
  isCmp := (op = '==') or (op = '!=') or (op = '<') or (op = '>') or (op = '<=') or (op = '>=');
  isShift := (op = '<<') or (op = '>>');
  isBit := (op = '&') or (op = '|') or (op = '^');
  if isCmp then lhsE := 0 else lhsE := expected;
  l := CheckExpr(Nodes[n].a, lhsE);
  lt := StructResolve(Hirs[l].ty);
  if IsNumericTy(lt) and (not isShift) then rt := lt else rt := 0;
  r := CheckExpr(Nodes[n].b, rt);
  rt := StructResolve(Hirs[r].ty);
  if (Tys[lt].k = tyErr) or (Tys[rt].k = tyErr) then
  begin
    h := HirAt(hBinary, TyErrT, n);
    Hirs[h].s := op; Hirs[h].a := l; Hirs[h].b := r;
    Result := h;
    Exit;
  end;
  { references a des primitives : deref automatique }
  lprim := RefDepthPrim(lt);
  rprim := RefDepthPrim(rt);
  lcmp := False;
  if (lprim and rprim) or ((lprim or rprim) and (Tys[lt].k = tyVar) or (Tys[rt].k = tyVar)) then
  begin
    if (Tys[lt].k = tyRef) and (Tys[rt].k = tyRef) and isCmp then ;
    l := StripRefs(l, n);
    r := StripRefs(r, n);
    lt := StructResolve(Hirs[l].ty);
    rt := StructResolve(Hirs[r].ty);
  end;
  if (IsPrimScalar(lt) or (Tys[lt].k = tyVar)) and (IsPrimScalar(rt) or (Tys[rt].k = tyVar)) and
     not ((Tys[lt].k = tyVar) and (VarKind[Tys[lt].n] = 0) and (Tys[rt].k = tyAdt)) then
  begin
    if isShift then
    begin
      if not (IsIntegralTy(lt) and IsIntegralTy(rt)) then
        ErrAt(n, 'E0369', 'no implementation for `' + TyStrZ(lt) + ' ' + op + ' ' + TyStrZ(rt) + '`', '');
      h := HirAt(hBinary, lt, n);
    end
    else
    begin
      if not TryUnify(lt, rt) then
      begin
        { divergence de types : message rustc }
        if isCmp or True then
        begin
          if (IsNumericTy(lt) and IsNumericTy(rt)) or (Tys[lt].k = tyBool) or (Tys[lt].k = tyChar) then
            ErrAt(Nodes[n].b, 'E0308', 'mismatched types', 'expected `' + TyStrZ(lt) + '`, found `' + TyStrZ(rt) + '`')
          else
            ErrAt(n, 'E0369', 'binary operation `' + op + '` cannot be applied to type `' + TyStrZ(lt) + '`',
                  '');
        end;
      end;
      if isCmp then h := HirAt(hBinary, TyBoolT, n)
      else
      begin
        if (Tys[Shallow(lt)].k = tyBool) and not (isBit) then
          ErrAt(n, 'E0369', 'cannot apply `' + op + '` to type `bool`', '');
        if (Tys[Shallow(lt)].k = tyChar) and not isCmp then
          ErrAt(n, 'E0369', 'cannot apply `' + op + '` to type `char`', '');
        if IsFloatTy(lt) and isBit then
          ErrAt(n, 'E0369', 'no implementation for `' + TyStrZ(lt) + ' ' + op + ' ' + TyStrZ(rt) + '`', '');
        h := HirAt(hBinary, lt, n);
      end;
    end;
    Hirs[h].s := op;
    Hirs[h].a := l;
    Hirs[h].b := r;
    Result := h;
    Exit;
  end;
  { operateur surcharge : appel de methode du trait }
  if isCmp then
  begin
    if (op = '==') or (op = '!=') then tr := LangPartialEq else tr := LangPartialOrd;
    if op = '==' then mname := 'eq'
    else if op = '!=' then mname := 'ne'
    else if op = '<' then mname := 'lt'
    else if op = '<=' then mname := 'le'
    else if op = '>' then mname := 'gt'
    else mname := 'ge';
    SetLength(targs, 2);
    targs[0] := lt;
    targs[1] := rt;
    AddObl(oblTrait, lt, tr, targs, '', 0, n);
    SolveObligations;
    SetLength(args, 2);
    args[0] := HAddrOf(l, False, Nodes[n].a);
    args[1] := HAddrOf(r, False, Nodes[n].b);
    Result := CallTraitMethod(tr, mname, targs, args, TyBoolT, n);
    Exit;
  end;
  tr := OpTraitFor(op, False);
  if tr = 0 then
  begin
    ErrAt(n, 'E0369', 'binary operation `' + op + '` cannot be applied to type `' + TyStrZ(lt) + '`', '');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  SetLength(targs, 2);
  targs[0] := lt;
  targs[1] := rt;
  { l'impl doit exister }
  if Tys[lt].k <> tyVar then
  begin
    SetLength(args, 0);
    e := SelectImpl(tr, targs, i, args, False);
    if e = 0 then
    begin
      ErrAt(n, 'E0369', 'cannot ' + OpMethodName(op) + ' `' + TyStrZ(rt) + '` ' +
            'to `' + TyStrZ(lt) + '`', '');
      if (op = '+') then
        ErrAt(n, 'E0369', 'cannot add `' + TyStrZ(rt) + '` to `' + TyStrZ(lt) + '`', 'no implementation for `' +
              TyStrZ(lt) + ' + ' + TyStrZ(rt) + '`');
      Result := HirAt(hUnit, TyErrT, n);
      Exit;
    end;
  end;
  outTy := ProjectAssoc(lt, tr, targs, 'Output', n);
  SetLength(args, 2);
  args[0] := l;
  args[1] := r;
  Result := CallTraitMethod(tr, OpMethodName(op), targs, args, outTy, n);
end;

function CheckUnary(n: Integer; expected: Integer): Integer;
var
  a, h, t: Integer;
  op: string;
  targs, args: TIntArr;
  tr, outTy: Integer;
begin
  op := Nodes[n].s;
  a := CheckExpr(Nodes[n].a, expected);
  t := StructResolve(Hirs[a].ty);
  if Tys[t].k = tyErr then begin Result := a; Exit; end;
  if (Tys[t].k = tyRef) and RefDepthPrim(t) then
  begin
    a := StripRefs(a, n);
    t := StructResolve(Hirs[a].ty);
  end;
  if op = '-' then
  begin
    if (Hirs[a].k = hLitInt) and (Tys[t].k <> tyFloat) then
    begin
      { litteral negatif }
      h := HirAt(hLitInt, Hirs[a].ty, n);
      Hirs[h].n := -Hirs[a].n;
      Hirs[h].s := '-';
      Result := h;
      Exit;
    end;
    if (Hirs[a].k = hLitFloat) then
    begin
      h := HirAt(hLitFloat, Hirs[a].ty, n);
      Hirs[h].fv := -Hirs[a].fv;
      Result := h;
      Exit;
    end;
    if IsNumericTy(t) or (Tys[t].k = tyVar) then
    begin
      if IsIntTy(t) and (not IsSigned(t)) then
        ErrAt(n, 'E0600', 'cannot apply unary operator `-` to type `' + TyStrZ(t) + '`',
              'cannot apply unary operator `-`');
      h := HirAt(hUnary, t, n);
      Hirs[h].n := 1;
      Hirs[h].a := a;
      Result := h;
      Exit;
    end;
    tr := HFind(OpTraits, 'neg');
    if tr < 0 then tr := 0;
    if tr = 0 then begin Result := a; Exit; end;
    SetLength(targs, 1);
    targs[0] := t;
    outTy := ProjectAssoc(t, tr, targs, 'Output', n);
    SetLength(args, 1);
    args[0] := a;
    Result := CallTraitMethod(tr, 'neg', targs, args, outTy, n);
    Exit;
  end;
  { ! }
  if (Tys[t].k = tyBool) or IsIntegralTy(t) or (Tys[t].k = tyVar) then
  begin
    h := HirAt(hUnary, t, n);
    Hirs[h].n := 2;
    Hirs[h].a := a;
    Result := h;
    Exit;
  end;
  tr := HFind(OpTraits, 'not');
  if tr < 0 then tr := 0;
  if tr = 0 then begin Result := a; Exit; end;
  SetLength(targs, 1);
  targs[0] := t;
  outTy := ProjectAssoc(t, tr, targs, 'Output', n);
  SetLength(args, 1);
  args[0] := a;
  Result := CallTraitMethod(tr, 'not', targs, args, outTy, n);
end;

function CheckExprCoerce(n: Integer; target: Integer): Integer;
var
  h: Integer;
begin
  h := CheckExpr(n, target);
  Result := CoerceTo(h, target, n);
end;

function CheckAssign(n: Integer): Integer;
var
  l, r, h, tmp, v, i, e, a: Integer;
  lt: Integer;
  stmts: TIntArr;
  lhs: Integer;
begin
  lhs := Nodes[n].a;
  { _ = expr }
  if Nodes[lhs].k = eUnderscore then
  begin
    r := CheckExpr(Nodes[n].b, 0);
    Result := HirAt(hBlock, TyUnit, n);
    SetLength(stmts, 1);
    stmts[0] := HirAt(hExprStmt, TyUnit, n);
    Hirs[stmts[0]].a := r;
    Hirs[Result].l := stmts;
    Exit;
  end;
  { affectation destructurante (a, b) = (x, y) }
  if Nodes[lhs].k = eTuple then
  begin
    r := CheckExpr(Nodes[n].b, 0);
    v := NewVarInfo('__tmp', Hirs[r].ty, False, n);
    stmts := nil;
    i := NewPat(pkBind, Hirs[r].ty);
    Pats[i].v := v;
    PatPos(i, n);
    h := HirAt(hLet, TyUnit, n);
    Hirs[h].n := i;
    Hirs[h].a := r;
    IAdd(stmts, h);
    for i := 0 to Length(Nodes[lhs].l) - 1 do
    begin
      if Nodes[Nodes[lhs].l[i]].k = eUnderscore then Continue;
      l := CheckExpr(Nodes[lhs].l[i], 0);
      CheckMutable(l, Nodes[lhs].l[i], True);
      MakeMutPlace(l);
      tmp := HirAt(hLocal, Hirs[r].ty, n);
      Hirs[tmp].n := v;
      e := HirAt(hField, 0, n);
      Hirs[e].a := tmp;
      Hirs[e].n := i;
      if Tys[Shallow(Hirs[r].ty)].k = tyTuple then
        Hirs[e].ty := Tys[Shallow(Hirs[r].ty)].args[i]
      else
        Hirs[e].ty := Hirs[l].ty;
      TryUnify(Hirs[l].ty, Hirs[e].ty);
      a := HirAt(hAssign, TyUnit, n);
      Hirs[a].a := l;
      Hirs[a].b := e;
      h := HirAt(hExprStmt, TyUnit, n);
      Hirs[h].a := a;
      IAdd(stmts, h);
    end;
    Result := HBlockOf(stmts, 0, TyUnit, n);
    Exit;
  end;
  l := CheckExpr(lhs, 0);
  if not IsPlaceHir(l) then
  begin
    ErrAt(lhs, 'E0070', 'invalid left-hand side of assignment', 'cannot assign to this expression');
  end
  else
  begin
    CheckMutable(l, lhs, True);
    MakeMutPlace(l);
  end;
  r := CheckExprCoerce(Nodes[n].b, Hirs[l].ty);
  h := HirAt(hAssign, TyUnit, n);
  Hirs[h].a := l;
  Hirs[h].b := r;
  Result := h;
end;

function CheckAssignOp(n: Integer): Integer;
var
  op: string;
  l, r, h, tr, lt, rt: Integer;
  targs, args: TIntArr;
  isShift: Boolean;
  addr: Integer;
  i: Integer;
begin
  op := Nodes[n].s;
  isShift := (op = '<<') or (op = '>>');
  l := CheckExpr(Nodes[n].a, 0);
  lt := StructResolve(Hirs[l].ty);
  if IsNumericTy(lt) and (not isShift) then rt := lt else rt := 0;
  r := CheckExpr(Nodes[n].b, rt);
  rt := StructResolve(Hirs[r].ty);
  if Tys[rt].k = tyRef then
  begin
    if RefDepthPrim(rt) then begin r := StripRefs(r, n); rt := StructResolve(Hirs[r].ty); end;
  end;
  if not IsPlaceHir(l) then
    ErrAt(Nodes[n].a, 'E0067', 'invalid left-hand side of compound assignment', 'cannot assign to this expression')
  else
  begin
    CheckMutable(l, Nodes[n].a, True);
  end;
  if (IsPrimScalar(lt) or (Tys[lt].k = tyVar)) and (IsPrimScalar(rt) or (Tys[rt].k = tyVar)) then
  begin
    MakeMutPlace(l);
    if not isShift then
    begin
      if not TryUnify(lt, rt) then
        ErrAt(Nodes[n].b, 'E0308', 'mismatched types', 'expected `' + TyStrZ(lt) + '`, found `' + TyStrZ(rt) + '`');
    end;
    h := HirAt(hAssignOp, TyUnit, n);
    Hirs[h].s := op;
    Hirs[h].a := l;
    Hirs[h].b := r;
    Result := h;
    Exit;
  end;
  tr := OpTraitFor(op, True);
  if tr = 0 then
  begin
    ErrAt(n, 'E0368', 'binary assignment operation `' + op + '=` cannot be applied to type `' + TyStrZ(lt) + '`', '');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  MakeMutPlace(l);
  SetLength(targs, 2);
  targs[0] := lt;
  targs[1] := rt;
  AddObl(oblTrait, lt, tr, targs, '', 0, n);
  SetLength(args, 2);
  args[0] := HAddrOf(l, True, Nodes[n].a);
  args[1] := r;
  Result := CallTraitMethod(tr, OpMethodName(op) + '_assign', targs, args, TyUnit, n);
end;

function CheckCast(n: Integer): Integer;
var
  a, h, tgt, src: Integer;
  hint: Integer;
begin
  tgt := LowerInCtx(Nodes[n].b);
  hint := 0;
  src := 0;
  a := CheckExpr(Nodes[n].a, 0);
  src := StructResolve(Hirs[a].ty);
  { litteral sans suffixe converti : le type du litteral reste libre (i32 par defaut) }
  if (Tys[src].k = tyVar) and (VarKind[Tys[src].n] = 0) then TryUnify(src, tgt);
  { coercion simple (ex. &x as &dyn T, &[..] as &[..]) }
  h := HirAt(hCast, tgt, n);
  Hirs[h].a := a;
  Result := h;
end;

function CheckRefExpr(n: Integer; expected: Integer): Integer;
var
  a, h, e, t: Integer;
  mut: Boolean;
  hint: Integer;
begin
  mut := (Nodes[n].f and 1) <> 0;
  hint := 0;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if (Tys[e].k = tyRef) or (Tys[e].k = tyPtr) then
    begin
      hint := Tys[e].args[0];
      if (Tys[Shallow(hint)].k = tySlice) or (Tys[Shallow(hint)].k = tyStr) or (Tys[Shallow(hint)].k = tyDyn) then
      begin
        { l'operande sera dimensionne : indice partiel }
        if Tys[Shallow(hint)].k = tySlice then hint := 0 else hint := 0;
      end;
    end;
  end;
  a := CheckExpr(Nodes[n].a, hint);
  if mut then
  begin
    if IsPlaceHir(a) then
    begin
      CheckMutable(a, Nodes[n].a, False);
      MakeMutPlace(a);
    end;
  end;
  if (Nodes[n].f and 2) <> 0 then
  begin
    h := HirAt(hAddr, MkPtr(Hirs[a].ty, mut), n);
    Hirs[h].a := a;
    Hirs[h].n := 2 + Ord(mut);
    Result := h;
    Exit;
  end;
  h := HAddrOf(a, mut, n);
  Result := h;
end;

function CheckDerefExpr(n: Integer): Integer;
var
  a, h, t, nx, k: Integer;
begin
  a := CheckExpr(Nodes[n].a, 0);
  t := StructResolve(Hirs[a].ty);
  case Tys[t].k of
    tyErr: begin Result := a; Exit; end;
    tyRef:
      begin
        h := HirAt(hDeref, Tys[t].args[0], n);
        Hirs[h].a := a;
        Result := h;
        Exit;
      end;
    tyPtr:
      begin
        RequireUnsafe(n, 'dereference of raw pointer');
        h := HirAt(hDeref, Tys[t].args[0], n);
        Hirs[h].a := a;
        Result := h;
        Exit;
      end;
  end;
  nx := DerefOnce(t, k);
  if nx = 0 then
  begin
    ErrAt(n, 'E0614', 'type `' + TyStrZ(t) + '` cannot be dereferenced', '');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  if IsBoxTy(t) then
  begin
    h := HirAt(hField, MkPtr(nx, True), n);
    Hirs[h].a := a;
    Hirs[h].n := 0;
    Result := HirAt(hDeref, nx, n);
    Hirs[Result].a := h;
    Exit;
  end;
  if not IsPlaceHir(a) then
  begin
    { temporaire }
  end;
  Result := CheckDerefCall(a, False, n);
  Hirs[Result].line := Nodes[n].line;
  Hirs[Result].col := Nodes[n].col;
  Hirs[Result].fi := Nodes[n].fi;
end;

{ ---- champs ---- }

function FieldIndexOf(structDef: Integer; const name: string): Integer;
var
  i, nd: Integer;
begin
  Result := -1;
  nd := Defs[structDef].node;
  for i := 0 to Length(Nodes[nd].l2) - 1 do
    if Nodes[Nodes[nd].l2[i]].s = name then begin Result := i; Exit; end;
end;

function FieldTyOf(adt: Integer; vdef: Integer; idx: Integer): Integer;
var
  env: TEnv;
  nd: Integer;
begin
  EnvForDef(vdef, Tys[adt].args, env);
  env.infer := True;
  nd := Defs[vdef].node;
  Result := LowerTy(Nodes[Nodes[nd].l2[idx]].a, env);
end;

function CheckField(n: Integer): Integer;
var
  base, cur, t, idx, h, steps: Integer;
  name: string;
begin
  base := CheckExpr(Nodes[n].a, 0);
  name := Nodes[n].s;
  cur := base;
  for steps := 0 to 12 do
  begin
    t := StructResolve(Hirs[cur].ty);
    if Tys[t].k = tyErr then begin Result := cur; Exit; end;
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkStruct) and (not IsTupleLike(Defs[Tys[t].def].node)) then
    begin
      idx := FieldIndexOf(Tys[t].def, name);
      if idx >= 0 then
      begin
        h := HirAt(hField, FieldTyOf(t, Tys[t].def, idx), n);
        Hirs[h].a := cur;
        Hirs[h].n := idx;
        Result := h;
        Exit;
      end;
    end;
    h := AutoDerefPlace(cur, n);
    if h < 0 then Break;
    cur := h;
  end;
  t := StructResolve(Hirs[base].ty);
  ErrAt(n, 'E0609', 'no field `' + name + '` on type `' + TyStrZ(t) + '`', 'unknown field');
  Result := HirAt(hUnit, TyErrT, n);
end;

function CheckTupleField(n: Integer): Integer;
var
  base, cur, t, h, steps: Integer;
  idx: Integer;
begin
  base := CheckExpr(Nodes[n].a, 0);
  idx := Integer(Nodes[n].iv);
  cur := base;
  for steps := 0 to 12 do
  begin
    t := StructResolve(Hirs[cur].ty);
    if Tys[t].k = tyErr then begin Result := cur; Exit; end;
    if (Tys[t].k = tyTuple) and (idx < Length(Tys[t].args)) then
    begin
      h := HirAt(hField, Tys[t].args[idx], n);
      Hirs[h].a := cur;
      Hirs[h].n := idx;
      Result := h;
      Exit;
    end;
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkStruct) and IsTupleLike(Defs[Tys[t].def].node) and
       (idx < Defs[Tys[t].def].fieldCount) then
    begin
      h := HirAt(hField, FieldTyOf(t, Tys[t].def, idx), n);
      Hirs[h].a := cur;
      Hirs[h].n := idx;
      Result := h;
      Exit;
    end;
    h := AutoDerefPlace(cur, n);
    if h < 0 then Break;
    cur := h;
  end;
  t := StructResolve(Hirs[base].ty);
  ErrAt(n, 'E0609', 'no field `' + IntToStr(idx) + '` on type `' + TyStrZ(t) + '`', 'unknown field');
  Result := HirAt(hUnit, TyErrT, n);
end;

{ ---- indexation ---- }

function CheckIndex(n: Integer): Integer;
var
  base, idx, cur, t, h, steps, it, tr, outTy, c: Integer;
  targs, args, ia: TIntArr;
  impl: Integer;
  r: Integer;
  addr: Integer;
begin
  base := CheckExpr(Nodes[n].a, 0);
  idx := CheckExpr(Nodes[n].b, 0);
  it := StructResolve(Hirs[idx].ty);
  cur := base;
  for steps := 0 to 12 do
  begin
    t := StructResolve(Hirs[cur].ty);
    if Tys[t].k = tyErr then begin Result := cur; Exit; end;
    if ((Tys[t].k = tyArray) or (Tys[t].k = tySlice)) and (IsIntegralTy(it)) then
    begin
      if not TryUnify(it, TyUsize) then
      begin
        ErrAt(Nodes[n].b, 'E0277', 'the type `[' + TyStrZ(Tys[t].args[0]) + ']` cannot be indexed by `' + TyStrZ(it) + '`',
              'slice indices are of type `usize` or ranges of `usize`');
      end;
      h := HirAt(hIndex, Tys[t].args[0], n);
      Hirs[h].a := cur;
      Hirs[h].b := idx;
      Result := h;
      Exit;
    end;
    { trait Index<Idx> }
    SetLength(targs, 2);
    targs[0] := t;
    targs[1] := it;
    if (Tys[t].k <> tyVar) then
    begin
      Inc(SuppressDiag);
      r := SelectImpl(LangIndex, targs, impl, ia, True);
      Dec(SuppressDiag);
      if r <> 0 then
      begin
        outTy := ProjectAssoc(t, LangIndex, targs, 'Output', n);
        SetLength(args, 2);
        args[0] := HAddrOf(cur, False, Nodes[n].a);
        args[1] := idx;
        c := CallTraitMethod(LangIndex, 'index', targs, args, MkRef(outTy, False), n);
        h := HirAt(hDeref, outTy, n);
        Hirs[h].a := c;
        Result := h;
        Exit;
      end;
    end;
    h := AutoDerefPlace(cur, n);
    if h < 0 then Break;
    cur := h;
  end;
  t := StructResolve(Hirs[base].ty);
  ErrAt(n, 'E0608', 'cannot index into a value of type `' + TyStrZ(t) + '`', '');
  Result := HirAt(hUnit, TyErrT, n);
end;

{ ============================================================ }
{ Verification des expressions (2) : appels, methodes,          }
{ constructeurs, intervalles                                    }
{ ============================================================ }

function PluralArgs(n: Integer): string;
begin
  if n = 1 then Result := ' argument' else Result := ' arguments';
end;

function WasWere(n: Integer): string;
begin
  if n = 1 then Result := ' was supplied' else Result := ' were supplied';
end;

{ Verifie les arguments d'un appel contre les types de parametres (offset = parametres deja fournis) }
procedure CheckCallArgs(callNode: Integer; const argNodes: TIntArr; const params: TIntArr; offset: Integer;
  variadic: Boolean; fnName: string; var outArgs: TIntArr);
var
  i, expect, pass, h: Integer;
  res: TIntArr;
  isClos: Boolean;
begin
  expect := Length(params) - offset;
  SetLength(res, Length(argNodes));
  for i := 0 to Length(res) - 1 do res[i] := -1;
  if (Length(argNodes) <> expect) and not (variadic and (Length(argNodes) >= expect)) then
  begin
    ErrAt(callNode, 'E0061', 'this ' + fnName + ' takes ' + IntToStr(expect) + PluralArgs(expect) + ' but ' +
          IntToStr(Length(argNodes)) + PluralArgs(Length(argNodes)) + WasWere(Length(argNodes)), '');
  end;
  for pass := 0 to 1 do
    for i := 0 to Length(argNodes) - 1 do
    begin
      isClos := Nodes[argNodes[i]].k = eClosure;
      if (pass = 0) = isClos then Continue;
      if i < expect then
        res[i] := CheckExprCoerce(argNodes[i], params[offset + i])
      else
        res[i] := CheckExpr(argNodes[i], 0);
    end;
  for i := 0 to Length(res) - 1 do
    if res[i] >= 0 then IAdd(outArgs, res[i]);
end;

function UnitCtorKind(def: Integer): Integer;
begin
  Result := 0;
end;

{ Appel d'une fonction connue (def, targs) avec arguments syntaxiques }
function CheckFnCall(n: Integer; def: Integer; const targs: TIntArr; const argNodes: TIntArr;
  recv: Integer; expected: Integer): Integer;
var
  params: TIntArr;
  ret: Integer;
  args: TIntArr;
  h, f, k, i, ty, e, adt: Integer;
  fname: string;
  variadic: Boolean;
  nd: Integer;
begin
  FnDefSig(def, targs, params, ret);
  if (Defs[def].kind = dkStruct) or (Defs[def].kind = dkVariant) then
  begin
    { constructeur de tuple }
    adt := Shallow(ret);
    if expected <> 0 then
    begin
      e := Shallow(expected);
      if (Tys[e].k = tyAdt) and (Tys[e].def = Tys[adt].def) then TryUnify(adt, e);
    end;
    args := nil;
    CheckCallArgs(n, argNodes, params, 0, False, 'struct', args);
    h := HirAt(hAdt, ret, n);
    Hirs[h].def := def;
    Hirs[h].l := args;
    if Defs[def].kind = dkVariant then Hirs[h].n := Defs[def].vindex;
    if Length(args) <> Length(params) then
      for i := Length(args) to Length(params) - 1 do begin k := HUnitOf(n); IAdd(Hirs[h].l, k); end;
    Result := h;
    Exit;
  end;
  nd := Defs[def].node;
  if Defs[def].kind <> dkFn then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
  if IsUnsafeFn(def) then
    if Defs[def].parent < 0 then RequireUnsafe(n, 'call to unsafe function `' + Defs[def].name + '`')
    else RequireUnsafe(n, 'call to unsafe method `' + Defs[def].name + '`');
  if Defs[def].isExtern then
    RequireUnsafe(n, 'call to unsafe function `' + Defs[def].name + '`');
  if (Defs[def].parent >= 0) and (Defs[def].selfKind <> 0) then fname := 'method' else fname := 'function';
  variadic := (Nodes[nd].f and fVariadic) <> 0;
  RegisterBounds(def, targs, n);
  { le type de retour attendu aide l'inference }
  if (expected <> 0) and (Tys[Shallow(ret)].k <> tyNever) then
  begin
    e := Shallow(expected);
    if (Tys[e].k <> tyVar) then TryUnify(ret, e);
  end;
  args := nil;
  if recv >= 0 then IAdd(args, recv);
  if recv >= 0 then
    CheckCallArgs(n, argNodes, params, 1, variadic, fname, args)
  else
    CheckCallArgs(n, argNodes, params, 0, variadic, fname, args);
  f := HirAt(hFnRef, MkFnDef(def, targs), n);
  Hirs[f].def := def;
  Hirs[f].targs := targs;
  h := HirAt(hCall, ret, n);
  Hirs[h].a := f;
  Hirs[h].l := args;
  Result := h;
end;

function CheckCall(n: Integer; expected: Integer): Integer;
var
  callee, r, p, c, ct, t, i, h, k, steps, nx: Integer;
  rv: TValRes;
  params: TIntArr;
  ret: Integer;
  args: TIntArr;
  argNodes: TIntArr;
  f: Integer;
  cur: Integer;
begin
  callee := Nodes[n].a;
  argNodes := Nodes[n].l;
  if Nodes[callee].k = ePath then
  begin
    ResolveValuePath(Nodes[callee].a, rv);
    case rv.kind of
      vrFn:
        begin
          Result := CheckFnCall(n, rv.def, rv.targs, argNodes, -1, expected);
          Exit;
        end;
      vrStruct, vrVariant:
        begin
          if IsTupleLike(Defs[rv.def].node) then
          begin
            Result := CheckFnCall(n, rv.def, rv.targs, argNodes, -1, expected);
            Exit;
          end;
          ErrAt(callee, 'E0618', 'expected function, found `' + Defs[rv.def].name + '`', '');
          Result := HirAt(hUnit, TyErrT, n);
          Exit;
        end;
      vrNone:
        begin
          Result := HirAt(hUnit, TyErrT, n);
          for i := 0 to Length(argNodes) - 1 do CheckExpr(argNodes[i], 0);
          Exit;
        end;
    end;
  end;
  c := CheckExpr(callee, 0);
  cur := c;
  for steps := 0 to 10 do
  begin
    ct := StructResolve(Hirs[cur].ty);
    case Tys[ct].k of
      tyErr:
        begin
          Result := HirAt(hUnit, TyErrT, n);
          for i := 0 to Length(argNodes) - 1 do CheckExpr(argNodes[i], 0);
          Exit;
        end;
      tyFnDef:
        begin
          Result := CheckFnCall(n, Tys[ct].def, Tys[ct].args, argNodes, -1, expected);
          Exit;
        end;
      tyFnPtr:
        begin
          SetLength(params, Length(Tys[ct].args) - 1);
          for i := 0 to Length(params) - 1 do params[i] := Tys[ct].args[i];
          ret := Tys[ct].args[Length(Tys[ct].args) - 1];
          args := nil;
          CheckCallArgs(n, argNodes, params, 0, False, 'function', args);
          h := HirAt(hCall, ret, n);
          Hirs[h].a := cur;
          Hirs[h].l := args;
          Result := h;
          Exit;
        end;
      tyClosure:
        begin
          params := Closures[Tys[ct].def].params;
          ret := Closures[Tys[ct].def].ret;
          args := nil;
          CheckCallArgs(n, argNodes, params, 0, False, 'function', args);
          h := HirAt(hCallClosure, ret, n);
          Hirs[h].a := cur;
          Hirs[h].l := args;
          Result := h;
          Exit;
        end;
      tyDyn:
        begin
          { dyn Fn(A) -> R }
          params := nil;
          if (Defs[Tys[ct].def].lang = 'fn') and (Length(Tys[ct].args) >= 2) then
          begin
            params := Tys[Shallow(Tys[ct].args[0])].args;
            ret := Tys[ct].args[1];
            args := nil;
            CheckCallArgs(n, argNodes, params, 0, False, 'function', args);
            h := HirAt(hCallClosure, ret, n);
            Hirs[h].a := cur;
            Hirs[h].l := args;
            Result := h;
            Exit;
          end;
          Break;
        end;
    end;
    nx := AutoDerefPlace(cur, callee);
    if nx < 0 then Break;
    cur := nx;
  end;
  ErrAt(callee, 'E0618', 'expected function, found `' + TyStrZ(Hirs[c].ty) + '`', 'call expression requires function');
  for i := 0 to Length(argNodes) - 1 do CheckExpr(argNodes[i], 0);
  Result := HirAt(hUnit, TyErrT, n);
end;

function KindWord(t: Integer): string;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyAdt:
      if Defs[Tys[t].def].kind = dkEnum then Result := 'enum' else Result := 'struct';
    tyRef: Result := 'reference';
    tyInt, tyFloat, tyBool, tyChar, tyStr: Result := 'type';
  else
    Result := 'type';
  end;
end;

function CheckMethodCall(n: Integer; expected: Integer): Integer;
var
  recvN, recv, t, i, adj, cur, nx, h, k: Integer;
  pr: TProbe;
  name: string;
  argNodes: TIntArr;
  targs: TIntArr;
  sp, tmpTy: Integer;
  own: Integer;
  nd: Integer;
  steps: Integer;
  baseTargs: TIntArr;
  nOwnExplicit: Integer;
  fld: Integer;
begin
  name := Nodes[n].s;
  argNodes := Nodes[n].l;
  recv := CheckExpr(Nodes[n].a, 0);
  t := StructResolve(Hirs[recv].ty);
  if Tys[t].k = tyErr then
  begin
    for i := 0 to Length(argNodes) - 1 do CheckExpr(argNodes[i], 0);
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  ProbeMethod(t, name, pr);
  if not pr.found then
  begin
    if (Tys[t].k = tyVar) and (VarKind[Tys[t].n] = 0) then
      ErrAt(Nodes[n].a, 'E0282', 'type annotations needed', 'cannot infer type')
    else if (Tys[t].k = tyVar) then
      ErrAt(n, 'E0689', 'can''t call method `' + name + '` on ambiguous numeric type `' + TyStrZ(t) + '`', '')
    else
      ErrAt(n, 'E0599', 'no method named `' + name + '` found for ' + KindWord(t) + ' `' + TyStrZ(t) +
            '` in the current scope', 'method not found in `' + TyStrZ(t) + '`');
    for i := 0 to Length(argNodes) - 1 do CheckExpr(argNodes[i], 0);
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  { ajustements du recepteur }
  cur := recv;
  for i := 1 to pr.steps do
  begin
    if pr.unsize and (i = pr.steps) then Break;
    nx := AutoDerefPlace(cur, n);
    if nx < 0 then Break;
    cur := nx;
  end;
  if pr.unsize then
  begin
    { cur : place de type tableau ; on veut &[T] }
    h := HAddrOf(cur, pr.adj = 2, n);
    if pr.adj = 2 then
    begin
      CheckMutable(cur, Nodes[n].a, False);
      MakeMutPlace(cur);
    end;
    cur := WrapCoerce(h, MkRef(MkSlice(Tys[Shallow(Hirs[cur].ty)].args[0]), pr.adj = 2), 3);
  end
  else
  begin
    case pr.adj of
      0:
        begin
          { reemprunt automatique d'un &mut passe par valeur }
          t := Shallow(Hirs[cur].ty);
          if (Tys[t].k = tyRef) and ((Tys[t].f and 1) <> 0) and IsPlaceHir(cur) then
          begin
            h := HDerefOf(cur, n);
            cur := HAddrOf(h, True, n);
          end;
        end;
      1: cur := HAddrOf(cur, False, n);
      2:
        begin
          if IsPlaceHir(cur) then
          begin
            CheckMutable(cur, Nodes[n].a, False);
            MakeMutPlace(cur);
          end;
          cur := HAddrOf(cur, True, n);
        end;
    end;
  end;
  { arguments generiques explicites ::<T> }
  targs := pr.fargs;
  if Length(Nodes[n].l2) > 0 then
  begin
    own := Defs[pr.fnDef].nOwn - HiddenGenerics(pr.fnDef);
    for i := 0 to Length(Nodes[n].l2) - 1 do
      if i < own then
        Unify(targs[Length(targs) - Defs[pr.fnDef].nOwn + i], LowerInCtx(Nodes[n].l2[i]));
  end;
  Result := CheckFnCall(n, pr.fnDef, targs, argNodes, cur, expected);
  { le premier parametre doit correspondre au recepteur ajuste }
  if Hirs[Result].k = hCall then
  begin
    FnDefSig(pr.fnDef, targs, baseTargs, k);
    if Length(baseTargs) > 0 then TryUnify(baseTargs[0], Hirs[cur].ty);
  end;
end;

{ ---- constructeurs de structures ---- }

function ResolveStructPath(p: Integer; var def: Integer; var targs: TIntArr): Boolean;
var
  segs: TStrArr;
  used, d, nx: Integer;
  t, e: Integer;
  r: TValRes;
  seg: Integer;
  env: TEnv;
begin
  Result := False;
  segs := PathSegs(p);
  if (Length(segs) = 1) and (segs[0] = 'Self') then
  begin
    t := Shallow(Cxs[CxTop].env.selfTy);
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkStruct) then
    begin
      def := Tys[t].def;
      targs := ICopy(Tys[t].args);
      Result := True;
    end;
    Exit;
  end;
  if (Length(segs) = 2) and (segs[0] = 'Self') then
  begin
    t := Shallow(Cxs[CxTop].env.selfTy);
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkEnum) then
    begin
      nx := ScopeLookup(Tys[t].def, 'T', segs[1], 0);
      if nx >= 0 then
      begin
        def := nx;
        targs := ICopy(Tys[t].args);
        Result := True;
      end;
    end;
    Exit;
  end;
  d := ResolveSegs(Cxs[CxTop].env.scope, segs, 'T', used);
  if (d < 0) or (used <> Length(segs)) then
  begin
    ErrAt(p, 'E0422', 'cannot find struct, variant or union type `' + segs[Length(segs) - 1] + '` in this scope',
          'not found in this scope');
    Exit;
  end;
  seg := Nodes[p].l[Length(Nodes[p].l) - 1];
  case Defs[d].kind of
    dkStruct:
      begin
        def := d;
        targs := AdtArgsFromSeg(d, seg);
        Result := True;
      end;
    dkVariant:
      begin
        def := d;
        if (Length(Nodes[p].l) >= 2) and (Length(Nodes[Nodes[p].l[Length(Nodes[p].l) - 2]].l) > 0) then
          targs := AdtArgsFromSeg(Defs[d].parent, Nodes[p].l[Length(Nodes[p].l) - 2])
        else
          targs := AdtArgsFromSeg(Defs[d].parent, 0);
        Result := True;
      end;
    dkTypeAlias:
      begin
        Cxs[CxTop].env.infer := True;
        env := Cxs[CxTop].env;
        t := Shallow(LowerTy(Nodes[p].a, env));
      end;
  else
    ErrAt(p, 'E0574', 'expected struct, variant or union type, found ' + Defs[d].name, 'not a struct');
  end;
  if (not Result) and (Defs[d].kind = dkTypeAlias) then
  begin
    t := Shallow(LowerInCtx(p));
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkStruct) then
    begin
      def := Tys[t].def;
      targs := ICopy(Tys[t].args);
      Result := True;
    end;
  end;
end;

function CheckStructLit(n: Integer; expected: Integer): Integer;
var
  def, i, j, idx, ty, e, fh, h, nd: Integer;
  targs: TIntArr;
  vals: TIntArr;
  fn: Integer;
  fname: string;
  provided: TStrArr;
  fty: Integer;
  baseH: Integer;
  parentAdt: Integer;
  missing: string;
  vdef: Integer;
begin
  if not ResolveStructPath(Nodes[n].a, def, targs) then
  begin
    for i := 0 to Length(Nodes[n].l) - 1 do CheckExpr(Nodes[Nodes[n].l[i]].a, 0);
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  nd := Defs[def].node;
  if Defs[def].kind = dkVariant then ty := MkAdt(Defs[def].parent, targs) else ty := MkAdt(def, targs);
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if (Tys[e].k = tyAdt) and (Tys[e].def = Tys[ty].def) then TryUnify(ty, e);
  end;
  SetLength(vals, Length(Nodes[nd].l2));
  for i := 0 to Length(vals) - 1 do vals[i] := 0;
  provided := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    fn := Nodes[n].l[i];
    fname := Nodes[fn].s;
    idx := -1;
    for j := 0 to Length(Nodes[nd].l2) - 1 do
      if Nodes[Nodes[nd].l2[j]].s = fname then begin idx := j; Break; end;
    if idx < 0 then
    begin
      ErrAt(fn, 'E0560', 'struct `' + Defs[def].name + '` has no field named `' + fname + '`', 'unknown field');
      CheckExpr(Nodes[fn].a, 0);
      Continue;
    end;
    if vals[idx] <> 0 then
    begin
      ErrAt(fn, 'E0062', 'field `' + fname + '` specified more than once', 'used more than once');
      CheckExpr(Nodes[fn].a, 0);
      Continue;
    end;
    fty := FieldTyOf(ty, def, idx);
    vals[idx] := CheckExprCoerce(Nodes[fn].a, fty);
  end;
  baseH := 0;
  if Nodes[n].b <> 0 then
    baseH := CheckExprCoerce(Nodes[n].b, ty)
  else
  begin
    missing := '';
    for j := 0 to Length(vals) - 1 do
      if vals[j] = 0 then
      begin
        if missing <> '' then missing := missing + ', ';
        missing := missing + '`' + Nodes[Nodes[nd].l2[j]].s + '`';
      end;
    if missing <> '' then
    begin
      ErrAt(n, 'E0063', 'missing field' + Copy('s', 1, Ord(Pos(',', missing) > 0)) + ' ' + missing +
            ' in initializer of `' + Defs[def].name + '`', 'missing ' + missing);
      for j := 0 to Length(vals) - 1 do
        if vals[j] = 0 then vals[j] := HUnitOf(n);
    end;
  end;
  h := HirAt(hAdt, ty, n);
  Hirs[h].def := def;
  Hirs[h].l := vals;
  Hirs[h].a := baseH;
  if Defs[def].kind = dkVariant then Hirs[h].n := Defs[def].vindex;
  Result := h;
end;

function CheckTupleExpr(n: Integer; expected: Integer): Integer;
var
  i, e, h: Integer;
  els, tyl: TIntArr;
  hint: Integer;
begin
  e := 0;
  if expected <> 0 then e := Shallow(expected);
  els := nil;
  tyl := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    hint := 0;
    if (e <> 0) and (Tys[e].k = tyTuple) and (i < Length(Tys[e].args)) then hint := Tys[e].args[i];
    h := CheckExpr(Nodes[n].l[i], hint);
    if hint <> 0 then
    begin
      h := TryCoerce(h, hint);
      if h < 0 then h := CheckExpr(Nodes[n].l[i], 0);
    end;
    IAdd(els, h);
    IAdd(tyl, Hirs[h].ty);
  end;
  Result := HirAt(hTuple, MkTuple(tyl), n);
  Hirs[Result].l := els;
end;

function CheckArrayExpr(n: Integer; expected: Integer): Integer;
var
  i, e, h, elemTy: Integer;
  els: TIntArr;
begin
  elemTy := 0;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if (Tys[e].k = tyArray) or (Tys[e].k = tySlice) then elemTy := Tys[e].args[0];
  end;
  if elemTy = 0 then elemTy := NewTyVar(0);
  els := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    h := CheckExprCoerce(Nodes[n].l[i], elemTy);
    IAdd(els, h);
  end;
  Result := HirAt(hArray, MkArray(elemTy, MkConstTy(Length(els))), n);
  Hirs[Result].l := els;
end;

function CheckRepeatExpr(n: Integer; expected: Integer): Integer;
var
  e, h, elemTy, cnt: Integer;
begin
  elemTy := 0;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if (Tys[e].k = tyArray) or (Tys[e].k = tySlice) then elemTy := Tys[e].args[0];
  end;
  if elemTy = 0 then elemTy := NewTyVar(0);
  h := CheckExprCoerce(Nodes[n].a, elemTy);
  Cxs[CxTop].env.infer := True;
  cnt := LowerConstExpr(Nodes[n].b, Cxs[CxTop].env);
  Result := HirAt(hRepeat, MkArray(elemTy, cnt), n);
  Hirs[Result].a := h;
  if Tys[Shallow(cnt)].k = tyConst then Hirs[Result].n := Tys[Shallow(cnt)].n
  else Hirs[Result].n := -1;
end;

function CheckRangeExpr(n: Integer; expected: Integer): Integer;
var
  lo, hi, t, def, h, e, hint: Integer;
  els, targs, args: TIntArr;
  incl: Boolean;
  nm: string;
  a, b: Integer;
begin
  incl := (Nodes[n].f and 1) <> 0;
  lo := 0;
  hi := 0;
  t := 0;
  hint := 0;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if (Tys[e].k = tyAdt) and (Length(Tys[e].args) = 1) then hint := Tys[e].args[0];
  end;
  if Nodes[n].a <> 0 then
  begin
    lo := CheckExpr(Nodes[n].a, hint);
    t := Hirs[lo].ty;
  end;
  if Nodes[n].b <> 0 then
  begin
    if t <> 0 then hi := CheckExprCoerce(Nodes[n].b, t)
    else
    begin
      hi := CheckExpr(Nodes[n].b, hint);
      t := Hirs[hi].ty;
    end;
  end;
  if (lo <> 0) and (hi <> 0) then
  begin
    if incl then
    begin
      SetLength(targs, 1);
      targs[0] := t;
      SetLength(args, 2);
      args[0] := lo;
      args[1] := hi;
      def := TraitAssocItem(0, '', 0);
      def := ScopeLookup(LangRangeInclusive, 'V', 'new', 0);
      Result := HCallFn(def, targs, args, MkAdt(LangRangeInclusive, targs), n);
      Exit;
    end;
    def := LangRange;
    els := nil;
    IAdd(els, lo);
    IAdd(els, hi);
  end
  else if lo <> 0 then
  begin
    def := LangRangeFrom;
    els := nil;
    IAdd(els, lo);
  end
  else if hi <> 0 then
  begin
    if incl then def := LangRangeToInclusive else def := LangRangeTo;
    els := nil;
    IAdd(els, hi);
  end
  else
  begin
    def := LangRangeFull;
    els := nil;
    t := 0;
  end;
  targs := nil;
  if t <> 0 then IAdd(targs, t);
  h := HirAt(hAdt, MkAdt(def, targs), n);
  Hirs[h].def := def;
  Hirs[h].l := els;
  Result := h;
end;

{ ---- operateur ? ---- }

function CheckTryExpr(n: Integer; expected: Integer): Integer;
var
  a, t, h, okV, errV, armOk, armErr, m, retT, rt, retAdt: Integer;
  ety, vty, targs, retErr: Integer;
  targ: TIntArr;
  p1, p2, pw: Integer;
  retH, conv, errExpr, someDef, noneDef, okDef, errDef: Integer;
  fromFn, i: Integer;
  fa: TIntArr;
  v1, v2: Integer;
  scrutTy: Integer;
  arms: TIntArr;
  lh, rh: Integer;
  isOpt: Boolean;
begin
  a := CheckExpr(Nodes[n].a, 0);
  t := StructResolve(Hirs[a].ty);
  if Tys[t].k = tyErr then begin Result := a; Exit; end;
  retT := Shallow(Cxs[CxBase + 1].retTy);
  if Cxs[CxTop].closure >= 0 then retT := Shallow(Cxs[CxTop].retTy);
  if (Tys[t].k <> tyAdt) or ((Tys[t].def <> LangOption) and (Tys[t].def <> LangResult)) then
  begin
    ErrAt(n, 'E0277', 'the `?` operator can only be applied to values that implement `Try`',
          'the `?` operator cannot be applied to type `' + TyStrZ(t) + '`');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  isOpt := Tys[t].def = LangOption;
  vty := Tys[t].args[0];
  if Tys[retT].k = tyVar then
  begin
    { type de retour inconnu : on le deduit }
    if isOpt then
    begin
      SetLength(targ, 1);
      targ[0] := NewTyVar(0);
      Unify(retT, MkAdt(LangOption, targ));
    end
    else
    begin
      SetLength(targ, 2);
      targ[0] := NewTyVar(0);
      targ[1] := NewTyVar(0);
      Unify(retT, MkAdt(LangResult, targ));
    end;
    retT := Shallow(retT);
  end;
  if (Tys[retT].k <> tyAdt) or (Tys[retT].def <> Tys[t].def) then
  begin
    ErrAt(n, 'E0277', 'the `?` operator can only be used in a function that returns `Result` or `Option`',
          'cannot use the `?` operator in a function that returns `' + TyStrZ(retT) + '`');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  { match a, bras Ok(v) et Err(e) avec conversion From }
  v1 := NewVarInfo('__v', vty, False, n);
  scrutTy := Hirs[a].ty;
  arms := nil;
  if isOpt then
  begin
    someDef := ScopeLookup(LangOption, 'V', 'Some', 0);
    noneDef := ScopeLookup(LangOption, 'V', 'None', 0);
    p1 := NewPat(pkAdt, scrutTy);
    Pats[p1].def := someDef;
    Pats[p1].vidx := Defs[someDef].vindex;
    pw := NewPat(pkBind, vty);
    Pats[pw].v := v1;
    IAdd(Pats[p1].l, pw);
    lh := HirAt(hArm, vty, n);
    Hirs[lh].n := p1;
    Hirs[lh].b := LocalHir(CxTop, v1, n);
    IAdd(arms, lh);
    p2 := NewPat(pkAdt, scrutTy);
    Pats[p2].def := noneDef;
    Pats[p2].vidx := Defs[noneDef].vindex;
    rh := HirAt(hAdt, retT, n);
    Hirs[rh].def := noneDef;
    Hirs[rh].n := Defs[noneDef].vindex;
    retH := HirAt(hReturn, TyNeverT, n);
    Hirs[retH].a := rh;
    lh := HirAt(hArm, vty, n);
    Hirs[lh].n := p2;
    Hirs[lh].b := retH;
    IAdd(arms, lh);
  end
  else
  begin
    okDef := ScopeLookup(LangResult, 'V', 'Ok', 0);
    errDef := ScopeLookup(LangResult, 'V', 'Err', 0);
    ety := Tys[t].args[1];
    p1 := NewPat(pkAdt, scrutTy);
    Pats[p1].def := okDef;
    Pats[p1].vidx := Defs[okDef].vindex;
    pw := NewPat(pkBind, vty);
    Pats[pw].v := v1;
    IAdd(Pats[p1].l, pw);
    lh := HirAt(hArm, vty, n);
    Hirs[lh].n := p1;
    Hirs[lh].b := LocalHir(CxTop, v1, n);
    IAdd(arms, lh);
    v2 := NewVarInfo('__e', ety, False, n);
    p2 := NewPat(pkAdt, scrutTy);
    Pats[p2].def := errDef;
    Pats[p2].vidx := Defs[errDef].vindex;
    pw := NewPat(pkBind, ety);
    Pats[pw].v := v2;
    IAdd(Pats[p2].l, pw);
    retErr := Tys[retT].args[1];
    { From::from(e) }
    SetLength(fa, 2);
    fa[0] := retErr;
    fa[1] := ety;
    AddObl(oblTrait, retErr, LangFrom, fa, '', 0, n);
    SetLength(targ, 1);
    targ[0] := LocalHir(CxTop, v2, n);
    conv := HCallFn(TraitAssocItem(LangFrom, 'from', dkFn), fa, targ, retErr, n);
    SetLength(targ, 1);
    targ[0] := conv;
    rh := HirAt(hAdt, retT, n);
    Hirs[rh].def := errDef;
    Hirs[rh].n := Defs[errDef].vindex;
    Hirs[rh].l := targ;
    retH := HirAt(hReturn, TyNeverT, n);
    Hirs[retH].a := rh;
    lh := HirAt(hArm, vty, n);
    Hirs[lh].n := p2;
    Hirs[lh].b := retH;
    IAdd(arms, lh);
  end;
  h := HirAt(hMatch, vty, n);
  Hirs[h].a := a;
  Hirs[h].l := arms;
  Result := h;
end;

{ ============================================================ }
{ Verification (3) : motifs, blocs, controle de flux, fermetures }
{ ============================================================ }

Var
  PatNames: TStrArr;
  PatVars: TIntArr;
  NPatB: Integer;
  PatAltDepth: Integer;
  PatAltFirst: Boolean;
  PatVarsDeclared: TIntArr;

function FindPatBinding(const name: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to NPatB - 1 do
    if PatNames[i] = name then begin Result := PatVars[i]; Exit; end;
end;

procedure AddPatBinding(const name: string; v: Integer);
begin
  if NPatB >= Length(PatNames) then
  begin
    SetLength(PatNames, NPatB * 2 + 8);
    SetLength(PatVars, NPatB * 2 + 8);
  end;
  PatNames[NPatB] := name;
  PatVars[NPatB] := v;
  Inc(NPatB);
end;

function PeelRefs(var t: Integer; var bm: Integer): Integer;
begin
  Result := 0;
  while True do
  begin
    t := StructResolve(t);
    if Tys[t].k <> tyRef then Break;
    if (Tys[t].f and 1) <> 0 then
    begin
      if bm = 0 then bm := 2;
    end
    else bm := 1;
    t := Tys[t].args[0];
    Inc(Result);
  end;
end;

function WrapDerefPats(p: Integer; count: Integer; outerTy: Integer; node: Integer): Integer;
var
  i, q: Integer;
  ty: Integer;
  tyl: TIntArr;
  t: Integer;
begin
  Result := p;
  if count = 0 then Exit;
  { reconstruit les types intermediaires : outerTy est le type externe }
  tyl := nil;
  t := outerTy;
  for i := 1 to count do
  begin
    IAdd(tyl, t);
    t := Shallow(t);
    if Tys[t].k = tyRef then t := Tys[t].args[0];
  end;
  for i := count - 1 downto 0 do
  begin
    q := NewPat(pkDeref, tyl[i]);
    Pats[q].a := Result;
    PatPos(q, node);
    Result := q;
  end;
end;

function BindingMode2Ty(t: Integer; bm: Integer): Integer;
begin
  case bm of
    1: Result := MkRef(t, False);
    2: Result := MkRef(t, True);
  else
    Result := t;
  end;
end;

function ConstPatValue(node: Integer; var v: Int64; var isStr: Boolean; var s: string; var fv: Double;
  var isFloat: Boolean; ty: Integer): Boolean; forward;

{ Resout un chemin de motif vers une variante / structure / constante. kind: 1 variante, 2 struct, 3 const }
function ResolvePatPath(p: Integer; var kind: Integer; var def: Integer; var targs: TIntArr; quiet: Boolean): Boolean;
var
  segs: TStrArr;
  used, d, t, nx, seg: Integer;
  rv: TValRes;
  selfT: Integer;
begin
  Result := False;
  segs := PathSegs(p);
  targs := nil;
  if Nodes[p].a <> 0 then
  begin
    ResolveValuePath(p, rv);
    if rv.kind = vrVariant then begin kind := 1; def := rv.def; targs := rv.targs; Result := True; end
    else if rv.kind = vrConst then begin kind := 3; def := rv.def; Result := True; end;
    Exit;
  end;
  if (Length(segs) = 1) and (segs[0] = 'Self') then
  begin
    t := Shallow(Cxs[CxTop].env.selfTy);
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkStruct) then
    begin
      kind := 2; def := Tys[t].def; targs := ICopy(Tys[t].args); Result := True;
    end;
    Exit;
  end;
  if (Length(segs) = 2) and (segs[0] = 'Self') then
  begin
    t := Shallow(Cxs[CxTop].env.selfTy);
    if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkEnum) then
    begin
      nx := ScopeLookup(Tys[t].def, 'V', segs[1], 0);
      if nx >= 0 then
      begin
        kind := 1; def := nx; targs := ICopy(Tys[t].args); Result := True; Exit;
      end;
    end;
    { constante associee }
    rv.kind := vrNone;
    if FindAssocItem(t, segs[1], 0, rv) and (rv.kind = vrConst) then
    begin
      kind := 3; def := rv.def; targs := rv.targs; Result := True;
    end;
    Exit;
  end;
  d := ResolveSegs(Cxs[CxTop].env.scope, segs, 'V', used);
  if (d >= 0) and (used = Length(segs)) then
  begin
    seg := Nodes[p].l[Length(Nodes[p].l) - 1];
    case Defs[d].kind of
      dkVariant:
        begin
          kind := 1; def := d;
          targs := AdtArgsFromSeg(Defs[d].parent, 0);
          Result := True;
        end;
      dkStruct:
        begin
          kind := 2; def := d;
          targs := AdtArgsFromSeg(d, seg);
          Result := True;
        end;
      dkConst:
        begin
          kind := 3; def := d; Result := True;
        end;
    end;
    Exit;
  end;
  { struct a champs nommes (espace des types) }
  d := ResolveSegs(Cxs[CxTop].env.scope, segs, 'T', used);
  if (d >= 0) and (used = Length(segs)) then
  begin
    seg := Nodes[p].l[Length(Nodes[p].l) - 1];
    case Defs[d].kind of
      dkVariant:
        begin kind := 1; def := d; targs := AdtArgsFromSeg(Defs[d].parent, 0); Result := True; end;
      dkStruct:
        begin kind := 2; def := d; targs := AdtArgsFromSeg(d, seg); Result := True; end;
    end;
    Exit;
  end;
  { Type::CONST ou Type::associe }
  if Length(segs) >= 2 then
  begin
    nx := SynthPrefixPath(p, Length(segs) - 1);
    Inc(SuppressDiag);
    t := LowerInCtx(nx);
    Dec(SuppressDiag);
    if t <> TyErrT then
    begin
      rv.kind := vrNone;
      if FindAssocItem(t, segs[Length(segs) - 1], 0, rv) then
      begin
        if rv.kind = vrVariant then begin kind := 1; def := rv.def; targs := rv.targs; Result := True; Exit; end;
        if rv.kind = vrConst then begin kind := 3; def := rv.def; targs := rv.targs; Result := True; Exit; end;
      end;
    end;
  end;
  if not quiet then
    ErrAt(p, 'E0531', 'cannot find tuple struct or tuple variant `' + segs[Length(segs) - 1] + '` in this scope',
          'not found in this scope');
end;

function AdtFieldCount(def: Integer): Integer;
begin
  Result := Length(Nodes[Defs[def].node].l2);
end;

function AdtTyOf(def: Integer; const targs: TIntArr): Integer;
begin
  if Defs[def].kind = dkVariant then Result := MkAdt(Defs[def].parent, targs) else Result := MkAdt(def, targs);
end;

function CheckLitPatValue(n: Integer; expected: Integer; var pat: Integer): Boolean;
var
  h: Integer;
  e: Integer;
begin
  h := CheckExpr(n, expected);
  e := Shallow(expected);
  if not TryUnify(Hirs[h].ty, e) then
  begin
    ErrMismatch(n, e, Hirs[h].ty);
  end;
  pat := NewPat(pkLit, e);
  PatPos(pat, n);
  case Hirs[h].k of
    hLitInt, hLitChar, hLitBool: Pats[pat].n := Hirs[h].n;
    hLitFloat: Pats[pat].fv := Hirs[h].fv;
    hLitStr, hLitByteStr: Pats[pat].s := Hirs[h].s;
  end;
  if Hirs[h].k = hLitStr then Pats[pat].m := 1
  else if Hirs[h].k = hLitFloat then Pats[pat].m := 2
  else if Hirs[h].k = hLitByteStr then Pats[pat].m := 3;
  Result := True;
end;

function PatBindVar(const name: string; ty: Integer; mut: Boolean; node: Integer): Integer;
var
  v: Integer;
begin
  v := -1;
  if PatAltDepth > 0 then v := FindPatBinding(name);
  if v < 0 then
  begin
    v := NewVarInfo(name, ty, mut, node);
    DeclareVar(name, v);
    AddPatBinding(name, v);
  end
  else
  begin
    if not TryUnify(Bodies[Cxs[CxTop].body].vars[v].ty, ty) then
      ErrAt(node, 'E0308', 'mismatched types', 'expected `' + TyStrZ(Bodies[Cxs[CxTop].body].vars[v].ty) + '`, found `' +
            TyStrZ(ty) + '`');
  end;
  Result := v;
end;

function CheckPat(n: Integer; expected: Integer; bm: Integer): Integer;
var
  t, k, i, j, peeled, p, q, v, def, kind, ety, nfields, restAt, bmode, idx: Integer;
  targs: TIntArr;
  isRef: Boolean;
  nd, subN, fnode: Integer;
  fty, adt: Integer;
  sub: TIntArr;
  pty: Integer;
  name: string;
  iv: Int64;
  isStr, isFloat: Boolean;
  s: string;
  fv: Double;
  lo, hi: Integer;
  elemT: Integer;
  seen: TStrArr;
  nextI: Integer;
  slt: Integer;
  bt: Integer;
  outerTy: Integer;
  segs: TStrArr;
  nvars: Integer;
  alt: Integer;
  firstBindings: Integer;
  hasRest: Boolean;
  before: TIntArr;
  after: TIntArr;
  wildCount: Integer;
  pp: Integer;
begin
  t := StructResolve(expected);
  outerTy := t;
  case Nodes[n].k of
    pWild:
      begin
        Result := NewPat(pkWild, t);
        PatPos(Result, n);
      end;
    pRest:
      begin
        Result := NewPat(pkWild, t);
        PatPos(Result, n);
      end;
    pIdent:
      begin
        name := Nodes[n].s;
        { unite : variante, structure unitaire ou constante ? }
        if (Nodes[n].a = 0) and ((Nodes[n].f and 3) = 0) then
        begin
          segs := nil;
          SAdd(segs, name);
          def := ResolveSegs(Cxs[CxTop].env.scope, segs, 'V', k);
          if (def >= 0) and (k = 1) and ((Defs[def].kind = dkVariant) or ((Defs[def].kind = dkStruct) and
             IsUnitLike(Defs[def].node)) or (Defs[def].kind = dkConst)) then
          begin
            { traiter comme un chemin }
            q := NewNode(tPath);
            Nodes[q].fi := Nodes[n].fi; Nodes[q].line := Nodes[n].line; Nodes[q].col := Nodes[n].col;
            Nodes[q].eline := Nodes[n].eline; Nodes[q].ecol := Nodes[n].ecol;
            i := NewNode(nSeg);
            Nodes[i].s := name;
            IAdd(Nodes[q].l, i);
            p := NewNode(pPath);
            Nodes[p].fi := Nodes[n].fi; Nodes[p].line := Nodes[n].line; Nodes[p].col := Nodes[n].col;
            Nodes[p].eline := Nodes[n].eline; Nodes[p].ecol := Nodes[n].ecol;
            Nodes[p].a := q;
            Result := CheckPat(p, expected, bm);
            Exit;
          end;
        end;
        bmode := bm;
        if (Nodes[n].f and 1) <> 0 then
        begin
          if (Nodes[n].f and 2) <> 0 then bmode := 2 else bmode := 1;
        end;
        if bmode = 0 then pty := t else pty := BindingMode2Ty(t, bmode);
        v := PatBindVar(name, pty, (Nodes[n].f and 2) <> 0, n);
        if (Nodes[n].f and 1) <> 0 then Bodies[Cxs[CxTop].body].vars[v].mut := False;
        Result := NewPat(pkBind, t);
        Pats[Result].v := v;
        Pats[Result].byRef := bmode;
        PatPos(Result, n);
        if Nodes[n].a <> 0 then Pats[Result].a := CheckPat(Nodes[n].a, expected, bm);
      end;
    pLit:
      begin
        { litteral : pas de pelage pour &str }
        subN := Nodes[n].a;
        if (Nodes[subN].k = eLit) and (Nodes[subN].f = lkStr) then
        begin
          if not CheckLitPatValue(subN, expected, p) then ;
          Result := p;
          Exit;
        end;
        peeled := PeelRefs(t, bm);
        CheckLitPatValue(subN, t, p);
        Result := WrapDerefPats(p, peeled, outerTy, n);
      end;
    pRange:
      begin
        peeled := PeelRefs(t, bm);
        p := NewPat(pkRange, t);
        PatPos(p, n);
        Pats[p].incl := (Nodes[n].f and 1) <> 0;
        Pats[p].l := nil;
        if Nodes[n].a <> 0 then
        begin
          q := 0;
          CheckLitPatValue(Nodes[n].a, t, q);
          if Pats[q].m = 2 then Pats[p].fv := Pats[q].fv;
          Pats[p].n := Pats[q].n;
          IAdd(Pats[p].l, 1);
        end
        else IAdd(Pats[p].l, 0);
        if Nodes[n].b <> 0 then
        begin
          q := 0;
          CheckLitPatValue(Nodes[n].b, t, q);
          Pats[p].m := Pats[q].n;
          IAdd(Pats[p].l, 1);
        end
        else IAdd(Pats[p].l, 0);
        Result := WrapDerefPats(p, peeled, outerTy, n);
      end;
    pRef:
      begin
        t := StructResolve(expected);
        if Tys[t].k = tyVar then
        begin
          ety := NewTyVar(0);
          Unify(t, MkRef(ety, (Nodes[n].f and 1) <> 0));
          t := Shallow(t);
        end;
        if Tys[t].k <> tyRef then
        begin
          ErrAt(n, 'E0308', 'mismatched types', 'expected `' + TyStrZ(t) + '`, found `&_`');
          Result := NewPat(pkWild, t);
          Exit;
        end;
        p := NewPat(pkDeref, t);
        PatPos(p, n);
        Pats[p].a := CheckPat(Nodes[n].a, Tys[t].args[0], 0);
        Result := p;
      end;
    pTuple:
      begin
        peeled := PeelRefs(t, bm);
        hasRest := False;
        restAt := -1;
        for i := 0 to Length(Nodes[n].l) - 1 do
          if Nodes[Nodes[n].l[i]].k = pRest then begin restAt := i; hasRest := True; end;
        if Tys[t].k = tyVar then
        begin
          if hasRest then
          begin
            ErrAt(n, 'E0282', 'type annotations needed', '');
            Result := NewPat(pkWild, t);
            Exit;
          end;
          sub := nil;
          for i := 0 to Length(Nodes[n].l) - 1 do IAdd(sub, NewTyVar(0));
          Unify(t, MkTuple(sub));
          t := Shallow(t);
        end;
        if Tys[t].k <> tyTuple then
        begin
          if Tys[t].k <> tyErr then
            ErrAt(n, 'E0308', 'mismatched types', 'expected `' + TyStrZ(t) + '`, found tuple');
          Result := NewPat(pkWild, t);
          Exit;
        end;
        nfields := Length(Tys[t].args);
        if ((not hasRest) and (Length(Nodes[n].l) <> nfields)) or (hasRest and (Length(Nodes[n].l) - 1 > nfields)) then
        begin
          ErrAt(n, 'E0308', 'mismatched types', 'expected a tuple with ' + IntToStr(nfields) + ' element' +
                Copy('s', 1, Ord(nfields <> 1)) + ', found one with ' + IntToStr(Length(Nodes[n].l)) +
                ' element' + Copy('s', 1, Ord(Length(Nodes[n].l) <> 1)));
          Result := NewPat(pkWild, t);
          Exit;
        end;
        p := NewPat(pkTuple, t);
        PatPos(p, n);
        j := 0;
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          if Nodes[Nodes[n].l[i]].k = pRest then
          begin
            for k := 1 to nfields - (Length(Nodes[n].l) - 1) do
            begin
              q := NewPat(pkWild, Tys[t].args[j]);
              IAdd(Pats[p].l, q);
              Inc(j);
            end;
            Continue;
          end;
          q := CheckPat(Nodes[n].l[i], Tys[t].args[j], bm);
          IAdd(Pats[p].l, q);
          Inc(j);
        end;
        Result := WrapDerefPats(p, peeled, outerTy, n);
      end;
    pPath, pTupleStruct, pStruct:
      begin
        peeled := PeelRefs(t, bm);
        if not ResolvePatPath(Nodes[n].a, kind, def, targs, False) then
        begin
          Result := NewPat(pkWild, t);
          Exit;
        end;
        if kind = 3 then
        begin
          { constante }
          p := NewPat(pkLit, t);
          PatPos(p, n);
          iv := 0; fv := 0; s := '';
          if ConstPatValue(Nodes[Nodes[n].a].l[0], iv, isStr, s, fv, isFloat, t) then
          begin
            Pats[p].n := iv;
            if isStr then begin Pats[p].s := s; Pats[p].m := 1; end;
          end
          else
          begin
            Pats[p].k := pkConst;
            Pats[p].def := def;
          end;
          Pats[p].def := def;
          { d'apres la declaration, on determine la valeur }
          Result := WrapDerefPats(p, peeled, outerTy, n);
          Exit;
        end;
        adt := AdtTyOf(def, targs);
        if not TryUnify(adt, t) then
        begin
          ErrMismatch(n, t, adt);
          Result := NewPat(pkWild, t);
          Exit;
        end;
        nd := Defs[def].node;
        nfields := Length(Nodes[nd].l2);
        p := NewPat(pkAdt, adt);
        PatPos(p, n);
        Pats[p].def := def;
        if Defs[def].kind = dkVariant then Pats[p].vidx := Defs[def].vindex;
        SetLength(sub, nfields);
        for i := 0 to nfields - 1 do sub[i] := -1;
        if Nodes[n].k = pTupleStruct then
        begin
          if not IsTupleLike(nd) then
            ErrAt(n, 'E0532', 'expected tuple struct or tuple variant, found `' + Defs[def].name + '`', '');
          restAt := -1;
          for i := 0 to Length(Nodes[n].l) - 1 do
            if Nodes[Nodes[n].l[i]].k = pRest then restAt := i;
          if ((restAt < 0) and (Length(Nodes[n].l) <> nfields)) or ((restAt >= 0) and (Length(Nodes[n].l) - 1 > nfields)) then
          begin
            ErrAt(n, 'E0023', 'this pattern has ' + IntToStr(Length(Nodes[n].l)) + ' field' +
                  Copy('s', 1, Ord(Length(Nodes[n].l) <> 1)) + ', but the corresponding tuple ' +
                  Copy('variant', 1, Ord(Defs[def].kind = dkVariant) * 7) + Copy('struct', 1, Ord(Defs[def].kind <> dkVariant) * 6) +
                  ' has ' + IntToStr(nfields) + ' field' + Copy('s', 1, Ord(nfields <> 1)),
                  'expected ' + IntToStr(nfields) + ' field' + Copy('s', 1, Ord(nfields <> 1)) + ', found ' +
                  IntToStr(Length(Nodes[n].l)));
          end
          else
          begin
            j := 0;
            for i := 0 to Length(Nodes[n].l) - 1 do
            begin
              if Nodes[Nodes[n].l[i]].k = pRest then
              begin
                j := j + (nfields - (Length(Nodes[n].l) - 1));
                Continue;
              end;
              sub[j] := CheckPat(Nodes[n].l[i], FieldTyOf(adt, def, j), bm);
              Inc(j);
            end;
          end;
        end
        else if Nodes[n].k = pStruct then
        begin
          seen := nil;
          for i := 0 to Length(Nodes[n].l) - 1 do
          begin
            fnode := Nodes[n].l[i];
            idx := -1;
            for j := 0 to nfields - 1 do
              if Nodes[Nodes[nd].l2[j]].s = Nodes[fnode].s then begin idx := j; Break; end;
            if idx < 0 then
            begin
              ErrAt(fnode, 'E0026', 'variant `' + Defs[def].name + '` does not have a field named `' + Nodes[fnode].s + '`',
                    'variant `' + Defs[def].name + '` does not have this field');
              Continue;
            end;
            sub[idx] := CheckPat(Nodes[fnode].a, FieldTyOf(adt, def, idx), bm);
          end;
          if (Nodes[n].f and 1) = 0 then
            for j := 0 to nfields - 1 do
              if sub[j] < 0 then
              begin
                ErrAt(n, 'E0027', 'pattern does not mention field `' + Nodes[Nodes[nd].l2[j]].s + '`',
                      'missing field `' + Nodes[Nodes[nd].l2[j]].s + '`');
                Break;
              end;
        end
        else
        begin
          if (nfields > 0) and not IsUnitLike(nd) then
            ErrAt(n, 'E0533', 'expected unit struct, unit variant or constant, found ' + Copy('tuple', 1, 5) +
                  ' variant `' + Defs[def].name + '`', '');
        end;
        for j := 0 to nfields - 1 do
          if sub[j] < 0 then
          begin
            q := NewPat(pkWild, FieldTyOf(adt, def, j));
            sub[j] := q;
          end;
        Pats[p].l := sub;
        Result := WrapDerefPats(p, peeled, outerTy, n);
      end;
    pOr:
      begin
        p := NewPat(pkOr, t);
        PatPos(p, n);
        Inc(PatAltDepth);
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          if i > 0 then ;
          q := CheckPat(Nodes[n].l[i], expected, bm);
          IAdd(Pats[p].l, q);
        end;
        Dec(PatAltDepth);
        Result := p;
      end;
    pSlice:
      begin
        peeled := PeelRefs(t, bm);
        elemT := 0;
        if Tys[t].k = tyVar then
        begin
          elemT := NewTyVar(0);
          ErrAt(n, 'E0282', 'type annotations needed', '');
        end
        else if (Tys[t].k = tyArray) or (Tys[t].k = tySlice) then elemT := Tys[t].args[0]
        else
        begin
          ErrAt(n, 'E0529', 'expected an array or slice, found `' + TyStrZ(t) + '`', 'pattern cannot match with input type `' +
                TyStrZ(t) + '`');
          Result := NewPat(pkWild, t);
          Exit;
        end;
        p := NewPat(pkSlice, t);
        PatPos(p, n);
        Pats[p].a := -1;
        j := 0;
        hasRest := False;
        for i := 0 to Length(Nodes[n].l) - 1 do
        begin
          subN := Nodes[n].l[i];
          if (Nodes[subN].k = pRest) or ((Nodes[subN].k = pIdent) and (Nodes[subN].a <> 0) and (Nodes[Nodes[subN].a].k = pRest)) then
          begin
            hasRest := True;
            if Nodes[subN].k = pIdent then
            begin
              { x @ .. : lie une tranche }
              if Tys[t].k = tyArray then
              begin
                slt := MkArray(elemT, MkConstTy(0));
                { longueur calculee a la fin }
                slt := t;
              end
              else slt := t;
              Pats[p].a := NewPat(pkBind, slt);
              v := PatBindVar(Nodes[subN].s, BindingMode2Ty(slt, 0), (Nodes[subN].f and 2) <> 0, subN);
              Pats[Pats[p].a].v := v;
              Pats[Pats[p].a].byRef := bm;
              if bm <> 0 then Bodies[Cxs[CxTop].body].vars[v].ty := BindingMode2Ty(slt, bm);
              Pats[Pats[p].a].k := pkBind;
            end
            else Pats[p].a := NewPat(pkWild, t);
            Continue;
          end;
          q := CheckPat(subN, elemT, bm);
          if hasRest then IAdd(Pats[p].l2, q) else IAdd(Pats[p].l, q);
        end;
        if not hasRest then Pats[p].a := -1;
        if hasRest then Pats[p].m := 1;
        Result := WrapDerefPats(p, peeled, outerTy, n);
      end;
  else
    Result := NewPat(pkWild, t);
  end;
end;

function ConstPatValue(node: Integer; var v: Int64; var isStr: Boolean; var s: string; var fv: Double;
  var isFloat: Boolean; ty: Integer): Boolean;
var
  r: TValRes;
  ok: Boolean;
  env: TEnv;
  nd: Integer;
begin
  Result := False;
  isStr := False;
  isFloat := False;
  Exit;
end;

{ Valeur d'une constante de motif : evaluee depuis la declaration }
function EvalConstPatNode(def: Integer; var v: Int64): Boolean;
var
  env: TEnv;
  ok: Boolean;
  nd: Integer;
begin
  nd := Defs[def].node;
  Result := False;
  if Nodes[nd].b = 0 then Exit;
  InitEnv(env);
  env.scope := Defs[def].scopeMod;
  ok := True;
  v := ConstEvalExpr(Nodes[nd].b, env, ok);
  Result := ok;
end;

{ ---- blocs ---- }

function PushLoop(const lbl: string; isLoop: Boolean): Integer;
begin
  with Cxs[CxTop] do
  begin
    if nL >= Length(loops) then SetLength(loops, nL * 2 + 4);
    loops[nL].lbl := lbl;
    Inc(LoopCounter);
    loops[nL].id := LoopCounter;
    loops[nL].breakTy := 0;
    loops[nL].hasBreak := False;
    loops[nL].isLoop := isLoop;
    Result := nL;
    Inc(nL);
  end;
end;

procedure PopLoop;
begin
  Dec(Cxs[CxTop].nL);
end;

function FindLoop(const lbl: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  with Cxs[CxTop] do
    for i := nL - 1 downto 0 do
      if (lbl = '') then
      begin
        if loops[i].lbl <> '<block>' then begin
          if loops[i].lbl <> '' then begin Result := i; Exit; end;
          Result := i;
          Exit;
        end;
      end
      else if loops[i].lbl = lbl then begin Result := i; Exit; end;
end;

function IsNeverTy(t: Integer): Boolean;
begin
  Result := Tys[Shallow(t)].k = tyNever;
end;

function JoinBranch(h: Integer; resTy: Integer; node: Integer; const what: string): Integer;
var
  r: Integer;
begin
  if IsNeverTy(Hirs[h].ty) then
  begin
    Result := WrapCoerce(h, resTy, 1);
    Exit;
  end;
  r := TryCoerce(h, resTy);
  if r < 0 then
  begin
    if what = '' then ErrMismatch(node, resTy, Hirs[h].ty)
    else
      ErrAt(node, 'E0308', what, 'expected `' + TyStrZ(resTy) + '`, found `' + TyStrZ(Hirs[h].ty) + '`');
    Result := h;
  end
  else Result := r;
end;

function CheckCondExpr(n: Integer): Integer;
var
  h, p, e: Integer;
begin
  case Nodes[n].k of
    eLet:
      begin
        e := CheckExpr(Nodes[n].b, 0);
        NPatB := 0;
        p := CheckPat(Nodes[n].a, Hirs[e].ty, 0);
        h := HirAt(hLetCond, TyBoolT, n);
        Hirs[h].n := p;
        Hirs[h].a := e;
        Result := h;
      end;
    eParen: Result := CheckCondExpr(Nodes[n].a);
    eBinary:
      if Nodes[n].s = '&&' then
      begin
        h := HirAt(hAnd, TyBoolT, n);
        Hirs[h].a := CheckCondExpr(Nodes[n].a);
        Hirs[h].b := CheckCondExpr(Nodes[n].b);
        Result := h;
      end
      else Result := CheckExprCoerce(n, TyBoolT);
  else
    Result := CheckExprCoerce(n, TyBoolT);
  end;
end;

function CheckLetStmt(st: Integer): Integer;
var
  declTy, init, h, p, els, e: Integer;
  hasInit: Boolean;
  v: Integer;
begin
  if Nodes[st].b <> 0 then declTy := LowerInCtx(Nodes[st].b) else declTy := NewTyVar(0);
  init := 0;
  els := 0;
  if Nodes[st].c <> 0 then
  begin
    init := CheckExpr(Nodes[st].c, declTy);
    if Nodes[st].b <> 0 then init := CoerceTo(init, declTy, Nodes[st].c)
    else
    begin
      if not TryUnify(declTy, Hirs[init].ty) then
        declTy := Hirs[init].ty;
    end;
  end;
  if Nodes[st].d <> 0 then
  begin
    els := CheckBlockExpr(Nodes[st].d, TyNeverT);
    if not IsNeverTy(Hirs[els].ty) then
      ErrAt(Nodes[st].d, 'E0308', '`else` clause of `let...else` does not diverge',
            'expected `!`, found `' + TyStrZ(Hirs[els].ty) + '`');
  end;
  NPatB := 0;
  p := CheckPat(Nodes[st].a, declTy, 0);
  { variable declaree sans initialisation : affectation tardive autorisee }
  if (init = 0) and (Pats[p].k = pkBind) then Bodies[Cxs[CxTop].body].vars[Pats[p].v].declared := True;
  h := HirAt(hLet, TyUnit, st);
  Hirs[h].n := p;
  Hirs[h].a := init;
  Hirs[h].b := els;
  Result := h;
end;

function CheckBlockExpr(n: Integer; expected: Integer): Integer;
var
  i, st, e, h, tail, ty, saveScope: Integer;
  stmts: TIntArr;
  diverges: Boolean;
  isUnsafe: Boolean;
  lblId: Integer;
  li: Integer;
  r: Integer;
begin
  saveScope := Cxs[CxTop].env.scope;
  if Nodes[n].id > 0 then Cxs[CxTop].env.scope := Nodes[n].id;
  isUnsafe := (Nodes[n].f and 1) <> 0;
  if isUnsafe then Inc(Cxs[CxTop].unsafeDepth);
  li := -1;
  if Nodes[n].s <> '' then li := PushLoop(Nodes[n].s, False);
  EnterScope;
  stmts := nil;
  diverges := False;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    st := Nodes[n].l[i];
    case Nodes[st].k of
      sLet:
        begin
          h := CheckLetStmt(st);
          if Hirs[h].a <> 0 then
            if IsNeverTy(Hirs[Hirs[h].a].ty) then diverges := True;
          IAdd(stmts, h);
        end;
      sExpr:
        begin
          if Nodes[st].f = 1 then
            e := CheckExpr(Nodes[st].a, 0)
          else
          begin
            e := CheckExpr(Nodes[st].a, TyUnit);
            { une expression sans point-virgule en milieu de bloc doit etre de type () }
            if (not IsNeverTy(Hirs[e].ty)) then
            begin
              if not TryUnify(Hirs[e].ty, TyUnit) then
                ErrAt(Nodes[st].a, 'E0308', 'mismatched types', 'expected `()`, found `' + TyStrZ(Hirs[e].ty) + '`');
            end;
          end;
          if IsNeverTy(Hirs[e].ty) then diverges := True;
          h := HirAt(hExprStmt, TyUnit, st);
          Hirs[h].a := e;
          IAdd(stmts, h);
        end;
      sItem: ;
    end;
  end;
  tail := 0;
  if Nodes[n].a <> 0 then
  begin
    tail := CheckExpr(Nodes[n].a, expected);
    ty := Hirs[tail].ty;
  end
  else if diverges then ty := TyNeverT
  else ty := TyUnit;
  LeaveScope;
  if li >= 0 then
  begin
    { bloc etiquete : type = type de tail joint aux break }
    if Cxs[CxTop].loops[li].hasBreak then
    begin
      if tail <> 0 then
      begin
        tail := JoinBranch(tail, Cxs[CxTop].loops[li].breakTy, Nodes[n].a, '');
        ty := Cxs[CxTop].loops[li].breakTy;
      end
      else if not diverges then
      begin
        TryUnify(Cxs[CxTop].loops[li].breakTy, TyUnit);
        ty := Cxs[CxTop].loops[li].breakTy;
      end
      else ty := Cxs[CxTop].loops[li].breakTy;
    end;
    lblId := Cxs[CxTop].loops[li].id;
    PopLoop;
  end;
  if isUnsafe then Dec(Cxs[CxTop].unsafeDepth);
  Cxs[CxTop].env.scope := saveScope;
  h := HBlockOf(stmts, tail, ty, n);
  if li >= 0 then
  begin
    r := HirAt(hBlockLabel, ty, n);
    Hirs[r].a := h;
    Hirs[r].n := lblId;
    Result := r;
  end
  else Result := h;
end;

function CheckIfExpr(n: Integer; expected: Integer): Integer;
var
  cond, thenH, elseH, h, resTy: Integer;
  anyNonNever: Boolean;
  th, el: Integer;
begin
  EnterScope;
  cond := CheckCondExpr(Nodes[n].a);
  if Nodes[n].c = 0 then
  begin
    thenH := CheckBlockExpr(Nodes[n].b, TyUnit);
    LeaveScope;
    if not IsNeverTy(Hirs[thenH].ty) then
      if not TryUnify(Hirs[thenH].ty, TyUnit) then
      begin
        ErrAt(Nodes[n].b, 'E0317', '`if` may be missing an `else` clause',
              'expected `' + TyStrZ(Hirs[thenH].ty) + '`, found `()`');
      end;
    h := HirAt(hIf, TyUnit, n);
    Hirs[h].a := cond;
    Hirs[h].b := thenH;
    Result := h;
    Exit;
  end;
  resTy := 0;
  if expected <> 0 then
  begin
    if Tys[Shallow(expected)].k <> tyVar then resTy := expected;
  end;
  thenH := CheckBlockExpr(Nodes[n].b, expected);
  LeaveScope;
  if Nodes[Nodes[n].c].k = eIf then elseH := CheckIfExpr(Nodes[n].c, expected)
  else elseH := CheckBlockExpr(Nodes[n].c, expected);
  if resTy = 0 then
  begin
    resTy := NewTyVar(0);
    if IsNeverTy(Hirs[thenH].ty) and (not IsNeverTy(Hirs[elseH].ty)) then
      resTy := Hirs[elseH].ty
    else if not IsNeverTy(Hirs[thenH].ty) then
      resTy := Hirs[thenH].ty;
  end;
  anyNonNever := (not IsNeverTy(Hirs[thenH].ty)) or (not IsNeverTy(Hirs[elseH].ty));
  if anyNonNever then
  begin
    thenH := JoinBranch(thenH, resTy, Nodes[n].b, '`if` and `else` have incompatible types');
    elseH := JoinBranch(elseH, resTy, Nodes[n].c, '`if` and `else` have incompatible types');
  end
  else resTy := TyNeverT;
  h := HirAt(hIf, resTy, n);
  Hirs[h].a := cond;
  Hirs[h].b := thenH;
  Hirs[h].c := elseH;
  Result := h;
end;

function CheckMatchExpr(n: Integer; expected: Integer): Integer;
var
  scrut, i, arm, p, g, body, resTy, h, st: Integer;
  arms: TIntArr;
  anyNonNever: Boolean;
  bodies: TIntArr;
  first: Boolean;
  pend: TIntArr;
begin
  scrut := CheckExpr(Nodes[n].a, 0);
  resTy := 0;
  if expected <> 0 then
    if Tys[Shallow(expected)].k <> tyVar then resTy := expected;
  arms := nil;
  anyNonNever := False;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    arm := Nodes[n].l[i];
    EnterScope;
    NPatB := 0;
    p := CheckPat(Nodes[arm].a, Hirs[scrut].ty, 0);
    g := 0;
    if Nodes[arm].b <> 0 then g := CheckCondExpr(Nodes[arm].b);
    body := CheckExpr(Nodes[arm].c, resTy);
    LeaveScope;
    if not IsNeverTy(Hirs[body].ty) then
    begin
      if resTy = 0 then resTy := Hirs[body].ty
      else body := JoinBranch(body, resTy, Nodes[arm].c, '`match` arms have incompatible types');
      anyNonNever := True;
    end;
    h := HirAt(hArm, 0, arm);
    Hirs[h].n := p;
    Hirs[h].a := g;
    Hirs[h].b := body;
    IAdd(arms, h);
  end;
  if (not anyNonNever) and (Length(arms) > 0) then
  begin
    if (resTy <> 0) and not IsNeverTy(resTy) and (expected <> 0) then
      resTy := expected
    else resTy := TyNeverT;
  end
  else if Length(arms) = 0 then resTy := TyNeverT;
  { aligner les types des bras jamais retournes }
  for i := 0 to Length(arms) - 1 do
  begin
    body := Hirs[arms[i]].b;
    if IsNeverTy(Hirs[body].ty) and (not IsNeverTy(resTy)) then
      Hirs[arms[i]].b := WrapCoerce(body, resTy, 1);
    Hirs[arms[i]].ty := resTy;
  end;
  h := HirAt(hMatch, resTy, n);
  Hirs[h].a := scrut;
  Hirs[h].l := arms;
  Result := h;
end;

function CheckLoopBodyUnit(n: Integer): Integer;
var
  b: Integer;
begin
  b := CheckBlockExpr(n, TyUnit);
  if not IsNeverTy(Hirs[b].ty) then
    if not TryUnify(Hirs[b].ty, TyUnit) then
      ErrAt(n, 'E0308', 'mismatched types', 'expected `()`, found `' + TyStrZ(Hirs[b].ty) + '`');
  Result := b;
end;

function CheckLoopExpr(n: Integer; expected: Integer): Integer;
var
  li, body, h, id: Integer;
begin
  li := PushLoop(Nodes[n].s, True);
  Cxs[CxTop].loops[li].breakTy := NewTyVar(0);
  if (expected <> 0) and (Tys[Shallow(expected)].k <> tyVar) then Unify(Cxs[CxTop].loops[li].breakTy, expected);
  id := Cxs[CxTop].loops[li].id;
  body := CheckLoopBodyUnit(Nodes[n].b);
  if Cxs[CxTop].loops[li].hasBreak then
    h := HirAt(hLoop, Cxs[CxTop].loops[li].breakTy, n)
  else
    h := HirAt(hLoop, TyNeverT, n);
  Hirs[h].a := body;
  Hirs[h].n := id;
  PopLoop;
  Result := h;
end;

function CheckWhileExpr(n: Integer): Integer;
var
  li, cond, body, h, id, brk, ifh: Integer;
begin
  li := PushLoop(Nodes[n].s, False);
  Cxs[CxTop].loops[li].breakTy := TyUnit;
  id := Cxs[CxTop].loops[li].id;
  EnterScope;
  cond := CheckCondExpr(Nodes[n].a);
  body := CheckLoopBodyUnit(Nodes[n].b);
  LeaveScope;
  brk := HirAt(hBreak, TyNeverT, n);
  Hirs[brk].n := id;
  ifh := HirAt(hIf, TyUnit, n);
  Hirs[ifh].a := cond;
  Hirs[ifh].b := body;
  Hirs[ifh].c := brk;
  h := HirAt(hLoop, TyUnit, n);
  Hirs[h].a := ifh;
  Hirs[h].n := id;
  PopLoop;
  Result := h;
end;

function CheckForExpr(n: Integer): Integer;
var
  iterE, iterTy, intoTr, ityp, itemTy, optTy, li, id, body, p, v, m, h, arm1, arm2, brk, nextCall, addr, pItem, pNone: Integer;
  targs, args, ta2: TIntArr;
  stmts: TIntArr;
  iterVar: Integer;
  letH, lp, sm: Integer;
  somePat, nonePat, someDef, noneDef: Integer;
  loc, bodyBlk: Integer;
  arms: TIntArr;
  pIter: Integer;
  e1: Integer;
begin
  iterE := CheckExpr(Nodes[n].b, 0);
  iterTy := StructResolve(Hirs[iterE].ty);
  if Tys[iterTy].k = tyErr then
  begin
    EnterScope; NPatB := 0;
    CheckPat(Nodes[n].a, TyErrT, 0);
    CheckLoopBodyUnit(Nodes[n].c);
    LeaveScope;
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  SetLength(targs, 1);
  targs[0] := iterTy;
  { IntoIterator::into_iter(expr) }
  AddObl(oblTrait, iterTy, LangIntoIterator, targs, '', 0, Nodes[n].b);
  SolveObligations;
  ityp := ProjectAssoc(iterTy, LangIntoIterator, targs, 'IntoIter', Nodes[n].b);
  ityp := Shallow(ityp);
  if Tys[ityp].k = tyErr then
  begin
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  SetLength(ta2, 1);
  ta2[0] := ityp;
  itemTy := ProjectAssoc(ityp, LangIterator, ta2, 'Item', Nodes[n].b);
  { let mut iter = into_iter(expr); }
  v := NewVarInfo('__iter', ityp, True, n);
  stmts := nil;
  SetLength(args, 1);
  args[0] := iterE;
  m := HCallFn(TraitAssocItem(LangIntoIterator, 'into_iter', dkFn), targs, args, ityp, Nodes[n].b);
  p := NewPat(pkBind, ityp);
  Pats[p].v := v;
  PatPos(p, n);
  letH := HirAt(hLet, TyUnit, n);
  Hirs[letH].n := p;
  Hirs[letH].a := m;
  IAdd(stmts, letH);
  { boucle : match de Iterator::next, Some(motif) pour le corps, None pour break }
  li := PushLoop(Nodes[n].s, False);
  Cxs[CxTop].loops[li].breakTy := TyUnit;
  id := Cxs[CxTop].loops[li].id;
  EnterScope;
  NPatB := 0;
  pItem := CheckPat(Nodes[n].a, itemTy, 0);
  body := CheckLoopBodyUnit(Nodes[n].c);
  LeaveScope;
  PopLoop;
  SetLength(args, 1);
  e1 := HirAt(hLocal, ityp, n);
  Hirs[e1].n := v;
  args[0] := HAddrOf(e1, True, n);
  SetLength(ta2, 1);
  ta2[0] := ityp;
  SetLength(targs, 1);
  targs[0] := itemTy;
  optTy := MkAdt(LangOption, targs);
  nextCall := HCallFn(TraitAssocItem(LangIterator, 'next', dkFn), ta2, args, optTy, n);
  someDef := ScopeLookup(LangOption, 'V', 'Some', 0);
  noneDef := ScopeLookup(LangOption, 'V', 'None', 0);
  somePat := NewPat(pkAdt, optTy);
  Pats[somePat].def := someDef;
  Pats[somePat].vidx := Defs[someDef].vindex;
  IAdd(Pats[somePat].l, pItem);
  nonePat := NewPat(pkAdt, optTy);
  Pats[nonePat].def := noneDef;
  Pats[nonePat].vidx := Defs[noneDef].vindex;
  arm1 := HirAt(hArm, TyUnit, n);
  Hirs[arm1].n := somePat;
  Hirs[arm1].b := body;
  brk := HirAt(hBreak, TyNeverT, n);
  Hirs[brk].n := id;
  brk := WrapCoerce(brk, TyUnit, 1);
  arm2 := HirAt(hArm, TyUnit, n);
  Hirs[arm2].n := nonePat;
  Hirs[arm2].b := brk;
  arms := nil;
  IAdd(arms, arm1);
  IAdd(arms, arm2);
  sm := HirAt(hMatch, TyUnit, n);
  Hirs[sm].a := nextCall;
  Hirs[sm].l := arms;
  lp := HirAt(hLoop, TyUnit, n);
  Hirs[lp].a := sm;
  Hirs[lp].n := id;
  loc := HirAt(hExprStmt, TyUnit, n);
  Hirs[loc].a := lp;
  IAdd(stmts, loc);
  Result := HBlockOf(stmts, 0, TyUnit, n);
end;

function CheckBreakExpr(n: Integer): Integer;
var
  li, v, h: Integer;
  lbl: string;
begin
  lbl := Nodes[n].s;
  li := FindLoop(lbl);
  if li < 0 then
  begin
    if lbl <> '' then
      ErrAt(n, 'E0426', 'use of undeclared label `' + lbl + '`', 'undeclared label `' + lbl + '`')
    else
      ErrAt(n, 'E0268', '`break` outside of a loop or labeled block', 'cannot `break` outside of a loop or labeled block');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  with Cxs[CxTop].loops[li] do
  begin
    hasBreak := True;
    if breakTy = 0 then breakTy := NewTyVar(0);
  end;
  v := 0;
  if Nodes[n].a <> 0 then
  begin
    if (not Cxs[CxTop].loops[li].isLoop) and (Cxs[CxTop].loops[li].lbl <> '') and
       (Cxs[CxTop].loops[li].breakTy = TyUnit) and False then ;
    v := CheckExprCoerce(Nodes[n].a, Cxs[CxTop].loops[li].breakTy);
  end
  else
  begin
    if not TryUnify(Cxs[CxTop].loops[li].breakTy, TyUnit) then
      ErrAt(n, 'E0308', 'mismatched types', 'expected `' + TyStrZ(Cxs[CxTop].loops[li].breakTy) + '`, found `()`');
  end;
  h := HirAt(hBreak, TyNeverT, n);
  Hirs[h].n := Cxs[CxTop].loops[li].id;
  Hirs[h].a := v;
  Result := h;
end;

function CheckContinueExpr(n: Integer): Integer;
var
  li, h: Integer;
begin
  li := FindLoop(Nodes[n].s);
  if li < 0 then
  begin
    ErrAt(n, 'E0268', '`continue` outside of a loop', 'cannot `continue` outside of a loop');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  h := HirAt(hContinue, TyNeverT, n);
  Hirs[h].n := Cxs[CxTop].loops[li].id;
  Result := h;
end;

function CheckReturnExpr(n: Integer): Integer;
var
  v, h, retT: Integer;
begin
  retT := Cxs[CxTop].retTy;
  v := 0;
  if Nodes[n].a <> 0 then v := CheckExprCoerce(Nodes[n].a, retT)
  else
  begin
    if not TryUnify(retT, TyUnit) then
      ErrAt(n, 'E0069', '`return;` in a function whose return type is not `()`', 'return type is `' + TyStrZ(retT) + '`');
  end;
  h := HirAt(hReturn, TyNeverT, n);
  Hirs[h].a := v;
  Result := h;
end;

{ ---- fermetures ---- }

function CheckClosureExpr(n: Integer; expected: Integer): Integer;
var
  cid, bidx, i, oi, p, pn, v, h, retTy, bodyH, ct, pp, e: Integer;
  ptys: TIntArr;
  obl: Integer;
  prm: Integer;
  params: TIntArr;
  stmts: TIntArr;
  pat: Integer;
  hasObl: Boolean;
  fnParams: TIntArr;
  fnRet: Integer;
  letH: Integer;
begin
  cid := NewClosure;
  Closures[cid].node := n;
  Closures[cid].isMove := (Nodes[n].f and 1) <> 0;
  { signature attendue }
  hasObl := False;
  fnParams := nil;
  fnRet := 0;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if Tys[e].k = tyVar then
    begin
      obl := FindFnObl(e);
      if obl >= 0 then
      begin
        hasObl := True;
        fnParams := Obls[obl].targs;
        fnRet := Obls[obl].res;
      end;
    end
    else if Tys[e].k = tyFnPtr then
    begin
      hasObl := True;
      SetLength(fnParams, Length(Tys[e].args) - 1);
      for i := 0 to Length(fnParams) - 1 do fnParams[i] := Tys[e].args[i];
      fnRet := Tys[e].args[Length(Tys[e].args) - 1];
    end
    else if (Tys[e].k = tyDyn) and (Defs[Tys[e].def].lang = 'fn') and (Length(Tys[e].args) >= 2) then
    begin
      hasObl := True;
      fnParams := Tys[Shallow(Tys[e].args[0])].args;
      fnRet := Tys[e].args[1];
    end;
  end;
  ptys := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    prm := Nodes[n].l[i];
    if Nodes[prm].b <> 0 then
    begin
      pp := LowerInCtx(Nodes[prm].b);
      if hasObl and (i < Length(fnParams)) then TryUnify(pp, fnParams[i]);
    end
    else if hasObl and (i < Length(fnParams)) then pp := fnParams[i]
    else pp := NewTyVar(0);
    IAdd(ptys, pp);
  end;
  if Nodes[n].a <> 0 then
  begin
    retTy := LowerInCtx(Nodes[n].a);
    if hasObl and (fnRet <> 0) then TryUnify(retTy, fnRet);
  end
  else if hasObl and (fnRet <> 0) then retTy := fnRet
  else retTy := NewTyVar(0);
  Closures[cid].params := ptys;
  Closures[cid].ret := retTy;
  ct := MkClosureTy(cid);
  { corps }
  if NBodies >= Length(Bodies) then SetLength(Bodies, NBodies * 2 + 16);
  bidx := NBodies;
  Inc(NBodies);
  Bodies[bidx].def := Cxs[CxBase + 1].env.defn;
  Bodies[bidx].isClosure := True;
  Bodies[bidx].closure := cid;
  Bodies[bidx].nvars := 0;
  Bodies[bidx].vars := nil;
  Bodies[bidx].params := nil;
  Closures[cid].bodyIdx := bidx;
  IAdd(InstBodies, bidx);
  PushCtx(bidx, cid);
  Cxs[CxTop].retTy := retTy;
  EnterScope;
  stmts := nil;
  params := nil;
  for i := 0 to Length(Nodes[n].l) - 1 do
  begin
    prm := Nodes[n].l[i];
    pn := Nodes[prm].a;
    if (Nodes[pn].k = pIdent) and (Nodes[pn].a = 0) and ((Nodes[pn].f and 1) = 0) then
    begin
      v := NewVarInfo(Nodes[pn].s, ptys[i], (Nodes[pn].f and 2) <> 0, pn);
      Bodies[bidx].vars[v].isParam := True;
      DeclareVar(Nodes[pn].s, v);
      IAdd(params, v);
    end
    else
    begin
      v := NewVarInfo('__arg' + IntToStr(i), ptys[i], False, pn);
      Bodies[bidx].vars[v].isParam := True;
      IAdd(params, v);
      NPatB := 0;
      pat := CheckPat(pn, ptys[i], 0);
      h := HirAt(hLocal, ptys[i], pn);
      Hirs[h].n := v;
      letH := HirAt(hLet, TyUnit, pn);
      Hirs[letH].n := pat;
      Hirs[letH].a := h;
      IAdd(stmts, letH);
    end;
  end;
  bodyH := CheckExpr(Nodes[n].b, retTy);
  bodyH := CoerceTo(bodyH, retTy, Nodes[n].b);
  LeaveScope;
  PopCtx;
  if Length(stmts) > 0 then
    bodyH := HBlockOf(stmts, bodyH, Hirs[bodyH].ty, Nodes[n].b);
  Bodies[bidx].params := params;
  Bodies[bidx].paramTys := ptys;
  Bodies[bidx].ret := retTy;
  Bodies[bidx].root := bodyH;
  Bodies[bidx].done := True;
  h := HirAt(hClosure, ct, n);
  Hirs[h].n := cid;
  Hirs[h].l := Closures[cid].capVars;
  if expected <> 0 then
  begin
    e := Shallow(expected);
    if Tys[e].k = tyVar then Unify(e, ct);
  end;
  Result := h;
end;

{ ---- distribution principale ---- }

function CheckExpr(n: Integer; expected: Integer): Integer;
var
  h: Integer;
begin
  case Nodes[n].k of
    eLit: Result := CheckLit(n, expected);
    ePath: Result := CheckPathExpr(n, expected);
    eParen: Result := CheckExpr(Nodes[n].a, expected);
    eUnary: Result := CheckUnary(n, expected);
    eBinary: Result := CheckBinary(n, expected);
    eAssign: Result := CheckAssign(n);
    eAssignOp: Result := CheckAssignOp(n);
    eCast: Result := CheckCast(n);
    eRef: Result := CheckRefExpr(n, expected);
    eDeref: Result := CheckDerefExpr(n);
    eField: Result := CheckField(n);
    eTupleField: Result := CheckTupleField(n);
    eIndex: Result := CheckIndex(n);
    eCall: Result := CheckCall(n, expected);
    eMethod: Result := CheckMethodCall(n, expected);
    eStruct: Result := CheckStructLit(n, expected);
    eTuple: Result := CheckTupleExpr(n, expected);
    eArray: Result := CheckArrayExpr(n, expected);
    eRepeat: Result := CheckRepeatExpr(n, expected);
    eRange: Result := CheckRangeExpr(n, expected);
    eTry: Result := CheckTryExpr(n, expected);
    eBlock: Result := CheckBlockExpr(n, expected);
    eIf: Result := CheckIfExpr(n, expected);
    eMatch: Result := CheckMatchExpr(n, expected);
    eLoop: Result := CheckLoopExpr(n, expected);
    eWhile: Result := CheckWhileExpr(n);
    eFor: Result := CheckForExpr(n);
    eBreak: Result := CheckBreakExpr(n);
    eContinue: Result := CheckContinueExpr(n);
    eReturn: Result := CheckReturnExpr(n);
    eClosure: Result := CheckClosureExpr(n, expected);
    eMacro: Result := CheckMacroExpr(n, expected);
    eLet:
      begin
        ErrAt(n, '', 'expected expression, found `let` statement', '');
        Result := HirAt(hUnit, TyErrT, n);
      end;
    eUnderscore:
      begin
        ErrAt(n, '', 'in expressions, `_` can only be used on the left-hand side of an assignment',
              '`_` not allowed here');
        Result := HirAt(hUnit, TyErrT, n);
      end;
  else
    ErrAt(n, '', 'unsupported expression', '');
    Result := HirAt(hUnit, TyErrT, n);
  end;
end;

{ ============================================================ }
{ Macros integrees : expansion par gabarit de code source       }
{ ============================================================ }

Type
  TFmtPiece = record
    lit: string;
    isArg: Boolean;
    arg: Integer;          { indice d'argument }
    trait: string;         { Display, Debug, LowerHex ... }
    fill: Char;
    align: Integer;        { 0 defaut 1 gauche 2 centre 3 droite }
    flags: Integer;        { 1 plus 2 dièse 4 zero }
    wKind: Integer;        { 0 aucun, 1 nombre, 2 argument }
    wVal: Integer;
    pKind: Integer;
    pVal: Integer;
  end;
  TFmtPieces = array of TFmtPiece;

Var
  SrcPathForLoc: string;
  SynthCounter: Integer;

function ParseSynthBlock(const text: string; site: Integer): Integer;
var
  fi, startNode, i: Integer;
  svToks: TTokArr;
  svN, svPos: Integer;
  svNS: Boolean;
begin
  Inc(SynthCounter);
  fi := AddSourceFile('<macro ' + IntToStr(SynthCounter) + '>', text);
  startNode := NNodes;
  svToks := Toks;
  svN := NToks;
  svPos := TokPos;
  svNS := NoStruct;
  Toks := nil;
  NToks := 0;
  LexFile(fi);
  TokPos := 0;
  NoStruct := False;
  Result := ParseBlock;
  Toks := svToks;
  NToks := svN;
  TokPos := svPos;
  NoStruct := svNS;
  { relocalise tous les noeuds crees sur le site d'appel }
  for i := startNode to NNodes - 1 do
  begin
    Nodes[i].fi := Nodes[site].fi;
    Nodes[i].line := Nodes[site].line;
    Nodes[i].col := Nodes[site].col;
    Nodes[i].eline := Nodes[site].eline;
    Nodes[i].ecol := Nodes[site].ecol;
  end;
end;

{ Substitue les marques __argN par les arguments reels }
procedure SubstArgs(startNode: Integer; const args: TIntArr);
var
  i, p, k: Integer;
  nm: string;
  saved: TNode;
  idx: Integer;
begin
  for i := startNode to NNodes - 1 do
  begin
    if Nodes[i].k <> ePath then Continue;
    p := Nodes[i].a;
    if (p = 0) or (Length(Nodes[p].l) <> 1) then Continue;
    nm := Nodes[Nodes[p].l[0]].s;
    if (Length(nm) > 5) and (Copy(nm, 1, 5) = '__arg') then
    begin
      idx := StrToIntDef(Copy(nm, 6, 10), -1);
      if (idx >= 0) and (idx < Length(args)) then
      begin
        saved := Nodes[args[idx]];
        Nodes[i] := saved;
      end;
    end;
  end;
end;

function SourceText(n: Integer): string;
var
  fi, l1, c1, l2, c2, a, b: Integer;
begin
  Result := '';
  fi := Nodes[n].fi;
  if (fi < 0) or (fi >= NFiles) then Exit;
  l1 := Nodes[n].line; c1 := Nodes[n].col;
  l2 := Nodes[n].eline; c2 := Nodes[n].ecol;
  if (l1 < 1) or (l1 > Files[fi].nlines) then Exit;
  if l2 < l1 then begin l2 := l1; c2 := c1 + 1; end;
  a := Files[fi].lines[l1 - 1] + c1 - 1;
  if l2 > Files[fi].nlines then b := Length(Files[fi].text) + 1
  else b := Files[fi].lines[l2 - 1] + c2 - 1;
  if b > Length(Files[fi].text) + 1 then b := Length(Files[fi].text) + 1;
  Result := Copy(Files[fi].text, a, b - a);
end;

function RustEscape(const s: string): string;
var
  i: Integer;
  c: Char;
begin
  Result := '';
  for i := 1 to Length(s) do
  begin
    c := s[i];
    case c of
      '"': Result := Result + '\"';
      '\': Result := Result + '\\';
      #10: Result := Result + '\n';
      #13: Result := Result + '\r';
      #9: Result := Result + '\t';
      #0: Result := Result + '\0';
    else
      Result := Result + c;
    end;
  end;
end;

function LocString(n: Integer): string;
begin
  Result := SrcPathForLoc + ':' + IntToStr(Nodes[n].line) + ':' + IntToStr(Nodes[n].col);
end;

function FmtTraitPath(const t: string): string;
begin
  Result := '::std::fmt::' + t;
end;

function Trim2(const s: string): string;
var
  a, b: Integer;
begin
  a := 1;
  b := Length(s);
  while (a <= b) and (s[a] = ' ') do Inc(a);
  while (b >= a) and (s[b] = ' ') do Dec(b);
  Result := Copy(s, a, b - a + 1);
end;

{ Analyse la chaine de format. nPos = nombre d'arguments positionnels ; names = noms des arguments nommes }
function ParseFormatString(const fs: string; nPos: Integer; var names: TStrArr; node: Integer;
  var pieces: TFmtPieces; var implicit: TStrArr): Boolean;
var
  i, n, k, nextPos: Integer;
  lit, spec, argName, tmp: string;
  pc: TFmtPiece;
  c: Char;
  total: Integer;

  function FindName(const nm: string): Integer;
  var
    j: Integer;
  begin
    Result := -1;
    for j := 0 to Length(names) - 1 do
      if names[j] = nm then begin Result := nPos + j; Exit; end;
    { capture implicite }
    for j := 0 to Length(implicit) - 1 do
      if implicit[j] = nm then begin Result := nPos + Length(names) + j; Exit; end;
    SAdd(implicit, nm);
    Result := nPos + Length(names) + Length(implicit) - 1;
  end;

  procedure AddLit;
  begin
    if lit <> '' then
    begin
      pc.lit := lit;
      pc.isArg := False;
      SetLength(pieces, Length(pieces) + 1);
      pieces[Length(pieces) - 1] := pc;
      lit := '';
    end;
  end;

  function ParseCount(var p: Integer; var kind, val: Integer): Boolean;
  var
    st: Integer;
    id: string;
  begin
    Result := False;
    kind := 0;
    val := 0;
    st := p;
    if (p <= Length(spec)) and IsDigitC(spec[p]) then
    begin
      while (p <= Length(spec)) and IsDigitC(spec[p]) do Inc(p);
      val := StrToIntDef(Copy(spec, st, p - st), 0);
      if (p <= Length(spec)) and (spec[p] = '$') then
      begin
        Inc(p);
        kind := 2;
      end
      else kind := 1;
      Result := True;
    end
    else if (p <= Length(spec)) and IsIdStart(spec[p]) then
    begin
      while (p <= Length(spec)) and IsIdChar(spec[p]) do Inc(p);
      id := Copy(spec, st, p - st);
      if (p <= Length(spec)) and (spec[p] = '$') then
      begin
        Inc(p);
        kind := 2;
        val := FindName(id);
        Result := True;
      end
      else p := st;
    end;
  end;

  procedure ParseSpec;
  var
    p, a, k1: Integer;
    tp: string;
    kd, vl: Integer;
  begin
    pc.fill := ' ';
    pc.align := 0;
    pc.flags := 0;
    pc.wKind := 0; pc.pKind := 0; pc.wVal := 0; pc.pVal := 0;
    pc.trait := 'Display';
    p := 1;
    { fill + align }
    if Length(spec) >= 2 then
    begin
      a := 0;
      k1 := 1;
      { le caractere de remplissage peut etre multi-octet : on ne gere que l'ASCII et UTF-8 simple }
      if (Ord(spec[1]) >= 128) then
      begin
        k1 := 1;
        while (k1 < Length(spec)) and ((Ord(spec[k1 + 1]) and $C0) = $80) do Inc(k1);
      end;
      if k1 + 1 <= Length(spec) then
      begin
        case spec[k1 + 1] of
          '<': a := 1;
          '^': a := 2;
          '>': a := 3;
        end;
        if a > 0 then
        begin
          if k1 = 1 then pc.fill := spec[1] else pc.fill := '?';
          pc.align := a;
          p := k1 + 2;
        end;
      end;
    end;
    if (p = 1) and (Length(spec) >= 1) then
    begin
      case spec[1] of
        '<': begin pc.align := 1; p := 2; end;
        '^': begin pc.align := 2; p := 2; end;
        '>': begin pc.align := 3; p := 2; end;
      end;
    end;
    if (p <= Length(spec)) and (spec[p] = '+') then begin pc.flags := pc.flags or 1; Inc(p); end
    else if (p <= Length(spec)) and (spec[p] = '-') then Inc(p);
    if (p <= Length(spec)) and (spec[p] = '#') then begin pc.flags := pc.flags or 2; Inc(p); end;
    if (p <= Length(spec)) and (spec[p] = '0') and not ((p < Length(spec)) and (spec[p + 1] = '$')) then
    begin
      pc.flags := pc.flags or 4;
      Inc(p);
    end;
    if ParseCount(p, kd, vl) then begin pc.wKind := kd; pc.wVal := vl; end;
    if (p <= Length(spec)) and (spec[p] = '.') then
    begin
      Inc(p);
      if (p <= Length(spec)) and (spec[p] = '*') then
      begin
        Inc(p);
        pc.pKind := 2;
        pc.pVal := nextPos;
        Inc(nextPos);
      end
      else if ParseCount(p, kd, vl) then begin pc.pKind := kd; pc.pVal := vl; end;
    end;
    tp := Copy(spec, p, Length(spec));
    if tp = '' then pc.trait := 'Display'
    else if tp = '?' then pc.trait := 'Debug'
    else if tp = 'x?' then begin pc.trait := 'Debug'; pc.flags := pc.flags or 8; end
    else if tp = 'X?' then begin pc.trait := 'Debug'; pc.flags := pc.flags or 16; end
    else if tp = 'x' then pc.trait := 'LowerHex'
    else if tp = 'X' then pc.trait := 'UpperHex'
    else if tp = 'o' then pc.trait := 'Octal'
    else if tp = 'b' then pc.trait := 'Binary'
    else if tp = 'e' then pc.trait := 'LowerExp'
    else if tp = 'E' then pc.trait := 'UpperExp'
    else if tp = 'p' then pc.trait := 'Pointer'
    else
    begin
      Report(True, '', 'unknown format trait `' + tp + '`', Nodes[node].fi, Nodes[node].line, Nodes[node].col,
             NodeLen(node), '');
    end;
  end;

begin
  Result := True;
  pieces := nil;
  lit := '';
  nextPos := 0;
  FillChar(pc, SizeOf(pc), 0);
  n := Length(fs);
  i := 1;
  while i <= n do
  begin
    c := fs[i];
    if c = '{' then
    begin
      if (i < n) and (fs[i + 1] = '{') then begin lit := lit + '{'; Inc(i, 2); Continue; end;
      AddLit;
      k := i + 1;
      while (k <= n) and (fs[k] <> '}') do Inc(k);
      if k > n then
      begin
        Report(True, '', 'invalid format string: expected `}` but string was terminated', Nodes[node].fi,
               Nodes[node].line, Nodes[node].col, NodeLen(node), 'expected `}` in format string');
        Result := False;
        Exit;
      end;
      tmp := Copy(fs, i + 1, k - i - 1);
      argName := tmp;
      spec := '';
      if Pos(':', tmp) > 0 then
      begin
        argName := Copy(tmp, 1, Pos(':', tmp) - 1);
        spec := Copy(tmp, Pos(':', tmp) + 1, Length(tmp));
      end;
      argName := Trim2(argName);
      ParseSpec;
      pc.isArg := True;
      if argName = '' then
      begin
        { le .* consomme un argument avant la valeur }
        pc.arg := nextPos;
        Inc(nextPos);
        if pc.pKind = 2 then
          if pc.pVal = nextPos - 1 then
          begin
            { cas .* : la precision est l'argument courant, la valeur est le suivant }
            pc.pVal := nextPos - 1;
            pc.arg := nextPos;
            Inc(nextPos);
          end;
      end
      else if IsDigitC(argName[1]) then pc.arg := StrToIntDef(argName, 0)
      else pc.arg := FindName(argName);
      pc.lit := '';
      SetLength(pieces, Length(pieces) + 1);
      pieces[Length(pieces) - 1] := pc;
      i := k + 1;
      Continue;
    end;
    if c = '}' then
    begin
      if (i < n) and (fs[i + 1] = '}') then begin lit := lit + '}'; Inc(i, 2); Continue; end;
      Report(True, '', 'invalid format string: unmatched `}` found', Nodes[node].fi, Nodes[node].line,
             Nodes[node].col, NodeLen(node), 'unmatched `}` in format string');
      Result := False;
      Exit;
    end;
    lit := lit + c;
    Inc(i);
  end;
  AddLit;
end;


{ Fabrique un noeud ePath simple pour une capture implicite }
function MkNameExpr(const nm: string; site: Integer): Integer;
var
  p, sg, e: Integer;
begin
  sg := NewNode(nSeg);
  Nodes[sg].s := nm;
  p := NewNode(tPath);
  IAdd(Nodes[p].l, sg);
  e := NewNode(ePath);
  Nodes[e].a := p;
  Nodes[sg].fi := Nodes[site].fi; Nodes[sg].line := Nodes[site].line; Nodes[sg].col := Nodes[site].col;
  Nodes[p].fi := Nodes[site].fi; Nodes[p].line := Nodes[site].line; Nodes[p].col := Nodes[site].col;
  Nodes[e].fi := Nodes[site].fi; Nodes[e].line := Nodes[site].line; Nodes[e].col := Nodes[site].col;
  Nodes[e].eline := Nodes[site].eline; Nodes[e].ecol := Nodes[site].ecol;
  Result := e;
end;

{ Genere le code de remplissage du formateur (variable __f) : retourne le texte ;
  argNodes recoit la liste des arguments pour __argN (les valeurs) }
function BuildFormatBody(n: Integer; fmtIdx: Integer; newline: Boolean; var argNodes: TIntArr;
  var okFlag: Boolean): string;
var
  args: TIntArr;
  fmtNode: Integer;
  fs: string;
  pieces: TFmtPieces;
  names, implicit: TStrArr;
  nPos, i, j, a: Integer;
  s, code, lets, w, pr: string;
  pc: TFmtPiece;
  namedNodes: TIntArr;
  nm: string;
  posNodes: TIntArr;
  usedArg: array of Boolean;
begin
  okFlag := True;
  args := Nodes[n].l;
  Result := '';
  if fmtIdx >= Length(args) then
  begin
    if newline then Result := '__f.push_str("\n");';
    Exit;
  end;
  fmtNode := args[fmtIdx];
  while Nodes[fmtNode].k = eParen do fmtNode := Nodes[fmtNode].a;
  if not ((Nodes[fmtNode].k = eLit) and (Nodes[fmtNode].f = lkStr)) then
  begin
    ErrAt(fmtNode, '', 'format argument must be a string literal', '');
    okFlag := False;
    Exit;
  end;
  fs := Nodes[fmtNode].s;
  posNodes := nil;
  namedNodes := nil;
  names := nil;
  for i := fmtIdx + 1 to Length(args) - 1 do
  begin
    if Nodes[args[i]].k = eNamedArg then
    begin
      SAdd(names, Nodes[args[i]].s);
      IAdd(namedNodes, Nodes[args[i]].a);
    end
    else IAdd(posNodes, args[i]);
  end;
  nPos := Length(posNodes);
  implicit := nil;
  if not ParseFormatString(fs, nPos, names, fmtNode, pieces, implicit) then
  begin
    okFlag := False;
    Exit;
  end;
  { tous les arguments : positionnels, nommes, captures implicites }
  argNodes := nil;
  for i := 0 to nPos - 1 do IAdd(argNodes, posNodes[i]);
  for i := 0 to Length(namedNodes) - 1 do IAdd(argNodes, namedNodes[i]);
  for i := 0 to Length(implicit) - 1 do IAdd(argNodes, MkNameExpr(implicit[i], fmtNode));
  SetLength(usedArg, Length(argNodes));
  lets := '';
  for i := 0 to Length(pieces) - 1 do
  begin
    pc := pieces[i];
    if not pc.isArg then Continue;
    if pc.arg >= Length(argNodes) then
    begin
      ErrAt(fmtNode, '', IntToStr(Length(pieces)) + ' positional argument' + Copy('s', 1, Ord(Length(pieces) <> 1)) +
            ' in format string, but there ' + Copy('is', 1, Ord(nPos = 1)) + Copy('are', 1, Ord(nPos <> 1)) + ' ' +
            IntToStr(nPos) + ' argument' + Copy('s', 1, Ord(nPos <> 1)), 'invalid reference to positional argument ' +
            IntToStr(pc.arg));
      okFlag := False;
      Exit;
    end;
    usedArg[pc.arg] := True;
    if pc.wKind = 2 then
      if pc.wVal < Length(usedArg) then usedArg[pc.wVal] := True;
    if pc.pKind = 2 then
      if pc.pVal < Length(usedArg) then usedArg[pc.pVal] := True;
  end;
  for i := 0 to Length(argNodes) - 1 do
    if not usedArg[i] then
    begin
      ErrAt(argNodes[i], '', 'argument never used', 'argument never used');
      okFlag := False;
      Exit;
    end;
  for i := 0 to Length(argNodes) - 1 do
    lets := lets + 'let __a' + IntToStr(i) + ' = &(__arg' + IntToStr(i) + ');' + #10;
  code := '';
  for i := 0 to Length(pieces) - 1 do
  begin
    pc := pieces[i];
    if not pc.isArg then
    begin
      code := code + '__f.push_str("' + RustEscape(pc.lit) + '");' + #10;
      Continue;
    end;
    case pc.wKind of
      1: w := IntToStr(pc.wVal);
      2: w := '*__a' + IntToStr(pc.wVal);
    else
      w := '::std::usize::MAX';
    end;
    case pc.pKind of
      1: pr := IntToStr(pc.pVal);
      2: pr := '*__a' + IntToStr(pc.pVal);
    else
      pr := '::std::usize::MAX';
    end;
    s := '';
    if (pc.fill = '''') or (pc.fill = '\') then s := '''\' + pc.fill + '''' else s := '''' + pc.fill + '''';
    code := code + '__f.set_spec(' + s + ', ' + IntToStr(pc.align) + ', ' + IntToStr(pc.flags) + ', ' + w + ', ' + pr +
            ');' + #10;
    code := code + 'let _ = ' + FmtTraitPath(pc.trait) + '::fmt(__a' + IntToStr(pc.arg) + ', &mut __f);' + #10;
  end;
  if newline then code := code + '__f.push_str("\n");' + #10;
  Result := lets + 'let mut __f = ::std::fmt::Formatter::new();' + #10 + code;
end;

function ExpandAndCheck(n: Integer; const text: string; const args: TIntArr; expected: Integer): Integer;
var
  startNode, blk: Integer;
  h: Integer;
begin
  startNode := NNodes;
  blk := ParseSynthBlock(text, n);
  SubstArgs(startNode, args);
  h := CheckBlockExpr(blk, expected);
  Result := h;
end;

function PanicLocText(n: Integer): string;
begin
  Result := '"' + RustEscape(LocString(n)) + '"';
end;

function CheckMacroExpr(n: Integer; expected: Integer): Integer;
var
  name: string;
  args, argNodes, one: TIntArr;
  body, text, msg, cond, loc: string;
  ok: Boolean;
  fmtIdx, i, h, m, arm, p1, p2, e, blk, startNode: Integer;
  newline: Boolean;
  nodeCopy: TNode;
  isDebug: Boolean;
  s: string;
  lit: Integer;
begin
  name := Nodes[n].s;
  args := Nodes[n].l;
  loc := PanicLocText(n);
  { macros sans formatage }
  if name = 'vec' then
  begin
    argNodes := nil;
    if Nodes[n].f = 1 then
    begin
      IAdd(argNodes, Nodes[n].a);
      IAdd(argNodes, Nodes[n].b);
      text := '{ ::std::vec::from_elem(__arg0, __arg1) }';
    end
    else if Length(args) = 0 then
      text := '{ ::std::vec::Vec::new() }'
    else
    begin
      text := '{ ::std::vec::from_array([';
      for i := 0 to Length(args) - 1 do
      begin
        if i > 0 then text := text + ', ';
        text := text + '__arg' + IntToStr(i);
        IAdd(argNodes, args[i]);
      end;
      text := text + ']) }';
    end;
    Result := ExpandAndCheck(n, text, argNodes, expected);
    Exit;
  end;
  if name = 'matches' then
  begin
    m := NewNode(eMatch);
    Nodes[m].fi := Nodes[n].fi; Nodes[m].line := Nodes[n].line; Nodes[m].col := Nodes[n].col;
    Nodes[m].eline := Nodes[n].eline; Nodes[m].ecol := Nodes[n].ecol;
    Nodes[m].a := Nodes[n].a;
    arm := NewNode(nArm);
    Nodes[arm].a := Nodes[n].b;
    Nodes[arm].b := Nodes[n].c;
    lit := NewNode(eLit);
    Nodes[lit].f := lkBool;
    Nodes[lit].iv := 1;
    Nodes[arm].c := lit;
    IAdd(Nodes[m].l, arm);
    arm := NewNode(nArm);
    Nodes[arm].a := NewNode(pWild);
    lit := NewNode(eLit);
    Nodes[lit].f := lkBool;
    Nodes[arm].c := lit;
    IAdd(Nodes[m].l, arm);
    for i := Nodes[n].fi * 0 + 0 to 0 do ;
    Result := CheckMatchExpr(m, expected);
    Exit;
  end;
  if name = 'line' then
  begin
    Result := HirAt(hLitInt, TyU32, n);
    Hirs[Result].n := Nodes[n].line;
    Exit;
  end;
  if name = 'column' then
  begin
    Result := HirAt(hLitInt, TyU32, n);
    Hirs[Result].n := Nodes[n].col;
    Exit;
  end;
  if name = 'file' then begin Result := HStrLit(SrcPathForLoc, n); Exit; end;
  if name = 'module_path' then begin Result := HStrLit('main', n); Exit; end;
  if name = 'stringify' then
  begin
    s := '';
    for i := 0 to Length(args) - 1 do
    begin
      if i > 0 then s := s + ', ';
      s := s + SourceText(args[i]);
    end;
    Result := HStrLit(s, n);
    Exit;
  end;
  if name = 'concat' then
  begin
    s := '';
    for i := 0 to Length(args) - 1 do
    begin
      e := args[i];
      if (Nodes[e].k = eLit) then
      begin
        case Nodes[e].f of
          lkStr: s := s + Nodes[e].s;
          lkInt: s := s + UIntToStr(Nodes[e].iv);
          lkChar: s := s + Utf8Encode(Integer(Nodes[e].iv));
          lkBool: if Nodes[e].iv <> 0 then s := s + 'true' else s := s + 'false';
          lkFloat: s := s + Nodes[e].s;
        end;
      end
      else ErrAt(e, '', 'expected a literal', 'concat! accepts only literals');
    end;
    Result := HStrLit(s, n);
    Exit;
  end;
  if name = 'cfg' then
  begin
    Result := HBool(False, n);
    Exit;
  end;
  if (name = 'env') or (name = 'option_env') or (name = 'include_str') or (name = 'compile_error') or
     (name = 'thread_local') or (name = 'is_x86_feature_detected') then
  begin
    ErrAt(n, '', 'the macro `' + name + '!` is not supported by this compiler', '');
    Result := HirAt(hUnit, TyErrT, n);
    Exit;
  end;
  if (name = 'dbg') then
  begin
    if Length(args) = 0 then
    begin
      text := '{ ::std::io::_eprint_str("[' + RustEscape(LocString(n)) + ']\n"); }';
      Result := ExpandAndCheck(n, text, nil, expected);
      Exit;
    end;
    text := '{ match __arg0 { __tmp => { ::std::io::_dbg_print("[' + RustEscape(LocString(n)) + '] ' +
            RustEscape(SourceText(args[0])) + ' = ", &__tmp); __tmp } } }';
    one := nil;
    IAdd(one, args[0]);
    Result := ExpandAndCheck(n, text, one, expected);
    Exit;
  end;
  { macros de formatage }
  newline := False;
  fmtIdx := 0;
  if (name = 'println') or (name = 'print') or (name = 'eprintln') or (name = 'eprint') or (name = 'format') or
     (name = 'format_args') then
  begin
    newline := (name = 'println') or (name = 'eprintln');
    body := BuildFormatBody(n, 0, newline, argNodes, ok);
    if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
    if body = '' then body := 'let mut __f = ::std::fmt::Formatter::new();' + #10;
    if (name = 'println') or (name = 'print') then text := '{ ' + body + ' __f.print_out(); }'
    else if (name = 'eprintln') or (name = 'eprint') then text := '{ ' + body + ' __f.print_err(); }'
    else text := '{ ' + body + ' __f.into_string() }';
    Result := ExpandAndCheck(n, text, argNodes, expected);
    Exit;
  end;
  if (name = 'write') or (name = 'writeln') then
  begin
    if Length(args) = 0 then
    begin
      ErrAt(n, '', 'requires at least a format string argument', '');
      Result := HirAt(hUnit, TyErrT, n);
      Exit;
    end;
    body := BuildFormatBody(n, 1, name = 'writeln', argNodes, ok);
    if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
    if body = '' then body := 'let mut __f = ::std::fmt::Formatter::new();' + #10;
    { le premier argument est la destination : __dst }
    one := nil;
    IAdd(one, args[0]);
    for i := 0 to Length(argNodes) - 1 do IAdd(one, argNodes[i]);
    { renumeroter : __arg0 = destination, les arguments de format deviennent __arg1... }
    body := ReplaceAll(body, '__arg', '__argX');
    for i := Length(argNodes) - 1 downto 0 do
      body := ReplaceAll(body, '__argX' + IntToStr(i) + ')', '__arg' + IntToStr(i + 1) + ')');
    body := ReplaceAll(body, '__argX', '__arg');
    text := '{ ' + body + ' (__arg0).__write_fmt_string(__f.into_string()) }';
    Result := ExpandAndCheck(n, text, one, expected);
    Exit;
  end;
  if name = 'panic' then
  begin
    if Length(args) = 0 then
      text := '{ ::std::rt::begin_panic_str("explicit panic", ' + loc + ') }'
    else
    begin
      body := BuildFormatBody(n, 0, False, argNodes, ok);
      if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
      text := '{ ' + body + ' ::std::rt::begin_panic(__f.into_string(), ' + loc + ') }';
    end;
    Result := ExpandAndCheck(n, text, argNodes, expected);
    Exit;
  end;
  if (name = 'unreachable') or (name = 'todo') or (name = 'unimplemented') then
  begin
    if name = 'unreachable' then msg := 'internal error: entered unreachable code'
    else if name = 'todo' then msg := 'not yet implemented'
    else msg := 'not implemented';
    if Length(args) = 0 then
      text := '{ ::std::rt::begin_panic_str("' + msg + '", ' + loc + ') }'
    else
    begin
      body := BuildFormatBody(n, 0, False, argNodes, ok);
      if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
      text := '{ ' + body + ' __f.push_front("' + msg + ': "); ::std::rt::begin_panic(__f.into_string(), ' + loc + ') }';
    end;
    Result := ExpandAndCheck(n, text, argNodes, expected);
    Exit;
  end;
  if (name = 'assert') or (name = 'debug_assert') then
  begin
    if (name = 'debug_assert') and (not CfgDebug) then
    begin
      Result := HUnitOf(n);
      Exit;
    end;
    if Length(args) = 0 then
    begin
      ErrAt(n, '', 'macro requires a boolean expression as an argument', '');
      Result := HirAt(hUnit, TyErrT, n);
      Exit;
    end;
    one := nil;
    IAdd(one, args[0]);
    if Length(args) = 1 then
      text := '{ if !(__arg0) { ::std::rt::begin_panic_str("assertion failed: ' + RustEscape(SourceText(args[0])) +
              '", ' + loc + ') } }'
    else
    begin
      body := BuildFormatBody(n, 1, False, argNodes, ok);
      if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
      body := ReplaceAll(body, '__arg', '__argX');
      for i := Length(argNodes) - 1 downto 0 do
        body := ReplaceAll(body, '__argX' + IntToStr(i) + ')', '__arg' + IntToStr(i + 1) + ')');
      body := ReplaceAll(body, '__argX', '__arg');
      for i := 0 to Length(argNodes) - 1 do IAdd(one, argNodes[i]);
      text := '{ if !(__arg0) { ' + body + ' ::std::rt::begin_panic(__f.into_string(), ' + loc + ') } }';
    end;
    Result := ExpandAndCheck(n, text, one, expected);
    Exit;
  end;
  if (name = 'assert_eq') or (name = 'assert_ne') or (name = 'debug_assert_eq') or (name = 'debug_assert_ne') then
  begin
    if StartsWith(name, 'debug_') and (not CfgDebug) then
    begin
      Result := HUnitOf(n);
      Exit;
    end;
    if Length(args) < 2 then
    begin
      ErrAt(n, '', 'macro requires two arguments', '');
      Result := HirAt(hUnit, TyErrT, n);
      Exit;
    end;
    one := nil;
    IAdd(one, args[0]);
    IAdd(one, args[1]);
    isDebug := (name = 'assert_ne') or (name = 'debug_assert_ne');
    if isDebug then cond := '!=' else cond := '==';
    if Length(args) = 2 then
      msg := '::std::option::Option::None'
    else
    begin
      body := BuildFormatBody(n, 2, False, argNodes, ok);
      if not ok then begin Result := HirAt(hUnit, TyErrT, n); Exit; end;
      body := ReplaceAll(body, '__arg', '__argX');
      for i := Length(argNodes) - 1 downto 0 do
        body := ReplaceAll(body, '__argX' + IntToStr(i) + ')', '__arg' + IntToStr(i + 2) + ')');
      body := ReplaceAll(body, '__argX', '__arg');
      for i := 0 to Length(argNodes) - 1 do IAdd(one, argNodes[i]);
      msg := '::std::option::Option::Some({ ' + body + ' __f.into_string() })';
    end;
    if isDebug then s := '1' else s := '0';
    text := '{ match (&(__arg0), &(__arg1)) { (__l, __r) => { if !(*__l ' + cond + ' *__r) { ' +
            '::std::rt::assert_failed(' + s + ', &*__l, &*__r, ' + msg + ', ' + loc + ') } } } }';
    Result := ExpandAndCheck(n, text, one, expected);
    Exit;
  end;
  ErrAt(n, '', 'cannot find macro `' + name + '` in this scope', '');
  Result := HirAt(hUnit, TyErrT, n);
end;

