{ PROGRAMME PRINCIPAL : options, pipeline, chaine d'outils      }
{ ============================================================ }

Type
  TOptions = record
    input: string;
    output: string;
    outDir: string;
    crateName: string;
    crateType: string;
    emit: TStrArr;
    optLevel: Integer;
    debug: Boolean;
    overflow: Integer;       { -1 defaut, 0 non, 1 oui }
    linker: string;
    linkArgs: TStrArr;
    libs: TStrArr;
    libDirs: TStrArr;
    target: string;
    unpretty: string;
    printWhat: string;
    keepTemps: Boolean;
    edition: string;
    cfgs: TStrArr;
    panicAbort: Boolean;
    verbose: Boolean;
    llc: string;
  end;

Var
  Opt: TOptions;
  MainDef: Integer;
  MainInst: Integer;
  LangStartInst: Integer;
  PreludeStartLine: Integer;

procedure Usage;
begin
  WriteLn('Usage: rustc [OPTIONS] INPUT');
  WriteLn;
  WriteLn('Options:');
  WriteLn('    -h, --help              Display this message');
  WriteLn('        --crate-name NAME   Specify the name of the crate being built');
  WriteLn('        --crate-type [bin|lib|staticlib|cdylib]');
  WriteLn('                            Comma separated list of types of crates for the compiler to emit');
  WriteLn('        --emit [asm|llvm-ir|obj|link|mir|hir|ast|tokens]');
  WriteLn('                            Comma separated list of types of output for the compiler to emit');
  WriteLn('        --edition 2015|2018|2021|2024');
  WriteLn('                            Specify which edition of the compiler to use when compiling code');
  WriteLn('        --out-dir DIR       Write output to compiler-chosen filename in <dir>');
  WriteLn('        --target TRIPLE     Target triple for which the code is compiled');
  WriteLn('        --cfg SPEC          Configure the compilation environment');
  WriteLn('    -L PATH                 Add a directory to the library search path');
  WriteLn('    -l NAME                 Link the generated crate(s) to the specified native library NAME');
  WriteLn('    -g                      Equivalent to -C debuginfo=2');
  WriteLn('    -O                      Equivalent to -C opt-level=2');
  WriteLn('    -o FILENAME             Write output to <filename>');
  WriteLn('    -C opt-level=0..3|s|z   Optimization level');
  WriteLn('    -C overflow-checks=on|off');
  WriteLn('    -C panic=abort|unwind');
  WriteLn('    -C linker=PATH          Linker to use');
  WriteLn('    -C link-arg=ARG         Extra argument passed to the linker');
  WriteLn('    -Z unpretty=ast-tree|hir|mir');
  WriteLn('                            Print the compiler''s representation of the input');
  WriteLn('        --print [sysroot|cfg|target-triple|crate-name|file-names]');
  WriteLn('    -V, --version           Print version info and exit');
  WriteLn('    -v, --verbose           Use verbose output');
  WriteLn;
  WriteLn('The compilation pipeline: lexing, parsing, name resolution, type checking, HIR, MIR, LLVM IR,');
  WriteLn('then llc (code generation) and the system linker (cc) produce the executable.');
end;

function HasEmit(const k: string): Boolean;
begin
  Result := SIndexOf(Opt.emit, k) >= 0;
end;

function ArgAfter(var i: Integer; const a: string): string;
begin
  Result := '';
  if Length(a) > 0 then Exit;
end;

procedure ParseOptions;
var
  i, n, p: Integer;
  a, v, k: string;
  procedure AddEmit(const s: string);
  var
    j, st: Integer;
    cur: string;
  begin
    cur := '';
    for j := 1 to Length(s) do
      if s[j] = ',' then begin if cur <> '' then SAdd(Opt.emit, cur); cur := ''; end
      else cur := cur + s[j];
    if cur <> '' then SAdd(Opt.emit, cur);
  end;
  function NextArg: string;
  begin
    Inc(i);
    if i > n then FatalMsg('missing argument for option `' + a + '`');
    Result := ParamStr(i);
  end;
  procedure CodegenOpt(const s: string);
  var
    q: Integer;
    key, val: string;
  begin
    q := Pos('=', s);
    if q > 0 then begin key := Copy(s, 1, q - 1); val := Copy(s, q + 1, Length(s)); end
    else begin key := s; val := ''; end;
    if key = 'opt-level' then
    begin
      if val = 's' then Opt.optLevel := 2
      else if val = 'z' then Opt.optLevel := 2
      else Opt.optLevel := StrToIntDef(val, 0);
    end
    else if key = 'debuginfo' then Opt.debug := val <> '0'
    else if key = 'overflow-checks' then
    begin
      if (val = 'on') or (val = 'yes') or (val = 'y') or (val = '') then Opt.overflow := 1 else Opt.overflow := 0;
    end
    else if key = 'panic' then Opt.panicAbort := val = 'abort'
    else if key = 'linker' then Opt.linker := val
    else if key = 'link-arg' then SAdd(Opt.linkArgs, val)
    else if key = 'link-args' then SAdd(Opt.linkArgs, val)
    else if key = 'save-temps' then Opt.keepTemps := True;
  end;
begin
  n := ParamCount;
  Opt.optLevel := 0;
  Opt.overflow := -1;
  Opt.crateType := 'bin';
  Opt.edition := '2021';
  i := 1;
  while i <= n do
  begin
    a := ParamStr(i);
    if (a = '-h') or (a = '--help') then begin Usage; Halt(0); end
    else if (a = '-V') or (a = '--version') then begin WriteLn(VERSION_TEXT); Halt(0); end
    else if (a = '-v') or (a = '--verbose') then Opt.verbose := True
    else if a = '-o' then Opt.output := NextArg
    else if a = '--out-dir' then Opt.outDir := NextArg
    else if StartsWith(a, '--out-dir=') then Opt.outDir := Copy(a, 11, Length(a))
    else if a = '--crate-name' then Opt.crateName := NextArg
    else if StartsWith(a, '--crate-name=') then Opt.crateName := Copy(a, 14, Length(a))
    else if a = '--crate-type' then Opt.crateType := NextArg
    else if StartsWith(a, '--crate-type=') then Opt.crateType := Copy(a, 14, Length(a))
    else if a = '--emit' then AddEmit(NextArg)
    else if StartsWith(a, '--emit=') then AddEmit(Copy(a, 8, Length(a)))
    else if a = '--edition' then Opt.edition := NextArg
    else if StartsWith(a, '--edition=') then Opt.edition := Copy(a, 11, Length(a))
    else if a = '--target' then Opt.target := NextArg
    else if StartsWith(a, '--target=') then Opt.target := Copy(a, 10, Length(a))
    else if a = '--cfg' then SAdd(Opt.cfgs, NextArg)
    else if a = '--print' then Opt.printWhat := NextArg
    else if StartsWith(a, '--print=') then Opt.printWhat := Copy(a, 9, Length(a))
    else if a = '-g' then Opt.debug := True
    else if a = '-O' then Opt.optLevel := 2
    else if a = '-C' then CodegenOpt(NextArg)
    else if StartsWith(a, '-C') and (Length(a) > 2) then CodegenOpt(Copy(a, 3, Length(a)))
    else if a = '-Z' then
    begin
      v := NextArg;
      if StartsWith(v, 'unpretty=') then Opt.unpretty := Copy(v, 10, Length(v));
    end
    else if StartsWith(a, '-Zunpretty=') then Opt.unpretty := Copy(a, 12, Length(a))
    else if StartsWith(a, '-Z') then
    begin
      v := Copy(a, 3, Length(a));
      if StartsWith(v, 'unpretty=') then Opt.unpretty := Copy(v, 10, Length(v));
    end
    else if a = '-L' then SAdd(Opt.libDirs, NextArg)
    else if StartsWith(a, '-L') then SAdd(Opt.libDirs, Copy(a, 3, Length(a)))
    else if a = '-l' then SAdd(Opt.libs, NextArg)
    else if StartsWith(a, '-l') then SAdd(Opt.libs, Copy(a, 3, Length(a)))
    else if (a = '-A') or (a = '-W') or (a = '-D') or (a = '-F') then NextArg
    else if StartsWith(a, '-A') or StartsWith(a, '-W') or StartsWith(a, '-D') or StartsWith(a, '-F') then
    else if StartsWith(a, '--color') or StartsWith(a, '--error-format') or StartsWith(a, '--cap-lints') or
            StartsWith(a, '--diagnostic-width') then
    begin
      if (a = '--color') or (a = '--error-format') or (a = '--cap-lints') then NextArg;
    end
    else if StartsWith(a, '-') and (a <> '-') then
      FatalMsg('Unrecognized option: ''' + Copy(a, 2, Length(a)) + '''')
    else
    begin
      if Opt.input <> '' then FatalMsg('multiple input filenames provided (first two filenames are `' + Opt.input +
                                        '` and `' + a + '`)');
      Opt.input := a;
    end;
    Inc(i);
  end;
end;

function FindInPath(const name: string): string;
var
  path, dir: string;
  i, st: Integer;
begin
  Result := '';
  if Pos('/', name) > 0 then
  begin
    if FileExists(name) then Result := name;
    Exit;
  end;
  path := GetEnv('PATH');
  st := 1;
  for i := 1 to Length(path) + 1 do
    if (i > Length(path)) or (path[i] = ':') or (path[i] = ';') then
    begin
      dir := Copy(path, st, i - st);
      if dir <> '' then
        if FileExists(dir + '/' + name) then begin Result := dir + '/' + name; Exit; end;
      st := i + 1;
    end;
end;

function RunTool(const path: string; const args: string): Integer;
begin
  if Opt.verbose then WriteErrLn('+ ' + path + ' ' + args);
  SwapVectors;
  Exec(path, args);
  SwapVectors;
  if DosError <> 0 then Result := 127 else Result := DosExitCode;
end;

function QuoteArg(const s: string): string;
begin
  if (Pos(' ', s) > 0) then Result := '"' + s + '"' else Result := s;
end;

function SanitizeName(const s: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(s) do
    if IsIdChar(s[i]) then Result := Result + s[i] else Result := Result + '_';
  if Result = '' then Result := 'main';
end;

{ ---- assemblage du module LLVM ---- }

function BuildModule(var errs: Integer): string;
var
  b: TBuf;
  i, d: Integer;
  sz: Int64;
  ty: Integer;
  mainSym, ls: string;
  initSyms: string;
  si: Integer;
begin
  BufInit(b);
  BufInit(ModBuf);
  BufInit(LLStrs);
  BufInit(LLGlobals);
  BufInit(LLDecls);
  BufInit(AllocaBuf);
  BufInit(LL);
  HInit(StrMap);
  HInit(IntrinsicNeeded);
  NStrs := 0;
  for i := 0 to NInsts - 1 do
  begin
    if Insts[i].mir >= 0 then EmitMirFn(Insts[i].mir);
  end;
  for i := 0 to NInsts - 1 do
    if Insts[i].external and not Insts[i].intrinsic then EmitExternDecl(i);
  { statiques }
  initSyms := '';
  for i := 0 to Length(StaticDefs) - 1 do
  begin
    d := StaticDefs[i];
    ty := StaticTy(d);
    sz := TySize(ty);
    if sz < 1 then sz := 1;
    if Defs[d].isExtern then
      BufAdd(LLGlobals, '@' + Defs[d].name + ' = external global [' + IntToStr(sz) + ' x i8]'#10)
    else
    begin
      BufAdd(LLGlobals, GlobName(d) + ' = internal global [' + IntToStr(sz) + ' x i8] zeroinitializer, align ' +
             IntToStr(AlignOfTy(ty)) + #10);
      si := HFind(InstMap, 's' + IntToStr(d));
      if si >= 0 then initSyms := initSyms + '  call void @"' + Insts[si].sym + '"()'#10;
    end;
  end;
  BufAdd(LLGlobals, '@rs_argc = global i32 0, align 4'#10'@rs_argv = global ptr null, align 8'#10);
  { en-tete }
  BufLn(b, '; ModuleID = ''' + Opt.crateName + '''');
  BufLn(b, 'source_filename = "' + Opt.input + '"');
  if Opt.target <> '' then BufLn(b, 'target triple = "' + Opt.target + '"');
  BufLn(b, '');
  BufAdd(b, BufStr(LLStrs));
  BufLn(b, '');
  BufAdd(b, BufStr(LLGlobals));
  BufLn(b, '');
  BufAdd(b, BufStr(LLDecls));
  BufLn(b, '');
  BufAdd(b, BufStr(ModBuf));
  { point d'entree C }
  BufLn(b, 'define i32 @main(i32 %argc, ptr %argv) #0 {');
  BufLn(b, 'entry:');
  BufLn(b, '  store i32 %argc, ptr @rs_argc, align 4');
  BufLn(b, '  store ptr %argv, ptr @rs_argv, align 8');
  BufAdd(b, initSyms);
  BufLn(b, '  %r = call i32 @"' + Insts[LangStartInst].sym + '"(ptr @"' + Insts[MainInst].sym + '")');
  BufLn(b, '  ret i32 %r');
  BufLn(b, '}');
  BufLn(b, '');
  BufLn(b, 'attributes #0 = { nounwind }');
  Result := BufStr(b);
end;

function ChangeExt(const fn, ext: string): string;
var
  i: Integer;
begin
  i := Length(fn);
  while (i > 0) and (fn[i] <> '.') and (fn[i] <> '/') do Dec(i);
  if (i > 0) and (fn[i] = '.') then Result := Copy(fn, 1, i - 1) + ext else Result := fn + ext;
end;

function OutPath(const ext: string; primary: Boolean): string;
begin
  if primary and (Opt.output <> '') then
  begin
    Result := Opt.output;
    Exit;
  end;
  if Opt.outDir <> '' then Result := Opt.outDir + '/' + Opt.crateName + ext
  else Result := Opt.crateName + ext;
end;

{ ---- chargement de la bibliotheque standard integree ---- }
function LoadStd: Integer;
var
  txt: string;
  fi, d, used: Integer;
  items: TIntArr;
begin
  PreludeText(txt);
  fi := AddSourceFile('<std>', txt);
  CurCrate := 1;
  StdRoot := NewDef(dkMod, 'std', 0, -1);
  Defs[StdRoot].scopeMod := StdRoot;
  items := nil;
  ParseFileItems(fi, '', items);
  CollectItems(StdRoot, items);
  ResolveImports;
  d := ResolveSegs(StdRoot, SplitPath('prelude::v1'), 'T', used);
  if d > 0 then PreludeMod := d;
  Result := fi;
end;

function CompileMain: Integer;
var
  txt, mod_, ll, llPath, objPath, outExe, tool, args, asmPath, mirPath, userStem: string;
  fi, i, d, used, rc: Integer;
  items: TIntArr;
  b: TBuf;
  mirOut: TBuf;
  errs: Integer;
  mainRet: TIntArr;
  params: TIntArr;
  ret: Integer;
  ta: TIntArr;
  langStart: Integer;
  kinds: string;
  doLink, doObj, doAsm, doLL, doMir: Boolean;
  llcPath, ccPath, clangPath: string;
  tmpLL: string;
  first: Boolean;
begin
  Result := 0;
  { initialisations }
  NNodes := 1;
  NHirs := 1;
  CfgDebug := Opt.optLevel = 0;
  OvfChecks := (Opt.overflow = 1) or ((Opt.overflow = -1) and (Opt.optLevel = 0));
  InitTypes;
  HInit(ScopeMap); HInit(MethodTraits); HInit(HeadMap); HInit(BodyMap); HInit(CopyCache); HInit(LayMap);
  HInit(InstMap); HInit(SymNames);
  NDefs := 0;
  NewDef(0, '<none>', 0, -1);
  LoadStd;
  FinishDiag;
  { crate utilisateur }
  if not ReadFileToString(Opt.input, txt) then
    FatalMsg('couldn''t read ' + Opt.input + ': No such file or directory (os error 2)');
  fi := AddSourceFile(Opt.input, txt);
  SrcPathForLoc := Opt.input;
  CurCrate := 0;
  CrateNameStr := Opt.crateName;
  UserRoot := NewDef(dkMod, 'crate', 0, -1);
  Defs[UserRoot].scopeMod := UserRoot;
  items := nil;
  ParseFileItems(fi, FileDir(Opt.input), items);
  FinishDiag;
  if Opt.unpretty = 'ast-tree' then
  begin
    BufInit(b);
    d := NewNode(nMod);
    Nodes[d].l2 := items;
    Nodes[d].s := 'crate';
    DumpNode(b, d, 0, '');
    Write(BufStr(b));
    Exit;
  end;
  CollectItems(UserRoot, items);
  ResolveImports;
  FinishDiag;
  IndexImpls;
  InitLang;
  FinishDiag;
  MainDef := ScopeLookup(UserRoot, 'V', 'main', 0);
  if (MainDef < 0) and (Opt.crateType = 'bin') then
  begin
    Report(True, 'E0601', '`main` function not found in crate `' + Opt.crateName + '`', -1, 0, 0, 0, '');
    WriteErrLn(' = note: consider adding a `main` function to `' + Opt.input + '`');
    FinishDiag;
  end;
  CxTop := -1;
  CxBase := -1;
  { verification eager des fonctions non generiques du crate utilisateur }
  for i := 1 to NDefs - 1 do
  begin
    if (Defs[i].crate = 0) and (Defs[i].kind = dkFn) and (Length(Defs[i].gnames) = 0) and Defs[i].hasBody then
      CheckInstance(i, nil);
  end;
  FinishDiag;
  if (Opt.crateType <> 'bin') then
  begin
    if ErrCount = 0 then Exit;
  end;
  { fonctions requises par le generateur }
  PanicConstInst := RequestInst(FindStd('rt::panic_const', 'V'), nil);
  PanicBoundsInst := RequestInst(FindStd('rt::panic_bounds', 'V'), nil);
  StrEqFn := FindStd('str::__str_eq', 'V');
  langStart := FindStd('rt::lang_start', 'V');
  MainInst := RequestInst(MainDef, nil);
  FnDefSig(MainDef, nil, params, ret);
  SetLength(ta, 1);
  ta[0] := Zonk(ret);
  LangStartInst := RequestInst(langStart, ta);
  { file de travail }
  i := 0;
  while i < NInsts do
  begin
    BuildInst(i);
    Inc(i);
  end;
  FinishDiag;
  if Opt.unpretty = 'mir' then
  begin
    BufInit(b);
    for i := 0 to NMirFns - 1 do
      if (Defs[MirFns[i].def].crate = 0) or Opt.verbose then DumpMirFn(b, MirFns[i]);
    Write(BufStr(b));
    Exit;
  end;
  if HasEmit('mir') then
  begin
    BufInit(b);
    for i := 0 to NMirFns - 1 do
      if Defs[MirFns[i].def].crate = 0 then DumpMirFn(b, MirFns[i]);
    WriteStringToFile(OutPath('.mir', True), BufStr(b));
  end;
  ll := BuildModule(errs);
  FinishDiag;
  doLL := HasEmit('llvm-ir');
  doObj := HasEmit('obj');
  doAsm := HasEmit('asm');
  doLink := HasEmit('link') or (Length(Opt.emit) = 0);
  tmpLL := '';
  if doLL then
  begin
    llPath := OutPath('.ll', Length(Opt.emit) = 1);
    WriteStringToFile(llPath, ll);
  end
  else
  begin
    llPath := OutPath('.rustc.tmp.ll', False);
    WriteStringToFile(llPath, ll);
    tmpLL := llPath;
  end;
  if not (doObj or doAsm or doLink) then
  begin
    if tmpLL <> '' then DeleteFile(tmpLL);
    Exit;
  end;
  { compilation LLVM -> objet / assembleur }
  llcPath := GetEnv('RUSTC_LLC');
  if llcPath = '' then llcPath := FindInPath('llc');
  if llcPath = '' then
  begin
    for i := 30 downto 14 do
    begin
      llcPath := FindInPath('llc-' + IntToStr(i));
      if llcPath <> '' then Break;
    end;
  end;
  clangPath := FindInPath('clang');
  ccPath := Opt.linker;
  if ccPath = '' then ccPath := GetEnv('RUSTC_LINKER');
  if ccPath = '' then ccPath := FindInPath('cc');
  if ccPath = '' then ccPath := FindInPath('gcc');
  if ccPath = '' then ccPath := clangPath;
  if doAsm then
  begin
    asmPath := OutPath('.s', Length(Opt.emit) = 1);
    if llcPath <> '' then
      args := '-O' + IntToStr(Opt.optLevel) + ' -filetype=asm ' + QuoteArg(llPath) + ' -o ' + QuoteArg(asmPath)
    else if clangPath <> '' then
      args := '-S -x ir -O' + IntToStr(Opt.optLevel) + ' ' + QuoteArg(llPath) + ' -o ' + QuoteArg(asmPath)
    else FatalMsg('could not find LLVM `llc` (or clang) in PATH');
    if llcPath <> '' then rc := RunTool(llcPath, args) else rc := RunTool(clangPath, args);
    if rc <> 0 then FatalMsg('LLVM code generation failed (exit code ' + IntToStr(rc) + ')');
  end;
  if doObj or doLink then
  begin
    if doObj then objPath := OutPath('.o', Length(Opt.emit) = 1)
    else objPath := OutPath('.rustc.tmp.o', False);
    if llcPath <> '' then
    begin
      args := '-O' + IntToStr(Opt.optLevel) + ' -filetype=obj -relocation-model=pic ' + QuoteArg(llPath) + ' -o ' +
              QuoteArg(objPath);
      rc := RunTool(llcPath, args);
    end
    else if clangPath <> '' then
    begin
      args := '-c -x ir -O' + IntToStr(Opt.optLevel) + ' -fPIC ' + QuoteArg(llPath) + ' -o ' + QuoteArg(objPath);
      rc := RunTool(clangPath, args);
    end
    else
    begin
      FatalMsg('could not find the LLVM code generator (`llc` or `clang`) in PATH');
      rc := 1;
    end;
    if rc <> 0 then FatalMsg('LLVM code generation failed (exit code ' + IntToStr(rc) + ')');
    if doLink then
    begin
      if ccPath = '' then FatalMsg('linker `cc` not found in PATH');
      if Opt.output <> '' then outExe := Opt.output
      else if Opt.outDir <> '' then outExe := Opt.outDir + '/' + Opt.crateName
      else outExe := Opt.crateName;
      args := QuoteArg(objPath) + ' -o ' + QuoteArg(outExe);
      for i := 0 to Length(Opt.libDirs) - 1 do args := args + ' -L' + QuoteArg(Opt.libDirs[i]);
      for i := 0 to Length(Opt.libs) - 1 do args := args + ' -l' + Opt.libs[i];
      for i := 0 to Length(Opt.linkArgs) - 1 do args := args + ' ' + Opt.linkArgs[i];
      args := args + ' -lm';
      rc := RunTool(ccPath, args);
      if rc <> 0 then FatalMsg('linking with `' + ccPath + '` failed: exit status: ' + IntToStr(rc));
      if not doObj then DeleteFile(objPath);
    end;
  end;
  if tmpLL <> '' then DeleteFile(tmpLL);
end;

begin
  ErrCount := 0;
  ParseOptions;
  if Opt.printWhat <> '' then
  begin
    if Opt.printWhat = 'sysroot' then WriteLn('/usr')
    else if Opt.printWhat = 'target-triple' then WriteLn('x86_64-unknown-linux-gnu')
    else if Opt.printWhat = 'crate-name' then WriteLn(SanitizeName(FileStem(Opt.input)))
    else if Opt.printWhat = 'cfg' then
    begin
      WriteLn('debug_assertions');
      WriteLn('panic="unwind"');
      WriteLn('target_arch="x86_64"');
      WriteLn('target_endian="little"');
      WriteLn('target_os="linux"');
      WriteLn('target_pointer_width="64"');
      WriteLn('unix');
    end;
    Halt(0);
  end;
  if Opt.input = '' then
  begin
    WriteErrLn('error: no input filename given');
    WriteErrLn('');
    Halt(1);
  end;
  if Opt.crateName = '' then Opt.crateName := SanitizeName(FileStem(Opt.input));
  CompileMain;
  FinishDiag;
  Halt(0);
end.
