{ @author: Sylvain Maltais (support@gladir.com)
  @created: 2026
  @website(https://www.gladir.com/dev-cools)
  @abstract(Target: Free Pascal 3.2)
  @description: Clone du compilateur Rust (rustc) : Rust -> LLVM IR -> executable
}

{ ============================================================================
  DESCRIPTION
  ============================================================================
  RUSTC est un clone du compilateur Rust ecrit en Pascal. A partir d'un
  fichier source Rust (.rs) il execute les memes phases que le vrai rustc :

    1. Analyse lexicale    : source -> jetons (tokens)
    2. Analyse syntaxique  : jetons -> arbre syntaxique abstrait (AST)
    3. Resolution de noms  : modules, "use", chemins, prelude
    4. Analyse semantique  : types, inference, traits, generiques,
                             fermetures, motifs, verification de mutabilite
    5. HIR                 : representation de haut niveau typee et desucree
                             (for, while let, ?, macros println!, ...)
    6. MIR                 : graphe de blocs de base (controle de flux,
                             controles de debordement et d'indices)
    7. LLVM IR             : generation du code intermediaire LLVM (.ll)
    8. Compilation LLVM    : "llc" produit le fichier objet / l'assembleur
    9. Edition de liens    : "cc" produit l'executable final

  Le programme n'utilise que l'unite DOS : la bibliotheque standard de Rust
  (core / alloc / std : Option, Result, Vec, String, Box, iterateurs,
  formatage, nombres, ...) est ecrite en Rust et integree dans le programme ;
  elle est compilee avec le programme utilisateur par le meme compilateur.

  Usage :  RUSTC [options] fichier.rs
  Options principales :
    -o fichier              fichier de sortie
    --out-dir repertoire    repertoire de sortie
    --emit=link,obj,asm,llvm-ir,mir     types de sortie
    --crate-name nom        nom du crate
    -O, -C opt-level=N      niveau d'optimisation (0..3)
    -C overflow-checks=on|off, -C panic=abort, -C linker=chemin
    -g                      informations de debogage
    -l lib, -L repertoire   bibliotheques natives
    -Z unpretty=ast-tree|mir   affiche l'AST ou le MIR
    --print sysroot|cfg|target-triple|crate-name
    -V, --version, -h, --help

  Exemple :
      RUSTC hello.rs            (produit l executable hello)
      RUSTC --emit=llvm-ir hello.rs
  ============================================================================ }

Program RUSTC;

{$A-}
{$I-}
{$B-}
{$Q-}
{$R-}

{$IFDEF FPC}
 {$MODE DELPHI}
 {$H+}
 {$INLINE ON}
{$ENDIF}

Uses Dos;

Const
  VERSION_TEXT = 'rustc 1.0.0 (RUSTC.PAS DEV-COOLS clone)';
  VERSION = 'RUSTC V1.0 - Cette commande permet de lancer le compilateur Rust (rustc) vers LLVM IR.';
  MAX_ERRORS = 100;

Type
  TIntArr = array of Integer;
  TStrArr = array of string;

  { Tampon de sortie a croissance geometrique }
  TBuf = record
    d: string;
    n: Integer;
  end;

  TSrcFile = record
    name: string;
    text: string;
    lines: TIntArr;     { offset du debut de chaque ligne (1-base dans text) }
    nlines: Integer;
  end;

Var
  ErrCount, WarnCount: Integer;
  Files: array of TSrcFile;
  NFiles: Integer;
  OptVerbose: Boolean;
  DiagFatal: Boolean;
  SuppressDiag: Integer;

{ ============================================================ }
{ Utilitaires generaux                                         }
{ ============================================================ }

function IntToStr(v: Int64): string;
begin
  Str(v, Result);
end;

function UIntToStr(v: QWord): string;
begin
  Str(v, Result);
end;

function StrToIntDef(const s: string; def: Int64): Int64;
var
  c: Integer;
  r: Int64;
begin
  Val(s, r, c);
  if c <> 0 then Result := def else Result := r;
end;

function UpperStr(const s: string): string;
var
  i: Integer;
begin
  Result := s;
  for i := 1 to Length(Result) do
    if (Result[i] >= 'a') and (Result[i] <= 'z') then Dec(Result[i], 32);
end;

function LowerStr(const s: string): string;
var
  i: Integer;
begin
  Result := s;
  for i := 1 to Length(Result) do
    if (Result[i] >= 'A') and (Result[i] <= 'Z') then Inc(Result[i], 32);
end;

function StartsWith(const s, p: string): Boolean;
begin
  Result := (Length(s) >= Length(p)) and (Copy(s, 1, Length(p)) = p);
end;

function EndsWith(const s, p: string): Boolean;
begin
  Result := (Length(s) >= Length(p)) and (Copy(s, Length(s) - Length(p) + 1, Length(p)) = p);
end;

function ReplaceAll(const s, a, b: string): string;
var
  i: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(s) do
  begin
    if (a <> '') and (Copy(s, i, Length(a)) = a) then
    begin
      Result := Result + b;
      Inc(i, Length(a));
    end
    else
    begin
      Result := Result + s[i];
      Inc(i);
    end;
  end;
end;

function PadLeft(const s: string; n: Integer): string;
begin
  Result := s;
  while Length(Result) < n do Result := ' ' + Result;
end;

function Spaces(n: Integer): string;
begin
  Result := '';
  while n > 0 do begin Result := Result + ' '; Dec(n); end;
end;

function HexByte(v: Integer): string;
const H: string = '0123456789ABCDEF';
begin
  Result := H[((v shr 4) and 15) + 1] + H[(v and 15) + 1];
end;

function HexStr(v: QWord; digits: Integer): string;
const H: string = '0123456789ABCDEF';
var
  i: Integer;
begin
  Result := '';
  for i := 1 to digits do
  begin
    Result := H[(v and 15) + 1] + Result;
    v := v shr 4;
  end;
end;

procedure IAdd(var a: TIntArr; v: Integer);
var
  n: Integer;
begin
  n := Length(a);
  SetLength(a, n + 1);
  a[n] := v;
end;

procedure SAdd(var a: TStrArr; const v: string);
var
  n: Integer;
begin
  n := Length(a);
  SetLength(a, n + 1);
  a[n] := v;
end;

function IIndexOf(const a: TIntArr; v: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to Length(a) - 1 do
    if a[i] = v then begin Result := i; Exit; end;
end;

function SIndexOf(const a: TStrArr; const v: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to Length(a) - 1 do
    if a[i] = v then begin Result := i; Exit; end;
end;

function ICopy(const a: TIntArr): TIntArr;
var
  i: Integer;
begin
  SetLength(Result, Length(a));
  for i := 0 to Length(a) - 1 do Result[i] := a[i];
end;

{ Remplace les separateurs de chemin par '/' pour les comparaisons }
function NormPath(const s: string): string;
begin
  Result := ReplaceAll(s, '\', '/');
end;

function FileDir(const s: string): string;
var
  i: Integer;
  t: string;
begin
  t := NormPath(s);
  i := Length(t);
  while (i > 0) and (t[i] <> '/') do Dec(i);
  if i = 0 then Result := '' else Result := Copy(t, 1, i);
end;

function FileBase(const s: string): string;
var
  i: Integer;
  t: string;
begin
  t := NormPath(s);
  i := Length(t);
  while (i > 0) and (t[i] <> '/') do Dec(i);
  Result := Copy(t, i + 1, Length(t));
end;

function FileStem(const s: string): string;
var
  i: Integer;
begin
  Result := FileBase(s);
  i := Length(Result);
  while (i > 0) and (Result[i] <> '.') do Dec(i);
  if i > 1 then Result := Copy(Result, 1, i - 1);
end;

function FileExists(const fn: string): Boolean;
var
  f: file;
  m: Integer;
begin
  m := FileMode;
  FileMode := 0;
  Assign(f, fn);
  Reset(f, 1);
  Result := IOResult = 0;
  if Result then Close(f);
  FileMode := m;
end;

function ReadFileToString(const fn: string; var s: string): Boolean;
var
  f: file;
  sz: Int64;
  got: LongInt;
  m: Integer;
begin
  Result := False;
  s := '';
  m := FileMode;
  FileMode := 0;
  Assign(f, fn);
  Reset(f, 1);
  if IOResult <> 0 then begin FileMode := m; Exit; end;
  sz := FileSize(f);
  SetLength(s, sz);
  if sz > 0 then BlockRead(f, s[1], sz, got);
  Close(f);
  FileMode := m;
  Result := True;
end;

function WriteStringToFile(const fn, s: string): Boolean;
var
  f: file;
  put: LongInt;
begin
  Assign(f, fn);
  Rewrite(f, 1);
  if IOResult <> 0 then begin Result := False; Exit; end;
  if Length(s) > 0 then BlockWrite(f, s[1], Length(s), put);
  Close(f);
  Result := IOResult = 0;
end;

procedure DeleteFile(const fn: string);
var
  f: file;
begin
  Assign(f, fn);
  Erase(f);
  if IOResult <> 0 then ;
end;

{ ---- Tampon de chaine ---- }
procedure BufInit(var b: TBuf);
begin
  b.n := 0;
  SetLength(b.d, 4096);
end;

procedure BufAdd(var b: TBuf; const s: string);
var
  l: Integer;
begin
  l := Length(s);
  if l = 0 then Exit;
  if b.n + l > Length(b.d) then
  begin
    if Length(b.d) * 2 < b.n + l then SetLength(b.d, b.n + l + 4096)
    else SetLength(b.d, Length(b.d) * 2);
  end;
  Move(s[1], b.d[b.n + 1], l);
  Inc(b.n, l);
end;

procedure BufLn(var b: TBuf; const s: string);
begin
  BufAdd(b, s);
  BufAdd(b, #10);
end;

function BufStr(var b: TBuf): string;
begin
  Result := Copy(b.d, 1, b.n);
end;

{ ============================================================ }
{ Gestion des fichiers sources et des diagnostics              }
{ ============================================================ }

function AddSourceFile(const name, text: string): Integer;
var
  i, n: Integer;
begin
  if NFiles >= Length(Files) then SetLength(Files, NFiles * 2 + 8);
  Result := NFiles;
  Inc(NFiles);
  Files[Result].name := name;
  Files[Result].text := text;
  n := 1;
  SetLength(Files[Result].lines, 64);
  Files[Result].lines[0] := 1;
  for i := 1 to Length(text) do
    if text[i] = #10 then
    begin
      if n >= Length(Files[Result].lines) then SetLength(Files[Result].lines, n * 2);
      Files[Result].lines[n] := i + 1;
      Inc(n);
    end;
  Files[Result].nlines := n;
end;

function SourceLine(fi, line: Integer): string;
var
  a, b: Integer;
begin
  Result := '';
  if (fi < 0) or (fi >= NFiles) then Exit;
  if (line < 1) or (line > Files[fi].nlines) then Exit;
  a := Files[fi].lines[line - 1];
  b := a;
  while (b <= Length(Files[fi].text)) and (Files[fi].text[b] <> #10) and (Files[fi].text[b] <> #13) do Inc(b);
  Result := Copy(Files[fi].text, a, b - a);
end;

function ExpandTabs(const s: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(s) do
    if s[i] = #9 then Result := Result + '    ' else Result := Result + s[i];
end;

{ Colonne d'affichage (apres expansion des tabulations) }
function DisplayCol(const s: string; col: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to col - 1 do
    if (i <= Length(s)) and (s[i] = #9) then Inc(Result, 4) else Inc(Result);
end;

procedure WriteErrLn(const s: string);
begin
  WriteLn(StdErr, s);
end;

{ Emet un diagnostic au format rustc }
procedure Report(isErr: Boolean; const code, msg: string; fi, line, col, len: Integer; const lbl: string);
var
  head, ln, w, dc: string;
  k, n: Integer;
begin
  if SuppressDiag > 0 then Exit;
  if isErr then
  begin
    Inc(ErrCount);
    head := 'error';
  end
  else
  begin
    Inc(WarnCount);
    head := 'warning';
  end;
  if code <> '' then head := head + '[' + code + ']';
  WriteErrLn(head + ': ' + msg);
  if (fi >= 0) and (fi < NFiles) and (line > 0) then
  begin
    ln := SourceLine(fi, line);
    w := IntToStr(line);
    k := Length(w);
    WriteErrLn(Spaces(k) + '--> ' + Files[fi].name + ':' + IntToStr(line) + ':' + IntToStr(col));
    WriteErrLn(Spaces(k + 1) + '|');
    WriteErrLn(w + ' | ' + ExpandTabs(ln));
    if len < 1 then len := 1;
    n := DisplayCol(ln, col);
    dc := '';
    if (len > 1) then
    begin
      { largeur d'affichage de l'intervalle }
      k := DisplayCol(ln, col + len) - n;
      if k < 1 then k := 1;
      len := k;
    end;
    w := Spaces(Length(w));
    ln := w + ' | ' + Spaces(n);
    while len > 0 do begin ln := ln + '^'; Dec(len); end;
    if lbl <> '' then ln := ln + ' ' + lbl;
    WriteErrLn(ln);
  end;
  if ErrCount >= MAX_ERRORS then
  begin
    WriteErrLn('error: aborting due to too many errors');
    Halt(1);
  end;
end;

procedure Note(const s: string);
begin
  WriteErrLn('  = note: ' + s);
end;

procedure Help(const s: string);
begin
  WriteErrLn('  = help: ' + s);
end;

procedure FatalMsg(const s: string);
begin
  Inc(ErrCount);
  WriteErrLn('error: ' + s);
  WriteErrLn('');
  WriteErrLn('error: aborting due to ' + IntToStr(ErrCount) + ' previous error' + 's');
  Halt(1);
end;

procedure FinishDiag;
begin
  if ErrCount > 0 then
  begin
    if ErrCount = 1 then
      WriteErrLn('error: aborting due to 1 previous error')
    else
      WriteErrLn('error: aborting due to ' + IntToStr(ErrCount) + ' previous errors');
    WriteErrLn('');
    Halt(1);
  end;
end;

{ ============================================================ }
{ ANALYSE LEXICALE : source -> jetons (tokens)                 }
{ ============================================================ }

Const
  tkEOF = 0;
  tkIdent = 1;
  tkLifetime = 2;
  tkInt = 3;
  tkFloat = 4;
  tkStr = 5;
  tkChar = 6;
  tkByte = 7;
  tkByteStr = 8;
  tkPunct = 9;

Type
  TToken = record
    k: Integer;
    s: string;
    line, col, len, fi: Integer;
    iv: QWord;
    fv: Double;
    sfx: string;
    raw: Boolean;
  end;
  TTokArr = array of TToken;

Var
  Toks: TTokArr;
  NToks: Integer;
  TokPos: Integer;

function Utf8Encode(cp: Integer): string;
begin
  if cp < $80 then Result := Chr(cp)
  else if cp < $800 then Result := Chr($C0 or (cp shr 6)) + Chr($80 or (cp and $3F))
  else if cp < $10000 then
    Result := Chr($E0 or (cp shr 12)) + Chr($80 or ((cp shr 6) and $3F)) + Chr($80 or (cp and $3F))
  else
    Result := Chr($F0 or (cp shr 18)) + Chr($80 or ((cp shr 12) and $3F)) +
              Chr($80 or ((cp shr 6) and $3F)) + Chr($80 or (cp and $3F));
end;

{ Decode un point de code UTF-8 a partir de s[i], avance i }
function Utf8Decode(const s: string; var i: Integer): Integer;
var
  c: Integer;
begin
  c := Ord(s[i]);
  if c < $80 then begin Result := c; Inc(i); end
  else if (c and $E0) = $C0 then
  begin
    Result := ((c and $1F) shl 6) or (Ord(s[i + 1]) and $3F);
    Inc(i, 2);
  end
  else if (c and $F0) = $E0 then
  begin
    Result := ((c and $0F) shl 12) or ((Ord(s[i + 1]) and $3F) shl 6) or (Ord(s[i + 2]) and $3F);
    Inc(i, 3);
  end
  else
  begin
    Result := ((c and $07) shl 18) or ((Ord(s[i + 1]) and $3F) shl 12) or
              ((Ord(s[i + 2]) and $3F) shl 6) or (Ord(s[i + 3]) and $3F);
    Inc(i, 4);
  end;
end;

function IsIdStart(c: Char): Boolean;
begin
  Result := ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c = '_') or (Ord(c) >= 128);
end;

function IsIdChar(c: Char): Boolean;
begin
  Result := IsIdStart(c) or ((c >= '0') and (c <= '9'));
end;

function IsDigitC(c: Char): Boolean;
begin
  Result := (c >= '0') and (c <= '9');
end;

function HexVal(c: Char): Integer;
begin
  if (c >= '0') and (c <= '9') then Result := Ord(c) - 48
  else if (c >= 'a') and (c <= 'f') then Result := Ord(c) - 87
  else if (c >= 'A') and (c <= 'F') then Result := Ord(c) - 55
  else Result := -1;
end;

procedure TokAdd(const t: TToken);
begin
  if NToks >= Length(Toks) then SetLength(Toks, Length(Toks) * 2 + 1024);
  Toks[NToks] := t;
  Inc(NToks);
end;

procedure LexError(fi, line, col, len: Integer; const msg: string);
begin
  Report(True, '', msg, fi, line, col, len, '');
  FinishDiag;
end;

const
  Punct3: array[0..3] of string = ('<<=', '>>=', '...', '..=');
  Punct2: array[0..19] of string = ('::', '->', '=>', '==', '!=', '<=', '>=', '&&', '||', '+=', '-=',
    '*=', '/=', '%=', '^=', '&=', '|=', '<<', '>>', '..');

{ Lit un fichier source entier dans le tableau Toks }
procedure LexFile(fi: Integer);
var
  src: string;
  i, n, line, lstart, depth, j, cp, base, dig, c0: Integer;
  t: TToken;
  c: Char;
  hashes, startI: Integer;
  isFloat, found: Boolean;
  buf: string;
  v: QWord;
  digs: string;
  q: Integer;
  fl: string;
  code: Integer;
  tokStart: Integer;

  function Peek(k: Integer): Char;
  begin
    if i + k <= n then Result := src[i + k] else Result := #0;
  end;

  procedure Start(kind: Integer);
  begin
    tokStart := i;
    t.k := kind;
    t.s := '';
    t.line := line;
    t.col := i - lstart + 1;
    t.len := 1;
    t.fi := fi;
    t.iv := 0;
    t.fv := 0;
    t.sfx := '';
    t.raw := False;
  end;

  { lit un echappement a partir de src[i]='\\' ; ajoute les octets a buf ; retourne le code }
  function Escape(var out: string; bytesOnly: Boolean): Integer;
  var
    h: Integer;
    k: Integer;
  begin
    Inc(i);
    c := src[i];
    Result := 0;
    case c of
      'n': begin Result := 10; Inc(i); end;
      'r': begin Result := 13; Inc(i); end;
      't': begin Result := 9; Inc(i); end;
      '\': begin Result := 92; Inc(i); end;
      '0': begin Result := 0; Inc(i); end;
      '''': begin Result := 39; Inc(i); end;
      '"': begin Result := 34; Inc(i); end;
      'x':
        begin
          Inc(i);
          h := HexVal(src[i]) * 16 + HexVal(src[i + 1]);
          Inc(i, 2);
          Result := h;
          if (not bytesOnly) and (h > 127) then
            LexError(fi, line, i - lstart - 3, 4, 'out of range hex escape');
        end;
      'u':
        begin
          Inc(i);
          if src[i] <> '{' then LexError(fi, line, i - lstart, 1, 'incorrect unicode escape sequence');
          Inc(i);
          h := 0;
          while (i <= n) and (src[i] <> '}') do
          begin
            if src[i] <> '_' then h := h * 16 + HexVal(src[i]);
            Inc(i);
          end;
          Inc(i);
          Result := h;
          out := out + Utf8Encode(h);
          Escape := h;
          Exit;
        end;
    else
      LexError(fi, line, i - lstart, 1, 'unknown character escape: `' + c + '`');
    end;
    out := out + Chr(Result and 255);
    if Result > 127 then ;
  end;

  procedure AddPunct(const p: string);
  begin
    Start(tkPunct);
    t.s := p;
    t.len := Length(p);
    TokAdd(t);
    Inc(i, Length(p));
  end;

begin
  src := Files[fi].text;
  n := Length(src);
  i := 1;
  line := 1;
  lstart := 1;
  { ligne shebang }
  if (n > 2) and (src[1] = '#') and (src[2] = '!') and (Peek(2) <> '[') then
    while (i <= n) and (src[i] <> #10) do Inc(i);
  while i <= n do
  begin
    c := src[i];
    if c = #10 then begin Inc(i); Inc(line); lstart := i; Continue; end;
    if (c = ' ') or (c = #9) or (c = #13) then begin Inc(i); Continue; end;
    { commentaires }
    if (c = '/') and (Peek(1) = '/') then
    begin
      while (i <= n) and (src[i] <> #10) do Inc(i);
      Continue;
    end;
    if (c = '/') and (Peek(1) = '*') then
    begin
      depth := 1;
      q := line;
      c0 := i - lstart + 1;
      Inc(i, 2);
      while (i <= n) and (depth > 0) do
      begin
        if (src[i] = '/') and (Peek(1) = '*') then begin Inc(depth); Inc(i, 2); end
        else if (src[i] = '*') and (Peek(1) = '/') then begin Dec(depth); Inc(i, 2); end
        else if src[i] = #10 then begin Inc(i); Inc(line); lstart := i; end
        else Inc(i);
      end;
      if depth > 0 then LexError(fi, q, c0, 2, 'unterminated block comment');
      Continue;
    end;
    { identificateurs, chaines brutes, octets }
    if IsIdStart(c) then
    begin
      { r"..." r#"..."# br"..." b"..." b'x' r#ident }
      if (c = 'r') and ((Peek(1) = '"') or ((Peek(1) = '#') and ((Peek(2) = '"') or (Peek(2) = '#')))) then
      begin
        Start(tkStr);
        startI := i;
        Inc(i);
        hashes := 0;
        while src[i] = '#' do begin Inc(hashes); Inc(i); end;
        Inc(i); { guillemet ouvrant }
        buf := '';
        found := False;
        while i <= n do
        begin
          if src[i] = '"' then
          begin
            j := 0;
            while (j < hashes) and (i + 1 + j <= n) and (src[i + 1 + j] = '#') do Inc(j);
            if j = hashes then begin Inc(i, 1 + hashes); found := True; Break; end;
          end;
          if src[i] = #10 then begin buf := buf + #10; Inc(i); Inc(line); lstart := i; end
          else begin buf := buf + src[i]; Inc(i); end;
        end;
        if not found then LexError(fi, t.line, t.col, 1, 'unterminated raw string');
        t.s := buf;
        t.len := 1;
        TokAdd(t);
        Continue;
      end;
      if (c = 'r') and (Peek(1) = '#') and IsIdStart(Peek(2)) then
      begin
        Start(tkIdent);
        Inc(i, 2);
        j := i;
        while (i <= n) and IsIdChar(src[i]) do Inc(i);
        t.s := Copy(src, j, i - j);
        t.len := i - j + 2;
        t.raw := True;
        TokAdd(t);
        Continue;
      end;
      if (c = 'b') and (Peek(1) = '"') then
      begin
        Start(tkByteStr);
        Inc(i, 2);
        buf := '';
        while (i <= n) and (src[i] <> '"') do
        begin
          if src[i] = '\' then
          begin
            if Peek(1) = #10 then
            begin
              Inc(i, 2); Inc(line); lstart := i;
              while (i <= n) and ((src[i] = ' ') or (src[i] = #9) or (src[i] = #10) or (src[i] = #13)) do
              begin
                if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
                Inc(i);
              end;
            end
            else Escape(buf, True);
          end
          else
          begin
            if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
            buf := buf + src[i]; Inc(i);
          end;
        end;
        Inc(i);
        t.len := i - tokStart;
        t.s := buf;
        TokAdd(t);
        Continue;
      end;
      if (c = 'b') and (Peek(1) = '''') then
      begin
        Start(tkByte);
        Inc(i, 2);
        buf := '';
        if src[i] = '\' then t.iv := Escape(buf, True)
        else begin t.iv := Ord(src[i]); Inc(i); end;
        if src[i] <> '''' then LexError(fi, t.line, t.col, 3, 'unterminated byte constant');
        Inc(i);
        t.len := 4;
        TokAdd(t);
        Continue;
      end;
      if (c = 'b') and (Peek(1) = 'r') and ((Peek(2) = '"') or (Peek(2) = '#')) then
      begin
        Start(tkByteStr);
        Inc(i, 2);
        hashes := 0;
        while src[i] = '#' do begin Inc(hashes); Inc(i); end;
        Inc(i);
        buf := '';
        while i <= n do
        begin
          if src[i] = '"' then
          begin
            j := 0;
            while (j < hashes) and (src[i + 1 + j] = '#') do Inc(j);
            if j = hashes then begin Inc(i, 1 + hashes); Break; end;
          end;
          if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
          buf := buf + src[i];
          Inc(i);
        end;
        t.len := i - tokStart;
        t.s := buf;
        TokAdd(t);
        Continue;
      end;
      Start(tkIdent);
      j := i;
      while (i <= n) and IsIdChar(src[i]) do Inc(i);
      t.s := Copy(src, j, i - j);
      t.len := i - j;
      TokAdd(t);
      Continue;
    end;
    { nombres }
    if IsDigitC(c) then
    begin
      Start(tkInt);
      j := i;
      isFloat := False;
      base := 10;
      v := 0;
      digs := '';
      if (c = '0') and ((Peek(1) = 'x') or (Peek(1) = 'o') or (Peek(1) = 'b')) then
      begin
        case Peek(1) of
          'x': base := 16;
          'o': base := 8;
          'b': base := 2;
        end;
        Inc(i, 2);
        while (i <= n) and ((src[i] = '_') or ((HexVal(src[i]) >= 0) and (HexVal(src[i]) < base))) do
        begin
          if src[i] <> '_' then
          begin
            dig := HexVal(src[i]);
            if (v > (High(QWord) - QWord(dig)) div QWord(base)) then
              LexError(fi, line, j - lstart + 1, i - j, 'integer literal is too large');
            v := v * base + dig;
          end;
          Inc(i);
        end;
        { suffixe: lettres hex ambigues pour la base 16 seulement apres i/u }
      end
      else
      begin
        while (i <= n) and (IsDigitC(src[i]) or (src[i] = '_')) do
        begin
          if src[i] <> '_' then digs := digs + src[i];
          Inc(i);
        end;
        if (src[i] = '.') and (Peek(1) <> '.') and (not IsIdStart(Peek(1))) then
        begin
          isFloat := True;
          Inc(i);
          digs := digs + '.';
          while (i <= n) and (IsDigitC(src[i]) or (src[i] = '_')) do
          begin
            if src[i] <> '_' then digs := digs + src[i];
            Inc(i);
          end;
          if Length(digs) > 0 then if digs[Length(digs)] = '.' then digs := digs + '0';
        end;
        if ((src[i] = 'e') or (src[i] = 'E')) and
           (IsDigitC(Peek(1)) or (((Peek(1) = '+') or (Peek(1) = '-')) and IsDigitC(Peek(2)))) then
        begin
          isFloat := True;
          digs := digs + 'e';
          Inc(i);
          if (src[i] = '+') or (src[i] = '-') then begin digs := digs + src[i]; Inc(i); end;
          while (i <= n) and (IsDigitC(src[i]) or (src[i] = '_')) do
          begin
            if src[i] <> '_' then digs := digs + src[i];
            Inc(i);
          end;
        end;
      end;
      { suffixe }
      if (i <= n) and IsIdStart(src[i]) then
      begin
        q := i;
        while (i <= n) and IsIdChar(src[i]) do Inc(i);
        t.sfx := Copy(src, q, i - q);
        if (t.sfx = 'f32') or (t.sfx = 'f64') then
        begin
          if base = 10 then isFloat := True;
        end;
      end;
      if isFloat then
      begin
        t.k := tkFloat;
        Val(digs, t.fv, code);
        if code <> 0 then LexError(fi, line, j - lstart + 1, i - j, 'invalid float literal');
      end
      else if base = 10 then
      begin
        v := 0;
        for q := 1 to Length(digs) do
        begin
          dig := Ord(digs[q]) - 48;
          if (v > (High(QWord) - QWord(dig)) div 10) then
            LexError(fi, line, j - lstart + 1, i - j, 'integer literal is too large');
          v := v * 10 + dig;
        end;
        t.iv := v;
      end
      else t.iv := v;
      t.len := i - j;
      t.s := Copy(src, j, i - j - Length(t.sfx));
      TokAdd(t);
      Continue;
    end;
    { chaines }
    if c = '"' then
    begin
      Start(tkStr);
      Inc(i);
      buf := '';
      found := False;
      while i <= n do
      begin
        if src[i] = '"' then begin found := True; Inc(i); Break; end;
        if src[i] = '\' then
        begin
          if Peek(1) = #10 then
          begin
            Inc(i, 2); Inc(line); lstart := i;
            while (i <= n) and ((src[i] = ' ') or (src[i] = #9) or (src[i] = #10) or (src[i] = #13)) do
            begin
              if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
              Inc(i);
            end;
          end
          else if (Peek(1) = #13) and (Peek(2) = #10) then
          begin
            Inc(i, 3); Inc(line); lstart := i;
            while (i <= n) and ((src[i] = ' ') or (src[i] = #9) or (src[i] = #10) or (src[i] = #13)) do
            begin
              if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
              Inc(i);
            end;
          end
          else Escape(buf, False);
        end
        else
        begin
          if src[i] = #10 then begin Inc(line); lstart := i + 1; end;
          if src[i] <> #13 then buf := buf + src[i];
          Inc(i);
        end;
      end;
      if not found then LexError(fi, t.line, t.col, 1, 'unterminated double quote string');
      t.len := i - tokStart;
      t.s := buf;
      TokAdd(t);
      Continue;
    end;
    { caractere ou duree de vie }
    if c = '''' then
    begin
      Start(tkChar);
      if Peek(1) = '\' then
      begin
        Inc(i);
        buf := '';
        t.iv := Escape(buf, False);
        if src[i] <> '''' then LexError(fi, line, t.col, 1, 'unterminated character literal');
        Inc(i);
        t.len := i - (t.col + lstart - 1);
        TokAdd(t);
        Continue;
      end;
      q := i + 1;
      cp := Utf8Decode(src, q);
      if src[q] = '''' then
      begin
        t.iv := cp;
        t.len := q + 1 - i;
        i := q + 1;
        TokAdd(t);
        Continue;
      end;
      { duree de vie }
      t.k := tkLifetime;
      Inc(i);
      j := i;
      while (i <= n) and IsIdChar(src[i]) do Inc(i);
      t.s := Copy(src, j, i - j);
      t.len := i - j + 1;
      TokAdd(t);
      Continue;
    end;
    { ponctuation }
    found := False;
    for q := 0 to 3 do
      if Copy(src, i, 3) = Punct3[q] then begin AddPunct(Punct3[q]); found := True; Break; end;
    if found then Continue;
    for q := 0 to 19 do
      if Copy(src, i, 2) = Punct2[q] then begin AddPunct(Punct2[q]); found := True; Break; end;
    if found then Continue;
    if Pos(c, '+-*/%^!&|=<>@.,;:#$?~()[]{}') = 0 then
      LexError(fi, line, i - lstart + 1, 1, 'unknown start of token: ' + c);
    AddPunct(c);
  end;
  Start(tkEOF);
  t.col := i - lstart + 1;
  TokAdd(t);
end;

