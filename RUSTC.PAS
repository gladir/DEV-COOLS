function InstanceKey(def: Integer; const args: TIntArr): string;
var
  i: Integer;
begin
  Result := IntToStr(def);
  for i := 0 to Length(args) - 1 do Result := Result + ',' + IntToStr(args[i]);
end;

{ Remplace les types opaques (impl Trait) par leur type concret }

function ZonkReveal(t: Integer): Integer;
var
  tt: TTy;
  i: Integer;
  changed: Boolean;
begin
  t := Shallow(t);
  if Tys[t].k = tyOpaque then
  begin
    Result := RevealOpaque(t);
    if Result <> t then Result := ZonkReveal(Result);
    Exit;
  end;
  if Length(Tys[t].args) = 0 then begin Result := t; Exit; end;
  tt := Tys[t];
  tt.args := ICopy(tt.args);
  changed := False;
  for i := 0 to Length(tt.args) - 1 do
  begin
    tt.args[i] := ZonkReveal(tt.args[i]);
    if tt.args[i] <> Tys[t].args[i] then changed := True;
  end;
  if changed then Result := InternTy(tt) else Result := t;
end;

procedure DefaultTy(t: Integer);
var
  i: Integer;
begin
  t := Shallow(t);
  if Tys[t].k = tyVar then
  begin
    if VarKind[Tys[t].n] = 1 then Unify(t, TyI32)
    else if VarKind[Tys[t].n] = 2 then Unify(t, TyF64);
    Exit;
  end;
  for i := 0 to Length(Tys[t].args) - 1 do DefaultTy(Tys[t].args[i]);
end;

function IntFits(v: Int64; neg: Boolean; t: Integer): Boolean;
var
  bits: Integer;
  mn, mx: Int64;
  uv: QWord;
begin
  Result := True;
  if Tys[t].k <> tyInt then Exit;
  bits := Tys[t].n;
  if bits >= 128 then Exit;
  if (Tys[t].f and 1) <> 0 then
  begin
    if bits = 64 then
    begin
      if neg then Result := v <= 0 else Result := v >= 0;
      Exit;
    end;
    mx := (Int64(1) shl (bits - 1)) - 1;
    mn := -(Int64(1) shl (bits - 1));
    Result := (v >= mn) and (v <= mx);
  end
  else
  begin
    if neg then begin Result := v = 0; Exit; end;
    if bits = 64 then Exit;
    uv := QWord(v);
    Result := uv < (QWord(1) shl bits);
  end;
end;

function RangeStr(t: Integer): string;
var
  bits: Integer;
begin
  bits := Tys[t].n;
  if (Tys[t].f and 1) <> 0 then
  begin
    if bits = 64 then Result := '-9223372036854775808..=9223372036854775807'
    else Result := '-' + IntToStr(Int64(1) shl (bits - 1)) + '..=' + IntToStr((Int64(1) shl (bits - 1)) - 1);
  end
  else
  begin
    if bits = 64 then Result := '0..=18446744073709551615'
    else Result := '0..=' + IntToStr((Int64(1) shl bits) - 1);
  end;
end;

procedure FinalizeInstance(hirStart, patStart, firstBody: Integer);
var
  i, j, b, t: Integer;
  reported: Boolean;
  cl: Integer;
  ty: Integer;
  neg: Boolean;
begin
  SolveObligations;
  for i := hirStart to NHirs - 1 do DefaultTy(Hirs[i].ty);
  for i := patStart to NPats - 1 do DefaultTy(Pats[i].ty);
  for j := 0 to Length(InstBodies) - 1 do
  begin
    b := InstBodies[j];
    for i := 0 to Bodies[b].nvars - 1 do DefaultTy(Bodies[b].vars[i].ty);
  end;
  for i := 0 to NClosures - 1 do
  begin
    for j := 0 to Length(Closures[i].params) - 1 do DefaultTy(Closures[i].params[j]);
    if Closures[i].ret <> 0 then DefaultTy(Closures[i].ret);
  end;
  SolveObligations;
  { zonk }
  reported := False;
  for i := hirStart to NHirs - 1 do
  begin
    Hirs[i].ty := ZonkReveal(Hirs[i].ty);
    for j := 0 to Length(Hirs[i].targs) - 1 do Hirs[i].targs[j] := ZonkReveal(Hirs[i].targs[j]);
    if (not reported) and (Hirs[i].k <> hCoerce) and HasVars(Hirs[i].ty) and (Hirs[i].line > 0) then
    begin
      reported := True;
      Report(True, 'E0282', 'type annotations needed', Hirs[i].fi, Hirs[i].line, Hirs[i].col, Hirs[i].len,
             'cannot infer type');
    end;
    if (Hirs[i].k = hLitInt) and (Hirs[i].fi >= 0) and (Hirs[i].line > 0) and (Tys[Hirs[i].ty].k = tyInt) then
    begin
      neg := Hirs[i].s = '-';
      if not IntFits(Hirs[i].n, neg, Hirs[i].ty) then
      begin
        Report(True, '', 'literal out of range for `' + TyToStr(Hirs[i].ty) + '`', Hirs[i].fi, Hirs[i].line,
               Hirs[i].col, Hirs[i].len, '');
        Note('the literal does not fit into the type `' + TyToStr(Hirs[i].ty) + '` whose range is `' +
             RangeStr(Hirs[i].ty) + '`');
        Note('`#[deny(overflowing_literals)]` on by default');
      end;
    end;
  end;
  for i := patStart to NPats - 1 do Pats[i].ty := ZonkReveal(Pats[i].ty);
  for j := 0 to Length(InstBodies) - 1 do
  begin
    b := InstBodies[j];
    for i := 0 to Bodies[b].nvars - 1 do Bodies[b].vars[i].ty := ZonkReveal(Bodies[b].vars[i].ty);
    Bodies[b].ret := ZonkReveal(Bodies[b].ret);
    for i := 0 to Length(Bodies[b].paramTys) - 1 do Bodies[b].paramTys[i] := ZonkReveal(Bodies[b].paramTys[i]);
  end;
  for i := firstBody * 0 to NClosures - 1 do
  begin
    for j := 0 to Length(Closures[i].params) - 1 do Closures[i].params[j] := ZonkReveal(Closures[i].params[j]);
    if Closures[i].ret <> 0 then Closures[i].ret := ZonkReveal(Closures[i].ret);
    for j := 0 to Length(Closures[i].capTys) - 1 do Closures[i].capTys[j] := ZonkReveal(Closures[i].capTys[j]);
  end;
end;

function CheckInstance(def: Integer; const args: TIntArr): Integer;
var
  key: string;
  b, i, nd, p, v, pat, h, bodyH, retT, hirStart, patStart, svBase, svTop, svObls, k: Integer;
  params: TIntArr;
  ret: Integer;
  env: TEnv;
  stmts: TIntArr;
  svBodies: TIntArr;
  pn, sp: Integer;
  ptys: TIntArr;
  svNPatB, svAlt: Integer;
  svLoop: Integer;
  svPatNames: TStrArr;
  svPatVars: TIntArr;
  vi: Integer;
  isSelf: Boolean;
  fnBody: Integer;
  svFirstBody: Integer;
begin
  key := InstanceKey(def, args);
  Result := HFind(BodyMap, key);
  if Result >= 0 then Exit;
  Result := -1;
  nd := Defs[def].node;
  case Defs[def].kind of
    dkFn: if Nodes[nd].b = 0 then Exit;
    dkConst, dkStatic: if Nodes[nd].b = 0 then Exit;
  else
    Exit;
  end;
  if NBodies >= Length(Bodies) then SetLength(Bodies, NBodies * 2 + 16);
  b := NBodies;
  Inc(NBodies);
  Bodies[b].def := def;
  Bodies[b].targs := ICopy(args);
  Bodies[b].key := key;
  Bodies[b].nvars := 0;
  Bodies[b].vars := nil;
  Bodies[b].isClosure := False;
  Bodies[b].done := False;
  Bodies[b].fnNode := nd;
  HPut(BodyMap, key, b);
  Result := b;
  { sauvegarde du contexte (appels imbriques pour les types opaques) }
  svBodies := InstBodies;
  InstBodies := nil;
  IAdd(InstBodies, b);
  svBase := CxBase;
  svNPatB := NPatB;
  svPatNames := PatNames;
  svPatVars := PatVars;
  svAlt := PatAltDepth;
  PatAltDepth := 0;
  CxBase := CxTop;
  hirStart := NHirs;
  patStart := NPats;
  PushCtx(b, -1);
  EnvForDef(def, args, env);
  env.infer := True;
  Cxs[CxTop].env := env;
  Cxs[CxTop].unsafeDepth := 0;
  EnterScope;
  stmts := nil;
  if Defs[def].kind = dkFn then
  begin
    FnDefSig(def, args, params, ret);
    { retour opaque : le type reel est deduit du corps }
    if Tys[Shallow(ret)].k = tyOpaque then ret := NewTyVar(0);
    Cxs[CxTop].retTy := ret;
    Bodies[b].ret := ret;
    Bodies[b].paramTys := params;
    Bodies[b].params := nil;
    k := 0;
    for i := 0 to Length(Nodes[nd].l2) - 1 do
    begin
      p := Nodes[nd].l2[i];
      if Nodes[p].k = nSelfParam then
      begin
        v := NewVarInfo('self', params[k], (Nodes[p].f and 2) <> 0, p);
        if (Nodes[p].f and 1) <> 0 then Bodies[b].vars[v].mut := False;
        Bodies[b].vars[v].isParam := True;
        Bodies[b].vars[v].used := True;
        DeclareVar('self', v);
        IAdd(Bodies[b].params, v);
      end
      else
      begin
        pn := Nodes[p].a;
        if (Nodes[pn].k = pIdent) and (Nodes[pn].a = 0) and ((Nodes[pn].f and 1) = 0) then
        begin
          v := NewVarInfo(Nodes[pn].s, params[k], (Nodes[pn].f and 2) <> 0, pn);
          Bodies[b].vars[v].isParam := True;
          DeclareVar(Nodes[pn].s, v);
          IAdd(Bodies[b].params, v);
        end
        else
        begin
          v := NewVarInfo('__arg' + IntToStr(i), params[k], False, pn);
          Bodies[b].vars[v].isParam := True;
          Bodies[b].vars[v].used := True;
          IAdd(Bodies[b].params, v);
          NPatB := 0;
          pat := CheckPat(pn, params[k], 0);
          h := HirAt(hLocal, params[k], pn);
          Hirs[h].n := v;
          bodyH := HirAt(hLet, TyUnit, pn);
          Hirs[bodyH].n := pat;
          Hirs[bodyH].a := h;
          IAdd(stmts, bodyH);
        end;
      end;
      Inc(k);
    end;
    bodyH := CheckBlockExpr(Nodes[nd].b, ret);
    { corps vide avec retour attendu }
    if not IsNeverTy(Hirs[bodyH].ty) then
    begin
      if (Hirs[bodyH].k = hBlock) and (Hirs[bodyH].a = 0) and (not TryUnify(ret, TyUnit)) then
      begin
        ErrAt(Nodes[nd].b, 'E0308', 'mismatched types', 'expected `' + TyStrZ(ret) + '`, found `()`');
      end
      else
        bodyH := CoerceTo(bodyH, ret, Nodes[nd].b);
    end;
    if Length(stmts) > 0 then
      bodyH := HBlockOf(ICopy(stmts), bodyH, Hirs[bodyH].ty, Nodes[nd].b);
    Bodies[b].root := bodyH;
  end
  else
  begin
    FnDefSig(def, args, params, ret);
    Cxs[CxTop].retTy := ret;
    Bodies[b].ret := ret;
    Bodies[b].params := nil;
    Bodies[b].paramTys := nil;
    Cxs[CxTop].isConstCtx := True;
    bodyH := CheckExpr(Nodes[nd].b, ret);
    bodyH := CoerceTo(bodyH, ret, Nodes[nd].b);
    Bodies[b].root := bodyH;
  end;
  LeaveScope;
  PopCtx;
  FinalizeInstance(hirStart, patStart, b);
  Bodies[b].done := True;
  CxBase := svBase;
  InstBodies := svBodies;
  NPatB := svNPatB;
  PatNames := svPatNames;
  PatVars := svPatVars;
  PatAltDepth := svAlt;
end;

function RevealOpaque(t: Integer): Integer;
var
  args: TIntArr;
  b: Integer;
  i: Integer;
begin
  Result := t;
  t := Shallow(t);
  if Tys[t].k <> tyOpaque then begin Result := t; Exit; end;
  args := Tys[t].args;
  for i := 0 to Length(args) - 1 do
    if HasVars(args[i]) then Exit;
  b := CheckInstance(Tys[t].def, args);
  if b >= 0 then
  begin
    if Bodies[b].done then Result := Bodies[b].ret
    else Result := Bodies[b].ret;
  end;
end;

{ ============================================================ }
{ MIR : representation intermediaire basee sur des blocs        }
{ ============================================================ }

Const
  { projections de places }
  peDeref = 1;
  peField = 2;        { n = indice, ty = type du champ }
  peIndex = 3;        { n = variable locale contenant l'indice }
  peDowncast = 4;     { n = indice de variante }
  peConstIndex = 5;   { n = indice constant ; fromEnd si m = 1 }

  { operandes }
  opCopy = 1;
  opMove = 2;
  opConst = 3;

  { sortes de constantes }
  ckInt = 1;
  ckFloat = 2;
  ckBool = 3;
  ckChar = 4;
  ckStr = 5;
  ckByteStr = 6;
  ckUnit = 7;         { valeur de taille nulle }
  ckFnItem = 8;       { fonction : de taille nulle }
  ckFnPtr = 9;        { adresse de fonction }
  ckNull = 10;
  ckStatic = 11;      { adresse d'une statique }
  ckUndef = 12;

  { valeurs de droite }
  rvUse = 1;
  rvRef = 2;
  rvAddrOf = 3;
  rvBin = 4;
  rvCheckedBin = 5;
  rvUn = 6;
  rvCast = 7;
  rvAgg = 8;
  rvDiscr = 9;
  rvLen = 10;
  rvRepeat = 11;
  rvSizeOf = 12;

  { agregats }
  agTuple = 1;
  agArray = 2;
  agAdt = 3;
  agClosure = 4;

  { instructions }
  stNop = 0;
  stAssign = 1;
  stSetDiscr = 2;

  { terminateurs }
  tmNone = 0;
  tmGoto = 1;
  tmSwitch = 2;
  tmReturn = 3;
  tmUnreachable = 4;
  tmCall = 5;
  tmAssert = 6;
  tmAssertBounds = 7;

  { sortes d'appel }
  ckDirect = 1;
  ckIndirect = 2;
  ckClosureCall = 3;
  ckIntrinsic = 4;
  ckVirtual = 5;

Type
  TPlaceElem = record
    k: Integer;
    n: Integer;
    m: Integer;
    ty: Integer;
  end;

  TPlace = record
    local: Integer;
    elems: array of TPlaceElem;
    ty: Integer;
    glob: Integer;      { statique si >= 0 }
  end;

  TOperand = record
    k: Integer;
    place: TPlace;
    ty: Integer;
    ck: Integer;
    n: Int64;
    fv: Double;
    s: string;
    def: Integer;
    targs: TIntArr;
  end;
  TOperandArr = array of TOperand;

  TRvalue = record
    k: Integer;
    ty: Integer;
    a, b: TOperand;
    place: TPlace;
    ops: TOperandArr;
    mut: Boolean;
    op: string;
    agk: Integer;
    def: Integer;
    vidx: Integer;
    n: Int64;
    srcTy: Integer;
  end;

  TStmt = record
    k: Integer;
    place: TPlace;
    rv: TRvalue;
    line, col, fi: Integer;
  end;

  TTerm = record
    k: Integer;
    target: Integer;
    othrw: Integer;
    discr: TOperand;
    vals: array of Int64;
    targets: TIntArr;
    callKind: Integer;
    def: Integer;
    targs: TIntArr;
    sym: string;
    callee: TOperand;
    args: TOperandArr;
    dest: TPlace;
    hasDest: Boolean;
    cond: TOperand;
    expect: Boolean;
    msg: string;
    loc: string;
    idx, len: TOperand;
    inst: Integer;
    retTy: Integer;
    line, col, fi: Integer;
  end;

  TMirBlock = record
    stmts: array of TStmt;
    nst: Integer;
    term: TTerm;
    terminated: Boolean;
  end;

  TMirLocal = record
    ty: Integer;
    name: string;
    mut: Boolean;
    isArg: Boolean;
  end;

  TMirFn = record
    def: Integer;
    targs: TIntArr;
    sym: string;
    isClosure: Boolean;
    closure: Integer;
    locals: array of TMirLocal;
    nlocals: Integer;
    nargs: Integer;
    blocks: array of TMirBlock;
    nblocks: Integer;
    retTy: Integer;
    isCtor: Boolean;
    isStaticInit: Boolean;
    isConst: Boolean;
    bodyIdx: Integer;
    external: Boolean;
    name: string;
  end;

Var
  MirFns: array of TMirFn;
  NMirFns: Integer;

function BoolStrS(v: Boolean): string;
begin
  if v then Result := 'true' else Result := 'false';
end;

function FloatToStrS(v: Double): string;
var
  s: string;
begin
  Str(v:0:6, s);
  Result := s;
end;

{ ---- affichage ---- }

function PlaceStr(const p: TPlace): string;
var
  i: Integer;
  s: string;
begin
  if p.glob >= 0 then s := 'static_' + IntToStr(p.glob) else s := '_' + IntToStr(p.local);
  for i := 0 to Length(p.elems) - 1 do
    case p.elems[i].k of
      peDeref: s := '(*' + s + ')';
      peField: s := s + '.' + IntToStr(p.elems[i].n);
      peIndex: s := s + '[_' + IntToStr(p.elems[i].n) + ']';
      peDowncast: s := '(' + s + ' as variant#' + IntToStr(p.elems[i].n) + ')';
      peConstIndex: s := s + '[' + IntToStr(p.elems[i].n) + ' of ' + IntToStr(p.elems[i].m) + ']';
    end;
  Result := s;
end;

function ConstStr(const o: TOperand): string;
begin
  case o.ck of
    ckInt: Result := IntToStr(o.n) + '_' + TyToStr(o.ty);
    ckFloat: Result := FloatToStrS(o.fv) + '_' + TyToStr(o.ty);
    ckBool: if o.n <> 0 then Result := 'true' else Result := 'false';
    ckChar: Result := '''' + Utf8Encode(Integer(o.n)) + '''';
    ckStr: Result := '"' + RustEscape(o.s) + '"';
    ckByteStr: Result := 'b"' + RustEscape(o.s) + '"';
    ckUnit: Result := '()';
    ckFnItem: Result := Defs[o.def].name;
    ckFnPtr: Result := '&' + Defs[o.def].name;
    ckNull: Result := 'null';
    ckStatic: Result := '&' + Defs[o.def].name;
  else
    Result := '<undef>';
  end;
end;

function OperandStr(const o: TOperand): string;
begin
  case o.k of
    opCopy: Result := 'copy ' + PlaceStr(o.place);
    opMove: Result := 'move ' + PlaceStr(o.place);
  else
    Result := 'const ' + ConstStr(o);
  end;
end;

function RvalueStr(const r: TRvalue): string;
var
  i: Integer;
  s: string;
begin
  case r.k of
    rvUse: Result := OperandStr(r.a);
    rvRef: if r.mut then Result := '&mut ' + PlaceStr(r.place) else Result := '&' + PlaceStr(r.place);
    rvAddrOf: if r.mut then Result := '&raw mut ' + PlaceStr(r.place) else Result := '&raw const ' + PlaceStr(r.place);
    rvBin: Result := r.op + '(' + OperandStr(r.a) + ', ' + OperandStr(r.b) + ')';
    rvCheckedBin: Result := 'Checked' + r.op + '(' + OperandStr(r.a) + ', ' + OperandStr(r.b) + ')';
    rvUn: Result := r.op + '(' + OperandStr(r.a) + ')';
    rvCast: Result := OperandStr(r.a) + ' as ' + TyToStr(r.ty) + ' (cast)';
    rvAgg:
      begin
        s := '';
        for i := 0 to Length(r.ops) - 1 do
        begin
          if i > 0 then s := s + ', ';
          s := s + OperandStr(r.ops[i]);
        end;
        case r.agk of
          agTuple: Result := '(' + s + ')';
          agArray: Result := '[' + s + ']';
          agAdt:
            begin
              if Defs[r.def].kind = dkVariant then
                Result := Defs[Defs[r.def].parent].name + '::' + Defs[r.def].name + '(' + s + ')'
              else
                Result := Defs[r.def].name + '(' + s + ')';
            end;
          agClosure: Result := '{closure#' + IntToStr(r.def) + '}(' + s + ')';
        end;
      end;
    rvDiscr: Result := 'discriminant(' + PlaceStr(r.place) + ')';
    rvLen: Result := 'Len(' + PlaceStr(r.place) + ')';
    rvRepeat: Result := '[' + OperandStr(r.a) + '; ' + IntToStr(r.n) + ']';
    rvSizeOf: Result := 'SizeOf(' + TyToStr(r.srcTy) + ')';
  else
    Result := '?';
  end;
end;

function MirFnName(const f: TMirFn): string;
begin
  Result := f.name;
end;

procedure DumpMirFn(var b: TBuf; var f: TMirFn);
var
  i, j, k: Integer;
  t: TTerm;
  s: string;
begin
  BufAdd(b, 'fn ' + f.name + '(');
  for i := 1 to f.nargs do
  begin
    if i > 1 then BufAdd(b, ', ');
    BufAdd(b, '_' + IntToStr(i) + ': ' + TyToStr(f.locals[i].ty));
  end;
  BufLn(b, ') -> ' + TyToStr(f.retTy) + ' {');
  for i := 0 to f.nlocals - 1 do
  begin
    if (i >= 1) and (i <= f.nargs) then Continue;
    s := '    let ';
    if f.locals[i].mut then s := s + 'mut ';
    s := s + '_' + IntToStr(i) + ': ' + TyToStr(f.locals[i].ty) + ';';
    if f.locals[i].name <> '' then s := s + '  // ' + f.locals[i].name;
    BufLn(b, s);
  end;
  for i := 0 to f.nblocks - 1 do
  begin
    BufLn(b, '');
    BufLn(b, '    bb' + IntToStr(i) + ': {');
    for j := 0 to f.blocks[i].nst - 1 do
      case f.blocks[i].stmts[j].k of
        stAssign: BufLn(b, '        ' + PlaceStr(f.blocks[i].stmts[j].place) + ' = ' + RvalueStr(f.blocks[i].stmts[j].rv) + ';');
        stSetDiscr: BufLn(b, '        discriminant(' + PlaceStr(f.blocks[i].stmts[j].place) + ') = ' +
                          IntToStr(f.blocks[i].stmts[j].rv.n) + ';');
        stNop: BufLn(b, '        nop;');
      end;
    t := f.blocks[i].term;
    case t.k of
      tmGoto: BufLn(b, '        goto -> bb' + IntToStr(t.target) + ';');
      tmReturn: BufLn(b, '        return;');
      tmUnreachable: BufLn(b, '        unreachable;');
      tmSwitch:
        begin
          s := '        switchInt(' + OperandStr(t.discr) + ') -> [';
          for k := 0 to Length(t.vals) - 1 do
            s := s + IntToStr(t.vals[k]) + ': bb' + IntToStr(t.targets[k]) + ', ';
          s := s + 'othrw: bb' + IntToStr(t.othrw) + '];';
          BufLn(b, s);
        end;
      tmCall:
        begin
          s := '        ';
          if t.hasDest then s := s + PlaceStr(t.dest) + ' = ';
          case t.callKind of
            ckIndirect, ckClosureCall: s := s + OperandStr(t.callee) + '(';
          else
            s := s + t.sym + '(';
          end;
          for k := 0 to Length(t.args) - 1 do
          begin
            if k > 0 then s := s + ', ';
            s := s + OperandStr(t.args[k]);
          end;
          s := s + ')';
          if t.target >= 0 then s := s + ' -> [return: bb' + IntToStr(t.target) + ']';
          BufLn(b, s + ';');
        end;
      tmAssert:
        begin
          BufLn(b, '        assert(' + OperandStr(t.cond) + ' == ' + BoolStrS(t.expect) + ', "' + RustEscape(t.msg) +
                '") -> [success: bb' + IntToStr(t.target) + '];');
        end;
      tmAssertBounds:
        BufLn(b, '        assert(Lt(' + OperandStr(t.idx) + ', ' + OperandStr(t.len) +
              '), "index out of bounds") -> [success: bb' + IntToStr(t.target) + '];');
    else
      BufLn(b, '        <no terminator>;');
    end;
    BufLn(b, '    }');
  end;
  BufLn(b, '}');
  BufLn(b, '');
end;


{ ============================================================ }
{ Construction du MIR a partir du HIR                           }
{ ============================================================ }

Type
  TInst = record
    def: Integer;
    targs: TIntArr;
    key: string;
    sym: string;
    kind: Integer;       { 0 fonction, 1 fermeture, 2 init de statique, 3 constructeur }
    closure: Integer;
    mir: Integer;
    built: Boolean;
    external: Boolean;
    intrinsic: Boolean;
  end;

Const
  ikFn = 0;
  ikClosure = 1;
  ikStaticInit = 2;
  ikCtor = 3;

Var
  Insts: array of TInst;
  NInsts: Integer;
  InstMap: THashSI;
  SymNames: THashSI;
  OvfChecks: Boolean;
  StaticDefs: TIntArr;
  CrateNameStr: string;

  { etat du constructeur }
  BI: Integer;
  CurBB: Integer;
  BBody: Integer;
  VarLoc: TIntArr;
  RetBB: Integer;
  LoopIds, LoopBrk, LoopCont: TIntArr;
  LoopDest: array of TPlace;
  NLoops: Integer;
  BClosure: Integer;
  NoDest: TPlace;
  StrEqFn, BoundsFn: Integer;

function LocName(fi: Integer): string;
begin
  if (fi >= 0) and (fi < NFiles) then
  begin
    if Files[fi].name = '<std>' then Result := 'library/std/src/lib.rs'
    else Result := Files[fi].name;
  end
  else Result := SrcPathForLoc;
end;

function VariantDisc(v: Integer): Int64; forward;
function ExprOp(h: Integer): TOperand; forward;
procedure ExprInto(h: Integer; const dest: TPlace); forward;
function RequestInst(def: Integer; const targs: TIntArr): Integer; forward;
procedure RequestStatic(def: Integer); forward;

{ ---- noms de symboles ---- }

function DefPathName(d: Integer): string;
var
  p: Integer;
begin
  if d = StdRoot then begin Result := 'std'; Exit; end;
  if d = UserRoot then begin Result := CrateNameStr; Exit; end;
  if Defs[d].isExtern and (Defs[d].kind = dkFn) then begin Result := Defs[d].name; Exit; end;
  p := Defs[d].parent;
  if (p < 0) and (Defs[d].scopeMod > 0) and (Defs[d].scopeMod <> d) then p := Defs[d].scopeMod;
  if p < 0 then begin Result := Defs[d].name; Exit; end;
  if Defs[p].kind = dkImpl then
  begin
    if Defs[p].implTrait >= 0 then
      Result := DefPathName(Defs[p].scopeMod) + '::{impl ' + Defs[Defs[p].implTrait].name + '}::' + Defs[d].name
    else
      Result := DefPathName(Defs[p].scopeMod) + '::{impl}::' + Defs[d].name;
    Exit;
  end;
  if Defs[p].isBlock then
  begin
    Result := DefPathName(Defs[p].parent) + '::' + Defs[d].name;
    Exit;
  end;
  Result := DefPathName(p) + '::' + Defs[d].name;
end;

function UniqueSym(const base: string): string;
var
  n: Integer;
begin
  n := HFind(SymNames, base);
  if n < 0 then
  begin
    HPut(SymNames, base, 0);
    Result := base;
  end
  else
  begin
    Inc(n);
    HPut(SymNames, base, n);
    Result := base + '.' + IntToStr(n);
  end;
end;

function InstSymName(def: Integer; const targs: TIntArr): string;
var
  i: Integer;
  s: string;
begin
  s := DefPathName(def);
  if Length(targs) > 0 then
  begin
    s := s + '<';
    for i := 0 to Length(targs) - 1 do
    begin
      if i > 0 then s := s + ', ';
      s := s + TyToStr(targs[i]);
    end;
    s := s + '>';
  end;
  Result := s;
end;

function RequestInst(def: Integer; const targs: TIntArr): Integer;
var
  key: string;
  i: Integer;
  zt: TIntArr;
begin
  zt := nil;
  for i := 0 to Length(targs) - 1 do IAdd(zt, Zonk(targs[i]));
  key := InstanceKey(def, zt);
  Result := HFind(InstMap, key);
  if Result >= 0 then Exit;
  if NInsts >= Length(Insts) then SetLength(Insts, NInsts * 2 + 64);
  Result := NInsts;
  Inc(NInsts);
  Insts[Result].def := def;
  Insts[Result].targs := zt;
  Insts[Result].key := key;
  Insts[Result].kind := ikFn;
  Insts[Result].built := False;
  Insts[Result].closure := -1;
  Insts[Result].mir := -1;
  Insts[Result].external := False;
  Insts[Result].intrinsic := False;
  if (Defs[def].kind = dkStruct) or (Defs[def].kind = dkVariant) then Insts[Result].kind := ikCtor;
  if Defs[def].isExtern then
  begin
    Insts[Result].external := True;
    if Nodes[Defs[def].node].s2 = 'rust-intrinsic' then Insts[Result].intrinsic := True;
    Insts[Result].sym := Defs[def].name;
  end
  else Insts[Result].sym := UniqueSym(InstSymName(def, zt));
  HPut(InstMap, key, Result);
end;

function RequestClosureInst(cid: Integer): Integer;
var
  key: string;
begin
  key := 'c' + IntToStr(cid);
  Result := HFind(InstMap, key);
  if Result >= 0 then Exit;
  if NInsts >= Length(Insts) then SetLength(Insts, NInsts * 2 + 64);
  Result := NInsts;
  Inc(NInsts);
  Insts[Result].def := Bodies[Closures[cid].bodyIdx].def;
  Insts[Result].targs := nil;
  Insts[Result].key := key;
  Insts[Result].kind := ikClosure;
  Insts[Result].closure := cid;
  Insts[Result].built := False;
  Insts[Result].mir := -1;
  Insts[Result].external := False;
  Insts[Result].intrinsic := False;
  Insts[Result].sym := UniqueSym(DefPathName(Insts[Result].def) + '::{closure#' + IntToStr(cid) + '}');
  HPut(InstMap, key, Result);
end;

{ ---- aides de construction ---- }

function PLocal(l: Integer; ty: Integer): TPlace;
begin
  Result.local := l;
  Result.elems := nil;
  Result.ty := ty;
  Result.glob := -1;
end;

function PProj(const p: TPlace; k, n, ty: Integer): TPlace;
var
  c: Integer;
begin
  Result := p;
  c := Length(p.elems);
  SetLength(Result.elems, c + 1);
  Result.elems[c].k := k;
  Result.elems[c].n := n;
  Result.elems[c].m := 0;
  Result.elems[c].ty := ty;
  Result.ty := ty;
end;

function NewLocal(ty: Integer; const name: string; mut: Boolean): Integer;
begin
  with MirFns[BI] do
  begin
    if nlocals >= Length(locals) then SetLength(locals, nlocals * 2 + 16);
    locals[nlocals].ty := ty;
    locals[nlocals].name := name;
    locals[nlocals].mut := mut;
    locals[nlocals].isArg := False;
    Result := nlocals;
    Inc(nlocals);
  end;
end;

function NewTemp(ty: Integer): TPlace;
begin
  Result := PLocal(NewLocal(ty, '', True), ty);
end;

function NewBB: Integer;
begin
  with MirFns[BI] do
  begin
    if nblocks >= Length(blocks) then SetLength(blocks, nblocks * 2 + 16);
    Result := nblocks;
    blocks[Result].nst := 0;
    blocks[Result].stmts := nil;
    blocks[Result].terminated := False;
    blocks[Result].term.k := tmNone;
    Inc(nblocks);
  end;
end;

procedure EnsureOpen;
begin
  if MirFns[BI].blocks[CurBB].terminated then CurBB := NewBB;
end;

function EmptyOperand: TOperand;
begin
  FillChar(Result, SizeOf(Result), 0);
  Result.place.glob := -1;
end;

function OCopyPlace(const p: TPlace): TOperand;
begin
  Result := EmptyOperand;
  Result.ty := p.ty;
  if IsCopyTy(p.ty) then Result.k := opCopy else Result.k := opMove;
  Result.place := p;
end;

function OConst(ck: Integer; ty: Integer; n: Int64): TOperand;
begin
  Result := EmptyOperand;
  Result.k := opConst;
  Result.ck := ck;
  Result.ty := ty;
  Result.n := n;
end;

function OUnit: TOperand;
begin
  Result := OConst(ckUnit, TyUnit, 0);
end;

function OInt(ty: Integer; v: Int64): TOperand;
begin
  Result := OConst(ckInt, ty, v);
end;

function OBool(v: Boolean): TOperand;
begin
  Result := OConst(ckBool, TyBoolT, Ord(v));
end;

procedure EmitStmt(const st: TStmt);
begin
  EnsureOpen;
  with MirFns[BI].blocks[CurBB] do
  begin
    if nst >= Length(stmts) then SetLength(stmts, nst * 2 + 4);
    stmts[nst] := st;
    Inc(nst);
  end;
end;

procedure EmitAssign(const p: TPlace; const rv: TRvalue);
var
  st: TStmt;
begin
  FillChar(st, SizeOf(st), 0);
  st.k := stAssign;
  st.place := p;
  st.rv := rv;
  EmitStmt(st);
end;

function MkRv(k: Integer; ty: Integer): TRvalue;
begin
  FillChar(Result, SizeOf(Result), 0);
  Result.k := k;
  Result.ty := ty;
  Result.a := EmptyOperand;
  Result.b := EmptyOperand;
  Result.place.glob := -1;
end;

procedure AssignOp(const p: TPlace; const o: TOperand);
var
  rv: TRvalue;
begin
  rv := MkRv(rvUse, p.ty);
  rv.a := o;
  EmitAssign(p, rv);
end;

procedure SetTerm(const t: TTerm);
begin
  EnsureOpen;
  MirFns[BI].blocks[CurBB].term := t;
  MirFns[BI].blocks[CurBB].terminated := True;
end;

procedure TermGoto(target: Integer);
var
  t: TTerm;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmGoto;
  t.target := target;
  SetTerm(t);
end;

procedure TermGotoIfOpen(target: Integer);
begin
  if not MirFns[BI].blocks[CurBB].terminated then TermGoto(target);
end;

procedure TermUnreachable;
var
  t: TTerm;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmUnreachable;
  SetTerm(t);
end;

procedure TermSwitchBool(const cond: TOperand; trueBB, falseBB: Integer);
var
  t: TTerm;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmSwitch;
  t.discr := cond;
  SetLength(t.vals, 1);
  SetLength(t.targets, 1);
  t.vals[0] := 0;
  t.targets[0] := falseBB;
  t.othrw := trueBB;
  SetTerm(t);
end;

procedure TermSwitchInt(const op: TOperand; val: Int64; hitBB, missBB: Integer);
var
  t: TTerm;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmSwitch;
  t.discr := op;
  SetLength(t.vals, 1);
  SetLength(t.targets, 1);
  t.vals[0] := val;
  t.targets[0] := hitBB;
  t.othrw := missBB;
  SetTerm(t);
