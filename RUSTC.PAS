  BufLn(b, '    // ---- flottants ----');
  BufLn(b, '    fn float_digits(a: f64, is32: bool, digits: &mut String) -> i32 {');
  BufLn(b, '        // retourne l''exposant decimal e tel que a = d.ddd * 10^e ; digits recoit les chiffres significatifs');
  BufLn(b, '        let mut buf = [0u8; 64];');
  BufLn(b, '        let mut p = 0usize;');
  BufLn(b, '        loop {');
  BufLn(b, '            unsafe {');
  BufLn(b, '                ::std::libc::snprintf(buf.as_mut_ptr(), 64usize, "%.*e\0".as_ptr(), p as i32, a);');
  BufLn(b, '                let back = ::std::libc::strtod(buf.as_ptr(), ::std::ptr::null_mut());');
  BufLn(b, '                let same = if is32 { (back as f32) == (a as f32) } else { back == a };');
  BufLn(b, '                if same || p >= 17 { break; }');
  BufLn(b, '            }');
  BufLn(b, '            p += 1;');
  BufLn(b, '        }');
  BufLn(b, '        let mut i = 0usize;');
  BufLn(b, '        while buf[i] != 0u8 && buf[i] != 101u8 {');
  BufLn(b, '            if buf[i] != 46u8 { digits.push(buf[i] as char); }');
  BufLn(b, '            i += 1;');
  BufLn(b, '        }');
  BufLn(b, '        // exposant');
  BufLn(b, '        i += 1;');
  BufLn(b, '        let mut neg = false;');
  BufLn(b, '        if buf[i] == 45u8 { neg = true; i += 1; } else if buf[i] == 43u8 { i += 1; }');
  BufLn(b, '        let mut e = 0i32;');
  BufLn(b, '        while buf[i] != 0u8 { e = e * 10 + (buf[i] - 48u8) as i32; i += 1; }');
  BufLn(b, '        if neg { -e } else { e }');
  BufLn(b, '    }');
  BufLn(b, '');
  BufLn(b, '    pub fn float_to_decimal(a: f64, is32: bool, debug: bool, prec: usize) -> String {');
  BufLn(b, '        let mut out = String::new();');
  BufLn(b, '        if prec != ::std::usize::MAX {');
  BufLn(b, '            let mut buf = [0u8; 512];');
  BufLn(b, '            unsafe {');
  BufLn(b, '                let mut p = prec;');
  BufLn(b, '                if p > 300 { p = 300; }');
  BufLn(b, '                ::std::libc::snprintf(buf.as_mut_ptr(), 512usize, "%.*f\0".as_ptr(), p as i32, a);');
  BufLn(b, '            }');
  BufLn(b, '            let mut i = 0usize;');
  BufLn(b, '            while buf[i] != 0u8 { out.push(buf[i] as char); i += 1; }');
  BufLn(b, '            return out;');
  BufLn(b, '        }');
  BufLn(b, '        let mut digits = String::new();');
  BufLn(b, '        let e;');
  BufLn(b, '        if a == 0.0 { digits.push(''0''); e = 0; } else { e = float_digits(a, is32, &mut digits); }');
  BufLn(b, '        let nd = digits.len() as i32;');
  BufLn(b, '        let db = digits.as_bytes();');
  BufLn(b, '        if debug && (e < -5 || e >= 16) {');
  BufLn(b, '            // notation scientifique');
  BufLn(b, '            out.push(db[0] as char);');
  BufLn(b, '            if nd > 1 {');
  BufLn(b, '                out.push(''.'');');
  BufLn(b, '                let mut i = 1usize;');
  BufLn(b, '                while (i as i32) < nd { out.push(db[i] as char); i += 1; }');
  BufLn(b, '            }');
  BufLn(b, '            out.push(''e'');');
  BufLn(b, '            let mut f = Formatter::new();');
