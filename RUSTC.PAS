procedure LowerStrEq(const a: TOperand; const b: TOperand; const dest: TPlace);
var
  args: TOperandArr;
  d: Integer;
begin
  SetLength(args, 2);
  args[0] := a;
  args[1] := b;
  MakeCall(StrEqFn, nil, args, dest, True, TyBoolT, 0);
end;

function SubPlaceField(const p: TPlace; idx, ty: Integer): TPlace;
begin
  Result := PProj(p, peField, idx, ty);
end;

procedure TestPat(p: Integer; const place: TPlace; failBB: Integer);
var
  k, i, nb, okBB, altOK, nextAlt, tag: Integer;
  pl, dl: TPlace;
  rv: TRvalue;
  c: TPlace;
  op: TOperand;
  ty, fty, vd: Integer;
  par: Integer;
  isEnum: Boolean;
  nfields: Integer;
  lenP: TPlace;
  n1, n2: Integer;
  elemTy: Integer;
  kind: Integer;
  t: TPlace;
  pty: Integer;
begin
  k := Pats[p].k;
  ty := Shallow(Pats[p].ty);
  case k of
    pkWild: ;
    pkBind:
      begin
        pl := PLocal(VarLoc[Pats[p].v], MirFns[BI].locals[VarLoc[Pats[p].v]].ty);
        case Pats[p].byRef of
          1: AssignOp(pl, RefOfPlace(place, False));
          2: AssignOp(pl, RefOfPlace(place, True));
        else
          AssignOp(pl, OCopyPlace(place));
        end;
        if Pats[p].a >= 0 then TestPat(Pats[p].a, place, failBB);
      end;
    pkLit:
      begin
        if Pats[p].m = 1 then
        begin
          { chaine : comparaison par appel }
          c := NewTemp(TyBoolT);
          op := EmptyOperand;
          op.k := opConst; op.ck := ckStr; op.s := Pats[p].s; op.ty := TyStrRef;
          LowerStrEq(OCopyPlace(place), op, c);
          nb := NewBB;
          TermSwitchBool(OCopyPlace(c), nb, failBB);
          CurBB := nb;
        end
        else if Pats[p].m = 2 then
        begin
          c := NewTemp(TyBoolT);
          rv := MkRv(rvBin, TyBoolT);
          rv.op := 'Eq';
          rv.a := OCopyPlace(place);
          rv.b := EmptyOperand;
          rv.b.k := opConst; rv.b.ck := ckFloat; rv.b.fv := Pats[p].fv; rv.b.ty := ty;
          EmitAssign(c, rv);
          nb := NewBB;
          TermSwitchBool(OCopyPlace(c), nb, failBB);
          CurBB := nb;
        end
        else if Pats[p].m = 3 then
        begin
          { octets : comparaison de tranches non geree }
        end
        else
        begin
          nb := NewBB;
          TermSwitchInt(OCopyPlace(place), Pats[p].n, nb, failBB);
          CurBB := nb;
        end;
      end;
    pkRange:
      begin
        if Pats[p].l[0] = 1 then
        begin
          c := NewTemp(TyBoolT);
          rv := MkRv(rvBin, TyBoolT);
          rv.op := 'Ge';
          rv.a := OCopyPlace(place);
          rv.b := OInt(ty, Pats[p].n);
          rv.srcTy := ty;
          if Tys[ty].k = tyChar then rv.b := OConst(ckChar, ty, Pats[p].n);
          EmitAssign(c, rv);
          nb := NewBB;
          TermSwitchBool(OCopyPlace(c), nb, failBB);
          CurBB := nb;
        end;
        if Pats[p].l[1] = 1 then
        begin
          c := NewTemp(TyBoolT);
          rv := MkRv(rvBin, TyBoolT);
          if Pats[p].incl then rv.op := 'Le' else rv.op := 'Lt';
          rv.a := OCopyPlace(place);
          rv.b := OInt(ty, Pats[p].m);
          rv.srcTy := ty;
          if Tys[ty].k = tyChar then rv.b := OConst(ckChar, ty, Pats[p].m);
          EmitAssign(c, rv);
          nb := NewBB;
          TermSwitchBool(OCopyPlace(c), nb, failBB);
          CurBB := nb;
        end;
      end;
    pkTuple:
      for i := 0 to Length(Pats[p].l) - 1 do
        TestPat(Pats[p].l[i], SubPlaceField(place, i, Pats[Pats[p].l[i]].ty), failBB);
    pkDeref:
      begin
        pl := PProj(place, peDeref, 0, Pats[Pats[p].a].ty);
        TestPat(Pats[p].a, pl, failBB);
      end;
    pkAdt:
      begin
        isEnum := Defs[Pats[p].def].kind = dkVariant;
        pl := place;
        if isEnum then
        begin
          par := Defs[Pats[p].def].parent;
          if Length(Defs[par].variants) > 1 then
          begin
            c := NewTemp(TyI64);
            rv := MkRv(rvDiscr, TyI64);
            rv.place := place;
            EmitAssign(c, rv);
            nb := NewBB;
            TermSwitchInt(OCopyPlace(c), VariantDisc(Pats[p].def), nb, failBB);
            CurBB := nb;
          end;
          pl := PProj(place, peDowncast, Pats[p].vidx, place.ty);
        end;
        for i := 0 to Length(Pats[p].l) - 1 do
        begin
          if Pats[Pats[p].l[i]].k = pkWild then Continue;
          TestPat(Pats[p].l[i], PProj(pl, peField, i, Pats[Pats[p].l[i]].ty), failBB);
        end;
      end;
    pkOr:
      begin
        altOK := NewBB;
        for i := 0 to Length(Pats[p].l) - 1 do
        begin
          if i < Length(Pats[p].l) - 1 then
          begin
            nextAlt := NewBB;
            TestPat(Pats[p].l[i], place, nextAlt);
            TermGotoIfOpen(altOK);
            CurBB := nextAlt;
          end
          else
          begin
            TestPat(Pats[p].l[i], place, failBB);
            TermGotoIfOpen(altOK);
          end;
        end;
        CurBB := altOK;
      end;
    pkSlice:
      begin
        { longueur }
        if Tys[Shallow(place.ty)].k = tyArray then
          op := OInt(TyUsize, Tys[Shallow(Tys[Shallow(place.ty)].args[1])].n)
        else
        begin
          lenP := NewTemp(TyUsize);
          rv := MkRv(rvLen, TyUsize);
          rv.place := place;
          EmitAssign(lenP, rv);
          op := OCopyPlace(lenP);
        end;
        n1 := Length(Pats[p].l);
        n2 := Length(Pats[p].l2);
        if Tys[Shallow(place.ty)].k <> tyArray then
        begin
          c := NewTemp(TyBoolT);
          rv := MkRv(rvBin, TyBoolT);
          if Pats[p].m = 1 then rv.op := 'Ge' else rv.op := 'Eq';
          rv.a := op;
          rv.b := OInt(TyUsize, n1 + n2);
          rv.srcTy := TyUsize;
          EmitAssign(c, rv);
          nb := NewBB;
          TermSwitchBool(OCopyPlace(c), nb, failBB);
          CurBB := nb;
        end;
        if Tys[Shallow(place.ty)].k = tyArray then elemTy := Tys[Shallow(place.ty)].args[0]
        else elemTy := Tys[Shallow(place.ty)].args[0];
        for i := 0 to n1 - 1 do
        begin
          pl := PProj(place, peConstIndex, i, elemTy);
          TestPat(Pats[p].l[i], pl, failBB);
        end;
        for i := 0 to n2 - 1 do
        begin
          pl := PProj(place, peConstIndex, n2 - i, elemTy);
          pl.elems[Length(pl.elems) - 1].m := 1;
          TestPat(Pats[p].l2[i], pl, failBB);
        end;
        if (Pats[p].a >= 0) and (Pats[Pats[p].a].k = pkBind) then
        begin
          { reste lie a une tranche : sous-tranche non geree pour les tableaux }
        end;
      end;
    pkConst: ;
  end;
end;

{ ---- conditions ---- }

procedure CondBranch(h: Integer; trueBB, falseBB: Integer);
var
  mid: Integer;
  op: TOperand;
  pl: TPlace;
  a: Integer;
begin
  case Hirs[h].k of
    hAnd:
      begin
        mid := NewBB;
        CondBranch(Hirs[h].a, mid, falseBB);
        CurBB := mid;
        CondBranch(Hirs[h].b, trueBB, falseBB);
      end;
    hOr:
      begin
        mid := NewBB;
        CondBranch(Hirs[h].a, trueBB, mid);
        CurBB := mid;
        CondBranch(Hirs[h].b, trueBB, falseBB);
      end;
    hLetCond:
      begin
        pl := HirPlaceOrTemp(Hirs[h].a);
        TestPat(Hirs[h].n, pl, falseBB);
        TermGotoIfOpen(trueBB);
      end;
    hUnary:
      if (Hirs[h].n = 2) and (Tys[Shallow(Hirs[h].ty)].k = tyBool) then
        CondBranch(Hirs[h].a, falseBB, trueBB)
      else
      begin
        op := ExprOp(h);
        TermSwitchBool(op, trueBB, falseBB);
      end;
    hLitBool:
      if Hirs[h].n <> 0 then TermGoto(trueBB) else TermGoto(falseBB);
  else
    op := ExprOp(h);
    TermSwitchBool(op, trueBB, falseBB);
  end;
end;

{ ---- expression vers une destination ---- }

function OperandOfLit(h: Integer): TOperand;
begin
  Result := EmptyOperand;
  Result.k := opConst;
  Result.ty := Hirs[h].ty;
  case Hirs[h].k of
    hLitInt: begin Result.ck := ckInt; Result.n := Hirs[h].n; end;
    hLitFloat: begin Result.ck := ckFloat; Result.fv := Hirs[h].fv; end;
    hLitBool: begin Result.ck := ckBool; Result.n := Hirs[h].n; end;
    hLitChar: begin Result.ck := ckChar; Result.n := Hirs[h].n; end;
    hLitStr: begin Result.ck := ckStr; Result.s := Hirs[h].s; end;
    hLitByteStr: begin Result.ck := ckByteStr; Result.s := Hirs[h].s; end;
  end;
end;

function IsConstHir(h: Integer): Boolean;
begin
  Result := Hirs[h].k in [hLitInt, hLitFloat, hLitBool, hLitChar, hLitStr, hLitByteStr, hFnRef];
end;

function ExprOp(h: Integer): TOperand;
var
  tmp: TPlace;
  ty: Integer;
begin
  ty := Hirs[h].ty;
  case Hirs[h].k of
    hLitInt, hLitFloat, hLitBool, hLitChar, hLitStr, hLitByteStr:
      Result := OperandOfLit(h);
    hFnRef:
      begin
        Result := EmptyOperand;
        Result.k := opConst;
        Result.ck := ckFnItem;
        Result.ty := ty;
        Result.def := Hirs[h].def;
        Result.targs := Hirs[h].targs;
      end;
    hLocal, hUpvar, hStatic, hField, hIndex, hDeref:
      Result := OCopyPlace(HirPlace(h));
    hTuple:
      if Length(Hirs[h].l) = 0 then Result := OUnit
      else
      begin
        tmp := NewTemp(ty);
        ExprInto(h, tmp);
        Result := OCopyPlace(tmp);
      end;
  else
    if Tys[Shallow(ty)].k = tyNever then
    begin
      tmp := NewTemp(TyUnit);
      ExprInto(h, tmp);
      Result := OUnit;
      Result.ty := ty;
    end
    else
    begin
      tmp := NewTemp(ty);
      ExprInto(h, tmp);
      Result := OCopyPlace(tmp);
    end;
  end;
end;

procedure ExprDiscard(h: Integer);
var
  tmp: TPlace;
begin
  case Hirs[h].k of
    hLocal, hUpvar, hStatic, hLitInt, hLitFloat, hLitBool, hLitChar, hLitStr: ;
  else
    tmp := NewTemp(Hirs[h].ty);
    ExprInto(h, tmp);
  end;
end;

procedure LowerLet(h: Integer);
var
  p, init, v, failBB, okBB: Integer;
  pl: TPlace;
  els: Integer;
begin
  p := Hirs[h].n;
  init := Hirs[h].a;
  els := Hirs[h].b;
  if init = 0 then Exit;
  if (Pats[p].k = pkBind) and (Pats[p].byRef = 0) and (Pats[p].a < 0) then
  begin
    ExprInto(init, PLocal(VarLoc[Pats[p].v], MirFns[BI].locals[VarLoc[Pats[p].v]].ty));
    Exit;
  end;
  pl := HirPlaceOrTemp(init);
  failBB := NewBB;
  TestPat(p, pl, failBB);
  okBB := NewBB;
  TermGotoIfOpen(okBB);
  CurBB := failBB;
  if els <> 0 then
  begin
    ExprDiscard(els);
    TermUnreachable;
  end
  else TermUnreachable;
  CurBB := okBB;
end;

procedure LowerMatch(h: Integer; const dest: TPlace);
var
  scrut: TPlace;
  i, arm, nextBB, doneBB, bodyBB, p, g: Integer;
begin
  scrut := HirPlaceOrTemp(Hirs[h].a);
  doneBB := NewBB;
  for i := 0 to Length(Hirs[h].l) - 1 do
  begin
    arm := Hirs[h].l[i];
    nextBB := NewBB;
    TestPat(Hirs[arm].n, scrut, nextBB);
    if Hirs[arm].a <> 0 then
    begin
      bodyBB := NewBB;
      CondBranch(Hirs[arm].a, bodyBB, nextBB);
      CurBB := bodyBB;
    end;
    ExprInto(Hirs[arm].b, dest);
    TermGotoIfOpen(doneBB);
    CurBB := nextBB;
  end;
  TermUnreachable;
  CurBB := doneBB;
end;

procedure EmitAggregate(const dest: TPlace; agk: Integer; def, vidx: Integer; const ops: TOperandArr; ty: Integer);
var
  rv: TRvalue;
begin
  rv := MkRv(rvAgg, ty);
  rv.agk := agk;
  rv.def := def;
  rv.vidx := vidx;
  rv.ops := ops;
  EmitAssign(dest, rv);
end;

function CastOperand(const o: TOperand; ty: Integer): TOperand;
var
  tmp: TPlace;
  rv: TRvalue;
begin
  tmp := NewTemp(ty);
  rv := MkRv(rvCast, ty);
  rv.a := o;
  rv.srcTy := o.ty;
  EmitAssign(tmp, rv);
  Result := OCopyPlace(tmp);
end;

procedure ExprInto(h: Integer; const dest: TPlace);
var
  ty, i, j, k, lp, brk, cont, th, el, jn, id, cid, fldIdx, nfld, bodyBB: Integer;
  a, b: TOperand;
  rv: TRvalue;
  tmp, pl, basePl: TPlace;
  ops: TOperandArr;
  op: string;
  args: TOperandArr;
  adt, def: Integer;
  st: Integer;
  rt: TTerm;
  cplace: TPlace;
  ft: Integer;
  isUnit: Boolean;
begin
  ty := Hirs[h].ty;
  case Hirs[h].k of
    hLitInt, hLitFloat, hLitBool, hLitChar, hLitStr, hLitByteStr, hFnRef:
      AssignOp(dest, ExprOp(h));
    hLocal, hUpvar, hStatic, hField, hIndex, hDeref:
      AssignOp(dest, OCopyPlace(HirPlace(h)));
    hConstVal:
      begin
        SetLength(args, 0);
        MakeCall(Hirs[h].def, Hirs[h].targs, args, dest, True, ty, h);
      end;
    hCall, hCallClosure:
      LowerCall(h, dest, True);
    hAddr:
      begin
        if (Hirs[h].n and 2) <> 0 then
        begin
          rv := MkRv(rvAddrOf, ty);
          rv.mut := Hirs[h].n = 3;
        end
        else
        begin
          rv := MkRv(rvRef, ty);
          rv.mut := Hirs[h].n = 1;
        end;
        rv.place := HirPlaceOrTemp(Hirs[h].a);
        EmitAssign(dest, rv);
      end;
    hCast:
      begin
        a := ExprOp(Hirs[h].a);
        rv := MkRv(rvCast, ty);
        rv.a := a;
        rv.srcTy := Hirs[Hirs[h].a].ty;
        EmitAssign(dest, rv);
      end;
    hCoerce:
      begin
        case Hirs[h].n of
          1:
            begin
              ExprDiscard(Hirs[h].a);
            end;
          4:
            begin
              { fonction -> pointeur de fonction }
              a := ExprOp(Hirs[h].a);
              if a.ck = ckFnItem then
              begin
                a.ck := ckFnPtr;
                a.ty := ty;
                AssignOp(dest, a);
              end
              else
              begin
                rv := MkRv(rvCast, ty);
                rv.a := a;
                rv.srcTy := Hirs[Hirs[h].a].ty;
                EmitAssign(dest, rv);
              end;
            end;
        else
          a := ExprOp(Hirs[h].a);
          rv := MkRv(rvCast, ty);
          rv.a := a;
          rv.srcTy := Hirs[Hirs[h].a].ty;
          rv.n := Hirs[h].n;
          EmitAssign(dest, rv);
        end;
      end;
    hUnary:
      begin
        a := ExprOp(Hirs[h].a);
        if Hirs[h].n = 1 then
        begin
          if Tys[Shallow(ty)].k = tyFloat then
          begin
            rv := MkRv(rvUn, ty);
            rv.op := 'Neg';
            rv.a := a;
            EmitAssign(dest, rv);
          end
          else if OvfChecks and ((Tys[Shallow(ty)].f and 1) <> 0) then
            EmitBinary('-', OInt(ty, 0), a, ty, dest, h)
          else
          begin
            rv := MkRv(rvUn, ty);
            rv.op := 'Neg';
            rv.a := a;
            EmitAssign(dest, rv);
          end;
        end
        else
        begin
          rv := MkRv(rvUn, ty);
          rv.op := 'Not';
          rv.a := a;
          EmitAssign(dest, rv);
        end;
      end;
    hBinary:
      begin
        a := ExprOp(Hirs[h].a);
        if (a.k <> opConst) and not IsPureHir(Hirs[h].b) then
        begin
          tmp := NewTemp(a.ty);
          AssignOp(tmp, a);
          a := OCopyPlace(tmp);
        end;
        b := ExprOp(Hirs[h].b);
        EmitBinary(Hirs[h].s, a, b, Hirs[Hirs[h].a].ty, dest, h);
      end;
    hAnd, hOr:
      begin
        th := NewBB; el := NewBB; jn := NewBB;
        CondBranch(h, th, el);
        CurBB := th;
        AssignOp(dest, OBool(True));
        TermGoto(jn);
        CurBB := el;
        AssignOp(dest, OBool(False));
        TermGoto(jn);
        CurBB := jn;
      end;
    hAssign:
      begin
        a := ExprOp(Hirs[h].b);
        if (a.k <> opConst) and (a.k <> 0) then
        begin
          tmp := NewTemp(a.ty);
          AssignOp(tmp, a);
          a := OCopyPlace(tmp);
        end;
        pl := HirPlace(Hirs[h].a);
        AssignOp(pl, a);
      end;
    hAssignOp:
      begin
        b := ExprOp(Hirs[h].b);
        if (b.k <> opConst) then
        begin
          tmp := NewTemp(b.ty);
          AssignOp(tmp, b);
          b := OCopyPlace(tmp);
        end;
        pl := HirPlace(Hirs[h].a);
        a := OCopyPlace(pl);
        if a.k = opMove then a.k := opCopy;
        EmitBinary(Hirs[h].s, a, b, Hirs[Hirs[h].a].ty, pl, h);
      end;
    hIf:
      begin
        th := NewBB; el := NewBB; jn := NewBB;
        CondBranch(Hirs[h].a, th, el);
        CurBB := th;
        ExprInto(Hirs[h].b, dest);
        TermGotoIfOpen(jn);
        CurBB := el;
        if Hirs[h].c <> 0 then ExprInto(Hirs[h].c, dest);
        TermGotoIfOpen(jn);
        CurBB := jn;
      end;
    hLoop:
      begin
        lp := NewBB;
        brk := NewBB;
        TermGoto(lp);
        CurBB := lp;
        if NLoops >= Length(LoopIds) then
        begin
          SetLength(LoopIds, NLoops * 2 + 8);
          SetLength(LoopBrk, NLoops * 2 + 8);
          SetLength(LoopCont, NLoops * 2 + 8);
          SetLength(LoopDest, NLoops * 2 + 8);
        end;
        LoopIds[NLoops] := Integer(Hirs[h].n);
        LoopBrk[NLoops] := brk;
        LoopCont[NLoops] := lp;
        LoopDest[NLoops] := dest;
        Inc(NLoops);
        tmp := NewTemp(TyUnit);
        ExprInto(Hirs[h].a, tmp);
        TermGotoIfOpen(lp);
        Dec(NLoops);
        CurBB := brk;
      end;
    hBlockLabel:
      begin
        brk := NewBB;
        if NLoops >= Length(LoopIds) then
        begin
          SetLength(LoopIds, NLoops * 2 + 8);
          SetLength(LoopBrk, NLoops * 2 + 8);
          SetLength(LoopCont, NLoops * 2 + 8);
          SetLength(LoopDest, NLoops * 2 + 8);
        end;
        LoopIds[NLoops] := Integer(Hirs[h].n);
        LoopBrk[NLoops] := brk;
        LoopCont[NLoops] := brk;
        LoopDest[NLoops] := dest;
        Inc(NLoops);
        ExprInto(Hirs[h].a, dest);
        TermGotoIfOpen(brk);
        Dec(NLoops);
        CurBB := brk;
      end;
    hBreak, hContinue:
      begin
        id := Integer(Hirs[h].n);
        k := -1;
        for i := NLoops - 1 downto 0 do
          if LoopIds[i] = id then begin k := i; Break; end;
        if k < 0 then Exit;
        if Hirs[h].k = hBreak then
        begin
          if Hirs[h].a <> 0 then ExprInto(Hirs[h].a, LoopDest[k]);
          TermGoto(LoopBrk[k]);
        end
        else TermGoto(LoopCont[k]);
      end;
    hReturn:
      begin
        if Hirs[h].a <> 0 then ExprInto(Hirs[h].a, PLocal(0, MirFns[BI].retTy));
        TermGoto(RetBB);
      end;
    hBlock:
      begin
        for i := 0 to Length(Hirs[h].l) - 1 do
        begin
          st := Hirs[h].l[i];
          if Hirs[st].k = hLet then LowerLet(st)
          else ExprDiscard(Hirs[st].a);
        end;
        if Hirs[h].a <> 0 then ExprInto(Hirs[h].a, dest);
      end;
    hLet: LowerLet(h);
    hExprStmt: ExprDiscard(Hirs[h].a);
    hMatch: LowerMatch(h, dest);
    hTuple:
      begin
        if Length(Hirs[h].l) = 0 then Exit;
        ops := EvalArgs(Hirs[h].l);
        EmitAggregate(dest, agTuple, 0, 0, ops, ty);
      end;
    hArray:
      begin
        ops := EvalArgs(Hirs[h].l);
        EmitAggregate(dest, agArray, 0, 0, ops, ty);
      end;
    hRepeat:
      begin
        rv := MkRv(rvRepeat, ty);
        rv.a := ExprOp(Hirs[h].a);
        rv.n := Hirs[h].n;
        EmitAssign(dest, rv);
      end;
    hAdt:
      begin
        def := Hirs[h].def;
        nfld := Length(Hirs[h].l);
        if Hirs[h].a <> 0 then
        begin
          { mise a jour fonctionnelle : champs manquants pris dans la base }
          basePl := HirPlaceOrTemp(Hirs[h].a);
          SetLength(ops, nfld);
          for i := 0 to nfld - 1 do
          begin
            if Hirs[h].l[i] <> 0 then ops[i] := ExprOp(Hirs[h].l[i])
            else
            begin
              ft := FieldTyOf(Shallow(ty), def, i);
              ops[i] := OCopyPlace(PProj(basePl, peField, i, ft));
            end;
          end;
        end
        else ops := EvalArgs(Hirs[h].l);
        EmitAggregate(dest, agAdt, def, Integer(Hirs[h].n), ops, ty);
      end;
    hClosure:
      begin
        cid := Integer(Hirs[h].n);
        SetLength(ops, Length(Hirs[h].l));
        for i := 0 to Length(Hirs[h].l) - 1 do
        begin
          pl := HirPlace(Hirs[h].l[i]);
          if Closures[cid].isMove then ops[i] := OCopyPlace(pl)
          else ops[i] := RefOfPlace(pl, True);
        end;
        EmitAggregate(dest, agClosure, cid, 0, ops, ty);
        RequestClosureInst(cid);
      end;
    hUnreachable:
      begin
        TermUnreachable;
      end;
  else
    AssignOp(dest, OUnit);
  end;
end;

{ ============================================================ }
{ MIR : construction d'une fonction complete                    }
{ ============================================================ }

function NewMirFn(const sym: string; def: Integer; const targs: TIntArr; retTy: Integer): Integer;
begin
  if NMirFns >= Length(MirFns) then SetLength(MirFns, NMirFns * 2 + 32);
  Result := NMirFns;
  Inc(NMirFns);
  MirFns[Result].def := def;
  MirFns[Result].targs := targs;
  MirFns[Result].sym := sym;
  MirFns[Result].name := sym;
  MirFns[Result].nlocals := 0;
  MirFns[Result].locals := nil;
  MirFns[Result].nblocks := 0;
  MirFns[Result].blocks := nil;
  MirFns[Result].nargs := 0;
  MirFns[Result].retTy := retTy;
  MirFns[Result].isClosure := False;
  MirFns[Result].isCtor := False;
  MirFns[Result].isStaticInit := False;
end;

procedure FinishMirFn;
var
  t: TTerm;
begin
  TermGotoIfOpen(RetBB);
  CurBB := RetBB;
  FillChar(t, SizeOf(t), 0);
  t.k := tmReturn;
  SetTerm(t);
end;

procedure BuildBodyMir(instIdx: Integer; b: Integer; cid: Integer);
var
  idx, i, v, l: Integer;
  ret: Integer;
  ty: Integer;
  isParam: array of Boolean;
begin
  if cid >= 0 then ret := Zonk(Closures[cid].ret) else ret := Zonk(Bodies[b].ret);
  idx := NewMirFn(Insts[instIdx].sym, Insts[instIdx].def, Insts[instIdx].targs, ret);
  Insts[instIdx].mir := idx;
  BI := idx;
  BBody := b;
  BClosure := cid;
  NLoops := 0;
  MirFns[idx].isClosure := cid >= 0;
  MirFns[idx].closure := cid;
  MirFns[idx].bodyIdx := b;
  l := NewLocal(ret, '', True);
  SetLength(VarLoc, Bodies[b].nvars);
  for i := 0 to Length(VarLoc) - 1 do VarLoc[i] := -1;
  if cid >= 0 then
  begin
    l := NewLocal(MkRef(MkClosureTy(cid), True), 'env', False);
    MirFns[idx].locals[l].isArg := True;
    Inc(MirFns[idx].nargs);
  end;
  for i := 0 to Length(Bodies[b].params) - 1 do
  begin
    v := Bodies[b].params[i];
    l := NewLocal(Zonk(Bodies[b].vars[v].ty), Bodies[b].vars[v].name, Bodies[b].vars[v].mut);
    MirFns[idx].locals[l].isArg := True;
    VarLoc[v] := l;
    Inc(MirFns[idx].nargs);
  end;
  for v := 0 to Bodies[b].nvars - 1 do
    if VarLoc[v] < 0 then
      VarLoc[v] := NewLocal(Zonk(Bodies[b].vars[v].ty), Bodies[b].vars[v].name, Bodies[b].vars[v].mut);
  CurBB := NewBB;
  RetBB := NewBB;
  ExprInto(Bodies[b].root, PLocal(0, ret));
  FinishMirFn;
end;

procedure BuildStaticInit(instIdx: Integer);
var
  def, b, idx, ty: Integer;
  dest: TPlace;
  l: Integer;
begin
  def := Insts[instIdx].def;
  b := CheckInstance(def, nil);
  if b < 0 then Exit;
  idx := NewMirFn(Insts[instIdx].sym, def, nil, TyUnit);
  Insts[instIdx].mir := idx;
  MirFns[idx].isStaticInit := True;
  BI := idx;
  BBody := b;
  BClosure := -1;
  NLoops := 0;
  SetLength(VarLoc, Bodies[b].nvars);
  l := NewLocal(TyUnit, '', True);
  for l := 0 to Bodies[b].nvars - 1 do
    VarLoc[l] := NewLocal(Zonk(Bodies[b].vars[l].ty), Bodies[b].vars[l].name, Bodies[b].vars[l].mut);
  CurBB := NewBB;
  RetBB := NewBB;
  ty := Zonk(Bodies[b].ret);
  dest := PLocal(0, ty);
  dest.glob := def;
  ExprInto(Bodies[b].root, dest);
  FinishMirFn;
end;

procedure BuildCtor(instIdx: Integer);
var
  def, idx, i, ret: Integer;
  params: TIntArr;
  ops: TOperandArr;
  l: Integer;
begin
  def := Insts[instIdx].def;
  FnDefSig(def, Insts[instIdx].targs, params, ret);
  ret := Zonk(ret);
  idx := NewMirFn(Insts[instIdx].sym, def, Insts[instIdx].targs, ret);
  Insts[instIdx].mir := idx;
  MirFns[idx].isCtor := True;
  BI := idx;
  BClosure := -1;
  NLoops := 0;
  SetLength(VarLoc, 0);
  l := NewLocal(ret, '', True);
  SetLength(ops, Length(params));
  for i := 0 to Length(params) - 1 do
  begin
    l := NewLocal(Zonk(params[i]), '', False);
    MirFns[idx].locals[l].isArg := True;
    Inc(MirFns[idx].nargs);
    ops[i] := OCopyPlace(PLocal(l, Zonk(params[i])));
  end;
  CurBB := NewBB;
  RetBB := NewBB;
  if Defs[def].kind = dkVariant then
    EmitAggregate(PLocal(0, ret), agAdt, def, Defs[def].vindex, ops, ret)
  else
    EmitAggregate(PLocal(0, ret), agAdt, def, 0, ops, ret);
  FinishMirFn;
end;

procedure BuildInst(i: Integer);
var
  b: Integer;
begin
  if Insts[i].built then Exit;
  Insts[i].built := True;
  if Insts[i].external then Exit;
  case Insts[i].kind of
    ikCtor: BuildCtor(i);
    ikStaticInit: BuildStaticInit(i);
    ikClosure:
      begin
        b := Closures[Insts[i].closure].bodyIdx;
        BuildBodyMir(i, b, Insts[i].closure);
      end;
  else
    b := CheckInstance(Insts[i].def, Insts[i].targs);
    if b >= 0 then BuildBodyMir(i, b, -1)
    else
      Report(True, '', 'internal error: no body for `' + Insts[i].sym + '`', -1, 0, 0, 0, '');
  end;
end;

{ ============================================================ }
{ DISPOSITION MEMOIRE DES TYPES (layout)                        }
{ ============================================================ }

Type
  TLayoutV = record
    offsets: array of Int64;
    ftys: TIntArr;
  end;

  TLayout = record
    done: Boolean;
    inProgress: Boolean;
    size: Int64;
    align: Int64;
    offsets: array of Int64;       { champs de struct / tuple / fermeture }
    ftys: TIntArr;                 { types des champs }
    tagSize: Integer;
    tagSigned: Boolean;
    vlay: array of TLayoutV;       { variantes d'enum }
  end;

Var
  Lays: array of TLayout;
  NLays: Integer;
  LayMap: THashSI;

function AlignUp(v, a: Int64): Int64;
begin
  if a <= 1 then Result := v else Result := ((v + a - 1) div a) * a;
end;

function IsUnsizedTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyStr) or (Tys[t].k = tySlice) or (Tys[t].k = tyDyn);
end;

function PointeeUnsized(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := ((Tys[t].k = tyRef) or (Tys[t].k = tyPtr)) and IsUnsizedTy(Tys[t].args[0]);
end;

{ Types des champs d'une structure ou d'une variante }
function AdtVariantFields(t: Integer; vdef: Integer): TIntArr;
var
  nd, i: Integer;
begin
  Result := nil;
  nd := Defs[vdef].node;
  for i := 0 to Length(Nodes[nd].l2) - 1 do
    IAdd(Result, Zonk(FieldTyOf(t, vdef, i)));
end;

function ClosureFieldTys(cid: Integer): TIntArr;
var
  i: Integer;
begin
  Result := nil;
  for i := 0 to Length(Closures[cid].capTys) - 1 do
    if Closures[cid].isMove then IAdd(Result, Closures[cid].capTys[i])
    else IAdd(Result, MkRef(Closures[cid].capTys[i], True));
end;

function LayoutOf(t: Integer): Integer; forward;

procedure LayStruct(idx: Integer; const ftys: TIntArr);
var
  i, l: Integer;
  off, al, sz: Int64;
begin
  off := 0;
  al := 1;
  SetLength(Lays[idx].offsets, Length(ftys));
  Lays[idx].ftys := ftys;
  for i := 0 to Length(ftys) - 1 do
  begin
    l := LayoutOf(ftys[i]);
    off := AlignUp(off, Lays[l].align);
    Lays[idx].offsets[i] := off;
    off := off + Lays[l].size;
    if Lays[l].align > al then al := Lays[l].align;
  end;
  Lays[idx].size := AlignUp(off, al);
  Lays[idx].align := al;
end;

function LayoutOf(t: Integer): Integer;
var
  key: Integer;
  tt, i, j, l, v, vd, par: Integer;
  mn, mx, off: Int64;
  al, sz, maxSz, tagSz: Int64;
  ftys: TIntArr;
  vl: TLayoutV;
begin
  t := Zonk(t);
  key := HFind(LayMap, IntToStr(t));
  if key >= 0 then begin Result := key; Exit; end;
  if NLays >= Length(Lays) then SetLength(Lays, NLays * 2 + 64);
  Result := NLays;
  Inc(NLays);
  HPut(LayMap, IntToStr(t), Result);
  Lays[Result].size := 0;
  Lays[Result].align := 1;
  Lays[Result].offsets := nil;
  Lays[Result].ftys := nil;
  Lays[Result].vlay := nil;
  Lays[Result].tagSize := 0;
  tt := t;
  case Tys[tt].k of
    tyBool: begin Lays[Result].size := 1; Lays[Result].align := 1; end;
    tyChar: begin Lays[Result].size := 4; Lays[Result].align := 4; end;
    tyInt:
      begin
        Lays[Result].size := Tys[tt].n div 8;
        Lays[Result].align := Lays[Result].size;
        if Lays[Result].align > 16 then Lays[Result].align := 16;
      end;
    tyFloat:
      begin
        Lays[Result].size := Tys[tt].n div 8;
        Lays[Result].align := Lays[Result].size;
      end;
    tyRef, tyPtr:
      begin
        if IsUnsizedTy(Tys[tt].args[0]) then
        begin
          Lays[Result].size := 16;
          Lays[Result].align := 8;
          SetLength(Lays[Result].offsets, 2);
          Lays[Result].offsets[0] := 0;
          Lays[Result].offsets[1] := 8;
        end
        else
        begin
          Lays[Result].size := 8;
          Lays[Result].align := 8;
        end;
      end;
    tyFnPtr:
      begin
        Lays[Result].size := 8;
        Lays[Result].align := 8;
      end;
    tyTuple:
      begin
        ftys := ICopy(Tys[tt].args);
        LayStruct(Result, ftys);
      end;
    tyArray:
      begin
        l := LayoutOf(Tys[tt].args[0]);
        if Tys[Shallow(Tys[tt].args[1])].k = tyConst then
          Lays[Result].size := Lays[l].size * Tys[Shallow(Tys[tt].args[1])].n
        else
          Lays[Result].size := 0;
        Lays[Result].align := Lays[l].align;
      end;
    tyClosure:
      begin
        ftys := ClosureFieldTys(Tys[tt].def);
        LayStruct(Result, ftys);
      end;
    tyAdt:
      begin
        if Defs[Tys[tt].def].kind = dkStruct then
        begin
          ftys := AdtVariantFields(tt, Tys[tt].def);
          LayStruct(Result, ftys);
        end
        else
        begin
          par := Tys[tt].def;
          if Length(Defs[par].variants) = 0 then
          begin
            Lays[Result].size := 0;
            Lays[Result].align := 1;
            Exit;
          end;
          mn := 0; mx := 0;
          for v := 0 to Length(Defs[par].variants) - 1 do
          begin
            vd := VariantDisc(Defs[par].variants[v]);
            if vd < mn then mn := vd;
            if vd > mx then mx := vd;
          end;
          if (mn >= -128) and (mx <= 127) then begin tagSz := 1; end
          else if (mn >= -32768) and (mx <= 32767) then tagSz := 2
          else if (mn >= -2147483648) and (mx <= 2147483647) then tagSz := 4
          else tagSz := 8;
          Lays[Result].tagSize := tagSz;
          Lays[Result].tagSigned := True;
          SetLength(Lays[Result].vlay, Length(Defs[par].variants));
          al := tagSz;
          maxSz := tagSz;
          for v := 0 to Length(Defs[par].variants) - 1 do
          begin
            ftys := AdtVariantFields(tt, Defs[par].variants[v]);
            Lays[Result].vlay[v].ftys := ftys;
            SetLength(Lays[Result].vlay[v].offsets, Length(ftys));
            off := tagSz;
            for i := 0 to Length(ftys) - 1 do
            begin
              l := LayoutOf(ftys[i]);
              off := AlignUp(off, Lays[l].align);
              Lays[Result].vlay[v].offsets[i] := off;
              off := off + Lays[l].size;
              if Lays[l].align > al then al := Lays[l].align;
            end;
            if off > maxSz then maxSz := off;
          end;
          Lays[Result].align := al;
          Lays[Result].size := AlignUp(maxSz, al);
        end;
      end;
    tyNever, tyFnDef, tyStr, tySlice, tyDyn, tyErr, tyConst, tyOpaque: ;
  end;
  Lays[Result].done := True;
end;

function TySize(t: Integer): Int64;
var
  l: Integer;
begin
  l := LayoutOf(t);
  Result := Lays[l].size;
end;

function TyAlign(t: Integer): Int64;
var
  l: Integer;
begin
  l := LayoutOf(t);
  Result := Lays[l].align;
end;

{ Le type est-il un scalaire LLVM (valeur dans un registre) ? }
function IsScalarTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyBool, tyChar, tyInt, tyFloat, tyFnPtr: Result := True;
    tyRef, tyPtr: Result := not IsUnsizedTy(Tys[t].args[0]);
  else
    Result := False;
  end;
end;

function IsZstTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyNever, tyFnDef: begin Result := True; Exit; end;
    tyStr, tySlice, tyDyn: begin Result := True; Exit; end;
  end;
  if IsScalarTy(t) then begin Result := False; Exit; end;
  Result := TySize(t) = 0;
end;

function LLScalar(t: Integer): string;
begin
  t := Shallow(t);
  case Tys[t].k of
    tyBool: Result := 'i8';
    tyChar: Result := 'i32';
    tyInt: Result := 'i' + IntToStr(Tys[t].n);
    tyFloat: if Tys[t].n = 32 then Result := 'float' else Result := 'double';
  else
    Result := 'ptr';
  end;
end;

function FieldOffsetOf(t: Integer; idx: Integer; vidx: Integer): Int64;
var
  l: Integer;
begin
  t := Shallow(t);
  l := LayoutOf(t);
  if (Tys[t].k = tyAdt) and (Defs[Tys[t].def].kind = dkEnum) then
  begin
    if vidx < 0 then vidx := 0;
    Result := Lays[l].vlay[vidx].offsets[idx];
  end
  else if (Tys[t].k = tyRef) or (Tys[t].k = tyPtr) then
    Result := Lays[l].offsets[idx]
  else
    Result := Lays[l].offsets[idx];
end;

function AlignOfTy(t: Integer): Int64;
begin
  Result := TyAlign(t);
  if Result < 1 then Result := 1;
end;

{ ============================================================ }
{ GENERATION DU CODE LLVM IR (1) : outils, places, operandes    }
{ ============================================================ }

Type
  TAddr = record
    ptr: string;
    meta: string;
    ty: Integer;
    vidx: Integer;
  end;

Var
  LL: TBuf;           { corps des fonctions }
  LLStrs: TBuf;       { constantes de chaines }
  LLGlobals: TBuf;    { variables statiques }
  LLDecls: TBuf;      { declarations externes }
  StrMap: THashSI;
  NStrs: Integer;
  DeclSet: THashSI;
  TmpN: Integer;
  LblN: Integer;
  LocAddr: TStrArr;
  CurFn: Integer;
  RetIsSret: Boolean;
  RetScalar: Boolean;
  TargetTriple: string;
  PanicConstInst, PanicBoundsInst: Integer;
  IntrinsicNeeded: THashSI;
  AllocaBuf: TBuf;
  ModBuf: TBuf;
  CurLabel: string;

function NewT: string;
begin
  Inc(TmpN);
  Result := '%t' + IntToStr(TmpN);
end;

function NewLbl(const pfx: string): string;
begin
  Inc(LblN);
  Result := pfx + IntToStr(LblN);
end;

procedure Emit(const s: string);
begin
  BufAdd(LL, '  ');
  BufAdd(LL, s);
  BufAdd(LL, #10);
end;

procedure EmitLabel(const s: string);
begin
  CurLabel := s;
  BufAdd(LL, s + ':'#10);
end;

function StaticTy(def: Integer): Integer;
var
  params: TIntArr;
  ret: Integer;
begin
  FnDefSig(def, nil, params, ret);
  Result := Zonk(ret);
end;

function GlobName(def: Integer): string;
begin
  if Defs[def].isExtern then Result := '@' + Defs[def].name
  else Result := '@"g.' + Defs[def].name + '.' + IntToStr(def) + '"';
end;

{ Chaine -> constante LLVM c"..." }
function LLEscape(const s: string): string;
var
  i: Integer;
  c: Integer;
begin
  Result := '';
  for i := 1 to Length(s) do
  begin
    c := Ord(s[i]);
    if (c >= 32) and (c < 127) and (c <> 34) and (c <> 92) then Result := Result + s[i]
    else Result := Result + '\' + HexByte(c);
  end;
end;

function StrConst(const s: string): string;
var
  id: Integer;
begin
  id := HFind(StrMap, s);
  if id < 0 then
  begin
    id := NStrs;
    Inc(NStrs);
    HPut(StrMap, s, id);
    BufAdd(LLStrs, '@str.' + IntToStr(id) + ' = private unnamed_addr constant [' + IntToStr(Length(s)) + ' x i8] c"' +
           LLEscape(s) + '", align 1'#10);
  end;
  Result := '@str.' + IntToStr(id);
end;

function DoubleHex(d: Double): string;
var
  q: Int64;
  v: Double;
begin
  v := d;
  Move(v, q, 8);
  Result := '0x' + HexStr(QWord(q), 16);
end;

function FloatConstStr(d: Double; bits: Integer): string;
var
  sg: Single;
  dd: Double;
begin
  if bits = 32 then
  begin
    sg := d;
    dd := sg;
    Result := DoubleHex(dd);
  end
  else Result := DoubleHex(d);
end;

function Gep(const base: string; off: Int64): string;
var
  t: string;
begin
  if off = 0 then begin Result := base; Exit; end;
  t := NewT;
  Emit(t + ' = getelementptr inbounds i8, ptr ' + base + ', i64 ' + IntToStr(off));
  Result := t;
end;

function LoadScalar(const addr: string; ty: Integer): string;
var
  t: string;
begin
  t := NewT;
  Emit(t + ' = load ' + LLScalar(ty) + ', ptr ' + addr + ', align ' + IntToStr(AlignOfTy(ty)));
  Result := t;
end;

procedure StoreScalar(const v: string; const addr: string; ty: Integer);
begin
  Emit('store ' + LLScalar(ty) + ' ' + v + ', ptr ' + addr + ', align ' + IntToStr(AlignOfTy(ty)));
end;

procedure NeedIntrinsic(const decl: string);
begin
  if HFind(IntrinsicNeeded, decl) < 0 then
  begin
    HPut(IntrinsicNeeded, decl, 1);
    BufAdd(LLDecls, decl + #10);
  end;
end;

procedure MemCopy(const dst, src: string; size: Int64; al: Int64);
begin
  if size <= 0 then Exit;
  NeedIntrinsic('declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ptr noalias nocapture readonly, i64, i1 immarg)');
  Emit('call void @llvm.memcpy.p0.p0.i64(ptr align ' + IntToStr(al) + ' ' + dst + ', ptr align ' + IntToStr(al) + ' ' + src +
       ', i64 ' + IntToStr(size) + ', i1 false)');
end;

function AllocaOf(ty: Integer): string;
var
  t: string;
  sz: Int64;
begin
  sz := TySize(ty);
  if sz < 1 then sz := 1;
  t := NewT;
  BufAdd(AllocaBuf, '  ' + t + ' = alloca [' + IntToStr(sz) + ' x i8], align ' + IntToStr(AlignOfTy(ty)) + #10);
  Result := t;
end;

{ ---- places ---- }

function LocalTy(l: Integer): Integer;
begin
  Result := MirFns[CurFn].locals[l].ty;
end;

function PlaceAddr(const p: TPlace): TAddr;
var
  cur, meta, t, idxv, off: string;
  curTy, i, vidx, ety: Integer;
  e: TPlaceElem;
  esz: Int64;
  pt: Integer;
  r: TAddr;
  lenv: string;
begin
  vidx := -1;
  meta := '';
  if p.glob >= 0 then
  begin
    cur := GlobName(p.glob);
    curTy := StaticTy(p.glob);
  end
  else
  begin
    cur := LocAddr[p.local];
    curTy := Zonk(LocalTy(p.local));
  end;
  for i := 0 to Length(p.elems) - 1 do
  begin
    e := p.elems[i];
    case e.k of
      peDeref:
        begin
          pt := Shallow(curTy);
          if IsUnsizedTy(Tys[pt].args[0]) then
          begin
            t := NewT;
            Emit(t + ' = load ptr, ptr ' + cur + ', align 8');
            off := Gep(cur, 8);
            meta := NewT;
            Emit(meta + ' = load i64, ptr ' + off + ', align 8');
            cur := t;
          end
          else
          begin
            t := NewT;
            Emit(t + ' = load ptr, ptr ' + cur + ', align 8');
            cur := t;
            meta := '';
          end;
          curTy := Zonk(e.ty);
          vidx := -1;
        end;
      peDowncast:
        vidx := e.n;
      peField:
        begin
          cur := Gep(cur, FieldOffsetOf(curTy, e.n, vidx));
          curTy := Zonk(e.ty);
          vidx := -1;
        end;
      peIndex:
        begin
          ety := Zonk(e.ty);
          esz := TySize(ety);
          idxv := LoadScalar(LocAddr[e.n], TyUsize);
          if esz = 1 then off := idxv
          else
          begin
            off := NewT;
            Emit(off + ' = mul i64 ' + idxv + ', ' + IntToStr(esz));
          end;
          t := NewT;
          Emit(t + ' = getelementptr inbounds i8, ptr ' + cur + ', i64 ' + off);
          cur := t;
          curTy := ety;
          meta := '';
        end;
      peConstIndex:
        begin
          ety := Zonk(e.ty);
          esz := TySize(ety);
          if e.m = 0 then cur := Gep(cur, esz * e.n)
          else
          begin
            if Tys[Shallow(curTy)].k = tyArray then
              cur := Gep(cur, esz * (Tys[Shallow(Tys[Shallow(curTy)].args[1])].n - e.n))
            else
            begin
              off := NewT;
              Emit(off + ' = sub i64 ' + meta + ', ' + IntToStr(e.n));
              idxv := NewT;
              Emit(idxv + ' = mul i64 ' + off + ', ' + IntToStr(esz));
              t := NewT;
              Emit(t + ' = getelementptr inbounds i8, ptr ' + cur + ', i64 ' + idxv);
              cur := t;
            end;
          end;
          curTy := ety;
          meta := '';
        end;
    end;
  end;
  r.ptr := cur;
  r.meta := meta;
  r.ty := curTy;
  r.vidx := vidx;
  Result := r;
end;

{ ---- operandes ---- }

function ConstScalarStr(const o: TOperand): string;
begin
  case o.ck of
    ckInt, ckChar, ckBool: Result := IntToStr(o.n);
    ckFloat: Result := FloatConstStr(o.fv, Tys[Shallow(o.ty)].n);
    ckNull: Result := 'null';
    ckFnPtr: Result := '@"' + o.s + '"';
    ckStatic: Result := GlobName(o.def);
    ckByteStr: Result := StrConst(o.s);
    ckUndef: Result := 'undef';
  else
    Result := '0';
  end;
  if (o.ck = ckInt) and (Tys[Shallow(o.ty)].k = tyInt) and (Tys[Shallow(o.ty)].n < 64) and (o.n < 0) then ;
end;

{ valeur scalaire d'un operande }
function OperandScalar(const o: TOperand): string;
var
  a: TAddr;
begin
  if o.k = opConst then
  begin
    if (o.ck = ckInt) and (Tys[Shallow(o.ty)].k = tyFloat) then
      Result := FloatConstStr(o.n, Tys[Shallow(o.ty)].n)
    else if (o.ck = ckInt) and (Tys[Shallow(o.ty)].k = tyInt) and ((o.n < 0)) then
      Result := IntToStr(o.n)
    else if (o.ck = ckInt) and (Tys[Shallow(o.ty)].k = tyInt) and (Tys[Shallow(o.ty)].n = 64) and ((Tys[Shallow(o.ty)].f and 1) = 0) then
      Result := UIntToStr(QWord(o.n))
    else
      Result := ConstScalarStr(o);
    Exit;
  end;
  a := PlaceAddr(o.place);
  Result := LoadScalar(a.ptr, Zonk(o.ty));
end;

{ adresse d'un operande de type memoire (copie si necessaire) }
function OperandAddr(const o: TOperand; forceCopy: Boolean): string;
var
  a: TAddr;
  tmp, p2: string;
  ty: Integer;
begin
  ty := Zonk(o.ty);
  if o.k = opConst then
  begin
    tmp := AllocaOf(ty);
    if o.ck = ckStr then
    begin
      Emit('store ptr ' + StrConst(o.s) + ', ptr ' + tmp + ', align 8');
      p2 := Gep(tmp, 8);
      Emit('store i64 ' + IntToStr(Length(o.s)) + ', ptr ' + p2 + ', align 8');
    end;
    Result := tmp;
    Exit;
  end;
  a := PlaceAddr(o.place);
  if forceCopy and (o.k = opCopy) then
  begin
    tmp := AllocaOf(ty);
    MemCopy(tmp, a.ptr, TySize(ty), AlignOfTy(ty));
    Result := tmp;
  end
  else Result := a.ptr;
end;

{ ecrit un operande a l'adresse dst }
procedure StoreOperand(const o: TOperand; const dst: string; ty: Integer);
var
  a: TAddr;
  v, p2: string;
begin
  ty := Zonk(ty);
  if IsZstTy(ty) then
  begin
    { evaluer l'operande pour ses effets : aucun }
    Exit;
  end;
  if IsScalarTy(ty) then
  begin
    v := OperandScalar(o);
    StoreScalar(v, dst, ty);
    Exit;
  end;
  if o.k = opConst then
  begin
    if o.ck = ckStr then
    begin
      Emit('store ptr ' + StrConst(o.s) + ', ptr ' + dst + ', align 8');
      p2 := Gep(dst, 8);
      Emit('store i64 ' + IntToStr(Length(o.s)) + ', ptr ' + p2 + ', align 8');
    end;
    Exit;
  end;
  a := PlaceAddr(o.place);
  MemCopy(dst, a.ptr, TySize(ty), AlignOfTy(ty));
end;

{ ============================================================ }
{ GENERATION DU CODE LLVM IR (2) : valeurs de droite, appels     }
{ ============================================================ }

function IsSignedTy(t: Integer): Boolean;
begin
  t := Shallow(t);
  Result := (Tys[t].k = tyInt) and ((Tys[t].f and 1) <> 0);
end;

function CmpPred(const op: string; ty: Integer): string;
var
  t: Integer;
  sgn: Boolean;
  isF: Boolean;
begin
  t := Shallow(ty);
  isF := Tys[t].k = tyFloat;
  sgn := IsSignedTy(t);
  if isF then
  begin
    if op = 'Eq' then Result := 'oeq'
    else if op = 'Ne' then Result := 'une'
    else if op = 'Lt' then Result := 'olt'
    else if op = 'Le' then Result := 'ole'
    else if op = 'Gt' then Result := 'ogt'
    else Result := 'oge';
    Exit;
  end;
  if op = 'Eq' then Result := 'eq'
  else if op = 'Ne' then Result := 'ne'
  else if op = 'Lt' then begin if sgn then Result := 'slt' else Result := 'ult'; end
  else if op = 'Le' then begin if sgn then Result := 'sle' else Result := 'ule'; end
  else if op = 'Gt' then begin if sgn then Result := 'sgt' else Result := 'ugt'; end
  else begin if sgn then Result := 'sge' else Result := 'uge'; end;
end;

function IsCmpOp(const op: string): Boolean;
begin
  Result := (op = 'Eq') or (op = 'Ne') or (op = 'Lt') or (op = 'Le') or (op = 'Gt') or (op = 'Ge');
end;

function ZextTo(const v: string; fromBits: Integer; toBits: Integer; sgn: Boolean): string;
var
  t: string;
begin
  if fromBits = toBits then begin Result := v; Exit; end;
  t := NewT;
  if toBits < fromBits then Emit(t + ' = trunc i' + IntToStr(fromBits) + ' ' + v + ' to i' + IntToStr(toBits))
  else if sgn then Emit(t + ' = sext i' + IntToStr(fromBits) + ' ' + v + ' to i' + IntToStr(toBits))
  else Emit(t + ' = zext i' + IntToStr(fromBits) + ' ' + v + ' to i' + IntToStr(toBits));
  Result := t;
end;

function ScalarBits(ty: Integer): Integer;
begin
  ty := Shallow(ty);
  case Tys[ty].k of
    tyBool: Result := 8;
    tyChar: Result := 32;
    tyInt: Result := Tys[ty].n;
    tyFloat: Result := Tys[ty].n;
  else
    Result := 64;
  end;
end;

{ operation binaire sur scalaires ; retourne la valeur ; resTy recoit le type LLVM du resultat }
function EmitBinOp(const op: string; const a, b: TOperand; opTy: Integer; var resLL: string): string;
var
  va, vb, t, opc, ll: string;
  tt: Integer;
  isF, sgn: Boolean;
  bits, bbits: Integer;
begin
  tt := Shallow(opTy);
  va := OperandScalar(a);
  vb := OperandScalar(b);
  isF := Tys[tt].k = tyFloat;
  sgn := IsSignedTy(tt);
  ll := LLScalar(tt);
  t := NewT;
  if IsCmpOp(op) then
  begin
    if isF then Emit(t + ' = fcmp ' + CmpPred(op, tt) + ' ' + ll + ' ' + va + ', ' + vb)
    else Emit(t + ' = icmp ' + CmpPred(op, tt) + ' ' + ll + ' ' + va + ', ' + vb);
    Result := t;
    resLL := 'i1';
    Exit;
  end;
  resLL := ll;
  if isF then
  begin
    if op = 'Add' then opc := 'fadd'
    else if op = 'Sub' then opc := 'fsub'
    else if op = 'Mul' then opc := 'fmul'
    else if op = 'Div' then opc := 'fdiv'
    else opc := 'frem';
    Emit(t + ' = ' + opc + ' ' + ll + ' ' + va + ', ' + vb);
    Result := t;
    Exit;
  end;
  if op = 'Add' then opc := 'add'
  else if op = 'Sub' then opc := 'sub'
  else if op = 'Mul' then opc := 'mul'
  else if op = 'Div' then begin if sgn then opc := 'sdiv' else opc := 'udiv'; end
  else if op = 'Rem' then begin if sgn then opc := 'srem' else opc := 'urem'; end
  else if op = 'BitAnd' then opc := 'and'
  else if op = 'BitOr' then opc := 'or'
  else if op = 'BitXor' then opc := 'xor'
  else if op = 'Shl' then opc := 'shl'
  else begin if sgn then opc := 'ashr' else opc := 'lshr'; end;
  if (op = 'Shl') or (op = 'Shr') then
  begin
    { la quantite de decalage doit avoir le meme type }
    bits := ScalarBits(tt);
    bbits := ScalarBits(b.ty);
    vb := ZextTo(vb, bbits, bits, IsSignedTy(b.ty));
  end;
  Emit(t + ' = ' + opc + ' ' + ll + ' ' + va + ', ' + vb);
  Result := t;
end;

function CheckedIntrinsic(const op: string; ty: Integer): string;
var
  tt: Integer;
  nm, ll: string;
begin
  tt := Shallow(ty);
  ll := LLScalar(tt);
  if IsSignedTy(tt) then nm := 's' else nm := 'u';
  if op = 'Add' then nm := nm + 'add'
  else if op = 'Sub' then nm := nm + 'sub'
  else nm := nm + 'mul';
  NeedIntrinsic('declare {' + ll + ', i1} @llvm.' + nm + '.with.overflow.' + ll + '(' + ll + ', ' + ll + ')');
  Result := 'llvm.' + nm + '.with.overflow.' + ll;
end;

procedure StoreI1AsBool(const v: string; const addr: string);
var
  t: string;
begin
  t := NewT;
  Emit(t + ' = zext i1 ' + v + ' to i8');
  Emit('store i8 ' + t + ', ptr ' + addr + ', align 1');
end;

{ conversion de type : a (operande) de type src vers dst, ecrit a l'adresse dstAddr }
procedure EmitCast(const a: TOperand; src, dst: Integer; const dstAddr: string);
var
  s, d: Integer;
  v, t, t2, p2, ls, ld: string;
  sb, db: Integer;
  sgn: Boolean;
  addr: string;
  pa: TAddr;
  lay: Integer;
  tagLL: string;
  tagSz: Integer;
begin
  s := Shallow(src);
  d := Shallow(dst);
  { entier / flottant / bool / char -> entier / flottant }
  if (Tys[d].k = tyInt) or (Tys[d].k = tyFloat) or (Tys[d].k = tyChar) or (Tys[d].k = tyBool) then
  begin
    if (Tys[s].k = tyAdt) and (Defs[Tys[s].def].kind = dkEnum) then
    begin
      { enum -> entier : lecture de la discrimination }
      pa := PlaceAddr(a.place);
      lay := LayoutOf(s);
      tagSz := Lays[lay].tagSize;
      tagLL := 'i' + IntToStr(tagSz * 8);
      t := NewT;
      Emit(t + ' = load ' + tagLL + ', ptr ' + pa.ptr + ', align ' + IntToStr(tagSz));
      db := ScalarBits(d);
      v := ZextTo(t, tagSz * 8, db, True);
      Emit('store ' + LLScalar(d) + ' ' + v + ', ptr ' + dstAddr + ', align ' + IntToStr(AlignOfTy(d)));
      Exit;
    end;
    v := OperandScalar(a);
    if ((Tys[s].k = tyPtr) or (Tys[s].k = tyRef) or (Tys[s].k = tyFnPtr)) and (Tys[d].k = tyInt) then
    begin
      t := NewT;
      Emit(t + ' = ptrtoint ptr ' + v + ' to i64');
      v := ZextTo(t, 64, Tys[d].n, False);
      StoreScalar(v, dstAddr, d);
      Exit;
    end;
    if Tys[s].k = tyFnDef then
    begin
      Exit;
    end;
    sb := ScalarBits(s);
    db := ScalarBits(d);
    ls := LLScalar(s);
    ld := LLScalar(d);
    if (Tys[s].k = tyFloat) and (Tys[d].k = tyFloat) then
    begin
      if sb = db then t := v
      else
      begin
        t := NewT;
        if db > sb then Emit(t + ' = fpext ' + ls + ' ' + v + ' to ' + ld)
        else Emit(t + ' = fptrunc ' + ls + ' ' + v + ' to ' + ld);
      end;
      StoreScalar(t, dstAddr, d);
      Exit;
    end;
    if Tys[s].k = tyFloat then
    begin
      { flottant -> entier avec saturation }
      t := NewT;
      if IsSignedTy(d) then
      begin
        NeedIntrinsic('declare ' + ld + ' @llvm.fptosi.sat.' + ld + '.' + ls + '(' + ls + ')');
        Emit(t + ' = call ' + ld + ' @llvm.fptosi.sat.' + ld + '.' + ls + '(' + ls + ' ' + v + ')');
      end
      else
      begin
        NeedIntrinsic('declare ' + ld + ' @llvm.fptoui.sat.' + ld + '.' + ls + '(' + ls + ')');
        Emit(t + ' = call ' + ld + ' @llvm.fptoui.sat.' + ld + '.' + ls + '(' + ls + ' ' + v + ')');
      end;
      StoreScalar(t, dstAddr, d);
      Exit;
    end;
    if Tys[d].k = tyFloat then
    begin
      t := NewT;
      if IsSignedTy(s) then Emit(t + ' = sitofp ' + ls + ' ' + v + ' to ' + ld)
      else Emit(t + ' = uitofp ' + ls + ' ' + v + ' to ' + ld);
      StoreScalar(t, dstAddr, d);
      Exit;
    end;
    { entier -> entier }
    sgn := IsSignedTy(s);
    t := ZextTo(v, sb, db, sgn);
    StoreScalar(t, dstAddr, d);
    Exit;
  end;
  { vers un pointeur ou une reference }
  if (Tys[d].k = tyPtr) or (Tys[d].k = tyRef) then
  begin
    if (Tys[s].k = tyInt) then
    begin
      v := OperandScalar(a);
      t := ZextTo(v, ScalarBits(s), 64, IsSignedTy(s));
      t2 := NewT;
      Emit(t2 + ' = inttoptr i64 ' + t + ' to ptr');
      StoreScalar(t2, dstAddr, d);
      Exit;
    end;
    if (Tys[s].k = tyFnDef) then
    begin
      Exit;
    end;
    if IsScalarTy(d) then
    begin
      if IsScalarTy(s) then
      begin
        v := OperandScalar(a);
        StoreScalar(v, dstAddr, d);
      end
      else
      begin
        { fat -> thin : on garde le pointeur }
        pa.ptr := OperandAddr(a, False);
        t := NewT;
        Emit(t + ' = load ptr, ptr ' + pa.ptr + ', align 8');
        StoreScalar(t, dstAddr, d);
      end;
      Exit;
    end;
    { destination fat : source fat ou dimensionnement }
    if IsScalarTy(s) then
    begin
      { &[T;N] -> &[T] : longueur connue }
      v := OperandScalar(a);
      Emit('store ptr ' + v + ', ptr ' + dstAddr + ', align 8');
      p2 := Gep(dstAddr, 8);
      if (Tys[Shallow(Tys[s].args[0])].k = tyArray) and (Tys[Shallow(Tys[d].args[0])].k = tySlice) then
        Emit('store i64 ' + IntToStr(Tys[Shallow(Tys[Shallow(Tys[s].args[0])].args[1])].n) + ', ptr ' + p2 + ', align 8')
      else
        Emit('store i64 0, ptr ' + p2 + ', align 8');
    end
    else
    begin
      addr := OperandAddr(a, False);
      MemCopy(dstAddr, addr, 16, 8);
    end;
    Exit;
  end;
  { cas general : copie }
  StoreOperand(a, dstAddr, dst);
end;

procedure EmitRepeat(const dstAddr: string; const elem: TOperand; ety: Integer; n: Int64);
var
  i: Int64;
  p, cnt, lh, lb, le, c, ip, nx: string;
  esz: Int64;
  v: string;
begin
  esz := TySize(ety);
  if n = 0 then Exit;
  if (n <= 8) or IsZstTy(ety) then
  begin
    for i := 0 to n - 1 do
      StoreOperand(elem, Gep(dstAddr, i * esz), ety);
    Exit;
  end;
  { boucle }
  if IsScalarTy(ety) then v := OperandScalar(elem) else v := '';
  cnt := NewT;
  BufAdd(AllocaBuf, '  ' + cnt + ' = alloca i64, align 8'#10);
  Emit('store i64 0, ptr ' + cnt + ', align 8');
  lh := NewLbl('rep.head');
  lb := NewLbl('rep.body');
  le := NewLbl('rep.end');
  Emit('br label %' + lh);
  EmitLabel(lh);
  ip := NewT;
  Emit(ip + ' = load i64, ptr ' + cnt + ', align 8');
  c := NewT;
  Emit(c + ' = icmp ult i64 ' + ip + ', ' + IntToStr(n));
  Emit('br i1 ' + c + ', label %' + lb + ', label %' + le);
  EmitLabel(lb);
  p := NewT;
  nx := NewT;
  Emit(nx + ' = mul i64 ' + ip + ', ' + IntToStr(esz));
  Emit(p + ' = getelementptr inbounds i8, ptr ' + dstAddr + ', i64 ' + nx);
  if IsScalarTy(ety) then StoreScalar(v, p, ety)
  else StoreOperand(elem, p, ety);
  nx := NewT;
  Emit(nx + ' = add i64 ' + ip + ', 1');
  Emit('store i64 ' + nx + ', ptr ' + cnt + ', align 8');
  Emit('br label %' + lh);
  EmitLabel(le);
end;

procedure EmitAggregateStore(const rv: TRvalue; const dstAddr: string; dty: Integer);
var
  i, lay, vidx: Integer;
  ftys: TIntArr;
  off: Int64;
  d: Integer;
  tagLL: string;
  tagSz: Integer;
  ety: Integer;
begin
  d := Shallow(dty);
  case rv.agk of
    agTuple, agClosure:
      begin
        lay := LayoutOf(d);
        for i := 0 to Length(rv.ops) - 1 do
          StoreOperand(rv.ops[i], Gep(dstAddr, Lays[lay].offsets[i]), Lays[lay].ftys[i]);
      end;
    agArray:
      begin
        ety := Zonk(Tys[d].args[0]);
        for i := 0 to Length(rv.ops) - 1 do
          StoreOperand(rv.ops[i], Gep(dstAddr, TySize(ety) * i), ety);
      end;
    agAdt:
      begin
        lay := LayoutOf(d);
        if Defs[rv.def].kind = dkStruct then
        begin
          for i := 0 to Length(rv.ops) - 1 do
            StoreOperand(rv.ops[i], Gep(dstAddr, Lays[lay].offsets[i]), Lays[lay].ftys[i]);
        end
        else
        begin
          vidx := rv.vidx;
          tagSz := Lays[lay].tagSize;
          tagLL := 'i' + IntToStr(tagSz * 8);
          Emit('store ' + tagLL + ' ' + IntToStr(VariantDisc(rv.def)) + ', ptr ' + dstAddr + ', align ' + IntToStr(tagSz));
          for i := 0 to Length(rv.ops) - 1 do
            StoreOperand(rv.ops[i], Gep(dstAddr, Lays[lay].vlay[vidx].offsets[i]), Lays[lay].vlay[vidx].ftys[i]);
        end;
      end;
  end;
end;

procedure EmitAssignStmt(const st: TStmt);
var
  rv: TRvalue;
  da, sa: TAddr;
  dty, i: Integer;
  v, t, res, resLL, ll, p2, f0: string;
  tupTy: Integer;
  lay: Integer;
  bits: Integer;
  tagSz: Integer;
  aty: Integer;
  e2: string;
begin
  rv := st.rv;
  dty := Zonk(st.place.ty);
  da := PlaceAddr(st.place);
  case rv.k of
    rvUse: StoreOperand(rv.a, da.ptr, dty);
    rvRef, rvAddrOf:
      begin
        sa := PlaceAddr(rv.place);
        if IsScalarTy(dty) then
          StoreScalar(sa.ptr, da.ptr, dty)
        else
        begin
          Emit('store ptr ' + sa.ptr + ', ptr ' + da.ptr + ', align 8');
          p2 := Gep(da.ptr, 8);
          if sa.meta <> '' then Emit('store i64 ' + sa.meta + ', ptr ' + p2 + ', align 8')
          else Emit('store i64 0, ptr ' + p2 + ', align 8');
        end;
      end;
    rvBin:
      begin
        aty := Zonk(rv.srcTy);
        if aty = 0 then aty := Zonk(rv.a.ty);
        res := EmitBinOp(rv.op, rv.a, rv.b, aty, resLL);
        if resLL = 'i1' then StoreI1AsBool(res, da.ptr)
        else StoreScalar(res, da.ptr, dty);
      end;
    rvCheckedBin:
      begin
        aty := Zonk(rv.a.ty);
        ll := LLScalar(aty);
        t := NewT;
        Emit(t + ' = call {' + ll + ', i1} @' + CheckedIntrinsic(rv.op, aty) + '(' + ll + ' ' + OperandScalar(rv.a) + ', ' + ll + ' ' +
             OperandScalar(rv.b) + ')');
        f0 := NewT;
        Emit(f0 + ' = extractvalue {' + ll + ', i1} ' + t + ', 0');
        res := NewT;
        Emit(res + ' = extractvalue {' + ll + ', i1} ' + t + ', 1');
        lay := LayoutOf(dty);
        Emit('store ' + ll + ' ' + f0 + ', ptr ' + Gep(da.ptr, Lays[lay].offsets[0]) + ', align ' + IntToStr(AlignOfTy(aty)));
        StoreI1AsBool(res, Gep(da.ptr, Lays[lay].offsets[1]));
      end;
    rvUn:
      begin
        aty := Zonk(rv.a.ty);
        v := OperandScalar(rv.a);
        ll := LLScalar(aty);
        t := NewT;
        if rv.op = 'Neg' then
        begin
          if Tys[Shallow(aty)].k = tyFloat then Emit(t + ' = fneg ' + ll + ' ' + v)
          else Emit(t + ' = sub ' + ll + ' 0, ' + v);
        end
        else
        begin
          if Tys[Shallow(aty)].k = tyBool then Emit(t + ' = xor i8 ' + v + ', 1')
          else Emit(t + ' = xor ' + ll + ' ' + v + ', -1');
        end;
        StoreScalar(t, da.ptr, dty);
      end;
    rvCast:
      EmitCast(rv.a, Zonk(rv.a.ty), dty, da.ptr);
    rvAgg:
      EmitAggregateStore(rv, da.ptr, dty);
    rvDiscr:
      begin
        sa := PlaceAddr(rv.place);
        lay := LayoutOf(sa.ty);
        tagSz := Lays[lay].tagSize;
        t := NewT;
        Emit(t + ' = load i' + IntToStr(tagSz * 8) + ', ptr ' + sa.ptr + ', align ' + IntToStr(tagSz));
        v := ZextTo(t, tagSz * 8, 64, True);
        Emit('store i64 ' + v + ', ptr ' + da.ptr + ', align 8');
      end;
    rvLen:
      begin
        sa := PlaceAddr(rv.place);
        if sa.meta <> '' then Emit('store i64 ' + sa.meta + ', ptr ' + da.ptr + ', align 8')
        else Emit('store i64 ' + IntToStr(Tys[Shallow(Tys[Shallow(sa.ty)].args[1])].n) + ', ptr ' + da.ptr + ', align 8');
      end;
    rvRepeat:
      begin
        aty := Zonk(Tys[Shallow(dty)].args[0]);
        EmitRepeat(da.ptr, rv.a, aty, rv.n);
      end;
    rvSizeOf:
      Emit('store i64 ' + IntToStr(TySize(rv.srcTy)) + ', ptr ' + da.ptr + ', align 8');
  end;
end;

{ ============================================================ }
{ GENERATION DU CODE LLVM IR (3) : appels, terminateurs,         }
{ fonctions et module                                           }
{ ============================================================ }

function RetKindOf(ty: Integer): Integer;
begin
  ty := Zonk(ty);
  if Tys[Shallow(ty)].k = tyNever then Result := 0
  else if IsZstTy(ty) then Result := 0
  else if IsScalarTy(ty) then Result := 1
  else Result := 2;
end;

function ParamLL(ty: Integer): string;
begin
  if IsScalarTy(ty) then Result := LLScalar(ty) else Result := 'ptr';
end;

function LLDisplayName(const sym: string): string;
begin
  Result := '@"' + sym + '"';
end;

{ Chaine de type de fonction pour appel indirect }
function FnPtrSig(ft: Integer): string;
var
  i: Integer;
  ret: Integer;
  s: string;
begin
  ft := Shallow(ft);
  ret := Zonk(Tys[ft].args[Length(Tys[ft].args) - 1]);
  s := '';
  if RetKindOf(ret) = 2 then s := 'ptr';
  for i := 0 to Length(Tys[ft].args) - 2 do
  begin
    if IsZstTy(Tys[ft].args[i]) then Continue;
    if s <> '' then s := s + ', ';
    s := s + ParamLL(Tys[ft].args[i]);
  end;
  if RetKindOf(ret) = 1 then Result := LLScalar(ret) + ' (' + s + ')'
  else Result := 'void (' + s + ')';
end;

procedure EmitIntrinsicCall(const t: TTerm);
var
  nm: string;
  ty0, ty1: Integer;
  da: TAddr;
  v, v2, v3, ll, ll1, r, dstp, tmp, srcp, p, nbytes: string;
  esz: Int64;
  i: Integer;
  ls, fn: string;
  tag: Integer;
  a: TAddr;
begin
  nm := t.sym;
  ty0 := 0; ty1 := 0;
  if Length(t.targs) > 0 then ty0 := Zonk(t.targs[0]);
  if Length(t.targs) > 1 then ty1 := Zonk(t.targs[1]);
  if t.hasDest then da := PlaceAddr(t.dest);
  if nm = 'size_of' then
  begin
    Emit('store i64 ' + IntToStr(TySize(ty0)) + ', ptr ' + da.ptr + ', align 8');
    Exit;
  end;
  if nm = 'align_of' then
  begin
    Emit('store i64 ' + IntToStr(AlignOfTy(ty0)) + ', ptr ' + da.ptr + ', align 8');
    Exit;
  end;
  if (nm = 'needs_drop') then
  begin
    Emit('store i8 0, ptr ' + da.ptr + ', align 1');
    Exit;
  end;
  if nm = 'type_name' then
  begin
    v := TyToStr(ty0);
    Emit('store ptr ' + StrConst(v) + ', ptr ' + da.ptr + ', align 8');
    Emit('store i64 ' + IntToStr(Length(v)) + ', ptr ' + Gep(da.ptr, 8) + ', align 8');
    Exit;
  end;
  if nm = 'abort' then
  begin
    NeedIntrinsic('declare void @abort()');
    Emit('call void @abort()');
    Emit('unreachable');
    Exit;
  end;
  if (nm = 'unreachable') then
  begin
    Emit('unreachable');
    Exit;
  end;
  if (nm = 'black_box') or (nm = 'assume') then
  begin
    if t.hasDest and (Length(t.args) > 0) then StoreOperand(t.args[0], da.ptr, t.dest.ty);
    Exit;
  end;
  if nm = 'transmute' then
  begin
    esz := TySize(ty0);
    if TySize(ty1) < esz then esz := TySize(ty1);
    if IsScalarTy(ty0) then
    begin
      tmp := AllocaOf(ty0);
      StoreOperand(t.args[0], tmp, ty0);
      MemCopy(da.ptr, tmp, esz, 1);
    end
    else
    begin
      srcp := OperandAddr(t.args[0], False);
      MemCopy(da.ptr, srcp, esz, 1);
    end;
    Exit;
  end;
  if (nm = 'offset') or (nm = 'arith_offset') then
  begin
    esz := TySize(ty0);
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    r := NewT;
    Emit(r + ' = mul i64 ' + v2 + ', ' + IntToStr(esz));
    p := NewT;
    Emit(p + ' = getelementptr i8, ptr ' + v + ', i64 ' + r);
    StoreScalar(p, da.ptr, t.dest.ty);
    Exit;
  end;
  if nm = 'ptr_offset_from' then
  begin
    esz := TySize(ty0);
    if esz < 1 then esz := 1;
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    r := NewT; Emit(r + ' = ptrtoint ptr ' + v + ' to i64');
    p := NewT; Emit(p + ' = ptrtoint ptr ' + v2 + ' to i64');
    tmp := NewT; Emit(tmp + ' = sub i64 ' + r + ', ' + p);
    srcp := NewT; Emit(srcp + ' = sdiv i64 ' + tmp + ', ' + IntToStr(esz));
    Emit('store i64 ' + srcp + ', ptr ' + da.ptr + ', align 8');
    Exit;
  end;
  if (nm = 'ptr_read') or (nm = 'volatile_load') then
  begin
    v := OperandScalar(t.args[0]);
    if IsZstTy(ty0) then Exit;
    if IsScalarTy(ty0) then
    begin
      r := LoadScalar(v, ty0);
      StoreScalar(r, da.ptr, ty0);
    end
    else MemCopy(da.ptr, v, TySize(ty0), AlignOfTy(ty0));
    Exit;
  end;
  if (nm = 'ptr_write') or (nm = 'volatile_store') then
  begin
    v := OperandScalar(t.args[0]);
    if IsZstTy(ty0) then Exit;
    if IsScalarTy(ty0) then StoreScalar(OperandScalar(t.args[1]), v, ty0)
    else
    begin
      srcp := OperandAddr(t.args[1], False);
      MemCopy(v, srcp, TySize(ty0), AlignOfTy(ty0));
    end;
    Exit;
  end;
  if (nm = 'copy_nonoverlapping') or (nm = 'copy') then
  begin
    esz := TySize(ty0);
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    v3 := OperandScalar(t.args[2]);
    r := NewT;
    Emit(r + ' = mul i64 ' + v3 + ', ' + IntToStr(esz));
    if nm = 'copy' then
    begin
      NeedIntrinsic('declare void @llvm.memmove.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)');
      Emit('call void @llvm.memmove.p0.p0.i64(ptr ' + v2 + ', ptr ' + v + ', i64 ' + r + ', i1 false)');
    end
    else
    begin
      NeedIntrinsic('declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ptr noalias nocapture readonly, i64, i1 immarg)');
      Emit('call void @llvm.memcpy.p0.p0.i64(ptr ' + v2 + ', ptr ' + v + ', i64 ' + r + ', i1 false)');
    end;
    Exit;
  end;
  if nm = 'write_bytes' then
  begin
    esz := TySize(ty0);
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    v3 := OperandScalar(t.args[2]);
    r := NewT;
    Emit(r + ' = mul i64 ' + v3 + ', ' + IntToStr(esz));
    NeedIntrinsic('declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)');
    Emit('call void @llvm.memset.p0.i64(ptr ' + v + ', i8 ' + v2 + ', i64 ' + r + ', i1 false)');
    Exit;
  end;
  if nm = 'discriminant_value' then
  begin
    { argument : &T ; resultat i64 }
    v := OperandScalar(t.args[0]);
    i := LayoutOf(ty0);
    tag := Lays[i].tagSize;
    if (Tys[Shallow(ty0)].k = tyAdt) and (Defs[Tys[Shallow(ty0)].def].kind = dkEnum) and (tag > 0) then
    begin
      r := NewT;
      Emit(r + ' = load i' + IntToStr(tag * 8) + ', ptr ' + v + ', align ' + IntToStr(tag));
      v2 := ZextTo(r, tag * 8, 64, True);
      Emit('store i64 ' + v2 + ', ptr ' + da.ptr + ', align 8');
    end
    else Emit('store i64 0, ptr ' + da.ptr + ', align 8');
    Exit;
  end;
  { arithmetique sans controle ou avec indicateur }
  ll := LLScalar(ty0);
  if (nm = 'wrapping_add') or (nm = 'wrapping_sub') or (nm = 'wrapping_mul') or (nm = 'unchecked_add') or
     (nm = 'unchecked_sub') or (nm = 'unchecked_mul') then
  begin
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    r := NewT;
    if Pos('add', nm) > 0 then fn := 'add' else if Pos('sub', nm) > 0 then fn := 'sub' else fn := 'mul';
    Emit(r + ' = ' + fn + ' ' + ll + ' ' + v + ', ' + v2);
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if (nm = 'unchecked_div') or (nm = 'unchecked_rem') or (nm = 'exact_div') or (nm = 'unchecked_shl') or
     (nm = 'unchecked_shr') then
  begin
    v := OperandScalar(t.args[0]);
    v2 := OperandScalar(t.args[1]);
    r := NewT;
    if nm = 'unchecked_shl' then fn := 'shl'
    else if nm = 'unchecked_shr' then begin if IsSignedTy(ty0) then fn := 'ashr' else fn := 'lshr'; end
    else if nm = 'unchecked_rem' then begin if IsSignedTy(ty0) then fn := 'srem' else fn := 'urem'; end
    else begin if IsSignedTy(ty0) then fn := 'sdiv' else fn := 'udiv'; end;
    Emit(r + ' = ' + fn + ' ' + ll + ' ' + v + ', ' + v2);
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if (nm = 'add_with_overflow') or (nm = 'sub_with_overflow') or (nm = 'mul_with_overflow') then
  begin
    if nm = 'add_with_overflow' then fn := 'Add' else if nm = 'sub_with_overflow' then fn := 'Sub' else fn := 'Mul';
    r := NewT;
    Emit(r + ' = call {' + ll + ', i1} @' + CheckedIntrinsic(fn, ty0) + '(' + ll + ' ' + OperandScalar(t.args[0]) + ', ' + ll +
         ' ' + OperandScalar(t.args[1]) + ')');
    v := NewT; Emit(v + ' = extractvalue {' + ll + ', i1} ' + r + ', 0');
    v2 := NewT; Emit(v2 + ' = extractvalue {' + ll + ', i1} ' + r + ', 1');
    i := LayoutOf(t.dest.ty);
    Emit('store ' + ll + ' ' + v + ', ptr ' + Gep(da.ptr, Lays[i].offsets[0]) + ', align ' + IntToStr(AlignOfTy(ty0)));
    StoreI1AsBool(v2, Gep(da.ptr, Lays[i].offsets[1]));
    Exit;
  end;
  if (nm = 'saturating_add') or (nm = 'saturating_sub') then
  begin
    if IsSignedTy(ty0) then fn := 's' else fn := 'u';
    if nm = 'saturating_add' then fn := fn + 'add' else fn := fn + 'sub';
    NeedIntrinsic('declare ' + ll + ' @llvm.' + fn + '.sat.' + ll + '(' + ll + ', ' + ll + ')');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + fn + '.sat.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ', ' + ll + ' ' +
         OperandScalar(t.args[1]) + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if (nm = 'ctpop') or (nm = 'bswap') or (nm = 'bitreverse') then
  begin
    fn := nm;
    if nm = 'ctpop' then fn := 'ctpop';
    NeedIntrinsic('declare ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ')');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ')');
    { le resultat est du meme type entier ; la fonction Rust declare u32 : conversion }
    v := ZextTo(r, ScalarBits(ty0), ScalarBits(t.dest.ty), False);
    StoreScalar(v, da.ptr, t.dest.ty);
    Exit;
  end;
  if (nm = 'ctlz') or (nm = 'cttz') then
  begin
    NeedIntrinsic('declare ' + ll + ' @llvm.' + nm + '.' + ll + '(' + ll + ', i1 immarg)');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + nm + '.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ', i1 false)');
    v := ZextTo(r, ScalarBits(ty0), ScalarBits(t.dest.ty), False);
    StoreScalar(v, da.ptr, t.dest.ty);
    Exit;
  end;
  if (nm = 'rotate_left') or (nm = 'rotate_right') then
  begin
    if nm = 'rotate_left' then fn := 'fshl' else fn := 'fshr';
    NeedIntrinsic('declare ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ', ' + ll + ', ' + ll + ')');
    v := OperandScalar(t.args[0]);
    v2 := ZextTo(OperandScalar(t.args[1]), ScalarBits(t.args[1].ty), ScalarBits(ty0), False);
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ' ' + v + ', ' + ll + ' ' + v + ', ' + ll + ' ' + v2 + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  { fonctions flottantes }
  if (nm = 'sqrt') or (nm = 'floor') or (nm = 'ceil') or (nm = 'trunc') or (nm = 'round') or (nm = 'fabs') or
     (nm = 'sin') or (nm = 'cos') or (nm = 'exp') or (nm = 'exp2') or (nm = 'log') or (nm = 'log2') or (nm = 'log10') or
     (nm = 'rint') then
  begin
    NeedIntrinsic('declare ' + ll + ' @llvm.' + nm + '.' + ll + '(' + ll + ')');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + nm + '.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if (nm = 'powf') or (nm = 'copysign') or (nm = 'minnum') or (nm = 'maxnum') then
  begin
    if nm = 'powf' then fn := 'pow' else fn := nm;
    NeedIntrinsic('declare ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ', ' + ll + ')');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.' + fn + '.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ', ' + ll + ' ' +
         OperandScalar(t.args[1]) + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if nm = 'powi' then
  begin
    NeedIntrinsic('declare ' + ll + ' @llvm.powi.' + ll + '.i32(' + ll + ', i32)');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.powi.' + ll + '.i32(' + ll + ' ' + OperandScalar(t.args[0]) + ', i32 ' +
         OperandScalar(t.args[1]) + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  if nm = 'fma' then
  begin
    NeedIntrinsic('declare ' + ll + ' @llvm.fma.' + ll + '(' + ll + ', ' + ll + ', ' + ll + ')');
    r := NewT;
    Emit(r + ' = call ' + ll + ' @llvm.fma.' + ll + '(' + ll + ' ' + OperandScalar(t.args[0]) + ', ' + ll + ' ' +
         OperandScalar(t.args[1]) + ', ' + ll + ' ' + OperandScalar(t.args[2]) + ')');
    StoreScalar(r, da.ptr, ty0);
    Exit;
  end;
  Report(True, '', 'unsupported compiler intrinsic `' + nm + '`', -1, 0, 0, 0, '');
end;

procedure EmitCallTerm(const t: TTerm);
var
  i: Integer;
  argStr, v, calleeV, sigStr, retLL, tmpRet, rv, callStr: string;
  rk: Integer;
  retTy: Integer;
  da: TAddr;
  ft, cty: Integer;
  o: TOperand;
  pty: Integer;
  fnName: string;
  varArgs: Boolean;
  ptys: string;
  nd: Integer;
begin
  if t.callKind = ckIntrinsic then
  begin
    EmitIntrinsicCall(t);
    if Tys[Shallow(t.retTy)].k = tyNever then Emit('unreachable')
    else if t.target >= 0 then Emit('br label %bb' + IntToStr(t.target));
    Exit;
  end;
  retTy := Zonk(t.retTy);
  rk := RetKindOf(retTy);
  argStr := '';
  ptys := '';
  tmpRet := '';
  if rk = 2 then
  begin
    tmpRet := AllocaOf(retTy);
    argStr := 'ptr ' + tmpRet;
    ptys := 'ptr';
  end;
  for i := 0 to Length(t.args) - 1 do
  begin
    o := t.args[i];
    pty := Zonk(o.ty);
    if IsZstTy(pty) then Continue;
    if argStr <> '' then argStr := argStr + ', ';
    if ptys <> '' then ptys := ptys + ', ';
    if IsScalarTy(pty) then
    begin
      argStr := argStr + LLScalar(pty) + ' ' + OperandScalar(o);
      ptys := ptys + LLScalar(pty);
    end
    else
    begin
      argStr := argStr + 'ptr ' + OperandAddr(o, True);
      ptys := ptys + 'ptr';
    end;
  end;
  case rk of
    1: retLL := LLScalar(retTy);
  else
    retLL := 'void';
  end;
  varArgs := False;
  if t.callKind = ckDirect then
  begin
    nd := Defs[t.def].node;
    if (Defs[t.def].isExtern) and ((Nodes[nd].f and fVariadic) <> 0) then varArgs := True;
  end;
  case t.callKind of
    ckDirect, ckClosureCall:
      begin
        if varArgs then callStr := retLL + ' (' + ptys + ', ...) @"' + t.sym + '"'
        else callStr := retLL + ' @"' + t.sym + '"';
      end;
    ckIndirect:
      begin
        calleeV := OperandScalar(t.callee);
        callStr := FnPtrSig(Zonk(t.callee.ty)) + ' ' + calleeV;
      end;
  else
    callStr := retLL + ' @"' + t.sym + '"';
  end;
  if rk = 1 then
  begin
    rv := NewT;
    Emit(rv + ' = call ' + callStr + '(' + argStr + ')');
    if t.hasDest then
    begin
      da := PlaceAddr(t.dest);
      StoreScalar(rv, da.ptr, retTy);
    end;
  end
  else
  begin
    Emit('call ' + callStr + '(' + argStr + ')');
    if (rk = 2) and t.hasDest then
    begin
      da := PlaceAddr(t.dest);
      MemCopy(da.ptr, tmpRet, TySize(retTy), AlignOfTy(retTy));
    end;
  end;
  if Tys[Shallow(retTy)].k = tyNever then Emit('unreachable')
  else if t.target >= 0 then Emit('br label %bb' + IntToStr(t.target));
end;

procedure EmitPanicCall(const msg: string; const loc: string);
begin
  Emit('call void @"' + Insts[PanicConstInst].sym + '"(ptr ' + StrConst(msg) + ', i64 ' + IntToStr(Length(msg)) + ', ptr ' +
       StrConst(loc) + ', i64 ' + IntToStr(Length(loc)) + ')');
  Emit('unreachable');
end;

procedure EmitTerminator(const t: TTerm);
var
  v, c, lp, lok, ll: string;
  i: Integer;
  da: TAddr;
  rt: Integer;
  idx, len: string;
begin
  case t.k of
    tmGoto: Emit('br label %bb' + IntToStr(t.target));
    tmUnreachable: Emit('unreachable');
    tmReturn:
      begin
        if RetScalar then
        begin
          v := LoadScalar(LocAddr[0], MirFns[CurFn].retTy);
          Emit('ret ' + LLScalar(MirFns[CurFn].retTy) + ' ' + v);
        end
        else Emit('ret void');
      end;
    tmSwitch:
      begin
        v := OperandScalar(t.discr);
        ll := LLScalar(Zonk(t.discr.ty));
        c := '';
        for i := 0 to Length(t.vals) - 1 do
          c := c + ll + ' ' + IntToStr(t.vals[i]) + ', label %bb' + IntToStr(t.targets[i]) + ' ';
        Emit('switch ' + ll + ' ' + v + ', label %bb' + IntToStr(t.othrw) + ' [ ' + c + ']');
      end;
    tmCall: EmitCallTerm(t);
    tmAssert:
      begin
        v := OperandScalar(t.cond);
        c := NewT;
        Emit(c + ' = icmp ne i8 ' + v + ', 0');
        lp := NewLbl('assert.fail');
        if t.expect then Emit('br i1 ' + c + ', label %bb' + IntToStr(t.target) + ', label %' + lp)
        else Emit('br i1 ' + c + ', label %' + lp + ', label %bb' + IntToStr(t.target));
        EmitLabel(lp);
        EmitPanicCall(t.msg, t.loc);
      end;
    tmAssertBounds:
      begin
        idx := OperandScalar(t.idx);
        len := OperandScalar(t.len);
        c := NewT;
        Emit(c + ' = icmp ult i64 ' + idx + ', ' + len);
        lp := NewLbl('bounds.fail');
        Emit('br i1 ' + c + ', label %bb' + IntToStr(t.target) + ', label %' + lp);
        EmitLabel(lp);
        Emit('call void @"' + Insts[PanicBoundsInst].sym + '"(i64 ' + idx + ', i64 ' + len + ', ptr ' + StrConst(t.loc) +
             ', i64 ' + IntToStr(Length(t.loc)) + ')');
        Emit('unreachable');
      end;
  else
    Emit('unreachable');
  end;
end;

{ ---- fonction ---- }

procedure EmitMirFn(idx: Integer);
var
  f: Integer;
  i, j: Integer;
  ty: Integer;
  params, header, ret, lname: string;
  rk: Integer;
  zs: Int64;
  t: string;
begin
  f := idx;
  CurFn := f;
  TmpN := 0;
  LblN := 0;
  BufInit(LL);
  BufInit(AllocaBuf);
  SetLength(LocAddr, MirFns[f].nlocals);
  ty := Zonk(MirFns[f].retTy);
  rk := RetKindOf(ty);
  params := '';
  case rk of
    1: ret := LLScalar(ty);
  else
    ret := 'void';
  end;
  if rk = 2 then params := 'ptr %sret';
  RetScalar := rk = 1;
  { allocas des variables locales }
  for i := 0 to MirFns[f].nlocals - 1 do
  begin
    ty := Zonk(MirFns[f].locals[i].ty);
    MirFns[f].locals[i].ty := ty;
    lname := '%l' + IntToStr(i);
    if (i = 0) and (rk = 2) then begin LocAddr[0] := '%sret'; Continue; end;
    if (i >= 1) and (i <= MirFns[f].nargs) and (not IsScalarTy(ty)) and (not IsZstTy(ty)) then
    begin
      LocAddr[i] := '%p' + IntToStr(i);
      if params <> '' then params := params + ', ';
      params := params + 'ptr %p' + IntToStr(i);
      Continue;
    end;
    zs := TySize(ty);
    if zs < 1 then zs := 1;
    if IsScalarTy(ty) then
      BufAdd(AllocaBuf, '  ' + lname + ' = alloca ' + LLScalar(ty) + ', align ' + IntToStr(AlignOfTy(ty)) + #10)
    else
      BufAdd(AllocaBuf, '  ' + lname + ' = alloca [' + IntToStr(zs) + ' x i8], align ' + IntToStr(AlignOfTy(ty)) + #10);
    LocAddr[i] := lname;
    if (i >= 1) and (i <= MirFns[f].nargs) and IsScalarTy(ty) then
    begin
      if params <> '' then params := params + ', ';
      params := params + LLScalar(ty) + ' %p' + IntToStr(i);
    end;
  end;
  header := 'define ' + ret + ' @"' + MirFns[f].sym + '"(' + params + ') #0 {';
  { instructions des blocs }
  for i := 0 to MirFns[f].nblocks - 1 do
  begin
    EmitLabel('bb' + IntToStr(i));
    for j := 0 to MirFns[f].blocks[i].nst - 1 do
      case MirFns[f].blocks[i].stmts[j].k of
        stAssign: EmitAssignStmt(MirFns[f].blocks[i].stmts[j]);
      end;
    if MirFns[f].blocks[i].terminated then EmitTerminator(MirFns[f].blocks[i].term)
    else Emit('unreachable');
  end;
  BufLn(ModBuf, header);
  BufLn(ModBuf, 'entry:');
  { stockage des parametres scalaires }
  for i := 1 to MirFns[f].nargs do
  begin
    ty := MirFns[f].locals[i].ty;
    if IsScalarTy(ty) then
      BufAdd(AllocaBuf, '  store ' + LLScalar(ty) + ' %p' + IntToStr(i) + ', ptr %l' + IntToStr(i) + ', align ' +
             IntToStr(AlignOfTy(ty)) + #10);
  end;
  BufAdd(ModBuf, BufStr(AllocaBuf));
  BufLn(ModBuf, '  br label %bb0');
  BufAdd(ModBuf, BufStr(LL));
  BufLn(ModBuf, '}');
  BufLn(ModBuf, '');
end;

{ ---- declarations externes ---- }
procedure EmitExternDecl(i: Integer);
var
  params: TIntArr;
  ret: Integer;
  k: Integer;
  s, ps: string;
  nd: Integer;
begin
  if Insts[i].intrinsic then Exit;
  FnDefSig(Insts[i].def, Insts[i].targs, params, ret);
  ret := Zonk(ret);
  nd := Defs[Insts[i].def].node;
  ps := '';
  for k := 0 to Length(params) - 1 do
  begin
    if ps <> '' then ps := ps + ', ';
    ps := ps + ParamLL(Zonk(params[k]));
  end;
  if (Nodes[nd].f and fVariadic) <> 0 then
  begin
    if ps <> '' then ps := ps + ', ';
    ps := ps + '...';
  end;
  if RetKindOf(ret) = 1 then s := LLScalar(ret) else s := 'void';
  BufAdd(LLDecls, 'declare ' + s + ' @' + Insts[i].sym + '(' + ps + ')'#10);
end;

