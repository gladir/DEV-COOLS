{ ANALYSE SYNTAXIQUE : jetons -> AST                           }
{ ============================================================ }

Const
  fGlob = 256;
  CtxExpr = 0;
  CtxStmt = 1;
  CtxItem = 2;
  CtxPat = 3;
  CtxType = 4;

Var
  NoStruct: Boolean;
  PreExpr: Integer;
  CfgDebug: Boolean;
  CurModDir: string;
  CurFileName: string;
  ParseDepth: Integer;
  ExtMods: Integer;

function ParseType: Integer; forward;
function ParseExpr: Integer; forward;
function ParsePat: Integer; forward;
function ParsePatNoTop: Integer; forward;
function ParseBlock: Integer; forward;
function ParsePath(mode: Integer): Integer; forward;
procedure ParseItemInto(var lst: TIntArr); forward;
function ParseUnary: Integer; forward;
function ParseBin(minPrec: Integer): Integer; forward;
function MacroInvoke(const name: string; ctx, startTok: Integer): Boolean; forward;
function IsUserMacro(const name: string): Boolean; forward;

function IsReserved(const s: string): Boolean;
begin
  case Length(s) of
    2: Result := (s = 'as') or (s = 'fn') or (s = 'if') or (s = 'in');
    3: Result := (s = 'for') or (s = 'let') or (s = 'mod') or (s = 'mut') or (s = 'pub') or (s = 'ref') or
                 (s = 'use') or (s = 'dyn') or (s = 'box');
    4: Result := (s = 'else') or (s = 'enum') or (s = 'impl') or (s = 'loop') or (s = 'move') or (s = 'self') or
                 (s = 'Self') or (s = 'true') or (s = 'type') or (s = 'priv');
    5: Result := (s = 'break') or (s = 'const') or (s = 'crate') or (s = 'false') or (s = 'match') or
                 (s = 'super') or (s = 'trait') or (s = 'where') or (s = 'while') or (s = 'async') or (s = 'await');
    6: Result := (s = 'extern') or (s = 'return') or (s = 'static') or (s = 'struct') or (s = 'unsafe');
    8: Result := s = 'continue';
  else
    Result := False;
  end;
end;

function CurK: Integer;
begin
  Result := Toks[TokPos].k;
end;

function CurS: string;
begin
  Result := Toks[TokPos].s;
end;

function IsPunct(const p: string): Boolean;
begin
  Result := (Toks[TokPos].k = tkPunct) and (Toks[TokPos].s = p);
end;

function PeekPunct(off: Integer; const p: string): Boolean;
begin
  Result := (TokPos + off < NToks) and (Toks[TokPos + off].k = tkPunct) and (Toks[TokPos + off].s = p);
end;

function IsKw(const w: string): Boolean;
begin
  Result := (Toks[TokPos].k = tkIdent) and (not Toks[TokPos].raw) and (Toks[TokPos].s = w);
end;

function PeekKw(off: Integer; const w: string): Boolean;
begin
  Result := (TokPos + off < NToks) and (Toks[TokPos + off].k = tkIdent) and (not Toks[TokPos + off].raw) and
            (Toks[TokPos + off].s = w);
end;

function PeekK(off: Integer): Integer;
begin
  if TokPos + off < NToks then Result := Toks[TokPos + off].k else Result := tkEOF;
end;

function PeekS(off: Integer): string;
begin
  if TokPos + off < NToks then Result := Toks[TokPos + off].s else Result := '';
end;

function IsIdentTok: Boolean;
begin
  Result := (Toks[TokPos].k = tkIdent) and (Toks[TokPos].raw or (not IsReserved(Toks[TokPos].s)));
end;

function TokDesc(const t: TToken): string;
begin
  case t.k of
    tkEOF: Result := '`<eof>`';
    tkIdent:
      if (not t.raw) and IsReserved(t.s) then Result := 'keyword `' + t.s + '`'
      else Result := 'identifier `' + t.s + '`';
    tkLifetime: Result := 'lifetime `''' + t.s + '`';
    tkInt, tkFloat: Result := '`' + t.s + t.sfx + '`';
    tkStr: Result := 'string literal';
    tkChar: Result := 'character literal';
    tkPunct: Result := '`' + t.s + '`';
  else
    Result := 'literal';
  end;
end;

procedure ParseErr(const msg, lbl: string);
begin
  Report(True, '', msg, Toks[TokPos].fi, Toks[TokPos].line, Toks[TokPos].col, Toks[TokPos].len, lbl);
  FinishDiag;
end;

procedure ErrExpected(const what: string);
begin
  ParseErr('expected ' + what + ', found ' + TokDesc(Toks[TokPos]), 'expected ' + what);
end;

procedure Adv;
begin
  if TokPos < NToks - 1 then Inc(TokPos);
end;

{ Consomme le premier caractere du jeton de ponctuation courant (>>, &&, ...) }
procedure SplitFirst;
begin
  Toks[TokPos].s := Copy(Toks[TokPos].s, 2, Length(Toks[TokPos].s) - 1);
  Inc(Toks[TokPos].col);
  Dec(Toks[TokPos].len);
end;

function AcceptPunct(const p: string): Boolean;
begin
  Result := IsPunct(p);
  if Result then Adv;
end;

procedure ExpectPunct(const p: string);
begin
  if IsPunct(p) then Adv else ErrExpected('`' + p + '`');
end;

function AcceptKw(const w: string): Boolean;
begin
  Result := IsKw(w);
  if Result then Adv;
end;

procedure ExpectKw(const w: string);
begin
  if IsKw(w) then Adv else ErrExpected('`' + w + '`');
end;

procedure ExpectGt;
begin
  if IsPunct('>') then Adv
  else if (CurK = tkPunct) and (Length(CurS) > 1) and (CurS[1] = '>') then SplitFirst
  else ErrExpected('`>`');
end;

function ExpectIdent: string;
begin
  if (CurK = tkIdent) and (Toks[TokPos].raw or (not IsReserved(CurS)) or (CurS = 'self') or (CurS = 'Self') or
     (CurS = 'super') or (CurS = 'crate')) then
  begin
    Result := CurS;
    Adv;
  end
  else
  begin
    if (CurK = tkIdent) and IsReserved(CurS) then
      ParseErr('expected identifier, found keyword `' + CurS + '`', 'expected identifier, found keyword')
    else
      ErrExpected('identifier');
    Result := '';
  end;
end;

function MkN(k: Integer): Integer;
begin
  Result := NewNode(k);
  Nodes[Result].fi := Toks[TokPos].fi;
  Nodes[Result].line := Toks[TokPos].line;
  Nodes[Result].col := Toks[TokPos].col;
end;

function MkFrom(k, child: Integer): Integer;
begin
  Result := NewNode(k);
  Nodes[Result].fi := Nodes[child].fi;
  Nodes[Result].line := Nodes[child].line;
  Nodes[Result].col := Nodes[child].col;
end;

procedure Fin(n: Integer);
begin
  if TokPos > 0 then
  begin
    Nodes[n].eline := Toks[TokPos - 1].line;
    Nodes[n].ecol := Toks[TokPos - 1].col + Toks[TokPos - 1].len;
  end;
end;

function Done(n: Integer): Integer;
begin
  Fin(n);
  Result := n;
end;

{ Longueur d'un noeud pour les diagnostics }
function NodeLen(n: Integer): Integer;
var
  l: Integer;
begin
  if n <= 0 then begin Result := 1; Exit; end;
  if (Nodes[n].eline = Nodes[n].line) and (Nodes[n].ecol > Nodes[n].col) then
    Result := Nodes[n].ecol - Nodes[n].col
  else
  begin
    l := Length(SourceLine(Nodes[n].fi, Nodes[n].line));
    Result := l - Nodes[n].col + 1;
    if Result < 1 then Result := 1;
  end;
end;

{ ---- attributs et cfg ---- }

function CfgAtom(const nm, val: string): Boolean;
begin
  if val = '' then
  begin
    Result := (nm = 'unix') or (nm = 'debug_assertions') and CfgDebug or (nm = 'panic');
    Exit;
  end;
  Result := False;
  if nm = 'target_os' then Result := val = 'linux'
  else if nm = 'target_family' then Result := val = 'unix'
  else if nm = 'target_arch' then Result := val = 'x86_64'
  else if nm = 'target_pointer_width' then Result := val = '64'
  else if nm = 'target_endian' then Result := val = 'little'
  else if nm = 'panic' then Result := val = 'unwind';
end;

function EvalCfg(const s: string; var i: Integer): Boolean;
var
  nm, val: string;
  r, first: Boolean;
  op: string;
begin
  nm := '';
  while (i <= Length(s)) and (IsIdChar(s[i])) do begin nm := nm + s[i]; Inc(i); end;
  if (i <= Length(s)) and (s[i] = '(') then
  begin
    Inc(i);
    if nm = 'all' then r := True else r := False;
    op := nm;
    first := True;
    while (i <= Length(s)) and (s[i] <> ')') do
    begin
      if s[i] = ',' then Inc(i)
      else
      begin
        if EvalCfg(s, i) then
        begin
          if op = 'any' then r := True
          else if op = 'not' then r := True;
        end
        else
        begin
          if op = 'all' then r := False;
        end;
        first := False;
      end;
    end;
    Inc(i);
    if op = 'not' then r := not r;
    Result := r;
    Exit;
  end;
  val := '';
  if (i <= Length(s)) and (s[i] = '=') then
  begin
    Inc(i);
    if (i <= Length(s)) and (s[i] = '"') then
    begin
      Inc(i);
      while (i <= Length(s)) and (s[i] <> '"') do begin val := val + s[i]; Inc(i); end;
      Inc(i);
    end;
    if val = '' then val := '?';
  end;
  Result := CfgAtom(nm, val);
end;

{ Lit les attributs #[...] / #![...]; remplit attrs ; skip = True si l'item doit etre ignore }
procedure ParseAttrs(var attrs: string; var skip: Boolean);
var
  depth, i: Integer;
  txt: string;
begin
  while IsPunct('#') and (PeekPunct(1, '[') or (PeekPunct(1, '!') and PeekPunct(2, '['))) do
  begin
    Adv;
    if IsPunct('!') then Adv;
    Adv; { [ }
    depth := 1;
    txt := '';
    while (depth > 0) and (CurK <> tkEOF) do
    begin
      if IsPunct('[') then Inc(depth)
      else if IsPunct(']') then
      begin
        Dec(depth);
        if depth = 0 then begin Adv; Break; end;
      end;
      case CurK of
        tkStr: txt := txt + '"' + CurS + '"';
        tkInt, tkFloat: txt := txt + CurS;
      else
        txt := txt + CurS;
      end;
      if (CurK = tkIdent) and (PeekK(1) = tkIdent) then txt := txt + ' ';
      Adv;
    end;
    if StartsWith(txt, 'cfg(') then
    begin
      i := 1;
      if not EvalCfg(txt, i) then skip := True;
    end
    else if txt = 'test' then skip := True
    else attrs := attrs + txt + ';';
  end;
end;

function HasAttr(n: Integer; const nm: string): Boolean;
begin
  Result := Pos(nm, Nodes[n].at) > 0;
end;

{ Retourne la liste des derives, ex "Debug,Clone" }
function DeriveList(const at: string): string;
var
  i, j: Integer;
  r: string;
begin
  r := '';
  i := 1;
  while i <= Length(at) do
  begin
    j := i;
    while (j <= Length(at)) and (at[j] <> ';') do Inc(j);
    if Copy(at, i, 7) = 'derive(' then
      r := r + Copy(at, i + 7, j - i - 8) + ',';
    i := j + 1;
  end;
  Result := r;
end;

{ ---- generiques et chemins ---- }

procedure ParseBounds(var lst: TIntArr);
var
  p: Integer;
begin
  repeat
    if CurK = tkLifetime then Adv
    else if IsPunct('?') then
    begin
      Adv;
      p := ParsePath(0);
    end
    else if IsPunct('(') then
    begin
      Adv;
      p := ParsePath(0);
      IAdd(lst, p);
      ExpectPunct(')');
    end
    else if IsKw('for') and PeekPunct(1, '<') then
    begin
      Adv; Adv;
      while not IsPunct('>') do Adv;
      Adv;
      p := ParsePath(0);
      IAdd(lst, p);
    end
    else if (CurK = tkIdent) or IsPunct('::') or IsPunct('<') then
    begin
      p := ParsePath(0);
      IAdd(lst, p);
    end
    else Break;
  until not AcceptPunct('+');
end;

procedure ParseBoundsInto(node, slot: Integer);
var
  tmp: TIntArr;
begin
  tmp := nil;
  ParseBounds(tmp);
  case slot of
    1: Nodes[node].l := tmp;
    2: Nodes[node].l2 := tmp;
  else
    Nodes[node].l3 := tmp;
  end;
end;

procedure ParseGenericArgs(seg: Integer);
var
  nm, c, b: Integer;
  t: Integer;
begin
  Adv; { < }
  while not (IsPunct('>') or IsPunct('>>') or IsPunct('>=') or IsPunct('>>=')) do
  begin
    if CurK = tkLifetime then Adv
    else if (CurK = tkIdent) and PeekPunct(1, '=') then
    begin
      b := MkN(nAssocBind);
      Nodes[b].s := CurS;
      Adv; Adv;
      Nodes[b].a := ParseType;
      IAdd(Nodes[seg].l2, b);
    end
    else if (CurK = tkInt) or (CurK = tkChar) or (CurK = tkStr) or IsPunct('-') or IsPunct('{') or
            IsKw('true') or IsKw('false') then
    begin
      c := MkN(nConstArg);
      if IsPunct('{') then Nodes[c].a := ParseBlock
      else Nodes[c].a := ParseUnary;
      IAdd(Nodes[seg].l, c);
    end
    else
    begin
      t := ParseType;
      IAdd(Nodes[seg].l, t);
    end;
    if not AcceptPunct(',') then Break;
  end;
  ExpectGt;
end;

{ mode 0 : contexte type (<> direct) ; mode 1 : contexte expression/motif (::<>) }
function ParsePath(mode: Integer): Integer;
var
  n, seg, t, a: Integer;
  nm: string;
begin
  n := MkN(tPath);
  if IsPunct('<') then
  begin
    Adv;
    Nodes[n].a := ParseType;
    if AcceptKw('as') then Nodes[n].b := ParsePath(0);
    ExpectGt;
    ExpectPunct('::');
  end
  else if IsPunct('::') then
  begin
    Adv;
    Nodes[n].f := 1;
  end;
  while True do
  begin
    seg := MkN(nSeg);
    nm := ExpectIdent;
    Nodes[seg].s := nm;
    if mode = 0 then
    begin
      if IsPunct('<') then ParseGenericArgs(seg)
      else if IsPunct('::') and PeekPunct(1, '<') then
      begin
        Adv;
        ParseGenericArgs(seg);
      end
      else if IsPunct('(') and ((nm = 'Fn') or (nm = 'FnMut') or (nm = 'FnOnce')) then
      begin
        Adv;
        Nodes[seg].f := 1;
        while not IsPunct(')') do
        begin
          t := ParseType;
          IAdd(Nodes[seg].l, t);
          if not AcceptPunct(',') then Break;
        end;
        ExpectPunct(')');
        if AcceptPunct('->') then Nodes[seg].a := ParseType;
      end;
    end
    else
    begin
      if IsPunct('::') and PeekPunct(1, '<') then
      begin
        Adv;
        ParseGenericArgs(seg);
      end;
    end;
    Fin(seg);
    IAdd(Nodes[n].l, seg);
    if IsPunct('::') and (PeekK(1) = tkIdent) then Adv
    else Break;
  end;
  Result := Done(n);
end;

procedure ParseGenerics(var lst: TIntArr);
var
  g: Integer;
begin
  if not IsPunct('<') then Exit;
  Adv;
  while not IsPunct('>') do
  begin
    g := MkN(nGenParam);
    if CurK = tkLifetime then
    begin
      Nodes[g].f := 1;
      Nodes[g].s := '''' + CurS;
      Adv;
      if AcceptPunct(':') then
        while CurK = tkLifetime do begin Adv; if not AcceptPunct('+') then Break; end;
    end
    else if IsKw('const') then
    begin
      Adv;
      Nodes[g].f := 2;
      Nodes[g].s := ExpectIdent;
      ExpectPunct(':');
      Nodes[g].b := ParseType;
      if AcceptPunct('=') then
      begin
        if IsPunct('{') then Nodes[g].a := ParseBlock else Nodes[g].a := ParseUnary;
      end;
    end
    else
    begin
      Nodes[g].s := ExpectIdent;
      if AcceptPunct(':') then ParseBoundsInto(g, 1);
      if AcceptPunct('=') then Nodes[g].a := ParseType;
    end;
    Fin(g);
    IAdd(lst, g);
    if not AcceptPunct(',') then Break;
  end;
  ExpectGt;
end;

procedure ParseWhere(var lst: TIntArr);
var
  w: Integer;
begin
  if not IsKw('where') then Exit;
  Adv;
  while not (IsPunct('{') or IsPunct(';') or IsPunct('=') or (CurK = tkEOF)) do
  begin
    if CurK = tkLifetime then
    begin
      Adv;
      ExpectPunct(':');
      while CurK = tkLifetime do begin Adv; if not AcceptPunct('+') then Break; end;
    end
    else
    begin
      if IsKw('for') and PeekPunct(1, '<') then
      begin
        Adv; Adv;
        while not IsPunct('>') do Adv;
        Adv;
      end;
      w := MkN(nWhere);
      Nodes[w].a := ParseType;
      ExpectPunct(':');
      ParseBoundsInto(w, 1);
      Fin(w);
      IAdd(lst, w);
    end;
    if not AcceptPunct(',') then Break;
  end;
end;

{ ---- types ---- }

function ParseType: Integer;
var
  n, t: Integer;
  nm: string;
begin
  n := MkN(tInfer);
  if IsPunct('(') then
  begin
    Adv;
    Nodes[n].k := tTuple;
    t := 0;
    while not IsPunct(')') do
    begin
      t := ParseType;
      IAdd(Nodes[n].l, t);
      if not AcceptPunct(',') then
      begin
        ExpectPunct(')');
        { parentheses simples : type interne }
        if Length(Nodes[n].l) = 1 then begin Result := t; Exit; end;
        Result := Done(n);
        Exit;
      end
      else if IsPunct(')') and (Length(Nodes[n].l) = 1) then Break;
    end;
    ExpectPunct(')');
  end
  else if IsPunct('[') then
  begin
    Adv;
    Nodes[n].a := ParseType;
    if AcceptPunct(';') then
    begin
      Nodes[n].k := tArray;
      Nodes[n].b := ParseExpr;
    end
    else Nodes[n].k := tSlice;
    ExpectPunct(']');
  end
  else if IsPunct('&') or IsPunct('&&') then
  begin
    Nodes[n].k := tRef;
    if IsPunct('&&') then SplitFirst else Adv;
    if CurK = tkLifetime then Adv;
    if AcceptKw('mut') then Nodes[n].f := 1;
    Nodes[n].a := ParseType;
  end
  else if IsPunct('*') then
  begin
    Adv;
    Nodes[n].k := tPtr;
    if AcceptKw('mut') then Nodes[n].f := 1
    else if AcceptKw('const') then Nodes[n].f := 0
    else ErrExpected('`mut` or `const`');
    Nodes[n].a := ParseType;
  end
  else if IsPunct('!') then
  begin
    Adv;
    Nodes[n].k := tNever;
  end
  else if IsKw('_') or ((CurK = tkIdent) and (CurS = '_')) then
  begin
    Adv;
    Nodes[n].k := tInfer;
  end
  else if IsKw('fn') or IsKw('unsafe') or IsKw('extern') then
  begin
    Nodes[n].k := tFnPtr;
    if AcceptKw('unsafe') then ;
    if AcceptKw('extern') then
    begin
      if CurK = tkStr then Adv;
    end;
    ExpectKw('fn');
    ExpectPunct('(');
    while not IsPunct(')') do
    begin
      if IsPunct('...') then begin Adv; Break; end;
      if (CurK = tkIdent) and PeekPunct(1, ':') and not PeekPunct(1, '::') then begin Adv; Adv; end;
      t := ParseType;
      IAdd(Nodes[n].l, t);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct(')');
    if AcceptPunct('->') then Nodes[n].a := ParseType;
  end
  else if IsKw('dyn') then
  begin
    Adv;
    Nodes[n].k := tDyn;
    ParseBoundsInto(n, 1);
  end
  else if IsKw('impl') then
  begin
    Adv;
    Nodes[n].k := tImplTrait;
    ParseBoundsInto(n, 1);
  end
  else if IsKw('for') and PeekPunct(1, '<') then
  begin
    Adv; Adv;
    while not IsPunct('>') do Adv;
    Adv;
    Result := ParseType;
    Exit;
  end
  else if (CurK = tkIdent) or IsPunct('<') or IsPunct('::') then
  begin
    { macro de type ou chemin }
    Result := ParsePath(0);
    Exit;
  end
  else
    ErrExpected('type');
  Result := Done(n);
end;

{ ---- litteraux ---- }

function ParseLiteral: Integer;
var
  n: Integer;
begin
  n := MkN(eLit);
  case CurK of
    tkInt: begin Nodes[n].f := lkInt; Nodes[n].iv := Toks[TokPos].iv; Nodes[n].s2 := Toks[TokPos].sfx; Nodes[n].s := CurS; end;
    tkFloat: begin Nodes[n].f := lkFloat; Nodes[n].fv := Toks[TokPos].fv; Nodes[n].s2 := Toks[TokPos].sfx; Nodes[n].s := CurS; end;
    tkStr: begin Nodes[n].f := lkStr; Nodes[n].s := CurS; end;
    tkChar: begin Nodes[n].f := lkChar; Nodes[n].iv := Toks[TokPos].iv; end;
    tkByte: begin Nodes[n].f := lkByte; Nodes[n].iv := Toks[TokPos].iv; end;
    tkByteStr: begin Nodes[n].f := lkByteStr; Nodes[n].s := CurS; end;
    tkIdent:
      if IsKw('true') then begin Nodes[n].f := lkBool; Nodes[n].iv := 1; end
      else if IsKw('false') then begin Nodes[n].f := lkBool; Nodes[n].iv := 0; end
      else ErrExpected('literal');
  else
    ErrExpected('literal');
  end;
  Adv;
  Result := Done(n);
end;

function IsLiteralStart: Boolean;
begin
  Result := (CurK = tkInt) or (CurK = tkFloat) or (CurK = tkStr) or (CurK = tkChar) or (CurK = tkByte) or
            (CurK = tkByteStr) or IsKw('true') or IsKw('false');
end;

{ ---- motifs ---- }

function ParsePatLitOrPath: Integer;
var
  lo, hi, n, neg: Integer;
begin
  { litteral (eventuellement negatif) ou chemin constant, suivi d'un intervalle optionnel }
  if IsPunct('-') then
  begin
    neg := MkN(eUnary);
    Adv;
    Nodes[neg].s := '-';
    Nodes[neg].a := ParseLiteral;
    lo := Done(neg);
  end
  else if IsLiteralStart then lo := ParseLiteral
  else
  begin
    n := MkN(ePath);
    Nodes[n].a := ParsePath(1);
    lo := Done(n);
  end;
  Result := lo;
end;

function ParseRangeHi: Integer;
begin
  if IsPunct('-') or IsLiteralStart then Result := ParsePatLitOrPath
  else if (CurK = tkIdent) and (not IsReserved(CurS)) then Result := ParsePatLitOrPath
  else Result := 0;
end;

function ParsePatNoTop: Integer;
var
  n, p, f, e, lo: Integer;
  nm: string;
begin
  n := MkN(pWild);
  if (CurK = tkIdent) and (CurS = '_') and (not Toks[TokPos].raw) then
  begin
    Adv;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('..') then
  begin
    Adv;
    Nodes[n].k := pRest;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('..=') then
  begin
    Adv;
    Nodes[n].k := pRange;
    Nodes[n].f := 1;
    Nodes[n].b := ParsePatLitOrPath;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('&') or IsPunct('&&') then
  begin
    Nodes[n].k := pRef;
    if IsPunct('&&') then SplitFirst else Adv;
    if AcceptKw('mut') then Nodes[n].f := 1;
    Nodes[n].a := ParsePatNoTop;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('(') then
  begin
    Adv;
    Nodes[n].k := pTuple;
    p := 0;
    while not IsPunct(')') do
    begin
      p := ParsePat;
      IAdd(Nodes[n].l, p);
      if not AcceptPunct(',') then
      begin
        ExpectPunct(')');
        if (Length(Nodes[n].l) = 1) and (Nodes[p].k <> pRest) then begin Result := p; Exit; end;
        Result := Done(n);
        Exit;
      end;
    end;
    ExpectPunct(')');
    Result := Done(n);
    Exit;
  end;
  if IsPunct('[') then
  begin
    Adv;
    Nodes[n].k := pSlice;
    while not IsPunct(']') do
    begin
      p := ParsePat;
      IAdd(Nodes[n].l, p);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct(']');
    Result := Done(n);
    Exit;
  end;
  if IsPunct('-') or IsLiteralStart then
  begin
    lo := ParsePatLitOrPath;
    if IsPunct('..=') or IsPunct('...') or IsPunct('..') then
    begin
      Nodes[n].k := pRange;
      Nodes[n].a := lo;
      if not IsPunct('..') then Nodes[n].f := 1;
      Adv;
      Nodes[n].b := ParseRangeHi;
      Result := Done(n);
      Exit;
    end;
    Nodes[n].k := pLit;
    Nodes[n].a := lo;
    Result := Done(n);
    Exit;
  end;
  if IsKw('ref') or IsKw('mut') then
  begin
    Nodes[n].k := pIdent;
    if AcceptKw('ref') then Nodes[n].f := Nodes[n].f or 1;
    if AcceptKw('mut') then Nodes[n].f := Nodes[n].f or 2;
    Nodes[n].s := ExpectIdent;
    if AcceptPunct('@') then Nodes[n].a := ParsePatNoTop;
    Result := Done(n);
    Exit;
  end;
  if IsKw('box') then
  begin
    Adv;
    Result := ParsePatNoTop;
    Exit;
  end;
  if (CurK = tkIdent) or IsPunct('<') or IsPunct('::') then
  begin
    { identifiant simple ? }
    if (CurK = tkIdent) and (not PeekPunct(1, '::')) and (not PeekPunct(1, '(')) and (not PeekPunct(1, '{')) and
       (not PeekPunct(1, '!')) and (not IsKw('self')) and (not IsKw('Self')) and (not IsKw('crate')) and
       (not IsKw('super')) and (not IsKw('true')) and (not IsKw('false')) then
    begin
      if IsPunct('..=') or PeekPunct(1, '..=') or PeekPunct(1, '...') or (PeekPunct(1, '..') and
         (PeekK(2) <> tkPunct) ) then
      begin
        { intervalle de constantes nommees }
        lo := ParsePatLitOrPath;
        Nodes[n].k := pRange;
        Nodes[n].a := lo;
        if not IsPunct('..') then Nodes[n].f := 1;
        Adv;
        Nodes[n].b := ParseRangeHi;
        Result := Done(n);
        Exit;
      end;
      Nodes[n].k := pIdent;
      Nodes[n].s := ExpectIdent;
      if AcceptPunct('@') then Nodes[n].a := ParsePatNoTop;
      Result := Done(n);
      Exit;
    end;
    { macro dans un motif }
    if (CurK = tkIdent) and PeekPunct(1, '!') and IsUserMacro(CurS) then
    begin
      if MacroInvoke(CurS, CtxPat, TokPos) then
      begin
        Result := ParsePatNoTop;
        Exit;
      end;
    end;
    p := ParsePath(1);
    if IsPunct('(') then
    begin
      Adv;
      Nodes[n].k := pTupleStruct;
      Nodes[n].a := p;
      while not IsPunct(')') do
      begin
        e := ParsePat;
        IAdd(Nodes[n].l, e);
        if not AcceptPunct(',') then Break;
      end;
      ExpectPunct(')');
    end
    else if IsPunct('{') then
    begin
      Adv;
      Nodes[n].k := pStruct;
      Nodes[n].a := p;
      while not IsPunct('}') do
      begin
        if IsPunct('..') then begin Adv; Nodes[n].f := 1; Break; end;
        f := MkN(pField);
        if IsKw('ref') or IsKw('mut') then
        begin
          e := MkN(pIdent);
          if AcceptKw('ref') then Nodes[e].f := Nodes[e].f or 1;
          if AcceptKw('mut') then Nodes[e].f := Nodes[e].f or 2;
          Nodes[e].s := ExpectIdent;
          Nodes[f].s := Nodes[e].s;
          Nodes[f].a := Done(e);
        end
        else
        begin
          nm := '';
          if CurK = tkInt then begin nm := CurS; Adv; end else nm := ExpectIdent;
          Nodes[f].s := nm;
          if AcceptPunct(':') then Nodes[f].a := ParsePat
          else
          begin
            e := MkN(pIdent);
            Nodes[e].s := nm;
            Nodes[f].a := Done(e);
          end;
        end;
        Fin(f);
        IAdd(Nodes[n].l, f);
        if not AcceptPunct(',') then Break;
      end;
      ExpectPunct('}');
    end
    else if IsPunct('..=') or IsPunct('...') then
    begin
      lo := MkFrom(ePath, p);
      Nodes[lo].a := p;
      Nodes[n].k := pRange;
      Nodes[n].a := Done(lo);
      Nodes[n].f := 1;
      Adv;
      Nodes[n].b := ParseRangeHi;
    end
    else
    begin
      Nodes[n].k := pPath;
      Nodes[n].a := p;
    end;
    Result := Done(n);
    Exit;
  end;
  ErrExpected('pattern');
  Result := n;
end;

function ParsePat: Integer;
var
  n, p: Integer;
begin
  AcceptPunct('|');
  p := ParsePatNoTop;
  if IsPunct('|') then
  begin
    n := MkFrom(pOr, p);
    IAdd(Nodes[n].l, p);
    while AcceptPunct('|') do
    begin
      p := ParsePatNoTop;
      IAdd(Nodes[n].l, p);
    end;
    Result := Done(n);
  end
  else Result := p;
end;

{ ---- expressions ---- }

function CanStartExpr: Boolean;
begin
  if CurK = tkEOF then begin Result := False; Exit; end;
  if CurK = tkPunct then
  begin
    Result := not ((CurS = ')') or (CurS = ']') or (CurS = '}') or (CurS = ',') or (CurS = ';') or
                   (CurS = '=>') or (CurS = '=') or (CurS = ':') or (CurS = '>') or (CurS = '.') or (CurS = '?')
                   or (CurS = '==') or (CurS = '|=') or (CurS = '&=') or (CurS = '+=') or (CurS = '-=') or
                   (CurS = '*=') or (CurS = '/=') or (CurS = '%=') or (CurS = '^='));
    if NoStruct and (CurS = '{') then Result := False;
    Exit;
  end;
  if (CurK = tkIdent) and (not Toks[TokPos].raw) and (CurS = 'else') then begin Result := False; Exit; end;
  Result := True;
end;

function IsBlockLikeStart: Boolean;
begin
  Result := IsPunct('{') or IsKw('if') or IsKw('match') or IsKw('loop') or IsKw('while') or IsKw('for') or
            (IsKw('unsafe') and PeekPunct(1, '{')) or (IsKw('const') and PeekPunct(1, '{')) or
            ((CurK = tkLifetime) and PeekPunct(1, ':'));
end;

function BinInfo(var op: string): Integer;
begin
  Result := -1;
  op := '';
  if CurK = tkPunct then
  begin
    op := CurS;
    if (op = '*') or (op = '/') or (op = '%') then Result := 10
    else if (op = '+') or (op = '-') then Result := 9
    else if (op = '<<') or (op = '>>') then Result := 8
    else if op = '&' then Result := 7
    else if op = '^' then Result := 6
    else if op = '|' then Result := 5
    else if (op = '==') or (op = '!=') or (op = '<') or (op = '>') or (op = '<=') or (op = '>=') then Result := 4
    else if op = '&&' then Result := 3
    else if op = '||' then Result := 2;
  end
  else if IsKw('as') then
  begin
    op := 'as';
    Result := 11;
  end;
end;

function ParseBin(minPrec: Integer): Integer;
var
  left, right, n, prec, t: Integer;
  op: string;
begin
  left := ParseUnary;
  while True do
  begin
    prec := BinInfo(op);
    if (prec < 0) or (prec < minPrec) then Break;
    Adv;
    if op = 'as' then
    begin
      n := MkFrom(eCast, left);
      Nodes[n].a := left;
      Nodes[n].b := ParseType;
      left := Done(n);
    end
    else
    begin
      right := ParseBin(prec + 1);
      n := MkFrom(eBinary, left);
      Nodes[n].s := op;
      Nodes[n].a := left;
      Nodes[n].b := right;
      left := Done(n);
    end;
  end;
  Result := left;
end;

function ParseRangeExpr: Integer;
var
  n, lo: Integer;
begin
  if IsPunct('..') or IsPunct('..=') then
  begin
    n := MkN(eRange);
    if IsPunct('..=') then Nodes[n].f := 1;
    Adv;
    if CanStartExpr then Nodes[n].b := ParseBin(2);
    Result := Done(n);
    Exit;
  end;
  lo := ParseBin(2);
  if IsPunct('..') or IsPunct('..=') then
  begin
    n := MkFrom(eRange, lo);
    Nodes[n].a := lo;
    if IsPunct('..=') then Nodes[n].f := 1;
    Adv;
    if CanStartExpr then Nodes[n].b := ParseBin(2);
    Result := Done(n);
    Exit;
  end;
  Result := lo;
end;

function ParseAssign: Integer;
var
  lo, n: Integer;
  s: string;
begin
  lo := ParseRangeExpr;
  if IsPunct('=') then
  begin
    n := MkFrom(eAssign, lo);
    Adv;
    Nodes[n].a := lo;
    Nodes[n].b := ParseAssign;
    Result := Done(n);
    Exit;
  end;
  if CurK = tkPunct then
  begin
    s := CurS;
    if (s = '+=') or (s = '-=') or (s = '*=') or (s = '/=') or (s = '%=') or (s = '^=') or (s = '&=') or
       (s = '|=') or (s = '<<=') or (s = '>>=') then
    begin
      n := MkFrom(eAssignOp, lo);
      Adv;
      Nodes[n].s := Copy(s, 1, Length(s) - 1);
      Nodes[n].a := lo;
      Nodes[n].b := ParseAssign;
      Result := Done(n);
      Exit;
    end;
  end;
  Result := lo;
end;

function ParseExpr: Integer;
begin
  Result := ParseAssign;
end;

function ParseExprNoStruct: Integer;
var
  sv: Boolean;
begin
  sv := NoStruct;
  NoStruct := True;
  Result := ParseExpr;
  NoStruct := sv;
end;

function ParseExprAllowStruct: Integer;
var
  sv: Boolean;
begin
  sv := NoStruct;
  NoStruct := False;
  Result := ParseExpr;
  NoStruct := sv;
end;

function ParseIfExpr: Integer;
var
  n: Integer;
begin
  n := MkN(eIf);
  ExpectKw('if');
  Nodes[n].a := ParseExprNoStruct;
  Nodes[n].b := ParseBlock;
  if AcceptKw('else') then
  begin
    if IsKw('if') then Nodes[n].c := ParseIfExpr
    else Nodes[n].c := ParseBlock;
  end;
  Result := Done(n);
end;

function ParseBlockLike: Integer;
var
  n, arm: Integer;
  lbl: string;
  sv: Boolean;
  sk: Boolean;
  at: string;
begin
  lbl := '';
  if CurK = tkLifetime then
  begin
    lbl := '''' + CurS;
    Adv;
    ExpectPunct(':');
  end;
  if IsKw('if') then Result := ParseIfExpr
  else if IsKw('match') then
  begin
    n := MkN(eMatch);
    Adv;
    Nodes[n].a := ParseExprNoStruct;
    ExpectPunct('{');
    sv := NoStruct;
    NoStruct := False;
    while not IsPunct('}') do
    begin
      at := '';
      sk := False;
      ParseAttrs(at, sk);
      arm := MkN(nArm);
      Nodes[arm].a := ParsePat;
      if AcceptKw('if') then Nodes[arm].b := ParseExpr;
      ExpectPunct('=>');
      if IsPunct('{') or (IsKw('unsafe') and PeekPunct(1, '{')) then
      begin
        Nodes[arm].c := ParseBlockLike;
        AcceptPunct(',');
      end
      else
      begin
        Nodes[arm].c := ParseExpr;
        if not IsPunct('}') then ExpectPunct(',');
      end;
      Fin(arm);
      if not sk then IAdd(Nodes[n].l, arm);
    end;
    ExpectPunct('}');
    NoStruct := sv;
    Result := Done(n);
  end
  else if IsKw('loop') then
  begin
    n := MkN(eLoop);
    Adv;
    Nodes[n].s := lbl;
    Nodes[n].b := ParseBlock;
    Result := Done(n);
  end
  else if IsKw('while') then
  begin
    n := MkN(eWhile);
    Adv;
    Nodes[n].s := lbl;
    Nodes[n].a := ParseExprNoStruct;
    Nodes[n].b := ParseBlock;
    Result := Done(n);
  end
  else if IsKw('for') then
  begin
    n := MkN(eFor);
    Adv;
    Nodes[n].s := lbl;
    Nodes[n].a := ParsePat;
    ExpectKw('in');
    Nodes[n].b := ParseExprNoStruct;
    Nodes[n].c := ParseBlock;
    Result := Done(n);
  end
  else if IsKw('unsafe') then
  begin
    Adv;
    n := ParseBlock;
    Nodes[n].f := Nodes[n].f or 1;
    Result := n;
  end
  else if IsKw('const') then
  begin
    Adv;
    n := ParseBlock;
    Nodes[n].f := Nodes[n].f or 2;
    Result := n;
  end
  else
  begin
    n := ParseBlock;
    Nodes[n].s := lbl;
    Result := n;
  end;
end;

function ParseArgs(close: string; var lst: TIntArr): Integer;
var
  sv: Boolean;
  e: Integer;
begin
  sv := NoStruct;
  NoStruct := False;
  while not IsPunct(close) do
  begin
    ParseDepth := ParseDepth;
    e := ParseExpr;
    IAdd(lst, e);
    if not AcceptPunct(',') then Break;
  end;
  ExpectPunct(close);
  NoStruct := sv;
  Result := 0;
end;

procedure ParseArgsInto(close: string; node: Integer);
var
  tmp: TIntArr;
begin
  tmp := nil;
  ParseArgs(close, tmp);
  Nodes[node].l := tmp;
end;

function IsFormatMacro(const nm: string): Boolean;
begin
  Result := (nm = 'println') or (nm = 'print') or (nm = 'eprintln') or (nm = 'eprint') or (nm = 'format') or
            (nm = 'panic') or (nm = 'write') or (nm = 'writeln') or (nm = 'assert') or (nm = 'assert_eq') or
            (nm = 'assert_ne') or (nm = 'debug_assert') or (nm = 'debug_assert_eq') or (nm = 'debug_assert_ne') or
            (nm = 'unreachable') or (nm = 'todo') or (nm = 'unimplemented') or (nm = 'dbg') or
            (nm = 'concat') or (nm = 'stringify') or (nm = 'line') or (nm = 'column') or (nm = 'file') or
            (nm = 'env') or (nm = 'option_env') or (nm = 'include_str') or (nm = 'module_path') or
            (nm = 'format_args') or (nm = 'compile_error') or (nm = 'cfg') or (nm = 'vec') or (nm = 'matches') or
            (nm = 'thread_local') or (nm = 'is_x86_feature_detected');
end;

{ Appel de macro : le jeton courant est le nom (deja lu avec le chemin) ; '!' est le jeton courant }
function ParseMacroCall(const name: string; startTok: Integer; n: Integer): Integer;
var
  close, e, arm: Integer;
  sv: Boolean;
  d: string;
  na: Integer;
begin
  { macro utilisateur ? }
  if IsUserMacro(name) then
  begin
    if MacroInvoke(name, CtxExpr, startTok) then
    begin
      Result := ParseUnary;
      Exit;
    end;
  end;
  Nodes[n].k := eMacro;
  Nodes[n].s := name;
  ExpectPunct('!');
  if IsPunct('(') then d := ')'
  else if IsPunct('[') then d := ']'
  else if IsPunct('{') then d := '}'
  else begin ErrExpected('one of `(`, `[`, or `{`'); d := ')'; end;
  Adv;
  Nodes[n].s2 := d;
  if not IsFormatMacro(name) then
  begin
    Report(True, '', 'cannot find macro `' + name + '` in this scope', Nodes[n].fi, Nodes[n].line, Nodes[n].col,
           Length(name), '');
    FinishDiag;
  end;
  sv := NoStruct;
  NoStruct := False;
  if (name = 'vec') then
  begin
    if not IsPunct(d) then
    begin
      e := ParseExpr;
      if AcceptPunct(';') then
      begin
        Nodes[n].f := 1;
        Nodes[n].a := e;
        Nodes[n].b := ParseExpr;
        AcceptPunct(',');
      end
      else
      begin
        IAdd(Nodes[n].l, e);
        while AcceptPunct(',') do
        begin
          if IsPunct(d) then Break;
          e := ParseExpr;
          IAdd(Nodes[n].l, e);
        end;
      end;
    end;
    ExpectPunct(d);
  end
  else if name = 'matches' then
  begin
    Nodes[n].a := ParseExpr;
    ExpectPunct(',');
    Nodes[n].b := ParsePat;
    if AcceptKw('if') then Nodes[n].c := ParseExpr;
    AcceptPunct(',');
    ExpectPunct(d);
  end
  else if name = 'thread_local' then
  begin
    while not IsPunct(d) do Adv;
    ExpectPunct(d);
  end
  else
  begin
    while not IsPunct(d) do
    begin
      if (CurK = tkIdent) and PeekPunct(1, '=') and not PeekPunct(1, '==') then
      begin
        na := MkN(eNamedArg);
        Nodes[na].s := CurS;
        Adv; Adv;
        Nodes[na].a := ParseExpr;
        e := Done(na);
      end
      else e := ParseExpr;
      IAdd(Nodes[n].l, e);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct(d);
  end;
  NoStruct := sv;
  Result := Done(n);
end;

function LooksLikeStructLit: Boolean;
begin
  { jeton courant = '{' }
  if PeekPunct(1, '}') then begin Result := True; Exit; end;
  if PeekPunct(1, '..') then begin Result := True; Exit; end;
  if ((PeekK(1) = tkIdent) or (PeekK(1) = tkInt)) and (PeekPunct(2, ':') or PeekPunct(2, ',') or PeekPunct(2, '}')) then
    Result := True
  else
    Result := False;
end;

function ParseClosure: Integer;
var
  n, p, prm: Integer;
begin
  n := MkN(eClosure);
  if AcceptKw('move') then Nodes[n].f := 1;
  if IsPunct('||') then Adv
  else
  begin
    ExpectPunct('|');
    while not IsPunct('|') do
    begin
      prm := MkN(nParam);
      Nodes[prm].a := ParsePatNoTop;
      if AcceptPunct(':') then Nodes[prm].b := ParseType;
      Fin(prm);
      IAdd(Nodes[n].l, prm);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct('|');
  end;
  if AcceptPunct('->') then
  begin
    Nodes[n].a := ParseType;
    Nodes[n].b := ParseBlock;
  end
  else
  begin
    p := ParseExpr;
    Nodes[n].b := p;
  end;
  Result := Done(n);
end;

function ParsePrimary: Integer;
var
  n, e, p, f, fi, base, startTok: Integer;
  nm: string;
  lbl: string;
  sv: Boolean;
begin
  startTok := TokPos;
  if IsLiteralStart then begin Result := ParseLiteral; Exit; end;
  if IsPunct('(') then
  begin
    n := MkN(eTuple);
    Adv;
    sv := NoStruct;
    NoStruct := False;
    e := 0;
    while not IsPunct(')') do
    begin
      e := ParseExpr;
      IAdd(Nodes[n].l, e);
      if not AcceptPunct(',') then
      begin
        ExpectPunct(')');
        NoStruct := sv;
        if Length(Nodes[n].l) = 1 then
        begin
          Nodes[n].k := eParen;
          Nodes[n].a := e;
          Nodes[n].l := nil;
        end;
        Result := Done(n);
        Exit;
      end;
    end;
    ExpectPunct(')');
    NoStruct := sv;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('[') then
  begin
    n := MkN(eArray);
    Adv;
    sv := NoStruct;
    NoStruct := False;
    while not IsPunct(']') do
    begin
      e := ParseExpr;
      if (Length(Nodes[n].l) = 0) and IsPunct(';') then
      begin
        Adv;
        Nodes[n].k := eRepeat;
        Nodes[n].a := e;
        Nodes[n].b := ParseExpr;
        Break;
      end;
      IAdd(Nodes[n].l, e);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct(']');
    NoStruct := sv;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('|') or IsPunct('||') or (IsKw('move') and (PeekPunct(1, '|') or PeekPunct(1, '||'))) then
  begin
    Result := ParseClosure;
    Exit;
  end;
  if IsBlockLikeStart then
  begin
    Result := ParseBlockLike;
    Exit;
  end;
  if IsKw('return') then
  begin
    n := MkN(eReturn);
    Adv;
    if CanStartExpr then Nodes[n].a := ParseExpr;
    Result := Done(n);
    Exit;
  end;
  if IsKw('break') then
  begin
    n := MkN(eBreak);
    Adv;
    if CurK = tkLifetime then begin Nodes[n].s := '''' + CurS; Adv; end;
    if CanStartExpr then Nodes[n].a := ParseExpr;
    Result := Done(n);
    Exit;
  end;
  if IsKw('continue') then
  begin
    n := MkN(eContinue);
    Adv;
    if CurK = tkLifetime then begin Nodes[n].s := '''' + CurS; Adv; end;
    Result := Done(n);
    Exit;
  end;
  if IsKw('let') then
  begin
    n := MkN(eLet);
    Adv;
    Nodes[n].a := ParsePat;
    ExpectPunct('=');
    Nodes[n].b := ParseBin(4);
    Result := Done(n);
    Exit;
  end;
  if (CurK = tkIdent) and (CurS = '_') and (not Toks[TokPos].raw) then
  begin
    n := MkN(eUnderscore);
    Adv;
    Result := Done(n);
    Exit;
  end;
  if (CurK = tkIdent) or IsPunct('<') or IsPunct('::') then
  begin
    if (CurK = tkIdent) and (not Toks[TokPos].raw) and IsReserved(CurS) and not (IsKw('self') or IsKw('Self') or
       IsKw('crate') or IsKw('super')) then
      ErrExpected('expression');
    n := MkN(ePath);
    p := ParsePath(1);
    { macro ? }
    if IsPunct('!') and (Length(Nodes[p].l) >= 1) and (PeekPunct(1, '(') or PeekPunct(1, '[') or PeekPunct(1, '{')) then
    begin
      nm := Nodes[Nodes[p].l[Length(Nodes[p].l) - 1]].s;
      Nodes[n].line := Nodes[p].line;
      Result := ParseMacroCall(nm, startTok, n);
      Exit;
    end;
    if IsPunct('{') and (not NoStruct) and LooksLikeStructLit then
    begin
      Nodes[n].k := eStruct;
      Nodes[n].a := p;
      Adv;
      sv := NoStruct;
      NoStruct := False;
      while not IsPunct('}') do
      begin
        if IsPunct('..') then
        begin
          Adv;
          if not IsPunct('}') then Nodes[n].b := ParseExpr;
          Break;
        end;
        f := MkN(nFieldInit);
        if CurK = tkInt then begin Nodes[f].s := CurS; Adv; end else Nodes[f].s := ExpectIdent;
        if AcceptPunct(':') then Nodes[f].a := ParseExpr
        else
        begin
          { raccourci : champ }
          e := MkN(ePath);
          base := MkN(tPath);
          fi := MkN(nSeg);
          Nodes[fi].s := Nodes[f].s;
          Nodes[fi].fi := Nodes[f].fi; Nodes[fi].line := Nodes[f].line; Nodes[fi].col := Nodes[f].col;
          IAdd(Nodes[base].l, fi);
          Nodes[base].fi := Nodes[f].fi; Nodes[base].line := Nodes[f].line; Nodes[base].col := Nodes[f].col;
          Nodes[e].fi := Nodes[f].fi; Nodes[e].line := Nodes[f].line; Nodes[e].col := Nodes[f].col;
          Nodes[e].a := base;
          Nodes[e].eline := Nodes[f].line;
          Nodes[e].ecol := Nodes[f].col + Length(Nodes[f].s);
          Nodes[f].a := e;
        end;
        Fin(f);
        IAdd(Nodes[n].l, f);
        if not AcceptPunct(',') then Break;
      end;
      ExpectPunct('}');
      NoStruct := sv;
      Result := Done(n);
      Exit;
    end;
    Nodes[n].a := p;
    Result := Done(n);
    Exit;
  end;
  ErrExpected('expression');
  Result := 0;
end;

function ParsePostfix(e: Integer): Integer;
var
  n, tmp: Integer;
  nm: string;
  txt: string;
  k: Integer;
begin
  while True do
  begin
    if IsPunct('?') then
    begin
      n := MkFrom(eTry, e);
      Adv;
      Nodes[n].a := e;
      e := Done(n);
    end
    else if IsPunct('(') then
    begin
      n := MkFrom(eCall, e);
      Adv;
      Nodes[n].a := e;
      ParseArgsInto(')', n);
      e := Done(n);
    end
    else if IsPunct('[') then
    begin
      n := MkFrom(eIndex, e);
      Adv;
      Nodes[n].a := e;
      Nodes[n].b := ParseExprAllowStruct;
      ExpectPunct(']');
      e := Done(n);
    end
    else if IsPunct('.') then
    begin
      Adv;
      if CurK = tkInt then
      begin
        n := MkFrom(eTupleField, e);
        Nodes[n].iv := Toks[TokPos].iv;
        Nodes[n].a := e;
        Adv;
        e := Done(n);
      end
      else if CurK = tkFloat then
      begin
        { x.0.1 lexe comme flottant 0.1 }
        txt := CurS;
        k := Pos('.', txt);
        n := MkFrom(eTupleField, e);
        Nodes[n].iv := StrToIntDef(Copy(txt, 1, k - 1), 0);
        Nodes[n].a := e;
        e := n;
        n := MkFrom(eTupleField, e);
        Nodes[n].iv := StrToIntDef(Copy(txt, k + 1, 20), 0);
        Nodes[n].a := e;
        Adv;
        e := Done(n);
      end
      else if IsKw('await') then
      begin
        ErrExpected('identifier');
      end
      else
      begin
        nm := ExpectIdent;
        if IsPunct('(') or (IsPunct('::') and PeekPunct(1, '<')) then
        begin
          n := MkFrom(eMethod, e);
          Nodes[n].s := nm;
          Nodes[n].a := e;
          if IsPunct('::') then
          begin
            Adv;
            tmp := MkN(nSeg);
            ParseGenericArgs(tmp);
            Nodes[n].l2 := Nodes[tmp].l;
          end;
          ExpectPunct('(');
          ParseArgsInto(')', n);
          e := Done(n);
        end
        else
        begin
          n := MkFrom(eField, e);
          Nodes[n].s := nm;
          Nodes[n].a := e;
          e := Done(n);
        end;
      end;
    end
    else Break;
  end;
  Result := e;
end;

function ParseUnary: Integer;
var
  n: Integer;
begin
  if PreExpr <> 0 then
  begin
    n := PreExpr;
    PreExpr := 0;
    Result := ParsePostfix(n);
    Exit;
  end;
  if IsPunct('-') or IsPunct('!') then
  begin
    n := MkN(eUnary);
    Nodes[n].s := CurS;
    Adv;
    Nodes[n].a := ParseUnary;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('*') then
  begin
    n := MkN(eDeref);
    Adv;
    Nodes[n].a := ParseUnary;
    Result := Done(n);
    Exit;
  end;
  if IsPunct('&') or IsPunct('&&') then
  begin
    n := MkN(eRef);
    if IsPunct('&&') then SplitFirst else Adv;
    if IsKw('mut') then begin Adv; Nodes[n].f := 1; end
    else if IsKw('raw') and (PeekKw(1, 'const') or PeekKw(1, 'mut')) then
    begin
      Adv;
      Nodes[n].f := 2;
      if IsKw('mut') then Nodes[n].f := 3;
      Adv;
    end;
    Nodes[n].a := ParseUnary;
    Result := Done(n);
    Exit;
  end;
  Result := ParsePostfix(ParsePrimary);
end;

{ ---- blocs et instructions ---- }

function IsItemStart: Boolean;
begin
  Result := False;
  if CurK <> tkIdent then Exit;
  if Toks[TokPos].raw then Exit;
  if IsKw('fn') or IsKw('struct') or IsKw('enum') or IsKw('impl') or IsKw('trait') or IsKw('mod') or
     IsKw('use') or IsKw('type') or IsKw('pub') then Result := True
  else if IsKw('static') then Result := not (PeekPunct(1, '|') or PeekPunct(1, '||'))
  else if IsKw('const') then
    Result := not PeekPunct(1, '{') and not PeekPunct(1, '|') and not PeekPunct(1, '||')
  else if IsKw('unsafe') then
    Result := PeekKw(1, 'fn') or PeekKw(1, 'impl') or PeekKw(1, 'trait') or PeekKw(1, 'extern')
  else if IsKw('extern') then Result := True
  else if CurS = 'macro_rules' then Result := PeekPunct(1, '!')
  else if CurS = 'union' then Result := (PeekK(1) = tkIdent) and (PeekPunct(2, '{') or PeekPunct(2, '<'));
end;

function ParseBlock: Integer;
var
  n, st, e, it, i: Integer;
  items: TIntArr;
  sv, semi, blk: Boolean;
  at: string;
  sk: Boolean;
begin
  n := MkN(eBlock);
  ExpectPunct('{');
  sv := NoStruct;
  NoStruct := False;
  while not IsPunct('}') do
  begin
    if CurK = tkEOF then ErrExpected('`}`');
    if AcceptPunct(';') then Continue;
    at := '';
    sk := False;
    ParseAttrs(at, sk);
    if IsPunct('}') then Break;
    if IsItemStart then
    begin
      items := nil;
      ParseItemInto(items);
      for i := 0 to Length(items) - 1 do
      begin
        if sk then Continue;
        st := MkN(sItem);
        Nodes[st].line := Nodes[items[i]].line;
        Nodes[st].col := Nodes[items[i]].col;
        Nodes[st].fi := Nodes[items[i]].fi;
        Nodes[st].a := items[i];
        IAdd(Nodes[n].l, st);
      end;
      Continue;
    end;
    if IsKw('let') then
    begin
      st := MkN(sLet);
      Adv;
      Nodes[st].a := ParsePat;
      if AcceptPunct(':') then Nodes[st].b := ParseType;
      if AcceptPunct('=') then
      begin
        Nodes[st].c := ParseExpr;
        if IsKw('else') then
        begin
          Adv;
          Nodes[st].d := ParseBlock;
        end;
      end;
      ExpectPunct(';');
      Fin(st);
      if not sk then IAdd(Nodes[n].l, st);
      Continue;
    end;
    { macro utilisateur en position d'instruction }
    if (CurK = tkIdent) and PeekPunct(1, '!') and IsUserMacro(CurS) then
    begin
      if MacroInvoke(CurS, CtxStmt, TokPos) then Continue;
    end;
    st := MkN(sExpr);
    if IsBlockLikeStart then
    begin
      e := ParseBlockLike;
      if IsPunct('.') or IsPunct('?') then
      begin
        PreExpr := e;
        e := ParseExpr;
        blk := False;
      end
      else blk := True;
    end
    else
    begin
      e := ParseExpr;
      blk := False;
      { macro avec accolades : se termine sans point-virgule }
      if (Nodes[e].k = eMacro) and (Nodes[e].s2 = '}') then blk := True;
    end;
    Nodes[st].a := e;
    if AcceptPunct(';') then Nodes[st].f := 1
    else if IsPunct('}') then
    begin
      if not sk then
      begin
        Nodes[n].a := e;
        Fin(st);
        Continue;
      end;
    end
    else if not blk then
      ParseErr('expected `;`, found ' + TokDesc(Toks[TokPos]), 'expected `;`')
    else
      Nodes[st].f := 0;
    Fin(st);
    if not sk then IAdd(Nodes[n].l, st);
  end;
  ExpectPunct('}');
  NoStruct := sv;
  Result := Done(n);
end;

{ ---- items ---- }

procedure RegisterMacro(const name: string; firstTok, lastTok: Integer); forward;
procedure ParseFileItems(fi: Integer; const modDir: string; var lst: TIntArr); forward;

function ParseVis: Integer;
begin
  Result := 0;
  if IsKw('pub') then
  begin
    Adv;
    Result := fPub;
    if IsPunct('(') and (PeekKw(1, 'crate') or PeekKw(1, 'super') or PeekKw(1, 'self') or PeekKw(1, 'in')) then
    begin
      while not IsPunct(')') do Adv;
      Adv;
    end;
  end;
end;

procedure ParseGenericsInto(node: Integer);
var
  tmp: TIntArr;
begin
  tmp := nil;
  ParseGenerics(tmp);
  Nodes[node].l := tmp;
end;

procedure ParseFnParams(fn: Integer);
var
  p, sp: Integer;
begin
  ExpectPunct('(');
  while not IsPunct(')') do
  begin
    { attributs de parametre }
    if IsPunct('#') then
    begin
      while not IsPunct(']') do Adv;
      Adv;
    end;
    if IsPunct('...') then
    begin
      Adv;
      Nodes[fn].f := Nodes[fn].f or fVariadic;
      Break;
    end;
    if IsKw('self') or (IsKw('mut') and PeekKw(1, 'self')) or
       (IsPunct('&') and (PeekKw(1, 'self') or (PeekKw(1, 'mut') and PeekKw(2, 'self')) or
         ((PeekK(1) = tkLifetime) and (PeekKw(2, 'self') or (PeekKw(2, 'mut') and PeekKw(3, 'self')))))) then
    begin
      sp := MkN(nSelfParam);
      if IsPunct('&') then
      begin
        Adv;
        Nodes[sp].f := 1;
        if CurK = tkLifetime then Adv;
        if AcceptKw('mut') then Nodes[sp].f := Nodes[sp].f or 2;
      end
      else if AcceptKw('mut') then Nodes[sp].f := 2;
      ExpectKw('self');
      if AcceptPunct(':') then Nodes[sp].a := ParseType;
      Fin(sp);
      IAdd(Nodes[fn].l2, sp);
    end
    else
    begin
      p := MkN(nParam);
      { parametre anonyme (type seul) dans les declarations de trait }
      Nodes[p].a := ParsePatNoTop;
      if AcceptPunct(':') then Nodes[p].b := ParseType;
      Fin(p);
      IAdd(Nodes[fn].l2, p);
    end;
    if not AcceptPunct(',') then Break;
  end;
  ExpectPunct(')');
end;

function ParseFn(vis: Integer; const at: string): Integer;
var
  n: Integer;
  w: TIntArr;
  i: Integer;
begin
  n := MkN(nFn);
  Nodes[n].f := vis;
  Nodes[n].at := at;
  while not IsKw('fn') do
  begin
    if AcceptKw('const') then Nodes[n].f := Nodes[n].f or fConstFn
    else if AcceptKw('unsafe') then Nodes[n].f := Nodes[n].f or fUnsafe
    else if AcceptKw('async') then
    else if AcceptKw('extern') then
    begin
      Nodes[n].f := Nodes[n].f or fExtern;
      if CurK = tkStr then begin Nodes[n].s2 := CurS; Adv; end else Nodes[n].s2 := 'C';
    end
    else if IsKw('default') then Adv
    else ErrExpected('`fn`');
  end;
  ExpectKw('fn');
  Nodes[n].s := ExpectIdent;
  ParseGenericsInto(n);
  ParseFnParams(n);
  if AcceptPunct('->') then Nodes[n].a := ParseType;
  w := nil;
  ParseWhere(w);
  for i := 0 to Length(w) - 1 do IAdd(Nodes[n].l, w[i]);
  if IsPunct('{') then
  begin
    Nodes[n].b := ParseBlock;
    Nodes[n].f := Nodes[n].f or fHasBody;
  end
  else ExpectPunct(';');
  Result := Done(n);
end;

procedure ParseFieldList(owner: Integer; tuple: Boolean);
var
  f: Integer;
  at: string;
  sk: Boolean;
  vis: Integer;
begin
  if tuple then
  begin
    ExpectPunct('(');
    while not IsPunct(')') do
    begin
      at := ''; sk := False;
      ParseAttrs(at, sk);
      f := MkN(nField);
      Nodes[f].f := ParseVis;
      Nodes[f].s := IntToStr(Length(Nodes[owner].l2));
      Nodes[f].a := ParseType;
      Fin(f);
      IAdd(Nodes[owner].l2, f);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct(')');
  end
  else
  begin
    ExpectPunct('{');
    while not IsPunct('}') do
    begin
      at := ''; sk := False;
      ParseAttrs(at, sk);
      f := MkN(nField);
      Nodes[f].f := ParseVis;
      Nodes[f].s := ExpectIdent;
      ExpectPunct(':');
      Nodes[f].a := ParseType;
      Fin(f);
      IAdd(Nodes[owner].l2, f);
      if not AcceptPunct(',') then Break;
    end;
    ExpectPunct('}');
  end;
end;

function ParseStruct(vis: Integer; const at: string): Integer;
var
  n, i: Integer;
  w: TIntArr;
begin
  n := MkN(nStruct);
  Adv; { struct / union }
  Nodes[n].f := vis;
  Nodes[n].at := at;
  Nodes[n].s := ExpectIdent;
  ParseGenericsInto(n);
  w := nil;
  ParseWhere(w);
  if IsPunct('(') then
  begin
    Nodes[n].f := Nodes[n].f or (1 shl 8);
    ParseFieldList(n, True);
    ParseWhere(w);
    ExpectPunct(';');
  end
  else if IsPunct('{') then
  begin
    ParseFieldList(n, False);
  end
  else
  begin
    Nodes[n].f := Nodes[n].f or (2 shl 8);
    ExpectPunct(';');
  end;
  for i := 0 to Length(w) - 1 do IAdd(Nodes[n].l, w[i]);
  Result := Done(n);
end;

function ParseEnum(vis: Integer; const at: string): Integer;
var
  n, v, i: Integer;
  w: TIntArr;
  vat: string;
  sk: Boolean;
begin
  n := MkN(nEnum);
  Adv;
  Nodes[n].f := vis;
  Nodes[n].at := at;
  Nodes[n].s := ExpectIdent;
  ParseGenericsInto(n);
  w := nil;
  ParseWhere(w);
  for i := 0 to Length(w) - 1 do IAdd(Nodes[n].l, w[i]);
  ExpectPunct('{');
  while not IsPunct('}') do
  begin
    vat := ''; sk := False;
    ParseAttrs(vat, sk);
    v := MkN(nVariant);
    Nodes[v].s := ExpectIdent;
    if IsPunct('(') then
    begin
      Nodes[v].f := 1 shl 8;
      ParseFieldList(v, True);
    end
    else if IsPunct('{') then ParseFieldList(v, False)
    else Nodes[v].f := 2 shl 8;
    if AcceptPunct('=') then Nodes[v].a := ParseExpr;
    Fin(v);
    IAdd(Nodes[n].l2, v);
    if not AcceptPunct(',') then Break;
  end;
  ExpectPunct('}');
  Result := Done(n);
end;

function ParseTypeAlias(vis: Integer): Integer;
var
  n: Integer;
  w: TIntArr;
begin
  n := MkN(nTypeAlias);
  ExpectKw('type');
  Nodes[n].f := vis;
  Nodes[n].s := ExpectIdent;
  ParseGenericsInto(n);
  if AcceptPunct(':') then ParseBoundsInto(n, 3);
  w := nil;
  ParseWhere(w);
  if AcceptPunct('=') then Nodes[n].a := ParseType;
  ParseWhere(w);
  ExpectPunct(';');
  Result := Done(n);
end;

function ParseConstStatic(vis: Integer): Integer;
var
  n: Integer;
begin
  if IsKw('const') then n := MkN(nConst) else n := MkN(nStatic);
  Nodes[n].f := vis;
  Adv;
  if AcceptKw('mut') then Nodes[n].f := Nodes[n].f or fMutStatic;
  if (CurK = tkIdent) and (CurS = '_') then begin Nodes[n].s := '_'; Adv; end
  else Nodes[n].s := ExpectIdent;
  if AcceptPunct(':') then Nodes[n].a := ParseType;
  if AcceptPunct('=') then Nodes[n].b := ParseExpr;
  ExpectPunct(';');
  Result := Done(n);
end;

procedure ParseAssocItems(owner: Integer; inTrait: Boolean);
var
  at: string;
  sk: Boolean;
  vis, it: Integer;
begin
  ExpectPunct('{');
  while not IsPunct('}') do
  begin
    if CurK = tkEOF then ErrExpected('`}`');
    at := ''; sk := False;
    ParseAttrs(at, sk);
    vis := ParseVis;
    if IsKw('default') and not PeekPunct(1, '{') then Adv;
    if IsKw('type') then it := ParseTypeAlias(vis)
    else if IsKw('const') and not (PeekKw(1, 'fn') or PeekKw(1, 'unsafe') or PeekKw(1, 'async') or PeekKw(1, 'extern')) then
      it := ParseConstStatic(vis)
    else if IsKw('fn') or IsKw('const') or IsKw('unsafe') or IsKw('async') or IsKw('extern') then
      it := ParseFn(vis, at)
    else if (CurK = tkIdent) and PeekPunct(1, '!') then
    begin
      if IsUserMacro(CurS) and MacroInvoke(CurS, CtxItem, TokPos) then Continue;
      ErrExpected('item');
      it := 0;
    end
    else
    begin
      ErrExpected('associated item');
      it := 0;
    end;
    if not sk then IAdd(Nodes[owner].l2, it);
  end;
  ExpectPunct('}');
end;

function ParseImpl(vis: Integer; const at: string): Integer;
var
  n, t, i: Integer;
  w: TIntArr;
begin
  n := MkN(nImpl);
  if IsKw('unsafe') then begin Adv; Nodes[n].f := fUnsafe; end;
  ExpectKw('impl');
  Nodes[n].at := at;
  { generiques : impl<T> ... mais pas impl <T as X>::Y }
  if IsPunct('<') then ParseGenericsInto(n);
  if IsPunct('!') then Adv;
  t := ParseType;
  if AcceptKw('for') then
  begin
    Nodes[n].b := t;
    Nodes[n].a := ParseType;
  end
  else Nodes[n].a := t;
  w := nil;
  ParseWhere(w);
  for i := 0 to Length(w) - 1 do IAdd(Nodes[n].l, w[i]);
  ParseAssocItems(n, False);
  Result := Done(n);
end;

function ParseTrait(vis: Integer; const at: string): Integer;
var
  n, i: Integer;
  w: TIntArr;
begin
  n := MkN(nTrait);
  if IsKw('unsafe') then Adv;
  ExpectKw('trait');
  Nodes[n].f := vis;
  Nodes[n].at := at;
  Nodes[n].s := ExpectIdent;
  ParseGenericsInto(n);
  if AcceptPunct(':') then ParseBoundsInto(n, 3);
  w := nil;
  ParseWhere(w);
  for i := 0 to Length(w) - 1 do IAdd(Nodes[n].l, w[i]);
  ParseAssocItems(n, True);
  Result := Done(n);
end;

procedure ParseUseTree(const prefix: string; vis: Integer; var lst: TIntArr);
var
  n: Integer;
  path, nm, alias: string;
begin
  path := prefix;
  AcceptPunct('::');
  while True do
  begin
    if IsPunct('{') then
    begin
      Adv;
      while not IsPunct('}') do
      begin
        ParseUseTree(path, vis, lst);
        if not AcceptPunct(',') then Break;
      end;
      ExpectPunct('}');
      Exit;
    end;
    if IsPunct('*') then
    begin
      Adv;
      n := MkN(nUse);
      Nodes[n].s := path;
      Nodes[n].f := vis or fGlob;
      Fin(n);
      IAdd(lst, n);
      Exit;
    end;
    nm := ExpectIdent;
    if (nm = 'self') and (path <> '') and not IsPunct('::') then
    begin
      // use a::b::{self} : importe a::b sous le nom b
      nm := '';
    end
    else if path = '' then path := nm else path := path + '::' + nm;
    if IsPunct('::') then
    begin
      Adv;
      Continue;
    end;
    Break;
  end;
  n := MkN(nUse);
  Nodes[n].s := path;
  Nodes[n].f := vis;
  if AcceptKw('as') then
  begin
    if (CurK = tkIdent) and (CurS = '_') then begin alias := '_'; Adv; end
    else alias := ExpectIdent;
    Nodes[n].s2 := alias;
  end;
  Fin(n);
  IAdd(lst, n);
end;

function ParseMod(vis: Integer; const at: string; skip: Boolean): Integer;
var
  n, fi: Integer;
  nm, f1, f2, saveDir, saveName: string;
  items: TIntArr;
  txt: string;
  i: Integer;
  modItems: TIntArr;
begin
  n := MkN(nMod);
  ExpectKw('mod');
  Nodes[n].f := vis;
  Nodes[n].at := at;
  nm := ExpectIdent;
  Nodes[n].s := nm;
  if IsPunct('{') then
  begin
    Adv;
    saveDir := CurModDir;
    CurModDir := CurModDir + nm + '/';
    modItems := nil;
    while not IsPunct('}') do
    begin
      if CurK = tkEOF then ErrExpected('`}`');
      ParseItemInto(modItems);
    end;
    CurModDir := saveDir;
    Nodes[n].l2 := modItems;
    ExpectPunct('}');
  end
  else
  begin
    ExpectPunct(';');
    if not skip then
    begin
      f1 := CurModDir + nm + '.rs';
      f2 := CurModDir + nm + '/mod.rs';
      if FileExists(f1) then
      begin
        ReadFileToString(f1, txt);
        fi := AddSourceFile(f1, txt);
        items := nil;
        ParseFileItems(fi, CurModDir + nm + '/', items);
        Nodes[n].l2 := items;
      end
      else if FileExists(f2) then
      begin
        ReadFileToString(f2, txt);
        fi := AddSourceFile(f2, txt);
        items := nil;
        ParseFileItems(fi, CurModDir + nm + '/', items);
        Nodes[n].l2 := items;
      end
      else
      begin
        Report(True, 'E0583', 'file not found for module `' + nm + '`', Nodes[n].fi, Nodes[n].line, Nodes[n].col,
               Length('mod ' + nm), '');
        Help('to create the module `' + nm + '`, create file "' + f1 + '" or "' + f2 + '"');
        FinishDiag;
      end;
    end;
  end;
  Result := Done(n);
end;

procedure ParseItemInto(var lst: TIntArr);
var
  at: string;
  sk: Boolean;
  vis, n, i, st, en, depth: Integer;
  nm: string;
  items: TIntArr;
  tmp: TIntArr;
  isExtern: Boolean;
begin
  at := '';
  sk := False;
  ParseAttrs(at, sk);
  vis := ParseVis;
  if CurK <> tkIdent then
  begin
    if IsPunct(';') then begin Adv; Exit; end;
    ErrExpected('item');
  end;
  n := 0;
  if IsKw('fn') or ((IsKw('const') or IsKw('async') or IsKw('unsafe') or IsKw('extern')) and
     (PeekKw(1, 'fn') or PeekKw(1, 'unsafe') or PeekKw(1, 'extern') or PeekKw(1, 'async') or
      ((PeekK(1) = tkStr) and PeekKw(2, 'fn')))) and not (IsKw('extern') and (PeekK(1) = tkStr) and PeekPunct(2, '{')) then
    n := ParseFn(vis, at)
  else if IsKw('struct') then n := ParseStruct(vis, at)
  else if IsKw('union') then n := ParseStruct(vis, at)
  else if IsKw('enum') then n := ParseEnum(vis, at)
  else if IsKw('impl') or (IsKw('unsafe') and PeekKw(1, 'impl')) then n := ParseImpl(vis, at)
  else if IsKw('trait') or (IsKw('unsafe') and PeekKw(1, 'trait')) then n := ParseTrait(vis, at)
  else if IsKw('mod') then n := ParseMod(vis, at, sk)
  else if IsKw('type') then n := ParseTypeAlias(vis)
  else if IsKw('const') or IsKw('static') then n := ParseConstStatic(vis)
  else if IsKw('use') then
  begin
    Adv;
    tmp := nil;
    ParseUseTree('', vis, tmp);
    ExpectPunct(';');
    for i := 0 to Length(tmp) - 1 do IAdd(items, tmp[i]);
    if not sk then
      for i := 0 to Length(tmp) - 1 do IAdd(lst, tmp[i]);
    Exit;
  end
  else if IsKw('extern') then
  begin
    { extern crate x ; ou bloc extern "C" }
    n := MkN(nExternBlock);
    Adv;
    if IsKw('crate') then
    begin
      while not IsPunct(';') do Adv;
      Adv;
      Exit;
    end;
    if CurK = tkStr then begin Nodes[n].s := CurS; Adv; end else Nodes[n].s := 'C';
    ExpectPunct('{');
    while not IsPunct('}') do
    begin
      st := 0;
      ParseAttrs(at, sk);
      i := ParseVis;
      if IsKw('static') then st := ParseConstStatic(i)
      else
      begin
        if IsKw('fn') or IsKw('unsafe') then st := ParseFn(i, '')
        else ErrExpected('foreign item');
        Nodes[st].f := Nodes[st].f or fExtern;
        Nodes[st].s2 := Nodes[n].s;
      end;
      IAdd(Nodes[n].l2, st);
    end;
    ExpectPunct('}');
    Done(n);
  end
  else if (CurK = tkIdent) and (CurS = 'macro_rules') and PeekPunct(1, '!') then
  begin
    st := TokPos;
    Adv; Adv;
    nm := ExpectIdent;
    if not (IsPunct('{') or IsPunct('(') or IsPunct('[')) then ErrExpected('`{`');
    depth := 0;
    en := TokPos;
    repeat
      if IsPunct('{') or IsPunct('(') or IsPunct('[') then Inc(depth)
      else if IsPunct('}') or IsPunct(')') or IsPunct(']') then Dec(depth);
      en := TokPos;
      Adv;
    until (depth = 0) or (CurK = tkEOF);
    AcceptPunct(';');
    RegisterMacro(nm, st, en);
    Exit;
  end
  else if (CurK = tkIdent) and PeekPunct(1, '!') then
  begin
    if IsUserMacro(CurS) then
    begin
      if MacroInvoke(CurS, CtxItem, TokPos) then Exit;
    end;
    Report(True, '', 'cannot find macro `' + CurS + '` in this scope', Toks[TokPos].fi, Toks[TokPos].line,
           Toks[TokPos].col, Length(CurS), '');
    FinishDiag;
  end
  else
    ParseErr('expected item, found ' + TokDesc(Toks[TokPos]), 'expected item');
  if (n <> 0) and (not sk) then IAdd(lst, n);
end;

procedure ParseFileItems(fi: Integer; const modDir: string; var lst: TIntArr);
var
  svToks: TTokArr;
  svN, svPos: Integer;
  svDir: string;
begin
  svToks := Toks;
  svN := NToks;
  svPos := TokPos;
  svDir := CurModDir;
  Toks := nil;
  NToks := 0;
  LexFile(fi);
  TokPos := 0;
  CurModDir := modDir;
  while CurK <> tkEOF do
    ParseItemInto(lst);
  Toks := svToks;
  NToks := svN;
  TokPos := svPos;
  CurModDir := svDir;
end;

{ ============================================================ }
{ Affichage de l'AST (-Z unpretty=ast-tree)                    }
