function LocOfHir(h: Integer): string;
begin
  Result := LocName(Hirs[h].fi) + ':' + IntToStr(Hirs[h].line) + ':' + IntToStr(Hirs[h].col);
end;

procedure RequestStatic(def: Integer);
var
  key: string;
  i: Integer;
begin
  if IIndexOf(StaticDefs, def) >= 0 then Exit;
  IAdd(StaticDefs, def);
  if Defs[def].isExtern then Exit;
  key := 's' + IntToStr(def);
  if NInsts >= Length(Insts) then SetLength(Insts, NInsts * 2 + 64);
  i := NInsts;
  Inc(NInsts);
  Insts[i].def := def;
  Insts[i].targs := nil;
  Insts[i].key := key;
  Insts[i].kind := ikStaticInit;
  Insts[i].closure := -1;
  Insts[i].built := False;
  Insts[i].mir := -1;
  Insts[i].external := False;
  Insts[i].intrinsic := False;
  Insts[i].sym := UniqueSym('static_init.' + Defs[def].name);
  HPut(InstMap, key, i);
end;

function ResolvedInst(def: Integer; const targs: TIntArr): Integer;
var
  d: Integer;
  ta: TIntArr;
  i: Integer;
begin
  d := def;
  ta := nil;
  for i := 0 to Length(targs) - 1 do IAdd(ta, Zonk(targs[i]));
  ResolveInstance(d, ta);
  Result := RequestInst(d, ta);
end;

procedure MakeCall(def: Integer; const targs: TIntArr; const args: TOperandArr; const dest: TPlace; hasDest: Boolean;
  retTy: Integer; h: Integer);
var
  t: TTerm;
  idx, nb: Integer;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmCall;
  t.retTy := retTy;
  idx := ResolvedInst(def, targs);
  t.inst := idx;
  t.def := Insts[idx].def;
  t.targs := Insts[idx].targs;
  t.sym := Insts[idx].sym;
  if Insts[idx].intrinsic then t.callKind := ckIntrinsic else t.callKind := ckDirect;
  if Insts[idx].intrinsic then t.sym := Defs[Insts[idx].def].name;
  t.args := args;
  t.dest := dest;
  t.hasDest := hasDest;
  if h > 0 then
  begin
    t.loc := LocOfHir(h);
    t.line := Hirs[h].line;
    t.col := Hirs[h].col;
  end;
  if Tys[Shallow(retTy)].k = tyNever then
  begin
    t.target := -1;
    SetTerm(t);
    CurBB := NewBB;
  end
  else
  begin
    nb := NewBB;
    t.target := nb;
    SetTerm(t);
    CurBB := nb;
  end;
end;

function RefOfPlace(const p: TPlace; mut: Boolean): TOperand;
var
  tmp: TPlace;
  rv: TRvalue;
begin
  tmp := NewTemp(MkRef(p.ty, mut));
  rv := MkRv(rvRef, tmp.ty);
  rv.place := p;
  rv.mut := mut;
  EmitAssign(tmp, rv);
  Result := OCopyPlace(tmp);
end;

{ ---- operateurs arithmetiques ---- }

function BinOpName(const op: string): string;
begin
  if op = '+' then Result := 'Add'
  else if op = '-' then Result := 'Sub'
  else if op = '*' then Result := 'Mul'
  else if op = '/' then Result := 'Div'
  else if op = '%' then Result := 'Rem'
  else if op = '&' then Result := 'BitAnd'
  else if op = '|' then Result := 'BitOr'
  else if op = '^' then Result := 'BitXor'
  else if op = '<<' then Result := 'Shl'
  else if op = '>>' then Result := 'Shr'
  else if op = '==' then Result := 'Eq'
  else if op = '!=' then Result := 'Ne'
  else if op = '<' then Result := 'Lt'
  else if op = '<=' then Result := 'Le'
  else if op = '>' then Result := 'Gt'
  else if op = '>=' then Result := 'Ge'
  else Result := op;
end;

function OpVerb(const op: string): string;
begin
  if op = '+' then Result := 'add'
  else if op = '-' then Result := 'subtract'
  else if op = '*' then Result := 'multiply'
  else if op = '/' then Result := 'divide'
  else if op = '%' then Result := 'calculate the remainder'
  else if op = '<<' then Result := 'shift left'
  else if op = '>>' then Result := 'shift right'
  else Result := 'negate';
end;

procedure EmitAssert(const cond: TOperand; expect: Boolean; const msg: string; h: Integer);
var
  t: TTerm;
  nb: Integer;
begin
  FillChar(t, SizeOf(t), 0);
  t.k := tmAssert;
  t.cond := cond;
  t.expect := expect;
  t.msg := msg;
  if h > 0 then
  begin
    t.loc := LocOfHir(h);
    t.line := Hirs[h].line;
    t.col := Hirs[h].col;
  end;
  nb := NewBB;
  t.target := nb;
  SetTerm(t);
  CurBB := nb;
end;

function IntMinOperand(ty: Integer): TOperand;
var
  bits: Integer;
  v: Int64;
begin
  bits := Tys[ty].n;
  if bits >= 64 then v := Low(Int64) else v := -(Int64(1) shl (bits - 1));
  Result := OInt(ty, v);
end;

procedure EmitBinary(const op: string; const a, b: TOperand; ty: Integer; const dest: TPlace; h: Integer);
var
  rv: TRvalue;
  tmp, c1, c2, c3: TPlace;
  tupTy: Integer;
  ta: TIntArr;
  isInt, isSigned: Boolean;
  bits: Integer;
  zero: TOperand;
  tt: Integer;
begin
  tt := Shallow(ty);
  isInt := Tys[tt].k = tyInt;
  isSigned := isInt and ((Tys[tt].f and 1) <> 0);
  if isInt and OvfChecks and ((op = '+') or (op = '-') or (op = '*')) then
  begin
    SetLength(ta, 2);
    ta[0] := tt;
    ta[1] := TyBoolT;
    tupTy := MkTuple(ta);
    tmp := NewTemp(tupTy);
    rv := MkRv(rvCheckedBin, tupTy);
    rv.op := BinOpName(op);
    rv.a := a;
    rv.b := b;
    EmitAssign(tmp, rv);
    EmitAssert(OCopyPlace(PProj(tmp, peField, 1, TyBoolT)), False, 'attempt to ' + OpVerb(op) + ' with overflow', h);
    AssignOp(dest, OCopyPlace(PProj(tmp, peField, 0, tt)));
    Exit;
  end;
  if isInt and ((op = '/') or (op = '%')) then
  begin
    zero := OInt(tt, 0);
    c1 := NewTemp(TyBoolT);
    rv := MkRv(rvBin, TyBoolT);
    rv.op := 'Eq';
    rv.a := b;
    rv.b := zero;
    EmitAssign(c1, rv);
    if op = '/' then
      EmitAssert(OCopyPlace(c1), False, 'attempt to divide by zero', h)
    else
      EmitAssert(OCopyPlace(c1), False, 'attempt to calculate the remainder with a divisor of zero', h);
    if isSigned then
    begin
      { MIN / -1 }
      c2 := NewTemp(TyBoolT);
      rv := MkRv(rvBin, TyBoolT);
      rv.op := 'Eq';
      rv.a := b;
      rv.b := OInt(tt, -1);
      EmitAssign(c2, rv);
      c3 := NewTemp(TyBoolT);
      rv := MkRv(rvBin, TyBoolT);
      rv.op := 'Eq';
      rv.a := a;
      rv.b := IntMinOperand(tt);
      EmitAssign(c3, rv);
      tmp := NewTemp(TyBoolT);
      rv := MkRv(rvBin, TyBoolT);
      rv.op := 'BitAnd';
      rv.a := OCopyPlace(c2);
      rv.b := OCopyPlace(c3);
      EmitAssign(tmp, rv);
      if op = '/' then
        EmitAssert(OCopyPlace(tmp), False, 'attempt to divide with overflow', h)
      else
        EmitAssert(OCopyPlace(tmp), False, 'attempt to calculate the remainder with overflow', h);
    end;
  end;
  if isInt and OvfChecks and ((op = '<<') or (op = '>>')) then
  begin
    bits := Tys[tt].n;
    c1 := NewTemp(TyBoolT);
    rv := MkRv(rvBin, TyBoolT);
    rv.op := 'Lt';
    rv.a := b;
    rv.b := OInt(b.ty, bits);
    { l'operande de decalage peut etre signe ou non : on compare au meme type }
    if (Tys[Shallow(b.ty)].k = tyInt) and ((Tys[Shallow(b.ty)].f and 1) <> 0) then rv.op := 'Lt';
    EmitAssign(c1, rv);
    EmitAssert(OCopyPlace(c1), True, 'attempt to ' + OpVerb(op) + ' with overflow', h);
  end;
  rv := MkRv(rvBin, Hirs[h].ty);
  rv.op := BinOpName(op);
  rv.a := a;
  rv.b := b;
  if (op = '==') or (op = '!=') or (op = '<') or (op = '<=') or (op = '>') or (op = '>=') then rv.ty := TyBoolT
  else rv.ty := tt;
  rv.srcTy := tt;
  EmitAssign(dest, rv);
end;

{ ---- appels ---- }

function EvalArgs(const l: TIntArr): TOperandArr;
var
  i, j: Integer;
  snap: Boolean;
  op: TOperand;
  t: TPlace;
begin
  SetLength(Result, Length(l));
  for i := 0 to Length(l) - 1 do
  begin
    op := ExprOp(l[i]);
    { copie les operandes de place si un argument suivant a des effets de bord }
    if (op.k <> opConst) and (i < Length(l) - 1) then
    begin
      snap := False;
      for j := i + 1 to Length(l) - 1 do
        if not IsPureHir(l[j]) then snap := True;
      if snap then
      begin
        t := NewTemp(op.ty);
        AssignOp(t, op);
        op := OCopyPlace(t);
        if op.k = opCopy then ;
      end;
    end;
    Result[i] := op;
  end;
end;

procedure LowerCall(h: Integer; const dest: TPlace; hasDest: Boolean);
var
  callee: Integer;
  args: TOperandArr;
  t: TTerm;
  op, envOp: TOperand;
  cty, nb, cid, idx: Integer;
  full: TOperandArr;
  i: Integer;
  cplace: TPlace;
begin
  callee := Hirs[h].a;
  if Hirs[h].k = hCall then
  begin
    if Hirs[callee].k = hFnRef then
    begin
      args := EvalArgs(Hirs[h].l);
      MakeCall(Hirs[callee].def, Hirs[callee].targs, args, dest, hasDest, Hirs[h].ty, h);
      Exit;
    end;
    { pointeur de fonction }
    op := ExprOp(callee);
    args := EvalArgs(Hirs[h].l);
    FillChar(t, SizeOf(t), 0);
    t.k := tmCall;
    t.retTy := Hirs[h].ty;
    t.callKind := ckIndirect;
    t.callee := op;
    t.args := args;
    t.dest := dest;
    t.hasDest := hasDest;
    t.loc := LocOfHir(h);
    if Tys[Shallow(Hirs[h].ty)].k = tyNever then
    begin
      t.target := -1;
      SetTerm(t);
      CurBB := NewBB;
    end
    else
    begin
      nb := NewBB;
      t.target := nb;
      SetTerm(t);
      CurBB := nb;
    end;
    Exit;
  end;
  { appel de fermeture (ou objet-trait Fn) }
  cty := Shallow(Hirs[callee].ty);
  cplace := HirPlaceOrTemp(callee);
  envOp := RefOfPlace(cplace, True);
  args := EvalArgs(Hirs[h].l);
  SetLength(full, Length(args) + 1);
  full[0] := envOp;
  for i := 0 to Length(args) - 1 do full[i + 1] := args[i];
  FillChar(t, SizeOf(t), 0);
  t.k := tmCall;
  t.retTy := Hirs[h].ty;
  t.args := full;
  t.dest := dest;
  t.hasDest := hasDest;
  t.loc := LocOfHir(h);
  if Tys[cty].k = tyClosure then
  begin
    cid := Tys[cty].def;
    idx := RequestClosureInst(cid);
    t.callKind := ckClosureCall;
    t.inst := idx;
    t.sym := Insts[idx].sym;
  end
  else
  begin
    t.callKind := ckVirtual;
    t.def := cty;
    t.sym := 'call';
  end;
  if Tys[Shallow(Hirs[h].ty)].k = tyNever then
  begin
    t.target := -1;
    SetTerm(t);
    CurBB := NewBB;
  end
  else
  begin
    nb := NewBB;
    t.target := nb;
    SetTerm(t);
    CurBB := nb;
  end;
end;

