Type
  TNode = record
    k, fi, line, col, eline, ecol, f: Integer;
    s, s2, at: string;
    a, b, c, d: Integer;
    l, l2, l3: TIntArr;
    iv: QWord;
    fv: Double;
    id: Integer;
  end;

Var
  Nodes: array of TNode;
  NNodes: Integer;

function NewNode(k: Integer): Integer;
begin
  if NNodes >= Length(Nodes) then SetLength(Nodes, Length(Nodes) * 2 + 4096);
  Result := NNodes;
  Inc(NNodes);
  Nodes[Result].k := k;
  Nodes[Result].id := -1;
end;

