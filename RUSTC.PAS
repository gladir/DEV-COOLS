Type
  TClosure = record
    params: TIntArr;
    ret: Integer;
    node: Integer;
    owner: Integer;       { instance proprietaire (indice) }
    isMove: Boolean;
    capVars: TIntArr;     { variables locales capturees (indices HIR) }
    capByRef: TIntArr;    { 1 = par reference }
    capTys: TIntArr;      { type de chaque capture (type de la variable) }
    sigDone: Boolean;
    selfFn: Integer;      { fonction de fermeture generee }
    isMut: Boolean;
    capKeys: TStrArr;
    bodyIdx: Integer;
  end;

  TProbe = record
    found: Boolean;
    fnDef: Integer;
    implDef: Integer;
    traitDef: Integer;
    fargs: TIntArr;
    steps: Integer;
    adj: Integer;          { 0 aucun, 1 &, 2 &mut }
    unsize: Boolean;
    selfParamTy: Integer;
    recvTy: Integer;       { type du recepteur apres auto-deref }
    inherent: Boolean;
  end;

Var
  Closures: array of TClosure;
  NClosures: Integer;
  SolveBusy: Boolean;
  CopyCache: THashSI;

procedure FnDefSig(def: Integer; const args: TIntArr; var params: TIntArr; var ret: Integer); forward;

function HeadOfTypeNode(tn, d: Integer): string;
var
  segs: TStrArr;
  i, used, r, k: Integer;
begin
  Result := 'other';
  if tn = 0 then Exit;
  case Nodes[tn].k of
    tRef: Result := 'ref';
    tPtr: Result := 'ptr';
    tSlice: Result := 'slice';
    tArray: Result := 'array';
    tTuple: Result := 'tuple' + IntToStr(Length(Nodes[tn].l));
    tFnPtr: Result := 'fnptr';
    tNever: Result := 'never';
    tDyn:
      for i := 0 to Length(Nodes[tn].l) - 1 do
      begin
        r := TraitOfPath(Nodes[tn].l[i], Defs[d].scopeMod);
        if (r >= 0) and (r <> LangSend) and (r <> LangSync) then begin Result := 'dyn' + IntToStr(r); Exit; end;
      end;
    tPath:
      begin
        if Nodes[tn].a <> 0 then Exit;
        segs := nil;
        for i := 0 to Length(Nodes[tn].l) - 1 do SAdd(segs, Nodes[Nodes[tn].l[i]].s);
        if (Length(segs) = 1) and (FindGeneric(d, segs[0]) >= 0) then begin Result := 'var'; Exit; end;
        r := ResolveSegs(Defs[d].scopeMod, segs, 'T', used);
        if (r >= 0) and (used = Length(segs)) then
        begin
          case Defs[r].kind of
            dkStruct, dkEnum: Result := 'adt' + IntToStr(r);
            dkTrait: Result := 'dyn' + IntToStr(r);
            dkTypeAlias: Result := HeadOfTypeNode(Nodes[Defs[r].node].a, r);
          end;
          Exit;
        end;
        if Length(segs) = 1 then
        begin
          k := PrimTy(segs[0]);
          if k >= 0 then Result := TyHeadKey(k);
        end;
      end;
  end;
end;

procedure AddToHeadList(const key: string; impl: Integer);
var
  idx: Integer;
begin
  idx := HFind(HeadMap, key);
  if idx < 0 then
  begin
    if NHeadLists >= Length(HeadLists) then SetLength(HeadLists, NHeadLists * 2 + 64);
    idx := NHeadLists;
    Inc(NHeadLists);
    HeadLists[idx] := nil;
    HPut(HeadMap, key, idx);
  end;
  IAdd(HeadLists[idx], impl);
end;

procedure AddMethodTrait(const nm: string; tr: Integer);
var
  idx: Integer;
begin
  idx := HFind(MethodTraits, nm);
  if idx < 0 then
  begin
    if NMethodLists >= Length(MethodTraitLists) then SetLength(MethodTraitLists, NMethodLists * 2 + 64);
    idx := NMethodLists;
    Inc(NMethodLists);
    MethodTraitLists[idx] := nil;
    HPut(MethodTraits, nm, idx);
  end;
  if IIndexOf(MethodTraitLists[idx], tr) < 0 then IAdd(MethodTraitLists[idx], tr);
end;

procedure IndexImpls;
var
  i, j, d, tr, it: Integer;
  node: Integer;
begin
  for i := 0 to Length(AllTraits) - 1 do
  begin
    tr := AllTraits[i];
    for j := 0 to Length(Defs[tr].items) - 1 do
      if Defs[Defs[tr].items[j]].kind = dkFn then AddMethodTrait(Defs[Defs[tr].items[j]].name, tr);
  end;
  for i := 0 to Length(AllImpls) - 1 do
  begin
    d := AllImpls[i];
    if Defs[d].implDone then Continue;
    Defs[d].implDone := True;
    node := Defs[d].node;
    Defs[d].headKey := HeadOfTypeNode(Nodes[node].a, d);
    if Nodes[node].b <> 0 then
    begin
      tr := TraitOfPath(Nodes[node].b, Defs[d].scopeMod);
      if tr < 0 then
      begin
        DefSpanErr('E0405', 'cannot find trait `' + Nodes[Nodes[Nodes[node].b].l[Length(Nodes[Nodes[node].b].l) - 1]].s +
                   '` in this scope', Nodes[node].b, 'not found in this scope');
        Continue;
      end;
      Defs[d].implTrait := tr;
      IAdd(Defs[tr].impls, d);
    end
    else AddToHeadList(Defs[d].headKey, d);
  end;
end;

{ ---- fermetures ---- }
function NewClosure: Integer;
begin
  if NClosures >= Length(Closures) then SetLength(Closures, NClosures * 2 + 16);
  Result := NClosures;
  Inc(NClosures);
  Closures[Result].params := nil;
  Closures[Result].ret := 0;
  Closures[Result].capVars := nil;
  Closures[Result].capByRef := nil;
  Closures[Result].capTys := nil;
  Closures[Result].capKeys := nil;
  Closures[Result].bodyIdx := -1;
  Closures[Result].selfFn := -1;
end;

{ ---- obligations ---- }

procedure AddObl(kind, selfTy, trait: Integer; const targs: TIntArr; const name: string; res, node: Integer);
begin
  if NObls >= Length(Obls) then SetLength(Obls, NObls * 2 + 64);
  Obls[NObls].kind := kind;
  Obls[NObls].selfTy := selfTy;
  Obls[NObls].trait := trait;
  Obls[NObls].targs := ICopy(targs);
  Obls[NObls].name := name;
  Obls[NObls].res := res;
  Obls[NObls].done := False;
  Obls[NObls].node := node;
  Inc(NObls);
end;

function TyToStr(t: Integer): string; forward;

{ Verifie les bornes d'un impl : 0 non, 1 oui/peut-etre }
function ImplBoundsHold(impl: Integer; var env: TEnv): Boolean;
var
  bs: TBoundArr;
  i, r, impl2: Integer;
  ia: TIntArr;
  t: Integer;
begin
  Result := True;
  if ImplDepth > 6 then Exit;
  LowerBoundsOf(impl, env, bs);
  Inc(ImplDepth);
  for i := 0 to Length(bs) - 1 do
  begin
    t := Shallow(bs[i].subj);
    if Tys[t].k = tyVar then Continue;
    if bs[i].trait = LangSized then Continue;
    r := SelectImpl(bs[i].trait, bs[i].targs, impl2, ia, False);
    if r = 0 then begin Result := False; Break; end;
  end;
  Dec(ImplDepth);
end;

{ Essaie un impl candidat ; en cas de succes avec commit, les variables restent liees }
function ProbeImpl(impl, trait: Integer; const targs: TIntArr; var iargs: TIntArr; commit: Boolean): Boolean;
var
  s, i: Integer;
  env, env2: TEnv;
  tt: TIntArr;
  bn: TStrArr;
  bt: TIntArr;
  node: Integer;
  ok: Boolean;
begin
  s := Snapshot;
  Inc(SuppressDiag);
  iargs := FreshArgs(impl);
  InitEnv(env);
  env.names := Defs[impl].gnames;
  env.tys := iargs;
  env.scope := Defs[impl].scopeMod;
  env.infer := True;
  env.implDef := impl;
  env.traitDef := trait;
  env.defn := impl;
  node := Defs[impl].node;
  env.selfTy := LowerTy(Nodes[node].a, env);
  ok := Unify(targs[0], env.selfTy);
  if ok and (Nodes[node].b <> 0) then
  begin
    tt := nil; bn := nil; bt := nil;
    if ResolveTraitRef(Nodes[node].b, env, env.selfTy, tt, bn, bt) < 0 then ok := False
    else
      for i := 1 to Length(tt) - 1 do
        if (i < Length(targs)) and (not Unify(tt[i], targs[i])) then begin ok := False; Break; end;
  end;
  if ok then ok := ImplBoundsHold(impl, env);
  Dec(SuppressDiag);
  if (not ok) or (not commit) then Rollback(s);
  Result := ok;
end;

function IsMarkerIntHead(const hk: string): Boolean;
begin
  Result := StartsWith(hk, 'int');
end;

{ Retourne 0 aucun impl, 1 un seul, 2 ambigu.  impl = -1 : impl natif (Sized, Fn...) }
function SelectImpl(trait: Integer; const targs: TIntArr; var impl: Integer; var iargs: TIntArr; commit: Boolean): Integer;
var
  selfT, i, cnt, last, k, p: Integer;
  head, hk: string;
  cands: TIntArr;
  tmp: TIntArr;
  params: TIntArr;
  ret: Integer;
  ok: Boolean;
begin
  impl := -1;
  iargs := nil;
  Result := 0;
  selfT := Shallow(targs[0]);
  { traits natifs }
  if trait = LangSized then
  begin
    case Tys[selfT].k of
      tyStr, tySlice, tyDyn: Result := 0;
      tyVar: Result := 2;
    else
      Result := 1;
    end;
    Exit;
  end;
  if (trait = LangFn) or (trait = LangFnMut) or (trait = LangFnOnce) then
  begin
    case Tys[selfT].k of
      tyClosure:
        begin
          params := Closures[Tys[selfT].def].params;
          ok := True;
          if Length(targs) > 1 then
          begin
            if commit then ok := Unify(targs[1], MkTuple(params))
            else ok := TryUnify(targs[1], MkTuple(params));
          end;
          if ok then Result := 1 else Result := 0;
          Exit;
        end;
      tyFnDef:
        begin
          FnDefSig(Tys[selfT].def, Tys[selfT].args, params, ret);
          ok := True;
          if Length(targs) > 1 then ok := TryUnify(targs[1], MkTuple(params));
          if ok then Result := 1 else Result := 0;
          Exit;
        end;
      tyFnPtr:
        begin
          SetLength(params, Length(Tys[selfT].args) - 1);
          for i := 0 to Length(params) - 1 do params[i] := Tys[selfT].args[i];
          ok := True;
          if Length(targs) > 1 then ok := TryUnify(targs[1], MkTuple(params));
          if ok then Result := 1 else Result := 0;
          Exit;
        end;
      tyVar: begin Result := 2; Exit; end;
      tyRef:
        begin
          { &F implemente Fn si F l'implemente }
          tmp := ICopy(targs);
          tmp[0] := Tys[selfT].args[0];
          Result := SelectImpl(trait, tmp, impl, iargs, commit);
          impl := -2;
          Exit;
        end;
      tyAdt:
        if (Defs[Tys[selfT].def].lang = 'box') then
        begin
          tmp := ICopy(targs);
          tmp[0] := Tys[selfT].args[0];
          Result := SelectImpl(trait, tmp, impl, iargs, commit);
          impl := -2;
          Exit;
        end;
    end;
  end;
  if Tys[selfT].k = tyDyn then
  begin
    if TraitIsA(Tys[selfT].def, trait, 0) then
    begin
      Result := 1;
      impl := -3;
      Exit;
    end;
  end;
  if Tys[selfT].k = tyVar then
  begin
    if VarKind[Tys[selfT].n] = 0 then begin Result := 2; Exit; end;
  end;
  head := TyHeadKey(selfT);
  cands := Defs[trait].impls;
  cnt := 0;
  last := -1;
  for i := 0 to Length(cands) - 1 do
  begin
    hk := Defs[cands[i]].headKey;
    if hk <> 'var' then
    begin
      if head = 'var' then
      begin
        if VarKind[Tys[selfT].n] = 1 then begin if not IsMarkerIntHead(hk) then Continue; end
        else if VarKind[Tys[selfT].n] = 2 then begin if not StartsWith(hk, 'f') or StartsWith(hk, 'fn') then Continue; end;
      end
      else if hk <> head then Continue;
    end;
    if ProbeImpl(cands[i], trait, targs, tmp, False) then
    begin
      Inc(cnt);
      last := cands[i];
    end;
  end;
  if cnt = 0 then Result := 0
  else if cnt > 1 then Result := 2
  else
  begin
    Result := 1;
    impl := last;
    ProbeImpl(last, trait, targs, iargs, commit);
    if not commit then ProbeImpl(last, trait, targs, iargs, False);
  end;
end;

function TypeImplements(t, trait: Integer; const extra: TIntArr): Boolean;
var
  targs: TIntArr;
  impl, i: Integer;
  ia: TIntArr;
begin
  SetLength(targs, Length(Defs[trait].gnames));
  targs[0] := t;
  for i := 1 to Length(targs) - 1 do
    if (i - 1 < Length(extra)) then targs[i] := extra[i - 1] else targs[i] := NewTyVar(0);
  Result := SelectImpl(trait, targs, impl, ia, False) <> 0;
end;

function IsCopyTy(t: Integer): Boolean;
var
  key: Integer;
  targs: TIntArr;
  impl: Integer;
  ia: TIntArr;
  i: Integer;
begin
  t := Zonk(t);
  case Tys[t].k of
    tyBool, tyChar, tyInt, tyFloat, tyNever, tyPtr, tyFnDef, tyFnPtr, tyErr: begin Result := True; Exit; end;
    tyRef: begin Result := (Tys[t].f and 1) = 0; Exit; end;
    tyStr, tySlice, tyDyn: begin Result := False; Exit; end;
    tyClosure: begin Result := True; Exit; end;
    tyVar: begin Result := VarKind[Tys[t].n] <> 0; Exit; end;
  end;
  key := HFind(CopyCache, IntToStr(t));
  if key >= 0 then begin Result := key = 1; Exit; end;
  SetLength(targs, 1);
  targs[0] := t;
  Result := SelectImpl(LangCopy, targs, impl, ia, False) = 1;
  if Result then HPut(CopyCache, IntToStr(t), 1) else HPut(CopyCache, IntToStr(t), 0);
end;

{ Type associe : <selfTy as trait<targs>>::name }
function ProjectAssoc(selfTy, trait: Integer; const targs: TIntArr; const name: string; errNode: Integer): Integer;
var
  selfT, r, impl, item, i: Integer;
  iargs: TIntArr;
  env: TEnv;
  res: Integer;
  params: TIntArr;
  ret: Integer;
begin
  selfT := Shallow(selfTy);
  if Tys[selfT].k = tyErr then begin Result := TyErrT; Exit; end;
  if Tys[selfT].k = tyVar then
  begin
    res := NewTyVar(0);
    AddObl(oblProj, selfT, trait, targs, name, res, errNode);
    Result := res;
    Exit;
  end;
  { FnOnce::Output des fermetures, pointeurs et fonctions }
  if ((trait = LangFnOnce) or (trait = LangFnMut) or (trait = LangFn)) and (name = 'Output') then
  begin
    case Tys[selfT].k of
      tyClosure: begin Result := Closures[Tys[selfT].def].ret; Exit; end;
      tyFnDef: begin FnDefSig(Tys[selfT].def, Tys[selfT].args, params, ret); Result := ret; Exit; end;
      tyFnPtr: begin Result := Tys[selfT].args[Length(Tys[selfT].args) - 1]; Exit; end;
      tyRef:
        begin
          Result := ProjectAssoc(Tys[selfT].args[0], trait, targs, name, errNode);
          Exit;
        end;
    end;
  end;
  { Item de l'objet-trait : type associe lie dans dyn Trait<Item=...> non gere }
  r := SelectImpl(trait, targs, impl, iargs, True);
  if r = 2 then
  begin
    res := NewTyVar(0);
    AddObl(oblProj, selfT, trait, targs, name, res, errNode);
    Result := res;
    Exit;
  end;
  if r = 0 then
  begin
    if errNode > 0 then
    begin
      Report(True, 'E0277', 'the trait bound `' + TyToStr(selfT) + ': ' + Defs[trait].name + '` is not satisfied',
             Nodes[errNode].fi, Nodes[errNode].line, Nodes[errNode].col, NodeLen(errNode),
             'the trait `' + Defs[trait].name + '` is not implemented for `' + TyToStr(selfT) + '`');
    end;
    Result := TyErrT;
    Exit;
  end;
  if impl >= 0 then
  begin
    item := ImplAssocItem(impl, name, dkTypeAlias);
    if item >= 0 then
    begin
      EnvForDef(item, iargs, env);
      env.infer := True;
      Result := LowerTy(Nodes[Defs[item].node].a, env);
      Exit;
    end;
  end;
  { valeur par defaut dans le trait }
  item := TraitAssocItem(trait, name, dkTypeAlias);
  if (item >= 0) and (Nodes[Defs[item].node].a <> 0) then
  begin
    EnvForDef(item, targs, env);
    env.infer := True;
    Result := LowerTy(Nodes[Defs[item].node].a, env);
    Exit;
  end;
  Result := TyErrT;
end;

procedure SolveObligations;
var
  progress: Boolean;
  i, r, impl, t: Integer;
  ia: TIntArr;
  v: Integer;
  params: TIntArr;
  ret: Integer;
  n: Integer;
begin
  if SolveBusy then Exit;
  SolveBusy := True;
  repeat
    progress := False;
    i := 0;
    while i < NObls do
    begin
      if Obls[i].done then begin Inc(i); Continue; end;
      t := Shallow(Obls[i].selfTy);
      case Obls[i].kind of
        oblProj:
          if Tys[t].k <> tyVar then
          begin
            Obls[i].done := True;
            v := ProjectAssoc(t, Obls[i].trait, Obls[i].targs, Obls[i].name, Obls[i].node);
            Unify(Obls[i].res, v);
            progress := True;
          end;
        oblTrait:
          if Tys[t].k <> tyVar then
          begin
            r := SelectImpl(Obls[i].trait, Obls[i].targs, impl, ia, True);
            if r = 1 then begin Obls[i].done := True; progress := True; end
            else if r = 0 then
            begin
              Obls[i].done := True;
              n := Obls[i].node;
              if (n > 0) then
                Report(True, 'E0277', 'the trait bound `' + TyToStr(t) + ': ' + Defs[Obls[i].trait].name +
                       '` is not satisfied', Nodes[n].fi, Nodes[n].line, Nodes[n].col, NodeLen(n),
                       'the trait `' + Defs[Obls[i].trait].name + '` is not implemented for `' + TyToStr(t) + '`');
              progress := True;
            end;
          end;
        oblFn:
          begin
            case Tys[t].k of
              tyClosure:
                begin
                  Obls[i].done := True;
                  params := Closures[Tys[t].def].params;
                  if Length(params) <> Length(Obls[i].targs) then
                  begin
                    n := Obls[i].node;
                    if n > 0 then
                      Report(True, 'E0593', 'closure is expected to take ' + IntToStr(Length(Obls[i].targs)) +
                             ' argument' + 's' + ', but it takes ' + IntToStr(Length(params)) + ' arguments',
                             Nodes[n].fi, Nodes[n].line, Nodes[n].col, NodeLen(n), '');
                  end
                  else
                  begin
                    for v := 0 to Length(params) - 1 do Unify(params[v], Obls[i].targs[v]);
                    Unify(Closures[Tys[t].def].ret, Obls[i].res);
                  end;
                  progress := True;
                end;
              tyFnDef:
                begin
                  Obls[i].done := True;
                  FnDefSig(Tys[t].def, Tys[t].args, params, ret);
                  if Length(params) = Length(Obls[i].targs) then
                  begin
                    for v := 0 to Length(params) - 1 do Unify(params[v], Obls[i].targs[v]);
                    Unify(ret, Obls[i].res);
                  end;
                  progress := True;
                end;
              tyFnPtr:
                begin
                  Obls[i].done := True;
                  for v := 0 to Length(Tys[t].args) - 2 do
                    if v < Length(Obls[i].targs) then Unify(Tys[t].args[v], Obls[i].targs[v]);
                  Unify(Tys[t].args[Length(Tys[t].args) - 1], Obls[i].res);
                  progress := True;
                end;
              tyRef:
                begin
                  Obls[i].selfTy := Tys[t].args[0];
                  progress := True;
                end;
              tyAdt:
                if Defs[Tys[t].def].lang = 'box' then
                begin
                  Obls[i].selfTy := Tys[t].args[0];
                  progress := True;
                end
                else
                  Obls[i].done := True;
              tyDyn:
                Obls[i].done := True;
            end;
          end;
      end;
      Inc(i);
    end;
  until not progress;
  SolveBusy := False;
end;

{ Resout la structure d'un type, en essayant de resoudre les obligations si c'est une variable }
function RevealOpaque(t: Integer): Integer; forward;

function StructResolve(t: Integer): Integer;
begin
  t := Shallow(t);
  if Tys[t].k = tyVar then
  begin
    SolveObligations;
    t := Shallow(t);
  end;
  if Tys[t].k = tyOpaque then t := Shallow(RevealOpaque(t));
  Result := t;
end;

{ ---- auto-deref ---- }

{ Un pas de deref. kind: 1 integre (& / &mut / Box), 2 via le trait Deref. Retourne 0 si impossible. }
function DerefOnce(t: Integer; var kind: Integer): Integer;
var
  targs: TIntArr;
  impl: Integer;
  ia: TIntArr;
begin
  Result := 0;
  kind := 0;
  t := StructResolve(t);
  case Tys[t].k of
    tyRef: begin Result := Tys[t].args[0]; kind := 1; Exit; end;
    tyAdt:
      begin
        if Defs[Tys[t].def].lang = 'box' then
        begin
          Result := Tys[t].args[0];
          kind := 1;
          Exit;
        end;
        SetLength(targs, 1);
        targs[0] := t;
        if (LangDeref > 0) and (SelectImpl(LangDeref, targs, impl, ia, False) = 1) then
        begin
          SetLength(targs, 1);
          targs[0] := t;
          Result := ProjectAssoc(t, LangDeref, targs, 'Target', 0);
          kind := 2;
        end;
      end;
  end;
end;

{ ---- fonctions : signatures ---- }

{ selfT-type de la methode (premier parametre) selon selfKind, avec S = type Self }
function SelfParamType(fnDef: Integer; S: Integer; var env: TEnv): Integer;
var
  sp, i: Integer;
  nd: Integer;
begin
  Result := 0;
  nd := Defs[fnDef].node;
  case Defs[fnDef].selfKind of
    1: Result := S;
    2: Result := MkRef(S, False);
    3: Result := MkRef(S, True);
    4:
      begin
        for i := 0 to Length(Nodes[nd].l2) - 1 do
          if Nodes[Nodes[nd].l2[i]].k = nSelfParam then
          begin
            sp := Nodes[nd].l2[i];
            Result := LowerTy(Nodes[sp].a, env);
            Exit;
          end;
      end;
  end;
end;

{ Recherche d'une methode par nom a partir du type recepteur (avec auto-deref / auto-ref) }
procedure ProbeMethod(recvTy: Integer; const name: string; var res: TProbe);
var
  steps: TIntArr;
  kinds: TIntArr;
  i, j, adj, st, k, m, h, idx: Integer;
  U, P: Integer;
  cands: TIntArr;
  hk: string;
  s, impl: Integer;
  iargs: TIntArr;
  env: TEnv;
  fnd: Integer;
  spt: Integer;
  trs: TIntArr;
  targs: TIntArr;
  r: Integer;
  ia: TIntArr;
  tr: Integer;
  X: Integer;
  fargs: TIntArr;
  ownCount: Integer;
  nd: Integer;
  unsz: Integer;
  tt: Integer;
begin
  res.found := False;
  steps := nil;
  kinds := nil;
  U := StructResolve(recvTy);
  IAdd(steps, U);
  for i := 1 to 12 do
  begin
    k := 0;
    U := DerefOnce(U, k);
    if U = 0 then Break;
    U := StructResolve(U);
    IAdd(steps, U);
  end;
  { deroulement par pas, avec etape finale de dimensionnement tableau -> tranche }
  unsz := -1;
  if Tys[steps[Length(steps) - 1]].k = tyArray then
  begin
    IAdd(steps, MkSlice(Tys[steps[Length(steps) - 1]].args[0]));
    unsz := Length(steps) - 1;
  end;
  for st := 0 to Length(steps) - 1 do
  begin
    U := steps[st];
    if Tys[U].k = tyVar then
    begin
      if VarKind[Tys[U].n] = 0 then Exit;
    end;
    if Tys[U].k = tyErr then Exit;
    for adj := 0 to 2 do
    begin
      case adj of
        0: P := U;
        1: P := MkRef(U, False);
      else
        P := MkRef(U, True);
      end;
      { ---- methodes inherentes ---- }
      hk := TyHeadKey(U);
      if (Tys[U].k = tyVar) then
      begin
        if VarKind[Tys[U].n] = 1 then hk := 'int' else hk := 'float';
      end;
      { les entiers : toutes les tailles }
      cands := nil;
      if (Tys[U].k = tyVar) then
      begin
        for h := 0 to NHeadLists - 1 do
        begin
          { variables numeriques : on ne cherche pas de methode (E0689) }
        end;
      end
      else
      begin
        idx := HFind(HeadMap, hk);
        if idx >= 0 then cands := HeadLists[idx];
      end;
      for i := 0 to Length(cands) - 1 do
      begin
        impl := cands[i];
        fnd := ImplAssocItem(impl, name, dkFn);
        if fnd < 0 then Continue;
        if Defs[fnd].selfKind = 0 then Continue;
        s := Snapshot;
        Inc(SuppressDiag);
        iargs := FreshArgs(impl);
        EnvForDef(impl, iargs, env);
        env.infer := True;
        if Defs[fnd].selfKind = 4 then
        begin
          fargs := nil;
          for j := 0 to Length(iargs) - 1 do IAdd(fargs, iargs[j]);
          for j := Length(iargs) to Length(Defs[fnd].gnames) - 1 do IAdd(fargs, NewTyVar(0));
          EnvForDef(fnd, fargs, env);
          env.infer := True;
        end;
        spt := SelfParamType(fnd, env.selfTy, env);
        m := 0;
        if spt <> 0 then
        begin
          if Unify(spt, P) and ImplBoundsHold(impl, env) then m := 1;
        end;
        Dec(SuppressDiag);
        if m = 1 then
        begin
          fargs := nil;
          for j := 0 to Length(iargs) - 1 do IAdd(fargs, iargs[j]);
          for j := Length(iargs) to Length(Defs[fnd].gnames) - 1 do IAdd(fargs, NewTyVar(0));
          res.found := True;
          res.fnDef := fnd;
          res.implDef := impl;
          res.traitDef := -1;
          res.fargs := fargs;
          res.steps := st;
          res.adj := adj;
          res.unsize := (unsz >= 0) and (st = unsz);
          res.selfParamTy := spt;
          res.recvTy := U;
          res.inherent := True;
          Exit;
        end;
        Rollback(s);
      end;
      { ---- methodes de traits ---- }
      idx := HFind(MethodTraits, name);
      if idx >= 0 then
      begin
        trs := MethodTraitLists[idx];
        for i := 0 to Length(trs) - 1 do
        begin
          tr := trs[i];
          fnd := TraitAssocItem(tr, name, dkFn);
          if fnd < 0 then Continue;
          if Defs[fnd].selfKind = 0 then Continue;
          case Defs[fnd].selfKind of
            1: X := P;
            2: begin
                 if (Tys[P].k <> tyRef) or ((Tys[P].f and 1) <> 0) then Continue;
                 X := Tys[P].args[0];
               end;
            3: begin
                 if (Tys[P].k <> tyRef) or ((Tys[P].f and 1) = 0) then Continue;
                 X := Tys[P].args[0];
               end;
          else
            Continue;
          end;
          X := Shallow(X);
          if Tys[X].k = tyVar then
          begin
            if VarKind[Tys[X].n] = 0 then Continue;
          end;
          { X : Trait ? }
          SetLength(targs, Length(Defs[tr].gnames));
          targs[0] := X;
          for j := 1 to Length(targs) - 1 do targs[j] := NewTyVar(0);
          s := Snapshot;
          Inc(SuppressDiag);
          r := SelectImpl(tr, targs, impl, ia, True);
          Dec(SuppressDiag);
          if r = 0 then begin Rollback(s); Continue; end;
          { le type Self doit correspondre exactement quand la methode prend selfT par valeur sur un type reference :
            cas courant (autoref) deja traite par P }
          fargs := nil;
          for j := 0 to Length(targs) - 1 do IAdd(fargs, targs[j]);
          for j := Length(targs) to Length(Defs[fnd].gnames) - 1 do IAdd(fargs, NewTyVar(0));
          res.found := True;
          res.fnDef := fnd;
          res.implDef := -1;
          res.traitDef := tr;
          res.fargs := fargs;
          res.steps := st;
          res.adj := adj;
          res.unsize := (unsz >= 0) and (st = unsz);
          res.selfParamTy := P;
          res.recvTy := U;
          res.inherent := False;
          { si l'impl surcharge la methode, on utilise celle de l'impl }
          if (impl >= 0) then
          begin
            m := ImplAssocItem(impl, name, dkFn);
            if m >= 0 then
            begin
              fargs := nil;
              for j := 0 to Length(ia) - 1 do IAdd(fargs, ia[j]);
              for j := Length(ia) to Length(Defs[m].gnames) - 1 do IAdd(fargs, NewTyVar(0));
              res.fnDef := m;
              res.implDef := impl;
              res.fargs := fargs;
            end;
          end;
          Exit;
        end;
      end;
    end;
  end;
end;

{ ---- resolution d'instances (monomorphisation) ---- }

{ Pour une methode de trait avec arguments concrets [Self, ...] trouve l'impl et la methode concrete }
procedure ResolveInstance(var def: Integer; var args: TIntArr);
var
  tr, impl, m, r, i, j, nTr: Integer;
  targs, ia, nargs: TIntArr;
  name: string;
begin
  if (Defs[def].parent < 0) or (Defs[Defs[def].parent].kind <> dkTrait) then Exit;
  tr := Defs[def].parent;
  name := Defs[def].name;
  nTr := Length(Defs[tr].gnames);
  SetLength(targs, nTr);
  for i := 0 to nTr - 1 do targs[i] := args[i];
  r := SelectImpl(tr, targs, impl, ia, True);
  if (r = 1) and (impl >= 0) then
  begin
    m := ImplAssocItem(impl, name, dkFn);
    if m >= 0 then
    begin
      nargs := nil;
      for i := 0 to Length(ia) - 1 do IAdd(nargs, Zonk(ia[i]));
      for j := nTr to Length(args) - 1 do IAdd(nargs, args[j]);
      def := m;
      args := nargs;
      Exit;
    end;
  end;
  { methode par defaut du trait : arguments inchanges (Self concret) }
end;

