  BufLn(b, '    // ---- entiers ----');
  BufLn(b, '    pub fn fmt_u128_radix(f: &mut Formatter, mut n: u128, nonneg: bool, radix: u32, upper: bool, prefix: &str) -> Result {');
  BufLn(b, '        let mut buf = [0u8; 130];');
  BufLn(b, '        let mut i = 130usize;');
