  BufLn(b, '        }');
  BufLn(b, '        if e >= 0 {');
  BufLn(b, '            let mut i = 0i32;');
  BufLn(b, '            while i <= e {');
  BufLn(b, '                if i < nd { out.push(db[i as usize] as char); } else { out.push(''0''); }');
  BufLn(b, '                i += 1;');
  BufLn(b, '            }');
  BufLn(b, '            if nd > e + 1 {');
