Rem 02_variables_math.vbs - Variables et operations arithmetiques

Dim a, b
a = 100
b = 37

WScript.Echo "a = " & a
WScript.Echo "b = " & b
WScript.Echo "a + b = " & (a + b)
WScript.Echo "a - b = " & (a - b)
WScript.Echo "a * b = " & (a * b)
WScript.Echo "a / b = " & (a / b)
WScript.Echo "a MOD b = " & (a Mod b)
WScript.Echo "a \\ b = " & (a \ b)
WScript.Echo "Abs(-42) = " & Abs(-42)
WScript.Echo "Sqr(81) = " & Sqr(81)
