5 REM FILES.BAS : FICHIERS SEQUENTIELS ET A ACCES ALEATOIRE
10 CLEARW 2
20 OPEN "O",#1,"SEQ.TXT"
30 FOR I=1 TO 3: PRINT #1,"NOM";I;",";I*10: NEXT
40 CLOSE #1
50 OPEN "I",#1,"SEQ.TXT"
60 WHILE NOT EOF(1)
70 LINE INPUT #1,L$
80 PRINT "LU: ";L$
90 WEND
100 CLOSE #1
110 OPEN "R",#1,"TESTFILE"
120 FIELD #1,20 AS V$,10 AS X$,30 AS N$
130 LSET V$="BONJOUR": LSET X$="CECI": RSET N$="EST UN ENREGISTREMENT 1"
140 PUT #1
150 RSET N$="EST UN ENREGISTREMENT 2"
160 PUT #1
170 CLOSE 1
180 OPEN "R",#1,"TESTFILE"
190 FIELD #1,20 AS A$,10 AS B$,30 AS C$
200 GET #1,2: PRINT A$;B$;C$
210 GET #1,1: PRINT A$;B$;C$
220 CLOSE 1
230 OPEN "R",#1,"AGES",32
240 FIELD #1,20 AS NM$,2 AS AG$,10 AS JB$
250 LSET NM$="ANNIE": AG$=MKI$(35): LSET JB$="DEV": PUT #1
260 CLOSE 1: OPEN "R",#1,"AGES",32: FIELD #1,20 AS NM$,2 AS AG$,10 AS JB$
270 GET #1,1: PRINT NM$;CVI(AG$);JB$
280 CLOSE 1
290 ON ERROR GOTO 400
300 OPEN "I",#1,"NOEXIST.TXT"
310 PRINT "SUITE": END
400 PRINT "ERREUR";ERR;"LIGNE";ERL: RESUME 310
