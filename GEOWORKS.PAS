{ Retourne 0 quitter, 1 debutant, 2 intermediaire, 3 avance, 4 programmes DOS }
Function WelcomeScreen: Integer;
Var E: TEvent; Sel,I,R,LastMin: Integer; Done: Boolean; H,Mi,S,C: Word;
PX: Array[1..3] Of Integer;
Begin
 PX[1]:=67;PX[2]:=243;PX[3]:=419;
 HideMouse;
 Sel:=2;
 DrawWelcome(Sel);
 ShowMouse;
 R:=-1;Done:=False;
 GetTime(H,Mi,S,C);LastMin:=Mi;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   Case E.Key Of
    K_LEFT: Begin If Sel>1 Then Dec(Sel);HideMouse;DrawWelcome(Sel);ShowMouse;
    End;
    K_RIGHT: Begin If Sel<4 Then Inc(Sel);HideMouse;DrawWelcome(Sel);ShowMouse;
    End;
    K_ENTER: R:=Sel;
    K_ESC: R:=0;
    K_F1: Info('Help',T3('Choose a level: Beginner, Intermediate or Advanced.',
               'Choisissez un niveau : D'#130'butant, Interm'#130+
                   'diaire ou Avanc'#130'.',
               'W'#132'hlen Sie eine Stufe: Anf'#132+
                   'nger, Fortgeschritten oder Experte.'));
   End;
  End Else If E.Kind=EV_UP Then Begin
   For I:=1 To 3 Do
    If InBox(E.X,E.Y,PX[I],55,PX[I]+155,190) Then R:=I;
   If InBox(E.X,E.Y,272,198,367,214) Then R:=4;
   If InBox(E.X,E.Y,0,0,47,31) Then R:=0;
   If InBox(E.X,E.Y,SCR_W-49,0,SCR_W-1,31) Then Begin
    Info('Help',T3('Choose a level: Beginner, Intermediate or Advanced.',
               'Choisissez un niveau : D'#130'butant, Interm'#130+
                   'diaire ou Avanc'#130'.',
               'W'#132'hlen Sie eine Stufe: Anf'#132+
                   'nger, Fortgeschritten oder Experte.'));
   End;
  End;
  GetTime(H,Mi,S,C);
  If Mi<>LastMin Then Begin LastMin:=Mi;HideMouse;DrawWelcome(Sel);ShowMouse;
  End;
  If R=0 Then Begin
   If Not Confirm(T3('Exit','Quitter','Beenden'),
      T3('Exit to DOS?','Quitter vers DOS ?','Zur'#129'ck zu DOS?')) Then R:=-1;
  End;
  If R<>-1 Then Done:=True;
 Until Done;
 WelcomeScreen:=R;
End;

