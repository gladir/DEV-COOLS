Procedure CommDone(Wd_: PWindow);
 Var Dt_: PComm;
Var I: Integer;
Begin
 Dt_:=Wd_^.Data;
 For I:=1 To Dt_^.NL Do FreeStr(Dt_^.Scr[I]);
End;

Procedure CommPutLine(Wd_: PWindow; Const S: String);
 Var Dt_: PComm;
Var I: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NL>=200 Then Begin FreeStr(Dt_^.Scr[1]);
 For I:=1 To 199 Do Dt_^.Scr[I]:=Dt_^.Scr[I+1];Dt_^.NL:=199;End;
 Inc(Dt_^.NL);Dt_^.Scr[Dt_^.NL]:=NewStr(S);
End;

Procedure CommExecute(Wd_: PWindow; Const S: String);
 Var Dt_: PComm;
Var U: String;
Begin
 Dt_:=Wd_^.Data;
 U:=Upper(TrimStr(S));
 If U='' Then Exit;
 If Copy(U,1,2)='AT' Then Begin
  If Copy(U,1,3)='ATD' Then Begin CommPutLine(Wd_,'NO DIALTONE');End
  Else If Copy(U,1,3)='ATH' Then CommPutLine(Wd_,'OK')
  Else CommPutLine(Wd_,'OK');
 End Else CommPutLine(Wd_,'?');
End;

Procedure CommDrawClient(Wd_: PWindow);
 Var Dt_: PComm;
Var X1,Y1,X2,Y2,Rw,I,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cBlk);
 Rw:=(Y2-Y1-6) Div 10;
 K:=Dt_^.NL-Rw+2;
 If K<1 Then K:=1;
 For I:=K To Dt_^.NL Do GText(X1+4,Y1+4+(I-K)*10,Dt_^.Scr[I]^,cLGr);
 GText(X1+4,Y1+4+(Dt_^.NL-K+1)*10,Dt_^.Cur+#219,cWht);
End;

Procedure CommOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PComm;
Begin
 Dt_:=Wd_^.Data;
 If K=K_ENTER Then Begin CommPutLine(Wd_,Dt_^.Cur);CommExecute(Wd_,Dt_^.Cur);
 Dt_^.Cur:='';End
 Else If K=K_BKSP Then Begin If Dt_^.Cur<>'' Then Delete(Dt_^.Cur,
     Length(Dt_^.Cur),1);End
 Else If (K>=32) And (K<256) And (Length(Dt_^.Cur)<76) Then
     Dt_^.Cur:=Dt_^.Cur+Chr(K);
 Invalidate(Wd_);
End;

Procedure CommOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PComm;
Var S: String;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_CLRSCR: Begin While Dt_^.NL>0 Do Begin FreeStr(Dt_^.Scr[Dt_^.NL]);
  Dec(Dt_^.NL);End;Invalidate(Wd_);End;
  CM_DIAL: Begin
            S:='';
            If InputBox(T3('Dial','Appeler','W'#132'hlen'),T3('Phone number:',
                'Num'#130'ro de t'#130'l'#130'phone :','Telefonnummer:'),S,
                30) Then Begin
             CommPutLine(Wd_,'ATD'+S);CommPutLine(Wd_,'NO DIALTONE');
            End;
            Invalidate(Wd_);
           End;
  CM_HANG: Begin CommPutLine(Wd_,'ATH');CommPutLine(Wd_,'OK');Invalidate(Wd_);
  End;
 Else CommonCmd(Wd_,Cmd);
 End;
End;

