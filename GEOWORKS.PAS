Procedure GbRun;
Var B: PBas; F: PForm; I,P: Integer; S: String; W: PWindow; E: ^TEdit;
L: PWindow; X,Y: Integer;
    Ed: PEditWin;
Begin
 B:=BNewBas;
 B^.NL:=0;
 If GbAlive(GbProj^.CodeW) Then Begin
  Ed:=GbProj^.CodeW^.Data;
  For I:=1 To Ed^.E.N Do
   If B^.NL<BMAXL Then Begin
    Inc(B^.NL);S:=EdLine(Ed^.E,I);
    B^.Src[B^.NL]:=NewStr(S);
    B^.LNo[B^.NL]:=BLineNo(S);
   End;
 End;
 If B^.NL=0 Then Begin
  Inc(B^.NL);B^.Src[1]:=NewStr('PRINT "Empty program"');B^.LNo[1]:=-1;
 End;
 New(F);F^:=GbProj^.Form^;
 If F^.N<=1 Then Begin Dispose(F);F:=Nil;End
 Else Begin B^.Refs:=F;End;
 NextWinPos(X,Y);
 W:=BrNew(X,Y,B,F,'GeoBASIC - '+T3('Running','Ex'#130'cution',
     'Ausf'#129'hrung'));
 AddWindow(W);
End;

{ execute directement un programme .BAS (avec ses ressources .GBR) }
Function BasRunFile(AX,AY: Integer; Const Path: String): PWindow;
Var B: PBas; R: String; P: Integer;
Begin
 BasRunFile:=Nil;
 B:=BasLoad(Path);
 If B=Nil Then Begin Info('GeoBASIC',T3('File not found','Fichier introuvable',
     'Datei nicht gefunden'));Exit;End;
 R:=Path;P:=Length(R);
 While (P>0) And (R[P]<>'.') And (R[P]<>'/') And (R[P]<>'\') Do Dec(P);
 If (P>0) And (R[P]='.') Then R:=Copy(R,1,P-1);
 If Not ResLoad(R+'.GBR') Then ResLoad(R+'.gbr');
 BasRunFile:=BrNew(AX,AY,B,Nil,'GeoBASIC - '+ShortName(Path));
End;

