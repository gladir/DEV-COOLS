Procedure TPrefs.Art(I,X,Y: Integer);
Begin
 Case I Of
  0: Begin GBar(X+8,Y+2,X+40,Y+22,cDGr);GBar(X+10,Y+4,X+38,Y+20,cBlk);
      GBar(X+10,Y+4,X+17,Y+20,cWht);GBar(X+17,Y+4,X+24,Y+20,cYel);GBar(X+24,Y+4,X+31,Y+20,cLCy);
      GBar(X+31,Y+4,X+38,Y+20,cLGn);GBar(X+14,Y+23,X+34,Y+27,cLGr);End;
  1: DrawIcon(IC_GLOBE,X,Y,False);
  2: Begin GTextBig(X+14,Y+8,'abc',1,cBlk);GTextBig(X+10,Y+2,'abc',2,cRed);GRect(X+4,Y+0,X+44,Y+26,cBlk);End;
  3: Begin GFillEllipse(X+24,Y+16,11,12,cLGr);GEllipse(X+24,Y+16,11,12,cBlk);GVLine(X+24,Y+4,Y+14,cBlk);
      GHLine(X+13,X+35,Y+14,cBlk);GBar(X+10,Y+2,X+14,Y+6,cBlk);End;
  4: Begin GBar(X+6,Y+12,X+42,Y+26,cBlk);GBar(X+10,Y+8,X+38,Y+12,cBlk);
      GBar(X+4,Y+4,X+12,Y+8,cBlk);GBar(X+36,Y+4,X+44,Y+8,cBlk);End;
  5: Begin GBar(X+10,Y+2,X+38,Y+10,cWht);GRect(X+10,Y+2,X+38,Y+10,cBlk);
