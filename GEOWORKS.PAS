{   GEOBASIC : utilitaires (Menu, Icon List, Dialog Box, Bitmap)         }
{   Les ressources creees ici sont utilisees par les commandes MENU,     }
{   ICON, DIALOG et BITMAP des programmes (voir manuel, chapitre 7).     }
{ ====================================================================== }

{ liste : retourne l'indice choisi, 0 si annule }
Function GbPick(Const Title,Prompt,Items: String): Integer;
Begin
 GbPick:=ChoiceBox(Title,Prompt,Items,1);
End;

Function GbAsk(Const Title,Prompt: String; Var S: String; Max: Integer):
    Boolean;
Begin
 GbAsk:=InputBox(Title,Prompt,S,Max);
End;

{ choisit (ou cree) une ressource de la categorie K (1 menu, 2 icones, 3
  dialogue, 4 bitmap) ;
  retourne l'indice dans GbRes, 0 si annule }
Function GbSelectRes(K: Integer): Integer;
Var L,Nm: String; N,I,R: Integer; Names: String; Max: Integer;
Begin
 GbSelectRes:=0;
 Case K Of
  1: Begin N:=GbRes.NM;Max:=8;End;
  2: Begin N:=GbRes.NI;Max:=8;End;
  3: Begin N:=GbRes.ND;Max:=8;End;
 Else Begin N:=GbRes.NB;Max:=12;End;
 End;
 L:='';
 For I:=1 To N Do Begin
  Case K Of
   1: Nm:=GbRes.M[I].Name;
   2: Nm:=GbRes.I[I].Name;
   3: Nm:=GbRes.D[I].Name;
  Else Nm:=GbRes.B[I].Name;
  End;
  L:=L+Nm+'|';
 End;
 L:=L+T3('<New>','<Nouveau>','<Neu>');
 R:=GbPick('GeoBASIC',T3('Create or edit an item - Name:',
     'Cr'#130'er ou modifier un '#130'l'#130'ment :',
     'Element erstellen oder bearbeiten:'),L);
 If R=0 Then Exit;
 If R<=N Then Begin GbSelectRes:=R;Exit;End;
 If N>=Max Then Begin Info('GeoBASIC',T3('Too many items.',
     'Trop d'''#130'l'#130'ments.','Zu viele Elemente.'));Exit;End;
 Nm:='';
 If Not GbAsk('GeoBASIC',T3('Name (5 letters maximum):',
     'Nom (5 lettres maximum) :','Name (h'#148'chstens 5 Buchstaben):'),Nm,
     5) Then Exit;
 If Nm='' Then Exit;
 Nm:=Upper(Nm);
 Case K Of
  1: Begin
      Inc(GbRes.NM);FillChar(GbRes.M[GbRes.NM],SizeOf(GbRes.M[1]),0);
      GbRes.M[GbRes.NM].Name:=Nm;GbRes.M[GbRes.NM].NSub:=4;
      For I:=1 To 4 Do Begin
       GbRes.M[GbRes.NM].SubT[I]:='menu'+IntStr(I);GbRes.M[GbRes.NM].NIt[I]:=4;
       For R:=1 To 4 Do Begin GbRes.M[GbRes.NM].It[I,R].Txt:='action'+IntStr(R);
       GbRes.M[GbRes.NM].It[I,R].Tg:='';End;
      End;
      GbSelectRes:=GbRes.NM;
     End;
  2: Begin Inc(GbRes.NI);FillChar(GbRes.I[GbRes.NI],SizeOf(GbRes.I[1]),0);
  GbRes.I[GbRes.NI].Name:=Nm;GbRes.I[GbRes.NI].N:=1;
      GbRes.I[GbRes.NI].Ic[1].X:=8;GbRes.I[GbRes.NI].Ic[1].Y:=40;
      GbSelectRes:=GbRes.NI;End;
  3: Begin Inc(GbRes.ND);FillChar(GbRes.D[GbRes.ND],SizeOf(GbRes.D[1]),0);
  GbRes.D[GbRes.ND].Name:=Nm;
      GbRes.D[GbRes.ND].N:=1;GbRes.D[GbRes.ND].It[1].K:=4;GbSelectRes:=GbRes.ND;
      End;
 Else Begin Inc(GbRes.NB);FillChar(GbRes.B[GbRes.NB],SizeOf(GbRes.B[1]),0);
 GbRes.B[GbRes.NB].Name:=Nm;
      GbRes.B[GbRes.NB].W:=16;GbRes.B[GbRes.NB].H:=16;GbSelectRes:=GbRes.NB;End;
 End;
End;

{ ---------------------- editeur de menus ---------------------- }

Procedure GbEdSub(M,S: Integer);
Var L,V: String; I,R,N: Integer;
Begin
 Repeat
  L:=T3('Title: ','Titre : ','Titel: ')+GbRes.M[M].SubT[S]+'|';
  For I:=1 To GbRes.M[M].NIt[S] Do L:=L+IntStr(I)+'. '+GbRes.M[M].It[S,
      I].Txt+' -> '+GbRes.M[M].It[S,I].Tg+'|';
  L:=L+T3('+ Add item','+ Ajouter un '#130'l'#130'ment',
      '+ Eintrag hinzuf'#129'gen')+'|'+T3('- Remove last item',
      '- Supprimer le dernier','- Letzten entfernen')+'|'+T3('Back','Retour',
      'Zur'#129'ck');
  R:=GbPick(T3('Menu editor','Editeur de menus','Men'#129'-Editor'),
      T3('Submenu ','Sous-menu ','Untermen'#129' ')+IntStr(S),L);
  N:=GbRes.M[M].NIt[S];
  If R=1 Then Begin V:=GbRes.M[M].SubT[S];
  If GbAsk('Menu',T3('Submenu text:','Texte du sous-menu :','Text:'),V,
      12) Then GbRes.M[M].SubT[S]:=V;End
  Else If (R>=2) And (R<=N+1) Then Begin
   I:=R-1;
   V:=GbRes.M[M].It[S,I].Txt;If GbAsk('Menu',T3('Item text:',
       'Texte de l'''#130'l'#130'ment :','Text:'),V,24) Then GbRes.M[M].It[S,
       I].Txt:=V;
   V:=GbRes.M[M].It[S,I].Tg;If GbAsk('Menu',T3('Gosub where (line or @label):',
       'Gosub o'#151' (ligne ou @'#130'tiquette) :','Gosub wohin:'),V,
       14) Then GbRes.M[M].It[S,I].Tg:=V;
  End Else If R=N+2 Then Begin
   If N<12 Then Begin Inc(GbRes.M[M].NIt[S]);
   GbRes.M[M].It[S,N+1].Txt:='action'+IntStr(N+1);GbRes.M[M].It[S,N+1].Tg:='';
   End;
  End Else If R=N+3 Then Begin If N>1 Then Dec(GbRes.M[M].NIt[S]);End;
 Until (R=0) Or (R=N+4) Or (R=GbRes.M[M].NIt[S]+4);
End;

Procedure GbEdMenu(M: Integer);
Var L: String; I,R,N: Integer;
Begin
 Repeat
  N:=GbRes.M[M].NSub;
  L:='';
  For I:=1 To N Do L:=L+IntStr(I)+'. '+GbRes.M[M].SubT[I]+' ('+
      IntStr(GbRes.M[M].NIt[I])+')|';
  L:=L+T3('+ Add submenu','+ Ajouter un sous-menu',
      '+ Untermen'#129' hinzuf'#129'gen')+'|'+T3('- Remove last submenu',
      '- Supprimer le dernier','- Letzten entfernen')+'|'+T3('Done',
      'Termin'#130,'Fertig');
  R:=GbPick(T3('Menu editor - ','Editeur de menus - ',
      'Men'#129'-Editor - ')+GbRes.M[M].Name,T3('Number of submenus: ',
      'Nombre de sous-menus : ','Anzahl Untermen'#129's: ')+IntStr(N),L);
  If (R>=1) And (R<=N) Then GbEdSub(M,R)
  Else If R=N+1 Then Begin
   If N<6 Then Begin Inc(GbRes.M[M].NSub);
   GbRes.M[M].SubT[N+1]:='menu'+IntStr(N+1);GbRes.M[M].NIt[N+1]:=4;
    For I:=1 To 4 Do Begin GbRes.M[M].It[N+1,I].Txt:='action'+IntStr(I);
    GbRes.M[M].It[N+1,I].Tg:='';End;End;
  End Else If R=N+2 Then Begin If N>1 Then Dec(GbRes.M[M].NSub);End;
 Until (R=0) Or (R=N+3);
End;

{ ---------------------- editeur de listes d'icones ---------------------- }

Procedure GbEdIcons(K: Integer);
Var L,V: String; I,R,N,X: Integer;
Begin
 Repeat
  N:=GbRes.I[K].N;
  L:='';
  For I:=1 To N Do L:=L+IntStr(I)+'. '+GbRes.I[K].Ic[I].Bmp+' ('+
      IntStr(GbRes.I[K].Ic[I].X)+','+IntStr(GbRes.I[K].Ic[I].Y)+') -> '+
      GbRes.I[K].Ic[I].Tg+'|';
  L:=L+T3('+ Add icon','+ Ajouter une ic'#147'ne',
      '+ Symbol hinzuf'#129'gen')+'|'+T3('- Remove last icon',
      '- Supprimer la derni'#138're','- Letztes entfernen')+'|'+T3('Done',
      'Termin'#130,'Fertig');
  R:=GbPick(T3('Icon list - ','Liste d''ic'#147'nes - ',
      'Symbolliste - ')+GbRes.I[K].Name,T3('Number of icons: ',
      'Nombre d''ic'#147'nes : ','Anzahl Symbole: ')+IntStr(N),L);
  If (R>=1) And (R<=N) Then Begin
   V:=GbRes.I[K].Ic[R].Bmp;If GbAsk('Icon',T3('Bitmap name:','Nom du bitmap :',
       'Bitmap-Name:'),V,6) Then GbRes.I[K].Ic[R].Bmp:=Upper(V);
   V:=IntStr(GbRes.I[K].Ic[R].X);If GbAsk('Icon',
       T3('X position (0-312, multiple of 8):',
       'Position X (0-312, multiple de 8) :','X-Position (0-312):'),V,
       3) Then Begin
    X:=Clamp(StrVal(V,0),0,312);GbRes.I[K].Ic[R].X:=X-(X Mod 8);End;
   V:=IntStr(GbRes.I[K].Ic[R].Y);If GbAsk('Icon',T3('Y position (0-199):',
       'Position Y (0-199) :','Y-Position (0-199):'),V,
       3) Then GbRes.I[K].Ic[R].Y:=Clamp(StrVal(V,0),0,199);
   V:=GbRes.I[K].Ic[R].Tg;If GbAsk('Icon',T3('Place to go (line or @label):',
       'Aller '#133' (ligne ou @'#130'tiquette) :','Ziel (Zeile oder @Marke):'),
       V,14) Then GbRes.I[K].Ic[R].Tg:=V;
  End Else If R=N+1 Then Begin
   If N<31 Then Begin Inc(GbRes.I[K].N);GbRes.I[K].Ic[N+1].X:=8+(N Mod 10)*32;
   GbRes.I[K].Ic[N+1].Y:=40;GbRes.I[K].Ic[N+1].Bmp:='';
   GbRes.I[K].Ic[N+1].Tg:='';End;
  End Else If R=N+2 Then Begin If N>1 Then Dec(GbRes.I[K].N);End;
 Until (R=0) Or (R=N+3);
End;

{ ---------------------- editeur de boites de dialogue ---------------------- }

Function GbDlgKind(K: Integer): String;
Begin
 Case K Of
  1: GbDlgKind:=T3('Text','Texte','Text');
  2: GbDlgKind:=T3('Expression','Expression','Ausdruck');
  3: GbDlgKind:=T3('Icon','Ic'#147'ne','Symbol');
  4: GbDlgKind:='OK';
  5: GbDlgKind:=T3('Cancel','Annuler','Abbruch');
  6: GbDlgKind:='Disk';
 Else GbDlgKind:='?';
 End;
End;

Procedure GbEdDialog(K: Integer);
Var L,V: String; I,R,N,T: Integer;
Begin
 Repeat
  N:=GbRes.D[K].N;
  L:='';
  For I:=1 To N Do Begin
   L:=L+IntStr(I)+'. '+GbDlgKind(GbRes.D[K].It[I].K);
   If GbRes.D[K].It[I].K<=3 Then L:=L+': '+GbRes.D[K].It[I].Txt;
   L:=L+'|';
  End;
  L:=L+T3('+ Add object','+ Ajouter un objet',
      '+ Objekt hinzuf'#129'gen')+'|'+T3('- Remove last object',
      '- Supprimer le dernier','- Letztes entfernen')+'|'+T3('Done',
      'Termin'#130,'Fertig');
  R:=GbPick(T3('Dialog box - ','Bo'#140'te de dialogue - ',
      'Dialogbox - ')+GbRes.D[K].Name,T3('Objects: ','Objets : ',
      'Objekte: ')+IntStr(N),L);
  If (R>=1) And (R<=N) Then Begin
   If GbRes.D[K].It[R].K<=3 Then Begin
    V:=GbRes.D[K].It[R].Txt;
    If GbAsk('Dialog',T3('Text, expression or bitmap name:',
        'Texte, expression ou nom de bitmap :','Text, Ausdruck oder Bitmap:'),V,
        40) Then GbRes.D[K].It[R].Txt:=V;
   End;
  End Else If R=N+1 Then Begin
   If N<12 Then Begin
    T:=GbPick('Dialog',T3('Object type','Type d''objet','Objekttyp'),
        T3('Text|Expression|Icon|OK|Cancel|Disk',
        'Texte|Expression|Ic'#147'ne|OK|Annuler|Disk',
        'Text|Ausdruck|Symbol|OK|Abbruch|Disk'));
    If T>0 Then Begin
     Inc(GbRes.D[K].N);GbRes.D[K].It[N+1].K:=T;GbRes.D[K].It[N+1].X:=8;
     GbRes.D[K].It[N+1].Y:=8+N*12;GbRes.D[K].It[N+1].Txt:='';
     If T<=3 Then Begin
      V:='';If GbAsk('Dialog',T3('Text, expression or bitmap name:',
          'Texte, expression ou nom de bitmap :','Text, Ausdruck oder Bitmap:'),
          V,40) Then GbRes.D[K].It[N+1].Txt:=V;
     End;
    End;
   End;
  End Else If R=N+2 Then Begin If N>1 Then Dec(GbRes.D[K].N);End;
 Until (R=0) Or (R=N+3);
End;

{ ---------------------- editeur de bitmaps ---------------------- }

Procedure GbEdBitmap(K: Integer);
Const CS=9;
Var W,H,X1,Y1,GX,GY,I,X,Y,PV,BY,BX: Integer; E: TEvent; Done,Ok,Dn: Boolean;
Sv: TSave; Tmp: TRBmp; V: String;
 Procedure Draw;
 Var PX,PY: Integer;
 Begin
  HideMouse;ClipFull;
  GBar(GX-1,GY-1,GX+24*CS,GY+24*CS,cWht);
  For PY:=0 To 23 Do For PX:=0 To 23 Do Begin
   If (PX<GbRes.B[K].W) And (PY<GbRes.B[K].H) Then Begin
    If GbRes.B[K].D[PY,PX]<>0 Then GBar(GX+PX*CS+1,GY+PY*CS+1,GX+PX*CS+CS-1,
        GY+PY*CS+CS-1,cBlk)
    Else GBar(GX+PX*CS+1,GY+PY*CS+1,GX+PX*CS+CS-1,GY+PY*CS+CS-1,cWht);
   End Else GBar(GX+PX*CS,GY+PY*CS,GX+PX*CS+CS-1,GY+PY*CS+CS-1,cLGr);
  End;
  For PX:=0 To GbRes.B[K].W Do GLine(GX+PX*CS,GY,GX+PX*CS,GY+GbRes.B[K].H*CS,
      cDGr);
  For PY:=0 To GbRes.B[K].H Do GLine(GX,GY+PY*CS,GX+GbRes.B[K].W*CS,GY+PY*CS,
      cDGr);
  { apercu en taille reelle }
  BX:=GX+24*CS+16;
  GBar(BX,GY,BX+39,GY+39,cWht);GRect(BX-1,GY-1,BX+40,GY+40,cBlk);
  For PY:=0 To GbRes.B[K].H-1 Do For PX:=0 To GbRes.B[K].W-1 Do
   If (GbRes.B[K].D[PY,PX]<>0) And (PX<40) And (PY<40) Then GBar(BX+PX,GY+PY,
       BX+PX,GY+PY,cBlk);
  GText(BX,GY+46,IntStr(GbRes.B[K].W)+'x'+IntStr(GbRes.B[K].H),cBlk);
  ShowMouse;
 End;
Begin
 Tmp:=GbRes.B[K];
 W:=540;H:=24*CS+TITLE_H+BORDER*2+70;
 DlgBegin(Sv,W,H,T3('Bitmap editor - ','Editeur de bitmaps - ',
     'Bitmap-Editor - ')+GbRes.B[K].Name,X1,Y1);
 GX:=X1+BORDER+14;GY:=Y1+BORDER+TITLE_H+12;
 BY:=Y1+H-BORDER-32;
 HideMouse;ClipFull;
 Button(X1+14,BY,X1+104,BY+22,'OK',True,False,True);
 Button(X1+114,BY,X1+204,BY+22,T3('Cancel','Annuler','Abbruch'),False,False,
     True);
 Button(X1+214,BY,X1+304,BY+22,T3('Clear','Effacer','L'#148'schen'),False,False,
     True);
 Button(X1+314,BY,X1+404,BY+22,T3('Invert','Inverser','Umkehren'),False,False,
     True);
 Button(X1+414,BY,X1+504,BY+22,T3('Size...','Taille...','Gr'#148#225'e...'),
     False,False,True);
 ShowMouse;
 Draw;
 Done:=False;Ok:=False;Dn:=False;PV:=1;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   If E.Key=K_ENTER Then Begin Ok:=True;Done:=True;End;
   If E.Key=K_ESC Then Done:=True;
  End Else If (E.Kind=EV_DOWN) Or ((E.Kind=EV_MOVE) And Dn) Then Begin
   X:=(E.X-GX) Div CS;Y:=(E.Y-GY) Div CS;
   If (E.X>=GX) And (E.Y>=GY) And (X>=0) And (X<GbRes.B[K].W) And (Y>=0)
       And (Y<GbRes.B[K].H) Then Begin
    If E.Kind=EV_DOWN Then Begin Dn:=True;PV:=1-GbRes.B[K].D[Y,X];End;
    GbRes.B[K].D[Y,X]:=PV;Draw;
   End Else If E.Kind=EV_DOWN Then Begin
    If InBox(E.X,E.Y,X1+14,BY,X1+104,BY+22) Then Begin Ok:=True;Done:=True;End
    Else If InBox(E.X,E.Y,X1+114,BY,X1+204,BY+22) Then Done:=True
    Else If InBox(E.X,E.Y,X1+214,BY,X1+304,
        BY+22) Then Begin FillChar(GbRes.B[K].D,SizeOf(GbRes.B[K].D),0);Draw;End
    Else If InBox(E.X,E.Y,X1+314,BY,X1+404,BY+22) Then Begin
     For Y:=0 To GbRes.B[K].H-1 Do For X:=0 To GbRes.B[K].W-1 Do GbRes.B[K].D[Y,
         X]:=1-GbRes.B[K].D[Y,X];
     Draw;
    End Else If InBox(E.X,E.Y,X1+414,BY,X1+504,BY+22) Then Begin
     V:=IntStr(GbRes.B[K].W);
     If GbAsk('Bitmap',T3('Width (1-24):','Largeur (1-24) :','Breite (1-24):'),
         V,2) Then GbRes.B[K].W:=Clamp(StrVal(V,16),1,24);
     V:=IntStr(GbRes.B[K].H);
     If GbAsk('Bitmap',T3('Height (1-24):','Hauteur (1-24) :',
         'H'#148'he (1-24):'),V,2) Then GbRes.B[K].H:=Clamp(StrVal(V,16),1,24);
     Draw;
    End;
   End;
  End Else If E.Kind=EV_UP Then Dn:=False;
 Until Done;
 If Not Ok Then GbRes.B[K]:=Tmp;
 DlgEnd(Sv);
End;

{ point d'entree : 1 menu, 2 icones, 3 dialogue, 4 bitmap, 5 sprite }
Procedure GbResEdit(Kind: Integer);
Var K: Integer;
Begin
 If Kind=5 Then Begin
  Info('Sprite',T3('The sprite editor is not available '+
      'in this version.|Use TEXT, DISC '+'and BITMAP to animate shapes.',
   'L'#130'diteur de sprites n''est pas '+
       'disponible dans cette version.|Utilisez '+
       'TEXT, DISC et BITMAP pour animer '+'des formes.',
   'Der Sprite-Editor ist in dieser Version nicht verf'#129'gbar.'));
  Exit;
 End;
 K:=GbSelectRes(Kind);
 If K=0 Then Exit;
 Case Kind Of
  1: GbEdMenu(K);
  2: GbEdIcons(K);
  3: GbEdDialog(K);
  4: GbEdBitmap(K);
 End;
End;

{ ====================================================================== }
{   VISIONNEUSE DE TABLEUR : Lotus 1-2-3 (.WKS, .WK1) et Quattro Pro      }
{   (.WQ1) - valeurs et libelles des cellules, sans les formules.        }
{ ====================================================================== }

Const
 MAXWC = 4000;
 CM_WKOPEN=1400; CM_WKGOTO=1401; CM_WKCSV=1402; CM_WKINFO=1403;

Type
 TWCell = Record
  Row,Col : Word;
  Kind    : Byte;          { 1 nombre, 2 libelle, 3 formule }
  Fmt     : Byte;
  Val     : Real;
  Txt     : String[60];
 End;

 PWk = ^TWk;
 TWk = Record
  N        : Integer;
  Cell     : Array[1..MAXWC] Of TWCell;
  ColW     : Array[0..255] Of Byte;
  MaxR,MaxC: Integer;
  CX,CY    : Integer;      { cellule courante }
  LX,LY    : Integer;      { cellule en haut a gauche }
  FName    : String;
  Kindf    : String[8];    { WKS, WK1, WQ1 }
  Msg      : String;
 End;

Function WkNew(AX,AY: Integer; Const AFile: String): PWindow; Forward;
Procedure WkDrawClient(Wd_: PWindow); Forward;
Procedure WkOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure WkOnKey(Wd_: PWindow; K: Word); Forward;
Procedure WkOnCommand(Wd_: PWindow; Cmd: Integer); Forward;

Function WkColName(C: Integer): String;
Begin
 If C<26 Then WkColName:=Chr(65+C)
 Else WkColName:=Chr(64+C Div 26)+Chr(65+C Mod 26);
End;

Function WkAddr(C,R: Integer): String;
Begin
 WkAddr:=WkColName(C)+IntStr(R+1);
End;

Function WkFind(Dt_: PWk; R,C: Integer): Integer;
Var I: Integer;
Begin
 WkFind:=0;
 For I:=1 To Dt_^.N Do
  If (Dt_^.Cell[I].Row=R) And (Dt_^.Cell[I].Col=C) Then Begin WkFind:=I;Exit;
  End;
End;

Procedure WkPut(Dt_: PWk; R,C: Integer; K,Fm: Byte; V: Real; Const S: String);
Var I: Integer;
Begin
 I:=WkFind(Dt_,R,C);
 If I=0 Then Begin
  If Dt_^.N>=MAXWC Then Exit;
  Inc(Dt_^.N);I:=Dt_^.N;
 End;
 Dt_^.Cell[I].Row:=R;Dt_^.Cell[I].Col:=C;Dt_^.Cell[I].Kind:=K;
 Dt_^.Cell[I].Fmt:=Fm;
 Dt_^.Cell[I].Val:=V;Dt_^.Cell[I].Txt:=Copy(S,1,60);
 If R>Dt_^.MaxR Then Dt_^.MaxR:=R;
 If C>Dt_^.MaxC Then Dt_^.MaxC:=C;
End;

{ Reel IEEE 754 sur 8 octets (little endian) }
Function WkDouble(Var B; Off: Integer): Real;
Var P: PByteArr; D: Double;
Begin
 P:=@B;
 Move(P^[Off],D,8);
 WkDouble:=D;
End;

{ Charge un fichier ; retourne '' ou un message d'erreur }
Function WkLoad(Dt_: PWk; Const Path: String): String;
Var F: File; Hd: Array[0..3] Of Byte; Buf: Array[0..1023] Of Byte;
Op,Len,Ver,N: Word; Col,Row: Integer; Ch: Char;
    Fm: Byte; S: String; I,Ofs,Q: Integer; Qp: Boolean; V: Real; Base: Integer;
Begin
 WkLoad:='';
 Dt_^.N:=0;Dt_^.MaxR:=0;Dt_^.MaxC:=0;Dt_^.CX:=0;Dt_^.CY:=0;Dt_^.LX:=0;
 Dt_^.LY:=0;
 FillChar(Dt_^.ColW,SizeOf(Dt_^.ColW),9);
 {$I-}
 Assign(F,Path);FileMode:=0;Reset(F,1);
 {$I+}
 If IOResult<>0 Then Begin WkLoad:=T3('Cannot open the file.',
     'Impossible d''ouvrir le fichier.','Datei nicht ge'#148'ffnet.');Exit;End;
 Qp:=False;Ver:=0;
 {$I-}
 BlockRead(F,Hd,4,N);
 {$I+}
 Op:=Hd[0]+256*Hd[1];
 If (N<4) Or (Op<>0) Then Begin Close(F);
 WkLoad:=T3('Not a spreadsheet file.','Ce n''est pas un fichier de tableur.',
     'Keine Tabellendatei.');Exit;End;
 Len:=Hd[2]+256*Hd[3];
 If Len>1024 Then Len:=1024;
 {$I-}
 BlockRead(F,Buf,Len,N);
 {$I+}
 Ver:=Buf[0]+256*Buf[1];
 Case Ver Of
  $0404: Begin Dt_^.Kindf:='WKS';Base:=0;End;
  $0406: Begin Dt_^.Kindf:='WK1';Base:=1;End;
 Else
  If (Ver>=$5000) And (Ver<$6000) Then Begin Dt_^.Kindf:='WQ1';Base:=1;Qp:=True;
  End
  Else Begin Close(F);WkLoad:=T3('Unsupported spreadsheet version.',
      'Version de tableur non g'#130'r'#130'e.',
      'Nicht unterst'#129'tzte Version.');Exit;End;
 End;
 {$I-}
 While Not Eof(F) Do Begin
  BlockRead(F,Hd,4,N);
  If N<4 Then Break;
  Op:=Hd[0]+256*Hd[1];Len:=Hd[2]+256*Hd[3];
  If Len>1024 Then Begin
   Seek(F,FilePos(F)+Len);
  End Else Begin
   If Len>0 Then BlockRead(F,Buf,Len,N);
   If Op=1 Then Break;
   If (Op=8) And (Len>=2) And Not Qp Then Dt_^.ColW[Buf[0]]:=Max2(3,Min2(40,
       Buf[1]));
   If Base=0 Then I:=Op+1 Else I:=Op;
   If (I>=$0D) And (I<=$10) Then Begin
    { I normalise : 0D entier, 0E nombre, 0F libelle, 10 formule }
    If Qp Then Begin
     { Quattro Pro : colonne(1) page(1) ligne(2) attributs(2) }
     Col:=Buf[0];Row:=Buf[2]+256*Buf[3];Fm:=Buf[4] And $FF;Ofs:=6;
    End Else Begin
     Fm:=Buf[0];Col:=Buf[1]+256*Buf[2];Row:=Buf[3]+256*Buf[4];Ofs:=5;
    End;
    Case I Of
     $0D: If Len>=Ofs+2 Then WkPut(Dt_,Row,Col,1,Fm,
         SmallInt(Buf[Ofs]+256*Buf[Ofs+1]),'');
     $0E: If Len>=Ofs+8 Then WkPut(Dt_,Row,Col,1,Fm,WkDouble(Buf,Ofs),'');
     $0F: Begin
           S:=CStr(Buf,Ofs,Min2(Len-Ofs,60));
           If (S<>'') And (S[1] In ['''','"','^','\','|']) Then Begin
            If S[1]='\' Then Begin
             Q:=Dt_^.ColW[Min2(Col,255)];
             Ch:=' ';If Length(S)>1 Then Ch:=S[2];
             S:='';
             For I:=1 To Q Do S:=S+Ch;
            End
            Else Delete(S,1,1);
           End;
           WkPut(Dt_,Row,Col,2,Fm,0,GeosToDos(S));
          End;
     $10: If Len>=Ofs+8 Then WkPut(Dt_,Row,Col,3,Fm,WkDouble(Buf,Ofs),'');
    End;
   End;
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 If Dt_^.N=0 Then WkLoad:=T3('The spreadsheet is empty.','Le tableur est vide.',
     'Die Tabelle ist leer.');
End;

{ Formate une valeur selon l'octet de format Lotus }
Function WkFmtNum(V: Real; Fm: Byte): String;
Var Dec: Integer; S: String; Typ: Integer; Neg: Boolean;
Begin
 Typ:=(Fm Shr 4) And 7;Dec:=Fm And 15;
 If Dec>9 Then Dec:=2;
 Case Typ Of
  0: Begin Str(V:0:Dec,S);End;
  1: Begin Str(V:0:Dec+1,S);End;
  2: Begin Str(V:0:Dec,S);S:=CurSym+S;End;
  3: Begin Str(V*100:0:Dec,S);S:=S+'%';End;
  4: Begin
      Neg:=V<0;Str(Abs(V):0:Dec,S);
      If Pos('.',S)>0 Then S:=NumFmt(Trunc(Abs(V)))+Copy(S,Pos('.',S),
          20) Else S:=NumFmt(Trunc(Abs(V)));
      If Neg Then S:='-'+S;
     End;
 Else S:=FmtReal(V);
 End;
 If (Typ<>0) And (Typ<>1) And (Typ<>2) And (Typ<>3) And (Typ<>4) Then
     S:=FmtReal(V);
 If Typ=7 Then S:=FmtReal(V);
 If (Typ=0) And (Fm=$FF) Then S:=FmtReal(V);
 WkFmtNum:=TrimStr(S);
End;

Function WkText(Dt_: PWk; I: Integer): String;
Begin
 Case Dt_^.Cell[I].Kind Of
  1,3: WkText:=WkFmtNum(Dt_^.Cell[I].Val,Dt_^.Cell[I].Fmt);
 Else WkText:=Dt_^.Cell[I].Txt;
 End;
End;

Function WkNew(AX,AY: Integer; Const AFile: String): PWindow;
 Var Wd_: PWindow; Dt_: PWk; E: String;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_WK1,AX,AY,560,340,T3('Spreadsheet Viewer',
     'Visionneuse de tableur','Tabellenbetrachter'));
 Wd_^.IconId:=IC_CALC;Wd_^.MinW:=300;Wd_^.MinH:=180;
 FillChar(Dt_^.ColW,SizeOf(Dt_^.ColW),9);
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'Open...~Ouvrir...~'#142'ffnen...',CM_WKOPEN,'Ctrl+O');
 WinAddItem(Wd_,'Export as Text (CSV)...~Exporter '+
     'en texte (CSV)...~Als Text exportieren '+'(CSV)...',CM_WKCSV,'');
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'View~Affichage~Ansicht');
 WinAddItem(Wd_,'Go To Cell...~Aller '#133' la cellule...~Gehe zu Zelle...',
     CM_WKGOTO,'Ctrl+G');
 WinAddItem(Wd_,'File Information~Informations~Dateiinfo',CM_WKINFO,'');
 If AFile<>'' Then Begin
  E:=WkLoad(Dt_,AFile);
  If E<>'' Then Info(T3('Spreadsheet Viewer','Visionneuse de tableur',
      'Tabellenbetrachter'),E)
  Else Begin Dt_^.FName:=AFile;Wd_^.Title:=T3('Spreadsheet','Tableur',
      'Tabelle')+' - '+ShortName(AFile);End;
 End;
 WkNew:=Wd_;
End;

Procedure WkGeom(Wd_: PWindow; Var X1,Y1,X2,Y2,VC,VR: Integer);
 Var Dt_: PWk;
Var I,X: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 VR:=(Y2-Y1-14-16) Div 14;
 If VR<1 Then VR:=1;
 VC:=0;X:=X1+34;
 I:=Dt_^.LX;
 While (X<X2) And (I<256) Do Begin Inc(VC);Inc(X,Dt_^.ColW[I]*8+4);Inc(I);End;
End;

Procedure WkDrawClient(Wd_: PWindow);
 Var Dt_: PWk;
Var X1,Y1,X2,Y2,VC,VR,I,J,K,X,Y,CW: Integer; S: String; Sel: Boolean;
C: Integer;
Begin
 Dt_:=Wd_^.Data;
 WkGeom(Wd_,X1,Y1,X2,Y2,VC,VR);
 GBar(X1,Y1,X2,Y2,cWht);
 { barre de formule }
 GBar(X1,Y1,X2,Y1+13,cLGr);
 K:=WkFind(Dt_,Dt_^.CY,Dt_^.CX);
 S:=WkAddr(Dt_^.CX,Dt_^.CY)+'  ';
 If K>0 Then Begin
  S:=S+WkText(Dt_,K);
  If Dt_^.Cell[K].Kind=3 Then S:=S+'  ('+T3('formula, cached value',
      'formule, valeur m'#130'moris'#130'e','Formel, gespeicherter Wert')+')';
 End;
 GText(X1+6,Y1+3,Copy(S,1,(X2-X1-12) Div 8),cBlk);
 GHLine(X1,X2,Y1+13,cDGr);
 { en-tetes de colonnes }
 GBar(X1,Y1+14,X2,Y1+27,cLGr);
 X:=X1+34;
 For I:=0 To VC-1 Do Begin
  CW:=Dt_^.ColW[Dt_^.LX+I]*8+4;
  If Dt_^.LX+I=Dt_^.CX Then GBar(X,Y1+14,X+CW-1,Y1+27,cDGr);
  GTextCtr(X,X+CW-1,Y1+17,WkColName(Dt_^.LX+I),cBlk);
  GVLine(X+CW-1,Y1+14,Y2,cLGr);
  Inc(X,CW);
 End;
 { lignes }
 For J:=0 To VR-1 Do Begin
  Y:=Y1+28+J*14;
  GBar(X1,Y,X1+33,Y+13,cLGr);
  If Dt_^.LY+J=Dt_^.CY Then GBar(X1,Y,X1+33,Y+13,cDGr);
  GText(X1+30-TextW(IntStr(Dt_^.LY+J+1)),Y+3,IntStr(Dt_^.LY+J+1),cBlk);
  GHLine(X1,X2,Y+13,cLGr);
  X:=X1+34;
  For I:=0 To VC-1 Do Begin
   CW:=Dt_^.ColW[Dt_^.LX+I]*8+4;
   K:=WkFind(Dt_,Dt_^.LY+J,Dt_^.LX+I);
   Sel:=(Dt_^.LX+I=Dt_^.CX) And (Dt_^.LY+J=Dt_^.CY);
   If Sel Then Begin GBar(X,Y,X+CW-2,Y+12,cBlk);C:=cWht;End Else C:=cBlk;
   If K>0 Then Begin
    S:=WkText(Dt_,K);
    S:=Copy(S,1,(CW-2) Div 8);
    If Dt_^.Cell[K].Kind=2 Then GText(X+2,Y+3,S,C) Else GText(X+CW-4-TextW(S),
        Y+3,S,C);
   End;
   Inc(X,CW);
  End;
 End;
 { cadre }
 If Dt_^.Msg<>'' Then Begin GBar(X1,Y2-12,X2,Y2,cLGr);
 GText(X1+6,Y2-10,Copy(Dt_^.Msg,1,(X2-X1-12) Div 8),cDGr);End;
End;

Procedure WkReveal(Wd_: PWindow);
 Var Dt_: PWk;
Var X1,Y1,X2,Y2,VC,VR: Integer;
Begin
 Dt_:=Wd_^.Data;
 WkGeom(Wd_,X1,Y1,X2,Y2,VC,VR);
 If Dt_^.CX<0 Then Dt_^.CX:=0;
 If Dt_^.CY<0 Then Dt_^.CY:=0;
 If Dt_^.CX>255 Then Dt_^.CX:=255;
 If Dt_^.CY>8191 Then Dt_^.CY:=8191;
 If Dt_^.CX<Dt_^.LX Then Dt_^.LX:=Dt_^.CX;
 If Dt_^.CX>=Dt_^.LX+Max2(1,VC-1) Then Dt_^.LX:=Dt_^.CX-Max2(1,VC-1)+1;
 If Dt_^.CY<Dt_^.LY Then Dt_^.LY:=Dt_^.CY;
 If Dt_^.CY>=Dt_^.LY+VR Then Dt_^.LY:=Dt_^.CY-VR+1;
End;

Procedure WkOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PWk;
Var X1,Y1,X2,Y2,VC,VR,I,J,X,CW: Integer;
Begin
 Dt_:=Wd_^.Data;
 If E.Kind<>EV_DOWN Then Exit;
 WkGeom(Wd_,X1,Y1,X2,Y2,VC,VR);
 If (E.X<X1+34) Or (E.Y<Y1+28) Then Exit;
 J:=(E.Y-Y1-28) Div 14;
 If J>=VR Then Exit;
 X:=X1+34;
 For I:=0 To VC-1 Do Begin
  CW:=Dt_^.ColW[Dt_^.LX+I]*8+4;
  If (E.X>=X) And (E.X<X+CW) Then Begin Dt_^.CX:=Dt_^.LX+I;Dt_^.CY:=Dt_^.LY+J;
  End;
  Inc(X,CW);
 End;
 Invalidate(Wd_);
End;

Procedure WkGoto(Wd_: PWindow);
 Var Dt_: PWk;
Var S: String; I,C,R: Integer;
Begin
 Dt_:=Wd_^.Data;
 S:='A1';
 If Not InputBox(T3('Go To Cell','Aller '#133' la cellule','Gehe zu Zelle'),
     T3('Cell (for example B12):','Cellule (par exemple B12) :',
     'Zelle (z. B. B12):'),S,10) Then Exit;
 S:=Upper(S);
 C:=0;I:=1;
 While (I<=Length(S)) And (S[I] In ['A'..'Z']) Do Begin C:=C*26+Ord(S[I])-64;
 Inc(I);End;
 R:=StrVal(Copy(S,I,10),1);
 If (C>=1) And (R>=1) Then Begin Dt_^.CX:=C-1;Dt_^.CY:=R-1;WkReveal(Wd_);End;
End;

Procedure WkOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PWk;
Var X1,Y1,X2,Y2,VC,VR: Integer;
Begin
 Dt_:=Wd_^.Data;
 WkGeom(Wd_,X1,Y1,X2,Y2,VC,VR);
 Case K Of
  K_LEFT: Dec(Dt_^.CX);
  K_RIGHT: Inc(Dt_^.CX);
  K_UP: Dec(Dt_^.CY);
  K_DOWN: Inc(Dt_^.CY);
  K_PGUP: Dec(Dt_^.CY,VR);
  K_PGDN: Inc(Dt_^.CY,VR);
  K_HOME: Begin Dt_^.CX:=0;Dt_^.CY:=0;End;
  K_END: Begin Dt_^.CX:=Dt_^.MaxC;Dt_^.CY:=Dt_^.MaxR;End;
  7: Begin WkGoto(Wd_);End;
  K_CTRLO: Begin WkOnCommand(Wd_,CM_WKOPEN);Exit;End;
 End;
 WkReveal(Wd_);
 Invalidate(Wd_);
End;

Procedure WkExportCsv(Wd_: PWindow);
 Var Dt_: PWk;
Var P,S,T: String; F: Text; R,C,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.N=0 Then Exit;
 P:=JoinPath(CurDirStr,'EXPORT.CSV');
 If Not FileDlg(T3('Export as Text','Exporter en texte','Als Text exportieren'),
     '*.CSV',P,True) Then Exit;
 {$I-}
 Assign(F,P);Rewrite(F);
 {$I+}
 If IOResult<>0 Then Begin Info(T3('Error','Erreur','Fehler'),
     T3('Cannot save file.','Impossible d''enregistrer.',
     'Datei nicht speicherbar.'));Exit;End;
 {$I-}
 For R:=0 To Dt_^.MaxR Do Begin
  S:='';
  For C:=0 To Dt_^.MaxC Do Begin
   K:=WkFind(Dt_,R,C);
   If K>0 Then T:=WkText(Dt_,K) Else T:='';
   If (Pos(';',T)>0) Or (Pos('"',T)>0) Then T:='"'+T+'"';
   If C>0 Then S:=S+';';
   S:=S+T;
  End;
  WriteLn(F,S);
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 Dt_^.Msg:=T3('Exported: ','Export'#130' : ','Exportiert: ')+ShortName(P);
End;

Procedure WkOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PWk;
Var P,E: String;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_WKOPEN: Begin
              P:=CurDirStr;
              If FileDlg(T3('Open','Ouvrir',#142'ffnen'),'*.WK1',P,
                  False) Then Begin
               E:=WkLoad(Dt_,P);
               If E<>'' Then Info(T3('Spreadsheet Viewer',
                   'Visionneuse de tableur','Tabellenbetrachter'),E)
               Else Begin Dt_^.FName:=P;Dt_^.Msg:='';
               Wd_^.Title:=T3('Spreadsheet','Tableur',
                   'Tabelle')+' - '+ShortName(P);End;
              End;
             End;
  CM_WKGOTO: WkGoto(Wd_);
  CM_WKCSV: WkExportCsv(Wd_);
  CM_WKINFO: Info(T3('File Information','Informations','Dateiinfo'),
      ShortName(Dt_^.FName)+'|'+Dt_^.Kindf+'|'+
              IntStr(Dt_^.N)+T3(' cells',' cellules',' Zellen')+'|'+WkAddr(0,
                  0)+':'+WkAddr(Dt_^.MaxC,Dt_^.MaxR));
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

