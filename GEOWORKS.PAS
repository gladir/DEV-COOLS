{ Convertit un texte GEOS (jeu Mac) en jeu DOS (CP437) }
Function GeosToDos(Const S: String): String;
Var I: Integer; R: String;
Begin
 R:=S;
 For I:=1 To Length(R) Do
  If R[I]>=#128 Then R[I]:=Chr(GeosXlate[Ord(R[I])-128]);
 GeosToDos:=R;
End;

Function ReadGeosHeader(Const Path: String; Var G: TGeosInfo): Boolean;
Var F: File; Buf: Array[0..255] Of Byte; N: Word; Magic: LongInt;
    P: PByteArr;
Begin
 ReadGeosHeader:=False;
 FillChar(G,SizeOf(G),0);
 FillChar(Buf,SizeOf(Buf),0);
 {$I-}
 Assign(F,Path);
 FileMode:=0;
 Reset(F,1);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 BlockRead(F,Buf,256,N);
 Close(F);
 {$I+}
 If (IOResult<>0) Or (N<64) Then Exit;
 P:=@Buf;
 Magic:=P^[0]+256*LongInt(P^[1])+65536*LongInt(P^[2])+16777216*LongInt(P^[3]);
 If Magic=$53CF45C7 Then Begin
  G.Valid:=True;G.Ver:=1;
  G.FType:=P^[4]+256*P^[5];
  G.IsExe:=G.FType=0;
  G.Release:=P^[8]+256*P^[9];
  G.Protocol:=P^[16]+256*P^[17];
  G.Tok:=CStr(Buf,$14,4);
  G.Creator:=CStr(Buf,$1A,4);
  G.LongName:=GeosToDos(CStr(Buf,$20,34));
  G.Notes:=GeosToDos(CStr(Buf,$44,60));
 End Else If Magic=$53C145C7 Then Begin
  G.Valid:=True;G.Ver:=2;
  G.FType:=P^[40]+256*P^[41];
  G.IsExe:=G.FType=1;
  G.Release:=P^[44]+256*P^[45];
  G.Protocol:=P^[52]+256*P^[53];
  G.Tok:=CStr(Buf,56,4);
  G.Creator:=CStr(Buf,62,4);
  G.LongName:=GeosToDos(CStr(Buf,4,34));
  G.Notes:=GeosToDos(CStr(Buf,68,60));
 End;
 ReadGeosHeader:=G.Valid;
End;

Function DocIcon(Const Creator: String): Integer;
Begin
 DocIcon:=IC_GEODOC;
 If Creator='WP00' Then DocIcon:=IC_WRITEDOC
 Else If Creator='DP00' Then DocIcon:=IC_DRAWDOC
 Else If (Creator='PLNR') Or (Creator='PLNG') Then DocIcon:=IC_PLANDOC
 Else If (Creator='ADBK') Or (Creator='GDBK') Then DocIcon:=IC_DEXDOC;
End;

Function IsNumExt(Const E: String): Boolean;
Begin
 IsNumExt:=(Length(E)=3) And (E[1]>='0') And (E[1]<='9') And (E[2]>='0') And (E[2]<='9')
  And (E[3]>='0') And (E[3]<='9');
End;

Function IsTextExt(Const E: String): Boolean;
Begin
 IsTextExt:=(E='TXT') Or (E='DOC') Or (E='PAS') Or (E='INI') Or (E='ASM') Or (E='C') Or
  (E='H') Or (E='BAS') Or (E='CFG') Or (E='LOG') Or (E='MD') Or (E='INC') Or (E='CPP') Or
  (E='TC') Or (E='MAC') Or (E='STR');
End;

