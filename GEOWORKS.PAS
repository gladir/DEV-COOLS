Var
 IconPx : Array[0..NICONS+NBIG-1] Of PByteArr;
 IconWd,IconHt : Array[0..NICONS+NBIG-1] Of Integer;
 BackBits : Array[0..NBACK-1] Of PByteArr;
 BackWd,BackHt : Array[0..NBACK-1] Of Integer;
 BackTile : Pointer;
 BackTileSz : LongInt;
 BackTileW,BackTileH : Integer;
 BackTileIdx,BackTileInk,BackTilePaper : Integer;

Function HexVal(C: Char): Integer;
Begin
 If (C>='0') And (C<='9') Then HexVal:=Ord(C)-48
 Else If (C>='A') And (C<='F') Then HexVal:=Ord(C)-55
 Else If (C>='a') And (C<='f') Then HexVal:=Ord(C)-87
 Else HexVal:=0;
End;

{ Les monikers sont du PackBits : n<128 -> n+1 octets litteraux ;
  n>128 -> 257-n copies de l'octet suivant ; 128 -> sans effet }
Procedure UnpackRow(Blob: PByteArr; Var P: Integer; Comp: Byte;
                    Var Row: Array Of Byte; RB: Integer);
Var Cnt,K,B,V: Integer;
Begin
 Cnt:=0;
 If Comp=0 Then Begin
  For K:=0 To RB-1 Do Begin Row[K]:=Blob^[P];Inc(P);End;
  Exit;
 End;
 While Cnt<RB Do Begin
  B:=Blob^[P];Inc(P);
  If B<128 Then Begin
   For K:=0 To B Do Begin
    If Cnt<RB Then Row[Cnt]:=Blob^[P];
    Inc(P);Inc(Cnt);
   End;
  End Else If B>128 Then Begin
   V:=Blob^[P];Inc(P);
   For K:=1 To 257-B Do Begin
    If Cnt<RB Then Row[Cnt]:=V;
    Inc(Cnt);
   End;
  End;
 End;
End;

Type
 THex = String[200];

Procedure LoadIconSet(Const Lines: Array Of THex; NBytes,First,Count: Integer);
Var Blob: PByteArr; L,I,N,P,Id,W,H,Y,X,MB,RB,Len,Q: Integer;
    S: String; Comp: Byte; Row: Array[0..127] Of Byte; V: Integer;
Begin
 GetMem(Blob,NBytes+16);
 N:=0;
 For L:=0 To High(Lines) Do Begin
  S:=Lines[L];
  I:=1;
  While I<Length(S) Do Begin
   Blob^[N]:=HexVal(S[I])*16+HexVal(S[I+1]);
   Inc(N);Inc(I,2);
  End;
 End;
 P:=0;
 For Id:=First To First+Count-1 Do Begin
  W:=Blob^[P];H:=Blob^[P+1];Comp:=Blob^[P+2];
  Len:=Blob^[P+4]+256*Blob^[P+5];
  Q:=P+6;
  P:=P+6+Len;
  IconWd[Id]:=W;IconHt[Id]:=H;
  GetMem(IconPx[Id],W*H);
  MB:=(W+7) Div 8;
  RB:=MB+(W+1) Div 2;
  For Y:=0 To H-1 Do Begin
   FillChar(Row,SizeOf(Row),0);
   UnpackRow(Blob,Q,Comp,Row,RB);
   For X:=0 To W-1 Do Begin
    If (Row[X Shr 3] And (128 Shr (X And 7)))<>0 Then Begin
     V:=Row[MB+X Shr 1];
     If Odd(X) Then V:=V And 15 Else V:=V Shr 4;
     IconPx[Id]^[Y*W+X]:=V;
    End Else IconPx[Id]^[Y*W+X]:=255;
   End;
  End;
 End;
 FreeMem(Blob,NBytes+16);
End;

Procedure LoadIcons;
Begin
 LoadIconSet(IconHex,ICONBLOB_BYTES,0,NICONS);
 LoadIconSet(BigHex,BIGBLOB_BYTES,NICONS,NBIG);
End;

{ Numero de l'icone 64x40 correspondante, ou -1 }
Function BigIcon(Id: Integer): Integer;
Begin
 BigIcon:=-1;
 If (Id>=0) And (Id<NICONS) Then
  If IconBigOf[Id]>=0 Then BigIcon:=NICONS+IconBigOf[Id];
End;

{ Dessine une icone (transparente) ; Inv inverse les couleurs (selection) }
Procedure DrawIcon(Id,X,Y: Integer; Inv: Boolean);
Var I,J,K,C,W,H: Integer; P: PByteArr;
Begin
 If (Id<0) Or (Id>=NICONS+NBIG) Then Exit;
 W:=IconWd[Id];H:=IconHt[Id];
 If Not Vis(X,Y,X+W-1,Y+H-1) Then Exit;
 P:=IconPx[Id];
 For J:=0 To H-1 Do Begin
  If (Y+J<CY1) Or (Y+J>CY2) Then
  Else Begin
   I:=0;
   While I<W Do Begin
    C:=P^[J*W+I];
    If C=255 Then Inc(I)
    Else Begin
     K:=I;
     While (K+1<W) And (P^[J*W+K+1]=C) Do Inc(K);
     If Inv Then GHLine(X+I,X+K,Y+J,C Xor 15) Else GHLine(X+I,X+K,Y+J,C);
     I:=K+1;
    End;
   End;
  End;
 End;
End;

{ Icone agrandie Z fois }
Procedure DrawIconZ(Id,X,Y,Z: Integer);
Var I,J,K,C,W,H: Integer; P: PByteArr;
Begin
 If (Id<0) Or (Id>=NICONS+NBIG) Then Exit;
 W:=IconWd[Id];H:=IconHt[Id];
 If Not Vis(X,Y,X+W*Z-1,Y+H*Z-1) Then Exit;
 P:=IconPx[Id];
 For J:=0 To H-1 Do Begin
  I:=0;
  While I<W Do Begin
   C:=P^[J*W+I];
   If C=255 Then Inc(I)
   Else Begin
    K:=I;
    While (K+1<W) And (P^[J*W+K+1]=C) Do Inc(K);
    GBar(X+I*Z,Y+J*Z,X+(K+1)*Z-1,Y+(J+1)*Z-1,C);
    I:=K+1;
   End;
  End;
 End;
End;

{ Fonds d'ecran : bitmaps 1 bit, 1 = encre, 0 = papier }
Procedure LoadBackgrounds;
Var Blob: PByteArr; L,I,N,P,Id,W,H,Len,RB,Tot,Q,B,K,V: Integer; S: String;
Begin
 GetMem(Blob,BACKBLOB_BYTES+16);
 N:=0;
 For L:=0 To High(BackHex) Do Begin
  S:=BackHex[L];
  I:=1;
  While I<Length(S) Do Begin
   Blob^[N]:=HexVal(S[I])*16+HexVal(S[I+1]);
   Inc(N);Inc(I,2);
  End;
 End;
 P:=0;
 For Id:=0 To NBACK-1 Do Begin
  W:=Blob^[P]+256*Blob^[P+1];H:=Blob^[P+2]+256*Blob^[P+3];
  Len:=Blob^[P+4]+256*Blob^[P+5];
  Q:=P+6;
  P:=P+6+Len;
  BackWd[Id]:=W;BackHt[Id]:=H;
  RB:=(W+7) Div 8;
  Tot:=RB*H;
  GetMem(BackBits[Id],Tot+300);
  N:=0;
  While (N<Tot) And (Q<P) Do Begin
   B:=Blob^[Q];Inc(Q);
   If B<128 Then Begin
    For K:=0 To B Do Begin BackBits[Id]^[N]:=Blob^[Q];Inc(Q);Inc(N);End;
   End Else If B>128 Then Begin
    V:=Blob^[Q];Inc(Q);
    For K:=1 To 257-B Do Begin BackBits[Id]^[N]:=V;Inc(N);End;
   End;
  End;
 End;
 FreeMem(Blob,BACKBLOB_BYTES+16);
 BackTile:=Nil;BackTileIdx:=-2;
End;

{ Pre-rend un motif de fond dans un tampon d'image (rapide a repeter) }
Procedure BuildBackTile(Idx,Ink,Paper: Integer);
Var X,Y,W,H,RB: Integer;
Begin
 If BackTile<>Nil Then Begin FreeMem(BackTile,BackTileSz);BackTile:=Nil;End;
 BackTileIdx:=Idx;BackTileInk:=Ink;BackTilePaper:=Paper;
 If (Idx<0) Or (Idx>=NBACK) Then Exit;
 W:=BackWd[Idx];H:=BackHt[Idx];
 RB:=(W+7) Div 8;
 ClipFull;
 For Y:=0 To H-1 Do
  For X:=0 To W-1 Do
   If (BackBits[Idx]^[Y*RB+X Shr 3] And (128 Shr (X And 7)))<>0 Then
    PutPixel(X,Y,Ink) Else PutPixel(X,Y,Paper);
 BackTileSz:=ImageSize(0,0,W-1,H-1);
 GetMem(BackTile,BackTileSz);
 GetImage(0,0,W-1,H-1,BackTile^);
 BackTileW:=W;BackTileH:=H;
End;

Procedure DrawBackground(X1,Y1,X2,Y2: Integer);
Var TX,TY: Integer;
Begin
 If (BackTile=Nil) Or (DeskBack<0) Then Begin
  GBar(X1,Y1,X2,Y2,DeskPaper);
  Exit;
 End;
 TY:=(Y1 Div BackTileH)*BackTileH;
 While TY<=Y2 Do Begin
  TX:=(X1 Div BackTileW)*BackTileW;
  While TX<=X2 Do Begin
   PutImage(TX-VX,TY-VY,BackTile^,NormalPut);
   Inc(TX,BackTileW);
  End;
  Inc(TY,BackTileH);
 End;
End;

{ Dessine directement un bitmap de fond (1 bit) a la position X,Y }
Procedure DrawBack1(Idx,X,Y,Ink,Paper: Integer);
Var W,H,RB,J,I,K: Integer;
 Function Bit(XX: Integer): Boolean;
 Begin
  Bit:=(BackBits[Idx]^[J*RB+XX Shr 3] And (128 Shr (XX And 7)))<>0;
 End;
Begin
 W:=BackWd[Idx];H:=BackHt[Idx];RB:=(W+7) Div 8;
 GBar(X,Y,X+W-1,Y+H-1,Paper);
 For J:=0 To H-1 Do Begin
  I:=0;
  While I<W Do Begin
   If Bit(I) Then Begin
    K:=I;
    While (K+1<W) And Bit(K+1) Do Inc(K);
    GHLine(X+I,X+K,Y+J,Ink);
    I:=K+1;
   End Else Inc(I);
  End;
 End;
End;

Procedure SetDesktopBack(Idx,Ink,Paper: Integer);
Begin
 DeskBack:=Idx;DeskInk:=Ink;DeskPaper:=Paper;
 If Idx>=0 Then BuildBackTile(Idx,Ink,Paper) Else BackTileIdx:=-1;
End;

