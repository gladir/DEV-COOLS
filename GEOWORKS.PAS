 { commandes communes }
 CM_CLOSE    = 900;  CM_QUIT     = 901;  CM_ABOUT    = 902;  CM_HELP     = 903;
 CM_MINIMIZE = 904;  CM_MAXIMIZE = 905;  CM_RESTORE  = 906;  CM_TILE     = 907;
 CM_OVERLAP  = 908;  CM_NEXTWIN  = 909;  CM_MOVE     = 910;  CM_SIZE     = 911;
 CM_NEWMGR   = 912;  CM_EXITWEL  = 913;

Type
 PWindow = ^TWindow;
 TWindow = Object
  Id        : Integer;
  Kind      : Integer;
  WinX,WinY,WinW,WinH : Integer;
  SX,SY,SW,SH : Integer;
  MinW,MinH : Integer;
  Title     : String[70];
  IconId    : Integer;
  Maxim     : Boolean;
  Iconic    : Boolean;
  Resizable : Boolean;
  Dirty     : Boolean;
  Dead      : Boolean;
  NMenu     : Integer;
  Menus     : Array[1..MAXMENU] Of TMenuDef;
  Constructor Init(AKind,AX,AY,AW,AH: Integer; Const ATitle: String);
  Destructor Done; Virtual;
  Procedure AddMenu(Const T: String);
  Procedure AddItem(Const T: String; Cmd: Integer; Const K: String);
  Procedure AddSep;
  Procedure SetFlag(Cmd: Integer; Flag: Byte; On: Boolean);
  Procedure ClientRect(Var X1,Y1,X2,Y2: Integer);
  Procedure DrawClient; Virtual;
  Procedure OnMouse(Var E: TEvent); Virtual;
  Procedure OnKey(K: Word); Virtual;
  Procedure OnCommand(Cmd: Integer); Virtual;
  Procedure PrepareMenus; Virtual;
  Function  Idle: Boolean; Virtual;
  Procedure OnResize; Virtual;
  Function  CanClose: Boolean; Virtual;
 End;

Var
 Wins    : Array[1..MAXWIN] Of PWindow;
 NWins   : Integer;
 NextId  : Integer;
 Capture : PWindow;
 NeedFull: Boolean;
 SysDef  : TMenuDef;

Constructor TWindow.Init(AKind,AX,AY,AW,AH: Integer; Const ATitle: String);
Begin
 Id:=NextId;Inc(NextId);
 Kind:=AKind;WinX:=AX;WinY:=AY;WinW:=AW;WinH:=AH;
 SX:=AX;SY:=AY;SW:=AW;SH:=AH;
 MinW:=160;MinH:=100;
 Title:=ATitle;IconId:=IC_UNKNOWN;
 Maxim:=False;Iconic:=False;Resizable:=True;Dirty:=True;Dead:=False;
 NMenu:=0;
End;

Destructor TWindow.Done;
Begin
End;

Procedure TWindow.AddMenu(Const T: String);
Begin
 If NMenu<MAXMENU Then Begin
  Inc(NMenu);
  Menus[NMenu].Title:=T;
  Menus[NMenu].N:=0;
 End;
End;

Procedure TWindow.AddItem(Const T: String; Cmd: Integer; Const K: String);
Var N: Integer;
Begin
 If (NMenu>0) And (Menus[NMenu].N<MAXITEM) Then Begin
  Inc(Menus[NMenu].N);
  N:=Menus[NMenu].N;
  Menus[NMenu].It[N].Txt:=T;
  Menus[NMenu].It[N].Cmd:=Cmd;
  Menus[NMenu].It[N].Flag:=0;
  Menus[NMenu].It[N].Key:=K;
 End;
End;

Procedure TWindow.AddSep;
Begin
 AddItem('-',0,'');
End;

Procedure TWindow.SetFlag(Cmd: Integer; Flag: Byte; On: Boolean);
Var M,I: Integer;
Begin
 For M:=1 To NMenu Do
  For I:=1 To Menus[M].N Do
   If Menus[M].It[I].Cmd=Cmd Then Begin
    If On Then Menus[M].It[I].Flag:=Menus[M].It[I].Flag Or Flag
    Else Menus[M].It[I].Flag:=Menus[M].It[I].Flag And (Not Flag);
   End;
End;

{ Rectangle de la zone client (sous la barre de menus) }
Procedure TWindow.ClientRect(Var X1,Y1,X2,Y2: Integer);
Begin
 X1:=WinX+BORDER;
 Y1:=WinY+BORDER+TITLE_H+1;
 If NMenu>0 Then Inc(Y1,MENU_H);
 X2:=WinX+WinW-BORDER-1;
 Y2:=WinY+WinH-BORDER-1;
End;

Procedure TWindow.DrawClient;
Var X1,Y1,X2,Y2: Integer;
Begin
 ClientRect(X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
End;

Procedure TWindow.OnMouse(Var E: TEvent);
Begin
End;

Procedure TWindow.OnKey(K: Word);
Begin
End;

Procedure TWindow.PrepareMenus;
Begin
End;

Function TWindow.Idle: Boolean;
Begin
 Idle:=False;
End;

Procedure TWindow.OnResize;
Begin
End;

Function TWindow.CanClose: Boolean;
Begin
 CanClose:=True;
End;

{ Les commandes communes sont traitees par CommonCmd (defini plus bas) }
Procedure CommonCmd(W: PWindow; Cmd: Integer); Forward;

Procedure TWindow.OnCommand(Cmd: Integer);
Begin
 CommonCmd(@Self,Cmd);
End;

Procedure Invalidate(W: PWindow);
Begin
 If W<>Nil Then W^.Dirty:=True;
End;

Function TopWin: PWindow;
Var I: Integer;
Begin
 TopWin:=Nil;
 For I:=NWins DownTo 1 Do
  If Not Wins[I]^.Iconic Then Begin TopWin:=Wins[I];Exit;End;
End;

Function WinIndex(W: PWindow): Integer;
Var I: Integer;
Begin
 WinIndex:=0;
 For I:=1 To NWins Do If Wins[I]=W Then WinIndex:=I;
End;

Procedure BringToFront(W: PWindow);
Var I,K: Integer;
Begin
 K:=WinIndex(W);
 If (K=0) Or (K=NWins) Then Exit;
 For I:=K To NWins-1 Do Wins[I]:=Wins[I+1];
 Wins[NWins]:=W;
 NeedFull:=True;
End;

Procedure AddWindow(W: PWindow);
Begin
 If NWins<MAXWIN Then Begin
  Inc(NWins);
  Wins[NWins]:=W;
  NeedFull:=True;
 End Else Begin
  Dispose(W,Done);
 End;
End;

Procedure RemoveWindow(W: PWindow);
Var I,K: Integer;
Begin
 K:=WinIndex(W);
 If K=0 Then Exit;
 If Capture=W Then Capture:=Nil;
 For I:=K To NWins-1 Do Wins[I]:=Wins[I+1];
 Dec(NWins);
 Dispose(W,Done);
 NeedFull:=True;
End;

{ ---------------------------------------------------------------------- }
{ Dessin du cadre d'une fenetre                                            }
{ ---------------------------------------------------------------------- }

Function MenuTitleX(W: PWindow; M: Integer): Integer;
Var I,X: Integer;
Begin
 X:=W^.WinX+BORDER+6;
 For I:=1 To M-1 Do X:=X+TextW(TL(W^.Menus[I].Title))+16;
 MenuTitleX:=X;
End;

Function MenuTitleW(W: PWindow; M: Integer): Integer;
Begin
 MenuTitleW:=TextW(TL(W^.Menus[M].Title))+16;
End;

Procedure DrawMenuBar(W: PWindow);
Var M,X,Y: Integer;
Begin
 If W^.NMenu=0 Then Exit;
 Y:=W^.WinY+BORDER+TITLE_H;
 GBar(W^.WinX+BORDER,Y,W^.WinX+W^.WinW-BORDER-1,Y+MENU_H-1,cLGr);
 GHLine(W^.WinX+BORDER,W^.WinX+W^.WinW-BORDER-1,Y+MENU_H-1,cDGr);
 For M:=1 To W^.NMenu Do Begin
  X:=MenuTitleX(W,M);
  GText(X+8,Y+5,TL(W^.Menus[M].Title),cBlk);
 End;
End;

Procedure DrawSysGlyph(X1,Y1,X2,Y2: Integer);
Var CX,CY: Integer;
Begin
 CX:=(X1+X2) Div 2;CY:=(Y1+Y2) Div 2;
 GBar(CX-6,CY-3,CX+5,CY-1,cBlk);
 GBar(CX-6,CY+1,CX+5,CY+2,cBlk);
 GBar(CX-6,CY-3,CX+5,CY-3,cWht);
End;

Procedure DrawWinFrame(W: PWindow; Active: Boolean);
Var TX1,TY1,TX2,TY2,B1,B2: Integer; TC,FC: Integer;
Begin
 { cadre }
 GBar(W^.WinX,W^.WinY,W^.WinX+W^.WinW-1,W^.WinY+W^.WinH-1,cLGr);
 Bevel1(W^.WinX,W^.WinY,W^.WinX+W^.WinW-1,W^.WinY+W^.WinH-1,cWht,cBlk);
 Bevel1(W^.WinX+1,W^.WinY+1,W^.WinX+W^.WinW-2,W^.WinY+W^.WinH-2,cLGr,cDGr);
 If W^.Resizable And Not W^.Maxim Then Begin
  { encoches de redimensionnement dans les coins }
  GHLine(W^.WinX+1,W^.WinX+BORDER+14,W^.WinY+BORDER-1,cDGr);
  GHLine(W^.WinX+W^.WinW-BORDER-15,W^.WinX+W^.WinW-2,W^.WinY+BORDER-1,cDGr);
  GHLine(W^.WinX+1,W^.WinX+BORDER+14,W^.WinY+W^.WinH-BORDER,cWht);
  GHLine(W^.WinX+W^.WinW-BORDER-15,W^.WinX+W^.WinW-2,W^.WinY+W^.WinH-BORDER,cWht);
 End;
 { zone interne }
 Bevel1(W^.WinX+BORDER-1,W^.WinY+BORDER-1,W^.WinX+W^.WinW-BORDER,W^.WinY+W^.WinH-BORDER,cDGr,cWht);
 { barre de titre }
 TX1:=W^.WinX+BORDER;TY1:=W^.WinY+BORDER;
 TX2:=W^.WinX+W^.WinW-BORDER-1;TY2:=TY1+TITLE_H-1;
 If Active Then Begin TC:=cWht;FC:=cDGr;End Else Begin TC:=cBlk;FC:=cLGr;End;
 GBar(TX1,TY1,TX2,TY2,FC);
 If Not Active Then GHLine(TX1,TX2,TY2,cDGr);
 { boutons }
 Btn3D(TX1,TY1,TX1+TITLE_H+1,TY2,False);
 DrawSysGlyph(TX1,TY1,TX1+TITLE_H+1,TY2);
 B2:=TX2;
 If W^.Resizable Then Begin
  Btn3D(B2-TITLE_H-1,TY1,B2,TY2,False);
  GRect(B2-TITLE_H+4,TY1+4,B2-5,TY2-4,cBlk);
  GHLine(B2-TITLE_H+4,B2-5,TY1+5,cBlk);
  B2:=B2-TITLE_H-3;
 End;
 Btn3D(B2-TITLE_H-1,TY1,B2,TY2,False);
 GBar(B2-TITLE_H Div 2-2,TY2-7,B2-TITLE_H Div 2+2,TY2-4,cBlk);
 { titre }
 B1:=TX1+TITLE_H+4;
 GTextB((B1+B2-TITLE_H-2-TextW(W^.Title)) Div 2,TY1+5,W^.Title,TC);
 DrawMenuBar(W);
End;

{ ---------------------------------------------------------------------- }
{ Icones des fenetres reduites                                            }
{ ---------------------------------------------------------------------- }

Function IconicIndex(W: PWindow): Integer;
Var I,K: Integer;
Begin
 K:=0;
 For I:=1 To NWins Do Begin
  If Wins[I]^.Iconic Then Inc(K);
  If Wins[I]=W Then Begin IconicIndex:=K-1;Exit;End;
 End;
 IconicIndex:=0;
End;

Procedure IconicPos(K: Integer; Var X,Y: Integer);
Begin
 X:=8+K*84;
 Y:=SCR_H-58;
 If X>SCR_W-80 Then Begin X:=8+(K Mod 7)*84;Y:=SCR_H-58-(K Div 7)*58;End;
End;

Procedure DrawIconicWin(W: PWindow);
Var X,Y: Integer; S: String;
Begin
 IconicPos(IconicIndex(W),X,Y);
 DrawIcon(W^.IconId,X+16,Y,False);
 S:=Copy(W^.Title,1,10);
 GBar(X,Y+33,X+TextW(S)+3,Y+43,cBlk);
 GText(X+2,Y+35,S,cWht);
End;

{ ---------------------------------------------------------------------- }
{ Peinture de la scene                                                    }
{ ---------------------------------------------------------------------- }

Procedure PaintRect(X1,Y1,X2,Y2: Integer);
Var I: Integer; W: PWindow; CX1_,CY1_,CX2_,CY2_,A1,B1,A2,B2: Integer;
    Act: PWindow;
Begin
 SetClip(X1,Y1,X2,Y2);
 DrawBackground(X1,Y1,X2,Y2);
 For I:=1 To NWins Do
  If Wins[I]^.Iconic Then DrawIconicWin(Wins[I]);
 Act:=TopWin;
 For I:=1 To NWins Do Begin
  W:=Wins[I];
  If Not W^.Iconic Then
   If (W^.WinX<=X2) And (W^.WinX+W^.WinW-1>=X1) And (W^.WinY<=Y2) And (W^.WinY+W^.WinH-1>=Y1) Then Begin
    SetClip(X1,Y1,X2,Y2);
    DrawWinFrame(W,W=Act);
    W^.ClientRect(A1,B1,A2,B2);
    If A1<X1 Then A1:=X1;
    If B1<Y1 Then B1:=Y1;
    If A2>X2 Then A2:=X2;
    If B2>Y2 Then B2:=Y2;
    If (A2>=A1) And (B2>=B1) Then Begin
     SetClip(A1,B1,A2,B2);
     W^.DrawClient;
    End;
   End;
 End;
 ClipFull;
End;

Procedure PaintAll;
Begin
 HideMouse;
 PaintRect(0,0,SCR_W-1,SCR_H-1);
 ShowMouse;
End;

Procedure PaintWinClient(W: PWindow);
Var X1,Y1,X2,Y2: Integer;
Begin
 If W^.Iconic Then Exit;
 W^.ClientRect(X1,Y1,X2,Y2);
 HideMouse;
 PaintRect(X1,Y1,X2,Y2);
 ShowMouse;
End;

Procedure FlushPaint;
Var I: Integer;
Begin
 If NeedFull Then Begin
  NeedFull:=False;
  For I:=1 To NWins Do Wins[I]^.Dirty:=False;
  PaintAll;
 End Else Begin
  For I:=1 To NWins Do
   If Wins[I]^.Dirty Then Begin
    Wins[I]^.Dirty:=False;
    PaintWinClient(Wins[I]);
   End;
 End;
End;

{ ====================================================================== }
{                        MENUS DEROULANTS                                }
{ ====================================================================== }

Function ItemH(Const It: TMenuItem): Integer;
Begin
 If It.Txt='-' Then ItemH:=7 Else ItemH:=16;
End;

Procedure DropGeom(Const MD: TMenuDef; AX,AY: Integer; Var X1,Y1,X2,Y2: Integer);
Var I,L,K,WL,WK,H: Integer;
Begin
 WL:=0;WK:=0;H:=4;
 For I:=1 To MD.N Do Begin
  L:=TextW(TL(MD.It[I].Txt));
  If L>WL Then WL:=L;
  K:=TextW(MD.It[I].Key);
  If K>WK Then WK:=K;
  H:=H+ItemH(MD.It[I]);
 End;
 X1:=AX;Y1:=AY;
 X2:=X1+24+WL+10;
 If WK>0 Then X2:=X2+WK+16;
 Y2:=Y1+H-1;
 If X2>SCR_W-5 Then Begin X1:=X1-(X2-(SCR_W-5));X2:=SCR_W-5;End;
 If Y2>SCR_H-5 Then Begin Y1:=Y1-(Y2-(SCR_H-5));Y2:=SCR_H-5;End;
End;

Function DropItemY(Const MD: TMenuDef; Y1,I: Integer): Integer;
Var K,Y: Integer;
Begin
 Y:=Y1+2;
 For K:=1 To I-1 Do Y:=Y+ItemH(MD.It[K]);
 DropItemY:=Y;
End;

Function DropHit(Const MD: TMenuDef; X1,Y1,X2,Y2: Integer; PX,PY: LongInt): Integer;
Var I,Y: Integer;
Begin
 DropHit:=0;
 If Not InBox(PX,PY,X1,Y1,X2,Y2) Then Exit;
 For I:=1 To MD.N Do Begin
  Y:=DropItemY(MD,Y1,I);
  If (PY>=Y) And (PY<Y+ItemH(MD.It[I])) Then DropHit:=I;
 End;
End;

Procedure DrawDrop(Const MD: TMenuDef; X1,Y1,X2,Y2,Hi: Integer);
Var I,Y: Integer; S: String; En,Sel: Boolean;
Begin
 ClipFull;
 GBar(X1,Y1,X2,Y2,cLGr);
 GRect(X1,Y1,X2,Y2,cBlk);
 Bevel1(X1+1,Y1+1,X2-1,Y2-1,cWht,cDGr);
 For I:=1 To MD.N Do Begin
  Y:=DropItemY(MD,Y1,I);
  S:=TL(MD.It[I].Txt);
  If MD.It[I].Txt='-' Then Begin
   GHLine(X1+4,X2-4,Y+2,cDGr);
   GHLine(X1+4,X2-4,Y+3,cWht);
  End Else Begin
   En:=(MD.It[I].Flag And 1)=0;
   Sel:=(I=Hi) And En;
   If Sel Then GBar(X1+3,Y,X2-3,Y+15,cBlk);
   If (MD.It[I].Flag And 2)<>0 Then Begin
    If Sel Then GText(X1+6,Y+4,#251,cWht) Else GText(X1+6,Y+4,#251,cBlk);
   End;
   If Not En Then GTextGrey(X1+20,Y+4,S)
   Else If Sel Then GText(X1+20,Y+4,S,cWht)
   Else GText(X1+20,Y+4,S,cBlk);
   If MD.It[I].Key<>'' Then Begin
    If Not En Then GTextGrey(X2-8-TextW(MD.It[I].Key),Y+4,MD.It[I].Key)
    Else If Sel Then GText(X2-8-TextW(MD.It[I].Key),Y+4,MD.It[I].Key,cWht)
    Else GText(X2-8-TextW(MD.It[I].Key),Y+4,MD.It[I].Key,cBlk);
   End;
  End;
 End;
End;

Function NextItem(Const MD: TMenuDef; From,Dir: Integer): Integer;
Var I,N,K: Integer;
Begin
 N:=MD.N;I:=From;
 For K:=1 To N Do Begin
  I:=I+Dir;
  If I<1 Then I:=N;
  If I>N Then I:=1;
  If (MD.It[I].Txt<>'-') And ((MD.It[I].Flag And 1)=0) Then Begin NextItem:=I;Exit;End;
 End;
 NextItem:=From;
End;

Procedure BuildSysMenu(W: PWindow);
Begin
 SysDef.N:=0;
 SysDef.Title:='';
 If W^.Resizable Then Begin
  Inc(SysDef.N);
  SysDef.It[SysDef.N].Txt:='Restore~Restaurer~Wiederherst.';SysDef.It[SysDef.N].Cmd:=CM_RESTORE;
  SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
  If Not W^.Maxim Then SysDef.It[SysDef.N].Flag:=1;
 End;
 Inc(SysDef.N);
 SysDef.It[SysDef.N].Txt:='Move~D'#130'placer~Verschieben';SysDef.It[SysDef.N].Cmd:=CM_MOVE;
 SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
 If W^.Resizable Then Begin
  Inc(SysDef.N);
  SysDef.It[SysDef.N].Txt:='Size~Taille~Gr'#148#225'e';SysDef.It[SysDef.N].Cmd:=CM_SIZE;
  SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
  If W^.Maxim Then SysDef.It[SysDef.N].Flag:=1;
 End;
 Inc(SysDef.N);
 SysDef.It[SysDef.N].Txt:='Minimize~R'#130'duire~Minimieren';SysDef.It[SysDef.N].Cmd:=CM_MINIMIZE;
 SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
 If W^.Resizable Then Begin
  Inc(SysDef.N);
  SysDef.It[SysDef.N].Txt:='Maximize~Agrandir~Maximieren';SysDef.It[SysDef.N].Cmd:=CM_MAXIMIZE;
  SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
  If W^.Maxim Then SysDef.It[SysDef.N].Flag:=1;
 End;
 Inc(SysDef.N);
 SysDef.It[SysDef.N].Txt:='-';SysDef.It[SysDef.N].Cmd:=0;
 SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='';
 Inc(SysDef.N);
 SysDef.It[SysDef.N].Txt:='Close~Fermer~Schlie'#225'en';SysDef.It[SysDef.N].Cmd:=CM_CLOSE;
 SysDef.It[SysDef.N].Flag:=0;SysDef.It[SysDef.N].Key:='Alt+F4';
End;

{ Boucle de menu : Sys = menu systeme (bouton de gauche de la barre de titre) }
Function RunMenus(W: PWindow; StartM: Integer; Sys: Boolean): Integer;
Var M,Hi,H,T,DX1,DY1,DX2,DY2,I: Integer; E: TEvent; Done,Pick,Entered: Boolean;
    Sv: TSave; Res: Integer; BarY,TX: Integer; Moved: Boolean; PX,PY: LongInt;

 Procedure Place;
 Begin
  If Sys Then Begin
   DX1:=W^.WinX+BORDER;DY1:=W^.WinY+BORDER+TITLE_H;
   DropGeom(SysDef,DX1,DY1,DX1,DY1,DX2,DY2);
  End Else Begin
   TX:=MenuTitleX(W,M);
   DropGeom(W^.Menus[M],TX,BarY+MENU_H,DX1,DY1,DX2,DY2);
  End;
 End;

 Procedure Show(NewHi: Integer);
 Begin
  HideMouse;
  If Sv.P<>Nil Then RestoreBack(Sv);
  Hi:=NewHi;
  Place;
  If Sys Then SaveBack(Sv,DX1,DY1,DX2+4,DY2+4)
  Else SaveBack(Sv,Min2(DX1,TX)-2,BarY,DX2+4,DY2+4);
  ClipFull;
  If Not Sys Then Begin
   GBar(TX,BarY,TX+MenuTitleW(W,M)-1,BarY+MENU_H-2,cLGr);
   Bevel1(TX,BarY,TX+MenuTitleW(W,M)-1,BarY+MENU_H-2,cDGr,cWht);
   GText(TX+8,BarY+5,TL(W^.Menus[M].Title),cBlk);
  End;
  GBar(DX1+4,DY2+1,DX2+4,DY2+4,cBlk);
  GBar(DX2+1,DY1+4,DX2+4,DY2+4,cBlk);
  If Sys Then DrawDrop(SysDef,DX1,DY1,DX2,DY2,Hi)
  Else DrawDrop(W^.Menus[M],DX1,DY1,DX2,DY2,Hi);
  ShowMouse;
 End;

Begin
 Res:=0;
 Sv.P:=Nil;
 BarY:=W^.WinY+BORDER+TITLE_H;
 If Sys Then BuildSysMenu(W) Else W^.PrepareMenus;
 M:=StartM;
 If Sys Then M:=1;
 Hi:=0;
 Show(0);
 Done:=False;Pick:=False;Entered:=False;Moved:=False;
 Repeat
  PollEvent(E);
  Case E.Kind Of
   EV_MOVE,EV_DOWN,EV_UP: Begin
     PX:=E.X;PY:=E.Y;
     T:=0;
     If Not Sys Then
      For I:=1 To W^.NMenu Do
       If InBox(PX,PY,MenuTitleX(W,I),BarY,MenuTitleX(W,I)+MenuTitleW(W,I)-1,BarY+MENU_H-1) Then T:=I;
     If Sys Then H:=DropHit(SysDef,DX1,DY1,DX2,DY2,PX,PY)
     Else H:=DropHit(W^.Menus[M],DX1,DY1,DX2,DY2,PX,PY);
     If H<>0 Then Begin
      If Sys Then Begin
       If (SysDef.It[H].Txt='-') Or ((SysDef.It[H].Flag And 1)<>0) Then H:=0;
      End Else Begin
       If (W^.Menus[M].It[H].Txt='-') Or ((W^.Menus[M].It[H].Flag And 1)<>0) Then H:=0;
      End;
     End;
     If (E.Kind=EV_MOVE) Or (E.Kind=EV_DOWN) Then Begin
      If (T>0) And (T<>M) Then Begin M:=T;Show(0);Entered:=False;End
      Else If H<>Hi Then Show(H);
      If H<>0 Then Entered:=True;
     End;
     If E.Kind=EV_DOWN Then Begin
      If H<>0 Then Begin Pick:=True;Done:=True;End
      Else If (T=0) Or (T=M) Then Done:=True;
     End;
     If E.Kind=EV_UP Then Begin
      If (H<>0) And Entered Then Begin Hi:=H;Pick:=True;Done:=True;End;
     End;
    End;
   EV_KEY: If Not Sys Then Begin
     Case E.Key Of
      K_ESC: Done:=True;
      K_LEFT: Begin Dec(M);If M<1 Then M:=W^.NMenu;Show(NextItem(W^.Menus[M],0,1));End;
      K_RIGHT: Begin Inc(M);If M>W^.NMenu Then M:=1;Show(NextItem(W^.Menus[M],0,1));End;
      K_UP: Show(NextItem(W^.Menus[M],Hi,-1));
      K_DOWN: Show(NextItem(W^.Menus[M],Hi,1));
      K_ENTER: If Hi<>0 Then Begin Pick:=True;Done:=True;End;
     End;
    End Else Begin
     Case E.Key Of
      K_ESC: Done:=True;
      K_UP: Show(NextItem(SysDef,Hi,-1));
      K_DOWN: Show(NextItem(SysDef,Hi,1));
      K_ENTER: If Hi<>0 Then Begin Pick:=True;Done:=True;End;
     End;
    End;
  End;
 Until Done;
 HideMouse;
 RestoreBack(Sv);
 ShowMouse;
 If Pick And (Hi>0) Then Begin
  If Sys Then Res:=SysDef.It[Hi].Cmd Else Res:=W^.Menus[M].It[Hi].Cmd;
 End;
 RunMenus:=Res;
End;

