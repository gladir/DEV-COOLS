Const
 CWD = 56;
 CHT = 74;
 GAPX = 68;
 TOPY = 8;
 TABY = 104;
 FDY = 17;
 BDY = 6;

Type
 TSolDeck = Array[1..52] Of Byte;
 TSolFnd  = Array[1..4,1..13] Of Byte;
 TSolFN   = Array[1..4] Of Integer;
 TSolTab  = Array[1..7,1..30] Of Byte;
 TSolTN   = Array[1..7] Of Integer;

 TSolSnap = Record
  Stock : TSolDeck;  SN : Integer;
  Waste : TSolDeck;  WN : Integer;
  Fnd   : TSolFnd; FN : TSolFN;
  Tab   : TSolTab; TN,TD : TSolTN;
  Score,Passes : Integer;
 End;

 PSolit = ^TSolit;
 TSolit = Record
  Stock : TSolDeck;  SN : Integer;
  Waste : TSolDeck;  WN : Integer;
  Fnd   : TSolFnd; FN : TSolFN;
  Tab   : TSolTab; TN,TD : TSolTN;
  Score : Integer;
  StartCs : LongInt;
  Secs  : LongInt;
  Started,Won,Draw3 : Boolean;
  Dragging : Boolean;
  DSrc,DCount : Integer;
  DCards : Array[1..13] Of Byte;
  GrabX,GrabY : Integer;
  RX,RY : Integer;
  RShown : Boolean;
  Scoring,Level,Passes,VegasTotal : Integer;
  { bareme 0 standard 1 Vegas 2 aucun ; niveau 0..2 }
  Timed : Boolean;
  UN    : Integer;
  UStack: Array[1..20] Of TSolSnap;
 End;

