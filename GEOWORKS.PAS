Procedure GbRefresh;
Begin
 If GbAlive(GbProj^.FormW) Then Begin
     GbProj^.FormW^.Title:=GbProj^.Form^.O[1].Title;Invalidate(GbProj^.FormW);
 End;
 If GbAlive(GbProj^.PropW) Then Invalidate(GbProj^.PropW);
 If GbAlive(GbProj^.Ide) Then Invalidate(GbProj^.Ide);
End;

Procedure GbAddObject(Kind: Integer);
Var F: PForm; Par,I: Integer;
Begin
 F:=GbProj^.Form;
 Par:=F^.Sel;
 If (Par<1) Or (Par>F^.N) Then Par:=1;
 If Not FmIsContainer(F^.O[Par].Kind) Then Par:=F^.O[Par].Parent;
 If Par<1 Then Par:=1;
 { un GenItem va dans un groupe d'items, un GenBoolean dans un groupe de
   booleens }
 If (Kind=FK_ITEM) And (F^.O[Par].Kind<>FK_IGROUP) Then Begin
  GbProj^.Msg:=T3('A GenItem belongs in a GenItemGroup',
      'Un GenItem va dans un GenItemGroup',
      'Ein GenItem geh'#148'rt in eine GenItemGroup');
  Exit;
 End;
 If (Kind=FK_BOOL) And (F^.O[Par].Kind<>FK_BGROUP) Then Begin
  GbProj^.Msg:=T3('A GenBoolean belongs in a GenBooleanGroup',
      'Un GenBoolean va dans un GenBooleanGroup',
      'Ein GenBoolean geh'#148'rt in eine GenBooleanGroup');
  Exit;
 End;
 I:=FmAdd(F,Kind,Par);
 If I>0 Then Begin F^.Sel:=I;GbProj^.Msg:=T3('Added ','Ajout de ',
     'Hinzugef'#129'gt: ')+F^.O[I].Name;End
 Else GbProj^.Msg:=T3('Too many objects','Trop d''objets','Zu viele Objekte');
 GbRefresh;
End;

Procedure GbDeleteSel;
Var F: PForm;
Begin
 F:=GbProj^.Form;
 If (F^.Sel<=1) Or (F^.Sel>F^.N) Then Begin
     GbProj^.Msg:=T3('The primary cannot be deleted',
     'Le primaire ne peut pas '#136'tre supprim'#130,
     'Das Primary kann nicht gel'#148'scht werden');Exit;End;
 FmDelete(F,F^.Sel);
 GbRefresh;
End;

