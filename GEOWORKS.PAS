Procedure Bevel1(X1,Y1,X2,Y2,TLc,BRc: Integer);
Begin
 GHLine(X1,X2-1,Y1,TLc);
 GVLine(X1,Y1,Y2-1,TLc);
 GHLine(X1,X2,Y2,BRc);
 GVLine(X2,Y1,Y2,BRc);
End;

{ Bouton en relief : 2 pixels ; enfonce si Down }
Procedure Btn3D(X1,Y1,X2,Y2: Integer; Down: Boolean);
Begin
 GBar(X1,Y1,X2,Y2,cLGr);
 If Down Then Begin
  Bevel1(X1,Y1,X2,Y2,cBlk,cWht);
  Bevel1(X1+1,Y1+1,X2-1,Y2-1,cDGr,cLGr);
 End Else Begin
  Bevel1(X1,Y1,X2,Y2,cWht,cBlk);
  Bevel1(X1+1,Y1+1,X2-1,Y2-1,cLGr,cDGr);
 End;
End;

{ Champ creux (zone de saisie / liste) }
Procedure Sunken(X1,Y1,X2,Y2,Fill: Integer);
Begin
 If Fill>=0 Then GBar(X1,Y1,X2,Y2,Fill);
 Bevel1(X1,Y1,X2,Y2,cDGr,cWht);
 Bevel1(X1+1,Y1+1,X2-1,Y2-1,cBlk,cLGr);
End;

Procedure Raised1(X1,Y1,X2,Y2: Integer);
Begin
 GBar(X1,Y1,X2,Y2,cLGr);
 Bevel1(X1,Y1,X2,Y2,cWht,cDGr);
End;

Procedure Sunken1(X1,Y1,X2,Y2: Integer);
Begin
 Bevel1(X1,Y1,X2,Y2,cDGr,cWht);
End;

{ Bouton avec libelle }
Procedure Button(X1,Y1,X2,Y2: Integer; Const S: String; Def,Down,Enabled: Boolean);
Var TX,TY: Integer;
Begin
 If Def Then Begin
  GRect(X1-2,Y1-2,X2+2,Y2+2,cBlk);
 End;
 Btn3D(X1,Y1,X2,Y2,Down);
 TX:=(X1+X2+1-TextW(S)) Div 2;
 TY:=(Y1+Y2-6) Div 2;
 If Down Then Begin Inc(TX);Inc(TY);End;
 If Enabled Then GText(TX,TY,S,cBlk) Else GTextGrey(TX,TY,S);
End;

Function InBox(X,Y,X1,Y1,X2,Y2: LongInt): Boolean;
Begin
 InBox:=(X>=X1) And (X<=X2) And (Y>=Y1) And (Y<=Y2);
End;

{ Fleche triangulaire : Dir 1 haut, 2 bas, 3 gauche, 4 droite }
Procedure GArrow(CX,CY,Dir,C: Integer);
Var I: Integer;
Begin
 Case Dir Of
  1: For I:=0 To 3 Do GHLine(CX-I,CX+I,CY-3+I,C);
  2: For I:=0 To 3 Do GHLine(CX-I,CX+I,CY+3-I,C);
  3: For I:=0 To 3 Do GVLine(CX-3+I,CY-I,CY+I,C);
  4: For I:=0 To 3 Do GVLine(CX+3-I,CY-I,CY+I,C);
 End;
End;

