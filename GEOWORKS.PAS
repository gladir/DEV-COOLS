 WinAddSep(Wd_);
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Dial~Appeler~W'#132'hlen');
 WinAddItem(Wd_,'Dial...~Composer...~W'#132'hlen...',CM_DIAL,'');
