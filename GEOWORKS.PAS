Function MgrIsVirtual(Wd_: PWindow): Boolean;
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 MgrIsVirtual:=(Length(Dt_^.Path)>=2) And (Dt_^.Path[1]='V')
     And (Dt_^.Path[2]=':');
End;

Procedure MgrAddEnt(Wd_: PWindow; Const N,D: String; K: Byte; Ic,
    Ap: Integer; Sz: LongInt);
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NE>=MAXENT Then Exit;
 Dt_^.Ents^[Dt_^.NE].Name:=N;Dt_^.Ents^[Dt_^.NE].Disp:=D;
 Dt_^.Ents^[Dt_^.NE].Kind:=K;
 Dt_^.Ents^[Dt_^.NE].Icon:=Ic;Dt_^.Ents^[Dt_^.NE].App:=Ap;
 Dt_^.Ents^[Dt_^.NE].Size:=Sz;Dt_^.Ents^[Dt_^.NE].Sel:=False;
 Inc(Dt_^.NE);
End;

Procedure MgrSortEnts(Wd_: PWindow);
 Var Dt_: PManager;
Var I,J: Integer; T: TEnt; Swp: Boolean;
Begin
 Dt_:=Wd_^.Data;
 For I:=0 To Dt_^.NE-2 Do
  For J:=I+1 To Dt_^.NE-1 Do Begin
   Swp:=False;
   If (Dt_^.Ents^[J].Kind=0) And (Dt_^.Ents^[I].Kind<>0) Then Swp:=True
   Else If (Dt_^.Ents^[J].Kind=0)=(Dt_^.Ents^[I].Kind=0) Then Begin
    Case Dt_^.SortMode Of
     1: If (Dt_^.Ents^[J].Kind<Dt_^.Ents^[I].Kind)
         Or ((Dt_^.Ents^[J].Kind=Dt_^.Ents^[I].Kind) And
         (Upper(Dt_^.Ents^[J].Disp)<Upper(Dt_^.Ents^[I].Disp))) Then Swp:=True;
     2: If (Dt_^.Ents^[J].Size>Dt_^.Ents^[I].Size)
         Or ((Dt_^.Ents^[J].Size=Dt_^.Ents^[I].Size) And
         (Upper(Dt_^.Ents^[J].Disp)<Upper(Dt_^.Ents^[I].Disp))) Then Swp:=True;
    Else If Upper(Dt_^.Ents^[J].Disp)<Upper(Dt_^.Ents^[I].Disp) Then Swp:=True;
    End;
   End;
   If Swp Then Begin T:=Dt_^.Ents^[I];Dt_^.Ents^[I]:=Dt_^.Ents^[J];
   Dt_^.Ents^[J]:=T;End;
  End;
End;

Procedure MgrScan(Wd_: PWindow);
 Var Dt_: PManager;
Var SR: SearchRec; G: TGeosInfo; E,P,Disp: String; Ap,Ic: Integer; K: Byte;
I: Integer;
Begin
 Dt_:=Wd_^.Data;
 Dt_^.NE:=0;Dt_^.Top:=0;Dt_^.Cur:=-1;Dt_^.TotBytes:=0;
 If MgrIsVirtual(Wd_) Then Begin
  If Dt_^.Path='V:WORLD' Then Begin
   MgrAddEnt(Wd_,'EXTRAS','EXTRAS',0,IC_FOLDER,0,0);
   For I:=1 To 16 Do Begin
    Case I Of
     1: Ap:=A_AOL;      2: Ap:=A_CALC;    3: Ap:=A_BANNER;  4: Ap:=A_GEOCALC;
     5: Ap:=A_COMM;     6: Ap:=A_DEX;     7: Ap:=A_DRAW;    8: Ap:=A_GEOFILE;
     9: Ap:=A_MANAGER; 10: Ap:=A_PLANNER; 11: Ap:=A_WRITE;  12: Ap:=A_NOTEPAD;
    13: Ap:=A_PREFS;   14: Ap:=A_SCRAP;   15: Ap:=A_SOLIT;  16: Ap:=A_TETRIS;
    End;
    MgrAddEnt(Wd_,AppTitle(Ap),AppTitle(Ap),1,AppIcon(Ap),Ap,0);
   End;
  End Else If Dt_^.Path='V:WORLD\EXTRAS' Then Begin
   MgrAddEnt(Wd_,AppTitle(A_CLOCK),AppTitle(A_CLOCK),1,IC_PERF,A_CLOCK,0);
   MgrAddEnt(Wd_,AppTitle(A_TEXTED),AppTitle(A_TEXTED),1,IC_NOTE,A_TEXTED,0);
   MgrAddEnt(Wd_,AppTitle(A_PERF),AppTitle(A_PERF),1,IC_PERF,A_PERF,0);
   MgrAddEnt(Wd_,AppTitle(A_BOUNCE),AppTitle(A_BOUNCE),1,IC_UNKNOWN,A_BOUNCE,0);
   MgrAddEnt(Wd_,AppTitle(A_DUMP),AppTitle(A_DUMP),1,IC_COLORS,A_DUMP,0);
   MgrAddEnt(Wd_,AppTitle(A_INSTALL),AppTitle(A_INSTALL),1,IC_GEOS,A_INSTALL,0);
   MgrAddEnt(Wd_,AppTitle(A_WK1),AppTitle(A_WK1),1,IC_CALC,A_WK1,0);
   MgrAddEnt(Wd_,AppTitle(A_GRAPH),AppTitle(A_GRAPH),1,IC_GEOS,A_GRAPH,0);
   MgrAddEnt(Wd_,AppTitle(A_GEOBASIC),AppTitle(A_GEOBASIC),1,IC_NOTE,A_GEOBASIC,
       0);
  End;
  MgrSortEnts(Wd_);
  Exit;
 End;
 P:=Dt_^.Path;
 If (P<>'') And (P[Length(P)]<>'\') And (P[Length(P)]<>'/') Then P:=P+DirSep;
 FindFirst(P+'*',AnyFile,SR);
 While (DosError=0) And (Dt_^.NE<MAXENT) Do Begin
  If (SR.Name<>'.') And (SR.Name<>'..') And
     (((SR.Attr And (Hidden Or SysFile))=0) Or Dt_^.ShowHid) Then Begin
   If (SR.Attr And Directory)<>0 Then Begin
    MgrAddEnt(Wd_,SR.Name,SR.Name,0,IC_FOLDER,0,0);
   End Else Begin
    E:=ExtOf(SR.Name);K:=6;Ic:=IC_DOSDOC;Ap:=0;Disp:=SR.Name;
    If (E='GEO') And ReadGeosHeader(P+SR.Name,G) Then Begin
     Ap:=TokenToApp(G.Tok);
     If Ap<>0 Then Begin K:=1;Ic:=AppIcon(Ap);End Else Begin K:=2;Ic:=IC_GEOS;
     End;
     If G.LongName<>'' Then Disp:=G.LongName;
    End Else If IsNumExt(E) And ReadGeosHeader(P+SR.Name,G) Then Begin
     K:=3;Ic:=DocIcon(G.Creator);Ap:=TokenToApp(G.Creator);
     If G.LongName<>'' Then Disp:=G.LongName;
    End Else If (E='EXE') Or (E='COM') Or (E='BAT') Then Begin
     K:=4;Ic:=IC_DOSPROG;
    End Else If IsTextExt(E) Then Begin
     K:=5;Ic:=IC_NOTEDOC;
    End;
    MgrAddEnt(Wd_,SR.Name,Disp,K,Ic,Ap,SR.Size);
    Dt_^.TotBytes:=Dt_^.TotBytes+SR.Size;
   End;
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC}FindClose(SR);{$ENDIF}
 MgrSortEnts(Wd_);
End;

Procedure MgrGoPath(Wd_: PWindow; Const P: String);
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 If (Length(P)<2) Or (P[1]<>'V') Or (P[2]<>':') Then
  If Not DirExists(P) Then Begin
   Info(T3('Error','Erreur','Fehler'),T3('Directory not found|',
       'R'#130'pertoire introuvable|','Verzeichnis nicht gefunden|')+P);
   Exit;
  End;
 Dt_^.Path:=P;
 MgrScan(Wd_);
 Invalidate(Wd_);
End;

Procedure MgrGoUp(Wd_: PWindow);
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 If MgrIsVirtual(Wd_) Then Begin
  If Dt_^.Path='V:WORLD\EXTRAS' Then MgrGoPath(Wd_,'V:WORLD');
  Exit;
 End;
 MgrGoPath(Wd_,ParentDir(Dt_^.Path));
End;

{ Zone de la liste de fichiers }
Procedure MgrGeom(Wd_: PWindow; Var FX1,FY1,FX2,FY2: Integer);
 Var Dt_: PManager;
Var X1,Y1,X2,Y2: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 FX1:=X1;FY1:=Y1+26;FX2:=X2;FY2:=Y2-BAR_H;
End;

Function MgrRows(Wd_: PWindow): Integer;
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 Case Dt_^.ViewMode Of
  0: Begin
      If Dt_^.Cols<1 Then Dt_^.Cols:=1;
      MgrRows:=(Dt_^.NE+Dt_^.Cols-1) Div Dt_^.Cols;
     End;
 Else MgrRows:=Dt_^.NE;
 End;
End;

Procedure MgrItemRect(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PManager;
Var FX1,FY1,FX2,FY2,R,C: Integer;
Begin
 Dt_:=Wd_^.Data;
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 If Dt_^.ViewMode=0 Then Begin
  R:=I Div Dt_^.Cols;C:=I Mod Dt_^.Cols;
  X1:=FX1+4+C*CellW;Y1:=FY1+4+(R-Dt_^.Top)*CellH;
  X2:=X1+CellW-1;Y2:=Y1+CellH-1;
 End Else Begin
  X1:=FX1+2;Y1:=FY1+2+(I-Dt_^.Top)*14;X2:=FX2-SB-2;Y2:=Y1+13;
 End;
End;

Function MgrItemAt(Wd_: PWindow; PX,PY: LongInt): Integer;
 Var Dt_: PManager;
Var FX1,FY1,FX2,FY2,I,X1,Y1,X2,Y2: Integer;
Begin
 Dt_:=Wd_^.Data;
 MgrItemAt:=-1;
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 If Not InBox(PX,PY,FX1,FY1,FX2-SB,FY2) Then Exit;
 For I:=0 To Dt_^.NE-1 Do Begin
  MgrItemRect(Wd_,I,X1,Y1,X2,Y2);
  If (Y2>=FY1) And (Y1<=FY2) Then
   If InBox(PX,PY,X1,Y1,X2,Y2) Then Begin MgrItemAt:=I;Exit;End;
 End;
End;

Procedure MgrOnResize(Wd_: PWindow);
 Var Dt_: PManager;
Var FX1,FY1,FX2,FY2: Integer;
Begin
 Dt_:=Wd_^.Data;
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 Dt_^.Cols:=(FX2-FX1-SB-8) Div CellW;
 If Dt_^.Cols<1 Then Dt_^.Cols:=1;
 If Dt_^.Top>MgrRows(Wd_)-1 Then Dt_^.Top:=Max2(0,MgrRows(Wd_)-1);
End;

Procedure MgrEnsureVisible(Wd_: PWindow; I: Integer);
 Var Dt_: PManager;
Var FX1,FY1,FX2,FY2,R,VR: Integer;
Begin
 Dt_:=Wd_^.Data;
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 If Dt_^.ViewMode=0 Then Begin
  R:=I Div Dt_^.Cols;VR:=(FY2-FY1-4) Div CellH;
 End Else Begin R:=I;VR:=(FY2-FY1-4) Div 14;End;
 If VR<1 Then VR:=1;
 If R<Dt_^.Top Then Dt_^.Top:=R;
 If R>=Dt_^.Top+VR Then Dt_^.Top:=R-VR+1;
End;

Procedure MgrSelectOnly(Wd_: PWindow; I: Integer);
 Var Dt_: PManager;
Var K: Integer;
Begin
 Dt_:=Wd_^.Data;
 For K:=0 To Dt_^.NE-1 Do Dt_^.Ents^[K].Sel:=(K=I);
 Dt_^.Cur:=I;
End;

Function MgrFullPath(Wd_: PWindow; I: Integer): String;
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 If MgrIsVirtual(Wd_) Then MgrFullPath:=Dt_^.Ents^[I].Name
 Else MgrFullPath:=JoinPath(Dt_^.Path,Dt_^.Ents^[I].Name);
End;

Function MgrDriveCount(Wd_: PWindow): Integer;
 Var Dt_: PManager;
Var D,N: Integer;
Begin
 Dt_:=Wd_^.Data;
 N:=0;
 For D:=1 To 26 Do If DriveExists(D) Then Inc(N);
 MgrDriveCount:=N;
End;

Procedure MgrOpenItem(Wd_: PWindow; I: Integer);
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 If (I<0) Or (I>=Dt_^.NE) Then Exit;
 Case Dt_^.Ents^[I].Kind Of
  0: Begin
      If MgrIsVirtual(Wd_) Then MgrGoPath(Wd_,Dt_^.Path+'\'+Dt_^.Ents^[I].Name)
      Else MgrGoPath(Wd_,JoinPath(Dt_^.Path,Dt_^.Ents^[I].Name));
     End;
 Else
  If MgrIsVirtual(Wd_) Then LaunchApp(Dt_^.Ents^[I].App,'')
  Else LaunchFile(MgrFullPath(Wd_,I));
 End;
End;

Procedure MgrDrawBar(Wd_: PWindow; X1,Y1,X2,Y2: Integer);
 Var Dt_: PManager;
Var BX,D,N,DX: Integer; L: String;
Begin
 Dt_:=Wd_^.Data;
 GBar(X1,Y1,X2,Y2,cLGr);
 GHLine(X1,X2,Y1,cWht);
 GHLine(X1,X2,Y1+1,cDGr);
 BX:=X1+6;
 Btn3D(BX,Y1+4,BX+43,Y1+38,False);DrawIcon(IC_TRASH,BX-2,Y1+6,False);Inc(BX,52);
 Btn3D(BX,Y1+4,BX+43,Y1+38,False);DrawIcon(IC_TILE,BX-2,Y1+6,False);Inc(BX,48);
 Btn3D(BX,Y1+4,BX+43,Y1+38,False);DrawIcon(IC_OVERLAP,BX-2,Y1+6,False);
 Inc(BX,56);
 Btn3D(BX,Y1+4,BX+43,Y1+38,False);DrawIcon(IC_GLOBE,BX-2,Y1+6,False);Inc(BX,48);
 Btn3D(BX,Y1+4,BX+43,Y1+38,False);DrawIcon(IC_DOCS,BX-2,Y1+6,False);
 { lecteurs }
 N:=0;
 For D:=1 To 26 Do If DriveExists(D) And (N<6) Then Inc(N);
 DX:=X2-6-N*54;
 N:=0;
 For D:=1 To 26 Do
  If DriveExists(D) And (N<6) Then Begin
   Btn3D(DX,Y1+4,DX+49,Y1+38,False);
   Case D Of
    1: DrawIcon(IC_FLOP525,DX-1,Y1+6,False);
    2: DrawIcon(IC_FLOP35,DX-1,Y1+6,False);
   Else If D=3 Then DrawIcon(IC_HDD,DX-1,Y1+6,False) Else DrawIcon(IC_CDROM,
       DX-1,Y1+6,False);
   End;
   L:=Chr(64+D);
   GBar(DX+3,Y1+7,DX+11,Y1+17,cBlk);
   GText(DX+4,Y1+9,L,cWht);
   Inc(DX,54);Inc(N);
  End;
End;

Procedure MgrDrawClient(Wd_: PWindow);
 Var Dt_: PManager;
Var X1,Y1,X2,Y2,FX1,FY1,FX2,FY2,I,IX,IY,VR,Ln,Tx,IcId: Integer; S,S2,P: String;
    Cap,Tot: LongInt; Sel: Boolean; Lines: Array[1..2] Of String[12];
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 MgrOnResize(Wd_);
 { barre de chemin }
 Btn3D(X1+4,Y1+3,X1+30,Y1+22,False);
 GArrow(X1+17,Y1+12,1,cBlk);GHLine(X1+11,X1+23,Y1+17,cBlk);
 If MgrIsVirtual(Wd_) Then Begin
  If Dt_^.Path='V:WORLD' Then P:='C:[Unnamed1] \GEOWORKS\WORLD'
  Else If Dt_^.Path='V:WORLD\EXTRAS' Then
      P:='C:[Unnamed1] \GEOWORKS\WORLD\EXTRAS'
  Else P:='C:[Unnamed1] \GEOWORKS\DOCUMENT';
  Tot:=0;
 End Else Begin
  P:=Dt_^.Path;
  If (Length(P)>=2) And (P[2]=':') Then P:=Copy(P,1,
      2)+'[Unnamed'+IntStr(DriveOfPath(P)-2)+'] '+Copy(P,3,255);
 End;
 S:=P+' - '+IntStr(Dt_^.NE)+' '+T3('items',''#130'l'#130'ments','Elemente');
 If Not MgrIsVirtual(Wd_) Then S:=S+' ('+NumFmt(Dt_^.TotBytes)+' '+T3('bytes',
     'octets','Bytes')+')';
 S:=S+'.';
 If Not MgrIsVirtual(Wd_) Then Begin
  Tot:=DiskFree(DriveOfPath(Dt_^.Path));
  If Tot>=0 Then S:=S+' '+NumFmt(Tot)+' '+T3('bytes free','octets libres',
      'Bytes frei');
 End;
 Sunken1(X1+34,Y1+3,X2-4,Y1+22);
 GText(X1+38,Y1+9,Copy(S,1,(X2-X1-44) Div 8),cBlk);
 { liste }
 Sunken(FX1,FY1,FX2,FY2,cWht);
 MgrOnResize(Wd_);
 If Dt_^.ViewMode=0 Then VR:=(FY2-FY1-4) Div CellH Else VR:=(FY2-FY1-4) Div 14;
 If VR<1 Then VR:=1;
 For I:=0 To Dt_^.NE-1 Do Begin
  MgrItemRect(Wd_,I,IX,IY,Tx,Ln);
  If (Ln>=FY1+2) And (IY<=FY2-2) Then Begin
   Sel:=Dt_^.Ents^[I].Sel;
   If Dt_^.ViewMode=0 Then Begin
    IcId:=Dt_^.Ents^[I].Icon;
    If LargeView And (BigIcon(IcId)>=0) Then IcId:=BigIcon(IcId);
    DrawIcon(IcId,IX+(CellW-IconWd[IcId]) Div 2,IY,Sel);
    S:=Dt_^.Ents^[I].Disp;
    { libelle sur 2 lignes maximum }
    Lines[1]:=S;Lines[2]:='';
    If Length(S)>12 Then Begin
     Tx:=12;
     While (Tx>3) And (S[Tx+1]<>' ') And (S[Tx]<>' ') Do Dec(Tx);
     If Tx<=3 Then Tx:=12;
     Lines[1]:=Copy(S,1,Tx);
     Lines[2]:=Copy(S,Tx+1,12);
     While (Lines[1]<>'') And (Lines[1][Length(Lines[1])]=' ') Do
         Delete(Lines[1],Length(Lines[1]),1);
     While (Lines[2]<>'') And (Lines[2][1]=' ') Do Delete(Lines[2],1,1);
    End;
    For Ln:=1 To 2 Do
     If Lines[Ln]<>'' Then Begin
      If Sel Then Begin
       GBar(IX+(CellW-TextW(Lines[Ln])) Div 2-2,IY+IconHt[IcId]+3+(Ln-1)*10,
            IX+(CellW+TextW(Lines[Ln])) Div 2+1,IY+IconHt[IcId]+12+(Ln-1)*10,
                cBlk);
       GTextCtr(IX,IX+CellW-1,IY+IconHt[IcId]+5+(Ln-1)*10,Lines[Ln],cWht);
      End Else GTextCtr(IX,IX+CellW-1,IY+IconHt[IcId]+5+(Ln-1)*10,Lines[Ln],
          cBlk);
     End;
   End Else Begin
    If Sel Then GBar(IX,IY,FX2-SB-2,IY+13,cBlk);
    If Sel Then Ln:=cWht Else Ln:=cBlk;
    GText(IX+4,IY+3,Copy(Dt_^.Ents^[I].Disp,1,26),Ln);
    If Dt_^.ViewMode=2 Then Begin
     If Dt_^.Ents^[I].Kind=0 Then S:=T3('<DIR>','<REP>','<VERZ>')
     Else S:=NumFmt(Dt_^.Ents^[I].Size);
     GText(IX+4+27*8,IY+3,S,Ln);
     Case Dt_^.Ents^[I].Kind Of
      0: S2:=T3('Directory','R'#130'pertoire','Verzeichnis');
      1: S2:=T3('Application','Application','Anwendung');
      2: S2:='Geode';
      3: S2:=T3('GEOS document','Document GEOS','GEOS-Dokument');
      4: S2:=T3('DOS program','Programme DOS','DOS-Programm');
      5: S2:=T3('Text file','Fichier texte','Textdatei');
     Else S2:=T3('File','Fichier','Datei');
     End;
     GText(IX+4+38*8,IY+3,S2,Ln);
    End;
   End;
  End;
 End;
  If Dt_^.RbOn Then Begin
  SetClip(Max2(CX1,FX1+2),Max2(CY1,FY1+2),Min2(CX2,FX2-SB-1),Min2(CY2,FY2-2));
  GDotRect(Min2(Dt_^.RbX0,Dt_^.RbX1),Min2(Dt_^.RbY0,Dt_^.RbY1),Max2(Dt_^.RbX0,
      Dt_^.RbX1),Max2(Dt_^.RbY0,Dt_^.RbY1),cBlu);
  ClipFull;
 End;
 DrawScroll(True,FX2-SB+1,FY1+2,FX2-2,FY2-2,MgrRows(Wd_),VR,Dt_^.Top);
 MgrDrawBar(Wd_,X1,Y2-BAR_H+1,X2,Y2);
End;

Procedure MgrBarRects(Wd_: PWindow; Var TX: Integer);
 Var Dt_: PManager;
Begin
 Dt_:=Wd_^.Data;
 TX:=0;
End;

Procedure MgrOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PManager;
Var FX1,FY1,FX2,FY2,X1,Y1,X2,Y2,I,P,VR,D,N,DX,BX: Integer; Tgt: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 MgrGeom(Wd_,FX1,FY1,FX2,FY2);
 If Dt_^.ViewMode=0 Then VR:=(FY2-FY1-4) Div CellH Else VR:=(FY2-FY1-4) Div 14;
 If VR<1 Then VR:=1;
 If E.Kind=EV_DOWN Then Begin
  Dt_^.SBDrag:=False;Dt_^.Dragging:=False;Dt_^.DragEnt:=-1;
  If E.Y<FY1 Then Begin
   If InBox(E.X,E.Y,X1+4,Y1+3,X1+30,Y1+22) Then MgrGoUp(Wd_);
   Exit;
  End;
  If E.Y>FY2 Then Begin
   { barre inferieure }
   BX:=X1+6;
   If InBox(E.X,E.Y,BX,Y2-BAR_H+5,BX+43,Y2-BAR_H+39) Then
    Info(T3('Wastebasket','Corbeille','Papierkorb'),
         T3('Drag files here to delete them.',
             'Glissez des fichiers ici pour les supprimer.',
             'Dateien hierher ziehen zum L'#148'schen.'));
   Inc(BX,52);
   If InBox(E.X,E.Y,BX,Y2-BAR_H+5,BX+43,Y2-BAR_H+39) Then CommonCmd(Wd_,
       CM_TILE);
   Inc(BX,48);
   If InBox(E.X,E.Y,BX,Y2-BAR_H+5,BX+43,Y2-BAR_H+39) Then CommonCmd(Wd_,
       CM_OVERLAP);
   Inc(BX,56);
   If InBox(E.X,E.Y,BX,Y2-BAR_H+5,BX+43,Y2-BAR_H+39) Then MgrOnCommand(Wd_,
       CM_WORLD);
   Inc(BX,48);
   If InBox(E.X,E.Y,BX,Y2-BAR_H+5,BX+43,Y2-BAR_H+39) Then MgrOnCommand(Wd_,
       CM_DOCDIR);
   N:=0;
   For D:=1 To 26 Do If DriveExists(D) And (N<6) Then Inc(N);
   DX:=X2-6-N*54;
   N:=0;
   For D:=1 To 26 Do
    If DriveExists(D) And (N<6) Then Begin
     If InBox(E.X,E.Y,DX,Y2-BAR_H+5,DX+49,Y2-BAR_H+39) Then MgrGoPath(Wd_,
         DriveRoot(D));
     Inc(DX,54);Inc(N);
    End;
   Exit;
  End;
  If E.X>=FX2-SB+1 Then Begin
   P:=ScrollPart(True,FX2-SB+1,FY1+2,FX2-2,FY2-2,MgrRows(Wd_),VR,Dt_^.Top,E.X,
       E.Y);
   Case P Of
    1: Dt_^.Top:=Max2(0,Dt_^.Top-1);
    2: Dt_^.Top:=Max2(0,Min2(MgrRows(Wd_)-VR,Dt_^.Top+1));
    3: Dt_^.Top:=Max2(0,Dt_^.Top-VR);
    4: Dt_^.Top:=Max2(0,Min2(MgrRows(Wd_)-VR,Dt_^.Top+VR));
    5: Begin Dt_^.SBDrag:=True;
        ScrollThumb(FY1+2+SB,FY2-2-SB,MgrRows(Wd_),VR,Dt_^.Top,I,N);
        Dt_^.SBGrab:=E.Y-I;
       End;
   End;
   Invalidate(Wd_);
   Exit;
  End;
  I:=MgrItemAt(Wd_,E.X,E.Y);
  If I>=0 Then Begin
   If Dt_^.ExtSel And Not E.Dbl Then Dt_^.Ents^[I].Sel:=Not Dt_^.Ents^[I].Sel
   Else If Not Dt_^.Ents^[I].Sel Then MgrSelectOnly(Wd_,I);
   Dt_^.Cur:=I;
   If E.Dbl Then MgrOpenItem(Wd_,I)
   Else If Dt_^.Ents^[I].Sel Then Begin Dt_^.DragEnt:=I;Dt_^.DragX:=E.X;
   Dt_^.DragY:=E.Y;End;
  End Else Begin
   If Not Dt_^.ExtSel Then Begin
    For P:=0 To Dt_^.NE-1 Do Dt_^.Ents^[P].Sel:=False;
    Dt_^.Cur:=-1;
   End;
   If InBox(E.X,E.Y,FX1+2,FY1+2,FX2-SB-1,FY2-2) Then Begin
    Dt_^.RbOn:=True;Dt_^.RbX0:=E.X;Dt_^.RbY0:=E.Y;Dt_^.RbX1:=E.X;Dt_^.RbY1:=E.Y;
   End;
  End;
  Invalidate(Wd_);
 End Else If E.Kind=EV_MOVE Then Begin
  If Dt_^.SBDrag Then Begin
   Dt_^.Top:=ScrollDrag(True,FX2-SB+1,FY1+2,FX2-2,FY2-2,MgrRows(Wd_),VR,E.Y,
       Dt_^.SBGrab);
   Invalidate(Wd_);
  End Else If Dt_^.RbOn Then Begin
   Dt_^.RbX1:=E.X;Dt_^.RbY1:=E.Y;
   For P:=0 To Dt_^.NE-1 Do Begin
    MgrItemRect(Wd_,P,DX,BX,D,N);
    If (DX<=Max2(Dt_^.RbX0,Dt_^.RbX1)) And (D>=Min2(Dt_^.RbX0,Dt_^.RbX1)) And
       (BX<=Max2(Dt_^.RbY0,Dt_^.RbY1)) And (N>=Min2(Dt_^.RbY0,
           Dt_^.RbY1)) Then Begin
     Dt_^.Ents^[P].Sel:=True;Dt_^.Cur:=P;
    End Else If Not Dt_^.ExtSel Then Dt_^.Ents^[P].Sel:=False;
   End;
   Invalidate(Wd_);
  End Else If (Dt_^.DragEnt>=0) And ((Abs(E.X-Dt_^.DragX)>5)
      Or (Abs(E.Y-Dt_^.DragY)>5)) Then Dt_^.Dragging:=True;
 End Else If E.Kind=EV_UP Then Begin
  If Dt_^.Dragging And (Dt_^.DragEnt>=0) Then Begin
   Tgt:=MgrItemAt(Wd_,E.X,E.Y);
   If (E.Y>FY2) And InBox(E.X,E.Y,X1+6,Y2-BAR_H+5,X1+49,Y2-BAR_H+39) Then Begin
    MgrDoDelete(Wd_);
   End Else If (Tgt>=0) And (Tgt<>Dt_^.DragEnt) And (Dt_^.Ents^[Tgt].Kind=0)
       And Not MgrIsVirtual(Wd_) Then Begin
    If Confirm(T3('Move','D'#130'placer','Verschieben'),
     T3('Move to directory|','D'#130'placer vers le r'#130'pertoire|',
         'Verschieben nach|')+Dt_^.Ents^[Tgt].Name+'?') Then Begin
     Dt_^.Ents^[Tgt].Sel:=False;
     MgrXfer(Wd_,MgrFullPath(Wd_,Tgt),True);
     MgrScan(Wd_);
    End;
   End;
  End;
  Dt_^.Dragging:=False;Dt_^.DragEnt:=-1;Dt_^.SBDrag:=False;Dt_^.RbOn:=False;
  Invalidate(Wd_);
 End;
End;

Procedure MgrOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PManager;
Var N,Old: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NE=0 Then Begin
  If K=K_BKSP Then MgrGoUp(Wd_);
  Exit;
 End;
 Old:=Dt_^.Cur;
 Case K Of
  K_ENTER: If Dt_^.Cur>=0 Then MgrOpenItem(Wd_,Dt_^.Cur);
  K_SPACE: If Dt_^.Cur>=0 Then Dt_^.Ents^[Dt_^.Cur].Sel:=Not
      Dt_^.Ents^[Dt_^.Cur].Sel;
  K_BKSP: MgrGoUp(Wd_);
  K_DEL: MgrDoDelete(Wd_);
  K_F2: MgrDoRename(Wd_);
  K_F5: Begin MgrScan(Wd_);Invalidate(Wd_);End;
  K_CTRLA: MgrOnCommand(Wd_,CM_SELALL);
  K_LEFT: Begin If Dt_^.Cur<0 Then N:=0 Else N:=Dt_^.Cur-1;If N<0 Then N:=0;
  MgrSelectOnly(Wd_,N);End;
  K_RIGHT: Begin If Dt_^.Cur<0 Then N:=0 Else N:=Dt_^.Cur+1;
  If N>=Dt_^.NE Then N:=Dt_^.NE-1;MgrSelectOnly(Wd_,N);End;
  K_UP: Begin
         If Dt_^.ViewMode=0 Then N:=Dt_^.Cur-Dt_^.Cols Else N:=Dt_^.Cur-1;
         If Dt_^.Cur<0 Then N:=0;
         If N<0 Then N:=0;
         MgrSelectOnly(Wd_,N);
        End;
  K_DOWN: Begin
         If Dt_^.ViewMode=0 Then N:=Dt_^.Cur+Dt_^.Cols Else N:=Dt_^.Cur+1;
         If Dt_^.Cur<0 Then N:=0;
         If N>=Dt_^.NE Then N:=Dt_^.NE-1;
         MgrSelectOnly(Wd_,N);
        End;
  K_HOME: MgrSelectOnly(Wd_,0);
  K_END: MgrSelectOnly(Wd_,Dt_^.NE-1);
  K_PGUP: Begin MgrSelectOnly(Wd_,Max2(0,Dt_^.Cur-Dt_^.Cols*3));End;
  K_PGDN: Begin MgrSelectOnly(Wd_,Min2(Dt_^.NE-1,Dt_^.Cur+Dt_^.Cols*3));End;
 End;
 If (Dt_^.Cur>=0) And (Dt_^.Cur<>Old) Then MgrEnsureVisible(Wd_,Dt_^.Cur);
 Invalidate(Wd_);
End;

Procedure MgrPrepareMenus(Wd_: PWindow);
 Var Dt_: PManager;
Var D: Integer; Any: Boolean;
Begin
 Dt_:=Wd_^.Data;
 Any:=Dt_^.Cur>=0;
 WinSetFlag(Wd_,CM_OPEN,1,Not Any);
 WinSetFlag(Wd_,CM_INFO,1,Not Any);
 WinSetFlag(Wd_,CM_RENAME,1,Not Any Or MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_DUP,1,Not Any Or MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_COPYTO,1,Not Any Or MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_MOVETO,1,Not Any Or MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_DELETE,1,Not Any Or MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_MKDIR,1,MgrIsVirtual(Wd_));
 WinSetFlag(Wd_,CM_VICON,2,(Dt_^.ViewMode=0) And Not LargeView);
 WinSetFlag(Wd_,CM_VLARGE,2,(Dt_^.ViewMode=0) And LargeView);
 WinSetFlag(Wd_,CM_VNAME,2,Dt_^.ViewMode=1);
 WinSetFlag(Wd_,CM_VDET,2,Dt_^.ViewMode=2);
 WinSetFlag(Wd_,CM_SNAME,2,Dt_^.SortMode=0);
 WinSetFlag(Wd_,CM_STYPE,2,Dt_^.SortMode=1);
 WinSetFlag(Wd_,CM_SSIZE,2,Dt_^.SortMode=2);
 WinSetFlag(Wd_,CM_HIDDEN,2,Dt_^.ShowHid);
 WinSetFlag(Wd_,CM_CONFIRM,2,Dt_^.ConfirmDel);
 WinSetFlag(Wd_,CM_EXTSEL,2,Dt_^.ExtSel);
 For D:=1 To 26 Do WinSetFlag(Wd_,CM_DRIVE+D,2,
     (Not MgrIsVirtual(Wd_)) And (DriveOfPath(Dt_^.Path)=D));
End;

Procedure MgrDoInfo(Wd_: PWindow);
 Var Dt_: PManager;
Var S,T: String; G: TGeosInfo; K: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.Cur<0 Then Exit;
 K:=Dt_^.Cur;
 If MgrIsVirtual(Wd_) Then Begin
  Info(Dt_^.Ents^[K].Disp,T3('Built-in application',
      'Application int'#130'gr'#130'e','Eingebaute Anwendung'));
  Exit;
 End;
 S:=Dt_^.Ents^[K].Name+'|';
 If Dt_^.Ents^[K].Kind=0 Then S:=S+T3('Type: directory',
     'Type : r'#130'pertoire','Typ: Verzeichnis')
 Else Begin
  S:=S+T3('Size: ','Taille : ','Gr'#148#225'e: ')+NumFmt(Dt_^.Ents^[K].Size)+' '
      +T3('bytes','octets','Bytes')+'|';
  If ReadGeosHeader(MgrFullPath(Wd_,K),G) Then Begin
   S:=S+T3('GEOS name: ','Nom GEOS : ','GEOS-Name: ')+G.LongName+'|';
   S:=S+T3('Token: ','Jeton : ','Token: ')+G.Tok+'   Creator: '+G.Creator+'|';
   S:=S+'PC/GEOS '+IntStr(G.Ver)+'.x   Release '+IntStr(G.Release
       shr 8)+'.'+IntStr(G.Release and 255);
  End Else S:=S+T3('Type: DOS file','Type : fichier DOS','Typ: DOS-Datei');
 End;
 Info(T3('Get Info','Informations','Informationen'),S);
End;

{ Suppression recursive d'un repertoire }
Function DelTree(Const P: String): Boolean;
Var SR: SearchRec; Ok: Boolean; F: File;
Begin
 Ok:=True;
 FindFirst(JoinPath(P,'*'),AnyFile,SR);
 While DosError=0 Do Begin
  If (SR.Name<>'.') And (SR.Name<>'..') Then Begin
   If (SR.Attr And Directory)<>0 Then Begin
    If Not DelTree(JoinPath(P,SR.Name)) Then Ok:=False;
   End Else Begin
    {$I-}
    Assign(F,JoinPath(P,SR.Name));Erase(F);
    {$I+}
    If IOResult<>0 Then Ok:=False;
   End;
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC}
 FindClose(SR);
 {$ENDIF}
 {$I-}
 RmDir(P);
 {$I+}
 If IOResult<>0 Then Ok:=False;
 DelTree:=Ok;
End;

Procedure MgrDoDelete(Wd_: PWindow);
 Var Dt_: PManager;
Var I,N,ND: Integer; Ok: Boolean; Sg: String;
Begin
 Dt_:=Wd_^.Data;
 If MgrIsVirtual(Wd_) Then Exit;
 N:=0;ND:=0;
 For I:=0 To Dt_^.NE-1 Do If Dt_^.Ents^[I].Sel Then Begin Inc(N);
 If Dt_^.Ents^[I].Kind=0 Then Inc(ND);End;
 If N=0 Then Exit;
 If Dt_^.ConfirmDel Or (ND>0) Then Begin
  If N=1 Then Sg:=T3('Delete ','Supprimer ',
      'L'#148'schen ')+Dt_^.Ents^[Dt_^.Cur].Name+' ?'
  Else Sg:=T3('Delete ','Supprimer ','L'#148'schen ')+IntStr(N)+' '+T3('items?',
      ''#130'l'#130'ments ?','Elemente?');
  If ND>0 Then Sg:=Sg+'|'+T3('Directories are deleted with their contents.',
      'Les r'#130'pertoires sont supprim'#130's avec leur contenu.',
                            'Verzeichnisse werden mit Inhalt gel'#148'scht.');
  If Not Confirm(T3('Delete','Supprimer','L'#148'schen'),Sg) Then Exit;
 End;
 For I:=0 To Dt_^.NE-1 Do
  If Dt_^.Ents^[I].Sel Then Begin
   If Dt_^.Ents^[I].Kind=0 Then Ok:=DelTree(MgrFullPath(Wd_,I))
   Else Begin
    {$I-}
    Assign(F_,MgrFullPath(Wd_,I));Erase(F_);
    Ok:=IOResult=0;
    {$I+}
   End;
   If Not Ok Then Info(T3('Error','Erreur','Fehler'),T3('Cannot delete|',
       'Impossible de supprimer|','Kann nicht l'#148'schen|')+
       Dt_^.Ents^[I].Name);
  End;
 MgrScan(Wd_);
 Invalidate(Wd_);
End;

Procedure MgrDoRename(Wd_: PWindow);
 Var Dt_: PManager;
Var S: String; Ok: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If (Dt_^.Cur<0) Or MgrIsVirtual(Wd_) Then Exit;
 S:=Dt_^.Ents^[Dt_^.Cur].Name;
 If InputBox(T3('Rename','Renommer','Umbenennen'),T3('New name:',
     'Nouveau nom :','Neuer Name:'),S,44) Then Begin
  If (S<>'') And (S<>Dt_^.Ents^[Dt_^.Cur].Name) Then Begin
   {$I-}
   Assign(F_,MgrFullPath(Wd_,Dt_^.Cur));
   Rename(F_,JoinPath(Dt_^.Path,S));
   Ok:=IOResult=0;
   {$I+}
   If Not Ok Then Info(T3('Error','Erreur','Fehler'),T3('Cannot rename.',
       'Impossible de renommer.','Umbenennen nicht m'#148'glich.'));
   MgrScan(Wd_);Invalidate(Wd_);
  End;
 End;
End;

Var
 XferMode   : Integer;      { 0 demander, 1 tout remplacer, 2 tout ignorer }
 XferCancel : Boolean;

Function XferFile(Const Src,Dst: String; Move: Boolean): Boolean;
Var R: Integer; F: File;
Begin
 XferFile:=True;
 If FileExists(Dst) Then Begin
  If XferMode=2 Then Exit;
  If XferMode=0 Then Begin
   R:=ChoiceBox(T3('Confirm Replace','Confirmer le remplacement',
       'Ersetzen best'#132'tigen'),
      ShortName(Dst)+T3(' already exists.',' existe d'#130'j'#133'.',
          ' existiert bereits.'),
      T3('Replace|Replace All|Skip|Skip All|Cancel',
          'Remplacer|Tout remplacer|Ignorer|Tout ignorer|Annuler',
         'Ersetzen|Alle ersetzen|'#154'berspringen|Alle '#129+
             'berspringen|Abbrechen'),1);
   Case R Of
    2: XferMode:=1;
    3: Exit;
    4: Begin XferMode:=2;Exit;End;
    5,0: Begin XferCancel:=True;XferFile:=False;Exit;End;
   End;
  End;
 End;
 If Not CopyFileTo(Src,Dst) Then Begin XferFile:=False;Exit;End;
 If Move Then Begin
  {$I-}
  Assign(F,Src);Erase(F);
  {$I+}
  If IOResult<>0 Then Beep;
 End;
End;

{ Copie ou deplace un repertoire de facon recursive }
Function XferDir(Const Src,Dst: String; Move: Boolean): Boolean;
Var SR: SearchRec; Ok: Boolean;
Begin
 Ok:=True;
 If Pos(Upper(Src)+DirSep,Upper(Dst)+DirSep)=1 Then Begin XferDir:=False;Exit;
 End;
 {$I-}
 If Not DirExists(Dst) Then MkDir(Dst);
 {$I+}
 If IOResult<>0 Then Begin XferDir:=False;Exit;End;
 FindFirst(JoinPath(Src,'*'),AnyFile,SR);
 While (DosError=0) And Not XferCancel Do Begin
  If (SR.Name<>'.') And (SR.Name<>'..') Then Begin
   If (SR.Attr And Directory)<>0 Then Begin
    If Not XferDir(JoinPath(Src,SR.Name),JoinPath(Dst,SR.Name),
        Move) Then Ok:=False;
   End Else If Not XferFile(JoinPath(Src,SR.Name),JoinPath(Dst,SR.Name),
       Move) Then Ok:=False;
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC}
 FindClose(SR);
 {$ENDIF}
 If Move And Ok And Not XferCancel Then Begin
  {$I-}
  RmDir(Src);
  {$I+}
  If IOResult<>0 Then Begin End;
 End;
 XferDir:=Ok;
End;

{ Copie ou deplace tous les elements selectionnes vers DstDir }
Procedure MgrXfer(Wd_: PWindow; Const DstDir: String; Move: Boolean);
 Var Dt_: PManager;
Var I,Bad: Integer; Src,Dst: String; Ok: Boolean;
Begin
 Dt_:=Wd_^.Data;
 XferMode:=0;XferCancel:=False;Bad:=0;
 For I:=0 To Dt_^.NE-1 Do
  If Dt_^.Ents^[I].Sel And Not XferCancel Then Begin
   Src:=MgrFullPath(Wd_,I);
   Dst:=JoinPath(DstDir,Dt_^.Ents^[I].Name);
   If Upper(Src)<>Upper(Dst) Then Begin
    If Dt_^.Ents^[I].Kind=0 Then Ok:=XferDir(Src,Dst,
        Move) Else Ok:=XferFile(Src,Dst,Move);
    If Not Ok And Not XferCancel Then Inc(Bad);
   End;
  End;
 If Bad>0 Then
  Info(T3('Error','Erreur','Fehler'),
      IntStr(Bad)+' '+T3('item(s) could not be copied or moved.',
      ''#130'l'#130'ment(s) non copi'#130'(s) ou d'#130'plac'#130'(s).',
       'Element(e) nicht kopiert oder verschoben.'));
 MgrScan(Wd_);Invalidate(Wd_);
End;

Procedure MgrDoCopyMove(Wd_: PWindow; Move,Dup: Boolean);
 Var Dt_: PManager;
Var S,Dst: String; I,N: Integer; Ok: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If MgrIsVirtual(Wd_) Then Exit;
 N:=0;
 For I:=0 To Dt_^.NE-1 Do If Dt_^.Ents^[I].Sel Then Inc(N);
 If N=0 Then Exit;
 If Dup Then Begin
  If Dt_^.Cur<0 Then Exit;
  S:=Dt_^.Ents^[Dt_^.Cur].Name;
  If Pos('.',S)>0 Then S:=Copy(S,1,Pos('.',S)-1)+'2'+Copy(S,Pos('.',S),
      20) Else S:=S+'2';
  If Not InputBox(T3('Duplicate','Dupliquer','Duplizieren'),
      T3('Name of the copy:','Nom de la copie :','Name der Kopie:'),S,
      44) Then Exit;
  Dst:=JoinPath(Dt_^.Path,S);
  XferMode:=0;XferCancel:=False;
  If Dt_^.Ents^[Dt_^.Cur].Kind=0 Then Ok:=XferDir(MgrFullPath(Wd_,Dt_^.Cur),Dst,
      False)
  Else Ok:=XferFile(MgrFullPath(Wd_,Dt_^.Cur),Dst,False);
  If Not Ok Then Info(T3('Error','Erreur','Fehler'),T3('Copy failed.',
      ''#130'chec de la copie.','Kopieren fehlgeschlagen.'));
  MgrScan(Wd_);Invalidate(Wd_);
  Exit;
 End;
 S:=Dt_^.Path;
 If Not InputBox(T3('Destination','Destination','Ziel'),T3('Directory:',
     'R'#130'pertoire :','Verzeichnis:'),S,70) Then Exit;
 If Not DirExists(S) Then Begin
  Info(T3('Error','Erreur','Fehler'),T3('Directory not found.',
      'R'#130'pertoire introuvable.','Verzeichnis nicht gefunden.'));
  Exit;
 End;
 MgrXfer(Wd_,S,Move);
End;

{ Filtre de type DOS : * et ? }
Function WildMatch(Const P,S: String; I,J: Integer): Boolean;
Begin
 If I>Length(P) Then WildMatch:=J>Length(S)
 Else If P[I]='*' Then WildMatch:=WildMatch(P,S,I+1,
     J) Or ((J<=Length(S)) And WildMatch(P,S,I,J+1))
 Else If J>Length(S) Then WildMatch:=False
 Else If (P[I]='?') Or (UpCase(P[I])=UpCase(S[J])) Then WildMatch:=WildMatch(P,
     S,I+1,J+1)
 Else WildMatch:=False;
End;

Procedure MgrSelPattern(Wd_: PWindow);
 Var Dt_: PManager;
Var P,Nm: String; I,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 P:='*.*';
 If Not InputBox(T3('Select by Pattern','S'#130'lection par motif',
     'Auswahl nach Muster'),T3('Pattern (* and ?):','Motif (* et ?) :',
     'Muster (* und ?):'),P,30) Then Exit;
 P:=Upper(P);
 If P='*.*' Then P:='*';
 For I:=0 To Dt_^.NE-1 Do Begin
  Nm:=Dt_^.Ents^[I].Name;
  Dt_^.Ents^[I].Sel:=WildMatch(P,Nm,1,1) And (Dt_^.Ents^[I].Kind<>0);
 End;
 K:=-1;
 For I:=0 To Dt_^.NE-1 Do If Dt_^.Ents^[I].Sel Then K:=I;
 Dt_^.Cur:=K;
 Invalidate(Wd_);
End;

Procedure MgrDoMkDir(Wd_: PWindow);
 Var Dt_: PManager;
Var S: String; Ok: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If MgrIsVirtual(Wd_) Then Exit;
 S:='';
 If InputBox(T3('Create Directory','Cr'#130'er un r'#130'pertoire',
     'Verzeichnis erstellen'),
             T3('Name:','Nom :','Name:'),S,44) And (S<>'') Then Begin
  {$I-}
  MkDir(JoinPath(Dt_^.Path,S));
  Ok:=IOResult=0;
  {$I+}
  If Not Ok Then Info(T3('Error','Erreur','Fehler'),
      T3('Cannot create directory.','Impossible de cr'#130'er le r'#130+
      'pertoire.','Verzeichnis nicht erstellbar.'));
  MgrScan(Wd_);Invalidate(Wd_);
 End;
End;

Procedure MgrOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PManager;
Var I,D: Integer; Tot,Fr: LongInt;
Begin
 Dt_:=Wd_^.Data;
 If (Cmd>CM_DRIVE) And (Cmd<=CM_DRIVE+26) Then Begin
  MgrGoPath(Wd_,DriveRoot(Cmd-CM_DRIVE));
  Exit;
 End;
 Case Cmd Of
  CM_OPEN: MgrOpenItem(Wd_,Dt_^.Cur);
  CM_OPENEMU: If (Dt_^.Cur>=0) And Not MgrIsVirtual(Wd_) Then LaunchApp(A_GEODE,
      MgrFullPath(Wd_,Dt_^.Cur));
  CM_INFO: MgrDoInfo(Wd_);
  CM_RENAME: MgrDoRename(Wd_);
  CM_DUP: MgrDoCopyMove(Wd_,False,True);
  CM_COPYTO: MgrDoCopyMove(Wd_,False,False);
  CM_MOVETO: MgrDoCopyMove(Wd_,True,False);
  CM_DELETE: MgrDoDelete(Wd_);
  CM_MKDIR: MgrDoMkDir(Wd_);
  CM_EXTSEL: Begin Dt_^.ExtSel:=Not Dt_^.ExtSel;Invalidate(Wd_);End;
  CM_SELINV: Begin
              For I:=0 To Dt_^.NE-1 Do Dt_^.Ents^[I].Sel:=Not Dt_^.Ents^[I].Sel;
              Invalidate(Wd_);
             End;
  CM_SELPAT: MgrSelPattern(Wd_);
  CM_TREE: LaunchApp(A_TREE,Dt_^.Path);
  CM_SELALL: Begin
              For I:=0 To Dt_^.NE-1 Do Dt_^.Ents^[I].Sel:=True;
              If Dt_^.Cur<0 Then Dt_^.Cur:=0;
              Invalidate(Wd_);
             End;
  CM_UP: MgrGoUp(Wd_);
  CM_ROOT: MgrGoPath(Wd_,DriveRoot(DriveOfPath(Dt_^.Path)));
  CM_WORLD: If WorldDir<>'' Then MgrGoPath(Wd_,WorldDir) Else MgrGoPath(Wd_,
      'V:WORLD');
  CM_DOCDIR: Begin
              If WorldDir<>'' Then Begin
               If DirExists(JoinPath(DirOf(ParentDir(WorldDir)),
                   'DOCUMENT')) Then
                MgrGoPath(Wd_,JoinPath(DirOf(ParentDir(WorldDir)),'DOCUMENT'))
               Else MgrGoPath(Wd_,'V:DOCUMENT');
              End Else MgrGoPath(Wd_,'V:DOCUMENT');
             End;
  CM_HOMEDIR: If HomeDir<>'' Then MgrGoPath(Wd_,HomeDir);
  CM_REFRESH: Begin MgrScan(Wd_);Invalidate(Wd_);End;
  CM_VICON: Begin Dt_^.ViewMode:=0;LargeView:=False;Dt_^.Top:=0;NeedFull:=True;
  End;
  CM_VLARGE: Begin Dt_^.ViewMode:=0;LargeView:=True;Dt_^.Top:=0;NeedFull:=True;
  End;
  CM_VNAME: Begin Dt_^.ViewMode:=1;Dt_^.Top:=0;Invalidate(Wd_);End;
  CM_VDET: Begin Dt_^.ViewMode:=2;Dt_^.Top:=0;Invalidate(Wd_);End;
  CM_SNAME: Begin Dt_^.SortMode:=0;MgrSortEnts(Wd_);Invalidate(Wd_);End;
  CM_STYPE: Begin Dt_^.SortMode:=1;MgrSortEnts(Wd_);Invalidate(Wd_);End;
  CM_SSIZE: Begin Dt_^.SortMode:=2;MgrSortEnts(Wd_);Invalidate(Wd_);End;
  CM_HIDDEN: Begin Dt_^.ShowHid:=Not Dt_^.ShowHid;MgrScan(Wd_);Invalidate(Wd_);
  End;
  CM_CONFIRM: Dt_^.ConfirmDel:=Not Dt_^.ConfirmDel;
  CM_DINFO: Begin
             D:=DriveOfPath(Dt_^.Path);
             Tot:=DiskSize(D);Fr:=DiskFree(D);
             Info(T3('Disk Information','Informations disque',
                 'Datentr'#132'gerinfo'),
              T3('Drive ','Lecteur ','Laufwerk ')+Chr(64+D)+':|'+
              T3('Capacity: ','Capacit'#130' : ',
                  'Kapazit'#132't: ')+NumFmt(Tot)+' '+T3('bytes','octets',
                  'Bytes')+'|'+
              T3('Free: ','Libre : ','Frei: ')+NumFmt(Fr)+' '+T3('bytes',
                  'octets','Bytes'));
            End;
  CM_FORMAT,CM_DCOPY: Info(T3('Not available','Non disponible',
      'Nicht verf'#129'gbar'),
       T3('This operation is not available '+
           'in this clone.|Use the DOS commands '+'FORMAT / DISKCOPY.',
          'Cette op'#130'ration n''est pas disponible '+
              'dans ce clone.|Utilisez les commandes '+'DOS FORMAT / DISKCOPY.',
          'Dieser Vorgang ist in diesem Klon nicht verf'#129+
              'gbar.|Benutzen Sie FORMAT / DISKCOPY unter DOS.'));
 Else CommonCmd(Wd_,Cmd);
 End;
End;

