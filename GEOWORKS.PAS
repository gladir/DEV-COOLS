Function CStr(Var Buf; Off,Len: Integer): String;
Var B: PByteArr; I: Integer; S: String;
Begin
 B:=@Buf;
 S:='';
 I:=0;
 While (I<Len) And (B^[Off+I]<>0) Do Begin
  S:=S+Chr(B^[Off+I]);
  Inc(I);
 End;
 CStr:=S;
End;

