Procedure PlnLoadData(Wd_: PWindow);
 Var Dt_: PPlanner;
Var F: Text; S: String; A: TAppt; Cde,Q: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,JoinPath(HomeDir,'PLANNER.DAT'));
 Reset(F);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 While Not Eof(F) And (Dt_^.NAp<MAXAP) Do Begin
  ReadLn(F,S);
  If Length(S)>=18 Then Begin
   Val(Copy(S,1,4),A.Y,Cde);Val(Copy(S,6,2),A.M,Cde);Val(Copy(S,9,2),A.D,Cde);
   A.Tm:=Copy(S,12,5);A.Rep:=0;A.Alm:=0;
   If S[17]='|' Then Begin
    A.Rep:=StrVal(Copy(S,18,1),0);
    Q:=Pos('|',Copy(S,20,10));
    A.Alm:=StrVal(Copy(S,20,Q-1),0);
    A.Txt:=Copy(S,20+Q,60);
   End Else A.Txt:=Copy(S,18,60);
   Inc(Dt_^.NAp);Dt_^.Ap[Dt_^.NAp]:=A;Dt_^.Fired[Dt_^.NAp]:=0;
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Procedure PlnSaveData(Wd_: PWindow);
 Var Dt_: PPlanner;
Var F: Text; I: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,JoinPath(HomeDir,'PLANNER.DAT'));
 Rewrite(F);
 For I:=1 To Dt_^.NAp Do
  WriteLn(F,IntStr(Dt_^.Ap[I].Y),'-',Pad2(Dt_^.Ap[I].M),'-',Pad2(Dt_^.Ap[I].D),
      ' ',Dt_^.Ap[I].Tm,'|',
          Dt_^.Ap[I].Rep,'|',Dt_^.Ap[I].Alm,'|',Dt_^.Ap[I].Txt);
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Function PlnCanClose(Wd_: PWindow): Boolean;
 Var Dt_: PPlanner;
Begin
 Dt_:=Wd_^.Data;
 PlnSaveData(Wd_);
 PlnCanClose:=True;
End;

{ Numero de jour (comparable) }
Function PlnSerial(Y,M,D: Integer): LongInt;
Begin
 PlnSerial:=LongInt(Y)*400+M*32+D;
End;

{ L'evenement I a-t-il lieu le jour Y/M/D (repetitions incluses) ? }
Function PlnOccurs(Dt_: PPlanner; I,Y,M,D: Integer): Boolean;
Var Ok: Boolean;
Begin
 Ok:=False;
 If (Dt_^.Ap[I].Y=Y) And (Dt_^.Ap[I].M=M) And (Dt_^.Ap[I].D=D) Then Ok:=True
 Else If PlnSerial(Y,M,D)>PlnSerial(Dt_^.Ap[I].Y,Dt_^.Ap[I].M,Dt_^.Ap[I].D) Then
  Case Dt_^.Ap[I].Rep Of
   1: Ok:=True;
   2: Ok:=DayOfWeek(Y,M,D)=DayOfWeek(Dt_^.Ap[I].Y,Dt_^.Ap[I].M,Dt_^.Ap[I].D);
   3: Ok:=(D=Dt_^.Ap[I].D) Or ((Dt_^.Ap[I].D>DaysInMonth(Y,
       M)) And (D=DaysInMonth(Y,M)));
   4: Ok:=(M=Dt_^.Ap[I].M) And (D=Dt_^.Ap[I].D);
  End;
 PlnOccurs:=Ok;
End;

Function PlnCountDay(Wd_: PWindow; Y,M,D: Integer): Integer;
 Var Dt_: PPlanner;
Var I,N: Integer;
Begin
 Dt_:=Wd_^.Data;
 N:=0;
 For I:=1 To Dt_^.NAp Do If PlnOccurs(Dt_,I,Y,M,D) Then Inc(N);
 PlnCountDay:=N;
End;

{ N-ieme evenement du jour, trie par heure }
Function PlnNthOfDay(Wd_: PWindow; Y,M,D,N: Integer): Integer;
 Var Dt_: PPlanner;
Var I,K,J,T: Integer; L: Array[1..MAXAP] Of Integer;
Begin
 Dt_:=Wd_^.Data;
 K:=0;PlnNthOfDay:=0;
 For I:=1 To Dt_^.NAp Do
  If PlnOccurs(Dt_,I,Y,M,D) Then Begin Inc(K);L[K]:=I;End;
 If (N<1) Or (N>K) Then Exit;
 For I:=2 To K Do Begin
  T:=L[I];J:=I-1;
  While (J>=1) And (Dt_^.Ap[L[J]].Tm>Dt_^.Ap[T].Tm) Do Begin L[J+1]:=L[J];
  Dec(J);End;
  L[J+1]:=T;
 End;
 PlnNthOfDay:=L[N];
End;

Procedure PlnDayRect(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PPlanner;
Var CX1,CY1,CX2,CY2: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,CX1,CY1,CX2,CY2);
 X1:=CX1+10+(I Mod 7)*36;Y1:=CY1+64+(I Div 7)*28;X2:=X1+34;Y2:=Y1+26;
End;

Procedure PlnDrawClient(Wd_: PWindow);
 Var Dt_: PPlanner;
Var X1,Y1,X2,Y2,I,N,First,DM,A,B,C,D,K,PX: Integer; S: String;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 S:=MonthName(Dt_^.CM_);S[1]:=UpCase(S[1]);
 S:=S+' '+IntStr(Dt_^.CY);
 Button(X1+10,Y1+8,X1+34,Y1+30,'<',False,False,True);
 Button(X1+10+216,Y1+8,X1+10+250,Y1+30,'>',False,False,True);
 GTextCtr(X1+36,X1+10+214,Y1+15,S,cBlk);
 GTextCtr(X1+37,X1+10+215,Y1+15,S,cBlk);
 For I:=0 To 6 Do GTextCtr(X1+10+I*36,X1+10+I*36+34,Y1+44,
     Copy(DayName((I+1) Mod 7),1,2),cBlk);
 First:=DayOfWeek(Dt_^.CY,Dt_^.CM_,1);
 First:=(First+6) Mod 7;
 DM:=DaysInMonth(Dt_^.CY,Dt_^.CM_);
 For I:=0 To 41 Do Begin
  PlnDayRect(Wd_,I,A,B,C,D);
  N:=I-First+1;
  If (N>=1) And (N<=DM) Then Begin
   If (N=Dt_^.CD) Then Begin Btn3D(A,B,C,D,True);End
   Else Begin GBar(A,B,C,D,cWht);GRect(A,B,C,D,cDGr);End;
   If (Dt_^.CY=Dt_^.TY) And (Dt_^.CM_=Dt_^.TM) And (N=Dt_^.TD) Then Begin
       GRect(A+1,B+1,C-1,D-1,cRed);GRect(A+2,B+2,C-2,D-2,cRed);End;
   GText(A+4,B+4,IntStr(N),cBlk);
   K:=PlnCountDay(Wd_,Dt_^.CY,Dt_^.CM_,N);
   If K>0 Then GBar(A+4,D-6,C-4,D-3,cBlu);
  End Else GBar(A,B,C,D,cLGr);
 End;
 { liste des evenements }
 PX:=X1+280;
 S:=LongDateStr(Dt_^.CY,Dt_^.CM_,Dt_^.CD,DayOfWeek(Dt_^.CY,Dt_^.CM_,Dt_^.CD));
 GText(PX,Y1+10,Copy(S,1,(X2-PX-6) Div 8),cBlk);
 Sunken(PX,Y1+28,X2-8,Y2-44,cWht);
 K:=PlnCountDay(Wd_,Dt_^.CY,Dt_^.CM_,Dt_^.CD);
 For I:=1 To Min2(K,14) Do Begin
  A:=PlnNthOfDay(Wd_,Dt_^.CY,Dt_^.CM_,Dt_^.CD,I);
  If I=Dt_^.SelAp Then GBar(PX+3,Y1+31+(I-1)*14,X2-11,Y1+43+(I-1)*14,cBlk);
  S:=Dt_^.Ap[A].Tm+' ';
  If Dt_^.Ap[A].Alm<>0 Then S:=S+#14 Else S:=S+' ';
  If Dt_^.Ap[A].Rep>0 Then S:=S+'R ' Else S:=S+'  ';
  S:=Copy(S+Dt_^.Ap[A].Txt,1,(X2-PX-24) Div 8);
  If I=Dt_^.SelAp Then GText(PX+6,Y1+34+(I-1)*14,S,cWht)
  Else GText(PX+6,Y1+34+(I-1)*14,S,cBlk);
 End;
 Button(PX,Y2-36,PX+60,Y2-12,T3('New','Nouveau','Neu'),False,False,True);
 Button(PX+66,Y2-36,PX+126,Y2-12,T3('Edit','Modifier','Edit.'),False,False,K>0);
 Button(PX+132,Y2-36,PX+192,Y2-12,T3('Delete','Suppr.','L'#148'sch.'),False,
     False,K>0);
End;

Procedure PlnMoveMonth(Wd_: PWindow; Delta: Integer);
 Var Dt_: PPlanner;
Begin
 Dt_:=Wd_^.Data;
 Dt_^.CM_:=Dt_^.CM_+Delta;
 While Dt_^.CM_>12 Do Begin Dt_^.CM_:=Dt_^.CM_-12;Inc(Dt_^.CY);End;
 While Dt_^.CM_<1 Do Begin Dt_^.CM_:=Dt_^.CM_+12;Dec(Dt_^.CY);End;
 If Dt_^.CD>DaysInMonth(Dt_^.CY,Dt_^.CM_) Then Dt_^.CD:=DaysInMonth(Dt_^.CY,
     Dt_^.CM_);
 Dt_^.SelAp:=0;
End;

Function PlnAlmVal(R: Integer): Integer;
Begin
 Case R Of
  2: PlnAlmVal:=-1;
  3: PlnAlmVal:=5;
  4: PlnAlmVal:=15;
  5: PlnAlmVal:=30;
  6: PlnAlmVal:=60;
 Else PlnAlmVal:=0;
 End;
End;

Function PlnAlmIdx(V: Integer): Integer;
Begin
 Case V Of
  -1: PlnAlmIdx:=2;
  5: PlnAlmIdx:=3;
  15: PlnAlmIdx:=4;
  30: PlnAlmIdx:=5;
  60: PlnAlmIdx:=6;
 Else PlnAlmIdx:=1;
 End;
End;

{ Dialogue d'evenement : heure, description, repetition, alarme }
Function PlnEventDlg(Var A: TAppt; Const Title: String): Boolean;
 Var T,S: String; R: Integer; V,K: LongInt;
Begin
 PlnEventDlg:=False;
 T:=A.Tm;
 If Not InputBox(Title,T3('Time (HH:MM):','Heure (HH:MM) :','Zeit (HH:MM):'),T,
     5) Then Exit;
 V:=StrVal(Copy(T,1,2),-1);K:=StrVal(Copy(T,4,2),-1);
 If (Length(T)<>5) Or (T[3]<>':') Or (V<0) Or (V>23) Or (K<0) Or (K>59) Then
     Begin
  Info(Title,T3('Invalid time. Use HH:MM.','Heure invalide. Utilisez HH:MM.',
      'Ung'#129'ltige Zeit. HH:MM verwenden.'));Exit;
 End;
 S:=A.Txt;
 If Not InputBox(Title,T3('Description:','Description :','Beschreibung:'),S,
     58) Then Exit;
 R:=ChoiceBox(Title,T3('Repeat:','R'#130'p'#130'ter :','Wiederholen:'),
    T3('Never|Daily|Weekly|Monthly|Yearly',
        'Jamais|Chaque jour|Chaque semaine|Chaque mois|Chaque ann'#130'e',
       'Nie|T'#132'glich|W'#148'chentlich|Monatlich|J'#132'hrlich'),A.Rep+1);
 If R=0 Then Exit;
 A.Rep:=R-1;
 R:=ChoiceBox(Title,T3('Alarm:','Alarme :','Alarm:'),
    T3('None|At event time|5 minutes '+'before|15 minutes before|30 minutes '+
        'before|1 hour before',
       'Aucune|'#133' l''heure|5 minutes avant|15 '+
           'minutes avant|30 minutes avant|1 '+'heure avant',
       'Keiner|Zur Terminzeit|5 Minuten '+
           'vorher|15 Minuten vorher|30 Minuten '+'vorher|1 Stunde vorher'),
    PlnAlmIdx(A.Alm));
 If R=0 Then Exit;
 A.Alm:=PlnAlmVal(R);
 A.Tm:=T;A.Txt:=S;
 PlnEventDlg:=True;
End;

Procedure PlnAddAp(Wd_: PWindow);
 Var Dt_: PPlanner;
Var A: TAppt;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NAp>=MAXAP Then Exit;
 FillChar(A,SizeOf(A),0);
 A.Y:=Dt_^.CY;A.M:=Dt_^.CM_;A.D:=Dt_^.CD;A.Tm:='09:00';
 If Not PlnEventDlg(A,T3('New Event','Nouvel '#130'v'#130'nement',
     'Neuer Termin')) Then Exit;
 Inc(Dt_^.NAp);Dt_^.Ap[Dt_^.NAp]:=A;Dt_^.Fired[Dt_^.NAp]:=0;
 PlnSaveData(Wd_);
 Invalidate(Wd_);
End;

Procedure PlnEditAp(Wd_: PWindow);
 Var Dt_: PPlanner;
Var I: Integer; A: TAppt;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.SelAp=0 Then Exit;
 I:=PlnNthOfDay(Wd_,Dt_^.CY,Dt_^.CM_,Dt_^.CD,Dt_^.SelAp);
 If I=0 Then Exit;
 A:=Dt_^.Ap[I];
 If PlnEventDlg(A,T3('Edit Event','Modifier','Termin '#132'ndern')) Then Begin
  Dt_^.Ap[I]:=A;Dt_^.Fired[I]:=0;PlnSaveData(Wd_);
 End;
 Invalidate(Wd_);
End;

Procedure PlnDelAp(Wd_: PWindow);
 Var Dt_: PPlanner;
Var I,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.SelAp=0 Then Exit;
 I:=PlnNthOfDay(Wd_,Dt_^.CY,Dt_^.CM_,Dt_^.CD,Dt_^.SelAp);
 If I=0 Then Exit;
 For K:=I To Dt_^.NAp-1 Do Begin Dt_^.Ap[K]:=Dt_^.Ap[K+1];
 Dt_^.Fired[K]:=Dt_^.Fired[K+1];End;
 Dec(Dt_^.NAp);Dt_^.SelAp:=0;PlnSaveData(Wd_);
 Invalidate(Wd_);
End;

Procedure PlnOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PPlanner;
Var X1,Y1,X2,Y2,I,A,B,C,D,First,N,PX,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 If E.Kind<>EV_DOWN Then Exit;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 If InBox(E.X,E.Y,X1+10,Y1+8,X1+34,Y1+30) Then Begin PlnMoveMonth(Wd_,-1);
 Invalidate(Wd_);Exit;End;
 If InBox(E.X,E.Y,X1+226,Y1+8,X1+260,Y1+30) Then Begin PlnMoveMonth(Wd_,1);
 Invalidate(Wd_);Exit;End;
 First:=(DayOfWeek(Dt_^.CY,Dt_^.CM_,1)+6) Mod 7;
 For I:=0 To 41 Do Begin
  PlnDayRect(Wd_,I,A,B,C,D);
  N:=I-First+1;
  If (N>=1) And (N<=DaysInMonth(Dt_^.CY,Dt_^.CM_)) And InBox(E.X,E.Y,A,B,C,
      D) Then Begin
   Dt_^.CD:=N;Dt_^.SelAp:=0;Invalidate(Wd_);
   If E.Dbl Then PlnAddAp(Wd_);
   Exit;
  End;
 End;
 PX:=X1+280;
 K:=PlnCountDay(Wd_,Dt_^.CY,Dt_^.CM_,Dt_^.CD);
 If InBox(E.X,E.Y,PX,Y2-36,PX+60,Y2-12) Then PlnAddAp(Wd_)
 Else If InBox(E.X,E.Y,PX+66,Y2-36,PX+126,Y2-12) Then PlnEditAp(Wd_)
 Else If InBox(E.X,E.Y,PX+132,Y2-36,PX+192,Y2-12) Then PlnDelAp(Wd_)
 Else If InBox(E.X,E.Y,PX,Y1+28,X2-8,Y2-44) Then Begin
  I:=(E.Y-Y1-31) Div 14+1;
  If (I>=1) And (I<=K) Then Begin Dt_^.SelAp:=I;Invalidate(Wd_);
  If E.Dbl Then PlnEditAp(Wd_);End;
 End;
End;

Procedure PlnOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PPlanner;
Begin
 Dt_:=Wd_^.Data;
 Case K Of
  K_LEFT: If Dt_^.CD>1 Then Dec(Dt_^.CD);
  K_RIGHT: If Dt_^.CD<DaysInMonth(Dt_^.CY,Dt_^.CM_) Then Inc(Dt_^.CD);
  K_UP: If Dt_^.CD>7 Then Dec(Dt_^.CD,7);
  K_DOWN: If Dt_^.CD+7<=DaysInMonth(Dt_^.CY,Dt_^.CM_) Then Inc(Dt_^.CD,7);
  K_PGUP: PlnMoveMonth(Wd_,-1);
  K_PGDN: PlnMoveMonth(Wd_,1);
  K_ENTER: PlnAddAp(Wd_);
  K_DEL: PlnDelAp(Wd_);
 End;
 Dt_^.SelAp:=0;
 Invalidate(Wd_);
End;

Procedure PlnOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PPlanner;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_PTODAY: Begin Dt_^.CY:=Dt_^.TY;Dt_^.CM_:=Dt_^.TM;Dt_^.CD:=Dt_^.TD;
  Dt_^.SelAp:=0;End;
  CM_PNEXT: PlnMoveMonth(Wd_,1);
  CM_PPREV: PlnMoveMonth(Wd_,-1);
  CM_PNEXTY: PlnMoveMonth(Wd_,12);
  CM_PPREVY: PlnMoveMonth(Wd_,-12);
  CM_PNEWAP: PlnAddAp(Wd_);
  CM_PEDIT: PlnEditAp(Wd_);
  CM_PDEL: PlnDelAp(Wd_);
  CM_PSAVE: PlnSaveData(Wd_);
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

{ Alarmes : verifie les evenements du jour environ chaque seconde }
Function PlnIdle(Wd_: PWindow): Boolean;
 Var Dt_: PPlanner;
Var I,Now,Ev,Al: Integer; H,M,S,C,Y,Mo,D,W: Word; Today: LongInt; Msg: String;
Begin
 Dt_:=Wd_^.Data;
 PlnIdle:=False;
 Inc(Dt_^.IdleN);
 If Dt_^.IdleN<10 Then Exit;
 Dt_^.IdleN:=0;
 GetTime(H,M,S,C);GetDate(Y,Mo,D,W);
 Now:=H*60+M;Today:=PlnSerial(Y,Mo,D);
 For I:=1 To Dt_^.NAp Do
  If (Dt_^.Ap[I].Alm<>0) And (Dt_^.Fired[I]<>Today) And PlnOccurs(Dt_,I,Y,Mo,
      D) Then Begin
   Ev:=StrVal(Copy(Dt_^.Ap[I].Tm,1,2),0)*60+StrVal(Copy(Dt_^.Ap[I].Tm,4,2),0);
   If Dt_^.Ap[I].Alm<0 Then Al:=0 Else Al:=Dt_^.Ap[I].Alm;
   If (Now>=Ev-Al) And (Now<=Ev+5) Then Begin
    Dt_^.Fired[I]:=Today;
    Msg:=Dt_^.Ap[I].Tm+'  '+Dt_^.Ap[I].Txt;
    Info(T3('GeoPlanner alarm','Alarme GeoPlanner','GeoPlanner-Alarm'),Msg);
    PlnIdle:=True;
   End;
  End;
End;

{ ---------------------------------------------------------------------- }
{ GeoDex : carnet d'adresses                                               }
{ ---------------------------------------------------------------------- }

Const
 CM_DNEW=620; CM_DDEL=621; CM_DNEXT=622; CM_DPREV=623; CM_DFIND=624;
 CM_DSAVE=625;
 CM_DFNEXT=626; CM_DDIAL=627; CM_DQUICK=628; CM_DFOPT=629;
 MAXCARD = 300;

Type
 TCard = Record
  F : Array[1..5] Of String[50];     { nom, adresse, ville, telephone, notes }
 End;

 PDex = ^TDex;
 TDex = Record
  C     : Array[1..MAXCARD] Of TCard;
  NC    : Integer;
  Cur   : Integer;
  Fld   : Integer;
  LastFind : String[40];
  FindFld  : Integer;      { 0 tous les champs, 1..5 un champ }
  FindCase : Boolean;
 End;

Function DexNew(AX,AY: Integer): PWindow; Forward;
Procedure DexLoadData(Wd_: PWindow); Forward;
Procedure DexSaveData(Wd_: PWindow); Forward;
Function DexCanClose(Wd_: PWindow): Boolean; Forward;
Procedure DexSortCards(Wd_: PWindow); Forward;
Procedure DexNewCard(Wd_: PWindow); Forward;
Procedure DexDelCard(Wd_: PWindow); Forward;
Procedure DexFindCard(Wd_: PWindow); Forward;
Procedure DexFieldRect(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
Forward;
Procedure DexDrawClient(Wd_: PWindow); Forward;
Procedure DexOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure DexOnKey(Wd_: PWindow; K: Word); Forward;
Procedure DexOnCommand(Wd_: PWindow; Cmd: Integer); Forward;

Function DexNew(AX,AY: Integer): PWindow;
 Var Wd_: PWindow; Dt_: PDex;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_DEX,AX,AY,470,330,'GeoDex');
 Wd_^.IconId:=IC_DEX;Wd_^.MinW:=470;Wd_^.MinH:=330;
 Dt_^.NC:=0;Dt_^.Cur:=1;Dt_^.Fld:=1;
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'Save~Enregistrer~Speichern',CM_DSAVE,'');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Card~Fiche~Karte');
 WinAddItem(Wd_,'New~Nouvelle~Neu',CM_DNEW,'Ctrl+N');
 WinAddItem(Wd_,'Delete~Supprimer~L'#148'schen',CM_DDEL,'');
 WinAddItem(Wd_,'Next~Suivante~N'#132'chste',CM_DNEXT,'PgDn');
 WinAddItem(Wd_,'Previous~Pr'#130'c'#130'dente~Vorherige',CM_DPREV,'PgUp');
 WinAddItem(Wd_,'Find...~Rechercher...~Suchen...',CM_DFIND,'Ctrl+F');
 WinAddItem(Wd_,'Find Next~Suivant~Weitersuchen',CM_DFNEXT,'F3');
 WinAddItem(Wd_,'Search Options...~Options de recherche...~Suchoptionen...',
     CM_DFOPT,'');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Dial Phone...~Composer le num'#130'ro...~Rufnummer w'#132+
     'hlen...',CM_DDIAL,'');
 WinAddItem(Wd_,'Quick Dial...~Num'#130'rotation rapide...~Kurzwahl...',
     CM_DQUICK,'');
 WinAddMenu(Wd_,'Window~Fen'#136'tre~Fenster');
 WinAddItem(Wd_,'Tile~Mosa'#139'que~Kacheln',CM_TILE,'');
 WinAddItem(Wd_,'Overlap~Cascade~'#154'berlappend',CM_OVERLAP,'');
 DexLoadData(Wd_);
 If Dt_^.NC=0 Then Begin
  Dt_^.NC:=1;
  FillChar(Dt_^.C[1],SizeOf(TCard),0);
  Dt_^.C[1].F[1]:='GeoWorks';Dt_^.C[1].F[2]:='2150 Shattuck Avenue';
  Dt_^.C[1].F[3]:='Berkeley, CA 94704';
  Dt_^.C[1].F[4]:='(415) 644-0883';Dt_^.C[1].F[5]:='GeoWorks Ensemble';
 End;
 DexNew:=Wd_;
End;

Procedure DexLoadData(Wd_: PWindow);
 Var Dt_: PDex;
Var F: Text; S: String; I,P: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,JoinPath(HomeDir,'GEODEX.DAT'));
 Reset(F);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 While Not Eof(F) And (Dt_^.NC<MAXCARD) Do Begin
  ReadLn(F,S);
  If S<>'' Then Begin
   Inc(Dt_^.NC);FillChar(Dt_^.C[Dt_^.NC],SizeOf(TCard),0);
   For I:=1 To 5 Do Begin
    P:=Pos(#9,S);
    If P=0 Then Begin Dt_^.C[Dt_^.NC].F[I]:=Copy(S,1,50);S:='';End
    Else Begin Dt_^.C[Dt_^.NC].F[I]:=Copy(S,1,P-1);Delete(S,1,P);End;
   End;
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Procedure DexSaveData(Wd_: PWindow);
 Var Dt_: PDex;
Var F: Text; I,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,JoinPath(HomeDir,'GEODEX.DAT'));
 Rewrite(F);
 For I:=1 To Dt_^.NC Do Begin
  For K:=1 To 5 Do Begin
   Write(F,Dt_^.C[I].F[K]);
   If K<5 Then Write(F,#9);
  End;
  WriteLn(F);
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Function DexCanClose(Wd_: PWindow): Boolean;
 Var Dt_: PDex;
Begin
 Dt_:=Wd_^.Data;
 DexSaveData(Wd_);DexCanClose:=True;
End;

Procedure DexSortCards(Wd_: PWindow);
 Var Dt_: PDex;
Var I,J: Integer; T: TCard; Cd: TCard;
Begin
 Dt_:=Wd_^.Data;
 Cd:=Dt_^.C[Dt_^.Cur];
 For I:=1 To Dt_^.NC-1 Do
  For J:=I+1 To Dt_^.NC Do
   If Upper(Dt_^.C[J].F[1])<Upper(Dt_^.C[I].F[1]) Then Begin T:=Dt_^.C[I];
   Dt_^.C[I]:=Dt_^.C[J];Dt_^.C[J]:=T;End;
 For I:=1 To Dt_^.NC Do If (Dt_^.C[I].F[1]=Cd.F[1]) And (Dt_^.C[I].F[4]=Cd.F[4])
     Then Dt_^.Cur:=I;
End;

Procedure DexNewCard(Wd_: PWindow);
 Var Dt_: PDex;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NC>=MAXCARD Then Exit;
 DexSortCards(Wd_);
 Inc(Dt_^.NC);FillChar(Dt_^.C[Dt_^.NC],SizeOf(TCard),0);
 Dt_^.Cur:=Dt_^.NC;Dt_^.Fld:=1;
 Invalidate(Wd_);
End;

Procedure DexDelCard(Wd_: PWindow);
 Var Dt_: PDex;
Var I: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NC<=1 Then Begin FillChar(Dt_^.C[1],SizeOf(TCard),0);Exit;End;
 If Not Confirm('GeoDex',T3('Delete this card?','Supprimer cette fiche ?',
     'Diese Karte l'#148'schen?')) Then Exit;
 For I:=Dt_^.Cur To Dt_^.NC-1 Do Dt_^.C[I]:=Dt_^.C[I+1];
 Dec(Dt_^.NC);
 If Dt_^.Cur>Dt_^.NC Then Dt_^.Cur:=Dt_^.NC;
 Invalidate(Wd_);
End;

{ Recherche a partir de la fiche suivante (Again) ou apres saisie }
Procedure DexFindNext(Wd_: PWindow; Start: Integer);
 Var Dt_: PDex;
Var S,V: String; I,K,N,K1,K2: Integer; Fnd: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.LastFind='' Then Exit;
 S:=Dt_^.LastFind;
 If Not Dt_^.FindCase Then S:=Upper(S);
 If Dt_^.FindFld=0 Then Begin K1:=1;K2:=5;End Else Begin K1:=Dt_^.FindFld;
 K2:=K1;End;
 For N:=0 To Dt_^.NC-1 Do Begin
  I:=((Start-1+N) Mod Dt_^.NC)+1;
  Fnd:=False;
  For K:=K1 To K2 Do Begin
   V:=Dt_^.C[I].F[K];
   If Not Dt_^.FindCase Then V:=Upper(V);
   If Pos(S,V)>0 Then Fnd:=True;
  End;
  If Fnd Then Begin Dt_^.Cur:=I;Invalidate(Wd_);Exit;End;
 End;
 Info(T3('Find','Rechercher','Suchen'),T3('Not found.','Introuvable.',
     'Nicht gefunden.'));
End;

Procedure DexFindCard(Wd_: PWindow);
 Var Dt_: PDex;
Var S: String;
Begin
 Dt_:=Wd_^.Data;
 S:=Dt_^.LastFind;
 If Not InputBox(T3('Find','Rechercher','Suchen'),T3('Find what:',
     'Rechercher :','Suchen nach:'),S,40) Then Exit;
 Dt_^.LastFind:=S;
 DexFindNext(Wd_,Dt_^.Cur);
End;

