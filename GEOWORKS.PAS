Procedure PrefDateTime;
Var S: String; Y,M,D,W,H,Mi,Sc,C: Word; V1,V2,V3: LongInt; R: Integer;
Begin
 GetDate(Y,M,D,W);GetTime(H,Mi,Sc,C);
 R:=ChoiceBox(T3('Date & Time','Date et heure','Datum & Zeit'),LongDateStr(Y,M,
     D,W)+'  '+TimeStr(H,Mi),
    T3('Set date...|Set time...|Close',
        'R'#130'gler la date...|R'#130'gler l''heure...|Fermer',
        'Datum einstellen...|Zeit einstellen...|Schlie'#225'en'),3);
 If R=1 Then Begin
  S:=IntStr(Y)+'-'+Pad2(M)+'-'+Pad2(D);
  If InputBox(T3('Date','Date','Datum'),'YYYY-MM-DD',S,
      10) And (Length(S)=10) Then Begin
   V1:=StrVal(Copy(S,1,4),Y);V2:=StrVal(Copy(S,6,2),M);
   V3:=StrVal(Copy(S,9,2),D);
   If (V2>=1) And (V2<=12) And (V3>=1) And (V3<=DaysInMonth(V1,
       V2)) Then SetDate(V1,V2,V3)
   Else Info(T3('Date','Date','Datum'),T3('Invalid date.','Date invalide.',
       'Ung'#129'ltiges Datum.'));
  End;
 End Else If R=2 Then Begin
  S:=Pad2(H)+':'+Pad2(Mi);
  If InputBox(T3('Time','Heure','Zeit'),'HH:MM',S,
      5) And (Length(S)=5) Then Begin
   V1:=StrVal(Copy(S,1,2),H);V2:=StrVal(Copy(S,4,2),Mi);
   If (V1>=0) And (V1<24) And (V2>=0) And (V2<60) Then SetTime(V1,V2,0,0)
   Else Info(T3('Time','Heure','Zeit'),T3('Invalid time.','Heure invalide.',
       'Ung'#129'ltige Zeit.'));
  End;
 End;
End;



