Procedure DrwToolRect(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PDraw;
Var CX1,CY1,CX2,CY2: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,CX1,CY1,CX2,CY2);
 X1:=CX1+4+(I Mod 2)*28;Y1:=CY1+4+(I Div 2)*28;X2:=X1+26;Y2:=Y1+26;
End;

Procedure DrwBounds(Wd_: PWindow; Var Ob: TObj; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PDraw;
Var I: Integer;
Begin
 Dt_:=Wd_^.Data;
 X1:=Min2(Ob.X1,Ob.X2);Y1:=Min2(Ob.Y1,Ob.Y2);X2:=Max2(Ob.X1,Ob.X2);
 Y2:=Max2(Ob.Y1,Ob.Y2);
 If Ob.K=4 Then Begin
  X1:=32000;Y1:=32000;X2:=-32000;Y2:=-32000;
  For I:=Ob.P0 To Ob.P0+Ob.PN-1 Do Begin
   If Dt_^.Pts[I].X<X1 Then X1:=Dt_^.Pts[I].X;
   If Dt_^.Pts[I].X>X2 Then X2:=Dt_^.Pts[I].X;
   If Dt_^.Pts[I].Y<Y1 Then Y1:=Dt_^.Pts[I].Y;
   If Dt_^.Pts[I].Y>Y2 Then Y2:=Dt_^.Pts[I].Y;
  End;
 End Else If Ob.K=5 Then Begin X2:=X1+Length(Ob.Txt)*8;Y2:=Y1+8;End
 Else If Ob.K=6 Then Begin X2:=X1+IconWd[Ob.Ic]-1;Y2:=Y1+IconHt[Ob.Ic]-1;End;
End;

Procedure DrwDrawObj(Wd_: PWindow; Var Ob: TObj; Shift: Integer);
 Var Dt_: PDraw;
Var I,A,B,C,D,T: Integer;
Begin
 Dt_:=Wd_^.Data;
 T:=Ob.Wd;
 Case Ob.K Of
  1: GThickLine(Ob.X1,Ob.Y1,Ob.X2,Ob.Y2,Ob.Col,T);
  2: Begin
      A:=Min2(Ob.X1,Ob.X2);B:=Min2(Ob.Y1,Ob.Y2);C:=Max2(Ob.X1,Ob.X2);
      D:=Max2(Ob.Y1,Ob.Y2);
      If Ob.Fill>=0 Then GBar(A,B,C,D,Ob.Fill);
      GRect(A,B,C,D,Ob.Col);
      If T>1 Then GRect(A+1,B+1,C-1,D-1,Ob.Col);
      If T>2 Then GRect(A+2,B+2,C-2,D-2,Ob.Col);
     End;
  3: Begin
      A:=(Ob.X1+Ob.X2) Div 2;B:=(Ob.Y1+Ob.Y2) Div 2;
      C:=Abs(Ob.X2-Ob.X1) Div 2;D:=Abs(Ob.Y2-Ob.Y1) Div 2;
      If Ob.Fill>=0 Then GFillEllipse(A,B,C,D,Ob.Fill);
      GEllipse(A,B,C,D,Ob.Col);
      If T>1 Then GEllipse(A,B,C+1,D+1,Ob.Col);
     End;
  4: For I:=Ob.P0 To Ob.P0+Ob.PN-2 Do GThickLine(Dt_^.Pts[I].X,Dt_^.Pts[I].Y,
      Dt_^.Pts[I+1].X,Dt_^.Pts[I+1].Y,Ob.Col,T);
  5: GText(Ob.X1,Ob.Y1,Ob.Txt,Ob.Col);
  6: DrawIcon(Ob.Ic,Ob.X1,Ob.Y1,False);
 End;
End;

Procedure DrwDrawClient(Wd_: PWindow);
 Var Dt_: PDraw;
Var X1,Y1,X2,Y2,I,A,B,C,D,SC1,SC2,SC3,SC4: Integer; OX1,OY1,OX2,OY2: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 { boite a outils }
 For I:=0 To 7 Do Begin
  DrwToolRect(Wd_,I,A,B,C,D);
  Btn3D(A,B,C,D,Dt_^.Tool=I);
  Case I Of
   0: Begin GArrow(A+13,B+13,1,cBlk);GLine(A+9,B+9,A+17,B+19,cBlk);End;
   1: GTextBig(A+7,B+5,'T',2,cBlk);
   2: GLine(A+5,B+20,A+21,B+6,cBlk);
   3: GRect(A+5,B+7,A+21,B+19,cBlk);
   4: GEllipse(A+13,B+13,8,6,cBlk);
   5: Begin GLine(A+5,B+18,A+9,B+8,cBlk);GLine(A+9,B+8,A+14,B+19,cBlk);
   GLine(A+14,B+19,A+21,B+9,cBlk);End;
   6: Begin GBar(A+6,B+10,A+20,B+18,cLRd);GRect(A+6,B+10,A+20,B+18,cBlk);End;
   7: Begin GBar(A+6,B+6,A+20,B+20,cLCy);GRect(A+6,B+6,A+20,B+20,cBlk);
   GBar(A+10,B+10,A+16,B+16,cYel);End;
  End;
 End;
 { couleurs courantes }
 GBar(X1+6,Y1+4+4*28+4,X1+30,Y1+4+4*28+22,Dt_^.Col);
 GRect(X1+6,Y1+4+4*28+4,X1+30,Y1+4+4*28+22,cBlk);
 If Dt_^.Fill>=0 Then GBar(X1+26,Y1+4+4*28+14,X1+50,Y1+4+4*28+32,Dt_^.Fill)
 Else GDither(X1+26,Y1+4+4*28+14,X1+50,Y1+4+4*28+32,cLGr,cWht);
 GRect(X1+26,Y1+4+4*28+14,X1+50,Y1+4+4*28+32,cBlk);
 { page }
 DrwCanvas(Wd_,A,B,C,D);
 Sunken(A-2,B-2,C+2,D+2,cWht);
 { palette }
 For I:=0 To 15 Do Begin
  GBar(X1+66+I*22,Y2-26,X1+66+I*22+19,Y2-8,I);
  GRect(X1+66+I*22,Y2-26,X1+66+I*22+19,Y2-8,cBlk);
 End;
 GRect(X1+66+16*22,Y2-26,X1+66+16*22+19,Y2-8,cBlk);
 GLine(X1+66+16*22,Y2-26,X1+66+16*22+19,Y2-8,cLRd);
 GLine(X1+66+16*22,Y2-8,X1+66+16*22+19,Y2-26,cLRd);
 { objets }
 OX1:=CX1;OY1:=CY1;OX2:=CX2;OY2:=CY2;
 SC1:=Max2(OX1,A);SC2:=Max2(OY1,B);SC3:=Min2(OX2,C);SC4:=Min2(OY2,D);
 If (SC3>=SC1) And (SC4>=SC2) Then Begin
  SetClip(SC1,SC2,SC3,SC4);
  For I:=1 To Dt_^.NO Do DrwDrawObj(Wd_,Dt_^.O[I],0);
  If (Dt_^.Sel>0) And (Dt_^.Sel<=Dt_^.NO) Then Begin
   DrwBounds(Wd_,Dt_^.O[Dt_^.Sel],A,B,C,D);
   GDotRect(A-2,B-2,C+2,D+2,cBlk);
   GBar(A-4,B-4,A-1,B-1,cBlk);GBar(C+1,B-4,C+4,B-1,cBlk);
   GBar(A-4,D+1,A-1,D+4,cBlk);GBar(C+1,D+1,C+4,D+4,cBlk);
  End;
  SetClip(OX1,OY1,OX2,OY2);
 End;
End;

Function DrwObjAt(Wd_: PWindow; PX,PY: Integer): Integer;
 Var Dt_: PDraw;
Var I,A,B,C,D,J: Integer; Hit: Boolean; DX,DY,L: Real;
Begin
 Dt_:=Wd_^.Data;
 DrwObjAt:=0;
 For I:=Dt_^.NO DownTo 1 Do Begin
  DrwBounds(Wd_,Dt_^.O[I],A,B,C,D);
  Hit:=False;
  If Dt_^.O[I].K=1 Then Begin
   If InBox(PX,PY,A-4,B-4,C+4,D+4) Then Begin
    DX:=Dt_^.O[I].X2-Dt_^.O[I].X1;DY:=Dt_^.O[I].Y2-Dt_^.O[I].Y1;
    L:=Sqrt(DX*DX+DY*DY);
    If L<1 Then Hit:=True
    Else Hit:=Abs(DX*(Dt_^.O[I].Y1-PY)-(Dt_^.O[I].X1-PX)*DY)/L<=4;
   End;
  End Else If Dt_^.O[I].K=4 Then Begin
   For J:=Dt_^.O[I].P0 To Dt_^.O[I].P0+Dt_^.O[I].PN-1 Do
    If (Abs(Dt_^.Pts[J].X-PX)<=4) And (Abs(Dt_^.Pts[J].Y-PY)<=4) Then Hit:=True;
  End Else If (Dt_^.O[I].K=2) Or (Dt_^.O[I].K=3) Then Begin
   If (Dt_^.O[I].Fill>=0) Then Hit:=InBox(PX,PY,A,B,C,D)
   Else Hit:=InBox(PX,PY,A-3,B-3,C+3,D+3) And Not InBox(PX,PY,A+4,B+4,C-4,D-4);
  End Else Hit:=InBox(PX,PY,A-2,B-2,C+2,D+2);
  If Hit Then Begin DrwObjAt:=I;Exit;End;
 End;
End;

Procedure DrwAddObj(Wd_: PWindow; Var Ob: TObj);
 Var Dt_: PDraw;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NO>=MAXOBJ Then Exit;
 Inc(Dt_^.NO);Dt_^.O[Dt_^.NO]:=Ob;Dt_^.Sel:=Dt_^.NO;Dt_^.Modified:=True;
 DrwUpdateTitle(Wd_);
End;

Procedure DrwDelObj(Wd_: PWindow; I: Integer);
 Var Dt_: PDraw;
Var K: Integer;
Begin
 Dt_:=Wd_^.Data;
 If (I<1) Or (I>Dt_^.NO) Then Exit;
 For K:=I To Dt_^.NO-1 Do Dt_^.O[K]:=Dt_^.O[K+1];
 Dec(Dt_^.NO);Dt_^.Sel:=0;Dt_^.Modified:=True;DrwUpdateTitle(Wd_);
End;

Procedure DrwMoveObj(Wd_: PWindow; I,DX,DY: Integer);
 Var Dt_: PDraw;
Var K: Integer;
Begin
 Dt_:=Wd_^.Data;
 Dt_^.O[I].X1:=Dt_^.O[I].X1+DX;Dt_^.O[I].X2:=Dt_^.O[I].X2+DX;
 Dt_^.O[I].Y1:=Dt_^.O[I].Y1+DY;Dt_^.O[I].Y2:=Dt_^.O[I].Y2+DY;
 If Dt_^.O[I].K=4 Then For K:=Dt_^.O[I].P0 To Dt_^.O[I].P0+Dt_^.O[I].PN-1 Do
     Begin
  Dt_^.Pts[K].X:=Dt_^.Pts[K].X+DX;Dt_^.Pts[K].Y:=Dt_^.Pts[K].Y+DY;
 End;
End;

Procedure DrwRubber(Wd_: PWindow);
 Var Dt_: PDraw;
Var A,B,C,D: Integer;
Begin
 Dt_:=Wd_^.Data;
 ClipFull;
 SetWriteMode(XORPut);
 SetColor(15);
 SetLineStyle(SolidLn,0,NormWidth);
 Case Dt_^.Tool Of
  TL_LINE: Line(Dt_^.RbX,Dt_^.RbY,Dt_^.CXp,Dt_^.CYp);
  TL_RECT: Rectangle(Min2(Dt_^.RbX,Dt_^.CXp),Min2(Dt_^.RbY,Dt_^.CYp),
      Max2(Dt_^.RbX,Dt_^.CXp),Max2(Dt_^.RbY,Dt_^.CYp));
  TL_ELL: Ellipse((Dt_^.RbX+Dt_^.CXp) Div 2,(Dt_^.RbY+Dt_^.CYp) Div 2,0,360,
      Abs(Dt_^.CXp-Dt_^.RbX) Div 2,Abs(Dt_^.CYp-Dt_^.RbY) Div 2);
 End;
 SetWriteMode(NormalPut);
End;

Procedure DrwOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PDraw;
Var X1,Y1,X2,Y2,I,A,B,C,D,Px,Py: Integer; Ob: TObj; S: String;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 DrwCanvas(Wd_,A,B,C,D);
 If (E.Kind=EV_DOWN) Or (E.Kind=EV_RDOWN) Then Begin
  { boite a outils }
  For I:=0 To 7 Do Begin
   DrwToolRect(Wd_,I,Px,Py,Px,Py);
  End;
  For I:=0 To 7 Do Begin
   DrwToolRect(Wd_,I,A,B,C,D);
   If InBox(E.X,E.Y,A,B,C,D) Then Begin Dt_^.Tool:=I;Invalidate(Wd_);Exit;End;
  End;
  DrwCanvas(Wd_,A,B,C,D);
  { palette }
  If E.Y>=Y2-26 Then Begin
   For I:=0 To 16 Do
    If InBox(E.X,E.Y,X1+66+I*22,Y2-26,X1+66+I*22+19,Y2-8) Then Begin
     If E.Kind=EV_DOWN Then Begin
      If I<16 Then Begin
       Dt_^.Col:=I;
       If (Dt_^.Sel>0) And (Dt_^.Sel<=Dt_^.NO) Then Begin
           Dt_^.O[Dt_^.Sel].Col:=I;Dt_^.Modified:=True;End;
      End Else Dt_^.Fill:=-1;
     End Else Begin
      If I<16 Then Begin
       Dt_^.Fill:=I;
       If (Dt_^.Sel>0) And (Dt_^.Sel<=Dt_^.NO) Then Begin
           Dt_^.O[Dt_^.Sel].Fill:=I;Dt_^.Modified:=True;End;
      End Else Dt_^.Fill:=-1;
     End;
     Invalidate(Wd_);
    End;
   Exit;
  End;
  If Not InBox(E.X,E.Y,A,B,C,D) Then Exit;
  If E.Kind=EV_RDOWN Then Exit;
  Dt_^.Mode:=0;Dt_^.RbX:=E.X;Dt_^.RbY:=E.Y;Dt_^.CXp:=E.X;Dt_^.CYp:=E.Y;
  Dt_^.LastX:=E.X;Dt_^.LastY:=E.Y;
  Case Dt_^.Tool Of
   TL_SEL: Begin
            Dt_^.Sel:=DrwObjAt(Wd_,E.X,E.Y);
            If Dt_^.Sel>0 Then Dt_^.Mode:=2;
            Invalidate(Wd_);
           End;
   TL_ERASE: Begin
              I:=DrwObjAt(Wd_,E.X,E.Y);
              If I>0 Then Begin DrwDelObj(Wd_,I);Invalidate(Wd_);End;
             End;
   TL_TEXT: Begin
             S:='';
             If InputBox('GeoDraw',T3('Text:','Texte :','Text:'),S,
                 40) And (S<>'') Then Begin
              FillChar(Ob,SizeOf(Ob),0);
              Ob.K:=5;Ob.X1:=E.X;Ob.Y1:=E.Y;Ob.Col:=Dt_^.Col;Ob.Txt:=S;
              DrwAddObj(Wd_,Ob);
              Invalidate(Wd_);
             End;
            End;
   TL_ICON: Begin
             If ClipIconId>=0 Then Begin
              FillChar(Ob,SizeOf(Ob),0);
              Ob.K:=6;Ob.X1:=E.X;Ob.Y1:=E.Y;Ob.Ic:=ClipIconId;
              DrwAddObj(Wd_,Ob);Invalidate(Wd_);
             End Else Info('GeoDraw',T3('Copy an image in the Scrapbook first.',
                 'Copiez d''abord une image dans le Scrapbook.',
                 'Kopieren Sie zuerst ein Bild im Scrapbook.'));
            End;
   TL_LINE,TL_RECT,TL_ELL: Begin
            Dt_^.Mode:=1;HideMouse;DrwRubber(Wd_);ShowMouse;
           End;
   TL_FREE: Begin
             Dt_^.Mode:=1;
             If Dt_^.NP<MAXPTS-2 Then Begin Inc(Dt_^.NP);
             Dt_^.Pts[Dt_^.NP].X:=E.X;Dt_^.Pts[Dt_^.NP].Y:=E.Y;End;
             Dt_^.RbX:=Dt_^.NP;
            End;
  End;
 End Else If E.Kind=EV_MOVE Then Begin
  If Dt_^.Mode=1 Then Begin
   Case Dt_^.Tool Of
    TL_LINE,TL_RECT,TL_ELL: Begin
      HideMouse;DrwRubber(Wd_);Dt_^.CXp:=E.X;Dt_^.CYp:=E.Y;DrwRubber(Wd_);
      ShowMouse;
     End;
    TL_FREE: If Dt_^.NP<MAXPTS-1 Then Begin
      HideMouse;
      ClipFull;
      GLine(Dt_^.Pts[Dt_^.NP].X,Dt_^.Pts[Dt_^.NP].Y,E.X,E.Y,Dt_^.Col);
      Inc(Dt_^.NP);Dt_^.Pts[Dt_^.NP].X:=E.X;Dt_^.Pts[Dt_^.NP].Y:=E.Y;
      ShowMouse;
     End;
   End;
  End Else If (Dt_^.Mode=2) And (Dt_^.Sel>0) Then Begin
   DrwMoveObj(Wd_,Dt_^.Sel,E.X-Dt_^.LastX,E.Y-Dt_^.LastY);
   Dt_^.LastX:=E.X;Dt_^.LastY:=E.Y;Dt_^.Modified:=True;
   Invalidate(Wd_);
  End;
 End Else If E.Kind=EV_UP Then Begin
  If Dt_^.Mode=1 Then Begin
   FillChar(Ob,SizeOf(Ob),0);
   Ob.Col:=Dt_^.Col;Ob.Wd:=Dt_^.Wd;
   If Dt_^.FillOn Then Ob.Fill:=Dt_^.Fill Else Ob.Fill:=-1;
   Case Dt_^.Tool Of
    TL_LINE,TL_RECT,TL_ELL: Begin
      HideMouse;DrwRubber(Wd_);ShowMouse;
      Ob.K:=Dt_^.Tool-1;
      If Dt_^.Tool=TL_LINE Then Ob.K:=1 Else If Dt_^.Tool=TL_RECT Then Ob.K:=2
          Else Ob.K:=3;
      Ob.X1:=Dt_^.RbX;Ob.Y1:=Dt_^.RbY;Ob.X2:=E.X;Ob.Y2:=E.Y;
      If (Abs(E.X-Dt_^.RbX)>2) Or (Abs(E.Y-Dt_^.RbY)>2) Then DrwAddObj(Wd_,Ob);
     End;
    TL_FREE: Begin
      If Dt_^.NP-Dt_^.RbX>=1 Then Begin
       Ob.K:=4;Ob.P0:=Dt_^.RbX;Ob.PN:=Dt_^.NP-Dt_^.RbX+1;
       DrwAddObj(Wd_,Ob);
      End;
     End;
   End;
   Dt_^.Mode:=0;
   Invalidate(Wd_);
  End;
  Dt_^.Mode:=0;
 End;
End;

Procedure DrwOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PDraw;
Begin
 Dt_:=Wd_^.Data;
 If (K=K_DEL) And (Dt_^.Sel>0) Then Begin DrwDelObj(Wd_,Dt_^.Sel);
 Invalidate(Wd_);End;
 If K=K_CTRLC Then DrwOnCommand(Wd_,CM_DOCOPY);
 If K=K_CTRLX Then DrwOnCommand(Wd_,CM_DOCUT);
 If K=K_CTRLV Then DrwOnCommand(Wd_,CM_DOPASTE);
End;

Procedure DrwPrepareMenus(Wd_: PWindow);
 Var Dt_: PDraw;
Begin
 Dt_:=Wd_^.Data;
 WinSetFlag(Wd_,CM_DFILL,2,Dt_^.FillOn);
 WinSetFlag(Wd_,CM_DW1,2,Dt_^.Wd=1);WinSetFlag(Wd_,CM_DW2,2,Dt_^.Wd=2);
 WinSetFlag(Wd_,CM_DW3,2,Dt_^.Wd=3);
 WinSetFlag(Wd_,CM_DDELO,1,Dt_^.Sel=0);WinSetFlag(Wd_,CM_DDUP,1,Dt_^.Sel=0);
 WinSetFlag(Wd_,CM_DFRONT,1,Dt_^.Sel=0);WinSetFlag(Wd_,CM_DBACK,1,Dt_^.Sel=0);
 WinSetFlag(Wd_,CM_DPASTEI,1,ClipIconId<0);
 WinSetFlag(Wd_,CM_DOCUT,1,Dt_^.Sel=0);WinSetFlag(Wd_,CM_DOCOPY,1,Dt_^.Sel=0);
 WinSetFlag(Wd_,CM_DOPASTE,1,Not DrwClipHas);
 WinSetFlag(Wd_,CM_DROT90,1,Dt_^.NO=0);WinSetFlag(Wd_,CM_DROT270,1,Dt_^.NO=0);
 WinSetFlag(Wd_,CM_DROT180,1,Dt_^.NO=0);
 WinSetFlag(Wd_,CM_DFLIPH,1,Dt_^.NO=0);WinSetFlag(Wd_,CM_DFLIPV,1,Dt_^.NO=0);
End;

Procedure DrwSaveFile(Wd_: PWindow; Const P: String);
 Var Dt_: PDraw;
Var F: Text; I,K: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,P);
 Rewrite(F);
 WriteLn(F,'GEODRAW1');
 For I:=1 To Dt_^.NO Do Begin
  WriteLn(F,Dt_^.O[I].K,' ',Dt_^.O[I].X1,' ',Dt_^.O[I].Y1,' ',Dt_^.O[I].X2,' ',
      Dt_^.O[I].Y2,' ',Dt_^.O[I].Col,' ',Dt_^.O[I].Fill,' ',Dt_^.O[I].Wd,' ',
      Dt_^.O[I].PN,' ',Dt_^.O[I].Ic,' ',Dt_^.O[I].Txt);
  If Dt_^.O[I].K=4 Then For K:=Dt_^.O[I].P0 To Dt_^.O[I].P0+Dt_^.O[I].PN-1 Do
      WriteLn(F,Dt_^.Pts[K].X,' ',Dt_^.Pts[K].Y);
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Info(T3('Error','Erreur','Fehler'),T3('Cannot save file.',
     'Impossible d''enregistrer.','Speichern nicht m'#148'glich.'))
 Else Begin Dt_^.Modified:=False;End;
End;

Procedure DrwLoadFile(Wd_: PWindow; Const P: String);
 Var Dt_: PDraw;
Var F: Text; S: String; N: Integer; Ob: TObj;

 Function NextInt: Integer;
 Var Q: Integer; T: String; V: Integer; Cd: Integer;
 Begin
  While (S<>'') And (S[1]=' ') Do Delete(S,1,1);
  Q:=Pos(' ',S);
  If Q=0 Then Begin T:=S;S:='';End Else Begin T:=Copy(S,1,Q-1);Delete(S,1,Q);
  End;
  Val(T,V,Cd);
  NextInt:=V;
 End;

Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,P);
 Reset(F);
 {$I+}
 If IOResult<>0 Then Begin
  Info(T3('Error','Erreur','Fehler'),T3('Cannot open|','Impossible d''ouvrir|',
      'Kann nicht '#148'ffnen|')+P);
  Exit;
 End;
 Dt_^.NO:=0;Dt_^.NP:=0;
 {$I-}
 ReadLn(F,S);
 If S<>'GEODRAW1' Then Begin Close(F);
 Info('GeoDraw',T3('Not a GeoDraw file.','Ce n''est pas un fichier GeoDraw.',
     'Keine GeoDraw-Datei.'));Exit;End;
 While Not Eof(F) And (Dt_^.NO<MAXOBJ) Do Begin
  ReadLn(F,S);
  FillChar(Ob,SizeOf(Ob),0);
  Ob.K:=NextInt;Ob.X1:=NextInt;Ob.Y1:=NextInt;Ob.X2:=NextInt;Ob.Y2:=NextInt;
  Ob.Col:=NextInt;Ob.Fill:=NextInt;Ob.Wd:=NextInt;Ob.PN:=NextInt;Ob.Ic:=NextInt;
  Ob.Txt:=Copy(S,1,40);
  If Ob.K=4 Then Begin
   Ob.P0:=Dt_^.NP+1;
   For N:=1 To Ob.PN Do Begin
    If Not Eof(F) And (Dt_^.NP<MAXPTS) Then Begin
     ReadLn(F,S);Inc(Dt_^.NP);Dt_^.Pts[Dt_^.NP].X:=NextInt;
     Dt_^.Pts[Dt_^.NP].Y:=NextInt;
    End;
   End;
  End;
  Inc(Dt_^.NO);Dt_^.O[Dt_^.NO]:=Ob;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 Dt_^.Modified:=False;Dt_^.Sel:=0;
End;

Function DrwCanClose(Wd_: PWindow): Boolean;
 Var Dt_: PDraw;
Var R: Integer;
Begin
 Dt_:=Wd_^.Data;
 DrwCanClose:=True;
 If Dt_^.Modified Then Begin
  R:=MsgBox(T3('Close','Fermer','Schlie'#225'en'),T3('Save changes?',
      'Enregistrer les modifications ?',#142'nderungen speichern?'),
     T3('Yes|No|Cancel','Oui|Non|Annuler','Ja|Nein|Abbruch'),2);
  If R=3 Then DrwCanClose:=False
  Else If R=1 Then Begin DrwOnCommand(Wd_,CM_DSAVE2);
  DrwCanClose:=Not Dt_^.Modified;End;
 End;
End;

{ Rotation / retournement de l'objet selectionne (ou de tous les objets) autour
  de son centre }
Procedure DrwXform(Wd_: PWindow; Mode: Integer);
 Var Dt_: PDraw;
Var I,K,Lo,Hi,A,B,C,D,CX,CY,MnX,MnY,MxX,MxY,HW,HH,NX,NY: Integer;

 Procedure Tx(X,Y: Integer; Var RX,RY: Integer);
 Begin
  Case Mode Of
   1: Begin RX:=CX-(Y-CY);RY:=CY+(X-CX);End;
   2: Begin RX:=CX+(Y-CY);RY:=CY-(X-CX);End;
   3: Begin RX:=2*CX-X;RY:=2*CY-Y;End;
   4: Begin RX:=2*CX-X;RY:=Y;End;
  Else Begin RX:=X;RY:=2*CY-Y;End;
  End;
 End;

Begin
 Dt_:=Wd_^.Data;
 If Dt_^.NO=0 Then Exit;
 If Dt_^.Sel>0 Then Begin Lo:=Dt_^.Sel;Hi:=Dt_^.Sel;End Else Begin Lo:=1;
 Hi:=Dt_^.NO;End;
 MnX:=32000;MnY:=32000;MxX:=-32000;MxY:=-32000;
 For I:=Lo To Hi Do Begin
  DrwBounds(Wd_,Dt_^.O[I],A,B,C,D);
  If A<MnX Then MnX:=A;If B<MnY Then MnY:=B;If C>MxX Then MxX:=C;
  If D>MxY Then MxY:=D;
 End;
 CX:=(MnX+MxX) Div 2;CY:=(MnY+MxY) Div 2;
 For I:=Lo To Hi Do Begin
  Case Dt_^.O[I].K Of
   1,2,3: Begin
           Tx(Dt_^.O[I].X1,Dt_^.O[I].Y1,NX,NY);Dt_^.O[I].X1:=NX;
           Dt_^.O[I].Y1:=NY;
           Tx(Dt_^.O[I].X2,Dt_^.O[I].Y2,NX,NY);Dt_^.O[I].X2:=NX;
           Dt_^.O[I].Y2:=NY;
          End;
   4: Begin
       For K:=Dt_^.O[I].P0 To Dt_^.O[I].P0+Dt_^.O[I].PN-1 Do Begin
        Tx(Dt_^.Pts[K].X,Dt_^.Pts[K].Y,NX,NY);Dt_^.Pts[K].X:=NX;
        Dt_^.Pts[K].Y:=NY;
       End;
      End;
   5,6: Begin
         { texte et images : seul l'emplacement change (leur trace n'est pas
           pivotee) }
         DrwBounds(Wd_,Dt_^.O[I],A,B,C,D);
         HW:=(C-A) Div 2;HH:=(D-B) Div 2;
         Tx((A+C) Div 2,(B+D) Div 2,NX,NY);
         If Dt_^.O[I].K=5 Then Begin Dt_^.O[I].X1:=NX-HW;Dt_^.O[I].Y1:=NY-HH;End
         Else Begin Dt_^.O[I].X1:=NX-HW;Dt_^.O[I].Y1:=NY-HH;End;
        End;
  End;
 End;
 Dt_^.Modified:=True;
End;

Procedure DrwCopyObj(Wd_: PWindow);
 Var Dt_: PDraw;
Var I: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.Sel=0 Then Exit;
 DrwClipOb:=Dt_^.O[Dt_^.Sel];
 If DrwClipOb.K=4 Then Begin
  If DrwClipOb.PN>600 Then DrwClipOb.PN:=600;
  For I:=0 To DrwClipOb.PN-1 Do DrwClipPts[1+I]:=Dt_^.Pts[DrwClipOb.P0+I];
 End;
 DrwClipHas:=True;
End;

Procedure DrwPasteObj(Wd_: PWindow);
 Var Dt_: PDraw;
Var I: Integer; Ob: TObj;
Begin
 Dt_:=Wd_^.Data;
 If Not DrwClipHas Then Exit;
 Ob:=DrwClipOb;
 If Ob.K=4 Then Begin
  If Dt_^.NP+Ob.PN>=MAXPTS Then Exit;
  For I:=0 To Ob.PN-1 Do Begin
   Dt_^.Pts[Dt_^.NP+1+I].X:=DrwClipPts[1+I].X+10;
   Dt_^.Pts[Dt_^.NP+1+I].Y:=DrwClipPts[1+I].Y+10;
  End;
  Ob.P0:=Dt_^.NP+1;Dt_^.NP:=Dt_^.NP+Ob.PN;
 End;
 Ob.X1:=Ob.X1+10;Ob.X2:=Ob.X2+10;Ob.Y1:=Ob.Y1+10;Ob.Y2:=Ob.Y2+10;
 DrwClipOb.X1:=Ob.X1;DrwClipOb.X2:=Ob.X2;DrwClipOb.Y1:=Ob.Y1;
 DrwClipOb.Y2:=Ob.Y2;
 If Ob.K=4 Then For I:=1 To Ob.PN Do Begin DrwClipPts[I].X:=DrwClipPts[I].X+10;
 DrwClipPts[I].Y:=DrwClipPts[I].Y+10;End;
 DrwAddObj(Wd_,Ob);
End;

Procedure DrwOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PDraw;
Var P: String; I: Integer; Ob: TObj;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_DNEWD: Begin If Not DrwCanClose(Wd_) Then Exit;Dt_^.NO:=0;Dt_^.NP:=0;
  Dt_^.Sel:=0;Dt_^.FName:='';Dt_^.Modified:=False;End;
  CM_DOPEN: Begin
             P:=CurDirStr;
             If FileDlg(T3('Open','Ouvrir',#142'ffnen'),'*.GDR',P,
                 False) Then Begin DrwLoadFile(Wd_,P);Dt_^.FName:=P;End;
            End;
  CM_DSAVE2,CM_DSAVEAS: Begin
             P:=Dt_^.FName;
             If (P='') Or (Cmd=CM_DSAVEAS) Then Begin
              If P='' Then P:=JoinPath(CurDirStr,'DRAWING.GDR');
              If Not FileDlg(T3('Save As','Enregistrer sous','Speichern unter'),
                  '*.GDR',P,True) Then Begin DrwUpdateTitle(Wd_);Exit;End;
             End;
             DrwSaveFile(Wd_,P);Dt_^.FName:=P;
            End;
  CM_DDELO: If Dt_^.Sel>0 Then DrwDelObj(Wd_,Dt_^.Sel);
  CM_DOCOPY: DrwCopyObj(Wd_);
  CM_DOCUT: Begin DrwCopyObj(Wd_);If Dt_^.Sel>0 Then DrwDelObj(Wd_,Dt_^.Sel);
  End;
  CM_DOPASTE: DrwPasteObj(Wd_);
  CM_DROT90: DrwXform(Wd_,1);
  CM_DROT270: DrwXform(Wd_,2);
  CM_DROT180: DrwXform(Wd_,3);
  CM_DFLIPH: DrwXform(Wd_,4);
  CM_DFLIPV: DrwXform(Wd_,5);
  CM_DCLR: Begin Dt_^.NO:=0;Dt_^.NP:=0;Dt_^.Sel:=0;Dt_^.Modified:=True;End;
  CM_DFRONT: If Dt_^.Sel>0 Then Begin Ob:=Dt_^.O[Dt_^.Sel];
  For I:=Dt_^.Sel To Dt_^.NO-1 Do Dt_^.O[I]:=Dt_^.O[I+1];Dt_^.O[Dt_^.NO]:=Ob;
  Dt_^.Sel:=Dt_^.NO;End;
  CM_DBACK: If Dt_^.Sel>0 Then Begin Ob:=Dt_^.O[Dt_^.Sel];
  For I:=Dt_^.Sel DownTo 2 Do Dt_^.O[I]:=Dt_^.O[I-1];Dt_^.O[1]:=Ob;Dt_^.Sel:=1;
  End;
  CM_DDUP: If Dt_^.Sel>0 Then Begin Ob:=Dt_^.O[Dt_^.Sel];
            If Ob.K=4 Then Begin
             If Dt_^.NP+Ob.PN<MAXPTS Then Begin
              For I:=0 To Ob.PN-1 Do Begin Dt_^.Pts[Dt_^.NP+1+I].X:=
                  Dt_^.Pts[Ob.P0+I].X+12;Dt_^.Pts[Dt_^.NP+1+I].Y:=Dt_^.Pts[Ob.P0
                  +I].Y+12;End;
              Ob.P0:=Dt_^.NP+1;Dt_^.NP:=Dt_^.NP+Ob.PN;
             End;
            End;
            Ob.X1:=Ob.X1+12;Ob.X2:=Ob.X2+12;Ob.Y1:=Ob.Y1+12;Ob.Y2:=Ob.Y2+12;
            DrwAddObj(Wd_,Ob);
           End;
  CM_DPASTEI: Begin
               If ClipIconId>=0 Then Begin
                FillChar(Ob,SizeOf(Ob),0);Ob.K:=6;Ob.X1:=100;Ob.Y1:=60;
                Ob.Ic:=ClipIconId;DrwAddObj(Wd_,Ob);
               End;
              End;
  CM_DFILL: Dt_^.FillOn:=Not Dt_^.FillOn;
  CM_DW1: Dt_^.Wd:=1;
  CM_DW2: Dt_^.Wd:=2;
  CM_DW3: Dt_^.Wd:=3;
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 DrwUpdateTitle(Wd_);
 Invalidate(Wd_);
End;

