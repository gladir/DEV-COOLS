Const
 {$IFDEF UNIX}
 DirSep = '/';
 {$ELSE}
 DirSep = '\';
 {$ENDIF}

Function T3(Const En,Fr,De: String): String;
Begin
 Case Lang Of
  0: T3:=En;
  2: T3:=De;
 Else T3:=Fr;
 End;
End;

{ 'EN~FR~DE' : extrait la partie correspondant a la langue }
Function Part3(Const S: String; N: Integer): String;
Var I,K: Integer; R: String;
Begin
 R:='';K:=0;
 For I:=1 To Length(S) Do
  If S[I]='~' Then Inc(K) Else If K=N Then R:=R+S[I];
 If (R='') And (N<>0) Then Part3:=Part3(S,0) Else Part3:=R;
End;

Function TL(Const S: String): String;      { traduit 'EN~FR~DE' }
Begin
 If Pos('~',S)=0 Then TL:=S Else TL:=Part3(S,Lang);
End;

Function IntStr(N: LongInt): String;
Var S: String;
Begin
 Str(N,S);
 IntStr:=S;
End;

Function Pad2(N: LongInt): String;
Var S: String;
Begin
 Str(N,S);
 If Length(S)<2 Then S:='0'+S;
 Pad2:=S;
End;

Function Upper(S: String): String;
Var I: Integer;
Begin
 For I:=1 To Length(S) Do S[I]:=UpCase(S[I]);
 Upper:=S;
End;

Function LowerStr(S: String): String;
Var I: Integer;
Begin
 For I:=1 To Length(S) Do
  If (S[I]>='A') And (S[I]<='Z') Then S[I]:=Chr(Ord(S[I])+32);
 LowerStr:=S;
End;

Function Min2(A,B: LongInt): LongInt;
Begin
 If A<B Then Min2:=A Else Min2:=B;
End;

Function Max2(A,B: LongInt): LongInt;
Begin
 If A>B Then Max2:=A Else Max2:=B;
End;

Function Clamp(V,A,B: LongInt): LongInt;
Begin
 If V<A Then V:=A;
 If V>B Then V:=B;
 Clamp:=V;
End;

Function TrimStr(Const S: String): String;
Var A,B: Integer;
Begin
 A:=1;B:=Length(S);
 While (A<=B) And (S[A]<=' ') Do Inc(A);
 While (B>=A) And (S[B]<=' ') Do Dec(B);
 TrimStr:=Copy(S,A,B-A+1);
End;

Function RepStr(C: Char; N: Integer): String;
Var S: String; I: Integer;
Begin
 S:='';
 For I:=1 To N Do S:=S+C;
 RepStr:=S;
End;

Function StrVal(Const S: String; Def: LongInt): LongInt;
Var V: LongInt; Cd: Integer;
Begin
 Val(TrimStr(S),V,Cd);
 If Cd<>0 Then StrVal:=Def Else StrVal:=V;
End;

Function HexB(B: Byte): String;
Const H: String[16] = '0123456789ABCDEF';
Begin
 HexB:=H[(B Shr 4)+1]+H[(B And 15)+1];
End;

Function HexW(W: Word): String;
Begin
 HexW:=HexB(W Shr 8)+HexB(W And 255);
End;

{ Nombre avec separateur de milliers selon la langue }
Function NumFmt(N: LongInt): String;
Var S,R: String; I,K: Integer; Sep: Char; Neg: Boolean;
Begin
 Neg:=N<0;
 If Neg Then N:=-N;
 Str(N,S);
 Case Lang Of
  0: Sep:=',';
  2: Sep:='.';
 Else Sep:=' ';
 End;
 R:='';K:=0;
 For I:=Length(S) DownTo 1 Do Begin
  R:=S[I]+R;
  Inc(K);
  If (K=3) And (I>1) Then Begin R:=Sep+R;K:=0;End;
 End;
 If Neg Then R:='-'+R;
 NumFmt:=R;
End;

Function RealStr(R: Real; Dec: Integer): String;
Var S: String;
Begin
 Str(R:0:Dec,S);
 RealStr:=S;
End;

