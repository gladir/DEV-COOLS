{   NOYAU PC/GEOS 2.x LOGICIEL : appels de bibliotheque emules par        }
{   ordinal. Les ordinaux et les prototypes proviennent des fichiers .gp  }
{   et des en-tetes C du depot open source bluewaysw/pcgeos (60a_names).  }
{   Un appel sans semantique connue n'arrete JAMAIS l'emulation : il est  }
{   journalise et rend 0.                                                  }
{ ====================================================================== }
{$IFDEF FPC}
Type
 TRtHan = Record Seg,Par: Word; Used: Boolean; End;
 TRtSeen = Record Lb: Byte; Ord_: Word; Cnt: Integer; End;
 TRtUser = Record Lb: Byte; Ord_: Word; Nm: String[24]; End;

Var
 RtHan     : Array[1..400] Of TRtHan;
 RtHeapTop : Word;
 RtPush    : Integer;
 RtCallPush: Integer;
 RtLogged  : Integer;
 RtCalls,RtUnkCalls : LongInt;
 RtSeen    : Array[1..200] Of TRtSeen;
 RtNSeen   : Integer;
 RtUser    : Array[1..160] Of TRtUser;
 RtNUser   : Integer;
 RtFiles   : Array[1..12] Of File;
 RtFUsed   : Array[1..12] Of Boolean;

Function RtLibId(Const N0: String): Integer;
Var N: String;
Begin
 N:=TrimStr(N0);
 If N='geos' Then RtLibId:=0 Else If N='ui' Then RtLibId:=1 Else If N='ansic'
     Then RtLibId:=2
 Else If N='borlandc' Then RtLibId:=3 Else If N='spool' Then RtLibId:=4 Else
     RtLibId:=9;
End;

Function RtLibName(Lb: Integer): String;
Begin
 If Lb<0 Then RtLibName:='geos'
 Else If (ELog<>Nil) And (Lb<MAXGLIB) Then
     RtLibName:=TrimStr(PGeodeWin(ELog^.Data)^.G.Libs[Lb].Name)
 Else RtLibName:='lib'+IntStr(Lb);
End;

{ Entree de table : 'Nom|signature|retour|convention' ou '' si inconnue }
Function RtEntry(LibId: Integer; O: Word): String;
Var S: String;
Begin
 S:='';
 Case LibId Of
  0: If O<=High(Tab_geos) Then S:=Tab_geos[O];
  1: If O<=High(Tab_ui) Then S:=Tab_ui[O];
  2: If O<=High(Tab_ansic) Then S:=Tab_ansic[O];
  3: If O<=High(Tab_borlandc) Then S:=Tab_borlandc[O];
  4: If O<=High(Tab_spool) Then S:=Tab_spool[O];
 End;
 RtEntry:=S;
End;

Function RtField(Const S: String; N: Integer): String;
Var I,K: Integer; R: String;
Begin
 R:='';K:=0;
 For I:=1 To Length(S) Do Begin
  If S[I]='|' Then Inc(K)
  Else If K=N Then R:=R+S[I];
 End;
 RtField:=R;
End;

{ Fichier de symboles utilisateur : "bibliotheque ordinal nom" (complete ou
  remplace la table) }
Procedure RtLoadSls(Const P: String);
Var F: Text; S,A,B,C: String; Q: Integer; V,Cd: Integer;
Begin
 {$I-}
 Assign(F,P);Reset(F);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 While Not Eof(F) Do Begin
  ReadLn(F,S);
  If (S<>'') And (S[1]<>';') Then Begin
   Q:=Pos(' ',S);
   If Q>0 Then Begin
    A:=Copy(S,1,Q-1);S:=TrimStr(Copy(S,Q+1,200));
    Q:=Pos(' ',S);
    If Q>0 Then Begin
     B:=Copy(S,1,Q-1);C:=TrimStr(Copy(S,Q+1,40));
     Val(B,V,Cd);
     If (Cd=0) And (RtNUser<160) Then Begin
      Inc(RtNUser);RtUser[RtNUser].Lb:=RtLibId(A);RtUser[RtNUser].Ord_:=V;
      RtUser[RtNUser].Nm:=Copy(C,1,24);
     End;
    End;
   End;
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

{ Handles de memoire emules }
Function RtAlloc(Size: Word): Word;
Var I: Integer; Par: LongInt;
Begin
 RtAlloc:=0;
 Par:=(LongInt(Size)+15) Shr 4+1;
 If RtHeapTop+Par>$EF00 Then Exit;
 For I:=1 To High(RtHan) Do
  If Not RtHan[I].Used Then Begin
   RtHan[I].Used:=True;RtHan[I].Seg:=RtHeapTop;RtHan[I].Par:=Par;
   FillChar(EMem^[Lin(RtHeapTop,0)],Par*16,0);
   RtHeapTop:=RtHeapTop+Par;
   RtAlloc:=$0400+I;
   Exit;
  End;
End;

Function RtSeg(H: Word): Word;
Var I: Integer;
Begin
 RtSeg:=0;
 If (H>=$0200) And (H<$0400) Then Begin
  If (H-$0200<MAXGSEG) Then RtSeg:=SegPara[H-$0200];
 End Else If (H>$0400) And (H<=$0400+High(RtHan)) Then Begin
  I:=H-$0400;
  If RtHan[I].Used Then RtSeg:=RtHan[I].Seg;
 End;
End;

Procedure RtNote(Lb: Integer; O: Word);
Var I: Integer;
Begin
 For I:=1 To RtNSeen Do
  If (RtSeen[I].Lb=Lb) And (RtSeen[I].Ord_=O) Then Begin Inc(RtSeen[I].Cnt);
  Exit;End;
 If RtNSeen<200 Then Begin
  Inc(RtNSeen);RtSeen[RtNSeen].Lb:=Lb;RtSeen[RtNSeen].Ord_:=O;
  RtSeen[RtNSeen].Cnt:=1;
 End;
End;

{ Suivi des empilements pour estimer les arguments d'un appel de signature
  inconnue }
Procedure RtTrack(Op: Byte);
Begin
 Case Op Of
  $50..$57,$68,$6A,$06,$0E,$16,$1E: Inc(RtPush);
  $58..$5F,$07,$17,$1F: If RtPush>0 Then Dec(RtPush);
  $FF: If ((M8(SegR[1],EIP) Shr 3) And 7)=6 Then Inc(RtPush);
  $E8,$9A: Begin RtCallPush:=RtPush;RtPush:=0;End;
  $C3,$CB,$C9,$C2,$CA: RtPush:=0;
 End;
End;

Function RtCStr(S,O: Word; Max: Integer): String;
Var R: String; I: Integer; C: Byte;
Begin
 R:='';
 For I:=0 To Max-1 Do Begin
  C:=M8(S,Word(O+I));
  If C=0 Then Break;
  If (C<32) And (C<>10) Then C:=32;
  R:=R+Chr(C);
 End;
 RtCStr:=R;
End;

Procedure RtPutStr(S,O: Word; Const T: String);
Var I: Integer;
Begin
 For I:=1 To Length(T) Do W8(S,Word(O+I-1),Ord(T[I]));
 W8(S,Word(O+Length(T)),0);
End;

Function RtFreeFile: Integer;
Var I: Integer;
Begin
 RtFreeFile:=0;
 For I:=1 To High(RtFiles) Do If Not RtFUsed[I] Then Begin RtFreeFile:=I;Exit;
 End;
End;

{ ------------------------------------------------------------------------
  SYSTEME D'OBJETS : CObjMessage / CObjCallSuper (objectClass.asm)
  Pile (convention pascal, l'appelant empile de gauche a droite) :
    CObjMessage   : params..., flags, ohan, och, method, mpd
    CObjCallSuper : params..., class(fptr), ohan, och, method, mpd
  Disposition en memoire a partir de SS:SP+4 (apres l'adresse de retour) :
    +0 mpd  +2 method  +4 och  +6 ohan  +8 flags (ou classe fptr)  puis params
  MethodParameterDef (16 bits, champs de poids fort a poids faible) :
    bits 15-14 type de retour, 13-10 info de retour, 9 params en registres,
    8-0 : registres (PARAM3 8-6, PARAM2 5-3, PARAM1 2-0 ; 1 CL 2 CH 3 DL
    4 DH 5 CX 6 DX 7 BP) ou memoire (bit 8 = format C, octet bas = taille ;
    sinon bit 7 = structure en ss:bp et bits 6-0 = taille).
  ------------------------------------------------------------------------ }
Type
 TObjMsg = Record
  Super   : Boolean;
  Mpd,Method,Och,Ohan,Flags,ClsOfs,ClsSeg : Word;
  ParamBytes,Total : Integer;
  Cx,Dx,Bp : Word;
  RetType  : Byte;
 End;

Var
 RtObjMsgs   : LongInt;
 RtLastObj   : TObjMsg;

Function ObjParamBytes(Mpd: Word): Integer;
Var Al,N: Integer;
Begin
 If (Mpd And $0200)<>0 Then Begin
  N:=0;
  If (Mpd And $0007)<>0 Then Inc(N);
  If (Mpd And $0038)<>0 Then Inc(N);
  If (Mpd And $01C0)<>0 Then Inc(N);
  ObjParamBytes:=2*N;
 End Else If (Mpd And $0100)<>0 Then Begin
  Al:=Mpd And $FF;
  If Al<=2 Then ObjParamBytes:=2 Else If Al<=4 Then ObjParamBytes:=4 Else
      If Al<=6 Then ObjParamBytes:=6 Else ObjParamBytes:=Al;
 End Else If (Mpd And $0080)<>0 Then ObjParamBytes:=4
 Else ObjParamBytes:=Mpd And $7F;
End;

{ charge cx, dx, bp selon le MethodParameterDef ; Top = SS:offset du premier
  argument }
Procedure ObjDecode(Super: Boolean; Top: Word; Var M: TObjMsg);
Var Q: Word; HdrB,I,K: Integer; Sel: Array[1..3] Of Integer; V: Word;
Code: Integer;
 Function Rd(O: Word): Word;
 Begin
  Rd:=M16(SegR[2],O);
 End;
 Procedure Put(Cd: Integer; W: Word);
 Begin
  Case Cd Of
   1: M.Cx:=(M.Cx And $FF00) Or (W And $FF);
   2: M.Cx:=(M.Cx And $00FF) Or ((W And $FF) Shl 8);
   3: M.Dx:=(M.Dx And $FF00) Or (W And $FF);
   4: M.Dx:=(M.Dx And $00FF) Or ((W And $FF) Shl 8);
   5: M.Cx:=W;
   6: M.Dx:=W;
   7: M.Bp:=W;
  End;
 End;
Begin
 FillChar(M,SizeOf(M),0);
 M.Super:=Super;
 M.Mpd:=Rd(Top);M.Method:=Rd(Word(Top+2));M.Och:=Rd(Word(Top+4));
 M.Ohan:=Rd(Word(Top+6));
 If Super Then Begin M.ClsOfs:=Rd(Word(Top+8));M.ClsSeg:=Rd(Word(Top+10));
 HdrB:=12;End
 Else Begin M.Flags:=Rd(Word(Top+8));HdrB:=10;End;
 M.RetType:=(M.Mpd Shr 14) And 3;
 M.ParamBytes:=ObjParamBytes(M.Mpd);
 M.Total:=HdrB+M.ParamBytes;
 Q:=Word(Top+HdrB);
 If (M.Mpd And $0200)<>0 Then Begin
  { params en registres : lus dans l'ordre PARAM3, PARAM2, PARAM1 }
  Sel[1]:=(M.Mpd Shr 6) And 7;Sel[2]:=(M.Mpd Shr 3) And 7;Sel[3]:=M.Mpd And 7;
  For K:=1 To 3 Do If Sel[K]<>0 Then Begin Put(Sel[K],Rd(Q));Inc(Q,2);End;
 End Else If (M.Mpd And $0100)<>0 Then Begin
  I:=M.Mpd And $FF;
  If I<=6 Then Begin
   M.Cx:=Rd(Q);
   If I>2 Then M.Dx:=Rd(Word(Q+2));
   If I>4 Then M.Bp:=Rd(Word(Q+4));
  End Else Begin M.Bp:=Q;M.Dx:=I;End;
 End Else Begin
  If (M.Mpd And $0080)<>0 Then M.Bp:=Rd(Q) Else Begin M.Bp:=Q;
  M.Dx:=M.Mpd And $7F;End;
 End;
End;

{ ------------------------------------------------------------------------
  Recherche de methode et remise d'un message a un gestionnaire de la geode.
  ClassStruct : +0 super (offset, segment) ; +4 decalage maitre ; +6 nombre de
  methodes ; +8 taille d'instance ; +16 numeros de messages (mots) puis les
  gestionnaires (pointeurs lointains). Une classe parente de bibliotheque
  (segment >= TRAP_LIB) n'a pas de code emulable : la recherche s'arrete.
  ------------------------------------------------------------------------ }
Const
 OBJ_MAXDEPTH = 6;

Var
 RtDepth    : Integer;
 RtDelivered: LongInt;

Procedure ExecOne; Forward;
Function RtApiExt(Const Up: String; Top: Word; Const Sg: String;
                  Tot: Integer; Var RAx,RDx: Word): Boolean; Forward;

Function RtMethodFind(CS,CO,Msg: Word; Var HS,HO: Word): Boolean;
Var K,I,N: Integer; Sg,Ofs: Word;
Begin
 RtMethodFind:=False;
 For K:=1 To 12 Do Begin
  N:=M16(CS,Word(CO+6));
  If N<200 Then
   For I:=0 To N-1 Do
    If M16(CS,Word(CO+16+2*I))=Msg Then Begin
     HO:=M16(CS,Word(CO+16+N*2+I*4));HS:=M16(CS,Word(CO+16+N*2+I*4+2));
     RtMethodFind:=True;Exit;
    End;
  Ofs:=M16(CS,CO);Sg:=M16(CS,Word(CO+2));
  If (Sg=0) Or (Sg>=TRAP_KERNEL) Then Exit;
  CS:=Sg;CO:=Ofs;
 End;
End;

{ execute un gestionnaire dans l'emulateur et rend les registres de sortie }
Function RtInvoke(HS,HO,Ax,Cx,Dx,Bp,Ds,Si,Es,Di,Bx: Word;
                  Var RA,RC,RD,RB: Word; Var Carry: Boolean): Boolean;
Var SvR: TERegs; SvS: TESegs; SvI,SvF: Word;
    SvH: Boolean; SvE: String; SvP,SvC: Integer; Stp: LongInt; I: Integer;
Begin
 RtInvoke:=False;
 If RtDepth>=OBJ_MAXDEPTH Then Exit;
 Inc(RtDepth);
 SvR:=Reg;SvS:=SegR;SvI:=EIP;SvF:=EFl;SvH:=EHalt;SvE:=EReason;
 SvP:=RtPush;SvC:=RtCallPush;
 If SegR[2]=0 Then Begin
  SegR[2]:=$9000;Reg[4]:=$FFF0;
  For I:=1 To 12 Do Push16(0);
 End Else Reg[4]:=Word(Reg[4]-64);
 Reg[0]:=Ax;Reg[1]:=Cx;Reg[2]:=Dx;Reg[3]:=Bx;Reg[5]:=Bp;Reg[6]:=Si;Reg[7]:=Di;
 SegR[0]:=Es;SegR[3]:=Ds;
 Push16(TRAP_EXIT);Push16(0);
 SegR[1]:=HS;EIP:=HO;EFl:=$0202;
 EHalt:=False;RtPush:=0;
 Stp:=0;
 While (Not EHalt) And (Stp<60000) Do Begin ExecOne;Inc(Stp);End;
 RtInvoke:=EHalt And (SegR[1]=TRAP_EXIT);
 RA:=Reg[0];RC:=Reg[1];RD:=Reg[2];RB:=Reg[5];Carry:=(EFl And FL_CF)<>0;
 Reg:=SvR;SegR:=SvS;EIP:=SvI;EFl:=SvF;EHalt:=SvH;EReason:=SvE;
 RtPush:=SvP;RtCallPush:=SvC;
 Dec(RtDepth);
End;

{ valeur de retour selon MPD_RETURN_TYPE / MPD_RETURN_INFO (CMessageReturn) }
Procedure ObjReturn(Mpd,Ax,Cx,Dx,Bp: Word; Carry: Boolean; Var RA,RD: Word);
Var T,Inf: Integer; Rg: Array[0..3] Of Word; V: Word;
Begin
 Rg[0]:=Ax;Rg[1]:=Cx;Rg[2]:=Dx;Rg[3]:=Bp;
 T:=(Mpd Shr 14) And 3;Inf:=(Mpd Shr 10) And 15;
 RA:=0;RD:=0;
 Case T Of
  1: Begin
      Case Inf Of
       0: V:=Ax And $FF;
       1: V:=(Ax Shr 8) And $FF;
       2: V:=Cx And $FF;
       3: V:=(Cx Shr 8) And $FF;
       4: V:=Dx And $FF;
       5: V:=(Dx Shr 8) And $FF;
       6: V:=Bp And $FF;
       7: V:=(Bp Shr 8) And $FF;
       8: V:=Ax;
       9: V:=Cx;
       10: V:=Dx;
      Else V:=Bp;
      End;
      RA:=V;
     End;
  2: Begin RD:=Rg[(Inf Shr 2) And 3];RA:=Rg[Inf And 3];End;
 Else If Carry Then RA:=1;
 End;
End;

{ remet un message a un objet (Res,H) de la geode ou au processus ;
  rend 1 si un gestionnaire a ete execute, 0 sinon (classe de bibliotheque) }
Function RtSendObj(Res: Integer; H: Word; IsProc,Super: Boolean;
                   ClsS,ClsO,Msg,Cx,Dx,Bp: Word; Var RA,RC,RD,RB: Word;
                   Var Carry: Boolean): Integer;
Var G: ^TGeode; Sg,HT,Off,Rid,Ent,CS,CO,HS,HO,DsS,Bx,Si: Word; Src: Integer;
    Ok: Boolean;
Begin
 RtSendObj:=0;
 If ELog=Nil Then Exit;
 G:=@PGeodeWin(ELog^.Data)^.G;
 DsS:=SegPara[Min2(1,G^.NS-1)];Bx:=0;Si:=0;
 If IsProc Then Begin
  If G^.ProcRes>=G^.NS Then Exit;
  CS:=SegPara[G^.ProcRes];CO:=G^.ProcOfs;
 End Else Begin
  If (Res<1) Or (Res>=G^.NS) Then Exit;
  Sg:=SegPara[Res];
  If M16(Sg,6)<>2 Then Exit;
  HT:=M16(Sg,2);
  If (H<HT) Or Odd(H) Or (H>=HT+2*M16(Sg,10)) Then Exit;
  Off:=M16(Sg,H);
  If (Off=0) Or (Off=$FFFF) Then Exit;
  Rid:=M16(Sg,Off);Ent:=M16(Sg,Word(Off+2));Src:=Rid Shr 12;
  If (Src<>6) Or (Ent>=G^.NE) Or (G^.Exp[Ent].Res>=G^.NS) Then Exit;
  CS:=SegPara[G^.Exp[Ent].Res];CO:=G^.Exp[Ent].Ofs;
  DsS:=Sg;Bx:=Off;Si:=H;
 End;
 If Super Then Begin
  CS:=ClsS;CO:=ClsO;
  { passe a la classe parente }
  HS:=M16(CS,Word(CO+2));HO:=M16(CS,CO);
  If (HS=0) Or (HS>=TRAP_KERNEL) Then Exit;
  CS:=HS;CO:=HO;
 End;
 If Not RtMethodFind(CS,CO,Msg,HS,HO) Then Exit;
 Ok:=RtInvoke(HS,HO,Msg,Cx,Dx,Bp,DsS,Si,CS,CO,Bx,RA,RC,RD,RB,Carry);
 If Ok Then Begin
  RtSendObj:=1;Inc(RtDelivered);
  ELogLine('    -> '+HexW(HS)+':'+HexW(HO)+' ax='+HexW(RA)+' cx='+HexW(RC)+
           ' dx='+HexW(RD)+' bp='+HexW(RB));
 End Else RtSendObj:=2;
End;

Procedure RtCall(Lib: Integer; Ord_: Word);
Var I,Tot,N: Integer; Nm,Up,Lb,Sg,Rs,Cv,S,Args,E,T: String; Top: Word;
Known,Logit,Cd: Boolean;
    LibId: Integer; V: Word; L: LongInt; Fnd: Boolean; Nw: Word; IsObj: Boolean;
    OM: TObjMsg;
    Rc_,Rd_,Rb_: Word;

 Function ArgOfs(Idx: Integer): Word;
 Var J,C: Integer;
 Begin
  C:=0;
  If Cv='c' Then Begin
   For J:=1 To Idx Do If Sg[J]='d' Then Inc(C,4) Else Inc(C,2);
   ArgOfs:=Word(Top+C);
  End Else Begin
   For J:=1 To Idx+1 Do If Sg[J]='d' Then Inc(C,4) Else Inc(C,2);
   ArgOfs:=Word(Top+Tot-C);
  End;
 End;
 Function ArgW(Idx: Integer): Word;
 Begin
  ArgW:=M16(SegR[2],ArgOfs(Idx));
 End;
 Function ArgSeg(Idx: Integer): Word;
 Begin
  ArgSeg:=M16(SegR[2],Word(ArgOfs(Idx)+2));
 End;

 { mise en forme minimale de printf : %d %u %x %s %c avec largeur et '-' }
 Function Fmt(FS,FO: Word; AO: Word): String;
 Var F,R,P,Wd: String; K,Wn: Integer; Left: Boolean; Ch: Char; V16: Word;
 SS,SO: Word;
 Begin
  F:=RtCStr(FS,FO,100);R:='';K:=1;
  While K<=Length(F) Do Begin
   If F[K]<>'%' Then Begin R:=R+F[K];Inc(K);End
   Else Begin
    Inc(K);Left:=False;Wd:='';
    If (K<=Length(F)) And (F[K]='-') Then Begin Left:=True;Inc(K);End;
    While (K<=Length(F)) And (F[K] In ['0'..'9']) Do Begin Wd:=Wd+F[K];Inc(K);
    End;
    If (K<=Length(F)) And (F[K] In ['l','h']) Then Inc(K);
    If K>Length(F) Then Break;
    Ch:=F[K];Inc(K);
    Wn:=StrVal(Wd,0);P:='';
    Case Ch Of
     'd','i': Begin V16:=M16(SegR[2],AO);Inc(AO,2);P:=IntStr(SmallInt(V16));End;
     'u': Begin V16:=M16(SegR[2],AO);Inc(AO,2);P:=IntStr(V16);End;
     'x','X': Begin V16:=M16(SegR[2],AO);Inc(AO,2);P:=HexW(V16);
     While (Length(P)>1) And (P[1]='0') Do Delete(P,1,1);End;
     'c': Begin V16:=M16(SegR[2],AO);Inc(AO,2);P:=Chr(V16 And 255);End;
     's': Begin SO:=M16(SegR[2],AO);SS:=M16(SegR[2],Word(AO+2));Inc(AO,4);
     P:=RtCStr(SS,SO,100);End;
     '%': P:='%';
    End;
    While Length(P)<Wn Do If Left Then P:=P+' ' Else P:=' '+P;
    R:=R+P;
   End;
  End;
  Fmt:=R;
 End;

Begin
 Inc(RtCalls);
 Lb:=RtLibName(Lib);
 LibId:=RtLibId(Lb);
 E:=RtEntry(LibId,Ord_);
 Known:=E<>'';
 Nm:=Lb+'#'+IntStr(Ord_);Sg:='?';Rs:='?';Cv:='p';
 For I:=1 To RtNUser Do If (RtUser[I].Lb=LibId) And (RtUser[I].Ord_=Ord_) Then
     Begin Nm:=RtUser[I].Nm;Known:=True;End;
 If E<>'' Then Begin
  Nm:=RtField(E,0);Sg:=RtField(E,1);Rs:=RtField(E,2);Cv:=RtField(E,3);
  If Cv='' Then Cv:='p';
 End;
 Up:=Upper(Nm);
 If (Length(Up)>0) And (Up[1]='_') Then Delete(Up,1,1);
 Top:=Word(Reg[4]+4);
 IsObj:=(Up='COBJMESSAGE') Or (Up='COBJCALLSUPER');
 If LibId=3 Then Begin Tot:=0;Cv:='p';Sg:='';End
 Else If (Up='MEMDEREFDS') Or (Up='MEMDEREFES') Then Begin Tot:=0;Cv:='p';
 Sg:='';End
 Else If IsObj Then Begin
  ObjDecode(Up='COBJCALLSUPER',Top,OM);
  Tot:=OM.Total;Cv:='p';Sg:='';
 End Else If (Sg<>'?') And (Pos('.',Sg)=0) Then Begin
  Tot:=0;
  For I:=1 To Length(Sg) Do If Sg[I]='d' Then Inc(Tot,4) Else Inc(Tot,2);
 End Else Begin
  Tot:=Min2(RtCallPush,20)*2;
  If Pos('.',Sg)>0 Then Begin Cv:='c';Delete(Sg,Pos('.',Sg),1);Tot:=0;
  For I:=1 To Length(Sg) Do If Sg[I]='d' Then Inc(Tot,4) Else Inc(Tot,2);End
  Else Begin Sg:='';For I:=1 To Tot Div 2 Do Sg:=Sg+'w';End;
 End;
 If Cv='c' Then Begin
  { cdecl : l'appelant nettoie, on ne retire rien }
  N:=Tot;Tot:=Tot;
 End;
 Args:='';
 For I:=0 To Min2(Length(Sg),6)-1 Do Begin
  If Sg[I+1]='d' Then Args:=Args+HexW(ArgSeg(I))+':'+HexW(ArgW(I)) Else
      Args:=Args+HexW(ArgW(I));
  If I<Min2(Length(Sg),6)-1 Then Args:=Args+',';
 End;
 If IsObj Then Begin
  Args:='obj='+HexW(OM.Ohan)+':'+HexW(OM.Och)+' msg='+HexW(OM.Method)+' mpd='+
      HexW(OM.Mpd)+' cx='+HexW(OM.Cx)+' dx='+HexW(OM.Dx)+' bp='+HexW(OM.Bp);
  If OM.Super Then Args:=Args+' class='+HexW(OM.ClsSeg)+':'+HexW(OM.ClsOfs) Else
      Args:=Args+' flags='+HexW(OM.Flags);
  Inc(RtObjMsgs);RtLastObj:=OM;
 End;
 Reg[0]:=0;Reg[2]:=0;
 Fnd:=True;
 { ---- semantique ---- }
 If Up='MEMALLOC' Then Reg[0]:=RtAlloc(ArgW(0))
 Else If Up='MEMFREE' Then Begin I:=ArgW(0)-$0400;
 If (I>=1) And (I<=High(RtHan)) Then RtHan[I].Used:=False;End
 Else If Up='MEMLOCK' Then Reg[2]:=RtSeg(ArgW(0))
 Else If (Up='MEMUNLOCK') Or (Up='MEMDISCARD') Then
 Else If Up='MEMREALLOC' Then Begin
  Nw:=RtAlloc(ArgW(1));
  If (Nw<>0) And (RtSeg(ArgW(0))<>0) Then Begin
   For I:=0 To Min2(ArgW(1),RtHan[ArgW(0)-$0400].Par*16)-1 Do
       EMem^[Lin(RtSeg(Nw),I)]:=EMem^[Lin(RtSeg(ArgW(0)),I)];
   I:=ArgW(0)-$0400;If (I>=1) And (I<=High(RtHan)) Then RtHan[I].Used:=False;
  End;
  Reg[0]:=Nw;
 End
 Else If Up='MALLOC' Then Begin I:=RtAlloc(ArgW(0));
 If I<>0 Then Reg[2]:=RtSeg(I);End
 Else If Up='FREE' Then
 Else If Up='STRLEN' Then Begin
  V:=0;While (V<60000) And (M8(ArgSeg(0),Word(ArgW(0)+V))<>0) Do Inc(V);
  Reg[0]:=V;
 End
 Else If Up='STRCPY' Then Begin
  V:=0;
  While (V<60000) Do Begin
   W8(ArgSeg(0),Word(ArgW(0)+V),M8(ArgSeg(1),Word(ArgW(1)+V)));
   If M8(ArgSeg(1),Word(ArgW(1)+V))=0 Then Break;
   Inc(V);
  End;
  Reg[0]:=ArgW(0);Reg[2]:=ArgSeg(0);
 End
 Else If Up='STRCAT' Then Begin
  V:=0;While (V<60000) And (M8(ArgSeg(0),Word(ArgW(0)+V))<>0) Do Inc(V);
  N:=0;
  While (N<60000) Do Begin
   W8(ArgSeg(0),Word(ArgW(0)+V+N),M8(ArgSeg(1),Word(ArgW(1)+N)));
   If M8(ArgSeg(1),Word(ArgW(1)+N))=0 Then Break;
   Inc(N);
  End;
  Reg[0]:=ArgW(0);Reg[2]:=ArgSeg(0);
 End
 Else If Up='STRCMP' Then Begin
  V:=0;
  While (V<60000) And (M8(ArgSeg(0),Word(ArgW(0)+V))=M8(ArgSeg(1),
      Word(ArgW(1)+V))) And (M8(ArgSeg(0),Word(ArgW(0)+V))<>0) Do Inc(V);
  Reg[0]:=Word(Integer(M8(ArgSeg(0),Word(ArgW(0)+V)))-Integer(M8(ArgSeg(1),
      Word(ArgW(1)+V))));
 End
 Else If Up='STRCHR' Then Begin
  V:=0;
  While (V<60000) And (M8(ArgSeg(0),Word(ArgW(0)+V))<>0) And (M8(ArgSeg(0),
      Word(ArgW(0)+V))<>(ArgW(1) And 255)) Do Inc(V);
  If M8(ArgSeg(0),Word(ArgW(0)+V))=(ArgW(1) And 255) Then Begin
      Reg[0]:=Word(ArgW(0)+V);Reg[2]:=ArgSeg(0);End;
 End
 Else If Up='ATOI' Then Reg[0]:=Word(StrVal(TrimStr(RtCStr(ArgSeg(0),ArgW(0),
     12)),0))
 Else If Up='SPRINTF' Then Begin
  S:=Fmt(ArgSeg(1),ArgW(1),Word(Top+8));
  RtPutStr(ArgSeg(0),ArgW(0),S);Reg[0]:=Length(S);
  Args:=Args+'  "'+Copy(S,1,24)+'"';
 End
 Else If (Up='FILEPUSHDIR') Or (Up='FILEPOPDIR') Or (Up='FILESETSTANDARDPATH')
     Then
 Else If Up='FILESETCURRENTPATH' Then Begin
  S:=RtCStr(ArgSeg(1),ArgW(1),120);
  {$I-}
  If S<>'' Then ChDir(S);
  {$I+}
  If IOResult<>0 Then Begin Reg[0]:=1;End;
 End
 Else If Up='FILEOPEN' Then Begin
  S:=RtCStr(ArgSeg(0),ArgW(0),120);N:=RtFreeFile;
  If N=0 Then Reg[0]:=0
  Else Begin
   {$I-}
   Assign(RtFiles[N],S);FileMode:=2;Reset(RtFiles[N],1);
   {$I+}
   If IOResult=0 Then Begin RtFUsed[N]:=True;Reg[0]:=$0800+N;End Else Reg[0]:=0;
  End;
  Args:=Args+'  "'+Copy(S,1,24)+'"';
 End
 Else If Up='FILECREATE' Then Begin
  S:=RtCStr(ArgSeg(1),ArgW(1),120);N:=RtFreeFile;
  If N=0 Then Reg[0]:=0
  Else Begin
   {$I-}
   Assign(RtFiles[N],S);Rewrite(RtFiles[N],1);
   {$I+}
   If IOResult=0 Then Begin RtFUsed[N]:=True;Reg[0]:=$0800+N;End Else Reg[0]:=0;
  End;
  Args:=Args+'  "'+Copy(S,1,24)+'"';
 End
 Else If Up='FILECLOSE' Then Begin
  N:=ArgW(0)-$0800;
  If (N>=1) And (N<=High(RtFiles)) And RtFUsed[N] Then Begin {$I-}
      Close(RtFiles[N]);{$I+}If IOResult<>0 Then Begin End;RtFUsed[N]:=False;
  End;
 End
 Else If (Up='FILEREAD') Or (Up='FILEWRITE') Then Begin
  N:=ArgW(0)-$0800;
  If (N>=1) And (N<=High(RtFiles)) And RtFUsed[N] Then Begin
   V:=0;
   {$I-}
   If Up='FILEREAD' Then BlockRead(RtFiles[N],EMem^[Lin(ArgSeg(1),ArgW(1))],
       ArgW(2),V)
   Else BlockWrite(RtFiles[N],EMem^[Lin(ArgSeg(1),ArgW(1))],ArgW(2),V);
   {$I+}
   If IOResult<>0 Then V:=0;
   Reg[0]:=V;
  End Else Reg[0]:=0;
 End
 Else If Up='FILEPOS' Then Begin
  N:=ArgW(0)-$0800;
  If (N>=1) And (N<=High(RtFiles)) And RtFUsed[N] Then Begin
   L:=ArgW(1)+65536*LongInt(ArgSeg(1));
   {$I-}
   Case ArgW(2) Of
    0: Seek(RtFiles[N],L);
    1: Seek(RtFiles[N],FilePos(RtFiles[N])+L);
   Else Seek(RtFiles[N],FileSize(RtFiles[N])+L);
   End;
   L:=FilePos(RtFiles[N]);
   {$I+}
   If IOResult<>0 Then L:=0;
   Reg[0]:=Word(L And $FFFF);Reg[2]:=Word(L Shr 16);
  End;
 End
 Else If Up='FILEDELETE' Then Begin
  S:=RtCStr(ArgSeg(0),ArgW(0),120);
  {$I-}
  Assign(RtFiles[1],S);Erase(RtFiles[1]);
  {$I+}
  If IOResult<>0 Then Reg[0]:=2;
 End
 Else If Up='FILECREATEDIR' Then Begin
  S:=RtCStr(ArgSeg(0),ArgW(0),120);
  {$I-}
  MkDir(S);
  {$I+}
  If IOResult<>0 Then Reg[0]:=1;
  Args:=Args+'  "'+Copy(S,1,24)+'"';
 End
 Else If Up='USERSTANDARDDIALOG' Then Begin
  S:=RtCStr(ArgSeg(4),ArgW(4),160);
  ELogLine('  [DIALOG] '+S);
  Args:=Args+'  "'+Copy(S,1,24)+'"';
 End
 Else If Up='GRCREATESTATE' Then Reg[0]:=$4001
 Else If (LibId=3) And FpuLib(Up,Reg[2],Reg[0]) Then Begin End
 Else If RtApiExt(Up,Top,Sg,Tot,Reg[0],Reg[2]) Then Begin End
 Else If IsObj Then Begin
  If (OM.Ohan>=$0200) And (OM.Ohan<$0400) Then Begin
   N:=RtSendObj(OM.Ohan-$0200,OM.Och,False,OM.Super,OM.ClsSeg,OM.ClsOfs,
                OM.Method,OM.Cx,OM.Dx,OM.Bp,Nw,Rc_,Rd_,Rb_,Cd);
   If N=1 Then
    If ((OM.Flags And $8000)<>0) Or OM.Super Then
     ObjReturn(OM.Mpd,Nw,Rc_,Rd_,Rb_,Cd,Reg[0],Reg[2]);
  End;
 End
 Else Fnd:=Known And (Copy(Up,1,2)='GR');
 { ---- journal ---- }
 Logit:=(RtLogged<18) Or (Not Known);
 If Not Known Then Begin Inc(RtUnkCalls);Logit:=RtLogged<40;End
 Else If Not Fnd Then Logit:=RtLogged<30;
 If IsObj And (RtObjMsgs<=80) Then Logit:=True;
 If Logit Then Begin
  Inc(RtLogged);
  If Not Known Then ELogLine('  CALL ?? '+Nm+'('+Args+')')
  Else If Fnd Then ELogLine('  CALL '+Nm+'('+Args+')')
  Else ELogLine('  CALL '+Nm+'('+Args+')  [non emule]');
 End;
 EFl:=EFl And (Not FL_CF);
 RetFar;
 If Cv<>'c' Then Reg[4]:=Word(Reg[4]+Tot);
 RtPush:=0;
End;
{$ENDIF}

{ ====================================================================== }
{   MEMOIRE LMEM, TABLEAUX DE CHUNKS, FICHIERS VM ET HUGEARRAY           }
{   Emulation logicielle des routines de bibliotheque geos : les blocs   }
{   sont des blocs emules (RtAlloc) ; les blocs de ressources de la      }
{   geode (poignees $0200+n) gardent leur disposition de fichier.        }
{   En-tete LMem (mots) : 0 poignee, 2 decalage de la table des chunks,  }
{   6 type, 8 taille utilisee, 10 nombre de poignees de chunk.           }
{   Chunk : mot de taille a (decalage-2), donnees a partir du decalage.  }
{   Tableau de chunks : mots 0 nombre, 2 taille d'element (0 = variable, }
{   chaque element est precede de sa taille), 6 debut des elements.      }
{   HugeArray / bloc VM : un bloc emule unique : dword nombre, mot taille}
{   d'element, mot espace d'en-tete, puis les elements.                  }
{ ====================================================================== }
{$IFDEF FPC}
Const
 VM_MAXBLK = 96;
 VM_FILE   = $0A01;

Var
 VmBlk     : Array[1..VM_MAXBLK] Of Word;     { poignee de bloc emule ou 0 }
 VmMap     : Word;
 VmKind    : Array[1..VM_MAXBLK] Of Byte;     { 1 donnees, 2 lmem, 3 huge }

Function BlkCap(H: Word): LongInt;
Var I: Integer;
Begin
 BlkCap:=0;
 If (H>$0400) And (H<=$0400+High(RtHan)) Then Begin
  I:=H-$0400;
  If RtHan[I].Used Then BlkCap:=LongInt(RtHan[I].Par-1)*16;
 End Else If (H>=$0200) And (H<$0400) And (ELog<>Nil) Then
  If H-$0200<PGeodeWin(ELog^.Data)^.G.NS Then
   BlkCap:=PGeodeWin(ELog^.Data)^.G.Seg[H-$0200].Len;
End;

{ agrandit un bloc emule (le segment peut changer) }
Function BlkGrow(H: Word; NewSize: LongInt): Boolean;
Var I,J: Integer; N: Word; Cap: LongInt; T: TRtHan; Old: Word;
Begin
 BlkGrow:=False;
 Cap:=BlkCap(H);
 If NewSize<=Cap Then Begin BlkGrow:=True;Exit;End;
 If (H<=$0400) Or (H>$0400+High(RtHan)) Then Exit;
 I:=H-$0400;
 If NewSize<Cap*2 Then NewSize:=Cap*2;
 If NewSize>60000 Then NewSize:=60000;
 If NewSize<=Cap Then Exit;
 N:=RtAlloc(Word(NewSize));
 If N=0 Then Exit;
 J:=N-$0400;
 Old:=RtHan[I].Seg;
 Move(EMem^[Lin(Old,0)],EMem^[Lin(RtHan[J].Seg,0)],Cap);
 T:=RtHan[I];RtHan[I]:=RtHan[J];RtHan[J]:=T;
 RtHan[J].Used:=False;
 BlkGrow:=True;
End;

{ ---------------------- LMem ---------------------- }

Function LmNew(Typ,HdrSz: Word): Word;
Var H,Sg,HT: Word; I: Integer;
Begin
 LmNew:=0;
 H:=RtAlloc(4096);
 If H=0 Then Exit;
 Sg:=RtSeg(H);
 HT:=HdrSz;If HT<14 Then HT:=14;
 W16(Sg,0,H);W16(Sg,2,HT);W16(Sg,6,Typ);
 W16(Sg,10,32);W16(Sg,8,Word(HT+64));
 LmNew:=H;
End;

Function LmChunkOfs(H,Ch: Word): Word;
Var Sg,HT,N,O: Word;
Begin
 LmChunkOfs:=0;
 Sg:=RtSeg(H);
 If Sg=0 Then Exit;
 HT:=M16(Sg,2);N:=M16(Sg,10);
 If (Ch<HT) Or (Ch>=HT+2*N) Or Odd(Ch) Then Exit;
 O:=M16(Sg,Ch);
 If (O=0) Or (O=$FFFF) Or (O<4) Then Exit;
 LmChunkOfs:=O;
End;

Function LmSize(H,Ch: Word): Word;
Var O: Word;
Begin
 O:=LmChunkOfs(H,Ch);
 If O=0 Then LmSize:=0 Else LmSize:=M16(RtSeg(H),Word(O-2));
End;

Function LmAlloc(H,Size: Word): Word;
Var Sg,HT,N,K,Off,Need: Word; I: Integer;
Begin
 LmAlloc:=0;
 Sg:=RtSeg(H);
 If Sg=0 Then Exit;
 HT:=M16(Sg,2);N:=M16(Sg,10);
 K:=0;
 While (K<N) And (M16(Sg,Word(HT+2*K))<>0) And (M16(Sg,
     Word(HT+2*K))<>$FFFF) Do Inc(K);
 If K>=N Then Exit;
 Off:=Word(M16(Sg,8)+2);
 Need:=Word(Off+((Size+1) And $FFFE));
 If Need<Off Then Exit;
 If Not BlkGrow(H,LongInt(Need)+8) Then Exit;
 Sg:=RtSeg(H);
 For I:=0 To Size-1 Do W8(Sg,Word(Off+I),0);
 W16(Sg,Word(Off-2),Size);
 W16(Sg,Word(HT+2*K),Off);
 W16(Sg,8,Need);
 LmAlloc:=Word(HT+2*K);
End;

Procedure LmFree(H,Ch: Word);
Var Sg,HT,N: Word;
Begin
 Sg:=RtSeg(H);
 If Sg=0 Then Exit;
 HT:=M16(Sg,2);N:=M16(Sg,10);
 If (Ch>=HT) And (Ch<HT+2*N) And Not Odd(Ch) Then W16(Sg,Ch,0);
End;

{ change la taille d'un chunk ; le contenu est conserve }
Function LmResize(H,Ch,NewSz: Word): Boolean;
Var Sg,Off,Old,NOff,Need,I: Word;
Begin
 LmResize:=False;
 Off:=LmChunkOfs(H,Ch);
 If Off=0 Then Exit;
 Sg:=RtSeg(H);
 Old:=M16(Sg,Word(Off-2));
 If NewSz<=Old Then Begin
  W16(Sg,Word(Off-2),NewSz);LmResize:=True;Exit;
 End;
 If Word(Off+((Old+1) And $FFFE))=M16(Sg,8) Then Begin
  Need:=Word(Off+((NewSz+1) And $FFFE));
  If Not BlkGrow(H,LongInt(Need)+8) Then Exit;
  Sg:=RtSeg(H);
  For I:=Old To NewSz-1 Do W8(Sg,Word(Off+I),0);
  W16(Sg,Word(Off-2),NewSz);W16(Sg,8,Need);
  LmResize:=True;Exit;
 End;
 NOff:=Word(M16(Sg,8)+2);
 Need:=Word(NOff+((NewSz+1) And $FFFE));
 If Not BlkGrow(H,LongInt(Need)+8) Then Exit;
 Sg:=RtSeg(H);
 For I:=0 To NewSz-1 Do
  If I<Old Then W8(Sg,Word(NOff+I),M8(Sg,Word(Off+I))) Else W8(Sg,Word(NOff+I),
      0);
 W16(Sg,Word(NOff-2),NewSz);
 W16(Sg,Ch,NOff);W16(Sg,8,Need);
 LmResize:=True;
End;

{ ---------------------- tableaux de chunks ---------------------- }

Function CaStart(H,Ch: Word): Word;
Begin
 CaStart:=M16(RtSeg(H),Word(LmChunkOfs(H,Ch)+6));
End;

{ decalage (dans le chunk) de l'element N ; en variable : balaye les tailles }
Function CaElemOfs(H,Ch,N: Word; Var Sz: Word): Word;
Var Sg,Off,Es,K,P: Word;
Begin
 Sg:=RtSeg(H);Off:=LmChunkOfs(H,Ch);
 Es:=M16(Sg,Word(Off+2));P:=M16(Sg,Word(Off+6));
 If Es<>0 Then Begin Sz:=Es;CaElemOfs:=Word(P+N*Es);Exit;End;
 For K:=1 To N Do P:=Word(P+2+M16(Sg,Word(Off+P)));
 Sz:=M16(Sg,Word(Off+P));
 CaElemOfs:=Word(P+2);
End;

Function CaCreate(H,Ch,Es,HdrSz: Word): Word;
Var Sg,Off: Word;
Begin
 CaCreate:=0;
 If Ch=0 Then Ch:=LmAlloc(H,Word(8+HdrSz))
 Else If Not LmResize(H,Ch,Word(8+HdrSz)) Then Exit;
 If Ch=0 Then Exit;
 Sg:=RtSeg(H);Off:=LmChunkOfs(H,Ch);
 W16(Sg,Off,0);W16(Sg,Word(Off+2),Es);W16(Sg,Word(Off+4),0);
 W16(Sg,Word(Off+6),Word(8+HdrSz));
 CaCreate:=Ch;
End;

{ ajoute (ou insere en At, decalage dans le chunk ; 0 = fin) un element ;
  retourne le decalage de l'element dans le chunk, 0 si echec }
Function CaAdd(H,Ch,ElSz,At: Word): Word;
Var Sg,Off,Es,Cnt,Used,Pos,Sz,K: Word; Tail: Integer; Add: Word;
Begin
 CaAdd:=0;
 Off:=LmChunkOfs(H,Ch);
 If Off=0 Then Exit;
 Sg:=RtSeg(H);
 Es:=M16(Sg,Word(Off+2));Cnt:=M16(Sg,Off);
 If Es<>0 Then Begin ElSz:=Es;Add:=Es;End Else Add:=Word(ElSz+2);
 Used:=LmSize(H,Ch);
 If At=0 Then Pos:=Used Else Pos:=At;
 If Pos>Used Then Pos:=Used;
 If Not LmResize(H,Ch,Word(Used+Add)) Then Exit;
 Sg:=RtSeg(H);Off:=LmChunkOfs(H,Ch);
 { decalage de la queue }
 Tail:=Used-Pos;
 If Tail>0 Then
  Move(EMem^[Lin(Sg,Word(Off+Pos))],EMem^[Lin(Sg,Word(Off+Pos+Add))],Tail);
 For K:=0 To Add-1 Do W8(Sg,Word(Off+Pos+K),0);
 If Es=0 Then W16(Sg,Word(Off+Pos),ElSz);
 W16(Sg,Off,Word(Cnt+1));
 If Es=0 Then CaAdd:=Word(Pos+2) Else CaAdd:=Pos;
End;

Procedure CaDelEl(H,Ch,ElOfs: Word);
Var Sg,Off,Es,Used,Sz,Tail: Word; Start: Word;
Begin
 Off:=LmChunkOfs(H,Ch);
 If Off=0 Then Exit;
 Sg:=RtSeg(H);
 Es:=M16(Sg,Word(Off+2));Used:=LmSize(H,Ch);
 If Es<>0 Then Begin Sz:=Es;Start:=ElOfs;End
 Else Begin Sz:=Word(M16(Sg,Word(Off+ElOfs-2))+2);Start:=Word(ElOfs-2);End;
 If Word(Start+Sz)>Used Then Exit;
 Tail:=Used-Start-Sz;
 If Tail>0 Then
  Move(EMem^[Lin(Sg,Word(Off+Start+Sz))],EMem^[Lin(Sg,Word(Off+Start))],Tail);
 LmResize(H,Ch,Word(Used-Sz));
 Sg:=RtSeg(H);Off:=LmChunkOfs(H,Ch);
 W16(Sg,Off,Word(M16(Sg,Off)-1));
End;

{ ---------------------- fichiers VM, HugeArray ---------------------- }

Function VmNewBlock(Size: Word; Kind: Byte): Word;
Var I: Integer; H: Word;
Begin
 VmNewBlock:=0;
 H:=RtAlloc(Size);
 If H=0 Then Exit;
 For I:=1 To VM_MAXBLK Do
  If VmBlk[I]=0 Then Begin VmBlk[I]:=H;VmKind[I]:=Kind;VmNewBlock:=$0100+I*2;
  Exit;End;
End;

Function VmHandleOf(B: Word): Word;
Begin
 VmHandleOf:=0;
 If (B>=$0102) And (B<=$0100+VM_MAXBLK*2) And Not Odd(B) Then
  VmHandleOf:=VmBlk[(B-$0100) Div 2];
End;

Function HaCount(H: Word): LongInt;
Var Sg: Word;
Begin
 Sg:=RtSeg(H);
 HaCount:=M16(Sg,0)+65536*LongInt(M16(Sg,2));
End;

Procedure HaSetCount(H: Word; N: LongInt);
Var Sg: Word;
Begin
 Sg:=RtSeg(H);W16(Sg,0,Word(N And $FFFF));W16(Sg,2,Word(N Shr 16));
End;

{ routines de bibliotheque supplementaires ; True si traitee }
Function RtApiExt(Const Up: String; Top: Word; Const Sg: String;
                  Tot: Integer; Var RAx,RDx: Word): Boolean;
 Function AOfs(Idx: Integer): Word;
 Var J,C: Integer;
 Begin
  C:=0;
  For J:=1 To Idx+1 Do If Sg[J]='d' Then Inc(C,4) Else Inc(C,2);
  AOfs:=Word(Top+Tot-C);
 End;
 Function AW(Idx: Integer): Word;
 Begin
  AW:=M16(SegR[2],AOfs(Idx));
 End;
 Function AS_(Idx: Integer): Word;
 Begin
  AS_:=M16(SegR[2],Word(AOfs(Idx)+2));
 End;
Var H,Ch,Sz,E,K,Sgm,Es,Hs,Cnt: Word; L: LongInt; B: Word; Ok: Boolean;
Begin
 RtApiExt:=True;
 RAx:=0;RDx:=0;
 { ---- LMem ---- }
 If Up='MEMALLOCLMEM' Then RAx:=LmNew(AW(0),AW(1))
 Else If Up='LMEMALLOC' Then RAx:=LmAlloc(AW(0),AW(1))
 Else If Up='LMEMFREE' Then LmFree(AS_(0),AW(0))
 Else If Up='LMEMDEREF' Then Begin
  H:=AS_(0);Ch:=AW(0);E:=LmChunkOfs(H,Ch);
  If E<>0 Then Begin RAx:=E;RDx:=RtSeg(H);End;
 End
 Else If Up='LMEMREALLOC' Then Begin
  If LmResize(AS_(0),AW(0),AW(1)) Then RAx:=AW(0);
 End
 Else If Up='LMEMGETCHUNKSIZE' Then RAx:=LmSize(AS_(0),AW(0))
 Else If Up='LMEMINSERTAT' Then Begin
  H:=AS_(0);Ch:=AW(0);Sz:=LmSize(H,Ch);K:=AW(1);Cnt:=AW(2);
  If LmResize(H,Ch,Word(Sz+Cnt)) Then Begin
   Sgm:=RtSeg(H);E:=LmChunkOfs(H,Ch);
   If K<Sz Then Move(EMem^[Lin(Sgm,Word(E+K))],EMem^[Lin(Sgm,Word(E+K+Cnt))],
       Sz-K);
   For Hs:=0 To Cnt-1 Do W8(Sgm,Word(E+K+Hs),0);
   RAx:=Ch;
  End;
 End
 Else If Up='LMEMDELETEAT' Then Begin
  H:=AS_(0);Ch:=AW(0);Sz:=LmSize(H,Ch);K:=AW(1);Cnt:=AW(2);
  If (Sz>=K+Cnt) And (LmChunkOfs(H,Ch)<>0) Then Begin
   Sgm:=RtSeg(H);E:=LmChunkOfs(H,Ch);
   If Sz>K+Cnt Then Move(EMem^[Lin(Sgm,Word(E+K+Cnt))],EMem^[Lin(Sgm,
       Word(E+K))],Sz-K-Cnt);
   LmResize(H,Ch,Word(Sz-Cnt));
  End;
 End
 { ---- registres : MemDerefDS / MemDerefES ---- }
 Else If (Up='MEMDEREFDS') Or (Up='MEMDEREFES') Then Begin
  Sgm:=RtSeg(Reg[3]);
  If Up='MEMDEREFDS' Then SegR[3]:=Sgm Else SegR[0]:=Sgm;
 End
 Else If Up='MEMDEREF' Then Begin RDx:=RtSeg(AW(0));End
 { ---- tableaux de chunks ---- }
 Else If (Up='CHUNKARRAYCREATE') Or (Up='CHUNKARRAYCREATEAT') Then
  RAx:=CaCreate(AS_(0),AW(0),AW(1),AW(2))
 Else If Up='CHUNKARRAYELEMENTTOPTR' Then Begin
  H:=AS_(0);Ch:=AW(0);Sz:=0;
  If LmChunkOfs(H,Ch)<>0 Then Begin
   K:=AW(1);
   If K<M16(RtSeg(H),LmChunkOfs(H,Ch)) Then Begin
    E:=CaElemOfs(H,Ch,K,Sz);
    RAx:=Word(LmChunkOfs(H,Ch)+E);RDx:=RtSeg(H);
    If (AW(2)<>0) Or (AS_(2)<>0) Then W16(AS_(2),AW(2),Sz);
   End;
  End;
 End
 Else If Up='CHUNKARRAYAPPEND' Then Begin
  H:=AS_(0);Ch:=AW(0);
  E:=CaAdd(H,Ch,AW(1),0);
  If E<>0 Then Begin RAx:=Word(LmChunkOfs(H,Ch)+E);RDx:=RtSeg(H);End;
 End
 Else If Up='CHUNKARRAYINSERTAT' Then Begin
  H:=AS_(0);Ch:=AW(0);
  { le pointeur d'insertion est un decalage dans le segment du bloc }
  K:=0;
  If AS_(1)=RtSeg(H) Then K:=Word(AW(1)-LmChunkOfs(H,Ch));
  E:=CaAdd(H,Ch,AW(2),K);
  If E<>0 Then Begin RAx:=Word(LmChunkOfs(H,Ch)+E);RDx:=RtSeg(H);End;
 End
 Else If Up='CHUNKARRAYGETCOUNT' Then Begin
  E:=LmChunkOfs(AS_(0),AW(0));
  If E<>0 Then RAx:=M16(RtSeg(AS_(0)),E);
 End
 Else If Up='CHUNKARRAYGETELEMENT' Then Begin
  H:=AS_(0);Ch:=AW(0);Sz:=0;
  If (LmChunkOfs(H,Ch)<>0) And (AW(1)<M16(RtSeg(H),LmChunkOfs(H,Ch))) Then Begin
   E:=CaElemOfs(H,Ch,AW(1),Sz);
   Sgm:=RtSeg(H);
   For K:=0 To Sz-1 Do
    W8(AS_(2),Word(AW(2)+K),M8(Sgm,Word(LmChunkOfs(H,Ch)+E+K)));
  End;
 End
 Else If Up='CHUNKARRAYDELETE' Then Begin
  H:=AS_(0);Ch:=AW(0);
  If AS_(1)=RtSeg(H) Then CaDelEl(H,Ch,Word(AW(1)-LmChunkOfs(H,Ch)));
 End
 Else If Up='CHUNKARRAYPTRTOELEMENT' Then Begin
  H:=AS_(0);Ch:=AW(0);Es:=M16(RtSeg(H),Word(LmChunkOfs(H,Ch)+2));
  If (Es<>0) And (AS_(1)=RtSeg(H)) Then
   RAx:=Word((AW(1)-LmChunkOfs(H,Ch)-CaStart(H,Ch)) Div Es);
 End
 { ---- fichiers VM ---- }
 Else If Up='VMOPEN' Then RAx:=VM_FILE
 Else If (Up='VMCLOSE') Or (Up='VMUPDATE') Or (Up='VMSAVE') Then RAx:=0
 Else If Up='VMALLOC' Then RAx:=VmNewBlock(AW(1),1)
 Else If Up='VMALLOCLMEM' Then Begin
  B:=VmNewBlock(16,2);
  If B<>0 Then Begin
   H:=LmNew(AW(1),AW(2));
   If H<>0 Then Begin
    RtHan[(VmBlk[(B-$0100) Div 2])-$0400].Used:=False;
    VmBlk[(B-$0100) Div 2]:=H;
   End;
  End;
  RAx:=B;
 End
 Else If Up='VMLOCK' Then Begin
  H:=VmHandleOf(AW(0));
  If H<>0 Then Begin
   RAx:=0;RDx:=RtSeg(H);
   If (AW(1)<>0) Or (AS_(1)<>0) Then W16(AS_(1),AW(1),H);
  End;
 End
 Else If (Up='VMUNLOCK') Or (Up='VMDIRTY') Then
 Else If Up='VMFREE' Then Begin
  B:=AW(0);
  If VmHandleOf(B)<>0 Then VmBlk[(B-$0100) Div 2]:=0;
 End
 Else If Up='VMGETMAPBLOCK' Then RAx:=VmMap
 Else If Up='VMSETMAPBLOCK' Then VmMap:=AW(0)
 Else If (Up='VMGETATTRIBUTES') Or (Up='VMSETATTRIBUTES') Then RAx:=0
 Else If Up='VMMODIFYUSERID' Then
 { ---- HugeArray : un bloc emule unique ---- }
 Else If Up='HUGEARRAYCREATE' Then Begin
  B:=VmNewBlock(2048,3);
  If B<>0 Then Begin
   H:=VmHandleOf(B);Sgm:=RtSeg(H);
   W16(Sgm,4,AW(1));W16(Sgm,6,AW(2));
   RAx:=B;
  End;
 End
 Else If Up='HUGEARRAYDESTROY' Then Begin
  If VmHandleOf(AW(1))<>0 Then VmBlk[(AW(1)-$0100) Div 2]:=0;
 End
 Else If Up='HUGEARRAYGETCOUNT' Then Begin
  H:=VmHandleOf(AW(1));
  If H<>0 Then Begin L:=HaCount(H);RAx:=Word(L And $FFFF);RDx:=Word(L Shr 16);
  End;
 End
 Else If Up='HUGEARRAYLOCK' Then Begin
  H:=VmHandleOf(AW(1));
  If H<>0 Then Begin
   Sgm:=RtSeg(H);Es:=M16(Sgm,4);If Es=0 Then Es:=1;
   L:=AW(2)+65536*LongInt(AS_(2));
   If L<HaCount(H) Then Begin
    E:=Word(8+M16(Sgm,6)+L*Es);
    If (AW(3)<>0) Or (AS_(3)<>0) Then Begin
     W16(AS_(3),AW(3),E);W16(AS_(3),Word(AW(3)+2),Sgm);
    End;
    If (AW(4)<>0) Or (AS_(4)<>0) Then W16(AS_(4),AW(4),Es);
    RAx:=Word(HaCount(H)-L);RDx:=Word(L);
   End;
  End;
 End
 Else If (Up='HUGEARRAYUNLOCK') Or (Up='HUGEARRAYDIRTY') Then
 Else If Up='HUGEARRAYAPPEND' Then Begin
  H:=VmHandleOf(AW(1));Cnt:=AW(2);
  If H<>0 Then Begin
   Sgm:=RtSeg(H);Es:=M16(Sgm,4);If Es=0 Then Es:=1;
   L:=HaCount(H);
   If BlkGrow(H,8+M16(Sgm,6)+(L+Cnt)*Es+16) Then Begin
    Sgm:=RtSeg(H);
    If (AW(3)<>0) Or (AS_(3)<>0) Then
     For K:=0 To Cnt*Es-1 Do
      W8(Sgm,Word(8+M16(Sgm,6)+L*Es+K),M8(AS_(3),Word(AW(3)+K)));
    HaSetCount(H,L+Cnt);
    RAx:=Word(L And $FFFF);RDx:=Word(L Shr 16);
   End;
  End;
 End
 Else If (Up='HUGEARRAYREPLACE') Then Begin
  H:=VmHandleOf(AW(1));Cnt:=AW(2);
  If H<>0 Then Begin
   Sgm:=RtSeg(H);Es:=M16(Sgm,4);If Es=0 Then Es:=1;
   L:=AW(3)+65536*LongInt(AS_(3));
   If L+Cnt<=HaCount(H) Then
    For K:=0 To Cnt*Es-1 Do
     W8(Sgm,Word(8+M16(Sgm,6)+L*Es+K),M8(AS_(4),Word(AW(4)+K)));
  End;
 End
 Else If (Up='HUGEARRAYDELETE') Or (Up='HUGEARRAYINSERT') Then Begin
  H:=VmHandleOf(AW(1));Cnt:=AW(2);
  If H<>0 Then Begin
   Sgm:=RtSeg(H);Es:=M16(Sgm,4);If Es=0 Then Es:=1;
   If Up='HUGEARRAYDELETE' Then Begin
    L:=AW(3)+65536*LongInt(AS_(3));
    If L+Cnt<=HaCount(H) Then Begin
     Move(EMem^[Lin(Sgm,Word(8+M16(Sgm,6)+(L+Cnt)*Es))],
          EMem^[Lin(Sgm,Word(8+M16(Sgm,6)+L*Es))],(HaCount(H)-L-Cnt)*Es);
     HaSetCount(H,HaCount(H)-Cnt);
    End;
   End Else Begin
    L:=AW(3)+65536*LongInt(AS_(3));
    If (L<=HaCount(H)) And BlkGrow(H,8+M16(Sgm,
        6)+(HaCount(H)+Cnt)*Es+16) Then Begin
     Sgm:=RtSeg(H);
     Move(EMem^[Lin(Sgm,Word(8+M16(Sgm,6)+L*Es))],
          EMem^[Lin(Sgm,Word(8+M16(Sgm,6)+(L+Cnt)*Es))],(HaCount(H)-L)*Es);
     For K:=0 To Cnt*Es-1 Do
      W8(Sgm,Word(8+M16(Sgm,6)+L*Es+K),M8(AS_(4),Word(AW(4)+K)));
     HaSetCount(H,HaCount(H)+Cnt);
    End;
   End;
  End;
 End
 Else RtApiExt:=False;
End;
{$ENDIF}

{$IFDEF FPC}
Function Reg_Get(Wd: Boolean): Word;
Begin
 If Wd Then Reg_Get:=Reg[MReg] Else Reg_Get:=GetR8(MReg);
End;

Procedure Reg_Set(Wd: Boolean; V: Word);
Begin
 If Wd Then Reg[MReg]:=V Else SetR8(MReg,V And 255);
End;
{$ENDIF}

{$IFDEF FPC}
Procedure StrOp(Op: Byte);
Var Wd,Go: Boolean; St: Integer; A,B: LongInt; SrcSeg: Word;
Begin
 Wd:=(Op And 1)<>0;
 If Wd Then St:=2 Else St:=1;
 If (EFl And FL_DF)<>0 Then St:=-St;
 SrcSeg:=SegR[3];
 If SegOv>=0 Then SrcSeg:=SegR[SegOv];
 Go:=True;
 While Go Do Begin
  If (RepP<>0) And (Reg[1]=0) Then Exit;
  Case Op Of
   $A4,$A5: Begin
     If Wd Then W16(SegR[0],Reg[7],M16(SrcSeg,Reg[6])) Else W8(SegR[0],Reg[7],
         M8(SrcSeg,Reg[6]));
     Reg[6]:=Word(Reg[6]+St);Reg[7]:=Word(Reg[7]+St);
    End;
   $A6,$A7: Begin
     If Wd Then Begin A:=M16(SrcSeg,Reg[6]);B:=M16(SegR[0],Reg[7]);End
     Else Begin A:=M8(SrcSeg,Reg[6]);B:=M8(SegR[0],Reg[7]);End;
     Alu(7,A,B,Wd);
     Reg[6]:=Word(Reg[6]+St);Reg[7]:=Word(Reg[7]+St);
    End;
   $AA,$AB: Begin
     If Wd Then W16(SegR[0],Reg[7],Reg[0]) Else W8(SegR[0],Reg[7],
         Reg[0] And 255);
     Reg[7]:=Word(Reg[7]+St);
    End;
   $AC,$AD: Begin
     If Wd Then Reg[0]:=M16(SrcSeg,Reg[6]) Else SetR8(0,M8(SrcSeg,Reg[6]));
     Reg[6]:=Word(Reg[6]+St);
    End;
   $AE,$AF: Begin
     If Wd Then Begin A:=Reg[0];B:=M16(SegR[0],Reg[7]);
     End Else Begin A:=Reg[0] And 255;B:=M8(SegR[0],Reg[7]);End;
     Alu(7,A,B,Wd);
     Reg[7]:=Word(Reg[7]+St);
    End;
  End;
  If RepP=0 Then Go:=False
  Else Begin
   Reg[1]:=Reg[1]-1;
   If Op In [$A6,$A7,$AE,$AF] Then Begin
    If RepP=1 Then Go:=(EFl And FL_ZF)<>0 Else Go:=(EFl And FL_ZF)=0;
   End;
  End;
 End;
End;

Procedure Halt_(Const S: String);
Begin
 EHalt:=True;EReason:=S;
End;

Var RtSkips: Integer;

{ Opcode non gere : on le journalise et on continue (jamais d'arret net) }
Procedure RtSkip(Op: Byte);
Begin
 Inc(RtSkips);
 If RtSkips<=6 Then ELogLine('  ?? opcode '+HexB(Op)+' ignore @'+HexW(SegR[1])+
     ':'+HexW(Word(EIP-1)));
 If RtSkips>60 Then Halt_('opcodes inconnus en rafale');
End;

Procedure ExecOne;
Var Op: Byte; Wd,Pref: Boolean; V,V2,D: LongInt; Imm: Word; Cnt: Integer;
R,I: Integer; Tmp: Word;
    OldF: Word;
Begin
 If SegR[1]>=TRAP_KERNEL Then Begin
  If SegR[1]=TRAP_EXIT Then Begin
   Halt_(T3('entry point returned','retour du point d''entr'#130'e',
       'Einsprungpunkt zur'#129'ckgekehrt'));Exit;
  End;
  If SegR[1]=TRAP_KERNEL Then TrapCall(-1,EIP) Else TrapCall(SegR[1]-TRAP_LIB,
      EIP);
  Inc(ICount);Exit;
 End;
 SegOv:=-1;RepP:=0;
 Pref:=True;
 While Pref Do Begin
  Op:=F8;
  Case Op Of
   $26: SegOv:=0;
   $2E: SegOv:=1;
   $36: SegOv:=2;
   $3E: SegOv:=3;
   $F2: RepP:=2;
   $F3: RepP:=1;
   $F0: ;
  Else Pref:=False;
  End;
 End;
 Inc(ICount);
 RtTrack(Op);
 If Op<$40 Then Begin
  If (Op And 7)>=6 Then Begin
   If (Op=$06) Or (Op=$0E) Or (Op=$16) Or (Op=$1E) Then Push16(SegR[(Op Shr 3)
       And 3])
   Else If (Op=$07) Or (Op=$17) Or (Op=$1F) Then SegR[(Op Shr 3) And 3]:=Pop16
   Else RtSkip(Op);
   Exit;
  End;
  R:=(Op Shr 3) And 7;
  Wd:=(Op And 1)<>0;
  Case Op And 7 Of
   0,1: Begin ModRM;V:=Alu(R,GetRM(Wd),Reg_Get(Wd),Wd);If R<>7 Then SetRM(Wd,V);
   End;
   2,3: Begin ModRM;V:=Alu(R,Reg_Get(Wd),GetRM(Wd),Wd);
   If R<>7 Then Reg_Set(Wd,V);End;
   4: Begin V:=Alu(R,GetR8(0),F8,False);If R<>7 Then SetR8(0,V);End;
   5: Begin V:=Alu(R,Reg[0],F16,True);If R<>7 Then Reg[0]:=V;End;
  End;
  Exit;
 End;
 Case Op Of
  $40..$47: Begin
     I:=Op-$40;V:=Reg[I]+1;OldF:=EFl;
     SetFl(FL_OF,V=$8000);SetFl(FL_AF,(V And 15)=0);SetZSP(V,True);
     Reg[I]:=V And $FFFF;
    End;
  $48..$4F: Begin
     I:=Op-$48;V:=Reg[I]-1;
     SetFl(FL_OF,V=$7FFF);SetFl(FL_AF,(V And 15)=15);SetZSP(V And $FFFF,True);
     Reg[I]:=V And $FFFF;
    End;
  $50..$57: Begin I:=Op-$50;If I=4 Then Push16(Reg[4]-2) Else Push16(Reg[I]);
  End;
  $58..$5F: Begin I:=Op-$58;Tmp:=Pop16;If I<>4 Then Reg[I]:=Tmp;End;
  $60: Begin Tmp:=Reg[4];Push16(Reg[0]);Push16(Reg[1]);Push16(Reg[2]);
  Push16(Reg[3]);Push16(Tmp);Push16(Reg[5]);Push16(Reg[6]);Push16(Reg[7]);End;
  $61: Begin Reg[7]:=Pop16;Reg[6]:=Pop16;Reg[5]:=Pop16;Tmp:=Pop16;Reg[3]:=Pop16;
  Reg[2]:=Pop16;Reg[1]:=Pop16;Reg[0]:=Pop16;End;
  $68: Push16(F16);
  $6A: Push16(Word(SignB(F8)));
  $69,$6B: Begin
     ModRM;V:=SignW(GetRM(True));
     If Op=$69 Then V2:=SignW(F16) Else V2:=SignB(F8);
     V:=V*V2;
     Reg[MReg]:=Word(V And $FFFF);
     SetFl(FL_CF,(V<-32768) Or (V>32767));SetFl(FL_OF,(V<-32768) Or (V>32767));
    End;
  $70..$7F: Begin D:=SignB(F8);If Cond(Op And 15) Then EIP:=Word(EIP+D);End;
  $80..$83: Begin
     Wd:=(Op And 1)<>0;
     ModRM;
     If Op=$81 Then Imm:=F16 Else If Op=$83 Then Imm:=Word(SignB(F8)) Else
         Imm:=F8;
     If (Not Wd) Then Imm:=Imm And 255;
     V:=Alu(MReg,GetRM(Wd),Imm,Wd);
     If MReg<>7 Then SetRM(Wd,V);
    End;
  $84,$85: Begin Wd:=(Op And 1)<>0;ModRM;Alu(4,GetRM(Wd),Reg_Get(Wd),Wd);End;
  $86,$87: Begin
     Wd:=(Op And 1)<>0;ModRM;
     Tmp:=GetRM(Wd);SetRM(Wd,Reg_Get(Wd));Reg_Set(Wd,Tmp);
    End;
  $88,$89: Begin Wd:=(Op And 1)<>0;ModRM;SetRM(Wd,Reg_Get(Wd));End;
  $8A,$8B: Begin Wd:=(Op And 1)<>0;ModRM;Reg_Set(Wd,GetRM(Wd));End;
  $8C: Begin ModRM;SetRM(True,SegR[MReg And 3]);End;
  $8D: Begin ModRM;Reg[MReg]:=EAo;End;
  $8E: Begin ModRM;SegR[MReg And 3]:=GetRM(True);End;
  $8F: Begin ModRM;SetRM(True,Pop16);End;
  $90: ;
  $91..$97: Begin I:=Op-$90;Tmp:=Reg[0];Reg[0]:=Reg[I];Reg[I]:=Tmp;End;
  $98: If (Reg[0] And $80)<>0 Then Reg[0]:=Reg[0] Or $FF00 Else Reg[0]:=Reg[0]
      And $00FF;
  $99: If (Reg[0] And $8000)<>0 Then Reg[2]:=$FFFF Else Reg[2]:=0;
  $9A: Begin Imm:=F16;Tmp:=F16;Push16(SegR[1]);Push16(EIP);EIP:=Imm;
  SegR[1]:=Tmp;End;
  $9B: ;
  $9C: Push16(EFl Or $F002);
  $9D: EFl:=Pop16;
  $9E: EFl:=(EFl And $FF00) Or (Reg[0] Shr 8);
  $9F: Reg[0]:=(Reg[0] And $00FF) Or ((EFl And $FF) Shl 8) Or $0200;
  $A0..$A3: Begin
     Imm:=F16;Tmp:=SegR[3];If SegOv>=0 Then Tmp:=SegR[SegOv];
     Case Op Of
      $A0: SetR8(0,M8(Tmp,Imm));
      $A1: Reg[0]:=M16(Tmp,Imm);
      $A2: W8(Tmp,Imm,Reg[0] And 255);
      $A3: W16(Tmp,Imm,Reg[0]);
     End;
    End;
  $A4..$A7,$AA..$AF: StrOp(Op);
  $A8: Alu(4,GetR8(0),F8,False);
  $A9: Alu(4,Reg[0],F16,True);
  $B0..$B7: SetR8(Op-$B0,F8);
  $B8..$BF: Reg[Op-$B8]:=F16;
  $C0,$C1,$D0..$D3: Begin
     Wd:=(Op And 1)<>0;ModRM;
     If Op<=$C1 Then Cnt:=F8 Else If Op<=$D1 Then Cnt:=1 Else Cnt:=Reg[1]
         And 255;
     SetRM(Wd,Shift(MReg,GetRM(Wd),Cnt,Wd));
    End;
  $C2: Begin Imm:=F16;EIP:=Pop16;Reg[4]:=Reg[4]+Imm;End;
  $C3: EIP:=Pop16;
  $C4,$C5: Begin
     ModRM;Reg[MReg]:=M16(EAs,EAo);
     If Op=$C4 Then SegR[0]:=M16(EAs,Word(EAo+2)) Else SegR[3]:=M16(EAs,
         Word(EAo+2));
    End;
  $C6,$C7: Begin Wd:=(Op And 1)<>0;ModRM;
  If Wd Then SetRM(True,F16) Else SetRM(False,F8);End;
  $C8: Begin Imm:=F16;F8;Push16(Reg[5]);Reg[5]:=Reg[4];Reg[4]:=Reg[4]-Imm;End;
  $C9: Begin Reg[4]:=Reg[5];Reg[5]:=Pop16;End;
  $CA: Begin Imm:=F16;RetFar;Reg[4]:=Reg[4]+Imm;End;
  $CB: RetFar;
  $CC: Halt_('INT3');
  $CD: Begin
     V:=F8;
     If (V>=$34) And (V<=$3B) Then FpuOp(V-$34)
     Else If V=$3C Then Begin
      { prefixe de segment pour l'instruction flottante suivante }
      V:=F8;SegOv:=(V Shr 3) And 3;
      V:=F8;V:=F8;
      If (V>=$34) And (V<=$3B) Then FpuOp(V-$34);
     End Else If V<>$3D Then Halt_('INT '+HexB(V));
    End;
  $CF: Begin EIP:=Pop16;SegR[1]:=Pop16;EFl:=Pop16;End;
  $D7: SetR8(0,M8(SegR[3],Word(Reg[3]+(Reg[0] And 255))));
  $E0..$E2: Begin
     D:=SignB(F8);Reg[1]:=Reg[1]-1;
     If (Reg[1]<>0) And ((Op=$E2) Or ((Op=$E1) And ((EFl And FL_ZF)<>0))
         Or ((Op=$E0) And ((EFl And FL_ZF)=0))) Then EIP:=Word(EIP+D);
    End;
  $E3: Begin D:=SignB(F8);If Reg[1]=0 Then EIP:=Word(EIP+D);End;
  $D8..$DF: FpuOp(Op-$D8);
  $E4..$E7: F8;
  $E8: Begin D:=SignW(F16);Push16(EIP);EIP:=Word(EIP+D);End;
  $E9: Begin D:=SignW(F16);EIP:=Word(EIP+D);End;
  $EA: Begin Imm:=F16;Tmp:=F16;EIP:=Imm;SegR[1]:=Tmp;End;
  $EB: Begin D:=SignB(F8);EIP:=Word(EIP+D);End;
  $EC..$EF: ;
  $F4: Halt_('HLT');
  $F5: EFl:=EFl Xor FL_CF;
  $F6,$F7: Begin
     Wd:=(Op And 1)<>0;ModRM;
     Case MReg Of
      0,1: Begin If Wd Then Alu(4,GetRM(True),F16,True) Else Alu(4,GetRM(False),
          F8,False);End;
      2: SetRM(Wd,Not GetRM(Wd));
      3: Begin V:=Alu(5,0,GetRM(Wd),Wd);SetRM(Wd,V);End;
      4,5: Begin
         If Wd Then Begin
          If MReg=4 Then V:=LongInt(Reg[0])*GetRM(True) Else
              V:=SignW(Reg[0])*SignW(GetRM(True));
          Reg[0]:=V And $FFFF;Reg[2]:=(V Shr 16) And $FFFF;
          SetFl(FL_CF,Reg[2]<>0);SetFl(FL_OF,Reg[2]<>0);
         End Else Begin
          If MReg=4 Then V:=(Reg[0] And 255)*GetRM(False) Else V:=SignB(Reg[0]
              And 255)*SignB(GetRM(False));
          Reg[0]:=V And $FFFF;SetFl(FL_CF,(Reg[0] Shr 8)<>0);
          SetFl(FL_OF,(Reg[0] Shr 8)<>0);
         End;
        End;
      6,7: Begin
         If Wd Then Begin
          V:=GetRM(True);
          If V=0 Then Begin Halt_('divide error');Exit;End;
          If MReg=6 Then Begin
           V2:=(LongInt(Reg[2]) Shl 16) Or Reg[0];
           If (V2 Shr 16)>=V Then Begin Halt_('divide overflow');Exit;End;
           Reg[0]:=(V2 Div V) And $FFFF;Reg[2]:=(V2 Mod V) And $FFFF;
          End Else Begin
           V2:=(LongInt(Reg[2]) Shl 16) Or Reg[0];V:=SignW(V);
           Reg[0]:=(V2 Div V) And $FFFF;Reg[2]:=(V2 Mod V) And $FFFF;
          End;
         End Else Begin
          V:=GetRM(False);
          If V=0 Then Begin Halt_('divide error');Exit;End;
          If MReg=6 Then Begin
           V2:=Reg[0];
           SetR8(0,(V2 Div V) And 255);SetR8(4,(V2 Mod V) And 255);
          End Else Begin
           V2:=SignW(Reg[0]);V:=SignB(V);
           SetR8(0,(V2 Div V) And 255);SetR8(4,(V2 Mod V) And 255);
          End;
         End;
        End;
     End;
    End;
  $F8: EFl:=EFl And (Not FL_CF);
  $F9: EFl:=EFl Or FL_CF;
  $FA: EFl:=EFl And (Not FL_IF);
  $FB: EFl:=EFl Or FL_IF;
  $FC: EFl:=EFl And (Not FL_DF);
  $FD: EFl:=EFl Or FL_DF;
  $FE: Begin
     ModRM;V:=GetRM(False);
     If MReg=0 Then Begin V:=V+1;SetFl(FL_OF,V=$80);End Else Begin V:=V-1;
     SetFl(FL_OF,V=$7F);End;
     SetZSP(V And 255,False);SetRM(False,V And 255);
    End;
  $FF: Begin
     ModRM;
     Case MReg Of
      0: Begin V:=GetRM(True)+1;SetFl(FL_OF,V=$8000);SetZSP(V And $FFFF,True);
      SetRM(True,V And $FFFF);End;
      1: Begin V:=GetRM(True)-1;SetFl(FL_OF,V=$7FFF);SetZSP(V And $FFFF,True);
      SetRM(True,V And $FFFF);End;
      2: Begin Tmp:=GetRM(True);Push16(EIP);EIP:=Tmp;End;
      3: Begin Imm:=M16(EAs,EAo);Tmp:=M16(EAs,Word(EAo+2));Push16(SegR[1]);
      Push16(EIP);EIP:=Imm;SegR[1]:=Tmp;End;
      4: EIP:=GetRM(True);
      5: Begin Imm:=M16(EAs,EAo);Tmp:=M16(EAs,Word(EAo+2));EIP:=Imm;
      SegR[1]:=Tmp;End;
      6: Push16(GetRM(True));
     Else Halt_('FF /7');
     End;
    End;
 Else RtSkip(Op);
 End;
End;
{$ENDIF}

Function GwNew(AX,AY: Integer; Const APath: String): PWindow;
 Var Wd_: PWindow; Dt_: PGeodeWin;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_GEODE,AX,AY,580,390,'Geode');
 Wd_^.IconId:=IC_GEOS;Wd_^.MinW:=300;Wd_^.MinH:=200;
 Dt_^.NL:=0;Dt_^.Top:=1;Dt_^.Drag:=False;
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Emulator~'#144'mulateur~Emulator');
 WinAddItem(Wd_,'Run~Ex'#130'cuter~Ausf'#129'hren',CM_GRUN,'F9');
 WinAddItem(Wd_,'Reset~R'#130'initialiser~Zur'#129'cksetzen',CM_GRESET,'');
 WinAddItem(Wd_,'Show Information~Afficher les '+
     'informations~Informationen anzeigen',CM_GREPORT,'');
 WinAddMenu(Wd_,'Window~Fen'#136'tre~Fenster');
 WinAddItem(Wd_,'Tile~Mosa'#139'que~Kacheln',CM_TILE,'');
 WinAddItem(Wd_,'Overlap~Cascade~'#154'berlappend',CM_OVERLAP,'');
 If ParseGeode(APath,Dt_^.G) Then Wd_^.Title:='Geode - '+Dt_^.G.Info.LongName
 Else Begin
  Dt_^.G.Path:=APath;
  ReadGeosHeader(APath,Dt_^.G.Info);
  Wd_^.Title:='GEOS - '+ShortName(APath);
 End;
 GwReport(Wd_);
 GwNew:=Wd_;
End;

Procedure GwDone(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Begin
 Dt_:=Wd_^.Data;
 GwClearLines(Wd_);
End;


{ Enregistre le journal dans GEOEMU.LOG (repertoire courant) }
Procedure GwSaveLog(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var F: Text; I: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,JoinPath(HomeDir,'GEOEMU.LOG'));Rewrite(F);
 For I:=1 To Dt_^.NL Do WriteLn(F,Dt_^.Ln[I]^);
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

{ Rapport statique : ordinaux importes par le geode, identifies ou non }
{ Inventaire des blocs d'objets (resources LMem de type objet) : le premier mot
  de
  chaque chunk-objet est un ObjRelocationID (source sur 4 bits, index sur 12)
    suivi du
  numero d'entree ; source 3 = classe d'une bibliotheque importee (index =
    bibliotheque,
  entree = ordinal dans la table des exportations), source 6 = classe de la
    geode. }
Procedure RtObjects(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var I,K,N,J,NC,NB: Integer; Sg,HT,Off,Sz,Rid,Ent: Word; Src: Integer;
Nm: String; Cl: Array[1..48] Of String[26];
    Cc: Array[1..48] Of Integer; S: String; LbName: String;
Begin
 Dt_:=Wd_^.Data;
 NC:=0;NB:=0;
 For I:=1 To Dt_^.G.NS-1 Do Begin
  Sg:=SegPara[I];
  If (M16(Sg,6)=2) And (M16(Sg,2)>=$10) And (M16(Sg,2)<$100) And (M16(Sg,
      10)<=400) Then Begin
   Inc(NB);
   HT:=M16(Sg,2);N:=M16(Sg,10);
   For K:=0 To N-1 Do Begin
    Off:=M16(Sg,Word(HT+2*K));
    If (Off=0) Or (Off=$FFFF) Or (Off<4) Then Continue;
    Sz:=M16(Sg,Word(Off-2));
    If (Sz<8) Or (Sz>$400) Then Continue;
    Rid:=M16(Sg,Off);Ent:=M16(Sg,Word(Off+2));Src:=Rid Shr 12;
    Nm:='';
    If (Src=3) And ((Rid And $FFF)<Dt_^.G.NL) Then Begin
     LbName:=TrimStr(Dt_^.G.Libs[Rid And $FFF].Name);
     Nm:=RtField(RtEntry(RtLibId(LbName),Ent),0);
     If Nm='' Then Nm:=LbName+'#'+IntStr(Ent);
    End Else If (Src=6) And ((Rid And $FFF)=0) And (Ent<20) Then
        Nm:='app#'+IntStr(Ent);
    If Nm<>'' Then Begin
     J:=1;While (J<=NC) And (Cl[J]<>Nm) Do Inc(J);
     If J>NC Then Begin If NC<48 Then Begin Inc(NC);Cl[NC]:=Nm;Cc[NC]:=0;J:=NC;
     End Else J:=0;End;
     If J>0 Then Inc(Cc[J]);
    End;
   End;
  End;
 End;
 If NB=0 Then Exit;
 GwAdd(Wd_,T3('Object blocks: ','Blocs d''objets : ',
     'Objektbl'#148'cke: ')+IntStr(NB)+T3(', classes used:',
     ', classes utilis'#130'es :',', verwendete Klassen:'));
 S:='';
 For J:=1 To NC Do Begin
  If Length(S)+Length(Cl[J])>56 Then Begin GwAdd(Wd_,'  '+S);S:='';End;
  S:=S+Cl[J]+'('+IntStr(Cc[J])+') ';
 End;
 If S<>'' Then GwAdd(Wd_,'  '+S);
End;

Procedure OtShow(Wd_: PWindow); Forward;

{ Auto-test du coprocesseur (GEOFPUTEST=1) : sqrt(2), atan(1)*4, 7/2 -> entier }
Procedure FpuSelfTest(Wd_: PWindow);
Const Code: Array[0..43] Of Byte = (
 $CD,$35,$E8, $CD,$35,$E8, $CD,$3A,$C1, $CD,$35,$FA, $CD,$39,$1E,$00,$01,
 $CD,$35,$E8, $CD,$35,$FB,
 $CD,$35,$E8, $CD,$38,$36,$10,$01, $CD,$39,$1E,$20,$01,
 $CD,$37,$06,$30,$01, $CB, $90, $90);
Var I: Integer; D: Double; L: LongInt; S: Word;
Begin
 S:=$9100;
 For I:=0 To High(Code) Do W8(S,I,Code[I]);
 { 3.5 en $0110 (double) : ecrit directement }
 D:=3.5;Move(D,EMem^[Lin(S,$110)],8);
 L:=1234567;Move(L,EMem^[Lin(S,$130)],4);
 FillChar(Reg,SizeOf(Reg),0);
 SegR[0]:=S;SegR[1]:=S;SegR[2]:=$9000;SegR[3]:=S;
 Reg[4]:=$FFF0;EIP:=0;EFl:=$0202;
 Push16(TRAP_EXIT);Push16(0);
 EHalt:=False;ICount:=0;FpuInit;
 I:=0;
 While (Not EHalt) And (I<200) Do Begin ExecOne;Inc(I);End;
 Move(EMem^[Lin(S,$100)],D,8);
 GwAdd(Wd_,'FPU test: sqrt(2) = '+FmtReal(D)+'  ('+EReason+')');
 Move(EMem^[Lin(S,$120)],D,8);
 GwAdd(Wd_,'FPU test: 1/3.5 = '+FmtReal(D));
 GwAdd(Wd_,'FPU test: ST(0) fild(1234567) -> '+FmtReal(FpuReg(0)));
End;

{ Auto-test des routines LMem / tableaux de chunks / HugeArray (GEOFPUTEST) }
Procedure ApiSelfTest(Wd_: PWindow);
Var Ax,Dx: Word; Hd,Ch,Hv,Hb: Word; Ok: Boolean; Sg: Word; I: Integer;

 { appelle une routine pascal : Args = mots dans l'ordre de declaration
   (un dword = mot bas puis mot haut) ; Sig = signature }
 Procedure Call(Const Up,Sig: String; Const Args: Array Of Word);
 Var K,Tot,Wi,C: Integer; Top: Word;
 Begin
  Tot:=0;
  For K:=1 To Length(Sig) Do If Sig[K]='d' Then Inc(Tot,4) Else Inc(Tot,2);
  Reg[4]:=$FF00;SegR[2]:=$9000;
  Top:=Word(Reg[4]);
  Wi:=0;C:=0;
  For K:=1 To Length(Sig) Do Begin
   If Sig[K]='d' Then Inc(C,4) Else Inc(C,2);
   W16($9000,Word(Top+Tot-C),Args[Wi]);Inc(Wi);
   If Sig[K]='d' Then Begin W16($9000,Word(Top+Tot-C+2),Args[Wi]);Inc(Wi);End;
  End;
  Ax:=0;Dx:=0;
  RtApiExt(Up,Top,Sig,Tot,Ax,Dx);
 End;

Begin
 Hd:=0;
 { dword = (bas, haut) : l'optr est (chunk, handle) }
 Call('MEMALLOCLMEM','ww',[0,0]);Hd:=Ax;
 Call('CHUNKARRAYCREATE','dwww',[0,Hd,4,0,0]);Ch:=Ax;
 Call('CHUNKARRAYAPPEND','dw',[Ch,Hd,4]);
 If (Ax<>0) Or (Dx<>0) Then Begin W16(Dx,Ax,$1111);W16(Dx,Word(Ax+2),$2222);End;
 Call('CHUNKARRAYAPPEND','dw',[Ch,Hd,4]);
 If (Ax<>0) Or (Dx<>0) Then Begin W16(Dx,Ax,$3333);W16(Dx,Word(Ax+2),$4444);End;
 Call('CHUNKARRAYGETCOUNT','d',[Ch,Hd]);
 GwAdd(Wd_,'ChunkArray test: count='+IntStr(Ax)+' (attendu 2)');
 Call('CHUNKARRAYELEMENTTOPTR','dwd',[Ch,Hd,1,0,0]);
 GwAdd(Wd_,'ChunkArray test: element 1 = '+HexW(M16(Dx,Ax))+':'+HexW(M16(Dx,
     Word(Ax+2)))+' (attendu 3333:4444)');
 { HugeArray }
 Call('VMOPEN','dwww',[0,0,0,0,0,0]);
 Call('HUGEARRAYCREATE','www',[Ax,2,0]);Hb:=Ax;
 W16($9100,$200,$ABCD);
 Call('HUGEARRAYAPPEND','wwwd',[VM_FILE,Hb,1,$0200,$9100]);
 Call('HUGEARRAYAPPEND','wwwd',[VM_FILE,Hb,1,$0200,$9100]);
 Call('HUGEARRAYGETCOUNT','ww',[VM_FILE,Hb]);
 GwAdd(Wd_,'HugeArray test: count='+IntStr(Ax)+' (attendu 2)');
 Call('HUGEARRAYLOCK','wwddd',[VM_FILE,Hb,1,0,$0300,$9100,$0310,$9100]);
 GwAdd(Wd_,'HugeArray test: lock -> '+HexW(M16($9100,
     $300))+' size '+HexW(M16($9100,$310)));
End;

Procedure RtCoverage(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var I,J,L,Known,Tot: Integer; T: TRtSeen; S,E,Nm: String;
Begin
 Dt_:=Wd_^.Data;
 For I:=2 To RtNSeen Do Begin
  T:=RtSeen[I];J:=I-1;
  While (J>=1) And ((RtSeen[J].Lb>T.Lb) Or ((RtSeen[J].Lb=T.Lb)
      And (RtSeen[J].Ord_>T.Ord_))) Do Begin RtSeen[J+1]:=RtSeen[J];Dec(J);End;
  RtSeen[J+1]:=T;
 End;
 Known:=0;Tot:=RtNSeen;
 For I:=1 To RtNSeen Do Begin
  L:=RtSeen[I].Lb;
  If L<Dt_^.G.NL Then E:=RtEntry(RtLibId(Dt_^.G.Libs[L].Name),
      RtSeen[I].Ord_) Else E:='';
  If E<>'' Then Inc(Known);
 End;
 GwAdd(Wd_,T3('Imported routines: ','Routines import'#130'es : ',
     'Importierte Routinen: ')+IntStr(Tot)+
   T3(' distinct, named: ',' distinctes, nomm'#130'es : ',
       ' verschiedene, benannt: ')+IntStr(Known)+
   ' ('+IntStr(Known*100 Div Max2(1,Tot))+' %)');
 S:='';
 For I:=1 To RtNSeen Do Begin
  L:=RtSeen[I].Lb;
  If L<Dt_^.G.NL Then E:=RtEntry(RtLibId(Dt_^.G.Libs[L].Name),
      RtSeen[I].Ord_) Else E:='';
  If E<>'' Then Nm:=RtField(E,0) Else Nm:='??'+IntStr(RtSeen[I].Ord_);
  If L<Dt_^.G.NL Then Nm:=TrimStr(Dt_^.G.Libs[L].Name)+'.'+Nm;
  If Length(S)+Length(Nm)>62 Then Begin GwAdd(Wd_,'  '+S);S:='';End;
  S:=S+Nm+'('+IntStr(RtSeen[I].Cnt)+') ';
 End;
 If S<>'' Then GwAdd(Wd_,'  '+S);
 RtObjects(Wd_);
End;

{ Execute un point d'entree synthetique et journalise ce qui se passe }
Procedure RtRunOne(Wd_: PWindow; Const Lbl: String; SegE,
    OfsE: Word; Budget: LongInt);
 Var Dt_: PGeodeWin;
Var I: Integer; C0,U0: LongInt; Stp: LongInt; DbgN: Integer;
Begin
 Dt_:=Wd_^.Data;
 ELog:=Wd_;
 If GetEnv('GEODEBUG')<>'' Then DbgN:=StrVal(GetEnv('GEODEBUG'),
     60) Else DbgN:=0;
 FillChar(Reg,SizeOf(Reg),0);
 SegR[0]:=SegPara[Min2(1,Dt_^.G.NS-1)];SegR[3]:=SegR[0];SegR[2]:=$9000;
 SegR[1]:=SegE;
 Reg[4]:=$FFF0;Reg[5]:=0;EIP:=OfsE;EFl:=$0202;
 For I:=1 To 12 Do Push16(0);
 Push16(TRAP_EXIT);Push16(0);
 EHalt:=False;EReason:='';ICount:=0;RtPush:=0;RtLogged:=0;RtSkips:=0;
 C0:=RtCalls;U0:=RtUnkCalls;
 GwAdd(Wd_,'> '+Lbl+'  '+HexW(SegE)+':'+HexW(OfsE));
 Stp:=0;
 While (Not EHalt) And (Stp<Budget) Do Begin
  If (Stp<DbgN) Then ELogLine('    '+HexW(SegR[1])+':'+HexW(EIP)+' '+
      HexB(M8(SegR[1],EIP))+HexB(M8(SegR[1],Word(EIP+1)))+HexB(M8(SegR[1],
      Word(EIP+2)))+' sp='+HexW(Reg[4]));
  ExecOne;Inc(Stp);
 End;
 If Not EHalt Then EReason:=T3('instruction budget','limite d''instructions',
     'Befehlslimit');
 GwAdd(Wd_,'  = '+EReason+'  ('+NumFmt(ICount)+' '+T3('instr.','instr.',
     'Bef.')+', '+IntStr(RtCalls-C0)+' '+T3('API calls','appels API',
     'API-Aufrufe')+
      ', '+IntStr(RtUnkCalls-U0)+' '+T3('unknown','inconnus','unbekannt')+')');
End;

{ Pour une application dont le code n'est atteint que par le systeme d'objets :
  on execute chaque methode de la classe de processus et chaque exportation. }
Procedure RtExercise(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var I,N: Integer; CS_,CO,MSeg: Word; Msg,Ho,Hs: Word;
Begin
 Dt_:=Wd_^.Data;
 GwAdd(Wd_,T3('--- object-system methods of '+
     'the process class (exercised one '+'by one) ---',
     '--- m'#130'thodes de la classe de processus (ex'#130'cut'#130+
     'es une par une) ---','--- Methoden der Prozessklasse (einzeln ausgef'#129+
     'hrt) ---'));
 If (Dt_^.G.Attr And $8000)<>0 Then Begin
  If Dt_^.G.ProcRes<Dt_^.G.NS Then Begin
   CS_:=SegPara[Dt_^.G.ProcRes];CO:=Dt_^.G.ProcOfs;
   N:=M16(CS_,Word(CO+6));
   GwAdd(Wd_,T3('Class struct at ','Classe en ',
       'Klasse bei ')+HexW(CS_)+':'+HexW(CO)+T3(', methods: ',
       ', m'#130'thodes : ',', Methoden: ')+IntStr(N));
   If (N>0) And (N<60) Then
    For I:=0 To N-1 Do Begin
     Msg:=M16(CS_,Word(CO+16+I*2));
     Ho:=M16(CS_,Word(CO+16+N*2+I*4));Hs:=M16(CS_,Word(CO+16+N*2+I*4+2));
     RtRunOne(Wd_,'MSG '+HexW(Msg),Hs,Ho,40000);
    End;
  End;
 End;
 If Dt_^.G.AType<>1 Then
 For I:=0 To Dt_^.G.NE-1 Do
  If Dt_^.G.Exp[I].Res<Dt_^.G.NS Then
   RtRunOne(Wd_,T3('export ','export ','Export ')+IntStr(I),
       SegPara[Dt_^.G.Exp[I].Res],Dt_^.G.Exp[I].Ofs,40000);
 GwAdd(Wd_,T3('Total API calls: ','Appels API : ',
     'API-Aufrufe: ')+IntStr(RtCalls)+T3(', unknown: ',', inconnus : ',
     ', unbekannt: ')+IntStr(RtUnkCalls));
 GwSaveLog(Wd_);
End;

{$IFDEF FPC}
Procedure GwEmulate(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var F: File; I,J,K,Cnt,Fx,Typ,Lb,Cn: Integer; Nx: LongInt; Ofs,Cur,Tmp: Word;
Buf: Pointer;
    Rel: Array[0..255] Of Word; N: Word; Cnts: Array[0..15] Of Integer;
    RelPos,P: LongInt;
    EntR,EntO: Word; Ok: Boolean; Steps: LongInt;
Begin
 Dt_:=Wd_^.Data;
 If Not Dt_^.G.Valid Then Begin GwAdd(Wd_,'No loadable geode.');Exit;End;
 GwAdd(Wd_,'');
 GwAdd(Wd_,'---------------- '+T3('PC/GEOS EMULATION','EMULATION PC/GEOS',
     'PC/GEOS-EMULATION')+' ----------------');
 If EMem=Nil Then GetMem(EMem,SizeOf(TEMem));
 FillChar(EMem^,SizeOf(TEMem),0);
 FpuInit;
 RtNUser:=0;RtNSeen:=0;RtHeapTop:=$A000;FillChar(RtHan,SizeOf(RtHan),0);
 RtCalls:=0;RtUnkCalls:=0;
 RtLoadSls(JoinPath(BaseDir,'GEOS2.SLS'));
 RtLoadSls(JoinPath(HomeDir,'GEOS2.SLS'));
 FillChar(Cnts,SizeOf(Cnts),0);
 If GetEnv('GEOFPUTEST')<>'' Then Begin FpuSelfTest(Wd_);ApiSelfTest(Wd_);End;
 FillChar(RtHan,SizeOf(RtHan),0);RtHeapTop:=$A000;
 Nx:=$0200;
 For I:=0 To Dt_^.G.NS-1 Do Begin
  SegPara[I]:=Nx;
  Nx:=Nx+((LongInt(Dt_^.G.Seg[I].Len)+15) Shr 4)+1;
  If Nx>$8F00 Then Begin GwAdd(Wd_,T3('Out of emulated memory.',
      'M'#130'moire '#130'mul'#130'e insuffisante.',
      'Emulierter Speicher voll.'));Exit;End;
 End;
 {$I-}
 Assign(F,Dt_^.G.Path);FileMode:=0;Reset(F,1);
 {$I+}
 If IOResult<>0 Then Begin GwAdd(Wd_,'Cannot open file.');Exit;End;
 GetMem(Buf,4096);
 For I:=0 To Dt_^.G.NS-1 Do Begin
  {$I-}
  Seek(F,Dt_^.G.Seg[I].Pos);
  K:=0;
  While K<Dt_^.G.Seg[I].Len Do Begin
   Cnt:=Min2(4096,Dt_^.G.Seg[I].Len-K);
   BlockRead(F,Buf^,Cnt,N);
   For J:=0 To N-1 Do EMem^[Lin(SegPara[I],K+J)]:=PByteArr(Buf)^[J];
   Inc(K,Cnt);
  End;
  {$I+}
  If IOResult<>0 Then Begin End;
 End;
 { relogements }
 For I:=0 To Dt_^.G.NS-1 Do Begin
  RelPos:=Dt_^.G.Seg[I].Pos+((LongInt(Dt_^.G.Seg[I].Len)+15)
      And LongInt($FFFFFFF0));
  {$I-}
  Seek(F,RelPos);
  {$I+}
  Cn:=Dt_^.G.Seg[I].Fix Div 4;
  For J:=0 To Cn-1 Do Begin
   {$I-}
   BlockRead(F,Rel,4,N);
   {$I+}
   If N<4 Then Cn:=0;
   Typ:=Rel[0] And $FF;Lb:=Rel[0] Shr 8;Ofs:=Rel[1];
   Cur:=M16(SegPara[I],Ofs);
   Case Typ Of
    $00: Begin W16(SegPara[I],Word(Ofs+2),TRAP_KERNEL);Inc(Cnts[0]);End;
    $11: Begin Inc(Cnts[1]);End;
    $12: Begin W16(SegPara[I],Ofs,TRAP_LIB+Lb);Inc(Cnts[2]);End;
    $13: Begin W16(SegPara[I],Ofs,$0100+Lb);Inc(Cnts[3]);End;
    $14: Begin RtNote(Lb,Cur);W16(SegPara[I],Word(Ofs+2),TRAP_LIB+Lb);
    Inc(Cnts[4]);End;
    $22: Begin If Cur<Dt_^.G.NS Then W16(SegPara[I],Ofs,SegPara[Cur]);
    Inc(Cnts[5]);End;
    $23: Begin W16(SegPara[I],Ofs,$0200+Cur);Inc(Cnts[6]);End;
    $24: Begin
          { pointeur dans le programme : fichier = numero de ressource puis
            offset ; memoire = offset puis segment }
          Tmp:=M16(SegPara[I],Word(Ofs+2));
          If Cur<Dt_^.G.NS Then Begin W16(SegPara[I],Ofs,Tmp);
          W16(SegPara[I],Word(Ofs+2),SegPara[Cur]);End;
          Inc(Cnts[7]);
         End;
   Else Inc(Cnts[8]);
   End;
  End;
 End;
 Close(F);
 FreeMem(Buf,4096);
 GwAdd(Wd_,T3('Resources loaded: ','Ressources charg'#130'es : ',
     'Ressourcen geladen: ')+IntStr(Dt_^.G.NS)+
     '   '+T3('relocations: kernel ','relogements : noyau ',
         'Relokationen: Kernel ')+IntStr(Cnts[0])+
     ', lib '+IntStr(Cnts[1]+Cnts[2]+Cnts[4])+', seg '+IntStr(Cnts[5]+Cnts[7])+
         ', '+T3('other ','autres ','andere ')+IntStr(Cnts[3]+Cnts[6]+Cnts[8]));
 For I:=0 To Min2(Dt_^.G.NS-1,5) Do GwAdd(Wd_,
     '  res '+IntStr(I)+' @ '+HexW(SegPara[I])+':0000  ('+
     IntStr(Dt_^.G.Seg[I].Len)+')');
 { application : son code n'est atteint que par le systeme d'objets }
 If Dt_^.G.AType=1 Then Begin
  RtCoverage(Wd_);RtExercise(Wd_);
  OtShow(Wd_);
  Dt_^.Top:=Max2(1,Dt_^.NL-14);
  Exit;
 End;
 { point d'entree }
 Ok:=False;EntR:=0;EntO:=0;
 If (Dt_^.G.Attr And $4000)<>0 Then Begin EntR:=Dt_^.G.EntRes;
 EntO:=Dt_^.G.EntOfs;Ok:=True;GwAdd(Wd_,T3('Entry: library entry point',
     'Entr'#130'e : point d''entr'#130'e de biblioth'#138'que',
     'Einsprung: Bibliothekseintritt'));End
 Else If Dt_^.G.NE>0 Then Begin EntR:=Dt_^.G.Exp[0].Res;EntO:=Dt_^.G.Exp[0].Ofs;
 Ok:=True;GwAdd(Wd_,T3('Entry: exported routine 0',
     'Entr'#130'e : routine export'#130'e 0',
     'Einsprung: exportierte Routine 0'));End;
 RtCoverage(Wd_);
 If (Not Ok) Or (EntR>=Dt_^.G.NS) Then Begin
  RtExercise(Wd_);
  Dt_^.Top:=Max2(1,Dt_^.NL-14);
  Exit;
 End;
 FillChar(Reg,SizeOf(Reg),0);
 SegR[0]:=SegPara[Min2(1,Dt_^.G.NS-1)];SegR[3]:=SegPara[Min2(1,Dt_^.G.NS-1)];
 SegR[2]:=$9000;SegR[1]:=SegPara[EntR];
 Reg[4]:=$FFF0;Reg[5]:=0;EIP:=EntO;EFl:=$0202;
 Push16(TRAP_EXIT);Push16(0);
 EHalt:=False;EReason:='';ICount:=0;ELog:=Wd_;
 GwAdd(Wd_,T3('Running at ','Ex'#130'cution en ',
     'Ausf'#129'hrung bei ')+HexW(SegR[1])+':'+HexW(EIP)+' ...');
 Steps:=0;
 While (Not EHalt) And (ICount<400000) Do Begin
  ExecOne;
 End;
 If Not EHalt Then EReason:=T3('instruction limit reached',
     'limite d''instructions atteinte','Befehlslimit erreicht');
 GwAdd(Wd_,T3('Stopped: ','Arr'#136't : ','Angehalten: ')+EReason);
 GwAdd(Wd_,T3('Instructions executed: ','Instructions ex'#130'cut'#130'es : ',
     'Ausgef'#129'hrte Befehle: ')+NumFmt(ICount));
 GwAdd(Wd_,'AX='+HexW(Reg[0])+' BX='+HexW(Reg[3])+' CX='+HexW(Reg[1])+' DX='+
     HexW(Reg[2])+' SI='+HexW(Reg[6])+
     ' DI='+HexW(Reg[7])+' BP='+HexW(Reg[5])+' SP='+HexW(Reg[4]));
 GwAdd(Wd_,'CS:IP='+HexW(SegR[1])+':'+HexW(EIP)+' DS='+HexW(SegR[3])+' ES='+
     HexW(SegR[0])+' SS='+HexW(SegR[2])+' FL='+HexW(EFl));
 Dt_^.Top:=Max2(1,Dt_^.NL-14);
End;
{$ELSE}
Procedure GwEmulate(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Begin
 Dt_:=Wd_^.Data;
 GwAdd(Wd_,'');
 GwAdd(Wd_,T3('The CPU emulator is available in the Free Pascal build.',
     'L''='#130'mulateur CPU est disponible dans la version Free Pascal.',
     'Der CPU-Emulator ist in der Free-Pascal-Version verf'#129'gbar.'));
End;
{$ENDIF}

Procedure GwDrawClient(Wd_: PWindow);
 Var Dt_: PGeodeWin;
Var X1,Y1,X2,Y2,I,VR,Y: Integer; S: String;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 Sunken(X1+4,Y1+4,X2-4,Y2-4,cBlk);
 VR:=(Y2-Y1-12) Div 10;
 For I:=Dt_^.Top To Dt_^.Top+VR-1 Do
  If I<=Dt_^.NL Then Begin
   Y:=Y1+8+(I-Dt_^.Top)*10;
   S:=Copy(Dt_^.Ln[I]^,1,(X2-X1-SB-20) Div 8);
   If Copy(Dt_^.Ln[I]^,1,6)='  CALL' Then GText(X1+10,Y,S,cLCy)
   Else If Copy(Dt_^.Ln[I]^,1,3)='---' Then GText(X1+10,Y,S,cYel)
   Else GText(X1+10,Y,S,cLGn);
  End;
 DrawScroll(True,X2-SB-3,Y1+6,X2-6,Y2-6,Dt_^.NL,VR,Dt_^.Top-1);
End;

Procedure GwOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PGeodeWin;
Var X1,Y1,X2,Y2,VR,P,A,B: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 VR:=(Y2-Y1-12) Div 10;
 If E.Kind=EV_DOWN Then Begin
  Dt_^.Drag:=False;
  If InBox(E.X,E.Y,X2-SB-3,Y1+6,X2-6,Y2-6) Then Begin
   P:=ScrollPart(True,X2-SB-3,Y1+6,X2-6,Y2-6,Dt_^.NL,VR,Dt_^.Top-1,E.X,E.Y);
   Case P Of
    1: If Dt_^.Top>1 Then Dec(Dt_^.Top);
    2: If Dt_^.Top<Dt_^.NL Then Inc(Dt_^.Top);
    3: Dt_^.Top:=Max2(1,Dt_^.Top-VR);
    4: Dt_^.Top:=Min2(Max2(1,Dt_^.NL-VR+1),Dt_^.Top+VR);
    5: Begin Dt_^.Drag:=True;ScrollThumb(Y1+6+SB,Y2-6-SB,Dt_^.NL,VR,Dt_^.Top-1,
        A,B);Dt_^.Grab:=E.Y-A;End;
   End;
   Invalidate(Wd_);
  End;
 End Else If (E.Kind=EV_MOVE) And Dt_^.Drag Then Begin
  Dt_^.Top:=1+ScrollDrag(True,X2-SB-3,Y1+6,X2-6,Y2-6,Dt_^.NL,VR,E.Y,Dt_^.Grab);
  Invalidate(Wd_);
 End Else If E.Kind=EV_UP Then Dt_^.Drag:=False;
End;

Procedure GwOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PGeodeWin;
Var X1,Y1,X2,Y2,VR: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 VR:=(Y2-Y1-12) Div 10;
 Case K Of
  K_UP: If Dt_^.Top>1 Then Dec(Dt_^.Top);
  K_DOWN: If Dt_^.Top<Dt_^.NL Then Inc(Dt_^.Top);
  K_PGUP: Dt_^.Top:=Max2(1,Dt_^.Top-VR);
  K_PGDN: Dt_^.Top:=Min2(Max2(1,Dt_^.NL-VR+1),Dt_^.Top+VR);
  K_HOME: Dt_^.Top:=1;
  K_END: Dt_^.Top:=Max2(1,Dt_^.NL-VR+1);
 End;
 If K=323 Then GwOnCommand(Wd_,CM_GRUN);
 Invalidate(Wd_);
End;

Procedure GwOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PGeodeWin;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_GRUN: Begin GwEmulate(Wd_);End;
  CM_GRESET,CM_GREPORT: GwReport(Wd_);
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

{ ====================================================================== }
{   ARBRE GENERIQUE D'UNE GEODE : les blocs d'objets (LMem) sont lus     }
{   en memoire emulee ; chaque objet Gen* est associe a un composant du  }
{   clone (formulaire de GeoBasic).                                      }
{   Disposition d'un objet : classe (ObjRelocationID + entree, 4 octets),}
{   puis le mot a +6 donne le decalage de la partie GenInstance :        }
{     GenOff = chunk + 4 + mot(+6)                                       }
{     GI_link(4) GI_comp(4) GI_visMoniker(2) GI_kbd(2) GI_attrs GI_states}
{   Un optr est [chunk][ObjRelocationID] ; bit 0 du chunk de GI_link =   }
{   lien vers le parent (fin de la liste des freres).                    }
{ ====================================================================== }
{$IFDEF FPC}
Const
 OT_MAXDLG = 24;
 CM_OTDLG  = 1560;           { +1..24 : ouverture d'une boite de dialogue }
 OT_MAXMENU = 8;
 OT_MAXTRG  = 64;
 CM_OTTRIG  = 1600;          { +1..64 : declencheur d'un menu }

Var
 OtGeode   : PWindow;
 OtNDlg    : Integer;
 OtDlgRes  : Array[1..OT_MAXDLG] Of Integer;
 OtDlgCh   : Array[1..OT_MAXDLG] Of Word;
 OtDlgTit  : Array[1..OT_MAXDLG] Of String[28];
 OtNMenu   : Integer;
 OtMenuRes : Array[1..OT_MAXMENU] Of Integer;
 OtMenuCh  : Array[1..OT_MAXMENU] Of Word;
 OtMenuTit : Array[1..OT_MAXMENU] Of String[20];
 OtNTrg    : Integer;
 OtDry     : Boolean;
 OtDryCnt  : Integer;
 OtTrgRes  : Array[1..OT_MAXTRG] Of Integer;
 OtTrgCh   : Array[1..OT_MAXTRG] Of Word;

Function OtGw: PGeodeWin;
Begin
 OtGw:=PGeodeWin(OtGeode^.Data);
End;

{ decalage d'un chunk dans un bloc d'objets, 0 si invalide }
Function OtChunkOfs(Res: Integer; H: Word): Word;
Var Sg,HT,N,O: Word;
Begin
 OtChunkOfs:=0;
 If (Res<0) Or (Res>=OtGw^.G.NS) Then Exit;
 Sg:=SegPara[Res];
 If M16(Sg,6)<>2 Then Exit;
 HT:=M16(Sg,2);N:=M16(Sg,10);
 If (H<HT) Or (H>=HT+2*N) Or Odd(H) Then Exit;
 O:=M16(Sg,H);
 If (O=0) Or (O=$FFFF) Or (O<4) Then Exit;
 OtChunkOfs:=O;
End;

Function OtChunkSize(Res: Integer; H: Word): Word;
Var O: Word;
Begin
 O:=OtChunkOfs(Res,H);
 If O=0 Then OtChunkSize:=0 Else OtChunkSize:=M16(SegPara[Res],Word(O-2));
End;

{ classe de base (bibliotheque) d'une structure de classe de la geode }
Function OtBaseOf(CS,CO: Word): String;
Var K: Integer; Sup,Ofs: Word; Lb: String;
Begin
 OtBaseOf:='';
 For K:=1 To 10 Do Begin
  Ofs:=M16(CS,CO);Sup:=M16(CS,Word(CO+2));
  If (Sup>=TRAP_LIB) And (Sup<TRAP_LIB+16) Then Begin
   If Sup-TRAP_LIB<OtGw^.G.NL Then Begin
    Lb:=TrimStr(OtGw^.G.Libs[Sup-TRAP_LIB].Name);
    OtBaseOf:=RtField(RtEntry(RtLibId(Lb),Ofs),0);
   End;
   Exit;
  End;
  If Sup=0 Then Exit;
  CS:=Sup;CO:=Ofs;
 End;
End;

{ nom de la classe de bibliotheque d'un objet ; Own = classe de la geode }
Function OtClassName(Res: Integer; H: Word; Var Own: Boolean): String;
Var O,Rid,Ent: Word; Src: Integer; Lb: String;
Begin
 OtClassName:='';Own:=False;
 O:=OtChunkOfs(Res,H);
 If O=0 Then Exit;
 Rid:=M16(SegPara[Res],O);Ent:=M16(SegPara[Res],Word(O+2));Src:=Rid Shr 12;
 If (Src=3) And ((Rid And $FFF)<OtGw^.G.NL) Then Begin
  Lb:=TrimStr(OtGw^.G.Libs[Rid And $FFF].Name);
  OtClassName:=RtField(RtEntry(RtLibId(Lb),Ent),0);
 End Else If (Src=6) And ((Rid And $FFF)=0) And (Ent<OtGw^.G.NE) Then Begin
  Own:=True;
  If OtGw^.G.Exp[Ent].Res<OtGw^.G.NS Then
   OtClassName:=OtBaseOf(SegPara[OtGw^.G.Exp[Ent].Res],OtGw^.G.Exp[Ent].Ofs);
 End;
End;

{ optr [chunk][relocation id] -> (ressource, chunk) ; False si nul }
Function OtOptr(Res: Integer; Ch,Hr: Word; Var R2: Integer; Var H2: Word):
    Boolean;
Var Src: Integer;
Begin
 OtOptr:=False;
 If Ch=0 Then Exit;
 Src:=Hr Shr 12;
 If Src=4 Then R2:=Res
 Else If Src=1 Then R2:=Hr And $FFF
 Else Exit;
 H2:=Ch And $FFFE;
 OtOptr:=OtChunkOfs(R2,H2)<>0;
End;

Function OtGenOfs(Res: Integer; H: Word): Word;
Var O: Word;
Begin
 O:=OtChunkOfs(Res,H);
 If O=0 Then OtGenOfs:=0 Else OtGenOfs:=Word(O+4+M16(SegPara[Res],Word(O+6)));
End;

Function OtMoniker(Res: Integer; H: Word): String;
Var O,Sz,I: Word; S: String; C: Byte;
Begin
 OtMoniker:='';
 If H=0 Then Exit;
 O:=OtChunkOfs(Res,H);
 If O=0 Then Exit;
 Sz:=M16(SegPara[Res],Word(O-2));
 S:='';
 I:=4;
 While (I<Sz) And (Length(S)<38) Do Begin
  C:=M8(SegPara[Res],Word(O+I));
  If C=0 Then Break;
  If (C<32) Or (C>126) Then Begin S:='';Break;End;
  S:=S+Chr(C);Inc(I);
 End;
 OtMoniker:=TrimStr(S);
End;

Function OtKindOf(Const Cn: String): Integer;
Var B: String;
Begin
 B:=Cn;
 If (Length(B)>5) And (Copy(B,Length(B)-4,5)='Class') Then Delete(B,Length(B)-4,
     5);
 If B='GenPrimary' Then OtKindOf:=FK_PRIMARY
 Else If B='GenTrigger' Then OtKindOf:=FK_TRIG
 Else If B='GenText' Then OtKindOf:=FK_TEXT
 Else If B='GenGlyph' Then OtKindOf:=FK_GLYPH
 Else If B='GenValue' Then OtKindOf:=FK_VALUE
 Else If B='GenItemGroup' Then OtKindOf:=FK_IGROUP
 Else If (B='GenDynamicList') Or (B='GenFileSelector') Then OtKindOf:=FK_LIST
 Else If B='GenBooleanGroup' Then OtKindOf:=FK_BGROUP
 Else If B='GenItem' Then OtKindOf:=FK_ITEM
 Else If B='GenBoolean' Then OtKindOf:=FK_BOOL
 Else If (B='GenEditControl') Or (Copy(B,1,
     10)='GenControl') Then OtKindOf:=FK_DCTRL
 Else If B='GenDisplayGroup' Then OtKindOf:=FK_DGROUP
 Else If B='GenDisplay' Then OtKindOf:=FK_DISPLAY
 Else OtKindOf:=FK_INTER;
End;

{ GenInteraction : 1 menu (popup), 4 dialogue, 5 popout }
Function OtVisibility(Res: Integer; H: Word): Integer;
Var G: Word; Own: Boolean; Cn: String;
Begin
 OtVisibility:=0;
 Cn:=OtClassName(Res,H,Own);
 If Copy(Cn,1,14)<>'GenInteraction' Then Exit;
 G:=OtGenOfs(Res,H);
 If G<>0 Then OtVisibility:=M8(SegPara[Res],Word(G+15));
End;

Function OtIsDialog(Res: Integer; H: Word): Boolean;
Var G: Word; V: Byte; Own: Boolean; Cn: String;
Begin
 OtIsDialog:=False;
 Cn:=OtClassName(Res,H,Own);
 If OtKindOf(Cn)<>FK_INTER Then Exit;
 If Copy(Cn,1,14)<>'GenInteraction' Then Exit;
 G:=OtGenOfs(Res,H);
 If G=0 Then Exit;
 V:=M8(SegPara[Res],Word(G+15));
 OtIsDialog:=V In [4,5];
End;

Function OtNextSibling(Res: Integer; H: Word; Var R2: Integer; Var H2: Word):
    Boolean;
Var G,Ch,Hr: Word;
Begin
 OtNextSibling:=False;
 G:=OtGenOfs(Res,H);
 If G=0 Then Exit;
 Ch:=M16(SegPara[Res],G);Hr:=M16(SegPara[Res],Word(G+2));
 If (Ch And 1)<>0 Then Exit;
 OtNextSibling:=OtOptr(Res,Ch,Hr,R2,H2);
End;

Function OtFirstChild(Res: Integer; H: Word; Var R2: Integer; Var H2: Word):
    Boolean;
Var G: Word;
Begin
 OtFirstChild:=False;
 G:=OtGenOfs(Res,H);
 If G=0 Then Exit;
 OtFirstChild:=OtOptr(Res,M16(SegPara[Res],Word(G+4)),M16(SegPara[Res],
     Word(G+6)),R2,H2);
End;

{ indices de hints (genC.def) : rang depuis HINT_DUMMY ; mot = $6000 or
  (9+4*rang) }
Const
 HNT_DRAW_BOX = 30; HNT_HORIZ = 45; HNT_VERT = 46; HNT_CENTER_H = 21;

Procedure OtRegisterDialog(Res: Integer; H: Word; Const Tit: String);
Begin
 If OtNDlg>=OT_MAXDLG Then Exit;
 Inc(OtNDlg);
 OtDlgRes[OtNDlg]:=Res;OtDlgCh[OtNDlg]:=H;
 If Tit<>'' Then OtDlgTit[OtNDlg]:=Copy(Tit,1,28)
 Else OtDlgTit[OtNDlg]:='Dialog '+IntStr(Res)+':'+HexW(H);
End;

{ ajoute l'objet et ses descendants au formulaire ; retourne l'indice }
Function OtBuild(F: PForm; Parent,Res: Integer; H: Word; Depth: Integer):
    Integer;
Var Cn,Tit: String; Own: Boolean; K,I,R2,Rc: Integer; H2,Hc,G,W,Q,E: Word;
Hdr: Byte;
Begin
 OtBuild:=0;
 If (F^.N>=FMAX) Or (Depth>14) Then Exit;
 Cn:=OtClassName(Res,H,Own);
 If Cn='' Then Exit;
 K:=OtKindOf(Cn);
 If K=FK_PRIMARY Then K:=FK_INTER;
 G:=OtGenOfs(Res,H);
 If G=0 Then Exit;
 Tit:=OtMoniker(Res,M16(SegPara[Res],Word(G+8)));
 If (Depth>0) And (OtIsDialog(Res,H) Or (OtVisibility(Res,H)=1)) Then Exit;
 I:=FmAdd(F,K,Parent);
 If I=0 Then Exit;
 F^.O[I].Name:='o'+IntStr(Res)+'_'+HexW(H);
 F^.O[I].Name:=Copy(F^.O[I].Name,1,20);
 F^.O[I].Title:=Copy(Tit,1,40);
 F^.O[I].SrcRes:=Res;F^.O[I].SrcCh:=H;
 Hdr:=M8(SegPara[Res],Word(G+13));
 F^.O[I].Enabled:=(Hdr And $40)<>0;
 F^.O[I].Usable:=True;
 If (K=FK_INTER) And (Tit='') Then F^.O[I].Feat:=F^.O[I].Feat Or $8000;
 { conseils de mise en page (variable data des GenInteraction) }
 If (K=FK_INTER) And (Copy(Cn,1,14)='GenInteraction') Then Begin
  W:=OtChunkSize(Res,H);Q:=Word(G+17);
  E:=Word(OtChunkOfs(Res,H)+W);
  While Q+2<=E Do Begin
   Rc:=M16(SegPara[Res],Q);
   If (Rc=$CCCC) Or ((Rc And $F800)<>$6000) Then Break;
   Rc:=((Rc And $1FFF)-9) Div 4;
   If Rc=HNT_HORIZ Then F^.O[I].Orient:=1;
   If Rc=HNT_VERT Then F^.O[I].Orient:=0;
   Inc(Q,2);
  End;
 End;
 If K=FK_VALUE Then Begin F^.O[I].Min:=0;F^.O[I].Max:=100;F^.O[I].Val:=50;End;
 { enfants }
 If OtFirstChild(Res,H,R2,H2) Then Begin
  Hc:=H2;Rc:=R2;Q:=0;
  Repeat
   OtBuild(F,I,Rc,Hc,Depth+1);
   Inc(Q);
  Until (Q>60) Or (Not OtNextSibling(Rc,Hc,Rc,Hc));
 End;
 OtBuild:=I;
End;

{ recense les dialogues et les menus accessibles depuis un objet }
Procedure OtScan(Res: Integer; H: Word; Depth: Integer; InDlg: Boolean);
Var R2,Rc: Integer; H2,Hc: Word; Q: Integer; Dlg: Boolean;
Begin
 If Depth>14 Then Exit;
 Dlg:=InDlg;
 If Depth>0 Then Begin
  If OtIsDialog(Res,H) Then Begin
   OtRegisterDialog(Res,H,OtMoniker(Res,M16(SegPara[Res],Word(OtGenOfs(Res,
       H)+8))));
   Dlg:=True;
  End Else If (OtVisibility(Res,H)=1) And (Not InDlg) And (OtNMenu<OT_MAXMENU)
      Then Begin
   Inc(OtNMenu);OtMenuRes[OtNMenu]:=Res;OtMenuCh[OtNMenu]:=H;
   OtMenuTit[OtNMenu]:=Copy(OtMoniker(Res,M16(SegPara[Res],
     Word(OtGenOfs(Res,H)+8))),1,20);
   If OtMenuTit[OtNMenu]='' Then OtMenuTit[OtNMenu]:='Menu '+IntStr(OtNMenu);
  End;
 End;
 If OtFirstChild(Res,H,R2,H2) Then Begin
  Rc:=R2;Hc:=H2;Q:=0;
  Repeat
   OtScan(Rc,Hc,Depth+1,Dlg);
   Inc(Q);
  Until (Q>60) Or (Not OtNextSibling(Rc,Hc,Rc,Hc));
 End;
End;

{ ajoute au menu courant les declencheurs descendants d'un objet }
Procedure OtMenuItems(W: PWindow; Res: Integer; H: Word; Depth: Integer);
Var R2,Rc: Integer; H2,Hc: Word; Q: Integer; Own: Boolean; Cn,T: String;
Begin
 If (Depth>6) Or ((Not OtDry) And (OtNTrg>=OT_MAXTRG)) Then Exit;
 If OtFirstChild(Res,H,R2,H2) Then Begin
  Rc:=R2;Hc:=H2;Q:=0;
  Repeat
   Cn:=OtClassName(Rc,Hc,Own);
   If OtKindOf(Cn)=FK_TRIG Then Begin
    T:=OtMoniker(Rc,M16(SegPara[Rc],Word(OtGenOfs(Rc,Hc)+8)));
    If T='' Then T:='Item';
    If OtDry Then Inc(OtDryCnt)
    Else If OtNTrg<OT_MAXTRG Then Begin
     Inc(OtNTrg);OtTrgRes[OtNTrg]:=Rc;OtTrgCh[OtNTrg]:=Hc;
     WinAddItem(W,T,CM_OTTRIG+OtNTrg,'');
    End;
   End Else If OtVisibility(Rc,Hc)<>1 Then OtMenuItems(W,Rc,Hc,Depth+1);
   Inc(Q);
  Until (Q>60) Or (Not OtNextSibling(Rc,Hc,Rc,Hc));
 End;
End;

Procedure OtMenus(W: PWindow);
Var I: Integer;
Begin
 For I:=1 To OtNMenu Do Begin
  OtDry:=True;OtDryCnt:=0;
  OtMenuItems(W,OtMenuRes[I],OtMenuCh[I],0);
  OtDry:=False;
  If OtDryCnt>0 Then Begin
   WinAddMenu(W,OtMenuTit[I]);
   OtMenuItems(W,OtMenuRes[I],OtMenuCh[I],0);
  End;
 End;
 If OtNDlg=0 Then Exit;
 WinAddMenu(W,'Dialogs~Bo'#140'tes~Dialoge');
 For I:=1 To OtNDlg Do
  WinAddItem(W,OtDlgTit[I]+' ('+IntStr(OtDlgRes[I])+':'+HexW(OtDlgCh[I])+')',
      CM_OTDLG+I,'');
End;

Function OtWindow(Res: Integer; H: Word; Const Title: String; Menus: Boolean):
    PWindow;
Var F: PForm; B: PBas; I,P: Integer; X,Y: Integer; Wd_: PWindow; R2: Integer;
H2,Hc: Word; Q: Integer;
Begin
 OtWindow:=Nil;
 New(F);FillChar(F^,SizeOf(TForm),0);
 P:=FmAdd(F,FK_PRIMARY,0);
 F^.O[P].Title:=Copy(Title,1,40);F^.O[P].Name:='root';
 F^.O[P].SrcRes:=Res;F^.O[P].SrcCh:=H;
 { les enfants de l'objet racine }
 If OtFirstChild(Res,H,R2,H2) Then Begin
  Q:=0;Hc:=H2;I:=R2;
  Repeat
   OtBuild(F,P,I,Hc,1);
   Inc(Q);
  Until (Q>60) Or (Not OtNextSibling(I,Hc,I,Hc));
 End;
 New(B);B:=BNewBas;B^.NoScr:=True;B^.NL:=1;B^.Src[1]:=NewStr('REM');
 B^.LNo[1]:=-1;
 NextWinPos(X,Y);
 Wd_:=BrNew(X,Y,B,F,Title);
 PBRun(Wd_^.Data)^.Tree:=True;
 If Menus Then OtMenus(Wd_);
 AddWindow(Wd_);
 OtWindow:=Wd_;
End;

{ ouvre l'interface generique de l'application : GenApplication -> GenPrimary }
Procedure OtShow(Wd_: PWindow);
Var Dt_: PGeodeWin; R2,R3: Integer; H2,H3: Word; Own: Boolean; Cn,Tit: String;
W: PWindow;
Begin
 Dt_:=Wd_^.Data;
 OtGeode:=Wd_;
 OtNDlg:=0;OtNMenu:=0;OtNTrg:=0;
 If (Dt_^.G.AppRes=0) Or (Dt_^.G.AppRes>=Dt_^.G.NS) Then Exit;
 If OtChunkOfs(Dt_^.G.AppRes,Dt_^.G.AppOfs)=0 Then Exit;
 If Not OtFirstChild(Dt_^.G.AppRes,Dt_^.G.AppOfs,R2,H2) Then Exit;
 Cn:=OtClassName(R2,H2,Own);
 Tit:=OtMoniker(R2,M16(SegPara[R2],Word(OtGenOfs(R2,H2)+8)));
 If Tit='' Then Tit:=TrimStr(Dt_^.G.Info.LongName);
 If Tit='' Then Tit:=Dt_^.G.Name;
 OtScan(R2,H2,0,False);
 GwAdd(Wd_,T3('Generic tree: primary ','Arbre g'#130'n'#130'rique : primary ',
     'Generischer Baum: Primary ')+IntStr(R2)+':'+HexW(H2)+
   ' ('+Cn+'), '+IntStr(OtNDlg)+T3(' dialogs/menus',' dialogues/menus',
       ' Dialoge/Men'#129's'));
 W:=OtWindow(R2,H2,Tit,True);
End;

{ envoie le message d'un GenTrigger (destination puis message d'action) }
Procedure OtSendTrigger(Res: Integer; H: Word; Const Title: String);
Var G,Msg,Ch,Hr,A,C,D,B: Word; R2,N: Integer; H2: Word; Cy,IsP: Boolean;
S: String;
Begin
 If OtGeode=Nil Then Exit;
 G:=OtGenOfs(Res,H);
 If G=0 Then Exit;
 { GenTrigger : GTI_destination (optr) puis GTI_actionMsg }
 Ch:=M16(SegPara[Res],Word(G+14));Hr:=M16(SegPara[Res],Word(G+16));
 Msg:=M16(SegPara[Res],Word(G+18));
 S:='> '+T3('trigger ','d'#130'clencheur ','Trigger ')+Title+'  msg='+
    HexW(Msg)+' dest='+HexW(Hr)+':'+HexW(Ch);
 If Msg=0 Then Begin GwAdd(OtGeode,S+'  (no message)');Exit;End;
 IsP:=(Ch=0) And ((Hr Shr 12)=1) And ((Hr And $FFF)=0);
 N:=0;
 ELog:=OtGeode;
 If IsP Then
  N:=RtSendObj(0,0,True,False,0,0,Msg,0,0,0,A,C,D,B,Cy)
 Else If OtOptr(Res,Ch,Hr,R2,H2) Then
  N:=RtSendObj(R2,H2,False,False,0,0,Msg,0,0,0,A,C,D,B,Cy);
 Case N Of
  1: S:=S+'  -> handler executed';
  2: S:=S+'  -> handler did not return';
 Else S:=S+'  (no handler in the geode)';
 End;
 GwAdd(OtGeode,S);
 GwSaveLog(OtGeode);
End;

{ commandes de menu des fenetres d'arbre ; True si traitee }
Function OtCommand(Wd_: PWindow; Cmd: Integer): Boolean;
Var K: Integer; W: PWindow;
Begin
 OtCommand:=False;
 If OtGeode=Nil Then Exit;
 If (Cmd>CM_OTTRIG) And (Cmd<=CM_OTTRIG+OT_MAXTRG) Then Begin
  K:=Cmd-CM_OTTRIG;
  If K<=OtNTrg Then OtSendTrigger(OtTrgRes[K],OtTrgCh[K],'menu '+IntStr(K));
  OtCommand:=True;Exit;
 End;
 If (Cmd<=CM_OTDLG) Or (Cmd>CM_OTDLG+OT_MAXDLG) Then Exit;
 K:=Cmd-CM_OTDLG;
 If K>OtNDlg Then Exit;
 W:=OtWindow(OtDlgRes[K],OtDlgCh[K],OtDlgTit[K],False);
 OtCommand:=True;
End;

Procedure OtClick(Wd_: PWindow; I: Integer);
Var F: PForm;
Begin
 F:=PBRun(Wd_^.Data)^.Form;
 If (F=Nil) Or (OtGeode=Nil) Then Exit;
 OtSendTrigger(F^.O[I].SrcRes,F^.O[I].SrcCh,F^.O[I].Title);
End;
{$ELSE}
Procedure OtClick(Wd_: PWindow; I: Integer);
Begin
End;

Function OtCommand(Wd_: PWindow; Cmd: Integer): Boolean;
Begin
 OtCommand:=False;
End;
{$ENDIF}

