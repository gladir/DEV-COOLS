Procedure InitializeGraphics;
Var
 Driver, Mode: Integer;
 ErrCode: Integer;
Begin
 {$IFDEF FPC}
  Driver:=VGA;
  Mode:=VGAHi;
 {$ELSE}
  Driver:=Detect;
  Mode:=VGAHi;
 {$ENDIF}
 InitGraph(Driver,Mode,'');
 ErrCode:=GraphResult;
 If ErrCode=grOk Then Begin
  SetColor(White);
  SetLineStyle(0,0,1);
  GfxOn:=True;
 End
  Else
 Begin
  WriteLn('Erreur graphique : ',GraphErrorMsg(ErrCode));
  Halt;
 End;
End;

{ Curseur logiciel (sauvegarde de l'arriere-plan) : meme apparence sous
  Turbo Pascal et Free Pascal }
Const
 CUR_W = 12;
 CUR_H = 17;
 CurShape : Array[0..CUR_H-1] Of String[CUR_W] = (
  '.           ',
  '..          ',
  '.#.         ',
  '.##.        ',
  '.###.       ',
  '.####.      ',
  '.#####.     ',
  '.######.    ',
  '.#######.   ',
  '.########.  ',
  '.#####.....',
  '.##.##.     ',
  '.#. .##.    ',
  '..  .##.    ',
  '.    .##.   ',
  '     .##.   ',
  '      ..    ');

Var
 VX,VY  : Integer;                 { origine du viewport courant }
 CX1,CY1,CX2,CY2 : Integer;        { rectangle de clip courant (absolu) }
 CurSaved,CurShown : Boolean;
 CurBuf : Pointer;
 CurSz  : LongInt;
 CurX,CurY : LongInt;

{$IFNDEF FPC}
 Function MouseDriverFound: Boolean;
 Var
  Regs: Registers;
 Begin
  Regs.AX := 0;
  Intr($33, Regs);
  MouseDriverFound := Regs.AX = $FFFF;
 End;

 Procedure GetMouseState(Var X, Y, Button: LongInt);
 Var
  Regs: Registers;
 Begin
  Regs.AX := $0003;
  Intr($33, Regs);
  Button := Regs.BX;
  X := Regs.CX;
  Y := Regs.DX;
 End;
{$ELSE}
 Function MouseDriverFound: Boolean;
 Begin
  MouseDriverFound := True;
 End;
{$ENDIF}

Procedure SetClip(X1,Y1,X2,Y2: Integer);
Begin
 If X1<0 Then X1:=0;
 If Y1<0 Then Y1:=0;
 If X2>SCR_W-1 Then X2:=SCR_W-1;
 If Y2>SCR_H-1 Then Y2:=SCR_H-1;
 CX1:=X1;CY1:=Y1;CX2:=X2;CY2:=Y2;
 VX:=X1;VY:=Y1;
 If (X2>=X1) And (Y2>=Y1) Then SetViewPort(X1,Y1,X2,Y2,True);
End;

Procedure ClipFull;
Begin
 SetClip(0,0,SCR_W-1,SCR_H-1);
End;

Procedure CursorErase;
Begin
 If CurSaved Then Begin
  ClipFull;
  PutImage(CurX,CurY,CurBuf^,NormalPut);
  CurSaved:=False;
 End;
End;

Procedure CursorDraw(X,Y: LongInt);
Var I,J: Integer; C: Char;
Begin
 If X>SCR_W-CUR_W Then X:=SCR_W-CUR_W;
 If Y>SCR_H-CUR_H Then Y:=SCR_H-CUR_H;
 If X<0 Then X:=0;
 If Y<0 Then Y:=0;
 CursorErase;
 ClipFull;
 GetImage(X,Y,X+CUR_W-1,Y+CUR_H-1,CurBuf^);
 CurX:=X;CurY:=Y;CurSaved:=True;
 For J:=0 To CUR_H-1 Do
  For I:=1 To CUR_W Do Begin
   C:=CurShape[J][I];
   If C='#' Then PutPixel(X+I-1,Y+J,cBlk)
   Else If C='.' Then PutPixel(X+I-1,Y+J,cWht);
  End;
End;

{ Pour l'application : le curseur n'est (re)dessine que hors peinture }
Procedure ShowMouse;
Begin
 CurShown:=True;
 CursorDraw(MX,MY);
End;

Procedure HideMouse;
Begin
 CursorErase;
 CurShown:=False;
End;

Procedure InitCursor;
Begin
 CurSz:=ImageSize(0,0,CUR_W-1,CUR_H-1);
 GetMem(CurBuf,CurSz);
 CurSaved:=False;CurShown:=False;
End;

{ ====================================================================== }
{              PRIMITIVES GRAPHIQUES AVEC ECRETAGE (CLIP)                }
{ ====================================================================== }

Function Vis(X1,Y1,X2,Y2: Integer): Boolean;
Begin
 Vis:=(X2>=CX1) And (X1<=CX2) And (Y2>=CY1) And (Y1<=CY2);
End;

Procedure GBar(X1,Y1,X2,Y2,C: Integer);
Begin
 If (X2<X1) Or (Y2<Y1) Then Exit;
 If Not Vis(X1,Y1,X2,Y2) Then Exit;
 SetFillStyle(SolidFill,C);
 Bar(X1-VX,Y1-VY,X2-VX,Y2-VY);
End;

Procedure GPix(X,Y,C: Integer);
Begin
 If (X<CX1) Or (X>CX2) Or (Y<CY1) Or (Y>CY2) Then Exit;
 PutPixel(X-VX,Y-VY,C);
End;

Procedure GHLine(X1,X2,Y,C: Integer);
Begin
 If X2<X1 Then Exit;
 If (Y<CY1) Or (Y>CY2) Or (X2<CX1) Or (X1>CX2) Then Exit;
 SetFillStyle(SolidFill,C);
 Bar(X1-VX,Y-VY,X2-VX,Y-VY);
End;

Procedure GVLine(X,Y1,Y2,C: Integer);
Begin
 If Y2<Y1 Then Exit;
 If (X<CX1) Or (X>CX2) Or (Y2<CY1) Or (Y1>CY2) Then Exit;
 SetFillStyle(SolidFill,C);
 Bar(X-VX,Y1-VY,X-VX,Y2-VY);
End;

Procedure GLine(X1,Y1,X2,Y2,C: Integer);
Begin
 SetColor(C);
 SetLineStyle(SolidLn,0,1);
 Line(X1-VX,Y1-VY,X2-VX,Y2-VY);
End;

Procedure GRect(X1,Y1,X2,Y2,C: Integer);
Begin
 If (X2<X1) Or (Y2<Y1) Then Exit;
 If Not Vis(X1,Y1,X2,Y2) Then Exit;
 GHLine(X1,X2,Y1,C);GHLine(X1,X2,Y2,C);
 GVLine(X1,Y1,Y2,C);GVLine(X2,Y1,Y2,C);
End;

Procedure GDotRect(X1,Y1,X2,Y2,C: Integer);
Var I: Integer;
Begin
 I:=X1;
 While I<=X2 Do Begin GPix(I,Y1,C);GPix(I,Y2,C);Inc(I,2);End;
 I:=Y1;
 While I<=Y2 Do Begin GPix(X1,I,C);GPix(X2,I,C);Inc(I,2);End;
End;

Procedure GEllipse(CX,CY,RX,RY,C: Integer);
Begin
 SetColor(C);
 SetLineStyle(SolidLn,0,1);
 Ellipse(CX-VX,CY-VY,0,360,RX,RY);
End;

Procedure GFillEllipse(CX,CY,RX,RY,C: Integer);
Begin
 SetFillStyle(SolidFill,C);
 SetColor(C);
 FillEllipse(CX-VX,CY-VY,RX,RY);
End;

Procedure GPoly(N: Integer; Var P: Array Of
    PointType; C: Integer; Filled: Boolean);
Var Q: Array[1..16] Of PointType; I: Integer;
Begin
 If N>16 Then N:=16;
 For I:=1 To N Do Begin
  Q[I].X:=P[I-1].X-VX;
  Q[I].Y:=P[I-1].Y-VY;
 End;
 SetColor(C);
 SetFillStyle(SolidFill,C);
 If Filled Then FillPoly(N,Q) Else DrawPoly(N,Q);
End;

{ Damier fin (2 couleurs) : troughs des barres de defilement, grisages }
Procedure GDither(X1,Y1,X2,Y2,C1,C2: Integer);
Var X,Y: Integer;
Begin
 If (X2<X1) Or (Y2<Y1) Then Exit;
 If Not Vis(X1,Y1,X2,Y2) Then Exit;
 GBar(X1,Y1,X2,Y2,C2);
 For Y:=Y1 To Y2 Do Begin
  X:=X1+((Y1+Y+X1) And 1);
  While X<=X2 Do Begin
   GPix(X,Y,C1);
   Inc(X,2);
  End;
 End;
End;

{ ---------------------------------------------------------------------- }
{ Texte (police BGI 8x8)                                                  }
{ ---------------------------------------------------------------------- }

Function TextW(Const S: String): Integer;
Begin
 TextW:=Length(S)*8;
End;

Procedure GText(X,Y: Integer; Const S: String; C: Integer);
Var T: String; I: Integer;
Begin
 If S='' Then Exit;
 If (Y>CY2) Or (Y+8<CY1) Or (X>CX2) Or (X+Length(S)*8<CX1) Then Exit;
 T:=S;
 { le glyphe #136 de la police 8x8 est defectueux sous PtcGraph }
 For I:=1 To Length(T) Do If T[I]=#136 Then T[I]:='e';
 SetColor(C);
 SetTextStyle(DefaultFont,HorizDir,1);
 OutTextXY(X-VX,Y-VY,T);
End;

Procedure GTextB(X,Y: Integer; Const S: String; C: Integer);
Begin
 GText(X,Y,S,C);
 GText(X+1,Y,S,C);
End;

Procedure GTextCtr(X1,X2,Y: Integer; Const S: String; C: Integer);
Begin
 GText((X1+X2+1-TextW(S)) Div 2,Y,S,C);
End;

Procedure GTextBig(X,Y: Integer; Const S: String; Size,C: Integer);
Begin
 If S='' Then Exit;
 SetColor(C);
 SetTextStyle(DefaultFont,HorizDir,Size);
 OutTextXY(X-VX,Y-VY,S);
 SetTextStyle(DefaultFont,HorizDir,1);
End;

{ Texte grise (desactive) : texte noir mele de blanc en damier }
Procedure GTextGrey(X,Y: Integer; Const S: String);
Begin
 GText(X+1,Y+1,S,cWht);
 GText(X,Y,S,cDGr);
End;

{ ---------------------------------------------------------------------- }
{ Reliefs 3D (style Motif de GeoWorks)                                    }
{ ---------------------------------------------------------------------- }

Procedure Bevel1(X1,Y1,X2,Y2,TLc,BRc: Integer);
Begin
 GHLine(X1,X2-1,Y1,TLc);
 GVLine(X1,Y1,Y2-1,TLc);
 GHLine(X1,X2,Y2,BRc);
 GVLine(X2,Y1,Y2,BRc);
End;

{ Bouton en relief : 2 pixels ; enfonce si Down }
Procedure Btn3D(X1,Y1,X2,Y2: Integer; Down: Boolean);
Begin
 GBar(X1,Y1,X2,Y2,cLGr);
 If Down Then Begin
  Bevel1(X1,Y1,X2,Y2,cBlk,cWht);
  Bevel1(X1+1,Y1+1,X2-1,Y2-1,cDGr,cLGr);
 End Else Begin
  Bevel1(X1,Y1,X2,Y2,cWht,cBlk);
  Bevel1(X1+1,Y1+1,X2-1,Y2-1,cLGr,cDGr);
 End;
End;

{ Champ creux (zone de saisie / liste) }
Procedure Sunken(X1,Y1,X2,Y2,Fill: Integer);
Begin
 If Fill>=0 Then GBar(X1,Y1,X2,Y2,Fill);
 Bevel1(X1,Y1,X2,Y2,cDGr,cWht);
 Bevel1(X1+1,Y1+1,X2-1,Y2-1,cBlk,cLGr);
End;

Procedure Raised1(X1,Y1,X2,Y2: Integer);
Begin
 GBar(X1,Y1,X2,Y2,cLGr);
 Bevel1(X1,Y1,X2,Y2,cWht,cDGr);
End;

Procedure Sunken1(X1,Y1,X2,Y2: Integer);
Begin
 Bevel1(X1,Y1,X2,Y2,cDGr,cWht);
End;

{ Bouton avec libelle }
Procedure Button(X1,Y1,X2,Y2: Integer; Const S: String; Def,Down,
    Enabled: Boolean);
Var TX,TY: Integer;
Begin
 If Def Then Begin
  GRect(X1-2,Y1-2,X2+2,Y2+2,cBlk);
 End;
 Btn3D(X1,Y1,X2,Y2,Down);
 TX:=(X1+X2+1-TextW(S)) Div 2;
 TY:=(Y1+Y2-6) Div 2;
 If Down Then Begin Inc(TX);Inc(TY);End;
 If Enabled Then GText(TX,TY,S,cBlk) Else GTextGrey(TX,TY,S);
End;

Function InBox(X,Y,X1,Y1,X2,Y2: LongInt): Boolean;
Begin
 InBox:=(X>=X1) And (X<=X2) And (Y>=Y1) And (Y<=Y2);
End;

{ Fleche triangulaire : Dir 1 haut, 2 bas, 3 gauche, 4 droite }
Procedure GArrow(CX,CY,Dir,C: Integer);
Var I: Integer;
Begin
 Case Dir Of
  1: For I:=0 To 3 Do GHLine(CX-I,CX+I,CY-3+I,C);
  2: For I:=0 To 3 Do GHLine(CX-I,CX+I,CY+3-I,C);
  3: For I:=0 To 3 Do GVLine(CX-3+I,CY-I,CY+I,C);
  4: For I:=0 To 3 Do GVLine(CX+3-I,CY-I,CY+I,C);
 End;
End;

