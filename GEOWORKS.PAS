{ Gestion d'un clic sur le bureau                                          }
{ ---------------------------------------------------------------------- }

Procedure HandleDown(Var E: TEvent);
Var I,Part,Cmd: Integer; W,Hit: PWindow; IX,IY: Integer;
Begin
 Hit:=Nil;
 I:=NWins;
 While (I>=1) And (Hit=Nil) Do Begin
  If Not Wins[I]^.Iconic Then
   If InBox(E.X,E.Y,Wins[I]^.WinX,Wins[I]^.WinY,Wins[I]^.WinX+Wins[I]^.WinW-1,Wins[I]^.WinY+Wins[I]^.WinH-1) Then
    Hit:=Wins[I];
  Dec(I);
 End;
 If Hit=Nil Then Begin
  { icones des fenetres reduites }
  For I:=1 To NWins Do
   If Wins[I]^.Iconic Then Begin
    IconicPos(IconicIndex(Wins[I]),IX,IY);
    If InBox(E.X,E.Y,IX,IY,IX+79,IY+44) Then Begin
     If E.Dbl Then RestoreWin(Wins[I]);
     Exit;
    End;
   End;
  Exit;
 End;
 If Hit<>TopWin Then BringToFront(Hit);
 Part:=WinFrameHit(Hit,E.X,E.Y);
 Case Part Of
  3: If E.Dbl Then CommonCmd(Hit,CM_CLOSE)
     Else Begin
      Cmd:=RunMenus(Hit,1,True);
      If Cmd>0 Then CommonCmd(Hit,Cmd);
     End;
  4: MinimizeWin(Hit);
  5: If Hit^.Maxim Then RestoreWin(Hit) Else MaximizeWin(Hit);
  2: If E.Dbl Then Begin
      If Hit^.Maxim Then RestoreWin(Hit) Else MaximizeWin(Hit);
     End Else If Not Hit^.Maxim Then DragWindow(Hit,E.X,E.Y);
  6: Begin
      Cmd:=RunMenus(Hit,HitMenu,False);
      If Cmd>0 Then WinCommand(Hit,Cmd);
     End;
  7: SizeWindow(Hit,HitEdge,E.X,E.Y);
  1: Begin
      Capture:=Hit;
      WinMouse(Hit,E);
     End;
 End;
End;

Procedure PurgeDead;
Var I: Integer;
Begin
 I:=1;
 While I<=NWins Do Begin
  If Wins[I]^.Dead Then RemoveWindow(Wins[I]) Else Inc(I);
 End;
End;

{ Boucle principale du bureau ; retourne 1 (accueil) ou 2 (quitter) }
{ Veille : ecran noir jusqu'a la prochaine activite }
Procedure LightsOut;
Var Ch: Char; X,Y,B,X0,Y0: LongInt;
Begin
 HideMouse;ClipFull;
 GBar(0,0,SCR_W-1,SCR_H-1,cBlk);
 X0:=MX;Y0:=MY;
 GetMouseState(X,Y,B);X0:=X;Y0:=Y;
 Repeat
  GetMouseState(X,Y,B);
 Until KeyPressed Or (B<>0) Or (Abs(X-X0)>3) Or (Abs(Y-Y0)>3);
 While KeyPressed Do Ch:=ReadKey;
 LastActCs:=NowCs;
 NeedFull:=True;
 ShowMouse;
End;

Function DesktopLoop: Integer;
Var E: TEvent; Tick,Nw: LongInt; I: Integer; W: PWindow; Cmd: Integer;
Begin
 ExitDesk:=0;Capture:=Nil;LastActCs:=NowCs;LightsOk:=True;
 NeedFull:=True;
 FlushPaint;
 Tick:=NowCs;
 Repeat
  PollEvent(E);
  If LightsOk And (LightsMin>0) And (NowCs>=LastActCs) And (NowCs-LastActCs>LightsMin*6000) Then LightsOut;
  Case E.Kind Of
   EV_DOWN,EV_RDOWN:
     If E.Kind=EV_DOWN Then HandleDown(E)
     Else Begin
      W:=TopWin;
      If W<>Nil Then Begin
       I:=WinFrameHit(W,E.X,E.Y);
       If I=1 Then WinMouse(W,E);
      End;
     End;
   EV_MOVE,EV_UP: Begin
     If Capture<>Nil Then WinMouse(Capture,E);
     If E.Kind=EV_UP Then Capture:=Nil;
    End;
   EV_KEY: Begin
     W:=TopWin;
     Case E.Key Of
      K_F10: If (W<>Nil) And (W^.NMenu>0) Then Begin
              Cmd:=RunMenus(W,1,False);
              If Cmd>0 Then WinCommand(W,Cmd);
             End;
      K_ALTF4: If W<>Nil Then CommonCmd(W,CM_CLOSE);
      K_F6: NextWindow;
     Else
      If W<>Nil Then WinKey(W,E.Key);
     End;
    End;
  End;
  Nw:=NowCs;
  If (Nw<Tick) Or (Nw-Tick>=8) Then Begin
   Tick:=Nw;
   For I:=1 To NWins Do
    If WinIdle(Wins[I]) Then Wins[I]^.Dirty:=True;
  End;
  PurgeDead;
  If NWins=0 Then ExitDesk:=1;
  FlushPaint;
 Until ExitDesk<>0;
 LightsOk:=False;
 DesktopLoop:=ExitDesk;
End;

