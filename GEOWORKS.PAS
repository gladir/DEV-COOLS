Procedure GThickLine(X1,Y1,X2,Y2,C,T: Integer);
Begin
 SetColor(C);
 If T>1 Then SetLineStyle(SolidLn,0,ThickWidth) Else SetLineStyle(SolidLn,0,NormWidth);
 Line(X1-VX,Y1-VY,X2-VX,Y2-VY);
 SetLineStyle(SolidLn,0,NormWidth);
End;

Function GlyphDef(Ch: Char): String;
Begin
 Case Ch Of
  'A': GlyphDef:='06 02 20 42 46 .. 03 43';
  'B': GlyphDef:='00 06 36 46 45 33 03 .. 33 42 31 30 00';
  'C': GlyphDef:='41 30 10 01 05 16 36 45';
  'D': GlyphDef:='00 06 26 45 41 20 00';
  'E': GlyphDef:='40 00 06 46 .. 03 33';
  'F': GlyphDef:='40 00 06 .. 03 33';
  'G': GlyphDef:='41 30 10 01 05 16 36 45 43 23';
  'H': GlyphDef:='00 06 .. 40 46 .. 03 43';
  'I': GlyphDef:='10 30 .. 20 26 .. 16 36';
  'K': GlyphDef:='00 06 .. 40 03 46';
  'L': GlyphDef:='00 06 46';
  'M': GlyphDef:='06 00 23 40 46';
  'N': GlyphDef:='06 00 46 40';
  'O': GlyphDef:='10 30 41 45 36 16 05 01 10';
  'P': GlyphDef:='06 00 30 41 42 33 03';
  'R': GlyphDef:='06 00 30 41 42 33 03 .. 23 46';
  'S': GlyphDef:='41 30 10 01 02 13 33 44 45 36 16 05';
  'T': GlyphDef:='00 40 .. 20 26';
  'U': GlyphDef:='00 05 16 36 45 40';
  'V': GlyphDef:='00 26 40';
  'W': GlyphDef:='00 16 22 36 40';
  'X': GlyphDef:='00 46 .. 40 06';
  'Y': GlyphDef:='00 23 40 .. 23 26';
  'Z': GlyphDef:='00 40 06 46';
 Else GlyphDef:='';
 End;
End;

{ Dessine du texte avec la police vectorielle : GW = largeur d'une lettre }
Procedure VecText(X,Y,GW,GH: Integer; Const S: String; C,T: Integer);
Var I,K,PX,PY,NX,NY: Integer; D: String; Pen: Boolean;
Begin
 For I:=1 To Length(S) Do Begin
  D:=GlyphDef(UpCase(S[I]));
  Pen:=False;PX:=0;PY:=0;
  K:=1;
  While K<=Length(D) Do Begin
   If D[K]='.' Then Begin Pen:=False;Inc(K,3);End
   Else If D[K]=' ' Then Inc(K)
   Else Begin
    NX:=X+(Ord(D[K])-48)*GW Div 4;
    NY:=Y+(Ord(D[K+1])-48)*GH Div 6;
    If Pen Then GThickLine(PX,PY,NX,NY,C,T);
    PX:=NX;PY:=NY;Pen:=True;
    Inc(K,2);
   End;
  End;
  X:=X+GW+GW Div 3;
 End;
End;

