{ Ouvre un cadre de dialogue centre ; sauvegarde l'arriere-plan }
Procedure DlgBegin(Var Sv: TSave; DW,DH: Integer; Const Title: String; Var X1,
    Y1: Integer);
Begin
 X1:=(SCR_W-DW) Div 2;
 Y1:=(SCR_H-DH) Div 2;
 HideMouse;
 SaveBack(Sv,X1,Y1,X1+DW+5,Y1+DH+5);
 ClipFull;
 GBar(X1+5,Y1+5,X1+DW+4,Y1+DH+4,cBlk);
 GBar(X1,Y1,X1+DW-1,Y1+DH-1,cLGr);
 Bevel1(X1,Y1,X1+DW-1,Y1+DH-1,cWht,cBlk);
 Bevel1(X1+1,Y1+1,X1+DW-2,Y1+DH-2,cLGr,cDGr);
 Bevel1(X1+BORDER-1,Y1+BORDER-1,X1+DW-BORDER,Y1+DH-BORDER,cDGr,cWht);
 GBar(X1+BORDER,Y1+BORDER,X1+DW-BORDER-1,Y1+BORDER+TITLE_H-1,cDGr);
 GTextB((2*X1+DW-TextW(Title)) Div 2,Y1+BORDER+5,Title,cWht);
 ShowMouse;
End;

Procedure DlgEnd(Var Sv: TSave);
Begin
 HideMouse;
 RestoreBack(Sv);
 ShowMouse;
End;

