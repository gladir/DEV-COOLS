 WinAddItem(Wd_,'Delete~Supprimer~L'#148'schen',CM_SCDEL,'Del');
 WinAddMenu(Wd_,'View~Affichage~Ansicht');
 WinAddItem(Wd_,'Reduced to 25%~R'#130'duit '#133' 25 %~Verkleinert auf 25%',
     CM_SCZ0,'');
 WinAddItem(Wd_,'Reduced to 50%~R'#130'duit '#133' 50 %~Verkleinert auf 50%',
