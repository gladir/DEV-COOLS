Type
 TBA4 = Array[1..4] Of Integer;

Procedure BIll;
Begin
 BFail(T3('Illegal quantity','Quantit'#130' ill'#130'gale',
     'Ung'#129'ltige Menge'));
End;

{ lit N expressions numeriques separees par des virgules }
Function BInts(N: Integer; Var V: TBA4): Boolean;
Var I: Integer; R: TBVal;
Begin
 BInts:=False;
 For I:=1 To N Do Begin
  If I>1 Then BExpect(',');
  If CB^.Done Then Exit;
  If Not BExpr(R) Then Exit;
  V[I]:=Trunc(BNum(R));
 End;
 BInts:=Not CB^.Done;
End;

Function BStrArg(Var S: String): Boolean;
Var R: TBVal;
Begin
 BStrArg:=False;
 If Not BExpr(R) Then Exit;
 If R.IsS Then S:=R.T Else S:=FmtReal(R.N);
 BStrArg:=True;
End;

Procedure BPost(L: Integer);
Begin
 If L<=0 Then Exit;
 If CB^.NPnd<8 Then Begin Inc(CB^.NPnd);CB^.Pnd[CB^.NPnd]:=L;End;
End;

{ ressources : recherche par nom }
Function BResMenu(Const Nm: String): Integer;
Var I: Integer;
Begin
 BResMenu:=0;
 For I:=1 To GbRes.NM Do If Upper(GbRes.M[I].Name)=Upper(Nm) Then BResMenu:=I;
End;

Function BResIcons(Const Nm: String): Integer;
Var I: Integer;
Begin
 BResIcons:=0;
 For I:=1 To GbRes.NI Do If Upper(GbRes.I[I].Name)=Upper(Nm) Then BResIcons:=I;
End;

Function BResDlg(Const Nm: String): Integer;
Var I: Integer;
Begin
 BResDlg:=0;
 For I:=1 To GbRes.ND Do If Upper(GbRes.D[I].Name)=Upper(Nm) Then BResDlg:=I;
End;

Function BResBmp(Const Nm: String): Integer;
Var I: Integer;
Begin
 BResBmp:=0;
 For I:=1 To GbRes.NB Do If Upper(GbRes.B[I].Name)=Upper(Nm) Then BResBmp:=I;
End;

Procedure BNoRes(Const K,Nm: String);
Begin
 BFail(K+' '+Nm+' '+T3('not found','introuvable','nicht gefunden'));
End;

{ evalue un texte d'expression (boite de dialogue) }
Function BEvalText(Const Ex: String; Var R: TBVal): Boolean;
Var Sv: String; SvP: Integer;
Begin
 Sv:=CB^.Ln_;SvP:=CB^.Ps;
 CB^.Ln_:=Ex;CB^.Ps:=1;
 BEvalText:=BExpr(R);
 CB^.Ln_:=Sv;CB^.Ps:=SvP;
End;

{ boite de dialogue creee avec l'editeur : DIALOG "nom"[,variable] }
Procedure BDoDialog;
Var Nm,TT,BT,Lb: String; D,I,NB,Ret,V,Pk: Integer; R: TBVal; W: String;
Num: Array[1..4] Of Integer;
Begin
 If Not BStrArg(Nm) Then Exit;
 V:=0;
 If BCh(',') Then Begin
  W:=BWord(True);
  If W<>'' Then V:=BFindVar(W,True,0,0,0);
 End;
 D:=BResDlg(Nm);
 If D=0 Then Begin BNoRes('Dialog',Nm);Exit;End;
 TT:='';BT:='';NB:=0;
 For I:=1 To GbRes.D[D].N Do Begin
  Case GbRes.D[D].It[I].K Of
   1: Begin If TT<>'' Then TT:=TT+'|';TT:=TT+GbRes.D[D].It[I].Txt;End;
   2: Begin
       If BEvalText(GbRes.D[D].It[I].Txt,R) Then Begin
        If TT<>'' Then TT:=TT+'|';
        If R.IsS Then TT:=TT+R.T Else TT:=TT+FmtReal(R.N);
       End;
      End;
   3,4,5,6: If NB<4 Then Begin
       Inc(NB);
       Case GbRes.D[D].It[I].K Of
        4: Begin Lb:='OK';Num[NB]:=1;End;
        5: Begin Lb:=T3('Cancel','Annuler','Abbrechen');Num[NB]:=2;End;
        6: Begin Lb:='Disk';Num[NB]:=3;End;
       Else Begin Lb:=GbRes.D[D].It[I].Txt;Num[NB]:=3+NB;End;
       End;
       If BT<>'' Then BT:=BT+'|';BT:=BT+Lb;
      End;
  End;
 End;
 If NB=0 Then Begin BT:='OK';Num[1]:=1;NB:=1;End;
 Pk:=MsgBox('GeoBASIC',TT,BT,0);
 If (Pk<1) Or (Pk>NB) Then Pk:=1;
 Ret:=Num[Pk];
 If V<>0 Then BSetV(@CB^.Var_[V].P^[0],False,Ret,'');
End;

Procedure BDoBitmap;
Var Nm: String; V: TBA4; B,X,Y: Integer;
Begin
 BExpect('(');If Not BStrArg(Nm) Then Exit;BExpect(')');
 BExpect(',');If Not BInts(2,V) Then Exit;
 B:=BResBmp(Nm);
 If B=0 Then Begin BNoRes('Bitmap',Nm);Exit;End;
 If (V[1]<0) Or (V[1]>39) Or (V[2]<0) Or (V[2]>199) Then Begin BIll;Exit;End;
 For Y:=0 To GbRes.B[B].H-1 Do
  For X:=0 To GbRes.B[B].W-1 Do
   If GbRes.B[B].D[Y,X]<>0 Then BPix(V[1]*8+X,V[2]+Y,BFgCol);
End;

Procedure BDoSysinfo;
Var V: TBA4; R: TBVal; W: String; Vi: Integer; Y,M,D,Wd,H,Mi,S,C: Word;
T: String; IsS: Boolean;
Begin
 If Not BInts(1,V) Then Exit;
 BCh(',');
 W:=BWord(True);
 If W='' Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
     'Syntaxfehler'));Exit;End;
 Vi:=BFindVar(W,True,0,0,0);
 If Vi=0 Then Exit;
 GetDate(Y,M,D,Wd);GetTime(H,Mi,S,C);
 T:='';R.N:=0;IsS:=False;
 Case V[1] Of
  0: R.N:=0;
  1: R.N:=2;
  2: Begin R.N:=0;If Lang=1 Then R.N:=1 Else If Lang=2 Then R.N:=2;End;
  3: R.N:=8;
  4: R.N:=319;
  5: R.N:=199;
  6: R.N:=CB^.ErrNo;
  7: R.N:=H;
  8: R.N:=Mi;
  9: R.N:=S;
  10: R.N:=M;
  11: R.N:=D;
  12: R.N:=Y;
  13: R.N:=0;
  14: Begin IsS:=True;T:='';End;
  15: Begin IsS:=True;T:=Pad2(H)+':'+Pad2(Mi)+':'+Pad2(S);End;
  16: Begin IsS:=True;T:=IntStr(M)+'/'+IntStr(D)+'/'+IntStr(Y);End;
 Else Begin BIll;Exit;End;
 End;
 If CB^.Var_[Vi].IsS Then Begin
  If Not IsS Then T:=FmtReal(R.N);
  BSetV(@CB^.Var_[Vi].P^[0],True,0,T);
 End Else BSetV(@CB^.Var_[Vi].P^[0],False,R.N,'');
End;

{ DEF FNnom(x)=expression }
Procedure BDoDef;
Var W,Nm,Par: String; I,P,N: Integer;
Begin
 W:=Upper(BWord(True));
 If Copy(W,1,2)<>'FN' Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
     'Syntaxfehler'));Exit;End;
 Nm:=Copy(W,3,10);
 BExpect('(');Par:=BWord(True);BExpect(')');BExpect('=');
 If CB^.Done Then Exit;
 I:=0;For P:=1 To CB^.NFn Do If CB^.Fns[P].Nm=Nm Then I:=P;
 If I=0 Then Begin
  If CB^.NFn>=16 Then Begin BFail(T3('Too many functions','Trop de fonctions',
      'Zu viele Funktionen'));Exit;End;
  Inc(CB^.NFn);I:=CB^.NFn;
 End;
 CB^.Fns[I].Nm:=Nm;CB^.Fns[I].Par:=Upper(Par);
 P:=CB^.Ps;N:=0;
 While P<=Length(CB^.Ln_) Do Begin
  If CB^.Ln_[P]='"' Then Begin Inc(P);
  While (P<=Length(CB^.Ln_)) And (CB^.Ln_[P]<>'"') Do Inc(P);End
  Else If CB^.Ln_[P]='(' Then Inc(N)
  Else If CB^.Ln_[P]=')' Then Dec(N)
  Else If (CB^.Ln_[P]=':') And (N<=0) Then Break;
  Inc(P);
 End;
 CB^.Fns[I].Ex:=Copy(CB^.Ln_,CB^.Ps,Min2(100,P-CB^.Ps));
 CB^.Ps:=P;
End;

{ fichiers : OPEN, CREATE, WRITE, DREAD, RDBYTE ... (fichier texte) }
Procedure BFileClose;
Begin
 If BFileOpen Then Begin {$I-}Close(BFile);{$I+}If IOResult<>0 Then Begin End;
 End;
 BFileOpen:=False;
End;

Procedure BDoOpen(Create: Boolean);
Var Nm: String; V: TBA4;
Begin
 If Not BStrArg(Nm) Then Exit;
 If BCh(',') Then BInts(1,V);
 BFileClose;
 Assign(BFile,Nm);
 {$I-}
 If Create Then Rewrite(BFile) Else Reset(BFile);
 {$I+}
 If IOResult<>0 Then Begin
  BFail(T3('File not found','Fichier introuvable','Datei nicht gefunden'));Exit;
 End;
 BFileOpen:=True;BFileWr:=Create;
End;

Procedure BDoWrite;
Var R: TBVal; S,Ln: String;
Begin
 If Not BFileOpen Then Begin BFail(T3('Unopened file','Fichier non ouvert',
     'Datei nicht ge'#148'ffnet'));Exit;End;
 Ln:='';
 Repeat
  If Not BExpr(R) Then Exit;
  If R.IsS Then S:='"'+R.T+'"' Else S:=FmtReal(R.N);
  If Ln<>'' Then Ln:=Ln+',';
  Ln:=Ln+S;
 Until (Not BCh(',')) Or CB^.Done;
 {$I-}
 If BFileWr Then WriteLn(BFile,Ln);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Procedure BDoDread;
Var W,Ln,Item: String; V,I1,I2,P: Integer; Q: Boolean; D: Double; N: Integer;
A: TBVal; PE: PBVal;
Begin
 If Not BFileOpen Then Begin BFail(T3('Unopened file','Fichier non ouvert',
     'Datei nicht ge'#148'ffnet'));Exit;End;
 Ln:='';
 {$I-}
 If Not Eof(BFile) Then ReadLn(BFile,Ln);
 {$I+}
 If IOResult<>0 Then Begin End;
 P:=1;
 Repeat
  W:=BWord(True);
  I1:=0;I2:=0;
  V:=BFindVar(W,False,0,0,0);
  If BPeek='(' Then Begin
   Inc(CB^.Ps);If Not BExpr(A) Then Exit;I1:=Trunc(BNum(A));
   If BCh(',') Then Begin If Not BExpr(A) Then Exit;I2:=Trunc(BNum(A));End;
   BExpect(')');
   If V=0 Then V:=BFindVar(W,True,10,10,2);
  End Else If V=0 Then V:=BFindVar(W,True,0,0,0);
  Item:='';Q:=False;
  While (P<=Length(Ln)) And ((Ln[P]<>',') Or Q) Do Begin
   If Ln[P]='"' Then Q:=Not Q Else Item:=Item+Ln[P];
   Inc(P);
  End;
  Inc(P);
  PE:=BElem(V,I1,I2);
  If PE=Nil Then Exit;
  If CB^.Var_[V].IsS Then BSetV(PE,True,0,Item)
  Else Begin Val(TrimStr(Item),D,N);If N<>0 Then D:=0;BSetV(PE,False,D,'');End;
 Until (Not BCh(',')) Or CB^.Done;
End;

Procedure BDoRdbyte;
Var W: String; V: Integer; C: Char; PE: PBVal;
Begin
 If Not BFileOpen Then Begin BFail(T3('Unopened file','Fichier non ouvert',
     'Datei nicht ge'#148'ffnet'));Exit;End;
 Repeat
  W:=BWord(True);
  V:=BFindVar(W,True,0,0,0);
  If V=0 Then Exit;
  C:=#0;
  {$I-}
  If Not Eof(BFile) Then Begin
   If Eoln(BFile) Then Begin ReadLn(BFile);C:=#13;End Else Read(BFile,C);
  End Else Begin BFail(T3('Buffer overflow','D'#130'passement de tampon',
      'Pufferuberlauf'));Exit;End;
  {$I+}
  If IOResult<>0 Then Begin End;
  PE:=@CB^.Var_[V].P^[0];
  If CB^.Var_[V].IsS Then BSetV(PE,True,0,C) Else BSetV(PE,False,Ord(C),'');
 Until (Not BCh(',')) Or CB^.Done;
End;

Procedure BDoDbfile;
Var W,S: String; V: Integer;
Begin
 W:=BWord(True);
 V:=BFindVar(W,True,0,0,0);
 S:='';
 If Not InputBox('DBFILE',T3('File name:','Nom du fichier :','Dateiname:'),S,
     40) Then S:='';
 If V<>0 Then BSetV(@CB^.Var_[V].P^[0],True,0,S);
 If S<>'' Then Begin
  BFileClose;Assign(BFile,S);
  {$I-}Reset(BFile);{$I+}
  If IOResult=0 Then Begin BFileOpen:=True;BFileWr:=False;End;
 End;
End;

Procedure BDoGet;
Var W: String; V: Integer;
Begin
 Repeat
  W:=BWord(True);
  If W='' Then Exit;
  V:=BFindVar(W,True,0,0,0);
  If V=0 Then Exit;
  If CB^.Var_[V].IsS Then BSetV(@CB^.Var_[V].P^[0],True,0,CB^.LastKey)
  Else Begin
   If CB^.LastKey='' Then BSetV(@CB^.Var_[V].P^[0],False,0,
       '') Else BSetV(@CB^.Var_[V].P^[0],False,Ord(CB^.LastKey[1]),'');
  End;
  CB^.LastKey:='';
 Until (Not BCh(',')) Or CB^.Done;
End;

Procedure BDoPrascii;
Var R: TBVal; S: String; NL: Boolean;
Begin
 NL:=True;
 While Not BAtEnd Do Begin
  If BPeek=':' Then Break;
  If Not BExpr(R) Then Exit;
  If R.IsS Then S:=R.T Else Begin S:=FmtReal(R.N);If R.N>=0 Then S:=' '+S;
  S:=S+' ';End;
  BPrnPut(S);NL:=True;
  If BPeek=';' Then Begin Inc(CB^.Ps);NL:=False;End
  Else If BPeek=',' Then Begin Inc(CB^.Ps);NL:=False;BPrnPut(#9);End Else Break;
 End;
 If NL Then BPrnPut(#13);
End;

Procedure BCmdGb(Const U: String; Var H: Boolean);
Var V: TBA4; R,R2: TBVal; I,J,N,L,X,Y,Sv: Integer; T,W: String;
Begin
 H:=True;
 If U='SETCOL' Then Begin If BExpr(R) Then CB^.ColV:=Trunc(BNum(R)) And 255;
 Exit;End;
 If U='SETPOS' Then Begin
  If Not BInts(2,V) Then Exit;
  If (V[1]<0) Or (V[1]>319) Or (V[2]<0) Or (V[2]>199) Then Begin BIll;Exit;End;
  CB^.CurC:=Max2(CB^.WX1,Min2(CB^.WX2,V[1] Div 8));
  CB^.CurR:=Max2(CB^.WY1,Min2(CB^.WY2,V[2] Div 8));Exit;
 End;
 If U='PATTERN' Then Begin
  If BExpr(R) Then Begin
   N:=Trunc(BNum(R));
   If (N<0) Or (N>31) Then BIll Else CB^.Pat:=N;
  End;
  Exit;
 End;
 If U='POINT' Then Begin
  If Not BInts(2,V) Then Exit;
  If (V[1]<0) Or (V[1]>319) Or (V[2]<0) Or (V[2]>199) Then Begin BIll;Exit;End;
  BPix(V[1],V[2],BFgCol);Exit;
 End;
 If (U='RECT') Or (U='FRECT') Or (U='INVRECT') Then Begin
  If Not BInts(4,V) Then Exit;
  If (V[1]<0) Or (V[3]>319) Or (V[2]<0) Or (V[4]>199) Or (V[3]<V[1])
      Or (V[4]<V[2]) Then Begin BIll;Exit;End;
  If U='RECT' Then BFillR(V[1],V[2],V[3],V[4],BFgCol)
  Else If U='FRECT' Then BFrameR(V[1],V[2],V[3],V[4])
  Else Begin
   For Y:=V[2] To V[4] Do For X:=V[1] To V[3] Do
    If CB^.Scr[Y,X]=CLRBG Then CB^.Scr[Y,X]:=0 Else CB^.Scr[Y,X]:=CLRBG;
  End;
  Exit;
 End;
 If U='COLRECT' Then Begin
  If Not BInts(4,V) Then Exit;
  If (V[1]<0) Or (V[3]>39) Or (V[2]<0) Or (V[4]>24) Or (V[3]<V[1])
      Or (V[4]<V[2]) Then Begin BIll;Exit;End;
  Sv:=CB^.Pat;CB^.Pat:=0;
  BFillR(V[1]*8,V[2]*8,V[3]*8+7,V[4]*8+7,BBgCol);
  CB^.Pat:=Sv;Exit;
 End;
 If U='LINE' Then Begin
  If BPeek='(' Then Begin
   { forme etendue : LINE (x,y)-(x,y)[,couleur[,B|BF]] }
   BExpect('(');If Not BExpr(R) Then Exit;BExpect(',');
   If Not BExpr(R2) Then Exit;BExpect(')');
   BExpect('-');BExpect('(');
   V[1]:=Trunc(BNum(R));V[2]:=Trunc(BNum(R2));
   If Not BExpr(R) Then Exit;BExpect(',');If Not BExpr(R2) Then Exit;
   BExpect(')');
   V[3]:=Trunc(BNum(R));V[4]:=Trunc(BNum(R2));
   N:=CB^.Pen;If BCh(',') Then If BExpr(R) Then N:=Trunc(BNum(R)) And 15;
   L:=2;
   If BCh(',') Then Begin T:=Upper(BWord(True));
   If T='B' Then L:=3 Else If T='BF' Then L:=4;End;
   Case L Of
    2: BLineS(V[1],V[2],V[3],V[4],N);
    3: Begin BLineS(V[1],V[2],V[3],V[2],N);BLineS(V[3],V[2],V[3],V[4],N);
    BLineS(V[3],V[4],V[1],V[4],N);BLineS(V[1],V[4],V[1],V[2],N);End;
    4: Begin
        For Y:=Min2(V[2],V[4]) To Max2(V[2],V[4]) Do BLineS(V[1],Y,V[3],Y,N);
       End;
   End;
   Exit;
  End;
  If Not BExpr(R) Then Exit;V[1]:=Trunc(BNum(R));
  BExpect(',');If Not BExpr(R) Then Exit;V[2]:=Trunc(BNum(R));
  If Not BAccept('TO') Then BExpect(',');
  If Not BExpr(R) Then Exit;V[3]:=Trunc(BNum(R));
  BExpect(',');If Not BExpr(R) Then Exit;V[4]:=Trunc(BNum(R));
  If (V[1]<0) Or (V[1]>319) Or (V[3]<0) Or (V[3]>319) Or (V[2]<0) Or (V[2]>199)
      Or (V[4]<0) Or (V[4]>199) Then Begin BIll;Exit;End;
  If CB^.ColV=0 Then BLineS(V[1],V[2],V[3],V[4],BBgCol) Else BLineS(V[1],V[2],
      V[3],V[4],BFgCol);
  Exit;
 End;
 If U='PSET' Then Begin
  BExpect('(');If Not BExpr(R) Then Exit;BExpect(',');
  If Not BExpr(R2) Then Exit;BExpect(')');
  BPix(Trunc(BNum(R)),Trunc(BNum(R2)),CB^.Pen);Exit;
 End;
 If (U='CIRCLE') Or (U='DISC') Then Begin
  BExpect('(');If Not BExpr(R) Then Exit;BExpect(',');
  If Not BExpr(R2) Then Exit;BExpect(')');
  V[1]:=Trunc(BNum(R));V[2]:=Trunc(BNum(R2));
  BExpect(',');If Not BExpr(R) Then Exit;
  N:=CB^.Pen;If BCh(',') Then If BExpr(R2) Then N:=Trunc(BNum(R2)) And 15;
  BCircleS(V[1],V[2],Trunc(BNum(R)),N,U='DISC');Exit;
 End;
 If U='TEXT' Then Begin
  BExpect('(');If Not BExpr(R) Then Exit;BExpect(',');
  If Not BExpr(R2) Then Exit;BExpect(')');
  X:=Trunc(BNum(R)) Div 8;Y:=Trunc(BNum(R2)) Div 8;
  BExpect(',');If Not BExpr(R) Then Exit;
  If R.IsS Then T:=R.T Else T:=FmtReal(R.N);
  For I:=1 To Length(T) Do If (X+I-1>=0) And (X+I-1<=39) And (Y>=0) And (Y<=24)
      Then Begin
   CB^.Tx[Y,X+I-1]:=T[I];CB^.TxK[Y,X+I-1]:=CB^.Pen;
  End;
  Exit;
 End;
 If U='MENU' Then Begin
  If Not BStrArg(T) Then Exit;
  N:=BResMenu(T);
  If N=0 Then Begin BNoRes('Menu',T);Exit;End;
  CB^.CurMenu:=N;CB^.MenuOpen:=0;Exit;
 End;
 If U='ICON' Then Begin
  If Not BStrArg(T) Then Exit;
  N:=BResIcons(T);
  If N=0 Then Begin BNoRes('Icon',T);Exit;End;
  CB^.CurIcons:=N;Exit;
 End;
 If U='DIALOG' Then Begin BDoDialog;Exit;End;
 If U='BITMAP' Then Begin BDoBitmap;Exit;End;
 If U='MAINLOOP' Then Begin
  CB^.WaitMain:=True;CB^.InMain:=True;CB^.IntBase:=0;CB^.MainL:=CB^.Ln;
  CB^.MainP:=CB^.StmtP;Exit;
 End;
 If U='BUTTON' Then Begin CB^.BtnL:=BLineTarget;Exit;End;
 If U='REDRAW' Then Begin CB^.RedrawL:=BLineTarget;Exit;End;
 If U='ONERR' Then Begin CB^.OnErrL:=BLineTarget;Exit;End;
 If U='PROCESS' Then Begin
  L:=BLineTarget;BExpect(',');If Not BExpr(R) Then Exit;
  N:=0;For I:=1 To 8 Do If CB^.Procs[I].L=L Then N:=I;
  If N=0 Then For I:=8 DownTo 1 Do If CB^.Procs[I].L=0 Then N:=I;
  If N=0 Then Begin BFail(T3('Too many processes','Trop de processus',
      'Zu viele Prozesse'));Exit;End;
  CB^.Procs[N].L:=L;CB^.Procs[N].Iv:=Trunc(BNum(R))*100 Div 60;
  If CB^.Procs[N].Iv<1 Then CB^.Procs[N].Iv:=1;
  CB^.Procs[N].Last:=NowCs;Exit;
 End;
 If U='DELPROC' Then Begin
  L:=BLineTarget;
  For I:=1 To 8 Do If CB^.Procs[I].L=L Then CB^.Procs[I].L:=0;Exit;
 End;
 If U='MOUSE' Then Begin If BExpr(R) Then CB^.MouseOn:=BNum(R)<>0;Exit;End;
 If U='WINDOW' Then Begin
  If Not BInts(4,V) Then Exit;
  If (V[1]<0) Or (V[1]>312) Or (V[3]<0) Or (V[3]>319) Or (V[2]<0) Or (V[4]>199)
      Then Begin BIll;Exit;End;
  CB^.WX1:=V[1] Div 8;CB^.WY1:=V[2] Div 8;CB^.WX2:=Min2(39,V[3] Div 8);
  CB^.WY2:=Min2(24,V[4] Div 8);
  If CB^.WX2<CB^.WX1 Then CB^.WX2:=CB^.WX1;
  If CB^.WY2<CB^.WY1 Then CB^.WY2:=CB^.WY1;
  CB^.CurC:=CB^.WX1;CB^.CurR:=CB^.WY1;Exit;
 End;
 If U='PROMPT' Then Begin
  If Not BInts(3,V) Then Exit;
  CB^.PromptOn:=V[1]<>0;Exit;
 End;
 If U='HEADER' Then Begin
  If BExpr(R) Then BHdrType:=Trunc(BNum(R));
  If BCh(',') Then BStrArg(BHdrName);
  If BCh(',') Then BExpr(R);
  Exit;
 End;
 If U='DEF' Then Begin BDoDef;Exit;End;
 If U='SYSINFO' Then Begin BDoSysinfo;Exit;End;
 If U='VOICE' Then Begin
  If Not BInts(2,V) Then Exit;
  If (V[1]>=0) And (V[1]<=3) Then CB^.Voice[V[1]]:=V[2];Exit;
 End;
 If (U='FONT') Or (U='SPRITE') Then Begin BStrArg(T);If BCh(',') Then BExpr(R);
 Exit;End;
 If (U='SPRT') Or (U='SPRCOL') Or (U='POKE') Or (U='DPOKE') Or (U='LOAD')
     Or (U='SAVE') Or (U='PRSCREEN') Or (U='PTREC') Or (U='APPEND')
     Or (U='INSERT') Or (U='DELETE') Then Begin
  { arguments evalues et ignores }
  If Not BAtEnd Then Begin
   If BPeek<>':' Then Repeat
    If (U='LOAD') Or (U='SAVE') Then Begin BExpr(R);End Else BExpr(R);
   Until (Not BCh(',')) Or CB^.Done;
  End;
  Exit;
 End;
 If (U='NEWPAGE') Then Exit;
 If U='PRNTER' Then Begin If BExpr(R) Then BPrn:=BNum(R)<>0;Exit;End;
 If U='PRASCII' Then Begin BDoPrascii;Exit;End;
 If U='OPEN' Then Begin BDoOpen(False);Exit;End;
 If U='CREATE' Then Begin BDoOpen(True);Exit;End;
 If U='CLOSE' Then Begin BFileClose;Exit;End;
 If U='WRITE' Then Begin BDoWrite;Exit;End;
 If U='DREAD' Then Begin BDoDread;Exit;End;
 If U='RDBYTE' Then Begin BDoRdbyte;Exit;End;
 If U='DBFILE' Then Begin BDoDbfile;Exit;End;
 If U='GET' Then Begin BDoGet;Exit;End;
 H:=False;
End;


Procedure BStmt;
Var W,U,T: String; R,R2,R3,R4,R5: TBVal; L,N,I: Integer; H: Boolean; C: Integer;
P0: Integer;
Begin
 BSkip;
 If BAtEnd Then Exit;
 P0:=CB^.Ps;CB^.StmtP:=P0;
 { etiquette @nom }
 If CB^.Ln_[CB^.Ps]='@' Then Begin
  Inc(CB^.Ps);While (CB^.Ps<=Length(CB^.Ln_)) And BIsId(CB^.Ln_[CB^.Ps]) Do
      Inc(CB^.Ps);
  Exit;
 End;
 If BPeek=''''  Then Begin CB^.Ps:=Length(CB^.Ln_)+1;Exit;End;
 W:=BWord(False);
 If W='' Then Begin
  If BPeek=':' Then Exit;
  BFail(T3('Syntax error','Erreur de syntaxe','Syntaxfehler'));Exit;
 End;
 U:=Upper(W);
 { etiquette ? }
 If (CB^.Ps+Length(W)<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps+Length(W)]=':')
     And (BFindVar(W,False,0,0,0)=0) And
    (U<>'REM') And (U<>'ELSE') And (U<>'REPEAT') And (U<>'DO') And (U<>'LOOP')
        And (U<>'WEND') And (U<>'NEXT') And (U<>'RETURN') And
    (U<>'END') And (U<>'STOP') And (U<>'CLS') And (U<>'BEEP')
        And (U<>'MAINLOOP') And (U<>'RESTORE') And (U<>'CLOSE')
        And (BFindLine(W)=CB^.Ln) Then Begin
  BWord(True);Inc(CB^.Ps);Exit;
 End;
 BWord(True);
 If U='REM' Then Begin CB^.Ps:=Length(CB^.Ln_)+1;Exit;End;
 If U='LET' Then Begin W:=BWord(True);BAssign(W);Exit;End;
 If U='PRINT' Then Begin BDoPrint;Exit;End;
 If U='?' Then Begin BDoPrint;Exit;End;
 If U='INPUT' Then Begin BDoInput;Exit;End;
 If U='IF' Then Begin BDoIf;Exit;End;
 If U='ELSE' Then Begin
  { fin de la partie THEN d'un IF bloc : saute jusqu'a END IF }
  L:=BScan(CB^.Ln+1,'IF','END IF','');
  If L=0 Then L:=BScan(CB^.Ln+1,'IF','ENDIF','');
  If L=0 Then CB^.Ps:=Length(CB^.Ln_)+1 Else BGotoLine(L);
  Exit;
 End;
 If (U='END') Then Begin
  If Upper(BWord(False))='IF' Then Begin BWord(True);Exit;End;
  If Upper(BWord(False))='SUB' Then Begin
   BWord(True);
   If CB^.NG>0 Then Begin
    Dec(CB^.NG);
    If CB^.GsL[CB^.NG+1]=0 Then Begin CB^.Running:=False;CB^.Done:=True;End
    Else Begin CB^.Ln:=CB^.GsL[CB^.NG+1];CB^.Ln_:=CB^.Src[CB^.Ln]^;
    CB^.Ps:=CB^.GsP[CB^.NG+1];End;
   End
   Else Begin CB^.Running:=False;CB^.Done:=True;End;
   Exit;
  End;
  CB^.Running:=False;CB^.Done:=True;Exit;
 End;
 If U='ENDIF' Then Exit;
 If (U='STOP') Then Begin BPutS(T3('Break in line ','Arr'#136't dans la ligne ',
     'Halt in Zeile ')+IntStr(CB^.Ln)+#13);CB^.Running:=False;CB^.Done:=True;
 Exit;End;
 If U='FOR' Then Begin BDoFor;Exit;End;
 If U='NEXT' Then Begin BDoNext;Exit;End;
 If U='GOTO' Then Begin L:=BLineTarget;BGotoLine(L);Exit;End;
 If U='GOSUB' Then Begin
  L:=BLineTarget;
  If L=0 Then Begin BGotoLine(0);Exit;End;
  If CB^.NG>=BMAXGS Then Begin BFail(T3('Stack overflow',
      'D'#130'passement de pile','Stapel'#129'berlauf'));Exit;End;
  Inc(CB^.NG);CB^.GsL[CB^.NG]:=CB^.Ln;CB^.GsP[CB^.NG]:=CB^.Ps;
  BGotoLine(L);Exit;
 End;
 If U='CALL' Then Begin
  T:=Upper(BWord(True));L:=0;
  For I:=1 To CB^.NSubs Do If CB^.Subs[I]=T Then L:=CB^.SubL[I];
  If L=0 Then Begin BFail(T3('Undefined SUB ','SUB non d'#130'finie ',
      'SUB nicht definiert ')+T);Exit;End;
  If CB^.NG>=BMAXGS Then Begin BFail(T3('Stack overflow',
      'D'#130'passement de pile','Stapel'#129'berlauf'));Exit;End;
  Inc(CB^.NG);CB^.GsL[CB^.NG]:=CB^.Ln;CB^.GsP[CB^.NG]:=Length(CB^.Ln_)+1;
  BGotoLine(L);CB^.Ps:=Length(CB^.Ln_)+1;Exit;
 End;
 If U='SUB' Then Begin
  { definition rencontree en execution normale : saute jusqu'a END SUB }
  L:=BScan(CB^.Ln+1,'SUB','END SUB','');
  If L=0 Then Begin BFail(T3('SUB without END SUB','SUB sans END SUB',
      'SUB ohne END SUB'));Exit;End;
  BGotoLine(L);CB^.Ps:=Length(CB^.Ln_)+1;Exit;
 End;
 If U='RETURN' Then Begin
  If CB^.NG=0 Then Begin BFail(T3('RETURN without GOSUB','RETURN sans GOSUB',
      'RETURN ohne GOSUB'));Exit;End;
  If CB^.GsL[CB^.NG]=0 Then Begin Dec(CB^.NG);CB^.Running:=False;CB^.Done:=True;
  Exit;End;
  CB^.Ln:=CB^.GsL[CB^.NG];CB^.Ln_:=CB^.Src[CB^.Ln]^;CB^.Ps:=CB^.GsP[CB^.NG];
  Dec(CB^.NG);
  If CB^.NG<CB^.IntBase Then CB^.IntBase:=0;
  Inc(CB^.Jmp);
  Exit;
 End;
 If U='ON' Then Begin
  If Not BExpr(R) Then Exit;
  T:=Upper(BWord(True));N:=Trunc(BNum(R));
  I:=0;L:=0;
  Repeat
   Inc(I);
   If I=N Then L:=BLineTarget Else BLineTarget;
  Until (Not BCh(',')) Or CB^.Done;
  If CB^.Done Then Exit;
  If N<0 Then Begin BIll;Exit;End;
  If L<>0 Then Begin
   If T='GOSUB' Then Begin Inc(CB^.NG);CB^.GsL[CB^.NG]:=CB^.Ln;
   CB^.GsP[CB^.NG]:=CB^.Ps;End;
   BGotoLine(L);
  End;
  Exit;
 End;
 { boucles : WHILE..LOOP/WEND, DO..LOOP, REPEAT..UNTIL }
 If U='WHILE' Then Begin
  If Not BExpr(R) Then Exit;
  If BNum(R)=0 Then Begin
   N:=BLoopEndSameLine;
   If N>0 Then Begin CB^.Ps:=N;Exit;End;
   L:=BLoopEnd(CB^.Ln+1);
   If L=0 Then Begin BFail(T3('WHILE without LOOP','WHILE sans LOOP',
       'WHILE ohne LOOP'));Exit;End;
   BGotoLine(L);CB^.Ps:=Length(CB^.Ln_)+1;
  End Else Begin
   If CB^.NLp>=BMAXGS Then Begin BFail(T3('Stack overflow',
       'D'#130'passement de pile','Stapel'#129'berlauf'));Exit;End;
   If (CB^.NLp=0) Or (CB^.Lp[CB^.NLp].L<>CB^.Ln) Or (CB^.Lp[CB^.NLp].K<>1) Then
       BPushLp(1,CB^.Ln,P0);
  End;
  Exit;
 End;
 If U='DO' Then Begin
  T:=Upper(BWord(False));
  If (T='WHILE') Or (T='UNTIL') Then Begin
   BWord(True);If Not BExpr(R) Then Exit;
   If ((T='WHILE') And (BNum(R)=0)) Or ((T='UNTIL') And (BNum(R)<>0)) Then Begin
    N:=BLoopEndSameLine;
    If N>0 Then Begin CB^.Ps:=N;Exit;End;
    L:=BLoopEnd(CB^.Ln+1);
    If L=0 Then Begin BFail(T3('DO without LOOP','DO sans LOOP',
        'DO ohne LOOP'));Exit;End;
    BGotoLine(L);CB^.Ps:=Length(CB^.Ln_)+1;Exit;
   End;
  End;
  If (CB^.NLp=0) Or (CB^.Lp[CB^.NLp].L<>CB^.Ln) Or (CB^.Lp[CB^.NLp].K<>2) Then
      BPushLp(2,CB^.Ln,P0);
  Exit;
 End;
 If (U='LOOP') Or (U='WEND') Then Begin
  If CB^.NLp=0 Then Begin BFail(T3('LOOP without DO','LOOP sans DO',
      'LOOP ohne DO'));Exit;End;
  If CB^.Lp[CB^.NLp].K=1 Then Begin
   { WHILE ... LOOP : retour au test }
   CB^.Ln:=CB^.Lp[CB^.NLp].L;CB^.Ln_:=CB^.Src[CB^.Ln]^;
   CB^.Ps:=CB^.Lp[CB^.NLp].P;Inc(CB^.Jmp);Dec(CB^.NLp);Exit;
  End;
  If CB^.Lp[CB^.NLp].K=3 Then Begin BFail(T3('LOOP without DO','LOOP sans DO',
      'LOOP ohne DO'));Exit;End;
  T:=Upper(BWord(False));H:=True;
  If (T='WHILE') Or (T='UNTIL') Then Begin
   BWord(True);If Not BExpr(R) Then Exit;
   If ((T='WHILE') And (BNum(R)=0)) Or ((T='UNTIL') And (BNum(R)<>0)) Then
       H:=False;
  End;
  If H Then Begin
   CB^.Ln:=CB^.Lp[CB^.NLp].L;CB^.Ln_:=CB^.Src[CB^.Ln]^;
   CB^.Ps:=CB^.Lp[CB^.NLp].P;Inc(CB^.Jmp);
  End Else Dec(CB^.NLp);
  Exit;
 End;
 If U='REPEAT' Then Begin
  If CB^.NLp>=BMAXGS Then Begin BFail(T3('Stack overflow',
      'D'#130'passement de pile','Stapel'#129'berlauf'));Exit;End;
  BPushLp(3,CB^.Ln,CB^.Ps);Exit;
 End;
 If U='UNTIL' Then Begin
  If (CB^.NLp=0) Or (CB^.Lp[CB^.NLp].K<>3) Then Begin
      BFail(T3('UNTIL without REPEAT','UNTIL sans REPEAT','UNTIL ohne REPEAT'));
  Exit;End;
  If Not BExpr(R) Then Exit;
  If BNum(R)=0 Then Begin
   CB^.Ln:=CB^.Lp[CB^.NLp].L;CB^.Ln_:=CB^.Src[CB^.Ln]^;
   CB^.Ps:=CB^.Lp[CB^.NLp].P;Inc(CB^.Jmp);
  End Else Dec(CB^.NLp);
  Exit;
 End;
 If U='DIM' Then Begin BDoDim;Exit;End;
 If U='DATA' Then Begin BDoData;Exit;End;
 If U='READ' Then Begin BDoRead;Exit;End;
 If U='RESTORE' Then Begin CB^.DPos:=0;Exit;End;
 If U='CLS' Then Begin BCls;Exit;End;
 If U='RANDOMIZE' Then Begin If Not BAtEnd Then BExpr(R);CB^.Rnd:=NowCs;Exit;
 End;
 If U='SWAP' Then Begin
  Exit;
 End;
 If U='BEEP' Then Begin Beep;Exit;End;
 If U='COLOR' Then Begin If BExpr(R) Then CB^.Pen:=Trunc(BNum(R)) And 15;Exit;
 End;
 H:=False;
 BCmdGb(U,H);
 If H Then Exit;
 If U='SLEEP' Then Begin If BExpr(R) Then Begin Delay(Trunc(BNum(R)*10));End;
 Exit;End;
 If U='SOUND' Then Begin
  If Not BExpr(R) Then Exit;BExpect(',');If Not BExpr(R2) Then Exit;
  If SoundOn Then Begin Sound(Trunc(BNum(R)));
  Delay(Min2(Trunc(BNum(R2)*10),1000));NoSound;End;Exit;
 End;
 If U='MSGBOX' Then Begin
  If Not BExpr(R) Then Exit;
  If R.IsS Then T:=R.T Else T:=FmtReal(R.N);
  Info('GeoBASIC',T);Exit;
 End;
 If U='GETKEY' Then Begin
  W:=BWord(True);If W<>'' Then Begin
   I:=BFindVar(W,True,0,0,0);
   If I<>0 Then Begin CB^.InVar:=I;CB^.InIdx1:=0;CB^.InIdx2:=0;
   CB^.WaitKey:=True;End;
  End;
  Exit;
 End;
 If U='TRACE' Then Exit;
 { instructions de l'interface GEOS (menus, dialogues, icones, formulaires) }
 H:=False;
 BExtCmd(U,H);
 If H Then Exit;
 { affectation : variable = expression }
 BAssign(W);
End;

Procedure BStmts;
Var J0: LongInt;
Begin
 Repeat
  J0:=CB^.Jmp;
  BStmt;
  If CB^.Done Or CB^.WaitIn Or CB^.WaitKey Or CB^.WaitMain Then Exit;
  If CB^.Jmp<>J0 Then Exit;
  BSkip;
  If (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]=':') Then Inc(CB^.Ps)
  Else If BAtEnd Then Exit
  Else If Upper(BWord(False))='ELSE' Then Begin CB^.Ps:=Length(CB^.Ln_)+1;Exit;
  End
  Else If CB^.Ps>Length(CB^.Ln_) Then Exit
  Else Begin
   { fin d'instruction attendue }
   If CB^.Ln_[CB^.Ps]=';' Then Inc(CB^.Ps)
   Else Begin BFail(T3('Syntax error','Erreur de syntaxe','Syntaxfehler'));Exit;
   End;
  End;
 Until False;
End;

{ ====================================================================== }
{   MODELE DE FORMULAIRE (objets GEOS Gen*) PARTAGE PAR L'EDITEUR ET     }
{   LA FENETRE D'EXECUTION                                                }
{ ====================================================================== }

Const
 FMAX = 96;
 FK_PRIMARY=1; FK_INTER=2; FK_TRIG=3; FK_VALUE=4; FK_TEXT=5; FK_IGROUP=6;
 FK_ITEM=7;
 FK_BGROUP=8; FK_BOOL=9; FK_DGROUP=10; FK_DCTRL=11; FK_DISPLAY=12;
 FK_GLYPH=13; FK_LIST=14;
 FKName : Array[1..14] Of String[18] = ('GenPrimary','GenInteraction',
     'GenTrigger','GenValue','GenText',
   'GenItemGroup','GenItem','GenBooleanGroup','GenBoolean','GenDisplayGroup',
       'GenDisplayControl','GenDisplay','GenGlyph','GenDynamicList');
FKPref : Array[1..14] Of String[10] = ('Primary','Interaction','Trigger',
    'Value','Text','ItemGroup','Item',
   'BooleanGroup','Boolean','DisplayGroup','DisplayCtl','Display','Glyph',
       'List');

Type
 TFObj = Record
  Kind   : Byte;
  Name   : String[20];
  Title  : String[40];
  Parent : Integer;
  Orient : Byte;               { 0 vertical, 1 horizontal }
  WHint  : Byte;               { 0 aucun, 1 petit, 2 moyen, 3 grand }
  HHint  : Byte;
  MonPos : Byte;               { placement du moniker : 0 haut, 1 gauche }
  Feat   : Word;               { caracteristiques de fenetre }
  Val,Min,Max : Integer;
  Txt    : String[60];
  Checked,Enabled,Usable : Boolean;
  X,Y,W,H : Integer;           { calcules par FmLayout }
  SrcRes  : Integer;           { objet GEOS d'origine (arbre) }
  SrcCh   : Word;
 End;

 PForm = ^TForm;
 TForm = Record
  N      : Integer;
  O      : Array[1..FMAX] Of TFObj;
  Sel    : Integer;
  Focus  : Integer;
 End;

Function FmAdd(F: PForm; Kind: Integer; Parent: Integer): Integer;
Var I,C: Integer; Cnt: Integer;
Begin
 FmAdd:=0;
 If F^.N>=FMAX Then Exit;
 Inc(F^.N);I:=F^.N;
 FillChar(F^.O[I],SizeOf(TFObj),0);
 F^.O[I].Kind:=Kind;F^.O[I].Parent:=Parent;F^.O[I].Enabled:=True;
 F^.O[I].Usable:=True;
 Cnt:=0;
 For C:=1 To F^.N-1 Do If F^.O[C].Kind=Kind Then Inc(Cnt);
 F^.O[I].Name:=FKPref[Kind]+IntStr(Cnt+1);
 Case Kind Of
  FK_PRIMARY: F^.O[I].Title:='Untitled Primary';
  FK_INTER: F^.O[I].Title:='Interaction';
  FK_TRIG: F^.O[I].Title:='Trigger';
  FK_VALUE: Begin F^.O[I].Title:='Value';F^.O[I].Max:=100;F^.O[I].Val:=50;End;
  FK_TEXT: Begin F^.O[I].Title:='Text';End;
  FK_IGROUP: F^.O[I].Title:='Choices';
  FK_ITEM: F^.O[I].Title:='Item';
  FK_BGROUP: F^.O[I].Title:='Options';
  FK_BOOL: F^.O[I].Title:='Option';
  FK_DGROUP: F^.O[I].Title:='Documents';
  FK_DCTRL: F^.O[I].Title:='Display Control';
  FK_DISPLAY: F^.O[I].Title:='Display';
 End;
 FmAdd:=I;
End;

Function FmIsContainer(K: Integer): Boolean;
Begin
 FmIsContainer:=K In [FK_PRIMARY,FK_INTER,FK_IGROUP,FK_BGROUP,FK_DGROUP,
     FK_DISPLAY];
End;

Procedure FmDelete(F: PForm; I: Integer);
Var J,K: Integer; Kill: Array[1..FMAX] Of Boolean; Ch: Boolean;
Begin
 If (I<1) Or (I>F^.N) Or (F^.O[I].Kind=FK_PRIMARY) Then Exit;
 FillChar(Kill,SizeOf(Kill),0);Kill[I]:=True;
 Repeat
  Ch:=False;
  For J:=1 To F^.N Do If (Not Kill[J]) And (F^.O[J].Parent>0)
      And Kill[F^.O[J].Parent] Then Begin Kill[J]:=True;Ch:=True;End;
 Until Not Ch;
 { compactage avec renumerotation des parents }
 K:=0;
 For J:=1 To F^.N Do Begin
  If Not Kill[J] Then Begin Inc(K);F^.O[K]:=F^.O[J];Kill[J]:=False;End;
 End;
 F^.N:=K;
 { les parents doivent etre recalcules : recherche par nom }
 F^.Sel:=1;F^.Focus:=0;
End;

{ Taille intrinseque et placement recursif }
Procedure FmLayout(F: PForm; I: Integer; X,Y: Integer; Var W,H: Integer);
Var C,CW,CH,CX,CY,MaxW,MaxH,Cnt: Integer; K: Integer; TW: Integer; Pad: Integer;
Begin
 F^.O[I].X:=X;F^.O[I].Y:=Y;
 K:=F^.O[I].Kind;
 TW:=TextW(F^.O[I].Title);
 Case K Of
  FK_TRIG: Begin W:=Max2(70,TW+22);H:=22;End;
  FK_VALUE: Begin W:=TW+8+150;H:=22;End;
  FK_TEXT: Begin W:=TW+8+Max2(100,F^.O[I].Max*0+150);H:=22;End;
  FK_ITEM,FK_BOOL: Begin W:=TW+24;H:=16;End;
  FK_DCTRL: Begin W:=Max2(120,TW+22);H:=22;End;
  FK_GLYPH: Begin W:=TW+4;H:=14;End;
  FK_LIST: Begin W:=Max2(160,TW+8);H:=82;End;
 Else Begin
  { conteneur }
  Pad:=8;
  If (F^.O[I].Feat And $8000)<>0 Then Pad:=2;
  CX:=X+Pad;CY:=Y+Pad;
  If (K<>FK_PRIMARY) And (F^.O[I].Title<>'') Then Inc(CY,10);
  MaxW:=0;MaxH:=0;Cnt:=0;
  For C:=1 To F^.N Do
   If F^.O[C].Parent=I Then Begin
    FmLayout(F,C,CX,CY,CW,CH);
    F^.O[C].W:=CW;F^.O[C].H:=CH;
    Inc(Cnt);
    If F^.O[I].Orient=0 Then Begin Inc(CY,CH+4);If CW>MaxW Then MaxW:=CW;
    MaxH:=CY-(Y+Pad);End
    Else Begin Inc(CX,CW+6);If CH>MaxH Then MaxH:=CH;MaxW:=CX-(X+Pad);End;
   End;
  If Cnt=0 Then Begin MaxW:=120;MaxH:=24;End;
  W:=MaxW+2*Pad;H:=MaxH+2*Pad;
  If (K<>FK_PRIMARY) And (F^.O[I].Title<>'') Then Begin Inc(H,10);
  If W<TW+24 Then W:=TW+24;End;
  Case F^.O[I].WHint Of 1: If W<120 Then W:=120; 2: If W<200 Then W:=200;
  3: If W<300 Then W:=300; End;
  Case F^.O[I].HHint Of 1: If H<60 Then H:=60; 2: If H<110 Then H:=110;
  3: If H<180 Then H:=180; End;
  If K=FK_PRIMARY Then Begin If W<220 Then W:=220;If H<120 Then H:=120;End;
 End;
 End;
 F^.O[I].W:=W;F^.O[I].H:=H;
End;

Function FmHit(F: PForm; PX,PY: Integer): Integer;
Var I: Integer;
Begin
 FmHit:=0;
 For I:=F^.N DownTo 1 Do
  If InBox(PX,PY,F^.O[I].X,F^.O[I].Y,F^.O[I].X+F^.O[I].W-1,
      F^.O[I].Y+F^.O[I].H-1) Then Begin FmHit:=I;Exit;End;
End;

{ Dessine un objet ; Live = execution (valeurs reelles), sinon conception }
Procedure FmDrawObj(F: PForm; I: Integer; Live: Boolean; OX,OY: Integer);
Var X1,Y1,X2,Y2,C,TW,J: Integer; S: String; Sel: Boolean;
Begin
 X1:=F^.O[I].X+OX;Y1:=F^.O[I].Y+OY;X2:=X1+F^.O[I].W-1;Y2:=Y1+F^.O[I].H-1;
 Sel:=(Not Live) And (F^.Sel=I);
 If Live And Not F^.O[I].Usable Then Exit;
 Case F^.O[I].Kind Of
  FK_TRIG: Begin
    Button(X1,Y1,X2,Y2,F^.O[I].Title,False,False,F^.O[I].Enabled);
   End;
  FK_VALUE: Begin
    GText(X1,Y1+7,F^.O[I].Title,cBlk);
    TW:=TextW(F^.O[I].Title)+8;
    Sunken(X1+TW,Y1+3,X2-30,Y2-3,cWht);
    If F^.O[I].Max>F^.O[I].Min Then C:=(X2-30-X1-TW-8)*(F^.O[I].Val-F^.O[I].Min)
        Div (F^.O[I].Max-F^.O[I].Min) Else C:=0;
    Btn3D(X1+TW+2+C,Y1+4,X1+TW+10+C,Y2-4,False);
    GText(X2-26,Y1+7,IntStr(F^.O[I].Val),cBlk);
   End;
  FK_TEXT: Begin
    GText(X1,Y1+7,F^.O[I].Title,cBlk);
    TW:=TextW(F^.O[I].Title)+8;
    Sunken(X1+TW,Y1+1,X2,Y2-1,cWht);
    GText(X1+TW+4,Y1+7,Copy(F^.O[I].Txt,1,(X2-X1-TW-8) Div 8),cBlk);
    If Live And (F^.Focus=I) Then GVLine(X1+TW+4+Min2(Length(F^.O[I].Txt),
        (X2-X1-TW-8) Div 8)*8,Y1+3,Y2-3,cBlk);
   End;
  FK_ITEM: Begin
    GEllipse(X1+6,Y1+7,5,5,cBlk);
    If (F^.O[I].Parent>0) And (F^.O[F^.O[I].Parent].Val=I) Then
        GFillEllipse(X1+6,Y1+7,2,2,cBlk);
    GText(X1+16,Y1+4,F^.O[I].Title,cBlk);
   End;
  FK_BOOL: Begin
    Sunken(X1,Y1+2,X1+11,Y1+13,cWht);
    If F^.O[I].Checked Then Begin GLine(X1+2,Y1+7,X1+5,Y1+11,cBlk);
    GLine(X1+5,Y1+11,X1+10,Y1+3,cBlk);End;
    GText(X1+16,Y1+4,F^.O[I].Title,cBlk);
   End;
  FK_DCTRL: Begin Button(X1,Y1,X2,Y2,F^.O[I].Title,False,False,True);End;
  FK_GLYPH: GText(X1,Y1+3,F^.O[I].Title,cBlk);
  FK_LIST: Begin
    If F^.O[I].Title<>'' Then GText(X1,Y1,F^.O[I].Title,cBlk);
    Sunken(X1,Y1+(Ord(F^.O[I].Title<>'')*10),X2,Y2,cWht);
   End;
 Else Begin
  If (F^.O[I].Kind<>FK_PRIMARY) And ((F^.O[I].Feat And $8000)=0) Then Begin
   GRect(X1,Y1+5,X2,Y2,cDGr);
   If F^.O[I].Title<>'' Then Begin GBar(X1+6,Y1,X1+10+TextW(F^.O[I].Title),Y1+9,
       cLGr);GText(X1+8,Y1+1,F^.O[I].Title,cBlk);End;
  End;
 End;
 End;
 If Sel Then GDotRect(X1-2,Y1-2,X2+2,Y2+2,cRed);
 For J:=1 To F^.N Do If F^.O[J].Parent=I Then FmDrawObj(F,J,Live,OX,OY);
End;

{ Sauvegarde / chargement du formulaire (.GBF) }
Procedure FmSave(F: PForm; Const Path: String);
Var T: Text; I: Integer;
Begin
 {$I-}
 Assign(T,Path);Rewrite(T);
 WriteLn(T,'GBFORM1');
 For I:=1 To F^.N Do
  With F^.O[I] Do
   WriteLn(T,Kind,'|',Name,'|',Title,'|',Parent,'|',Orient,'|',WHint,'|',HHint,
       '|',MonPos,'|',Feat,'|',Val,'|',Min,'|',Max,'|',Txt,'|',Ord(Checked),'|',
       Ord(Enabled),'|',Ord(Usable));
 Close(T);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Function FmPart(Var S: String): String;
Var P: Integer;
Begin
 P:=Pos('|',S);
 If P=0 Then Begin FmPart:=S;S:='';End Else Begin FmPart:=Copy(S,1,P-1);
 Delete(S,1,P);End;
End;

Function FmLoad(F: PForm; Const Path: String): Boolean;
Var T: Text; S: String; I: Integer;
Begin
 FmLoad:=False;
 {$I-}
 Assign(T,Path);Reset(T);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 ReadLn(T,S);
 If S<>'GBFORM1' Then Begin Close(T);Exit;End;
 F^.N:=0;
 While (Not Eof(T)) And (F^.N<FMAX) Do Begin
  ReadLn(T,S);
  If S<>'' Then Begin
   Inc(F^.N);I:=F^.N;FillChar(F^.O[I],SizeOf(TFObj),0);
   With F^.O[I] Do Begin
    Kind:=StrVal(FmPart(S),1);Name:=FmPart(S);Title:=FmPart(S);
    Parent:=StrVal(FmPart(S),0);
    Orient:=StrVal(FmPart(S),0);WHint:=StrVal(FmPart(S),0);
    HHint:=StrVal(FmPart(S),0);MonPos:=StrVal(FmPart(S),0);
    Feat:=StrVal(FmPart(S),0);Val:=StrVal(FmPart(S),0);Min:=StrVal(FmPart(S),0);
    Max:=StrVal(FmPart(S),100);
    Txt:=FmPart(S);Checked:=StrVal(FmPart(S),0)<>0;
    Enabled:=StrVal(FmPart(S),1)<>0;Usable:=StrVal(FmPart(S),1)<>0;
   End;
  End;
 End;
 Close(T);
 {$I+}
 If IOResult<>0 Then Begin End;
 F^.Sel:=1;F^.Focus:=0;
 FmLoad:=F^.N>0;
End;

Function FmFind(F: PForm; Const Nm: String): Integer;
Var I: Integer; U: String;
Begin
 FmFind:=0;U:=Upper(Nm);
 If F=Nil Then Exit;
 For I:=1 To F^.N Do If Upper(F^.O[I].Name)=U Then Begin FmFind:=I;Exit;End;
End;

{ ---------------------- proprietes visibles depuis BASIC
  ---------------------- }

Function BExtVar(Const Nm: String; Var R: TBVal): Boolean;
Var P: Integer; O,Pr: String; F: PForm; I: Integer; Ok: Boolean;
Begin
 BExtVar:=False;Ok:=True;R.IsS:=False;R.N:=0;R.T:='';
 F:=CB^.Refs;
 P:=Pos('.',Nm);O:=Copy(Nm,1,P-1);Pr:=Upper(Copy(Nm,P+1,30));
 I:=FmFind(F,O);
 If I=0 Then Begin BFail(T3('Unknown object ','Objet inconnu ',
     'Unbekanntes Objekt ')+O);Exit;End;
 If (Pr='TEXT') Or (Pr='TITLE') Or (Pr='CAPTION') Then Begin R.IsS:=True;
 If Pr='TEXT' Then R.T:=F^.O[I].Txt Else R.T:=F^.O[I].Title;End
 Else If (Pr='VALUE') Or (Pr='SELECTED') Then R.N:=F^.O[I].Val
 Else If Pr='CHECKED' Then Begin If F^.O[I].Checked Then R.N:=-1 Else R.N:=0;End
 Else If Pr='ENABLED' Then Begin If F^.O[I].Enabled Then R.N:=-1 Else R.N:=0;End
 Else If Pr='USABLE' Then Begin If F^.O[I].Usable Then R.N:=-1 Else R.N:=0;End
 Else If Pr='MIN' Then R.N:=F^.O[I].Min
 Else If Pr='MAX' Then R.N:=F^.O[I].Max
 Else Ok:=False;
 If Not Ok Then BFail(T3('Unknown property ','Propri'#130't'#130' inconnue ',
     'Unbekannte Eigenschaft ')+Nm);
 BExtVar:=Ok;
End;

Function BExtSet(Const Nm: String; Const V: TBVal): Boolean;
Var P: Integer; O,Pr: String; F: PForm; I: Integer;
Begin
 BExtSet:=False;
 F:=CB^.Refs;
 P:=Pos('.',Nm);O:=Copy(Nm,1,P-1);Pr:=Upper(Copy(Nm,P+1,30));
 I:=FmFind(F,O);
 If I=0 Then Exit;
 BExtSet:=True;
 If Pr='TEXT' Then Begin If V.IsS Then F^.O[I].Txt:=Copy(V.T,1,
     60) Else F^.O[I].Txt:=Copy(FmtReal(V.N),1,60);End
 Else If (Pr='TITLE') Or (Pr='CAPTION') Then Begin If V.IsS Then
     F^.O[I].Title:=Copy(V.T,1,40) Else F^.O[I].Title:=Copy(FmtReal(V.N),1,40);
 End
 Else If (Pr='VALUE') Or (Pr='SELECTED') Then F^.O[I].Val:=Trunc(BNum(V))
 Else If Pr='CHECKED' Then F^.O[I].Checked:=BNum(V)<>0
 Else If Pr='ENABLED' Then F^.O[I].Enabled:=BNum(V)<>0
 Else If Pr='USABLE' Then F^.O[I].Usable:=BNum(V)<>0
 Else If Pr='MIN' Then F^.O[I].Min:=Trunc(BNum(V))
 Else If Pr='MAX' Then F^.O[I].Max:=Trunc(BNum(V))
 Else BExtSet:=False;
End;

Procedure BExtCmd(Const U: String; Var Handled: Boolean);
Begin
 Handled:=False;
End;

