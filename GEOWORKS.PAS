Const
 DayNames : Array[0..6] Of String[40] = (
  'Sunday~Dimanche~Sonntag','Monday~Lundi~Montag','Tuesday~Mardi~Dienstag',
  'Wednesday~Mercredi~Mittwoch','Thursday~Jeudi~Donnerstag',
  'Friday~Vendredi~Freitag','Saturday~Samedi~Samstag');
 MonthNames : Array[1..12] Of String[40] = (
  'January~janvier~Januar','February~f'#130'vrier~Februar',
      'March~mars~M'#132'rz',
  'April~avril~April','May~mai~Mai','June~juin~Juni','July~juillet~Juli',
  'August~ao'#150't~August','September~septembre~September',
  'October~octobre~Oktober','November~novembre~November',
  'December~d'#130'cembre~Dezember');

Function DayName(D: Integer): String;
Begin
 DayName:=Part3(DayNames[D Mod 7],Lang);
End;

Function MonthName(M: Integer): String;
Begin
 MonthName:=Part3(MonthNames[Clamp(M,1,12)],Lang);
End;

Function Ordinal(D: Integer): String;
Begin
 Case Lang Of
  0: Begin
      If (D Mod 100>=11) And (D Mod 100<=13) Then Ordinal:=IntStr(D)+'th'
      Else Case D Mod 10 Of
       1: Ordinal:=IntStr(D)+'st';
       2: Ordinal:=IntStr(D)+'nd';
       3: Ordinal:=IntStr(D)+'rd';
      Else Ordinal:=IntStr(D)+'th';
      End;
     End;
  2: Ordinal:=IntStr(D)+'.';
 Else
  If D=1 Then Ordinal:='1er' Else Ordinal:=IntStr(D);
 End;
End;

{ Montant en centimes avec le symbole monetaire }
Function MoneyFmt(Cents: LongInt): String;
Var S,F: String; Neg: Boolean;
Begin
 Neg:=Cents<0;
 If Neg Then Cents:=-Cents;
 S:=NumFmt(Cents Div 100);
 F:=IntStr(Cents Mod 100);
 If Length(F)<2 Then F:='0'+F;
 If DecSep=0 Then S:=S+'.'+F Else S:=S+','+F;
 If CurAfter Then S:=S+' '+CurSym Else S:=CurSym+S;
 If Neg Then S:='-'+S;
 MoneyFmt:=S;
End;

Function LongDateStr(Y,M,D,W: Word): String;
Begin
 Case Lang Of
  0: LongDateStr:=DayName(W)+', '+MonthName(M)+' '+Ordinal(D)+', '+IntStr(Y);
  2: LongDateStr:=DayName(W)+', '+Ordinal(D)+' '+MonthName(M)+' '+IntStr(Y);
 Else LongDateStr:=DayName(W)+' '+Ordinal(D)+' '+MonthName(M)+' '+IntStr(Y);
 End;
End;

Function TimeStr(H,M: Word): String;
Begin
 If Clock24 Or (Lang<>0) Then TimeStr:=Pad2(H)+':'+Pad2(M)
 Else Begin
  If H>=12 Then Begin
   If H>12 Then Dec(H,12);
   TimeStr:=IntStr(H)+':'+Pad2(M)+' PM';
  End Else Begin
   If H=0 Then H:=12;
   TimeStr:=IntStr(H)+':'+Pad2(M)+' AM';
  End;
 End;
End;

Function ShortDateStr(Y,M,D: Word): String;
Begin
 Case ShortFmt Of
  0: ShortDateStr:=IntStr(M)+'/'+IntStr(D)+'/'+IntStr(Y);
  1: ShortDateStr:=Pad2(D)+'/'+Pad2(M)+'/'+IntStr(Y);
  2: ShortDateStr:=IntStr(Y)+'-'+Pad2(M)+'-'+Pad2(D);
  3: ShortDateStr:=Pad2(D)+'.'+Pad2(M)+'.'+IntStr(Y);
 Else ShortDateStr:=IntStr(Y)+'/'+Pad2(M)+'/'+Pad2(D);
 End;
End;

Function DaysInMonth(Y,M: Integer): Integer;
Begin
 Case M Of
  1,3,5,7,8,10,12: DaysInMonth:=31;
  4,6,9,11: DaysInMonth:=30;
 Else
  If ((Y Mod 4=0) And (Y Mod 100<>0)) Or (Y Mod 400=0) Then DaysInMonth:=29
  Else DaysInMonth:=28;
 End;
End;

{ Jour de la semaine (0 = dimanche) - formule de Zeller }
Function DayOfWeek(Y,M,D: Integer): Integer;
Var A,YY,MM: Integer;
Begin
 A:=(14-M) Div 12;
 YY:=Y-A;
 MM:=M+12*A-2;
 DayOfWeek:=(D+YY+YY Div 4-YY Div 100+YY Div 400+(31*MM) Div 12) Mod 7;
End;

