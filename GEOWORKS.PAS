Procedure SolSave(Dt_: PSolit);
Var I: Integer;
Begin
 If Dt_^.UN>=20 Then Begin
  For I:=1 To 19 Do Dt_^.UStack[I]:=Dt_^.UStack[I+1];
  Dt_^.UN:=19;
 End;
 Inc(Dt_^.UN);
 With Dt_^.UStack[Dt_^.UN] Do Begin
  Stock:=Dt_^.Stock;SN:=Dt_^.SN;Waste:=Dt_^.Waste;WN:=Dt_^.WN;Fnd:=Dt_^.Fnd;
  FN:=Dt_^.FN;
  Tab:=Dt_^.Tab;TN:=Dt_^.TN;TD:=Dt_^.TD;Score:=Dt_^.Score;Passes:=Dt_^.Passes;
 End;
End;

Procedure SolUndo(Dt_: PSolit);
Begin
 If Dt_^.UN<=0 Then Exit;
 With Dt_^.UStack[Dt_^.UN] Do Begin
  Dt_^.Stock:=Stock;Dt_^.SN:=SN;Dt_^.Waste:=Waste;Dt_^.WN:=WN;Dt_^.Fnd:=Fnd;
  Dt_^.FN:=FN;
  Dt_^.Tab:=Tab;Dt_^.TN:=TN;Dt_^.TD:=TD;Dt_^.Score:=Score;Dt_^.Passes:=Passes;
 End;
 Dec(Dt_^.UN);
 If Dt_^.Scoring=1 Then Dt_^.VegasTotal:=Dt_^.Score;
End;

{ Points : Std en mode standard, Veg en mode Vegas, rien sans score }
Procedure SolAdd(Dt_: PSolit; Std,Veg: Integer);
Begin
 If Dt_^.Scoring=0 Then Dt_^.Score:=Max2(0,Dt_^.Score+Std)
 Else If Dt_^.Scoring=1 Then Begin Dt_^.Score:=Dt_^.Score+Veg;
 Dt_^.VegasTotal:=Dt_^.Score;End;
End;

Function CardRank(C: Integer): Integer;
Begin
 CardRank:=C Mod 13;
End;

Function CardSuit(C: Integer): Integer;
Begin
 CardSuit:=C Div 13;
End;

Function CardRed(C: Integer): Boolean;
Begin
 CardRed:=(C Div 13=1) Or (C Div 13=2);
End;

Function RankStr(R: Integer): String;
Begin
 Case R Of
  0: RankStr:='A';
  9: RankStr:='10';
  10: RankStr:='J';
  11: RankStr:='Q';
  12: RankStr:='K';
 Else RankStr:=IntStr(R+1);
 End;
End;

Function SuitChar(S: Integer): Char;
Begin
 Case S Of
  0: SuitChar:=#6;
  1: SuitChar:=#3;
  2: SuitChar:=#4;
 Else SuitChar:=#5;
 End;
End;

Function SolNew(AX,AY: Integer): PWindow;
 Var Wd_: PWindow; Dt_: PSolit;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_SOLIT,AX,AY,516,BORDER*2+TITLE_H+MENU_H+TABY+CHT+7*FDY+60,
     'Solitaire');
 Wd_^.IconId:=IC_SOLI;Wd_^.MinW:=516;Wd_^.MinH:=300;
 Dt_^.Draw3:=False;Dt_^.Timed:=True;
 WinAddMenu(Wd_,'Game~Jeu~Spiel');
 WinAddItem(Wd_,'Re-Deal~Redistribuer~Neu geben',CM_GNEW,'F2');
 WinAddItem(Wd_,'Undo~Annuler~R'#129'ckg'#132'ngig',CM_UNDO,'Ctrl+Z');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Options~Options~Optionen');
 WinAddItem(Wd_,'Draw One Card~Tirer une carte~Eine Karte ziehen',CM_DRAW1,'');
 WinAddItem(Wd_,'Draw Three Cards~Tirer trois cartes~Drei Karten ziehen',
     CM_DRAW3,'');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Level: Beginner~Niveau : D'#130'butant~Stufe: Anf'#132'nger',
     CM_SLV0,'');
 WinAddItem(Wd_,'Level: Intermediate~Niveau : Interm'#130+
     'diaire~Stufe: Fortgeschritten',CM_SLV1,'');
 WinAddItem(Wd_,'Level: Advanced~Niveau : Avanc'#130'~Stufe: Experte',CM_SLV2,
     '');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Scoring: Standard~Score : Standard~Wertung: Standard',CM_SSC0,
     '');
 WinAddItem(Wd_,'Scoring: Vegas~Score : Vegas~Wertung: Vegas',CM_SSC1,'');
 WinAddItem(Wd_,'No Scoring~Sans score~Ohne Wertung',CM_SSC2,'');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Timed Game~Partie chronom'#130'tr'#130'e~Zeitspiel',CM_STIMED,
     '');
 SolDeal(Wd_);
 SolNew:=Wd_;
End;

Procedure SolDeal(Wd_: PWindow);
 Var Dt_: PSolit;
Var Deck: Array[1..52] Of Byte; I,J,K,T: Integer;
Begin
 Dt_:=Wd_^.Data;
 For I:=1 To 52 Do Deck[I]:=I-1;
 For I:=52 DownTo 2 Do Begin
  J:=Random(I)+1;T:=Deck[I];Deck[I]:=Deck[J];Deck[J]:=T;
 End;
 K:=0;
 For I:=1 To 7 Do Begin
  Dt_^.TN[I]:=I;Dt_^.TD[I]:=I-1;
  For J:=1 To I Do Begin Inc(K);Dt_^.Tab[I,J]:=Deck[K];End;
 End;
 Dt_^.SN:=0;
 For I:=K+1 To 52 Do Begin Inc(Dt_^.SN);Dt_^.Stock[Dt_^.SN]:=Deck[I];End;
 Dt_^.WN:=0;
 For I:=1 To 4 Do Dt_^.FN[I]:=0;
 Dt_^.Passes:=0;Dt_^.UN:=0;
 If Dt_^.Scoring=1 Then Begin Dt_^.VegasTotal:=Dt_^.VegasTotal-52;
 Dt_^.Score:=Dt_^.VegasTotal;End Else Dt_^.Score:=0;
 Dt_^.Secs:=0;Dt_^.Started:=False;Dt_^.Won:=False;Dt_^.Dragging:=False;
 Dt_^.RShown:=False;
End;

Procedure SolColX(Wd_: PWindow; C: Integer; Var X: Integer);
 Var Dt_: PSolit;
Var X1,Y1,X2,Y2: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 X:=X1+10+(C-1)*GAPX;
End;

Function SolCardY(Wd_: PWindow; Col,K: Integer): Integer;
 Var Dt_: PSolit;
Var Y1,X1,X2,Y2,I,Y: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 Y:=Y1+TABY;
 For I:=1 To K-1 Do
  If I<=Dt_^.TD[Col] Then Y:=Y+BDY Else Y:=Y+FDY;
 SolCardY:=Y;
End;

Procedure SolDrawCard(Wd_: PWindow; X,Y,C: Integer);
 Var Dt_: PSolit;
Var Col: Integer; S,R: String; Sc: Char;
Begin
 Dt_:=Wd_^.Data;
 GBar(X,Y,X+CWD-1,Y+CHT-1,cWht);
 GRect(X,Y,X+CWD-1,Y+CHT-1,cBlk);
 GPix(X,Y,cGrn);GPix(X+CWD-1,Y,cGrn);GPix(X,Y+CHT-1,cGrn);
 GPix(X+CWD-1,Y+CHT-1,cGrn);
 If CardRed(C) Then Col:=cRed Else Col:=cBlk;
 R:=RankStr(CardRank(C));Sc:=SuitChar(CardSuit(C));
 GText(X+4,Y+4,R,Col);
 GText(X+4,Y+14,Sc,Col);
 GText(X+CWD-4-TextW(R),Y+CHT-12,R,Col);
 GText(X+CWD-12,Y+CHT-22,Sc,Col);
 If CardRank(C)>=10 Then Begin
  GRect(X+14,Y+16,X+CWD-15,Y+CHT-17,Col);
  GTextBig(X+(CWD-16) Div 2,Y+(CHT-16) Div 2,R,2,Col);
  GText(X+CWD-24,Y+18,Sc,Col);
  GText(X+16,Y+CHT-26,Sc,Col);
 End Else Begin
  GTextBig(X+(CWD-24) Div 2,Y+(CHT-24) Div 2,Sc,3,Col);
 End;
End;

Procedure SolDrawBack(Wd_: PWindow; X,Y: Integer);
 Var Dt_: PSolit;
Var SC1,SC2,SC3,SC4,I,OX1,OY1,OX2,OY2: Integer;
Begin
 Dt_:=Wd_^.Data;
 GBar(X,Y,X+CWD-1,Y+CHT-1,cWht);
 GRect(X,Y,X+CWD-1,Y+CHT-1,cBlk);
 GPix(X,Y,cGrn);GPix(X+CWD-1,Y,cGrn);GPix(X,Y+CHT-1,cGrn);
 GPix(X+CWD-1,Y+CHT-1,cGrn);
 GBar(X+3,Y+3,X+CWD-4,Y+CHT-4,cCyn);
 OX1:=CX1;OY1:=CY1;OX2:=CX2;OY2:=CY2;
 SC1:=Max2(OX1,X+3);SC2:=Max2(OY1,Y+3);SC3:=Min2(OX2,X+CWD-4);
 SC4:=Min2(OY2,Y+CHT-4);
 If (SC3>=SC1) And (SC4>=SC2) Then Begin
  SetClip(SC1,SC2,SC3,SC4);
  I:=-CHT;
  While I<CWD+CHT Do Begin
   GLine(X+I,Y,X+I+CHT,Y+CHT,cRed);
   GLine(X+I+CHT,Y,X+I,Y+CHT,cRed);
   Inc(I,9);
  End;
  SetClip(OX1,OY1,OX2,OY2);
 End;
 GRect(X+3,Y+3,X+CWD-4,Y+CHT-4,cBlk);
End;

Procedure SolDrawSlot(Wd_: PWindow; X,Y: Integer);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 GDither(X,Y,X+CWD-1,Y+CHT-1,cLGn,cGrn);
 GRect(X,Y,X+CWD-1,Y+CHT-1,cGrn);
End;

Procedure SolDrawClient(Wd_: PWindow);
 Var Dt_: PSolit;
Var X1,Y1,X2,Y2,I,K,X,Y: Integer; S: String;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cGrn);
 { talon et defausse }
 SolColX(Wd_,1,X);
 If Dt_^.SN>0 Then SolDrawBack(Wd_,X,Y1+TOPY) Else SolDrawSlot(Wd_,X,Y1+TOPY);
 SolColX(Wd_,2,X);
 SolDrawSlot(Wd_,X,Y1+TOPY);
 If Dt_^.WN>0 Then Begin
  If Dt_^.Draw3 Then Begin
   K:=Max2(1,Dt_^.WN-2);
   For I:=K To Dt_^.WN Do
    If Not (Dt_^.Dragging And (Dt_^.DSrc=0) And (I=Dt_^.WN)) Then
        SolDrawCard(Wd_,X+(I-K)*14,Y1+TOPY,Dt_^.Waste[I]);
   If Dt_^.Dragging And (Dt_^.DSrc=0) And (Dt_^.WN>1) Then SolDrawCard(Wd_,
       X+(Min2(Dt_^.WN,3)-2)*14,Y1+TOPY,Dt_^.Waste[Dt_^.WN-1]);
  End Else Begin
   If Dt_^.Dragging And (Dt_^.DSrc=0) Then Begin
    If Dt_^.WN>1 Then SolDrawCard(Wd_,X,Y1+TOPY,Dt_^.Waste[Dt_^.WN-1]);
   End Else SolDrawCard(Wd_,X,Y1+TOPY,Dt_^.Waste[Dt_^.WN]);
  End;
 End;
 { fondations }
 For I:=1 To 4 Do Begin
  SolColX(Wd_,3+I,X);
  If Dt_^.FN[I]>0 Then Begin
   If Dt_^.Dragging And (Dt_^.DSrc=7+I) Then Begin
    If Dt_^.FN[I]>1 Then SolDrawCard(Wd_,X,Y1+TOPY,Dt_^.Fnd[I,
        Dt_^.FN[I]-1]) Else SolDrawSlot(Wd_,X,Y1+TOPY);
   End Else SolDrawCard(Wd_,X,Y1+TOPY,Dt_^.Fnd[I,Dt_^.FN[I]]);
  End Else SolDrawSlot(Wd_,X,Y1+TOPY);
 End;
 { colonnes }
 For I:=1 To 7 Do Begin
  SolColX(Wd_,I,X);
  If Dt_^.TN[I]=0 Then SolDrawSlot(Wd_,X,Y1+TABY);
  For K:=1 To Dt_^.TN[I] Do Begin
   If Dt_^.Dragging And (Dt_^.DSrc=I) And (K>Dt_^.TN[I]-Dt_^.DCount) Then
   Else Begin
    Y:=SolCardY(Wd_,I,K);
    If K<=Dt_^.TD[I] Then SolDrawBack(Wd_,X,Y) Else SolDrawCard(Wd_,X,Y,
        Dt_^.Tab[I,K]);
   End;
  End;
 End;
 { barre d'etat }
 GBar(X1,Y2-18,X2,Y2,cLGr);
 GHLine(X1,X2,Y2-18,cWht);
 S:='';
 If Dt_^.Scoring<>2 Then S:=T3('Score: ','Score : ',
     'Punkte: ')+IntStr(Dt_^.Score)+'     ';
 If Dt_^.Timed Then S:=S+T3('Time: ','Temps : ',
     'Zeit: ')+IntStr(Dt_^.Secs Div 60)+':'+Pad2(Dt_^.Secs Mod 60);
 GText(X1+10,Y2-12,S,cBlk);
End;

Function SolIdle(Wd_: PWindow): Boolean;
 Var Dt_: PSolit;
Var N: LongInt;
Begin
 Dt_:=Wd_^.Data;
 SolIdle:=False;
 If Dt_^.Started And Not Dt_^.Won And Not Wd_^.Iconic Then Begin
  N:=(NowCs-Dt_^.StartCs) Div 100;
  If N<0 Then N:=Dt_^.Secs+1;
  If N<>Dt_^.Secs Then Begin
   Dt_^.Secs:=N;SolIdle:=True;
   If (Dt_^.Scoring=0) And Dt_^.Timed And (N>0) And (N Mod 10=0) Then
       SolAdd(Dt_,-1,0);
  End;
 End;
End;

Function SolCanTab(Wd_: PWindow; C,Col: Integer): Boolean;
 Var Dt_: PSolit;
Var T: Integer;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.TN[Col]=0 Then SolCanTab:=CardRank(C)=12
 Else Begin
  T:=Dt_^.Tab[Col,Dt_^.TN[Col]];
  SolCanTab:=(CardRed(C)<>CardRed(T)) And (CardRank(C)=CardRank(T)-1);
 End;
End;

Function SolCanFnd(Wd_: PWindow; C,F: Integer): Boolean;
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.FN[F]=0 Then SolCanFnd:=CardRank(C)=0
 Else SolCanFnd:=(CardSuit(Dt_^.Fnd[F,
     Dt_^.FN[F]])=CardSuit(C)) And (CardRank(C)=CardRank(Dt_^.Fnd[F,
     Dt_^.FN[F]])+1);
End;

Function SolAutoFnd(Wd_: PWindow; C: Integer): Integer;
 Var Dt_: PSolit;
Var F: Integer;
Begin
 Dt_:=Wd_^.Data;
 SolAutoFnd:=0;
 For F:=1 To 4 Do If SolCanFnd(Wd_,C,F) Then Begin SolAutoFnd:=F;Exit;End;
End;

Procedure SolFlip(Wd_: PWindow; Col: Integer);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 If (Dt_^.TN[Col]>0) And (Dt_^.TD[Col]>=Dt_^.TN[Col]) Then Begin
  Dt_^.TD[Col]:=Dt_^.TN[Col]-1;
  SolAdd(Dt_,5,0);
 End;
End;

Procedure SolCheckWin(Wd_: PWindow);
 Var Dt_: PSolit;
Var I,T: Integer;
Begin
 Dt_:=Wd_^.Data;
 T:=0;
 For I:=1 To 4 Do Inc(T,Dt_^.FN[I]);
 If (T=52) And Not Dt_^.Won Then Begin
  Dt_^.Won:=True;
  Info('Solitaire',T3('Congratulations! You won!',
      'F'#130'licitations ! Vous avez gagn'#130' !',
      'Gl'#129'ckwunsch! Sie haben gewonnen!'));
 End;
End;

Procedure SolRemoveSrc(Wd_: PWindow);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.DSrc=0 Then Dec(Dt_^.WN)
 Else If Dt_^.DSrc<=7 Then Begin Dec(Dt_^.TN[Dt_^.DSrc],Dt_^.DCount);
 SolFlip(Wd_,Dt_^.DSrc);End
 Else Dec(Dt_^.FN[Dt_^.DSrc-7]);
End;

Procedure SolRubber(Wd_: PWindow);
 Var Dt_: PSolit;
Var X1,Y1,X2,Y2: Integer;
Begin
 Dt_:=Wd_^.Data;
 ClipFull;
 SetWriteMode(XORPut);
 SetColor(15);
 Rectangle(Dt_^.RX,Dt_^.RY,Dt_^.RX+CWD-1,Dt_^.RY+CHT+(Dt_^.DCount-1)*FDY-1);
 Rectangle(Dt_^.RX+1,Dt_^.RY+1,Dt_^.RX+CWD-2,Dt_^.RY+CHT+(Dt_^.DCount-1)*FDY-2);
 SetWriteMode(NormalPut);
End;

Procedure SolOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PSolit;
Var X1,Y1,X2,Y2,I,K,X,Y,C,F,Col,Tx: Integer; Hit: Boolean; CxC: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 If E.Kind=EV_DOWN Then Begin
  Dt_^.Dragging:=False;
  { talon }
  SolColX(Wd_,1,X);
  If InBox(E.X,E.Y,X,Y1+TOPY,X+CWD-1,Y1+TOPY+CHT-1) Then Begin
   If Not Dt_^.Started Then Begin Dt_^.Started:=True;Dt_^.StartCs:=NowCs;End;
   If Dt_^.SN>0 Then Begin
    SolSave(Dt_);
    K:=1;If Dt_^.Draw3 Then K:=Min2(3,Dt_^.SN);
    For I:=1 To K Do Begin Inc(Dt_^.WN);
    Dt_^.Waste[Dt_^.WN]:=Dt_^.Stock[Dt_^.SN];Dec(Dt_^.SN);End;
   End Else If Dt_^.WN>0 Then Begin
    If Dt_^.Scoring=1 Then Begin
     If Dt_^.Draw3 Then K:=3 Else K:=1;
     If Dt_^.Passes>=K Then Dt_^.WN:=Dt_^.WN+0;
    End Else K:=1000;
    If Dt_^.Passes<K Then Begin
     SolSave(Dt_);
     For I:=Dt_^.WN DownTo 1 Do Begin Inc(Dt_^.SN);
     Dt_^.Stock[Dt_^.SN]:=Dt_^.Waste[I];End;
     Dt_^.WN:=0;Inc(Dt_^.Passes);
     If Dt_^.Scoring=0 Then Begin
      If Dt_^.Draw3 Then Begin
       If Dt_^.Passes<=2 Then SolAdd(Dt_,-30,0) Else SolAdd(Dt_,
           -30*(Dt_^.Passes-1),0);
      End Else Begin
       If Dt_^.Passes<=4 Then SolAdd(Dt_,-10,0) Else SolAdd(Dt_,
           -10*(Dt_^.Passes-3),0);
      End;
     End;
    End;
   End;
   Invalidate(Wd_);Exit;
  End;
  { defausse }
  SolColX(Wd_,2,X);
  If (Dt_^.WN>0) And InBox(E.X,E.Y,X+Ord(Dt_^.Draw3
      And (Dt_^.WN>1))*14*(Min2(Dt_^.WN,3)-1),Y1+TOPY,
      X+Ord(Dt_^.Draw3 And (Dt_^.WN>1))*14*(Min2(Dt_^.WN,3)-1)+CWD-1,
      Y1+TOPY+CHT-1) Then Begin
   If E.Dbl Then Begin
    F:=SolAutoFnd(Wd_,Dt_^.Waste[Dt_^.WN]);
    If F>0 Then Begin
     SolSave(Dt_);
     Inc(Dt_^.FN[F]);Dt_^.Fnd[F,Dt_^.FN[F]]:=Dt_^.Waste[Dt_^.WN];Dec(Dt_^.WN);
     SolAdd(Dt_,10,5);SolCheckWin(Wd_);Invalidate(Wd_);
    End;
    Exit;
   End;
   Dt_^.Dragging:=True;Dt_^.DSrc:=0;Dt_^.DCount:=1;
   Dt_^.DCards[1]:=Dt_^.Waste[Dt_^.WN];
   Dt_^.GrabX:=E.X-(X+Ord(Dt_^.Draw3 And (Dt_^.WN>1))*14*(Min2(Dt_^.WN,3)-1));
   Dt_^.GrabY:=E.Y-(Y1+TOPY);
  End;
  { fondations }
  If Not Dt_^.Dragging Then
   For I:=1 To 4 Do Begin
    SolColX(Wd_,3+I,X);
    If (Dt_^.FN[I]>0) And (Dt_^.Level=0) And InBox(E.X,E.Y,X,Y1+TOPY,X+CWD-1,
        Y1+TOPY+CHT-1) Then Begin
     Dt_^.Dragging:=True;Dt_^.DSrc:=7+I;Dt_^.DCount:=1;
     Dt_^.DCards[1]:=Dt_^.Fnd[I,Dt_^.FN[I]];Dt_^.GrabX:=E.X-X;
     Dt_^.GrabY:=E.Y-(Y1+TOPY);
    End;
   End;
  { colonnes }
  If Not Dt_^.Dragging Then
   For I:=1 To 7 Do Begin
    SolColX(Wd_,I,X);
    K:=Dt_^.TN[I];
    While (K>=1) And Not Dt_^.Dragging Do Begin
     Y:=SolCardY(Wd_,I,K);
     If K>Dt_^.TD[I] Then Begin
      If K=Dt_^.TN[I] Then Tx:=Y+CHT-1 Else Tx:=SolCardY(Wd_,I,K+1)-1;
      If InBox(E.X,E.Y,X,Y,X+CWD-1,Tx) And ((Dt_^.Level<2) Or (K=Dt_^.TD[I]+1)
          Or (K=Dt_^.TN[I])) Then Begin
       If E.Dbl And (K=Dt_^.TN[I]) Then Begin
        F:=SolAutoFnd(Wd_,Dt_^.Tab[I,K]);
        If F>0 Then Begin
         SolSave(Dt_);
         Inc(Dt_^.FN[F]);Dt_^.Fnd[F,Dt_^.FN[F]]:=Dt_^.Tab[I,K];Dec(Dt_^.TN[I]);
         SolFlip(Wd_,I);SolAdd(Dt_,10,5);SolCheckWin(Wd_);
         Invalidate(Wd_);Exit;
        End;
       End;
       Dt_^.Dragging:=True;Dt_^.DSrc:=I;Dt_^.DCount:=Dt_^.TN[I]-K+1;
       For C:=1 To Dt_^.DCount Do Dt_^.DCards[C]:=Dt_^.Tab[I,K+C-1];
       Dt_^.GrabX:=E.X-X;Dt_^.GrabY:=E.Y-Y;
      End;
     End;
     Dec(K);
    End;
   End;
  If Dt_^.Dragging Then Begin
   If Not Dt_^.Started Then Begin Dt_^.Started:=True;Dt_^.StartCs:=NowCs;End;
   Dt_^.RX:=E.X-Dt_^.GrabX;Dt_^.RY:=E.Y-Dt_^.GrabY;
   HideMouse;
   Wd_^.Dirty:=False;
   PaintWinClient(Wd_);
   HideMouse;
   SolRubber(Wd_);Dt_^.RShown:=True;
   ShowMouse;
  End;
 End Else If E.Kind=EV_MOVE Then Begin
  If Dt_^.Dragging Then Begin
   HideMouse;
   If Dt_^.RShown Then SolRubber(Wd_);
   Dt_^.RX:=E.X-Dt_^.GrabX;Dt_^.RY:=E.Y-Dt_^.GrabY;
   SolRubber(Wd_);Dt_^.RShown:=True;
   ShowMouse;
  End;
 End Else If E.Kind=EV_UP Then Begin
  If Dt_^.Dragging Then Begin
   HideMouse;
   If Dt_^.RShown Then SolRubber(Wd_);
   Dt_^.RShown:=False;
   ShowMouse;
   Dt_^.Dragging:=False;
   CxC:=Dt_^.RX+CWD Div 2;Hit:=False;
   { colonne de tableau ? }
   If Dt_^.RY+CHT>Y1+TABY-20 Then Begin
    For I:=1 To 7 Do Begin
     SolColX(Wd_,I,X);
     If (CxC>=X-GAPX Div 2+CWD Div 2) And (CxC<X+CWD+(GAPX-CWD) Div 2+0)
         And Not Hit Then
      If SolCanTab(Wd_,Dt_^.DCards[1],I) And (I<>Dt_^.DSrc) Then Begin
       Hit:=True;
       SolSave(Dt_);
       SolRemoveSrc(Wd_);
       For K:=1 To Dt_^.DCount Do Begin Inc(Dt_^.TN[I]);
       Dt_^.Tab[I,Dt_^.TN[I]]:=Dt_^.DCards[K];End;
       If Dt_^.DSrc=0 Then SolAdd(Dt_,5,0) Else If Dt_^.DSrc>7 Then SolAdd(Dt_,
           -15,-5);
      End;
    End;
   End Else If Dt_^.DCount=1 Then Begin
    For I:=1 To 4 Do Begin
     SolColX(Wd_,3+I,X);
     If (CxC>=X-6) And (CxC<X+CWD+6) And Not Hit Then
      If SolCanFnd(Wd_,Dt_^.DCards[1],I) And (Dt_^.DSrc<>7+I) Then Begin
       Hit:=True;
       SolSave(Dt_);
       SolRemoveSrc(Wd_);
       Inc(Dt_^.FN[I]);Dt_^.Fnd[I,Dt_^.FN[I]]:=Dt_^.DCards[1];
       If Dt_^.DSrc<=7 Then SolAdd(Dt_,10,5);
       SolCheckWin(Wd_);
      End;
    End;
   End;
  End;
  Invalidate(Wd_);
 End;
End;

Procedure SolOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 If K=K_F2 Then Begin SolDeal(Wd_);Invalidate(Wd_);End
 Else If K=K_CTRLZ Then Begin SolUndo(Dt_);Invalidate(Wd_);End;
End;

Procedure SolPrepareMenus(Wd_: PWindow);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 WinSetFlag(Wd_,CM_DRAW1,2,Not Dt_^.Draw3);
 WinSetFlag(Wd_,CM_DRAW3,2,Dt_^.Draw3);
 WinSetFlag(Wd_,CM_SLV0,2,Dt_^.Level=0);WinSetFlag(Wd_,CM_SLV1,2,Dt_^.Level=1);
 WinSetFlag(Wd_,CM_SLV2,2,Dt_^.Level=2);
 WinSetFlag(Wd_,CM_SSC0,2,Dt_^.Scoring=0);
 WinSetFlag(Wd_,CM_SSC1,2,Dt_^.Scoring=1);
 WinSetFlag(Wd_,CM_SSC2,2,Dt_^.Scoring=2);
 WinSetFlag(Wd_,CM_STIMED,2,Dt_^.Timed);WinSetFlag(Wd_,CM_UNDO,1,Dt_^.UN=0);
End;

Procedure SolOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PSolit;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_GNEW: Begin SolDeal(Wd_);Invalidate(Wd_);End;
  CM_DRAW1: Begin Dt_^.Draw3:=False;Invalidate(Wd_);End;
  CM_DRAW3: Begin Dt_^.Draw3:=True;Invalidate(Wd_);End;
  CM_UNDO: Begin SolUndo(Dt_);Invalidate(Wd_);End;
  CM_SLV0: Dt_^.Level:=0;
  CM_SLV1: Dt_^.Level:=1;
  CM_SLV2: Dt_^.Level:=2;
  CM_SSC0: Begin Dt_^.Scoring:=0;SolDeal(Wd_);Invalidate(Wd_);End;
  CM_SSC1: Begin Dt_^.Scoring:=1;SolDeal(Wd_);Invalidate(Wd_);End;
  CM_SSC2: Begin Dt_^.Scoring:=2;SolDeal(Wd_);Invalidate(Wd_);End;
  CM_STIMED: Begin Dt_^.Timed:=Not Dt_^.Timed;Invalidate(Wd_);End;
 Else CommonCmd(Wd_,Cmd);
 End;
End;

