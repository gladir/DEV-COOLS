{ Niveau de gris/bleu du ciel : 0 noir ... 4 bleu uni (tramage) }
Procedure DitherBand(X1,Y1,X2,Y2,Lv: Integer);
Var X,Y: Integer;
Begin
 Case Lv Of
  0: GBar(X1,Y1,X2,Y2,cBlk);
  4: GBar(X1,Y1,X2,Y2,cBlu);
 Else Begin
   GBar(X1,Y1,X2,Y2,cBlk);
   For Y:=Y1 To Y2 Do
    For X:=X1 To X2 Do Begin
     Case Lv Of
      1: If (X And 3=0) And (Y And 1=0) Then GPix(X,Y,cBlu);
      2: If (X+Y) And 1=0 Then GPix(X,Y,cBlu);
      3: If Not ((X And 3=0) And (Y And 1=0)) Then GPix(X,Y,cBlu);
     End;
    End;
  End;
 End;
End;

Procedure PicSky(X1,Y1,X2,Y2: Integer);
Var Y,B,H,Lv: Integer;
Begin
 H:=(Y2-Y1+1);
 For B:=0 To 9 Do Begin
  Y:=Y1+B*H Div 10;
  If B<2 Then Lv:=0 Else If B<4 Then Lv:=1 Else If B<6 Then Lv:=2
  Else If B<7 Then Lv:=3 Else Lv:=4;
  DitherBand(X1,Y,X2,Y1+(B+1)*H Div 10-1,Lv);
 End;
End;

