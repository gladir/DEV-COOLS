Const
 CM_PTODAY=600; CM_PNEXT=601; CM_PPREV=602; CM_PNEWAP=603; CM_PEDIT=604; CM_PDEL=605;
 CM_PNEXTY=606; CM_PPREVY=607; CM_PSAVE=608;
 MAXAP = 400;

Type
 TAppt = Record
  Y,M,D : Integer;
  Tm    : String[5];
  Txt   : String[60];
  Rep   : Integer;      { 0 aucune, 1 jour, 2 semaine, 3 mois, 4 an }
  Alm   : Integer;      { alarme : minutes avant (0 = aucune) }
 End;

 PPlanner = ^TPlanner;
 TPlanner = Record
  Ap     : Array[1..MAXAP] Of TAppt;
  NAp    : Integer;
  CY,CM_,CD : Integer;     { date selectionnee }
  TY,TM,TD  : Integer;     { aujourd'hui }
  SelAp  : Integer;
  Fired  : Array[1..MAXAP] Of Integer;   { jour ou l'alarme a sonne }
  IdleN  : Integer;
 End;

