Const
 SROWS = 99;
 SCOLS = 26;
 SCW   = 72;       { largeur de colonne }
 SRH   = 14;       { hauteur de ligne }
 CM_SNEW=800; CM_SOPEN=801; CM_SSAVE=802; CM_SSAVEAS=803; CM_SCLR=804;
 CM_SCOPY=805;
 CM_SPASTE=806; CM_SCUT=807; CM_SSUM=808; CM_SFILLD=809;

Type
 PSheet = ^TSheet;
 TSheet = Record
  Cells    : Array[1..SROWS,1..SCOLS] Of PString;
  SR,SC    : Integer;
  TopR,LeftC : Integer;
  Editing  : Boolean;
  EditBuf  : String;
  FName    : String;
  Modified : Boolean;
  DB       : Boolean;
 End;

Function ShtNew(AX,AY: Integer; ADB: Boolean; Const AFile: String): PWindow;
Forward;
Procedure ShtDone(Wd_: PWindow); Forward;
Procedure ShtUpdateTitle(Wd_: PWindow); Forward;
Function ShtGet(Wd_: PWindow; R,C: Integer): String; Forward;
Procedure ShtSetCell(Wd_: PWindow; R,C: Integer; Const S: String); Forward;
Procedure ShtCellName(Wd_: PWindow; R,C: Integer; Var S: String); Forward;
Procedure ShtGridRect(Wd_: PWindow; Var X1,Y1,X2,Y2: Integer); Forward;
Procedure ShtReveal(Wd_: PWindow); Forward;
Procedure ShtDrawClient(Wd_: PWindow); Forward;
Procedure ShtCommit(Wd_: PWindow); Forward;
Procedure ShtOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure ShtOnKey(Wd_: PWindow; K: Word); Forward;
Procedure ShtSaveFile(Wd_: PWindow; Const P: String); Forward;
Procedure ShtLoadFile(Wd_: PWindow; Const P: String); Forward;
Function ShtCanClose(Wd_: PWindow): Boolean; Forward;
Procedure ShtOnCommand(Wd_: PWindow; Cmd: Integer); Forward;

Var
 ShSheet : PWindow;
 FmDepth : Integer;
 FmS     : String;
 FmP     : Integer;
 FmErr   : Boolean;
 AccSum,AccMin,AccMax : Real;
 AccCnt  : Integer;
 ClipCell: String[200];

Function FmReal2(V: Real): String;
Var S: String;
Begin
 S:=FmtReal(V);
 If Length(S)>9 Then Str(V:0:2,S);
 FmReal2:=S;
End;

Function CellValue(R,C: Integer; Var Err: Boolean): Real; Forward;

Function FmExpr: Real; Forward;

Procedure FmSkip;
Begin
 While (FmP<=Length(FmS)) And (FmS[FmP]=' ') Do Inc(FmP);
End;

{ Lecture d'une reference de cellule : A1..Z99 ; retourne False si ce n'en est
  pas une }
Function FmCellRef(Var R,C: Integer): Boolean;
Var P,Q: Integer; N: String;
Begin
 FmCellRef:=False;
 P:=FmP;
 If (P>Length(FmS)) Or Not (UpCase(FmS[P]) In ['A'..'Z']) Then Exit;
 C:=Ord(UpCase(FmS[P]))-64;Inc(P);
 Q:=P;
 While (P<=Length(FmS)) And (FmS[P] In ['0'..'9']) Do Inc(P);
 If P=Q Then Exit;
 N:=Copy(FmS,Q,P-Q);
 R:=StrVal(N,0);
 If (R<1) Or (R>SROWS) Then Exit;
 FmP:=P;
 FmCellRef:=True;
End;

Procedure FmAccAdd(V: Real);
Begin
 AccSum:=AccSum+V;
 If AccCnt=0 Then Begin AccMin:=V;AccMax:=V;End
 Else Begin If V<AccMin Then AccMin:=V;If V>AccMax Then AccMax:=V;End;
 Inc(AccCnt);
End;

Function FmFactor: Real;
Var V: Real; R,C,R2,C2,I,J,St,Cd: Integer; Id: String; Sg: Real; S: String;
    SSum,SMin,SMax: Real; SCnt: Integer; Er: Boolean;
Begin
 FmFactor:=0;
 FmSkip;
 If FmP>Length(FmS) Then Begin FmErr:=True;Exit;End;
 If FmS[FmP]='-' Then Begin Inc(FmP);Sg:=FmFactor;FmFactor:=-Sg;Exit;End;
 If FmS[FmP]='+' Then Begin Inc(FmP);FmFactor:=FmFactor;Exit;End;
 If FmS[FmP]='(' Then Begin
  Inc(FmP);V:=FmExpr;FmSkip;
  If (FmP<=Length(FmS)) And (FmS[FmP]=')') Then Inc(FmP) Else FmErr:=True;
  FmFactor:=V;Exit;
 End;
 If FmS[FmP] In ['0'..'9','.'] Then Begin
  St:=FmP;
  While (FmP<=Length(FmS)) And (FmS[FmP] In ['0'..'9','.']) Do Inc(FmP);
  Val(Copy(FmS,St,FmP-St),V,Cd);
  If Cd<>0 Then FmErr:=True;
  FmFactor:=V;Exit;
 End;
 { fonction ou reference }
 St:=FmP;
 While (FmP<=Length(FmS)) And (UpCase(FmS[FmP]) In ['A'..'Z']) Do Inc(FmP);
 Id:=Upper(Copy(FmS,St,FmP-St));
 FmSkip;
 If (FmP<=Length(FmS)) And (FmS[FmP]='(') And (Length(Id)>1) Then Begin
  Inc(FmP);
  SSum:=AccSum;SMin:=AccMin;SMax:=AccMax;SCnt:=AccCnt;
  AccSum:=0;AccCnt:=0;AccMin:=0;AccMax:=0;
  FmSkip;
  While (FmP<=Length(FmS)) And (FmS[FmP]<>')') And Not FmErr Do Begin
   St:=FmP;
   If FmCellRef(R,C) Then Begin
    FmSkip;
    If (FmP<=Length(FmS)) And (FmS[FmP]=':') Then Begin
     Inc(FmP);
     If FmCellRef(R2,C2) Then Begin
      For I:=Min2(R,R2) To Max2(R,R2) Do
       For J:=Min2(C,C2) To Max2(C,C2) Do Begin
        S:=ShtGet(ShSheet,I,J);
        If S<>'' Then FmAccAdd(CellValue(I,J,Er));
       End;
     End Else FmErr:=True;
    End Else Begin
     If ShtGet(ShSheet,R,C)<>'' Then FmAccAdd(CellValue(R,C,Er));
    End;
   End Else Begin
    FmP:=St;
    FmAccAdd(FmExpr);
   End;
   FmSkip;
   If (FmP<=Length(FmS)) And (FmS[FmP] In [',',';']) Then Inc(FmP);
   FmSkip;
  End;
  If (FmP<=Length(FmS)) And (FmS[FmP]=')') Then Inc(FmP) Else FmErr:=True;
  If Id='SUM' Then V:=AccSum
  Else If (Id='AVG') Or (Id='AVERAGE') Or (Id='MOYENNE') Then Begin If AccCnt>0
      Then V:=AccSum/AccCnt Else V:=0;End
  Else If Id='MIN' Then V:=AccMin
  Else If Id='MAX' Then V:=AccMax
  Else If (Id='COUNT') Or (Id='NB') Then V:=AccCnt
  Else If Id='ABS' Then V:=Abs(AccSum)
  Else If (Id='SQRT') Or (Id='RACINE') Then Begin If AccSum<0 Then Begin
      FmErr:=True;V:=0;End Else V:=Sqrt(AccSum);End
  Else If Id='INT' Then V:=Int(AccSum)
  Else If Id='ROUND' Then V:=Round(AccSum)
  Else Begin FmErr:=True;V:=0;End;
  AccSum:=SSum;AccMin:=SMin;AccMax:=SMax;AccCnt:=SCnt;
  FmFactor:=V;
  Exit;
 End;
 { reference de cellule }
 FmP:=St;
 If FmCellRef(R,C) Then Begin
  Er:=False;
  V:=CellValue(R,C,Er);
  If Er Then FmErr:=True;
  FmFactor:=V;
 End Else FmErr:=True;
End;

Function FmPower: Real;
Var V,W: Real;
Begin
 V:=FmFactor;
 FmSkip;
 While (FmP<=Length(FmS)) And (FmS[FmP]='^') Do Begin
  Inc(FmP);W:=FmFactor;
  If (V>0) Then V:=Exp(W*Ln(V)) Else If (V=0) Then V:=0 Else If W=Int(W) Then
      Begin
   If Odd(Round(W)) Then V:=-Exp(W*Ln(-V)) Else V:=Exp(W*Ln(-V));
  End Else FmErr:=True;
  FmSkip;
 End;
 FmPower:=V;
End;

Function FmTerm: Real;
Var V,W: Real; Op: Char;
Begin
 V:=FmPower;
 FmSkip;
 While (FmP<=Length(FmS)) And (FmS[FmP] In ['*','/']) Do Begin
  Op:=FmS[FmP];Inc(FmP);W:=FmPower;
  If Op='*' Then V:=V*W Else If W=0 Then FmErr:=True Else V:=V/W;
  FmSkip;
 End;
 FmTerm:=V;
End;

Function FmExpr: Real;
Var V: Real; Op: Char;
Begin
 V:=FmTerm;
 FmSkip;
 While (FmP<=Length(FmS)) And (FmS[FmP] In ['+','-']) Do Begin
  Op:=FmS[FmP];Inc(FmP);
  If Op='+' Then V:=V+FmTerm Else V:=V-FmTerm;
  FmSkip;
 End;
 FmExpr:=V;
End;

Function CellValue(R,C: Integer; Var Err: Boolean): Real;
Var S: String; V: Real; Cd: Integer; SaveS: String; SaveP: Integer;
SaveErr: Boolean;
Begin
 CellValue:=0;
 S:=ShtGet(ShSheet,R,C);
 If S='' Then Exit;
 If S[1]='=' Then Begin
  If FmDepth>14 Then Begin Err:=True;Exit;End;
  Inc(FmDepth);
  SaveS:=FmS;SaveP:=FmP;SaveErr:=FmErr;
  FmS:=Copy(S,2,255);FmP:=1;FmErr:=False;
  V:=FmExpr;
  FmSkip;
  If FmP<=Length(FmS) Then FmErr:=True;
  If FmErr Then Err:=True;
  FmS:=SaveS;FmP:=SaveP;FmErr:=SaveErr;
  Dec(FmDepth);
  CellValue:=V;
 End Else Begin
  Val(S,V,Cd);
  If Cd=0 Then CellValue:=V Else CellValue:=0;
 End;
End;

Function ShtNew(AX,AY: Integer; ADB: Boolean; Const AFile: String): PWindow;
 Var Wd_: PWindow; Dt_: PSheet;
Var R,C: Integer;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 If ADB Then WinInit(Wd_,A_GEOFILE,AX,AY,600,380,'GeoFile')
 Else WinInit(Wd_,A_GEOCALC,AX,AY,600,380,'GeoCalc');
 Dt_^.DB:=ADB;
 If Dt_^.DB Then Wd_^.IconId:=IC_DEXDOC Else Wd_^.IconId:=IC_CALC;
 Wd_^.MinW:=300;Wd_^.MinH:=200;
 For R:=1 To SROWS Do For C:=1 To SCOLS Do Dt_^.Cells[R,C]:=Nil;
 Dt_^.SR:=1;Dt_^.SC:=1;Dt_^.TopR:=1;Dt_^.LeftC:=1;Dt_^.Editing:=False;
 Dt_^.EditBuf:='';Dt_^.FName:='';Dt_^.Modified:=False;
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'New~Nouveau~Neu',CM_SNEW,'');
 WinAddItem(Wd_,'Open...~Ouvrir...~'#142'ffnen...',CM_SOPEN,'');
 WinAddItem(Wd_,'Save~Enregistrer~Speichern',CM_SSAVE,'');
 WinAddItem(Wd_,'Save As...~Enregistrer sous...~Speichern unter...',CM_SSAVEAS,
     '');
 WinAddSep(Wd_);
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Edit~'#144'dition~Bearbeiten');
 WinAddItem(Wd_,'Cut~Couper~Ausschneiden',CM_SCUT,'');
 WinAddItem(Wd_,'Copy~Copier~Kopieren',CM_SCOPY,'');
 WinAddItem(Wd_,'Paste~Coller~Einf'#129'gen',CM_SPASTE,'');
 WinAddItem(Wd_,'Clear~Effacer~L'#148'schen',CM_SCLR,'Del');
 WinAddMenu(Wd_,'Cell~Cellule~Zelle');
 WinAddItem(Wd_,'Fill Down~Recopier vers le bas~Nach unten f'#129'llen',
     CM_SFILLD,'');
 WinAddMenu(Wd_,'Formula~Formule~Formel');
 WinAddItem(Wd_,'AutoSum~Somme auto~AutoSumme',CM_SSUM,'');
 WinAddMenu(Wd_,'Window~Fen'#136'tre~Fenster');
 WinAddItem(Wd_,'Tile~Mosa'#139'que~Kacheln',CM_TILE,'');
 WinAddItem(Wd_,'Overlap~Cascade~'#154'berlappend',CM_OVERLAP,'');
 If Dt_^.DB Then Begin
  ShtSetCell(Wd_,1,1,T3('Name','Nom','Name'));
  ShtSetCell(Wd_,1,2,T3('Phone','T'#130'l'#130'phone','Telefon'));
  ShtSetCell(Wd_,1,3,T3('City','Ville','Ort'));Dt_^.Modified:=False;
 End;
 If AFile<>'' Then Begin ShtLoadFile(Wd_,AFile);Dt_^.FName:=AFile;End;
 ShtUpdateTitle(Wd_);
 ShtNew:=Wd_;
End;

Procedure ShtDone(Wd_: PWindow);
 Var Dt_: PSheet;
Var R,C: Integer;
Begin
 Dt_:=Wd_^.Data;
 For R:=1 To SROWS Do For C:=1 To SCOLS Do FreeStr(Dt_^.Cells[R,C]);
End;

Procedure ShtUpdateTitle(Wd_: PWindow);
 Var Dt_: PSheet;
Var N,B: String;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.FName='' Then N:=T3('Untitled','Sans titre',
     'Unbenannt') Else N:=ShortName(Dt_^.FName);
 If Dt_^.DB Then B:='GeoFile' Else B:='GeoCalc';
 If Dt_^.DB Then Wd_^.Title:=B+' - '+N Else Wd_^.Title:=B+' - Calc '+N;
 If Dt_^.Modified Then Wd_^.Title:=Wd_^.Title+' *';
End;

Function ShtGet(Wd_: PWindow; R,C: Integer): String;
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 If (R<1) Or (R>SROWS) Or (C<1) Or (C>SCOLS) Or (Dt_^.Cells[R,
     C]=Nil) Then ShtGet:='' Else ShtGet:=Dt_^.Cells[R,C]^;
End;

Procedure ShtSetCell(Wd_: PWindow; R,C: Integer; Const S: String);
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 If (R<1) Or (R>SROWS) Or (C<1) Or (C>SCOLS) Then Exit;
 FreeStr(Dt_^.Cells[R,C]);
 If S<>'' Then Dt_^.Cells[R,C]:=NewStr(Copy(S,1,200));
 Dt_^.Modified:=True;
End;

Procedure ShtCellName(Wd_: PWindow; R,C: Integer; Var S: String);
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 S:=Chr(64+C)+IntStr(R);
End;

Procedure ShtGridRect(Wd_: PWindow; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 Inc(Y1,52);
End;

Procedure ShtReveal(Wd_: PWindow);
 Var Dt_: PSheet;
Var X1,Y1,X2,Y2,VR,VC: Integer;
Begin
 Dt_:=Wd_^.Data;
 ShtGridRect(Wd_,X1,Y1,X2,Y2);
 VR:=(Y2-Y1-SRH) Div SRH;VC:=(X2-X1-30-SB) Div SCW;
 If VR<1 Then VR:=1;
 If VC<1 Then VC:=1;
 If Dt_^.SR<Dt_^.TopR Then Dt_^.TopR:=Dt_^.SR;
 If Dt_^.SR>=Dt_^.TopR+VR Then Dt_^.TopR:=Dt_^.SR-VR+1;
 If Dt_^.SC<Dt_^.LeftC Then Dt_^.LeftC:=Dt_^.SC;
 If Dt_^.SC>=Dt_^.LeftC+VC Then Dt_^.LeftC:=Dt_^.SC-VC+1;
End;

Procedure ShtDrawClient(Wd_: PWindow);
 Var Dt_: PSheet;
Var X1,Y1,X2,Y2,GX1,GY1,GX2,GY2,I,J,R,C,X,Y,VR,VC,Cd: Integer; S,T: String;
V: Real; Er: Boolean;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 ShSheet:=Wd_;
 { barre de formule }
 ShtCellName(Wd_,Dt_^.SR,Dt_^.SC,S);
 Sunken(X1+4,Y1+4,X1+60,Y1+22,cWht);GText(X1+10,Y1+9,S,cBlk);
 Sunken(X1+66,Y1+4,X2-4,Y1+22,cWht);
 If Dt_^.Editing Then Begin
  GText(X1+72,Y1+9,Copy(Dt_^.EditBuf,Max2(1,
      Length(Dt_^.EditBuf)-((X2-X1-90) Div 8)+1),255),cBlk);
  GVLine(X1+72+Min2(Length(Dt_^.EditBuf),(X2-X1-90) Div 8)*8,Y1+7,Y1+19,cBlk);
 End Else GText(X1+72,Y1+9,Copy(ShtGet(Wd_,Dt_^.SR,Dt_^.SC),1,(X2-X1-80) Div 8),
     cBlk);
 { barre d'outils decorative }
 GBar(X1,Y1+26,X2,Y1+48,cLGr);
 For I:=0 To 9 Do Btn3D(X1+4+I*26,Y1+27,X1+26+I*26,Y1+47,False);
 GTextB(X1+10,Y1+33,'B',cBlk);GText(X1+36,Y1+33,'I',cBlk);
 GText(X1+62,Y1+33,'U',cBlk);
 GText(X1+88,Y1+33,#17,cBlk);GText(X1+114,Y1+33,#18,cBlk);
 GText(X1+140,Y1+33,#16,cBlk);
 GText(X1+166,Y1+33,'$',cBlk);GText(X1+192,Y1+33,'%',cBlk);
 GText(X1+218,Y1+33,'+',cBlk);GText(X1+244,Y1+33,'-',cBlk);
 { grille }
 ShtGridRect(Wd_,GX1,GY1,GX2,GY2);
 GBar(GX1,GY1,GX2,GY2,cWht);
 VR:=(GY2-GY1-SRH) Div SRH+1;VC:=(GX2-GX1-30-SB) Div SCW+1;
 GBar(GX1,GY1,GX1+29,GY1+SRH-1,cLGr);Bevel1(GX1,GY1,GX1+29,GY1+SRH-1,cWht,cDGr);
 For J:=0 To VC-1 Do Begin
  C:=Dt_^.LeftC+J;
  If C<=SCOLS Then Begin
   X:=GX1+30+J*SCW;
   GBar(X,GY1,X+SCW-1,GY1+SRH-1,cLGr);Bevel1(X,GY1,X+SCW-1,GY1+SRH-1,cWht,cDGr);
   GTextCtr(X,X+SCW-1,GY1+3,Chr(64+C),cBlk);
  End;
 End;
 For I:=0 To VR-1 Do Begin
  R:=Dt_^.TopR+I;
  If R<=SROWS Then Begin
   Y:=GY1+SRH+I*SRH;
   GBar(GX1,Y,GX1+29,Y+SRH-1,cLGr);Bevel1(GX1,Y,GX1+29,Y+SRH-1,cWht,cDGr);
   GTextCtr(GX1,GX1+29,Y+3,IntStr(R),cBlk);
   For J:=0 To VC-1 Do Begin
    C:=Dt_^.LeftC+J;
    If C<=SCOLS Then Begin
     X:=GX1+30+J*SCW;
     GRect(X,Y,X+SCW-1,Y+SRH-1,cLGr);
     If Dt_^.DB And (R=1) Then GBar(X+1,Y+1,X+SCW-2,Y+SRH-2,cLGr);
     S:=ShtGet(Wd_,R,C);
     If S<>'' Then Begin
      If S[1]='=' Then Begin
       Er:=False;FmDepth:=0;
       V:=CellValue(R,C,Er);
       If Er Then T:='ERR' Else T:=FmReal2(V);
       GText(X+SCW-4-TextW(Copy(T,1,8)),Y+3,Copy(T,1,8),cBlk);
      End Else Begin
       Er:=False;
       Val(S,V,Cd);
       If Cd=0 Then
        GText(X+SCW-4-TextW(Copy(S,1,8)),Y+3,Copy(S,1,8),cBlk)
       Else GText(X+4,Y+3,Copy(S,1,8),cBlk);
      End;
     End;
    End;
   End;
  End;
 End;
 { cellule active }
 If (Dt_^.SR>=Dt_^.TopR) And (Dt_^.SR<Dt_^.TopR+VR) And (Dt_^.SC>=Dt_^.LeftC)
     And (Dt_^.SC<Dt_^.LeftC+VC) Then Begin
  X:=GX1+30+(Dt_^.SC-Dt_^.LeftC)*SCW;Y:=GY1+SRH+(Dt_^.SR-Dt_^.TopR)*SRH;
  GRect(X,Y,X+SCW-1,Y+SRH-1,cBlk);GRect(X+1,Y+1,X+SCW-2,Y+SRH-2,cBlk);
 End;
 DrawScroll(True,GX2-SB+1,GY1,GX2,GY2,SROWS,VR,Dt_^.TopR-1);
End;

Procedure ShtCommit(Wd_: PWindow);
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.Editing Then Begin
  ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,Dt_^.EditBuf);
  Dt_^.Editing:=False;
  ShtUpdateTitle(Wd_);
 End;
End;

Procedure ShtOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PSheet;
Var GX1,GY1,GX2,GY2,R,C: Integer;
Begin
 Dt_:=Wd_^.Data;
 If E.Kind<>EV_DOWN Then Exit;
 ShtGridRect(Wd_,GX1,GY1,GX2,GY2);
 If (E.X>=GX1+30) And (E.X<GX2-SB) And (E.Y>=GY1+SRH) And (E.Y<=GY2) Then Begin
  ShtCommit(Wd_);
  C:=Dt_^.LeftC+(E.X-GX1-30) Div SCW;R:=Dt_^.TopR+(E.Y-GY1-SRH) Div SRH;
  If (R>=1) And (R<=SROWS) And (C>=1) And (C<=SCOLS) Then Begin
   Dt_^.SR:=R;Dt_^.SC:=C;
   If E.Dbl Then Begin Dt_^.Editing:=True;
   Dt_^.EditBuf:=ShtGet(Wd_,Dt_^.SR,Dt_^.SC);End;
  End;
 End Else If (E.X>=GX2-SB+1) And (E.Y>=GY1) Then Begin
  If E.Y<GY1+SB Then Begin If Dt_^.TopR>1 Then Dec(Dt_^.TopR);End
  Else If E.Y>GY2-SB Then Begin If Dt_^.TopR<SROWS Then Inc(Dt_^.TopR);End
  Else If E.Y<(GY1+GY2) Div 2 Then Dt_^.TopR:=Max2(1,
      Dt_^.TopR-10) Else Dt_^.TopR:=Min2(SROWS,Dt_^.TopR+10);
 End;
 Invalidate(Wd_);
End;

Procedure ShtOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PSheet;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.Editing Then Begin
  Case K Of
   K_ENTER: Begin ShtCommit(Wd_);If Dt_^.SR<SROWS Then Inc(Dt_^.SR);End;
   K_TAB: Begin ShtCommit(Wd_);If Dt_^.SC<SCOLS Then Inc(Dt_^.SC);End;
   K_ESC: Dt_^.Editing:=False;
   K_BKSP: If Dt_^.EditBuf<>'' Then Delete(Dt_^.EditBuf,Length(Dt_^.EditBuf),1);
  Else
   If (K>=32) And (K<256) And (Length(Dt_^.EditBuf)<190) Then
       Dt_^.EditBuf:=Dt_^.EditBuf+Chr(K);
  End;
 End Else Begin
  Case K Of
   K_UP: If Dt_^.SR>1 Then Dec(Dt_^.SR);
   K_DOWN: If Dt_^.SR<SROWS Then Inc(Dt_^.SR);
   K_LEFT: If Dt_^.SC>1 Then Dec(Dt_^.SC);
   K_RIGHT: If Dt_^.SC<SCOLS Then Inc(Dt_^.SC);
   K_TAB: If Dt_^.SC<SCOLS Then Inc(Dt_^.SC);
   K_PGUP: Dt_^.SR:=Max2(1,Dt_^.SR-10);
   K_PGDN: Dt_^.SR:=Min2(SROWS,Dt_^.SR+10);
   K_HOME: Dt_^.SC:=1;
   K_DEL: Begin ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,'');ShtUpdateTitle(Wd_);End;
   K_F2,K_ENTER: Begin Dt_^.Editing:=True;
   Dt_^.EditBuf:=ShtGet(Wd_,Dt_^.SR,Dt_^.SC);End;
   K_CTRLC: ClipCell:=ShtGet(Wd_,Dt_^.SR,Dt_^.SC);
   K_CTRLV: Begin ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,ClipCell);ShtUpdateTitle(Wd_);
   End;
  Else
   If (K>=32) And (K<256) Then Begin Dt_^.Editing:=True;Dt_^.EditBuf:=Chr(K);
   End;
  End;
 End;
 ShtReveal(Wd_);
 Invalidate(Wd_);
End;

Procedure ShtSaveFile(Wd_: PWindow; Const P: String);
 Var Dt_: PSheet;
Var F: Text; R,C: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,P);
 Rewrite(F);
 WriteLn(F,'GEOCALC1');
 For R:=1 To SROWS Do
  For C:=1 To SCOLS Do
   If Dt_^.Cells[R,C]<>Nil Then WriteLn(F,Chr(64+C),R,#9,Dt_^.Cells[R,C]^);
 Close(F);
 {$I+}
 If IOResult<>0 Then Info(T3('Error','Erreur','Fehler'),T3('Cannot save file.',
     'Impossible d''enregistrer.','Speichern nicht m'#148'glich.'))
 Else Dt_^.Modified:=False;
End;

Procedure ShtLoadFile(Wd_: PWindow; Const P: String);
 Var Dt_: PSheet;
Var F: Text; S,N: String; R,C,T: Integer;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,P);
 Reset(F);
 {$I+}
 If IOResult<>0 Then Begin Info(T3('Error','Erreur','Fehler'),T3('Cannot open|',
     'Impossible d''ouvrir|','Kann nicht '#148'ffnen|')+P);Exit;End;
 For R:=1 To SROWS Do For C:=1 To SCOLS Do FreeStr(Dt_^.Cells[R,C]);
 {$I-}
 ReadLn(F,S);
 While Not Eof(F) Do Begin
  ReadLn(F,S);
  T:=Pos(#9,S);
  If T>2 Then Begin
   N:=Copy(S,1,T-1);
   C:=Ord(UpCase(N[1]))-64;R:=StrVal(Copy(N,2,5),0);
   If (R>=1) And (R<=SROWS) And (C>=1) And (C<=SCOLS) Then Dt_^.Cells[R,
       C]:=NewStr(Copy(S,T+1,200));
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 Dt_^.Modified:=False;
End;

Function ShtCanClose(Wd_: PWindow): Boolean;
 Var Dt_: PSheet;
Var R: Integer;
Begin
 Dt_:=Wd_^.Data;
 ShtCanClose:=True;
 If Dt_^.Modified Then Begin
  R:=MsgBox(T3('Close','Fermer','Schlie'#225'en'),T3('Save changes?',
      'Enregistrer les modifications ?',#142'nderungen speichern?'),
     T3('Yes|No|Cancel','Oui|Non|Annuler','Ja|Nein|Abbruch'),2);
  If R=3 Then ShtCanClose:=False
  Else If R=1 Then Begin ShtOnCommand(Wd_,CM_SSAVE);
  ShtCanClose:=Not Dt_^.Modified;End;
 End;
End;

Procedure ShtOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PSheet;
Var P,S: String; R,C: Integer; V: Real; Er: Boolean;
Begin
 Dt_:=Wd_^.Data;
 ShtCommit(Wd_);
 Case Cmd Of
  CM_SNEW: Begin
            If Not ShtCanClose(Wd_) Then Exit;
            For R:=1 To SROWS Do For C:=1 To SCOLS Do FreeStr(Dt_^.Cells[R,C]);
            Dt_^.FName:='';Dt_^.Modified:=False;Dt_^.SR:=1;Dt_^.SC:=1;
            Dt_^.TopR:=1;Dt_^.LeftC:=1;
           End;
  CM_SOPEN: Begin
             P:=CurDirStr;
             If FileDlg(T3('Open','Ouvrir',#142'ffnen'),'*.GCL',P,
                 False) Then Begin ShtLoadFile(Wd_,P);Dt_^.FName:=P;End;
            End;
  CM_SSAVE,CM_SSAVEAS: Begin
             P:=Dt_^.FName;
             If (P='') Or (Cmd=CM_SSAVEAS) Then Begin
              If P='' Then P:=JoinPath(CurDirStr,'SHEET.GCL');
              If Not FileDlg(T3('Save As','Enregistrer sous','Speichern unter'),
                  '*.GCL',P,True) Then Begin ShtUpdateTitle(Wd_);Exit;End;
             End;
             ShtSaveFile(Wd_,P);Dt_^.FName:=P;
            End;
  CM_SCLR: ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,'');
  CM_SCOPY: ClipCell:=ShtGet(Wd_,Dt_^.SR,Dt_^.SC);
  CM_SCUT: Begin ClipCell:=ShtGet(Wd_,Dt_^.SR,Dt_^.SC);
  ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,'');End;
  CM_SPASTE: ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,ClipCell);
  CM_SFILLD: If Dt_^.SR<SROWS Then ShtSetCell(Wd_,Dt_^.SR+1,Dt_^.SC,ShtGet(Wd_,
      Dt_^.SR,Dt_^.SC));
  CM_SSUM: Begin
            R:=Dt_^.SR-1;
            While (R>=1) And (ShtGet(Wd_,R,Dt_^.SC)<>'') Do Dec(R);
            S:='=SUM('+Chr(64+Dt_^.SC)+IntStr(R+1)+':'+Chr(64+Dt_^.SC)+
                IntStr(Dt_^.SR-1)+')';
            If Dt_^.SR>1 Then ShtSetCell(Wd_,Dt_^.SR,Dt_^.SC,S);
           End;
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 ShtUpdateTitle(Wd_);
 Invalidate(Wd_);
End;

{ ====================================================================== }
{   GRAPH : outil pedagogique d'algorithmes de graphes (GRAPH.GEO, jeton  }
{   GRAF) - equivalent natif de l'application GEOS de Blue Marsh Softworks }
{ ====================================================================== }

Const
 MAXGV = 40;
 MAXGE = 200;
 CM_GVADD=1000; CM_GVREM=1001; CM_GVRND=1002; CM_GVSEL=1003; CM_GVUNS=1004;
 CM_GEADD=1010; CM_GEREM=1011; CM_GERND=1012; CM_GESEL=1013; CM_GEUNS=1014;
 CM_GKRU=1020; CM_GPRIM=1021; CM_GBOTHM=1022;
 CM_GBFS=1030; CM_GDFS=1031; CM_GBOTHS=1032;
 CM_GSHORT=1040; CM_GCOMP=1041; CM_GREDRAW=1042; CM_GCLEAR=1043;
 CM_GRSAVE=1044; CM_GROPEN=1045;
 GVR = 10;                      { rayon d'un sommet }

Type
 PGraph = ^TGraph;
 TGraph = Record
  NV    : Integer;
  VX,VY : Array[1..MAXGV] Of Integer;
  VSel  : Array[1..MAXGV] Of Boolean;
  NE    : Integer;
  EA,EB : Array[1..MAXGE] Of Integer;
  EDir  : Array[1..MAXGE] Of Boolean;
  ESel  : Array[1..MAXGE] Of Boolean;
  ECol : Array[1..MAXGE] Of Integer; { couleur donnee par un algorithme (0 =
    aucune) }
  NStep : Integer;
  StepE : Array[1..2*MAXGE] Of Integer;
  StepC : Array[1..2*MAXGE] Of Integer;
  StepP : Integer;                         { etapes deja montrees }
  AlgoName : String[30];
  Drag  : Integer;
  CurX,CurY : Integer;
  Msg   : String[80];
  Visited : Array[1..MAXGV] Of Boolean;
 End;

Function GrNew(AX,AY: Integer): PWindow; Forward;
Procedure GrDone(Wd_: PWindow); Forward;
Procedure GrDrawClient(Wd_: PWindow); Forward;
Procedure GrOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure GrOnKey(Wd_: PWindow; K: Word); Forward;
Procedure GrOnCommand(Wd_: PWindow; Cmd: Integer); Forward;
Procedure GrPrepareMenus(Wd_: PWindow); Forward;

Function GrWeight(G: PGraph; E: Integer): Integer;
Var DX,DY: LongInt;
Begin
 DX:=G^.VX[G^.EA[E]]-G^.VX[G^.EB[E]];DY:=G^.VY[G^.EA[E]]-G^.VY[G^.EB[E]];
 GrWeight:=Round(Sqrt(DX*DX+DY*DY)/8)+1;
End;

Function GrVertexAt(G: PGraph; X,Y: Integer): Integer;
Var I: Integer;
Begin
 GrVertexAt:=0;
 For I:=G^.NV DownTo 1 Do
  If (Abs(X-G^.VX[I])<=GVR) And (Abs(Y-G^.VY[I])<=GVR) Then Begin GrVertexAt:=I;
  Exit;End;
End;

Function GrEdgeBetween(G: PGraph; A,B: Integer): Integer;
Var I: Integer;
Begin
 GrEdgeBetween:=0;
 For I:=1 To G^.NE Do
  If ((G^.EA[I]=A) And (G^.EB[I]=B)) Or ((G^.EA[I]=B) And (G^.EB[I]=A)) Then
      Begin GrEdgeBetween:=I;Exit;End;
End;

Procedure GrClearAlgo(G: PGraph);
Var I: Integer;
Begin
 For I:=1 To G^.NE Do G^.ECol[I]:=0;
 G^.NStep:=0;G^.StepP:=0;G^.AlgoName:='';
End;

Procedure GrAddEdge(G: PGraph; A,B: Integer; Dir: Boolean);
Begin
 If (G^.NE>=MAXGE) Or (A=B) Or (GrEdgeBetween(G,A,B)<>0) Then Exit;
 Inc(G^.NE);
 G^.EA[G^.NE]:=A;G^.EB[G^.NE]:=B;G^.EDir[G^.NE]:=Dir;G^.ESel[G^.NE]:=False;
 G^.ECol[G^.NE]:=0;
End;

Procedure GrDelEdge(G: PGraph; E: Integer);
Var K: Integer;
Begin
 For K:=E To G^.NE-1 Do Begin
  G^.EA[K]:=G^.EA[K+1];G^.EB[K]:=G^.EB[K+1];G^.EDir[K]:=G^.EDir[K+1];
  G^.ESel[K]:=G^.ESel[K+1];G^.ECol[K]:=G^.ECol[K+1];
 End;
 Dec(G^.NE);
End;

Procedure GrDelVertex(G: PGraph; V: Integer);
Var K,E: Integer;
Begin
 E:=1;
 While E<=G^.NE Do
  If (G^.EA[E]=V) Or (G^.EB[E]=V) Then GrDelEdge(G,E) Else Inc(E);
 For K:=V To G^.NV-1 Do Begin G^.VX[K]:=G^.VX[K+1];G^.VY[K]:=G^.VY[K+1];
 G^.VSel[K]:=G^.VSel[K+1];End;
 Dec(G^.NV);
 For E:=1 To G^.NE Do Begin
  If G^.EA[E]>V Then Dec(G^.EA[E]);
  If G^.EB[E]>V Then Dec(G^.EB[E]);
 End;
End;

Procedure GrStep(G: PGraph; E,C: Integer);
Begin
 If G^.NStep<2*MAXGE Then Begin Inc(G^.NStep);G^.StepE[G^.NStep]:=E;
 G^.StepC[G^.NStep]:=C;End;
End;

{ Premier sommet selectionne (ou 1) }
Function GrStart(G: PGraph; Nth: Integer): Integer;
Var I,K: Integer;
Begin
 K:=0;GrStart:=0;
 For I:=1 To G^.NV Do
  If G^.VSel[I] Then Begin
   Inc(K);
   If K=Nth Then Begin GrStart:=I;Exit;End;
  End;
End;

Procedure GrPrim(G: PGraph);
Var InT: Array[1..MAXGV] Of Boolean; S,I,N,Best,BW,W: Integer;
Begin
 If G^.NV=0 Then Exit;
 FillChar(InT,SizeOf(InT),0);
 S:=GrStart(G,1);If S=0 Then S:=1;
 InT[S]:=True;
 For N:=1 To G^.NV-1 Do Begin
  Best:=0;BW:=32000;
  For I:=1 To G^.NE Do
   If InT[G^.EA[I]]<>InT[G^.EB[I]] Then Begin
    W:=GrWeight(G,I);
    If W<BW Then Begin BW:=W;Best:=I;End;
   End;
  If Best=0 Then Exit;
  InT[G^.EA[Best]]:=True;InT[G^.EB[Best]]:=True;
  GrStep(G,Best,cLBl);
 End;
End;

Procedure GrKruskal(G: PGraph);
Var Ord_: Array[1..MAXGE] Of Integer; Par: Array[1..MAXGV] Of Integer;
I,J,T,A,B: Integer;
 Function Find(X: Integer): Integer;
 Begin
  While Par[X]<>X Do X:=Par[X];
  Find:=X;
 End;
Begin
 For I:=1 To G^.NE Do Ord_[I]:=I;
 For I:=1 To G^.NE-1 Do
  For J:=I+1 To G^.NE Do
   If GrWeight(G,Ord_[J])<GrWeight(G,Ord_[I]) Then Begin T:=Ord_[I];
   Ord_[I]:=Ord_[J];Ord_[J]:=T;End;
 For I:=1 To G^.NV Do Par[I]:=I;
 For I:=1 To G^.NE Do Begin
  A:=Find(G^.EA[Ord_[I]]);B:=Find(G^.EB[Ord_[I]]);
  If A<>B Then Begin Par[A]:=B;GrStep(G,Ord_[I],cLRd);End;
 End;
End;

Procedure GrBfs(G: PGraph);
Var Q: Array[1..MAXGV] Of Integer; H,T,U,E,V,S: Integer;
Begin
 If G^.NV=0 Then Exit;
 FillChar(G^.Visited,SizeOf(G^.Visited),0);
 S:=GrStart(G,1);If S=0 Then S:=1;
 H:=1;T:=1;Q[1]:=S;G^.Visited[S]:=True;
 While H<=T Do Begin
  U:=Q[H];Inc(H);
  For E:=1 To G^.NE Do Begin
   V:=0;
   If G^.EA[E]=U Then V:=G^.EB[E]
   Else If (G^.EB[E]=U) And Not G^.EDir[E] Then V:=G^.EA[E];
   If (V>0) And Not G^.Visited[V] Then Begin
    G^.Visited[V]:=True;Inc(T);Q[T]:=V;GrStep(G,E,cBrn);
   End;
  End;
 End;
End;

Procedure GrDfsRec(G: PGraph; U: Integer);
Var E,V: Integer;
Begin
 G^.Visited[U]:=True;
 For E:=1 To G^.NE Do Begin
  V:=0;
  If G^.EA[E]=U Then V:=G^.EB[E]
  Else If (G^.EB[E]=U) And Not G^.EDir[E] Then V:=G^.EA[E];
  If (V>0) And Not G^.Visited[V] Then Begin GrStep(G,E,cMag);GrDfsRec(G,V);End;
 End;
End;

Procedure GrDfs(G: PGraph);
Var S: Integer;
Begin
 If G^.NV=0 Then Exit;
 FillChar(G^.Visited,SizeOf(G^.Visited),0);
 S:=GrStart(G,1);If S=0 Then S:=1;
 GrDfsRec(G,S);
End;

Procedure GrShortest(G: PGraph);
Var Dist: Array[1..MAXGV] Of LongInt; PrevE: Array[1..MAXGV] Of Integer;
Done: Array[1..MAXGV] Of Boolean;
    S,T,I,U,E,V,W,K: Integer; Path: Array[1..MAXGV] Of Integer; NP: Integer;
Begin
 If G^.NV<2 Then Exit;
 S:=GrStart(G,1);If S=0 Then S:=1;
 T:=GrStart(G,2);If T=0 Then T:=G^.NV;
 For I:=1 To G^.NV Do Begin Dist[I]:=1000000;PrevE[I]:=0;Done[I]:=False;End;
 Dist[S]:=0;
 K:=0;
 While K<G^.NV Do Begin
  Inc(K);
  U:=0;
  For I:=1 To G^.NV Do If Not Done[I] And ((U=0) Or (Dist[I]<Dist[U])) Then
      U:=I;
  If (U=0) Or (Dist[U]>=1000000) Then K:=G^.NV
  Else Begin
   Done[U]:=True;
   For E:=1 To G^.NE Do Begin
    V:=0;
    If G^.EA[E]=U Then V:=G^.EB[E]
    Else If (G^.EB[E]=U) And Not G^.EDir[E] Then V:=G^.EA[E];
    If V>0 Then Begin
     W:=GrWeight(G,E);
     If Dist[U]+W<Dist[V] Then Begin Dist[V]:=Dist[U]+W;PrevE[V]:=E;End;
    End;
   End;
  End;
 End;
 If PrevE[T]=0 Then Begin G^.Msg:='No path';Exit;End;
 NP:=0;V:=T;
 While V<>S Do Begin
  Inc(NP);Path[NP]:=PrevE[V];
  E:=PrevE[V];
  If G^.EB[E]=V Then V:=G^.EA[E] Else V:=G^.EB[E];
 End;
 For I:=NP DownTo 1 Do GrStep(G,Path[I],cLGn);
End;

Procedure GrRun(G: PGraph; Which: Integer);
Begin
 GrClearAlgo(G);
 G^.Msg:='';
 Case Which Of
  1: Begin G^.AlgoName:='Prim';GrPrim(G);End;
  2: Begin G^.AlgoName:='Kruskal';GrKruskal(G);End;
  3: Begin G^.AlgoName:='Prim + Kruskal';GrPrim(G);GrKruskal(G);End;
  4: Begin G^.AlgoName:='BFS';GrBfs(G);End;
  5: Begin G^.AlgoName:='DFS';GrDfs(G);End;
  6: Begin G^.AlgoName:='BFS + DFS';GrBfs(G);GrDfs(G);End;
  7: Begin G^.AlgoName:='Shortest Path';GrShortest(G);End;
 End;
 If G^.NStep=0 Then G^.AlgoName:='';
 If G^.AlgoName<>'' Then G^.Msg:=G^.AlgoName+' - '+
     T3('press a key for each step','appuyez sur une touche pour chaque '#130+
     'tape','Taste f'#129'r jeden Schritt');
End;

