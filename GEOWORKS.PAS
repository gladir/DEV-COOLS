 BFileOpen,BFileWr,BPrn : Boolean;
 BHdrType: Integer;
 BHdrName: String;

Const
 { palette C64 -> palette EGA du clone }
 C64Pal : Array[0..15] Of Byte = (0,15,4,3,5,2,1,14,6,6,12,8,7,10,9,7);
 CLRBG  = 255;

Function BNum(Const V: TBVal): Double; Forward;
Function BEval(Var R: TBVal): Boolean; Forward;
Function BExpr(Var R: TBVal): Boolean; Forward;
Procedure BStmts; Forward;

{ ---------------------- utilitaires ---------------------- }

Function BErrNum(Const S: String): Integer;
Begin
 BErrNum:=1;
 If (Pos('llegal',S)>0) Or (Pos('gale',S)>0) Or (Pos('ltige',
     S)>0) Then BErrNum:=17
 Else If Pos('RETURN',S)=1 Then BErrNum:=15
 Else If Pos('NEXT',S)=1 Then BErrNum:=14
 Else If (Pos('DATA',S)>0) And ((Pos('Out',S)=1) Or (Pos('Plus',
     S)=1) Or (Pos('Keine',S)=1)) Then BErrNum:=16
 Else If (Pos('not found',S)>0) Or (Pos('introuvable',
     S)>0) Or (Pos('nicht gefunden',S)>0) Then BErrNum:=6
 Else If (Pos('nopened',S)>0) Or (Pos('non ouvert',S)>0) Then BErrNum:=8;
End;

Procedure BFail(Const S: String);
Begin
 If CB^.Err='' Then Begin
  CB^.ErrNo:=BErrNum(S);
  If (CB^.OnErrL>0) And (Not CB^.ErrJump) Then Begin
   CB^.ErrJump:=True;CB^.Running:=False;CB^.Done:=True;Exit;
  End;
  If (CB^.Ln>=1) And (CB^.Ln<=CB^.NL) And (CB^.LNo[CB^.Ln]>=0) Then
      CB^.Err:=S+' '+T3('in line ','dans la ligne ',
      'in Zeile ')+IntStr(CB^.LNo[CB^.Ln])
  Else CB^.Err:=S+' '+T3('in line ','dans la ligne ',
      'in Zeile ')+IntStr(CB^.Ln);
 End;
 CB^.Running:=False;CB^.Done:=True;
End;

Function BNewBas: PBas;
Var B: PBas;
Begin
 New(B);FillChar(B^,SizeOf(B^),0);B^.Rnd:=12345;
 FillChar(B^.Scr,SizeOf(B^.Scr),CLRBG);
 FillChar(B^.Tx,SizeOf(B^.Tx),' ');
 B^.WX2:=39;B^.WY2:=24;B^.ColV:=1;B^.MouseOn:=True;B^.PromptOn:=True;
 BNewBas:=B;
End;

Procedure BFreeVars(B: PBas);
Var I: Integer;
Begin
 For I:=1 To B^.NV Do
  If B^.Var_[I].P<>Nil Then Begin
   If B^.Var_[I].Dims=0 Then FreeMem(B^.Var_[I].P,SizeOf(TBVal))
   Else FreeMem(B^.Var_[I].P,(B^.Var_[I].D1+1)*(B^.Var_[I].D2+1)*SizeOf(TBVal));
   B^.Var_[I].P:=Nil;
  End;
 B^.NV:=0;
End;

Procedure BFree(B: PBas);
Var I: Integer;
Begin
 For I:=1 To B^.NL Do FreeStr(B^.Src[I]);
 BFreeVars(B);
 Dispose(B);
End;

Function BRnd: Double;
Begin
 CB^.Rnd:=(CB^.Rnd*1103515245+12345) And $7FFFFFFF;
 BRnd:=(CB^.Rnd Shr 4)/134217728.0;
 If BRnd>=1 Then BRnd:=0.999999;
End;

{ ---------------------- ecran texte 40x25 et ecran graphique 320x200
  ---------------------- }

Procedure BScroll;
Var R,C: Integer;
Begin
 For R:=CB^.WY1 To CB^.WY2-1 Do
  For C:=CB^.WX1 To CB^.WX2 Do Begin
   CB^.Tx[R,C]:=CB^.Tx[R+1,C];CB^.TxK[R,C]:=CB^.TxK[R+1,C];
  End;
 For C:=CB^.WX1 To CB^.WX2 Do CB^.Tx[CB^.WY2,C]:=' ';
End;

Procedure BNewLine;
Begin
 CB^.CurC:=CB^.WX1;
 If CB^.CurR>=CB^.WY2 Then BScroll Else Inc(CB^.CurR);
End;

Procedure BPutS(Const S: String);
Var I: Integer;
Begin
 For I:=1 To Length(S) Do Begin
  If S[I]=#13 Then BNewLine
  Else Begin
   If CB^.CurC>CB^.WX2 Then BNewLine;
   CB^.Tx[CB^.CurR,CB^.CurC]:=S[I];CB^.TxK[CB^.CurR,CB^.CurC]:=CB^.Pen;
   Inc(CB^.CurC);
  End;
 End;
End;

Procedure BCls;
Begin
 FillChar(CB^.Scr,SizeOf(CB^.Scr),CLRBG);
 FillChar(CB^.Tx,SizeOf(CB^.Tx),' ');
 FillChar(CB^.TxK,SizeOf(CB^.TxK),0);
 CB^.CurR:=CB^.WY1;CB^.CurC:=CB^.WX1;
End;

{ efface le texte des cellules couvertes par un rectangle (en pixels) }
Procedure BTxErase(X1,Y1,X2,Y2: Integer);
Var R,C: Integer;
Begin
 For R:=Max2(0,Y1 Div 8) To Min2(24,Y2 Div 8) Do
  For C:=Max2(0,X1 Div 8) To Min2(39,X2 Div 8) Do CB^.Tx[R,C]:=' ';
End;

Procedure BPix(X,Y,C: Integer);
Begin
 If (X>=0) And (X<=319) And (Y>=0) And (Y<=199) Then CB^.Scr[Y,X]:=C;
End;

{ couleur d'avant-plan (SETCOL) : quartet haut, 0 -> noir }
Function BFgCol: Integer;
Begin
 BFgCol:=C64Pal[(CB^.ColV Shr 4) And 15];
End;

Function BBgCol: Integer;
Begin
 BBgCol:=C64Pal[CB^.ColV And 15];
End;

Procedure BLineS(X1,Y1,X2,Y2,C: Integer);
Var DX,DY,SX,SY,E,E2: Integer;
Begin
 DX:=Abs(X2-X1);DY:=-Abs(Y2-Y1);
 If X1<X2 Then SX:=1 Else SX:=-1;
 If Y1<Y2 Then SY:=1 Else SY:=-1;
 E:=DX+DY;
 Repeat
  BPix(X1,Y1,C);
  If (X1=X2) And (Y1=Y2) Then Break;
  E2:=2*E;
  If E2>=DY Then Begin E:=E+DY;X1:=X1+SX;End;
  If E2<=DX Then Begin E:=E+DX;Y1:=Y1+SY;End;
 Until False;
End;

Const
 BBayer : Array[0..3,0..3] Of Byte = ((0,8,2,10),(12,4,14,6),(3,11,1,9),(15,7,
     13,5));

{ rectangle plein avec la trame PATTERN (0 = plein, 1..31 = de plus en plus
  clair) }
Procedure BFillR(X1,Y1,X2,Y2,C: Integer);
Var X,Y,T,Z: Integer;
Begin
 If X1>X2 Then Begin Z:=X1;X1:=X2;X2:=Z;End;
 If Y1>Y2 Then Begin Z:=Y1;Y1:=Y2;Y2:=Z;End;
 T:=16-(CB^.Pat*16) Div 32;
 For Y:=Max2(0,Y1) To Min2(199,Y2) Do
  For X:=Max2(0,X1) To Min2(319,X2) Do
   If (CB^.Pat=0) Or (BBayer[Y And 3,X And 3]<T) Then CB^.Scr[Y,X]:=C;
 BTxErase(X1,Y1,X2,Y2);
End;

{ rectangle trame : la trame est donnee par SETCOL (8 bits) ; sans bits hauts :
  trait plein }
Procedure BFrameR(X1,Y1,X2,Y2: Integer);
Var Pt,K,X,Y: Integer; C: Integer;
 Procedure Dot(PX,PY: Integer);
 Begin
  If (Pt And (1 Shl (K And 7)))<>0 Then BPix(PX,PY,C);
  Inc(K);
 End;
Begin
 If CB^.ColV<16 Then Pt:=255 Else Pt:=CB^.ColV And 255;
 C:=BFgCol;K:=0;
 For X:=X1 To X2 Do Dot(X,Y1);
 For Y:=Y1+1 To Y2 Do Dot(X2,Y);
 For X:=X2-1 DownTo X1 Do Dot(X,Y2);
 For Y:=Y2-1 DownTo Y1+1 Do Dot(X1,Y);
End;

Procedure BCircleS(CX,CY,R,C: Integer; Fill: Boolean);
Var X,Y,D: Integer;
 Procedure Pts;
 Begin
  If Fill Then Begin
   BLineS(CX-X,CY+Y,CX+X,CY+Y,C);BLineS(CX-X,CY-Y,CX+X,CY-Y,C);
   BLineS(CX-Y,CY+X,CX+Y,CY+X,C);BLineS(CX-Y,CY-X,CX+Y,CY-X,C);
  End Else Begin
   BPix(CX+X,CY+Y,C);BPix(CX-X,CY+Y,C);BPix(CX+X,CY-Y,C);BPix(CX-X,CY-Y,C);
   BPix(CX+Y,CY+X,C);BPix(CX-Y,CY+X,C);BPix(CX+Y,CY-X,C);BPix(CX-Y,CY-X,C);
  End;
 End;
Begin
 X:=0;Y:=R;D:=3-2*R;
 While X<=Y Do Begin
  Pts;
  If D<0 Then D:=D+4*X+6 Else Begin D:=D+4*(X-Y)+10;Dec(Y);End;
  Inc(X);
 End;
End;

{ ---------------------- variables ---------------------- }

Function BFindVar(Const Nm: String; Create: Boolean; D1,D2,
    Dims: Integer): Integer;
Var I: Integer; N: String;
Begin
 N:=Upper(Nm);
 For I:=1 To CB^.NV Do If CB^.Var_[I].Name=N Then Begin BFindVar:=I;Exit;End;
 BFindVar:=0;
 If Not Create Then Exit;
 If CB^.NV>=BMAXV Then Begin BFail(T3('Too many variables','Trop de variables',
     'Zu viele Variablen'));Exit;End;
 Inc(CB^.NV);I:=CB^.NV;
 CB^.Var_[I].Name:=Copy(N,1,18);
 CB^.Var_[I].IsS:=(N<>'') And (N[Length(N)]='$');
 CB^.Var_[I].Dims:=Dims;CB^.Var_[I].D1:=D1;CB^.Var_[I].D2:=D2;
 If Dims=0 Then Begin GetMem(CB^.Var_[I].P,SizeOf(TBVal));
 FillChar(CB^.Var_[I].P^,SizeOf(TBVal),0);End
 Else Begin
  GetMem(CB^.Var_[I].P,(D1+1)*(D2+1)*SizeOf(TBVal));
  FillChar(CB^.Var_[I].P^,(D1+1)*(D2+1)*SizeOf(TBVal),0);
 End;
 CB^.Var_[I].P^[0].IsS:=CB^.Var_[I].IsS;
 BFindVar:=I;
End;

Function BElem(V,I1,I2: Integer): PBVal;
Var K: Integer;
Begin
 BElem:=Nil;
 If V=0 Then Exit;
 If CB^.Var_[V].Dims=0 Then Begin BElem:=@CB^.Var_[V].P^[0];Exit;End;
 If (I1<0) Or (I1>CB^.Var_[V].D1) Or (I2<0) Or (I2>CB^.Var_[V].D2) Then Begin
  BFail(T3('Subscript out of range','Indice hors limites',
      'Index au'#225'erhalb')); Exit;
 End;
 K:=I1*(CB^.Var_[V].D2+1)+I2;
 BElem:=@CB^.Var_[V].P^[K];
End;

Procedure BSetV(P: PBVal; IsS: Boolean; N: Double; Const T: String);
Begin
 If P=Nil Then Exit;
 P^.IsS:=IsS;P^.N:=N;P^.T:=Copy(T,1,120);
End;

{ ---------------------- analyseur lexical ---------------------- }

Procedure BSkip;
Begin
 While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In [' ',
     #9]) Do Inc(CB^.Ps);
End;

Function BAtEnd: Boolean;
Begin
 BSkip;
 BAtEnd:=CB^.Ps>Length(CB^.Ln_);
End;

Function BPeek: Char;
Begin
 BSkip;
 If CB^.Ps>Length(CB^.Ln_) Then BPeek:=#0 Else BPeek:=CB^.Ln_[CB^.Ps];
End;

Function BIsId(C: Char): Boolean;
Begin
 BIsId:=C In ['A'..'Z','a'..'z','0'..'9','_','$','%'];
End;

{ lit un identifiant (lettres, chiffres, $) sans l'avancer si Adv=False }
Function BWord(Adv: Boolean): String;
Var P: Integer; S: String;
Begin
 BSkip;
 P:=CB^.Ps;S:='';
 If (P<=Length(CB^.Ln_)) And (CB^.Ln_[P] In ['A'..'Z','a'..'z','_']) Then Begin
  While (P<=Length(CB^.Ln_)) And BIsId(CB^.Ln_[P]) Do Begin S:=S+CB^.Ln_[P];
  Inc(P);End;
 End;
 If Adv Then CB^.Ps:=P;
 BWord:=S;
End;

Function BAccept(Const K: String): Boolean;
Var W: String;
Begin
 W:=Upper(BWord(False));
 If W=K Then Begin BWord(True);BAccept:=True;End Else BAccept:=False;
End;

Function BCh(C: Char): Boolean;
Begin
 If BPeek=C Then Begin Inc(CB^.Ps);BCh:=True;End Else BCh:=False;
End;

Procedure BExpect(C: Char);
Begin
 If Not BCh(C) Then BFail(T3('Syntax error, expected ',
     'Erreur de syntaxe, attendu ','Syntaxfehler, erwartet ')+C);
End;

{ ---------------------- fonctions ---------------------- }

Function BCallFn(Const Nm: String; Var R: TBVal): Boolean;
Var A,B,C,D4: TBVal; U: String; N: Integer; D: Double; S: String; I,J: Integer;
Sv: String; SvP: Integer; PV: PBVal; OldV: TBVal;
Begin
 BCallFn:=True;
 R.IsS:=False;R.N:=0;R.T:='';
 U:=Upper(Nm);
 { fonction utilisateur : DEF FNnom(x) = expression }
 If (Copy(U,1,2)='FN') And (Length(U)>2) Then Begin
  I:=0;For J:=1 To CB^.NFn Do If CB^.Fns[J].Nm=Copy(U,3,10) Then I:=J;
  If I=0 Then Begin BFail(T3('Undefined function ','Fonction non d'#130'finie ',
      'Funktion nicht definiert ')+U);BCallFn:=False;Exit;End;
  BExpect('(');If Not BExpr(A) Then Begin BCallFn:=False;Exit;End;BExpect(')');
  If CB^.Done Then Begin BCallFn:=False;Exit;End;
  J:=BFindVar(CB^.Fns[I].Par,True,0,0,0);
  If J=0 Then Begin BCallFn:=False;Exit;End;
  PV:=@CB^.Var_[J].P^[0];OldV:=PV^;
  PV^.IsS:=A.IsS;PV^.N:=A.N;PV^.T:=A.T;
  Sv:=CB^.Ln_;SvP:=CB^.Ps;CB^.Ln_:=CB^.Fns[I].Ex;CB^.Ps:=1;
  BCallFn:=BExpr(R);
  CB^.Ln_:=Sv;CB^.Ps:=SvP;PV^:=OldV;
  Exit;
 End;
 BExpect('(');
 If CB^.Done Then Begin BCallFn:=False;Exit;End;
 If U='RND' Then Begin If Not BExpr(A) Then Begin BCallFn:=False;Exit;End;
 R.N:=BRnd;BExpect(')');Exit;End;
 If Not BExpr(A) Then Begin BCallFn:=False;Exit;End;
 B.N:=0;B.T:='';B.IsS:=False;C.N:=0;C.T:='';C.IsS:=False;D4.N:=0;D4.T:='';
 D4.IsS:=False;
 If BCh(',') Then Begin If Not BExpr(B) Then Begin BCallFn:=False;Exit;End;
  If BCh(',') Then Begin If Not BExpr(C) Then Begin BCallFn:=False;Exit;End;
   If BCh(',') Then If Not BExpr(D4) Then Begin BCallFn:=False;Exit;End;End;End;
 BExpect(')');
 If CB^.Done Then Begin BCallFn:=False;Exit;End;
 If U='ABS' Then R.N:=Abs(BNum(A))
 Else If U='INT' Then R.N:=Int(BNum(A)-Ord(BNum(A)<0)*Ord(Frac(BNum(A))<>0))
 Else If U='FIX' Then R.N:=Int(BNum(A))
 Else If U='SGN' Then Begin If BNum(A)>0 Then R.N:=1 Else If BNum(A)<0 Then
     R.N:=-1 Else R.N:=0;End
 Else If U='SQR' Then Begin If BNum(A)<0 Then BFail(T3('Illegal quantity',
     'Quantit'#130' ill'#130'gale','Ung'#129'ltige Menge')) Else
     R.N:=Sqrt(BNum(A));End
 Else If U='SIN' Then R.N:=Sin(BNum(A))
 Else If U='COS' Then R.N:=Cos(BNum(A))
 Else If U='TAN' Then R.N:=Sin(BNum(A))/Cos(BNum(A))
 Else If U='ATN' Then R.N:=ArcTan(BNum(A))
 Else If U='EXP' Then R.N:=Exp(BNum(A))
 Else If U='LOG' Then Begin If BNum(A)<=0 Then BFail(T3('Illegal quantity',
     'Quantit'#130' ill'#130'gale','Ung'#129'ltige Menge')) Else
     R.N:=Ln(BNum(A));End
 Else If U='LEN' Then R.N:=Length(A.T)
 Else If U='ASC' Then Begin If A.T='' Then R.N:=0 Else R.N:=Ord(A.T[1]);End
 Else If U='VAL' Then Begin Val(TrimStr(A.T),D,N);If N<>0 Then D:=0;R.N:=D;End
 Else If U='LEFT$' Then Begin R.IsS:=True;R.T:=Copy(A.T,1,Trunc(BNum(B)));End
 Else If U='RIGHT$' Then Begin R.IsS:=True;N:=Trunc(BNum(B));
 If N>Length(A.T) Then N:=Length(A.T);R.T:=Copy(A.T,Length(A.T)-N+1,N);End
 Else If U='MID$' Then Begin
  R.IsS:=True;
  If C.T='' Then Begin If C.N=0 Then N:=255 Else N:=Trunc(BNum(C));
  End Else N:=255;
  If (C.IsS) Then N:=255 Else N:=Trunc(C.N);
  If N=0 Then N:=255;
  R.T:=Copy(A.T,Trunc(BNum(B)),N);
 End
 Else If U='CHR$' Then Begin R.IsS:=True;R.T:=Chr(Trunc(BNum(A)) And 255);End
 Else If U='STR$' Then Begin R.IsS:=True;S:=FmtReal(BNum(A));
 If BNum(A)>=0 Then S:=' '+S;R.T:=S;End
 Else If U='UCASE$' Then Begin R.IsS:=True;R.T:=Upper(A.T);End
 Else If U='LCASE$' Then Begin
  R.IsS:=True;S:=A.T;For N:=1 To Length(S) Do If S[N] In ['A'..'Z'] Then
      S[N]:=Chr(Ord(S[N])+32);R.T:=S;
 End
 Else If U='SPACE$' Then Begin R.IsS:=True;S:='';
 For N:=1 To Trunc(BNum(A)) Do S:=S+' ';R.T:=Copy(S,1,120);End
 Else If U='STRING$' Then Begin
  R.IsS:=True;S:='';
  If B.IsS Then Begin If B.T<>'' Then For N:=1 To Trunc(BNum(A)) Do S:=S+B.T[1];
  End
  Else For N:=1 To Trunc(BNum(A)) Do S:=S+Chr(Trunc(BNum(B)) And 255);
  R.T:=Copy(S,1,120);
 End
 Else If U='HEX$' Then Begin R.IsS:=True;R.T:=HexW(Trunc(BNum(A)) And $FFFF);
 While (Length(R.T)>1) And (R.T[1]='0') Do Delete(R.T,1,1);End
 Else If U='INSTR' Then Begin
  If A.IsS Then R.N:=Pos(B.T,A.T) Else R.N:=Pos(C.T,B.T);
 End
 Else If (U='PEEK') Or (U='DPEEK') Then R.N:=0
 Else If (U='TAB') Or (U='SPC') Then Begin R.IsS:=True;S:='';
 For N:=1 To Trunc(BNum(A)) Do S:=S+' ';R.T:=S;End
 Else If U='POS' Then R.N:=CB^.CurC-CB^.WX1
 Else If U='XPOS' Then R.N:=CB^.CurC*8
 Else If U='YPOS' Then R.N:=CB^.CurR*8
 Else If U='MOUSEX' Then R.N:=CB^.MX
 Else If U='MOUSEY' Then R.N:=CB^.MY
 Else If U='MOUSEIN' Then Begin
  If (CB^.MX>=BNum(A)) And (CB^.MX<=BNum(C)) And (CB^.MY>=BNum(B))
      And (CB^.MY<=BNum(D4)) Then R.N:=-1 Else R.N:=0;
 End
 Else If U='TESTPT' Then Begin
  I:=Trunc(BNum(A));J:=Trunc(BNum(B));
  If (I<0) Or (I>319) Or (J<0) Or (J>199) Then BFail(T3('Illegal quantity',
      'Quantit'#130' ill'#130'gale','Ung'#129'ltige Menge'))
  Else If CB^.Scr[J,I]<>CLRBG Then R.N:=-1 Else R.N:=0;
 End
 Else If U='FRE' Then R.N:=38911
 Else If U='EOF' Then Begin If BFileOpen Then Begin If Eof(BFile) Then R.N:=-1
     Else R.N:=0;End Else R.N:=-1;End
 Else If U='USR' Then R.N:=0
 Else If U='BITS' Then R.N:=0
 Else Begin BFail(T3('Unknown function ','Fonction inconnue ',
     'Unbekannte Funktion ')+U);BCallFn:=False;End;
End;

Function BNum(Const V: TBVal): Double;
Var D: Double; N: Integer;
Begin
 If V.IsS Then Begin Val(TrimStr(V.T),D,N);If N<>0 Then D:=0;BNum:=D;
 End Else BNum:=V.N;
End;

Function BExtVar(Const Nm: String; Var R: TBVal): Boolean; Forward;
Function BFindLine(Const Tg: String): Integer; Forward;

{ lit une primaire : nombre, chaine, variable, fonction, parentheses }
Function BPrimary(Var R: TBVal): Boolean;
Var W,U: String; C: Char; P0: Integer; V: Integer; I1,I2: Integer; A: TBVal;
PE: PBVal; D: Double; N: Integer; S: String;
Begin
 BPrimary:=False;
 R.IsS:=False;R.N:=0;R.T:='';
 C:=BPeek;
 If C=#0 Then Begin BFail(T3('Missing operand','Op'#130'rande manquant',
     'Operand fehlt'));Exit;End;
 If C='(' Then Begin
  Inc(CB^.Ps);If Not BExpr(R) Then Exit;
  BExpect(')');BPrimary:=Not CB^.Done;Exit;
 End;
 If C='"' Then Begin
  Inc(CB^.Ps);S:='';
  While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]<>'"') Do Begin
      S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
  Inc(CB^.Ps);
  R.IsS:=True;R.T:=Copy(S,1,120);BPrimary:=True;Exit;
 End;
 If (C In ['0'..'9','.']) Or ((C='&') And (CB^.Ps<Length(CB^.Ln_))
     And (UpCase(CB^.Ln_[CB^.Ps+1])='H')) Then Begin
  P0:=CB^.Ps;S:='';
  If C='&' Then Begin
   Inc(CB^.Ps,2);S:='$';
   While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In ['0'..'9','A'..'F',
       'a'..'f']) Do Begin S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
  End Else Begin
   While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In ['0'..'9',
       '.']) Do Begin S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
   If (CB^.Ps<=Length(CB^.Ln_)) And (UpCase(CB^.Ln_[CB^.Ps])='E')
       And (CB^.Ps<Length(CB^.Ln_)) And
      (CB^.Ln_[CB^.Ps+1] In ['0'..'9','+','-']) Then Begin
    S:=S+'E';Inc(CB^.Ps);
    If CB^.Ln_[CB^.Ps] In ['+','-'] Then Begin S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);
    End;
    While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In ['0'..'9']) Do Begin
        S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
   End;
  End;
  Val(S,D,N);
  If N<>0 Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
      'Syntaxfehler'));Exit;End;
  R.N:=D;BPrimary:=True;Exit;
 End;
 If C='@' Then Begin
  Inc(CB^.Ps);S:='@'+BWord(True);
  I1:=BFindLine(S);
  If I1=0 Then Begin BFail(T3('Undefined label ','Etiquette non d'#130'finie ',
      'Marke nicht definiert ')+S);Exit;End;
  If CB^.LNo[I1]>=0 Then R.N:=CB^.LNo[I1] Else R.N:=I1;
  BPrimary:=True;Exit;
 End;
 If C='-' Then Begin Inc(CB^.Ps);If Not BPrimary(R) Then Exit;R.N:=-BNum(R);
 R.IsS:=False;BPrimary:=True;Exit;End;
 If C='+' Then Begin Inc(CB^.Ps);BPrimary:=BPrimary(R);Exit;End;
 W:=BWord(True);
 If W='' Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
     'Syntaxfehler'));Exit;End;
 U:=Upper(W);
 If U='NOT' Then Begin
  If Not BPrimary(R) Then Exit;
  R.N:=Not Trunc(BNum(R));R.IsS:=False;BPrimary:=True;Exit;
 End;
 If U='TIMER' Then Begin R.N:=NowCs/100.0;BPrimary:=True;Exit;End;
 If U='TIME$' Then Begin
  R.IsS:=True;R.T:=Pad2((NowCs Div 360000) Mod 24)+':'+Pad2((NowCs Div 6000)
      Mod 60)+':'+Pad2((NowCs Div 100) Mod 60);BPrimary:=True;Exit;
 End;
 If U='DATE$' Then Begin
  R.IsS:=True;R.T:='';BPrimary:=True;Exit;
 End;
 If U='INKEY$' Then Begin R.IsS:=True;R.T:=CB^.LastKey;CB^.LastKey:='';
 BPrimary:=True;Exit;End;
 If U='PI' Then Begin R.N:=Pi;BPrimary:=True;Exit;End;
 If U='TRUE' Then Begin R.N:=-1;BPrimary:=True;Exit;End;
 If U='FALSE' Then Begin R.N:=0;BPrimary:=True;Exit;End;
 { fonction ? }
 If (BPeek='(') And (BFindVar(W,False,0,0,0)=0) Then Begin
  BPrimary:=BCallFn(W,R);Exit;
 End;
 { propriete d'objet : Nom.Prop ? }
 If (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]='.') Then Begin
  Inc(CB^.Ps);
  S:=BWord(True);
  BPrimary:=BExtVar(W+'.'+S,R);Exit;
 End;
 { variable ou element de tableau }
 V:=BFindVar(W,False,0,0,0);
 If BPeek='(' Then Begin
  Inc(CB^.Ps);
  If Not BExpr(A) Then Exit;
  I1:=Trunc(BNum(A));I2:=0;
  If BCh(',') Then Begin If Not BExpr(A) Then Exit;I2:=Trunc(BNum(A));End;
  BExpect(')');
  If V=0 Then Begin
   { tableau implicite 10 x 10 }
   V:=BFindVar(W,True,10,10,2);
  End;
  PE:=BElem(V,I1,I2);
  If PE=Nil Then Exit;
  R:=PE^;BPrimary:=Not CB^.Done;Exit;
 End;
 If V=0 Then V:=BFindVar(W,True,0,0,0);
 If V=0 Then Exit;
 R:=CB^.Var_[V].P^[0];
 R.IsS:=CB^.Var_[V].IsS;
 BPrimary:=True;
End;

Function BPower(Var R: TBVal): Boolean;
Var B: TBVal;
Begin
 BPower:=False;
 If Not BPrimary(R) Then Exit;
 While BPeek='^' Do Begin
  Inc(CB^.Ps);
  If Not BPrimary(B) Then Exit;
  If (R.N=0) And (BNum(B)<0) Then Begin BFail(T3('Division by zero',
      'Division par z'#130'ro','Division durch Null'));Exit;End;
  If BNum(R)>0 Then R.N:=Exp(BNum(B)*Ln(BNum(R)))
  Else If BNum(R)=0 Then R.N:=0
  Else R.N:=Exp(BNum(B)*Ln(-BNum(R)))*(1-2*(Trunc(BNum(B)) And 1));
  R.IsS:=False;
 End;
 BPower:=True;
End;

Function BTerm(Var R: TBVal): Boolean;
Var B: TBVal; Op: Char; Nm: String;
Begin
 BTerm:=False;
 If Not BPower(R) Then Exit;
 Repeat
  Op:=BPeek;
  Nm:=Upper(BWord(False));
  If (Op='*') Or (Op='/') Or (Op='\') Then Begin
   Inc(CB^.Ps);
   If Not BPower(B) Then Exit;
   If Op='*' Then R.N:=BNum(R)*BNum(B)
   Else Begin
    If BNum(B)=0 Then Begin BFail(T3('Division by zero',
        'Division par z'#130'ro','Division durch Null'));Exit;End;
    If Op='/' Then R.N:=BNum(R)/BNum(B) Else R.N:=Trunc(BNum(R)/BNum(B));
   End;
   R.IsS:=False;
  End Else If Nm='MOD' Then Begin
   BWord(True);
   If Not BPower(B) Then Exit;
   If Trunc(BNum(B))=0 Then Begin BFail(T3('Division by zero',
       'Division par z'#130'ro','Division durch Null'));Exit;End;
   R.N:=Trunc(BNum(R)) Mod Trunc(BNum(B));R.IsS:=False;
  End Else Break;
 Until CB^.Done;
 BTerm:=Not CB^.Done;
End;

Function BArith(Var R: TBVal): Boolean;
Var B: TBVal; Op: Char;
Begin
 BArith:=False;
 If Not BTerm(R) Then Exit;
 Repeat
  Op:=BPeek;
  If (Op='+') Or (Op='-') Then Begin
   Inc(CB^.Ps);
   If Not BTerm(B) Then Exit;
   If Op='+' Then Begin
    If R.IsS Or B.IsS Then Begin R.T:=Copy(R.T+B.T,1,120);R.IsS:=True;End
    Else R.N:=R.N+B.N;
   End Else Begin R.N:=BNum(R)-BNum(B);R.IsS:=False;End;
  End Else Break;
 Until CB^.Done;
 BArith:=Not CB^.Done;
End;

Function BCompare(Var R: TBVal): Boolean;
Var B: TBVal; Op: String; C: Integer; Ok: Boolean; P0: Integer;
Begin
 BCompare:=False;
 If Not BArith(R) Then Exit;
 Repeat
  BSkip;P0:=CB^.Ps;Op:='';
  While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In ['<','>',
      '=']) And (Length(Op)<2) Do Begin Op:=Op+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
  If Op='' Then Break;
  If Not BArith(B) Then Exit;
  If R.IsS Or B.IsS Then Begin If R.T<B.T Then C:=-1 Else If R.T>B.T Then C:=1
      Else C:=0;End
  Else Begin If R.N<B.N Then C:=-1 Else If R.N>B.N Then C:=1 Else C:=0;End;
  Ok:=False;
  If Op='=' Then Ok:=C=0
  Else If (Op='<>') Or (Op='><') Then Ok:=C<>0
  Else If Op='<' Then Ok:=C<0
  Else If Op='>' Then Ok:=C>0
  Else If (Op='<=') Or (Op='=<') Then Ok:=C<=0
  Else If (Op='>=') Or (Op='=>') Then Ok:=C>=0;
  R.IsS:=False;R.T:='';
  If Ok Then R.N:=-1 Else R.N:=0;
 Until CB^.Done;
 BCompare:=Not CB^.Done;
End;

Function BAnd(Var R: TBVal): Boolean;
Var B: TBVal;
Begin
 BAnd:=False;
 If Not BCompare(R) Then Exit;
 While Upper(BWord(False))='AND' Do Begin
  BWord(True);
  If Not BCompare(B) Then Exit;
  R.N:=Trunc(BNum(R)) And Trunc(BNum(B));R.IsS:=False;
 End;
 BAnd:=True;
End;

Function BExpr(Var R: TBVal): Boolean;
Var B: TBVal; U: String;
Begin
 BExpr:=False;
 If Not BAnd(R) Then Exit;
 Repeat
  U:=Upper(BWord(False));
  If U='OR' Then Begin
   BWord(True);If Not BAnd(B) Then Exit;
   R.N:=Trunc(BNum(R)) Or Trunc(BNum(B));R.IsS:=False;
  End Else If U='XOR' Then Begin
   BWord(True);If Not BAnd(B) Then Exit;
   R.N:=Trunc(BNum(R)) Xor Trunc(BNum(B));R.IsS:=False;
  End Else Break;
 Until CB^.Done;
 BExpr:=Not CB^.Done;
End;

Function BEval(Var R: TBVal): Boolean;
Begin
 BEval:=BExpr(R);
End;

{ ---------------------- saut vers une ligne ---------------------- }

Function BFindLine(Const Tg: String): Integer;
Var I,P,K: Integer; N: LongInt; U,L: String;
Begin
 BFindLine:=0;
 U:=Upper(TrimStr(Tg));
 If (U<>'') And (U[1] In ['0'..'9']) Then Begin
  N:=StrVal(U,-1);
  For I:=1 To CB^.NL Do If CB^.LNo[I]=N Then Begin BFindLine:=I;Exit;End;
 End Else Begin
  If (U<>'') And (U[1]='@') Then Delete(U,1,1);
  U:=Copy(U,1,6);
  For I:=1 To CB^.NL Do Begin
   L:=Upper(TrimStr(CB^.Src[I]^));
   If CB^.LNo[I]>=0 Then Begin P:=1;While (P<=Length(L)) And (L[P] In ['0'..'9',
       ' ']) Do Inc(P);L:=Copy(L,P,255);End;
   If (L<>'') And (L[1]='@') Then Delete(L,1,1);
   K:=0;While (K<Length(L)) And BIsId(L[K+1]) And (K<6) Do Inc(K);
   If (K>0) And (Copy(L,1,K)=U) And ((K=Length(L)) Or (L[K+1] In [':',
       ' '])) Then Begin BFindLine:=I;Exit;End;
  End;
 End;
End;

Procedure BGotoLine(L: Integer);
Begin
 If L<=0 Then Begin BFail(T3('Undefined line','Ligne non d'#130'finie',
     'Zeile nicht definiert'));Exit;End;
 CB^.Ln:=L;CB^.Ln_:=CB^.Src[L]^;CB^.Ps:=1;Inc(CB^.Jmp);
 { passe le numero de ligne ou l'etiquette }
 If CB^.LNo[L]>=0 Then Begin
  BSkip;
  While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps] In ['0'..'9']) Do
      Inc(CB^.Ps);
 End;
End;

Function BTarget: String;
Var S: String; P: Integer;
Begin
 BSkip;
 S:='';
 If (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]='@') Then Begin S:='@';
 Inc(CB^.Ps);End;
 While (CB^.Ps<=Length(CB^.Ln_)) And BIsId(CB^.Ln_[CB^.Ps]) Do Begin
     S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
 BTarget:=S;
End;

{ cible d'un saut : numero, @etiquette, nom ou expression -> indice de ligne }
Function BLineTarget: Integer;
Var R: TBVal; N: LongInt; I: Integer;
Begin
 BLineTarget:=0;
 BSkip;
 If BPeek In ['A'..'Z','a'..'z','_'] Then Begin BLineTarget:=BFindLine(BTarget);
 Exit;End;
 If Not BExpr(R) Then Exit;
 N:=Trunc(BNum(R));
 For I:=1 To CB^.NL Do If CB^.LNo[I]=N Then Begin BLineTarget:=I;Exit;End;
 If (N>=1) And (N<=CB^.NL) And (CB^.LNo[N]<0) Then BLineTarget:=N;
End;

{ ---------------------- affectation ---------------------- }

Function BExtSet(Const Nm: String; Const V: TBVal): Boolean; Forward;
Procedure BExtCmd(Const U: String; Var Handled: Boolean); Forward;

Procedure BAssign(Const W: String);
Var V,I1,I2: Integer; A,R: TBVal; PE: PBVal; S: String;
Begin
 I1:=0;I2:=0;
 If (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]='.') Then Begin
  Inc(CB^.Ps);S:=BWord(True);
  BExpect('=');If CB^.Done Then Exit;
  If Not BExpr(R) Then Exit;
  If Not BExtSet(W+'.'+S,R) Then BFail(T3('Unknown property ',
      'Propri'#130't'#130' inconnue ','Unbekannte Eigenschaft ')+W+'.'+S);
  Exit;
 End;
 V:=BFindVar(W,False,0,0,0);
 If BPeek='(' Then Begin
  Inc(CB^.Ps);If Not BExpr(A) Then Exit;
  I1:=Trunc(BNum(A));
  If BCh(',') Then Begin If Not BExpr(A) Then Exit;I2:=Trunc(BNum(A));End;
  BExpect(')');
  If V=0 Then V:=BFindVar(W,True,10,10,2);
 End Else If V=0 Then V:=BFindVar(W,True,0,0,0);
 BExpect('=');
 If CB^.Done Then Exit;
 If Not BExpr(R) Then Exit;
 PE:=BElem(V,I1,I2);
 If PE=Nil Then Exit;
 If CB^.Var_[V].IsS Then BSetV(PE,True,0,R.T+'')
 Else BSetV(PE,False,BNum(R),'');
 If CB^.Var_[V].IsS And (Not R.IsS) Then PE^.T:=Copy(FmtReal(R.N),1,120);
End;

{ ---------------------- structures de controle ---------------------- }

{ avance jusqu'a la ligne contenant l'un des mots (avec imbrication) ; retourne
  l'indice ou 0 }
Function BScan(From: Integer; Const OpenW,CloseW,AltW: String): Integer;
Var I,Dep: Integer; S,U: String; P: Integer;
Begin
 Dep:=0;BScan:=0;
 For I:=From To CB^.NL Do Begin
  U:=Upper(TrimStr(CB^.Src[I]^));
  While (U<>'') And (U[1] In ['0'..'9']) Do Delete(U,1,1);
  U:=TrimStr(U);
  If (Pos(CloseW,U)=1) And ((Length(U)=Length(CloseW))
      Or Not (U[Length(CloseW)+1] In ['A'..'Z','0'..'9','_'])) Then Begin
   If Dep=0 Then Begin BScan:=I;Exit;End;
   Dec(Dep);
  End Else If (AltW<>'') And (Pos(AltW,U)=1) And (Dep=0) And
          ((Length(U)=Length(AltW)) Or Not (U[Length(AltW)+1] In ['A'..'Z',
              '0'..'9','_'])) Then Begin BScan:=I;Exit;End
  Else If (Pos(OpenW,U)=1) And ((Length(U)=Length(OpenW))
      Or Not (U[Length(OpenW)+1] In ['A'..'Z','0'..'9','_'])) Then Begin
   If OpenW='IF' Then Begin
    { IF bloc : THEN en fin de ligne }
    If Copy(U,Length(U)-3,4)='THEN' Then Inc(Dep);
   End Else Inc(Dep);
  End;
 End;
End;

Procedure BPushLp(K: Byte; L,P: Integer);
Begin
 If CB^.NLp>=BMAXGS Then Begin BFail(T3('Stack overflow',
     'D'#130'passement de pile','Stapel'#129'berlauf'));Exit;End;
 Inc(CB^.NLp);CB^.Lp[CB^.NLp].K:=K;CB^.Lp[CB^.NLp].L:=L;CB^.Lp[CB^.NLp].P:=P;
End;

{ ferme-boucle (LOOP, WEND, UNTIL) sur la ligne courante apres Ps : retourne la
  position qui suit, ou 0 }
Function BLoopEndSameLine: Integer;
Var P,Q,Dep: Integer; W: String;
Begin
 BLoopEndSameLine:=0;
 Dep:=0;P:=CB^.Ps;
 While P<=Length(CB^.Ln_) Do Begin
  If CB^.Ln_[P]='"' Then Begin
   Inc(P);While (P<=Length(CB^.Ln_)) And (CB^.Ln_[P]<>'"') Do Inc(P);
   Inc(P);
  End Else If CB^.Ln_[P] In ['A'..'Z','a'..'z','_'] Then Begin
   Q:=P;W:='';
   While (Q<=Length(CB^.Ln_)) And BIsId(CB^.Ln_[Q]) Do Begin W:=W+CB^.Ln_[Q];
   Inc(Q);End;
   W:=Upper(W);
   If (W='WEND') Or (W='LOOP') Or (W='UNTIL') Then Begin
    If Dep=0 Then Begin BLoopEndSameLine:=Q;Exit;End;
    Dec(Dep);
   End Else If (W='WHILE') Or (W='DO') Or (W='REPEAT') Then Inc(Dep);
   P:=Q;
  End Else Inc(P);
 End;
End;

{ ligne de fermeture (WEND, LOOP ou UNTIL) correspondant a une ouverture, avec
  imbrication }
Function BLoopEnd(From: Integer): Integer;
Var I,Dep: Integer; U: String; P: Integer;
 Function Starts(Const W: String): Boolean;
 Begin
  Starts:=(Copy(U,1,Length(W))=W) And ((Length(U)=Length(W))
      Or Not (U[Length(W)+1] In ['A'..'Z','0'..'9','_']));
 End;
Begin
 Dep:=0;BLoopEnd:=0;
 For I:=From To CB^.NL Do Begin
  U:=Upper(TrimStr(CB^.Src[I]^));
  If CB^.LNo[I]>=0 Then Begin P:=1;While (P<=Length(U)) And (U[P] In ['0'..'9',
      ' ']) Do Inc(P);U:=Copy(U,P,255);End;
  If (U<>'') And (U[1]='@') Then Begin P:=Pos(':',U);
  If P>0 Then U:=TrimStr(Copy(U,P+1,255));End;
  If Starts('WEND') Or Starts('LOOP') Or Starts('UNTIL') Then Begin
   If Dep=0 Then Begin BLoopEnd:=I;Exit;End;
   Dec(Dep);
  End Else If Starts('WHILE') Or Starts('DO') Or Starts('REPEAT') Then Inc(Dep);
 End;
End;

Procedure BDoIf;
Var R: TBVal; T: String; L: Integer; True_: Boolean; Fnd: Boolean;
Begin
 If Not BExpr(R) Then Exit;
 True_:=BNum(R)<>0;
 If Not BAccept('THEN') Then Begin
  If Upper(BWord(False))='GOTO' Then Begin End Else Begin
      BFail(T3('Syntax error (THEN)','Erreur de syntaxe (THEN)',
      'Syntaxfehler (THEN)'));Exit;End;
 End;
 If BAtEnd Then Begin
  { IF bloc }
  If True_ Then Exit;
  L:=BScan(CB^.Ln+1,'IF','END IF','ELSE');
  If L=0 Then L:=BScan(CB^.Ln+1,'IF','ENDIF','ELSE');
  If L=0 Then Begin BFail(T3('IF without END IF','IF sans END IF',
      'IF ohne END IF'));Exit;End;
  BGotoLine(L);
  { si c'est ELSE, on continue apres ; ELSEIF non gere }
  If Upper(BWord(False))='ELSE' Then BWord(True);
  Exit;
 End;
 If True_ Then Begin
  { instruction(s) du THEN : numero de ligne = GOTO }
  If BPeek In ['0'..'9'] Then Begin
   T:=BTarget;BGotoLine(BFindLine(T));Exit;
  End;
  BStmts;
 End Else Begin
  { cherche ELSE sur la ligne }
  Fnd:=False;
  While (CB^.Ps<=Length(CB^.Ln_)) And Not Fnd Do Begin
   If CB^.Ln_[CB^.Ps]='"' Then Begin
    Inc(CB^.Ps);While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]<>'"') Do
        Inc(CB^.Ps);
    Inc(CB^.Ps);
   End Else If (Upper(Copy(CB^.Ln_,CB^.Ps,
       4))='ELSE') And ((CB^.Ps=1) Or Not BIsId(CB^.Ln_[CB^.Ps-1])) And
     ((CB^.Ps+4>Length(CB^.Ln_)) Or Not BIsId(CB^.Ln_[CB^.Ps+4])) Then Fnd:=True
   Else Inc(CB^.Ps);
  End;
  If Fnd Then Begin
   Inc(CB^.Ps,4);
   If BPeek In ['0'..'9'] Then Begin T:=BTarget;BGotoLine(BFindLine(T));Exit;
   End;
   BStmts;
  End Else CB^.Ps:=Length(CB^.Ln_)+1;
 End;
End;

Procedure BNextLine;
Begin
 If CB^.Ln>=CB^.NL Then Begin CB^.Running:=False;CB^.Done:=True;Exit;End;
 BGotoLine(CB^.Ln+1);
End;

Procedure BDoFor;
Var W: String; V: Integer; A,L,S: TBVal; F: Integer;
Begin
 W:=BWord(True);
 V:=BFindVar(W,True,0,0,0);
 BExpect('=');If CB^.Done Then Exit;
 If Not BExpr(A) Then Exit;
 BSetV(@CB^.Var_[V].P^[0],False,BNum(A),'');
 If Not BAccept('TO') Then Begin BFail(T3('Syntax error (TO)',
     'Erreur de syntaxe (TO)','Syntaxfehler (TO)'));Exit;End;
 If Not BExpr(L) Then Exit;
 S.N:=1;S.IsS:=False;
 If BAccept('STEP') Then If Not BExpr(S) Then Exit;
 If CB^.NF>=BMAXFOR Then Begin BFail(T3('Too many FOR loops',
     'Trop de boucles FOR','Zu viele FOR'));Exit;End;
 { une boucle sur la meme variable remplace l'ancienne }
 For F:=CB^.NF DownTo 1 Do If CB^.Fors[F].V=V Then Begin CB^.NF:=F-1;Break;End;
 Inc(CB^.NF);
 CB^.Fors[CB^.NF].V:=V;CB^.Fors[CB^.NF].Lim:=BNum(L);
 CB^.Fors[CB^.NF].Stp:=BNum(S);
 CB^.Fors[CB^.NF].Ln:=CB^.Ln;CB^.Fors[CB^.NF].Ps:=CB^.Ps;
 If ((BNum(S)>=0) And (BNum(A)>BNum(L))) Or ((BNum(S)<0) And (BNum(A)<BNum(L)))
     Then Begin
  { boucle vide : saute jusqu'au NEXT correspondant }
  Dec(CB^.NF);
  F:=BScan(CB^.Ln+1,'FOR','NEXT','');
  If F=0 Then Begin BFail(T3('FOR without NEXT','FOR sans NEXT',
      'FOR ohne NEXT'));Exit;End;
  BGotoLine(F);CB^.Ps:=Length(CB^.Ln_)+1;
 End;
End;

Procedure BDoNext;
Var W: String; V,F: Integer; P: PBVal; X: Double;
Begin
 W:=BWord(True);
 If CB^.NF=0 Then Begin BFail(T3('NEXT without FOR','NEXT sans FOR',
     'NEXT ohne FOR'));Exit;End;
 If W<>'' Then Begin
  V:=BFindVar(W,False,0,0,0);
  F:=CB^.NF;
  While (F>=1) And (CB^.Fors[F].V<>V) Do Dec(F);
  If F=0 Then Begin BFail(T3('NEXT without FOR','NEXT sans FOR',
      'NEXT ohne FOR'));Exit;End;
  CB^.NF:=F;
 End;
 F:=CB^.NF;
 P:=@CB^.Var_[CB^.Fors[F].V].P^[0];
 X:=P^.N+CB^.Fors[F].Stp;P^.N:=X;
 If ((CB^.Fors[F].Stp>=0) And (X<=CB^.Fors[F].Lim+1E-12))
     Or ((CB^.Fors[F].Stp<0) And (X>=CB^.Fors[F].Lim-1E-12)) Then Begin
  CB^.Ln:=CB^.Fors[F].Ln;CB^.Ln_:=CB^.Src[CB^.Ln]^;CB^.Ps:=CB^.Fors[F].Ps;
 End Else Dec(CB^.NF);
End;

Procedure BDoDim;
Var W: String; A: TBVal; D1,D2: Integer; V: Integer;
Begin
 Repeat
  W:=BWord(True);
  If W='' Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
      'Syntaxfehler'));Exit;End;
  BExpect('(');If Not BExpr(A) Then Exit;
  D1:=Trunc(BNum(A));D2:=0;
  If BCh(',') Then Begin If Not BExpr(A) Then Exit;D2:=Trunc(BNum(A));End;
  BExpect(')');
  If (D1<0) Or (D2<0) Or ((D1+1)*(D2+1)>8000) Then Begin
      BFail(T3('Bad dimension','Dimension incorrecte','Falsche Dimension'));
  Exit;End;
  If BFindVar(W,False,0,0,0)<>0 Then Begin BFail(T3('Redimensioned array',
      'Tableau red'#130'dimensionn'#130,'Feld neu dimensioniert'));Exit;End;
  V:=BFindVar(W,True,D1,D2,1+Ord(D2>0));
 Until (Not BCh(',')) Or CB^.Done;
End;

Procedure BPrnPut(Const S: String);
Var T: Text; I: Integer;
Begin
 Assign(T,'PRINTER.TXT');
 {$I-}Append(T);If IOResult<>0 Then Rewrite(T);{$I+}
 If IOResult<>0 Then Exit;
 For I:=1 To Length(S) Do If S[I]=#13 Then WriteLn(T) Else Write(T,S[I]);
 Close(T);
End;

Procedure BDoPrint;
Var R: TBVal; S: String; NL: Boolean; C: Char;
Begin
 NL:=True;
 While Not BAtEnd Do Begin
  If Upper(BWord(False))='ELSE' Then Break;
  If BPeek=':' Then Break;
  If BPeek='#' Then Begin Inc(CB^.Ps);
  While (BPeek In ['0'..'9']) Do Inc(CB^.Ps);BCh(',');End;
  If Upper(BWord(False))='USING' Then Begin BWord(True);
  If Not BExpr(R) Then Exit;BCh(';');End;
  If BAtEnd Then Break;
  If Not BExpr(R) Then Exit;
  If R.IsS Then S:=R.T Else Begin S:=FmtReal(R.N);If R.N>=0 Then S:=' '+S;
  S:=S+' ';End;
  If BPrn Then Begin BPrnPut(S);End Else BPutS(S);
  NL:=True;
  C:=BPeek;
  If C=';' Then Begin Inc(CB^.Ps);NL:=False;End
  Else If C=',' Then Begin
   Inc(CB^.Ps);NL:=False;
   Repeat BPutS(' ');Until ((CB^.CurC-CB^.WX1) Mod 10)=0;
  End Else Break;
 End;
 If NL Then Begin If BPrn Then BPrnPut(#13) Else BPutS(#13);End;
End;

Procedure BDoInput;
Var S: String; W: String; V: Integer; I1,I2: Integer; A: TBVal;
Begin
 S:='';
 If BPeek='"' Then Begin
  Inc(CB^.Ps);While (CB^.Ps<=Length(CB^.Ln_)) And (CB^.Ln_[CB^.Ps]<>'"') Do
      Begin S:=S+CB^.Ln_[CB^.Ps];Inc(CB^.Ps);End;
  Inc(CB^.Ps);BCh(';');BCh(',');
 End Else S:='? ';
 W:=BWord(True);
 If W='' Then Begin BFail(T3('Syntax error','Erreur de syntaxe',
     'Syntaxfehler'));Exit;End;
 I1:=0;I2:=0;
 V:=BFindVar(W,False,0,0,0);
 If BPeek='(' Then Begin
  Inc(CB^.Ps);If Not BExpr(A) Then Exit;I1:=Trunc(BNum(A));
  If BCh(',') Then Begin If Not BExpr(A) Then Exit;I2:=Trunc(BNum(A));End;
  BExpect(')');
  If V=0 Then V:=BFindVar(W,True,10,10,2);
 End Else If V=0 Then V:=BFindVar(W,True,0,0,0);
 CB^.InVar:=V;CB^.InIdx1:=I1;CB^.InIdx2:=I2;CB^.InPrompt:=S;CB^.InBuf:='';
 BPutS(S);
 CB^.WaitIn:=True;
End;

Procedure BFinishInput;
Var P: PBVal; D: Double; N: Integer;
Begin
 P:=BElem(CB^.InVar,CB^.InIdx1,CB^.InIdx2);
 If P=Nil Then Exit;
 If CB^.Var_[CB^.InVar].IsS Then BSetV(P,True,0,CB^.InBuf)
 Else Begin Val(TrimStr(CB^.InBuf),D,N);If N<>0 Then D:=0;BSetV(P,False,D,'');
 End;
 BPutS(CB^.InBuf+#13);
 CB^.WaitIn:=False;
End;

Procedure BDoData;
Begin
 CB^.Ps:=Length(CB^.Ln_)+1;
End;

Procedure BDoRead;
Var W: String; V,I1,I2: Integer; A: TBVal; P: PBVal; S: String; D: Double;
N: Integer;
Begin
 Repeat
  W:=BWord(True);
  I1:=0;I2:=0;
  V:=BFindVar(W,False,0,0,0);
  If BPeek='(' Then Begin
   Inc(CB^.Ps);If Not BExpr(A) Then Exit;I1:=Trunc(BNum(A));
   If BCh(',') Then Begin If Not BExpr(A) Then Exit;I2:=Trunc(BNum(A));End;
   BExpect(')');
   If V=0 Then V:=BFindVar(W,True,10,10,2);
  End Else If V=0 Then V:=BFindVar(W,True,0,0,0);
  If CB^.DPos>=CB^.NDat Then Begin BFail(T3('Out of DATA','Plus de DATA',
      'Keine DATA mehr'));Exit;End;
  Inc(CB^.DPos);S:=CB^.Dat[CB^.DPos];
  P:=BElem(V,I1,I2);
  If P=Nil Then Exit;
  If CB^.Var_[V].IsS Then BSetV(P,True,0,S)
  Else Begin Val(TrimStr(S),D,N);If N<>0 Then Begin BFail(T3('Type mismatch',
      'Types incompatibles','Typen unvertr'#132'glich'));Exit;End;
  BSetV(P,False,D,'');End;
 Until (Not BCh(',')) Or CB^.Done;
End;

Procedure BCollectData;
Var I,P: Integer; L,U,Item: String; Q: Boolean;
Begin
 CB^.NDat:=0;CB^.DPos:=0;
 For I:=1 To CB^.NL Do Begin
  L:=CB^.Src[I]^;
  If CB^.LNo[I]>=0 Then Begin P:=1;While (P<=Length(L)) And (L[P]
      In [' ']+['0'..'9']) Do Inc(P);L:=Copy(L,P,255);End;
  L:=TrimStr(L);U:=Upper(L);
  If Copy(U,1,5)='DATA ' Then Begin
   L:=Copy(L,6,255);Item:='';Q:=False;
   P:=1;
   While P<=Length(L)+1 Do Begin
    If (P>Length(L)) Or ((L[P]=',') And Not Q) Then Begin
     If CB^.NDat<BMAXDAT Then Begin Inc(CB^.NDat);
     CB^.Dat[CB^.NDat]:=Copy(TrimStr(Item),1,60);End;
     Item:='';
    End Else If L[P]='"' Then Q:=Not Q
    Else Item:=Item+L[P];
    Inc(P);
   End;
  End;
 End;
End;

Procedure BCollectSubs;
Var I: Integer; U,N: String; P: Integer;
Begin
 CB^.NSubs:=0;
 For I:=1 To CB^.NL Do Begin
  U:=Upper(TrimStr(CB^.Src[I]^));
  If CB^.LNo[I]>=0 Then Begin P:=1;While (P<=Length(U)) And (U[P] In ['0'..'9',
      ' ']) Do Inc(P);U:=Copy(U,P,255);End;
  If (Copy(U,1,4)='SUB ') And (CB^.NSubs<40) Then Begin
   N:=TrimStr(Copy(U,5,40));P:=Pos('(',N);If P>0 Then N:=Copy(N,1,P-1);
   Inc(CB^.NSubs);CB^.Subs[CB^.NSubs]:=Copy(TrimStr(N),1,24);
   CB^.SubL[CB^.NSubs]:=I;
  End;
 End;
End;

