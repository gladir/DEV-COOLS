Procedure EdwUpdateTitle(Wd_: PWindow);
 Var Dt_: PEditWin;
Var N: String;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.FName='' Then N:=T3('Untitled','Sans titre',
     'Unbenannt') Else N:=ShortName(Dt_^.FName);
 Case Dt_^.Mode Of
  1: Wd_^.Title:='Notepad - '+N;
  2: Wd_^.Title:=T3('Text File Editor','Editeur de texte','Texteditor')+' - '+N;
 Else Wd_^.Title:='GeoWrite - '+N+' - '+T3('Page 1','Page 1','Seite 1');
 End;
 If Dt_^.E.Modified Then Wd_^.Title:=Wd_^.Title+' *';
End;

Procedure EdwCellSize(Wd_: PWindow; Var CW,CH: Integer);
 Var Dt_: PEditWin;
Begin
 Dt_:=Wd_^.Data;
 CW:=8*Dt_^.Scale;CH:=8*Dt_^.Scale+3;
End;

Procedure EdwTextRect(Wd_: PWindow; Var X1,Y1,X2,Y2: Integer);
 Var Dt_: PEditWin;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 If (Dt_^.Mode=3) And Dt_^.RulerOn Then Inc(Y1,24);
 If Dt_^.Mode=1 Then Begin Inc(X1,6);Inc(Y1,6);End;
 Dec(X2,SB);
End;

Function EdwLineOfs(Wd_: PWindow; I: Integer; CW,TW: Integer): Integer;
 Var Dt_: PEditWin;
Var Ln: Integer;
Begin
 Dt_:=Wd_^.Data;
 EdwLineOfs:=0;
 If Dt_^.Mode<>3 Then Exit;
 Ln:=Length(EdLine(Dt_^.E,I))*CW;
 Case Dt_^.E.Al[I] Of
  1: EdwLineOfs:=Max2(0,(TW-Ln) Div 2-Dt_^.E.LeftC*CW);
  2: EdwLineOfs:=Max2(0,TW-Ln-Dt_^.E.LeftC*CW);
 End;
End;

Procedure EdwReveal(Wd_: PWindow);
 Var Dt_: PEditWin;
Var X1,Y1,X2,Y2,CW,CH,VR,VC: Integer;
Begin
 Dt_:=Wd_^.Data;
 EdwTextRect(Wd_,X1,Y1,X2,Y2);
 EdwCellSize(Wd_,CW,CH);
 VR:=(Y2-Y1+1) Div CH;VC:=(X2-X1+1) Div CW;
 If VR<1 Then VR:=1;
 If VC<1 Then VC:=1;
 If Dt_^.E.CY<Dt_^.E.TopL Then Dt_^.E.TopL:=Dt_^.E.CY;
 If Dt_^.E.CY>=Dt_^.E.TopL+VR Then Dt_^.E.TopL:=Dt_^.E.CY-VR+1;
 If Dt_^.E.CX<Dt_^.E.LeftC Then Dt_^.E.LeftC:=Dt_^.E.CX;
 If Dt_^.E.CX>=Dt_^.E.LeftC+VC Then Dt_^.E.LeftC:=Dt_^.E.CX-VC+1;
End;

{ Dessine un texte avec ses attributs (gras, italique, souligne) par plages }
Procedure EdwDrawStyled(X,Y: Integer; Const S,At: String; Fg,Scale,CW,
    CH: Integer);
Var J,K,A,SX1,SY1,SX2,SY2: Integer; R: String; Sv: Boolean;
Begin
 J:=1;
 While J<=Length(S) Do Begin
  If J<=Length(At) Then A:=Ord(At[J]) Else A:=0;
  K:=J;
  While (K<Length(S)) And (K<Length(At)) And (Ord(At[K+1])=A) Do Inc(K);
  If (K=J) And (J>Length(At)) Then K:=Length(S);
  R:=Copy(S,J,K-J+1);
  If (A And 2)<>0 Then Begin
   { italique : la moitie haute est decalee d'un pixel }
   SX1:=CX1;SY1:=CY1;SX2:=CX2;SY2:=CY2;
   SetClip(SX1,Max2(SY1,Y),SX2,Min2(SY2,Y+CH Div 2-1));
   If Scale=1 Then GText(X+(J-1)*CW+1,Y+1,R,Fg) Else GTextBig(X+(J-1)*CW+1,Y+1,
       R,Scale,Fg);
   SetClip(SX1,Max2(SY1,Y+CH Div 2),SX2,Min2(SY2,Y+CH-1));
   If Scale=1 Then GText(X+(J-1)*CW,Y+1,R,Fg) Else GTextBig(X+(J-1)*CW,Y+1,R,
       Scale,Fg);
   SetClip(SX1,SY1,SX2,SY2);
  End Else Begin
   If Scale=1 Then GText(X+(J-1)*CW,Y+1,R,Fg) Else GTextBig(X+(J-1)*CW,Y+1,R,
       Scale,Fg);
  End;
  If (A And 1)<>0 Then Begin
   If Scale=1 Then GText(X+(J-1)*CW+1,Y+1,R,Fg) Else GTextBig(X+(J-1)*CW+1,Y+1,
       R,Scale,Fg);
  End;
  If (A And 4)<>0 Then GHLine(X+(J-1)*CW,X+(J-1)*CW+Length(R)*CW-1,Y+CH-2,Fg);
  J:=K+1;
 End;
End;

Procedure EdwDrawClient(Wd_: PWindow);
 Var Dt_: PEditWin;
Var X1,Y1,X2,Y2,CW,CH,VR,VC,I,Y,X,TW,Of_,SX1,SX2,A,B: Integer; S,T: String;
    HX1,HY1,HX2,HY2: Integer; Fg: Integer; CX_: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 If (Dt_^.Mode=3) And Dt_^.RulerOn Then Begin
  { regle }
  GBar(X1,Y1,X2,Y1+23,cLGr);
  GHLine(X1,X2,Y1+23,cDGr);
  GBar(X1+4,Y1+3,X2-SB-4,Y1+14,cWht);GRect(X1+4,Y1+3,X2-SB-4,Y1+14,cBlk);
  For I:=0 To (X2-SB-X1-12) Div 8 Do Begin
   If I Mod 8=0 Then Begin
    GVLine(X1+8+I*8,Y1+4,Y1+13,cBlk);
    GText(X1+11+I*8,Y1+6,IntStr(I Div 8),cBlk);
   End Else If I Mod 4=0 Then GVLine(X1+8+I*8,Y1+7,Y1+13,cBlk)
   Else GVLine(X1+8+I*8,Y1+10,Y1+13,cBlk);
  End;
  A:=1;
  For B:=1 To Dt_^.E.CY-1 Do If EdLine(Dt_^.E,B)=#12 Then Inc(A);
  GText(X1+8,Y1+15,'<'+T3('Page ','Page ',
      'Seite ')+IntStr(A)+'>  '+#24+' '+#24+' '+#24,cBlk);
 End;
 EdwTextRect(Wd_,HX1,HY1,HX2,HY2);
 If Dt_^.Mode=1 Then Begin
  GBar(X1,HY1-6,X2,Y2,cYel);
 End;
 If Dt_^.Mode=3 Then Begin
  Sunken(HX1-1,HY1-1,HX2+1,HY2+1,cWht);
 End Else If Dt_^.Mode=2 Then Sunken(X1,Y1,X2,Y2,cWht)
 Else GBar(HX1-6,HY1-6,HX2+SB,Y2,cYel);
 EdwCellSize(Wd_,CW,CH);
 If Dt_^.Mode=2 Then Begin HX1:=X1+3;HY1:=Y1+3;HX2:=X2-SB-1;HY2:=Y2-3;End;
 If Dt_^.Mode=3 Then Begin Inc(HX1,2);Inc(HY1,2);End;
 VR:=(HY2-HY1+1) Div CH;VC:=(HX2-HX1+1) Div CW;
 If VR<1 Then VR:=1;
 If VC<1 Then VC:=1;
 TW:=VC*CW;
 For I:=Dt_^.E.TopL To Dt_^.E.TopL+VR-1 Do Begin
  If I>Dt_^.E.N Then Begin
   If Dt_^.Mode=1 Then GHLine(HX1,HX2,HY1+(I-Dt_^.E.TopL)*CH+CH-1,cLBl);
  End Else Begin
   Y:=HY1+(I-Dt_^.E.TopL)*CH;
   If Dt_^.Mode=1 Then GHLine(HX1,HX2,Y+CH-1,cLBl);
   S:=Copy(EdLine(Dt_^.E,I),Dt_^.E.LeftC+1,VC);
   X:=HX1+EdwLineOfs(Wd_,I,CW,TW);
   { selection }
   If Dt_^.E.HasSel Then Begin
    EdSelOrder(Dt_^.E,A,B,SX1,SX2);
    { A,B = debut (col,ligne) ; SX1,SX2 = fin (col,ligne) }
    If (I>=B) And (I<=SX2) Then Begin
     HX1:=HX1;
     If I=B Then CX_:=A Else CX_:=0;
     If I=SX2 Then Of_:=SX1 Else Of_:=Length(EdLine(Dt_^.E,I))+1;
     CX_:=Max2(CX_,Dt_^.E.LeftC);Of_:=Min2(Of_,Dt_^.E.LeftC+VC);
     If Of_>CX_ Then GBar(X+(CX_-Dt_^.E.LeftC)*CW,Y,X+(Of_-Dt_^.E.LeftC)*CW-1,
         Y+CH-1,cBlk);
    End;
   End;
   If Dt_^.Mode=1 Then Fg:=cBlu Else Fg:=cBlk;
   If EdLine(Dt_^.E,I)=#12 Then Begin
    GText(X,Y+1,Copy('- - - - - '+T3('Page break','Saut de page',
        'Seitenumbruch')+' - - - - - - - - - - - - - - - - - -',1,VC),cDGr);
   End Else
    EdwDrawStyled(X,Y,S,Copy(EdAttrOf(Dt_^.E,I),Dt_^.E.LeftC+1,VC),Fg,
        Dt_^.Scale,CW,CH);
   If Dt_^.E.HasSel Then Begin
    { relecture en blanc de la partie selectionnee }
    EdSelOrder(Dt_^.E,A,B,SX1,SX2);
    If (I>=B) And (I<=SX2) Then Begin
     If I=B Then CX_:=A Else CX_:=0;
     If I=SX2 Then Of_:=SX1 Else Of_:=Length(EdLine(Dt_^.E,I));
     CX_:=Max2(CX_,Dt_^.E.LeftC);Of_:=Min2(Of_,Dt_^.E.LeftC+VC);
     If Of_>CX_ Then Begin
      T:=Copy(EdLine(Dt_^.E,I),CX_+1,Of_-CX_);
      If T<>#12 Then EdwDrawStyled(X+(CX_-Dt_^.E.LeftC)*CW,Y,T,
          Copy(EdAttrOf(Dt_^.E,I),CX_+1,Of_-CX_),cWht,Dt_^.Scale,CW,CH);
     End;
    End;
   End;
  End;
 End;
 { curseur }
 If Dt_^.CursorOn And (TopWin=Wd_) Then Begin
  If (Dt_^.E.CY>=Dt_^.E.TopL) And (Dt_^.E.CY<Dt_^.E.TopL+VR)
      And (Dt_^.E.CX>=Dt_^.E.LeftC) And (Dt_^.E.CX<=Dt_^.E.LeftC+VC) Then Begin
   X:=HX1+EdwLineOfs(Wd_,Dt_^.E.CY,CW,TW)+(Dt_^.E.CX-Dt_^.E.LeftC)*CW;
   Y:=HY1+(Dt_^.E.CY-Dt_^.E.TopL)*CH;
   GVLine(X,Y,Y+CH-2,cBlk);
   GVLine(X+1,Y,Y+CH-2,cBlk);
  End;
 End;
 { barres de defilement }
 If Dt_^.Mode=2 Then DrawScroll(True,X2-SB+1,Y1,X2,Y2,Dt_^.E.N+VR-1,VR,
     Dt_^.E.TopL-1)
 Else Begin
  If Dt_^.Mode=3 Then DrawScroll(True,X2-SB+1,HY1-3,X2,Y2,Dt_^.E.N+VR-1,VR,
      Dt_^.E.TopL-1)
  Else DrawScroll(True,X2-SB+1,HY1-6,X2,Y2,Dt_^.E.N+VR-1,VR,Dt_^.E.TopL-1);
 End;
End;

Function EdwIdle(Wd_: PWindow): Boolean;
 Var Dt_: PEditWin;
Begin
 Dt_:=Wd_^.Data;
 Inc(Dt_^.Blink);
 If Dt_^.Blink>=5 Then Begin
  Dt_^.Blink:=0;Dt_^.CursorOn:=Not Dt_^.CursorOn;
  EdwIdle:=TopWin=Wd_;
 End Else EdwIdle:=False;
End;

Procedure EdwPrepareMenus(Wd_: PWindow);
 Var Dt_: PEditWin;
Begin
 Dt_:=Wd_^.Data;
 WinSetFlag(Wd_,CM_CUT,1,Not Dt_^.E.HasSel);
 WinSetFlag(Wd_,CM_COPY,1,Not Dt_^.E.HasSel);
 WinSetFlag(Wd_,CM_PASTE,1,ClipN=0);
 WinSetFlag(Wd_,CM_RULER,2,Dt_^.RulerOn);
 WinSetFlag(Wd_,CM_BOLD,2,(Dt_^.E.CurAttr And 1)<>0);
 WinSetFlag(Wd_,CM_ITAL,2,(Dt_^.E.CurAttr And 2)<>0);
 WinSetFlag(Wd_,CM_UNDER,2,(Dt_^.E.CurAttr And 4)<>0);
 WinSetFlag(Wd_,CM_SZ8,2,Dt_^.Scale=1);WinSetFlag(Wd_,CM_SZ12,2,Dt_^.Scale=1);
 WinSetFlag(Wd_,CM_SZ18,2,Dt_^.Scale=2);WinSetFlag(Wd_,CM_SZ24,2,Dt_^.Scale=3);
 WinSetFlag(Wd_,CM_AL_L,2,Dt_^.E.Al[Dt_^.E.CY]=0);
 WinSetFlag(Wd_,CM_AL_C,2,Dt_^.E.Al[Dt_^.E.CY]=1);
 WinSetFlag(Wd_,CM_AL_R,2,Dt_^.E.Al[Dt_^.E.CY]=2);
 WinSetFlag(Wd_,CM_AL_J,2,Dt_^.E.Al[Dt_^.E.CY]=3);
End;

Function EdwCanClose(Wd_: PWindow): Boolean;
 Var Dt_: PEditWin;
Var R: Integer;
Begin
 Dt_:=Wd_^.Data;
 EdwCanClose:=True;
 If Dt_^.E.Modified Then Begin
  R:=MsgBox(T3('Close','Fermer','Schlie'#225'en'),
     T3('Save changes to|','Enregistrer les modifications de|',
         ''#142'nderungen speichern f'#129'r|')+
     ShortName(Dt_^.FName)+'?',T3('Yes|No|Cancel','Oui|Non|Annuler',
         'Ja|Nein|Abbruch'),2);
  If R=3 Then EdwCanClose:=False
  Else If R=1 Then EdwCanClose:=EdwDoSave(Wd_,False);
 End;
End;

Procedure EdwDoOpen(Wd_: PWindow);
 Var Dt_: PEditWin;
Var P: String;
Begin
 Dt_:=Wd_^.Data;
 If Dt_^.E.Modified Then If Not EdwCanClose(Wd_) Then Exit;
 P:=CurDirStr;
 If FileDlg(T3('Open','Ouvrir',#142'ffnen'),'*.*',P,False) Then Begin
  If EdLoad(Dt_^.E,P) Then Begin Dt_^.FName:=P;EdwUpdateTitle(Wd_);End
  Else Info(T3('Error','Erreur','Fehler'),T3('Cannot open file.',
      'Impossible d''ouvrir le fichier.','Datei nicht ladbar.'));
 End;
 Invalidate(Wd_);
End;

Function EdwDoSave(Wd_: PWindow; AsNew: Boolean): Boolean;
 Var Dt_: PEditWin;
Var P: String;
Begin
 Dt_:=Wd_^.Data;
 EdwDoSave:=False;
 P:=Dt_^.FName;
 If AsNew Or (P='') Then Begin
  If P='' Then P:=JoinPath(CurDirStr,'UNTITLED.TXT');
  If Not FileDlg(T3('Save As','Enregistrer sous','Speichern unter'),'*.*',P,
      True) Then Exit;
 End;
 If EdSave(Dt_^.E,P) Then Begin Dt_^.FName:=P;EdwDoSave:=True;
 EdwUpdateTitle(Wd_);End
 Else Info(T3('Error','Erreur','Fehler'),T3('Cannot save file.',
     'Impossible d''enregistrer.','Datei nicht speicherbar.'));
 Invalidate(Wd_);
End;

Procedure EdwDoFind(Wd_: PWindow; Again: Boolean);
 Var Dt_: PEditWin;
Var I,P: Integer; S: String; Fnd: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If (Not Again) Or (Dt_^.LastFind='') Then Begin
  S:=Dt_^.LastFind;
  If Not InputBox(T3('Find','Rechercher','Suchen'),T3('Find what:',
      'Rechercher :','Suchen nach:'),S,60) Then Exit;
  Dt_^.LastFind:=S;
 End;
 If Dt_^.LastFind='' Then Exit;
 Fnd:=False;
 I:=Dt_^.E.CY;
 While (I<=Dt_^.E.N) And Not Fnd Do Begin
  S:=EdLine(Dt_^.E,I);
  If I=Dt_^.E.CY Then Begin
   P:=Pos(Upper(Dt_^.LastFind),Upper(Copy(S,Dt_^.E.CX+2,255)));
   If P>0 Then P:=P+Dt_^.E.CX+1;
  End Else P:=Pos(Upper(Dt_^.LastFind),Upper(S));
  If P>0 Then Begin
   Dt_^.E.SAX:=P-1;Dt_^.E.SAY:=I;Dt_^.E.CX:=P-1+Length(Dt_^.LastFind);
   Dt_^.E.CY:=I;Dt_^.E.HasSel:=True;
   Fnd:=True;
  End;
  Inc(I);
 End;
 If Not Fnd Then Info(T3('Find','Rechercher','Suchen'),T3('Text not found.',
     'Texte introuvable.','Text nicht gefunden.'))
 Else EdwReveal(Wd_);
 Invalidate(Wd_);
End;

Procedure EdwDoPrint(Wd_: PWindow);
 Var Dt_: PEditWin;
Var F: Text; I: Integer; Ok: Boolean;
Begin
 Dt_:=Wd_^.Data;
 {$I-}
 Assign(F,'PRN');
 Rewrite(F);
 Ok:=IOResult=0;
 If Ok Then Begin
  For I:=1 To Dt_^.E.N Do WriteLn(F,EdLine(Dt_^.E,I));
  Close(F);
 End;
 {$I+}
 If IOResult<>0 Then Ok:=False;
 If Not Ok Then Info(T3('Print','Imprimer','Drucken'),
     T3('No printer available.','Aucune imprimante disponible.',
     'Kein Drucker verf'#129'gbar.'));
End;

{ Applique ou retire un attribut sur la selection (ou sur le style de frappe) }
Procedure EdwToggleAttr(Wd_: PWindow; Bit: Integer);
 Var Dt_: PEditWin;
Var X1,Y1,X2,Y2,I,K,A,B: Integer; T: String; All,SetOn: Boolean;
Begin
 Dt_:=Wd_^.Data;
 If Not Dt_^.E.HasSel Then Begin
  If Bit=0 Then Dt_^.E.CurAttr:=0 Else Dt_^.E.CurAttr:=Dt_^.E.CurAttr Xor Bit;
  Invalidate(Wd_);Exit;
 End;
 EdSelOrder(Dt_^.E,X1,Y1,X2,Y2);
 All:=True;
 If Bit<>0 Then
  For I:=Y1 To Y2 Do Begin
   If I=Y1 Then A:=X1 Else A:=0;
   If I=Y2 Then B:=X2 Else B:=Length(EdLine(Dt_^.E,I));
   T:=EdAttrOf(Dt_^.E,I);
   For K:=A+1 To B Do If (Ord(T[K]) And Bit)=0 Then All:=False;
  End;
 SetOn:=Not All;
 For I:=Y1 To Y2 Do Begin
  If I=Y1 Then A:=X1 Else A:=0;
  If I=Y2 Then B:=X2 Else B:=Length(EdLine(Dt_^.E,I));
  T:=EdAttrOf(Dt_^.E,I);
  For K:=A+1 To B Do Begin
   If Bit=0 Then T[K]:=#0
   Else If SetOn Then T[K]:=Chr(Ord(T[K]) Or Bit)
   Else T[K]:=Chr(Ord(T[K]) And (255-Bit));
  End;
  EdSetAttr(Dt_^.E,I,T);
 End;
 Dt_^.E.Modified:=True;
 Invalidate(Wd_);
End;

{ Le style de frappe suit le caractere precedant le curseur }
Procedure EdwSyncAttr(Wd_: PWindow);
 Var Dt_: PEditWin;
Var T: String;
Begin
 Dt_:=Wd_^.Data;
 T:=EdAttrOf(Dt_^.E,Dt_^.E.CY);
 If (Dt_^.E.CX>0) And (Dt_^.E.CX<=Length(T)) Then
     Dt_^.E.CurAttr:=Ord(T[Dt_^.E.CX])
 Else If (Dt_^.E.CX=0) And (Length(T)>0) Then Dt_^.E.CurAttr:=Ord(T[1])
 Else If Length(T)=0 Then Dt_^.E.CurAttr:=0;
End;

{ Palette de caracteres speciaux }
Procedure EdwSpecial(Wd_: PWindow);
 Var Dt_: PEditWin;
Const Chars : String = #131#135#130#138#136#137#133#160#132#129#148#164#225#248+
    #241#253#172#171#174#175#168#173#246#251#158#157#156#155#169#170;
Var R,I,K: Integer; Desc,Lst: String;
Begin
 Dt_:=Wd_^.Data;
 Desc:='a circumflex|c cedilla|e acute|e '+'grave|e circumflex|e diaeresis|a '+
     'grave|a acute|a umlaut|u umlaut|o '+'umlaut|n tilde'+
  '|sharp s|degree|plus-minus|squared|quarter|half|left '+
      'guillemet|right guillemet|inverted '+
      '?|inverted !|divide|square root|peseta|yen|pound|cent|not|'+'not';
 Lst:='';I:=1;
 While (Desc<>'') And (I<=Length(Chars)) Do Begin
  K:=Pos('|',Desc);
  If K=0 Then K:=Length(Desc)+1;
  If Lst<>'' Then Lst:=Lst+'|';
  Lst:=Lst+'('+Chars[I]+')  '+Copy(Desc,1,K-1);
  Delete(Desc,1,K);Inc(I);
 End;
 R:=ChoiceBox(T3('Special Characters','Caract'#138'res sp'#130'ciaux',
     'Sonderzeichen'),T3('Insert:','Ins'#130'rer :','Einf'#129'gen:'),Lst,1);
 If (R>=1) And (R<=Length(Chars)) Then Begin
  EdInsChar(Dt_^.E,Chars[R]);
  EdwReveal(Wd_);Invalidate(Wd_);
 End;
End;

Procedure EdwInsertFile(Wd_: PWindow);
 Var Dt_: PEditWin;
Var P,S: String; F: Text; First: Boolean;
Begin
 Dt_:=Wd_^.Data;
 P:=CurDirStr;
 If Not FileDlg(T3('Insert From File','Ins'#130'rer un fichier',
     'Datei einf'#129'gen'),'*.*',P,False) Then Exit;
 {$I-}
 Assign(F,P);Reset(F);
 {$I+}
 If IOResult<>0 Then Begin Info(T3('Error','Erreur','Fehler'),
     T3('Cannot open file.','Impossible d''ouvrir le fichier.',
     'Datei nicht ladbar.'));Exit;End;
 If Dt_^.E.HasSel Then EdDelSel(Dt_^.E);
 First:=True;
 {$I-}
 While Not Eof(F) Do Begin
  ReadLn(F,S);
  If Not First Then EdNewLine(Dt_^.E);
  First:=False;
  If S=StyMark Then Begin Dt_^.E.Modified:=True;Break;End;
  EdInsText(Dt_^.E,Copy(S,1,MAXLEN));
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 EdwReveal(Wd_);Invalidate(Wd_);
End;

Procedure EdwSaveText(Wd_: PWindow);
 Var Dt_: PEditWin;
Var P: String;
Begin
 Dt_:=Wd_^.Data;
 P:=JoinPath(CurDirStr,'UNTITLED.TXT');
 If Not FileDlg(T3('Save As Text File','Enregistrer en texte',
     'Als Textdatei speichern'),'*.TXT',P,True) Then Exit;
 If EdSaveEx(Dt_^.E,P,False) Then Dt_^.E.Modified:=True
 Else Info(T3('Error','Erreur','Fehler'),T3('Cannot save file.',
     'Impossible d''enregistrer.','Datei nicht speicherbar.'));
End;

Procedure EdwOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PEditWin;
Var D: Word; Y,M,Dd,W: Word; I: Integer;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_NEW: Begin If Not EdwCanClose(Wd_) Then Exit;EdClear(Dt_^.E);
  Dt_^.FName:='';EdwUpdateTitle(Wd_);Invalidate(Wd_);End;
  CM_OPENF: EdwDoOpen(Wd_);
  CM_SAVE: D:=Ord(EdwDoSave(Wd_,False));
  CM_SAVEAS: D:=Ord(EdwDoSave(Wd_,True));
  CM_PRINT: EdwDoPrint(Wd_);
  CM_CUT: If Dt_^.E.HasSel Then Begin EdCopySel(Dt_^.E);EdDelSel(Dt_^.E);
  Invalidate(Wd_);End;
  CM_COPY: EdCopySel(Dt_^.E);
  CM_PASTE: Begin EdPaste(Dt_^.E);EdwReveal(Wd_);Invalidate(Wd_);End;
  CM_SELALL2: Begin EdSelAll(Dt_^.E);Invalidate(Wd_);End;
  CM_FIND: EdwDoFind(Wd_,False);
  CM_FINDNEXT: EdwDoFind(Wd_,True);
  CM_DATE: Begin GetDate(Y,M,Dd,W);EdInsText(Dt_^.E,ShortDateStr(Y,M,Dd));
  EdwReveal(Wd_);Invalidate(Wd_);End;
  CM_AL_L: Begin Dt_^.E.Al[Dt_^.E.CY]:=0;Invalidate(Wd_);End;
  CM_AL_C: Begin Dt_^.E.Al[Dt_^.E.CY]:=1;Invalidate(Wd_);End;
  CM_AL_R: Begin Dt_^.E.Al[Dt_^.E.CY]:=2;Invalidate(Wd_);End;
  CM_AL_J: Begin Dt_^.E.Al[Dt_^.E.CY]:=3;Invalidate(Wd_);End;
  CM_SZ8,CM_SZ12: Begin Dt_^.Scale:=1;Invalidate(Wd_);End;
  CM_SZ18: Begin Dt_^.Scale:=2;Invalidate(Wd_);End;
  CM_SZ24: Begin Dt_^.Scale:=3;Invalidate(Wd_);End;
  CM_BOLD: EdwToggleAttr(Wd_,1);
  CM_ITAL: EdwToggleAttr(Wd_,2);
  CM_UNDER: EdwToggleAttr(Wd_,4);
  CM_PLAIN: Begin
             If Dt_^.E.HasSel Then Begin
              For I:=1 To 1 Do Begin End;
              EdwToggleAttr(Wd_,0);
             End Else Dt_^.E.CurAttr:=0;
            End;
  CM_PGBRK: Begin
             If Dt_^.E.HasSel Then EdDelSel(Dt_^.E);
             If Dt_^.E.CX>0 Then EdNewLine(Dt_^.E);
             EdInsLine(Dt_^.E,Dt_^.E.CY,#12);
             Inc(Dt_^.E.CY);Dt_^.E.CX:=0;Dt_^.E.Modified:=True;
             EdwReveal(Wd_);Invalidate(Wd_);
            End;
  CM_SPECIAL: EdwSpecial(Wd_);
  CM_INSFILE: EdwInsertFile(Wd_);
  CM_SAVETXT: EdwSaveText(Wd_);
  CM_RULER: Begin Dt_^.RulerOn:=Not Dt_^.RulerOn;Invalidate(Wd_);End;
  CM_FONT: Info(T3('Fonts','Polices','Schriften'),
      T3('Only the system font is available in this clone.',
      'Seule la police syst'#138'me est disponible dans ce clone.',
      'In diesem Klon ist nur die Systemschrift verf'#129'gbar.'));
 Else CommonCmd(Wd_,Cmd);
 End;
 EdwUpdateTitle(Wd_);
End;

Procedure EdwOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PEditWin;
Var Shift: Boolean; 
Begin
 Dt_:=Wd_^.Data;
 Dt_^.CursorOn:=True;
 Case K Of
  K_LEFT,K_RIGHT,K_UP,K_DOWN,K_HOME,K_END,K_PGUP,K_PGDN: Begin EdMoveCur(Dt_^.E,
      K,False);EdwSyncAttr(Wd_);End;
  K_ENTER: EdNewLine(Dt_^.E);
  K_BKSP: Begin EdBackspace(Dt_^.E);EdwSyncAttr(Wd_);End;
  K_DEL: EdDelChar(Dt_^.E);
  K_TAB: Begin EdInsChar(Dt_^.E,' ');EdInsChar(Dt_^.E,' ');
  EdInsChar(Dt_^.E,' ');EdInsChar(Dt_^.E,' ');End;
  K_CTRLC: EdCopySel(Dt_^.E);
  K_CTRLX: Begin EdCopySel(Dt_^.E);EdDelSel(Dt_^.E);End;
  K_CTRLV: EdPaste(Dt_^.E);
  K_CTRLA: EdSelAll(Dt_^.E);
  K_CTRLS: Begin EdwOnCommand(Wd_,CM_SAVE);Exit;End;
  K_CTRLN: Begin EdwOnCommand(Wd_,CM_NEW);Exit;End;
  K_CTRLO: Begin EdwOnCommand(Wd_,CM_OPENF);Exit;End;
  K_F3: Begin EdwDoFind(Wd_,True);Exit;End;
  6: Begin EdwDoFind(Wd_,False);Exit;End;
  2: Begin EdwOnCommand(Wd_,CM_BOLD);Exit;End;
 Else
  If (K>=32) And (K<256) Then EdInsChar(Dt_^.E,Chr(K));
 End;
 EdwReveal(Wd_);
 EdwUpdateTitle(Wd_);
 Invalidate(Wd_);
End;

Procedure EdwOnMouse(Wd_: PWindow; Var Ev: TEvent);
 Var Dt_: PEditWin;
Var X1,Y1,X2,Y2,CW,CH,TW,VR,Ln,Cl,P,VC: Integer; CX0,CY0: Integer;

 Procedure SetCaret(MX_,MY_: LongInt);
 Var HX1,HY1,HX2,HY2: Integer;
 Begin
  EdwTextRect(Wd_,HX1,HY1,HX2,HY2);
  If Dt_^.Mode=2 Then Begin HX1:=X1+3;HY1:=Y1+3;End;
  If Dt_^.Mode=3 Then Begin Inc(HX1,2);Inc(HY1,2);End;
  Ln:=Dt_^.E.TopL+(MY_-HY1) Div CH;
  If MY_<HY1 Then Ln:=Dt_^.E.TopL-1;
  Ln:=Clamp(Ln,1,Dt_^.E.N);
  Cl:=Dt_^.E.LeftC+(MX_-HX1-EdwLineOfs(Wd_,Ln,CW,TW)+CW Div 2) Div CW;
  Dt_^.E.CY:=Ln;
  Dt_^.E.CX:=Clamp(Cl,0,Length(EdLine(Dt_^.E,Ln)));
 End;

Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 EdwTextRect(Wd_,CX0,CY0,P,Ln);
 EdwCellSize(Wd_,CW,CH);
 If Dt_^.Mode=2 Then VR:=(Y2-Y1-6) Div CH Else VR:=(Ln-CY0+1) Div CH;
 If VR<1 Then VR:=1;
 VC:=(P-CX0+1) Div CW;
 TW:=VC*CW;
 If Ev.Kind=EV_DOWN Then Begin
  Dt_^.VScrDrag:=False;
  If Ev.X>=X2-SB+1 Then Begin
   P:=ScrollPart(True,X2-SB+1,Y1,X2,Y2,Dt_^.E.N+VR-1,VR,Dt_^.E.TopL-1,Ev.X,
       Ev.Y);
   Case P Of
    1: If Dt_^.E.TopL>1 Then Dec(Dt_^.E.TopL);
    2: If Dt_^.E.TopL<Dt_^.E.N Then Inc(Dt_^.E.TopL);
    3: Dt_^.E.TopL:=Max2(1,Dt_^.E.TopL-VR);
    4: Dt_^.E.TopL:=Min2(Dt_^.E.N,Dt_^.E.TopL+VR);
    5: Begin Dt_^.VScrDrag:=True;ScrollThumb(Y1+SB,Y2-SB,Dt_^.E.N+VR-1,VR,
        Dt_^.E.TopL-1,Cl,Ln);Dt_^.VGrab:=Ev.Y-Cl;End;
   End;
   Invalidate(Wd_);
   Exit;
  End;
  If (Dt_^.Mode=3) And Dt_^.RulerOn And (Ev.Y<Y1+24) Then Exit;
  SetCaret(Ev.X,Ev.Y);
  Dt_^.E.HasSel:=False;Dt_^.E.SAX:=Dt_^.E.CX;Dt_^.E.SAY:=Dt_^.E.CY;
  Dt_^.Selecting:=True;
  EdwSyncAttr(Wd_);
  Dt_^.CursorOn:=True;
  Invalidate(Wd_);
 End Else If Ev.Kind=EV_MOVE Then Begin
  If Dt_^.VScrDrag Then Begin
   Dt_^.E.TopL:=1+ScrollDrag(True,X2-SB+1,Y1,X2,Y2,Dt_^.E.N+VR-1,VR,Ev.Y,
       Dt_^.VGrab);
   If Dt_^.E.TopL>Dt_^.E.N Then Dt_^.E.TopL:=Dt_^.E.N;
   Invalidate(Wd_);
  End Else If Dt_^.Selecting Then Begin
   SetCaret(Ev.X,Ev.Y);
   Dt_^.E.HasSel:=(Dt_^.E.CX<>Dt_^.E.SAX) Or (Dt_^.E.CY<>Dt_^.E.SAY);
   EdwReveal(Wd_);
   Invalidate(Wd_);
  End;
 End Else If Ev.Kind=EV_UP Then Begin
  Dt_^.Selecting:=False;Dt_^.VScrDrag:=False;
 End;
End;

