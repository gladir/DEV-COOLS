Procedure BanDrawClient(Wd_: PWindow);
 Var Dt_: PBanner;
Var X1,Y1,X2,Y2,S,TW,TH: Integer;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 GText(X1+8,Y1+8,T3('Banner text:','Texte de la banni'#138're :','Bannertext:'),
     cBlk);
 Sunken(X1+8,Y1+20,X2-8,Y1+42,cWht);
 GText(X1+12,Y1+27,Dt_^.Txt+'_',cBlk);
 Sunken(X1+8,Y1+50,X2-8,Y2-8,cWht);
 S:=Dt_^.Sz;
 TW:=Length(Dt_^.Txt)*8*S;
 While (S>1) And (TW>X2-X1-40) Do Begin Dec(S);TW:=Length(Dt_^.Txt)*8*S;End;
 TH:=8*S;
 If Dt_^.Box Then GRect(X1+14,Y1+56,X2-14,Y2-14,cBlk);
 GTextBig((X1+X2-TW) Div 2,(Y1+50+Y2-8-TH) Div 2,Dt_^.Txt,S,Dt_^.Col);
 GTextBig((X1+X2-TW) Div 2+1,(Y1+50+Y2-8-TH) Div 2,Dt_^.Txt,S,Dt_^.Col);
End;

Procedure BanOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PBanner;
Begin
 Dt_:=Wd_^.Data;
 If K=K_BKSP Then Begin If Dt_^.Txt<>'' Then Delete(Dt_^.Txt,Length(Dt_^.Txt),
     1);End
 Else If (K>=32) And (K<256) And (Length(Dt_^.Txt)<30) Then
     Dt_^.Txt:=Dt_^.Txt+Chr(K);
 Invalidate(Wd_);
End;

Procedure BanOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PBanner;
Var R: Integer;
Begin
 Dt_:=Wd_^.Data;
 Case Cmd Of
  CM_BSZ1: Dt_^.Sz:=2;
  CM_BSZ2: Dt_^.Sz:=4;
  CM_BSZ3: Dt_^.Sz:=6;
  CM_BSZ4: Dt_^.Sz:=8;
  CM_BCOL: Begin R:=ChoiceBox(T3('Color','Couleur','Farbe'),T3('Text color:',
      'Couleur du texte :','Textfarbe:'),ColorList,Dt_^.Col+1);
  If R>0 Then Dt_^.Col:=R-1;End;
  CM_BBOX: Dt_^.Box:=Not Dt_^.Box;
  CM_PRINT: Info('GeoBanner',T3('No printer available.',
      'Aucune imprimante disponible.','Kein Drucker verf'#129'gbar.'));
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

