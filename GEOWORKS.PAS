Procedure ResClear;
Begin
 FillChar(GbRes,SizeOf(GbRes),0);
End;

Procedure ResSave(Const Path: String);
Var T: Text; I,J,K,Y,X: Integer; S: String;
Begin
 Assign(T,Path);
 {$I-}Rewrite(T);{$I+}
 If IOResult<>0 Then Exit;
 WriteLn(T,'GBRES1');
 For I:=1 To GbRes.NM Do Begin
  WriteLn(T,'MENU|',GbRes.M[I].Name,'|',GbRes.M[I].NSub);
  For J:=1 To GbRes.M[I].NSub Do Begin
   WriteLn(T,'SUB|',GbRes.M[I].SubT[J],'|',GbRes.M[I].NIt[J]);
   For K:=1 To GbRes.M[I].NIt[J] Do WriteLn(T,'ITEM|',GbRes.M[I].It[J,K].Txt,
       '|',GbRes.M[I].It[J,K].Tg);
  End;
 End;
 For I:=1 To GbRes.NI Do Begin
  WriteLn(T,'ICONS|',GbRes.I[I].Name,'|',GbRes.I[I].N);
  For J:=1 To GbRes.I[I].N Do
   WriteLn(T,'ICON|',GbRes.I[I].Ic[J].X,'|',GbRes.I[I].Ic[J].Y,'|',
       GbRes.I[I].Ic[J].Bmp,'|',GbRes.I[I].Ic[J].Tg);
 End;
 For I:=1 To GbRes.ND Do Begin
  WriteLn(T,'DLG|',GbRes.D[I].Name,'|',GbRes.D[I].N);
  For J:=1 To GbRes.D[I].N Do
   WriteLn(T,'DITEM|',GbRes.D[I].It[J].K,'|',GbRes.D[I].It[J].X,'|',
       GbRes.D[I].It[J].Y,'|',GbRes.D[I].It[J].Txt);
 End;
 For I:=1 To GbRes.NB Do Begin
  WriteLn(T,'BMP|',GbRes.B[I].Name,'|',GbRes.B[I].W,'|',GbRes.B[I].H);
  For Y:=0 To GbRes.B[I].H-1 Do Begin
   S:='';For X:=0 To GbRes.B[I].W-1 Do S:=S+Chr(48+GbRes.B[I].D[Y,X]);
   WriteLn(T,'ROW|',S);
  End;
 End;
 WriteLn(T,'END');
 Close(T);
End;

Function ResPart(Var S: String): String;
Var P: Integer;
Begin
 P:=Pos('|',S);
 If P=0 Then Begin ResPart:=S;S:='';End
 Else Begin ResPart:=Copy(S,1,P-1);Delete(S,1,P);End;
End;

Function ResLoad(Const Path: String): Boolean;
Var T: Text; S,K: String; M,SB,Ic,Dl,Bm,Row,I: Integer;
Begin
 ResLoad:=False;
 If Not FileExists(Path) Then Exit;
 Assign(T,Path);
 {$I-}Reset(T);{$I+}
 If IOResult<>0 Then Exit;
 ReadLn(T,S);
 If S<>'GBRES1' Then Begin Close(T);Exit;End;
 ResClear;M:=0;SB:=0;Ic:=0;Dl:=0;Bm:=0;Row:=0;
 While Not Eof(T) Do Begin
  ReadLn(T,S);K:=ResPart(S);
  If K='MENU' Then Begin
   If GbRes.NM<8 Then Begin Inc(GbRes.NM);M:=GbRes.NM;
   GbRes.M[M].Name:=Copy(ResPart(S),1,6);
   GbRes.M[M].NSub:=Min2(8,StrVal(ResPart(S),0));SB:=0;End;
  End Else If K='SUB' Then Begin
   If (M>0) And (SB<8) Then Begin Inc(SB);
   GbRes.M[M].SubT[SB]:=Copy(ResPart(S),1,12);
   GbRes.M[M].NIt[SB]:=Min2(12,StrVal(ResPart(S),0));I:=0;End;
  End Else If K='ITEM' Then Begin
   If (M>0) And (SB>0) And (I<12) Then Begin Inc(I);
   GbRes.M[M].It[SB,I].Txt:=Copy(ResPart(S),1,24);
   GbRes.M[M].It[SB,I].Tg:=Copy(ResPart(S),1,14);End;
  End Else If K='ICONS' Then Begin
   If GbRes.NI<8 Then Begin Inc(GbRes.NI);Ic:=GbRes.NI;
   GbRes.I[Ic].Name:=Copy(ResPart(S),1,6);GbRes.I[Ic].N:=0;End;
  End Else If K='ICON' Then Begin
   If (Ic>0) And (GbRes.I[Ic].N<31) Then Begin
    Inc(GbRes.I[Ic].N);
    GbRes.I[Ic].Ic[GbRes.I[Ic].N].X:=StrVal(ResPart(S),0);
    GbRes.I[Ic].Ic[GbRes.I[Ic].N].Y:=StrVal(ResPart(S),0);
    GbRes.I[Ic].Ic[GbRes.I[Ic].N].Bmp:=Copy(ResPart(S),1,6);
    GbRes.I[Ic].Ic[GbRes.I[Ic].N].Tg:=Copy(ResPart(S),1,14);
   End;
  End Else If K='DLG' Then Begin
   If GbRes.ND<8 Then Begin Inc(GbRes.ND);Dl:=GbRes.ND;
   GbRes.D[Dl].Name:=Copy(ResPart(S),1,6);GbRes.D[Dl].N:=0;End;
  End Else If K='DITEM' Then Begin
   If (Dl>0) And (GbRes.D[Dl].N<12) Then Begin
    Inc(GbRes.D[Dl].N);
    GbRes.D[Dl].It[GbRes.D[Dl].N].K:=StrVal(ResPart(S),1);
    GbRes.D[Dl].It[GbRes.D[Dl].N].X:=StrVal(ResPart(S),0);
    GbRes.D[Dl].It[GbRes.D[Dl].N].Y:=StrVal(ResPart(S),0);
    GbRes.D[Dl].It[GbRes.D[Dl].N].Txt:=Copy(S,1,40);
   End;
  End Else If K='BMP' Then Begin
   If GbRes.NB<12 Then Begin
    Inc(GbRes.NB);Bm:=GbRes.NB;GbRes.B[Bm].Name:=Copy(ResPart(S),1,6);
    GbRes.B[Bm].W:=Min2(24,StrVal(ResPart(S),8));
    GbRes.B[Bm].H:=Min2(24,StrVal(ResPart(S),8));Row:=0;
   End;
  End Else If K='ROW' Then Begin
   If (Bm>0) And (Row<GbRes.B[Bm].H) Then Begin
    For I:=1 To Min2(24,Length(S)) Do GbRes.B[Bm].D[Row,I-1]:=Ord(S[I])-48;
    Inc(Row);
   End;
  End;
 End;
 Close(T);
 ResLoad:=True;
End;

{ numero de ligne BASIC en tete d'une ligne de source (-1 si absent) }
Function BLineNo(Const S: String): LongInt;
Var P: Integer; N: LongInt;
Begin
 P:=1;While (P<=Length(S)) And (S[P]=' ') Do Inc(P);
 If (P>Length(S)) Or Not (S[P] In ['0'..'9']) Then Begin BLineNo:=-1;Exit;End;
 N:=0;
 While (P<=Length(S)) And (S[P] In ['0'..'9']) And (N<100000) Do Begin
     N:=N*10+Ord(S[P])-48;Inc(P);End;
 BLineNo:=N;
End;

{ charge un programme .BAS (texte) dans une structure TBas }
Function BasLoad(Const Path: String): PBas;
Var T: Text; B: PBas; S: String; P: Integer;
Begin
 BasLoad:=Nil;
 Assign(T,Path);
 {$I-}Reset(T);{$I+}
 If IOResult<>0 Then Exit;
 B:=BNewBas;
 While (Not Eof(T)) And (B^.NL<BMAXL) Do Begin
  ReadLn(T,S);
  Inc(B^.NL);B^.Src[B^.NL]:=NewStr(S);
  B^.LNo[B^.NL]:=BLineNo(S);
 End;
 Close(T);
 If B^.NL=0 Then Begin Inc(B^.NL);B^.Src[1]:=NewStr('REM');B^.LNo[1]:=-1;End;
 BasLoad:=B;
End;

{ ====================================================================== }
{   SCREEN DUMPER : capture de l'ecran ou d'une fenetre (BMP ou PCX)       }
{ ====================================================================== }

Const
 CM_SDCAP=1300; CM_SDFMT=1301; CM_SDDLY=1302; CM_SDAREA=1303; CM_SDNAME=1304;
 DumpPal : Array[0..15,0..2] Of Byte = (
  (0,0,0),(0,0,170),(0,170,0),(0,170,170),(170,0,0),(170,0,170),(170,85,0),(170,
      170,170),
  (85,85,85),(85,85,255),(85,255,85),(85,255,255),(255,85,85),(255,85,255),(255,
      255,85),(255,255,255));

Type
 PDump = ^TDump;
 TDump = Record
  Fmt   : Integer;         { 0 BMP, 1 PCX }
  Delay : Integer;         { secondes }
  Area  : Integer;         { 0 ecran entier, 1 fenetre sous l'outil }
  FName : String;
  Msg   : String;
  MsgErr: Boolean;
  Down  : Integer;
 End;

Function DumpNew(AX,AY: Integer): PWindow; Forward;
Procedure DumpDrawClient(Wd_: PWindow); Forward;
Procedure DumpOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure DumpOnKey(Wd_: PWindow; K: Word); Forward;
Procedure DumpOnCommand(Wd_: PWindow; Cmd: Integer); Forward;

Function DumpNextName(Fmt: Integer): String;
Var I: Integer; S,E: String;
Begin
 If Fmt=0 Then E:='.BMP' Else E:='.PCX';
 I:=0;
 Repeat
  S:=JoinPath(HomeDir,'SCREEN'+Pad2(I)+E);
  Inc(I);
 Until (Not FileExists(S)) Or (I>99);
 DumpNextName:=S;
End;

{ Ecrit un BMP 16 couleurs (4 bits) ; Pix contient W*H indices de couleur }
Function DumpWriteBmp(Const P: String; Pix: PByteArr; W,H: Integer): Boolean;
Var F: File; Hd: Array[0..117] Of Byte; Row: Array[0..399] Of Byte;
Y,X,RB,I: Integer; Sz: LongInt; Ok: Boolean;
Begin
 DumpWriteBmp:=False;
 RB:=((W+1) Div 2+3) And (Not 3);
 Sz:=118+LongInt(RB)*H;
 FillChar(Hd,SizeOf(Hd),0);
 Hd[0]:=Ord('B');Hd[1]:=Ord('M');
 Hd[2]:=Sz And 255;Hd[3]:=(Sz Shr 8) And 255;Hd[4]:=(Sz Shr 16) And 255;
 Hd[5]:=(Sz Shr 24) And 255;
 Hd[10]:=118;
 Hd[14]:=40;
 Hd[18]:=W And 255;Hd[19]:=W Shr 8;Hd[22]:=H And 255;Hd[23]:=H Shr 8;
 Hd[26]:=1;Hd[28]:=4;
 Hd[34]:=(LongInt(RB)*H) And 255;Hd[35]:=((LongInt(RB)*H) Shr 8) And 255;
 Hd[36]:=((LongInt(RB)*H) Shr 16) And 255;
 Hd[46]:=16;
 For I:=0 To 15 Do Begin
  Hd[54+I*4]:=DumpPal[I,2];Hd[55+I*4]:=DumpPal[I,1];Hd[56+I*4]:=DumpPal[I,0];
 End;
 {$I-}
 Assign(F,P);FileMode:=2;Rewrite(F,1);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 BlockWrite(F,Hd,118);
 Ok:=IOResult=0;
 For Y:=H-1 DownTo 0 Do Begin
  FillChar(Row,RB,0);
  For X:=0 To W-1 Do
   If Odd(X) Then Row[X Div 2]:=Row[X Div 2] Or (Pix^[Y*W+X] And 15)
   Else Row[X Div 2]:=(Pix^[Y*W+X] And 15) Shl 4;
  BlockWrite(F,Row,RB);
  If IOResult<>0 Then Ok:=False;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Ok:=False;
 DumpWriteBmp:=Ok;
End;

{ Ecrit un PCX 16 couleurs (4 plans, RLE) }
Function DumpWritePcx(Const P: String; Pix: PByteArr; W,H: Integer): Boolean;
Var F: File; Hd: Array[0..127] Of Byte; Y,X,Pl,I,BPL,N: Integer;
Line: Array[0..99] Of Byte; Out: Array[0..799] Of Byte;
    Cnt: Integer; Ok: Boolean; B,Prev: Byte; Have: Boolean;

 Procedure Emit(V: Byte);
 Begin
  Out[N]:=V;Inc(N);
 End;
 Procedure Flush;
 Begin
  If Have Then Begin
   If (Cnt>1) Or (Prev>=$C0) Then Begin Emit($C0+Cnt);Emit(Prev);
   End Else Emit(Prev);
  End;
 End;

Begin
 DumpWritePcx:=False;
 BPL:=(W+7) Div 8;
 If Odd(BPL) Then Inc(BPL);
 FillChar(Hd,SizeOf(Hd),0);
 Hd[0]:=10;Hd[1]:=5;Hd[2]:=1;Hd[3]:=1;
 Hd[8]:=(W-1) And 255;Hd[9]:=(W-1) Shr 8;Hd[10]:=(H-1) And 255;
 Hd[11]:=(H-1) Shr 8;
 Hd[12]:=96;Hd[14]:=96;
 For I:=0 To 15 Do Begin Hd[16+I*3]:=DumpPal[I,0];Hd[17+I*3]:=DumpPal[I,1];
 Hd[18+I*3]:=DumpPal[I,2];End;
 Hd[65]:=4;Hd[66]:=BPL And 255;Hd[67]:=BPL Shr 8;Hd[68]:=1;
 {$I-}
 Assign(F,P);FileMode:=2;Rewrite(F,1);
 BlockWrite(F,Hd,128);
 {$I+}
 If IOResult<>0 Then Exit;
 Ok:=True;
 For Y:=0 To H-1 Do Begin
  N:=0;Have:=False;Cnt:=0;Prev:=0;
  For Pl:=0 To 3 Do Begin
   FillChar(Line,SizeOf(Line),0);
   For X:=0 To W-1 Do
    If (Pix^[Y*W+X] And (1 Shl Pl))<>0 Then Line[X Div 8]:=Line[X Div 8] Or ($80
        Shr (X Mod 8));
   For I:=0 To BPL-1 Do Begin
    B:=Line[I];
    If Have And (B=Prev) And (Cnt<63) Then Inc(Cnt)
    Else Begin Flush;Prev:=B;Cnt:=1;Have:=True;End;
   End;
   Flush;Have:=False;Cnt:=0;
  End;
  {$I-}
  BlockWrite(F,Out,N);
  {$I+}
  If IOResult<>0 Then Ok:=False;
 End;
 {$I-}
 Close(F);
 {$I+}
 If IOResult<>0 Then Ok:=False;
 DumpWritePcx:=Ok;
End;

Procedure DumpCapture(Wd_: PWindow);
 Var Dt_: PDump;
Var I,K,X0,Y0,X1,Y1,W,H,X,Y,Sx: Integer; Pix: PByteArr; P: String; Ok: Boolean;
T: LongInt;
Begin
 Dt_:=Wd_^.Data;
 { fenetre cible : celle qui est sous l'outil }
 X0:=0;Y0:=0;X1:=SCR_W-1;Y1:=SCR_H-1;
 If Dt_^.Area=1 Then Begin
  K:=0;
  For I:=1 To NWins Do If Wins[I]=Wd_ Then K:=I;
  If K>1 Then Begin
   X0:=Max2(0,Wins[K-1]^.WinX);Y0:=Max2(0,Wins[K-1]^.WinY);
   X1:=Min2(SCR_W-1,Wins[K-1]^.WinX+Wins[K-1]^.WinW-1);
   Y1:=Min2(SCR_H-1,Wins[K-1]^.WinY+Wins[K-1]^.WinH-1);
  End;
 End;
 W:=X1-X0+1;H:=Y1-Y0+1;
 GetMem(Pix,W*H);
 Sx:=Wd_^.WinX;
 If Dt_^.Delay>0 Then Begin
  T:=NowCs;
  While (NowCs>=T) And (NowCs-T<Dt_^.Delay*100) Do Begin Delay(20);End;
 End;
 { masque l'outil le temps de la capture }
 Wd_^.WinX:=SCR_W+100;
 NeedFull:=True;FlushPaint;
 HideMouse;ClipFull;
 For Y:=0 To H-1 Do
  For X:=0 To W-1 Do Pix^[Y*W+X]:=GetPixel(X0+X,Y0+Y);
 Wd_^.WinX:=Sx;
 NeedFull:=True;FlushPaint;
 ShowMouse;
 P:=Dt_^.FName;
 If P='' Then P:=DumpNextName(Dt_^.Fmt);
 If Dt_^.Fmt=0 Then Ok:=DumpWriteBmp(P,Pix,W,H) Else Ok:=DumpWritePcx(P,Pix,W,
     H);
 FreeMem(Pix,W*H);
 Dt_^.MsgErr:=Not Ok;
 If Ok Then Dt_^.Msg:=T3('Saved: ','Enregistr'#130' : ',
     'Gespeichert: ')+ShortName(P)+' ('+IntStr(W)+'x'+IntStr(H)+')'
 Else Dt_^.Msg:=T3('Cannot write the file.',
     'Impossible d'''#130'crire le fichier.','Datei nicht schreibbar.');
 If SoundOn And Ok Then Begin Sound(1200);Delay(60);NoSound;End;
End;

Function DumpNew(AX,AY: Integer): PWindow;
 Var Wd_: PWindow; Dt_: PDump;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_DUMP,AX,AY,380,236,'Screen Dumper');
 Wd_^.IconId:=IC_COLORS;Wd_^.Resizable:=False;
 Dt_^.Delay:=3;Dt_^.Down:=-1;
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'Capture~Capturer~Aufnehmen',CM_SDCAP,'Enter');
 WinAddItem(Wd_,'File Name...~Nom du fichier...~Dateiname...',CM_SDNAME,'');
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Options~Options~Optionen');
 WinAddItem(Wd_,'Area~Zone~Bereich',CM_SDAREA,'');
 WinAddItem(Wd_,'Delay~D'#130'lai~Verz'#148'gerung',CM_SDDLY,'');
 WinAddItem(Wd_,'Format~Format~Format',CM_SDFMT,'');
 DumpNew:=Wd_;
End;

Procedure DumpRows(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
Var CX1,CY1,CX2,CY2: Integer;
Begin
 WinClientRect(Wd_,CX1,CY1,CX2,CY2);
 X1:=CX1+150;Y1:=CY1+14+I*30;X2:=CX2-14;Y2:=Y1+22;
End;

Procedure DumpDrawClient(Wd_: PWindow);
 Var Dt_: PDump;
Var X1,Y1,X2,Y2,I,A,B,C,D: Integer; S: String;
Begin
 Dt_:=Wd_^.Data;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 For I:=0 To 3 Do Begin
  DumpRows(Wd_,I,A,B,C,D);
  Case I Of
   0: Begin GText(X1+14,B+7,T3('Area:','Zone :','Bereich:'),cBlk);
       If Dt_^.Area=0 Then S:=T3('Entire screen','Ecran entier',
           'Ganzer Bildschirm') Else S:=T3('Window below',
           'Fen'#136'tre dessous','Fenster darunter');End;
   1: Begin GText(X1+14,B+7,T3('Delay:','D'#130'lai :','Verz'#148'gerung:'),
       cBlk);S:=IntStr(Dt_^.Delay)+' s';End;
   2: Begin GText(X1+14,B+7,'Format:',cBlk);
   If Dt_^.Fmt=0 Then S:='BMP (16 colors)' Else S:='PCX (16 colors)';End;
   3: Begin GText(X1+14,B+7,T3('File:','Fichier :','Datei:'),cBlk);
       If Dt_^.FName='' Then S:=T3('SCREENnn (auto)','SCREENnn (auto)',
           'SCREENnn (auto)') Else S:=ShortName(Dt_^.FName);End;
  End;
  Button(A,B,C,D,Copy(S,1,(C-A) Div 8-1),False,Dt_^.Down=I,True);
 End;
 DumpRows(Wd_,4,A,B,C,D);
 Button(X1+14,B,X1+170,B+24,T3('Capture','Capturer','Aufnehmen'),True,
     Dt_^.Down=4,True);
 If Dt_^.Msg<>'' Then Begin
  If Dt_^.MsgErr Then I:=cRed Else I:=cGrn;
  GText(X1+14,Y2-18,Copy(Dt_^.Msg,1,(X2-X1-28) Div 8),I);
 End;
End;

Procedure DumpAction(Wd_: PWindow; I: Integer);
 Var Dt_: PDump;
Var S: String;
Begin
 Dt_:=Wd_^.Data;
 Case I Of
  0: Dt_^.Area:=1-Dt_^.Area;
  1: Begin
      Case Dt_^.Delay Of 0: Dt_^.Delay:=3; 3: Dt_^.Delay:=5; 5: Dt_^.Delay:=10;
      Else Dt_^.Delay:=0; End;
     End;
  2: Begin Dt_^.Fmt:=1-Dt_^.Fmt;If Dt_^.FName<>'' Then Dt_^.FName:='';End;
  3: Begin
      S:=Dt_^.FName;
      If S='' Then S:=DumpNextName(Dt_^.Fmt);
      If InputBox(T3('File Name','Nom du fichier','Dateiname'),
          T3('Save screen to:','Enregistrer l''image dans :',
          'Bild speichern in:'),S,70) Then Dt_^.FName:=S;
     End;
  4: DumpCapture(Wd_);
 End;
End;

Procedure DumpOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PDump;
Var I,A,B,C,D,X1,Y1,X2,Y2: Integer;
Begin
 Dt_:=Wd_^.Data;
 If E.Kind=EV_DOWN Then Begin
  For I:=0 To 3 Do Begin
   DumpRows(Wd_,I,A,B,C,D);
   If InBox(E.X,E.Y,A,B,C,D) Then Dt_^.Down:=I;
  End;
  WinClientRect(Wd_,X1,Y1,X2,Y2);
  DumpRows(Wd_,4,A,B,C,D);
  If InBox(E.X,E.Y,X1+14,B,X1+170,B+24) Then Dt_^.Down:=4;
  Invalidate(Wd_);
 End Else If E.Kind=EV_UP Then Begin
  If Dt_^.Down>=0 Then Begin
   I:=Dt_^.Down;Dt_^.Down:=-1;
   WinClientRect(Wd_,X1,Y1,X2,Y2);
   If I<4 Then DumpRows(Wd_,I,A,B,C,D) Else Begin DumpRows(Wd_,4,A,B,C,D);
   C:=X1+170;A:=X1+14;D:=B+24;End;
   If InBox(E.X,E.Y,A,B,C,D) Then DumpAction(Wd_,I);
   Invalidate(Wd_);
  End;
 End;
End;

Procedure DumpOnKey(Wd_: PWindow; K: Word);
Begin
 If K=K_ENTER Then DumpAction(Wd_,4);
End;

Procedure DumpOnCommand(Wd_: PWindow; Cmd: Integer);
Begin
 Case Cmd Of
  CM_SDCAP: DumpAction(Wd_,4);
  CM_SDAREA: DumpAction(Wd_,0);
  CM_SDDLY: DumpAction(Wd_,1);
  CM_SDFMT: DumpAction(Wd_,2);
  CM_SDNAME: DumpAction(Wd_,3);
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

