 Wd_^.IconId:=IC_GEOMGR;
 Wd_^.MinW:=300;Wd_^.MinH:=200;
 GetMem(Dt_^.Ents,SizeOf(TEntArr));
 Dt_^.NE:=0;Dt_^.Top:=0;Dt_^.ViewMode:=0;LargeView:=False;Dt_^.SortMode:=0;
 Dt_^.ShowHid:=False;Dt_^.ConfirmDel:=True;
 Dt_^.Cur:=-1;Dt_^.DragEnt:=-1;Dt_^.Dragging:=False;Dt_^.SBDrag:=False;
 Dt_^.Cols:=4;
 Dt_^.Path:=APath;
 MgrBuildMenus(Wd_);
 MgrScan(Wd_);
 MgrNew:=Wd_;
End;

