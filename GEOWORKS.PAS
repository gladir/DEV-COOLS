{ Composition d'un numero : tonalites DTMF approximees et commande Hayes }
Procedure DexDialNumber(Const Name,Phone: String);
Var Digits,Cmd: String; I: Integer;
Begin
 Digits:='';
 For I:=1 To Length(Phone) Do
  If Phone[I] In ['0'..'9','*','#',','] Then Digits:=Digits+Phone[I];
 If Digits='' Then Begin
  Info(T3('Dial','Composer','W'#132'hlen'),T3('This card has no phone number.',
      'Cette fiche n''a pas de num'#130'ro.','Diese Karte hat keine Nummer.'));
  Exit;
 End;
 If ModemTone Then Cmd:='ATDT'+Digits Else Cmd:='ATDP'+Digits;
 If SoundOn And ModemTone Then
  For I:=1 To Length(Digits) Do
   If Digits[I] In ['0'..'9'] Then Begin
    Sound(697+(Ord(Digits[I])-48)*60);Delay(90);NoSound;Delay(40);
   End;
 Info(T3('Dial','Composer','W'#132'hlen'),
     Name+'|'+Phone+'|'+'COM'+IntStr(ModemPort)+' '+IntStr(BaudTab[ModemBaud])+
     ' bps|'+Cmd+'|'+
      T3('Pick up the phone, press OK.','D'#130'crochez, puis appuyez sur OK.',
          'H'#148'rer abnehmen, dann OK.'));
End;

Procedure DexQuickDial(Wd_: PWindow);
 Var Dt_: PDex;
Var I,N,R: Integer; L: String; Map: Array[1..40] Of Integer;
Begin
 Dt_:=Wd_^.Data;
 L:='';N:=0;
 For I:=1 To Dt_^.NC Do
  If (Dt_^.C[I].F[4]<>'') And (N<40) Then Begin
   Inc(N);Map[N]:=I;
   If L<>'' Then L:=L+'|';
   L:=L+Copy(Dt_^.C[I].F[1],1,18)+' '+Copy(Dt_^.C[I].F[4],1,18);
  End;
 If N=0 Then Begin Info('GeoDex',T3('No phone numbers.','Aucun num'#130'ro.',
     'Keine Nummern.'));Exit;End;
 R:=ChoiceBox(T3('Quick Dial','Num'#130'rotation rapide','Kurzwahl'),
     T3('Select a number:','Choisissez un num'#130'ro :','Nummer w'#132'hlen:'),
     L,1);
 If R>0 Then Begin
  Dt_^.Cur:=Map[R];
  DexDialNumber(Dt_^.C[Map[R]].F[1],Dt_^.C[Map[R]].F[4]);
 End;
End;

