  $8E,$8F,$80,$90,$A5,$99,$9A,$A0,$85,$83,$84,$20,$86,$87,$82,$8A,
  $88,$89,$A1,$8D,$8C,$8B,$A4,$A2,$95,$93,$94,$20,$A3,$97,$96,$81,
