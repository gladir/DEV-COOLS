 CommPutLine(Wd_,T3('Type AT commands. ATZ resets, ATD dials.',
     'Tapez des commandes AT. ATZ r'#130'initialise, ATD compose.',
     'AT-Befehle eingeben. ATZ setzt zur'#129'ck, ATD w'#132'hlt.'));
 CommPutLine(Wd_,'');
