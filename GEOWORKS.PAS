 CM_STIMED=416;
 CM_GNEW=400; CM_GPAUSE=401; CM_DRAW1=402; CM_DRAW3=403; CM_GHELP=404;
 CM_UNDO=405;
 TCELL = 14;
 CM_TPREV=420; CM_TLINES=421; CM_THIGH=422; CM_TSAVE=423;

Const
 PieceTxt : Array[1..7] Of String[16] = (
  '....####........', '.##..##.........', '.#..###.........',
      '.##.##..........',
  '##...##.........', '#...###.........', '..#.###.........');
 PieceCol : Array[1..7] Of Integer = (cLCy,cYel,cLMg,cLGn,cLRd,cLBl,cBrn);

