Procedure CommonCmd(W: PWindow; Cmd: Integer);
Begin
 Case Cmd Of
  CM_CLOSE: If WinCanClose(W) Then W^.Dead:=True;
  CM_MINIMIZE: MinimizeWin(W);
  CM_MAXIMIZE: If W^.Maxim Then RestoreWin(W) Else MaximizeWin(W);
  CM_RESTORE: RestoreWin(W);
  CM_MOVE: If Not W^.Maxim Then Begin
            MX:=W^.WinX+W^.WinW Div 2;MY:=W^.WinY+9;
            DragWindow(W,MX,MY);
           End;
  CM_SIZE: If W^.Resizable And Not W^.Maxim Then SizeWindow(W,10,W^.WinX+W^.WinW-3,W^.WinY+W^.WinH-3);
  CM_TILE: ArrangeTile;
  CM_OVERLAP: ArrangeOverlap;
  CM_NEXTWIN: NextWindow;
  CM_ABOUT: AboutBox;
  CM_HELP: Info('Help',T3('Click an icon twice to open it.|Use the menus of each window.',
              'Cliquez deux fois sur une ic'#147'ne pour l''ouvrir.|Utilisez les menus de chaque fen'#136'tre.',
              'Doppelklick auf ein Symbol '#148'ffnet es.|Benutzen Sie die Men'#129's der Fenster.'));
  CM_NEWMGR: LaunchApp(A_MANAGER,'');
  CM_EXITWEL: ExitDesk:=1;
  CM_QUIT: If Confirm(T3('Exit','Quitter','Beenden'),
            T3('Return to the Welcome screen?','Retourner '#133' l''accueil ?','Zur'#129'ck zum Willkommen-Bildschirm?')) Then ExitDesk:=1;
 End;
End;

