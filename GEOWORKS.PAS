Function FileExists(Const N: String): Boolean;
Var F: File;
Begin
 {$I-}
 Assign(F,N);
 Reset(F,1);
 {$I+}
 If IOResult=0 Then Begin Close(F);FileExists:=True;End Else FileExists:=False;
End;

Function DirExists(Const N: String): Boolean;
Var SR: SearchRec; D: String;
Begin
 D:=N;
 While (Length(D)>1) And ((D[Length(D)]='\') Or (D[Length(D)]='/')) Do
  Delete(D,Length(D),1);
 If (D='') Or (D='.') Then Begin DirExists:=True;Exit;End;
 If (Length(D)=2) And (D[2]=':') Then Begin DirExists:=True;Exit;End;
 If (Length(D)=1) And ((D='\') Or (D='/')) Then Begin DirExists:=True;Exit;End;
 FindFirst(D,Directory,SR);
 DirExists:=(DosError=0) And ((SR.Attr And Directory)<>0);
 {$IFDEF FPC}
 FindClose(SR);
 {$ENDIF}
End;

Function ShortName(Const N: String): String;
Var I: Integer;
Begin
 I:=Length(N);
 While (I>0) And (N[I]<>'\') And (N[I]<>'/') And (N[I]<>':') Do Dec(I);
 ShortName:=Copy(N,I+1,255);
End;

Function DirOf(Const N: String): String;
Var I: Integer;
Begin
 I:=Length(N);
 While (I>0) And (N[I]<>'\') And (N[I]<>'/') And (N[I]<>':') Do Dec(I);
 DirOf:=Copy(N,1,I);
End;

Function ExtOf(Const N: String): String;
Var S: String; I: Integer;
Begin
 S:=ShortName(N);
 I:=Length(S);
 While (I>0) And (S[I]<>'.') Do Dec(I);
 If I=0 Then ExtOf:='' Else ExtOf:=Upper(Copy(S,I+1,10));
End;

Function AddExt(Const N,Ext: String): String;
Var S: String;
Begin
 S:=N;
 If Pos('.',ShortName(S))=0 Then S:=S+'.'+Ext;
 AddExt:=S;
End;

Function JoinPath(Const A,B: String): String;
Begin
 If A='' Then JoinPath:=B
 Else If (A[Length(A)]='\') Or (A[Length(A)]='/') Or (A[Length(A)]=':') Then
     JoinPath:=A+B
 Else JoinPath:=A+DirSep+B;
End;

Function NowCs: LongInt;
Var H,M,S,C: Word;
Begin
 GetTime(H,M,S,C);
 NowCs:=((LongInt(H)*60+M)*60+S)*100+C;
End;

{ Memoire libre (TP : MemAvail ; FPC : etat du tas) }
