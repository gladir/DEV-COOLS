Const
 K_F6 = 320;

Var
 HitEdge : Integer;
 HitMenu : Integer;
 ExitDesk: Integer;        { 0 continue, 1 retour a l'accueil, 2 quitter }

Procedure LaunchApp(AppId: Integer; Const Param: String); Forward;

Function WinFrameHit(W: PWindow; PX,PY: LongInt): Integer;
Var TX1,TY1,TX2,TY2,I,BarY,Edge: Integer;
Begin
 WinFrameHit:=0;
 If W^.Iconic Then Exit;
 If Not InBox(PX,PY,W^.WinX,W^.WinY,W^.WinX+W^.WinW-1,W^.WinY+W^.WinH-1) Then Exit;
 HitEdge:=0;HitMenu:=0;
 TX1:=W^.WinX+BORDER;TY1:=W^.WinY+BORDER;TX2:=W^.WinX+W^.WinW-BORDER-1;TY2:=TY1+TITLE_H-1;
 { anneau exterieur : redimensionnement }
 If (PX<TX1) Or (PX>TX2) Or (PY<TY1) Or (PY>W^.WinY+W^.WinH-BORDER-1) Then Begin
  If Not W^.Resizable Or W^.Maxim Then Begin WinFrameHit:=8;Exit;End;
  Edge:=0;
  If PX<W^.WinX+BORDER+1 Then Edge:=Edge Or 1;
  If PX>W^.WinX+W^.WinW-BORDER-2 Then Edge:=Edge Or 2;
  If PY<W^.WinY+BORDER+1 Then Edge:=Edge Or 4;
  If PY>W^.WinY+W^.WinH-BORDER-2 Then Edge:=Edge Or 8;
  If (Edge And 3)<>0 Then Begin
   If PY<W^.WinY+18 Then Edge:=Edge Or 4;
   If PY>W^.WinY+W^.WinH-19 Then Edge:=Edge Or 8;
  End;
  If (Edge And 12)<>0 Then Begin
   If PX<W^.WinX+18 Then Edge:=Edge Or 1;
   If PX>W^.WinX+W^.WinW-19 Then Edge:=Edge Or 2;
  End;
  HitEdge:=Edge;
  WinFrameHit:=7;
  Exit;
 End;
 If PY<=TY2 Then Begin
  If PX<=TX1+TITLE_H+1 Then Begin WinFrameHit:=3;Exit;End;
  If W^.Resizable Then Begin
   If PX>=TX2-TITLE_H-1 Then Begin WinFrameHit:=5;Exit;End;
   If PX>=TX2-2*TITLE_H-3 Then Begin WinFrameHit:=4;Exit;End;
  End Else If PX>=TX2-TITLE_H-1 Then Begin WinFrameHit:=4;Exit;End;
  WinFrameHit:=2;
  Exit;
 End;
 BarY:=W^.WinY+BORDER+TITLE_H;
 If (W^.NMenu>0) And (PY>=BarY) And (PY<BarY+MENU_H) Then Begin
  For I:=1 To W^.NMenu Do
   If (PX>=MenuTitleX(W,I)) And (PX<MenuTitleX(W,I)+MenuTitleW(W,I)) Then HitMenu:=I;
  If HitMenu>0 Then WinFrameHit:=6 Else WinFrameHit:=9;
  Exit;
 End;
 WinFrameHit:=1;
End;

Procedure RubberRect(X1,Y1,X2,Y2: Integer);
Begin
 ClipFull;
 SetWriteMode(XORPut);
 SetColor(15);
 SetLineStyle(SolidLn,0,NormWidth);
 Rectangle(X1,Y1,X2,Y2);
 Rectangle(X1+1,Y1+1,X2-1,Y2-1);
 Rectangle(X1+2,Y1+2,X2-2,Y2-2);
 SetWriteMode(NormalPut);
End;

Procedure SetWinRect(W: PWindow; NX,NY,NW,NH: Integer);
Begin
 W^.WinX:=NX;W^.WinY:=NY;
 If (NW<>W^.WinW) Or (NH<>W^.WinH) Then Begin
  W^.WinW:=NW;W^.WinH:=NH;
  W^.OnResize;
 End;
 NeedFull:=True;
End;

Procedure DragWindow(W: PWindow; SX0,SY0: LongInt);
Var NX,NY,OX,OY: Integer; E: TEvent; Done: Boolean;
Begin
 HideMouse;
 OX:=W^.WinX;OY:=W^.WinY;NX:=OX;NY:=OY;
 RubberRect(NX,NY,NX+W^.WinW-1,NY+W^.WinH-1);
 Done:=False;
 Repeat
  PollEvent(E);
  If E.Kind=EV_MOVE Then Begin
   RubberRect(NX,NY,NX+W^.WinW-1,NY+W^.WinH-1);
   NX:=OX+(E.X-SX0);NY:=OY+(E.Y-SY0);
   If NY<0 Then NY:=0;
   If NY>SCR_H-24 Then NY:=SCR_H-24;
   If NX>SCR_W-40 Then NX:=SCR_W-40;
   If NX<-W^.WinW+60 Then NX:=-W^.WinW+60;
   RubberRect(NX,NY,NX+W^.WinW-1,NY+W^.WinH-1);
  End Else If E.Kind=EV_UP Then Done:=True
  Else If (E.Kind=EV_KEY) And (E.Key=K_ESC) Then Begin NX:=OX;NY:=OY;Done:=True;End;
 Until Done;
 RubberRect(NX,NY,NX+W^.WinW-1,NY+W^.WinH-1);
 SetWinRect(W,NX,NY,W^.WinW,W^.WinH);
 W^.Maxim:=False;
 ShowMouse;
End;

Procedure SizeWindow(W: PWindow; Edge: Integer; SX0,SY0: LongInt);
Var X1,Y1,X2,Y2,A1,B1,A2,B2: Integer; E: TEvent; Done: Boolean;
Begin
 HideMouse;
 A1:=W^.WinX;B1:=W^.WinY;A2:=W^.WinX+W^.WinW-1;B2:=W^.WinY+W^.WinH-1;
 X1:=A1;Y1:=B1;X2:=A2;Y2:=B2;
 RubberRect(X1,Y1,X2,Y2);
 Done:=False;
 Repeat
  PollEvent(E);
  If E.Kind=EV_MOVE Then Begin
   RubberRect(X1,Y1,X2,Y2);
   X1:=A1;Y1:=B1;X2:=A2;Y2:=B2;
   If (Edge And 1)<>0 Then X1:=Min2(A1+(E.X-SX0),A2-W^.MinW+1);
   If (Edge And 2)<>0 Then X2:=Max2(A2+(E.X-SX0),A1+W^.MinW-1);
   If (Edge And 4)<>0 Then Y1:=Min2(B1+(E.Y-SY0),B2-W^.MinH+1);
   If (Edge And 8)<>0 Then Y2:=Max2(B2+(E.Y-SY0),B1+W^.MinH-1);
   If X2>SCR_W-1 Then X2:=SCR_W-1;
   If Y2>SCR_H-1 Then Y2:=SCR_H-1;
   RubberRect(X1,Y1,X2,Y2);
  End Else If E.Kind=EV_UP Then Done:=True
  Else If (E.Kind=EV_KEY) And (E.Key=K_ESC) Then Begin X1:=A1;Y1:=B1;X2:=A2;Y2:=B2;Done:=True;End;
 Until Done;
 RubberRect(X1,Y1,X2,Y2);
 SetWinRect(W,X1,Y1,X2-X1+1,Y2-Y1+1);
 ShowMouse;
End;

Procedure MaximizeWin(W: PWindow);
Begin
 If Not W^.Resizable Then Exit;
 If Not W^.Maxim Then Begin
  W^.SX:=W^.WinX;W^.SY:=W^.WinY;W^.SW:=W^.WinW;W^.SH:=W^.WinH;
  W^.Maxim:=True;
  SetWinRect(W,0,0,SCR_W,SCR_H);
 End;
End;

Procedure RestoreWin(W: PWindow);
Begin
 If W^.Iconic Then Begin W^.Iconic:=False;NeedFull:=True;BringToFront(W);Exit;End;
 If W^.Maxim Then Begin
  W^.Maxim:=False;
  SetWinRect(W,W^.SX,W^.SY,W^.SW,W^.SH);
 End;
End;

Procedure MinimizeWin(W: PWindow);
Begin
 W^.Iconic:=True;
 NeedFull:=True;
End;

Procedure ArrangeTile;
Var I,N,Cols,Rows,CW,CH,K: Integer; L: Array[1..MAXWIN] Of PWindow;
Begin
 N:=0;
 For I:=1 To NWins Do If (Not Wins[I]^.Iconic) And Wins[I]^.Resizable Then Begin Inc(N);L[N]:=Wins[I];End;
 If N=0 Then Exit;
 Cols:=1;
 While Cols*Cols<N Do Inc(Cols);
 Rows:=(N+Cols-1) Div Cols;
 CW:=SCR_W Div Cols;CH:=(SCR_H-60) Div Rows;
 For K:=1 To N Do Begin
  L[K]^.Maxim:=False;
  SetWinRect(L[K],((K-1) Mod Cols)*CW,((K-1) Div Cols)*CH,CW,CH);
 End;
End;

Procedure ArrangeOverlap;
Var I,K: Integer;
Begin
 K:=0;
 For I:=1 To NWins Do
  If (Not Wins[I]^.Iconic) And Wins[I]^.Resizable Then Begin
   Wins[I]^.Maxim:=False;
   SetWinRect(Wins[I],16+K*26,8+K*26,Min2(SCR_W-16-K*26,Max2(Wins[I]^.SW,420)),Min2(SCR_H-70-K*26,Max2(Wins[I]^.SH,300)));
   Inc(K);
   If K>8 Then K:=0;
  End;
End;

Procedure NextWindow;
Var I: Integer; W: PWindow;
Begin
 If NWins<2 Then Exit;
 W:=Wins[1];
 If W^.Iconic Then Begin
  I:=1;
  While (I<=NWins) And Wins[I]^.Iconic Do Inc(I);
  If I>NWins Then Exit;
 End;
 W^.Iconic:=False;
 BringToFront(W);
 NeedFull:=True;
End;

