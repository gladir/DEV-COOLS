Function NewStr(Const S: String): PString;
Var P: PString;
Begin
 GetMem(P,Length(S)+1);
 P^:=S;
 NewStr:=P;
End;

Procedure FreeStr(Var P: PString);
Begin
 If P<>Nil Then Begin
  FreeMem(P,Length(P^)+1);
  P:=Nil;
 End;
End;
