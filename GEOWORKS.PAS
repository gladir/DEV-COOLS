 GText(X1+10,Y1+40,Copy(Dt_^.PCopy,1,(X2-X1-20) Div 8),cDGr);
 Sunken(X1+8,Y1+54,X2-8,Y1+130,cWht);
 InstWrap(X1+14,Y1+60,X2-X1-34,7,Dt_^.PDesc,cBlk);
 { liste des fichiers }
 Y:=Y1+138;
 GText(X1+10,Y+2,T3('Files in this package','Fichiers de ce paquet',
