{ Jeton GEOS (4 caracteres) -> application integree }
Function TokenToApp(Const T: String): Integer;
Begin
 TokenToApp:=0;
 If T='DESK' Then TokenToApp:=A_MANAGER
 Else If (T='CALc') Or (T='CALC') Then TokenToApp:=A_CALC
 Else If (T='NPAD') Or (T='GPAD') Then TokenToApp:=A_NOTEPAD
 Else If T='TETR' Then TokenToApp:=A_TETRIS
 Else If (T='SOLI') Or (T='SOLG') Then TokenToApp:=A_SOLIT
 Else If T='WP00' Then TokenToApp:=A_WRITE
 Else If T='DP00' Then TokenToApp:=A_DRAW
 Else If (T='PLNR') Or (T='PLNG') Then TokenToApp:=A_PLANNER
 Else If (T='ADBK') Or (T='GDBK') Then TokenToApp:=A_DEX
 Else If T='BANR' Then TokenToApp:=A_BANNER
 Else If T='Scrp' Then TokenToApp:=A_SCRAP
 Else If (T='PMGR') Or (T='PREF') Then TokenToApp:=A_PREFS
 Else If T='TERM' Then TokenToApp:=A_COMM
 Else If T='AMOL' Then TokenToApp:=A_AOL
 Else If T='PERF' Then TokenToApp:=A_PERF
 Else If T='GRAF' Then TokenToApp:=A_GRAPH
 Else If (T='IstF') Or (T='InsD') Then TokenToApp:=A_INSTALL
 Else If T='BONC' Then TokenToApp:=A_BOUNCE
 Else If T='GCLK' Then TokenToApp:=A_CLOCK
 Else If T='GCAL' Then TokenToApp:=A_GEOCALC
 Else If T='GFIL' Then TokenToApp:=A_GEOFILE;
End;

