{ Boite de message : lignes separees par '|' ; boutons separes par '|' ;
  retourne le numero (1..n) du bouton choisi. Le 1er est le bouton par defaut }
Function MsgBox(Const Title,Txt,Btns: String; IconKind: Integer): Integer;
Var Lines: Array[1..14] Of String[70]; BT: Array[1..4] Of String[20];
    N,NB,I,W,H,X1,Y1,P,BW,BX0,BY,TX,R: Integer; S: String; E: TEvent;
    Done: Boolean; Sv: TSave; Dn: Integer;
Begin
 N:=0;S:=TL(Txt);
 While (S<>'') And (N<14) Do Begin
  P:=Pos('|',S);
  Inc(N);
  If P=0 Then Begin Lines[N]:=Copy(S,1,70);S:='';End
  Else Begin Lines[N]:=Copy(S,1,P-1);Delete(S,1,P);End;
 End;
 NB:=0;S:=TL(Btns);
 While (S<>'') And (NB<4) Do Begin
  P:=Pos('|',S);
  Inc(NB);
  If P=0 Then Begin BT[NB]:=Copy(S,1,20);S:=''; End
  Else Begin BT[NB]:=Copy(S,1,P-1);Delete(S,1,P);End;
 End;
 If NB=0 Then Begin NB:=1;BT[1]:='OK';End;
 BW:=84;
 W:=NB*(BW+12)+24;
 For I:=1 To N Do If TextW(Lines[I])+90>W Then W:=TextW(Lines[I])+90;
 If W<260 Then W:=260;
 H:=N*14+TITLE_H+BORDER*2+78;
 If H<TITLE_H+BORDER*2+110 Then H:=TITLE_H+BORDER*2+110;
 DlgBegin(Sv,W,H,TL(Title),X1,Y1);
 HideMouse;
 ClipFull;
 TX:=X1+BORDER+16;
 If IconKind>0 Then Begin DrawMsgIcon(IconKind,X1+BORDER+14,
     Y1+BORDER+TITLE_H+16);TX:=X1+BORDER+60;End;
 For I:=1 To N Do GText(TX,Y1+BORDER+TITLE_H+20+(I-1)*14,Lines[I],cBlk);
 BX0:=X1+(W-(NB*BW+(NB-1)*12)) Div 2;
 BY:=Y1+H-BORDER-34;
 For I:=1 To NB Do Button(BX0+(I-1)*(BW+12),BY,BX0+(I-1)*(BW+12)+BW,BY+22,BT[I],
     I=1,False,True);
 ShowMouse;
 Done:=False;R:=1;Dn:=0;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   If E.Key=K_ENTER Then Begin R:=1;Done:=True;End;
   If E.Key=K_ESC Then Begin R:=NB;Done:=True;End;
   If (E.Key=K_SPACE) And (NB=1) Then Done:=True;
   For I:=1 To NB Do
    If (BT[I]<>'') And (UpCase(Chr(E.Key And 255))=UpCase(BT[I][1]))
        And (E.Key<256) Then Begin
     If (I=1) Or (NB>1) Then Begin R:=I;Done:=True;End;
    End;
  End Else If E.Kind=EV_DOWN Then Begin
   For I:=1 To NB Do
    If InBox(E.X,E.Y,BX0+(I-1)*(BW+12),BY,BX0+(I-1)*(BW+12)+BW,BY+22) Then Begin
     HideMouse;ClipFull;
     Button(BX0+(I-1)*(BW+12),BY,BX0+(I-1)*(BW+12)+BW,BY+22,BT[I],I=1,True,
         True);
     ShowMouse;
     Dn:=I;
    End;
  End Else If E.Kind=EV_UP Then Begin
   If Dn>0 Then Begin
    If InBox(E.X,E.Y,BX0+(Dn-1)*(BW+12),BY,BX0+(Dn-1)*(BW+12)+BW,
        BY+22) Then Begin
     R:=Dn;Done:=True;
    End Else Begin
     HideMouse;ClipFull;
     Button(BX0+(Dn-1)*(BW+12),BY,BX0+(Dn-1)*(BW+12)+BW,BY+22,BT[Dn],Dn=1,False,
         True);
     ShowMouse;
     Dn:=0;
    End;
   End;
  End;
 Until Done;
 DlgEnd(Sv);
 MsgBox:=R;
End;

Procedure Info(Const Title,Txt: String);
Var R: Integer;
Begin
 R:=MsgBox(Title,Txt,'OK',1);
End;

Function Confirm(Const Title,Txt: String): Boolean;
Begin
 Confirm:=MsgBox(Title,Txt,T3('Yes|No','Oui|Non','Ja|Nein'),2)=1;
End;

{ Saisie d'une ligne de texte }
Function InputBox(Const Title,Prompt: String; Var S: String; MaxLen: Integer):
    Boolean;
Var W,H,X1,Y1,FX1,FX2,FY,BY,Cur,Scr,VisC,I: Integer; E: TEvent;
Done,Ok,Fresh: Boolean;
    Sv: TSave; Ch: Char; Tmp: String;

 Procedure Draw;
 Begin
  HideMouse;ClipFull;
  Sunken(FX1,FY,FX2,FY+19,cWht);
  If Cur<Scr Then Scr:=Cur;
  If Cur>Scr+VisC Then Scr:=Cur-VisC;
  Tmp:=Copy(S,Scr+1,VisC);
  If Fresh Then Begin
   GBar(FX1+3,FY+3,FX1+3+TextW(Tmp)+1,FY+16,cBlk);
   GText(FX1+4,FY+6,Tmp,cWht);
  End Else Begin
   GBar(FX1+3,FY+3,FX2-3,FY+16,cWht);
   GText(FX1+4,FY+6,Tmp,cBlk);
   GVLine(FX1+4+(Cur-Scr)*8,FY+4,FY+15,cBlk);
  End;
  ShowMouse;
 End;

Begin
 W:=Max2(360,TextW(Prompt)+60);H:=TITLE_H+BORDER*2+98;
 DlgBegin(Sv,W,H,TL(Title),X1,Y1);
 HideMouse;ClipFull;
 GText(X1+BORDER+14,Y1+BORDER+TITLE_H+14,TL(Prompt),cBlk);
 FX1:=X1+BORDER+14;FX2:=X1+W-BORDER-15;FY:=Y1+BORDER+TITLE_H+30;
 VisC:=(FX2-FX1-10) Div 8;
 BY:=Y1+H-BORDER-34;
 Button(X1+W Div 2-100,BY,X1+W Div 2-16,BY+22,'OK',True,False,True);
 Button(X1+W Div 2+16,BY,X1+W Div 2+100,BY+22,T3('Cancel','Annuler','Abbruch'),
     False,False,True);
 ShowMouse;
 Cur:=Length(S);Scr:=0;Fresh:=S<>'';Done:=False;Ok:=False;
 Draw;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   If E.Key=K_ENTER Then Begin Ok:=True;Done:=True;End
   Else If E.Key=K_ESC Then Done:=True
   Else Begin
    If Fresh Then Begin
     If (E.Key>=32) And (E.Key<256) Then Begin S:='';Cur:=0;End;
     Fresh:=False;
    End;
    Case E.Key Of
     K_BKSP: If Cur>0 Then Begin Delete(S,Cur,1);Dec(Cur);End;
     K_DEL: If Cur<Length(S) Then Delete(S,Cur+1,1);
     K_LEFT: If Cur>0 Then Dec(Cur);
     K_RIGHT: If Cur<Length(S) Then Inc(Cur);
     K_HOME: Cur:=0;
     K_END: Cur:=Length(S);
    Else
     If (E.Key>=32) And (E.Key<256) And (Length(S)<MaxLen) Then Begin
      Ch:=Chr(E.Key);
      Insert(Ch,S,Cur+1);Inc(Cur);
     End;
    End;
    Draw;
   End;
  End Else If E.Kind=EV_DOWN Then Begin
   If InBox(E.X,E.Y,X1+W Div 2-100,BY,X1+W Div 2-16,BY+22) Then Begin Ok:=True;
   Done:=True;End;
   If InBox(E.X,E.Y,X1+W Div 2+16,BY,X1+W Div 2+100,BY+22) Then Done:=True;
  End;
 Until Done;
 DlgEnd(Sv);
 InputBox:=Ok;
End;

{ Choix dans une liste (Items separes par '|') ; retourne 0 si annule }
Function ChoiceBox(Const Title,Prompt,Items: String; Def: Integer): Integer;
Var It: Array[1..40] Of String[40]; N,I,P,Sel,Top,Vis,W,H,X1,Y1,LX1,LY1,LX2,LY2,
    BY,R: Integer;
    S: String; E: TEvent; Done: Boolean; Sv: TSave; Dn: Boolean;

 Procedure Draw;
 Var K,Y: Integer;
 Begin
  HideMouse;ClipFull;
  GBar(LX1+2,LY1+2,LX2-SB-1,LY2-2,cWht);
  For K:=0 To Vis-1 Do Begin
   If Top+K+1<=N Then Begin
    Y:=LY1+3+K*14;
    If Top+K+1=Sel Then Begin
     GBar(LX1+3,Y-1,LX2-SB-2,Y+11,cBlk);
     GText(LX1+6,Y+2,It[Top+K+1],cWht);
    End Else GText(LX1+6,Y+2,It[Top+K+1],cBlk);
   End;
  End;
  DrawScroll(True,LX2-SB+1,LY1+2,LX2-2,LY2-2,N,Vis,Top);
  ShowMouse;
 End;

Begin
 N:=0;S:=TL(Items);
 While (S<>'') And (N<40) Do Begin
  P:=Pos('|',S);
  Inc(N);
  If P=0 Then Begin It[N]:=Copy(S,1,40);S:='';End
  Else Begin It[N]:=Copy(S,1,P-1);Delete(S,1,P);End;
 End;
 Vis:=10;If N<Vis Then Vis:=N;
 W:=340;H:=TITLE_H+BORDER*2+Vis*14+98;
 DlgBegin(Sv,W,H,TL(Title),X1,Y1);
 HideMouse;ClipFull;
 GText(X1+BORDER+14,Y1+BORDER+TITLE_H+12,TL(Prompt),cBlk);
 LX1:=X1+BORDER+14;LX2:=X1+W-BORDER-15;LY1:=Y1+BORDER+TITLE_H+28;
 LY2:=LY1+Vis*14+7;
 Sunken(LX1,LY1,LX2,LY2,cWht);
 BY:=Y1+H-BORDER-34;
 Button(X1+W Div 2-100,BY,X1+W Div 2-16,BY+22,'OK',True,False,True);
 Button(X1+W Div 2+16,BY,X1+W Div 2+100,BY+22,T3('Cancel','Annuler','Abbruch'),
     False,False,True);
 ShowMouse;
 Sel:=Clamp(Def,1,N);Top:=0;
 If Sel>Vis Then Top:=Sel-Vis;
 Draw;
 Done:=False;R:=0;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   Case E.Key Of
    K_ENTER: Begin R:=Sel;Done:=True;End;
    K_ESC: Done:=True;
    K_UP: If Sel>1 Then Begin Dec(Sel);If Sel<=Top Then Top:=Sel-1;Draw;End;
    K_DOWN: If Sel<N Then Begin Inc(Sel);If Sel>Top+Vis Then Top:=Sel-Vis;Draw;
    End;
   End;
  End Else If E.Kind=EV_DOWN Then Begin
   If InBox(E.X,E.Y,LX1+2,LY1+2,LX2-SB-1,LY2-2) Then Begin
    I:=Top+(E.Y-LY1-2) Div 14+1;
    If (I>=1) And (I<=N) Then Begin Sel:=I;Draw;If E.Dbl Then Begin R:=Sel;
    Done:=True;End;End;
   End Else If InBox(E.X,E.Y,LX2-SB+1,LY1+2,LX2-2,LY2-2) Then Begin
    I:=ScrollPart(True,LX2-SB+1,LY1+2,LX2-2,LY2-2,N,Vis,Top,E.X,E.Y);
    Case I Of
     1: If Top>0 Then Dec(Top);
     2: If Top<N-Vis Then Inc(Top);
     3: Top:=Max2(0,Top-Vis);
     4: Top:=Min2(N-Vis,Top+Vis);
    End;
    Draw;
   End;
   If InBox(E.X,E.Y,X1+W Div 2-100,BY,X1+W Div 2-16,BY+22) Then Begin R:=Sel;
   Done:=True;End;
   If InBox(E.X,E.Y,X1+W Div 2+16,BY,X1+W Div 2+100,BY+22) Then Done:=True;
  End;
 Until Done;
 DlgEnd(Sv);
 ChoiceBox:=R;
End;

{ ---------------------------------------------------------------------- }
{ Selecteur de fichiers                                                    }
{ ---------------------------------------------------------------------- }

Type
 TFEntry = Record Name: String[13]; IsDir: Boolean; Size: LongInt; End;

Var
 FdList : Array[1..400] Of TFEntry;
 FdN    : Integer;

Procedure FdScan(Const Dir,Mask: String);
Var SR: SearchRec; D: String; I,J: Integer; T: TFEntry;
Begin
 FdN:=0;
 D:=Dir;
 If (D<>'') And (D[Length(D)]<>'\') And (D[Length(D)]<>'/') Then D:=D+DirSep;
 FindFirst(D+'*',AnyFile,SR);
 While DosError=0 Do Begin
  If (SR.Name<>'.') And ((SR.Attr And Directory)<>0) And (FdN<400) Then Begin
   Inc(FdN);FdList[FdN].Name:=SR.Name;FdList[FdN].IsDir:=True;
   FdList[FdN].Size:=0;
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC}FindClose(SR);{$ENDIF}
 FindFirst(D+Mask,Archive,SR);
 While DosError=0 Do Begin
  If ((SR.Attr And Directory)=0) And (FdN<400) Then Begin
   Inc(FdN);FdList[FdN].Name:=SR.Name;FdList[FdN].IsDir:=False;
   FdList[FdN].Size:=SR.Size;
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC}FindClose(SR);{$ENDIF}
 For I:=1 To FdN-1 Do
  For J:=I+1 To FdN Do
   If (FdList[J].IsDir And Not FdList[I].IsDir) Or
      ((FdList[J].IsDir=FdList[I].IsDir)
          And (Upper(FdList[J].Name)<Upper(FdList[I].Name))) Then Begin
    T:=FdList[I];FdList[I]:=FdList[J];FdList[J]:=T;
   End;
End;

Function CurDirStr: String;
Var S: String;
Begin
 GetDir(0,S);
 CurDirStr:=S;
End;

{ Parent d'un repertoire }
Function ParentDir(Const D: String): String;
Var S: String; I: Integer;
Begin
 S:=D;
 While (Length(S)>1) And ((S[Length(S)]='\') Or (S[Length(S)]='/')) Do Delete(S,
     Length(S),1);
 I:=Length(S);
 While (I>0) And (S[I]<>'\') And (S[I]<>'/') Do Dec(I);
 If I<=1 Then Begin
  If (Length(S)>=2) And (S[2]=':') Then ParentDir:=Copy(S,1,
      2)+'\' Else ParentDir:=DirSep;
 End Else ParentDir:=Copy(S,1,I-1);
End;

Function FileDlg(Const Title,Mask: String; Var Res: String; SaveMode: Boolean):
    Boolean;
Var W,H,X1,Y1,LX1,LY1,LX2,LY2,BY,FY,Vis,Top,Sel,I,R: Integer; E: TEvent;
    Dir,Nm,Msk: String; Done,Ok: Boolean; Sv: TSave; Typing: Boolean;
    OkBtn: String;

 Procedure Draw;
 Var K,Y: Integer; S: String;
 Begin
  HideMouse;ClipFull;
  GBar(LX1+2,LY1+2,LX2-SB-1,LY2-2,cWht);
  For K:=0 To Vis-1 Do Begin
   If Top+K+1<=FdN Then Begin
    Y:=LY1+3+K*14;
    If FdList[Top+K+1].IsDir Then S:='['+FdList[Top+K+1].Name+']' Else
        S:=FdList[Top+K+1].Name;
    If Top+K+1=Sel Then Begin
     GBar(LX1+3,Y-1,LX2-SB-2,Y+11,cBlk);
     GText(LX1+6,Y+2,S,cWht);
    End Else GText(LX1+6,Y+2,S,cBlk);
   End;
  End;
  DrawScroll(True,LX2-SB+1,LY1+2,LX2-2,LY2-2,FdN,Vis,Top);
  Sunken(LX1,FY,LX2,FY+19,cWht);
  GText(LX1+5,FY+6,Copy(Nm,Max2(1,Length(Nm)-((LX2-LX1-14) Div 8)+1),255),cBlk);
  GVLine(LX1+5+Min2(Length(Nm),(LX2-LX1-14) Div 8)*8,FY+4,FY+15,cBlk);
  GBar(LX1,LY1-20,LX2,LY1-4,cLGr);
  GText(LX1+2,LY1-17,Copy(Dir,Max2(1,Length(Dir)-((LX2-LX1) Div 8)+5),255),
      cBlk);
  ShowMouse;
 End;

 Procedure Rescan;
 Begin
  FdScan(Dir,Msk);
  Top:=0;Sel:=0;
 End;

 Procedure Accept;
 Begin
  If Nm='' Then Exit;
  If (Pos('\',Nm)>0) Or (Pos('/',Nm)>0) Or (Pos(':',Nm)>0) Then Res:=Nm
  Else Res:=JoinPath(Dir,Nm);
  Ok:=True;Done:=True;
 End;

 Procedure Pick(I: Integer; Dbl: Boolean);
 Begin
  If (I<1) Or (I>FdN) Then Exit;
  Sel:=I;
  If FdList[I].IsDir Then Begin
   If Dbl Then Begin
    If FdList[I].Name='..' Then Dir:=ParentDir(Dir)
    Else Dir:=JoinPath(Dir,FdList[I].Name);
    Rescan;
   End;
  End Else Begin
   Nm:=FdList[I].Name;
   If Dbl Then Accept;
  End;
  Draw;
 End;

Begin
 Dir:=Res;
 If Not DirExists(Dir) Then Dir:=DirOf(Res);
 If (Dir='') Or Not DirExists(Dir) Then Dir:=CurDirStr;
 Nm:='';
 If Not DirExists(Res) Then Nm:=ShortName(Res);
 Msk:=Mask;
 If SaveMode Then OkBtn:=T3('Save','Sauver','Speichern') Else OkBtn:=T3('Open',
     'Ouvrir',#142'ffnen');
 Vis:=11;
 W:=420;H:=TITLE_H+BORDER*2+Vis*14+130;
 DlgBegin(Sv,W,H,TL(Title),X1,Y1);
 LX1:=X1+BORDER+14;LX2:=X1+W-BORDER-15;LY1:=Y1+BORDER+TITLE_H+30;
 LY2:=LY1+Vis*14+7;
 FY:=LY2+10;BY:=Y1+H-BORDER-34;
 HideMouse;ClipFull;
 Sunken(LX1,LY1,LX2,LY2,cWht);
 Button(X1+W Div 2-100,BY,X1+W Div 2-16,BY+22,OkBtn,True,False,True);
 Button(X1+W Div 2+16,BY,X1+W Div 2+100,BY+22,T3('Cancel','Annuler','Abbruch'),
     False,False,True);
 ShowMouse;
 Rescan;
 Draw;
 Done:=False;Ok:=False;Typing:=False;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   Case E.Key Of
    K_ESC: Done:=True;
    K_ENTER: Begin
      If (Nm<>'') And DirExists(JoinPath(Dir,Nm)) Then Begin Dir:=JoinPath(Dir,
          Nm);Nm:='';Rescan;Draw;End
      Else Accept;
     End;
    K_UP: If Sel>1 Then Begin Dec(Sel);If Sel<=Top Then Top:=Sel-1;
    Pick(Sel,False);End;
    K_DOWN: If Sel<FdN Then Begin Inc(Sel);If Sel>Top+Vis Then Top:=Sel-Vis;
    Pick(Sel,False);End;
    K_BKSP: Begin If Nm<>'' Then Delete(Nm,Length(Nm),1);Draw;End;
   Else
    If (E.Key>=32) And (E.Key<256) And (Length(Nm)<70) Then Begin
        Nm:=Nm+Chr(E.Key);Draw;End;
   End;
  End Else If E.Kind=EV_DOWN Then Begin
   If InBox(E.X,E.Y,LX1+2,LY1+2,LX2-SB-1,
       LY2-2) Then Pick(Top+(E.Y-LY1-2) Div 14+1,E.Dbl)
   Else If InBox(E.X,E.Y,LX2-SB+1,LY1+2,LX2-2,LY2-2) Then Begin
    I:=ScrollPart(True,LX2-SB+1,LY1+2,LX2-2,LY2-2,FdN,Vis,Top,E.X,E.Y);
    Case I Of
     1: If Top>0 Then Dec(Top);
     2: If Top<FdN-Vis Then Inc(Top);
     3: Top:=Max2(0,Top-Vis);
     4: Top:=Max2(0,Min2(FdN-Vis,Top+Vis));
    End;
    Draw;
   End;
   If InBox(E.X,E.Y,X1+W Div 2-100,BY,X1+W Div 2-16,BY+22) Then Accept;
   If InBox(E.X,E.Y,X1+W Div 2+16,BY,X1+W Div 2+100,BY+22) Then Done:=True;
  End;
 Until Done;
 DlgEnd(Sv);
 FileDlg:=Ok;
End;

