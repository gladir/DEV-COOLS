 End;
 GwAdd(Wd_,T3('Total code and data: ','Total code et donn'#130'es : ','Code und Daten gesamt: ')+NumFmt(Tot)+T3(' bytes',' octets',' Bytes'));
 GwAdd(Wd_,'');
 {$IFDEF FPC}
 GwAdd(Wd_,T3('Menu Emulator > Run executes the geode entry point.','Menu '#144'mulateur > Ex'#130'cuter lance le point d''entr'#130'e.','Men'#129' Emulator > Ausf'#129'hren startet den Einsprungpunkt.'));
 {$ELSE}
 GwAdd(Wd_,T3('The CPU emulator needs the Free Pascal build.','L''='#130'mulateur CPU n'#130'cessite la version Free Pascal.','Der CPU-Emulator ben'#148'tigt die Free-Pascal-Version.'));
 {$ENDIF}
End;

{ ---------------------------------------------------------------------- }
{ Emulateur 8086 / 80186 (FPC uniquement)                                  }
{ ---------------------------------------------------------------------- }

{$IFDEF FPC}
Type
 TEMem = Array[0..1048575] Of Byte;
 PEMem = ^TEMem;

Const
 FL_CF=1; FL_PF=4; FL_AF=16; FL_ZF=64; FL_SF=128; FL_IF=512; FL_DF=1024; FL_OF=2048;
 TRAP_KERNEL = $F000;
 TRAP_LIB    = $F100;
 TRAP_EXIT   = $F0FF;

Var
 EMem   : PEMem;
 Reg    : Array[0..7] Of Word;
 SegR   : Array[0..3] Of Word;     { ES CS SS DS }
 EIP    : Word;
 EFl    : Word;
 SegOv  : Integer;
 RepP   : Integer;
 EHalt  : Boolean;
 EReason: String;
 ICount : LongInt;
 MM,MReg,MRm : Byte;
 EAs,EAo: Word;
 EIsReg : Boolean;
 ETrap  : Integer;
 ELog   : PWindow;
 SegPara: Array[0..MAXGSEG-1] Of Word;

Function Lin(S,O: Word): LongInt;
Begin
 Lin:=((LongInt(S) Shl 4)+O) And $FFFFF;
End;

Function M8(S,O: Word): Byte;
Begin
 M8:=EMem^[Lin(S,O)];
End;

Function M16(S,O: Word): Word;
Begin
 M16:=EMem^[Lin(S,O)]+256*EMem^[Lin(S,Word(O+1))];
End;

Procedure W8(S,O: Word; V: Byte);
Begin
 EMem^[Lin(S,O)]:=V;
End;

Procedure W16(S,O,V: Word);
Begin
 EMem^[Lin(S,O)]:=V And 255;
 EMem^[Lin(S,Word(O+1))]:=V Shr 8;
End;

Function F8: Byte;
Begin
 F8:=M8(SegR[1],EIP);Inc(EIP);
End;

Function F16: Word;
Begin
 F16:=M16(SegR[1],EIP);Inc(EIP,2);
End;

Procedure Push16(V: Word);
Begin
 Reg[4]:=Reg[4]-2;
 W16(SegR[2],Reg[4],V);
End;

Function Pop16: Word;
Begin
 Pop16:=M16(SegR[2],Reg[4]);
 Reg[4]:=Reg[4]+2;
End;

Function GetR8(I: Integer): Byte;
Begin
 If I<4 Then GetR8:=Reg[I] And 255 Else GetR8:=Reg[I-4] Shr 8;
End;

Procedure SetR8(I: Integer; V: Byte);
Begin
 If I<4 Then Reg[I]:=(Reg[I] And $FF00) Or V
 Else Reg[I-4]:=(Reg[I-4] And $00FF) Or (Word(V) Shl 8);
End;

Function SignW(V: Word): LongInt;
Begin
 If V>=$8000 Then SignW:=LongInt(V)-65536 Else SignW:=V;
End;

Function SignB(V: Byte): LongInt;
Begin
 If V>=$80 Then SignB:=LongInt(V)-256 Else SignB:=V;
End;

Procedure ModRM;
Var Disp: LongInt; Base: Word; DefSeg: Word;
Begin
 MM:=F8;
 MReg:=(MM Shr 3) And 7;MRm:=MM And 7;
 EIsReg:=(MM Shr 6)=3;
 If EIsReg Then Exit;
 DefSeg:=SegR[3];
 Disp:=0;
 Case MRm Of
  0: Base:=Reg[3]+Reg[6];
  1: Base:=Reg[3]+Reg[7];
  2: Begin Base:=Reg[5]+Reg[6];DefSeg:=SegR[2];End;
  3: Begin Base:=Reg[5]+Reg[7];DefSeg:=SegR[2];End;
  4: Base:=Reg[6];
  5: Base:=Reg[7];
  6: Begin Base:=Reg[5];DefSeg:=SegR[2];End;
 Else Base:=Reg[3];
 End;
 Case MM Shr 6 Of
  0: If MRm=6 Then Begin Base:=F16;DefSeg:=SegR[3];End;
  1: Disp:=SignB(F8);
  2: Disp:=SignW(F16);
 End;
 EAo:=Word(Base+Disp);
 EAs:=DefSeg;
 If SegOv>=0 Then EAs:=SegR[SegOv];
End;

Function GetRM(Wd: Boolean): Word;
Begin
 If EIsReg Then Begin
  If Wd Then GetRM:=Reg[MRm] Else GetRM:=GetR8(MRm);
 End Else Begin
  If Wd Then GetRM:=M16(EAs,EAo) Else GetRM:=M8(EAs,EAo);
 End;
End;

Procedure SetRM(Wd: Boolean; V: Word);
Begin
 If EIsReg Then Begin
  If Wd Then Reg[MRm]:=V Else SetR8(MRm,V And 255);
 End Else Begin
  If Wd Then W16(EAs,EAo,V) Else W8(EAs,EAo,V And 255);
 End;
End;

Procedure SetFl(Mask: Word; On: Boolean);
Begin
 If On Then EFl:=EFl Or Mask Else EFl:=EFl And (Not Mask);
End;

Function Par(V: Byte): Boolean;
Var I,C: Integer;
Begin
 C:=0;
 For I:=0 To 7 Do If (V And (1 Shl I))<>0 Then Inc(C);
 Par:=Not Odd(C);
End;

Procedure SetZSP(R: LongInt; Wd: Boolean);
Var M,Sg: LongInt;
Begin
 If Wd Then Begin M:=$FFFF;Sg:=$8000;End Else Begin M:=$FF;Sg:=$80;End;
 SetFl(FL_ZF,(R And M)=0);
 SetFl(FL_SF,(R And Sg)<>0);
 SetFl(FL_PF,Par(R And 255));
End;

Function Alu(Op: Integer; A,B: LongInt; Wd: Boolean): LongInt;
Var R,M,Sg,C: LongInt;
Begin
 If Wd Then Begin M:=$FFFF;Sg:=$8000;End Else Begin M:=$FF;Sg:=$80;End;
 C:=0;
 If (EFl And FL_CF)<>0 Then C:=1;
 Case Op Of
  0,2: Begin
        If Op=2 Then R:=A+B+C Else R:=A+B;
        SetFl(FL_CF,R>M);
        SetFl(FL_OF,((A Xor R) And (B Xor R) And Sg)<>0);
        SetFl(FL_AF,((A Xor B Xor R) And $10)<>0);
       End;
  3,5,7: Begin
        If Op=3 Then R:=A-B-C Else R:=A-B;
        SetFl(FL_CF,R<0);
        SetFl(FL_OF,((A Xor B) And (A Xor R) And Sg)<>0);
        SetFl(FL_AF,((A Xor B Xor R) And $10)<>0);
       End;
  1: Begin R:=A Or B;SetFl(FL_CF,False);SetFl(FL_OF,False);End;
  4: Begin R:=A And B;SetFl(FL_CF,False);SetFl(FL_OF,False);End;
 Else Begin R:=A Xor B;SetFl(FL_CF,False);SetFl(FL_OF,False);End;
 End;
 R:=R And M;
 SetZSP(R,Wd);
 Alu:=R;
End;

Function Shift(Op: Integer; A: LongInt; Cnt: Integer; Wd: Boolean): LongInt;
Var M,Sg: LongInt; I,Bits: Integer; Cf: Boolean; T: LongInt;
Begin
 If Wd Then Begin M:=$FFFF;Sg:=$8000;Bits:=16;End Else Begin M:=$FF;Sg:=$80;Bits:=8;End;
 Cnt:=Cnt And 31;
 If Cnt=0 Then Begin Shift:=A;Exit;End;
 For I:=1 To Cnt Do Begin
  Case Op Of
   0: Begin Cf:=(A And Sg)<>0;A:=((A Shl 1) Or Ord(Cf)) And M;SetFl(FL_CF,Cf);End;
   1: Begin Cf:=(A And 1)<>0;A:=(A Shr 1) Or (Ord(Cf)*Sg);SetFl(FL_CF,Cf);End;
   2: Begin Cf:=(A And Sg)<>0;T:=Ord((EFl And FL_CF)<>0);A:=((A Shl 1) Or T) And M;SetFl(FL_CF,Cf);End;
   3: Begin Cf:=(A And 1)<>0;T:=Ord((EFl And FL_CF)<>0);A:=(A Shr 1) Or (T*Sg);SetFl(FL_CF,Cf);End;
   4,6: Begin Cf:=(A And Sg)<>0;A:=(A Shl 1) And M;SetFl(FL_CF,Cf);End;
   5: Begin Cf:=(A And 1)<>0;A:=A Shr 1;SetFl(FL_CF,Cf);End;
  Else Begin Cf:=(A And 1)<>0;A:=(A Shr 1) Or (A And Sg);SetFl(FL_CF,Cf);End;
  End;
 End;
 If Op>=4 Then SetZSP(A,Wd);
 Shift:=A And M;
End;

Function Cond(C: Integer): Boolean;
Var R: Boolean; Cf,Zf,Sf,Of_,Pf: Boolean;
Begin
 Cf:=(EFl And FL_CF)<>0;Zf:=(EFl And FL_ZF)<>0;Sf:=(EFl And FL_SF)<>0;
 Of_:=(EFl And FL_OF)<>0;Pf:=(EFl And FL_PF)<>0;
 Case C Shr 1 Of
  0: R:=Of_;
  1: R:=Cf;
  2: R:=Zf;
  3: R:=Cf Or Zf;
  4: R:=Sf;
  5: R:=Pf;
  6: R:=Sf<>Of_;
 Else R:=Zf Or (Sf<>Of_);
 End;
 If (C And 1)<>0 Then R:=Not R;
 Cond:=R;
End;

Procedure ELogLine(Const S: String);
Begin
 If ELog<>Nil Then GwAdd(ELog,S);
End;

Procedure RetFar;
Begin
 EIP:=Pop16;
 SegR[1]:=Pop16;
End;

{ Appel noyau/bibliotheque intercepte : on journalise puis on retourne }
Procedure TrapCall(Lib: Integer; Ord_: Word);
Var Nm: String;
Begin
 If Lib<0 Then Nm:='geos' Else If Lib<MAXGLIB Then Nm:=PGeodeWin(ELog^.Data)^.G.Libs[Lib].Name Else Nm:='lib'+IntStr(Lib);
 ELogLine('  CALL '+Nm+'.'+IntStr(Ord_)+'  AX='+HexW(Reg[0])+' BX='+HexW(Reg[3])+' CX='+HexW(Reg[1])+' DX='+HexW(Reg[2]));
 Reg[0]:=0;
 EFl:=EFl And (Not FL_CF);
 RetFar;
End;

{$ENDIF}

{$IFDEF FPC}
Function Reg_Get(Wd: Boolean): Word;
Begin
 If Wd Then Reg_Get:=Reg[MReg] Else Reg_Get:=GetR8(MReg);
End;

Procedure Reg_Set(Wd: Boolean; V: Word);
Begin
 If Wd Then Reg[MReg]:=V Else SetR8(MReg,V And 255);
End;
{$ENDIF}

{$IFDEF FPC}
Procedure StrOp(Op: Byte);
Var Wd,Go: Boolean; St: Integer; A,B: LongInt; SrcSeg: Word;
Begin
 Wd:=(Op And 1)<>0;
 If Wd Then St:=2 Else St:=1;
 If (EFl And FL_DF)<>0 Then St:=-St;
 SrcSeg:=SegR[3];
 If SegOv>=0 Then SrcSeg:=SegR[SegOv];
 Go:=True;
 While Go Do Begin
  If (RepP<>0) And (Reg[1]=0) Then Exit;
  Case Op Of
   $A4,$A5: Begin
     If Wd Then W16(SegR[0],Reg[7],M16(SrcSeg,Reg[6])) Else W8(SegR[0],Reg[7],M8(SrcSeg,Reg[6]));
     Reg[6]:=Word(Reg[6]+St);Reg[7]:=Word(Reg[7]+St);
    End;
   $A6,$A7: Begin
     If Wd Then Begin A:=M16(SrcSeg,Reg[6]);B:=M16(SegR[0],Reg[7]);End
     Else Begin A:=M8(SrcSeg,Reg[6]);B:=M8(SegR[0],Reg[7]);End;
     Alu(7,A,B,Wd);
     Reg[6]:=Word(Reg[6]+St);Reg[7]:=Word(Reg[7]+St);
    End;
   $AA,$AB: Begin
     If Wd Then W16(SegR[0],Reg[7],Reg[0]) Else W8(SegR[0],Reg[7],Reg[0] And 255);
     Reg[7]:=Word(Reg[7]+St);
    End;
   $AC,$AD: Begin
     If Wd Then Reg[0]:=M16(SrcSeg,Reg[6]) Else SetR8(0,M8(SrcSeg,Reg[6]));
     Reg[6]:=Word(Reg[6]+St);
    End;
   $AE,$AF: Begin
     If Wd Then Begin A:=Reg[0];B:=M16(SegR[0],Reg[7]);End Else Begin A:=Reg[0] And 255;B:=M8(SegR[0],Reg[7]);End;
     Alu(7,A,B,Wd);
     Reg[7]:=Word(Reg[7]+St);
    End;
  End;
  If RepP=0 Then Go:=False
  Else Begin
   Reg[1]:=Reg[1]-1;
   If Op In [$A6,$A7,$AE,$AF] Then Begin
    If RepP=1 Then Go:=(EFl And FL_ZF)<>0 Else Go:=(EFl And FL_ZF)=0;
   End;
  End;
 End;
End;

Procedure Halt_(Const S: String);
Begin
 EHalt:=True;EReason:=S;
End;

Procedure ExecOne;
Var Op: Byte; Wd,Pref: Boolean; V,V2,D: LongInt; Imm: Word; Cnt: Integer; R,I: Integer; Tmp: Word;
    OldF: Word;
Begin
 If SegR[1]>=TRAP_KERNEL Then Begin
  If SegR[1]=TRAP_EXIT Then Begin
   Halt_(T3('entry point returned','retour du point d''entr'#130'e','Einsprungpunkt zur'#129'ckgekehrt'));Exit;
  End;
  If SegR[1]=TRAP_KERNEL Then TrapCall(-1,EIP) Else TrapCall(SegR[1]-TRAP_LIB,EIP);
  Inc(ICount);Exit;
 End;
 SegOv:=-1;RepP:=0;
 Pref:=True;
 While Pref Do Begin
  Op:=F8;
  Case Op Of
   $26: SegOv:=0;
   $2E: SegOv:=1;
   $36: SegOv:=2;
   $3E: SegOv:=3;
   $F2: RepP:=2;
   $F3: RepP:=1;
   $F0: ;
  Else Pref:=False;
  End;
 End;
 Inc(ICount);
 If Op<$40 Then Begin
  If (Op And 7)>=6 Then Begin
   If (Op=$06) Or (Op=$0E) Or (Op=$16) Or (Op=$1E) Then Push16(SegR[(Op Shr 3) And 3])
   Else If (Op=$07) Or (Op=$17) Or (Op=$1F) Then SegR[(Op Shr 3) And 3]:=Pop16
   Else Halt_('opcode '+HexB(Op));
   Exit;
  End;
  R:=(Op Shr 3) And 7;
  Wd:=(Op And 1)<>0;
  Case Op And 7 Of
   0,1: Begin ModRM;V:=Alu(R,GetRM(Wd),Reg_Get(Wd),Wd);If R<>7 Then SetRM(Wd,V);End;
   2,3: Begin ModRM;V:=Alu(R,Reg_Get(Wd),GetRM(Wd),Wd);If R<>7 Then Reg_Set(Wd,V);End;
   4: Begin V:=Alu(R,GetR8(0),F8,False);If R<>7 Then SetR8(0,V);End;
   5: Begin V:=Alu(R,Reg[0],F16,True);If R<>7 Then Reg[0]:=V;End;
  End;
  Exit;
 End;
 Case Op Of
  $40..$47: Begin
     I:=Op-$40;V:=Reg[I]+1;OldF:=EFl;
     SetFl(FL_OF,V=$8000);SetFl(FL_AF,(V And 15)=0);SetZSP(V,True);
     Reg[I]:=V And $FFFF;
    End;
  $48..$4F: Begin
     I:=Op-$48;V:=Reg[I]-1;
     SetFl(FL_OF,V=$7FFF);SetFl(FL_AF,(V And 15)=15);SetZSP(V And $FFFF,True);
     Reg[I]:=V And $FFFF;
    End;
  $50..$57: Begin I:=Op-$50;If I=4 Then Push16(Reg[4]-2) Else Push16(Reg[I]);End;
  $58..$5F: Begin I:=Op-$58;Tmp:=Pop16;If I<>4 Then Reg[I]:=Tmp;End;
  $60: Begin Tmp:=Reg[4];Push16(Reg[0]);Push16(Reg[1]);Push16(Reg[2]);Push16(Reg[3]);Push16(Tmp);Push16(Reg[5]);Push16(Reg[6]);Push16(Reg[7]);End;
  $61: Begin Reg[7]:=Pop16;Reg[6]:=Pop16;Reg[5]:=Pop16;Tmp:=Pop16;Reg[3]:=Pop16;Reg[2]:=Pop16;Reg[1]:=Pop16;Reg[0]:=Pop16;End;
  $68: Push16(F16);
  $6A: Push16(Word(SignB(F8)));
  $69,$6B: Begin
     ModRM;V:=SignW(GetRM(True));
     If Op=$69 Then V2:=SignW(F16) Else V2:=SignB(F8);
     V:=V*V2;
     Reg[MReg]:=Word(V And $FFFF);
     SetFl(FL_CF,(V<-32768) Or (V>32767));SetFl(FL_OF,(V<-32768) Or (V>32767));
    End;
  $70..$7F: Begin D:=SignB(F8);If Cond(Op And 15) Then EIP:=Word(EIP+D);End;
  $80..$83: Begin
     Wd:=(Op And 1)<>0;
     ModRM;
     If Op=$81 Then Imm:=F16 Else If Op=$83 Then Imm:=Word(SignB(F8)) Else Imm:=F8;
     If (Not Wd) Then Imm:=Imm And 255;
     V:=Alu(MReg,GetRM(Wd),Imm,Wd);
     If MReg<>7 Then SetRM(Wd,V);
    End;
  $84,$85: Begin Wd:=(Op And 1)<>0;ModRM;Alu(4,GetRM(Wd),Reg_Get(Wd),Wd);End;
  $86,$87: Begin
     Wd:=(Op And 1)<>0;ModRM;
     Tmp:=GetRM(Wd);SetRM(Wd,Reg_Get(Wd));Reg_Set(Wd,Tmp);
    End;
  $88,$89: Begin Wd:=(Op And 1)<>0;ModRM;SetRM(Wd,Reg_Get(Wd));End;
  $8A,$8B: Begin Wd:=(Op And 1)<>0;ModRM;Reg_Set(Wd,GetRM(Wd));End;
  $8C: Begin ModRM;SetRM(True,SegR[MReg And 3]);End;
  $8D: Begin ModRM;Reg[MReg]:=EAo;End;
  $8E: Begin ModRM;SegR[MReg And 3]:=GetRM(True);End;
  $8F: Begin ModRM;SetRM(True,Pop16);End;
  $90: ;
  $91..$97: Begin I:=Op-$90;Tmp:=Reg[0];Reg[0]:=Reg[I];Reg[I]:=Tmp;End;
  $98: If (Reg[0] And $80)<>0 Then Reg[0]:=Reg[0] Or $FF00 Else Reg[0]:=Reg[0] And $00FF;
  $99: If (Reg[0] And $8000)<>0 Then Reg[2]:=$FFFF Else Reg[2]:=0;
  $9A: Begin Imm:=F16;Tmp:=F16;Push16(SegR[1]);Push16(EIP);EIP:=Imm;SegR[1]:=Tmp;End;
  $9B: ;
  $9C: Push16(EFl Or $F002);
  $9D: EFl:=Pop16;
  $9E: EFl:=(EFl And $FF00) Or (Reg[0] Shr 8);
  $9F: Reg[0]:=(Reg[0] And $00FF) Or ((EFl And $FF) Shl 8) Or $0200;
  $A0..$A3: Begin
     Imm:=F16;Tmp:=SegR[3];If SegOv>=0 Then Tmp:=SegR[SegOv];
     Case Op Of
      $A0: SetR8(0,M8(Tmp,Imm));
      $A1: Reg[0]:=M16(Tmp,Imm);
      $A2: W8(Tmp,Imm,Reg[0] And 255);
      $A3: W16(Tmp,Imm,Reg[0]);
     End;
    End;
  $A4..$A7,$AA..$AF: StrOp(Op);
  $A8: Alu(4,GetR8(0),F8,False);
  $A9: Alu(4,Reg[0],F16,True);
  $B0..$B7: SetR8(Op-$B0,F8);
  $B8..$BF: Reg[Op-$B8]:=F16;
  $C0,$C1,$D0..$D3: Begin
     Wd:=(Op And 1)<>0;ModRM;
     If Op<=$C1 Then Cnt:=F8 Else If Op<=$D1 Then Cnt:=1 Else Cnt:=Reg[1] And 255;
     SetRM(Wd,Shift(MReg,GetRM(Wd),Cnt,Wd));
    End;
  $C2: Begin Imm:=F16;EIP:=Pop16;Reg[4]:=Reg[4]+Imm;End;
  $C3: EIP:=Pop16;
  $C4,$C5: Begin
     ModRM;Reg[MReg]:=M16(EAs,EAo);
     If Op=$C4 Then SegR[0]:=M16(EAs,Word(EAo+2)) Else SegR[3]:=M16(EAs,Word(EAo+2));
    End;
  $C6,$C7: Begin Wd:=(Op And 1)<>0;ModRM;If Wd Then SetRM(True,F16) Else SetRM(False,F8);End;
  $C8: Begin Imm:=F16;F8;Push16(Reg[5]);Reg[5]:=Reg[4];Reg[4]:=Reg[4]-Imm;End;
  $C9: Begin Reg[4]:=Reg[5];Reg[5]:=Pop16;End;
  $CA: Begin Imm:=F16;RetFar;Reg[4]:=Reg[4]+Imm;End;
  $CB: RetFar;
  $CC: Halt_('INT3');
  $CD: Halt_('INT '+HexB(F8));
  $CF: Begin EIP:=Pop16;SegR[1]:=Pop16;EFl:=Pop16;End;
  $D7: SetR8(0,M8(SegR[3],Word(Reg[3]+(Reg[0] And 255))));
  $E0..$E2: Begin
     D:=SignB(F8);Reg[1]:=Reg[1]-1;
     If (Reg[1]<>0) And ((Op=$E2) Or ((Op=$E1) And ((EFl And FL_ZF)<>0)) Or ((Op=$E0) And ((EFl And FL_ZF)=0))) Then EIP:=Word(EIP+D);
    End;
  $E3: Begin D:=SignB(F8);If Reg[1]=0 Then EIP:=Word(EIP+D);End;
  $D8..$DF: Begin ModRM;End;
  $E4..$E7: F8;
  $E8: Begin D:=SignW(F16);Push16(EIP);EIP:=Word(EIP+D);End;
  $E9: Begin D:=SignW(F16);EIP:=Word(EIP+D);End;
  $EA: Begin Imm:=F16;Tmp:=F16;EIP:=Imm;SegR[1]:=Tmp;End;
  $EB: Begin D:=SignB(F8);EIP:=Word(EIP+D);End;
  $EC..$EF: ;
  $F4: Halt_('HLT');
  $F5: EFl:=EFl Xor FL_CF;
  $F6,$F7: Begin
     Wd:=(Op And 1)<>0;ModRM;
     Case MReg Of
      0,1: Begin If Wd Then Alu(4,GetRM(True),F16,True) Else Alu(4,GetRM(False),F8,False);End;
      2: SetRM(Wd,Not GetRM(Wd));
      3: Begin V:=Alu(5,0,GetRM(Wd),Wd);SetRM(Wd,V);End;
      4,5: Begin
         If Wd Then Begin
          If MReg=4 Then V:=LongInt(Reg[0])*GetRM(True) Else V:=SignW(Reg[0])*SignW(GetRM(True));
          Reg[0]:=V And $FFFF;Reg[2]:=(V Shr 16) And $FFFF;
          SetFl(FL_CF,Reg[2]<>0);SetFl(FL_OF,Reg[2]<>0);
         End Else Begin
          If MReg=4 Then V:=(Reg[0] And 255)*GetRM(False) Else V:=SignB(Reg[0] And 255)*SignB(GetRM(False));
          Reg[0]:=V And $FFFF;SetFl(FL_CF,(Reg[0] Shr 8)<>0);SetFl(FL_OF,(Reg[0] Shr 8)<>0);
         End;
        End;
      6,7: Begin
         If Wd Then Begin
          V:=GetRM(True);
          If V=0 Then Begin Halt_('divide error');Exit;End;
          If MReg=6 Then Begin
           V2:=(LongInt(Reg[2]) Shl 16) Or Reg[0];
           If (V2 Shr 16)>=V Then Begin Halt_('divide overflow');Exit;End;
           Reg[0]:=(V2 Div V) And $FFFF;Reg[2]:=(V2 Mod V) And $FFFF;
          End Else Begin
           V2:=(LongInt(Reg[2]) Shl 16) Or Reg[0];V:=SignW(V);
           Reg[0]:=(V2 Div V) And $FFFF;Reg[2]:=(V2 Mod V) And $FFFF;
          End;
         End Else Begin
          V:=GetRM(False);
          If V=0 Then Begin Halt_('divide error');Exit;End;
          If MReg=6 Then Begin
           V2:=Reg[0];
           SetR8(0,(V2 Div V) And 255);SetR8(4,(V2 Mod V) And 255);
          End Else Begin
           V2:=SignW(Reg[0]);V:=SignB(V);
           SetR8(0,(V2 Div V) And 255);SetR8(4,(V2 Mod V) And 255);
          End;
         End;
        End;
     End;
    End;
  $F8: EFl:=EFl And (Not FL_CF);
  $F9: EFl:=EFl Or FL_CF;
  $FA: EFl:=EFl And (Not FL_IF);
  $FB: EFl:=EFl Or FL_IF;
  $FC: EFl:=EFl And (Not FL_DF);
  $FD: EFl:=EFl Or FL_DF;
  $FE: Begin
     ModRM;V:=GetRM(False);
     If MReg=0 Then Begin V:=V+1;SetFl(FL_OF,V=$80);End Else Begin V:=V-1;SetFl(FL_OF,V=$7F);End;
     SetZSP(V And 255,False);SetRM(False,V And 255);
    End;
  $FF: Begin
     ModRM;
     Case MReg Of
      0: Begin V:=GetRM(True)+1;SetFl(FL_OF,V=$8000);SetZSP(V And $FFFF,True);SetRM(True,V And $FFFF);End;
      1: Begin V:=GetRM(True)-1;SetFl(FL_OF,V=$7FFF);SetZSP(V And $FFFF,True);SetRM(True,V And $FFFF);End;
      2: Begin Tmp:=GetRM(True);Push16(EIP);EIP:=Tmp;End;
      3: Begin Imm:=M16(EAs,EAo);Tmp:=M16(EAs,Word(EAo+2));Push16(SegR[1]);Push16(EIP);EIP:=Imm;SegR[1]:=Tmp;End;
      4: EIP:=GetRM(True);
      5: Begin Imm:=M16(EAs,EAo);Tmp:=M16(EAs,Word(EAo+2));EIP:=Imm;SegR[1]:=Tmp;End;
      6: Push16(GetRM(True));
     Else Halt_('FF /7');
     End;
    End;
 Else Halt_('opcode '+HexB(Op)+' @'+HexW(SegR[1])+':'+HexW(Word(EIP-1)));
 End;
End;
{$ENDIF}

Function GwNew(AX,AY: Integer; Const APath: String): PWindow;
 Var Wd_: PWindow; Dt_: PGeodeWin;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 WinInit(Wd_,A_GEODE,AX,AY,580,390,'Geode');
 Wd_^.IconId:=IC_GEOS;Wd_^.MinW:=300;Wd_^.MinH:=200;
 Dt_^.NL:=0;Dt_^.Top:=1;Dt_^.Drag:=False;
 WinAddMenu(Wd_,'File~Fichier~Datei');
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 WinAddMenu(Wd_,'Emulator~'#144'mulateur~Emulator');
 WinAddItem(Wd_,'Run~Ex'#130'cuter~Ausf'#129'hren',CM_GRUN,'F9');
 WinAddItem(Wd_,'Reset~R'#130'initialiser~Zur'#129'cksetzen',CM_GRESET,'');
 WinAddItem(Wd_,'Show Information~Afficher les informations~Informationen anzeigen',CM_GREPORT,'');
 WinAddMenu(Wd_,'Window~Fen'#136'tre~Fenster');
 WinAddItem(Wd_,'Tile~Mosa'#139'que~Kacheln',CM_TILE,'');
 WinAddItem(Wd_,'Overlap~Cascade~'#154'berlappend',CM_OVERLAP,'');
 If ParseGeode(APath,Dt_^.G) Then Wd_^.Title:='Geode - '+Dt_^.G.Info.LongName
 Else Begin
  Dt_^.G.Path:=APath;
  ReadGeosHeader(APath,Dt_^.G.Info);
