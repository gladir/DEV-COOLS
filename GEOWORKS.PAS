Procedure GbIdeAction(Wd_: PWindow; I: Integer);
Var F: PForm; P: String;
Begin
 F:=GbProj^.Form;
 Case I Of
  1: GbShowWin(GbProj^.AddW,A_GBADD,404,10,150,300,'Add Object');
  2: GbShowWin(GbProj^.PropW,A_GBPROP,66,162,280,262,'Properties');
  3: GbOpenCode;
  4: GbRun;
  5: Begin
      P:='';
      If FileDlg(T3('Open Form','Ouvrir un formulaire','Formular '#148'ffnen'),
          '*.GBF',P,False) Then Begin
       If FmLoad(F,P) Then Begin GbProj^.Path:=P;
       GbProj^.Msg:=T3('Loaded ','Charg'#130' : ','Geladen: ')+ShortName(P);End
       Else GbProj^.Msg:=T3('Cannot open the form','Formulaire illisible',
           'Formular nicht lesbar');
       GbRefresh;
      End;
     End;
  6: Begin
      P:=GbProj^.Path;
      If P='' Then Begin P:=JoinPath(CurDirStr,'FORM.GBF');
       If Not FileDlg(T3('Save Form','Enregistrer le formulaire',
           'Formular speichern'),'*.GBF',P,True) Then Exit;End;
      FmSave(F,P);GbProj^.Path:=P;GbProj^.Msg:=T3('Saved ','Enregistr'#130' : ',
          'Gespeichert: ')+ShortName(P);
     End;
  7: GbDeleteSel;
 End;
 GbRefresh;
End;

