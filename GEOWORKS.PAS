{ Ouvre un cadre de dialogue centre ; sauvegarde l'arriere-plan }
Procedure DlgBegin(Var Sv: TSave; DW,DH: Integer; Const Title: String; Var X1,Y1: Integer);
Begin
 X1:=(SCR_W-DW) Div 2;
 Y1:=(SCR_H-DH) Div 2;
