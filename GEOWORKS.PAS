   6: Begin
       K:=ChoiceBox(T3('Measurement','Mesure','Ma'#225'system'),T3('System:',
           'Syst'#138'me :','System:'),
          T3('US (inches, miles)|Metric (cm, km)',
              'US (pouces, milles)|M'#130'trique (cm, km)',
