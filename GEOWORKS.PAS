 ClipFull;
 GBar(X1+5,Y1+5,X1+DW+4,Y1+DH+4,cBlk);
 GBar(X1,Y1,X1+DW-1,Y1+DH-1,cLGr);
 Bevel1(X1,Y1,X1+DW-1,Y1+DH-1,cWht,cBlk);
 Bevel1(X1+1,Y1+1,X1+DW-2,Y1+DH-2,cLGr,cDGr);
 Bevel1(X1+BORDER-1,Y1+BORDER-1,X1+DW-BORDER,Y1+DH-BORDER,cDGr,cWht);
