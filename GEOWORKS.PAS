 WinAddItem(Wd_,'Enlarged to 125%~Agrandi '#133' 125 %~Vergr'#148#225+
     'ert auf 125%',CM_SCZ0+4,'');
 WinAddItem(Wd_,'Enlarged to 150%~Agrandi '#133' 150 %~Vergr'#148#225+
     'ert auf 150%',CM_SCZ0+5,'');
 WinAddItem(Wd_,'Enlarged to 175%~Agrandi '#133' 175 %~Vergr'#148#225+
     'ert auf 175%',CM_SCZ0+6,'');
 WinAddItem(Wd_,'Enlarged to 200%~Agrandi '#133' 200 %~Vergr'#148#225+
