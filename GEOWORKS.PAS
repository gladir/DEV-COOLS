Procedure PrefsSave;
Var F: Text;
Begin
 {$I-}
 Assign(F,IniPath);Rewrite(F);
 WriteLn(F,'[GEOWORKS]');
 WriteLn(F,'Clock24=',Ord(Clock24));
 WriteLn(F,'ShortDate=',ShortFmt);
 WriteLn(F,'ThousandSep=',NumSep);
 WriteLn(F,'DecimalSep=',DecSep);
 WriteLn(F,'Metric=',Ord(Metric));
 WriteLn(F,'Currency=',CurSym);
 WriteLn(F,'CurrencyAfter=',Ord(CurAfter));
 WriteLn(F,'DoubleClick=',DblCs);
 WriteLn(F,'Sound=',Ord(SoundOn));
 WriteLn(F,'Background=',DeskBack);
 WriteLn(F,'BackInk=',DeskInk);
 WriteLn(F,'BackPaper=',DeskPaper);
 WriteLn(F,'LeftHand=',Ord(LeftHand));
 WriteLn(F,'LightsOut=',LightsMin);
 WriteLn(F,'KeyDelay=',KeyDelay);
 WriteLn(F,'KeyRate=',KeyRate);
 WriteLn(F,'ModemPort=',ModemPort);
 WriteLn(F,'ModemBaud=',ModemBaud);
 WriteLn(F,'ModemTone=',Ord(ModemTone));
 WriteLn(F,'ModemInit=',ModemInit);
 WriteLn(F,'Printer=',PrinterSel);
 WriteLn(F,'PrinterPort=',PrinterPort);
 WriteLn(F,'TextSize=',TextSize);
 WriteLn(F,'Welcome=',Ord(WelcomeOn));
 WriteLn(F,'StartLevel=',GeosLevel);
 WriteLn(F,'TaskSwitch=',Ord(TaskOn));
 WriteLn(F,'TaskKey=',TaskKey);
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
End;

Procedure PrefsLoad;
Var F: Text; S,K,V: String; P: Integer;
Begin
 {$I-}
 Assign(F,IniPath);Reset(F);
 {$I+}
 If IOResult<>0 Then Exit;
 {$I-}
 While Not Eof(F) Do Begin
  ReadLn(F,S);
  P:=Pos('=',S);
  If P>0 Then Begin
   K:=Upper(Copy(S,1,P-1));V:=Copy(S,P+1,40);
   If K='CLOCK24' Then Clock24:=StrVal(V,0)<>0
   Else If K='SHORTDATE' Then ShortFmt:=StrVal(V,ShortFmt)
   Else If K='THOUSANDSEP' Then NumSep:=StrVal(V,NumSep)
   Else If K='DECIMALSEP' Then DecSep:=StrVal(V,DecSep)
   Else If K='METRIC' Then Metric:=StrVal(V,0)<>0
   Else If K='CURRENCY' Then CurSym:=Copy(V,1,4)
   Else If K='CURRENCYAFTER' Then CurAfter:=StrVal(V,0)<>0
   Else If K='DOUBLECLICK' Then DblCs:=StrVal(V,DblCs)
   Else If K='SOUND' Then SoundOn:=StrVal(V,1)<>0
   Else If K='BACKGROUND' Then DeskBack:=StrVal(V,DeskBack)
   Else If K='BACKINK' Then DeskInk:=StrVal(V,DeskInk)
   Else If K='BACKPAPER' Then DeskPaper:=StrVal(V,DeskPaper)
   Else If K='LEFTHAND' Then LeftHand:=StrVal(V,0)<>0
   Else If K='LIGHTSOUT' Then LightsMin:=StrVal(V,0)
   Else If K='KEYDELAY' Then KeyDelay:=StrVal(V,2)
   Else If K='KEYRATE' Then KeyRate:=StrVal(V,3)
   Else If K='MODEMPORT' Then ModemPort:=StrVal(V,1)
   Else If K='MODEMBAUD' Then ModemBaud:=StrVal(V,5)
   Else If K='MODEMTONE' Then ModemTone:=StrVal(V,1)<>0
   Else If K='MODEMINIT' Then ModemInit:=Copy(V,1,40)
   Else If K='PRINTER' Then PrinterSel:=StrVal(V,1)
   Else If K='PRINTERPORT' Then PrinterPort:=StrVal(V,1)
   Else If K='TEXTSIZE' Then TextSize:=StrVal(V,2)
   Else If K='WELCOME' Then WelcomeOn:=StrVal(V,1)<>0
   Else If K='STARTLEVEL' Then GeosLevel:=StrVal(V,0)
   Else If K='TASKSWITCH' Then TaskOn:=StrVal(V,1)<>0
   Else If K='TASKKEY' Then TaskKey:=StrVal(V,K_F6);
  End;
 End;
 Close(F);
 {$I+}
 If IOResult<>0 Then Begin End;
 If ShortFmt<0 Then ShortFmt:=0;If ShortFmt>4 Then ShortFmt:=0;
 If NumSep<0 Then NumSep:=0;If NumSep>3 Then NumSep:=0;
 If DecSep<0 Then DecSep:=0;If DecSep>1 Then DecSep:=0;
 If (DblCs<10) Or (DblCs>100) Then DblCs:=40;
End;

