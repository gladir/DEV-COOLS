 DriveRoot:=Chr(64+D)+':\';
 {$ENDIF}
End;

Function DriveOfPath(Const P: String): Integer;
Begin
 If (Length(P)>=2) And (P[2]=':') Then DriveOfPath:=Ord(UpCase(P[1]))-64
 Else DriveOfPath:=3;
End;

Function CopyFileTo(Const Src,Dst: String): Boolean;
Var F,G: File; Buf: Pointer; N,M: Word; Ok: Boolean;
Begin
 CopyFileTo:=False;
 {$I-}
 Assign(F,Src);FileMode:=0;Reset(F,1);
 If IOResult<>0 Then Exit;
 Assign(G,Dst);Rewrite(G,1);
 If IOResult<>0 Then Begin Close(F);Exit;End;
 GetMem(Buf,16384);
 Ok:=True;
 Repeat
  BlockRead(F,Buf^,16384,N);
  If N>0 Then Begin BlockWrite(G,Buf^,N,M);If M<>N Then Ok:=False;End;
 Until (N=0) Or Not Ok;
 FreeMem(Buf,16384);
 Close(F);Close(G);
 {$I+}
 If IOResult<>0 Then Ok:=False;
 CopyFileTo:=Ok;
End;

