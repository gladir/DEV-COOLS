Procedure DosRun(I: Integer);
Begin
 RunDosCommand(DosCmd[I]);
 If DosAsk[I] Then Info(T3('Return','Retour','R'#129'ckkehr'),
     T3('Press OK to return to PC/GEOS.',
     'Appuyez sur OK pour revenir '#133' PC/GEOS.',
     'OK dr'#129'cken, um zu PC/GEOS zur'#129'ckzukehren.'));
End;

Procedure DosOptions(Var Page: Integer);
Var R,I: Integer; N,C: String;
Begin
 R:=ChoiceBox(T3('Options','Options','Optionen'),T3('Choose a command:',
     'Choisissez une commande :','Befehl w'#132'hlen:'),
   T3('Create New Button|Change Button Settings|Delete Button',
       'Cr'#130'er un bouton|Modifier un bouton|Supprimer un bouton',
       'Neue Schaltfl'#132'che|Schaltfl'#132'che '#132'ndern|Schaltfl'#132+
       'che l'#148'schen'),1);
 Case R Of
  1: If DosN<MAXDOSB Then Begin
      N:='';C:='';
      If InputBox(T3('New Button','Nouveau bouton','Neue Schaltfl'#132'che'),
          T3('Button name:','Nom du bouton :','Name:'),N,20) And (N<>'') Then
       If InputBox(T3('New Button','Nouveau bouton','Neue Schaltfl'#132'che'),
           T3('Command line:','Ligne de commande :','Befehlszeile:'),C,
           90) Then Begin
        Inc(DosN);DosName[DosN]:=N;DosCmd[DosN]:=C;
        DosAsk[DosN]:=Confirm(T3('Button Settings','Param'#138'tres du bouton',
            'Schaltfl'#132'cheneinstellungen'),
         T3('Ask before returning to PC/GEOS?',
             'Demander avant de revenir '#133' PC/GEOS ?',
             'Vor der R'#129'ckkehr zu PC/GEOS fragen?'));
        DosSave;
       End;
     End;
  2,3: If DosN>0 Then Begin
      N:='';
      For I:=1 To DosN Do Begin If I>1 Then N:=N+'|';N:=N+DosName[I];End;
      I:=ChoiceBox(T3('Select Button','Choisir un bouton',
          'Schaltfl'#132'che w'#132'hlen'),T3('Button:','Bouton :',
          'Schaltfl'#132'che:'),N,Page*8+1);
      If I>0 Then Begin
       If R=3 Then Begin
        While I<DosN Do Begin DosName[I]:=DosName[I+1];DosCmd[I]:=DosCmd[I+1];
        DosAsk[I]:=DosAsk[I+1];Inc(I);End;
        Dec(DosN);
        If Page*8>=DosN Then Page:=Max2(0,Page-1);
       End Else Begin
        N:=DosName[I];C:=DosCmd[I];
        If InputBox(T3('Button Settings','Param'#138'tres du bouton',
            'Schaltfl'#132'cheneinstellungen'),T3('Button name:',
            'Nom du bouton :','Name:'),N,20) Then
         If InputBox(T3('Button Settings','Param'#138'tres du bouton',
             'Schaltfl'#132'cheneinstellungen'),T3('Command line:',
             'Ligne de commande :','Befehlszeile:'),C,90) Then Begin
          DosName[I]:=N;DosCmd[I]:=C;
          DosAsk[I]:=Confirm(T3('Button Settings','Param'#138'tres du bouton',
              'Schaltfl'#132'cheneinstellungen'),
           T3('Ask before returning to PC/GEOS?',
               'Demander avant de revenir '#133' PC/GEOS ?',
               'Vor der R'#129'ckkehr zu PC/GEOS fragen?'));
         End;
       End;
       DosSave;
      End;
     End;
 End;
End;

Procedure DosScreen;
Var E: TEvent; Page,K,I,X1,Y1,X2,Y2: Integer; Done: Boolean;
Begin
 DosLoad;
 Page:=0;Done:=False;
 HideMouse;DrawDosScreen(Page);ShowMouse;
 Repeat
  PollEvent(E);
  If E.Kind=EV_KEY Then Begin
   If E.Key=K_ESC Then Done:=True;
  End Else If E.Kind=EV_UP Then Begin
   If InBox(E.X,E.Y,0,0,47,31) Then Done:=True
   Else If InBox(E.X,E.Y,SCR_W-49,0,SCR_W-1,31) Then
    Info(T3('Help','Aide','Hilfe'),T3('Click a button to run its DOS '+
        'program.|Options creates, changes '+'or deletes buttons.',
     'Cliquez sur un bouton pour lancer '+'son programme DOS.|Options cr'#130+
         'e, modifie ou supprime des boutons.',
     'Klicken Sie auf eine Schaltfl'#132+
         'che, um das DOS-Programm zu starten.|Optionen erstellt, '#132+
         'ndert oder l'#148'scht Schaltfl'#132'chen.'))
   Else If InBox(E.X,E.Y,36,SCR_H-70,170,SCR_H-40) Then DosOptions(Page)
   Else If InBox(E.X,E.Y,SCR_W Div 2-90,SCR_H-74,SCR_W Div 2+90,
       SCR_H-36) Then RunDosCommand('')
   Else If (DosN>8) And InBox(E.X,E.Y,SCR_W-170,SCR_H-70,SCR_W-100,
       SCR_H-40) And (Page>0) Then Dec(Page)
   Else If (DosN>8) And InBox(E.X,E.Y,SCR_W-90,SCR_H-70,SCR_W-36,
       SCR_H-40) And ((Page+1)*8<DosN) Then Inc(Page)
   Else
    For K:=1 To 8 Do Begin
     I:=Page*8+K;
     DosBtnRect(K,X1,Y1,X2,Y2);
     If (I<=DosN) And InBox(E.X,E.Y,X1,Y1,X2,Y2) Then DosRun(I);
    End;
   If Not Done Then Begin HideMouse;DrawDosScreen(Page);ShowMouse;End;
  End;
 Until Done;
End;

