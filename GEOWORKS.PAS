Function IsNumExt(Const E: String): Boolean;
Begin
 IsNumExt:=(Length(E)=3) And (E[1]>='0') And (E[1]<='9') And (E[2]>='0')
     And (E[2]<='9')
  And (E[3]>='0') And (E[3]<='9');
End;

Function IsTextExt(Const E: String): Boolean;
Begin
 IsTextExt:=(E='TXT') Or (E='DOC') Or (E='PAS') Or (E='INI') Or (E='ASM')
     Or (E='C') Or
  (E='H') Or (E='BAS') Or (E='CFG') Or (E='LOG') Or (E='MD') Or (E='INC')
      Or (E='CPP') Or
  (E='TC') Or (E='MAC') Or (E='STR');
End;

