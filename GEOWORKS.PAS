Const
 CM_BRRUN = 1503;

Type
 PBRun = ^TBRun;
 TBRun = Record
  Bas     : PBas;
  Form    : PForm;
  Alive   : Boolean;
  Queue   : Array[1..8] Of String[40];
  NQ      : Integer;
  InSub   : Boolean;
  FormH   : Integer;
  Dragging: Integer;
  CvX,CvY : Integer;
  Stepping,StepOnce: Boolean;
  Tree     : Boolean;
 End;

Function BrNew(AX,AY: Integer; Bas: PBas; Form: PForm; Const Title: String):
    PWindow; Forward;
Procedure BrDone(Wd_: PWindow); Forward;
Procedure BrDrawClient(Wd_: PWindow); Forward;
Procedure BrOnMouse(Wd_: PWindow; Var E: TEvent); Forward;
Procedure BrOnKey(Wd_: PWindow; K: Word); Forward;
Procedure BrOnCommand(Wd_: PWindow; Cmd: Integer); Forward;
Function BrIdle(Wd_: PWindow): Boolean; Forward;

Procedure BrStartSub(R: PBRun; Const Nm: String);
Var I,L: Integer; U: String;
Begin
 CB:=R^.Bas;
 U:=Upper(Nm);L:=0;
 For I:=1 To CB^.NSubs Do If CB^.Subs[I]=U Then L:=CB^.SubL[I];
 If L=0 Then Exit;
 CB^.NG:=1;CB^.GsL[1]:=0;CB^.GsP[1]:=0;
 CB^.Err:='';
 BGotoLine(L);CB^.Ps:=Length(CB^.Ln_)+1;
 CB^.Running:=True;CB^.Done:=False;R^.InSub:=True;
End;

Procedure BrPost(R: PBRun; Const Nm: String);
Begin
 If R^.NQ<8 Then Begin Inc(R^.NQ);R^.Queue[R^.NQ]:=Nm;End;
End;

{ Demarre l'execution d'un programme }
Procedure BrBegin(R: PBRun);
Begin
 CB:=R^.Bas;
 BCollectData;BCollectSubs;
 CB^.Err:='';CB^.Running:=True;CB^.Done:=False;CB^.NG:=0;CB^.NF:=0;CB^.NLp:=0;
 CB^.NPnd:=0;CB^.IntBase:=0;CB^.WaitMain:=False;CB^.ErrJump:=False;
 If CB^.NL>0 Then BGotoLine(1);
End;

Function BrNew(AX,AY: Integer; Bas: PBas; Form: PForm; Const Title: String):
    PWindow;
 Var Wd_: PWindow; Dt_: PBRun; W,H: Integer;
Begin
 New(Wd_);New(Dt_);FillChar(Dt_^,SizeOf(Dt_^),0);Wd_^.Data:=Dt_;
 Dt_^.Bas:=Bas;Dt_^.Form:=Form;Dt_^.Alive:=Form<>Nil;
 If Bas^.NoScr Then WinInit(Wd_,A_BASRUN,AX,AY,350,70,Title)
 Else WinInit(Wd_,A_BASRUN,AX,AY,350,200+6+66,Title);
 Wd_^.IconId:=IC_NOTE;Wd_^.MinW:=300;Wd_^.MinH:=200;
 WinAddMenu(Wd_,'Program~Programme~Programm');
 WinAddItem(Wd_,'Restart~Red'#130'marrer~Neu starten',CM_BRRESTART,'');
 WinAddItem(Wd_,'Stop~Arr'#136'ter~Anhalten',CM_BRSTOP,'');
 WinAddItem(Wd_,'Pause / Continue~Pause / Reprendre~Pause / Weiter',CM_BRPAUSE,
     'F8');
 WinAddItem(Wd_,'Step~Pas '#133' pas~Einzelschritt',CM_BRSTEP,'F10');
 WinAddItem(Wd_,'Variables...~Variables...~Variablen...',CM_BRVARS,'');
 WinAddItem(Wd_,'Clear Screen~Effacer l'''#130'cran~Bildschirm l'#148'schen',
     CM_BRCLS,'');
 WinAddItem(Wd_,'Close~Fermer~Schlie'#225'en',CM_CLOSE,'Alt+F4');
 CB:=Bas;
 If Form<>Nil Then Begin
  FmLayout(Form,1,8,8,W,H);Dt_^.FormH:=H+16;
  Wd_^.WinW:=Min2(630,Max2(350,W+30));Wd_^.WinH:=Min2(450,Wd_^.WinH+Dt_^.FormH);
 End;
 BrBegin(Dt_);
 BrNew:=Wd_;
End;

Procedure BrDone(Wd_: PWindow);
Begin
 BFree(PBRun(Wd_^.Data)^.Bas);
 If PBRun(Wd_^.Data)^.Form<>Nil Then Dispose(PBRun(Wd_^.Data)^.Form);
End;

{ position (x) du titre de sous-menu Sub (0 = GEOS) dans la barre de menus }
Function BrMenuX(M,Sub: Integer): Integer;
Var I,X: Integer;
Begin
 X:=4;
 If Sub>=1 Then Begin
  X:=X+4*8+12;
  For I:=1 To Sub-1 Do X:=X+Length(GbRes.M[M].SubT[I])*8+12;
 End;
 BrMenuX:=X;
End;

Function BrMenuW(M,Sub: Integer): Integer;
Var I,W: Integer;
Begin
 W:=0;
 For I:=1 To GbRes.M[M].NIt[Sub] Do If Length(GbRes.M[M].It[Sub,
     I].Txt)*8>W Then W:=Length(GbRes.M[M].It[Sub,I].Txt)*8;
 BrMenuW:=W+16;
End;

Procedure BrDrawIcon(CX,CY,X,Y: Integer; Const Nm: String);
Var B,PX,PY: Integer;
Begin
 B:=BResBmp(Nm);
 If B=0 Then Begin
  GRect(CX+X,CY+Y,CX+X+15,CY+Y+15,cBlk);GText(CX+X+4,CY+Y+4,Copy(Nm,1,1),cBlk);
  Exit;
 End;
 For PY:=0 To GbRes.B[B].H-1 Do
  For PX:=0 To GbRes.B[B].W-1 Do
   If GbRes.B[B].D[PY,PX]<>0 Then GBar(CX+X+PX,CY+Y+PY,CX+X+PX,CY+Y+PY,cBlk);
End;

{ dessine l'ecran geoBASIC (graphiques, texte, menu, icones) a partir de
  (CX,CY) }
Procedure BrPaintScreen(CX,CY: Integer);
Var Y,X,X0,R,C,I,M,S,W: Integer; Cl: Byte; T: String;
Begin
 GBar(CX,CY,CX+319,CY+199,cWht);
 For Y:=0 To 199 Do Begin
  X:=0;
  While X<=319 Do Begin
   Cl:=CB^.Scr[Y,X];
   If Cl=CLRBG Then Inc(X)
   Else Begin
    X0:=X;
    While (X<=319) And (CB^.Scr[Y,X]=Cl) Do Inc(X);
    GBar(CX+X0,CY+Y,CX+X-1,CY+Y,Cl);
   End;
  End;
 End;
 For R:=0 To 24 Do
  For C:=0 To 39 Do
   If CB^.Tx[R,C]<>' ' Then GText(CX+C*8,CY+R*8,CB^.Tx[R,C],CB^.TxK[R,C]);
 If CB^.WaitIn Or CB^.WaitKey Then Begin
  T:=CB^.InBuf;If CB^.PromptOn Then T:=T+'_';
  GBar(CX+CB^.CurC*8,CY+CB^.CurR*8,CX+319,CY+CB^.CurR*8+7,cWht);
  GText(CX+CB^.CurC*8,CY+CB^.CurR*8,T,cBlu);
 End;
 { icones }
 If CB^.CurIcons>0 Then
  For I:=1 To GbRes.I[CB^.CurIcons].N Do
   BrDrawIcon(CX,CY,GbRes.I[CB^.CurIcons].Ic[I].X,GbRes.I[CB^.CurIcons].Ic[I].Y,
       GbRes.I[CB^.CurIcons].Ic[I].Bmp);
 { menu }
 If CB^.CurMenu>0 Then Begin
  M:=CB^.CurMenu;
  GBar(CX,CY,CX+319,CY+11,cWht);GLine(CX,CY+11,CX+319,CY+11,cBlk);
  GText(CX+4,CY+2,'GEOS',cBlk);
  For S:=1 To GbRes.M[M].NSub Do Begin
   X:=BrMenuX(M,S);
   If CB^.MenuOpen=S Then GBar(CX+X-4,CY,CX+X+Length(GbRes.M[M].SubT[S])*8+4,
       CY+10,cBlk);
   If CB^.MenuOpen=S Then GText(CX+X,CY+2,GbRes.M[M].SubT[S],
       cWht) Else GText(CX+X,CY+2,GbRes.M[M].SubT[S],cBlk);
  End;
  If CB^.MenuOpen>0 Then Begin
   S:=CB^.MenuOpen;X:=BrMenuX(M,S);W:=BrMenuW(M,S);
   GBar(CX+X-4,CY+12,CX+X-4+W,CY+12+GbRes.M[M].NIt[S]*11+2,cWht);
   GRect(CX+X-4,CY+12,CX+X-4+W,CY+12+GbRes.M[M].NIt[S]*11+2,cBlk);
   For I:=1 To GbRes.M[M].NIt[S] Do GText(CX+X,CY+14+(I-1)*11,GbRes.M[M].It[S,
       I].Txt,cBlk);
  End;
 End;
 Cl:=0;
End;

Procedure BrDrawClient(Wd_: PWindow);
 Var Dt_: PBRun;
Var X1,Y1,X2,Y2,CY,W,H,CX: Integer;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 CY:=Y1;
 If Dt_^.Form<>Nil Then Begin
  FmLayout(Dt_^.Form,1,8,8,W,H);
  Dt_^.FormH:=H+16;
  Sunken(X1+2,Y1+2,X2-2,Y1+Dt_^.FormH-2,cLGr);
  SetClip(Max2(CX1,X1+3),Max2(CY1,Y1+3),Min2(CX2,X2-3),Min2(CY2,
      Y1+Dt_^.FormH-3));
  FmDrawObj(Dt_^.Form,1,True,X1,Y1);
  ClipFull;
  CY:=Y1+Dt_^.FormH;
 End;
 CX:=X1+Max2(4,((X2-X1)-320) Div 2);
 CY:=CY+4;
 Dt_^.CvX:=CX;Dt_^.CvY:=CY;
 If Not CB^.NoScr Then Begin
  SetClip(Max2(CX1,CX),Max2(CY1,CY),Min2(CX2,CX+319),Min2(CY2,CY+199));
  BrPaintScreen(CX,CY);
  ClipFull;
  GRect(CX-1,CY-1,CX+320,CY+200,cBlk);
 End;
 If Dt_^.Stepping And (CB^.Err='') Then Begin
  GBar(X1+4,Y2-14,X2-4,Y2-3,cYel);
  GText(X1+8,Y2-12,Copy(IntStr(CB^.Ln)+': '+TrimStr(CB^.Src[Max2(1,Min2(CB^.NL,
      CB^.Ln))]^),1,(X2-X1-16) Div 8),cBlk);
 End;
 If CB^.Err<>'' Then Begin
  GBar(X1+4,Y2-14,X2-4,Y2-3,cRed);
  GText(X1+8,Y2-12,Copy(CB^.Err,1,(X2-X1-16) Div 8),cWht);
 End;
End;

Procedure BrFeedInput(Wd_: PWindow; K: Word);
 Var Dt_: PBRun;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;
 If CB^.WaitIn Then Begin
  If K=K_ENTER Then BFinishInput
  Else If K=K_BKSP Then Begin If CB^.InBuf<>'' Then Delete(CB^.InBuf,
      Length(CB^.InBuf),1);End
  Else If (K>=32) And (K<256) And (Length(CB^.InBuf)<60) Then
      CB^.InBuf:=CB^.InBuf+Chr(K);
 End Else If CB^.WaitKey Then Begin
  If (K>=1) And (K<256) Then Begin
   BSetV(BElem(CB^.InVar,0,0),True,0,Chr(K));
   CB^.WaitKey:=False;
  End;
 End Else If (K>=32) And (K<256) Then CB^.LastKey:=Chr(K);
End;

Procedure BrOnKey(Wd_: PWindow; K: Word);
 Var Dt_: PBRun; F: PForm; I: Integer;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;
 F:=Dt_^.Form;
 If (F<>Nil) And (F^.Focus>0) And (Not CB^.WaitIn) And (Not CB^.WaitKey) Then
     Begin
  I:=F^.Focus;
  If F^.O[I].Kind=FK_TEXT Then Begin
   If K=K_BKSP Then Begin
    If F^.O[I].Txt<>'' Then Begin Delete(F^.O[I].Txt,Length(F^.O[I].Txt),1);
    BrPost(Dt_,F^.O[I].Name+'_Change');End;
   End Else If (K>=32) And (K<256) And (Length(F^.O[I].Txt)<58) Then Begin
    F^.O[I].Txt:=F^.O[I].Txt+Chr(K);BrPost(Dt_,F^.O[I].Name+'_Change');
   End;
   Invalidate(Wd_);Exit;
  End;
 End;
 BrFeedInput(Wd_,K);
 Invalidate(Wd_);
End;

{ clics sur le menu, les icones et BUTTON ; retourne True si le clic est
  consomme }
Function BrCanvasMouse(Dt_: PBRun; Var E: TEvent): Boolean;
Var MX,MY,M,S,I,X,W,T,Hh: Integer; Tg: String;
Begin
 BrCanvasMouse:=False;
 CB:=Dt_^.Bas;
 MX:=E.X-Dt_^.CvX;MY:=E.Y-Dt_^.CvY;
 If (MX>=0) And (MX<=319) And (MY>=0) And (MY<=199) Then Begin CB^.MX:=MX;
 CB^.MY:=MY;End;
 If E.Kind<>EV_DOWN Then Exit;
 If Not CB^.Running Then Exit;
 If (MX<0) Or (MX>319) Or (MY<0) Or (MY>199) Then Begin CB^.MenuOpen:=0;Exit;
 End;
 If CB^.BtnL>0 Then BPost(CB^.BtnL);
 M:=CB^.CurMenu;
 If M>0 Then Begin
  If CB^.MenuOpen>0 Then Begin
   S:=CB^.MenuOpen;X:=BrMenuX(M,S);W:=BrMenuW(M,S);
   If (MX>=X-4) And (MX<=X-4+W) And (MY>=12) And (MY<12+GbRes.M[M].NIt[S]*11+2)
       Then Begin
    I:=(MY-13) Div 11+1;
    If (I>=1) And (I<=GbRes.M[M].NIt[S]) Then Begin
     Tg:=GbRes.M[M].It[S,I].Tg;
     If Tg<>'' Then BPost(BFindLine(Tg));
    End;
    CB^.MenuOpen:=0;BrCanvasMouse:=True;Exit;
   End;
   CB^.MenuOpen:=0;
  End;
  If MY<=11 Then Begin
   For S:=1 To GbRes.M[M].NSub Do Begin
    X:=BrMenuX(M,S);
    If (MX>=X-4) And (MX<=X+Length(GbRes.M[M].SubT[S])*8+4) Then
        CB^.MenuOpen:=S;
   End;
   BrCanvasMouse:=True;Exit;
  End;
 End;
 If CB^.CurIcons>0 Then
  For I:=1 To GbRes.I[CB^.CurIcons].N Do
   With GbRes.I[CB^.CurIcons].Ic[I] Do Begin
    T:=BResBmp(Bmp);
    If T>0 Then Begin W:=GbRes.B[T].W;Hh:=GbRes.B[T].H;End Else Begin W:=16;
    Hh:=16;End;
    If (MX>=X) And (MX<=X+W-1) And (MY>=Y) And (MY<=Y+Hh-1) Then Begin
     If Tg<>'' Then BPost(BFindLine(Tg));
     BrCanvasMouse:=True;Exit;
    End;
   End;
End;

Procedure OtClick(Wd_: PWindow; I: Integer); Forward;
Function OtCommand(Wd_: PWindow; Cmd: Integer): Boolean; Forward;

Procedure BrOnMouse(Wd_: PWindow; Var E: TEvent);
 Var Dt_: PBRun; F: PForm; X1,Y1,X2,Y2,I,P: Integer;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;F:=Dt_^.Form;
 If BrCanvasMouse(Dt_,E) Then Begin Invalidate(Wd_);Exit;End;
 If CB^.MenuOpen>0 Then Invalidate(Wd_);
 If F=Nil Then Exit;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 If (E.Kind=EV_MOVE) And (Dt_^.Dragging>0) Then Begin
  I:=Dt_^.Dragging;
  P:=E.X-(F^.O[I].X+X1)-TextW(F^.O[I].Title)-8;
  F^.O[I].Val:=F^.O[I].Min+P*(F^.O[I].Max-F^.O[I].Min) Div Max2(1,
      F^.O[I].W-TextW(F^.O[I].Title)-8-38);
  If F^.O[I].Val<F^.O[I].Min Then F^.O[I].Val:=F^.O[I].Min;
  If F^.O[I].Val>F^.O[I].Max Then F^.O[I].Val:=F^.O[I].Max;
  Invalidate(Wd_);Exit;
 End;
 If E.Kind=EV_UP Then Begin
  If Dt_^.Dragging>0 Then BrPost(Dt_,F^.O[Dt_^.Dragging].Name+'_Change');
  Dt_^.Dragging:=0;Exit;
 End;
 If E.Kind<>EV_DOWN Then Exit;
 I:=FmHit(F,E.X-X1,E.Y-Y1);
 While (I>0) And (F^.O[I].Kind In [FK_PRIMARY,FK_INTER,FK_IGROUP,FK_BGROUP,
     FK_DGROUP,FK_DISPLAY]) Do I:=0;
 If I=0 Then Exit;
 If Not (F^.O[I].Enabled And F^.O[I].Usable) Then Exit;
 Case F^.O[I].Kind Of
  FK_TRIG,FK_DCTRL: If Dt_^.Tree Then OtClick(Wd_,I) Else BrPost(Dt_,
      F^.O[I].Name+'_Click');
  FK_BOOL: Begin F^.O[I].Checked:=Not F^.O[I].Checked;
  BrPost(Dt_,F^.O[I].Name+'_Click');End;
  FK_ITEM: Begin
    If F^.O[I].Parent>0 Then F^.O[F^.O[I].Parent].Val:=I;
    BrPost(Dt_,F^.O[I].Name+'_Select');
    If F^.O[I].Parent>0 Then BrPost(Dt_,F^.O[F^.O[I].Parent].Name+'_Change');
   End;
  FK_VALUE: Begin Dt_^.Dragging:=I;E.Kind:=EV_MOVE;BrOnMouse(Wd_,E);End;
  FK_TEXT: F^.Focus:=I;
 End;
 Invalidate(Wd_);
End;

{ lance le sous-programme d'une interruption (menu, icone, BUTTON, PROCESS) }
Procedure BDispatch;
Var L,I: Integer;
Begin
 L:=CB^.Pnd[1];
 For I:=1 To CB^.NPnd-1 Do CB^.Pnd[I]:=CB^.Pnd[I+1];
 Dec(CB^.NPnd);
 If CB^.NG>=BMAXGS Then Exit;
 Inc(CB^.NG);
 If CB^.WaitMain Then Begin CB^.GsL[CB^.NG]:=CB^.MainL;
 CB^.GsP[CB^.NG]:=CB^.MainP;CB^.WaitMain:=False;End
 Else Begin CB^.GsL[CB^.NG]:=CB^.Ln;CB^.GsP[CB^.NG]:=CB^.Ps;End;
 CB^.IntBase:=CB^.NG;
 BGotoLine(L);
End;

Function BrIdle(Wd_: PWindow): Boolean;
 Var Dt_: PBRun; N,I: Integer; Moved: Boolean; L: Integer;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;
 BrIdle:=False;
 If CB^.WaitIn Or CB^.WaitKey Then Begin BrIdle:=True;Exit;End;
 { processus periodiques }
 If CB^.Running Then
  For I:=1 To 8 Do
   If (CB^.Procs[I].L>0) And (NowCs-CB^.Procs[I].Last>=CB^.Procs[I].Iv) Then
       Begin
    CB^.Procs[I].Last:=NowCs;BPost(CB^.Procs[I].L);
   End;
 If CB^.Running Then Begin
  N:=0;Moved:=False;
  If Dt_^.Stepping And (Not Dt_^.StepOnce) Then Exit;
  While CB^.Running And (Not CB^.WaitIn) And (Not CB^.WaitKey) And (N<400) Do
      Begin
   If (CB^.NPnd>0) And (CB^.IntBase=0) Then Begin BDispatch;Moved:=True;End;
   If CB^.WaitMain Then Break;
   If CB^.Ps>Length(CB^.Ln_) Then BNextLine
   Else BStmts;
   If (CB^.Ps>Length(CB^.Ln_)) And CB^.Running And (Not CB^.WaitIn)
       And (Not CB^.WaitKey) And (Not CB^.WaitMain) Then BNextLine;
   Inc(N);Moved:=True;
   If Dt_^.Stepping Then Begin Dt_^.StepOnce:=False;Break;End;
  End;
  { ONERR : saut vers le gestionnaire d'erreur }
  If CB^.ErrJump Then Begin
   CB^.ErrJump:=False;L:=CB^.OnErrL;CB^.OnErrL:=0;
   CB^.NG:=0;CB^.NLp:=0;CB^.NF:=0;CB^.IntBase:=0;CB^.WaitMain:=False;
   CB^.NPnd:=0;
   CB^.Done:=False;CB^.Running:=True;CB^.Err:='';
   BGotoLine(L);Moved:=True;
  End;
  If CB^.Err<>'' Then Begin CB^.Running:=False;End;
  BrIdle:=Moved Or CB^.WaitIn Or CB^.WaitKey;
  If (Not CB^.Running) And Dt_^.InSub Then Dt_^.InSub:=False;
  Exit;
 End;
 If Dt_^.InSub Then Dt_^.InSub:=False;
 If (Dt_^.NQ>0) And Dt_^.Alive Then Begin
  BrStartSub(Dt_,Dt_^.Queue[1]);
  For N:=1 To Dt_^.NQ-1 Do Dt_^.Queue[N]:=Dt_^.Queue[N+1];
  Dec(Dt_^.NQ);
  BrIdle:=True;
 End;
End;

Procedure BrShowVars;
Var I,N: Integer; L,V: String;
Begin
 L:='';N:=0;
 For I:=1 To CB^.NV Do Begin
  If N>=12 Then Break;
  If CB^.Var_[I].Dims=0 Then Begin
   If CB^.Var_[I].IsS Then V:='"'+CB^.Var_[I].P^[0].T+'"' Else
       V:=FmtReal(CB^.Var_[I].P^[0].N);
  End Else V:='('+IntStr(CB^.Var_[I].D1)+','+IntStr(CB^.Var_[I].D2)+')';
  If L<>'' Then L:=L+'|';
  L:=L+CB^.Var_[I].Name+' = '+V;Inc(N);
 End;
 If L='' Then L:=T3('(no variables)','(aucune variable)','(keine Variablen)');
 L:=T3('Line ','Ligne ','Zeile ')+IntStr(CB^.Ln)+'|'+L;
 Info(T3('Variables','Variables','Variablen'),L);
End;

Procedure BrOnCommand(Wd_: PWindow; Cmd: Integer);
 Var Dt_: PBRun;
Begin
 Dt_:=Wd_^.Data;CB:=Dt_^.Bas;
 Case Cmd Of
  CM_BRSTOP: Begin CB^.Running:=False;CB^.WaitIn:=False;CB^.WaitKey:=False;
  CB^.WaitMain:=False;Dt_^.Alive:=False;
  BPutS(T3('*** Stopped ***','*** Arr'#136't ***','*** Angehalten ***')+#13);
  End;
  CM_BRCLS: BCls;
  CM_BRPAUSE: Begin Dt_^.Stepping:=Not Dt_^.Stepping;Dt_^.StepOnce:=False;End;
  CM_BRSTEP: Begin Dt_^.Stepping:=True;Dt_^.StepOnce:=True;End;
  CM_BRVARS: BrShowVars;
  CM_BRRESTART: Begin
    BCls;BFreeVars(CB);CB^.Err:='';CB^.NF:=0;CB^.NG:=0;CB^.WaitIn:=False;
    CB^.WaitKey:=False;CB^.CurMenu:=0;CB^.CurIcons:=0;CB^.MenuOpen:=0;
    CB^.BtnL:=0;CB^.OnErrL:=0;
    FillChar(CB^.Procs,SizeOf(CB^.Procs),0);CB^.NFn:=0;CB^.CurR:=0;CB^.CurC:=0;
    CB^.WX1:=0;CB^.WY1:=0;CB^.WX2:=39;CB^.WY2:=24;
    Dt_^.Alive:=Dt_^.Form<>Nil;Dt_^.NQ:=0;
    BrBegin(Dt_);
   End;
 Else Begin
  If Not OtCommand(Wd_,Cmd) Then CommonCmd(Wd_,Cmd);
  Exit;
 End;
 End;
 Invalidate(Wd_);
End;


