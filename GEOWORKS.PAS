Procedure TPrefs.Module(I: Integer);
Var R,K: Integer; S: String; Y,M,D,W,H,Mi,Sc,C: Word;
Begin
 Case I Of
  6: Begin
      R:=ChoiceBox(T3('Background','Fond d''ecran','Hintergrund'),T3('Pattern:','Motif :','Muster:'),
        T3('None|Bricks|Chocolate|Cubes|Pebble|Pipes|Tiles|Vines|Weave|Logo','Aucun|Briques|Chocolat|Cubes|Galets|Tuyaux|Tuiles|Vigne|Tissage|Logo','Keines|Ziegel|Schokolade|W'#129'rfel|Kiesel|Rohre|Fliesen|Ranken|Gewebe|Logo'),DeskBack+2);
      If R>0 Then Begin
       K:=ChoiceBox(T3('Background','Fond d''ecran','Hintergrund'),T3('Color:','Couleur :','Farbe:'),ColorList,DeskPaper+1);
       If K>0 Then Begin
        If R=1 Then SetDesktopBack(-1,cBlk,K-1)
        Else Begin
         If K-1=cBlk Then SetDesktopBack(R-2,cWht,cBlk) Else SetDesktopBack(R-2,cBlk,K-1);
        End;
        NeedFull:=True;
       End;
      End;
     End;
  1: Begin
      R:=ChoiceBox(T3('International','International','International'),T3('Language:','Langue :','Sprache:'),'English|Fran'#135'ais|Deutsch',Lang+1);
      If R>0 Then Begin Lang:=R-1;Clock24:=Lang<>0;NeedFull:=True;End;
     End;
  8: Begin
      GetDate(Y,M,D,W);GetTime(H,Mi,Sc,C);
      Info(T3('Date & Time','Date et heure','Datum & Zeit'),LongDateStr(Y,M,D,W)+'|'+TimeStr(H,Mi)+'|'+
        T3('Set the date and time with the DOS commands DATE and TIME.',
           'R'#130'glez la date et l''heure avec les commandes DOS DATE et TIME.',
           'Datum und Uhrzeit mit den DOS-Befehlen DATE und TIME einstellen.'));
     End;
  3: Begin
      R:=ChoiceBox(T3('Mouse','Souris','Maus'),T3('Double-click speed:','Vitesse du double-clic :','Doppelklick-Geschwindigkeit:'),
        T3('Fast|Medium|Slow','Rapide|Moyenne|Lente','Schnell|Mittel|Langsam'),3-Ord(DblCs<=25)-Ord(DblCs>=55)*2+1);
      Case R Of 1: DblCs:=25; 2: DblCs:=40; 3: DblCs:=60; End;
     End;
  7: Begin
      Info(T3('Computer','Ordinateur','Computer'),
       'PC/GEOS clone '+VERSION_TEXT+'|'+T3('Video: VGA 640x480, 16 colors','Vid'#130'o : VGA 640x480, 16 couleurs','Video: VGA 640x480, 16 Farben')+'|'+
       T3('Free memory: ','M'#130'moire libre : ','Freier Speicher: ')+NumFmt(FreeMemory)+' '+T3('bytes','octets','Bytes')+'|'+
       T3('World directory: ','R'#130'pertoire WORLD : ','WORLD-Verzeichnis: ')+WorldDir);
     End;
  0: Info(T3('Video','Vid'#130'o','Video'),T3('VGA 640x480 with 16 colors.','VGA 640x480 avec 16 couleurs.','VGA 640x480 mit 16 Farben.'));
  14: Begin
       SoundOn:=Not SoundOn;
       If SoundOn Then S:=T3('Sound is on.','Le son est activ'#130'.','Ton ist an.') Else S:=T3('Sound is off.','Le son est d'#130'sactiv'#130'.','Ton ist aus.');
       Info(T3('Sound','Son','Ton'),S);
      End;
  13: Begin
       R:=ChoiceBox(T3('Look & Feel','Aspect','Aussehen'),T3('User level:','Niveau utilisateur :','Benutzerstufe:'),
          T3('Beginner|Intermediate|Advanced','D'#130'butant|Interm'#130'diaire|Avanc'#130,'Anf'#132'nger|Fortgeschritten|Experte'),Level+1);
       If R>0 Then Level:=R-1;
      End;
 Else Info(TL(PrefNames[I]),T3('This module has no settings in this clone.','Ce module n''a pas de r'#130'glages dans ce clone.','Dieses Modul hat in diesem Klon keine Einstellungen.'));
 End;
End;

Procedure TPrefs.OnMouse(Var E: TEvent);
Var I,X1,Y1,X2,Y2: Integer;
Begin
 If E.Kind=EV_DOWN Then
  For I:=0 To 15 Do Begin
   CellRect(I,X1,Y1,X2,Y2);
   If InBox(E.X,E.Y,X1,Y1,X2,Y2) Then Begin
    Sel:=I;Invalidate(@Self);
    If E.Dbl Then Module(I);
   End;
  End;
End;

Procedure TPrefs.OnKey(K: Word);
Begin
 Case K Of
  K_LEFT: If Sel>0 Then Dec(Sel);
  K_RIGHT: If Sel<15 Then Inc(Sel);
  K_UP: If Sel>=4 Then Dec(Sel,4);
  K_DOWN: If Sel<12 Then Inc(Sel,4);
  K_ENTER: Module(Sel);
 End;
 Invalidate(@Self);
End;

Procedure TPrefs.OnCommand(Cmd: Integer);
Begin
 CommonCmd(@Self,Cmd);
End;

