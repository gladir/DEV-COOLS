Procedure ShowHelp;
Begin
 WriteLn('GEOWORKS - Clone de l''environnement '+
     'graphique GeoWorks Ensemble / '+'Pro');
 WriteLn('Version ',VERSION_TEXT);
 WriteLn;
 WriteLn('Syntaxe : GEOWORKS [options] [fichier]');
 WriteLn;
 WriteLn('  /?, -?, /H, --help   Affiche cette aide');
 WriteLn('  /L:langue            Force la langue (EN, FR ou GR/DE)');
 WriteLn('  /W:repertoire        Repertoire '+'WORLD de GeoWorks (par defaut '+
     ': detection)');
 WriteLn('  /B:niveau            Niveau '+': 1 debutant, 2 intermediaire, '+
     '3 avance');
 WriteLn('  /F:n                 Fond d''ecran '+
     ': 0 uni, 1 Bricks, 2 Chocolate, '+'3 Cubes, 4 Pebble,');
 WriteLn('                       5 Pipes, 6 Tiles, 7 Vines, 8 Weave, 9 Logo');
 WriteLn('  /E                   Ouvre '+
     'le fichier .GEO donne dans l''emulateur '+'de geodes');
 WriteLn('  /NOWELCOME           Demarre directement sur le bureau');
 WriteLn('  /R:application       Lance '+'une application au demarrage (CALC, '+
     'CLOCK, TETRIS,');
 WriteLn('                       SOLITAIRE, '+'WRITE, DRAW, PLANNER, GEODEX, '+
     '...)');
 WriteLn('  /BAS:fichier.BAS     Execute '+'un programme GeoBASIC (ressources '+
     'FICHIER.GBR)');
 WriteLn('  fichier              Fichier '+'.GEO, .000, texte... a ouvrir '+
     'au demarrage');
 WriteLn;
 WriteLn('Variable d''environnement LANGUAGE '+
     ': EN = anglais, GR (ou DE) = allemand,');
 WriteLn('toute autre valeur = francais.');
 WriteLn;
 WriteLn('Exemples :');
 WriteLn('  GEOWORKS');
 WriteLn('  GEOWORKS /L:EN /W:C:\GEOWORKS\WORLD');
 WriteLn('  GEOWORKS C:\GEOWORKS\WORLD\CALC.GEO');
 WriteLn;
 WriteLn('Raccourcis : F10 menus, F6 fenetre '+
     'suivante, Alt+F4 fermer, Echap '+'annuler.');
End;

Function DetectLanguage: Integer;
Var S: String;
Begin
 S:=Upper(GetEnv('LANGUAGE'));
 If (S='EN') Or (Copy(S,1,3)='EN_') Or (Copy(S,1,
     3)='EN.') Then DetectLanguage:=0
 Else If (S='GR') Or (S='DE') Or (Copy(S,1,3)='DE_') Then DetectLanguage:=2
 Else DetectLanguage:=1;
End;

Procedure DetectWorld;
Var S: String; I: Integer;
Const Cand : Array[1..8] Of String[30] = (
  '\GEOWORKS\WORLD','C:\GEOWORKS\WORLD','C:\GEOS20\WORLD','C:\ENSEMBLE\WORLD',
  '\GEOS20\WORLD','C:\GEOS\WORLD','WORLD','..\WORLD');
Begin
 WorldDir:='';
 S:=GetEnv('GEOWORKS_WORLD');
 If (S<>'') And DirExists(S) Then Begin WorldDir:=S;Exit;End;
 S:=DirOf(ParamStr(0));
 If DirExists(JoinPath(S,'WORLD')) Then Begin WorldDir:=JoinPath(S,'WORLD');
 Exit;End;
 For I:=1 To 8 Do
  If DirExists(Cand[I]) Then Begin WorldDir:=Cand[I];Exit;End;
End;

Var
 I,R,Choice,StartLvl: Integer;
 Arg,StartFile,RunParam: String;
 NoWelcome: Boolean;
 M: PWindow;
 RunApp,BgOpt,A: Integer;
 ForceEmu: Boolean;

BEGIN
 Lang:=DetectLanguage;
 StartFile:='';RunParam:='';NoWelcome:=False;StartLvl:=2;RunApp:=0;BgOpt:=0;
 ForceEmu:=False;
 DetectWorld;
 For I:=1 To ParamCount Do Begin
  Arg:=ParamStr(I);
  If FileExists(Arg) Then StartFile:=Arg
  Else If (Arg='/?') Or (Arg='-?') Or (Upper(Arg)='/H') Or (Upper(Arg)='-H') Or
     (Upper(Arg)='--HELP') Or (Upper(Arg)='/HELP') Then Begin
   ShowHelp;
   Halt(0);
  End Else If Upper(Copy(Arg,1,3))='/L:' Then Begin
   Arg:=Upper(Copy(Arg,4,10));
   If Arg='EN' Then Lang:=0 Else If (Arg='GR') Or (Arg='DE') Then Lang:=2 Else
       Lang:=1;
  End Else If Upper(Copy(Arg,1,3))='/W:' Then Begin
   WorldDir:=Copy(Arg,4,200);
   If Not DirExists(WorldDir) Then WorldDir:='';
  End Else If Upper(Copy(Arg,1,3))='/B:' Then Begin
   StartLvl:=Clamp(StrVal(Copy(Arg,4,3),2),1,3);LvlGiven:=True;
  End Else If Upper(Copy(Arg,1,3))='/R:' Then Begin
   Arg:=Upper(Copy(Arg,4,30));
   For R:=1 To NAPPS Do
    If (Upper(Part3(AppNameTab[R],0))=Arg) Or (Upper(Part3(AppNameTab[R],
        1))=Arg) Or
       ((Copy(Upper(Part3(AppNameTab[R],0)),1,
           3)='GEO') And (Copy(Upper(Part3(AppNameTab[R],0)),4,20)=Arg)) Or
       ((Arg='SOLITAIRE') And (R=A_SOLIT)) Then RunApp:=R;
   If (Arg='GEOBASIC') Or (Arg='BASIC') Then RunApp:=A_GEOBASIC;
   If (Arg='TREE') Then RunApp:=A_TREE;
   If (Arg='DUMP') Then RunApp:=A_DUMP;
   If Arg='SCRAP' Then RunApp:=A_SCRAP;
   If Arg='COMM' Then RunApp:=A_COMM;
   If Arg='AOL' Then RunApp:=A_AOL;
   If Arg='TEXT' Then RunApp:=A_TEXTED;
   If (Arg='WRITE') Or (Arg='GEOWRITE') Then RunApp:=A_WRITE;
   If (Arg='CALC') Or (Arg='CALCULATOR') Then RunApp:=A_CALC;
   If Arg='SOLITAIRE' Then RunApp:=A_SOLIT;
   If (Arg='NOTES') Or (Arg='NOTEPAD') Then RunApp:=A_NOTEPAD;
   If (Arg='MANAGER') Then RunApp:=A_MANAGER;
   If (Arg='PLANNER') Then RunApp:=A_PLANNER;
   If (Arg='DEX') Or (Arg='GEODEX') Then RunApp:=A_DEX;
   If (Arg='BANNER') Then RunApp:=A_BANNER;
   If (Arg='PREFS') Or (Arg='PREFERENCES') Then RunApp:=A_PREFS;
  End Else If Upper(Copy(Arg,1,5))='/BAS:' Then Begin
   RunApp:=A_BASRUN;RunParam:=Copy(Arg,6,200);
  End Else If Upper(Copy(Arg,1,3))='/F:' Then Begin
   BgOpt:=StrVal(Copy(Arg,4,3),0);
  End Else If Upper(Arg)='/E' Then ForceEmu:=True
  Else If Upper(Arg)='/NOWELCOME' Then NoWelcome:=True
  Else If (Arg<>'') And FileExists(Arg) Then StartFile:=Arg;
 End;
 GetDir(0,HomeDir);
 BaseDir:=DirOf(ParamStr(0));
 Level:=StartLvl-1;
 NWins:=0;NextId:=1;NewWinCount:=0;Capture:=Nil;
 DeskBack:=-1;DeskInk:=cBlk;DeskPaper:=cDGr;
 WelcomeOn:=True;GeosLevel:=0;TaskOn:=True;TaskKey:=K_F6;CalcDecPl:=-1;
 LeftHand:=False;LightsMin:=0;LightsOk:=False;LastActCs:=0;KeyDelay:=2;
 KeyRate:=3;ModemPort:=1;ModemBaud:=5;ModemTone:=True;ModemInit:='ATZ';
 PrinterSel:=1;PrinterPort:=1;TextSize:=2;
 IntlDefaults;Clock24:=Lang<>0;DblCs:=40;ClipIconId:=-1;SoundOn:=True;Randomize;
 If Not MouseDriverFound Then Begin
  WriteLn('Pilote de souris non trouve.');
  Halt(1);
 End;
 InitializeGraphics;
 InitCursor;
 LoadIcons;
 LoadBackgrounds;
 SetDesktopBack(-1,cBlk,cDGr);
 PrefsLoad;
 If Not WelcomeOn Then NoWelcome:=True;
 If (GeosLevel>0) And Not LvlGiven Then Begin StartLvl:=GeosLevel;
 Level:=StartLvl-1;End;
 SetDesktopBack(DeskBack,DeskInk,DeskPaper);
 If (BgOpt>=1) And (BgOpt<=NBACK) Then Begin
  If BgOpt=7 Then SetDesktopBack(BgOpt-1,cBlk,cGrn) Else SetDesktopBack(BgOpt-1,
      cBlk,cLGr);
 End;
 MX:=SCR_W Div 2;MY:=SCR_H Div 2;
 ShowMouse;
 Repeat
  If NoWelcome Then Choice:=StartLvl Else Choice:=WelcomeScreen;
  NoWelcome:=False;
  If Choice<=0 Then R:=2
  Else Begin
   If Choice<=3 Then Level:=Choice-1 Else Level:=1;
   NWins:=0;
   If Choice=4 Then DosScreen
   Else If (Choice=1) And (StartFile='') And (RunApp=0) Then Begin
    R:=1;
    Repeat
     A:=BeginnerScreen;
     If A>0 Then Begin
      LaunchApp(A,'');
      If NWins>0 Then MaximizeWin(Wins[NWins]);
      R:=DesktopLoop;
      While NWins>0 Do RemoveWindow(Wins[NWins]);
     End;
    Until (A=0) Or (R=2);
    If A=0 Then R:=1;
   End Else Begin
    LaunchApp(A_MANAGER,'');
    If (Level=0) And (NWins>0) Then MaximizeWin(Wins[1]);
   End;
   If StartFile<>'' Then Begin
    If ForceEmu Then LaunchApp(A_GEODE,StartFile) Else LaunchFile(StartFile);
    StartFile:='';
   End;
   If RunApp<>0 Then Begin LaunchApp(RunApp,RunParam);RunApp:=0;End;
   R:=DesktopLoop;
   While NWins>0 Do RemoveWindow(Wins[NWins]);
  End;
 Until R=2;
 HideMouse;
 CloseGraph;
 WriteLn('GeoWorks Ensemble (clone) - '+T3('Thank you!','Merci !','Danke!'));
END.
