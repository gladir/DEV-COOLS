Procedure GbDupSel;
Var F: PForm; I,J: Integer;
Begin
 F:=GbProj^.Form;
 If (F^.Sel<=1) Or (F^.N>=FMAX) Then Exit;
 Inc(F^.N);J:=F^.N;F^.O[J]:=F^.O[F^.Sel];
 F^.O[J].Name:=Copy(F^.O[J].Name,1,16)+'x';
 F^.Sel:=J;GbRefresh;
End;

Procedure GbMove(D: Integer);
Var F: PForm; I,J,K: Integer; T: TFObj;
Begin
 F:=GbProj^.Form;I:=F^.Sel;
 If (I<=1) Or (I>F^.N) Then Exit;
 { echange avec le frere precedent / suivant (meme parent) }
 J:=I+D;
 While (J>=2) And (J<=F^.N) And (F^.O[J].Parent<>F^.O[I].Parent) Do J:=J+D;
 If (J<2) Or (J>F^.N) Then Exit;
 { les parents sont des indices : on echange aussi les references }
 T:=F^.O[I];F^.O[I]:=F^.O[J];F^.O[J]:=T;
 For K:=1 To F^.N Do Begin
  If F^.O[K].Parent=I Then F^.O[K].Parent:=-1
  Else If F^.O[K].Parent=J Then F^.O[K].Parent:=I;
 End;
 For K:=1 To F^.N Do If F^.O[K].Parent=-1 Then F^.O[K].Parent:=J;
 F^.Sel:=J;GbRefresh;
End;

Procedure GbIdeCommand(Wd_: PWindow; Cmd: Integer);
Var P: String;
Begin
 Case Cmd Of
  CM_GBNEW: Begin GbSample;GbProj^.Path:='';
  GbProj^.Msg:=T3('New form','Nouveau formulaire','Neues Formular');GbRefresh;
  End;
  CM_GBOPEN: GbIdeAction(Wd_,5);
  CM_GBSAVE: GbIdeAction(Wd_,6);
  CM_GBSAVEAS: Begin GbProj^.Path:='';GbIdeAction(Wd_,6);End;
  CM_GBADD: GbIdeAction(Wd_,1);
  CM_GBPROP: GbIdeAction(Wd_,2);
  CM_GBCODE: GbIdeAction(Wd_,3);
  CM_GBRUN: GbRun;
  CM_GBUTIL+1..CM_GBUTIL+5: GbResEdit(Cmd-CM_GBUTIL);
  CM_GBRLOAD: Begin
    P:='';
    If FileDlg(T3('Open Resources','Ouvrir les ressources',
        'Ressourcen '#148'ffnen'),'*.GBR',P,False) Then Begin
     If ResLoad(P) Then Begin GbProj^.ResPath:=P;
     GbProj^.Msg:=T3('Resources loaded','Ressources charg'#130'es',
         'Ressourcen geladen');End
     Else Info('GeoBASIC',T3('Not a resource file.',
         'Ce n''est pas un fichier de ressources.','Keine Ressourcendatei.'));
    End;
   End;
  CM_GBRSAVE: Begin
    P:=GbProj^.ResPath;
    If P='' Then P:=JoinPath(CurDirStr,'PROGRAM.GBR');
    If FileDlg(T3('Save Resources','Enregistrer les ressources',
        'Ressourcen speichern'),'*.GBR',P,True) Then Begin
     ResSave(P);GbProj^.ResPath:=P;GbProj^.Msg:=T3('Saved ',
         'Enregistr'#130' : ','Gespeichert: ')+ShortName(P);
    End;
   End;
  CM_GBSAVEBAS: If GbAlive(GbProj^.CodeW) Then WinCommand(GbProj^.CodeW,
      CM_SAVE) Else GbOpenCode;
  CM_GBDEL: GbDeleteSel;
  CM_GBDUP: GbDupSel;
  CM_GBUP: GbMove(-1);
  CM_GBDOWN: GbMove(1);
  CM_GBFORM: GbShowWin(GbProj^.FormW,A_GBFORM,30,100,380,290,
      'Untitled Primary');
  CM_GBABOUT: Info('GeoBasic','GeoBasic - '+
      T3('visual BASIC for the GEOS clone','BASIC visuel pour le clone GEOS',
      'visuelles BASIC f'#129'r den GEOS-Klon')+'|'+
      T3('Build a GEOS interface (GenPrimary, '+
          'GenTrigger...) and program it '+'in BASIC.',
        'Construisez une interface GEOS '+'(GenPrimary, GenTrigger...) et '+
            'programmez-la en BASIC.',
        'Bauen Sie eine GEOS-Oberfl'#132+
            'che und programmieren Sie sie in BASIC.'));
 Else Begin CommonCmd(Wd_,Cmd);Exit;End;
 End;
 Invalidate(Wd_);
End;

Function GbIdeIdle(Wd_: PWindow): Boolean;
Var H: Integer;
Begin
 H:=GbIdeHover(Wd_);
 GbIdeIdle:=False;
 If H<>GbProj^.Hover Then Begin GbProj^.Hover:=H;GbIdeIdle:=True;End;
End;

{ ---------------------- palette Add Object ---------------------- }

Procedure GbAddRect(Wd_: PWindow; I: Integer; Var X1,Y1,X2,Y2: Integer);
Var CX1,CY1,CX2,CY2: Integer;
Begin
 WinClientRect(Wd_,CX1,CY1,CX2,CY2);
 X1:=CX1+6;Y1:=CY1+6+(I-1)*23;X2:=CX2-6;Y2:=Y1+20;
End;

Procedure GbAddDraw(Wd_: PWindow);
Var X1,Y1,X2,Y2,I,A,B,C,D: Integer;
Begin
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 For I:=1 To 11 Do Begin
  GbAddRect(Wd_,I,A,B,C,D);
  Button(A,B,C,D,FKName[I+1],False,False,True);
 End;
End;

Procedure GbAddMouse(Wd_: PWindow; Var E: TEvent);
Var I,A,B,C,D: Integer;
Begin
 If E.Kind<>EV_DOWN Then Exit;
 For I:=1 To 11 Do Begin
  GbAddRect(Wd_,I,A,B,C,D);
  If InBox(E.X,E.Y,A,B,C,D) Then GbAddObject(I+1);
 End;
End;

{ ---------------------- fenetre Properties ---------------------- }

Type
 TPRow = Record Lb: String[28]; Id: Byte; End;

Function GbRows(Var R: Array Of TPRow): Integer;
Var F: PForm; I,N: Integer;
 Procedure Add(Const L: String; Id: Byte);
 Begin
  If N<=High(R) Then Begin R[N].Lb:=L;R[N].Id:=Id;Inc(N);End;
 End;
Begin
 F:=GbProj^.Form;I:=F^.Sel;N:=0;
 If (I<1) Or (I>F^.N) Then Begin GbRows:=0;Exit;End;
 Add('',0);                     { ligne d'objet }
 Add('Name',1);
 Add('Title',2);
 Case F^.O[I].Kind Of
  FK_PRIMARY: Begin Add('Width Hints',3);Add('Height Hints',4);
  Add('Children Orientation Hints',5);Add('Moniker Placement',6);
  Add('Window Features',7);End;
  FK_INTER,FK_IGROUP,FK_BGROUP,FK_DGROUP,FK_DISPLAY: Begin Add('Width Hints',3);
  Add('Height Hints',4);Add('Children Orientation Hints',5);End;
  FK_VALUE: Begin Add('Value',8);Add('Minimum',9);Add('Maximum',10);End;
  FK_TEXT: Add('Text',11);
  FK_BOOL: Add('Checked',12);
  FK_ITEM: Add('Default (selected)',13);
 End;
 If F^.O[I].Kind<>FK_PRIMARY Then Begin Add('Enabled',14);Add('Usable',15);End;
 If F^.O[I].Kind<>FK_PRIMARY Then Add('Parent',16);
 GbRows:=N;
End;

Procedure GbPropDraw(Wd_: PWindow);
Var X1,Y1,X2,Y2,I,N,Y: Integer; R: Array[0..15] Of TPRow; F: PForm; S: String;
K: Integer;
Begin
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 GBar(X1,Y1,X2,Y2,cLGr);
 F:=GbProj^.Form;K:=F^.Sel;
 N:=GbRows(R);
 Y:=Y1+6;
 For I:=0 To N-1 Do Begin
  Case R[I].Id Of
   0: Begin
       Btn3D(X1+6,Y,X2-6,Y+18,False);
       GText(X1+12,Y+5,F^.O[K].Name+'  ('+FKName[F^.O[K].Kind]+')',cBlk);
       GArrow(X2-14,Y+9,2,cBlk);
      End;
   1: Begin GText(X1+10,Y+5,'Name',cBlk);Sunken(X1+70,Y,X2-6,Y+18,cWht);
   GText(X1+74,Y+5,F^.O[K].Name,cBlk);End;
   2: Begin GText(X1+10,Y+5,'Title',cBlk);Sunken(X1+70,Y,X2-6,Y+18,cWht);
   GText(X1+74,Y+5,Copy(F^.O[K].Title,1,(X2-X1-84) Div 8),cBlk);End;
   8: Begin GText(X1+10,Y+5,'Value',cBlk);Sunken(X1+100,Y,X2-6,Y+18,cWht);
   GText(X1+104,Y+5,IntStr(F^.O[K].Val),cBlk);End;
   9: Begin GText(X1+10,Y+5,'Minimum',cBlk);Sunken(X1+100,Y,X2-6,Y+18,cWht);
   GText(X1+104,Y+5,IntStr(F^.O[K].Min),cBlk);End;
   10: Begin GText(X1+10,Y+5,'Maximum',cBlk);Sunken(X1+100,Y,X2-6,Y+18,cWht);
   GText(X1+104,Y+5,IntStr(F^.O[K].Max),cBlk);End;
   11: Begin GText(X1+10,Y+5,'Text',cBlk);Sunken(X1+70,Y,X2-6,Y+18,cWht);
   GText(X1+74,Y+5,Copy(F^.O[K].Txt,1,(X2-X1-84) Div 8),cBlk);End;
   12,13,14,15: Begin
       S:=R[I].Lb;
       Case R[I].Id Of
        12: If F^.O[K].Checked Then S:=S+': Yes' Else S:=S+': No';
        14: If F^.O[K].Enabled Then S:=S+': Yes' Else S:=S+': No';
        15: If F^.O[K].Usable Then S:=S+': Yes' Else S:=S+': No';
        13: If (F^.O[K].Parent>0) And (F^.O[F^.O[K].Parent].Val=K) Then
            S:=S+': Yes' Else S:=S+': No';
       End;
       Btn3D(X1+6,Y,X2-6,Y+18,False);GText(X1+12,Y+5,S,cBlk);
      End;
   16: Begin
       Btn3D(X1+6,Y,X2-6,Y+18,False);
       If F^.O[K].Parent>0 Then S:=F^.O[F^.O[K].Parent].Name Else S:='-';
       GText(X1+12,Y+5,'Parent: '+S,cBlk);GArrow(X2-14,Y+9,2,cBlk);
      End;
  Else Begin
       Btn3D(X1+6,Y,X2-6,Y+18,False);
       GText(X1+12,Y+5,R[I].Lb,cBlk);GArrow(X2-14,Y+9,2,cBlk);
      End;
  End;
  Inc(Y,23);
 End;
End;

Procedure GbPropMouse(Wd_: PWindow; Var E: TEvent);
Var X1,Y1,X2,Y2,I,N,Y,K,V,J,Q: Integer; R: Array[0..15] Of TPRow; F: PForm;
S: String;
Begin
 If E.Kind<>EV_DOWN Then Exit;
 WinClientRect(Wd_,X1,Y1,X2,Y2);
 F:=GbProj^.Form;K:=F^.Sel;
 N:=GbRows(R);
 Y:=Y1+6;
 For I:=0 To N-1 Do Begin
  If InBox(E.X,E.Y,X1+6,Y,X2-6,Y+18) Then Begin
   Case R[I].Id Of
    0: Begin
        { choix de l'objet courant }
        S:='';
        For J:=1 To F^.N Do Begin If S<>'' Then S:=S+'|';S:=S+F^.O[J].Name;End;
        V:=ChoiceBox(T3('Object','Objet','Objekt'),T3('Select an object:',
            'Choisissez un objet :','Objekt w'#132'hlen:'),S,K);
        If V>0 Then F^.Sel:=V;
       End;
    1: Begin S:=F^.O[K].Name;If InputBox('Properties','Name:',S,
        18) And (S<>'') Then F^.O[K].Name:=S;End;
    2: Begin S:=F^.O[K].Title;If InputBox('Properties','Title:',S,
        38) Then F^.O[K].Title:=S;End;
    3: Begin V:=ChoiceBox('Width Hints','Width:',T3('None|Small|Medium|Large',
        'Aucun|Petit|Moyen|Grand','Keine|Klein|Mittel|Gro'#225),
        F^.O[K].WHint+1);If V>0 Then F^.O[K].WHint:=V-1;End;
    4: Begin V:=ChoiceBox('Height Hints','Height:',T3('None|Small|Medium|Large',
        'Aucun|Petit|Moyen|Grand','Keine|Klein|Mittel|Gro'#225),
        F^.O[K].HHint+1);If V>0 Then F^.O[K].HHint:=V-1;End;
    5: Begin V:=ChoiceBox('Children Orientation Hints','Orientation:',
        T3('Vertical|Horizontal','Verticale|Horizontale','Vertikal|Horizontal'),
        F^.O[K].Orient+1);If V>0 Then F^.O[K].Orient:=V-1;End;
    6: Begin V:=ChoiceBox('Moniker Placement','Placement:',T3('Top|Left',
        'Haut|Gauche','Oben|Links'),F^.O[K].MonPos+1);
    If V>0 Then F^.O[K].MonPos:=V-1;End;
    7: Begin V:=ChoiceBox('Window Features','Features:',
        T3('Standard|Minimize/Maximize|Resizable|Menu bar',
      'Standard|Minimiser/Maximiser|Redimensionnable|Barre '+'de menus',
          'Standard|Min/Max|Gr'#148#225'e '#132'nderbar|Men'#129'leiste'),
          F^.O[K].Feat+1);If V>0 Then F^.O[K].Feat:=V-1;End;
    8: Begin S:=IntStr(F^.O[K].Val);If InputBox('Properties','Value:',S,
        8) Then F^.O[K].Val:=StrVal(S,F^.O[K].Val);End;
    9: Begin S:=IntStr(F^.O[K].Min);If InputBox('Properties','Minimum:',S,
        8) Then F^.O[K].Min:=StrVal(S,F^.O[K].Min);End;
    10: Begin S:=IntStr(F^.O[K].Max);If InputBox('Properties','Maximum:',S,
        8) Then F^.O[K].Max:=StrVal(S,F^.O[K].Max);End;
    11: Begin S:=F^.O[K].Txt;If InputBox('Properties','Text:',S,
        58) Then F^.O[K].Txt:=S;End;
    12: F^.O[K].Checked:=Not F^.O[K].Checked;
    13: If F^.O[K].Parent>0 Then F^.O[F^.O[K].Parent].Val:=K;
    14: F^.O[K].Enabled:=Not F^.O[K].Enabled;
    15: F^.O[K].Usable:=Not F^.O[K].Usable;
    16: Begin
         S:='';V:=0;
         For J:=1 To F^.N Do
          If FmIsContainer(F^.O[J].Kind) And (J<>K) Then Begin If S<>'' Then
              S:=S+'|';S:=S+F^.O[J].Name;End;
         V:=ChoiceBox('Parent','Move to container:',S,1);
         If V>0 Then Begin
          J:=0;
          For Q:=1 To F^.N Do If FmIsContainer(F^.O[Q].Kind) And (Q<>K) Then
              Begin Inc(J);If J=V Then F^.O[K].Parent:=Q;End;
         End;
        End;
   End;
   GbRefresh;
   Exit;
  End;
  Inc(Y,23);
 End;
End;

