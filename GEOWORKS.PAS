Const
 CM_GRUN=900+50; CM_GRESET=951; CM_GREPORT=952; CM_GSAVE=953;
 MAXGSEG = 64;
 MAXGEXP = 256;
 MAXGLIB = 32;
 MAXGLN  = 700;

Type
 TGSeg = Record Len,Fix,Flg: Word; Pos: LongInt; End;
 TGLib = Record Name: String[8]; Typ: Word; Proto: Word; End;
 TGExp = Record Ofs,Res: Word; End;

 TGeode = Record
  Valid   : Boolean;
  Path    : String;
  Info    : TGeosInfo;
  HdrPos  : LongInt;
  Attr,AType,Stack : Word;
  Name    : String[8];
  Ext     : String[4];
  NE,NL,NS : Word;
  Libs    : Array[0..MAXGLIB-1] Of TGLib;
  Exp     : Array[0..MAXGEXP-1] Of TGExp;
  Seg     : Array[0..MAXGSEG-1] Of TGSeg;
  ProcOfs,ProcRes,EntOfs,EntRes,AppOfs,AppRes,DrvOfs,DrvRes : Word;
  FileLen : LongInt;
  Kernel  : Word;
 End;

Function GKindName(T: Word): String;
Begin
 Case T Of
  1: GKindName:=T3('Application','Application','Anwendung');
  2: GKindName:=T3('Library','Biblioth'#138'que','Bibliothek');
  3: GKindName:=T3('Driver','Pilote','Treiber');
  5: GKindName:=T3('Application (2.x)','Application (2.x)','Anwendung (2.x)');
 Else GKindName:='?';
 End;
End;

{ Analyse de l'en-tete d'un geode ; retourne False si invalide }
Function ParseGeode(Const Path: String; Var G: TGeode): Boolean;
Var F: File; Hd: Array[0..511] Of Byte; N: Word; P: PByteArr; Base,LibPos,ExpPos,SegPos: LongInt;
    I: Integer; Buf: Array[0..1023] Of Byte; B2: PByteArr; Cnt: Word;

 Function W(Pos: Integer): Word;
 Begin
  W:=P^[Pos]+256*P^[Pos+1];
 End;

Begin
 ParseGeode:=False;
 FillChar(G,SizeOf(G),0);
 G.Path:=Path;
 If Not ReadGeosHeader(Path,G.Info) Then Exit;
 If Not G.Info.IsExe Then Exit;
 {$I-}
 Assign(F,Path);FileMode:=0;Reset(F,1);
 {$I+}
 If IOResult<>0 Then Exit;
 G.FileLen:=FileSize(F);
 FillChar(Hd,SizeOf(Hd),0);
 {$I-}
 BlockRead(F,Hd,512,N);
 {$I+}
 P:=@Hd;
 If G.Info.Ver=1 Then Begin G.HdrPos:=$C0;Base:=0;End Else Begin G.HdrPos:=248;Base:=256;End;
 If G.HdrPos+96>N Then Begin Close(F);Exit;End;
 I:=G.HdrPos;
 G.Kernel:=W(I+12);G.Stack:=W(I+22);
 G.ProcOfs:=W(I+24);G.ProcRes:=W(I+26);G.AppOfs:=W(I+28);G.AppRes:=W(I+30);
 G.Attr:=W(I+34);G.AType:=W(I+36);
 G.Name:=CStr(Hd,I+52,8);G.Ext:=CStr(Hd,I+60,4);
 G.DrvOfs:=W(I+72);G.DrvRes:=W(I+74);G.EntOfs:=W(I+76);G.EntRes:=W(I+78);
 G.NE:=W(I+82);G.NL:=W(I+84);G.NS:=W(I+88);
 If (G.NL>MAXGLIB) Or (G.NE>MAXGEXP) Or (G.NS>MAXGSEG) Then Begin Close(F);Exit;End;
 LibPos:=G.HdrPos+96;
 ExpPos:=LibPos+LongInt(G.NL)*14;
 SegPos:=ExpPos+LongInt(G.NE)*4;
 Cnt:=G.NL*14+G.NE*4+G.NS*10;
 If Cnt>1024 Then Begin Close(F);Exit;End;
 {$I-}
 Seek(F,LibPos);
 BlockRead(F,Buf,Cnt,N);
 Close(F);
 {$I+}
 If N<Cnt Then Exit;
 B2:=@Buf;
 For I:=0 To G.NL-1 Do Begin
  G.Libs[I].Name:=CStr(Buf,I*14,8);
  G.Libs[I].Typ:=B2^[I*14+8]+256*B2^[I*14+9];
  G.Libs[I].Proto:=B2^[I*14+10]+256*B2^[I*14+11];
 End;
 For I:=0 To G.NE-1 Do Begin
  G.Exp[I].Ofs:=B2^[G.NL*14+I*4]+256*B2^[G.NL*14+I*4+1];
  G.Exp[I].Res:=B2^[G.NL*14+I*4+2]+256*B2^[G.NL*14+I*4+3];
 End;
 For I:=0 To G.NS-1 Do Begin
  Cnt:=G.NL*14+G.NE*4;
  G.Seg[I].Len:=B2^[Cnt+I*2]+256*B2^[Cnt+I*2+1];
  G.Seg[I].Pos:=B2^[Cnt+G.NS*2+I*4]+256*LongInt(B2^[Cnt+G.NS*2+I*4+1])+
                65536*LongInt(B2^[Cnt+G.NS*2+I*4+2])+16777216*LongInt(B2^[Cnt+G.NS*2+I*4+3])+Base;
  G.Seg[I].Fix:=B2^[Cnt+G.NS*6+I*2]+256*B2^[Cnt+G.NS*6+I*2+1];
  G.Seg[I].Flg:=B2^[Cnt+G.NS*8+I*2]+256*B2^[Cnt+G.NS*8+I*2+1];
 End;
 G.Valid:=True;
 ParseGeode:=True;
End;

