Function DriveExists(D: Integer): Boolean;
Begin
 {$IFDEF UNIX}
 DriveExists:=D=3;
 {$ELSE}
 DriveExists:=DiskSize(D)>=0;
 {$ENDIF}
End;

Function DriveRoot(D: Integer): String;
Begin
 {$IFDEF UNIX}
 DriveRoot:='/';
