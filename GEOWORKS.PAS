  Case I Of
   1: Begin GRect(A+5,B+5,A+18,B+18,cBlk);GBar(A+7,B+7,A+16,B+10,cBlu);End;
   2: Begin GRect(A+5,B+4,A+18,B+19,cBlk);GHLine(A+7,A+16,B+8,cBlk);
   GHLine(A+7,A+16,B+12,cBlk);GHLine(A+7,A+16,B+16,cBlk);End;
   3: Begin GBar(A+6,B+4,A+17,B+19,cWht);GRect(A+6,B+4,A+17,B+19,cBlk);
   GText(A+8,B+8,'B',cBlu);End;
   4: Begin GLine(A+8,B+5,A+8,B+19,cGrn);GLine(A+8,B+5,A+18,B+12,cGrn);
   GLine(A+8,B+19,A+18,B+12,cGrn);GLine(A+9,B+8,A+9,B+16,cGrn);
   GLine(A+11,B+9,A+11,B+15,cGrn);GLine(A+13,B+10,A+13,B+14,cGrn);End;
   5: Begin GBar(A+5,B+8,A+18,B+19,cYel);GRect(A+5,B+8,A+18,B+19,cBlk);
   GBar(A+5,B+5,A+11,B+8,cYel);End;
   6: Begin GBar(A+5,B+5,A+18,B+19,cCyn);GRect(A+5,B+5,A+18,B+19,cBlk);
   GBar(A+8,B+5,A+15,B+10,cWht);End;
   7: Begin GLine(A+6,B+6,A+17,B+17,cRed);GLine(A+17,B+6,A+6,B+17,cRed);
   GLine(A+7,B+6,A+17,B+16,cRed);GLine(A+16,B+6,A+6,B+16,cRed);End;
  End;
 End;
 If GbProj^.Hover>0 Then S:=T3(GbTip[GbProj^.Hover],GbTipFr[GbProj^.Hover],
