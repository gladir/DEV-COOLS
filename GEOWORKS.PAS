Procedure RunDosCommand(Const Cmd: String);
Begin
 HideMouse;
 CloseGraph;
 GfxOn:=False;
 {$IFDEF UNIX}
 If Cmd='' Then Exec('/bin/sh','') Else Exec('/bin/sh','-c "'+Cmd+'"');
 {$ELSE}
 SwapVectors;
 If Cmd='' Then Exec(GetEnv('COMSPEC'),'') Else Exec(GetEnv('COMSPEC'),
     '/C '+Cmd);
 SwapVectors;
 {$ENDIF}
 RestoreGraphicsAfterDos;
End;

Procedure RestoreGraphicsAfterDos;
Begin
 InitializeGraphics;
 InitCursor;
 BackTile:=Nil;
 If DeskBack>=0 Then BuildBackTile(DeskBack,DeskInk,DeskPaper);
 NeedFull:=True;
 ShowMouse;
End;

Procedure LaunchFile(Const Path: String);
Var G: TGeosInfo; E: String; A: Integer;
Begin
 E:=ExtOf(Path);
 If (E='GEO') Or IsNumExt(E) Or (E='BIT') Or (E='VM') Or (E='DB') Then Begin
  If ReadGeosHeader(Path,G) Then Begin
   If G.IsExe Then Begin
    A:=TokenToApp(G.Tok);
    If A<>0 Then LaunchApp(A,'') Else LaunchApp(A_GEODE,Path);
   End Else Begin
    A:=TokenToApp(G.Creator);
    If A<>0 Then LaunchApp(A,Path) Else LaunchApp(A_GEODE,Path);
   End;
  End Else LaunchApp(A_GEODE,Path);
 End Else If (E='WK1') Or (E='WKS') Or (E='WQ1') Then LaunchApp(A_WK1,Path)
 Else If (E='GBF') Or (E='BAS') Then LaunchApp(A_GEOBASIC,Path)
 Else If (E='EXE') Or (E='COM') Or (E='BAT') Then Begin
  If Confirm(T3('DOS program','Programme DOS','DOS-Programm'),
   T3('Run the DOS program|','Ex'#130'cuter le programme DOS|',
       'DOS-Programm starten|')+ShortName(Path)+'?') Then
   RunDosCommand(Path);
 End Else LaunchApp(A_TEXTED,Path);
End;

