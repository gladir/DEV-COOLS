{ ----- Throwable ------------------------------------------------------------ }

Procedure NThr_fill(A : PSlot);
Var H, N, I, F, Own, R, K : LongInt; Arr : LongInt; Skip : LongInt;
Begin
  H := AP(A)^[0];
  { cadres actifs, du plus recent au plus ancien ; on ignore les constructeurs de la pile d'exception }
  N := 0;
  Skip := FTop;
  While (Skip > 0) And (Classes[Frames^[Skip - 1].Cls].Methods[Frames^[Skip - 1].Mth].Name = '<init>') And IsSubclass(Frames^[Skip - 1].Cls, C_THROWABLE) Do Dec(Skip);
  N := Skip;
  Arr := NewArray(ArrayClassIdx('[J'), N * 2);
  K := 0;
  For I := Skip - 1 DownTo 0 Do Begin
    Heap[Arr].F[K] := Int64(Frames^[I].Cls) * 65536 + Frames^[I].Mth;
    Heap[Arr].F[K + 1] := LineOf(Frames^[I].Cls, Frames^[I].Mth, Frames^[I].Pc);
    Inc(K, 2);
  End;
  Own := -1;
  F := FindFieldIn(Heap[H].Cls, 'backtrace', 'Ljava/lang/Object;', Own);
  If F >= 0 Then Heap[H].F[Classes[Own].Fields[F].Slot] := Arr;
  NRet := H;
End;

{ StackTraceElement[] a partir du tableau de cadres }
Procedure NThr_elements(A : PSlot);
Var Bt, N, I, Cls, Mth, Line, R, E, C : LongInt; Ctor : LongInt; Own, F : LongInt; Cn, Mn, Fn : LongInt;
Begin
  Bt := AP(A)^[0];
  C := LoadClass('java/lang/StackTraceElement');
  If Bt = 0 Then Begin NRet := NewArray(ArrayClassIdx('[Ljava/lang/StackTraceElement;'), 0); Exit; End;
  N := Heap[Bt].Len Div 2;
  R := NewArray(ArrayClassIdx('[Ljava/lang/StackTraceElement;'), N);
  Pin(R);
  Ctor := FindMethodDecl(C, '<init>', '(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;I)V');
  For I := 0 To N - 1 Do Begin
    Cls := Heap[Bt].F[I * 2] Div 65536;
    Mth := Heap[Bt].F[I * 2] Mod 65536;
    Line := Heap[Bt].F[I * 2 + 1];
    E := NewObject(C);
    Heap[R].F[I] := E;
    Cn := JStr(JavaName(Cls)); Pin(Cn);
    Mn := JStr(Classes[Cls].Methods[Mth].Name); Pin(Mn);
    If Classes[Cls].SourceFile <> '' Then Fn := JStr(Classes[Cls].SourceFile) Else Fn := 0;
    Pin(Fn);
    CallPacked(C * 65536 + Ctor, [E, Cn, Mn, Fn, Line]);
    Unpin(3);
    If Pend Then Begin Unpin(1); Exit; End;
  End;
  Unpin(1);
  NRet := R;
End;

