Procedure NStr_charAt(A : PSlot);
Var I : LongInt; H : LongInt;
Begin
  H := AP(A)^[0]; I := AP(A)^[1];
  If (I < 0) Or (I >= Length(Heap[H].S)) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Index ' + IStr(I) + ' out of bounds for length ' + IStr(Length(Heap[H].S)));
    Exit;
  End;
  NRet := Ord(Heap[H].S[I + 1]);
End;

Procedure NStr_hashCode(A : PSlot);
Var H, I : LongInt; HV : Int64;
Begin
  H := AP(A)^[0];
  If Not Heap[H].HasHash Then Begin
    HV := 0;
    For I := 1 To Length(Heap[H].S) Do HV := LongInt(HV * 31 + Ord(Heap[H].S[I]));
    Heap[H].SHash := HV;
    Heap[H].HasHash := True;
  End;
  NRet := Heap[H].SHash;
End;

Procedure NStr_equals(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then NRet := 0
  Else If O = AP(A)^[0] Then NRet := 1
  Else NRet := BoolRet((Heap[O].Kind = KIND_STR) And (Heap[O].S = Heap[AP(A)^[0]].S));
End;

Function CmpW(Const X, Y : UnicodeString) : LongInt;
Var I, N : LongInt;
Begin
  N := Length(X);
  If Length(Y) < N Then N := Length(Y);
  For I := 1 To N Do
    If X[I] <> Y[I] Then Begin CmpW := Ord(X[I]) - Ord(Y[I]); Exit; End;
  CmpW := Length(X) - Length(Y);
End;

Function FoldW(Const X : UnicodeString) : UnicodeString;
Var I : LongInt; R : UnicodeString;
Begin
  R := X;
  For I := 1 To Length(R) Do R[I] := WideChar(ToLowerW(ToUpperW(Ord(R[I]))));
  FoldW := R;
End;

Procedure NStr_compareTo(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := CmpW(Heap[AP(A)^[0]].S, Heap[O].S);
End;

Procedure NStr_compareToIgnoreCase(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := CmpW(FoldW(Heap[AP(A)^[0]].S), FoldW(Heap[O].S));
End;

Procedure NStr_equalsIgnoreCase(A : PSlot);
Var O : LongInt;
Begin
