Function KindOfDesc(Const D : AnsiString) : Char;
Begin
  If D = '' Then KindOfDesc := 'L'
  Else If (D[1] = 'L') Or (D[1] = '[') Then KindOfDesc := 'L'
  Else KindOfDesc := D[1];
End;

Function FindAttr(Const At : TAttrs; Const N : AnsiString) : LongInt;
Var I : LongInt;
Begin
  FindAttr := -1;
  For I := 0 To High(At) Do If At[I].Name = N Then Begin FindAttr := I; Exit;
    End;
End;

