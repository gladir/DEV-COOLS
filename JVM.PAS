  ============================================================================ }


{ ----- caracteres ---------------------------------------------------------- }

Function ToUpperW(C : LongInt) : LongInt;
Begin
  ToUpperW := C;
  If (C >= 97) And (C <= 122) Then ToUpperW := C - 32
  Else If C < 128 Then Exit
  Else If (C >= $E0) And (C <= $FE) And (C <> $F7) Then ToUpperW := C - 32
  Else If C = $FF Then ToUpperW := $178
  Else If C = $B5 Then ToUpperW := $39C
  Else If (C >= $100) And (C <= $17F) Then Begin
    If ((C >= $100) And (C <= $137)) Or ((C >= $14A) And (C <= $177)) Then Begin
      If Odd(C) Then ToUpperW := C - 1;
    End
    Else If ((C >= $139) And (C <= $148)) Or ((C >= $179) And (C <= $17E)) Then Begin
      If Not Odd(C) Then ToUpperW := C - 1;
    End;
  End
  Else If (C >= $3B1) And (C <= $3C9) And (C <> $3C2) Then ToUpperW := C - 32
  Else If C = $3C2 Then ToUpperW := $3A3
  Else If (C >= $3AC) And (C <= $3AF) Then Begin
    Case C Of $3AC : ToUpperW := $386; $3AD : ToUpperW := $388; $3AE : ToUpperW := $389; $3AF : ToUpperW := $38A; End;
  End
  Else If (C >= $430) And (C <= $44F) Then ToUpperW := C - 32
  Else If (C >= $450) And (C <= $45F) Then ToUpperW := C - 80;
End;

Function ToLowerW(C : LongInt) : LongInt;
Begin
  ToLowerW := C;
  If (C >= 65) And (C <= 90) Then ToLowerW := C + 32
  Else If C < 128 Then Exit
  Else If (C >= $C0) And (C <= $DE) And (C <> $D7) Then ToLowerW := C + 32
  Else If C = $178 Then ToLowerW := $FF
  Else If (C >= $100) And (C <= $17F) Then Begin
    If ((C >= $100) And (C <= $137)) Or ((C >= $14A) And (C <= $177)) Then Begin
      If Not Odd(C) Then ToLowerW := C + 1;
    End
    Else If ((C >= $139) And (C <= $148)) Or ((C >= $179) And (C <= $17E)) Then Begin
      If Odd(C) Then ToLowerW := C + 1;
    End;
  End
  Else If (C >= $391) And (C <= $3A9) And (C <> $3A2) Then ToLowerW := C + 32
  Else If (C >= $410) And (C <= $42F) Then ToLowerW := C + 32
  Else If (C >= $400) And (C <= $40F) Then ToLowerW := C + 80;
End;

Function IsLetterW(C : LongInt) : Boolean;
Begin
  If C < 128 Then IsLetterW := ((C >= 65) And (C <= 90)) Or ((C >= 97) And (C <= 122))
  Else IsLetterW := ((C >= $C0) And (C <> $D7) And (C <> $F7) And (C <= $24F)) Or (C = $AA) Or (C = $B5) Or (C = $BA)
    Or ((C >= $370) And (C <= $3FF) And (C <> $37E) And (C <> $387)) Or ((C >= $400) And (C <= $481)) Or ((C >= $48A) And (C <= $52F))
    Or ((C >= $5D0) And (C <= $5EA)) Or ((C >= $620) And (C <= $64A)) Or ((C >= $3040) And (C <= $30FF))
    Or ((C >= $4E00) And (C <= $9FFF)) Or ((C >= $AC00) And (C <= $D7A3)) Or ((C >= $1E00) And (C <= $1FFF));
End;

Function IsDigitW(C : LongInt) : Boolean;
Begin
  IsDigitW := ((C >= 48) And (C <= 57)) Or ((C >= $660) And (C <= $669)) Or ((C >= $FF10) And (C <= $FF19));
End;

Function IsSpaceW(C : LongInt) : Boolean;
Begin
  IsSpaceW := ((C >= 9) And (C <= 13)) Or ((C >= $1C) And (C <= $20)) Or (C = $1680) Or ((C >= $2000) And (C <= $2006))
    Or ((C >= $2008) And (C <= $200A)) Or (C = $2028) Or (C = $2029) Or (C = $205F) Or (C = $3000);
End;

