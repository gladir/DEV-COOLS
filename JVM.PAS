Begin
  S := Heap[AP(A)^[0]].S; C := AP(A)^[1]; From := AP(A)^[2];
  NRet := -1;
  If From >= Length(S) Then From := Length(S) - 1;
  For I := From + 1 DownTo 1 Do If Ord(S[I]) = C Then Begin NRet := I - 1; Exit; End;
End;

