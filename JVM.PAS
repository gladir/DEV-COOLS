  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2];
  If AP(A)^[1] = 0 Then NRet := Classes[C].Fields[I].Flags
  Else If Classes[C].Methods[I].Lam > 0 Then NRet := -1
  Else NRet := Classes[C].Methods[I].Flags;
