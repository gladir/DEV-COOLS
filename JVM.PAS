Procedure NSys_arraycopy(A : PSlot);
Var Src, Dst, SP, DP, N, I : LongInt; Tmp : Array Of Int64;
Begin
  Src := AP(A)^[0]; SP := AP(A)^[1]; Dst := AP(A)^[2]; DP := AP(A)^[3]; N := AP(A)^[4];
  If (Src = 0) Or (Dst = 0) Then Begin ThrowNPE(''); Exit; End;
  If (Heap[Src].Kind <> KIND_ARR) Or (Heap[Dst].Kind <> KIND_ARR) Then Begin
    ThrowNew('java/lang/ArrayStoreException', 'arraycopy: source type is not an array'); Exit;
  End;
  If (SP < 0) Or (DP < 0) Or (N < 0) Or (SP + N > Heap[Src].Len) Or (DP + N > Heap[Dst].Len) Then Begin
    If SP + N > Heap[Src].Len Then
      ThrowNew('java/lang/ArrayIndexOutOfBoundsException', 'arraycopy: last source index ' + IStr(SP + N) + ' out of bounds for length ' + IStr(Heap[Src].Len))
    Else If DP + N > Heap[Dst].Len Then
      ThrowNew('java/lang/ArrayIndexOutOfBoundsException', 'arraycopy: last destination index ' + IStr(DP + N) + ' out of bounds for length ' + IStr(Heap[Dst].Len))
    Else If SP < 0 Then
      ThrowNew('java/lang/ArrayIndexOutOfBoundsException', 'arraycopy: source index ' + IStr(SP) + ' out of bounds for length ' + IStr(Heap[Src].Len))
    Else If DP < 0 Then
      ThrowNew('java/lang/ArrayIndexOutOfBoundsException', 'arraycopy: destination index ' + IStr(DP) + ' out of bounds for length ' + IStr(Heap[Dst].Len))
    Else ThrowNew('java/lang/ArrayIndexOutOfBoundsException', 'arraycopy: length ' + IStr(N) + ' is negative');
    Exit;
  End;
  If N > 0 Then Move(Heap[Src].F[SP], Heap[Dst].F[DP], N * SizeOf(Int64));
  I := 0;
End;

Var
  TimeBase : Int64;

Function NowMillis : Int64;
Var Y, M, D, DW, H, Mi, S, HS : Word; Days : Int64; I : LongInt;
  Function Leap(Yr : LongInt) : Boolean;
  Begin Leap := ((Yr Mod 4 = 0) And (Yr Mod 100 <> 0)) Or (Yr Mod 400 = 0); End;
Const MD : Array[1..12] Of LongInt = (31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);
Begin
  GetDate(Y, M, D, DW);
  GetTime(H, Mi, S, HS);
  Days := 0;
  For I := 1970 To Y - 1 Do If Leap(I) Then Inc(Days, 366) Else Inc(Days, 365);
  For I := 1 To M - 1 Do Begin
    Inc(Days, MD[I]);
    If (I = 2) And Leap(Y) Then Inc(Days);
  End;
  Inc(Days, D - 1);
  NowMillis := ((Days * 24 + H) * 60 + Mi) * 60000 + S * 1000 + HS * 10;
End;

Procedure NSys_currentTimeMillis(A : PSlot);
Begin
  NRet := NowMillis;
End;

Var NanoLast, NanoAdd : Int64;

Procedure NSys_nanoTime(A : PSlot);
Var T : Int64;
Begin
  T := NowMillis;
  If T = NanoLast Then Begin Inc(NanoAdd, 1000); End Else Begin NanoLast := T; NanoAdd := 0; End;
  NRet := T * 1000000 + NanoAdd;
End;

