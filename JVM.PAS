Procedure NVM_newArray(A : PSlot);
Var C, K : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  K := AP(A)^[1];
  If K < 0 Then Begin ThrowNew('java/lang/NegativeArraySizeException', IStr(K));
    Exit; End;
  If Classes[C].IsArray Then NRet := NewArray(ArrayClassIdx('[' +
    Classes[C].Name), K)
  Else If Classes[C].Name = 'int' Then NRet := NewArray(ArrayClassIdx('[I'), K)
  Else If Classes[C].Name = 'long' Then NRet := NewArray(ArrayClassIdx('[J'), K)
  Else If Classes[C].Name = 'double' Then NRet := NewArray(ArrayClassIdx('[D'),
    K)
  Else If Classes[C].Name = 'float' Then NRet := NewArray(ArrayClassIdx('[F'),
    K)
  Else If Classes[C].Name = 'boolean' Then NRet := NewArray(ArrayClassIdx('[Z'),
    K)
  Else If Classes[C].Name = 'char' Then NRet := NewArray(ArrayClassIdx('[C'), K)
  Else If Classes[C].Name = 'short' Then NRet := NewArray(ArrayClassIdx('[S'),
    K)
  Else If Classes[C].Name = 'byte' Then NRet := NewArray(ArrayClassIdx('[B'), K)
  Else NRet := NewArray(ArrayClassIdx('[L' + Classes[C].Name + ';'), K);
End;
