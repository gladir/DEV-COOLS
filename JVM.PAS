Procedure NSB_appendSII(A : PSlot);
Var H : LongInt; S : UnicodeString;
Begin
  H := AP(A)^[0];
  S := SOf(AP(A)^[1]);
  If (AP(A)^[2] < 0) Or (AP(A)^[3] > Length(S)) Or (AP(A)^[2] > AP(A)^[3]) Then
    Begin
    ThrowNew('java/lang/IndexOutOfBoundsException', 'Range [' + IStr(AP(A)^[2])
      + ', ' + IStr(AP(A)^[3]) + ') out of bounds for length ' +
      IStr(Length(S)));
    Exit;
  End;
  Heap[H].S := Heap[H].S + Copy(S, AP(A)^[2] + 1, AP(A)^[3] - AP(A)^[2]);
  NRet := H;
