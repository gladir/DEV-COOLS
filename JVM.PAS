Var HashSeed : LongInt;

Function IdentityHash(H : LongInt) : LongInt;
Var X : LongInt;
Begin
  If Not Heap[H].HasHash Then Begin
    HashSeed := LongInt((Int64(HashSeed) * 1103515245 + 12345) And $7FFFFFFF);
    X := (HashSeed Shr 3) And $7FFFFFF;
    If X = 0 Then X := 1;
    Heap[H].IdHash := X;
    Heap[H].HasHash := True;
  End;
  IdentityHash := Heap[H].IdHash;
End;

Procedure NObj_hashCode(A : PSlot);
Begin
  NRet := IdentityHash(AP(A)^[0]);
End;

Procedure NObj_clone(A : PSlot);
Var H, R : LongInt;
Begin
  H := AP(A)^[0];
  If Heap[H].Kind = KIND_ARR Then Begin
    R := NewArray(Heap[H].Cls, Heap[H].Len);
    If Heap[H].Len > 0 Then Move(Heap[H].F[0], Heap[R].F[0], Heap[H].Len * SizeOf(Int64));
    NRet := R;
  End
  Else Begin
    If Not IsSubclass(Heap[H].Cls, C_CLONEABLE) Then Begin
      ThrowNew('java/lang/CloneNotSupportedException', JavaName(Heap[H].Cls));
      Exit;
    End;
    R := NewObject(Heap[H].Cls);
    If Length(Heap[H].F) > 0 Then Move(Heap[H].F[0], Heap[R].F[0], Length(Heap[H].F) * SizeOf(Int64));
    Heap[R].S := Heap[H].S;
    NRet := R;
  End;
End;

Procedure NObj_nop(A : PSlot);
Begin
  NRet := 0;
End;

