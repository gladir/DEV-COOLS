Procedure NFS_length(A : PSlot);
Var SR : SearchRec; P : AnsiString;
Begin
  P := FsPath(AP(A)^[0]);
  NRet := 0;
  FindFirst(P, AnyFile, SR);
  If DosError = 0 Then NRet := SR.Size;
  FindClose(SR);
End;

Procedure NFS_delete(A : PSlot);
Var P : AnsiString; F : File; At : Word;
Begin
  P := FsPath(AP(A)^[0]);
  NRet := 0;
  If Not FsExists(P, At) Then Exit;
  {$I-}
  If (At And Directory) <> 0 Then RmDir(P)
  Else Begin Assign(F, P); Erase(F); End;
  {$I+}
  NRet := BoolRet(IOResult = 0);
End;

Procedure NFS_mkdir(A : PSlot);
Begin
  {$I-}
  MkDir(FsPath(AP(A)^[0]));
  {$I+}
