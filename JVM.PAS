    [CP_CLASS, CP_STRING, CP_MTYPE]) Then I := Classes[C].CP[I].A;
  If (I <= 0) Or (I >= Length(Classes[C].CP)) Or (Classes[C].CP[I].Tag <>
    CP_UTF8) Then NRet := 0
  Else NRet := JStr(Classes[C].CP[I].S);
End;

