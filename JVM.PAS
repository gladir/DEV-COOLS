  RegN('java/lang/Math.rint(D)D', @NMath_rint);

  RegN('java/lang/Double.parseDouble(' + S + ')D', @NDouble_parse);
  RegN('java/lang/Double.toString(D)' + S, @NDouble_toString);
  RegN('java/lang/Double.doubleToRawLongBits(D)J', @NDouble_dToBits);
  RegN('java/lang/Double.longBitsToDouble(J)D', @NDouble_bitsToD);
  RegN('java/lang/Float.toString(F)' + S, @NFloat_toString);
  RegN('java/lang/Float.floatToRawIntBits(F)I', @NFloat_fToBits);
  RegN('java/lang/Float.intBitsToFloat(I)F', @NFloat_bitsToF);
  RegN('java/lang/Integer.toString(I)' + S, @NInt_toString);
  RegN('java/lang/Integer.toHexString(I)' + S, @NInt_toHex);
  RegN('java/lang/Long.toString(J)' + S, @NLong_toString);
  RegN('java/lang/Long.toHexString(J)' + S, @NLong_toHex);

  RegN('java/lang/Character.isLetter(I)Z', @NChar_isLetter);
  RegN('java/lang/Character.isDigit(I)Z', @NChar_isDigit);
  RegN('java/lang/Character.isWhitespace(I)Z', @NChar_isWhitespace);
  RegN('java/lang/Character.isUpperCase(I)Z', @NChar_isUpper);
  RegN('java/lang/Character.isLowerCase(I)Z', @NChar_isLower);
  RegN('java/lang/Character.toUpperCase(I)I', @NChar_toUpper);
  RegN('java/lang/Character.toLowerCase(I)I', @NChar_toLower);

  RegN('java/lang/Throwable.fillInStackTrace()Ljava/lang/Throwable;', @NThr_fill);
  RegN('java/lang/Throwable.elements(' + O + ')[Ljava/lang/StackTraceElement;', @NThr_elements);
End;
