End;

Procedure NFS_size(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  NRet := FileSize(FHandles[H]);
End;

Procedure NFS_setLength(A : PSlot);
Var H : LongInt; P, Rem : Int64; Z : Array[0..4095] Of Byte; N : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  P := FileSize(FHandles[H]);
  If AP(A)^[1] < P Then Begin
    Seek(FHandles[H], AP(A)^[1]);
    Truncate(FHandles[H]);
  End
  Else Begin
    FillChar(Z, SizeOf(Z), 0);
    Seek(FHandles[H], P);
    Rem := AP(A)^[1] - P;
    While Rem > 0 Do Begin
      If Rem > 4096 Then N := 4096 Else N := Rem;
      BlockWrite(FHandles[H], Z, N);
      Dec(Rem, N);
    End;
  End;
  {$I+}
  If IOResult <> 0 Then ;
End;

Procedure NFS_close(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  Close(FHandles[H]);
  {$I+}
  If IOResult = 0 Then ;
  FUsed[H] := False;
End;

Function FsExists(Const P : AnsiString; Var Attr : Word) : Boolean;
Var SR : SearchRec;
Begin
  FsExists := False;
  Attr := 0;
  If P = '' Then Exit;
  FindFirst(P, AnyFile, SR);
  If DosError = 0 Then Begin FsExists := True; Attr := SR.Attr; End;
  FindClose(SR);
End;

Procedure NFS_exists(A : PSlot);
Var At : Word;
Begin
  NRet := BoolRet(FsExists(FsPath(AP(A)^[0]), At));
End;

Procedure NFS_isDir(A : PSlot);
Var At : Word;
Begin
  NRet := BoolRet(FsExists(FsPath(AP(A)^[0]), At) And ((At And Directory) <> 0));
