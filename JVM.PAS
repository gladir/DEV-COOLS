  Else NRet := BoolRet((Length(Heap[O].S) = Length(Heap[AP(A)^[0]].S)) And (FoldW(Heap[AP(A)^[0]].S) = FoldW(Heap[O].S)));
End;

Procedure NStr_substring1(A : PSlot);
Var H, B : LongInt;
Begin
  H := AP(A)^[0]; B := AP(A)^[1];
  If (B < 0) Or (B > Length(Heap[H].S)) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Range [' + IStr(B) + ', ' + IStr(Length(Heap[H].S)) + ') out of bounds for length ' + IStr(Length(Heap[H].S)));
    Exit;
  End;
  If B = 0 Then NRet := H Else NRet := NewStr(Copy(Heap[H].S, B + 1, Length(Heap[H].S)));
End;

Procedure NStr_substring2(A : PSlot);
Var H, B, E : LongInt;
Begin
  H := AP(A)^[0]; B := AP(A)^[1]; E := AP(A)^[2];
  If (B < 0) Or (E > Length(Heap[H].S)) Or (B > E) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Range [' + IStr(B) + ', ' + IStr(E) + ') out of bounds for length ' + IStr(Length(Heap[H].S)));
    Exit;
  End;
  If (B = 0) And (E = Length(Heap[H].S)) Then NRet := H Else NRet := NewStr(Copy(Heap[H].S, B + 1, E - B));
End;

Function IndexOfW(Const S, Sub : UnicodeString; From : LongInt) : LongInt;
Var I, J, N, M : LongInt; Ok : Boolean;
Begin
  N := Length(S); M := Length(Sub);
  If From < 0 Then From := 0;
  IndexOfW := -1;
  If M = 0 Then Begin If From <= N Then IndexOfW := From Else IndexOfW := N; Exit; End;
  I := From;
  While I + M <= N Do Begin
    If S[I + 1] = Sub[1] Then Begin
      Ok := True;
      For J := 2 To M Do If S[I + J] <> Sub[J] Then Begin Ok := False; Break; End;
      If Ok Then Begin IndexOfW := I; Exit; End;
    End;
    Inc(I);
  End;
End;

Function LastIndexOfW(Const S, Sub : UnicodeString; From : LongInt) : LongInt;
Var I, J, N, M : LongInt; Ok : Boolean;
Begin
  N := Length(S); M := Length(Sub);
  LastIndexOfW := -1;
  If From > N - M Then From := N - M;
  I := From;
  While I >= 0 Do Begin
    Ok := True;
    For J := 1 To M Do If S[I + J] <> Sub[J] Then Begin Ok := False; Break; End;
    If Ok Then Begin LastIndexOfW := I; Exit; End;
    Dec(I);
  End;
End;

Procedure NStr_indexOfCh(A : PSlot);
Var S : UnicodeString; I, C, From : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; C := AP(A)^[1]; From := AP(A)^[2];
  NRet := -1;
  If From < 0 Then From := 0;
  For I := From + 1 To Length(S) Do If Ord(S[I]) = C Then Begin NRet := I - 1; Exit; End;
End;

Procedure NStr_lastIndexOfCh(A : PSlot);
Var S : UnicodeString; I, C, From : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; C := AP(A)^[1]; From := AP(A)^[2];
  NRet := -1;
  If From >= Length(S) Then From := Length(S) - 1;
  For I := From + 1 DownTo 1 Do If Ord(S[I]) = C Then Begin NRet := I - 1; Exit; End;
End;

Procedure NStr_indexOfS(A : PSlot);
Begin
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := IndexOfW(Heap[AP(A)^[0]].S, Heap[AP(A)^[1]].S, AP(A)^[2]);
End;

Procedure NStr_lastIndexOfS(A : PSlot);
Begin
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := LastIndexOfW(Heap[AP(A)^[0]].S, Heap[AP(A)^[1]].S, AP(A)^[2]);
End;

Procedure NStr_startsWith(A : PSlot);
Var S, P : UnicodeString; Off : LongInt;
Begin
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  S := Heap[AP(A)^[0]].S; P := Heap[AP(A)^[1]].S; Off := AP(A)^[2];
  NRet := BoolRet((Off >= 0) And (Off + Length(P) <= Length(S)) And (Copy(S, Off + 1, Length(P)) = P));
End;

Procedure NStr_endsWith(A : PSlot);
Var S, P : UnicodeString;
Begin
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  S := Heap[AP(A)^[0]].S; P := Heap[AP(A)^[1]].S;
  NRet := BoolRet((Length(P) <= Length(S)) And (Copy(S, Length(S) - Length(P) + 1, Length(P)) = P));
End;

Procedure NStr_concat(A : PSlot);
Begin
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := NewStr(Heap[AP(A)^[0]].S + Heap[AP(A)^[1]].S);
End;

Procedure NStr_toUpperCase(A : PSlot);
Var S : UnicodeString; I : LongInt; Chg : Boolean;
Begin
  S := Heap[AP(A)^[0]].S; Chg := False;
  For I := 1 To Length(S) Do If ToUpperW(Ord(S[I])) <> Ord(S[I]) Then Begin S[I] := WideChar(ToUpperW(Ord(S[I]))); Chg := True; End;
  If Chg Then NRet := NewStr(S) Else NRet := AP(A)^[0];
End;

Procedure NStr_toLowerCase(A : PSlot);
Var S : UnicodeString; I : LongInt; Chg : Boolean;
Begin
  S := Heap[AP(A)^[0]].S; Chg := False;
  For I := 1 To Length(S) Do If ToLowerW(Ord(S[I])) <> Ord(S[I]) Then Begin S[I] := WideChar(ToLowerW(Ord(S[I]))); Chg := True; End;
  If Chg Then NRet := NewStr(S) Else NRet := AP(A)^[0];
End;

Procedure NStr_trim(A : PSlot);
Var S : UnicodeString; B, E : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; B := 1; E := Length(S);
  While (B <= E) And (Ord(S[B]) <= 32) Do Inc(B);
  While (E >= B) And (Ord(S[E]) <= 32) Do Dec(E);
  If (B = 1) And (E = Length(S)) Then NRet := AP(A)^[0] Else NRet := NewStr(Copy(S, B, E - B + 1));
End;

Procedure NStr_strip(A : PSlot);
Var S : UnicodeString; B, E : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; B := 1; E := Length(S);
  While (B <= E) And IsSpaceW(Ord(S[B])) Do Inc(B);
  While (E >= B) And IsSpaceW(Ord(S[E])) Do Dec(E);
  If (B = 1) And (E = Length(S)) Then NRet := AP(A)^[0] Else NRet := NewStr(Copy(S, B, E - B + 1));
End;

Procedure NStr_stripLeading(A : PSlot);
Var S : UnicodeString; B : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; B := 1;
  While (B <= Length(S)) And IsSpaceW(Ord(S[B])) Do Inc(B);
  If B = 1 Then NRet := AP(A)^[0] Else NRet := NewStr(Copy(S, B, Length(S)));
End;

Procedure NStr_stripTrailing(A : PSlot);
Var S : UnicodeString; E : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; E := Length(S);
  While (E >= 1) And IsSpaceW(Ord(S[E])) Do Dec(E);
  If E = Length(S) Then NRet := AP(A)^[0] Else NRet := NewStr(Copy(S, 1, E));
End;

Procedure NStr_replaceCh(A : PSlot);
Var S : UnicodeString; I : LongInt; X, Y : WideChar; Chg : Boolean;
Begin
  S := Heap[AP(A)^[0]].S; X := WideChar(AP(A)^[1]); Y := WideChar(AP(A)^[2]); Chg := False;
  For I := 1 To Length(S) Do If S[I] = X Then Begin S[I] := Y; Chg := True; End;
  If Chg Then NRet := NewStr(S) Else NRet := AP(A)^[0];
End;

Function ReplaceW(Const S, X, Y : UnicodeString) : UnicodeString;
Var R : UnicodeString; I, P : LongInt;
Begin
  If Length(X) = 0 Then Begin
    R := Y;
    For I := 1 To Length(S) Do R := R + S[I] + Y;
    ReplaceW := R;
    Exit;
  End;
  R := ''; I := 0;
  Repeat
    P := IndexOfW(S, X, I);
    If P < 0 Then Begin R := R + Copy(S, I + 1, Length(S)); Break; End;
    R := R + Copy(S, I + 1, P - I) + Y;
    I := P + Length(X);
  Until False;
  ReplaceW := R;
End;

Procedure NStr_replaceS(A : PSlot);
Begin
  If (AP(A)^[1] = 0) Or (AP(A)^[2] = 0) Then Begin ThrowNPE(''); Exit; End;
  NRet := NewStr(ReplaceW(Heap[AP(A)^[0]].S, Heap[AP(A)^[1]].S, Heap[AP(A)^[2]].S));
End;

Procedure NStr_toCharArray(A : PSlot);
Var S : UnicodeString; R, I : LongInt;
Begin
  S := Heap[AP(A)^[0]].S;
  R := NewArray(ArrayClassIdx('[C'), Length(S));
  For I := 1 To Length(S) Do Heap[R].F[I - 1] := Ord(S[I]);
  NRet := R;
End;

Procedure NStr_getBytes(A : PSlot);
Var S : UnicodeString; B : AnsiString; R, I : LongInt; Latin : Boolean;
Begin
  S := Heap[AP(A)^[0]].S;
  Latin := AP(A)^[1] <> 0;
  If Latin Then Begin
    SetLength(B, Length(S));
    For I := 1 To Length(S) Do If Ord(S[I]) < 256 Then B[I] := Chr(Ord(S[I])) Else B[I] := '?';
  End
  Else B := WideToUtf8(S);
  R := NewArray(ArrayClassIdx('[B'), Length(B));
  For I := 1 To Length(B) Do Heap[R].F[I - 1] := ShortInt(Ord(B[I]));
  NRet := R;
End;

