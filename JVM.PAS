{ ----- proxy dynamiques ---------------------------------------------------- }

Type
  TProxyMeth = Record Cls, MIdx : LongInt; End;

Var
  ProxyMeths : Array Of TProxyMeth;
  NProxyMeths : LongInt;
  ProxyDispatchPM : LongInt = -1;

Function AddProxyMeth(SC, DeclC, MI : LongInt) : LongInt;
Var N, I, J : LongInt; Src : PMethod;
Begin
  If NProxyMeths >= Length(ProxyMeths) Then SetLength(ProxyMeths, NProxyMeths *
    2 + 32);
  ProxyMeths[NProxyMeths].Cls := DeclC;
  ProxyMeths[NProxyMeths].MIdx := MI;
  Src := @Classes[DeclC].Methods[MI];
  N := Length(Classes[SC].Methods);
  SetLength(Classes[SC].Methods, N + 1);
  FillChar(Classes[SC].Methods[N], SizeOf(TMethod), 0);
  Classes[SC].Methods[N].Name := Src^.Name;
  Classes[SC].Methods[N].Desc := Src^.Desc;
  Classes[SC].Methods[N].Flags := ACC_PUBLIC Or ACC_FINAL;
  Classes[SC].Methods[N].Cls := SC;
  Classes[SC].Methods[N].Lam := -(NProxyMeths + 1);
  ParseDesc(Src^.Desc, Classes[SC].Methods[N].ArgKinds,
    Classes[SC].Methods[N].RetKind);
  Classes[SC].Methods[N].NArgs := Length(Classes[SC].Methods[N].ArgKinds);
  J := 1;
  For I := 1 To Length(Classes[SC].Methods[N].ArgKinds) Do Inc(J,
    ArgSlotsOf(Classes[SC].Methods[N].ArgKinds[I]));
  Classes[SC].Methods[N].NArgSlots := J;
  Classes[SC].Methods[N].Sel := Src^.Sel;
  Inc(NProxyMeths);
  AddProxyMeth := N;
End;

Procedure ProxyAddIface(SC, Ic : LongInt);
Var I, J, K : LongInt; Have : Boolean;
Begin
  For I := 0 To High(Classes[Ic].Methods) Do Begin
    If (Classes[Ic].Methods[I].Flags And (ACC_STATIC Or ACC_PRIVATE)) <> 0 Then
      Continue;
    If Classes[Ic].Methods[I].Name = '<clinit>' Then Continue;
    Have := False;
    For J := 0 To High(Classes[SC].Methods) Do
      If Classes[SC].Methods[J].Sel = Classes[Ic].Methods[I].Sel Then Have :=
        True;
    If Not Have Then AddProxyMeth(SC, Ic, I);
  End;
  For K := 0 To High(Classes[Ic].Ifaces) Do ProxyAddIface(SC,
    Classes[Ic].Ifaces[K]);
End;

{ defineProxy(Class[] interfaces, String nom) : Class }
Procedure NR_defineProxy(A : PSlot);
Var Arr, I, SC, PC, K : LongInt; Nm : AnsiString;
Begin
  Arr := AP(A)^[0]; Nm := ReplaceCh(SOfA(AP(A)^[1]), '.', '/');
  PC := LoadClass('java/lang/reflect/Proxy');
  EnsureInit(PC);
  If Pend Then Exit;
  SC := NewClassRec(Nm);
  Classes[SC].Flags := ACC_PUBLIC Or ACC_FINAL;
  Classes[SC].Super := PC;
  Classes[SC].NInst := Classes[PC].NInst;
  Classes[SC].InitState := 2;
  Classes[SC].ObjKind := KIND_OBJ;
  SetLength(Classes[SC].Ifaces, Heap[Arr].Len);
  For I := 0 To Heap[Arr].Len - 1 Do Classes[SC].Ifaces[I] :=
    ClsOfMirror(Heap[Arr].F[I]);
  { methodes de Object, puis celles des interfaces }
  For K := 0 To High(Classes[C_OBJECT].Methods) Do
    If (Classes[C_OBJECT].Methods[K].Name = 'hashCode') Or
      (Classes[C_OBJECT].Methods[K].Name = 'toString')
      Or ((Classes[C_OBJECT].Methods[K].Name = 'equals') And
        (Classes[C_OBJECT].Methods[K].Desc = '(Ljava/lang/Object;)Z')) Then
      AddProxyMeth(SC, C_OBJECT, K);
  For I := 0 To High(Classes[SC].Ifaces) Do ProxyAddIface(SC,
    Classes[SC].Ifaces[I]);
  NRet := MirrorOf(SC);
End;

Procedure ProxyCall(Idx : LongInt; A : PSlot);
Var PA : PSlotArr; Obj, Arr, I, Slot, DeclC, MI : LongInt; M : PMethod; R :
  Int64; K : Char; V : Int64; Bk : Char;
Begin
  PA := PSlotArr(A);
  Obj := PA^[0];
  DeclC := ProxyMeths[Idx].Cls; MI := ProxyMeths[Idx].MIdx;
  M := @Classes[DeclC].Methods[MI];
  Arr := NewArray(ArrayClassIdx('[Ljava/lang/Object;'), M^.NArgs);
  Pin(Arr);
  Slot := 1;
  For I := 1 To M^.NArgs Do Begin
    K := M^.ArgKinds[I];
    V := PA^[Slot];
    If K = 'L' Then Heap[Arr].F[I - 1] := V Else Heap[Arr].F[I - 1] :=
      BoxPrim(K, V);
    Inc(Slot, ArgSlotsOf(K));
  End;
  If ProxyDispatchPM < 0 Then
    ProxyDispatchPM := FindMethodByName('java/lang/reflect/Proxy', 'dispatch', 
      '(Ljava/lang/Object;Ljava/lang/Class;I[Ljava/lang/Object;)Ljava/lang/Ob' +
      'ject;');
  R := CallPacked(ProxyDispatchPM, [Obj, MirrorOf(DeclC), MI, Arr]);
  Unpin(1);
  If Pend Then Exit;
  K := M^.RetKind;
  If K = 'V' Then NRet := 0
  Else If K = 'L' Then NRet := R
  Else If R = 0 Then ThrowNPE('')
  Else Begin
    Bk := BoxKindOfClass(Heap[R].Cls);
    If Bk = #0 Then ThrowNew('java/lang/ClassCastException', 'proxy result')
    Else NRet := ConvPrim(Heap[R].F[0], Bk, K);
  End;
End;
