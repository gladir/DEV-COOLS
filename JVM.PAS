{ ----- champs ------------------------------------------------------------- }

Function UnboxTo(V : LongInt; K : Char; Var Ok : Boolean) : Int64;
Var Bk : Char;
Begin
  Ok := True;
  If K = 'L' Then Begin UnboxTo := V; Exit; End;
  If V = 0 Then Begin Ok := False; UnboxTo := 0; Exit; End;
  Bk := BoxKindOfClass(Heap[V].Cls);
  If Bk = #0 Then Begin Ok := False; UnboxTo := 0; Exit; End;
  UnboxTo := ConvPrim(Heap[V].F[0], Bk, K);
End;

Procedure NR_fieldGet(A : PSlot);
Var O, C, I : LongInt; V : Int64; K : Char;
Begin
  O := AP(A)^[0]; C := ClsOfMirror(AP(A)^[1]); I := AP(A)^[2];
  K := KindOfDesc(Classes[C].Fields[I].Desc);
  If (Classes[C].Fields[I].Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    V := Classes[C].Statics[Classes[C].Fields[I].Slot];
  End
  Else V := Heap[O].F[Classes[C].Fields[I].Slot];
  If K = 'L' Then NRet := V Else NRet := BoxPrim(K, V);
End;

Procedure NR_fieldSet(A : PSlot);
Var O, C, I : LongInt; V : Int64; K : Char; Ok : Boolean;
Begin
  O := AP(A)^[0]; C := ClsOfMirror(AP(A)^[1]); I := AP(A)^[2];
  K := KindOfDesc(Classes[C].Fields[I].Desc);
  V := UnboxTo(AP(A)^[3], K, Ok);
  If Not Ok Then Begin ThrowNew('java/lang/IllegalArgumentException',
    'Can not set ' + Classes[C].Fields[I].Desc + ' field to null value'); Exit;
    End;
  If (Classes[C].Fields[I].Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    Classes[C].Statics[Classes[C].Fields[I].Slot] := V;
  End
  Else Heap[O].F[Classes[C].Fields[I].Slot] := V;
  NRet := 0;
End;

{ ----- invocation --------------------------------------------------------- }

Function BuildArgs(M : PMethod; Recv : LongInt; HasRecv : Boolean; Arr :
  LongInt; Var Args : Array Of Int64; Var N : LongInt) : Boolean;
Var I : LongInt; K : Char; V : Int64; Ok : Boolean;
Begin
  BuildArgs := False;
  N := 0;
  If HasRecv Then Begin Args[0] := Recv; N := 1; End;
  For I := 1 To M^.NArgs Do Begin
    K := M^.ArgKinds[I];
    If Arr = 0 Then V := 0 Else V := Heap[Arr].F[I - 1];
    V := UnboxTo(V, K, Ok);
    If Not Ok Then Begin ThrowNew('java/lang/IllegalArgumentException',
      'argument type mismatch'); Exit; End;
    Args[N] := V; Inc(N);
    If (K = 'J') Or (K = 'D') Then Begin Args[N] := 0; Inc(N); End;
  End;
  BuildArgs := True;
End;

Procedure NR_invoke(A : PSlot);
Var C, MI, Recv, Arr, N, T : LongInt; M : PMethod; Args : Array Of Int64; R :
  Int64;
Begin
  C := ClsOfMirror(AP(A)^[0]); MI := AP(A)^[1]; Recv := AP(A)^[2]; Arr :=
    AP(A)^[3];
  M := @Classes[C].Methods[MI];
  SetLength(Args, M^.NArgSlots + 2);
  T := C * 65536 + MI;
  If (M^.Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    If Not BuildArgs(M, 0, False, Arr, Args, N) Then Exit;
  End
  Else Begin
    If Recv = 0 Then Begin ThrowNPE(''); Exit; End;
    If Not BuildArgs(M, Recv, True, Arr, Args, N) Then Exit;
    If ((M^.Flags And ACC_PRIVATE) = 0) And (M^.Name <> '<init>') Then Begin
      T := FindVirtual(Heap[Recv].Cls, M^.Sel);
      If T < 0 Then Begin ThrowNew('java/lang/AbstractMethodError', JavaName(C)
        + '.' + M^.Name + M^.Desc); Exit; End;
    End;
  End;
  R := CallPacked(T, Args);
  If Pend Then Exit;
  Case M^.RetKind Of
    'V' : NRet := 0;
    'L' : NRet := R;
  Else NRet := BoxPrim(M^.RetKind, R);
  End;
End;

Procedure NR_construct(A : PSlot);
Var C, MI, Arr, N, O : LongInt; M : PMethod; Args : Array Of Int64;
Begin
  C := ClsOfMirror(AP(A)^[0]); MI := AP(A)^[1]; Arr := AP(A)^[2];
  M := @Classes[C].Methods[MI];
  EnsureInit(C);
  If Pend Then Exit;
  SetLength(Args, M^.NArgSlots + 2);
  O := NewObject(C);
  Pin(O);
  If Not BuildArgs(M, O, True, Arr, Args, N) Then Begin Unpin(1); Exit; End;
  CallPacked(C * 65536 + MI, Args);
  Unpin(1);
  If Pend Then Exit;
  NRet := O;
End;

