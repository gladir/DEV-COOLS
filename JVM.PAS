Procedure NStr_getBytes(A : PSlot);
Var S : UnicodeString; B : AnsiString; R, I : LongInt; Latin : Boolean;
Begin
  S := Heap[AP(A)^[0]].S;
  Latin := AP(A)^[1] <> 0;
  If Latin Then Begin
    SetLength(B, Length(S));
    For I := 1 To Length(S) Do If Ord(S[I]) < 256 Then B[I] := Chr(Ord(S[I])) Else B[I] := '?';
  End
  Else B := WideToUtf8(S);
  R := NewArray(ArrayClassIdx('[B'), Length(B));
  For I := 1 To Length(B) Do Heap[R].F[I - 1] := ShortInt(Ord(B[I]));
  NRet := R;
End;

