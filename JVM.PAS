Function CharsToWide(Arr : LongInt; Off, Cnt : LongInt) : UnicodeString;
Var R : UnicodeString; I : LongInt;
Begin
  SetLength(R, Cnt);
  For I := 0 To Cnt - 1 Do R[I + 1] := WideChar(Heap[Arr].F[Off + I] And $FFFF);
  CharsToWide := R;
End;

Procedure NStr_initC(A : PSlot);
Var Arr : LongInt;
Begin
  Arr := AP(A)^[1];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  Heap[AP(A)^[0]].S := CharsToWide(Arr, 0, Heap[Arr].Len);
End;

Procedure NStr_initCII(A : PSlot);
Var Arr, Off, Cnt : LongInt;
Begin
  Arr := AP(A)^[1]; Off := AP(A)^[2]; Cnt := AP(A)^[3];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  If (Off < 0) Or (Cnt < 0) Or (Off + Cnt > Heap[Arr].Len) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'offset ' + IStr(Off) + ', count ' + IStr(Cnt) + ', length ' + IStr(Heap[Arr].Len));
    Exit;
  End;
  Heap[AP(A)^[0]].S := CharsToWide(Arr, Off, Cnt);
End;

Function BytesToWide(Arr : LongInt; Off, Cnt : LongInt; Latin : Boolean) : UnicodeString;
Var B : AnsiString; I : LongInt; R : UnicodeString;
Begin
  SetLength(B, Cnt);
  For I := 0 To Cnt - 1 Do B[I + 1] := Chr(Heap[Arr].F[Off + I] And $FF);
  If Latin Then Begin
    SetLength(R, Cnt);
    For I := 1 To Cnt Do R[I] := WideChar(Ord(B[I]));
    BytesToWide := R;
  End
  Else BytesToWide := Utf8ToWide(B);
End;

Procedure NStr_initB(A : PSlot);
Var Arr : LongInt;
Begin
  Arr := AP(A)^[1];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  Heap[AP(A)^[0]].S := BytesToWide(Arr, 0, Heap[Arr].Len, False);
End;

