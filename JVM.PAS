  ACC_PRIVATE      = $0002;
  ACC_PROTECTED    = $0004;
  ACC_STATIC       = $0008;
  ACC_FINAL        = $0010;
  ACC_SYNCHRONIZED = $0020;
  ACC_VARARGS      = $0080;
  ACC_NATIVE       = $0100;
  ACC_INTERFACE    = $0200;
  ACC_ABSTRACT     = $0400;

  CP_UTF8    = 1;
  CP_INT     = 3;
  CP_FLOAT   = 4;
  CP_LONG    = 5;
  CP_DOUBLE  = 6;
  CP_CLASS   = 7;
  CP_STRING  = 8;
  CP_FIELD   = 9;
  CP_METHOD  = 10;
  CP_IMETHOD = 11;
  CP_NAMETYPE = 12;
  CP_MHANDLE = 15;
  CP_MTYPE   = 16;
  CP_DYNAMIC = 17;
