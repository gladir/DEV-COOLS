Procedure ExecIndy(C, I : LongInt; Var SP : LongInt); Forward;
Procedure LambdaCall(Site : LongInt; A : PSlot); Forward;

Function JavaName(C : LongInt) : AnsiString;
Begin
  JavaName := ReplaceCh(Classes[C].Name, '/', '.');
End;

Function ModuleOf(C : LongInt) : AnsiString;
Begin
  If (Copy(Classes[C].Name, 1, 5) = 'java/') Or (Copy(Classes[C].Name, 1, 6) =
    'javax/') Then
    ModuleOf := 'module java.base of loader ''bootstrap'''
  Else ModuleOf := 'unnamed module of loader ''app''';
End;

Function CastMsg(From, To_ : LongInt) : AnsiString;
Var A, B : AnsiString;
Begin
  A := ModuleOf(From); B := ModuleOf(To_);
  If A = B Then
    CastMsg := 'class ' + JavaName(From) + ' cannot be cast to class ' +
      JavaName(To_) + ' (' + JavaName(From) + ' and ' + JavaName(To_) +
      ' are in ' + A + ')'
  Else
    CastMsg := 'class ' + JavaName(From) + ' cannot be cast to class ' +
      JavaName(To_) + ' (' + JavaName(From) + ' is in ' + A + '; ' +
      JavaName(To_) + ' is in ' + B + ')';
End;

{Champ reference par l'entree I du pool de C : R = classe proprietaire + 1, R2
= case, N = lettre du type }
Function ResolveField(C, I : LongInt; IsStatic : Boolean) : Boolean;
Var Cn, Nm, Ds : AnsiString; K, Owner, F : LongInt;
Begin
  ResolveField := False;
  Cn := CPClassName(C, I);
  CPNameType(C, I, Nm, Ds);
  K := LoadClass(Cn);
  If K < 0 Then Begin SetErr('java/lang/NoClassDefFoundError', Cn); Exit; End;
  Owner := -1;
  F := FindFieldIn(K, Nm, Ds, Owner);
  If F < 0 Then Begin SetErr('java/lang/NoSuchFieldError', Nm); Exit; End;
  If IsStatic Then Begin
    EnsureInit(Owner);
    If Pend Then Exit;
  End;
  Classes[C].CP[I].R := Owner + 1;
  Classes[C].CP[I].R2 := Classes[Owner].Fields[F].Slot;
  Classes[C].CP[I].N := Ord(Ds[1]);
  ResolveField := True;
End;

{ Methode referencee : R = (classe * 65536 + indice) + 1, R2 = selecteur }
Function ResolveMethodRef(C, I : LongInt; IsStatic : Boolean) : Boolean;
Var Cn, Nm, Ds : AnsiString; K, PM : LongInt;
Begin
  ResolveMethodRef := False;
  Cn := CPClassName(C, I);
  CPNameType(C, I, Nm, Ds);
  K := LoadClass(Cn);
  If K < 0 Then Begin SetErr('java/lang/NoClassDefFoundError', Cn); Exit; End;
  PM := FindMethodRef(K, Nm, Ds);
  If PM < 0 Then Begin SetErr('java/lang/NoSuchMethodError', Cn + '.' + Nm +
    Ds); Exit; End;
  If IsStatic Then Begin
    EnsureInit(PM Div 65536);
    If Pend Then Exit;
  End;
  Classes[C].CP[I].R := PM + 1;
  Classes[C].CP[I].R2 := SelectorOf(Nm, Ds);
  ResolveMethodRef := True;
End;

Function NewMulti(AC : LongInt; Const Dims : Array Of LongInt; Level : LongInt)
  : LongInt;
Var R, I, Sub : LongInt;
Begin
  R := NewArray(AC, Dims[Level]);
  If Level < High(Dims) Then Begin
    Pin(R);
    For I := 0 To Dims[Level] - 1 Do Begin
      Sub := NewMulti(Classes[AC].ElemCls, Dims, Level + 1);
      Heap[R].F[I] := Sub;
    End;
    Unpin(1);
  End;
  NewMulti := R;
End;

Function ArrayDescOfClassRef(Const Nm : AnsiString) : AnsiString;
Begin
  If Nm[1] = '[' Then ArrayDescOfClassRef := '[' + Nm
  Else ArrayDescOfClassRef := '[L' + Nm + ';';
End;

Function PrimArrayDesc(T : LongInt) : AnsiString;
Begin
  Case T Of
    4 : PrimArrayDesc := '[Z'; 5 : PrimArrayDesc := '[C'; 6 : PrimArrayDesc :=
      '[F'; 7 : PrimArrayDesc := '[D';
    8 : PrimArrayDesc := '[B'; 9 : PrimArrayDesc := '[S'; 10 : PrimArrayDesc :=
      '[I'; 11 : PrimArrayDesc := '[J';
  Else PrimArrayDesc := '[I';
  End;
End;

Function CatchMatches(C, Cp, EC : LongInt) : Boolean;
Var R : LongInt;
Begin
  If Cp = 0 Then Begin CatchMatches := True; Exit; End;
  R := Classes[C].CP[Cp].R;
  If R = 0 Then Begin
    R := LoadClass(Classes[C].CP[Classes[C].CP[Cp].A].S) + 1;
    Classes[C].CP[Cp].R := R;
  End;
  If R = 0 Then CatchMatches := False Else CatchMatches := IsSubclass(EC, R -
    1);
End;

Function SwitchTarget(Code : PByteArr; OpPc : LongInt; Key : Int64; Var Ok :
  Boolean) : LongInt;
Var P, Def, Lo, Hi, N, I, T : LongInt; M : Int64;
  Function G4(Q : LongInt) : LongInt;
  Begin
    G4 := LongInt((Cardinal(Code^[Q]) Shl 24) Or (Cardinal(Code^[Q + 1]) Shl 16)
      Or (Cardinal(Code^[Q + 2]) Shl 8) Or Cardinal(Code^[Q + 3]));
  End;
Begin
  Ok := True;
  P := (OpPc + 4) And (Not 3);
  Def := G4(P);
  If Code^[OpPc] = $AA Then Begin
    Lo := G4(P + 4); Hi := G4(P + 8);
    If (Key < Lo) Or (Key > Hi) Then SwitchTarget := OpPc + Def
    Else SwitchTarget := OpPc + G4(P + 12 + (Key - Lo) * 4);
  End
  Else Begin
    N := G4(P + 4);
    T := Def;
    For I := 0 To N - 1 Do Begin
      M := G4(P + 8 + I * 8);
      If M = Key Then Begin T := G4(P + 12 + I * 8); Break; End;
    End;
    SwitchTarget := OpPc + T;
  End;
End;

