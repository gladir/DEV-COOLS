Procedure NMath_cos(A : PSlot); Begin NRet := DToSlot(Cos(SlotToD(AP(A)^[0]))); End;
Procedure NMath_tan(A : PSlot); Var X : Double; Begin X := SlotToD(AP(A)^[0]); NRet := DToSlot(Sin(X) / Cos(X)); End;
Procedure NMath_atan(A : PSlot); Begin NRet := DToSlot(ArcTan(SlotToD(AP(A)^[0]))); End;

Procedure NMath_sqrt(A : PSlot);
Var X : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or (X < 0) Then NRet := DToSlot(NanD)
  Else NRet := DToSlot(Sqrt(X));
End;

Procedure NMath_exp(A : PSlot);
Var X : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Then NRet := DToSlot(X)
  Else If X > 709.78 Then NRet := DToSlot(PosInfD)
  Else If X < -745.2 Then NRet := DToSlot(0.0)
  Else NRet := DToSlot(Exp(X));
End;

Procedure NMath_log(A : PSlot);
Var X : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or (X < 0) Then NRet := DToSlot(NanD)
  Else If X = 0 Then NRet := DToSlot(-PosInfD)
  Else If IsInfD(X) Then NRet := DToSlot(X)
  Else NRet := DToSlot(Ln(X));
End;

Procedure NMath_log10(A : PSlot);
Var X, R : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or (X < 0) Then NRet := DToSlot(NanD)
  Else If X = 0 Then NRet := DToSlot(-PosInfD)
  Else If IsInfD(X) Then NRet := DToSlot(X)
  Else Begin
    R := Ln(X) / Ln(10.0);
    If Abs(R - Round(R)) < 1e-12 Then If Abs(Exp(Round(R) * Ln(10.0)) - X) <= X * 1e-15 Then R := Round(R);
    NRet := DToSlot(R);
  End;
End;

Function PowD(X, Y : Double) : Double;
Var N : Int64; R, B : Double; Neg : Boolean;
Begin
  If Y = 0 Then Begin PowD := 1; Exit; End;
  If IsNanD(X) Or IsNanD(Y) Then Begin PowD := NanD; Exit; End;
  If IsInfD(Y) Then Begin
    If Abs(X) = 1 Then PowD := NanD
    Else If (Abs(X) > 1) = (Y > 0) Then PowD := PosInfD
    Else PowD := 0;
    Exit;
  End;
  If X = 0 Then Begin
    If Y < 0 Then PowD := PosInfD Else PowD := 0;
    Exit;
  End;
  If IsInfD(X) Then Begin
    If Y > 0 Then PowD := PosInfD Else PowD := 0;
    Exit;
  End;
  If (Y = Int(Y)) And (Abs(Y) < 1e9) Then Begin
    N := Trunc(Abs(Y)); R := 1; B := X;
    While N > 0 Do Begin
      If Odd(N) Then R := R * B;
      B := B * B;
      N := N Shr 1;
    End;
    If Y < 0 Then R := 1 / R;
    PowD := R;
    Exit;
  End;
  If X < 0 Then Begin PowD := NanD; Exit; End;
  PowD := Exp(Y * Ln(X));
End;

Procedure NMath_pow(A : PSlot);
Begin
  NRet := DToSlot(PowD(SlotToD(AP(A)^[0]), SlotToD(AP(A)^[2])));
End;

Procedure NMath_atan2(A : PSlot);
Var Y, X, R : Double;
Begin
  Y := SlotToD(AP(A)^[0]); X := SlotToD(AP(A)^[2]);
  If IsNanD(X) Or IsNanD(Y) Then Begin NRet := DToSlot(NanD); Exit; End;
  If X = 0 Then Begin
    If Y > 0 Then R := Pi / 2 Else If Y < 0 Then R := -Pi / 2 Else If IsNegD(X) Then R := Pi Else R := 0;
  End
  Else Begin
    R := ArcTan(Y / X);
    If X < 0 Then Begin If Y >= 0 Then R := R + Pi Else R := R - Pi; End;
  End;
  NRet := DToSlot(R);
End;

Procedure NMath_floor(A : PSlot);
Var X, R : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or IsInfD(X) Or (Abs(X) >= 4503599627370496.0) Then NRet := DToSlot(X)
  Else Begin
    R := Int(X);
    If (R > X) Then R := R - 1;
    If (R = 0) And IsNegD(X) Then R := -0.0;
    NRet := DToSlot(R);
  End;
End;

Procedure NMath_ceil(A : PSlot);
Var X, R : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or IsInfD(X) Or (Abs(X) >= 4503599627370496.0) Then NRet := DToSlot(X)
  Else Begin
    R := Int(X);
    If (R < X) Then R := R + 1;
    If (R = 0) And (X < 0) Then R := -0.0;
    NRet := DToSlot(R);
  End;
End;

Procedure NMath_rint(A : PSlot);
Var X, R, F : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or IsInfD(X) Or (Abs(X) >= 4503599627370496.0) Then NRet := DToSlot(X)
  Else Begin
    R := Int(X); F := X - R;
    If F > 0.5 Then R := R + 1
    Else If F < -0.5 Then R := R - 1
    Else If F = 0.5 Then Begin If Odd(Trunc(R)) Then R := R + 1; End
    Else If F = -0.5 Then Begin If Odd(Trunc(R)) Then R := R - 1; End;
    NRet := DToSlot(R);
  End;
End;

Procedure NMath_cbrt(A : PSlot);
Var X, R : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If (X = 0) Or IsNanD(X) Or IsInfD(X) Then NRet := DToSlot(X)
  Else Begin
    R := Exp(Ln(Abs(X)) / 3);
    R := R - (R * R * R - Abs(X)) / (3 * R * R);
    If Abs(Round(R) - R) < 1e-9 Then If Round(R) * Round(R) * Round(R) = Round(Abs(X)) Then R := Round(R);
    If X < 0 Then R := -R;
    NRet := DToSlot(R);
  End;
End;

Procedure NMath_asin(A : PSlot);
Var X : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or (Abs(X) > 1) Then NRet := DToSlot(NanD)
  Else If Abs(X) = 1 Then NRet := DToSlot(X * Pi / 2)
  Else NRet := DToSlot(ArcTan(X / Sqrt(1 - X * X)));
End;

Procedure NMath_acos(A : PSlot);
Var X, R : Double;
Begin
  X := SlotToD(AP(A)^[0]);
  If IsNanD(X) Or (Abs(X) > 1) Then NRet := DToSlot(NanD)
  Else If X = 1 Then NRet := DToSlot(0.0)
  Else If X = -1 Then NRet := DToSlot(Pi)
  Else Begin
    R := Pi / 2 - ArcTan(X / Sqrt(1 - X * X));
    NRet := DToSlot(R);
  End;
End;

