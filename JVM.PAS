{ une iteration de la boucle d'evenements : vrai tant que des fenetres sont affichees }
Var
  PumpMeth : LongInt;

Function GfxPump : Boolean;
Var R, Ex : LongInt;
Begin
  GfxPump := False;
  If Not GfxUsed Or Not GfxOn Then Exit;
  If PumpMeth = 0 Then PumpMeth := FindMethodByName('java/awt/WM', 'pump', '()I') + 1;
  If PumpMeth <= 0 Then Begin GfxClose; Exit; End;
  R := CallPacked(PumpMeth - 1, []);
  If Pend Then Begin
    Ex := PendingExc;
    Pend := False;
    GfxClose;
    PrintUncaught(Ex);
    ExitJvm(1);
  End;
  GfxPump := R <> 0;
End;
{ ============================================================================
  REFLEXION : acces aux membres, aux attributs bruts, invocation
  ============================================================================ }

Function KindOfDesc(Const D : AnsiString) : Char;
Begin
  If D = '' Then KindOfDesc := 'L'
  Else If (D[1] = 'L') Or (D[1] = '[') Then KindOfDesc := 'L'
  Else KindOfDesc := D[1];
End;

Function FindAttr(Const At : TAttrs; Const N : AnsiString) : LongInt;
Var I : LongInt;
Begin
  FindAttr := -1;
  For I := 0 To High(At) Do If At[I].Name = N Then Begin FindAttr := I; Exit; End;
End;

{ memberCount(Class, kind) : kind 0 champs, 1 methodes }
Procedure NR_memberCount(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If AP(A)^[1] = 0 Then NRet := Length(Classes[C].Fields) Else NRet := Length(Classes[C].Methods);
End;

Procedure NR_memberName(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2];
  If AP(A)^[1] = 0 Then NRet := JStr(Classes[C].Fields[I].Name) Else NRet := JStr(Classes[C].Methods[I].Name);
End;

Procedure NR_memberDesc(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2];
  If AP(A)^[1] = 0 Then NRet := JStr(Classes[C].Fields[I].Desc) Else NRet := JStr(Classes[C].Methods[I].Desc);
End;

{ -1 : membre cache (methode de lambda ou de proxy) }
Procedure NR_memberFlags(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2];
  If AP(A)^[1] = 0 Then NRet := Classes[C].Fields[I].Flags
  Else If Classes[C].Methods[I].Lam > 0 Then NRet := -1
  Else NRet := Classes[C].Methods[I].Flags;
End;

{ memberAttr(Class, kind, i, nom) : kind 2 = la classe elle-meme }
Procedure NR_memberAttr(A : PSlot);
Var C, I, K, J : LongInt; Nm : AnsiString; R : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2]; Nm := SOfA(AP(A)^[3]);
  Case AP(A)^[1] Of
    0 : K := FindAttr(Classes[C].Fields[I].Attrs, Nm);
    1 : K := FindAttr(Classes[C].Methods[I].Attrs, Nm);
  Else K := FindAttr(Classes[C].Attrs, Nm);
  End;
  If K < 0 Then Begin NRet := 0; Exit; End;
  Case AP(A)^[1] Of
    0 : Nm := Classes[C].Fields[I].Attrs[K].Data;
    1 : Nm := Classes[C].Methods[I].Attrs[K].Data;
  Else Nm := Classes[C].Attrs[K].Data;
  End;
  R := NewArray(ArrayClassIdx('[B'), Length(Nm));
  For J := 1 To Length(Nm) Do Heap[R].F[J - 1] := ShortInt(Byte(Nm[J]));
  NRet := R;
End;

Procedure NR_cpUtf8(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[1];
  If (I > 0) And (I < Length(Classes[C].CP)) And (Classes[C].CP[I].Tag In [CP_CLASS, CP_STRING, CP_MTYPE]) Then I := Classes[C].CP[I].A;
  If (I <= 0) Or (I >= Length(Classes[C].CP)) Or (Classes[C].CP[I].Tag <> CP_UTF8) Then NRet := 0
  Else NRet := JStr(Classes[C].CP[I].S);
End;

{ cpRef(Class, idx, part) : NameAndType -> nom (0) ou descripteur (1) }
Procedure NR_cpRef(A : PSlot);
Var C, I, P : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[1]; P := AP(A)^[2];
  If (I <= 0) Or (I >= Length(Classes[C].CP)) Or (Classes[C].CP[I].Tag <> CP_NAMETYPE) Then Begin NRet := 0; Exit; End;
  If P = 0 Then I := Classes[C].CP[I].A Else I := Classes[C].CP[I].B;
  NRet := JStr(Classes[C].CP[I].S);
End;

Procedure NR_cpTag(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[1];
  If (I <= 0) Or (I >= Length(Classes[C].CP)) Then NRet := 0 Else NRet := Classes[C].CP[I].Tag;
End;

Procedure NR_cpNum(A : PSlot);
Var C, I : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[1];
  NRet := Classes[C].CP[I].N;
End;

{ ----- champs ------------------------------------------------------------- }

Function UnboxTo(V : LongInt; K : Char; Var Ok : Boolean) : Int64;
Var Bk : Char;
Begin
  Ok := True;
  If K = 'L' Then Begin UnboxTo := V; Exit; End;
  If V = 0 Then Begin Ok := False; UnboxTo := 0; Exit; End;
  Bk := BoxKindOfClass(Heap[V].Cls);
  If Bk = #0 Then Begin Ok := False; UnboxTo := 0; Exit; End;
  UnboxTo := ConvPrim(Heap[V].F[0], Bk, K);
End;

Procedure NR_fieldGet(A : PSlot);
Var O, C, I : LongInt; V : Int64; K : Char;
Begin
  O := AP(A)^[0]; C := ClsOfMirror(AP(A)^[1]); I := AP(A)^[2];
  K := KindOfDesc(Classes[C].Fields[I].Desc);
  If (Classes[C].Fields[I].Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    V := Classes[C].Statics[Classes[C].Fields[I].Slot];
  End
  Else V := Heap[O].F[Classes[C].Fields[I].Slot];
  If K = 'L' Then NRet := V Else NRet := BoxPrim(K, V);
End;

Procedure NR_fieldSet(A : PSlot);
Var O, C, I : LongInt; V : Int64; K : Char; Ok : Boolean;
Begin
  O := AP(A)^[0]; C := ClsOfMirror(AP(A)^[1]); I := AP(A)^[2];
  K := KindOfDesc(Classes[C].Fields[I].Desc);
  V := UnboxTo(AP(A)^[3], K, Ok);
  If Not Ok Then Begin ThrowNew('java/lang/IllegalArgumentException', 'Can not set ' + Classes[C].Fields[I].Desc + ' field to null value'); Exit; End;
  If (Classes[C].Fields[I].Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    Classes[C].Statics[Classes[C].Fields[I].Slot] := V;
  End
  Else Heap[O].F[Classes[C].Fields[I].Slot] := V;
  NRet := 0;
End;

{ ----- invocation --------------------------------------------------------- }

Function BuildArgs(M : PMethod; Recv : LongInt; HasRecv : Boolean; Arr : LongInt; Var Args : Array Of Int64; Var N : LongInt) : Boolean;
Var I : LongInt; K : Char; V : Int64; Ok : Boolean;
Begin
  BuildArgs := False;
  N := 0;
  If HasRecv Then Begin Args[0] := Recv; N := 1; End;
  For I := 1 To M^.NArgs Do Begin
    K := M^.ArgKinds[I];
    If Arr = 0 Then V := 0 Else V := Heap[Arr].F[I - 1];
    V := UnboxTo(V, K, Ok);
    If Not Ok Then Begin ThrowNew('java/lang/IllegalArgumentException', 'argument type mismatch'); Exit; End;
    Args[N] := V; Inc(N);
    If (K = 'J') Or (K = 'D') Then Begin Args[N] := 0; Inc(N); End;
  End;
  BuildArgs := True;
End;

Procedure NR_invoke(A : PSlot);
Var C, MI, Recv, Arr, N, T : LongInt; M : PMethod; Args : Array Of Int64; R : Int64;
Begin
  C := ClsOfMirror(AP(A)^[0]); MI := AP(A)^[1]; Recv := AP(A)^[2]; Arr := AP(A)^[3];
  M := @Classes[C].Methods[MI];
  SetLength(Args, M^.NArgSlots + 2);
  T := C * 65536 + MI;
  If (M^.Flags And ACC_STATIC) <> 0 Then Begin
    EnsureInit(C);
    If Pend Then Exit;
    If Not BuildArgs(M, 0, False, Arr, Args, N) Then Exit;
  End
  Else Begin
    If Recv = 0 Then Begin ThrowNPE(''); Exit; End;
    If Not BuildArgs(M, Recv, True, Arr, Args, N) Then Exit;
    If ((M^.Flags And ACC_PRIVATE) = 0) And (M^.Name <> '<init>') Then Begin
      T := FindVirtual(Heap[Recv].Cls, M^.Sel);
      If T < 0 Then Begin ThrowNew('java/lang/AbstractMethodError', JavaName(C) + '.' + M^.Name + M^.Desc); Exit; End;
    End;
  End;
  R := CallPacked(T, Args);
  If Pend Then Exit;
  Case M^.RetKind Of
    'V' : NRet := 0;
    'L' : NRet := R;
  Else NRet := BoxPrim(M^.RetKind, R);
  End;
End;

Procedure NR_construct(A : PSlot);
Var C, MI, Arr, N, O : LongInt; M : PMethod; Args : Array Of Int64;
Begin
  C := ClsOfMirror(AP(A)^[0]); MI := AP(A)^[1]; Arr := AP(A)^[2];
  M := @Classes[C].Methods[MI];
  EnsureInit(C);
  If Pend Then Exit;
  SetLength(Args, M^.NArgSlots + 2);
  O := NewObject(C);
  Pin(O);
  If Not BuildArgs(M, O, True, Arr, Args, N) Then Begin Unpin(1); Exit; End;
  CallPacked(C * 65536 + MI, Args);
  Unpin(1);
  If Pend Then Exit;
  NRet := O;
End;

{ allocate(Class) : objet sans appeler de constructeur (serialisation) }
Procedure NR_allocate(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  EnsureInit(C);
  If Pend Then Exit;
  NRet := NewObject(C);
End;

{ Class.getModifiers : drapeaux de InnerClasses pour les classes imbriquees }
Procedure NClass_getModifiers2(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If Classes[C].IsInnerInfo Then NRet := Classes[C].InnerFlags And $FFFF
  Else If Classes[C].IsArray Then Begin
    NRet := ACC_PUBLIC Or ACC_FINAL Or ACC_ABSTRACT;
  End
  Else NRet := Classes[C].Flags And $FFFF;
End;

Procedure NR_initClass(A : PSlot);
Begin
  EnsureInit(ClsOfMirror(AP(A)^[0]));
  NRet := 0;
End;

Procedure NR_isLinkedDeclared(A : PSlot);
Begin
  NRet := 0;
End;

{ ----- proxy dynamiques ---------------------------------------------------- }

Type
  TProxyMeth = Record Cls, MIdx : LongInt; End;

Var
  ProxyMeths : Array Of TProxyMeth;
  NProxyMeths : LongInt;
  ProxyDispatchPM : LongInt = -1;

Function AddProxyMeth(SC, DeclC, MI : LongInt) : LongInt;
Var N, I, J : LongInt; Src : PMethod;
Begin
  If NProxyMeths >= Length(ProxyMeths) Then SetLength(ProxyMeths, NProxyMeths * 2 + 32);
  ProxyMeths[NProxyMeths].Cls := DeclC;
  ProxyMeths[NProxyMeths].MIdx := MI;
  Src := @Classes[DeclC].Methods[MI];
  N := Length(Classes[SC].Methods);
  SetLength(Classes[SC].Methods, N + 1);
  FillChar(Classes[SC].Methods[N], SizeOf(TMethod), 0);
  Classes[SC].Methods[N].Name := Src^.Name;
  Classes[SC].Methods[N].Desc := Src^.Desc;
  Classes[SC].Methods[N].Flags := ACC_PUBLIC Or ACC_FINAL;
  Classes[SC].Methods[N].Cls := SC;
  Classes[SC].Methods[N].Lam := -(NProxyMeths + 1);
  ParseDesc(Src^.Desc, Classes[SC].Methods[N].ArgKinds, Classes[SC].Methods[N].RetKind);
  Classes[SC].Methods[N].NArgs := Length(Classes[SC].Methods[N].ArgKinds);
  J := 1;
  For I := 1 To Length(Classes[SC].Methods[N].ArgKinds) Do Inc(J, ArgSlotsOf(Classes[SC].Methods[N].ArgKinds[I]));
  Classes[SC].Methods[N].NArgSlots := J;
  Classes[SC].Methods[N].Sel := Src^.Sel;
  Inc(NProxyMeths);
  AddProxyMeth := N;
End;

Procedure ProxyAddIface(SC, Ic : LongInt);
Var I, J, K : LongInt; Have : Boolean;
Begin
  For I := 0 To High(Classes[Ic].Methods) Do Begin
    If (Classes[Ic].Methods[I].Flags And (ACC_STATIC Or ACC_PRIVATE)) <> 0 Then Continue;
    If Classes[Ic].Methods[I].Name = '<clinit>' Then Continue;
    Have := False;
    For J := 0 To High(Classes[SC].Methods) Do
      If Classes[SC].Methods[J].Sel = Classes[Ic].Methods[I].Sel Then Have := True;
    If Not Have Then AddProxyMeth(SC, Ic, I);
  End;
  For K := 0 To High(Classes[Ic].Ifaces) Do ProxyAddIface(SC, Classes[Ic].Ifaces[K]);
End;

{ defineProxy(Class[] interfaces, String nom) : Class }
Procedure NR_defineProxy(A : PSlot);
Var Arr, I, SC, PC, K : LongInt; Nm : AnsiString;
Begin
  Arr := AP(A)^[0]; Nm := ReplaceCh(SOfA(AP(A)^[1]), '.', '/');
  PC := LoadClass('java/lang/reflect/Proxy');
  EnsureInit(PC);
  If Pend Then Exit;
  SC := NewClassRec(Nm);
  Classes[SC].Flags := ACC_PUBLIC Or ACC_FINAL;
  Classes[SC].Super := PC;
  Classes[SC].NInst := Classes[PC].NInst;
  Classes[SC].InitState := 2;
  Classes[SC].ObjKind := KIND_OBJ;
  SetLength(Classes[SC].Ifaces, Heap[Arr].Len);
  For I := 0 To Heap[Arr].Len - 1 Do Classes[SC].Ifaces[I] := ClsOfMirror(Heap[Arr].F[I]);
  { methodes de Object, puis celles des interfaces }
  For K := 0 To High(Classes[C_OBJECT].Methods) Do
    If (Classes[C_OBJECT].Methods[K].Name = 'hashCode') Or (Classes[C_OBJECT].Methods[K].Name = 'toString')
      Or ((Classes[C_OBJECT].Methods[K].Name = 'equals') And (Classes[C_OBJECT].Methods[K].Desc = '(Ljava/lang/Object;)Z')) Then
      AddProxyMeth(SC, C_OBJECT, K);
  For I := 0 To High(Classes[SC].Ifaces) Do ProxyAddIface(SC, Classes[SC].Ifaces[I]);
  NRet := MirrorOf(SC);
End;

Procedure ProxyCall(Idx : LongInt; A : PSlot);
Var PA : PSlotArr; Obj, Arr, I, Slot, DeclC, MI : LongInt; M : PMethod; R : Int64; K : Char; V : Int64; Bk : Char;
Begin
  PA := PSlotArr(A);
  Obj := PA^[0];
  DeclC := ProxyMeths[Idx].Cls; MI := ProxyMeths[Idx].MIdx;
  M := @Classes[DeclC].Methods[MI];
  Arr := NewArray(ArrayClassIdx('[Ljava/lang/Object;'), M^.NArgs);
  Pin(Arr);
  Slot := 1;
  For I := 1 To M^.NArgs Do Begin
    K := M^.ArgKinds[I];
    V := PA^[Slot];
    If K = 'L' Then Heap[Arr].F[I - 1] := V Else Heap[Arr].F[I - 1] := BoxPrim(K, V);
    Inc(Slot, ArgSlotsOf(K));
  End;
  If ProxyDispatchPM < 0 Then
    ProxyDispatchPM := FindMethodByName('java/lang/reflect/Proxy', 'dispatch', '(Ljava/lang/Object;Ljava/lang/Class;I[Ljava/lang/Object;)Ljava/lang/Object;');
  R := CallPacked(ProxyDispatchPM, [Obj, MirrorOf(DeclC), MI, Arr]);
  Unpin(1);
  If Pend Then Exit;
  K := M^.RetKind;
  If K = 'V' Then NRet := 0
  Else If K = 'L' Then NRet := R
  Else If R = 0 Then ThrowNPE('')
  Else Begin
    Bk := BoxKindOfClass(Heap[R].Cls);
    If Bk = #0 Then ThrowNew('java/lang/ClassCastException', 'proxy result')
    Else NRet := ConvPrim(Heap[R].F[0], Bk, K);
  End;
End;
