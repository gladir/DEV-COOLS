{une iteration de la boucle d'evenements : vrai tant que des fenetres sont
affichees }
Var
  PumpMeth : LongInt;

Function GfxPump : Boolean;
Var R, Ex : LongInt;
Begin
  GfxPump := False;
  If Not GfxUsed Or Not GfxOn Then Exit;
  If PumpMeth = 0 Then PumpMeth := FindMethodByName('java/awt/WM', 'pump',
    '()I') + 1;
  If PumpMeth <= 0 Then Begin GfxClose; Exit; End;
  R := CallPacked(PumpMeth - 1, []);
  If Pend Then Begin
    Ex := PendingExc;
    Pend := False;
    GfxClose;
    PrintUncaught(Ex);
    ExitJvm(1);
  End;
  GfxPump := R <> 0;
End;
