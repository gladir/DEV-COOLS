Procedure NStr_toUpperCase(A : PSlot);
Var S : UnicodeString; I : LongInt; Chg : Boolean;
Begin
  S := Heap[AP(A)^[0]].S; Chg := False;
  For I := 1 To Length(S) Do If ToUpperW(Ord(S[I])) <> Ord(S[I]) Then Begin S[I] := WideChar(ToUpperW(Ord(S[I]))); Chg := True; End;
  If Chg Then NRet := NewStr(S) Else NRet := AP(A)^[0];
End;

Procedure NStr_toLowerCase(A : PSlot);
Var S : UnicodeString; I : LongInt; Chg : Boolean;
