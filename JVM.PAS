Type
  TSlot = Int64;
  PSlot = ^TSlot;
  TBytes = Array Of Byte;
  PBytes = ^Byte;
  TStrMap = Record
    Keys  : Array Of AnsiString;
    Vals  : Array Of LongInt;
    Nexts : Array Of LongInt;
    Heads : Array Of LongInt;
    Count : LongInt;
    HSize : LongInt;
  End;

Var
