  Else If K = 'path.separator' Then NRet := JStr(':')
  Else If K = 'java.version' Then NRet := JStr('21')
  Else If K = 'java.vendor' Then NRet := JStr('Gladir')
  Else If K = 'java.vm.name' Then NRet := JStr('JVM.PAS')
