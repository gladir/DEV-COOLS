Procedure NSB_setLength(A : PSlot);
Var H, N, I, Old : LongInt;
Begin
  H := AP(A)^[0]; N := AP(A)^[1];
  If N < 0 Then Begin ThrowNew('java/lang/StringIndexOutOfBoundsException', 'String index out of range: ' + IStr(N)); Exit; End;
  Old := Length(Heap[H].S);
  SetLength(Heap[H].S, N);
  For I := Old + 1 To N Do Heap[H].S[I] := #0;
End;

Procedure NSB_reverse(A : PSlot);
Var H, I, N : LongInt; S, R : UnicodeString; C, D : WideChar;
Begin
  H := AP(A)^[0];
  S := Heap[H].S; N := Length(S);
  SetLength(R, N);
  For I := 1 To N Do R[I] := S[N - I + 1];
  { paires de substitution : on les remet dans l'ordre }
  I := 1;
  While I < N Do Begin
    C := R[I]; D := R[I + 1];
    If (Ord(C) >= $DC00) And (Ord(C) <= $DFFF) And (Ord(D) >= $D800) And (Ord(D) <= $DBFF) Then Begin
      R[I] := D; R[I + 1] := C; Inc(I);
    End;
    Inc(I);
  End;
  Heap[H].S := R;
  NRet := H;
End;

