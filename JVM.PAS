Function ClsOfMirror(H : LongInt) : LongInt;
Begin
  ClsOfMirror := Heap[H].Aux;
End;

Function ExternalName(C : LongInt) : AnsiString;
Begin
  If Classes[C].IsArray Then ExternalName := ReplaceCh(Classes[C].Name, '/', '.')
  Else ExternalName := ReplaceCh(Classes[C].Name, '/', '.');
End;

Procedure NClass_getName(A : PSlot);
Begin
  NRet := JStr(ExternalName(ClsOfMirror(AP(A)^[0])));
End;

Procedure NClass_getSimpleName(A : PSlot);
Var C : LongInt; N : AnsiString;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If Classes[C].IsArray Then Begin
    N := Classes[C].ElemDesc;
    If N[1] = 'L' Then N := Copy(N, 2, Length(N) - 2);
    Case N[1] Of
      'I' : N := 'int'; 'J' : N := 'long'; 'Z' : N := 'boolean'; 'B' : N := 'byte'; 'C' : N := 'char';
      'S' : N := 'short'; 'F' : N := 'float'; 'D' : N := 'double';
    Else Begin
      N := ReplaceCh(N, '/', '.');
      While Pos('.', N) > 0 Do Delete(N, 1, Pos('.', N));
    End;
    End;
    NRet := JStr(N + '[]');
  End
  Else Begin
    N := SimpleName(C);
    NRet := JStr(N);
  End;
End;

Procedure NClass_isInstance(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then NRet := 0 Else NRet := BoolRet(IsSubclass(Heap[O].Cls, ClsOfMirror(AP(A)^[0])));
End;

Procedure NClass_isAssignableFrom(A : PSlot);
Begin
  NRet := BoolRet(IsSubclass(ClsOfMirror(AP(A)^[1]), ClsOfMirror(AP(A)^[0])));
