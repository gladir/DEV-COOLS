  FICHIERS : natives de java.io.FS
  ============================================================================ }

Var
  FHandles : Array[1..64] Of File;
  FUsed : Array[1..64] Of Boolean;

Function FsPath(H : LongInt) : AnsiString;
Begin
  If H = 0 Then FsPath := '' Else FsPath := WideToUtf8(Heap[H].S);
End;

Procedure NFS_open(A : PSlot);
Var P : AnsiString; Mode, I, Id : LongInt; Old : Byte;
Begin
  P := FsPath(AP(A)^[0]);
  Mode := AP(A)^[1];
  Id := 0;
  For I := 1 To 64 Do If Not FUsed[I] Then Begin Id := I; Break; End;
  NRet := -1;
  If Id = 0 Then Exit;
  Assign(FHandles[Id], P);
  Old := FileMode;
  {$I-}
  Case Mode Of
    0 : Begin FileMode := 0; Reset(FHandles[Id], 1); End;
    1 : Begin FileMode := 2; Rewrite(FHandles[Id], 1); End;
  3 : Begin
    FileMode := 2;
    Reset(FHandles[Id], 1);
    If IOResult <> 0 Then Rewrite(FHandles[Id], 1);
  End;
  Else Begin
    FileMode := 2;
    Reset(FHandles[Id], 1);
    If IOResult <> 0 Then Rewrite(FHandles[Id], 1)
    Else Seek(FHandles[Id], FileSize(FHandles[Id]));
  End;
  End;
  FileMode := Old;
  If IOResult = 0 Then Begin FUsed[Id] := True; NRet := Id; End;
  {$I+}
End;

Procedure NFS_read(A : PSlot);
Var B : Byte; N : LongInt; H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := -1;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  BlockRead(FHandles[H], B, 1, N);
  {$I+}
  If (IOResult = 0) And (N = 1) Then NRet := B;
End;

Procedure NFS_readBytes(A : PSlot);
Var H, Arr, Off, Len, N, I, Got : LongInt; Buf : Array Of Byte;
Begin
  H := AP(A)^[0]; Arr := AP(A)^[1]; Off := AP(A)^[2]; Len := AP(A)^[3];
  NRet := -1;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Or (Arr = 0) Then Exit;
  If Len <= 0 Then Begin NRet := 0; Exit; End;
  SetLength(Buf, Len);
  N := 0;
  {$I-}
  BlockRead(FHandles[H], Buf[0], Len, N);
  {$I+}
  If IOResult <> 0 Then Exit;
  If N = 0 Then Exit;
  For I := 0 To N - 1 Do Heap[Arr].F[Off + I] := ShortInt(Buf[I]);
  NRet := N;
End;

Procedure NFS_write(A : PSlot);
Var H, Arr, Off, Len, I, N : LongInt; Buf : Array Of Byte;
Begin
  H := AP(A)^[0]; Arr := AP(A)^[1]; Off := AP(A)^[2]; Len := AP(A)^[3];
  If (H < 1) Or (H > 64) Or Not FUsed[H] Or (Arr = 0) Or (Len <= 0) Then Exit;
  SetLength(Buf, Len);
  For I := 0 To Len - 1 Do Buf[I] := Heap[Arr].F[Off + I] And $FF;
  {$I-}
  BlockWrite(FHandles[H], Buf[0], Len, N);
  {$I+}
  If IOResult <> 0 Then ThrowNew('java/io/IOException', 'write error');
End;

Procedure NFS_seek(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  Seek(FHandles[H], AP(A)^[1]);
  {$I+}
  If IOResult <> 0 Then ;
End;

Procedure NFS_pos(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  NRet := FilePos(FHandles[H]);
End;

Procedure NFS_size(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  NRet := FileSize(FHandles[H]);
End;

Procedure NFS_setLength(A : PSlot);
Var H : LongInt; P, Rem : Int64; Z : Array[0..4095] Of Byte; N : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  P := FileSize(FHandles[H]);
  If AP(A)^[1] < P Then Begin
    Seek(FHandles[H], AP(A)^[1]);
    Truncate(FHandles[H]);
  End
  Else Begin
    FillChar(Z, SizeOf(Z), 0);
    Seek(FHandles[H], P);
    Rem := AP(A)^[1] - P;
    While Rem > 0 Do Begin
      If Rem > 4096 Then N := 4096 Else N := Rem;
      BlockWrite(FHandles[H], Z, N);
      Dec(Rem, N);
    End;
  End;
  {$I+}
  If IOResult <> 0 Then ;
End;

Procedure NFS_close(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  Close(FHandles[H]);
  {$I+}
  If IOResult = 0 Then ;
  FUsed[H] := False;
End;

Function FsExists(Const P : AnsiString; Var Attr : Word) : Boolean;
Var SR : SearchRec;
Begin
  FsExists := False;
  Attr := 0;
  If P = '' Then Exit;
  FindFirst(P, AnyFile, SR);
  If DosError = 0 Then Begin FsExists := True; Attr := SR.Attr; End;
  FindClose(SR);
End;

Procedure NFS_exists(A : PSlot);
Var At : Word;
Begin
  NRet := BoolRet(FsExists(FsPath(AP(A)^[0]), At));
End;

Procedure NFS_isDir(A : PSlot);
Var At : Word;
Begin
  NRet := BoolRet(FsExists(FsPath(AP(A)^[0]), At) And ((At And Directory) <>
    0));
End;

Procedure NFS_length(A : PSlot);
Var SR : SearchRec; P : AnsiString;
Begin
  P := FsPath(AP(A)^[0]);
  NRet := 0;
  FindFirst(P, AnyFile, SR);
  If DosError = 0 Then NRet := SR.Size;
  FindClose(SR);
End;

Procedure NFS_delete(A : PSlot);
Var P : AnsiString; F : File; At : Word;
Begin
  P := FsPath(AP(A)^[0]);
  NRet := 0;
  If Not FsExists(P, At) Then Exit;
  {$I-}
  If (At And Directory) <> 0 Then RmDir(P)
  Else Begin Assign(F, P); Erase(F); End;
  {$I+}
  NRet := BoolRet(IOResult = 0);
End;

Procedure NFS_mkdir(A : PSlot);
Begin
  {$I-}
  MkDir(FsPath(AP(A)^[0]));
  {$I+}
  NRet := BoolRet(IOResult = 0);
End;

Procedure NFS_rename(A : PSlot);
Var F : File;
Begin
  Assign(F, FsPath(AP(A)^[0]));
  {$I-}
  Rename(F, FsPath(AP(A)^[1]));
  {$I+}
  NRet := BoolRet(IOResult = 0);
End;

Procedure NFS_list(A : PSlot);
Var SR : SearchRec; P, Nm : AnsiString; Names : Array Of AnsiString; N, I, R :
  LongInt; At : Word;
Begin
  P := FsPath(AP(A)^[0]);
  NRet := 0;
  If Not FsExists(P, At) Or ((At And Directory) = 0) Then Exit;
  If (P <> '') And (P[Length(P)] <> '/') And (P[Length(P)] <> '\') Then P := P +
    '/';
  N := 0;
  SetLength(Names, 16);
  FindFirst(P + '*', AnyFile, SR);
  While DosError = 0 Do Begin
    Nm := SR.Name;
    If (Nm <> '.') And (Nm <> '..') Then Begin
      If N >= Length(Names) Then SetLength(Names, N * 2);
      Names[N] := Nm; Inc(N);
    End;
    FindNext(SR);
  End;
  FindClose(SR);
  R := NewArray(ArrayClassIdx('[Ljava/lang/String;'), N);
  Pin(R);
  For I := 0 To N - 1 Do Heap[R].F[I] := JStr(Names[I]);
  Unpin(1);
  NRet := R;
End;

Procedure NFS_cwd(A : PSlot);
Var S : AnsiString;
Begin
  GetDir(0, S);
  NRet := JStr(S);
End;

Procedure RegisterFileNatives;
Const S = 'Ljava/lang/String;';
Begin
  RegN('java/io/FS.open(' + S + 'I)I', @NFS_open);
  RegN('java/io/FS.read(I)I', @NFS_read);
  RegN('java/io/FS.readBytes(I[BII)I', @NFS_readBytes);
  RegN('java/io/FS.write(I[BII)V', @NFS_write);
  RegN('java/io/FS.close(I)V', @NFS_close);
  RegN('java/io/FS.seek(IJ)V', @NFS_seek);
  RegN('java/io/FS.pos(I)J', @NFS_pos);
  RegN('java/io/FS.size(I)J', @NFS_size);
  RegN('java/io/FS.setLength(IJ)V', @NFS_setLength);
  RegN('java/io/FS.exists(' + S + ')Z', @NFS_exists);
  RegN('java/io/FS.isDir(' + S + ')Z', @NFS_isDir);
  RegN('java/io/FS.length(' + S + ')J', @NFS_length);
  RegN('java/io/FS.delete(' + S + ')Z', @NFS_delete);
  RegN('java/io/FS.mkdir(' + S + ')Z', @NFS_mkdir);
  RegN('java/io/FS.rename(' + S + S + ')Z', @NFS_rename);
  RegN('java/io/FS.list(' + S + ')[' + S, @NFS_list);
  RegN('java/io/FS.cwd()' + S, @NFS_cwd);
End;
