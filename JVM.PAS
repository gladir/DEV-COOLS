Begin
  K := SOfA(AP(A)^[0]);
  NRet := 0;
  If K = 'line.separator' Then NRet := JStr(#10)
  Else If K = 'file.separator' Then NRet := JStr('/')
  Else If K = 'path.separator' Then NRet := JStr(':')
  Else If K = 'java.version' Then NRet := JStr('21')
  Else If K = 'java.vendor' Then NRet := JStr('Gladir')
  Else If K = 'java.vm.name' Then NRet := JStr('JVM.PAS')
  Else If K = 'os.name' Then NRet := JStr('Pascal')
  Else If K = 'user.dir' Then Begin
    { repertoire courant }
    NRet := JStr('.');
  End
  Else If K = 'user.name' Then NRet := JStr('user')
  Else If K = 'java.specification.version' Then NRet := JStr('21')
  Else If K = 'file.encoding' Then NRet := JStr('UTF-8');
End;

