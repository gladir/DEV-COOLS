Procedure NStr_repeat(A : PSlot);
Var S, R : UnicodeString; N, I : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; N := AP(A)^[1];
  If N < 0 Then Begin ThrowNew('java/lang/IllegalArgumentException', 'count is negative: ' + IStr(N)); Exit; End;
  R := '';
  For I := 1 To N Do R := R + S;
  NRet := NewStr(R);
End;

Procedure NStr_codePointAt(A : PSlot);
Var S : UnicodeString; I, C, D : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; I := AP(A)^[1];
  If (I < 0) Or (I >= Length(S)) Then Begin ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Index ' + IStr(I) + ' out of bounds for length ' + IStr(Length(S))); Exit; End;
  C := Ord(S[I + 1]);
  If (C >= $D800) And (C <= $DBFF) And (I + 2 <= Length(S)) Then Begin
    D := Ord(S[I + 2]);
    If (D >= $DC00) And (D <= $DFFF) Then C := $10000 + ((C - $D800) Shl 10) + (D - $DC00);
  End;
  NRet := C;
End;

Procedure NStr_fromCodePoint(A : PSlot);
Var W : UnicodeString; C : LongInt;
Begin
  C := AP(A)^[0];
  If C >= $10000 Then Begin
    Dec(C, $10000);
    SetLength(W, 2); W[1] := WideChar($D800 + (C Shr 10)); W[2] := WideChar($DC00 + (C And $3FF));
  End
  Else Begin SetLength(W, 1); W[1] := WideChar(C); End;
  NRet := NewStr(W);
End;

