Procedure NVM_newArray(A : PSlot);
Var C, K : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  K := AP(A)^[1];
  If K < 0 Then Begin ThrowNew('java/lang/NegativeArraySizeException', IStr(K)); Exit; End;
  If Classes[C].IsArray Then NRet := NewArray(ArrayClassIdx('[' + Classes[C].Name), K)
  Else If Classes[C].Name = 'int' Then NRet := NewArray(ArrayClassIdx('[I'), K)
  Else If Classes[C].Name = 'long' Then NRet := NewArray(ArrayClassIdx('[J'), K)
  Else If Classes[C].Name = 'double' Then NRet := NewArray(ArrayClassIdx('[D'), K)
  Else If Classes[C].Name = 'float' Then NRet := NewArray(ArrayClassIdx('[F'), K)
  Else If Classes[C].Name = 'boolean' Then NRet := NewArray(ArrayClassIdx('[Z'), K)
  Else If Classes[C].Name = 'char' Then NRet := NewArray(ArrayClassIdx('[C'), K)
  Else If Classes[C].Name = 'short' Then NRet := NewArray(ArrayClassIdx('[S'), K)
  Else If Classes[C].Name = 'byte' Then NRet := NewArray(ArrayClassIdx('[B'), K)
  Else NRet := NewArray(ArrayClassIdx('[L' + Classes[C].Name + ';'), K);
End;
{ ============================================================================
  FICHIERS : natives de java.io.FS
  ============================================================================ }

Var
  FHandles : Array[1..64] Of File;
  FUsed : Array[1..64] Of Boolean;

Function FsPath(H : LongInt) : AnsiString;
Begin
  If H = 0 Then FsPath := '' Else FsPath := WideToUtf8(Heap[H].S);
End;

Procedure NFS_open(A : PSlot);
Var P : AnsiString; Mode, I, Id : LongInt; Old : Byte;
Begin
  P := FsPath(AP(A)^[0]);
  Mode := AP(A)^[1];
  Id := 0;
  For I := 1 To 64 Do If Not FUsed[I] Then Begin Id := I; Break; End;
  NRet := -1;
  If Id = 0 Then Exit;
  Assign(FHandles[Id], P);
  Old := FileMode;
  {$I-}
  Case Mode Of
    0 : Begin FileMode := 0; Reset(FHandles[Id], 1); End;
    1 : Begin FileMode := 2; Rewrite(FHandles[Id], 1); End;
  3 : Begin
    FileMode := 2;
    Reset(FHandles[Id], 1);
    If IOResult <> 0 Then Rewrite(FHandles[Id], 1);
  End;
  Else Begin
    FileMode := 2;
    Reset(FHandles[Id], 1);
    If IOResult <> 0 Then Rewrite(FHandles[Id], 1)
    Else Seek(FHandles[Id], FileSize(FHandles[Id]));
  End;
  End;
  FileMode := Old;
  If IOResult = 0 Then Begin FUsed[Id] := True; NRet := Id; End;
  {$I+}
End;

Procedure NFS_read(A : PSlot);
Var B : Byte; N : LongInt; H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := -1;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  BlockRead(FHandles[H], B, 1, N);
  {$I+}
  If (IOResult = 0) And (N = 1) Then NRet := B;
End;

Procedure NFS_readBytes(A : PSlot);
Var H, Arr, Off, Len, N, I, Got : LongInt; Buf : Array Of Byte;
Begin
  H := AP(A)^[0]; Arr := AP(A)^[1]; Off := AP(A)^[2]; Len := AP(A)^[3];
  NRet := -1;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Or (Arr = 0) Then Exit;
  If Len <= 0 Then Begin NRet := 0; Exit; End;
  SetLength(Buf, Len);
  N := 0;
  {$I-}
  BlockRead(FHandles[H], Buf[0], Len, N);
  {$I+}
  If IOResult <> 0 Then Exit;
  If N = 0 Then Exit;
  For I := 0 To N - 1 Do Heap[Arr].F[Off + I] := ShortInt(Buf[I]);
  NRet := N;
End;

Procedure NFS_write(A : PSlot);
Var H, Arr, Off, Len, I, N : LongInt; Buf : Array Of Byte;
Begin
  H := AP(A)^[0]; Arr := AP(A)^[1]; Off := AP(A)^[2]; Len := AP(A)^[3];
  If (H < 1) Or (H > 64) Or Not FUsed[H] Or (Arr = 0) Or (Len <= 0) Then Exit;
  SetLength(Buf, Len);
  For I := 0 To Len - 1 Do Buf[I] := Heap[Arr].F[Off + I] And $FF;
  {$I-}
  BlockWrite(FHandles[H], Buf[0], Len, N);
  {$I+}
  If IOResult <> 0 Then ThrowNew('java/io/IOException', 'write error');
End;

Procedure NFS_seek(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
  {$I-}
  Seek(FHandles[H], AP(A)^[1]);
  {$I+}
  If IOResult <> 0 Then ;
End;

Procedure NFS_pos(A : PSlot);
Var H : LongInt;
Begin
  H := AP(A)^[0];
  NRet := 0;
  If (H < 1) Or (H > 64) Or Not FUsed[H] Then Exit;
