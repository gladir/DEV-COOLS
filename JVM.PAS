Procedure RegSB(Const Name, Args, Ret : AnsiString; P : TNativeProc);
Var R1, R2 : AnsiString;
Begin
  If Ret = 'T' Then Begin R1 := 'Ljava/lang/StringBuilder;'; R2 := 'Ljava/lang/StringBuffer;'; End
  Else Begin R1 := Ret; R2 := Ret; End;
  RegN('java/lang/StringBuilder.' + Name + Args + R1, P);
  RegN('java/lang/StringBuffer.' + Name + Args + R2, P);
End;

