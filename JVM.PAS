{ une iteration de la boucle d'evenements : vrai tant que des fenetres sont affichees }
Var
  PumpMeth : LongInt;

Function GfxPump : Boolean;
Var R, Ex : LongInt;
Begin
  GfxPump := False;
  If Not GfxUsed Or Not GfxOn Then Exit;
  If PumpMeth = 0 Then PumpMeth := FindMethodByName('java/awt/WM', 'pump', '()I') + 1;
  If PumpMeth <= 0 Then Begin GfxClose; Exit; End;
  R := CallPacked(PumpMeth - 1, []);
  If Pend Then Begin
    Ex := PendingExc;
    Pend := False;
    GfxClose;
    PrintUncaught(Ex);
    ExitJvm(1);
  End;
  GfxPump := R <> 0;
End;
{ ============================================================================
  CLASSES DE BIBLIOTHEQUE INCLUSES (section DONNEES : voir plus bas)
  ============================================================================ }

Var
  EmbMap : TStrMap;
  EmbData : Array Of AnsiString;
  NEmb : LongInt;

Procedure EmbAdd(Const Name, Data : AnsiString);
Begin
  If NEmb >= Length(EmbData) Then SetLength(EmbData, NEmb * 2 + 256);
  EmbData[NEmb] := Data;
  MapPut(EmbMap, Name, NEmb);
  Inc(NEmb);
End;

Function B64Val(C : Char) : LongInt;
Begin
  Case C Of
    'A'..'Z' : B64Val := Ord(C) - 65;
    'a'..'z' : B64Val := Ord(C) - 71;
    '0'..'9' : B64Val := Ord(C) + 4;
    '+' : B64Val := 62;
    '/' : B64Val := 63;
  Else B64Val := 0;
  End;
End;

Function EmbeddedClassBytes(Const Name : AnsiString; Var B : TBytes) : Boolean;
Var I, N, J, K, Acc, Bits : LongInt; D : AnsiString;
Begin
  I := MapFind(EmbMap, Name);
  EmbeddedClassBytes := I >= 0;
  If I < 0 Then Exit;
  D := EmbData[I];
  N := (Length(D) * 6) Div 8;
  SetLength(B, N);
  J := 0; Acc := 0; Bits := 0;
  For K := 1 To Length(D) Do Begin
    Acc := (Acc Shl 6) Or B64Val(D[K]);
    Inc(Bits, 6);
    If Bits >= 8 Then Begin
      Dec(Bits, 8);
      B[J] := (Acc Shr Bits) And $FF;
      Inc(J);
      Acc := Acc And ((1 Shl Bits) - 1);
    End;
  End;
End;
