Procedure RegSB(Const Name, Args, Ret : AnsiString; P : TNativeProc);
Var R1, R2 : AnsiString;
Begin
  If Ret = 'T' Then Begin R1 := 'Ljava/lang/StringBuilder;'; R2 :=
    'Ljava/lang/StringBuffer;'; End
