{ memberAttr(Class, kind, i, nom) : kind 2 = la classe elle-meme }
Procedure NR_memberAttr(A : PSlot);
Var C, I, K, J : LongInt; Nm : AnsiString; R : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]); I := AP(A)^[2]; Nm := SOfA(AP(A)^[3]);
  Case AP(A)^[1] Of
    0 : K := FindAttr(Classes[C].Fields[I].Attrs, Nm);
    1 : K := FindAttr(Classes[C].Methods[I].Attrs, Nm);
  Else K := FindAttr(Classes[C].Attrs, Nm);
  End;
  If K < 0 Then Begin NRet := 0; Exit; End;
  Case AP(A)^[1] Of
    0 : Nm := Classes[C].Fields[I].Attrs[K].Data;
    1 : Nm := Classes[C].Methods[I].Attrs[K].Data;
  Else Nm := Classes[C].Attrs[K].Data;
  End;
  R := NewArray(ArrayClassIdx('[B'), Length(Nm));
  For J := 1 To Length(Nm) Do Heap[R].F[J - 1] := ShortInt(Byte(Nm[J]));
  NRet := R;
End;

