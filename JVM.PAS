  INTERPRETEUR
  ============================================================================ }

Function ArrOOB(Idx, Len : Int64) : AnsiString;
Begin
  ArrOOB := 'Index ' + IStr(Idx) + ' out of bounds for length ' + IStr(Len);
End;

Procedure Run(StopDepth : LongInt);
Var
  St : PSlotArr;
  Code : PByteArr;
  CPA : PCPArr;
  MP, CM : PMethod;
  pc, sp, base, opPc, cls, mth, I, J, K, NS, CallPM, Ref, Idx, Sel, RC, T : LongInt;
  a, b, v : Int64;
  Slow, Ok : Boolean;
  op : Byte;
  fa, fb : Single;
  da, db : Double;
  CA : TConv;
  E : AnsiString;
  Dims : Array Of LongInt;

  Procedure Reload;
  Begin
    cls := Frames^[FTop - 1].Cls;
    mth := Frames^[FTop - 1].Mth;
    MP := @Classes[cls].Methods[mth];
    If Length(MP^.Code) > 0 Then Code := PByteArr(@MP^.Code[0]);
    base := Frames^[FTop - 1].Base;
    CPA := PCPArr(@Classes[cls].CP[0]);
  End;

Begin
  St := Stk;
  Reload;
  { le cadre courant a ete empile par l'appelant : pc et sp sont ceux du cadre }
  pc := Frames^[FTop - 1].Pc;
  sp := Frames^[FTop - 1].Base + MP^.MaxLocals;
  Slow := False;
  CallPM := -1;
  RunLevel := RunLevel + 1;
  While True Do Begin
    Dec(Budget);
    If Budget <= 0 Then TimeSlice(sp);
    opPc := pc;
    op := Code^[pc];
    Case op Of
      $00 : Inc(pc);
      $01 : Begin St^[sp] := 0; Inc(sp); Inc(pc); End;
      $02..$08 : Begin St^[sp] := Integer(op) - 3; Inc(sp); Inc(pc); End;
      $09, $0A : Begin St^[sp] := op - $09; St^[sp + 1] := 0; Inc(sp, 2); Inc(pc); End;
      $0B..$0D : Begin
        da := op - $0B;
        St^[sp] := FToSlot(da); Inc(sp); Inc(pc);
      End;
      $0E, $0F : Begin
        da := op - $0E;
        St^[sp] := DToSlot(da); St^[sp + 1] := 0; Inc(sp, 2); Inc(pc);
      End;
      $10 : Begin St^[sp] := ShortInt(Code^[pc + 1]); Inc(sp); Inc(pc, 2); End;
      $11 : Begin St^[sp] := SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]); Inc(sp); Inc(pc, 3); End;
      $12, $13, $14 : Begin
        If op = $12 Then Begin Idx := Code^[pc + 1]; K := 2; End
        Else Begin Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2]; K := 3; End;
        If GcWanted Then Begin GSP := sp; CollectGarbage(PSlot(St), sp); End;
        Case CPA^[Idx].Tag Of
          CP_INT, CP_FLOAT : Begin St^[sp] := CPA^[Idx].N; Inc(sp); End;
          CP_LONG, CP_DOUBLE : Begin St^[sp] := CPA^[Idx].N; St^[sp + 1] := 0; Inc(sp, 2); End;
          CP_STRING : Begin St^[sp] := CPStringObj(cls, Idx); Inc(sp); End;
          CP_CLASS : Begin
            T := ResolveClass(cls, Idx);
            If T >= 0 Then Begin St^[sp] := MirrorOf(T); Inc(sp); End Else Slow := True;
          End;
        Else
          SetErr('java/lang/UnsupportedOperationException', 'ldc de ce type de constante');
          Slow := True;
        End;
        Inc(pc, K);
      End;
      $15, $17, $19 : Begin St^[sp] := St^[base + Code^[pc + 1]]; Inc(sp); Inc(pc, 2); End;
      $16, $18 : Begin St^[sp] := St^[base + Code^[pc + 1]]; St^[sp + 1] := 0; Inc(sp, 2); Inc(pc, 2); End;
      $1A..$1D : Begin St^[sp] := St^[base + (op - $1A)]; Inc(sp); Inc(pc); End;
      $1E..$21 : Begin St^[sp] := St^[base + (op - $1E)]; St^[sp + 1] := 0; Inc(sp, 2); Inc(pc); End;
      $22..$25 : Begin St^[sp] := St^[base + (op - $22)]; Inc(sp); Inc(pc); End;
      $26..$29 : Begin St^[sp] := St^[base + (op - $26)]; St^[sp + 1] := 0; Inc(sp, 2); Inc(pc); End;
      $2A..$2D : Begin St^[sp] := St^[base + (op - $2A)]; Inc(sp); Inc(pc); End;
      $2E, $30, $32, $33, $34, $35 : Begin
        Idx := St^[sp - 1]; Ref := St^[sp - 2];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else If (Idx < 0) Or (Idx >= Heap[Ref].Len) Then Begin SetErr('java/lang/ArrayIndexOutOfBoundsException', ArrOOB(Idx, Heap[Ref].Len)); Slow := True; End
        Else Begin St^[sp - 2] := Heap[Ref].F[Idx]; Dec(sp); Inc(pc); End;
      End;
      $2F, $31 : Begin
        Idx := St^[sp - 1]; Ref := St^[sp - 2];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else If (Idx < 0) Or (Idx >= Heap[Ref].Len) Then Begin SetErr('java/lang/ArrayIndexOutOfBoundsException', ArrOOB(Idx, Heap[Ref].Len)); Slow := True; End
        Else Begin St^[sp - 2] := Heap[Ref].F[Idx]; St^[sp - 1] := 0; Inc(pc); End;
      End;
      $36, $38, $3A : Begin Dec(sp); St^[base + Code^[pc + 1]] := St^[sp]; Inc(pc, 2); End;
      $37, $39 : Begin Dec(sp, 2); St^[base + Code^[pc + 1]] := St^[sp]; Inc(pc, 2); End;
      $3B..$3E : Begin Dec(sp); St^[base + (op - $3B)] := St^[sp]; Inc(pc); End;
      $3F..$42 : Begin Dec(sp, 2); St^[base + (op - $3F)] := St^[sp]; Inc(pc); End;
      $43..$46 : Begin Dec(sp); St^[base + (op - $43)] := St^[sp]; Inc(pc); End;
      $47..$4A : Begin Dec(sp, 2); St^[base + (op - $47)] := St^[sp]; Inc(pc); End;
      $4B..$4E : Begin Dec(sp); St^[base + (op - $4B)] := St^[sp]; Inc(pc); End;
      $4F, $51, $54, $55, $56 : Begin
        v := St^[sp - 1]; Idx := St^[sp - 2]; Ref := St^[sp - 3];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else If (Idx < 0) Or (Idx >= Heap[Ref].Len) Then Begin SetErr('java/lang/ArrayIndexOutOfBoundsException', ArrOOB(Idx, Heap[Ref].Len)); Slow := True; End
        Else Begin
          Case op Of
            $54 : v := ShortInt(v);
            $55 : v := Word(v);
            $56 : v := SmallInt(v);
          End;
          Heap[Ref].F[Idx] := v;
          Dec(sp, 3); Inc(pc);
        End;
      End;
      $50, $52 : Begin
        v := St^[sp - 2]; Idx := St^[sp - 3]; Ref := St^[sp - 4];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else If (Idx < 0) Or (Idx >= Heap[Ref].Len) Then Begin SetErr('java/lang/ArrayIndexOutOfBoundsException', ArrOOB(Idx, Heap[Ref].Len)); Slow := True; End
        Else Begin Heap[Ref].F[Idx] := v; Dec(sp, 4); Inc(pc); End;
      End;
      $53 : Begin
        v := St^[sp - 1]; Idx := St^[sp - 2]; Ref := St^[sp - 3];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else If (Idx < 0) Or (Idx >= Heap[Ref].Len) Then Begin SetErr('java/lang/ArrayIndexOutOfBoundsException', ArrOOB(Idx, Heap[Ref].Len)); Slow := True; End
        Else Begin
          T := Classes[Heap[Ref].Cls].ElemCls;
          If (v <> 0) And (T >= 0) And (T <> C_OBJECT) And Not IsSubclass(Heap[v].Cls, T) Then Begin
            SetErr('java/lang/ArrayStoreException', JavaName(Heap[v].Cls)); Slow := True;
          End
          Else Begin Heap[Ref].F[Idx] := v; Dec(sp, 3); Inc(pc); End;
        End;
      End;
      $57 : Begin Dec(sp); Inc(pc); End;
      $58 : Begin Dec(sp, 2); Inc(pc); End;
      $59 : Begin St^[sp] := St^[sp - 1]; Inc(sp); Inc(pc); End;
      $5A : Begin
        St^[sp] := St^[sp - 1]; St^[sp - 1] := St^[sp - 2]; St^[sp - 2] := St^[sp]; Inc(sp); Inc(pc);
      End;
      $5B : Begin
        St^[sp] := St^[sp - 1]; St^[sp - 1] := St^[sp - 2]; St^[sp - 2] := St^[sp - 3]; St^[sp - 3] := St^[sp]; Inc(sp); Inc(pc);
      End;
      $5C : Begin St^[sp] := St^[sp - 2]; St^[sp + 1] := St^[sp - 1]; Inc(sp, 2); Inc(pc); End;
      $5D : Begin
        St^[sp + 1] := St^[sp - 1]; St^[sp] := St^[sp - 2];
        St^[sp - 1] := St^[sp - 3]; St^[sp - 2] := St^[sp + 1]; St^[sp - 3] := St^[sp];
        Inc(sp, 2); Inc(pc);
      End;
      $5E : Begin
        St^[sp + 1] := St^[sp - 1]; St^[sp] := St^[sp - 2];
        St^[sp - 1] := St^[sp - 3]; St^[sp - 2] := St^[sp - 4];
        St^[sp - 3] := St^[sp + 1]; St^[sp - 4] := St^[sp];
        Inc(sp, 2); Inc(pc);
      End;
      $5F : Begin a := St^[sp - 1]; St^[sp - 1] := St^[sp - 2]; St^[sp - 2] := a; Inc(pc); End;
      $60 : Begin St^[sp - 2] := LongInt(St^[sp - 2] + St^[sp - 1]); Dec(sp); Inc(pc); End;
      $61 : Begin St^[sp - 4] := St^[sp - 4] + St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $62 : Begin fa := SlotToF(St^[sp - 2]); fb := SlotToF(St^[sp - 1]); St^[sp - 2] := FToSlot(Single(fa + fb)); Dec(sp); Inc(pc); End;
      $63 : Begin da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); St^[sp - 4] := DToSlot(da + db); Dec(sp, 2); Inc(pc); End;
      $64 : Begin St^[sp - 2] := LongInt(St^[sp - 2] - St^[sp - 1]); Dec(sp); Inc(pc); End;
      $65 : Begin St^[sp - 4] := St^[sp - 4] - St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $66 : Begin fa := SlotToF(St^[sp - 2]); fb := SlotToF(St^[sp - 1]); St^[sp - 2] := FToSlot(Single(fa - fb)); Dec(sp); Inc(pc); End;
      $67 : Begin da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); St^[sp - 4] := DToSlot(da - db); Dec(sp, 2); Inc(pc); End;
      $68 : Begin St^[sp - 2] := LongInt(St^[sp - 2] * St^[sp - 1]); Dec(sp); Inc(pc); End;
      $69 : Begin St^[sp - 4] := St^[sp - 4] * St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $6A : Begin fa := SlotToF(St^[sp - 2]); fb := SlotToF(St^[sp - 1]); St^[sp - 2] := FToSlot(Single(fa * fb)); Dec(sp); Inc(pc); End;
      $6B : Begin da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); St^[sp - 4] := DToSlot(da * db); Dec(sp, 2); Inc(pc); End;
      $6C, $70 : Begin
        b := St^[sp - 1];
        If b = 0 Then Begin SetErr('java/lang/ArithmeticException', '/ by zero'); Slow := True; End
        Else Begin
          a := St^[sp - 2];
          If op = $6C Then St^[sp - 2] := LongInt(a Div b) Else St^[sp - 2] := a Mod b;
          Dec(sp); Inc(pc);
        End;
      End;
      $6D, $71 : Begin
        b := St^[sp - 2];
        If b = 0 Then Begin SetErr('java/lang/ArithmeticException', '/ by zero'); Slow := True; End
        Else Begin
          a := St^[sp - 4];
          If b = -1 Then Begin
            If op = $6D Then St^[sp - 4] := -a Else St^[sp - 4] := 0;
          End
          Else If op = $6D Then St^[sp - 4] := a Div b Else St^[sp - 4] := a Mod b;
          Dec(sp, 2); Inc(pc);
        End;
      End;
      $6E : Begin fa := SlotToF(St^[sp - 2]); fb := SlotToF(St^[sp - 1]); St^[sp - 2] := FToSlot(Single(fa / fb)); Dec(sp); Inc(pc); End;
      $6F : Begin da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); St^[sp - 4] := DToSlot(da / db); Dec(sp, 2); Inc(pc); End;
      $72 : Begin da := SlotToF(St^[sp - 2]); db := SlotToF(St^[sp - 1]); St^[sp - 2] := FToSlot(FModD(da, db)); Dec(sp); Inc(pc); End;
      $73 : Begin da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); St^[sp - 4] := DToSlot(FModD(da, db)); Dec(sp, 2); Inc(pc); End;
      $74 : Begin St^[sp - 1] := LongInt(-St^[sp - 1]); Inc(pc); End;
      $75 : Begin St^[sp - 2] := -St^[sp - 2]; Inc(pc); End;
      $76 : Begin fa := SlotToF(St^[sp - 1]); St^[sp - 1] := FToSlot(-fa); Inc(pc); End;
      $77 : Begin da := SlotToD(St^[sp - 2]); St^[sp - 2] := DToSlot(-da); Inc(pc); End;
      $78 : Begin St^[sp - 2] := LongInt(Cardinal(St^[sp - 2]) Shl (St^[sp - 1] And 31)); Dec(sp); Inc(pc); End;
      $79 : Begin St^[sp - 3] := Int64(QWord(St^[sp - 3]) Shl (St^[sp - 1] And 63)); Dec(sp); Inc(pc); End;
      $7A : Begin
        a := St^[sp - 2]; K := St^[sp - 1] And 31;
        If a >= 0 Then St^[sp - 2] := a Shr K Else St^[sp - 2] := Not ((Not a) Shr K);
        Dec(sp); Inc(pc);
      End;
      $7B : Begin
        a := St^[sp - 3]; K := St^[sp - 1] And 63;
        If a >= 0 Then St^[sp - 3] := a Shr K Else St^[sp - 3] := Not ((Not a) Shr K);
        Dec(sp); Inc(pc);
      End;
      $7C : Begin St^[sp - 2] := LongInt(Cardinal(St^[sp - 2]) Shr (St^[sp - 1] And 31)); Dec(sp); Inc(pc); End;
      $7D : Begin St^[sp - 3] := Int64(QWord(St^[sp - 3]) Shr (St^[sp - 1] And 63)); Dec(sp); Inc(pc); End;
      $7E : Begin St^[sp - 2] := St^[sp - 2] And St^[sp - 1]; Dec(sp); Inc(pc); End;
      $7F : Begin St^[sp - 4] := St^[sp - 4] And St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $80 : Begin St^[sp - 2] := St^[sp - 2] Or St^[sp - 1]; Dec(sp); Inc(pc); End;
      $81 : Begin St^[sp - 4] := St^[sp - 4] Or St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $82 : Begin St^[sp - 2] := St^[sp - 2] Xor St^[sp - 1]; Dec(sp); Inc(pc); End;
      $83 : Begin St^[sp - 4] := St^[sp - 4] Xor St^[sp - 2]; Dec(sp, 2); Inc(pc); End;
      $84 : Begin
        K := base + Code^[pc + 1];
        St^[K] := LongInt(St^[K] + ShortInt(Code^[pc + 2]));
        Inc(pc, 3);
      End;
      $85 : Begin St^[sp] := 0; Inc(sp); Inc(pc); End;
      $86 : Begin St^[sp - 1] := FToSlot(St^[sp - 1]); Inc(pc); End;
      $87 : Begin St^[sp - 1] := DToSlot(St^[sp - 1]); St^[sp] := 0; Inc(sp); Inc(pc); End;
      $88 : Begin Dec(sp); St^[sp - 1] := LongInt(St^[sp - 1]); Inc(pc); End;
      $89 : Begin Dec(sp); St^[sp - 1] := FToSlot(St^[sp - 1]); Inc(pc); End;
      $8A : Begin St^[sp - 2] := DToSlot(St^[sp - 2]); Inc(pc); End;
      $8B : Begin St^[sp - 1] := D2I(SlotToF(St^[sp - 1])); Inc(pc); End;
      $8C : Begin St^[sp - 1] := D2L(SlotToF(St^[sp - 1])); St^[sp] := 0; Inc(sp); Inc(pc); End;
      $8D : Begin St^[sp - 1] := DToSlot(SlotToF(St^[sp - 1])); St^[sp] := 0; Inc(sp); Inc(pc); End;
      $8E : Begin Dec(sp); St^[sp - 1] := D2I(SlotToD(St^[sp - 1])); Inc(pc); End;
      $8F : Begin St^[sp - 2] := D2L(SlotToD(St^[sp - 2])); Inc(pc); End;
      $90 : Begin da := SlotToD(St^[sp - 2]); Dec(sp); St^[sp - 1] := FToSlot(da); Inc(pc); End;
      $91 : Begin St^[sp - 1] := ShortInt(St^[sp - 1]); Inc(pc); End;
      $92 : Begin St^[sp - 1] := Word(St^[sp - 1]); Inc(pc); End;
      $93 : Begin St^[sp - 1] := SmallInt(St^[sp - 1]); Inc(pc); End;
      $94 : Begin
        a := St^[sp - 4]; b := St^[sp - 2]; Dec(sp, 3);
        If a < b Then St^[sp - 1] := -1 Else If a > b Then St^[sp - 1] := 1 Else St^[sp - 1] := 0;
        Inc(pc);
      End;
      $95, $96 : Begin
        fa := SlotToF(St^[sp - 2]); fb := SlotToF(St^[sp - 1]); Dec(sp);
        If IsNanD(fa) Or IsNanD(fb) Then Begin If op = $95 Then St^[sp - 1] := -1 Else St^[sp - 1] := 1; End
        Else If fa < fb Then St^[sp - 1] := -1 Else If fa > fb Then St^[sp - 1] := 1 Else St^[sp - 1] := 0;
        Inc(pc);
      End;
      $97, $98 : Begin
        da := SlotToD(St^[sp - 4]); db := SlotToD(St^[sp - 2]); Dec(sp, 3);
        If IsNanD(da) Or IsNanD(db) Then Begin If op = $97 Then St^[sp - 1] := -1 Else St^[sp - 1] := 1; End
        Else If da < db Then St^[sp - 1] := -1 Else If da > db Then St^[sp - 1] := 1 Else St^[sp - 1] := 0;
        Inc(pc);
      End;
      $99..$9E : Begin
        Dec(sp); a := St^[sp];
        Case op Of
          $99 : Ok := a = 0; $9A : Ok := a <> 0; $9B : Ok := a < 0;
          $9C : Ok := a >= 0; $9D : Ok := a > 0; $9E : Ok := a <= 0;
        End;
        If Ok Then pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]) Else Inc(pc, 3);
      End;
      $9F..$A4 : Begin
        Dec(sp, 2); a := St^[sp]; b := St^[sp + 1];
        Case op Of
          $9F : Ok := a = b; $A0 : Ok := a <> b; $A1 : Ok := a < b;
          $A2 : Ok := a >= b; $A3 : Ok := a > b; $A4 : Ok := a <= b;
        End;
        If Ok Then pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]) Else Inc(pc, 3);
      End;
      $A5, $A6 : Begin
        Dec(sp, 2); Ok := St^[sp] = St^[sp + 1];
        If op = $A6 Then Ok := Not Ok;
        If Ok Then pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]) Else Inc(pc, 3);
      End;
      $A7 : pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]);
      $AA, $AB : Begin
        Dec(sp);
        pc := SwitchTarget(Code, opPc, LongInt(St^[sp]), Ok);
      End;
      $AC, $AE, $B0 : Begin
        v := St^[sp - 1];
        If Frames^[FTop - 1].Mon <> 0 Then MonExit(Frames^[FTop - 1].Mon);
        Dec(FTop);
        St^[base] := v;
        If FTop = StopDepth Then Begin RunLevel := RunLevel - 1; Exit; End;
        sp := base + 1;
        Reload;
        pc := Frames^[FTop - 1].Pc;
        If (Code^[pc] = $B9) Or (Code^[pc] = $BA) Then Inc(pc, 5) Else Inc(pc, 3);
      End;
      $AD, $AF : Begin
        v := St^[sp - 2];
        If Frames^[FTop - 1].Mon <> 0 Then MonExit(Frames^[FTop - 1].Mon);
        Dec(FTop);
        St^[base] := v; St^[base + 1] := 0;
        If FTop = StopDepth Then Begin RunLevel := RunLevel - 1; Exit; End;
        sp := base + 2;
        Reload;
        pc := Frames^[FTop - 1].Pc;
        If (Code^[pc] = $B9) Or (Code^[pc] = $BA) Then Inc(pc, 5) Else Inc(pc, 3);
      End;
      $B1 : Begin
        If Frames^[FTop - 1].Mon <> 0 Then MonExit(Frames^[FTop - 1].Mon);
        Dec(FTop);
        If FTop = StopDepth Then Begin RunLevel := RunLevel - 1; Exit; End;
        sp := base;
        Reload;
        pc := Frames^[FTop - 1].Pc;
        If (Code^[pc] = $B9) Or (Code^[pc] = $BA) Then Inc(pc, 5) Else Inc(pc, 3);
      End;
      $B2 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If CPA^[Idx].R = 0 Then Begin GSP := sp; Frames^[FTop - 1].Pc := opPc; End;
        If (CPA^[Idx].R = 0) And Not ResolveField(cls, Idx, True) Then Slow := True
        Else Begin
          v := Classes[CPA^[Idx].R - 1].Statics[CPA^[Idx].R2];
          St^[sp] := v; Inc(sp);
          If (CPA^[Idx].N = Ord('J')) Or (CPA^[Idx].N = Ord('D')) Then Begin St^[sp] := 0; Inc(sp); End;
          Inc(pc, 3);
        End;
      End;
      $B3 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If CPA^[Idx].R = 0 Then Begin GSP := sp; Frames^[FTop - 1].Pc := opPc; End;
        If (CPA^[Idx].R = 0) And Not ResolveField(cls, Idx, True) Then Slow := True
        Else Begin
          If (CPA^[Idx].N = Ord('J')) Or (CPA^[Idx].N = Ord('D')) Then Dec(sp);
          Dec(sp);
          Classes[CPA^[Idx].R - 1].Statics[CPA^[Idx].R2] := St^[sp];
          Inc(pc, 3);
        End;
      End;
      $B4 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If (CPA^[Idx].R = 0) And Not ResolveField(cls, Idx, False) Then Slow := True
        Else Begin
          Ref := St^[sp - 1];
          If Ref = 0 Then Begin
            SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc));
            Slow := True;
          End
          Else If CPA^[Idx].R2 >= Length(Heap[Ref].F) Then Begin
            SetErr('java/lang/InternalError', 'champ hors objet : ' + JavaName(Heap[Ref].Cls) + ' / ' + Classes[cls].CP[Classes[cls].CP[Classes[cls].CP[Idx].B].A].S + ' dans ' + Classes[cls].Name);
            Slow := True;
          End
          Else Begin
            St^[sp - 1] := Heap[Ref].F[CPA^[Idx].R2];
            If (CPA^[Idx].N = Ord('J')) Or (CPA^[Idx].N = Ord('D')) Then Begin St^[sp] := 0; Inc(sp); End;
            Inc(pc, 3);
          End;
        End;
      End;
      $B5 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If (CPA^[Idx].R = 0) And Not ResolveField(cls, Idx, False) Then Slow := True
        Else Begin
          If (CPA^[Idx].N = Ord('J')) Or (CPA^[Idx].N = Ord('D')) Then K := 2 Else K := 1;
          Ref := St^[sp - K - 1];
          If Ref = 0 Then Begin
            SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc));
            Slow := True;
          End
          Else If CPA^[Idx].R2 >= Length(Heap[Ref].F) Then Begin
            SetErr('java/lang/InternalError', 'champ hors objet : ' + JavaName(Heap[Ref].Cls) + ' / ' + Classes[cls].CP[Classes[cls].CP[Classes[cls].CP[Idx].B].A].S + ' dans ' + Classes[cls].Name);
            Slow := True;
          End
          Else Begin
            Heap[Ref].F[CPA^[Idx].R2] := St^[sp - K];
            Dec(sp, K + 1);
            Inc(pc, 3);
          End;
        End;
      End;
      $B6, $B7, $B8, $B9 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If CPA^[Idx].R = 0 Then Begin GSP := sp; Frames^[FTop - 1].Pc := opPc; End;
        If (CPA^[Idx].R = 0) And Not ResolveMethodRef(cls, Idx, op = $B8) Then Slow := True
        Else Begin
          CallPM := CPA^[Idx].R - 1;
          CM := MethodPtr(CallPM);
          NS := CM^.NArgSlots;
          If (op = $B6) Or (op = $B9) Then Begin
            Ref := St^[sp - NS];
            If Ref = 0 Then Begin
              SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc));
              CallPM := -1; Slow := True;
            End
            Else Begin
              T := FindVirtual(Heap[Ref].Cls, CPA^[Idx].R2);
              If T < 0 Then Begin
                SetErr('java/lang/AbstractMethodError', JavaName(Heap[Ref].Cls) + '.' + CM^.Name + CM^.Desc);
                CallPM := -1; Slow := True;
              End
              Else Begin CallPM := T; CM := MethodPtr(CallPM); End;
            End;
          End
          Else If op = $B7 Then Begin
            If St^[sp - NS] = 0 Then Begin
              SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc));
              CallPM := -1; Slow := True;
            End;
          End;
          If CallPM >= 0 Then Slow := True;
        End;
      End;
      $BA : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        If GcWanted Then Begin GSP := sp; CollectGarbage(PSlot(St), sp); End;
        Frames^[FTop - 1].Pc := opPc;
        GSP := sp;
        ExecIndy(cls, Idx, sp);
        If Pend Then Slow := True Else Inc(pc, 5);
      End;
      $BB : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        T := ResolveClass(cls, Idx);
        If T < 0 Then Slow := True
        Else Begin
          Frames^[FTop - 1].Pc := opPc; GSP := sp;
          If Classes[T].InitState <> 2 Then EnsureInit(T);
          If Pend Then Slow := True
          Else Begin
            If (Classes[T].Flags And (ACC_ABSTRACT Or ACC_INTERFACE)) <> 0 Then Begin
              SetErr('java/lang/InstantiationError', JavaName(T)); Slow := True;
            End
            Else Begin
              If GcWanted Then CollectGarbage(PSlot(St), sp);
              St^[sp] := NewObject(T); Inc(sp); Inc(pc, 3);
            End;
          End;
        End;
      End;
      $BC : Begin
        K := St^[sp - 1];
        If K < 0 Then Begin SetErr('java/lang/NegativeArraySizeException', IStr(K)); Slow := True; End
        Else Begin
          If GcWanted Then CollectGarbage(PSlot(St), sp);
          St^[sp - 1] := NewArray(ArrayClassIdx(PrimArrayDesc(Code^[pc + 1])), K);
          Inc(pc, 2);
        End;
      End;
      $BD : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        K := St^[sp - 1];
        If K < 0 Then Begin SetErr('java/lang/NegativeArraySizeException', IStr(K)); Slow := True; End
        Else Begin
          If CPA^[Idx].R2 = 0 Then Begin
            Frames^[FTop - 1].Pc := opPc; GSP := sp;
            T := ResolveClass(cls, Idx);
            If T >= 0 Then CPA^[Idx].R2 := ArrayClassIdx(ArrayDescOfClassRef(Classes[T].Name)) + 1;
          End;
          If CPA^[Idx].R2 = 0 Then Slow := True
          Else Begin
            If GcWanted Then CollectGarbage(PSlot(St), sp);
            St^[sp - 1] := NewArray(CPA^[Idx].R2 - 1, K);
            Inc(pc, 3);
          End;
        End;
      End;
      $BE : Begin
        Ref := St^[sp - 1];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else Begin St^[sp - 1] := Heap[Ref].Len; Inc(pc); End;
      End;
      $BF : Begin
        Ref := St^[sp - 1];
        Dec(sp);
        If Ref = 0 Then SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc))
        Else ThrowObj(Ref);
        Slow := True;
      End;
      $C0 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        Ref := St^[sp - 1];
        If Ref <> 0 Then Begin
          T := ResolveClass(cls, Idx);
          If T < 0 Then Slow := True
          Else If Not IsSubclass(Heap[Ref].Cls, T) Then Begin
            SetErr('java/lang/ClassCastException', CastMsg(Heap[Ref].Cls, T)); Slow := True;
          End
          Else Inc(pc, 3);
        End
        Else Inc(pc, 3);
      End;
      $C1 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        Ref := St^[sp - 1];
        If Ref = 0 Then Begin St^[sp - 1] := 0; Inc(pc, 3); End
        Else Begin
          T := ResolveClass(cls, Idx);
          If T < 0 Then Slow := True
          Else Begin
            If IsSubclass(Heap[Ref].Cls, T) Then St^[sp - 1] := 1 Else St^[sp - 1] := 0;
            Inc(pc, 3);
          End;
        End;
      End;
      $C2, $C3 : Begin
        Ref := St^[sp - 1];
        If Ref = 0 Then Begin SetErr('java/lang/NullPointerException', NpeMsg(cls, mth, opPc)); Slow := True; End
        Else Begin
          Dec(sp);
          If op = $C2 Then MonEnter(Ref, sp + 1) Else MonExit(Ref);
          Inc(pc);
        End;
      End;
      $C4 : Begin
        K := (Code^[pc + 2] Shl 8) Or Code^[pc + 3];
        Case Code^[pc + 1] Of
          $15, $17, $19 : Begin St^[sp] := St^[base + K]; Inc(sp); Inc(pc, 4); End;
          $16, $18 : Begin St^[sp] := St^[base + K]; St^[sp + 1] := 0; Inc(sp, 2); Inc(pc, 4); End;
          $36, $38, $3A : Begin Dec(sp); St^[base + K] := St^[sp]; Inc(pc, 4); End;
          $37, $39 : Begin Dec(sp, 2); St^[base + K] := St^[sp]; Inc(pc, 4); End;
          $84 : Begin
            St^[base + K] := LongInt(St^[base + K] + SmallInt((Code^[pc + 4] Shl 8) Or Code^[pc + 5]));
            Inc(pc, 6);
          End;
        Else
          SetErr('java/lang/InternalError', 'wide'); Slow := True;
        End;
      End;
      $C5 : Begin
        Idx := (Code^[pc + 1] Shl 8) Or Code^[pc + 2];
        K := Code^[pc + 3];
        T := ResolveClass(cls, Idx);
        If T < 0 Then Slow := True
        Else Begin
          SetLength(Dims, K);
          Ok := True;
          For I := 0 To K - 1 Do Begin
            Dims[I] := St^[sp - K + I];
            If Dims[I] < 0 Then Ok := False;
          End;
          If Not Ok Then Begin SetErr('java/lang/NegativeArraySizeException', IStr(St^[sp - K])); Slow := True; End
          Else Begin
            If GcWanted Then CollectGarbage(PSlot(St), sp);
            Dec(sp, K);
            St^[sp] := NewMulti(T, Dims, 0);
            Inc(sp); Inc(pc, 4);
          End;
        End;
      End;
      $C6 : Begin
        Dec(sp);
        If St^[sp] = 0 Then pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]) Else Inc(pc, 3);
      End;
      $C7 : Begin
        Dec(sp);
        If St^[sp] <> 0 Then pc := pc + SmallInt((Code^[pc + 1] Shl 8) Or Code^[pc + 2]) Else Inc(pc, 3);
      End;
      $C8 : Begin
        pc := pc + LongInt((Cardinal(Code^[pc + 1]) Shl 24) Or (Cardinal(Code^[pc + 2]) Shl 16) Or (Cardinal(Code^[pc + 3]) Shl 8) Or Cardinal(Code^[pc + 4]));
      End;
    Else
      SetErr('java/lang/InternalError', 'instruction non geree : ' + IStr(op) + ' dans ' + Classes[cls].Name + '.' + MP^.Name);
      Slow := True;
    End;
    If Slow Then Begin
      Slow := False;
      If CallPM >= 0 Then Begin
        { ----- appel ----- }
        CM := MethodPtr(CallPM);
        NS := CM^.NArgSlots;
        Frames^[FTop - 1].Pc := opPc;
        If GcWanted Then Begin GSP := sp; CollectGarbage(PSlot(St), sp); End;
        If CM^.Lam <> 0 Then Begin
          GSP := sp;
          LambdaCall(CM^.Lam - 1, @St^[sp - NS]);
          Dec(sp, NS);
          If Not Pend Then Begin
            Case CM^.RetKind Of
              'V' : ;
              'J', 'D' : Begin St^[sp] := NRet; St^[sp + 1] := 0; Inc(sp, 2); End;
            Else Begin St^[sp] := NRet; Inc(sp); End;
            End;
            If (Code^[opPc] = $B9) Or (Code^[opPc] = $BA) Then pc := opPc + 5 Else pc := opPc + 3;
          End;
        End
        Else If Assigned(CM^.Native) Then Begin
          GSP := sp;
          CM^.Native(@St^[sp - NS]);
          Dec(sp, NS);
          If Not Pend Then Begin
            Case CM^.RetKind Of
              'V' : ;
              'J', 'D' : Begin St^[sp] := NRet; St^[sp + 1] := 0; Inc(sp, 2); End;
            Else Begin St^[sp] := NRet; Inc(sp); End;
            End;
            If (Code^[opPc] = $B9) Or (Code^[opPc] = $BA) Then pc := opPc + 5 Else pc := opPc + 3;
          End;
        End
        Else If (CM^.Flags And (ACC_ABSTRACT Or ACC_NATIVE)) <> 0 Then Begin
          If (CM^.Flags And ACC_NATIVE) <> 0 Then
            SetErr('java/lang/UnsatisfiedLinkError', JavaName(CM^.Cls) + '.' + CM^.Name + CM^.Desc)
          Else SetErr('java/lang/AbstractMethodError', JavaName(CM^.Cls) + '.' + CM^.Name + CM^.Desc);
        End
        Else If (FTop >= MAX_FRAMES) Or (sp - NS + CM^.MaxLocals + CM^.MaxStack + 32 >= StkLimit) Then Begin
          SetErrNoMsg('java/lang/StackOverflowError');
        End
        Else Begin
          Frames^[FTop].Cls := CM^.Cls;
          Frames^[FTop].Mth := CallPM Mod 65536;
          Frames^[FTop].Pc := 0;
          Frames^[FTop].Base := sp - NS;
          Frames^[FTop].Mon := 0;
          Inc(FTop);
          Reload;
          sp := base + MP^.MaxLocals;
          pc := 0;
          If (CM^.Flags And ACC_SYNCHRONIZED) <> 0 Then Begin
            If (CM^.Flags And ACC_STATIC) <> 0 Then Ref := MirrorOf(CM^.Cls) Else Ref := St^[base];
            Frames^[FTop - 1].Mon := Ref;
            MonEnter(Ref, sp);
          End;
        End;
        CallPM := -1;
      End;
      If Pend Then Begin
        { ----- exception ----- }
        Frames^[FTop - 1].Pc := opPc;
        GSP := sp;
        If ErrCls <> '' Then Begin
          E := ErrCls; ErrCls := ''; Pend := False;
          If ErrHasMsg Then ThrowNew(E, ErrMsg) Else ThrowNew(E, '');
        End;
        Pend := False;
        J := PendingExc;
        K := -1;
        While K < 0 Do Begin
          Ref := Frames^[FTop - 1].Pc;
          For I := 0 To Length(MP^.Exc) - 1 Do
            If (MP^.Exc[I].SPc <= Ref) And (Ref < MP^.Exc[I].EPc) And CatchMatches(cls, MP^.Exc[I].CatchCp, Heap[J].Cls) Then Begin
              K := I; Break;
            End;
          If K >= 0 Then Break;
          If Frames^[FTop - 1].Mon <> 0 Then MonExit(Frames^[FTop - 1].Mon);
          Dec(FTop);
          If FTop = StopDepth Then Begin
            Pend := True;
            RunLevel := RunLevel - 1;
            Exit;
          End;
          Reload;
        End;
        { gestionnaire trouve dans le cadre courant }
        PendingExc := 0;
        sp := base + MP^.MaxLocals;
        St^[sp] := J; Inc(sp);
        pc := MP^.Exc[K].HPc;
      End;
    End;
  End;
End;

Function InvokeNested(C, MI, Base : LongInt) : Int64;
Var M : PMethod; SaveG : LongInt; R : Int64;
Begin
  M := @Classes[C].Methods[MI];
  SaveG := GSP;
  InvokeNested := 0;
  If M^.Lam <> 0 Then Begin
    GSP := Base + M^.NArgSlots;
    LambdaCall(M^.Lam - 1, @Stk^[Base]);
    InvokeNested := NRet;
    GSP := SaveG;
    Exit;
  End;
  If Assigned(M^.Native) Then Begin
    GSP := Base + M^.NArgSlots;
    M^.Native(@Stk^[Base]);
    InvokeNested := NRet;
    GSP := SaveG;
    Exit;
  End;
  If (M^.Flags And (ACC_ABSTRACT Or ACC_NATIVE)) <> 0 Then Begin
    If (M^.Flags And ACC_NATIVE) <> 0 Then SetErr('java/lang/UnsatisfiedLinkError', JavaName(C) + '.' + M^.Name + M^.Desc)
    Else SetErr('java/lang/AbstractMethodError', JavaName(C) + '.' + M^.Name + M^.Desc);
    ThrowNew(ErrCls, ErrMsg);
    Exit;
  End;
  If (FTop >= MAX_FRAMES + 40) Or (Base + M^.MaxLocals + M^.MaxStack + 32 >= StkLimit) Then Begin
    SetErrNoMsg('java/lang/StackOverflowError');
    Exit;
  End;
  Frames^[FTop].Cls := C;
  Frames^[FTop].Mth := MI;
  Frames^[FTop].Pc := 0;
  Frames^[FTop].Base := Base;
  Frames^[FTop].Mon := 0;
  Inc(FTop);
  If (M^.Flags And ACC_SYNCHRONIZED) <> 0 Then Begin
    If (M^.Flags And ACC_STATIC) <> 0 Then Frames^[FTop - 1].Mon := MirrorOf(C) Else Frames^[FTop - 1].Mon := Stk^[Base];
    MonEnter(Frames^[FTop - 1].Mon, Base + M^.MaxLocals);
  End;
  Run(FTop - 1);
  If Not Pend Then Begin
    R := Stk^[Base];
    InvokeNested := R;
  End;
  GSP := SaveG;
End;
{ ============================================================================
  INVOKEDYNAMIC : lambdas, concatenation, enregistrements, switch a motifs
  ============================================================================ }

Type
  TSite = Record
    Kind     : Byte;            { 1 lambda, 2 concatenation, 3 methodes d'enregistrement, 4 switch de types, 5 switch d'enum }
    Cls      : LongInt;         { lambda : classe synthetique }
    NCap     : LongInt;         { cases capturees }
    CapKinds : AnsiString;      { genres des arguments de l'appel dynamique }
    Impl     : LongInt;         { methode d'implementation (classe * 65536 + indice) }
    ImplKind : LongInt;         { 5 virtuel, 6 statique, 7 special, 8 constructeur, 9 interface }
    ImplCls  : LongInt;
    ImplSel  : LongInt;
    SamKinds : AnsiString;
    SamRet   : Char;
    Recipe   : UnicodeString;
    CStr     : Array Of UnicodeString;
    RecCls   : LongInt;
    FSlots   : Array Of LongInt;
    FKinds   : AnsiString;
    FNames   : Array Of AnsiString;
    What     : Byte;            { enregistrement : 1 toString, 2 hashCode, 3 equals }
    Labels   : Array Of Int64;  { switch : classe, ou handle de chaine, ou entier }
    LKinds   : AnsiString;      { C classe, S chaine, I entier }
  End;

Var
  Sites : Array Of TSite;
  NSites : LongInt;
  SelToString, SelHashCode, SelEquals : LongInt;
  LambdaCount : LongInt;

Function VCall(H, Sel : LongInt; Const Extra : Array Of Int64) : Int64;
Var T, I : LongInt; A : Array Of Int64;
Begin
  VCall := 0;
  If H = 0 Then Begin ThrowNPE(''); Exit; End;
  T := FindVirtual(Heap[H].Cls, Sel);
  If T < 0 Then Begin SetErr('java/lang/AbstractMethodError', 'methode virtuelle absente'); Exit; End;
  SetLength(A, Length(Extra) + 1);
  A[0] := H;
  For I := 0 To High(Extra) Do A[I + 1] := Extra[I];
  VCall := CallPacked(T, A);
End;

{ Conversion d'un objet en chaine Java (String.valueOf) }
Function ObjToStr(H : LongInt) : UnicodeString;
Var R : Int64;
Begin
  If H = 0 Then Begin ObjToStr := 'null'; Exit; End;
  If Heap[H].Kind = KIND_STR Then Begin ObjToStr := Heap[H].S; Exit; End;
  R := VCall(H, SelToString, []);
  If Pend Then Begin ObjToStr := ''; Exit; End;
  If R = 0 Then ObjToStr := 'null' Else ObjToStr := Heap[R].S;
End;

Function PrimToStr(V : Int64; K : Char) : UnicodeString;
Begin
  Case K Of
    'C' : PrimToStr := WideChar(V And $FFFF);
    'Z' : If V <> 0 Then PrimToStr := 'true' Else PrimToStr := 'false';
    'F' : PrimToStr := Utf8ToWide(FloatToStr_(SlotToF(V)));
    'D' : PrimToStr := Utf8ToWide(DoubleToStr(SlotToD(V)));
  Else PrimToStr := Utf8ToWide(IStr(V));
  End;
End;

Function AdaptArg(V : Int64; FromK, ToK : Char) : Int64;
Var Bk : Char;
Begin
  If (FromK = 'L') And (ToK = 'L') Then Begin AdaptArg := V; Exit; End;
  If FromK = 'L' Then Begin
    If V = 0 Then Begin ThrowNPE(''); AdaptArg := 0; Exit; End;
    Bk := BoxKindOfClass(Heap[V].Cls);
    If Bk = #0 Then Begin AdaptArg := V; Exit; End;
    AdaptArg := ConvPrim(Heap[V].F[0], Bk, ToK);
    Exit;
  End;
  If ToK = 'L' Then Begin AdaptArg := BoxPrim(FromK, V); Exit; End;
  AdaptArg := ConvPrim(V, FromK, ToK);
End;

Function ClassNameOfDesc(Const D : AnsiString) : AnsiString;
Begin
  If (Length(D) > 0) And (D[1] = 'L') Then ClassNameOfDesc := Copy(D, 2, Length(D) - 2) Else ClassNameOfDesc := D;
End;

Function NewSite : LongInt;
Begin
  If NSites >= Length(Sites) Then SetLength(Sites, NSites * 2 + 32);
  FillChar(Sites[NSites], SizeOf(TSite), 0);
  Sites[NSites].Impl := -1;
  NewSite := NSites;
  Inc(NSites);
End;

Procedure AddLambdaMethod(C : LongInt; Const Name, Desc : AnsiString; SiteIdx : LongInt);
Var N, I, J : LongInt; M : ^TMethod;
Begin
  N := Length(Classes[C].Methods);
  SetLength(Classes[C].Methods, N + 1);
  FillChar(Classes[C].Methods[N], SizeOf(TMethod), 0);
  Classes[C].Methods[N].Name := Name;
  Classes[C].Methods[N].Desc := Desc;
  Classes[C].Methods[N].Flags := ACC_PUBLIC;
  Classes[C].Methods[N].Cls := C;
  Classes[C].Methods[N].Lam := SiteIdx + 1;
  ParseDesc(Desc, Classes[C].Methods[N].ArgKinds, Classes[C].Methods[N].RetKind);
  Classes[C].Methods[N].NArgs := Length(Classes[C].Methods[N].ArgKinds);
  J := 1;
  For I := 1 To Length(Classes[C].Methods[N].ArgKinds) Do Inc(J, ArgSlotsOf(Classes[C].Methods[N].ArgKinds[I]));
  Classes[C].Methods[N].NArgSlots := J;
  Classes[C].Methods[N].Sel := SelectorOf(Name, Desc);
  M := nil;
End;

Procedure SetupLambda(C, I : LongInt; SiteIdx : LongInt);
Var
  Bi, Mh, NT, ImplRef, K, Fl, NB, J, P : LongInt;
  Nm, Ds, ItfName, SamDesc, Dummy : AnsiString;
  RK : Char; Ifc, SC, ICls : LongInt; Args : Array Of LongInt; CName, MName, MDesc : AnsiString;
  Ifs : Array Of LongInt; NI : LongInt;
Begin
  Bi := Classes[C].CP[I].A;
  NT := Classes[C].CP[I].B;
  Nm := Classes[C].CP[Classes[C].CP[NT].A].S;
  Ds := Classes[C].CP[Classes[C].CP[NT].B].S;
  Args := Classes[C].Boots[Bi].Args;
  Mh := Classes[C].Boots[Bi].Mh;
  ParseDesc(Ds, Sites[SiteIdx].CapKinds, RK);
  P := Pos(')', Ds);
  ItfName := ClassNameOfDesc(Copy(Ds, P + 1, Length(Ds)));
  Ifc := LoadClass(ItfName);
  SamDesc := Classes[C].CP[Classes[C].CP[Args[0]].A].S;
  ParseDesc(SamDesc, Sites[SiteIdx].SamKinds, Sites[SiteIdx].SamRet);
  Mh := Args[1];
  Sites[SiteIdx].ImplKind := Classes[C].CP[Mh].A;
  ImplRef := Classes[C].CP[Mh].B;
  CName := CPClassName(C, ImplRef);
  CPNameType(C, ImplRef, MName, MDesc);
  ICls := LoadClass(CName);
  Sites[SiteIdx].ImplCls := ICls;
  Sites[SiteIdx].Impl := FindMethodRef(ICls, MName, MDesc);
  Sites[SiteIdx].ImplSel := SelectorOf(MName, MDesc);
  If Sites[SiteIdx].Impl < 0 Then Fatal('lambda : methode introuvable ' + CName + '.' + MName + MDesc);
  J := 0;
  For K := 1 To Length(Sites[SiteIdx].CapKinds) Do Inc(J, ArgSlotsOf(Sites[SiteIdx].CapKinds[K]));
  Sites[SiteIdx].NCap := J;
  { classe synthetique }
  Inc(LambdaCount);
  SC := NewClassRec(Classes[C].Name + '$$Lambda/0x' + IStr(LambdaCount));
  Classes[SC].Flags := ACC_FINAL Or $1000;
  Classes[SC].Super := C_OBJECT;
  Classes[SC].NInst := J;
  Classes[SC].InitState := 2;
  Classes[SC].ObjKind := KIND_OBJ;
  NI := 1;
  SetLength(Ifs, 1);
  Ifs[0] := Ifc;
  SetLength(Classes[SC].Ifaces, 1);
  Classes[SC].Ifaces[0] := Ifc;
  Sites[SiteIdx].Cls := SC;
  AddLambdaMethod(SC, Nm, SamDesc, SiteIdx);
  { altMetafactory : marqueurs et ponts }
  If Length(Args) > 3 Then Begin
    If (Classes[C].CP[Args[3]].Tag = CP_INT) Then Begin
      Fl := Classes[C].CP[Args[3]].N;
      K := 4;
      If (Fl And 1) <> 0 Then Begin
        SetLength(Classes[SC].Ifaces, Length(Classes[SC].Ifaces) + 1);
        Classes[SC].Ifaces[High(Classes[SC].Ifaces)] := C_SERIAL;
      End;
      If (Fl And 2) <> 0 Then Begin
        NB := Classes[C].CP[Args[K]].N; Inc(K);
        For J := 1 To NB Do Begin
          ICls := LoadClass(Classes[C].CP[Classes[C].CP[Args[K]].A].S); Inc(K);
          If ICls >= 0 Then Begin
            SetLength(Classes[SC].Ifaces, Length(Classes[SC].Ifaces) + 1);
            Classes[SC].Ifaces[High(Classes[SC].Ifaces)] := ICls;
          End;
        End;
      End;
      If (Fl And 4) <> 0 Then Begin
        NB := Classes[C].CP[Args[K]].N; Inc(K);
        For J := 1 To NB Do Begin
          Dummy := Classes[C].CP[Classes[C].CP[Args[K]].A].S; Inc(K);
          AddLambdaMethod(SC, Nm, Dummy, SiteIdx);
        End;
      End;
    End;
  End;
End;

Procedure SetupConcat(C, I, SiteIdx : LongInt);
Var Bi, NT, K, N : LongInt; Ds : AnsiString; RK : Char; Args : Array Of LongInt; Nm : AnsiString;
Begin
  Bi := Classes[C].CP[I].A;
  NT := Classes[C].CP[I].B;
  Ds := Classes[C].CP[Classes[C].CP[NT].B].S;
  Nm := Classes[C].CP[Classes[C].CP[Classes[C].CP[Classes[C].Boots[Bi].Mh].B].B].S;
  ParseDesc(Ds, Sites[SiteIdx].CapKinds, RK);
  Args := Classes[C].Boots[Bi].Args;
  If (Length(Args) > 0) And (Pos('Recipe', Nm) = 0) And (Nm = 'makeConcatWithConstants') Then Begin
    Sites[SiteIdx].Recipe := ModUtf8ToWide(Classes[C].CP[Classes[C].CP[Args[0]].A].S);
    N := Length(Args) - 1;
    SetLength(Sites[SiteIdx].CStr, N);
    For K := 1 To N Do Begin
      Case Classes[C].CP[Args[K]].Tag Of
        CP_STRING : Sites[SiteIdx].CStr[K - 1] := ModUtf8ToWide(Classes[C].CP[Classes[C].CP[Args[K]].A].S);
        CP_INT : Sites[SiteIdx].CStr[K - 1] := Utf8ToWide(IStr(Classes[C].CP[Args[K]].N));
        CP_LONG : Sites[SiteIdx].CStr[K - 1] := Utf8ToWide(IStr(Classes[C].CP[Args[K]].N));
        CP_FLOAT : Sites[SiteIdx].CStr[K - 1] := Utf8ToWide(FloatToStr_(SlotToF(Classes[C].CP[Args[K]].N)));
        CP_DOUBLE : Sites[SiteIdx].CStr[K - 1] := Utf8ToWide(DoubleToStr(SlotToD(Classes[C].CP[Args[K]].N)));
      End;
    End;
  End
  Else Begin
    { makeConcat : tous les arguments, sans recette }
    Sites[SiteIdx].Recipe := '';
    For K := 1 To Length(Sites[SiteIdx].CapKinds) Do Sites[SiteIdx].Recipe := Sites[SiteIdx].Recipe + #1;
  End;
End;

Procedure SetupRecord(C, I, SiteIdx : LongInt);
Var Bi, NT, K, N, Ref, Owner, F : LongInt; Args : Array Of LongInt; Nm, Names, Fn, Fd : AnsiString; Rc : LongInt; Parts : Array Of AnsiString; P, Q : LongInt;
Begin
  Bi := Classes[C].CP[I].A;
  NT := Classes[C].CP[I].B;
  Nm := Classes[C].CP[Classes[C].CP[NT].A].S;
  Args := Classes[C].Boots[Bi].Args;
  Rc := ResolveClass(C, Args[0]);
  Sites[SiteIdx].RecCls := Rc;
  If Nm = 'toString' Then Sites[SiteIdx].What := 1 Else If Nm = 'hashCode' Then Sites[SiteIdx].What := 2 Else Sites[SiteIdx].What := 3;
  N := Length(Args) - 2;
  SetLength(Sites[SiteIdx].FSlots, N);
  SetLength(Sites[SiteIdx].FNames, N);
  Sites[SiteIdx].FKinds := '';
  Names := Classes[C].CP[Classes[C].CP[Args[1]].A].S;
  P := 1;
  For K := 0 To N - 1 Do Begin
    Q := P;
    While (Q <= Length(Names)) And (Names[Q] <> ';') Do Inc(Q);
    Sites[SiteIdx].FNames[K] := Copy(Names, P, Q - P);
    P := Q + 1;
    Ref := Classes[C].CP[Args[K + 2]].B;
    CPNameType(C, Ref, Fn, Fd);
    Owner := -1;
    F := FindFieldIn(Rc, Fn, Fd, Owner);
    Sites[SiteIdx].FSlots[K] := Classes[Owner].Fields[F].Slot;
    Sites[SiteIdx].FKinds := Sites[SiteIdx].FKinds + Fd[1];
  End;
End;

Procedure SetupSwitch(C, I, SiteIdx : LongInt; IsEnum : Boolean);
Var Bi, K, N : LongInt; Args : Array Of LongInt; T : LongInt;
Begin
  Bi := Classes[C].CP[I].A;
  Args := Classes[C].Boots[Bi].Args;
  N := Length(Args);
  SetLength(Sites[SiteIdx].Labels, N);
  Sites[SiteIdx].LKinds := '';
  For K := 0 To N - 1 Do Begin
    Case Classes[C].CP[Args[K]].Tag Of
      CP_CLASS : Begin
        T := ResolveClass(C, Args[K]);
        Sites[SiteIdx].Labels[K] := T; Sites[SiteIdx].LKinds := Sites[SiteIdx].LKinds + 'C';
      End;
      CP_STRING : Begin
        Sites[SiteIdx].Labels[K] := CPStringObj(C, Args[K]); Sites[SiteIdx].LKinds := Sites[SiteIdx].LKinds + 'S';
      End;
      CP_INT : Begin
        Sites[SiteIdx].Labels[K] := Classes[C].CP[Args[K]].N; Sites[SiteIdx].LKinds := Sites[SiteIdx].LKinds + 'I';
      End;
    Else
      Sites[SiteIdx].Labels[K] := 0; Sites[SiteIdx].LKinds := Sites[SiteIdx].LKinds + 'X';
    End;
  End;
End;

Function ResolveSite(C, I : LongInt) : Boolean;
Var Bi, S : LongInt; Own, Nm : AnsiString; Mh : LongInt;
Begin
  ResolveSite := False;
  Bi := Classes[C].CP[I].A;
  Mh := Classes[C].Boots[Bi].Mh;
  Own := CPClassName(C, Classes[C].CP[Mh].B);
  Nm := Classes[C].CP[Classes[C].CP[Classes[C].CP[Mh].B].B].S;
  Nm := Classes[C].CP[Classes[C].CP[Classes[C].CP[Classes[C].CP[Mh].B].B].A].S;
  S := NewSite;
  If Own = 'java/lang/invoke/LambdaMetafactory' Then Begin Sites[S].Kind := 1; SetupLambda(C, I, S); End
  Else If Own = 'java/lang/invoke/StringConcatFactory' Then Begin Sites[S].Kind := 2; SetupConcat(C, I, S); End
  Else If Own = 'java/lang/runtime/ObjectMethods' Then Begin Sites[S].Kind := 3; SetupRecord(C, I, S); End
  Else If (Own = 'java/lang/runtime/SwitchBootstraps') Then Begin
    If Nm = 'enumSwitch' Then Begin Sites[S].Kind := 5; SetupSwitch(C, I, S, True); End
    Else Begin Sites[S].Kind := 4; SetupSwitch(C, I, S, False); End;
  End
  Else Begin
    SetErr('java/lang/BootstrapMethodError', 'bootstrap non pris en charge : ' + Own + '.' + Nm);
    Exit;
  End;
  Classes[C].CP[I].R := S + 1;
  ResolveSite := True;
End;

Function HashOfValue(V : Int64; K : Char) : LongInt;
Var R : Int64;
Begin
  Case K Of
    'J' : HashOfValue := LongInt(V Xor (V Shr 32));
    'Z' : If V <> 0 Then HashOfValue := 1231 Else HashOfValue := 1237;
    'D' : Begin
      If IsNanD(SlotToD(V)) Then V := $7FF8000000000000;
      HashOfValue := LongInt(V Xor (V Shr 32));
    End;
    'F' : Begin
      If IsNanD(SlotToF(V)) Then V := $7FC00000;
      HashOfValue := LongInt(V);
    End;
    'L' : Begin
      If V = 0 Then HashOfValue := 0
      Else Begin
        R := VCall(V, SelHashCode, []);
        HashOfValue := LongInt(R);
      End;
    End;
  Else HashOfValue := LongInt(V);
  End;
End;

Function SimpleName(C : LongInt) : AnsiString;
Var N : AnsiString; P : LongInt;
Begin
  If Classes[C].IsInnerInfo Then Begin SimpleName := Classes[C].InnerName; Exit; End;
  N := Classes[C].Name;
  P := Length(N);
  While (P > 0) And (N[P] <> '/') Do Dec(P);
  SimpleName := Copy(N, P + 1, Length(N));
End;

Procedure ExecRecord(S : LongInt; Var SP : LongInt);
Var Rc, K, Obj, Other : LongInt; R : UnicodeString; H, A, B : Int64; Eq : Boolean; Kd : Char; Sl : LongInt;
Begin
  Rc := Sites[S].RecCls;
  Case Sites[S].What Of
    1 : Begin
      Obj := Stk^[SP - 1];
      If Obj = 0 Then Begin ThrowNPE(''); Exit; End;
      R := Utf8ToWide(SimpleName(Rc)) + '[';
      For K := 0 To High(Sites[S].FSlots) Do Begin
        If K > 0 Then R := R + ', ';
        Kd := Sites[S].FKinds[K + 1];
        A := Heap[Obj].F[Sites[S].FSlots[K]];
        If Kd = 'L' Then R := R + Utf8ToWide(Sites[S].FNames[K]) + '=' + ObjToStr(A)
        Else If Kd = '[' Then R := R + Utf8ToWide(Sites[S].FNames[K]) + '=' + ObjToStr(A)
        Else R := R + Utf8ToWide(Sites[S].FNames[K]) + '=' + PrimToStr(A, Kd);
        If Pend Then Exit;
      End;
      R := R + ']';
      Stk^[SP - 1] := NewStr(R);
    End;
    2 : Begin
      Obj := Stk^[SP - 1];
      If Obj = 0 Then Begin ThrowNPE(''); Exit; End;
      H := 0;
      For K := 0 To High(Sites[S].FSlots) Do Begin
        Kd := Sites[S].FKinds[K + 1];
        If Kd = '[' Then Kd := 'L';
        A := Heap[Obj].F[Sites[S].FSlots[K]];
        H := LongInt(H * 31 + HashOfValue(A, Kd));
        If Pend Then Exit;
      End;
      Stk^[SP - 1] := H;
    End;
    3 : Begin
      Other := Stk^[SP - 1]; Obj := Stk^[SP - 2];
      Dec(SP);
      If Obj = 0 Then Begin ThrowNPE(''); Exit; End;
      Eq := (Other <> 0) And (Heap[Other].Cls = Heap[Obj].Cls);
      If Eq Then
        For K := 0 To High(Sites[S].FSlots) Do Begin
          Kd := Sites[S].FKinds[K + 1];
          Sl := Sites[S].FSlots[K];
          A := Heap[Obj].F[Sl]; B := Heap[Other].F[Sl];
          Case Kd Of
            'L', '[' : Begin
              If A = B Then Eq := True
              Else If (A = 0) Or (B = 0) Then Eq := False
              Else Eq := VCall(A, SelEquals, [B]) <> 0;
              If Pend Then Exit;
            End;
            'D' : Eq := (A = B) Or (IsNanD(SlotToD(A)) And IsNanD(SlotToD(B)));
            'F' : Eq := (A = B) Or (IsNanD(SlotToF(A)) And IsNanD(SlotToF(B)));
          Else Eq := A = B;
          End;
          If Not Eq Then Break;
        End;
      If Eq Then Stk^[SP - 1] := 1 Else Stk^[SP - 1] := 0;
    End;
  End;
End;

Procedure ExecSwitch(S : LongInt; Var SP : LongInt);
Var Restart, Obj, K, N, Cl : LongInt; Found : LongInt; Nm : AnsiString; Own, F : LongInt; Nmh : Int64; Bk : Char;
Begin
  Restart := Stk^[SP - 1];
  Obj := Stk^[SP - 2];
  Dec(SP);
  N := Length(Sites[S].Labels);
  If Obj = 0 Then Begin Stk^[SP - 1] := -1; Exit; End;
  Found := N;
  Cl := Heap[Obj].Cls;
  For K := Restart To N - 1 Do Begin
    Case Sites[S].LKinds[K + 1] Of
      'C' : If IsSubclass(Cl, Sites[S].Labels[K]) Then Begin Found := K; Break; End;
      'S' : Begin
        If Sites[S].Kind = 5 Then Begin
          Own := -1;
          F := FindFieldIn(Cl, 'name', 'Ljava/lang/String;', Own);
          If F >= 0 Then Begin
            Nmh := Heap[Obj].F[Classes[Own].Fields[F].Slot];
            If (Nmh <> 0) And (Heap[Nmh].S = Heap[Sites[S].Labels[K]].S) Then Begin Found := K; Break; End;
          End;
        End
        Else If (Heap[Obj].Kind = KIND_STR) And (Heap[Obj].S = Heap[Sites[S].Labels[K]].S) Then Begin Found := K; Break; End;
      End;
      'I' : Begin
        Bk := BoxKindOfClass(Cl);
        If (Bk <> #0) And (Bk <> 'D') And (Bk <> 'F') And (Heap[Obj].F[0] = Sites[S].Labels[K]) Then Begin Found := K; Break; End;
      End;
    End;
  End;
  Stk^[SP - 1] := Found;
End;

Procedure ExecConcat(S : LongInt; Var SP : LongInt);
Var NSl, K, Off, CI, Ai : LongInt; R, Part : UnicodeString; Ch : WideChar; Kd : Char; V : Int64; Offs : Array Of LongInt; NA : LongInt;
Begin
  NA := Length(Sites[S].CapKinds);
  SetLength(Offs, NA);
  NSl := 0;
  For K := 1 To NA Do Begin Offs[K - 1] := NSl; Inc(NSl, ArgSlotsOf(Sites[S].CapKinds[K])); End;
  Off := SP - NSl;
  R := '';
  CI := 0; Ai := 0;
  For K := 1 To Length(Sites[S].Recipe) Do Begin
    Ch := Sites[S].Recipe[K];
    If Ch = #1 Then Begin
      Kd := Sites[S].CapKinds[Ai + 1];
      V := Stk^[Off + Offs[Ai]];
      If Kd = 'L' Then Part := ObjToStr(V) Else Part := PrimToStr(V, Kd);
      If Pend Then Exit;
      R := R + Part;
      Inc(Ai);
    End
    Else If Ch = #2 Then Begin
      R := R + Sites[S].CStr[CI]; Inc(CI);
    End
    Else R := R + Ch;
  End;
  SP := Off;
  Stk^[SP] := NewStr(R);
  Inc(SP);
End;

Procedure ExecIndy(C, I : LongInt; Var SP : LongInt);
Var S, Obj, Off : LongInt;
Begin
  S := Classes[C].CP[I].R - 1;
  If S < 0 Then Begin
    If Not ResolveSite(C, I) Then Exit;
    S := Classes[C].CP[I].R - 1;
  End;
  Case Sites[S].Kind Of
    1 : Begin
      Off := SP - Sites[S].NCap;
      Obj := NewObject(Sites[S].Cls);
      If Sites[S].NCap > 0 Then Move(Stk^[Off], Heap[Obj].F[0], Sites[S].NCap * SizeOf(Int64));
      SP := Off;
      Stk^[SP] := Obj; Inc(SP);
    End;
    2 : ExecConcat(S, SP);
    3 : ExecRecord(S, SP);
    4, 5 : ExecSwitch(S, SP);
  End;
End;

{ Appel d'une lambda : A pointe sur [this, arguments du SAM...] ; resultat dans NRet }
Procedure LambdaCall(Site : LongInt; A : PSlot);
Var
  PA : PSlotArr; Obj, I, J, NP, Slot, NewO, T, Cnt : LongInt; M : PMethod;
  Args : Array Of Int64; ImplK : AnsiString; IR : Char; Res : Int64; Recv : LongInt; Kk : Char;
  Vals : Array Of Int64; ValK : AnsiString; Pinned : Boolean;
Begin
  PA := PSlotArr(A);
  Obj := PA^[0];
  NRet := 0;
  M := MethodPtr(Sites[Site].Impl);
  ImplK := '';
  Pinned := False;
  If Sites[Site].ImplKind In [5, 7, 9] Then ImplK := 'L';
  ImplK := ImplK + M^.ArgKinds;
  IR := M^.RetKind;
  { valeurs fournies : captures puis arguments }
  SetLength(Vals, 0);
  ValK := '';
  Slot := 0;
  For I := 1 To Length(Sites[Site].CapKinds) Do Begin
    SetLength(Vals, Length(Vals) + 1);
    Vals[High(Vals)] := Heap[Obj].F[Slot];
    ValK := ValK + Sites[Site].CapKinds[I];
    Inc(Slot, ArgSlotsOf(Sites[Site].CapKinds[I]));
  End;
  Slot := 1;
  For I := 1 To Length(Sites[Site].SamKinds) Do Begin
    SetLength(Vals, Length(Vals) + 1);
    Vals[High(Vals)] := PA^[Slot];
    ValK := ValK + Sites[Site].SamKinds[I];
    Inc(Slot, ArgSlotsOf(Sites[Site].SamKinds[I]));
  End;
  If Sites[Site].ImplKind = 8 Then Begin
    EnsureInit(Sites[Site].ImplCls);
    If Pend Then Exit;
    NewO := NewObject(Sites[Site].ImplCls);
    Pin(NewO); Pinned := True;
  End
  Else NewO := 0;
  { construction du tableau d'arguments (cases) }
  SetLength(Args, 0);
  If NewO <> 0 Then Begin
    SetLength(Args, 1); Args[0] := NewO;
  End;
  Cnt := 0;
  For I := 0 To High(Vals) Do Begin
    If I + 1 <= Length(ImplK) Then Kk := ImplK[I + 1] Else Kk := ValK[I + 1];
    Res := AdaptArg(Vals[I], ValK[I + 1], Kk);
    If Pend Then Begin If Pinned Then Unpin(1); Exit; End;
    SetLength(Args, Length(Args) + 1);
    Args[High(Args)] := Res;
    If (Kk = 'J') Or (Kk = 'D') Then Begin
      SetLength(Args, Length(Args) + 1);
      Args[High(Args)] := 0;
    End;
  End;
  T := Sites[Site].Impl;
  If Sites[Site].ImplKind In [5, 9] Then Begin
    Recv := Args[0];
    If Recv = 0 Then Begin ThrowNPE(''); Exit; End;
    T := FindVirtual(Heap[Recv].Cls, Sites[Site].ImplSel);
    If T < 0 Then Begin SetErr('java/lang/AbstractMethodError', 'lambda'); Exit; End;
  End
  Else If Sites[Site].ImplKind = 6 Then Begin
    If Classes[Sites[Site].ImplCls].InitState <> 2 Then Begin
      EnsureInit(Sites[Site].ImplCls);
      If Pend Then Exit;
    End;
  End;
  Res := CallPacked(T, Args);
  If Pinned Then Unpin(1);
  If Pend Then Exit;
  If Sites[Site].ImplKind = 8 Then Begin Res := NewO; IR := 'L'; End;
  If Sites[Site].SamRet = 'V' Then NRet := 0
  Else If IR = 'V' Then NRet := 0
  Else Begin
    NRet := AdaptArg(Res, IR, Sites[Site].SamRet);
  End;
End;
