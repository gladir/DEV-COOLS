Procedure NVM_classpath(A : PSlot);
Var R, I : LongInt;
Begin
  R := NewArray(ArrayClassIdx('[Ljava/lang/String;'), NClassPath);
  Pin(R);
  For I := 0 To NClassPath - 1 Do Heap[R].F[I] := JStr(ClassPath[I]);
  Unpin(1);
  NRet := R;
End;

Function AbsPath(Const P : AnsiString) : AnsiString;
Var D : AnsiString;
Begin
  If (P <> '') And ((P[1] = '/') Or ((Length(P) > 1) And (P[2] = ':'))) Then
    Begin AbsPath := P; Exit; End;
  GetDir(0, D);
  If (D <> '') And (D[Length(D)] <> '/') And (D[Length(D)] <> '\') Then D := D +
    '/';
  If Copy(P, 1, 2) = './' Then AbsPath := D + Copy(P, 3, Length(P)) Else AbsPath
    := D + P;
End;

{ VM.resourceUrl(String nom) : URL (file: ou jar:file:) ou null }
Procedure NVM_resourceUrl(A : PSlot);
Var N, Path : AnsiString; I, J, E : LongInt; Attr : Word;
Begin
  N := SOfA(AP(A)^[0]);
  NRet := 0;
  For I := 0 To NClassPath - 1 Do Begin
    Path := ClassPath[I];
    If IsJarPath(Path) Then Begin
      J := JarOpen(Path);
      If J >= 0 Then Begin
        E := JarFind(J, N);
        If E >= 0 Then Begin NRet := JStr('jar:file:' + AbsPath(Path) + '!/' +
          N); Exit; End;
      End;
    End
    Else Begin
      If (Path <> '') And (Path[Length(Path)] <> '/') And (Path[Length(Path)] <>
        '\') Then Path := Path + '/';
      If FsExists(Path + N, Attr) Then Begin NRet := JStr('file:' + AbsPath(Path
        + N)); Exit; End;
    End;
  End;
End;

Procedure NVM_addClasspath(A : PSlot);
Var P : AnsiString;
Begin
  P := SOfA(AP(A)^[0]);
  If NClassPath >= Length(ClassPath) Then SetLength(ClassPath, NClassPath + 8);
  ClassPath[NClassPath] := P;
  Inc(NClassPath);
  NRet := 0;
End;

{ VM.defineClass0(String nom, byte[] b, int off, int len) : Class }
Procedure NVM_defineClass(A : PSlot);
Var Arr, Off, Len, I, C : LongInt; B : TBytes; Nm : AnsiString;
Begin
  Arr := AP(A)^[1]; Off := AP(A)^[2]; Len := AP(A)^[3];
  SetLength(B, Len);
  For I := 0 To Len - 1 Do B[I] := Heap[Arr].F[Off + I] And $FF;
  If AP(A)^[0] <> 0 Then Begin
    Nm := ReplaceCh(SOfA(AP(A)^[0]), '.', '/');
    If MapFind(ClassMap, Nm) >= 0 Then Begin ThrowNew('java/lang/LinkageError',
      'duplicate class definition: ' + Nm); NRet := 0; Exit; End;
  End;
  C := DefineClass(B);
  If C < 0 Then Begin ThrowNew('java/lang/ClassFormatError',
    'Incompatible magic value'); Exit; End;
  NRet := MirrorOf(C);
End;
