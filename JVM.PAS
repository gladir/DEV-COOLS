  ExitCode : LongInt;

{ ----- chaines ------------------------------------------------------------ }

Function IStr(N : Int64) : AnsiString;
Var S : AnsiString;
Begin
  Str(N, S);
  IStr := S;
End;

Function StrHash(Const S : AnsiString) : LongInt;
Var I : LongInt; H : Int64;
Begin
  H := 5381;
  For I := 1 To Length(S) Do H := (H * 33 + Ord(S[I])) And $7FFFFFFF;
  StrHash := H;
End;

Procedure MapInit(Var M : TStrMap; HSize : LongInt);
Var I : LongInt;
Begin
  M.Count := 0;
  M.HSize := HSize;
  SetLength(M.Heads, HSize);
  For I := 0 To HSize - 1 Do M.Heads[I] := -1;
  SetLength(M.Keys, 0);
  SetLength(M.Vals, 0);
  SetLength(M.Nexts, 0);
End;

Function MapFind(Var M : TStrMap; Const K : AnsiString) : LongInt;
Var I : LongInt;
Begin
  MapFind := -1;
  If M.HSize = 0 Then Exit;
  I := M.Heads[StrHash(K) Mod M.HSize];
  While I >= 0 Do Begin
    If M.Keys[I] = K Then Begin MapFind := M.Vals[I]; Exit; End;
    I := M.Nexts[I];
  End;
End;

Procedure MapPut(Var M : TStrMap; Const K : AnsiString; V : LongInt);
Var H, I : LongInt;
Begin
  H := StrHash(K) Mod M.HSize;
  I := M.Heads[H];
  While I >= 0 Do Begin
    If M.Keys[I] = K Then Begin M.Vals[I] := V; Exit; End;
    I := M.Nexts[I];
  End;
  If M.Count >= Length(M.Keys) Then Begin
    SetLength(M.Keys, M.Count * 2 + 64);
    SetLength(M.Vals, M.Count * 2 + 64);
    SetLength(M.Nexts, M.Count * 2 + 64);
  End;
  M.Keys[M.Count] := K;
  M.Vals[M.Count] := V;
  M.Nexts[M.Count] := M.Heads[H];
  M.Heads[H] := M.Count;
  Inc(M.Count);
End;

{ ----- Unicode : UTF-8 <-> UTF-16 ----------------------------------------- }

{ UTF-8 "modifie" du fichier .class -> UTF-16 }
Function ModUtf8ToWide(Const S : AnsiString) : UnicodeString;
Var I, N : LongInt; C, C2, C3 : Integer; R : UnicodeString;
Begin
  SetLength(R, Length(S));
  N := 0;
  I := 1;
  While I <= Length(S) Do Begin
    C := Ord(S[I]);
    If C < $80 Then Begin Inc(N); R[N] := WideChar(C); Inc(I); End
    Else If (C And $E0) = $C0 Then Begin
      If I < Length(S) Then C2 := Ord(S[I + 1]) Else C2 := 0;
      Inc(N); R[N] := WideChar(((C And $1F) Shl 6) Or (C2 And $3F)); Inc(I, 2);
    End
    Else Begin
      If I + 1 <= Length(S) Then C2 := Ord(S[I + 1]) Else C2 := 0;
      If I + 2 <= Length(S) Then C3 := Ord(S[I + 2]) Else C3 := 0;
      Inc(N); R[N] := WideChar(((C And $0F) Shl 12) Or ((C2 And $3F) Shl 6) Or (C3 And $3F)); Inc(I, 3);
    End;
  End;
  SetLength(R, N);
  ModUtf8ToWide := R;
End;

{ UTF-16 -> UTF-8 standard (sortie ; les paires de substitution deviennent un point de code) }
Function WideToUtf8(Const S : UnicodeString) : AnsiString;
Var I, N, C, D : LongInt; R : AnsiString;
Begin
  SetLength(R, Length(S) * 3);
  N := 0;
  I := 1;
  While I <= Length(S) Do Begin
    C := Ord(S[I]);
    If (C >= $D800) And (C <= $DBFF) And (I < Length(S)) And (Ord(S[I + 1]) >= $DC00) And (Ord(S[I + 1]) <= $DFFF) Then Begin
      D := Ord(S[I + 1]);
      C := $10000 + ((C - $D800) Shl 10) + (D - $DC00);
      Inc(I);
    End;
    If C < $80 Then Begin Inc(N); R[N] := Chr(C); End
    Else If C < $800 Then Begin
      Inc(N); R[N] := Chr($C0 Or (C Shr 6));
      Inc(N); R[N] := Chr($80 Or (C And $3F));
    End
    Else If C < $10000 Then Begin
      Inc(N); R[N] := Chr($E0 Or (C Shr 12));
      Inc(N); R[N] := Chr($80 Or ((C Shr 6) And $3F));
      Inc(N); R[N] := Chr($80 Or (C And $3F));
    End
    Else Begin
      Inc(N); R[N] := Chr($F0 Or (C Shr 18));
      Inc(N); R[N] := Chr($80 Or ((C Shr 12) And $3F));
      Inc(N); R[N] := Chr($80 Or ((C Shr 6) And $3F));
      Inc(N); R[N] := Chr($80 Or (C And $3F));
    End;
    Inc(I);
  End;
  SetLength(R, N);
  WideToUtf8 := R;
End;

{ UTF-8 standard -> UTF-16 }
Function Utf8ToWide(Const S : AnsiString) : UnicodeString;
Var I, N, C, C2, C3, C4 : LongInt; R : UnicodeString;
Begin
  SetLength(R, Length(S) + 1);
  N := 0;
  I := 1;
  While I <= Length(S) Do Begin
    C := Ord(S[I]);
    C2 := 0; C3 := 0; C4 := 0;
    If C < $80 Then Begin Inc(N); R[N] := WideChar(C); Inc(I); End
    Else If (C And $E0) = $C0 Then Begin
      If I < Length(S) Then C2 := Ord(S[I + 1]);
      Inc(N); R[N] := WideChar(((C And $1F) Shl 6) Or (C2 And $3F)); Inc(I, 2);
    End
    Else If (C And $F0) = $E0 Then Begin
      If I + 1 <= Length(S) Then C2 := Ord(S[I + 1]);
      If I + 2 <= Length(S) Then C3 := Ord(S[I + 2]);
      Inc(N); R[N] := WideChar(((C And $0F) Shl 12) Or ((C2 And $3F) Shl 6) Or (C3 And $3F)); Inc(I, 3);
    End
    Else Begin
      If I + 1 <= Length(S) Then C2 := Ord(S[I + 1]);
      If I + 2 <= Length(S) Then C3 := Ord(S[I + 2]);
      If I + 3 <= Length(S) Then C4 := Ord(S[I + 3]);
      C := ((C And $07) Shl 18) Or ((C2 And $3F) Shl 12) Or ((C3 And $3F) Shl 6) Or (C4 And $3F);
      Dec(C, $10000);
      Inc(N); R[N] := WideChar($D800 + (C Shr 10));
      Inc(N); R[N] := WideChar($DC00 + (C And $3FF));
      Inc(I, 4);
    End;
  End;
  SetLength(R, N);
  Utf8ToWide := R;
End;

Function WideToAnsi(Const S : UnicodeString) : AnsiString;
Begin
  WideToAnsi := WideToUtf8(S);
End;

Function AnsiToWide(Const S : AnsiString) : UnicodeString;
Begin
  AnsiToWide := Utf8ToWide(S);
End;

{ ----- ecriture sur la sortie standard ------------------------------------ }

Procedure OutStr(Const S : AnsiString);
Begin
  Write(JOut, S);
End;

Procedure ErrStr(Const S : AnsiString);
Begin
  Write(StdErr, S);
End;

Procedure Fatal(Const Msg : AnsiString);
Begin
  Flush(JOut);
  WriteLn(StdErr, 'jvm: ', Msg);
  Flush(StdErr);
  Halt(1);
End;

Function LowerA(Const S : AnsiString) : AnsiString;
Var I : LongInt; R : AnsiString;
Begin
  R := S;
  For I := 1 To Length(R) Do If R[I] In ['A'..'Z'] Then R[I] := Chr(Ord(R[I]) + 32);
  LowerA := R;
End;

Function ReplaceCh(Const S : AnsiString; A, B : Char) : AnsiString;
Var I : LongInt; R : AnsiString;
Begin
  R := S;
  For I := 1 To Length(R) Do If R[I] = A Then R[I] := B;
  ReplaceCh := R;
End;

{ ============================================================================
  MODELE DE CLASSES ET LECTURE DES FICHIERS .class
  ============================================================================ }

Type
  TNativeProc = Procedure(A : PSlot);

  TExc = Record
    SPc, EPc, HPc, CatchCp : LongInt;
  End;

  TLine = Record
    Pc, Line : LongInt;
  End;

  TLVar = Record
    Start, Len, Slot : LongInt;
    Name : AnsiString;
  End;

  TMethod = Record
    Name, Desc : AnsiString;
    Flags      : LongInt;
    Cls        : LongInt;
    Code       : TBytes;
    MaxStack   : LongInt;
    MaxLocals  : LongInt;
    NArgSlots  : LongInt;       { cases occupees par les arguments (this compris) }
    NArgs      : LongInt;       { nombre d'arguments sans this }
    RetKind    : Char;          { V Z B C S I J F D L }
    ArgKinds   : AnsiString;    { une lettre par argument : Z B C S I J F D L }
    Exc        : Array Of TExc;
    Lines      : Array Of TLine;
    LVars      : Array Of TLVar;
    Native     : TNativeProc;
    Sel        : LongInt;       { selecteur nom + descripteur }
    Lam        : LongInt;       { site invokedynamic + 1 pour une methode de lambda, 0 sinon }
  End;

  TField = Record
    Name, Desc : AnsiString;
    Flags      : LongInt;
    Slot       : LongInt;       { case dans l'objet ou dans Statics }
    Cls        : LongInt;
    ConstIdx   : LongInt;       { attribut ConstantValue (index du pool), 0 sinon }
  End;

  TCPEntry = Record
    Tag : Byte;
    A, B : LongInt;
    N : Int64;
    S : AnsiString;
    R, R2 : LongInt;            { cache de resolution }
  End;

  TBoot = Record
    Mh : LongInt;
    Args : Array Of LongInt;
  End;

  TClass = Record
    Name : AnsiString;
    Super : LongInt;
    Ifaces : Array Of LongInt;
    Flags : LongInt;
    CP : Array Of TCPEntry;
    Fields : Array Of TField;
    Methods : Array Of TMethod;
    NInst : LongInt;            { nombre de champs d'instance (superclasses comprises) }
    Statics : Array Of Int64;
    InitState : Byte;           { 0 non initialisee, 1 en cours, 2 faite, 3 echec }
    Mirror : LongInt;           { objet java.lang.Class }
    Boots : Array Of TBoot;
    SourceFile : AnsiString;
    VTab : Array Of LongInt;    { selecteur -> methode (cls * 65536 + indice), -2 inconnu, -1 absente }
    ObjKind : Byte;             { genre des instances : KIND_OBJ, KIND_STR, KIND_SB }
    IsArray : Boolean;
    ElemCls : LongInt;          { tableau : classe des elements (-1 pour les primitifs) }
    ElemDesc : AnsiString;      { tableau : descripteur de l'element }
    Enclosing : AnsiString;     { nom de la classe englobante (InnerClasses) }
    InnerName : AnsiString;     { nom simple (InnerClasses), '' si anonyme }
    IsInnerInfo : Boolean;
    Permitted : Array Of AnsiString;   { PermittedSubclasses }
  End;

Var
  Classes : Array Of TClass;
  NClasses : LongInt;
  ClassMap : TStrMap;
  SelMap : TStrMap;
  NSels : LongInt;
  NativeMap : TStrMap;
  NativeProcs : Array Of TNativeProc;
  NNatives : LongInt;

  C_OBJECT, C_STRING, C_CLASS, C_THROWABLE, C_SB, C_CLONEABLE, C_SERIAL : LongInt;

{ ----- lecture des octets -------------------------------------------------- }

Function ReadFileBytes(Const Path : AnsiString; Var B : TBytes) : Boolean;
Var F : File; Sz : Int64; Old : Byte;
Begin
  ReadFileBytes := False;
  Old := FileMode;
  FileMode := 0;
  AssignFile(F, Path);
  {$I-}
  Reset(F, 1);
  {$I+}
  If IOResult <> 0 Then Begin FileMode := Old; Exit; End;
  Sz := FileSize(F);
  SetLength(B, Sz);
  If Sz > 0 Then BlockRead(F, B[0], Sz);
  CloseFile(F);
  FileMode := Old;
  ReadFileBytes := True;
End;

Function RdU1(Const B : TBytes; Var P : LongInt) : LongInt;
Begin
  RdU1 := B[P]; Inc(P);
End;

Function RdU2(Const B : TBytes; Var P : LongInt) : LongInt;
Begin
  RdU2 := (B[P] Shl 8) Or B[P + 1]; Inc(P, 2);
End;

Function RdU4(Const B : TBytes; Var P : LongInt) : Int64;
Begin
  RdU4 := (Int64(B[P]) Shl 24) Or (Int64(B[P + 1]) Shl 16) Or (Int64(B[P + 2]) Shl 8) Or B[P + 3];
  Inc(P, 4);
End;

{ ----- descripteurs ------------------------------------------------------- }

{ Lettre de genre d'un type de descripteur a la position P ; avance P au-dela du type }
Function DescKind(Const D : AnsiString; Var P : LongInt) : Char;
Begin
  Case D[P] Of
    'L' : Begin
      DescKind := 'L';
      While (P <= Length(D)) And (D[P] <> ';') Do Inc(P);
      Inc(P);
    End;
    '[' : Begin
      DescKind := 'L';
      While D[P] = '[' Do Inc(P);
      If D[P] = 'L' Then Begin
        While (P <= Length(D)) And (D[P] <> ';') Do Inc(P);
      End;
      Inc(P);
    End;
  Else
    DescKind := D[P]; Inc(P);
  End;
End;

Procedure ParseDesc(Const D : AnsiString; Var Args : AnsiString; Var Ret : Char);
Var P : LongInt; K : Char;
Begin
  Args := '';
  P := 2;
  While (P <= Length(D)) And (D[P] <> ')') Do Begin
    K := DescKind(D, P);
    Args := Args + K;
  End;
  Inc(P);
  Ret := DescKind(D, P);
End;

{ ----- selecteurs et natives ---------------------------------------------- }

Function SelectorOf(Const Name, Desc : AnsiString) : LongInt;
Var K : AnsiString; I : LongInt;
Begin
  K := Name + Desc;
  I := MapFind(SelMap, K);
  If I < 0 Then Begin
    I := NSels;
    Inc(NSels);
    MapPut(SelMap, K, I);
  End;
  SelectorOf := I;
End;

{ Enregistre une methode native : Cle = 'java/lang/String.length()I' }
Procedure RegN(Const Key : AnsiString; P : TNativeProc);
Begin
  If NNatives >= Length(NativeProcs) Then SetLength(NativeProcs, NNatives * 2 + 256);
  NativeProcs[NNatives] := P;
  MapPut(NativeMap, Key, NNatives);
  Inc(NNatives);
End;

{ ----- acces au pool de constantes ---------------------------------------- }

Function CPUtf(C, I : LongInt) : AnsiString;
Begin
  CPUtf := Classes[C].CP[I].S;
End;

Function CPClassName(C, I : LongInt) : AnsiString;
Begin
  CPClassName := Classes[C].CP[Classes[C].CP[Classes[C].CP[I].A].A].S;
End;

Procedure CPNameType(C, I : LongInt; Var Name, Desc : AnsiString);
Var NT : LongInt;
Begin
  NT := Classes[C].CP[I].B;
  Name := Classes[C].CP[Classes[C].CP[NT].A].S;
  Desc := Classes[C].CP[Classes[C].CP[NT].B].S;
End;

{ ----- analyse d'un fichier .class ---------------------------------------- }

Function FindClassIdx(Const Name : AnsiString) : LongInt; Forward;
Function LoadClass(Const Name : AnsiString) : LongInt; Forward;

Function NewClassRec(Const Name : AnsiString) : LongInt;
Begin
  If NClasses >= Length(Classes) Then SetLength(Classes, NClasses * 2 + 128);
  FillChar(Classes[NClasses], SizeOf(TClass), 0);
  Classes[NClasses].Name := Name;
  Classes[NClasses].Super := -1;
  Classes[NClasses].ElemCls := -1;
  MapPut(ClassMap, Name, NClasses);
  NewClassRec := NClasses;
  Inc(NClasses);
End;

Procedure ParseCode(Var M : TMethod; Const B : TBytes; Var P : LongInt; EndP : LongInt);
Var CodeLen, NE, I, NA, AL, AEnd, NL, K : LongInt; AName : AnsiString; Cls : LongInt;
Begin
  { appele avec P sur max_stack }
  M.MaxStack := RdU2(B, P);
  M.MaxLocals := RdU2(B, P);
  CodeLen := RdU4(B, P);
  SetLength(M.Code, CodeLen);
  If CodeLen > 0 Then Move(B[P], M.Code[0], CodeLen);
  Inc(P, CodeLen);
  NE := RdU2(B, P);
  SetLength(M.Exc, NE);
  For I := 0 To NE - 1 Do Begin
    M.Exc[I].SPc := RdU2(B, P);
    M.Exc[I].EPc := RdU2(B, P);
    M.Exc[I].HPc := RdU2(B, P);
    M.Exc[I].CatchCp := RdU2(B, P);
  End;
  NA := RdU2(B, P);
  Cls := M.Cls;
  For I := 1 To NA Do Begin
    AName := Classes[Cls].CP[RdU2(B, P)].S;
    AL := RdU4(B, P);
    AEnd := P + AL;
    If AName = 'LineNumberTable' Then Begin
      NL := RdU2(B, P);
      SetLength(M.Lines, Length(M.Lines) + NL);
      While NL > 0 Do Begin
        M.Lines[Length(M.Lines) - NL].Pc := RdU2(B, P);
        M.Lines[Length(M.Lines) - NL].Line := RdU2(B, P);
        Dec(NL);
      End;
    End;
    If AName = 'LocalVariableTable' Then Begin
      NL := RdU2(B, P);
      SetLength(M.LVars, NL);
      For K := 0 To NL - 1 Do Begin
        M.LVars[K].Start := RdU2(B, P);
        M.LVars[K].Len := RdU2(B, P);
        M.LVars[K].Name := Classes[Cls].CP[RdU2(B, P)].S;
        RdU2(B, P);
        M.LVars[K].Slot := RdU2(B, P);
      End;
    End;
    P := AEnd;
  End;
  EndP := EndP;
End;

Procedure LinkClass(C : LongInt); Forward;

{ Analyse un fichier .class ; retourne l'indice de la classe (liee, non initialisee) }
Type
  TCPArray = Array Of TCPEntry;

Function DefineClass(Const B : TBytes) : LongInt;
Var
  P, I, N, Tag, ThisCp, SuperCp, NI, NF, NM, NA, AL, AEnd, J, Len, IfIdx, NBoot, NBA, K : LongInt;
  Name, AName, SuperName : AnsiString; C : LongInt; Magic : Int64;
  Tmp : TCPArray; Fl : LongInt; Ifs : Array Of AnsiString;
Begin
  P := 0;
  Magic := RdU4(B, P);
  If Magic <> $CAFEBABE Then Fatal('fichier .class invalide');
  RdU2(B, P); RdU2(B, P);           { versions }
  N := RdU2(B, P);
  SetLength(Tmp, N);
  I := 1;
  While I < N Do Begin
    Tag := RdU1(B, P);
    Tmp[I].Tag := Tag;
    Tmp[I].R := 0; Tmp[I].R2 := 0;
    Case Tag Of
      CP_UTF8 : Begin
        Len := RdU2(B, P);
        SetLength(Tmp[I].S, Len);
        If Len > 0 Then Move(B[P], Tmp[I].S[1], Len);
        Inc(P, Len);
      End;
      CP_INT : Begin Tmp[I].N := LongInt(RdU4(B, P)); End;
      CP_FLOAT : Begin Tmp[I].N := LongInt(RdU4(B, P)); End;
      CP_LONG, CP_DOUBLE : Begin
        Tmp[I].N := (RdU4(B, P) Shl 32) Or RdU4(B, P);
        Inc(I);
      End;
      CP_CLASS, CP_STRING, CP_MTYPE, 19, 20 : Tmp[I].A := RdU2(B, P);
      CP_FIELD, CP_METHOD, CP_IMETHOD, CP_NAMETYPE, CP_DYNAMIC, CP_INDY : Begin
        Tmp[I].A := RdU2(B, P); Tmp[I].B := RdU2(B, P);
      End;
      CP_MHANDLE : Begin Tmp[I].A := RdU1(B, P); Tmp[I].B := RdU2(B, P); End;
    Else
      Fatal('entree de pool inconnue : ' + IStr(Tag));
    End;
    Inc(I);
  End;
  Fl := RdU2(B, P);
  ThisCp := RdU2(B, P);
  SuperCp := RdU2(B, P);
  Name := Tmp[Tmp[ThisCp].A].S;
  If SuperCp > 0 Then SuperName := Tmp[Tmp[SuperCp].A].S Else SuperName := '';
  NI := RdU2(B, P);
  SetLength(Ifs, NI);
  For I := 0 To NI - 1 Do Ifs[I] := Tmp[Tmp[RdU2(B, P)].A].S;
  If MapFind(ClassMap, Name) >= 0 Then Begin
    { classe deja enregistree (reference anticipee) : on la reutilise }
    C := MapFind(ClassMap, Name);
  End
  Else C := NewClassRec(Name);
  Classes[C].Flags := Fl;
  Classes[C].CP := Tmp;
  Classes[C].Super := -1;
  DefineClass := C;
  { champs }
  NF := RdU2(B, P);
  SetLength(Classes[C].Fields, NF);
  For I := 0 To NF - 1 Do Begin
    Classes[C].Fields[I].Flags := RdU2(B, P);
    Classes[C].Fields[I].Name := Tmp[RdU2(B, P)].S;
    Classes[C].Fields[I].Desc := Tmp[RdU2(B, P)].S;
    Classes[C].Fields[I].Cls := C;
    Classes[C].Fields[I].ConstIdx := 0;
    NA := RdU2(B, P);
    For J := 1 To NA Do Begin
      AName := Tmp[RdU2(B, P)].S;
      AL := RdU4(B, P);
      AEnd := P + AL;
      If AName = 'ConstantValue' Then Classes[C].Fields[I].ConstIdx := RdU2(B, P);
      P := AEnd;
    End;
  End;
  { methodes }
  NM := RdU2(B, P);
  SetLength(Classes[C].Methods, NM);
  For I := 0 To NM - 1 Do Begin
    Classes[C].Methods[I].Flags := RdU2(B, P);
    Classes[C].Methods[I].Name := Tmp[RdU2(B, P)].S;
    Classes[C].Methods[I].Desc := Tmp[RdU2(B, P)].S;
    Classes[C].Methods[I].Cls := C;
    NA := RdU2(B, P);
    For J := 1 To NA Do Begin
      AName := Tmp[RdU2(B, P)].S;
      AL := RdU4(B, P);
      AEnd := P + AL;
      If AName = 'Code' Then ParseCode(Classes[C].Methods[I], B, P, AEnd);
      P := AEnd;
    End;
  End;
  { attributs de classe }
  NA := RdU2(B, P);
  For J := 1 To NA Do Begin
    AName := Tmp[RdU2(B, P)].S;
    AL := RdU4(B, P);
    AEnd := P + AL;
    If AName = 'SourceFile' Then Classes[C].SourceFile := Tmp[RdU2(B, P)].S
    Else If AName = 'BootstrapMethods' Then Begin
      NBoot := RdU2(B, P);
      SetLength(Classes[C].Boots, NBoot);
      For I := 0 To NBoot - 1 Do Begin
        Classes[C].Boots[I].Mh := RdU2(B, P);
        NBA := RdU2(B, P);
        SetLength(Classes[C].Boots[I].Args, NBA);
        For K := 0 To NBA - 1 Do Classes[C].Boots[I].Args[K] := RdU2(B, P);
      End;
    End
    Else If AName = 'PermittedSubclasses' Then Begin
      NBoot := RdU2(B, P);
      SetLength(Classes[C].Permitted, NBoot);
      For I := 0 To NBoot - 1 Do Classes[C].Permitted[I] := Tmp[Tmp[RdU2(B, P)].A].S;
    End
    Else If AName = 'InnerClasses' Then Begin
      NBoot := RdU2(B, P);
      For I := 0 To NBoot - 1 Do Begin
        IfIdx := RdU2(B, P);         { inner_class_info }
        K := RdU2(B, P);             { outer_class_info }
        NBA := RdU2(B, P);           { inner_name }
        RdU2(B, P);                  { flags }
        If Tmp[Tmp[IfIdx].A].S = Name Then Begin
          Classes[C].IsInnerInfo := True;
          If K > 0 Then Classes[C].Enclosing := Tmp[Tmp[K].A].S;
          If NBA > 0 Then Classes[C].InnerName := Tmp[NBA].S Else Classes[C].InnerName := '';
        End;
      End;
    End;
    P := AEnd;
  End;
  { super-classe et interfaces (peuvent charger d'autres classes) }
  If SuperName <> '' Then Begin
    K := LoadClass(SuperName);
    Classes[C].Super := K;
  End;
  SetLength(Classes[C].Ifaces, NI);
  For I := 0 To NI - 1 Do Begin
    K := LoadClass(Ifs[I]);
    Classes[C].Ifaces[I] := K;
  End;
  LinkClass(C);
End;

{ ============================================================================
  LIAISON, CHARGEMENT ET RESOLUTION
  ============================================================================ }

Function ArgSlotsOf(K : Char) : LongInt;
Begin
  If (K = 'J') Or (K = 'D') Then ArgSlotsOf := 2 Else ArgSlotsOf := 1;
End;

Procedure LinkClass(C : LongInt);
Var I, Base, NStat, J : LongInt; S : LongInt; M : LongInt; Nm : AnsiString;
Begin
  Base := 0;
  S := Classes[C].Super;
  If S >= 0 Then Begin
    Base := Classes[S].NInst;
    Classes[C].ObjKind := Classes[S].ObjKind;
  End;
  Nm := Classes[C].Name;
  If Nm = 'java/lang/String' Then Classes[C].ObjKind := KIND_STR
  Else If (Nm = 'java/lang/StringBuilder') Or (Nm = 'java/lang/StringBuffer') Then Classes[C].ObjKind := KIND_SB;
  NStat := 0;
  For I := 0 To Length(Classes[C].Fields) - 1 Do
    If (Classes[C].Fields[I].Flags And ACC_STATIC) <> 0 Then Begin
      Classes[C].Fields[I].Slot := NStat; Inc(NStat);
    End
    Else Begin
      Classes[C].Fields[I].Slot := Base; Inc(Base);
    End;
  Classes[C].NInst := Base;
  SetLength(Classes[C].Statics, NStat);
  For I := 0 To NStat - 1 Do Classes[C].Statics[I] := 0;
  For I := 0 To Length(Classes[C].Methods) - 1 Do Begin
    ParseDesc(Classes[C].Methods[I].Desc, Classes[C].Methods[I].ArgKinds, Classes[C].Methods[I].RetKind);
    Classes[C].Methods[I].NArgs := Length(Classes[C].Methods[I].ArgKinds);
    If (Classes[C].Methods[I].Flags And ACC_STATIC) <> 0 Then J := 0 Else J := 1;
    For M := 1 To Length(Classes[C].Methods[I].ArgKinds) Do Inc(J, ArgSlotsOf(Classes[C].Methods[I].ArgKinds[M]));
    Classes[C].Methods[I].NArgSlots := J;
    Classes[C].Methods[I].Sel := SelectorOf(Classes[C].Methods[I].Name, Classes[C].Methods[I].Desc);
    Classes[C].Methods[I].Native := Nil;
    If (Classes[C].Methods[I].Flags And ACC_NATIVE) <> 0 Then Begin
      J := MapFind(NativeMap, Nm + '.' + Classes[C].Methods[I].Name + Classes[C].Methods[I].Desc);
      If J >= 0 Then Classes[C].Methods[I].Native := NativeProcs[J];
    End;
  End;
  If Classes[C].Name = 'java/lang/Object' Then C_OBJECT := C
  Else If Classes[C].Name = 'java/lang/String' Then C_STRING := C
  Else If Classes[C].Name = 'java/lang/Class' Then C_CLASS := C
  Else If Classes[C].Name = 'java/lang/Throwable' Then C_THROWABLE := C
  Else If Classes[C].Name = 'java/lang/StringBuilder' Then C_SB := C
  Else If Classes[C].Name = 'java/lang/Cloneable' Then C_CLONEABLE := C
  Else If Classes[C].Name = 'java/io/Serializable' Then C_SERIAL := C;
End;

{ Octets d'une classe : classes incluses dans ce fichier, puis classpath }
Function EmbeddedClassBytes(Const Name : AnsiString; Var B : TBytes) : Boolean; Forward;

Function FindClassBytes(Const Name : AnsiString; Var B : TBytes) : Boolean;
Var I : LongInt; Path : AnsiString;
Begin
  FindClassBytes := True;
  If EmbeddedClassBytes(Name, B) Then Exit;
  For I := 0 To NClassPath - 1 Do Begin
    Path := ClassPath[I];
    If (Path <> '') And (Path[Length(Path)] <> '/') And (Path[Length(Path)] <> '\') Then Path := Path + '/';
    If ReadFileBytes(Path + Name + '.class', B) Then Exit;
  End;
  FindClassBytes := False;
End;

Function ArrayClassIdx(Const Desc : AnsiString) : LongInt;
Var C, E : LongInt; ED : AnsiString;
Begin
  C := MapFind(ClassMap, Desc);
  If C >= 0 Then Begin ArrayClassIdx := C; Exit; End;
  C := NewClassRec(Desc);
  Classes[C].IsArray := True;
  Classes[C].Flags := ACC_PUBLIC Or ACC_FINAL Or ACC_ABSTRACT;
  Classes[C].Super := C_OBJECT;
  SetLength(Classes[C].Ifaces, 2);
  Classes[C].Ifaces[0] := C_CLONEABLE;
  Classes[C].Ifaces[1] := C_SERIAL;
  Classes[C].InitState := 2;
  ED := Copy(Desc, 2, Length(Desc));
  Classes[C].ElemDesc := ED;
  Classes[C].ElemCls := -1;
  If ED[1] = 'L' Then Begin
    E := LoadClass(Copy(ED, 2, Length(ED) - 2));
    Classes[C].ElemCls := E;
  End
  Else If ED[1] = '[' Then Classes[C].ElemCls := ArrayClassIdx(ED);
  ArrayClassIdx := C;
End;

Function FindClassIdx(Const Name : AnsiString) : LongInt;
Begin
  FindClassIdx := MapFind(ClassMap, Name);
End;

{ Charge une classe par son nom interne ; -1 si introuvable }
Function LoadClass(Const Name : AnsiString) : LongInt;
Var C : LongInt; B : TBytes;
Begin
  C := MapFind(ClassMap, Name);
  If C >= 0 Then Begin LoadClass := C; Exit; End;
  If (Name <> '') And (Name[1] = '[') Then Begin LoadClass := ArrayClassIdx(Name); Exit; End;
  If Not FindClassBytes(Name, B) Then Begin LoadClass := -1; Exit; End;
  LoadClass := DefineClass(B);
End;

{ ----- sous-typage -------------------------------------------------------- }

Var
  SubCache : Array[0..8191] Of Int64;

Function IsSubclassRaw(C, D : LongInt) : Boolean;
Var I : LongInt;
Begin
  IsSubclassRaw := True;
  If C = D Then Exit;
  If D = C_OBJECT Then Exit;
  If C < 0 Then Begin IsSubclassRaw := False; Exit; End;
  If Classes[C].IsArray Then Begin
    If Classes[D].IsArray Then Begin
      If (Classes[C].ElemCls >= 0) And (Classes[D].ElemCls >= 0) Then
        IsSubclassRaw := IsSubclassRaw(Classes[C].ElemCls, Classes[D].ElemCls)
      Else IsSubclassRaw := Classes[C].ElemDesc = Classes[D].ElemDesc;
    End
    Else IsSubclassRaw := (D = C_CLONEABLE) Or (D = C_SERIAL);
    Exit;
  End;
  If (Classes[D].Flags And ACC_INTERFACE) = 0 Then Begin
    { classe : on remonte les superclasses }
    I := Classes[C].Super;
    While I >= 0 Do Begin
      If I = D Then Exit;
      I := Classes[I].Super;
    End;
    IsSubclassRaw := False;
    Exit;
  End;
  { interface : toutes les interfaces implementees }
  I := C;
  While I >= 0 Do Begin
    If I = D Then Exit;
    For C := 0 To Length(Classes[I].Ifaces) - 1 Do
      If IsSubclassRaw(Classes[I].Ifaces[C], D) Then Exit;
    I := Classes[I].Super;
  End;
  IsSubclassRaw := False;
End;

Function IsSubclass(C, D : LongInt) : Boolean;
Var K : LongInt; V : Int64; Ok : Boolean;
Begin
  If C = D Then Begin IsSubclass := True; Exit; End;
  K := ((C * 31) Xor D) And 8191;
  V := SubCache[K];
  If (V <> 0) And ((V Shr 2) = (Int64(C) * 65536 + D)) Then Begin IsSubclass := (V And 1) <> 0; Exit; End;
  Ok := IsSubclassRaw(C, D);
  IsSubclass := Ok;
  If Ok Then V := 1 Else V := 0;
  SubCache[K] := ((Int64(C) * 65536 + D) Shl 2) Or V Or 2;
End;

{ ----- recherche de methodes et de champs --------------------------------- }

Function FindMethodDecl(C : LongInt; Const Name, Desc : AnsiString) : LongInt;
Var I : LongInt;
Begin
  FindMethodDecl := -1;
  For I := 0 To Length(Classes[C].Methods) - 1 Do
    If (Classes[C].Methods[I].Name = Name) And (Classes[C].Methods[I].Desc = Desc) Then Begin
      FindMethodDecl := I; Exit;
    End;
End;

{ Methode declaree dans C, ses superclasses ou ses super-interfaces : (classe * 65536 + indice) ou -1 }
Function FindMethodRef(C : LongInt; Const Name, Desc : AnsiString) : LongInt;
Var I, K, R : LongInt;
Begin
  FindMethodRef := -1;
  K := C;
  While K >= 0 Do Begin
    I := FindMethodDecl(K, Name, Desc);
    If I >= 0 Then Begin FindMethodRef := K * 65536 + I; Exit; End;
    K := Classes[K].Super;
  End;
  K := C;
  While K >= 0 Do Begin
    For I := 0 To Length(Classes[K].Ifaces) - 1 Do Begin
      R := FindMethodRef(Classes[K].Ifaces[I], Name, Desc);
      If R >= 0 Then Begin FindMethodRef := R; Exit; End;
    End;
    K := Classes[K].Super;
  End;
  If (Classes[C].Flags And ACC_INTERFACE) <> 0 Then Begin
    I := FindMethodDecl(C_OBJECT, Name, Desc);
    If I >= 0 Then FindMethodRef := C_OBJECT * 65536 + I;
  End;
End;

Function FindFieldIn(C : LongInt; Const Name, Desc : AnsiString; Var Owner : LongInt) : LongInt;
Var I, K, R : LongInt;
Begin
  FindFieldIn := -1;
  If C < 0 Then Exit;
  For I := 0 To Length(Classes[C].Fields) - 1 Do
    If (Classes[C].Fields[I].Name = Name) And ((Desc = '') Or (Classes[C].Fields[I].Desc = Desc)) Then Begin
      Owner := C; FindFieldIn := I; Exit;
    End;
  For K := 0 To Length(Classes[C].Ifaces) - 1 Do Begin
    R := FindFieldIn(Classes[C].Ifaces[K], Name, Desc, Owner);
    If R >= 0 Then Begin FindFieldIn := R; Exit; End;
  End;
  FindFieldIn := FindFieldIn(Classes[C].Super, Name, Desc, Owner);
End;

{ Methode par defaut (ou concrete) d'une interface pour le selecteur Sel : cherche dans C et ses super-interfaces ;
  prefere la plus specifique }
Function FindDefault(C : LongInt; Sel : LongInt) : LongInt;
Var I, K, R, Best : LongInt;
Begin
  FindDefault := -1;
  For I := 0 To Length(Classes[C].Methods) - 1 Do
    If (Classes[C].Methods[I].Sel = Sel) And ((Classes[C].Methods[I].Flags And (ACC_ABSTRACT Or ACC_STATIC)) = 0) Then Begin
      FindDefault := C * 65536 + I; Exit;
    End;
  Best := -1;
  For K := 0 To Length(Classes[C].Ifaces) - 1 Do Begin
    R := FindDefault(Classes[C].Ifaces[K], Sel);
    If R >= 0 Then Begin
      If (Best < 0) Or IsSubclass(R Div 65536, Best Div 65536) Then Best := R;
    End;
  End;
  FindDefault := Best;
End;

{ Methode a executer pour un objet de classe RC et un selecteur : (classe * 65536 + indice) ou -1 }
Function FindVirtual(RC : LongInt; Sel : LongInt) : LongInt;
Var K, I, R, Best, J : LongInt;
Begin
  If Sel < Length(Classes[RC].VTab) Then Begin
    R := Classes[RC].VTab[Sel];
    If R <> -2 Then Begin FindVirtual := R; Exit; End;
  End
  Else Begin
    J := Length(Classes[RC].VTab);
    SetLength(Classes[RC].VTab, NSels + 64);
    For I := J To Length(Classes[RC].VTab) - 1 Do Classes[RC].VTab[I] := -2;
  End;
  R := -1;
  K := RC;
  While (K >= 0) And (R < 0) Do Begin
    For I := 0 To Length(Classes[K].Methods) - 1 Do
      If (Classes[K].Methods[I].Sel = Sel) And ((Classes[K].Methods[I].Flags And (ACC_ABSTRACT Or ACC_STATIC)) = 0) Then Begin
        R := K * 65536 + I; Break;
      End;
    K := Classes[K].Super;
  End;
  If R < 0 Then Begin
    { methodes par defaut des interfaces }
    Best := -1;
    K := RC;
    While K >= 0 Do Begin
      For I := 0 To Length(Classes[K].Ifaces) - 1 Do Begin
        J := FindDefault(Classes[K].Ifaces[I], Sel);
        If J >= 0 Then
          If (Best < 0) Or IsSubclass(J Div 65536, Best Div 65536) Then Best := J;
      End;
      K := Classes[K].Super;
    End;
    R := Best;
  End;
  Classes[RC].VTab[Sel] := R;
  FindVirtual := R;
End;
{ ============================================================================
  TAS D'OBJETS, CHAINES ET RAMASSE-MIETTES
  ============================================================================ }

Type
  TObj = Record
    Cls      : LongInt;         { -1 : emplacement libre }
    Kind     : Byte;
    Mark     : Boolean;
    NoRefs   : Boolean;         { tableau de primitifs : rien a parcourir }
    HasHash  : Boolean;
    IdHash   : LongInt;
    Len      : LongInt;         { tableaux : longueur ; emplacement libre : suivant }
    SHash    : LongInt;
    Aux      : Int64;
    MonOwner : LongInt;         { moniteur : indice du thread proprietaire + 1 (0 : libre) }
    MonCnt   : LongInt;
    F        : Array Of Int64;  { champs d'instance ou elements de tableau }
    S        : UnicodeString;   { chaines, StringBuilder }
  End;

Var
  Heap        : Array Of TObj;
  HeapTop     : LongInt;
  FreeHead    : LongInt;
  AllocCount  : LongInt;
  GcThreshold : LongInt;
  GcWanted    : Boolean;
  LiveCount   : LongInt;
  Pins        : Array Of LongInt;
  NPins       : LongInt;
  InternMap   : TStrMap;
  PendingExc  : LongInt;        { exception en cours de propagation (0 : aucune) }
  NRet        : Int64;          { valeur de retour d'une methode native }
  GSP         : LongInt;        { sommet de la pile pour les appels imbriques }
  MarkStk     : Array Of LongInt;

Procedure HeapInit;
Begin
  SetLength(Heap, 4096);
  HeapTop := 1;
  FreeHead := 0;
  AllocCount := 0;
  GcThreshold := 200000;
  GcWanted := False;
  LiveCount := 0;
  NPins := 0;
  SetLength(Pins, 64);
  MapInit(InternMap, 4099);
  Heap[0].Cls := -1;
End;

Function AllocObj : LongInt;
Var R, I, N : LongInt;
Begin
  If FreeHead <> 0 Then Begin
    R := FreeHead;
    FreeHead := Heap[R].Len;
  End
  Else Begin
    If HeapTop >= Length(Heap) Then Begin
      N := Length(Heap) * 2;
      SetLength(Heap, N);
    End;
    R := HeapTop;
    Inc(HeapTop);
  End;
  Heap[R].Mark := False;
  Heap[R].NoRefs := False;
  Heap[R].HasHash := False;
  Heap[R].IdHash := 0;
  Heap[R].Len := 0;
  Heap[R].SHash := 0;
  Heap[R].Aux := 0;
  Heap[R].MonOwner := 0;
  Heap[R].MonCnt := 0;
  Inc(AllocCount);
  Inc(LiveCount);
  If AllocCount >= GcThreshold Then GcWanted := True;
  I := 0;
  AllocObj := R;
End;

Procedure Pin(H : LongInt);
Begin
  If NPins >= Length(Pins) Then SetLength(Pins, NPins * 2);
  Pins[NPins] := H;
  Inc(NPins);
End;

Procedure Unpin(N : LongInt);
Begin
  Dec(NPins, N);
End;

Function NewObject(C : LongInt) : LongInt;
Var R : LongInt;
Begin
  R := AllocObj;
  Heap[R].Cls := C;
  Heap[R].Kind := Classes[C].ObjKind;
  SetLength(Heap[R].F, Classes[C].NInst);
  If Classes[C].NInst > 0 Then FillChar(Heap[R].F[0], Classes[C].NInst * SizeOf(Int64), 0);
  Heap[R].S := '';
  NewObject := R;
End;

Function NewArray(AC : LongInt; N : LongInt) : LongInt;
Var R : LongInt;
Begin
  R := AllocObj;
  Heap[R].Cls := AC;
  Heap[R].Kind := KIND_ARR;
  Heap[R].Len := N;
  SetLength(Heap[R].F, N);
  If N > 0 Then FillChar(Heap[R].F[0], N * SizeOf(Int64), 0);
  Heap[R].S := '';
  Heap[R].NoRefs := (Classes[AC].ElemCls < 0) And (Classes[AC].ElemDesc[1] <> 'L') And (Classes[AC].ElemDesc[1] <> '[');
  NewArray := R;
End;

{ Tableau d'un descripteur de tableau comme '[I' ou '[Ljava/lang/String;' }
Function NewArrayDesc(Const Desc : AnsiString; N : LongInt) : LongInt;
Begin
  NewArrayDesc := NewArray(ArrayClassIdx(Desc), N);
End;

Function NewStr(Const W : UnicodeString) : LongInt;
Var R : LongInt;
Begin
  R := AllocObj;
  Heap[R].Cls := C_STRING;
  Heap[R].Kind := KIND_STR;
  SetLength(Heap[R].F, 0);
  Heap[R].S := W;
  NewStr := R;
End;

Function WKey(Const W : UnicodeString) : AnsiString;
Var R : AnsiString;
Begin
  SetLength(R, Length(W) * 2);
  If Length(W) > 0 Then Move(W[1], R[1], Length(W) * 2);
  WKey := R;
End;

Function Intern(Const W : UnicodeString) : LongInt;
Var K : AnsiString; H : LongInt;
Begin
  K := WKey(W);
  H := MapFind(InternMap, K);
  If H < 0 Then Begin
    H := NewStr(W);
    MapPut(InternMap, K, H);
  End;
  Intern := H;
End;

{ Chaine Java a partir d'un texte Pascal en UTF-8 }
Function JStr(Const A : AnsiString) : LongInt;
Begin
  JStr := NewStr(Utf8ToWide(A));
End;

Function SOf(H : LongInt) : UnicodeString;
Begin
  If H = 0 Then SOf := 'null' Else SOf := Heap[H].S;
End;

Function SOfA(H : LongInt) : AnsiString;
Begin
  SOfA := WideToUtf8(SOf(H));
End;

Function ClassOfObj(H : LongInt) : LongInt;
Begin
  ClassOfObj := Heap[H].Cls;
End;

Function MirrorOf(C : LongInt) : LongInt;
Var R : LongInt;
Begin
  If Classes[C].Mirror = 0 Then Begin
    R := NewObject(C_CLASS);
    Heap[R].Aux := C;
    Classes[C].Mirror := R;
  End;
  MirrorOf := Classes[C].Mirror;
End;

{ ----- ramasse-miettes (marquage et balayage conservateur) ---------------- }

Var
  MarkTop : LongInt;

Procedure MarkPush(V : Int64);
Begin
  If (V > 0) And (V < HeapTop) Then
    If Heap[V].Cls >= 0 Then
      If Not Heap[V].Mark Then Begin
        Heap[V].Mark := True;
        If MarkTop >= Length(MarkStk) Then SetLength(MarkStk, MarkTop * 2 + 1024);
        MarkStk[MarkTop] := V;
        Inc(MarkTop);
      End;
End;

Procedure MarkDrain;
Var H, I : LongInt;
Begin
  While MarkTop > 0 Do Begin
    Dec(MarkTop);
    H := MarkStk[MarkTop];
    If Not Heap[H].NoRefs Then
      For I := 0 To Length(Heap[H].F) - 1 Do MarkPush(Heap[H].F[I]);
  End;
End;

Procedure ScanOtherThreads; Forward;

Procedure CollectGarbage(Stk : PSlot; SP : LongInt);
Var I, J : LongInt; P : PSlot;
Begin
  MarkTop := 0;
  { pile d'execution }
  For I := 0 To SP - 1 Do Begin
    P := Stk; Inc(P, I);
    MarkPush(P^);
  End;
  MarkDrain;
  ScanOtherThreads;
  { classes : statiques, miroirs }
  For I := 0 To NClasses - 1 Do Begin
    For J := 0 To Length(Classes[I].Statics) - 1 Do MarkPush(Classes[I].Statics[J]);
    MarkPush(Classes[I].Mirror);
    MarkDrain;
  End;
  For I := 0 To InternMap.Count - 1 Do MarkPush(InternMap.Vals[I]);
  MarkDrain;
  For I := 0 To NPins - 1 Do MarkPush(Pins[I]);
  MarkPush(PendingExc);
  MarkDrain;
  { balayage }
  LiveCount := 0;
  FreeHead := 0;
  For I := HeapTop - 1 DownTo 1 Do Begin
    If Heap[I].Cls >= 0 Then Begin
      If Heap[I].Mark Then Begin
        Heap[I].Mark := False;
        Inc(LiveCount);
      End
      Else Begin
        Heap[I].Cls := -1;
        SetLength(Heap[I].F, 0);
        Heap[I].S := '';
        Heap[I].Len := FreeHead;
        FreeHead := I;
      End;
    End
    Else Begin
      Heap[I].Len := FreeHead;
      FreeHead := I;
    End;
  End;
  AllocCount := 0;
  GcThreshold := LiveCount + 200000;
  If GcThreshold < 300000 Then GcThreshold := 300000;
  GcWanted := False;
End;
{ ============================================================================
  NOMBRES : conversions et formatage a la maniere de Java
  ============================================================================ }

Type
  TConv = Record
    Case Byte Of
      0 : (I : Int64);
      1 : (D : Double);
      2 : (L : LongInt);
      3 : (S : Single);
  End;

Function SlotToD(V : Int64) : Double;
Var C : TConv;
Begin
  C.I := V; SlotToD := C.D;
End;

Function DToSlot(D : Double) : Int64;
Var C : TConv;
Begin
  C.D := D; DToSlot := C.I;
End;

Function SlotToF(V : Int64) : Single;
Var C : TConv;
Begin
  C.I := 0; C.L := LongInt(V); SlotToF := C.S;
End;

Function FToSlot(F : Single) : Int64;
Var C : TConv;
Begin
  C.I := 0; C.S := F; FToSlot := C.L;
End;

Function IsNanD(D : Double) : Boolean;
Var C : TConv;
Begin
  C.D := D;
  IsNanD := ((C.I Shr 52) And $7FF = $7FF) And ((C.I And $000FFFFFFFFFFFFF) <> 0);
End;

Function IsInfD(D : Double) : Boolean;
Var C : TConv;
Begin
  C.D := D;
  IsInfD := ((C.I Shr 52) And $7FF = $7FF) And ((C.I And $000FFFFFFFFFFFFF) = 0);
End;

Function IsNegD(D : Double) : Boolean;
Var C : TConv;
Begin
  C.D := D;
  IsNegD := C.I < 0;
End;

Function NanD : Double;
Var C : TConv;
Begin
  C.I := $7FF8000000000000; NanD := C.D;
End;

Function PosInfD : Double;
Var C : TConv;
Begin
  C.I := $7FF0000000000000; PosInfD := C.D;
End;

Function D2I(D : Double) : Int64;
Begin
  If IsNanD(D) Then D2I := 0
  Else If D >= 2147483647.0 Then D2I := 2147483647
  Else If D <= -2147483648.0 Then D2I := -2147483648
  Else D2I := Trunc(D);
End;

Function D2L(D : Double) : Int64;
Begin
  If IsNanD(D) Then D2L := 0
  Else If D >= 9223372036854775807.0 Then D2L := $7FFFFFFFFFFFFFFF
  Else If D <= -9223372036854775808.0 Then D2L := Int64($8000000000000000)
  Else D2L := Trunc(D);
End;

Function FModD(A, B : Double) : Double;
Var R, T : Double; Neg : Boolean;
Begin
  If IsNanD(A) Or IsNanD(B) Or IsInfD(A) Or (B = 0) Then Begin FModD := NanD; Exit; End;
  If IsInfD(B) Then Begin FModD := A; Exit; End;
  Neg := IsNegD(A);
  R := Abs(A);
  B := Abs(B);
  While R >= B Do Begin
    T := B;
    While (T * 2 <= R) And Not IsInfD(T * 2) Do T := T * 2;
    R := R - T;
  End;
  If Neg Then FModD := -R Else FModD := R;
End;

{ Chiffres decimaux les plus courts qui redonnent D : Digs = 'd1d2d3', E = exposant (d1.d2d3 x 10^E) }
Procedure ShortestDigits(D : Double; Var Digs : AnsiString; Var E : LongInt; Single_ : Boolean);
Var P, I, Code, MaxP : LongInt; S : AnsiString; R : Double; RS : Single; Ok : Boolean; Ex : LongInt; Sg : Single;
Begin
  If Single_ Then MaxP := 9 Else MaxP := 17;
  Sg := D;
  For P := 1 To MaxP Do Begin
    If Single_ Then Str(Sg : (P + 7), S) Else Str(D : (P + 7), S);
    Ok := False;
    If Single_ Then Begin Val(S, RS, Code); Ok := (Code = 0) And (RS = Sg); End
    Else Begin Val(S, R, Code); Ok := (Code = 0) And (R = D); End;
    If Ok Or (P = MaxP) Then Break;
  End;
  { analyse : [espace]d.ddddE+xxx }
  I := 1;
  While (I <= Length(S)) And (S[I] = ' ') Do Inc(I);
  Digs := S[I]; Inc(I);
  If S[I] = '.' Then Inc(I);
  While (I <= Length(S)) And (S[I] <> 'E') Do Begin Digs := Digs + S[I]; Inc(I); End;
  Inc(I);
  Val(Copy(S, I, 10), Ex, Code);
  E := Ex;
  While (Length(Digs) > 1) And (Digs[Length(Digs)] = '0') Do SetLength(Digs, Length(Digs) - 1);
End;

Function FormatFloating(D : Double; Single_ : Boolean) : AnsiString;
Var Digs, R, Fr : AnsiString; E, I : LongInt; Neg : Boolean;
Begin
  If IsNanD(D) Then Begin FormatFloating := 'NaN'; Exit; End;
  If IsInfD(D) Then Begin
    If D < 0 Then FormatFloating := '-Infinity' Else FormatFloating := 'Infinity';
    Exit;
  End;
  Neg := IsNegD(D);
  If D = 0 Then Begin
    If Neg Then FormatFloating := '-0.0' Else FormatFloating := '0.0';
    Exit;
  End;
  If Neg Then D := -D;
  ShortestDigits(D, Digs, E, Single_);
  If (E >= -3) And (E < 7) Then Begin
    If E >= 0 Then Begin
      R := '';
      For I := 1 To E + 1 Do If I <= Length(Digs) Then R := R + Digs[I] Else R := R + '0';
      If Length(Digs) > E + 1 Then Fr := Copy(Digs, E + 2, Length(Digs)) Else Fr := '0';
      R := R + '.' + Fr;
    End
    Else Begin
      R := '0.';
      For I := 1 To -E - 1 Do R := R + '0';
      R := R + Digs;
    End;
  End
  Else Begin
    R := Digs[1] + '.';
    If Length(Digs) > 1 Then R := R + Copy(Digs, 2, Length(Digs)) Else R := R + '0';
    R := R + 'E' + IStr(E);
  End;
  If Neg Then R := '-' + R;
  FormatFloating := R;
End;

Function DoubleToStr(D : Double) : AnsiString;
Begin
  DoubleToStr := FormatFloating(D, False);
End;

Function FloatToStr_(F : Single) : AnsiString;
Begin
  FloatToStr_ := FormatFloating(F, True);
End;

{ Notation fixe avec Prec decimales, arrondi "demi superieur" sur les chiffres les plus courts (comme String.format) }
Function FormatFixed(D : Double; Prec : LongInt) : AnsiString;
Var Digs : AnsiString; E, I, K, Pos : LongInt; Neg : Boolean; Ds : Array Of LongInt; N : LongInt; Carry : LongInt; IntP, FrP : AnsiString;
Begin
  If IsNanD(D) Then Begin FormatFixed := 'NaN'; Exit; End;
  If IsInfD(D) Then Begin
    If D < 0 Then FormatFixed := '-Infinity' Else FormatFixed := 'Infinity';
    Exit;
  End;
  Neg := IsNegD(D);
  If Neg Then D := -D;
  If D = 0 Then Begin
    Digs := '0'; E := 0;
  End
  Else ShortestDigits(D, Digs, E, False);
  { chiffres : indice 0 = poids 10^E }
  N := Length(Digs);
  { nombre de chiffres a conserver : E + 1 + Prec }
  K := E + 1 + Prec;
  SetLength(Ds, N + 2);
  For I := 0 To N + 1 Do Ds[I] := 0;
  For I := 1 To N Do Ds[I] := Ord(Digs[I]) - 48;   { Ds[1] = poids 10^E ; Ds[0] = retenue }
  If K < 0 Then Begin
    For I := 1 To N Do Ds[I] := 0;
  End
  Else If K < N Then Begin
    Carry := 0;
    If Ds[K + 1] >= 5 Then Carry := 1;
    For I := K + 1 To N Do Ds[I] := 0;
    I := K;
    While Carry > 0 Do Begin
      Inc(Ds[I], Carry);
      If Ds[I] >= 10 Then Begin Dec(Ds[I], 10); Carry := 1; End Else Carry := 0;
      Dec(I);
      If I < 0 Then Break;
    End;
  End;
  { poids de Ds[i] : 10^(E + 1 - i) ; Ds[0] de poids 10^(E+1) }
  IntP := ''; FrP := '';
  For Pos := E + 1 DownTo -Prec Do Begin
    I := E + 1 - Pos;
    If (I >= 0) And (I <= N) Then K := Ds[I] Else K := 0;
    If Pos >= 0 Then IntP := IntP + Chr(48 + K) Else FrP := FrP + Chr(48 + K);
  End;
  If E + 1 < 0 Then Begin
    { partie entiere sans chiffre : on cree les chiffres manquants }
  End;
  While (Length(IntP) > 1) And (IntP[1] = '0') Do Delete(IntP, 1, 1);
  If IntP = '' Then IntP := '0';
  If E + 1 < 0 Then Begin
    { positions entre E+1 et -1 : zeros }
    FrP := '';
    For Pos := -1 DownTo -Prec Do Begin
      I := E + 1 - Pos;
      If (I >= 0) And (I <= N) Then K := Ds[I] Else K := 0;
      FrP := FrP + Chr(48 + K);
    End;
  End;
  If Prec > 0 Then IntP := IntP + '.' + FrP;
  If Neg Then IntP := '-' + IntP;
  FormatFixed := IntP;
End;

Function LongToHex(V : Int64; Bits : LongInt) : AnsiString;
Var S : AnsiString; U : QWord; D : LongInt;
Begin
  If Bits = 32 Then U := QWord(V) And $FFFFFFFF Else U := QWord(V);
  If U = 0 Then Begin LongToHex := '0'; Exit; End;
  S := '';
  While U <> 0 Do Begin
    D := U And 15;
    If D < 10 Then S := Chr(48 + D) + S Else S := Chr(87 + D) + S;
    U := U Shr 4;
  End;
  LongToHex := S;
End;

Function ParseDouble(Const S : AnsiString; Var Ok : Boolean) : Double;
Var T : AnsiString; Code : LongInt; R : Double;
Begin
  T := S;
  While (Length(T) > 0) And (T[1] <= ' ') Do Delete(T, 1, 1);
  While (Length(T) > 0) And (T[Length(T)] <= ' ') Do SetLength(T, Length(T) - 1);
  If (Length(T) > 0) And (T[Length(T)] In ['d', 'D', 'f', 'F']) Then SetLength(T, Length(T) - 1);
  Ok := True;
  If T = 'NaN' Then Begin ParseDouble := NanD; Exit; End;
  If (T = 'Infinity') Or (T = '+Infinity') Then Begin ParseDouble := PosInfD; Exit; End;
  If T = '-Infinity' Then Begin ParseDouble := -PosInfD; Exit; End;
  If (T = '') Or (T[Length(T)] = '.') And (Length(T) = 1) Then Begin Ok := False; ParseDouble := 0; Exit; End;
  If Pos('x', LowerA(T)) > 0 Then Begin Ok := False; ParseDouble := 0; Exit; End;
  Val(T, R, Code);
  If Code <> 0 Then Begin Ok := False; R := 0; End;
  ParseDouble := R;
End;
{ ============================================================================
  PILE, CADRES, ERREURS, INITIALISATION DE CLASSES ET APPELS IMBRIQUES
  ============================================================================ }

Const
  STK_SIZE   = 4000000;       { cases de la pile }
  MAX_FRAMES = 9000;

Type
  TFrame = Record
    Cls, Mth, Pc, Base, Mon : LongInt;
  End;
  TFrameArr = Array[0..MAX_FRAMES + 63] Of TFrame;
  PFrameArr = ^TFrameArr;
  TSlotArr = Array[0..$3FFFFFF] Of Int64;
  PSlotArr = ^TSlotArr;
  PMethod = ^TMethod;
  TArgs = Array Of Int64;

Var
  Stk : PSlotArr;
  Frames : PFrameArr;
  FTop : LongInt;             { nombre de cadres actifs }
  Pend : Boolean;             { une exception est en attente (PendingExc ou ErrCls) }
  ErrCls : AnsiString;        { erreur levee par une instruction : classe et message }
  ErrMsg : AnsiString;
  ErrHasMsg : Boolean;
  RunLevel : LongInt;
  StkLimit : LongInt;          { taille de la pile du thread courant }

Type PSlotArr_ = PSlotArr;

Function AP(A : PSlot) : PSlotArr;
Begin
  AP := PSlotArr(A);
End;

Function BoolRet(B : Boolean) : Int64;
Begin
  If B Then BoolRet := 1 Else BoolRet := 0;
End;

Procedure StackInit;
Begin
  GetMem(Stk, STK_SIZE * SizeOf(Int64));
  GetMem(Frames, SizeOf(TFrameArr));
  FillChar(Stk^, 1024, 0);
  StkLimit := STK_SIZE;
  FTop := 0;
  GSP := 0;
  Pend := False;
  PendingExc := 0;
End;

Procedure SetErr(Const Cls, Msg : AnsiString);
Begin
  ErrCls := Cls; ErrMsg := Msg; ErrHasMsg := True;
  If OptDebug Then WriteLn(StdErr, '[erreur] ', Cls, ' ', Msg);
  Pend := True;
End;

Procedure SetErrNoMsg(Const Cls : AnsiString);
Begin
  ErrCls := Cls; ErrMsg := ''; ErrHasMsg := False;
  Pend := True;
End;

Function MethodPtr(PM : LongInt) : PMethod;
Begin
  MethodPtr := @Classes[PM Div 65536].Methods[PM Mod 65536];
End;

Function InvokeNested(C, MI, Base : LongInt) : Int64; Forward;
Procedure EnsureInit(C : LongInt); Forward;
Procedure ThrowNew(Const ClsName, Msg : AnsiString); Forward;

{ Appel d'une methode Java depuis Pascal : A contient toutes les cases d'arguments (this compris) }
Function CallPacked(PM : LongInt; Const A : Array Of Int64) : Int64;
Var I, Base : LongInt; SaveG : LongInt;
Begin
  SaveG := GSP;
  Base := GSP;
  For I := 0 To High(A) Do Stk^[Base + I] := A[I];
  CallPacked := InvokeNested(PM Div 65536, PM Mod 65536, Base);
  GSP := SaveG;
End;

Function FindMethodByName(Const CName, Name, Desc : AnsiString) : LongInt;
Var C : LongInt;
Begin
  FindMethodByName := -1;
  C := LoadClass(CName);
  If C < 0 Then Exit;
  FindMethodByName := FindMethodRef(C, Name, Desc);
End;

{ ----- creation d'exceptions ---------------------------------------------- }

Procedure ThrowObj(O : LongInt);
Begin
  PendingExc := O;
  Pend := True;
End;

Procedure ThrowNew(Const ClsName, Msg : AnsiString);
Var C, O, Ctor : LongInt; S : LongInt;
Begin
  C := LoadClass(ClsName);
  If C < 0 Then Fatal('classe d''exception introuvable : ' + ClsName + ' (' + Msg + ')');
  EnsureInit(C);
  If PendingExc <> 0 Then Exit;
  O := NewObject(C);
  Pin(O);
  If Msg <> '' Then Begin
    S := JStr(Msg);
    Pin(S);
    Ctor := FindMethodDecl(C, '<init>', '(Ljava/lang/String;)V');
    If Ctor >= 0 Then CallPacked(C * 65536 + Ctor, [O, S])
    Else Begin
      Ctor := FindMethodDecl(C, '<init>', '()V');
      CallPacked(C * 65536 + Ctor, [O]);
    End;
    Unpin(1);
  End
  Else Begin
    Ctor := FindMethodDecl(C, '<init>', '()V');
    If Ctor < 0 Then Fatal('constructeur absent : ' + ClsName);
    CallPacked(C * 65536 + Ctor, [O]);
  End;
  Unpin(1);
  If PendingExc = 0 Then Begin PendingExc := O; End;
  Pend := True;
End;

Procedure ThrowNPE(Const Msg : AnsiString);
Begin
  ThrowNew('java/lang/NullPointerException', Msg);
End;

{ ----- constantes du pool ------------------------------------------------- }

Function CPStringObj(C, I : LongInt) : LongInt;
Var H : LongInt;
Begin
  H := Classes[C].CP[I].R;
  If H = 0 Then Begin
    H := Intern(ModUtf8ToWide(Classes[C].CP[Classes[C].CP[I].A].S));
    Classes[C].CP[I].R := H;
  End;
  CPStringObj := H;
End;

{ Classe designee par l'entree CONSTANT_Class I du pool de C ; -1 si introuvable (Pend positionne) }
Function ResolveClass(C, I : LongInt) : LongInt;
Var R : LongInt; Nm : AnsiString;
Begin
  R := Classes[C].CP[I].R;
  If R <> 0 Then Begin ResolveClass := R - 1; Exit; End;
  Nm := Classes[C].CP[Classes[C].CP[I].A].S;
  R := LoadClass(Nm);
  If R < 0 Then Begin
    SetErr('java/lang/NoClassDefFoundError', Nm);
    ResolveClass := -1;
    Exit;
  End;
  Classes[C].CP[I].R := R + 1;
  ResolveClass := R;
End;

{ ----- initialisation des classes ----------------------------------------- }

Procedure InitConstants(C : LongInt);
Var I, J, Ix : LongInt; Tg : Byte;
Begin
  For I := 0 To Length(Classes[C].Fields) - 1 Do Begin
    Ix := Classes[C].Fields[I].ConstIdx;
    If (Ix > 0) And ((Classes[C].Fields[I].Flags And ACC_STATIC) <> 0) Then Begin
      Tg := Classes[C].CP[Ix].Tag;
      J := Classes[C].Fields[I].Slot;
      Case Tg Of
        CP_INT, CP_FLOAT, CP_LONG, CP_DOUBLE : Classes[C].Statics[J] := Classes[C].CP[Ix].N;
        CP_STRING : Classes[C].Statics[J] := CPStringObj(C, Ix);
      End;
    End;
  End;
End;

Procedure EnsureInit(C : LongInt);
Var Sup, CI, O, Ctor, I : LongInt;
Begin
  If Classes[C].InitState = 2 Then Exit;
  If Classes[C].InitState = 1 Then Exit;
  If Classes[C].InitState = 3 Then Begin
    SetErr('java/lang/NoClassDefFoundError', 'Could not initialize class ' + ReplaceCh(Classes[C].Name, '/', '.'));
    Exit;
  End;
  Classes[C].InitState := 1;
  Sup := Classes[C].Super;
  If Sup >= 0 Then Begin
    EnsureInit(Sup);
    If Pend Then Begin Classes[C].InitState := 3; Exit; End;
  End;
  InitConstants(C);
  CI := FindMethodDecl(C, '<clinit>', '()V');
  If CI >= 0 Then Begin
    CallPacked(C * 65536 + CI, []);
    If Pend Then Begin
      Classes[C].InitState := 3;
      If PendingExc <> 0 Then Begin
        O := PendingExc;
        If Not IsSubclass(Heap[O].Cls, LoadClass('java/lang/Error')) Then Begin
          PendingExc := 0; Pend := False;
          Pin(O);
          I := LoadClass('java/lang/ExceptionInInitializerError');
          EnsureInit(I);
          Sup := NewObject(I);
          Pin(Sup);
          Ctor := FindMethodDecl(I, '<init>', '(Ljava/lang/Throwable;)V');
          CallPacked(I * 65536 + Ctor, [Sup, O]);
          Unpin(2);
          PendingExc := Sup;
          Pend := True;
        End;
      End;
      Exit;
    End;
  End;
  Classes[C].InitState := 2;
End;

{ ----- boites (Integer, Long, ...) ----------------------------------------- }

Var
  BoxMeth : Array[0..7] Of LongInt;
  BoxInited : Boolean;

Function BoxIdx(K : Char) : LongInt;
Begin
  Case K Of
    'Z' : BoxIdx := 0; 'B' : BoxIdx := 1; 'C' : BoxIdx := 2; 'S' : BoxIdx := 3;
    'I' : BoxIdx := 4; 'J' : BoxIdx := 5; 'F' : BoxIdx := 6; 'D' : BoxIdx := 7;
  Else BoxIdx := 4;
  End;
End;

Function BoxClassName(K : Char) : AnsiString;
Begin
  Case K Of
    'Z' : BoxClassName := 'java/lang/Boolean'; 'B' : BoxClassName := 'java/lang/Byte';
    'C' : BoxClassName := 'java/lang/Character'; 'S' : BoxClassName := 'java/lang/Short';
    'I' : BoxClassName := 'java/lang/Integer'; 'J' : BoxClassName := 'java/lang/Long';
    'F' : BoxClassName := 'java/lang/Float'; 'D' : BoxClassName := 'java/lang/Double';
  Else BoxClassName := 'java/lang/Integer';
  End;
End;

Function BoxPrim(K : Char; V : Int64) : LongInt;
Var I : LongInt; Cn : AnsiString; C : LongInt;
Begin
  I := BoxIdx(K);
  If BoxMeth[I] = 0 Then Begin
    Cn := BoxClassName(K);
    C := LoadClass(Cn);
    EnsureInit(C);
    BoxMeth[I] := FindMethodRef(C, 'valueOf', '(' + K + ')L' + Cn + ';') + 1;
  End;
  BoxPrim := CallPacked(BoxMeth[I] - 1, [V, 0]);
End;

{ lettre primitive d'une classe boite, ou #0 }
Function BoxKindOfClass(C : LongInt) : Char;
Var N : AnsiString;
Begin
  BoxKindOfClass := #0;
  If C < 0 Then Exit;
  N := Classes[C].Name;
  If Copy(N, 1, 10) <> 'java/lang/' Then Exit;
  N := Copy(N, 11, 20);
  If N = 'Integer' Then BoxKindOfClass := 'I'
  Else If N = 'Long' Then BoxKindOfClass := 'J'
  Else If N = 'Double' Then BoxKindOfClass := 'D'
  Else If N = 'Float' Then BoxKindOfClass := 'F'
  Else If N = 'Boolean' Then BoxKindOfClass := 'Z'
  Else If N = 'Character' Then BoxKindOfClass := 'C'
  Else If N = 'Short' Then BoxKindOfClass := 'S'
  Else If N = 'Byte' Then BoxKindOfClass := 'B';
End;

{ conversion entre types primitifs (elargissement) d'une valeur de case }
Function ConvPrim(V : Int64; From, To_ : Char) : Int64;
Var D : Double;
Begin
  If From = To_ Then Begin ConvPrim := V; Exit; End;
  Case From Of
    'F' : Begin
      D := SlotToF(V);
      Case To_ Of
        'D' : ConvPrim := DToSlot(D);
        'I' : ConvPrim := D2I(D);
        'J' : ConvPrim := D2L(D);
      Else ConvPrim := V;
      End;
    End;
    'D' : Begin
      D := SlotToD(V);
      Case To_ Of
        'F' : ConvPrim := FToSlot(D);
        'I' : ConvPrim := D2I(D);
        'J' : ConvPrim := D2L(D);
      Else ConvPrim := V;
      End;
    End;
  Else
    Case To_ Of
      'F' : ConvPrim := FToSlot(V);
      'D' : ConvPrim := DToSlot(V);
    Else ConvPrim := V;
    End;
  End;
End;

{ debogage de la pile : "classe.methode" des cadres actifs }
Function FrameName(F : LongInt) : AnsiString;
Begin
  FrameName := Classes[Frames^[F].Cls].Name + '.' + Classes[Frames^[F].Cls].Methods[Frames^[F].Mth].Name;
End;

Function LineOf(C, MI, Pc : LongInt) : LongInt;
Var I, Best, BestPc : LongInt;
Begin
  Best := -1; BestPc := -1;
  For I := 0 To Length(Classes[C].Methods[MI].Lines) - 1 Do
    If (Classes[C].Methods[MI].Lines[I].Pc <= Pc) And (Classes[C].Methods[MI].Lines[I].Pc >= BestPc) Then Begin
      BestPc := Classes[C].Methods[MI].Lines[I].Pc;
      Best := Classes[C].Methods[MI].Lines[I].Line;
    End;
  LineOf := Best;
End;
