Procedure ExitJvm(Code : LongInt);
Begin
  Flush(JOut);
  Flush(StdErr);
  Halt(Code);
End;

{$IFDEF CPUX86_64}
Procedure MaskFPU; Assembler; {$asmmode intel}
Asm
  sub rsp, 8
  mov dword ptr [rsp], $1F80
  ldmxcsr dword ptr [rsp]
  add rsp, 8
End;
{$ENDIF}

Procedure PrintUncaught(Ex : LongInt);
Var Pm : LongInt; Msg : AnsiString;
Begin
  Flush(JOut);
  Write(StdErr, 'Exception in thread "main" ');
  Flush(StdErr);
  Pm := FindMethodByName('java/lang/Throwable', 'printStackTrace', '()V');
  PendingExc := 0; Pend := False;
  If Pm >= 0 Then Begin
    CallPacked(Pm, [Ex]);
    If Pend Then Begin
      Pend := False; PendingExc := 0;
      WriteLn(StdErr, JavaName(Heap[Ex].Cls));
    End;
  End
  Else WriteLn(StdErr, JavaName(Heap[Ex].Cls));
  Flush(JOut);
  Flush(StdErr);
End;

Procedure SplitPath(Const S : AnsiString);
Var I : LongInt; Cur : AnsiString;
Begin
  Cur := '';
  For I := 1 To Length(S) + 1 Do Begin
    If (I > Length(S)) Or (S[I] = ';') Or ((S[I] = ':') And Not ((I = 2) And (Length(Cur) = 1))) Then Begin
      If Cur <> '' Then Begin
        If NClassPath >= Length(ClassPath) Then SetLength(ClassPath, NClassPath + 8);
        ClassPath[NClassPath] := Cur;
        Inc(NClassPath);
      End;
      Cur := '';
    End
    Else Cur := Cur + S[I];
  End;
End;

Procedure Usage;
Begin
  WriteLn(StdErr, 'Usage : JVM [options] Classe [arguments]');
  WriteLn(StdErr, '  -cp, -classpath <chemins>  repertoires des classes (separes par ; ou :)');
  WriteLn(StdErr, '  -text                      pas de mode graphique');
  WriteLn(StdErr, '  -version                   affiche la version');
  Halt(1);
End;

Var
  MainName : AnsiString;
  ArgStart, AI, MainCls, MainM, ArgArr, I : LongInt;
  A : AnsiString;
  MainClsRef : LongInt;
  GuiAlive, ThreadsAlive : Boolean;

Begin
  {$IFDEF CPUX86_64} MaskFPU; {$ENDIF}
  {$IFDEF CPU386} Set8087CW($133F); {$ENDIF}
  Assign(JOut, ''); Rewrite(JOut);
  Assign(JIn, ''); Reset(JIn);
  OptText := False;
  OptDebug := False;
  NClassPath := 0;
  SetLength(ClassPath, 8);
  MapInit(ClassMap, 8209);
  MapInit(SelMap, 4099);
  MapInit(NativeMap, 1031);
  MapInit(EmbMap, 4099);
  SetLength(Classes, 256);
  SetLength(NativeProcs, 512);
  NClasses := 0; NSels := 0; NNatives := 0; NEmb := 0; NSites := 0;
  C_OBJECT := -1; C_STRING := -1; C_CLASS := -1; C_THROWABLE := -1; C_SB := -1; C_CLONEABLE := -1; C_SERIAL := -1;
  HashSeed := 12345;
  FillChar(SubCache, SizeOf(SubCache), 0);
  HeapInit;
  StackInit;
  ThreadsInited := False;
  LoadEmbedded;
  RegisterCoreNatives;
  RegisterGfxNatives;
  RegisterFileNatives;
  AI := 1;
  MainName := '';
  While AI <= ParamCount Do Begin
    A := ParamStr(AI);
    If (A = '-cp') Or (A = '-classpath') Or (A = '--class-path') Then Begin
      Inc(AI);
      If AI > ParamCount Then Usage;
      SplitPath(ParamStr(AI));
    End
    Else If A = '-text' Then OptText := True
    Else If A = '-vga' Then GfxVga := True
    Else If A = '-debug' Then OptDebug := True
    Else If (A = '-version') Or (A = '--version') Then Begin WriteLn(VERSION); Halt(0); End
    Else If (A = '-help') Or (A = '-h') Or (A = '-?') Then Usage
    Else If (Length(A) > 0) And (A[1] = '-') Then Begin
      WriteLn(StdErr, 'Option inconnue : ', A); Usage;
    End
    Else Begin MainName := A; Break; End;
    Inc(AI);
  End;
  If MainName = '' Then Usage;
  If NClassPath = 0 Then SplitPath('.');
  ArgStart := AI + 1;
  MainName := ReplaceCh(MainName, '.', '/');
  If (Length(MainName) > 6) And (Copy(MainName, Length(MainName) - 5, 6) = '/class') Then SetLength(MainName, Length(MainName) - 6);
  { classes de base }
  LoadClass('java/lang/Object');
  LoadClass('java/lang/Cloneable');
  LoadClass('java/io/Serializable');
  LoadClass('java/lang/String');
  LoadClass('java/lang/Class');
  LoadClass('java/lang/Throwable');
  If (C_OBJECT < 0) Or (C_STRING < 0) Or (C_CLASS < 0) Then Fatal('classes de base absentes de la bibliotheque');
  SelToString := SelectorOf('toString', '()Ljava/lang/String;');
  SelHashCode := SelectorOf('hashCode', '()I');
  SelEquals := SelectorOf('equals', '(Ljava/lang/Object;)Z');
  MainCls := LoadClass(MainName);
  If MainCls < 0 Then Begin
    WriteLn(StdErr, 'Erreur : impossible de trouver ou de charger la classe principale ', ReplaceCh(MainName, '/', '.'));
    ExitJvm(1);
  End;
  MainM := FindMethodDecl(MainCls, 'main', '([Ljava/lang/String;)V');
  If (MainM < 0) Or ((Classes[MainCls].Methods[MainM].Flags And ACC_STATIC) = 0) Then Begin
    WriteLn(StdErr, 'Erreur : la methode main(String[]) est absente de la classe ', ReplaceCh(MainName, '/', '.'));
    ExitJvm(1);
  End;
  GSP := 0;
  EnsureInit(MainCls);
  If Pend Then Begin
    I := PendingExc;
    PrintUncaught(I);
    ExitJvm(1);
  End;
  ArgArr := NewArray(ArrayClassIdx('[Ljava/lang/String;'), ParamCount - ArgStart + 1);
  Pin(ArgArr);
  For I := ArgStart To ParamCount Do Heap[ArgArr].F[I - ArgStart] := JStr(ParamStr(I));
  CallPacked(MainCls * 65536 + MainM, [ArgArr]);
  If Pend Then Begin
    I := PendingExc;
    Pend := False; PendingExc := 0;
    PrintUncaught(I);
    ExitCode := 1;
  End;
  { le thread principal a fini : on attend les fenetres et les threads non daemon }
  If ThreadsInited Then Dec(NonDaemon);
  Repeat
    GuiAlive := GfxPump;
    ThreadsAlive := ThreadsInited And (NonDaemon > 0);
    If GuiAlive Or ThreadsAlive Then SchedSleepSlice(10);
  Until Not (GuiAlive Or ThreadsAlive);
  GfxClose;
  ExitJvm(ExitCode);
End.
