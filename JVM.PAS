Procedure NVM_newInstance(A : PSlot);
Var C, Ctor, O : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  EnsureInit(C);
  If Pend Then Exit;
  Ctor := FindMethodDecl(C, '<init>', '()V');
  If Ctor < 0 Then Begin ThrowNew('java/lang/InstantiationException', JavaName(C)); Exit; End;
  O := NewObject(C);
  Pin(O);
  CallPacked(C * 65536 + Ctor, [O]);
  Unpin(1);
  NRet := O;
End;

