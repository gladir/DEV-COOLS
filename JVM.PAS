  NRet := BoolRet(Classes[ClsOfMirror(AP(A)^[0])].IsArray);
End;

Procedure NClass_isPrimitive(A : PSlot);
Var N : AnsiString;
Begin
  N := Classes[ClsOfMirror(AP(A)^[0])].Name;
  NRet := BoolRet((N = 'int') Or (N = 'long') Or (N = 'double') Or (N = 'float') Or (N = 'boolean') Or (N = 'char') Or (N = 'short') Or (N = 'byte') Or (N = 'void'));
End;

Procedure NClass_getSuperclass(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If (Classes[C].Super < 0) Or ((Classes[C].Flags And ACC_INTERFACE) <> 0) Then NRet := 0 Else NRet := MirrorOf(Classes[C].Super);
End;

Procedure NClass_getModifiers(A : PSlot);
Begin
  NRet := Classes[ClsOfMirror(AP(A)^[0])].Flags And $FFFF;
End;

Function PrimClassIdx(Const N : AnsiString) : LongInt; Forward;

Procedure NClass_getComponentType(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If Not Classes[C].IsArray Then NRet := 0
  Else If Classes[C].ElemCls >= 0 Then NRet := MirrorOf(Classes[C].ElemCls)
  Else Begin
    Case Classes[C].ElemDesc[1] Of
      'I' : NRet := MirrorOf(PrimClassIdx('int'));
      'J' : NRet := MirrorOf(PrimClassIdx('long'));
      'D' : NRet := MirrorOf(PrimClassIdx('double'));
      'F' : NRet := MirrorOf(PrimClassIdx('float'));
      'Z' : NRet := MirrorOf(PrimClassIdx('boolean'));
      'C' : NRet := MirrorOf(PrimClassIdx('char'));
      'S' : NRet := MirrorOf(PrimClassIdx('short'));
      'B' : NRet := MirrorOf(PrimClassIdx('byte'));
    Else NRet := 0;
    End;
  End;
End;

Function PrimClassIdx(Const N : AnsiString) : LongInt;
Var C : LongInt;
Begin
  C := MapFind(ClassMap, N);
  If C < 0 Then Begin
    C := NewClassRec(N);
    Classes[C].Flags := ACC_PUBLIC Or ACC_FINAL Or ACC_ABSTRACT;
    Classes[C].InitState := 2;
    Classes[C].Super := -1;
  End;
  PrimClassIdx := C;
End;

Procedure NClass_getPrimitiveClass(A : PSlot);
Begin
  NRet := MirrorOf(PrimClassIdx(SOfA(AP(A)^[0])));
End;

Procedure NClass_forName(A : PSlot);
Var N : AnsiString; C : LongInt;
Begin
  N := ReplaceCh(SOfA(AP(A)^[0]), '.', '/');
  C := LoadClass(N);
  If C < 0 Then Begin ThrowNew('java/lang/ClassNotFoundException', SOfA(AP(A)^[0])); Exit; End;
  EnsureInit(C);
  NRet := MirrorOf(C);
End;

