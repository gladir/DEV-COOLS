{ ----- caracteres ---------------------------------------------------------- }

Function ToUpperW(C : LongInt) : LongInt;
Begin
  ToUpperW := C;
  If (C >= 97) And (C <= 122) Then ToUpperW := C - 32
  Else If C < 128 Then Exit
  Else If (C >= $E0) And (C <= $FE) And (C <> $F7) Then ToUpperW := C - 32
  Else If C = $FF Then ToUpperW := $178
  Else If C = $B5 Then ToUpperW := $39C
  Else If (C >= $100) And (C <= $17F) Then Begin
    If ((C >= $100) And (C <= $137)) Or ((C >= $14A) And (C <= $177)) Then Begin
      If Odd(C) Then ToUpperW := C - 1;
    End
    Else If ((C >= $139) And (C <= $148)) Or ((C >= $179) And (C <= $17E)) Then
      Begin
      If Not Odd(C) Then ToUpperW := C - 1;
    End;
  End
  Else If (C >= $3B1) And (C <= $3C9) And (C <> $3C2) Then ToUpperW := C - 32
  Else If C = $3C2 Then ToUpperW := $3A3
  Else If (C >= $3AC) And (C <= $3AF) Then Begin
    Case C Of $3AC : ToUpperW := $386; $3AD : ToUpperW := $388; $3AE : ToUpperW
      := $389; $3AF : ToUpperW := $38A; End;
  End
  Else If (C >= $430) And (C <= $44F) Then ToUpperW := C - 32
  Else If (C >= $450) And (C <= $45F) Then ToUpperW := C - 80;
End;

Function ToLowerW(C : LongInt) : LongInt;
Begin
  ToLowerW := C;
  If (C >= 65) And (C <= 90) Then ToLowerW := C + 32
  Else If C < 128 Then Exit
  Else If (C >= $C0) And (C <= $DE) And (C <> $D7) Then ToLowerW := C + 32
  Else If C = $178 Then ToLowerW := $FF
  Else If (C >= $100) And (C <= $17F) Then Begin
    If ((C >= $100) And (C <= $137)) Or ((C >= $14A) And (C <= $177)) Then Begin
      If Not Odd(C) Then ToLowerW := C + 1;
    End
    Else If ((C >= $139) And (C <= $148)) Or ((C >= $179) And (C <= $17E)) Then
      Begin
      If Odd(C) Then ToLowerW := C + 1;
    End;
  End
  Else If (C >= $391) And (C <= $3A9) And (C <> $3A2) Then ToLowerW := C + 32
  Else If (C >= $410) And (C <= $42F) Then ToLowerW := C + 32
  Else If (C >= $400) And (C <= $40F) Then ToLowerW := C + 80;
End;

Function IsLetterW(C : LongInt) : Boolean;
Begin
  If C < 128 Then IsLetterW := ((C >= 65) And (C <= 90)) Or ((C >= 97) And (C <=
    122))
  Else IsLetterW := ((C >= $C0) And (C <> $D7) And (C <> $F7) And (C <= $24F))
    Or (C = $AA) Or (C = $B5) Or (C = $BA)
    Or ((C >= $370) And (C <= $3FF) And (C <> $37E) And (C <> $387)) Or ((C >=
      $400) And (C <= $481)) Or ((C >= $48A) And (C <= $52F))
    Or ((C >= $5D0) And (C <= $5EA)) Or ((C >= $620) And (C <= $64A)) Or ((C >=
      $3040) And (C <= $30FF))
    Or ((C >= $4E00) And (C <= $9FFF)) Or ((C >= $AC00) And (C <= $D7A3)) Or ((C
      >= $1E00) And (C <= $1FFF));
End;

Function IsDigitW(C : LongInt) : Boolean;
Begin
  IsDigitW := ((C >= 48) And (C <= 57)) Or ((C >= $660) And (C <= $669)) Or ((C
    >= $FF10) And (C <= $FF19));
End;

Function IsSpaceW(C : LongInt) : Boolean;
Begin
  IsSpaceW := ((C >= 9) And (C <= 13)) Or ((C >= $1C) And (C <= $20)) Or (C =
    $1680) Or ((C >= $2000) And (C <= $2006))
    Or ((C >= $2008) And (C <= $200A)) Or (C = $2028) Or (C = $2029) Or (C =
      $205F) Or (C = $3000);
End;

{ ----- Object ------------------------------------------------------------- }

Procedure NObj_getClass(A : PSlot);
Begin
  NRet := MirrorOf(Heap[AP(A)^[0]].Cls);
End;

Var HashSeed : LongInt;

Function IdentityHash(H : LongInt) : LongInt;
Var X : LongInt;
Begin
  If Not Heap[H].HasHash Then Begin
    HashSeed := LongInt((Int64(HashSeed) * 1103515245 + 12345) And $7FFFFFFF);
    X := (HashSeed Shr 3) And $7FFFFFF;
    If X = 0 Then X := 1;
    Heap[H].IdHash := X;
    Heap[H].HasHash := True;
  End;
  IdentityHash := Heap[H].IdHash;
End;

Procedure NObj_hashCode(A : PSlot);
Begin
  NRet := IdentityHash(AP(A)^[0]);
End;

Procedure NObj_clone(A : PSlot);
Var H, R : LongInt;
Begin
  H := AP(A)^[0];
  If Heap[H].Kind = KIND_ARR Then Begin
    R := NewArray(Heap[H].Cls, Heap[H].Len);
    If Heap[H].Len > 0 Then Move(Heap[H].F[0], Heap[R].F[0], Heap[H].Len *
      SizeOf(Int64));
    NRet := R;
  End
  Else Begin
    If Not IsSubclass(Heap[H].Cls, C_CLONEABLE) Then Begin
      ThrowNew('java/lang/CloneNotSupportedException', JavaName(Heap[H].Cls));
      Exit;
    End;
    R := NewObject(Heap[H].Cls);
    If Length(Heap[H].F) > 0 Then Move(Heap[H].F[0], Heap[R].F[0],
      Length(Heap[H].F) * SizeOf(Int64));
    Heap[R].S := Heap[H].S;
    NRet := R;
  End;
End;

Procedure NObj_nop(A : PSlot);
Begin
  NRet := 0;
End;

{ ----- Class -------------------------------------------------------------- }

Function ClsOfMirror(H : LongInt) : LongInt;
Begin
  ClsOfMirror := Heap[H].Aux;
End;

Function ExternalName(C : LongInt) : AnsiString;
Begin
  If Classes[C].IsArray Then ExternalName := ReplaceCh(Classes[C].Name, '/',
    '.')
  Else ExternalName := ReplaceCh(Classes[C].Name, '/', '.');
End;

Procedure NClass_getName(A : PSlot);
Begin
  NRet := JStr(ExternalName(ClsOfMirror(AP(A)^[0])));
End;

Procedure NClass_getSimpleName(A : PSlot);
Var C : LongInt; N : AnsiString;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If Classes[C].IsArray Then Begin
    N := Classes[C].ElemDesc;
    If N[1] = 'L' Then N := Copy(N, 2, Length(N) - 2);
    Case N[1] Of
      'I' : N := 'int'; 'J' : N := 'long'; 'Z' : N := 'boolean'; 'B' : N :=
        'byte'; 'C' : N := 'char';
      'S' : N := 'short'; 'F' : N := 'float'; 'D' : N := 'double';
    Else Begin
      N := ReplaceCh(N, '/', '.');
      While Pos('.', N) > 0 Do Delete(N, 1, Pos('.', N));
    End;
    End;
    NRet := JStr(N + '[]');
  End
  Else Begin
    N := SimpleName(C);
    NRet := JStr(N);
  End;
End;

Procedure NClass_isInstance(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then NRet := 0 Else NRet := BoolRet(IsSubclass(Heap[O].Cls,
    ClsOfMirror(AP(A)^[0])));
End;

Procedure NClass_isAssignableFrom(A : PSlot);
Begin
  NRet := BoolRet(IsSubclass(ClsOfMirror(AP(A)^[1]), ClsOfMirror(AP(A)^[0])));
End;

Procedure NClass_isInterface(A : PSlot);
Begin
  NRet := BoolRet((Classes[ClsOfMirror(AP(A)^[0])].Flags And ACC_INTERFACE) <>
    0);
End;

Procedure NClass_isArray(A : PSlot);
Begin
  NRet := BoolRet(Classes[ClsOfMirror(AP(A)^[0])].IsArray);
End;

Procedure NClass_isPrimitive(A : PSlot);
Var N : AnsiString;
Begin
  N := Classes[ClsOfMirror(AP(A)^[0])].Name;
  NRet := BoolRet((N = 'int') Or (N = 'long') Or (N = 'double') Or (N = 'float')
    Or (N = 'boolean') Or (N = 'char') Or (N = 'short') Or (N = 'byte') Or (N =
    'void'));
End;

Procedure NClass_getSuperclass(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If (Classes[C].Super < 0) Or ((Classes[C].Flags And ACC_INTERFACE) <> 0) Then
    NRet := 0 Else NRet := MirrorOf(Classes[C].Super);
End;

Procedure NClass_getModifiers(A : PSlot);
Begin
  NRet := Classes[ClsOfMirror(AP(A)^[0])].Flags And $FFFF;
End;

Function PrimClassIdx(Const N : AnsiString) : LongInt; Forward;

Procedure NClass_getComponentType(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  If Not Classes[C].IsArray Then NRet := 0
  Else If Classes[C].ElemCls >= 0 Then NRet := MirrorOf(Classes[C].ElemCls)
  Else Begin
    Case Classes[C].ElemDesc[1] Of
      'I' : NRet := MirrorOf(PrimClassIdx('int'));
      'J' : NRet := MirrorOf(PrimClassIdx('long'));
      'D' : NRet := MirrorOf(PrimClassIdx('double'));
      'F' : NRet := MirrorOf(PrimClassIdx('float'));
      'Z' : NRet := MirrorOf(PrimClassIdx('boolean'));
      'C' : NRet := MirrorOf(PrimClassIdx('char'));
      'S' : NRet := MirrorOf(PrimClassIdx('short'));
      'B' : NRet := MirrorOf(PrimClassIdx('byte'));
    Else NRet := 0;
    End;
  End;
End;

Function PrimClassIdx(Const N : AnsiString) : LongInt;
Var C : LongInt;
Begin
  C := MapFind(ClassMap, N);
  If C < 0 Then Begin
    C := NewClassRec(N);
    Classes[C].Flags := ACC_PUBLIC Or ACC_FINAL Or ACC_ABSTRACT;
    Classes[C].InitState := 2;
    Classes[C].Super := -1;
  End;
  PrimClassIdx := C;
End;

Procedure NClass_getPrimitiveClass(A : PSlot);
Begin
  NRet := MirrorOf(PrimClassIdx(SOfA(AP(A)^[0])));
End;

Procedure NClass_forName(A : PSlot);
Var N : AnsiString; C : LongInt;
Begin
  N := ReplaceCh(SOfA(AP(A)^[0]), '.', '/');
  C := LoadClass(N);
  If C < 0 Then Begin ThrowNew('java/lang/ClassNotFoundException',
    SOfA(AP(A)^[0])); Exit; End;
  EnsureInit(C);
  NRet := MirrorOf(C);
End;

Procedure NClass_desiredAssertionStatus(A : PSlot);
Begin
  NRet := 0;
End;

Procedure NClass_isEnumFlag(A : PSlot);
Begin
  NRet := BoolRet((Classes[ClsOfMirror(AP(A)^[0])].Flags And $4000) <> 0);
End;

Procedure NClass_isSynthetic(A : PSlot);
Begin
  NRet := BoolRet((Classes[ClsOfMirror(AP(A)^[0])].Flags And $1000) <> 0);
End;

Procedure NClass_isRecord(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  NRet := BoolRet((Classes[C].Super >= 0) And (Classes[Classes[C].Super].Name =
    'java/lang/Record'));
End;

Procedure NClass_getInterfaces(A : PSlot);
Var C, I, R : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  R := NewArray(ArrayClassIdx('[Ljava/lang/Class;'), Length(Classes[C].Ifaces));
  For I := 0 To High(Classes[C].Ifaces) Do Heap[R].F[I] :=
    MirrorOf(Classes[C].Ifaces[I]);
  NRet := R;
End;

Procedure NClass_permitted(A : PSlot);
Var C, I, R : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  R := NewArray(ArrayClassIdx('[Ljava/lang/Class;'),
    Length(Classes[C].Permitted));
  For I := 0 To High(Classes[C].Permitted) Do Heap[R].F[I] :=
    MirrorOf(LoadClass(Classes[C].Permitted[I]));
  NRet := R;
End;

Procedure NClass_isAnonymous(A : PSlot);
Var C : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  NRet := BoolRet(Classes[C].IsInnerInfo And (Classes[C].InnerName = ''));
End;

Procedure NClass_getPackageName(A : PSlot);
Var N : AnsiString; P : LongInt;
Begin
  N := Classes[ClsOfMirror(AP(A)^[0])].Name;
  P := Length(N);
  While (P > 0) And (N[P] <> '/') Do Dec(P);
  NRet := JStr(ReplaceCh(Copy(N, 1, P - 1), '/', '.'));
End;

Procedure NClass_getEnumConstants(A : PSlot);
Var C, F, Own, R, I : LongInt; V : Int64; S : Int64;
  Mi : LongInt;
Begin
  C := ClsOfMirror(AP(A)^[0]);
  EnsureInit(C);
  Mi := FindMethodDecl(C, 'values', '()[L' + Classes[C].Name + ';');
  If Mi < 0 Then Begin NRet := 0; Exit; End;
  NRet := CallPacked(C * 65536 + Mi, []);
End;

{ ----- String -------------------------------------------------------------- }

Function SArgs(V : Int64) : UnicodeString;
Begin
  If V = 0 Then Begin ThrowNPE(''); SArgs := ''; End
  Else SArgs := Heap[V].S;
End;

Procedure NStr_init0(A : PSlot);
Begin
  Heap[AP(A)^[0]].S := '';
End;

Procedure NStr_initS(A : PSlot);
Begin
  Heap[AP(A)^[0]].S := SArgs(AP(A)^[1]);
End;

Function CharsToWide(Arr : LongInt; Off, Cnt : LongInt) : UnicodeString;
Var R : UnicodeString; I : LongInt;
Begin
  SetLength(R, Cnt);
  For I := 0 To Cnt - 1 Do R[I + 1] := WideChar(Heap[Arr].F[Off + I] And $FFFF);
  CharsToWide := R;
End;

Procedure NStr_initC(A : PSlot);
Var Arr : LongInt;
Begin
  Arr := AP(A)^[1];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  Heap[AP(A)^[0]].S := CharsToWide(Arr, 0, Heap[Arr].Len);
End;

Procedure NStr_initCII(A : PSlot);
Var Arr, Off, Cnt : LongInt;
Begin
  Arr := AP(A)^[1]; Off := AP(A)^[2]; Cnt := AP(A)^[3];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  If (Off < 0) Or (Cnt < 0) Or (Off + Cnt > Heap[Arr].Len) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'offset ' + IStr(Off)
      + ', count ' + IStr(Cnt) + ', length ' + IStr(Heap[Arr].Len));
    Exit;
  End;
  Heap[AP(A)^[0]].S := CharsToWide(Arr, Off, Cnt);
End;

Function BytesToWide(Arr : LongInt; Off, Cnt : LongInt; Latin : Boolean) :
  UnicodeString;
Var B : AnsiString; I : LongInt; R : UnicodeString;
Begin
  SetLength(B, Cnt);
  For I := 0 To Cnt - 1 Do B[I + 1] := Chr(Heap[Arr].F[Off + I] And $FF);
  If Latin Then Begin
    SetLength(R, Cnt);
    For I := 1 To Cnt Do R[I] := WideChar(Ord(B[I]));
    BytesToWide := R;
  End
  Else BytesToWide := Utf8ToWide(B);
End;

Procedure NStr_initB(A : PSlot);
Var Arr : LongInt;
Begin
  Arr := AP(A)^[1];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  Heap[AP(A)^[0]].S := BytesToWide(Arr, 0, Heap[Arr].Len, False);
End;

{ String(byte[], int, int, boolean latin1) }
Procedure NStr_initBX(A : PSlot);
Var Arr : LongInt;
Begin
  Arr := AP(A)^[1];
  If Arr = 0 Then Begin ThrowNPE(''); Exit; End;
  Heap[AP(A)^[0]].S := BytesToWide(Arr, AP(A)^[2], AP(A)^[3], AP(A)^[4] <> 0);
End;

Procedure NStr_length(A : PSlot);
Begin
  NRet := Length(Heap[AP(A)^[0]].S);
End;

Procedure NStr_isEmpty(A : PSlot);
Begin
  NRet := BoolRet(Length(Heap[AP(A)^[0]].S) = 0);
End;

Procedure NStr_charAt(A : PSlot);
Var I : LongInt; H : LongInt;
Begin
  H := AP(A)^[0]; I := AP(A)^[1];
  If (I < 0) Or (I >= Length(Heap[H].S)) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Index ' + IStr(I) +
      ' out of bounds for length ' + IStr(Length(Heap[H].S)));
    Exit;
  End;
  NRet := Ord(Heap[H].S[I + 1]);
End;

Procedure NStr_hashCode(A : PSlot);
Var H, I : LongInt; HV : Int64;
Begin
  H := AP(A)^[0];
  If Not Heap[H].HasHash Then Begin
    HV := 0;
    For I := 1 To Length(Heap[H].S) Do HV := LongInt(HV * 31 +
      Ord(Heap[H].S[I]));
    Heap[H].SHash := HV;
    Heap[H].HasHash := True;
  End;
  NRet := Heap[H].SHash;
End;

Procedure NStr_equals(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then NRet := 0
  Else If O = AP(A)^[0] Then NRet := 1
  Else NRet := BoolRet((Heap[O].Kind = KIND_STR) And (Heap[O].S =
    Heap[AP(A)^[0]].S));
End;

Function CmpW(Const X, Y : UnicodeString) : LongInt;
Var I, N : LongInt;
Begin
  N := Length(X);
  If Length(Y) < N Then N := Length(Y);
  For I := 1 To N Do
    If X[I] <> Y[I] Then Begin CmpW := Ord(X[I]) - Ord(Y[I]); Exit; End;
  CmpW := Length(X) - Length(Y);
End;

Function FoldW(Const X : UnicodeString) : UnicodeString;
Var I : LongInt; R : UnicodeString;
Begin
  R := X;
  For I := 1 To Length(R) Do R[I] := WideChar(ToLowerW(ToUpperW(Ord(R[I]))));
  FoldW := R;
End;

Procedure NStr_compareTo(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := CmpW(Heap[AP(A)^[0]].S, Heap[O].S);
End;

Procedure NStr_compareToIgnoreCase(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then Begin ThrowNPE(''); Exit; End;
  NRet := CmpW(FoldW(Heap[AP(A)^[0]].S), FoldW(Heap[O].S));
End;

Procedure NStr_equalsIgnoreCase(A : PSlot);
Var O : LongInt;
Begin
  O := AP(A)^[1];
  If O = 0 Then NRet := 0
  Else NRet := BoolRet((Length(Heap[O].S) = Length(Heap[AP(A)^[0]].S)) And
    (FoldW(Heap[AP(A)^[0]].S) = FoldW(Heap[O].S)));
End;

Procedure NStr_substring1(A : PSlot);
Var H, B : LongInt;
Begin
  H := AP(A)^[0]; B := AP(A)^[1];
  If (B < 0) Or (B > Length(Heap[H].S)) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Range [' + IStr(B) +
      ', ' + IStr(Length(Heap[H].S)) + ') out of bounds for length ' +
      IStr(Length(Heap[H].S)));
    Exit;
  End;
  If B = 0 Then NRet := H Else NRet := NewStr(Copy(Heap[H].S, B + 1,
    Length(Heap[H].S)));
End;

Procedure NStr_substring2(A : PSlot);
Var H, B, E : LongInt;
Begin
  H := AP(A)^[0]; B := AP(A)^[1]; E := AP(A)^[2];
  If (B < 0) Or (E > Length(Heap[H].S)) Or (B > E) Then Begin
    ThrowNew('java/lang/StringIndexOutOfBoundsException', 'Range [' + IStr(B) +
      ', ' + IStr(E) + ') out of bounds for length ' + IStr(Length(Heap[H].S)));
    Exit;
  End;
  If (B = 0) And (E = Length(Heap[H].S)) Then NRet := H Else NRet :=
    NewStr(Copy(Heap[H].S, B + 1, E - B));
End;

Function IndexOfW(Const S, Sub : UnicodeString; From : LongInt) : LongInt;
Var I, J, N, M : LongInt; Ok : Boolean;
Begin
  N := Length(S); M := Length(Sub);
  If From < 0 Then From := 0;
  IndexOfW := -1;
  If M = 0 Then Begin If From <= N Then IndexOfW := From Else IndexOfW := N;
    Exit; End;
  I := From;
  While I + M <= N Do Begin
    If S[I + 1] = Sub[1] Then Begin
      Ok := True;
      For J := 2 To M Do If S[I + J] <> Sub[J] Then Begin Ok := False; Break;
        End;
      If Ok Then Begin IndexOfW := I; Exit; End;
    End;
    Inc(I);
  End;
End;

Function LastIndexOfW(Const S, Sub : UnicodeString; From : LongInt) : LongInt;
Var I, J, N, M : LongInt; Ok : Boolean;
Begin
  N := Length(S); M := Length(Sub);
  LastIndexOfW := -1;
  If From > N - M Then From := N - M;
  I := From;
  While I >= 0 Do Begin
    Ok := True;
    For J := 1 To M Do If S[I + J] <> Sub[J] Then Begin Ok := False; Break; End;
    If Ok Then Begin LastIndexOfW := I; Exit; End;
    Dec(I);
  End;
End;

Procedure NStr_indexOfCh(A : PSlot);
Var S : UnicodeString; I, C, From : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; C := AP(A)^[1]; From := AP(A)^[2];
  NRet := -1;
  If From < 0 Then From := 0;
  For I := From + 1 To Length(S) Do If Ord(S[I]) = C Then Begin NRet := I - 1;
    Exit; End;
End;

Procedure NStr_lastIndexOfCh(A : PSlot);
Var S : UnicodeString; I, C, From : LongInt;
Begin
  S := Heap[AP(A)^[0]].S; C := AP(A)^[1]; From := AP(A)^[2];
  NRet := -1;
  If From >= Length(S) Then From := Length(S) - 1;
  For I := From + 1 DownTo 1 Do If Ord(S[I]) = C Then Begin NRet := I - 1; Exit;
    End;
End;

