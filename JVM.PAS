Var
  GfxOn : Boolean;
  GfxUsed : Boolean;
  GfxW, GfxH : LongInt;
  GfxVga : Boolean;           { mode 16 couleurs (VGAHi) plutot que 256 couleurs }
  PalRGB : Array[0..255] Of LongInt;
  PalUsed, PalMax : LongInt;
  ClipX, ClipY : LongInt;
  MPrevX, MPrevY, MPrevB : LongInt;
  LastRgb, LastIdx : LongInt;

Const
  VgaRGB : Array[0..15] Of LongInt = ($000000, $0000AA, $00AA00, $00AAAA, $AA0000, $AA00AA, $AA5500, $AAAAAA,
                                      $555555, $5555FF, $55FF55, $55FFFF, $FF5555, $FF55FF, $FFFF55, $FFFFFF);

Function GfxOpen(W, H : LongInt) : Boolean;
Var Driver, Mode, Err : SmallInt; I : LongInt;
Begin
  GfxOpen := False;
  If GfxOn Then Begin GfxOpen := True; Exit; End;
  If OptText Then Exit;
  GfxUsed := True;
  {$IFDEF FPC}
  If Not GfxVga Then Begin
    Driver := VESA;
    If (W <= 640) And (H <= 480) Then Begin Mode := m640x480x256; GfxW := 640; GfxH := 480; End
    Else Begin Mode := m800x600x256; GfxW := 800; GfxH := 600; End;
    InitGraph(Driver, Mode, '');
    Err := GraphResult;
    If Err <> grOk Then GfxVga := True
    Else PalMax := 256;
  End;
  {$ELSE}
  GfxVga := True;
  {$ENDIF}
  If GfxVga Then Begin
    InitializeGraphics;
    GfxW := GetMaxX + 1; GfxH := GetMaxY + 1;
    PalMax := 16;
    For I := 0 To 15 Do PalRGB[I] := VgaRGB[I];
    PalUsed := 16;
  End
  Else Begin
    PalUsed := 0;
    {$IFDEF FPC}
    { entrees 0 et 1 : noir et blanc }
    SetRGBPalette(0, 0, 0, 0); PalRGB[0] := 0;
    SetRGBPalette(1, 255, 255, 255); PalRGB[1] := $FFFFFF;
    PalUsed := 2;
    {$ENDIF}
  End;
  LastRgb := -1; LastIdx := 0;
  ClipX := 0; ClipY := 0;
  MPrevX := -1; MPrevY := -1; MPrevB := 0;
  GfxOn := True;
  GfxOpen := True;
End;

Procedure GfxClose;
Begin
  If GfxOn Then Begin CloseGraph; GfxOn := False; End;
End;

Function ColorDist(A, B : LongInt) : LongInt;
Var DR, DG, DB : LongInt;
Begin
  DR := ((A Shr 16) And 255) - ((B Shr 16) And 255);
  DG := ((A Shr 8) And 255) - ((B Shr 8) And 255);
  DB := (A And 255) - (B And 255);
  ColorDist := DR * DR * 3 + DG * DG * 4 + DB * DB * 2;
End;

{ index de palette pour une couleur 0xRRGGBB (alloue une entree si possible) }
Function PalIndex(Rgb : LongInt) : LongInt;
Var I, Best, BD, D : LongInt;
Begin
  Rgb := Rgb And $FFFFFF;
  If Rgb = LastRgb Then Begin PalIndex := LastIdx; Exit; End;
  Best := 0; BD := MaxLongInt;
  For I := 0 To PalUsed - 1 Do Begin
    D := ColorDist(Rgb, PalRGB[I]);
    If D < BD Then Begin BD := D; Best := I; End;
    If D = 0 Then Break;
  End;
  If (BD <> 0) And (PalUsed < PalMax) And (PalMax > 16) Then Begin
    {$IFDEF FPC}
    SetRGBPalette(PalUsed, (Rgb Shr 16) And 255, (Rgb Shr 8) And 255, Rgb And 255);
    {$ENDIF}
    PalRGB[PalUsed] := Rgb;
    Best := PalUsed;
    Inc(PalUsed);
  End;
  LastRgb := Rgb; LastIdx := Best;
  PalIndex := Best;
End;

Procedure NGfx_open(A : PSlot);
Begin
  NRet := BoolRet(GfxOpen(AP(A)^[0], AP(A)^[1]));
End;

Procedure NGfx_close(A : PSlot);
Begin
  GfxClose;
End;

Procedure NGfx_width(A : PSlot);
Begin
  NRet := GfxW;
End;

Procedure NGfx_height(A : PSlot);
Begin
  NRet := GfxH;
End;

Procedure NGfx_setClip(A : PSlot);
Var X1, Y1, X2, Y2 : LongInt;
Begin
  If Not GfxOn Then Exit;
  X1 := AP(A)^[0]; Y1 := AP(A)^[1]; X2 := AP(A)^[2]; Y2 := AP(A)^[3];
  If X1 < 0 Then X1 := 0;
  If Y1 < 0 Then Y1 := 0;
  If X2 >= GfxW Then X2 := GfxW - 1;
  If Y2 >= GfxH Then Y2 := GfxH - 1;
  If (X2 < X1) Or (Y2 < Y1) Then Begin X2 := X1; Y2 := Y1; X1 := GfxW; Y1 := GfxH; X2 := GfxW; Y2 := GfxH; End;
  SetViewPort(X1, Y1, X2, Y2, True);
  ClipX := X1; ClipY := Y1;
End;

Procedure NGfx_fillRect(A : PSlot);
Var X, Y, W, H : LongInt;
Begin
  If Not GfxOn Then Exit;
  X := AP(A)^[0] - ClipX; Y := AP(A)^[1] - ClipY; W := AP(A)^[2]; H := AP(A)^[3];
  If (W <= 0) Or (H <= 0) Then Exit;
  SetFillStyle(SolidFill, PalIndex(AP(A)^[4]));
  Bar(X, Y, X + W - 1, Y + H - 1);
End;

Procedure NGfx_drawLine(A : PSlot);
Begin
  If Not GfxOn Then Exit;
  SetColor(PalIndex(AP(A)^[4]));
  Line(AP(A)^[0] - ClipX, AP(A)^[1] - ClipY, AP(A)^[2] - ClipX, AP(A)^[3] - ClipY);
End;

Procedure NGfx_drawRect(A : PSlot);
Var X, Y, W, H : LongInt;
Begin
  If Not GfxOn Then Exit;
  X := AP(A)^[0] - ClipX; Y := AP(A)^[1] - ClipY; W := AP(A)^[2]; H := AP(A)^[3];
  If (W < 0) Or (H < 0) Then Exit;
  SetColor(PalIndex(AP(A)^[4]));
  Rectangle(X, Y, X + W, Y + H);
End;

Procedure NGfx_fillOval(A : PSlot);
Var X, Y, W, H : LongInt; C : LongInt;
Begin
  If Not GfxOn Then Exit;
  X := AP(A)^[0] - ClipX; Y := AP(A)^[1] - ClipY; W := AP(A)^[2]; H := AP(A)^[3];
  If (W <= 0) Or (H <= 0) Then Exit;
  C := PalIndex(AP(A)^[4]);
  SetColor(C);
  SetFillStyle(SolidFill, C);
  FillEllipse(X + W Div 2, Y + H Div 2, W Div 2, H Div 2);
End;

Procedure NGfx_drawOval(A : PSlot);
Var X, Y, W, H : LongInt;
Begin
  If Not GfxOn Then Exit;
  X := AP(A)^[0] - ClipX; Y := AP(A)^[1] - ClipY; W := AP(A)^[2]; H := AP(A)^[3];
  If (W <= 0) Or (H <= 0) Then Exit;
  SetColor(PalIndex(AP(A)^[4]));
  Ellipse(X + W Div 2, Y + H Div 2, 0, 360, W Div 2, H Div 2);
End;

{ drawArc(x, y, w, h, start, extent, rgb, fill) }
Procedure NGfx_arc(A : PSlot);
Var X, Y, W, H, S, E, C : LongInt;
Begin
  If Not GfxOn Then Exit;
  X := AP(A)^[0] - ClipX; Y := AP(A)^[1] - ClipY; W := AP(A)^[2]; H := AP(A)^[3];
  S := AP(A)^[4]; E := S + AP(A)^[5];
  If E < S Then Begin C := S; S := E; E := C; End;
  If (W <= 0) Or (H <= 0) Then Exit;
  C := PalIndex(AP(A)^[6]);
  SetColor(C);
  While S < 0 Do Begin Inc(S, 360); Inc(E, 360); End;
  If E - S >= 360 Then Begin S := 0; E := 360; End
  Else Begin S := S Mod 360; E := S + (E - S); If E > 360 Then E := E - 360; End;
  If AP(A)^[7] <> 0 Then Begin
    SetFillStyle(SolidFill, C);
    If S = E Then FillEllipse(X + W Div 2, Y + H Div 2, W Div 2, H Div 2)
    Else Sector(X + W Div 2, Y + H Div 2, S, E, W Div 2, H Div 2);
  End
  Else Ellipse(X + W Div 2, Y + H Div 2, S, E, W Div 2, H Div 2);
End;

{ fillPoly(xs, ys, n, rgb, fill) }
Procedure NGfx_poly(A : PSlot);
Var Xs, Ys, N, I : LongInt; Pts : Array[0..255] Of PointType; C : LongInt;
Begin
  If Not GfxOn Then Exit;
  Xs := AP(A)^[0]; Ys := AP(A)^[1]; N := AP(A)^[2];
  If (Xs = 0) Or (Ys = 0) Or (N < 2) Then Exit;
  If N > 255 Then N := 255;
  For I := 0 To N - 1 Do Begin
    Pts[I].X := Heap[Xs].F[I] - ClipX;
    Pts[I].Y := Heap[Ys].F[I] - ClipY;
  End;
  C := PalIndex(AP(A)^[3]);
  SetColor(C);
  If AP(A)^[4] <> 0 Then Begin
    SetFillStyle(SolidFill, C);
    FillPoly(N, Pts);
  End
  Else Begin
    Pts[N] := Pts[0];
    DrawPoly(N + 1, Pts);
  End;
End;

{ conversion Unicode -> jeu de caracteres de la police 8x8 }
Function ToFontText(Const W : UnicodeString) : AnsiString;
Var I, C, R : LongInt; S : AnsiString;
Begin
  SetLength(S, Length(W));
  For I := 1 To Length(W) Do Begin
    C := Ord(W[I]);
    If C < 128 Then R := C
    Else Case C Of
      $E9 : R := $82; $E8 : R := $8A; $EA : R := $88; $EB : R := $89; $E0 : R := $85; $E2 : R := $83;
      $E4 : R := $84; $E7 : R := $87; $F9 : R := $97; $FB : R := $96; $FC : R := $81; $F4 : R := $93;
      $F6 : R := $94; $EE : R := $8C; $EF : R := $8B; $C9 : R := $90; $F1 : R := $A4; $D1 : R := $A5;
      $F7 : R := $F6; $B0 : R := $F8; $B1 : R := $F1; $B5 : R := $E6; $D7 : R := Ord('x');
      $C7 : R := $80; $C4 : R := $8E; $D6 : R := $99; $DC : R := $9A; $A3 : R := $9C; $A5 : R := $9D;
      $A1 : R := $AD; $BF : R := $A8; $AB : R := $AE; $BB : R := $AF; $A0 : R := 32; $2022 : R := 7;
    Else R := Ord('?');
    End;
    S[I] := Chr(R);
  End;
  ToFontText := S;
End;

{ drawText(x, y, texte, rgb, echelle) : (x, y) est le coin superieur gauche }
Procedure NGfx_drawText(A : PSlot);
Var S : AnsiString;
Begin
  If Not GfxOn Then Exit;
  If AP(A)^[2] = 0 Then Exit;
  S := ToFontText(Heap[AP(A)^[2]].S);
  SetColor(PalIndex(AP(A)^[3]));
  SetTextStyle(DefaultFont, HorizDir, AP(A)^[4]);
  OutTextXY(AP(A)^[0] - ClipX, AP(A)^[1] - ClipY, S);
End;

Procedure NGfx_textWidth(A : PSlot);
Begin
  If AP(A)^[0] = 0 Then NRet := 0
  Else NRet := Length(Heap[AP(A)^[0]].S) * 8 * AP(A)^[1];
End;

{ pollEvent(int[] ev) : 0 rien, 1 deplacement, 2 bouton enfonce, 3 bouton relache, 4 touche, 5 fermeture }
Procedure NGfx_poll(A : PSlot);
Var X, Y, B, Arr : LongInt; Ch : Char; Code : LongInt;
Begin
  NRet := 0;
  If Not GfxOn Then Exit;
  Arr := AP(A)^[0];
  If KeyPressed Then Begin
    Ch := ReadKey;
    If Ch = #0 Then Begin
      Code := Ord(ReadKey);
      Heap[Arr].F[0] := 4; Heap[Arr].F[3] := 256 + Code; Heap[Arr].F[4] := 0;
    End
    Else Begin
      Heap[Arr].F[0] := 4; Heap[Arr].F[3] := Ord(Ch); Heap[Arr].F[4] := Ord(Ch);
    End;
    NRet := 4;
    Exit;
  End;
  X := 0; Y := 0; B := 0;
  GetMouseState(X, Y, B);
  B := B And 7;
  If B <> MPrevB Then Begin
    Heap[Arr].F[1] := X; Heap[Arr].F[2] := Y;
    If (B And Not MPrevB) <> 0 Then Begin
      Heap[Arr].F[0] := 2; Heap[Arr].F[3] := B And Not MPrevB;
      NRet := 2;
    End
    Else Begin
      Heap[Arr].F[0] := 3; Heap[Arr].F[3] := MPrevB And Not B;
      NRet := 3;
    End;
    MPrevB := B;
    MPrevX := X; MPrevY := Y;
    Exit;
  End;
  If (X <> MPrevX) Or (Y <> MPrevY) Then Begin
    MPrevX := X; MPrevY := Y;
    Heap[Arr].F[0] := 1; Heap[Arr].F[1] := X; Heap[Arr].F[2] := Y; Heap[Arr].F[3] := B;
    NRet := 1;
  End;
End;

