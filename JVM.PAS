Procedure NVM_write(A : PSlot);
Var Fd : LongInt;
Begin
  Fd := AP(A)^[0];
  If AP(A)^[1] = 0 Then Begin ThrowNPE(''); Exit; End;
  If Fd = 2 Then Begin
    Flush(JOut);
    Write(StdErr, WideToUtf8(Heap[AP(A)^[1]].S));
    Flush(StdErr);
  End
  Else Write(JOut, WideToUtf8(Heap[AP(A)^[1]].S));
End;

Procedure NVM_writeByte(A : PSlot);
Begin
  If AP(A)^[0] = 2 Then Begin Flush(JOut); Write(StdErr, Chr(AP(A)^[1] And $FF)); Flush(StdErr); End
  Else Write(JOut, Chr(AP(A)^[1] And $FF));
End;

