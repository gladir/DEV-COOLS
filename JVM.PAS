  KIND_OBJ   = 0;       { objet ordinaire }
  KIND_ARR   = 1;       { tableau }
  KIND_STR   = 2;       { java.lang.String }
  KIND_LAMBDA = 3;      { objet cree par invokedynamic (lambda, reference de methode) }
