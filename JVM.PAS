Procedure NVM_readByte(A : PSlot);
Var C : Char;
Begin
  Flush(JOut);
  If Eof(JIn) Then NRet := -1
  Else Begin
    Read(JIn, C);
    NRet := Ord(C);
  End;
End;

Procedure NVM_sleep(A : PSlot);
