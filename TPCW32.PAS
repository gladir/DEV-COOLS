  { ------ _TPRT_WINDOW : definir zone de texte ------------------ }
  { Params : [ESP+4]=X1, [ESP+8]=Y1, [ESP+12]=X2, [ESP+16]=Y2    }
  { Stocke dans WINDMIN/WINDMAX                                     }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'WINDOW');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EAX');
  EmitInstr('PUSH EDX');
  { WINDMIN = (Y1-1)*256 + (X1-1) }
  EmitInstr('MOV EAX,DWORD PTR [EBP+12]');        { Y1 }
  EmitInstr('DEC EAX');
  EmitInstr('SHL EAX,8');
  EmitInstr('MOV EDX,DWORD PTR [EBP+8]');         { X1 }
  EmitInstr('DEC EDX');
  EmitInstr('OR EAX,EDX');
  EmitInstr('MOV DWORD PTR [WINDMIN],EAX');
  { WINDMAX = (Y2-1)*256 + (X2-1) }
  EmitInstr('MOV EAX,DWORD PTR [EBP+20]');        { Y2 }
  EmitInstr('DEC EAX');
  EmitInstr('SHL EAX,8');
  EmitInstr('MOV EDX,DWORD PTR [EBP+16]');        { X2 }
  EmitInstr('DEC EDX');
  EmitInstr('OR EAX,EDX');
  EmitInstr('MOV DWORD PTR [WINDMAX],EAX');
  EmitInstr('POP EDX');
  EmitInstr('POP EAX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_KEYPRESSED : touche disponible -> EAX ---------- }
  { Retourne 1 (True) si une touche est disponible, 0 sinon       }
  { Si fenetre graphique ouverte, pompe les messages + ring buffer  }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'KEYPRESSED');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  { Si mode graphique actif, utiliser la fenetre }
  EmitInstr('CMP DWORD PTR [GR_ACTIVE],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'KP_GR');
  { --- Chemin console (inchange) --- }
  { GetNumberOfConsoleInputEvents(hStdin, &count) }
  EmitInstr('PUSH OFFSET CRT_NEVT');
  EmitInstr('PUSH DWORD PTR [HSTDIN]');
  EmitInstr('CALL GetNumberOfConsoleInputEvents');
  EmitInstr('MOV EAX,DWORD PTR [CRT_NEVT]');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'KP_NO');
  { PeekConsoleInputA(hStdin, &rec, 1, &count) }
  EmitInstr('PUSH OFFSET CRT_NEVT');
  EmitInstr('PUSH 1');
  EmitInstr('PUSH OFFSET CRT_INREC');
  EmitInstr('PUSH DWORD PTR [HSTDIN]');
  EmitInstr('CALL PeekConsoleInputA');
  { Verifier si c est un evenement clavier (EventType == 1) }
  EmitInstr('MOVZX EAX,WORD PTR [CRT_INREC]');
  EmitInstr('CMP EAX,1');
  EmitInstr('JNE ' + TP_RT_PFX + 'KP_FL');
  { Verifier bKeyDown (offset 4 dans INPUT_RECORD) }
  EmitInstr('MOV EAX,DWORD PTR [CRT_INREC+4]');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'KP_FL');
  EmitInstr('MOV EAX,1');
  EmitInstr('JMP ' + TP_RT_PFX + 'KP_DN');
  EmitLabel(TP_RT_PFX + 'KP_FL');
  { Pas un key event ou key up - flush et retourner 0 }
  EmitInstr('PUSH OFFSET CRT_NEVT');
  EmitInstr('PUSH 1');
  EmitInstr('PUSH OFFSET CRT_INREC');
  EmitInstr('PUSH DWORD PTR [HSTDIN]');
  EmitInstr('CALL ReadConsoleInputA');
  EmitLabel(TP_RT_PFX + 'KP_NO');
  EmitInstr('XOR EAX,EAX');
  EmitLabel(TP_RT_PFX + 'KP_DN');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('RET');
  { --- Chemin fenetre graphique --- }
  EmitLabel(TP_RT_PFX + 'KP_GR');
  { Pomper tous les messages en attente (non bloquant) }
  EmitLabel(TP_RT_PFX + 'KP_GP');
  EmitInstr('PUSH 1');                   { PM_REMOVE }
  EmitInstr('PUSH 0');                   { wMsgFilterMax }
  EmitInstr('PUSH 0');                   { wMsgFilterMin }
  EmitInstr('PUSH 0');                   { hWnd=NULL (tous) }
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL PeekMessageA');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'KP_GC');
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL TranslateMessage');
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL DispatchMessageA');
  EmitInstr('JMP ' + TP_RT_PFX + 'KP_GP');
  EmitLabel(TP_RT_PFX + 'KP_GC');
  { Verifier si le ring buffer contient une touche }
  EmitInstr('MOV EAX,DWORD PTR [GR_KEYHEAD]');
  EmitInstr('CMP EAX,DWORD PTR [GR_KEYTAIL]');
  EmitInstr('JE ' + TP_RT_PFX + 'KP_G0');
  EmitInstr('MOV EAX,1');
  EmitInstr('JMP ' + TP_RT_PFX + 'KP_DN');
  EmitLabel(TP_RT_PFX + 'KP_G0');
  EmitInstr('XOR EAX,EAX');
  EmitInstr('JMP ' + TP_RT_PFX + 'KP_DN');

  { ------ _TPRT_READKEY : lire une touche -> EAX --------------- }
  { Retourne le code ASCII de la touche pressee                    }
  { Si fenetre graphique ouverte, lit depuis le ring buffer         }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'READKEY');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  { Si mode graphique actif, utiliser la fenetre }
  EmitInstr('CMP DWORD PTR [GR_ACTIVE],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'RK_GR');
  { --- Chemin console (inchange) --- }
  EmitLabel(TP_RT_PFX + 'RK_LP');
  { ReadConsoleInputA(hStdin, &rec, 1, &count) }
  EmitInstr('PUSH OFFSET CRT_NEVT');
  EmitInstr('PUSH 1');
  EmitInstr('PUSH OFFSET CRT_INREC');
  EmitInstr('PUSH DWORD PTR [HSTDIN]');
  EmitInstr('CALL ReadConsoleInputA');
  { Verifier EventType == KEY_EVENT (1) }
  EmitInstr('MOVZX EAX,WORD PTR [CRT_INREC]');
  EmitInstr('CMP EAX,1');
  EmitInstr('JNE ' + TP_RT_PFX + 'RK_LP');
  { Verifier bKeyDown }
  EmitInstr('MOV EAX,DWORD PTR [CRT_INREC+4]');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'RK_LP');
  { Retourner AsciiChar (offset 14 dans INPUT_RECORD) }
  EmitInstr('MOVZX EAX,BYTE PTR [CRT_INREC+14]');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('RET');
  { --- Chemin fenetre graphique --- }
  EmitLabel(TP_RT_PFX + 'RK_GR');
  { Boucle : verifier ring buffer, sinon pomper messages }
  EmitLabel(TP_RT_PFX + 'RK_GL');
  { Verifier si le ring buffer contient une touche }
  EmitInstr('MOV EAX,DWORD PTR [GR_KEYHEAD]');
  EmitInstr('CMP EAX,DWORD PTR [GR_KEYTAIL]');
  EmitInstr('JE ' + TP_RT_PFX + 'RK_GM');
  { Consommer le caractere du ring buffer }
  EmitInstr('MOVZX EAX,BYTE PTR [GR_KEYBUF+EAX*1]');
  EmitInstr('PUSH EAX');
  EmitInstr('MOV EAX,DWORD PTR [GR_KEYHEAD]');
  EmitInstr('INC EAX');
  EmitInstr('AND EAX,0FFh');
  EmitInstr('MOV DWORD PTR [GR_KEYHEAD],EAX');
  EmitInstr('POP EAX');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'RK_GM');
  { GetMessageA bloque jusqu'a reception d un message }
  EmitInstr('PUSH 0');                   { wMsgFilterMax }
  EmitInstr('PUSH 0');                   { wMsgFilterMin }
  EmitInstr('PUSH 0');                   { hWnd=NULL }
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL GetMessageA');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'RK_GQ');   { WM_QUIT -> retourner 0 }
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL TranslateMessage');
  EmitInstr('PUSH OFFSET GR_MSG');
  EmitInstr('CALL DispatchMessageA');
  EmitInstr('JMP ' + TP_RT_PFX + 'RK_GL');
  EmitLabel(TP_RT_PFX + 'RK_GQ');
  { WM_QUIT recu : retourner 0 }
  EmitInstr('XOR EAX,EAX');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('RET');

  { ------ _TPRT_SOUND : emettre un son (Hz) -------------------- }
  { Parametre sur pile : [ESP+4] = frequence en Hz                 }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'SOUND');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  { Beep(frequency, duration=200ms) }
  EmitInstr('PUSH 200');
  EmitInstr('PUSH DWORD PTR [EBP+8]');
  EmitInstr('CALL Beep');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_INSLINE : inserer une ligne vide a la position du curseur -- }
  { Deplace les lignes vers le bas depuis la position courante                 }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'INSLINE');
  EmitInstr('PUSHAD');
  { GetConsoleScreenBufferInfo(hStdout, &CRT_CSBI) }
  EmitInstr('PUSH OFFSET CRT_CSBI');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL GetConsoleScreenBufferInfo');
  EmitInstr('MOVZX EAX,WORD PTR [CRT_CSBI+6]');   { curY }
  EmitInstr('MOVZX ECX,WORD PTR [CRT_CSBI+0]');   { cols }
  EmitInstr('DEC ECX');
  EmitInstr('MOVZX EDX,WORD PTR [CRT_CSBI+2]');   { rows }
  EmitInstr('DEC EDX');
  { SMALL_RECT src: Left=0, Top=curY, Right=cols-1, Bottom=rows-1 }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],AX');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],CX');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],DX');
  { fill char: space(32) + attribute }
  EmitInstr('MOV ECX,DWORD PTR [TEXTATTR]');
  EmitInstr('AND ECX,0FFh');
  EmitInstr('SHL ECX,16');
  EmitInstr('OR ECX,32');
  EmitInstr('MOV DWORD PTR [CRT_FILL],ECX');
  { dest = (0, curY+1) packed as COORD: X=low word, Y=high word }
  EmitInstr('INC AX');
  EmitInstr('SHL EAX,16');
  EmitInstr('MOV EBX,EAX');
  { ScrollConsoleScreenBufferA(hOut, lpScroll, lpClip, dwDest, lpFill) }
  EmitInstr('PUSH OFFSET CRT_FILL');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL ScrollConsoleScreenBufferA');
  { Fill current line with spaces }
  EmitInstr('MOVZX EAX,WORD PTR [CRT_CSBI+6]');   { curY }
  EmitInstr('SHL EAX,16');
  EmitInstr('MOV EBX,EAX');
  EmitInstr('MOVZX ECX,WORD PTR [CRT_CSBI+0]');   { cols }
  EmitInstr('PUSH OFFSET CRT_NWRT');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH 32');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL FillConsoleOutputCharacterA');
  { Fill attribute on current line }
  EmitInstr('MOVZX EAX,WORD PTR [CRT_CSBI+6]');
  EmitInstr('SHL EAX,16');
  EmitInstr('MOV EBX,EAX');
  EmitInstr('MOVZX ECX,WORD PTR [CRT_CSBI+0]');
  EmitInstr('PUSH OFFSET CRT_NWRT');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH DWORD PTR [TEXTATTR]');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL FillConsoleOutputAttribute');
  EmitInstr('POPAD');
  EmitInstr('RET');

  { ------ _TPRT_DELLINE : supprimer la ligne a la position du curseur ------ }
  { Deplace les lignes vers le haut depuis la position courante+1             }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DELLINE');
  EmitInstr('PUSHAD');
  EmitInstr('PUSH OFFSET CRT_CSBI');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL GetConsoleScreenBufferInfo');
  EmitInstr('MOVZX EAX,WORD PTR [CRT_CSBI+6]');   { curY }
  EmitInstr('MOVZX ECX,WORD PTR [CRT_CSBI+0]');   { cols }
  EmitInstr('DEC ECX');
  EmitInstr('MOVZX EDX,WORD PTR [CRT_CSBI+2]');   { rows }
  EmitInstr('DEC EDX');
  { SMALL_RECT src: Left=0, Top=curY+1, Right=cols-1, Bottom=rows-1 }
  EmitInstr('MOV EBX,EAX');
  EmitInstr('INC EBX');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],BX');     { Top=curY+1 }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],CX');     { Right=cols-1 }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],DX');     { Bottom=rows-1 }
  { fill char }
  EmitInstr('MOV ECX,DWORD PTR [TEXTATTR]');
  EmitInstr('AND ECX,0FFh');
  EmitInstr('SHL ECX,16');
  EmitInstr('OR ECX,32');
  EmitInstr('MOV DWORD PTR [CRT_FILL],ECX');
  { dest = (0, curY) }
  EmitInstr('SHL EAX,16');
  EmitInstr('MOV EBX,EAX');
  EmitInstr('PUSH OFFSET CRT_FILL');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL ScrollConsoleScreenBufferA');
  EmitInstr('POPAD');
  EmitInstr('RET');

  { ------ _TPRT_TEXTMODE : changer le mode texte -------------------- }
  { Parametre : [ESP+4] = mode (CO80=3, BW80=2, etc.)                 }
  { Reset TEXTATTR, WINDMIN, WINDMAX, appelle ClrScr                  }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'TEXTMODE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EAX');
  { Sauver le mode courant dans LASTMODE }
  EmitInstr('MOV EAX,DWORD PTR [LASTMODE]');
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('AND EAX,0FFh');                       { ignorer Font8x8 bit }
  EmitInstr('MOV DWORD PTR [LASTMODE],EAX');
  { Reset TEXTATTR a $07 (LightGray sur Black) }
  EmitInstr('MOV DWORD PTR [TEXTATTR],7');
  { Reset WINDMIN/WINDMAX }
  EmitInstr('MOV DWORD PTR [WINDMIN],0');
  EmitInstr('MOV DWORD PTR [WINDMAX],184Fh');      { 24*256+79 }
  { Appliquer l attribut }
  EmitInstr('PUSH 7');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL SetConsoleTextAttribute');
  { Appeler ClrScr }
  EmitInstr('CALL ' + TP_RT_PFX + 'CLRSCR');
  EmitInstr('POP EAX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_SETTEXTROWS : changer nb de lignes console (Win32) --- }
  { Parametre : [ESP+4] = rows demandees (25, 43 ou 50)                 }
  { Retour    : EAX = rows si succes, 0 si valeur non supportee         }
  { Etape 1 : reduire la fenetre a 80x25 pour autoriser le resize du    }
  {           buffer sans conflit avec la fenetre courante.             }
  { Etape 2 : redimensionner le buffer console a 80 x rows.            }
  { Etape 3 : agrandir la fenetre au nombre de lignes demande.          }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'SETTEXTROWS');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');     { EBX = rows demandees }
  { Valider : accepter seulement 25, 43 ou 50 }
  EmitInstr('CMP EBX,25');
  EmitInstr('JE ' + TP_RT_PFX + 'SETR_OK');
  EmitInstr('CMP EBX,43');
  EmitInstr('JE ' + TP_RT_PFX + 'SETR_OK');
  EmitInstr('CMP EBX,50');
  EmitInstr('JNE ' + TP_RT_PFX + 'SETR_DN');  { valeur non supportee -> 0 }
  EmitLabel(TP_RT_PFX + 'SETR_OK');
  { Etape 1 : fenetre minimale 80x25 pour eviter conflit avec le resize }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');   { Left   = 0  }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],0');   { Top    = 0  }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],79');  { Right  = 79 }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],24');  { Bottom = 24 (25 lignes min) }
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH 1');                           { bAbsolute = TRUE }
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleWindowInfo@12');
  { Etape 2 : redimensionner le buffer a 80 x rows }
  { COORD : 80 (colonnes) dans les 16 bits bas, rows dans les 16 bits hauts }
  EmitInstr('MOV EAX,EBX');
  EmitInstr('SHL EAX,16');
  EmitInstr('OR EAX,80');                        { COORD X=80 Y=rows }
  EmitInstr('PUSH EAX');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleScreenBufferSize@8');
  { Etape 3 : agrandir la fenetre au nombre de lignes demande }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');   { Left   = 0        }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],0');   { Top    = 0        }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],79');  { Right  = 79       }
  EmitInstr('MOV EAX,EBX');
  EmitInstr('DEC EAX');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],AX');  { Bottom = rows - 1 }
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH 1');                           { bAbsolute = TRUE }
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleWindowInfo@12');
  EmitInstr('MOV EAX,EBX');                     { retourner rows }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'SETR_DN');
  EmitInstr('XOR EAX,EAX');                     { retourner 0 : valeur invalide }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_DISPLAYCURSOR : afficher/cacher le curseur (Win32) -- }
  { Parametre : [ESP+4] = toggle (0=cacher, autre=montrer)             }
  { Retour    : EAX = etat precedent (0=cache, -1=visible)             }
  { Utilise SetConsoleCursorInfo(HSTDOUT, &CRT_CURINFO)                }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DISPLAYCURSOR');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  { Lire l etat precedent depuis CRT_CURSVIS }
  EmitInstr('MOV EBX,DWORD PTR [CRT_CURSVIS]');  { EBX = etat precedent (1=visible) }
  { Calculer la valeur de retour : etat precedent -> -1 si visible, 0 si cache }
  EmitInstr('TEST EBX,EBX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DC_PREV0');
  EmitInstr('MOV EBX,-1');                       { etait visible -> -1 }
  EmitLabel(TP_RT_PFX + 'DC_PREV0');
  { EBX = valeur de retour ; maintenant appliquer le nouveau toggle }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');        { EAX = toggle demande }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DC_HIDE');
  { Montrer le curseur : CRT_CURSVIS=1, CRT_CURINFO.bVisible=1 }
  EmitInstr('MOV DWORD PTR [CRT_CURSVIS],1');
  EmitInstr('MOV DWORD PTR [CRT_CURINFO+4],1'); { bVisible = TRUE }
  EmitInstr('JMP ' + TP_RT_PFX + 'DC_CALL');
  EmitLabel(TP_RT_PFX + 'DC_HIDE');
  { Cacher le curseur : CRT_CURSVIS=0, CRT_CURINFO.bVisible=0 }
  EmitInstr('MOV DWORD PTR [CRT_CURSVIS],0');
  EmitInstr('MOV DWORD PTR [CRT_CURINFO+4],0'); { bVisible = FALSE }
  EmitLabel(TP_RT_PFX + 'DC_CALL');
  EmitInstr('PUSH OFFSET CRT_CURINFO');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleCursorInfo@8');
  EmitInstr('MOV EAX,EBX');                     { retourner l etat precedent }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_GETTEXTCURSOR : lire la forme du curseur texte (Win32) - }
  { Retour : EAX = forme curseur compatible DOS-16 bits :                  }
  {   octet haut = scanline debut (bit 5=1 si cache), octet bas = fin.     }
  { Synthese depuis CRT_CURSVIS et CRT_CURINFO via GetConsoleCursorInfo.   }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'GETTEXTCURSOR');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH OFFSET CRT_CURINFO');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _GetConsoleCursorInfo@8');     { met a jour CRT_CURINFO   }
  { CRT_CURINFO+0 = dwSize (1..100), CRT_CURINFO+4 = bVisible (0 ou 1)    }
  EmitInstr('MOV EAX,DWORD PTR [CRT_CURINFO+4]'); { EAX = bVisible          }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'GTC_HIDE');
  { Curseur visible : forme standard DOS CH=06h, CL=07h -> AX=0607h        }
  EmitInstr('MOV EAX,0607h');
  EmitInstr('JMP ' + TP_RT_PFX + 'GTC_DONE');
  EmitLabel(TP_RT_PFX + 'GTC_HIDE');
  { Curseur cache : CH=20h (bit 5 set), CL=00h -> AX=2000h                 }
  EmitInstr('MOV EAX,2000h');
  EmitLabel(TP_RT_PFX + 'GTC_DONE');
  EmitInstr('POP EBP');
  EmitInstr('RET');

