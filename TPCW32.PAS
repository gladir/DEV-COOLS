                EmitInstr('JSR ' + TP_RT_PFX + 'CONCAT');
              End
              Else
                Break;
            End;
            EmitInstr('LDD #STRBUF1');
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            ParseExpr(PI);
            EmitInstr('MOV ESI,EAX');
            If LastExprIsPascalStr Then
              EmitInstr('INC ESI');
            EmitInstr('LEA EDI,[STRBUF1]');
            EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN_PCHAR');
            While Not EPAtEnd Do
