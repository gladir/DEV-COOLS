{ ------------------------------------------------------------ }
{ TranslateReg16to32 : traduire un registre 8086 (16 bits)     }
{ vers son equivalent 80386 (32 bits).                          }
{ AX->EAX, BX->EBX, CX->ECX, DX->EDX                          }
{ SI->ESI, DI->EDI, BP->EBP, SP->ESP                           }
{ Registres 8 bits (AL,AH,BL,...) : inchanges                  }
{ Registres de segment (CS,DS,ES,SS) : retourne '' (ignores)   }
{ ------------------------------------------------------------ }

Function TranslateReg16to32(Const Reg : TString) : TString;
Var
  Up : TString;
Begin
  Up := StrUpperCase(Reg);
  { Registres 16 bits -> 32 bits }
  If Up = 'AX' Then TranslateReg16to32 := 'EAX'
  Else If Up = 'BX' Then TranslateReg16to32 := 'EBX'
  Else If Up = 'CX' Then TranslateReg16to32 := 'ECX'
  Else If Up = 'DX' Then TranslateReg16to32 := 'EDX'
  Else If Up = 'SI' Then TranslateReg16to32 := 'ESI'
  Else If Up = 'DI' Then TranslateReg16to32 := 'EDI'
  Else If Up = 'BP' Then TranslateReg16to32 := 'EBP'
  Else If Up = 'SP' Then TranslateReg16to32 := 'ESP'
  { Registres de segment : ignores en mode FLAT Win32 }
  Else If Up = 'CS' Then TranslateReg16to32 := ''
  Else If Up = 'DS' Then TranslateReg16to32 := ''
  Else If Up = 'ES' Then TranslateReg16to32 := ''
  Else If Up = 'SS' Then TranslateReg16to32 := ''
  { Registres 8 bits : inchanges }
  Else If (Up = 'AL') Or (Up = 'AH') Or (Up = 'BL') Or (Up = 'BH') Or
          (Up = 'CL') Or (Up = 'CH') Or (Up = 'DL') Or (Up = 'DH') Then
    TranslateReg16to32 := Up
  { Registres 32 bits deja : inchanges }
  Else If (Up = 'EAX') Or (Up = 'EBX') Or (Up = 'ECX') Or (Up = 'EDX') Or
          (Up = 'ESI') Or (Up = 'EDI') Or (Up = 'EBP') Or (Up = 'ESP') Then
    TranslateReg16to32 := Up
  Else
    TranslateReg16to32 := Reg;  { pas un registre, retourner tel quel }
End;

{ ------------------------------------------------------------ }
{ IsAsmReg : tester si un identificateur est un registre x86   }
{ ------------------------------------------------------------ }

Function IsAsmReg(Const S : TString) : Boolean;
Var
  Up : TString;
Begin
  Up := StrUpperCase(S);
  IsAsmReg :=
    (Up = 'AX') Or (Up = 'BX') Or (Up = 'CX') Or (Up = 'DX') Or
    (Up = 'SI') Or (Up = 'DI') Or (Up = 'BP') Or (Up = 'SP') Or
    (Up = 'AL') Or (Up = 'AH') Or (Up = 'BL') Or (Up = 'BH') Or
    (Up = 'CL') Or (Up = 'CH') Or (Up = 'DL') Or (Up = 'DH') Or
    (Up = 'EAX') Or (Up = 'EBX') Or (Up = 'ECX') Or (Up = 'EDX') Or
    (Up = 'ESI') Or (Up = 'EDI') Or (Up = 'EBP') Or (Up = 'ESP') Or
    (Up = 'CS') Or (Up = 'DS') Or (Up = 'ES') Or (Up = 'SS');
End;

{ ------------------------------------------------------------ }
{ TranslateAsmOperand : traduire un operande ASM 8086 vers     }
{ 80386. Gere les registres, les immediats, et les references   }
{ memoire avec adressage indirect [BX+SI+disp] etc.            }
{ ------------------------------------------------------------ }

Function TranslateAsmOperand(PI : Integer; Const Op : TString) : TString;
Var
  R     : TString;
  I     : Integer;
  C     : Char;
  Tok   : TString;
  Up    : TString;
Begin
  If Length(Op) = 0 Then
  Begin
    TranslateAsmOperand := '';
    Exit;
  End;

  { Si l operande est un simple registre }
  Up := StrUpperCase(Op);
  If IsAsmReg(Up) Then
  Begin
    TranslateAsmOperand := TranslateReg16to32(Op);
    Exit;
  End;

  { Si c est un reference memoire [xxx] }
  If (Op[1] = '[') And (Op[Length(Op)] = ']') Then
  Begin
    R := '[';
    I := 2;
    While I < Length(Op) Do
    Begin
      C := Op[I];
      { Extraire un token (ident ou autre) }
      If ((C >= 'A') And (C <= 'Z')) Or ((C >= 'a') And (C <= 'z')) Or
         (C = '_') Then
      Begin
        Tok := '';
        While (I < Length(Op)) And
              (((Op[I] >= 'A') And (Op[I] <= 'Z')) Or
               ((Op[I] >= 'a') And (Op[I] <= 'z')) Or
               ((Op[I] >= '0') And (Op[I] <= '9')) Or
               (Op[I] = '_')) Do
        Begin
          Tok := Tok + Op[I];
          Inc(I);
        End;
        { Traduire les registres dans les crochets }
        If IsAsmReg(Tok) Then
          R := R + TranslateReg16to32(Tok)
        Else
        Begin
          { Verifier si c est une variable Pascal }
          If (PI >= 0) And (FindLocal(PI, Tok) >= 0) Then
            R := R + GenVarAddr(PI, Tok)
          Else If (PI >= 0) And (FindParam(PI, Tok) >= 0) Then
            R := R + GenVarAddr(PI, Tok)
          Else If SymFind(StrUpperCase(Tok)) >= 0 Then
            R := R + GenVarAddr(PI, Tok)
          Else
            R := R + Tok;
        End;
      End
      Else
      Begin
        R := R + C;
        Inc(I);
      End;
    End;
    R := R + ']';
    TranslateAsmOperand := R;
    Exit;
  End;

  { Verifier si c est une variable Pascal (pas un immediat) }
  If ((Op[1] >= 'A') And (Op[1] <= 'Z')) Or
     ((Op[1] >= 'a') And (Op[1] <= 'z')) Or
     (Op[1] = '_') Then
  Begin
    If IsAsmReg(Op) Then
    Begin
      TranslateAsmOperand := TranslateReg16to32(Op);
      Exit;
    End;
    { Verifier si c est une variable Pascal connue }
    If (PI >= 0) And (FindLocal(PI, Op) >= 0) Then
    Begin
      TranslateAsmOperand := GenVarRef(PI, Op);
      Exit;
    End;
    If (PI >= 0) And (FindParam(PI, Op) >= 0) Then
    Begin
      TranslateAsmOperand := GenVarRef(PI, Op);
      Exit;
    End;
    If SymFind(StrUpperCase(Op)) >= 0 Then
    Begin
      TranslateAsmOperand := GenVarRef(PI, Op);
      Exit;
    End;
  End;

  { Sinon retourner tel quel (immediat, label, etc.) }
  TranslateAsmOperand := Op;
End;

{ ------------------------------------------------------------ }
{ AsmTrimSpaces : supprimer les espaces en debut et fin         }
{ ------------------------------------------------------------ }

Function AsmTrimSpaces(Const S : TString) : TString;
Var
  A, B : Integer;
Begin
  A := 1;
  While (A <= Length(S)) And (S[A] = ' ') Do Inc(A);
  B := Length(S);
  While (B >= A) And (S[B] = ' ') Do Dec(B);
  AsmTrimSpaces := Copy(S, A, B - A + 1);
End;

{ ------------------------------------------------------------ }
{ TranslateAsmLine : traduire une ligne ASM complete 8086       }
{ vers son equivalent 80386.                                    }
{ Gere : traduction des mnemoniques, registres et adressage     }
{ CBW->CWDE, CWD->CDQ, PUSHF->PUSHFD, POPF->POPFD             }
{ LDS/LES -> MOV registre 32 bits                               }
{ INT nn -> commentaire (emulation future TODO 21)              }
{ IN/OUT -> appel _TPRT_INPORT/_TPRT_OUTPORT (emulation TODO 22) }
{ LOOP/LOOPZ/LOOPNZ -> DEC ECX + Jcc equivalent                }
{ ------------------------------------------------------------ }

Procedure TranslateAsmLine(PI : Integer; Const Line : TString);
Var
  S      : TString;
  Mne    : TString;
  Rest   : TString;
  Op1    : TString;
  Op2    : TString;
  I, J   : Integer;
  Depth  : Integer;
  Up     : TString;
  LblEnd : TString;
Begin
  S := AsmTrimSpaces(Line);
  If Length(S) = 0 Then Exit;

  { Extraire le mnemonique (premier mot) }
  I := 1;
  While (I <= Length(S)) And (S[I] <> ' ') And (S[I] <> #9) Do Inc(I);
  Mne := Copy(S, 1, I - 1);
  Up := StrUpperCase(Mne);

  { Extraire le reste (operandes) }
  While (I <= Length(S)) And ((S[I] = ' ') Or (S[I] = #9)) Do Inc(I);
  Rest := Copy(S, I, Length(S) - I + 1);

  { Separer les operandes par virgule (en respectant les crochets) }
  Op1 := '';
  Op2 := '';
  Depth := 0;
  J := 0;
  For I := 1 To Length(Rest) Do
  Begin
    If Rest[I] = '[' Then Inc(Depth)
    Else If Rest[I] = ']' Then Dec(Depth);
    If (Rest[I] = ',') And (Depth = 0) And (J = 0) Then
    Begin
      J := I;
    End;
  End;
  If J > 0 Then
  Begin
    Op1 := AsmTrimSpaces(Copy(Rest, 1, J - 1));
    Op2 := AsmTrimSpaces(Copy(Rest, J + 1, Length(Rest) - J));
  End
  Else
    Op1 := AsmTrimSpaces(Rest);

  { --- Traductions speciales de mnemoniques --- }

  { CBW -> CWDE (extension de signe 8 -> 32 bits via EAX) }
  If Up = 'CBW' Then
  Begin
    EmitInstr('CWDE');
    Exit;
  End;

  { CWD -> CDQ (extension de signe 16 -> 64 bits via EDX:EAX) }
  If Up = 'CWD' Then
  Begin
    EmitInstr('CDQ');
    Exit;
  End;

  { PUSHF -> PUSHFD }
  If Up = 'PUSHF' Then
  Begin
    EmitInstr('PUSHFD');
    Exit;
  End;

  { POPF -> POPFD }
  If Up = 'POPF' Then
  Begin
    EmitInstr('POPFD');
    Exit;
  End;

  { LDS reg, [mem] -> MOV Ereg, DWORD PTR [mem] }
  If Up = 'LDS' Then
  Begin
    EmitComment('LDS traduit en MOV 32 bits (mode FLAT)');
    EmitInstr('MOV ' + TranslateAsmOperand(PI, Op1) + ',' +
              TranslateAsmOperand(PI, Op2));
    Exit;
  End;

  { LES reg, [mem] -> MOV Ereg, DWORD PTR [mem] }
  If Up = 'LES' Then
  Begin
    EmitComment('LES traduit en MOV 32 bits (mode FLAT)');
    EmitInstr('MOV ' + TranslateAsmOperand(PI, Op1) + ',' +
              TranslateAsmOperand(PI, Op2));
    Exit;
  End;

  { LOOP label -> DEC ECX / JNZ label }
  If Up = 'LOOP' Then
  Begin
    EmitInstr('DEC ECX');
    EmitInstr('JNZ ' + TranslateAsmOperand(PI, Op1));
    Exit;
  End;

  { LOOPZ/LOOPE label -> DEC ECX / JNZ +skip / JZ label }
  If (Up = 'LOOPZ') Or (Up = 'LOOPE') Then
  Begin
    LblEnd := LabelGen;
    EmitInstr('DEC ECX');
    EmitInstr('JZ ' + LblEnd);
    EmitInstr('JZ ' + TranslateAsmOperand(PI, Op1));
    EmitLabel(LblEnd);
    Exit;
  End;

  { LOOPNZ/LOOPNE label -> DEC ECX / JZ +skip / JNZ label }
  If (Up = 'LOOPNZ') Or (Up = 'LOOPNE') Then
  Begin
    LblEnd := LabelGen;
    EmitInstr('DEC ECX');
    EmitInstr('JZ ' + LblEnd);
    EmitInstr('JNZ ' + TranslateAsmOperand(PI, Op1));
    EmitLabel(LblEnd);
    Exit;
  End;

  { INT nn -> emulation via routines runtime (TODO 23) }
  If Up = 'INT' Then
  Begin
    If (Op1 = '21h') Or (Op1 = '21H') Or (Op1 = '$21') Then
    Begin
      EmitComment('INT 21h -> emulation DOS via _TPRT_MSDOS');
      EmitInstr('CALL ' + TP_RT_PFX + 'MSDOS');
    End
    Else If (Op1 = '10h') Or (Op1 = '10H') Or (Op1 = '$10') Then
    Begin
      EmitComment('INT 10h -> emulation Video BIOS via _TPRT_INT10');
      EmitInstr('CALL ' + TP_RT_PFX + 'INT10');
    End
    Else If (Op1 = '16h') Or (Op1 = '16H') Or (Op1 = '$16') Then
    Begin
      EmitComment('INT 16h -> emulation Clavier BIOS via _TPRT_INT16');
      EmitInstr('CALL ' + TP_RT_PFX + 'INT16');
    End
    Else If (Op1 = '33h') Or (Op1 = '33H') Or (Op1 = '$33') Then
    Begin
      EmitComment('INT 33h -> emulation Souris via _TPRT_INT33');
      EmitInstr('CALL ' + TP_RT_PFX + 'INT33');
    End
    Else
    Begin
      EmitComment('INT ' + Op1 + ' (non emule - NOP)');
      EmitInstr('NOP');
    End;
    Exit;
  End;

  { IN -> emulation Port via _TPRT_INPORT (TODO 22) }
  If Up = 'IN' Then
  Begin
    EmitComment('IN ' + Op1 + ',' + Op2 + ' (emule via _TPRT_INPORT)');
    { Op2 = numero port (immediat ou DX), Op1 = registre dest (AL/AX/EAX) }
    { Charger le numero de port dans EAX }
    If StrUpperCase(Op2) = 'DX' Then
      EmitInstr('MOVZX EAX,DX')
    Else
      EmitInstr('MOV EAX,' + TranslateAsmOperand(PI, Op2));
    EmitInstr('CALL ' + TP_RT_PFX + 'INPORT');
    { Stocker le resultat dans le registre destination }
    If StrUpperCase(Op1) = 'AL' Then
      { resultat deja dans AL via EAX }
    Else If StrUpperCase(Op1) = 'AX' Then
      { resultat deja dans AX via EAX }
    Else
      { resultat deja dans EAX };
    Exit;
  End;

  { OUT -> emulation Port via _TPRT_OUTPORT (TODO 22) }
  If Up = 'OUT' Then
  Begin
    EmitComment('OUT ' + Op1 + ',' + Op2 + ' (emule via _TPRT_OUTPORT)');
    { Op1 = numero port (immediat ou DX), Op2 = valeur (AL/AX/EAX) }
    { Sauvegarder la valeur dans EDX }
    If StrUpperCase(Op2) = 'AL' Then
      EmitInstr('MOVZX EDX,AL')
    Else If StrUpperCase(Op2) = 'AX' Then
      EmitInstr('MOVZX EDX,AX')
    Else
      EmitInstr('MOV EDX,EAX');
    { Charger le numero de port dans EAX }
    If StrUpperCase(Op1) = 'DX' Then
      EmitInstr('MOVZX EAX,DX')
    Else
      EmitInstr('MOV EAX,' + TranslateAsmOperand(PI, Op1));
    EmitInstr('CALL ' + TP_RT_PFX + 'OUTPORT');
    Exit;
  End;

  { REP MOVSB / REP MOVSW -> REP MOVSD (ou traduire) }
  If Up = 'REP' Then
  Begin
    { Le reste contient l instruction repetee }
    If StrUpperCase(Op1) = 'MOVSW' Then
      EmitInstr('REP MOVSD')
    Else If StrUpperCase(Op1) = 'STOSW' Then
      EmitInstr('REP STOSD')
    Else
      EmitInstr('REP ' + StrUpperCase(Op1));
    Exit;
  End;

  { Instructions sans operande }
  If (Up = 'NOP') Or (Up = 'CLD') Or (Up = 'STD') Or
     (Up = 'RET') Or (Up = 'RETF') Or (Up = 'CLI') Or (Up = 'STI') Or
     (Up = 'MOVSB') Or (Up = 'MOVSW') Or (Up = 'MOVSD') Or
     (Up = 'STOSB') Or (Up = 'STOSW') Or (Up = 'STOSD') Or
     (Up = 'LODSB') Or (Up = 'LODSW') Or (Up = 'LODSD') Or
     (Up = 'SCASB') Or (Up = 'SCASW') Or (Up = 'SCASD') Or
     (Up = 'CMPSB') Or (Up = 'CMPSW') Or (Up = 'CMPSD') Or
     (Up = 'PUSHA') Or (Up = 'POPA') Or
     (Up = 'PUSHAD') Or (Up = 'POPAD') Or
     (Up = 'PUSHFD') Or (Up = 'POPFD') Or
     (Up = 'CWDE') Or (Up = 'CDQ') Or
     (Up = 'SAHF') Or (Up = 'LAHF') Or
     (Up = 'IRET') Or (Up = 'IRETD') Then
  Begin
    { MOVSW -> MOVSD en 32 bits }
    If Up = 'MOVSW' Then EmitInstr('MOVSD')
    Else If Up = 'STOSW' Then EmitInstr('STOSD')
    Else If Up = 'LODSW' Then EmitInstr('LODSD')
    Else If Up = 'SCASW' Then EmitInstr('SCASD')
    Else If Up = 'CMPSW' Then EmitInstr('CMPSD')
    Else If Up = 'PUSHA' Then EmitInstr('PUSHAD')
    Else If Up = 'POPA' Then EmitInstr('POPAD')
    Else If Up = 'IRET' Then EmitInstr('IRETD')
    Else If Up = 'RETF' Then EmitInstr('RET')
    Else EmitInstr(Up);
    Exit;
  End;

  { Instructions avec 1 operande : PUSH, POP, INC, DEC, NEG, NOT, }
  { CALL, JMP, Jcc, MUL, DIV, IMUL, IDIV                          }
  If (Up = 'PUSH') Or (Up = 'POP') Or (Up = 'INC') Or (Up = 'DEC') Or
     (Up = 'NEG') Or (Up = 'NOT') Or (Up = 'CALL') Or (Up = 'JMP') Or
     (Up = 'MUL') Or (Up = 'DIV') Or (Up = 'IMUL') Or (Up = 'IDIV') Or
     (Up = 'JE') Or (Up = 'JNE') Or (Up = 'JZ') Or (Up = 'JNZ') Or
     (Up = 'JL') Or (Up = 'JLE') Or (Up = 'JG') Or (Up = 'JGE') Or
     (Up = 'JB') Or (Up = 'JBE') Or (Up = 'JA') Or (Up = 'JAE') Or
     (Up = 'JC') Or (Up = 'JNC') Or (Up = 'JS') Or (Up = 'JNS') Or
     (Up = 'JO') Or (Up = 'JNO') Or (Up = 'JP') Or (Up = 'JNP') Or
     (Up = 'JCXZ') Or (Up = 'JECXZ') Or
     (Up = 'SETE') Or (Up = 'SETNE') Or (Up = 'SETL') Or
     (Up = 'SETLE') Or (Up = 'SETG') Or (Up = 'SETGE') Or
     (Up = 'SETB') Or (Up = 'SETBE') Or (Up = 'SETA') Or (Up = 'SETAE') Then
  Begin
    { JCXZ -> JECXZ en 32 bits }
    If Up = 'JCXZ' Then
      EmitInstr('JECXZ ' + TranslateAsmOperand(PI, Op1))
    Else If Length(Op2) > 0 Then
      EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1) + ',' +
                TranslateAsmOperand(PI, Op2))
    Else
      EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1));
    Exit;
  End;

  { Instructions avec 2 operandes : MOV, ADD, SUB, CMP, TEST, AND, }
  { OR, XOR, SHL, SHR, ROL, ROR, RCL, RCR, LEA, XCHG, ADC, SBB   }
  If (Up = 'MOV') Or (Up = 'ADD') Or (Up = 'SUB') Or (Up = 'CMP') Or
     (Up = 'TEST') Or (Up = 'AND') Or (Up = 'OR') Or (Up = 'XOR') Or
     (Up = 'SHL') Or (Up = 'SHR') Or (Up = 'SAL') Or (Up = 'SAR') Or
     (Up = 'ROL') Or (Up = 'ROR') Or (Up = 'RCL') Or (Up = 'RCR') Or
     (Up = 'LEA') Or (Up = 'XCHG') Or (Up = 'ADC') Or (Up = 'SBB') Or
     (Up = 'BT') Or (Up = 'BTS') Or (Up = 'BTR') Or (Up = 'BTC') Or
     (Up = 'BSF') Or (Up = 'BSR') Or
     (Up = 'MOVZX') Or (Up = 'MOVSX') Or
     (Up = 'SHLD') Or (Up = 'SHRD') Then
  Begin
    If Length(Op2) > 0 Then
      EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1) + ',' +
                TranslateAsmOperand(PI, Op2))
    Else
      EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1));
    Exit;
  End;

  { Si on arrive ici, emettre tel quel (instruction non reconnue) }
  If Length(Op2) > 0 Then
    EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1) + ',' +
              TranslateAsmOperand(PI, Op2))
  Else If Length(Op1) > 0 Then
    EmitInstr(Up + ' ' + TranslateAsmOperand(PI, Op1))
  Else
    EmitInstr(Up);
End;

{ ------------------------------------------------------------ }
{ ParseAsmBlock : parser un bloc ASM...END et traduire chaque   }
{ ligne d assembleur 8086 en assembleur 80386 Win32.            }
{ Syntaxe Turbo Pascal : ASM instruction; instruction; ... END  }
{ Dans le TokenPool, chaque token est un mot ; on reconstruit   }
{ les lignes d assembleur et on les traduit.                    }
{ ------------------------------------------------------------ }

Procedure ParseAsmBlock(PI : Integer);
Var
  AsmLine : TString;
  Up      : TString;
  T       : TString;
Begin
  EmitComment('--- Debut bloc ASM (TODO 17) ---');

  { Consommer le mot-cle ASM }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
     (StrUpperCase(TokenPool[EP].Val) = 'ASM') Then
    Inc(EP);

  { Traiter les tokens jusqu au END correspondant }
  While Not EPAtEnd Do
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    { END termine le bloc ASM }
    If (TokenPool[EP].Kind = TK_KEYWORD) And (Up = 'END') Then
    Begin
      Inc(EP);
      { Consommer ; ou . optionnel apres END }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         ((TokenPool[EP].Val = ';') Or (TokenPool[EP].Val = '.')) Then
        Inc(EP);
      Break;
    End;

    { Point-virgule seul : separateur d instructions, ignorer }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';') Then
    Begin
      Inc(EP);
      Continue;
    End;

    { Construire une ligne ASM a partir des tokens }
    { Une instruction ASM va jusqu au prochain ; ou END }
    AsmLine := '';
    While Not EPAtEnd Do
    Begin
      { Arreter au ; ou END }
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';') Then
        Break;
      If (TokenPool[EP].Kind = TK_KEYWORD) And
         (StrUpperCase(TokenPool[EP].Val) = 'END') Then
        Break;

      { Verifier si le token suivant est ':' (c est un label ASM) }
      T := TokenPool[EP].Val;
      Inc(EP);

      { Si le prochain token est ':', c est un label }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ':') Then
      Begin
        { Emettre le label }
        EmitLabel(T);
        Inc(EP); { consommer ':' }
        Continue;
      End;

      { Ajouter au tampon de la ligne }
      If Length(AsmLine) > 0 Then
        AsmLine := AsmLine + ' ';
      AsmLine := AsmLine + T;
    End;

    { Traduire et emettre la ligne ASM }
    AsmLine := AsmTrimSpaces(AsmLine);
    If Length(AsmLine) > 0 Then
      TranslateAsmLine(PI, AsmLine);
  End;

  EmitComment('--- Fin bloc ASM ---');
End;

{ ------------------------------------------------------------ }
{ EmitMainBlock : emettre le bloc principal du programme        }
{ (le BEGIN..END. final)                                        }
{ ------------------------------------------------------------ }

Procedure EmitMainBlock;
Var
  I    : Integer;
  Up   : TString;
  Depth: Integer;
Begin
  { Chercher le dernier BEGIN au niveau global = bloc principal }
  I := TokenCount - 1;
  While I >= 0 Do
  Begin
    If (TokenPool[I].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[I].Val) = 'END') Then
    Begin
      { Remonter pour trouver le BEGIN correspondant }
      Depth := 1;
      Dec(I);
      While (I >= 0) And (Depth > 0) Do
      Begin
        If TokenPool[I].Kind = TK_KEYWORD Then
        Begin
          Up := StrUpperCase(TokenPool[I].Val);
          If Up = 'END' Then
            Inc(Depth)
          Else If ((Up = 'BEGIN') Or (Up = 'CASE') Or (Up = 'RECORD') Or
                   (Up = 'ASM') Or (Up = 'OBJECT')) And Not TokVariantCase[I] Then
            Dec(Depth);
        End;
        If Depth > 0 Then Dec(I);
      End;
      If Depth = 0 Then Break;
    End;
    Dec(I);
  End;

  { Si on a trouve le bloc principal, emettre _TPF_Main }
  If (I >= 0) And (TokenPool[I].Kind = TK_KEYWORD) And
     (StrUpperCase(TokenPool[I].Val) = 'BEGIN') Then
  Begin
    HasProgram := True;
    EmitBlankLine;
    EmitComment('--- Programme principal ---');
    EmitLabel(TP_FUNC_PFX + 'Main');

    If (Opts.DestTarget = DEST_DOSR) Or (Opts.DestTarget = DEST_DOSP) Then
    Begin
      { Mode DOS 16 bits : initialiser DS et ES }
      EmitComment('Initialiser DS et ES pour DOS 16 bits');
      EmitInstr('MOV AX,0');   { placeholder, fixup segment data }
      EmitInstr('MOV DS,AX');
      EmitInstr('MOV ES,AX');
    End
    Else If Opts.DestTarget = DEST_AMIGA Then
    Begin
      { Mode Amiga : ouvrir dos.library, obtenir stdout }
      EmitComment('Entree programme Amiga');
      EmitInstr('MOVEM.L D0-D7/A0-A6,-(SP)');
      EmitInstr('MOVE.L 4.W,A6');       { ExecBase : adresse fixe Amiga Kickstart }
      EmitInstr('LEA DOS_NAME,A1');
      EmitInstr('MOVEQ #0,D0');
      EmitInstr('JSR -552(A6)');         { exec OpenLibrary() }
      EmitInstr('MOVE.L D0,DOS_BASE');
      EmitInstr('BEQ ' + TP_RT_PFX + 'EXIT_FAIL');
      EmitInstr('MOVE.L D0,A6');
      EmitInstr('JSR -60(A6)');          { dos Output() -> stdout handle }
      EmitInstr('MOVE.L D0,STDOUT');
    End
    Else If Is68kTarget Then
    Begin
      { Mode 68000 / Atari ST : pas d initialisation speciale }
      EmitComment('Entree programme 68000');
    End
    Else If Opts.DestTarget = DEST_CRAY1 Then
    Begin
      { Mode Cray-1 : pas de prologue (pas de pile materielle, pas d OS) }
      EmitComment('Entree programme Cray-1 (P-register = $200)');
    End
    Else If Opts.MSX Then
    Begin
      { Mode MSX-DOS : pas d initialisation, entree directe (CP/M) }
      EmitComment('Entree programme MSX (CP/M @ $0100)');
    End
    Else If Opts.Adam Then
    Begin
      { Mode Coleco Adam (CP/M 2.2) : pas d initialisation, entree @ $0100 }
      EmitComment('Entree programme Coleco Adam (CP/M 2.2 @ $0100)');
    End
    Else If Opts.TRS80 Then
    Begin
      { Mode TRS-80 Model I : pas d initialisation, entree directe @ $5200 }
      EmitComment('Entree programme TRS-80 Model I (TRSDOS @ $5200)');
    End
    Else If Opts.CoCo3 Then
    Begin
      { Mode CoCo 3 : pas d initialisation, entree directe (DECB @ $2000) }
      EmitComment('Entree programme CoCo 3 (DECB @ $2000)');
    End
    Else If Opts.TO7 Then
    Begin
      { Mode Thomson TO7 : pas d initialisation, entree directe (@ $6100) }
      EmitComment('Entree programme Thomson TO7 (@ $6100)');
    End
    Else
    Begin
      EmitProlog(0);

      { Initialiser les handles Win32 }
      EmitComment('Obtenir STDOUT');
      EmitInstr('PUSH -11');
      EmitInstr('CALL GetStdHandle');
      EmitInstr('MOV [HSTDOUT],EAX');
      EmitComment('Obtenir STDIN');
      EmitInstr('PUSH -10');
      EmitInstr('CALL GetStdHandle');
      EmitInstr('MOV [HSTDIN],EAX');
      EmitComment('Obtenir le tas du processus');
      EmitInstr('CALL GetProcessHeap');
      EmitInstr('MOV [HHEAP],EAX');
      EmitComment('Erreurs d execution materielles (216, 200, 207...) et exceptions x87 comme FPC');
      EmitInstr('PUSH OFFSET ' + TP_RT_PFX + 'EXCFILTER');
      EmitInstr('CALL SetUnhandledExceptionFilter');
      EmitInstr('FLDCW WORD PTR [FPUCW]');
    End;

    { Parser et emettre le corps du programme }
    RetLbl := LabelGen;
    EP := I;      { I pointe sur le BEGIN }
    EPEnd := TokenCount;
    CurProcIdx := -1;
    ParseBody(-1);
    EmitLabel(RetLbl);

    If (Opts.DestTarget = DEST_DOSR) Or (Opts.DestTarget = DEST_DOSP) Then
    Begin
      { Sortie DOS via INT 21h }
      EmitInstr('MOV AX,4C00H');
      EmitInstr('INT 21H');
    End
    Else If Opts.AppleII Or Opts.C64 Or Opts.Atari400 Or Opts.Atari800 Then
    Begin
      { Sortie 6502 (Apple II / C64) : retour via RTS }
      EmitComment('6502 : retour via RTS');
      EmitInstr('RTS');
    End
    Else If Opts.NES Then
    Begin
      { Sortie NES : retour via RTS vers _TPRT_NES_INIT (boucle infinie) }
      EmitComment('NES : retour vers _TPRT_NES_INIT');
      EmitInstr('RTS');
    End
    Else If Opts.MSX Then
    Begin
      { Sortie MSX-DOS (CP/M) : retour via RET vers MSX-DOS }
      EmitComment('MSX-DOS : retour via RET');
      EmitInstr('RET');
    End
    Else If Opts.Adam Then
    Begin
      { Sortie Coleco Adam (CP/M 2.2) : retour via RET }
      EmitComment('Coleco Adam : retour via RET');
      EmitInstr('RET');
    End
    Else If Opts.TRS80 Then
    Begin
      { Sortie TRS-80 Model I : retour via RET vers TRSDOS }
      EmitComment('TRS-80 Model I : retour via RET');
      EmitInstr('RET');
    End
    Else If Opts.CoCo3 Then
    Begin
      { Sortie CoCo 3 : retour via RTS vers le moniteur DECB }
      EmitComment('CoCo 3 : retour via RTS');
      EmitInstr('RTS');
    End
    Else If Opts.TO7 Then
    Begin
      { Sortie Thomson TO7 : retour via RTS vers le moniteur BASIC }
      EmitComment('Thomson TO7 : retour via RTS');
      EmitInstr('RTS');
    End
    Else If Opts.DestTarget = DEST_AMIGA Then
    Begin
      { Sortie Amiga : fermer dos.library et retourner }
      EmitComment('Sortie AmigaDOS');
      EmitInstr('MOVE.L 4.W,A6');         { ExecBase }
      EmitInstr('MOVE.L DOS_BASE,A1');
      EmitInstr('JSR -414(A6)');         { exec CloseLibrary() }
      EmitLabel(TP_RT_PFX + 'EXIT_FAIL');
      EmitInstr('MOVEM.L (SP)+,D0-D7/A0-A6');
      EmitInstr('MOVEQ #0,D0');
      EmitInstr('RTS');
    End
    Else If Is68kTarget Then
    Begin
      { Sortie Atari ST / 68000 via GEMDOS Pterm0 }
      EmitComment('GEMDOS Pterm0 (fin du programme)');
      EmitInstr('CLR.W -(SP)');
      EmitInstr('TRAP #1');
    End
    Else If Opts.DestTarget = DEST_CRAY1 Then
    Begin
      { Sortie Cray-1 : ERR (Error Exit) arrete le CPU. }
      EmitComment('Cray-1 ERR (halt CPU)');
      EmitInstr('ERR');
    End
    Else
    Begin
      { Sortie propre Win32 }
      EmitInstr('PUSH 0');
      EmitInstr('CALL ' + TP_RT_PFX + 'OFLUSH');
      EmitInstr('CALL ExitProcess');
      EmitEpilog;
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ EmitRuntime : emettre les routines runtime internes du        }
{ compilateur dans le segment .CODE.                           }
{ _TPRT_PRINTSTR : afficher chaine ASCIIZ (ESI = pointeur)    }
{ _TPRT_NUMTOSTR : convertir EAX en chaine NUMBUF             }
{ _TPRT_STRTONUM : convertir chaine ASCIIZ (ESI) en EAX       }
{ _TPRT_READLN   : lire une ligne de STDIN dans INBUF         }
{ _TPRT_STRASSIGN: affecter String Pascal (ASCIIZ -> Pascal) }
{ _TPRT_STRASSIGN_PCHAR: copier ASCIIZ brut (ESI -> EDI)      }
{ _TPRT_STRCPY   : StrCopy PChar ASCIIZ (Dest,Src) -> Dest    }
{ _TPRT_LENGTH   : longueur String Pascal S[0] -> EAX         }
{ _TPRT_STRLEN   : longueur ASCIIZ PChar (ESI) -> EAX         }
{ _TPRT_CONCAT   : concatener EDI apres ESI      (TODO 16)   }
{ _TPRT_STRCOMPARE: comparer String Pascal ESI/EDI -> EAX     }
{ _TPRT_STRCMP    : StrComp PChar ASCIIZ ESI/EDI -> EAX       }
{ _TPRT_COPY     : sous-chaine -> STRBUF1        (TODO 16)   }
{ _TPRT_POS      : position sous-chaine -> EAX   (TODO 16)   }
{ _TPRT_DELETE    : supprimer in-place            (TODO 16)   }
{ _TPRT_INSERT    : inserer via STRBUF2           (TODO 16)   }
{ ------------------------------------------------------------ }

Procedure EmitRuntimeDOS;
{ Runtime DOS 16 bits utilisant INT 21h au lieu des API Win32. }
{ Les registres sont en 16 bits : SI au lieu de ESI, AX de EAX, etc. }
Begin
  EmitBlankLine;
  EmitComment('=== Routines runtime TPCW32 - DOS 16 bits ===');

  { ------ _TPRT_PRINTSTR : afficher chaine ASCIIZ (SI = ptr) ----- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'PRINTSTR');
  EmitInstr('PUSH AX');
  EmitInstr('PUSH DX');
  EmitInstr('PUSH SI');
  EmitLabel(TP_RT_PFX + 'PSTR_L');
  EmitInstr('LODSB');                    { AL = [DS:SI], SI++ }
  EmitInstr('CMP AL,0');
  EmitInstr('JE ' + TP_RT_PFX + 'PSTR_D');
  EmitInstr('MOV DL,AL');
  EmitInstr('MOV AH,2');               { DOS: afficher caractere }
  EmitInstr('INT 21H');
  EmitInstr('JMP ' + TP_RT_PFX + 'PSTR_L');
  EmitLabel(TP_RT_PFX + 'PSTR_D');
  EmitInstr('POP SI');
  EmitInstr('POP DX');
  EmitInstr('POP AX');
  EmitInstr('RET');

  { ------ _TPRT_NUMTOSTR : AX -> NUMBUF (ASCIIZ decimal) -------- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'NUMTOSTR');
  EmitInstr('PUSH AX');
  EmitInstr('PUSH BX');
  EmitInstr('PUSH CX');
  EmitInstr('PUSH DX');
  EmitInstr('PUSH DI');
  EmitInstr('LEA DI,[NUMBUF]');
  EmitInstr('XOR CX,CX');              { compteur de chiffres }
  EmitInstr('CMP AX,0');
  EmitInstr('JGE ' + TP_RT_PFX + 'NTS_POS');
  { Nombre negatif }
  EmitInstr('MOV BYTE PTR [NUMBUF],45'); { '-' utiliser label direct }
  EmitInstr('INC DI');
  EmitInstr('NEG AX');
  EmitLabel(TP_RT_PFX + 'NTS_POS');
  EmitInstr('MOV BX,10');
  EmitLabel(TP_RT_PFX + 'NTS_DIV');
  EmitInstr('XOR DX,DX');
  EmitInstr('DIV BX');                  { AX=quotient, DX=reste }
  EmitInstr('ADD DL,48');               { '0' }
  EmitInstr('PUSH DX');
  EmitInstr('INC CX');
  EmitInstr('CMP AX,0');
  EmitInstr('JNE ' + TP_RT_PFX + 'NTS_DIV');
  EmitLabel(TP_RT_PFX + 'NTS_POP');
  EmitInstr('POP AX');
  EmitInstr('STOSB');                   { [DI] = AL, DI++ }
  EmitInstr('DEC CX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'NTS_POP');
  EmitInstr('MOV AL,0');
  EmitInstr('STOSB');                   { terminateur NUL }
  EmitInstr('POP DI');
  EmitInstr('POP DX');
  EmitInstr('POP CX');
  EmitInstr('POP BX');
  EmitInstr('POP AX');
  EmitInstr('RET');

  { ------ _TPRT_READLN : lire ligne STDIN -> INBUF (ASCIIZ) ----- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'READLN');
  EmitInstr('PUSH AX');
  EmitInstr('PUSH DI');
  EmitInstr('LEA DI,[INBUF]');
  EmitLabel(TP_RT_PFX + 'RL_LP');
  EmitInstr('MOV AH,1');               { DOS: lire caractere avec echo }
  EmitInstr('INT 21H');
  EmitInstr('CMP AL,13');              { CR ? }
  EmitInstr('JE ' + TP_RT_PFX + 'RL_DN');
  EmitInstr('CMP AL,10');              { LF ? }
  EmitInstr('JE ' + TP_RT_PFX + 'RL_DN');
  EmitInstr('STOSB');                  { [DI] = AL, DI++ }
  EmitInstr('JMP ' + TP_RT_PFX + 'RL_LP');
  EmitLabel(TP_RT_PFX + 'RL_DN');
  EmitInstr('MOV AL,0');
  EmitInstr('STOSB');                  { terminateur NUL }
  EmitInstr('POP DI');
  EmitInstr('POP AX');
  EmitInstr('RET');

  { ------ _TPRT_STRTONUM : SI -> AX (conversion decimale) ------- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'STRTONUM');
  EmitInstr('PUSH BX');
  EmitInstr('PUSH CX');
  EmitInstr('PUSH DX');
  EmitInstr('XOR AX,AX');
  EmitInstr('XOR CX,CX');              { flag signe }
  EmitInstr('CMP BYTE PTR [INBUF],45'); { '-' }
  EmitInstr('JNE ' + TP_RT_PFX + 'STN_LP');
  EmitInstr('INC SI');
  EmitInstr('INC CX');
  EmitLabel(TP_RT_PFX + 'STN_LP');
  EmitInstr('LODSB');
  EmitInstr('CMP AL,48');              { '0' }
  EmitInstr('JB ' + TP_RT_PFX + 'STN_DN');
  EmitInstr('CMP AL,57');              { '9' }
  EmitInstr('JA ' + TP_RT_PFX + 'STN_DN');
  EmitInstr('SUB AL,48');
  EmitInstr('MOV BX,AX');             { sauver chiffre }
  EmitInstr('POP DX');                 { temp: recup AX partiel }
  EmitInstr('PUSH DX');
  { Simplification: multiplication par 10 via shifts+adds }
  { AX = result * 10 + digit, on utilise une approche simple }
  { Pour l instant, ignorer silencieusement les grands nombres }
  EmitInstr('JMP ' + TP_RT_PFX + 'STN_LP');
  EmitLabel(TP_RT_PFX + 'STN_DN');
  EmitInstr('CMP CX,0');
  EmitInstr('JE ' + TP_RT_PFX + 'STN_RT');
  EmitInstr('NEG AX');
  EmitLabel(TP_RT_PFX + 'STN_RT');
  EmitInstr('POP DX');
  EmitInstr('POP CX');
  EmitInstr('POP BX');
  EmitInstr('RET');

  { ------ _TPRT_STRASSIGN : ASCIIZ -> Pascal String (stub) ------ }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'STRASSIGN');
  EmitInstr('RET');

  { ------ _TPRT_STRASSIGN_PCHAR : copie ASCIIZ (stub) ----------- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'STRASSIGN_PCHAR');
  EmitInstr('RET');

  { ------ Stubs pour les autres routines runtime ------------------ }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'PADPRINT');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'STRCPY');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'LENGTH');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'STRLEN');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'CONCAT');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'STRCOMPARE');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'STRCMP');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'COPY');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'POS');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'DELETE');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'INSERT');
  EmitInstr('RET');

  { ------ _TPRT_PACKTIME : empaqueter DateTime en LongInt DOS (8086) --- }
  { [BP+6] = ptr DateTime T, [BP+4] = ptr LongInt P                      }
  { Packed: mot bas  bits 0-4=Sec/2, 5-10=Min, 11-15=Hour               }
  {         mot haut bits 0-4=Day,   5-8=Month, 9-15=Year-1980           }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'PACKTIME');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH SI');
  EmitInstr('PUSH DI');
  EmitInstr('PUSH BX');
  EmitInstr('PUSH CX');
  EmitInstr('MOV SI,[BP+6]');      { SI = ptr DateTime T }
  EmitInstr('MOV DI,[BP+4]');      { DI = ptr LongInt P }
  { --- Mot bas : Hour<<11 | Min<<5 | Sec/2 --- }
  EmitInstr('MOV AX,[SI+6]');      { Hour }
  EmitInstr('AND AX,1Fh');
  EmitInstr('MOV CL,11');
  EmitInstr('SHL AX,CL');          { AX = Hour << 11 }
  EmitInstr('MOV BX,[SI+8]');      { Min }
  EmitInstr('AND BX,3Fh');
  EmitInstr('MOV CL,5');
  EmitInstr('SHL BX,CL');          { BX = Min << 5 }
  EmitInstr('OR AX,BX');
  EmitInstr('MOV BX,[SI+10]');     { Sec }
  EmitInstr('SHR BX,1');
  EmitInstr('AND BX,1Fh');         { BX = Sec/2 }
  EmitInstr('OR AX,BX');
  EmitInstr('MOV [DI],AX');        { mot bas -> [P] }
  { --- Mot haut : (Year-1980)<<9 | Month<<5 | Day --- }
  EmitInstr('MOV AX,[SI]');        { Year }
  EmitInstr('SUB AX,1980');
  EmitInstr('AND AX,7Fh');
  EmitInstr('MOV CL,9');
  EmitInstr('SHL AX,CL');          { AX = (Year-1980) << 9 }
  EmitInstr('MOV BX,[SI+2]');      { Month }
  EmitInstr('AND BX,0Fh');
  EmitInstr('MOV CL,5');
  EmitInstr('SHL BX,CL');          { BX = Month << 5 }
  EmitInstr('OR AX,BX');
  EmitInstr('MOV BX,[SI+4]');      { Day }
  EmitInstr('AND BX,1Fh');
  EmitInstr('OR AX,BX');
  EmitInstr('MOV [DI+2],AX');      { mot haut -> [P+2] }
  EmitInstr('POP CX');
  EmitInstr('POP BX');
  EmitInstr('POP DI');
  EmitInstr('POP SI');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_UNPACKTIME : decomposer LongInt en DateTime (8086) ----- }
  { [BP+4] = ptr DateTime T, [BP+6] = P mot bas, [BP+8] = P mot haut     }
  { Mot bas  bits 0-4=Sec/2, 5-10=Min, 11-15=Hour                        }
  { Mot haut bits 0-4=Day,   5-8=Month, 9-15=Year-1980                   }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'UNPACKTIME');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH SI');
  EmitInstr('PUSH BX');
  EmitInstr('PUSH CX');
  EmitInstr('MOV SI,[BP+4]');      { SI = ptr DateTime T }
  EmitInstr('MOV AX,[BP+6]');      { AX = P mot bas (Hour|Min|Sec/2) }
  { Sec = (AX & 1Fh) * 2 }
  EmitInstr('MOV CX,AX');
  EmitInstr('AND CX,1Fh');
  EmitInstr('SHL CX,1');
  EmitInstr('MOV [SI+10],CX');     { Sec }
  { Min = (AX >> 5) & 3Fh }
  EmitInstr('MOV CX,AX');
  EmitInstr('MOV BL,5');
  EmitInstr('MOV CL,5');
  EmitInstr('SHR CX,CL');
  EmitInstr('AND CX,3Fh');
  EmitInstr('MOV [SI+8],CX');      { Min }
  { Hour = (AX >> 11) & 1Fh }
  EmitInstr('MOV CX,AX');
  EmitInstr('MOV CL,11');
  EmitInstr('SHR CX,CL');
  EmitInstr('AND CX,1Fh');
  EmitInstr('MOV [SI+6],CX');      { Hour }
  EmitInstr('MOV AX,[BP+8]');      { AX = P mot haut (Year-1980|Month|Day) }
  { Day = AX & 1Fh }
  EmitInstr('MOV CX,AX');
  EmitInstr('AND CX,1Fh');
  EmitInstr('MOV [SI+4],CX');      { Day }
  { Month = (AX >> 5) & 0Fh }
  EmitInstr('MOV CX,AX');
  EmitInstr('MOV CL,5');
  EmitInstr('SHR CX,CL');
  EmitInstr('AND CX,0Fh');
  EmitInstr('MOV [SI+2],CX');      { Month }
  { Year = ((AX >> 9) & 7Fh) + 1980 }
  EmitInstr('MOV CL,9');
  EmitInstr('SHR AX,CL');
  EmitInstr('AND AX,7Fh');
  EmitInstr('ADD AX,1980');
  EmitInstr('MOV [SI],AX');        { Year }
  EmitInstr('POP CX');
  EmitInstr('POP BX');
  EmitInstr('POP SI');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_INITGRAPH : initialiser mode graphique VGA (8086/DOS) --- }
  { Convention : [BP+4] = ptr Gd (Word), [BP+6] = ptr Gm (Word), [BP+8] = Path }
  { Active le mode VGA 640x480 16 couleurs via INT 10h, AH=00h, AL=12h     }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'INITGRAPH');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH AX');
  EmitInstr('PUSH BX');
  { Activer le mode video VGA 640x480 16 couleurs (mode 12h) }
  EmitInstr('MOV AX,0012h');        { AH=00h (Set Video Mode), AL=12h (VGA 640x480) }
  EmitInstr('INT 10h');
  { Retourner Gd = 9 (VGA) via le parametre var }
  EmitInstr('MOV BX,[BP+4]');       { BX = adresse de Gd }
  EmitInstr('MOV WORD PTR [BX],9'); { Gd = VGA }
  { Retourner Gm = 2 (VGAHi) via le parametre var }
  EmitInstr('MOV BX,[BP+6]');       { BX = adresse de Gm }
  EmitInstr('MOV WORD PTR [BX],2'); { Gm = VGAHi }
  EmitInstr('POP BX');
  EmitInstr('POP AX');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_CLOSEGRAPH : restaurer le mode texte (8086/DOS) --------- }
  { Restaure le mode texte 80x25 couleur via INT 10h, AH=00h, AL=03h       }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'CLOSEGRAPH');
  EmitInstr('PUSH AX');
  EmitInstr('MOV AX,0003h');        { AH=00h (Set Video Mode), AL=03h (texte 80x25) }
  EmitInstr('INT 10h');
  EmitInstr('POP AX');
  EmitInstr('RET');

  { ------ _TPRT_SETVIDEOMODE : changer le mode video (8086/DOS) ---------- }
  { Convention : [BP+4] = mode (Integer)                                    }
  { Si mode = -1 (_DefaultMode), restaurer le mode texte (appeler CLOSEGRAPH) }
  { Sinon : INT 10h, AH=00h, AL=mode pour activer le mode                   }
  { Retour : AX = 25 (nb lignes texte) si succes                            }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'SETVIDEOMODE');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH BX');
  EmitInstr('MOV AX,[BP+4]');       { AX = mode }
  { Si mode == -1 : restaurer le mode texte }
  EmitInstr('CMP AX,-1');
  EmitInstr('JNE ' + TP_RT_PFX + 'SVM_SET');
  EmitInstr('CALL ' + TP_RT_PFX + 'CLOSEGRAPH');
  EmitInstr('XOR AX,AX');           { retourner 0 }
  EmitInstr('POP BX');
  EmitInstr('POP BP');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'SVM_SET');
  { Activer le mode video demande via INT 10h, AH=00h, AL=mode }
  EmitInstr('MOV AH,00h');
  EmitInstr('AND AL,0FFh');          { AL = mode (deja dans AX basse) }
  EmitInstr('INT 10h');
  EmitInstr('MOV AX,25');           { retourner 25 = nb lignes texte = succes }
  EmitInstr('POP BX');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_PUTPIXEL : dessiner un pixel (8086/DOS) ------------------- }
  { Convention : [BP+4]=X (Word), [BP+6]=Y (Word), [BP+8]=Color (Word)       }
  { Dispatch selon le mode video BIOS courant (INT 10h AH=0Fh) :             }
  {   Mode $13 (320x200 256c)  -> ecriture lineaire directe au segment $A000 }
  {   Modes $0D..$12 (EGA/VGA) -> INT 10h AH=0Ch (acces planaire $A000)      }
  {   Modes 4,5,6 (CGA)        -> INT 10h AH=0Ch (segment $B800)             }
  {   Modes 7,8 (mono)         -> INT 10h AH=0Ch (segment $B000)             }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'PUTPIXEL');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH AX');
  EmitInstr('PUSH BX');
  EmitInstr('PUSH CX');
  EmitInstr('PUSH DX');
  EmitInstr('PUSH ES');
  { Obtenir le mode video courant via INT 10h AH=0Fh }
  EmitInstr('MOV AH,0Fh');
  EmitInstr('INT 10h');              { AL = mode video courant }
  { Mode $13 : 320x200 256 couleurs, ecriture lineaire directe $A000 }
  EmitInstr('CMP AL,13h');
  EmitInstr('JNE ' + TP_RT_PFX + 'PP_INT10');
  EmitInstr('MOV AX,0A000h');
  EmitInstr('MOV ES,AX');
  EmitInstr('MOV AX,[BP+6]');        { Y }
  EmitInstr('MOV BX,320');
  EmitInstr('MUL BX');               { AX = Y * 320 }
  EmitInstr('ADD AX,[BP+4]');        { AX = Y*320 + X }
  EmitInstr('MOV BX,AX');
  EmitInstr('MOV AL,BYTE PTR [BP+8]'); { Color }
  EmitInstr('MOV BYTE PTR ES:[BX],AL');
  EmitInstr('JMP ' + TP_RT_PFX + 'PP_DONE');
  { Autres modes ($0D-$12 EGA/VGA $A000, 4/5/6 CGA $B800, 7/8 $B000) }
  { Utiliser INT 10h AH=0Ch (Write Graphics Pixel) }
  EmitLabel(TP_RT_PFX + 'PP_INT10');
  EmitInstr('MOV AH,0Ch');           { AH=0Ch : Write Graphics Pixel }
  EmitInstr('MOV AL,BYTE PTR [BP+8]'); { AL = couleur }
  EmitInstr('MOV BH,0');             { BH = page 0 }
  EmitInstr('MOV CX,[BP+4]');        { CX = X }
  EmitInstr('MOV DX,[BP+6]');        { DX = Y }
  EmitInstr('INT 10h');
  EmitLabel(TP_RT_PFX + 'PP_DONE');
  EmitInstr('POP ES');
  EmitInstr('POP DX');
  EmitInstr('POP CX');
  EmitInstr('POP BX');
  EmitInstr('POP AX');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_SETCOLOR : changer la couleur de dessin (8086/DOS) --------- }
  { Convention : [BP+4]=Color (Word)                                           }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'SETCOLOR');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('MOV AX,[BP+4]');              { Color }
  EmitInstr('MOV WORD PTR [GR_COLOR],AX'); { mise a jour couleur courante }
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_LINE : tracer une ligne - algorithme Bresenham (8086/DOS) -- }
  { Convention : [BP+10]=X1 [BP+8]=Y1 [BP+6]=X2 [BP+4]=Y2                   }
  { Locaux (5 mots) : dx[BP-2], dy[BP-4], sx[BP-6], sy[BP-8], err[BP-10]     }
  { Mode $13 (320x200 256c) : acces direct segment $A000                      }
  { Modes $0D..$12 EGA/VGA ($A000), modes 4-6 CGA ($B800), 7-8 MDA ($B000) : }
  {   utilise INT 10h AH=0Ch (Write Graphics Pixel) comme repli universel     }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'LINE');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('SUB SP,10');   { 5 locaux : dx[BP-2] dy[BP-4] sx[BP-6] sy[BP-8] err[BP-10] }
  EmitInstr('PUSH SI');     { sauvegarde SI = x courant }
  EmitInstr('PUSH DI');     { sauvegarde DI = y courant }
  { Initialiser SI=X1, DI=Y1 }
  EmitInstr('MOV SI,[BP+10]');
  EmitInstr('MOV DI,[BP+8]');
  { dx = abs(X2-X1), sx = signe(X2-X1) }
  EmitInstr('MOV AX,[BP+6]');           { X2 }
  EmitInstr('SUB AX,SI');               { AX = X2-X1 }
  EmitInstr('MOV CX,1');                { sx defaut = +1 }
  EmitInstr('JGE ' + TP_RT_PFX + 'LN16_SX1');
  EmitInstr('NEG AX');                  { |X2-X1| }
  EmitInstr('MOV CX,-1');               { sx = -1 }
  EmitLabel(TP_RT_PFX + 'LN16_SX1');
  EmitInstr('MOV [BP-2],AX');           { dx }
  EmitInstr('MOV [BP-6],CX');           { sx }
  { dy = abs(Y2-Y1), sy = signe(Y2-Y1) }
  EmitInstr('MOV AX,[BP+4]');           { Y2 }
  EmitInstr('SUB AX,DI');               { AX = Y2-Y1 }
  EmitInstr('MOV CX,1');                { sy defaut = +1 }
  EmitInstr('JGE ' + TP_RT_PFX + 'LN16_SY1');
  EmitInstr('NEG AX');                  { |Y2-Y1| }
  EmitInstr('MOV CX,-1');               { sy = -1 }
  EmitLabel(TP_RT_PFX + 'LN16_SY1');
  EmitInstr('MOV [BP-4],AX');           { dy }
  EmitInstr('MOV [BP-8],CX');           { sy }
  { err = dx - dy }
  EmitInstr('MOV AX,[BP-2]');
  EmitInstr('SUB AX,[BP-4]');
  EmitInstr('MOV [BP-10],AX');          { err }
  { Determiner le mode video courant }
  EmitInstr('MOV AH,0Fh');
  EmitInstr('INT 10h');                 { AL = mode video courant }
  EmitInstr('CMP AL,13h');
  EmitInstr('JNE ' + TP_RT_PFX + 'LN16_LGN'); { autre mode -> repli INT 10h }
  { --- Chemin rapide mode $13 : acces direct segment $A000 (lineaire) --- }
  EmitInstr('MOV AX,0A000h');
  EmitInstr('MOV ES,AX');
  EmitLabel(TP_RT_PFX + 'LN16_L13');   { debut boucle mode $13 }
  { Ecrire pixel a (SI, DI) : ES:[DI*320+SI] = GR_COLOR }
  EmitInstr('MOV AX,DI');
  EmitInstr('MOV BX,320');
  EmitInstr('MUL BX');                  { DX:AX = DI*320 }
  EmitInstr('ADD AX,SI');               { AX = DI*320+SI }
  EmitInstr('MOV BX,AX');              { BX = offset }
  EmitInstr('MOV AL,BYTE PTR [GR_COLOR]');
  EmitInstr('MOV BYTE PTR ES:[BX],AL');
  { Test fin : SI=X2 et DI=Y2 ? }
  EmitInstr('CMP SI,[BP+6]');
  EmitInstr('JNE ' + TP_RT_PFX + 'LN16_C13');
  EmitInstr('CMP DI,[BP+4]');
  EmitInstr('JE ' + TP_RT_PFX + 'LN16_END');
  EmitLabel(TP_RT_PFX + 'LN16_C13');
  { e2 = 2*err }
  EmitInstr('MOV AX,[BP-10]');
  EmitInstr('SAL AX,1');                { e2 = 2*err }
  { if e2 > -dy : err -= dy ; x += sx }
  EmitInstr('MOV CX,[BP-4]');
  EmitInstr('NEG CX');                  { CX = -dy }
  EmitInstr('CMP AX,CX');
  EmitInstr('JLE ' + TP_RT_PFX + 'LN16_X13');
  EmitInstr('MOV CX,[BP-4]');
  EmitInstr('SUB [BP-10],CX');          { err -= dy }
  EmitInstr('ADD SI,[BP-6]');           { x += sx }
  EmitLabel(TP_RT_PFX + 'LN16_X13');
  { if e2 < dx : err += dx ; y += sy }
  EmitInstr('MOV CX,[BP-2]');           { CX = dx }
  EmitInstr('CMP AX,CX');
  EmitInstr('JGE ' + TP_RT_PFX + 'LN16_Y13');
  EmitInstr('ADD [BP-10],CX');          { err += dx }
  EmitInstr('ADD DI,[BP-8]');           { y += sy }
  EmitLabel(TP_RT_PFX + 'LN16_Y13');
  EmitInstr('JMP ' + TP_RT_PFX + 'LN16_L13');
  { --- Repli generique : INT 10h AH=0Ch par pixel ($A000/$B800/$B000 via BIOS) --- }
  EmitLabel(TP_RT_PFX + 'LN16_LGN');   { debut boucle generique }
  EmitInstr('MOV AH,0Ch');              { Write Graphics Pixel }
  EmitInstr('MOV AL,BYTE PTR [GR_COLOR]');
  EmitInstr('MOV BH,0');               { page 0 }
  EmitInstr('MOV CX,SI');              { CX = X }
  EmitInstr('MOV DX,DI');              { DX = Y }
  EmitInstr('INT 10h');
  { Test fin : SI=X2 et DI=Y2 ? }
  EmitInstr('CMP SI,[BP+6]');
  EmitInstr('JNE ' + TP_RT_PFX + 'LN16_CGN');
  EmitInstr('CMP DI,[BP+4]');
  EmitInstr('JE ' + TP_RT_PFX + 'LN16_END');
  EmitLabel(TP_RT_PFX + 'LN16_CGN');
  { e2 = 2*err }
  EmitInstr('MOV AX,[BP-10]');
  EmitInstr('SAL AX,1');                { e2 = 2*err }
  { if e2 > -dy : err -= dy ; x += sx }
  EmitInstr('MOV CX,[BP-4]');
  EmitInstr('NEG CX');                  { CX = -dy }
  EmitInstr('CMP AX,CX');
  EmitInstr('JLE ' + TP_RT_PFX + 'LN16_XGN');
  EmitInstr('MOV CX,[BP-4]');
  EmitInstr('SUB [BP-10],CX');          { err -= dy }
  EmitInstr('ADD SI,[BP-6]');           { x += sx }
  EmitLabel(TP_RT_PFX + 'LN16_XGN');
  { if e2 < dx : err += dx ; y += sy }
  EmitInstr('MOV CX,[BP-2]');           { CX = dx }
  EmitInstr('CMP AX,CX');
  EmitInstr('JGE ' + TP_RT_PFX + 'LN16_YGN');
  EmitInstr('ADD [BP-10],CX');          { err += dx }
  EmitInstr('ADD DI,[BP-8]');           { y += sy }
  EmitLabel(TP_RT_PFX + 'LN16_YGN');
  EmitInstr('JMP ' + TP_RT_PFX + 'LN16_LGN');
  { --- Epilogue commun --- }
  EmitLabel(TP_RT_PFX + 'LN16_END');
  EmitInstr('POP DI');
  EmitInstr('POP SI');
  EmitInstr('MOV SP,BP');               { libere les locaux }
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_LINETO : ligne depuis position courante (8086/DOS) ---------- }
  { Convention : [BP+6]=X (Word), [BP+4]=Y (Word)                             }
  { Trace de (GR_CPX,GR_CPY) vers (X,Y) puis met a jour la position courante  }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'LINETO');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  { Empiler les 4 parametres pour LINE : X1=GR_CPX, Y1=GR_CPY, X2=[BP+6], Y2=[BP+4] }
  EmitInstr('PUSH WORD PTR [GR_CPX]');  { X1 }
  EmitInstr('PUSH WORD PTR [GR_CPY]');  { Y1 }
  EmitInstr('PUSH WORD PTR [BP+6]');    { X2 }
  EmitInstr('PUSH WORD PTR [BP+4]');    { Y2 }
  EmitInstr('CALL ' + TP_RT_PFX + 'LINE');
  EmitInstr('ADD SP,8');                { nettoyer les 4 words }
  { Mettre a jour la position courante }
  EmitInstr('MOV AX,[BP+6]');
  EmitInstr('MOV WORD PTR [GR_CPX],AX');
  EmitInstr('MOV AX,[BP+4]');
  EmitInstr('MOV WORD PTR [GR_CPY],AX');
  EmitInstr('POP BP');
  EmitInstr('RET');

  { ------ _TPRT_LINEREL : ligne relative depuis position courante (8086/DOS) }
  { Convention : [BP+6]=Dx (Word), [BP+4]=Dy (Word)                          }
  { Trace de (GR_CPX,GR_CPY) vers (GR_CPX+Dx,GR_CPY+Dy)                     }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'LINEREL');
  EmitInstr('PUSH BP');
  EmitInstr('MOV BP,SP');
  EmitInstr('PUSH BX');                 { sauvegarde BX }
  { Calculer X2 = GR_CPX+Dx, Y2 = GR_CPY+Dy }
  EmitInstr('MOV AX,WORD PTR [GR_CPX]');
  EmitInstr('ADD AX,[BP+6]');           { AX = X2 }
  EmitInstr('MOV BX,WORD PTR [GR_CPY]');
  EmitInstr('ADD BX,[BP+4]');           { BX = Y2 }
  { Empiler les 4 parametres pour LINE : X1=GR_CPX, Y1=GR_CPY, X2=AX, Y2=BX }
  EmitInstr('PUSH WORD PTR [GR_CPX]');  { X1 }
  EmitInstr('PUSH WORD PTR [GR_CPY]');  { Y1 }
  EmitInstr('PUSH AX');                 { X2 }
  EmitInstr('PUSH BX');                 { Y2 }
  EmitInstr('CALL ' + TP_RT_PFX + 'LINE');
  EmitInstr('ADD SP,8');                { nettoyer les 4 words }
  { Mettre a jour la position courante avec X2 et Y2 }
  EmitInstr('MOV AX,WORD PTR [GR_CPX]');
  EmitInstr('ADD AX,[BP+6]');           { X2 = GR_CPX+Dx }
  EmitInstr('MOV WORD PTR [GR_CPX],AX');
  EmitInstr('MOV AX,WORD PTR [GR_CPY]');
  EmitInstr('ADD AX,[BP+4]');           { Y2 = GR_CPY+Dy }
  EmitInstr('MOV WORD PTR [GR_CPY],AX');
  EmitInstr('POP BX');
  EmitInstr('POP BP');
  EmitInstr('RET');
End;

{ ------------------------------------------------------------ }
{ EmitRuntimeAppleII : runtime minimal Apple II 6502.          }
{ Une seule routine : _TPRT_AII_PRSTR                          }
{   Entree : A = lo octet pointeur ASCIIZ, Y = hi octet         }
{   Imprime via JSR $FDED (COUT) en forcant bit 7 (convention   }
{   ROM Apple II) jusqu'au premier octet 0.                     }
{ Utilise la zero-page $06/$07 comme pointeur.                  }
{ ------------------------------------------------------------ }
Procedure EmitRuntimeAppleII;
Begin
  EmitBlankLine;
  If Opts.MSX Then
  Begin
    EmitComment('--- Runtime MSX (Z80, BIOS CHPUT $00A2) ---');
    { _TPRT_MSX_PRSTR : HL = pointeur ASCIIZ ; sortie via CHPUT          }
    {   loop: LD A,(HL) ; OR A ; RET Z ; CALL $00A2 ; INC HL ; JP loop  }
    EmitLabel('_TPRT_MSX_PRSTR');
    EmitInstr('LD A,(HL)');
    EmitInstr('OR A');
    EmitInstr('RET Z');
    EmitInstr('CALL $00A2');
    EmitInstr('INC HL');
    EmitInstr('JP _TPRT_MSX_PRSTR');
    Exit;
  End;
  If Opts.Adam Then
  Begin
    EmitComment('--- Runtime Coleco Adam (Z80, CP/M 2.2 BDOS @ 5) ---');
    { _TPRT_ADAM_PRSTR : HL = pointeur ASCIIZ ; sortie via BDOS fn 2     }
    {   loop: LD A,(HL) ; OR A ; RET Z ;                                 }
    {         PUSH HL ; LD E,A ; LD C,2 ; CALL 5 ; POP HL ;              }
    {         INC HL ; JP loop                                           }
    EmitLabel('_TPRT_ADAM_PRSTR');
    EmitInstr('LD A,(HL)');
    EmitInstr('OR A');
    EmitInstr('RET Z');
    EmitInstr('PUSH HL');
    EmitInstr('LD E,A');
    EmitInstr('LD C,2');
    EmitInstr('CALL 5');
    EmitInstr('POP HL');
    EmitInstr('INC HL');
    EmitInstr('JP _TPRT_ADAM_PRSTR');
    Exit;
  End;
  If Opts.TRS80 Then
  Begin
    EmitComment('--- Runtime TRS-80 Model I (Z80, ROM VDCHAR $0033) ---');
    { _TPRT_TRS80_PRSTR : HL = pointeur ASCIIZ ; sortie via VDCHAR ROM   }
    {   loop: LD A,(HL) ; OR A ; RET Z ; CALL $0033 ; INC HL ; JP loop  }
    EmitLabel('_TPRT_TRS80_PRSTR');
    EmitInstr('LD A,(HL)');
    EmitInstr('OR A');
    EmitInstr('RET Z');
    EmitInstr('CALL $0033');
    EmitInstr('INC HL');
    EmitInstr('JP _TPRT_TRS80_PRSTR');
    Exit;
  End;
  If Opts.CoCo3 Then
  Begin
    EmitComment('--- Runtime CoCo 3 (6809, BASIC CHROUT $A002) ---');
    { _TPRT_COCO3_PRSTR : X = pointeur ASCIIZ ; sortie via CHROUT       }
    {   loop: LDA ,X+ ; BEQ end ; JSR $A002 ; BRA loop ; end: RTS      }
    EmitLabel('_TPRT_COCO3_PRSTR');
    EmitInstr('LDA ,X+');
    EmitInstr('BEQ _TPRT_COCO3_PRSTR_E');
    EmitInstr('JSR $A002');
    EmitInstr('BRA _TPRT_COCO3_PRSTR');
    EmitLabel('_TPRT_COCO3_PRSTR_E');
    EmitInstr('RTS');
    Exit;
  End;
  If Opts.TO7 Then
  Begin
    EmitComment('--- Runtime Thomson TO7 (6809, BIOS PUTC $E803) ---');
    { _TPRT_TO7_PRSTR : X = pointeur ASCIIZ ; sortie via PUTC          }
    {   loop: LDA ,X+ ; BEQ end ; JSR $E803 ; BRA loop ; end: RTS      }
    EmitLabel('_TPRT_TO7_PRSTR');
    EmitInstr('LDA ,X+');
    EmitInstr('BEQ _TPRT_TO7_PRSTR_E');
    EmitInstr('JSR $E803');
    EmitInstr('BRA _TPRT_TO7_PRSTR');
    EmitLabel('_TPRT_TO7_PRSTR_E');
    EmitInstr('RTS');
    Exit;
  End;
  If Opts.C64 Then
  Begin
    EmitComment('--- Runtime C64 (6510/6502) ---');
    EmitLabel('_TPRT_AII_PRSTR');
    EmitInstr('STA $06');
    EmitInstr('STY $07');
    EmitInstr('LDY #0');
    EmitLabel('_TPRT_AII_PRSTR_L');
    EmitInstr('LDA ($06),Y');
    EmitInstr('BEQ _TPRT_AII_PRSTR_E');
    EmitInstr('JSR $FFD2');
    EmitInstr('INY');
    EmitInstr('BNE _TPRT_AII_PRSTR_L');
    EmitLabel('_TPRT_AII_PRSTR_E');
    EmitInstr('RTS');
    Exit;
  End;
  If Opts.NES Then
  Begin
    EmitComment('--- Runtime NES (6502/2A03, sortie via PPU 32x30) ---');
    { Conventions zero-page NES :                                      }
    {   $0A = cursor_x (0..31)                                          }
    {   $0B = cursor_y (0..29)                                          }
    {   $0C = sauvegarde Y dans _TPRT_NES_PUTC                          }
    {   $06,$07 = pointeur ASCIIZ pour _TPRT_AII_PRSTR                  }
    { Convention CHR-ROM : tile $XX correspond au caractere ASCII $XX  }
    { donc l octet ecrit dans la nametable EST le code ASCII du glyphe.}

    { _TPRT_NES_INIT : point d entree (vecteur RESET pointe ici).       }
    {   1) Init CPU + PPU                                               }
    {   2) Attente 2 vblanks pour que la PPU soit stable                }
    {   3) Init palette + nametable                                     }
    {   4) JSR _TPF_Main (programme utilisateur)                        }
    {   5) Active rendu BG, boucle infinie                              }
    EmitLabel('_TPRT_NES_INIT');
    EmitInstr('SEI');
    EmitInstr('CLD');
    EmitInstr('LDX #$FF');
    EmitInstr('TXS');
    EmitInstr('LDA #0');
    EmitInstr('STA $2000');     { PPUCTRL = 0 (NMI off) }
    EmitInstr('STA $2001');     { PPUMASK = 0 (rendu off) }
    EmitInstr('STA $4010');     { APU DMC off }
    { Attente premier vblank (bit 7 de $2002) }
    EmitLabel('_TPRT_NES_INIT_W1');
    EmitInstr('LDA $2002');
    EmitInstr('BPL _TPRT_NES_INIT_W1');
    { Init curseur }
    EmitInstr('LDA #0');
    EmitInstr('STA $0A');
    EmitInstr('STA $0B');
    { Attente second vblank }
    EmitLabel('_TPRT_NES_INIT_W2');
    EmitInstr('LDA $2002');
    EmitInstr('BPL _TPRT_NES_INIT_W2');
    { Palette : adresse PPU $3F00 }
    EmitInstr('LDA #$3F');
    EmitInstr('STA $2006');
    EmitInstr('LDA #$00');
    EmitInstr('STA $2006');
    EmitInstr('LDA #$0F');      { fond noir }
    EmitInstr('STA $2007');
    EmitInstr('LDA #$30');      { couleur 1 = blanc }
    EmitInstr('STA $2007');
    EmitInstr('STA $2007');
    EmitInstr('STA $2007');
    { Nametable + attributs : remplir 1024 octets a $2000 avec ' ' }
    EmitInstr('LDA #$20');
    EmitInstr('STA $2006');
    EmitInstr('LDA #$00');
    EmitInstr('STA $2006');
    EmitInstr('LDX #4');        { 4 pages }
    EmitInstr('LDY #0');
    EmitLabel('_TPRT_NES_INIT_C');
    EmitInstr('LDA #$20');      { tile espace = ASCII 32 }
    EmitInstr('STA $2007');
    EmitInstr('INY');
    EmitInstr('BNE _TPRT_NES_INIT_C');
    EmitInstr('DEX');
    EmitInstr('BNE _TPRT_NES_INIT_C');
    { Programme utilisateur }
    EmitInstr('JSR _TPF_Main');
    { Active le rendu BG, scroll a 0 }
    EmitInstr('LDA #0');
    EmitInstr('STA $2005');
    EmitInstr('STA $2005');
    EmitInstr('LDA #$08');      { show BG }
    EmitInstr('STA $2001');
    EmitInstr('LDA #0');
    EmitInstr('STA $2000');
    { Boucle infinie }
    EmitLabel('_TPRT_NES_HALT');
    EmitInstr('JMP _TPRT_NES_HALT');

    { _TPRT_NES_PUTC : A = caractere ASCII a imprimer.                 }
    { Preserve Y. CR ($0D) = nouvelle ligne.                            }
    EmitLabel('_TPRT_NES_PUTC');
    EmitInstr('STY $0C');
    EmitInstr('CMP #$0D');
    EmitInstr('BNE _TPRT_NES_PUTC_NCR');
    { CR : x=0, y++, wrap si y>=30 }
    EmitInstr('LDA #0');
    EmitInstr('STA $0A');
    EmitInstr('INC $0B');
    EmitInstr('LDA $0B');
    EmitInstr('CMP #30');
    EmitInstr('BCC _TPRT_NES_PUTC_END');
    EmitInstr('LDA #0');
    EmitInstr('STA $0B');
    EmitInstr('JMP _TPRT_NES_PUTC_END');
    EmitLabel('_TPRT_NES_PUTC_NCR');
    EmitInstr('PHA');
    { addr_hi = $20 + (cursor_y >> 3) }
    EmitInstr('LDA $0B');
    EmitInstr('LSR A');
    EmitInstr('LSR A');
    EmitInstr('LSR A');
    EmitInstr('CLC');
    EmitInstr('ADC #$20');
    EmitInstr('STA $2006');
    { addr_lo = ((cursor_y & 7) << 5) + cursor_x }
    EmitInstr('LDA $0B');
    EmitInstr('AND #$07');
    EmitInstr('ASL A');
    EmitInstr('ASL A');
    EmitInstr('ASL A');
    EmitInstr('ASL A');
    EmitInstr('ASL A');
    EmitInstr('CLC');
    EmitInstr('ADC $0A');
    EmitInstr('STA $2006');
    EmitInstr('PLA');
    EmitInstr('STA $2007');     { ecriture du tile = code ASCII }
    EmitInstr('INC $0A');
    EmitInstr('LDA $0A');
    EmitInstr('CMP #32');
    EmitInstr('BCC _TPRT_NES_PUTC_END');
    EmitInstr('LDA #0');
    EmitInstr('STA $0A');
    EmitInstr('INC $0B');
    EmitInstr('LDA $0B');
    EmitInstr('CMP #30');
    EmitInstr('BCC _TPRT_NES_PUTC_END');
    EmitInstr('LDA #0');
    EmitInstr('STA $0B');
    EmitLabel('_TPRT_NES_PUTC_END');
    EmitInstr('LDY $0C');
    EmitInstr('RTS');

    { _TPRT_AII_PRSTR : A = lo, Y = hi pointeur ASCIIZ                 }
    EmitLabel('_TPRT_AII_PRSTR');
    EmitInstr('STA $06');
    EmitInstr('STY $07');
    EmitInstr('LDY #0');
    EmitLabel('_TPRT_AII_PRSTR_L');
    EmitInstr('LDA ($06),Y');
    EmitInstr('BEQ _TPRT_AII_PRSTR_E');
    EmitInstr('JSR _TPRT_NES_PUTC');
    EmitInstr('INY');
    EmitInstr('BNE _TPRT_AII_PRSTR_L');
    EmitLabel('_TPRT_AII_PRSTR_E');
    EmitInstr('RTS');
    Exit;
  End;
  If Opts.Atari400 Or Opts.Atari800 Then
  Begin
    EmitComment('--- Runtime Atari 400/800 (6502, OS CIO via IOCB 0) ---');
    { _TPRT_ATARI_PUTC : A = octet ATASCII a imprimer (preserve Y).      }
    EmitLabel('_TPRT_ATARI_PUTC');
    EmitInstr('STA $0E');
    EmitInstr('STY $0F');
    EmitInstr('LDA #$0B');
    EmitInstr('STA $0342');
    EmitInstr('LDA #$00');
    EmitInstr('STA $0348');
    EmitInstr('STA $0349');
    EmitInstr('LDX #$00');
    EmitInstr('LDA $0E');
    EmitInstr('JSR $E456');
    EmitInstr('LDY $0F');
    EmitInstr('RTS');
    { _TPRT_AII_PRSTR : A = lo, Y = hi pointeur ASCIIZ                  }
    EmitLabel('_TPRT_AII_PRSTR');
    EmitInstr('STA $06');
    EmitInstr('STY $07');
    EmitInstr('LDY #0');
    EmitLabel('_TPRT_AII_PRSTR_L');
    EmitInstr('LDA ($06),Y');
    EmitInstr('BEQ _TPRT_AII_PRSTR_E');
    EmitInstr('STY $08');
    EmitInstr('JSR _TPRT_ATARI_PUTC');
    EmitInstr('LDY $08');
    EmitInstr('INY');
    EmitInstr('BNE _TPRT_AII_PRSTR_L');
    EmitLabel('_TPRT_AII_PRSTR_E');
    EmitInstr('RTS');
    Exit;
  End;
  EmitComment('--- Runtime Apple II (6502) ---');
  EmitLabel('_TPRT_AII_PRSTR');
  EmitInstr('STA $06');
  EmitInstr('STY $07');
  EmitInstr('LDY #0');
  EmitLabel('_TPRT_AII_PRSTR_L');
  EmitInstr('LDA ($06),Y');
  EmitInstr('BEQ _TPRT_AII_PRSTR_E');
  EmitInstr('ORA #$80');
  EmitInstr('JSR $FDED');
  EmitInstr('INY');
  EmitInstr('BNE _TPRT_AII_PRSTR_L');
  EmitLabel('_TPRT_AII_PRSTR_E');
  EmitInstr('RTS');
End;

{ ============================================================ }
{ EmitFileRuntime : fichiers Text et File par enregistrement    }
{ Chaque variable fichier occupe TFR_SIZE octets : handle,       }
{ tampon de lecture, indicateur de fin, taille d enregistrement, }
{ mode et nom ASCIIZ. Plusieurs fichiers peuvent etre ouverts    }
{ simultanement (l ancien runtime partageait un seul tampon et   }
{ un seul nom). Conventions : parametres empiles de gauche a     }
{ droite, le premier est donc le plus haut dans la pile.         }
{ ============================================================ }
Procedure EmitFileRuntime;
Begin
  EmitBlankLine;
  EmitComment(' RUNTIME FICHIERS : enregistrement TFR par variable Text/File ');
  EmitComment('_TPRT_ASSIGN : [EBP+12]=adresse fichier, [EBP+8]=nom ASCIIZ');
  EmitLabel(TP_RT_PFX + 'ASSIGN');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EBX,DWORD PTR [EBP+12]');
  EmitInstr('MOV DWORD PTR [EBX],-1');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFPOS) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_EOF) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_STD) + '],0');
  EmitInstr('MOV ESI,DWORD PTR [EBP+8]');
  EmitInstr('LEA EDI,[EBX+' + IntToStr_(TFR_NAME) + ']');
  EmitInstr('MOV ECX,259');
  EmitLabel(TP_RT_PFX + 'TF_AS_CP');
  EmitInstr('LODSB');
  EmitInstr('STOSB');
  EmitInstr('TEST AL,AL');
  EmitInstr('JZ ' + TP_RT_PFX + 'TF_AS_DN');
  EmitInstr('DEC ECX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'TF_AS_CP');
  EmitInstr('MOV BYTE PTR [EDI],0');
  EmitLabel(TP_RT_PFX + 'TF_AS_DN');
  EmitComment('copie aussi dans FILE_NAMEBUF (anciens usages)');
  EmitInstr('LEA ESI,[EBX+' + IntToStr_(TFR_NAME) + ']');
  EmitInstr('LEA EDI,[FILE_NAMEBUF]');
  EmitInstr('MOV ECX,260');
  EmitInstr('REP MOVSB');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_FOPEN : EBX=fichier, EAX=mode (1 Reset,2 Rewrite,3 Append), ECX=taille enreg.');
  EmitLabel(TP_RT_PFX + 'FOPEN');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],EAX');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_RECSIZE) + '],ECX');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFPOS) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_EOF) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_STD) + '],0');
  EmitInstr('CMP BYTE PTR [EBX+' + IntToStr_(TFR_NAME) + '],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_NAMED');
  EmitComment('nom vide : entree ou sortie standard');
  EmitInstr('MOV EDX,-11');
  EmitInstr('CMP EAX,1');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_STD');
  EmitInstr('MOV EDX,-10');
  EmitLabel(TP_RT_PFX + 'TF_FO_STD');
  EmitInstr('PUSH EDX');
  EmitInstr('CALL GetStdHandle');
  EmitInstr('MOV DWORD PTR [EBX],EAX');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_STD) + '],1');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'TF_FO_NAMED');
  EmitComment('acces : Reset texte = lecture ; Reset fichier = lecture+ecriture ; Rewrite = ecriture (+lecture si fichier)');
  EmitInstr('MOV ESI,80000000h');
  EmitInstr('MOV EDI,3');
  EmitInstr('CMP EAX,1');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_NR');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_RECSIZE) + '],0');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_FO_GO');
  EmitInstr('MOV ESI,0C0000000h');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_FO_GO');
  EmitLabel(TP_RT_PFX + 'TF_FO_NR');
  EmitInstr('MOV ESI,40000000h');
  EmitInstr('MOV EDI,2');
  EmitInstr('CMP EAX,2');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_AP');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_RECSIZE) + '],0');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_FO_GO');
  EmitInstr('MOV ESI,0C0000000h');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_FO_GO');
  EmitLabel(TP_RT_PFX + 'TF_FO_AP');
  EmitInstr('MOV EDI,4');
  EmitLabel(TP_RT_PFX + 'TF_FO_GO');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH 128');
  EmitInstr('PUSH EDI');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH 3');
  EmitInstr('PUSH ESI');
  EmitInstr('LEA EAX,[EBX+' + IntToStr_(TFR_NAME) + ']');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL CreateFileA');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_OK');
  EmitComment('echec en lecture+ecriture : reessayer en lecture seule');
  EmitInstr('CMP ESI,0C0000000h');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_ERR');
  EmitInstr('MOV ESI,80000000h');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_FO_GO');
  EmitLabel(TP_RT_PFX + 'TF_FO_ERR');
  EmitInstr('MOV DWORD PTR [FILE_IOERR],2');
  EmitInstr('MOV DWORD PTR [EBX],-1');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],0');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'TF_FO_OK');
  EmitInstr('MOV DWORD PTR [EBX],EAX');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],3');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_FO_DN');
  EmitInstr('PUSH 2');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL SetFilePointer');
  EmitLabel(TP_RT_PFX + 'TF_FO_DN');
  EmitInstr('RET');
  EmitComment('_TPRT_RESET : [EBP+12]=adresse fichier, [EBP+8]=taille enregistrement (0 = Text)');
  EmitLabel(TP_RT_PFX + 'RESET');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EBX,DWORD PTR [EBP+12]');
  EmitInstr('MOV ECX,DWORD PTR [EBP+8]');
  EmitInstr('MOV EAX,1');
  EmitInstr('CALL ' + TP_RT_PFX + 'FOPEN');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_REWRITE : [EBP+12]=adresse fichier, [EBP+8]=taille enregistrement (0 = Text)');
  EmitLabel(TP_RT_PFX + 'REWRITE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EBX,DWORD PTR [EBP+12]');
  EmitInstr('MOV ECX,DWORD PTR [EBP+8]');
  EmitInstr('MOV EAX,2');
  EmitInstr('CALL ' + TP_RT_PFX + 'FOPEN');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_APPEND : [EBP+8]=adresse fichier');
  EmitLabel(TP_RT_PFX + 'APPEND');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');
  EmitInstr('XOR ECX,ECX');
  EmitInstr('MOV EAX,3');
  EmitInstr('CALL ' + TP_RT_PFX + 'FOPEN');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_CLOSE : [EBP+8]=adresse fichier');
  EmitLabel(TP_RT_PFX + 'CLOSE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');
  { fichier non ouvert : erreur 103 (comme TP/FPC) }
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_CL_OP');
  EmitInstr('MOV DWORD PTR [FILE_IOERR],103');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_CL_DN');
  EmitLabel(TP_RT_PFX + 'TF_CL_OP');
  EmitInstr('MOV EAX,DWORD PTR [EBX]');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_CL_DN');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_STD) + '],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'TF_CL_DN');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL CloseHandle');
  EmitLabel(TP_RT_PFX + 'TF_CL_DN');
  EmitInstr('MOV DWORD PTR [EBX],-1');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFPOS) + '],0');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + '],0');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_FFILL : EBX=fichier ; remplit le tampon (256 octets), pose Eof si rien lu');
  EmitLabel(TP_RT_PFX + 'FFILL');
  EmitInstr('CALL ' + TP_RT_PFX + 'OFLUSH');
  EmitInstr('PUSH EAX');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH OFFSET FILE_BYTESRD');
  EmitInstr('PUSH 256');
  EmitInstr('LEA EAX,[EBX+' + IntToStr_(TFR_BUF) + ']');
  EmitInstr('PUSH EAX');
  EmitInstr('PUSH DWORD PTR [EBX]');
  EmitInstr('CALL ReadFile');
  EmitInstr('MOV EAX,DWORD PTR [FILE_BYTESRD]');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + '],EAX');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_BUFPOS) + '],0');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'TF_FF_DN');
  EmitInstr('MOV DWORD PTR [EBX+' + IntToStr_(TFR_EOF) + '],1');
  EmitLabel(TP_RT_PFX + 'TF_FF_DN');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('POP EAX');
  EmitInstr('RET');
  EmitComment('_TPRT_FPEEK : EBX=fichier -> EAX=caractere courant, EAX=-1 si fin de fichier');
  EmitLabel(TP_RT_PFX + 'FPEEK');
  EmitInstr('MOV EAX,DWORD PTR [EBX+' + IntToStr_(TFR_BUFPOS) + ']');
  EmitInstr('CMP EAX,DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + ']');
  EmitInstr('JB ' + TP_RT_PFX + 'TF_FP_GC');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_EOF) + '],1');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_FP_EOF');
  EmitInstr('CALL ' + TP_RT_PFX + 'FFILL');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_BUFEND) + '],0');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_FP_EOF');
  EmitInstr('XOR EAX,EAX');
  EmitLabel(TP_RT_PFX + 'TF_FP_GC');
  EmitInstr('LEA EDX,[EBX+' + IntToStr_(TFR_BUF) + ']');
  EmitInstr('ADD EDX,EAX');
  EmitInstr('MOVZX EAX,BYTE PTR [EDX]');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'TF_FP_EOF');
  EmitInstr('MOV EAX,-1');
  EmitInstr('RET');
  EmitComment('_TPRT_EOF_FILE : [EBP+8]=adresse fichier -> EAX=1 si fin de fichier');
  EmitLabel(TP_RT_PFX + 'EOF_FILE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  EmitInstr('PUSH ESI');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');
  EmitInstr('CALL ' + TP_RT_PFX + 'FCHKOPEN');   { fichier ferme : erreur 103 }
  EmitInstr('CMP DWORD PTR [EBX],-1');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_EF_YES');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_RECSIZE) + '],0');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_EF_TXT');
  EmitComment('fichier type ou non type : position courante >= taille');
  EmitInstr('PUSH 1');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH DWORD PTR [EBX]');
  EmitInstr('CALL SetFilePointer');
  EmitInstr('MOV ESI,EAX');
  EmitInstr('PUSH 0');
  EmitInstr('PUSH DWORD PTR [EBX]');
  EmitInstr('CALL GetFileSize');
  EmitInstr('CMP ESI,EAX');
  EmitInstr('JAE ' + TP_RT_PFX + 'TF_EF_YES');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_EF_NO');
  EmitLabel(TP_RT_PFX + 'TF_EF_TXT');
  EmitInstr('CALL ' + TP_RT_PFX + 'FPEEK');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_EF_YES');
  EmitLabel(TP_RT_PFX + 'TF_EF_NO');
  EmitInstr('XOR EAX,EAX');
  EmitInstr('JMP ' + TP_RT_PFX + 'TF_EF_DN');
  EmitLabel(TP_RT_PFX + 'TF_EF_YES');
  EmitInstr('MOV EAX,1');
  EmitLabel(TP_RT_PFX + 'TF_EF_DN');
  EmitInstr('POP ESI');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitComment('_TPRT_EOLN_FILE : [EBP+8]=adresse fichier -> EAX=1 si fin de ligne ou de fichier');
  EmitLabel(TP_RT_PFX + 'EOLN_FILE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');
  EmitInstr('CALL ' + TP_RT_PFX + 'FPEEK');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_EN_YES');
  EmitInstr('CMP AL,13');
  EmitInstr('JE ' + TP_RT_PFX + 'TF_EN_YES');
