        Else
          EmitInstr('PUSH ' + IntToStr_(RecSz));
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'RESET');
      EmitInstr('ADD ESP,8');
      EmitIoCheck;
