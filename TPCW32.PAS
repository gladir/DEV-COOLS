  EmitInstr('TEST ECX,ECX');
  EmitInstr('JZ ' + TP_RT_PFX + 'RS_F');
  EmitInstr('MOV EBX,ECX');
  EmitInstr('SUB EBX,EAX');
  EmitInstr('SUB EBX,5');
  EmitInstr('CMP EBX,1');
  EmitInstr('JGE ' + TP_RT_PFX + 'RS_D3');
  EmitInstr('MOV EBX,1');
  EmitLabel(TP_RT_PFX + 'RS_D3');
