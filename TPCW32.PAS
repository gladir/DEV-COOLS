Procedure ProcessArgument(S: TShortString);
Var Arg,Part: TShortString; P,ErrorCode: Integer; C: Char; AddressPart: Longint;
Begin
  If (S='--help') Or (S='/?') Or (S='-?') Or (S='-h') Or (S='/h') Then Begin
   Help; Halt(0)
  End
  Else If S='--quiet' Then Quiet:=True Else
  If Copy(S,1,14)='--inspect-tpu=' Then InspectName:=Copy(S,15,255) Else
  If Copy(S,1,14)='--inspect-tpl=' Then InspectLibraryName:=Copy(S,15,255) Else
  If (Length(S)>0) And (S[1] In ['/','-']) Then Begin
   If Length(S)<2 Then CLIError('Option vide');
   C:=UpCase(S[2]); Arg:=Copy(S,3,255);
   Case C Of
   '$':
   Begin
    If (Length(Arg)>0) And (UpCase(Arg[1])='M') Then            MemoryDirective(Copy(Arg,
    2,255))
    Else SetSwitch(Upper(Arg));
   End;
   'E':
   Begin
    If Arg='' Then CLIError('Repertoire /E manquant'); OutputDir:=Arg
   End;
   'U':
   Begin
    If Arg='' Then CLIError('Repertoire /U manquant'); UnitDirs:=Arg
   End;
   'T':
   Begin
    If Arg='' Then CLIError('Repertoire /T manquant'); TurboDirs:=Arg
   End;
   'Q':
   Begin
    If Arg<>'' Then CLIError('Option /Q incorrecte'); Quiet:=True
   End;
   'D':
   Begin
    Repeat
    P:=Pos(';',Arg);
    If P=0 Then Begin
     Part:=Arg; Arg:=''
    End
     Else
    Begin
     Part:=Copy(Arg,1,P-1); Delete(Arg,1,P)
    End;
    Define(Part);
    Until Arg='';
   End;
   'B':
   Begin
    If Arg<>'' Then CLIError('Option /B incorrecte'); BuildMode:=True
   End;
   'M':
   Begin
    If Arg<>'' Then CLIError('Option /M incorrecte'); MakeMode:=True
   End;
   'I':Begin If Arg='' Then CLIError('Repertoire /I manquant'); IncludeDirs:=Arg End;
   'G':Begin
    Arg:=Upper(Arg); If Arg='S' Then MapMode:=1 Else If Arg='P' Then MapMode:=2
    Else If Arg='D' Then Begin MapMode:=3; SetSwitch('D+'); SetSwitch('L+') End
    Else CLIError('Option /G attendue: /GS /GP /GD');
   End;
   'V':Begin
    If Not ((Arg='') Or (Arg='+') Or (Arg='-')) Then CLIError('Option /V incorrecte');
    DebugInExe:=Arg<>'-'; If DebugInExe Then Begin SetSwitch('D+'); SetSwitch('L+') End;
   End;
   'F':Begin
    P:=Pos(':',Arg); If P=0 Then CLIError('/F exige segment:offset hexadecimal');
    Val('$'+Copy(Arg,1,P-1),LookupAddress,ErrorCode); If (ErrorCode<>0) Or (LookupAddress<0) Or (LookupAddress>65535) Then CLIError('Segment /F invalide');
    LookupAddress:=LookupAddress*16;
    Val('$'+Copy(Arg,P+1,255),AddressPart,ErrorCode); If (ErrorCode<>0) Or (AddressPart<0) Or (AddressPart>65535) Then CLIError('Offset /F invalide');
    LookupAddress:=LookupAddress+AddressPart; LookupRequested:=True; SetSwitch('D+');
   End;
   'O':Begin If Arg='' Then CLIError('Repertoire /O manquant'); ObjectDirs:=Arg End;
   'L':Begin
    { Tampon de liaison sur disque: l'image est deja construite en memoire
      hote, l'option est acceptee sans effet comme sur un PC bien dote. }
    If Arg<>'' Then CLIError('Option /L incorrecte');
   End;
   Else CLIError('Option inconnue: '+S);
  End;
 End Else
 Begin
  If InputName<>'' Then CLIError('Un seul fichier source attendu'); InputName:=S;
 End;
End;

Procedure ParseArguments;
Var I,J,Sep,Err: Integer; Config: Text; S,WordText,Path,Search,Part: TShortString;
 D: DirStr; N: NameStr; E: ExtStr; Quoted: Boolean;
Begin
 If EngineArgCount=0 Then Begin Help; Halt(0) End;
 Search:='.;';
 For I:=1 To EngineArgCount Do Begin
  S:=EngineArg(I);
  If (Length(S)>2) And (S[1] In ['/','-']) And (UpCase(S[2])='T') Then Search:=Search+Copy(S,3,255)+';';
 End;
 FSplit(EngineArg(0),D,N,E); Search:=Search+D; Path:='';
 Repeat
  Sep:=Pos(';',Search);
  If Sep=0 Then Begin Part:=Search; Search:='' End
  Else Begin Part:=Copy(Search,1,Sep-1); Delete(Search,1,Sep) End;
  Path:=JoinPath(Part,'TPC.CFG'); If FileExists(Path) Then Break; Path:='';
 Until Search='';
 If Path<>'' Then Begin
  Assign(Config,Path); {$I-} Reset(Config); Err:=IOResult; {$I+}
  If Err<>0 Then CLIError('Lecture TPC.CFG impossible');
  While Not Eof(Config) Do Begin
   ReadLn(Config,S); S:=Trim(S);
   If (S<>'') And (S[1]<>'#') Then Begin
    J:=1;
    While J<=Length(S) Do Begin
     While (J<=Length(S)) And (S[J]<=' ') Do Inc(J);
     WordText:=''; Quoted:=False;
     While J<=Length(S) Do Begin
      If S[J]='"' Then Quoted:=Not Quoted
      Else If (S[J]<=' ') And Not Quoted Then Break
      Else AppendChar(WordText,S[J]);
      Inc(J);
     End;
     If Quoted Then CLIError('Guillemet TPC.CFG non termine');
     If WordText<>'' Then Begin
      If Not (WordText[1] In ['/','-']) Then CLIError('TPC.CFG contient un nom de source');
      ProcessArgument(WordText);
     End;
    End;
   End;
  End;
  Close(Config);
 End;
 For I:=1 To EngineArgCount Do ProcessArgument(EngineArg(I));
End;

Procedure CheckLayout;
Var
 Actual: Word;
Begin
 Actual:=SizeOf(TUnitHeader);
 If Actual<>TPUHeaderSize Then CLIError('Disposition en-tete TPU incompatible');
 Actual:=SizeOf(TTypeDescriptor);
 If Actual<>6 Then CLIError('Disposition descripteur incompatible');
 Actual:=SizeOf(TSymbolPrefix);
 If Actual<>4 Then CLIError('Disposition symbole incompatible');
 Actual:=SizeOf(TTPUFixup);
 If Actual<>8 Then CLIError('Disposition fixup incompatible');
 Actual:=SizeOf(TShortString);
 If Actual<>256 Then CLIError('Disposition shortstring incompatible');
End;

Var
 D: DirStr;
 N: NameStr;
 E: ExtStr;

Function ClockHundredths: Longint;
Var H,M,S,C: Word;
Begin
 GetTime(H,M,S,C);
 ClockHundredths:=((Longint(H)*60+M)*60+S)*100+C;
End;

Procedure Summary(CodeBytes,DataBytes: Longint);
{ Ligne de resume de TPC 7.0: "n lines, s seconds, c bytes code, d bytes data." }
Var Elapsed: Longint;
Begin
 Elapsed:=ClockHundredths-StartTime;
 If Elapsed<0 Then Inc(Elapsed,Longint(24)*60*60*100);
 WriteLn(TpTotalLines,' lignes, ',Elapsed Div 100,'.',(Elapsed Mod 100) Div 10,' secondes, ',
  CodeBytes,' octets de code, ',DataBytes,' octets de donnees.');
End;

Procedure TpcEngineMain;
Begin
  { Structures fixes du format TPU, verifier avant toute lecture binaire. }
 CheckLayout;
 StartTime:=ClockHundredths; TpTotalLines:=0;
 StackSize:=16384; MinHeap:=0; MaxHeap:=$FFFF;
 OptionBits:=$171D; { defauts TPC 7.0: A+ D+ E+ I+ L+ S+ V+ X+; B F G N O P Q R T desactives }
 TokenLine:=1; TokenColumn:=1;
 Case EngineTPVersion Of 4:Define('VER40'); 5:Define('VER50'); 55:Define('VER55'); 6:Define('VER60'); Else Define('VER70') End; Define('MSDOS'); Define('CPU86');
 Banner;
 ParseArguments;
 If InspectName<>'' Then Begin
  SourceName:=InspectName; InspectTPU; Halt(0)
 End;
 If InspectLibraryName<>'' Then Begin
  SourceName:=InspectLibraryName; InspectLibrary; Halt(0)
 End;
 If InputName='' Then CLIError('Fichier source manquant');
 SourceName:=InputName; FSplit(SourceName,D,N,E);
 If E='' Then SourceName:=SourceName+'.PAS';
 MainSourceName:=SourceName;
 FindAndReadLibrary;
 Move(Defines,InitialDefines,SizeOf(Defines)); InitialDefineCount:=TpDefineCount;
 InitialOptions:=OptionBits;
 LoadSource; CompileProgram; LoadObjects; WriteUnits;
 If Not UnitOutput Then Begin
  LinkNative; PrepareOverlays; WriteExecutable
 End;
 Summary(CodeSize,DataSize+BssSize);
End;
{$A+}{$I-}
{ === FIN MOTEUR TPC === }

Procedure RunTpcEngine;
  Procedure AddArg(Const A : TString);
  Begin
    If EngineArgCount < 64 Then
    Begin Inc(EngineArgCount); EngineArgs[EngineArgCount] := A; End;
  End;
Begin
  EngineArgCount := 0;
  EngineTPVersion := Opts.TPVersion;
  If Opts.Quiet Then AddArg('-Q');
  If Opts.BuildAll Then AddArg('-B');
  If Opts.MakeUnits Then AddArg('-M');
  If Opts.LinkDisk Then AddArg('-L');
  If Opts.DebugInfo Then AddArg('-V');
  If Opts.MapDetailed Then AddArg('-GD');
  If Opts.MapPublics Then AddArg('-GP');
  If Opts.MapSegments Then AddArg('-GS');
  If Opts.Defines <> '' Then AddArg('-D' + Opts.Defines);
  If Opts.ExeDir <> '' Then AddArg('-E' + Opts.ExeDir);
  If Opts.FindErr <> '' Then AddArg('-F' + Opts.FindErr);
  If Opts.IncDirs <> '' Then AddArg('-I' + Opts.IncDirs);
  If Opts.ObjDirs <> '' Then AddArg('-O' + Opts.ObjDirs);
  If Opts.ResDirs <> '' Then AddArg('-R' + Opts.ResDirs);
  If Opts.TurboDir <> '' Then AddArg('-T' + Opts.TurboDir);
  If Opts.UnitDirs <> '' Then AddArg('-U' + Opts.UnitDirs);
  If Opts.CompDir <> '' Then AddArg('-$' + Opts.CompDir);
  AddArg(Opts.SrcFile);
  TpcEngineMain;
End;

Procedure Run;
Begin
  { -CD : moteur TPC integre, sauf --dos-native et les modes QuickPascal,
    Apple Pascal et SANE (unites MSGraph, SANE, TRANSCEND) qui restent
    traites par le generateur interne comme auparavant. }
  If (Opts.DestTarget = DEST_DOSR) And Not Opts.DosNative And
     Not Opts.QuickPascal And Not Opts.ApplePascal And Not Opts.Sane Then
  Begin
    RunTpcEngine;
    Exit;
  End;
  ShowBanner;

  { Ouvrir le fichier source }
  Assign(LexSrcF, Opts.SrcFile);
  {$I-}
  Reset(LexSrcF);
  {$I+}
  If IOResult <> 0 Then
    FatalError('impossible d''ouvrir le fichier source: ' + Opts.SrcFile);
  LexOpened := True;
  LexSrcFName := Opts.SrcFile;

  { Initialiser le pool de donnees et le pool de tokens (TODO 04) }
  DataInit;
  TokenPoolInit;

  { Initialiser la table des symboles (TODO 05) }
  SymInit;

  { Initialiser le systeme de types (TODO 06) }
  TypeInit;

  { Enregistrer le type SearchRec apres TypeInit (TypeAdd disponible) }
  RegisterSearchRecType;

  { Enregistrer le type DateTime apres TypeInit }
  RegisterDateTimeType;

  { Enregistrer le type _VideoConfig de MSGraph }
  RegisterVideoConfigType;

  { Initialiser le preprocesseur }
  PPInitDefines;

  { Initialiser le lexeur et scanner les tokens dans le pool }
  LexInit;
  Repeat
    LexNextToken;
    If CurToken.Kind <> TK_EOF Then
      TokenPoolAdd(CurToken);
  Until CurToken.Kind = TK_EOF;

  { Enregistrer toutes les chaines dans le pool de donnees }
  TokenPoolRegisterStrings;

  If Opts.Verbose Then
    WriteLn('  Tokens: ', TokenCount, '  Donnees: ', DataCount,
            '  Symboles: ', SymCount, '  Types: ', TypeCount);

  { Initialiser les variables de l emetteur (TODO 07) }
  HasProgram := False;
  IsUnitSource := False;
  UnitSourceName := '';
  DataEmittedCount := 0;
  EmitLabelSeq := 0;
  StaticVarSeq := 0;

  { Analyser la clause Uses (TODO 26) }
  ParseUsesClause;

  { Si c est une unite, ajuster le fichier de sortie en .TPU (TODO 27) }
  If IsUnitSource Then
  Begin
    If Opts.Verbose Then
      WriteLn('  Mode unite : pas de generation d''executable');
    { Si le fichier de sortie est .exe, le changer en .tpu }
    If StrUpperCase(ExtractExt(Opts.OutFile)) = '.EXE' Then
      Opts.OutFile := ReplaceExt(Opts.OutFile, '.tpu');
  End;

  { Analyser les declarations TYPE (TODO 15) }
  ParseTypeDecls;

  { Analyser les declarations globales VAR et CONST (TODO 08) }
  ParseDataDecls;

  If Opts.Verbose Then
    WriteLn('  Apres ParseDataDecls: Donnees=', DataCount,
            '  Symboles=', SymCount);

  { Analyser les declarations PROCEDURE et FUNCTION (TODO 09) }
  ParseProcDecls;

  If Opts.Verbose Then
    WriteLn('  Apres ParseProcDecls: Procedures=', ProcCount,
            '  Symboles=', SymCount);

  { Generation du code Win32 : pipeline d emission (texte ASM + binaire PE) }
  { La pipeline s execute si -asm est demande OU si un PE doit etre genere }
  If (Not Opts.Dos16Mode) And
     (Opts.AsmOutput Or ((Not Opts.ObjOnly) And (Not IsUnitSource))) Then
  Begin
    { Initialiser la generation binaire si un PE est requis }
    If (Not Opts.ObjOnly) And (Not IsUnitSource) Then
    Begin
      BcInit;
      BcActive := True;
    End;

    { Ouvrir le fichier ASM texte si demande (TODO 07) }
    If Opts.AsmOutput Then
      EmitOpen(ReplaceExt(Opts.OutFile, '.asm'));

    EmitHeader;
    EmitDataSeg;
    EmitCodeSeg;

    { Emettre les procedures et fonctions (TODO 09) }
    EmitProcedures;

    { Emettre le bloc principal (TODO 09) - seulement pour les programmes }
    If Not IsUnitSource Then
      EmitMainBlock;

    { Emettre les donnees ajoutees tardivement (cible 6502 Apple II / C64 / MSX) }
    If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
      EmitDataSegLate;

    { Emettre les routines runtime (TODO 12) }
    If (Opts.DestTarget = DEST_DOSR) Or (Opts.DestTarget = DEST_DOSP) Then
      EmitRuntimeDOS
    Else If Opts.DestTarget = DEST_AMIGA Then
      EmitRuntimeAmiga
    Else If Is68kTarget Then
      EmitRuntime68000
    Else If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
      EmitRuntimeAppleII
    Else
      EmitRuntime;

    { Emettre les routines runtime supplementaires (pas en mode DOS ni 68000) }
    If (Opts.DestTarget <> DEST_DOSR) And (Opts.DestTarget <> DEST_DOSP) And
       (Not Is68kTarget) And (Not Opts.AppleII) And (Not Opts.C64) And
       (Not Opts.MSX) And (Not Opts.CoCo3) And (Not Opts.TO7) And (Not Opts.Adam) And (Not Opts.TRS80) And
       (Not Opts.Atari400) And (Not Opts.Atari800) Then
    Begin
      { Emettre les routines runtime Graph (TODO 20) }
      EmitGraphRuntime;

      { Emettre les routines runtime Strings/Overlay (TODO 21) }
      EmitStringsRuntime;

      { Emettre les routines runtime Objects (TODO 21) }
      EmitObjectsRuntime;

      { Emettre les routines runtime Mem/Port (TODO 22) }
      EmitMemPortRuntime;

      { Emettre les routines runtime interruptions (TODO 23) }
      EmitIntrRuntime;
    End;

    If Opts.AsmOutput Then
    Begin
      EmitClose;
      If Opts.Verbose Then
        WriteLn('  ASM genere : ', ReplaceExt(Opts.OutFile, '.asm'));
    End;

    BcActive := False;
  End;

  { Generation du fichier .ASM DOS 16 bits si -dos16 et -asm (TODO 24) }
  If Opts.Dos16Mode And Opts.AsmOutput Then
  Begin
    EmitOpen(ReplaceExt(Opts.OutFile, '.asm'));
    EmitHeaderDos16;
    EmitDataSegDos16;
    { Emettre le bloc principal seulement pour les programmes (TODO 27) }
    If Not IsUnitSource Then
      EmitMainBlockDos16;
    { Note: EmitClose n est pas appele car EmitMainBlockDos16 ecrit END }
    If OutFOpen Then Begin Close(OutF); OutFOpen := False End;
    If Opts.Verbose Then
      WriteLn('  ASM DOS 16 bits genere : ', ReplaceExt(Opts.OutFile, '.asm'));
  End;

  { Generation du fichier PE (TODO 24) - seulement pour les programmes (TODO 27) }
  If (Not Opts.ObjOnly) And (Not Opts.Dos16Mode) And (Not IsUnitSource) Then
  Begin
    BcBuildData;  { Apres toute emission pour capturer tous les DataTab }
    If (Opts.DestTarget = DEST_DOSR) Or (Opts.DestTarget = DEST_DOSP) Then
    Begin
      WriteMZFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  MZ DOS EXE genere : ', Opts.OutFile);
    End
    Else If Opts.DestTarget = DEST_AMIGA Then
    Begin
      WriteAmigaHunkFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Amiga Hunk genere : ', Opts.OutFile);
      { Generer egalement un .s19 (S-Record Motorola) pour les emulateurs }
      WriteSRecordFile(ReplaceExt(Opts.OutFile, '.s19'));
      If Opts.Verbose Then
        WriteLn('  S-Record genere  : ',
          ReplaceExt(Opts.OutFile, '.s19'));
    End
    Else If Is68kTarget Then
    Begin
      WritePRGFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Atari ST PRG genere : ', Opts.OutFile);
      { Generer egalement un .s19 (S-Record Motorola) pour les emulateurs }
      WriteSRecordFile(ReplaceExt(Opts.OutFile, '.s19'));
      If Opts.Verbose Then
        WriteLn('  S-Record genere  : ',
          ReplaceExt(Opts.OutFile, '.s19'));
    End
    Else If Opts.AppleII Then
    Begin
      WriteAppleBinFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Apple II BIN genere : ', Opts.OutFile);
    End
    Else If Opts.C64 Then
    Begin
      WriteC64PrgFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Commodore 64 PRG genere : ', Opts.OutFile);
    End
    Else If Opts.CoCo3 Then
    Begin
      WriteCoCo3BinFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  CoCo 3 BIN genere : ', Opts.OutFile);
    End
    Else If Opts.TO7 Then
    Begin
      WriteTO7BinFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Thomson TO7 BIN genere : ', Opts.OutFile);
    End
    Else If Opts.TRS80 Then
    Begin
      WriteTRS80CmdFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  TRS-80 Model I CMD genere : ', Opts.OutFile);
    End
    Else If Opts.Atari400 Then
    Begin
      WriteAtari400XexFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Atari 400 XEX genere : ', Opts.OutFile);
    End
    Else If Opts.Atari800 Then
    Begin
      WriteAtari400XexFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Atari 800 XEX genere : ', Opts.OutFile);
    End
    Else If Opts.MSX Then
    Begin
      WriteMsxComFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  MSX-DOS COM genere : ', Opts.OutFile);
    End
    Else If Opts.NES Then
    Begin
      WriteNesRomFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  NES ROM (iNES) genere : ', Opts.OutFile);
    End
    Else If Opts.Atari2600 Then
    Begin
      WriteAtari2600RomFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Atari 2600 VCS ROM genere : ', Opts.OutFile);
    End
    Else If Opts.Adam Then
    Begin
      WriteMsxComFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Coleco Adam CP/M COM genere : ', Opts.OutFile);
    End
    Else If Opts.Cray1 Then
    Begin
      WriteCray1AbsFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  Cray-1 COS Absolute Binary genere : ', Opts.OutFile);
    End
    Else
    Begin
      WritePEFile(Opts.OutFile);
      If Opts.Verbose Then
        WriteLn('  PE Win32 genere : ', Opts.OutFile);
    End;
  End;

  { Generation du fichier COFF pour les unites Win32 (TODO 27) }
  If (Not Opts.Dos16Mode) And IsUnitSource Then
  Begin
    WriteCOFFFile(ReplaceExt(Opts.OutFile, '.obj'));
    If Opts.Verbose Then
      WriteLn('  Unite COFF OBJ genere : ', ReplaceExt(Opts.OutFile, '.obj'));
  End;

  { Generation du fichier COFF (TODO 24) }
  If Opts.ObjOnly And (Not IsUnitSource) Then
  Begin
    WriteCOFFFile(Opts.OutFile);
    If Opts.Verbose Then
      WriteLn('  COFF OBJ genere : ', Opts.OutFile);
  End;

  { Generation du fichier TPU pour les unites DOS 16 bits (TODO 27) }
  If Opts.Dos16Mode And IsUnitSource Then
  Begin
    If Opts.Verbose Then
      WriteLn('  Unite TPU genere : ', Opts.OutFile);
  End;

  LexClose;
  ShowStats;
End;

{ ============================================================ }
{ PROGRAMME PRINCIPAL                                          }
{ ============================================================ }

BEGIN
  ErrorCount := 0;
  WarnCount  := 0;
  TotalLines := 0;
  OutFOpen   := False;

  ParseArgs;
  Run;
  Cleanup;
  Halt(EXIT_OK);
END.
