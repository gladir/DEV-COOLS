    { MOVETO(X, Y) }
    If Up = 'MOVETO' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);  EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);  EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('POP ECX');  { Y }
      EmitInstr('MOV DWORD PTR [GR_CPY],ECX');
      EmitInstr('POP ECX');  { X }
      EmitInstr('MOV DWORD PTR [GR_CPX],ECX');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
