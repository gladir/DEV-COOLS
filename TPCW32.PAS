Procedure WriteNesRomFile(FileName: TString);
Const
  PRG_BLOCK_SIZE = 16384; { 16 KB }
  CHR_BLOCK_SIZE = 8192;  {  8 KB }
  ENTRY_ADDR     = $8000;
Var
  F: File;
  TextLen, DataLen, DataBase, Payload, PrgSize: LongInt;
  Header: Array[0..15] Of Byte;
  Prg: Array Of Byte;
  ChrRom: Array[0..8191] Of Byte;
  PrgBlocks: Byte;
  EntryOfs: LongInt;
  EntryAddr: LongInt;
  I, ChIdx, Row: LongInt;
Begin
  { Patcher le JMP au tout debut (3 octets reserves par EmitCodeSeg).   }
  { Cible = _TPRT_NES_INIT (init PPU + appel _TPF_Main + halt).         }
  { Si absent (programme custom), retomber sur _TPF_Main.                }
  EntryOfs := BcFindLabel('_TPRT_NES_INIT');
  If EntryOfs < 0 Then EntryOfs := BcFindLabel('_TPF_Main');
  If (EntryOfs > 0) And (BcCodeLen >= 3) Then
  Begin
    EntryAddr := ENTRY_ADDR + EntryOfs;
    BcCode[0] := $4C; { JMP abs }
    BcCode[1] := Byte(EntryAddr);
    BcCode[2] := Byte(EntryAddr Shr 8);
  End;

  TextLen := BcCodeLen;
  DataLen := BcDataLen;
  DataBase := (TextLen + 3) And Not 3;
  Payload := DataBase + DataLen;
  If Payload < TextLen Then Payload := TextLen;
  If Payload < 1 Then Payload := 1;

  { Resoudre les fixups 6502 maintenant que le layout est fige.        }
  { Code et data sont concatenes a partir de $8000 dans la PRG-ROM.    }
  BcResolveFixups6502(ENTRY_ADDR, DataBase);

  { Calcule le nombre de blocs 16 KB necessaires (au moins 1) }
  PrgBlocks := 1;
  While (LongInt(PrgBlocks) * PRG_BLOCK_SIZE) < (Payload + 6) Do
    Inc(PrgBlocks);
  PrgSize := LongInt(PrgBlocks) * PRG_BLOCK_SIZE;

  { Construit le PRG-ROM }
  SetLength(Prg, PrgSize);
  For I := 0 To PrgSize - 1 Do Prg[I] := $FF;
  For I := 0 To TextLen - 1 Do Prg[I] := BcCode[I];
  For I := 0 To DataLen - 1 Do Prg[DataBase + I] := BcData[I];

  { Vecteurs NMI/RESET/IRQ a la fin du dernier bloc }
  Prg[PrgSize - 6] := ENTRY_ADDR And $FF;
  Prg[PrgSize - 5] := (ENTRY_ADDR Shr 8) And $FF;
  Prg[PrgSize - 4] := ENTRY_ADDR And $FF;
  Prg[PrgSize - 3] := (ENTRY_ADDR Shr 8) And $FF;
  Prg[PrgSize - 2] := ENTRY_ADDR And $FF;
  Prg[PrgSize - 1] := (ENTRY_ADDR Shr 8) And $FF;

  { Construit la CHR-ROM 8 KB. Chaque tile = 16 octets (8 plan 0 + 8   }
  { plan 1). On place le glyphe ASCII C a l offset C*16 dans le plan 0,}
  { plan 1 a zero (monochrome). Resultat : la valeur ecrite dans la   }
  { nametable EST le code ASCII du caractere a afficher.               }
  FillChar(ChrRom, 8192, 0);
  For ChIdx := 32 To 127 Do
    For Row := 0 To 7 Do
      ChrRom[ChIdx * 16 + Row] := NesFontTiles[ChIdx - 32, Row];

  { Header iNES }
  FillChar(Header, 16, 0);
  Header[0] := Ord('N');
  Header[1] := Ord('E');
  Header[2] := Ord('S');
  Header[3] := $1A;
  Header[4] := PrgBlocks;  { PRG en blocs 16 KB }
  Header[5] := 1;          { 1 bloc CHR-ROM (8 KB) }
  Header[6] := $00;        { mapper 0 (NROM), mirroring horizontal }
  Header[7] := $00;

  Assign(F, FileName);
  Rewrite(F, 1);
  BlockWrite(F, Header, 16);
  BlockWrite(F, Prg[0], PrgSize);
  BlockWrite(F, ChrRom, 8192);
  Close(F);
End;

Procedure WriteMsxComFile(FileName: TString);
Const
  MSX_LOAD_ADDR = $0100;
Var
  F: File;
  TextLen, DataLen, DataBase: LongInt;
  PadLen: LongInt;
  PadByte: Byte;
Begin
  TextLen := BcCodeLen;
  DataLen := BcDataLen;
  DataBase := (TextLen + 3) And Not 3;

  { Resoudre les fixups Z80 (memes encodages 16 bits LE que 6502) }
  BcResolveFixups6502(MSX_LOAD_ADDR, DataBase);

  Assign(F, FileName);
  Rewrite(F, 1);
  If TextLen > 0 Then
    BlockWrite(F, BcCode[0], TextLen);
  PadByte := 0;
  PadLen := DataBase - TextLen;
  While PadLen > 0 Do
  Begin BlockWrite(F, PadByte, 1); Dec(PadLen); End;
  If DataLen > 0 Then
    BlockWrite(F, BcData[0], DataLen);
  Close(F);
End;

Procedure WriteAtari400XexFile(FileName: TString);
Const
  ATARI_LOAD_ADDR = $2000;
  ATARI_RUN_VEC   = $02E0;
Var
  F: File;
  TextLen, DataLen, DataBase, TotalLen: LongInt;
  PadLen: LongInt;
  PadByte: Byte;
  EndAddr: Word;
  EntryOfs: LongInt;
  EntryAddr: LongInt;
  Magic: Array[0..1] Of Byte;
  SegHdr: Array[0..3] Of Byte;
  RunSeg: Array[0..5] Of Byte;
Begin
  { Patcher le JMP _TPF_Main au tout debut (3 octets reserves par   }
  { EmitCodeSeg pour les cibles 6502).                              }
  EntryOfs := BcFindLabel('_TPF_Main');
  If (EntryOfs > 0) And (BcCodeLen >= 3) Then
  Begin
    EntryAddr := ATARI_LOAD_ADDR + EntryOfs;
    BcCode[0] := $4C; { JMP abs }
    BcCode[1] := Byte(EntryAddr);
    BcCode[2] := Byte(EntryAddr Shr 8);
  End;

  TextLen := BcCodeLen;
  DataLen := BcDataLen;
  DataBase := (TextLen + 3) And Not 3;
  TotalLen := DataBase + DataLen;
  If TotalLen < TextLen Then TotalLen := TextLen;
  If TotalLen < 1 Then TotalLen := 1;

  { Resoudre les fixups 6502 maintenant que le layout est fige }
  BcResolveFixups6502(ATARI_LOAD_ADDR, DataBase);

  EndAddr := (ATARI_LOAD_ADDR + TotalLen - 1) And $FFFF;

  { Magic $FF $FF }
  Magic[0] := $FF;
  Magic[1] := $FF;

  { Segment principal : start LE + end LE }
  SegHdr[0] := ATARI_LOAD_ADDR And $FF;
  SegHdr[1] := (ATARI_LOAD_ADDR Shr 8) And $FF;
  SegHdr[2] := EndAddr And $FF;
  SegHdr[3] := (EndAddr Shr 8) And $FF;

  { Segment RUN : $02E0 $02E1 + entry LE }
  RunSeg[0] := ATARI_RUN_VEC And $FF;
  RunSeg[1] := (ATARI_RUN_VEC Shr 8) And $FF;
  RunSeg[2] := (ATARI_RUN_VEC + 1) And $FF;
  RunSeg[3] := ((ATARI_RUN_VEC + 1) Shr 8) And $FF;
  RunSeg[4] := ATARI_LOAD_ADDR And $FF;
  RunSeg[5] := (ATARI_LOAD_ADDR Shr 8) And $FF;

  Assign(F, FileName);
  Rewrite(F, 1);
  BlockWrite(F, Magic, 2);
  BlockWrite(F, SegHdr, 4);
  If TextLen > 0 Then
    BlockWrite(F, BcCode[0], TextLen);
  PadByte := 0;
  PadLen := DataBase - TextLen;
  While PadLen > 0 Do
  Begin BlockWrite(F, PadByte, 1); Dec(PadLen); End;
  If DataLen > 0 Then
    BlockWrite(F, BcData[0], DataLen);
  BlockWrite(F, RunSeg, 6);
  Close(F);
End;

Procedure WriteTRS80CmdFile(FileName: TString);
Const
  TRS80_LOAD_ADDR = $5200;
Var
  F: File;
  TextLen, DataLen, DataBase, TotalLen: LongInt;
  PadLen, Remaining, ChunkLen, Pos: LongInt;
  PadByte: Byte;
  CurAddr: Word;
  Header: Array[0..3] Of Byte;
  Tail: Array[0..3] Of Byte;
  Buf: Array[0..255] Of Byte;
  I: LongInt;
Begin
  TextLen := BcCodeLen;
  DataLen := BcDataLen;
  DataBase := (TextLen + 3) And Not 3;
  TotalLen := DataBase + DataLen;
  If TotalLen < TextLen Then TotalLen := TextLen;

  { Resoudre les fixups Z80 (little-endian, code et data sont charges }
  { contigus a TRS80_LOAD_ADDR via les chunks $01).                   }
  BcResolveFixups6502(TRS80_LOAD_ADDR, DataBase);

  Assign(F, FileName);
  Rewrite(F, 1);

  CurAddr := TRS80_LOAD_ADDR;
  Pos := 0;
  Remaining := TotalLen;
  While Remaining > 0 Do
  Begin
    { Limite a 254 octets de data par chunk : LL = data + 2 (adresse) }
    { reste dans la plage 3..255, evitant l'ambiguite LL=0/1/2 des     }
    { loaders TRSDOS/LDOS.                                             }
    If Remaining > 254 Then ChunkLen := 254 Else ChunkLen := Remaining;
    { Construire le chunk en lisant code, padding, data }
    For I := 0 To ChunkLen - 1 Do
    Begin
      If (Pos + I) < TextLen Then
        Buf[I] := BcCode[Pos + I]
      Else If (Pos + I) < DataBase Then
        Buf[I] := 0
      Else
        Buf[I] := BcData[(Pos + I) - DataBase];
    End;
    Header[0] := $01;
    Header[1] := (ChunkLen + 2) And $FF;
    Header[2] := CurAddr And $FF;
    Header[3] := (CurAddr Shr 8) And $FF;
    BlockWrite(F, Header, 4);
    BlockWrite(F, Buf, ChunkLen);
    Inc(CurAddr, ChunkLen);
    Inc(Pos, ChunkLen);
    Dec(Remaining, ChunkLen);
  End;

  { Terminateur : $02 $02 entry(LE) }
  Tail[0] := $02;
  Tail[1] := $02;
  Tail[2] := TRS80_LOAD_ADDR And $FF;
  Tail[3] := (TRS80_LOAD_ADDR Shr 8) And $FF;
  BlockWrite(F, Tail, 4);

  { Eviter warnings unused }
  PadByte := 0; PadLen := 0;
  If PadByte = PadLen Then;

  Close(F);
End;

Procedure WriteCoCo3BinFile(FileName: TString);
Const
  COCO3_LOAD_ADDR = $2000;
Var
  F: File;
  TextLen, DataLen, DataBase, TotalLen: LongInt;
  PadLen: LongInt;
  PadByte: Byte;
  Preamble: Array[0..4] Of Byte;
  Postamble: Array[0..4] Of Byte;
Begin
  TextLen := BcCodeLen;
  DataLen := BcDataLen;
  DataBase := (TextLen + 3) And Not 3;
  TotalLen := DataBase + DataLen;
  If TotalLen < TextLen Then TotalLen := TextLen;

  { Resoudre les fixups vers les adresses absolues (BE) }
  BcResolveFixups6809(COCO3_LOAD_ADDR, DataBase);

  { Preamble : $00 length(BE) load(BE) }
  Preamble[0] := $00;
  Preamble[1] := (TotalLen Shr 8) And $FF;
  Preamble[2] := TotalLen And $FF;
  Preamble[3] := (COCO3_LOAD_ADDR Shr 8) And $FF;
  Preamble[4] := COCO3_LOAD_ADDR And $FF;

  { Postamble : $FF $00 $00 entry(BE) }
  Postamble[0] := $FF;
  Postamble[1] := $00;
  Postamble[2] := $00;
  Postamble[3] := (COCO3_LOAD_ADDR Shr 8) And $FF;
  Postamble[4] := COCO3_LOAD_ADDR And $FF;

  Assign(F, FileName);
  Rewrite(F, 1);
  BlockWrite(F, Preamble, 5);
  If TextLen > 0 Then
    BlockWrite(F, BcCode[0], TextLen);
  PadByte := 0;
  PadLen := DataBase - TextLen;
  While PadLen > 0 Do
  Begin BlockWrite(F, PadByte, 1); Dec(PadLen); End;
  If DataLen > 0 Then
    BlockWrite(F, BcData[0], DataLen);
  BlockWrite(F, Postamble, 5);
  Close(F);
End;

{ --- WriteTO7BinFile : binaire Thomson TO7 (.BIN format Motorola)        }
{ Meme structure que CoCo 3 (preamble $00 LL HH HH + ... + postamble      }
{ $FF $00 $00 EE EE) reutilise BcResolveFixups6809.                       }
Procedure WriteTO7BinFile(FileName: TString);
Const
  TO7_LOAD_ADDR = $6100;
Var
  F: File;
  TextLen, DataLen, DataBase, TotalLen: LongInt;
