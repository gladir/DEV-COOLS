    { ---- TODO 22 : Mem[Seg:Ofs] := val / MemW / MemL en ecriture ---- }
    If (Up = 'MEM') Or (Up = 'MEMW') Or (Up = 'MEML') Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOVE.L D0,D2');
              EmitInstr('MOVE.L (SP)+,D1');
              EmitInstr('MOVE.L (SP)+,D0');
              EmitInstr('BSR ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOV CX,AX');
              EmitInstr('POP DX');
              EmitInstr('POP AX');
              EmitInstr('CALL ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('LD C,L');
              EmitInstr('POP DE');
              EmitInstr('POP HL');
              EmitInstr('CALL ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('PHA');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PHA');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('TAX');
              EmitInstr('PLA');
              EmitInstr('TAY');
              EmitInstr('PLA');
              EmitInstr('JSR ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PSHS D');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('TFR D,U');
              EmitInstr('PULS D');
              EmitInstr('TFR D,X');
              EmitInstr('PULS D');
              EmitInstr('JSR ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOV ECX,EAX');
              EmitInstr('POP EDX');
              EmitInstr('POP EAX');
              EmitInstr('CALL ' + TP_RT_PFX + 'WRITEMEM');
            End;
          End;
        End; { Case }
      End;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { ---- TODO 22 : Port[$nn] := val / PortW en ecriture ---- }
    If (Up = 'PORT') Or (Up = 'PORTW') Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOVE.L D0,D1');
              EmitInstr('MOVE.L (SP)+,D0');
              EmitInstr('BSR ' + TP_RT_PFX + 'OUTPORT');
            End;
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOV DX,AX');  { DX = val }
              EmitInstr('POP AX');     { AX = port }
              EmitInstr('XCHG AX,DX');
              If Up = 'PORT' Then
                EmitInstr('OUT DX,AL')
              Else
                EmitInstr('OUT DX,AX');
            End;
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('LD A,L');
              EmitInstr('POP BC');
              EmitInstr('OUT (C),A');
            End;
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('PHA');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('TAX');
              EmitInstr('PLA');
              EmitInstr('JSR ' + TP_RT_PFX + 'OUTPORT');
            End;
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('TFR D,X');
              EmitInstr('PULS D');
              EmitInstr('JSR ' + TP_RT_PFX + 'OUTPORT');
            End;
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            EPMatch(']');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
               (TokenPool[EP].Val = ':=') Then
            Begin
              Inc(EP);
              ParseExpr(PI);
              EmitInstr('MOV EDX,EAX');
              EmitInstr('POP EAX');
              EmitInstr('CALL ' + TP_RT_PFX + 'OUTPORT');
            End;
          End;
        End; { Case }
      End;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { Appel de proc (dans SymTab) }
    SI := SymFind(Up);
    If (SI >= 0) And (SymTab[SI].Kind = SK_PROC) Then
    Begin
      Inc(EP);
      ParseFuncCall(PI, Up);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { Appel de proc (dans ProcTab) }
    LI := 0;
    While LI < ProcCount Do
    Begin
      If ProcTab[LI].Name = Up Then Break;
      Inc(LI);
    End;
    If (LI < ProcCount) And (Not ProcTab[LI].IsFunction) Then
    Begin
      Inc(EP);
      ParseFuncCall(PI, Up);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { WITH : resoudre champ implicite dans le scope WITH }
    If (WithDepth > 0) Then
    Begin
      WI := WithFieldIndex(Up, FOfs);
      If WI >= 0 Then
      Begin
        ParseLValueAddrW32(PI, TIdx);   { EAX = adresse du champ (et suffixes) }
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
           (TokenPool[EP].Val = ':=') Then
        Begin
          Inc(EP);
          EmitInstr('PUSH EAX');
          WantCharLit := (TIdx = TY_IDX_CHAR);
          ParseExpr(PI);
          WantCharLit := False;
          EmitInstr('POP EBX');
          GenStoreToAddr(TIdx);
        End;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;
    End;

    { Affectation ou appel de fonction }
    Inc(EP);
    If Not EPAtEnd Then
    Begin
      { Affectation indirecte : ident[index] / ident.champ / ident^ ... := expr }
      If ((TokenPool[EP].Kind = TK_PUNCT) And
          ((TokenPool[EP].Val = '[') Or (TokenPool[EP].Val = '.'))) Or
         ((TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '^')) Then
      Begin
        ParseLValueW32(PI, VName, TIdx);   { EAX = adresse destination }
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
           (TokenPool[EP].Val = ':=') Then
        Begin
          Inc(EP);
          EmitInstr('PUSH EAX');
          WantCharLit := (TIdx = TY_IDX_CHAR);
          ParseExpr(PI);               { EAX = valeur (ou adresse source) }
          WantCharLit := False;
          EmitInstr('POP EBX');
          GenStoreToAddr(TIdx);
          If LastIndexIsStrLen Then
          Begin
            { S[0] := n : maintenir le terminateur NUL de la vue ASCIIZ }
            EmitInstr('MOVZX ECX,AL');
            EmitInstr('ADD ECX,EBX');
            EmitInstr('MOV BYTE PTR [ECX+1],0');
          End;
        End;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;

      { Variable de type procedure : F; ou F(args); = appel indirect }
      TIdx := GetVarTypeIdx(PI, VName);
      If (TIdx >= 0) And (TIdx < TypeCount) And (TypeTab[TIdx].Kind = TYK_PROCVAR) And
         Not ((TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = ':=')) Then
      Begin
        ParseFuncCall(PI, Up);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;

      { Affectation ident := expr }
      If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = ':=') Then
      Begin
        Inc(EP);
        { variable procedure := nom de sous-programme : adresse }
        If (TIdx >= 0) And (TIdx < TypeCount) And (TypeTab[TIdx].Kind = TYK_PROCVAR) And
           (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          FOfs := SymFind(StrUpperCase(TokenPool[EP].Val));
          If (FOfs >= 0) And ((SymTab[FOfs].Kind = SK_PROC) Or (SymTab[FOfs].Kind = SK_FUNC)) And
             (Not SymTab[FOfs].IsExternal) Then
          Begin
            EmitInstr('LEA EAX,[' + SymTab[FOfs].MangledName + ']');
            Inc(EP);
            GenStoreVar(PI, VName);
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ';') Then
              Inc(EP);
            Exit;
          End;
        End;
        WantCharLit := (FileVarType(PI, VName) = TY_IDX_CHAR);
        ParseExpr(PI);
        WantCharLit := False;
        GenStoreVar(PI, VName);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;

      { Appel de fonction (via SymTab) }
      If (SI >= 0) And (SymTab[SI].Kind = SK_FUNC) Then
      Begin
        If SymTab[SI].IsExternal And W32Fpu Then
        Begin
          { fonction predefinie (StrPCopy, StrCat...) en instruction : evaluer, resultat ignore }
          Dec(EP);
          ParseExpr(PI);
          If TypeIsReal(LastVarTypeIdx) Then EmitInstr('FSTP ST(0)');
        End
        Else
          ParseFuncCall(PI, Up);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;

      { Appel avec parentheses }
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(') Then
      Begin
        ParseFuncCall(PI, Up);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        Exit;
      End;
    End;

    { Sinon : continuer }
    Exit;
  End;

  { Autre : avancer }
  Inc(EP);
End;
{ Gere : affectation, appel, EXIT, var := expr, INC, DEC       }
{ Utilise ParseStmt pour chaque instruction.                    }
{ ------------------------------------------------------------ }

Procedure ParseBody(PI : Integer);
Var
  Up      : TString;
  SaveEP, SaveEnd, PrevEP : Integer;
Begin
  { Sauvegarder le contexte si necessaire }
  SaveEP  := EP;
  SaveEnd := EPEnd;

  If PI >= 0 Then
  Begin
    EP    := ProcTab[PI].BodyStart;
    EPEnd := ProcTab[PI].BodyEnd;
    CurProcIdx := PI;
  End;

  { Initialiser la pile de boucles }
  LoopTop := -1;

  { Sauter le BEGIN initial }
  If Not EPAtEnd Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If Up = 'BEGIN' Then
      Inc(EP);
  End;

  { Parser les instructions du corps via ParseStmt }
  While Not EPAtEnd Do
  Begin
    { END : fin du bloc }
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'END') Then
    Begin
      Inc(EP);
      { Sauter le '.' ou ';' apres END }
      If Not EPAtEnd Then
      Begin
        If (TokenPool[EP].Kind = TK_PUNCT) And
           ((TokenPool[EP].Val = '.') Or (TokenPool[EP].Val = ';')) Then
          Inc(EP);
      End;
      Break;
    End;

    { Point final : fin du programme }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '.') Then
    Begin
      Inc(EP);
      Break;
    End;

    { Deleguer a ParseStmt }
    PrevEP := EP;
    ParseStmt(PI);
    { Securite : si EP n a pas avance, forcer l avancement }
    If EP = PrevEP Then SkipStuckToken;
  End;

  { Restaurer le contexte }
  EP    := SaveEP;
  EPEnd := SaveEnd;
End;

{ ------------------------------------------------------------ }
{ EmitProcedures : emettre le code ASM pour chaque procedure   }
{ et fonction declaree dans ProcTab.                            }
{ Emet le prologue, le corps (ParseBody), et l epilogue.       }
{ ------------------------------------------------------------ }

Procedure EmitProcedures;
Var
  FI       : Integer;
  PK       : Integer;
  Extra, CopyOfs, CopySz : LongInt;
Begin
  For FI := 0 To ProcCount - 1 Do
  Begin
    If ProcTab[FI].IsForward Then Continue;
    If ProcTab[FI].IsExternal Then Continue;

    EmitBlankLine;
    EmitComment('--- ' + ProcTab[FI].Name + ' ---');
    EmitLabel(ProcTab[FI].MangledName);
    { espace supplementaire : copies locales des parametres valeur chaine/agregat }
    Extra := 0;
    If Not Is68kTarget And (Opts.DestTarget <> DEST_CRAY1) And (Not Opts.Dos16Mode) Then
      For PK := 0 To ProcTab[FI].ParamCount - 1 Do
        If (Not ProcTab[FI].Params[PK].IsVar) And (Not ProcTab[FI].Params[PK].IsConst) And
           (TypeIsString(ProcTab[FI].Params[PK].TypeIdx) Or
            W32IsAggregate(ProcTab[FI].Params[PK].TypeIdx)) Then
          Extra := Extra + ((TypeSizeofIdx(ProcTab[FI].Params[PK].TypeIdx) + 3) And (Not 3));
    EmitProlog(ProcTab[FI].LocalSize + Extra);
    If Extra > 0 Then
    Begin
      CopyOfs := ProcTab[FI].LocalSize;
      For PK := 0 To ProcTab[FI].ParamCount - 1 Do
        If (Not ProcTab[FI].Params[PK].IsVar) And (Not ProcTab[FI].Params[PK].IsConst) And
           (TypeIsString(ProcTab[FI].Params[PK].TypeIdx) Or
            W32IsAggregate(ProcTab[FI].Params[PK].TypeIdx)) Then
        Begin
          CopySz := TypeSizeofIdx(ProcTab[FI].Params[PK].TypeIdx);
          CopyOfs := CopyOfs + ((CopySz + 3) And (Not 3));
          EmitInstr('MOV ESI,DWORD PTR ' + EBPOfs(ProcTab[FI].Params[PK].Offset));
          EmitInstr('LEA EDI,' + EBPOfs(-CopyOfs));
          If TypeIsString(ProcTab[FI].Params[PK].TypeIdx) Then
          Begin
            EmitInstr('INC ESI');
            EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN');
          End
          Else
          Begin
            EmitInstr('MOV ECX,' + IntToStr_(CopySz));
            EmitInstr('REP MOVSB');
          End;
          EmitInstr('LEA EAX,' + EBPOfs(-CopyOfs));
          EmitInstr('MOV DWORD PTR ' + EBPOfs(ProcTab[FI].Params[PK].Offset) + ',EAX');
        End;
    End;

    { Initialiser la valeur de retour a 0 pour les fonctions (chaine : tampon vide de l anneau) }
    If ProcTab[FI].IsFunction Then
    Begin
      If TypeIsString(ProcTab[FI].RetTypeIdx) And Not Is68kTarget And
         (Opts.DestTarget <> DEST_CRAY1) And (Not Opts.Dos16Mode) Then
      Begin
        EmitInstr('LEA ESI,[CRLF+2]');
        EmitInstr('CALL ' + TP_RT_PFX + 'STRRET');
        EmitInstr('MOV DWORD PTR ' + EBPOfs(ProcTab[FI].RetOffset) + ',EAX');
      End
      Else
      Begin
        EmitInstr('MOV DWORD PTR ' + EBPOfs(ProcTab[FI].RetOffset) + ',0');
        If TypeIsReal(ProcTab[FI].RetTypeIdx) And W32Fpu Then
        Begin
          EmitInstr('MOV DWORD PTR ' + EBPOfs(ProcTab[FI].RetOffset + 4) + ',0');
          If RealSizeCode(ProcTab[FI].RetTypeIdx) = 10 Then
            EmitInstr('MOV DWORD PTR ' + EBPOfs(ProcTab[FI].RetOffset + 8) + ',0');
        End;
      End;
    End;

    { Label de retour }
    RetLbl := LabelGen;

    { Parser et emettre le corps de la fonction }
    ParseBody(FI);

    { Emettre le label de retour }
    EmitLabel(RetLbl);

    { Charger la valeur de retour dans EAX (ST(0) pour un reel) pour les fonctions }
    If ProcTab[FI].IsFunction Then
    Begin
      If TypeIsReal(ProcTab[FI].RetTypeIdx) And W32Fpu Then
        GenRealLoad(EBPOfs(ProcTab[FI].RetOffset), ProcTab[FI].RetTypeIdx)
      Else
        EmitInstr('MOV EAX,' + 'DWORD PTR ' +
          EBPOfs(ProcTab[FI].RetOffset));
    End;

    EmitEpilog;
  End;
End;

