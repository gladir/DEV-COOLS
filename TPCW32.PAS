{ ------------------------------------------------------------ }
{ InferExprType : deviner le type de l expression courante      }
{ en examinant le premier token sans avancer EP.                }
{ Retourne un TY_IDX_* valide.                                 }
{ ------------------------------------------------------------ }

Function InferExprType(PI : Integer) : Integer;
Var
  Up : TString;
  SI, LI : Integer;
  SP, SDepth : Integer;
  ResultType : Integer;
  FUp : TString;
  FJ  : Integer;

  { Descendre dans les types ARRAY si un '[' suit }
  Function ResolveArrayElement(TI : Integer) : Integer;
  { suit les suffixes ^ [i,j] .champ qui suivent l identificateur en EP }
  Var P, Depth, FJ : Integer; FUp : TString;
  Begin
    P := EP + 1;
    While (P < EPEnd) And (TI >= 0) And (TI < TypeCount) Do
    Begin
      If (TokenPool[P].Kind = TK_OP) And (TokenPool[P].Val = '^') Then
      Begin
        If TypeTab[TI].Kind = TYK_POINTER Then TI := TypeTab[TI].BaseTypeIdx
        Else If TypeTab[TI].Kind = TYK_PCHAR Then TI := TY_IDX_CHAR
        Else Break;
        Inc(P);
      End
      Else If (TokenPool[P].Kind = TK_PUNCT) And (TokenPool[P].Val = '[') Then
      Begin
        If TypeTab[TI].Kind = TYK_ARRAY Then TI := TypeTab[TI].BaseTypeIdx
        Else If (TypeTab[TI].Kind = TYK_STRING) Or (TypeTab[TI].Kind = TYK_PCHAR) Then TI := TY_IDX_CHAR
        Else Break;
        Depth := 1; Inc(P);
        While (P < EPEnd) And (Depth > 0) Do
        Begin
          If TokenPool[P].Kind = TK_PUNCT Then
          Begin
            If (TokenPool[P].Val = '[') Or (TokenPool[P].Val = '(') Then Inc(Depth)
            Else If (TokenPool[P].Val = ']') Or (TokenPool[P].Val = ')') Then Dec(Depth)
            Else If (TokenPool[P].Val = ',') And (Depth = 1) And (TI >= 0) And
                    (TI < TypeCount) And (TypeTab[TI].Kind = TYK_ARRAY) Then
              TI := TypeTab[TI].BaseTypeIdx;
          End;
          Inc(P);
        End;
      End
      Else If (TokenPool[P].Kind = TK_PUNCT) And (TokenPool[P].Val = '.') And (P + 1 < EPEnd) Then
      Begin
        If (TypeTab[TI].Kind <> TYK_RECORD) And (TypeTab[TI].Kind <> TYK_OBJECT) Then Break;
        FUp := StrUpperCase(TokenPool[P + 1].Val);
        FJ := 0;
        While (FJ < TypeTab[TI].FieldCount) And (TypeTab[TI].Fields[FJ].Name <> FUp) Do Inc(FJ);
        If FJ < TypeTab[TI].FieldCount Then TI := TypeTab[TI].Fields[FJ].TypeIdx
        Else Break;
        Inc(P, 2);
      End
      Else Break;
    End;
    ResolveArrayElement := TI;
  End;

Begin
  InferExprType := TY_IDX_INTEGER;
  If EP >= EPEnd Then Exit;
  { expression relationnelle ou logique au niveau superieur (hors parentheses et crochets)
    jusqu a la fin de l argument : le resultat est un booleen (Write(A = B) affiche TRUE/FALSE) }
  SP := EP; SDepth := 0;
  While SP < EPEnd Do
  Begin
    If TokenPool[SP].Kind = TK_PUNCT Then
    Begin
      If (TokenPool[SP].Val = '(') Or (TokenPool[SP].Val = '[') Then Inc(SDepth)
      Else If (TokenPool[SP].Val = ')') Or (TokenPool[SP].Val = ']') Then
      Begin
        If SDepth = 0 Then Break;
        Dec(SDepth);
      End
      Else If (SDepth = 0) And ((TokenPool[SP].Val = ',') Or (TokenPool[SP].Val = ':') Or
                                (TokenPool[SP].Val = ';')) Then Break;
    End
    Else If SDepth = 0 Then
    Begin
      If (TokenPool[SP].Kind = TK_OP) And ((TokenPool[SP].Val = '=') Or (TokenPool[SP].Val = '<>') Or
         (TokenPool[SP].Val = '<') Or (TokenPool[SP].Val = '>') Or (TokenPool[SP].Val = '<=') Or
         (TokenPool[SP].Val = '>=')) Then
      Begin
        InferExprType := TY_IDX_BOOLEAN;
        Exit;
      End;
      If (TokenPool[SP].Kind = TK_KEYWORD) And ((StrUpperCase(TokenPool[SP].Val) = 'IN') Or
         (StrUpperCase(TokenPool[SP].Val) = 'NOT')) Then
      Begin
        InferExprType := TY_IDX_BOOLEAN;
        Exit;
      End;
    End;
    Inc(SP);
  End;

  If TokenPool[EP].Kind = TK_STRING Then
  Begin
    InferExprType := TY_IDX_STRING;
    Exit;
  End;

  If TokenPool[EP].Kind = TK_CHAR Then
  Begin
    InferExprType := TY_IDX_CHAR;
    Exit;
  End;

  If TokenPool[EP].Kind = TK_IDENT Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If (Up = 'TRUE') Or (Up = 'FALSE') Then
    Begin
      InferExprType := TY_IDX_BOOLEAN;
      Exit;
    End;

    { Chercher dans les variables locales }
    If PI >= 0 Then
    Begin
      LI := FindLocal(PI, Up);
      If LI >= 0 Then
      Begin
        ResultType := ProcTab[PI].Locals[LI].TypeIdx;
        InferExprType := ResolveArrayElement(ResultType);
        Exit;
      End;
      LI := FindParam(PI, Up);
      If LI >= 0 Then
      Begin
        ResultType := ProcTab[PI].Params[LI].TypeIdx;
        InferExprType := ResolveArrayElement(ResultType);
        Exit;
      End;
    End;

    { Builtins retournant une chaine }
    If (Up = 'PARAMSTR') Or (Up = 'COPY') Or (Up = 'CONCAT')
       Or (Up = 'GETENV') Or (Up = 'FEXPAND') Or (Up = 'FSEARCH')
       Or (Up = 'ENVSTR') Or (Up = 'GRAPHERRORMSG')
       Or (Up = 'GETDRIVERNAME') Or (Up = 'GETMODENAME') Then
    Begin
      InferExprType := TY_IDX_STRING;
      Exit;
    End;

    { Chercher dans les symboles globaux }
    SI := SymFind(Up);
    { fonction integree : type du resultat (Chr -> Char, Eof -> Boolean, Length -> Integer...) }
    If (SI >= 0) And (SymTab[SI].Kind = SK_FUNC) And SymTab[SI].IsExternal Then
    Begin
      Case BuiltinFuncResultKind(Up) Of
        1 : InferExprType := TY_IDX_STRING;
        2 : InferExprType := TY_IDX_CHAR;
        3 : InferExprType := TY_IDX_BOOLEAN;
      Else InferExprType := TY_IDX_INTEGER;
      End;
      Exit;
    End;
    If SI >= 0 Then
    Begin
      ResultType := SymTab[SI].TypeIdx;
      ResultType := ResolveArrayElement(ResultType);
      InferExprType := ResultType;
      Exit;
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ EmitPrintEAX : emettre le code pour afficher EAX selon le    }
{ type. EAX contient la valeur a afficher.                     }
{ String -> appel de _TPRT_PRINTSTR (EAX=pointeur ASCIIZ)     }
{ Char -> ecriture d un caractere unique via WriteFile          }
{ Boolean -> 'TRUE' ou 'FALSE'                                 }
{ Integer -> conversion en chaine puis affichage               }
{ ------------------------------------------------------------ }

Procedure EmitPrintEAX(TypeIdx : Integer);
Var
  LblFalse, LblDone : TString;
  IsStrType : Boolean;
Begin
  IsStrType := (TypeIdx = TY_IDX_STRING) Or
               ((TypeIdx >= 0) And (TypeIdx < TypeCount) And
                (TypeTab[TypeIdx].Kind = TYK_STRING));

  If Is68kTarget Then
  Begin
    { --- Mode 68000 : D0 = valeur, A0 = adresse chaine --- }
    If IsStrType Then
    Begin
      { A0 = pointeur vers chaine ASCIIZ (charge par LEA dans ParseExpr) }
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
    End
    Else If TypeIdx = TY_IDX_CHAR Then
    Begin
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTCHAR');
    End
    Else If TypeIdx = TY_IDX_BOOLEAN Then
    Begin
      LblFalse := LabelGen;
      LblDone  := LabelGen;
      EmitInstr('TST.L D0');
      EmitInstr('BEQ ' + LblFalse);
      EmitInstr('LEA TRUE_STR,A0');
      EmitInstr('BRA ' + LblDone);
      EmitLabel(LblFalse);
      EmitInstr('LEA FALSE_STR,A0');
      EmitLabel(LblDone);
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
    End
    Else
    Begin
      { Integer : D0 = valeur -> convertir et afficher }
      EmitInstr('BSR ' + TP_RT_PFX + 'NUMTOSTR');
      EmitInstr('LEA NUMBUF,A0');
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
    End;
    Exit;
  End;

  { --- Mode x86 --- }
  If (TypeIdx >= 0) And (TypeIdx < TypeCount) And (TypeTab[TypeIdx].Kind = TYK_PCHAR) Then
  Begin
    { EAX = PChar : chaine ASCIIZ }
    EmitInstr('MOV ESI,EAX');
    EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
  End
  Else If IsStrType Then
  Begin
    { EAX = pointeur vers chaine }
    EmitInstr('MOV ESI,EAX');
    If LastExprIsPascalStr Then
      EmitInstr('INC ESI');           { sauter l octet de longueur }
    EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
  End
  Else If TypeIdx = TY_IDX_CHAR Then
  Begin
    { EAX = caractere -> stocker dans STRTMP et afficher }
    EmitInstr('MOV BYTE PTR [STRTMP],AL');
    EmitInstr('MOV BYTE PTR [STRTMP+1],0');
    EmitInstr('LEA ESI,[STRTMP]');
    EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
  End
  Else If TypeIdx = TY_IDX_BOOLEAN Then
  Begin
    { EAX = 0 -> FALSE, sinon -> TRUE }
    LblFalse := LabelGen;
    LblDone  := LabelGen;
    EmitInstr('TEST EAX,EAX');
    EmitInstr('JZ ' + LblFalse);
    EmitInstr('LEA ESI,[TRUE_STR]');
    EmitInstr('JMP ' + LblDone);
    EmitLabel(LblFalse);
    EmitInstr('LEA ESI,[FALSE_STR]');
    EmitLabel(LblDone);
    EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
  End
  Else
  Begin
    { Integer / Word / Byte / autre -> convertir en chaine }
    EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');
    EmitInstr('LEA ESI,[NUMBUF]');
    EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
  End;
End;

{ ------------------------------------------------------------ }
{ EmitFilePrintEAX : emettre le code pour ecrire EAX dans un   }
{ fichier via _TPRT_FPRINTSTR (FILE_WRHND doit etre positionne).}
{ Meme logique que EmitPrintEAX mais ecrit dans le fichier.     }
{ ------------------------------------------------------------ }

Procedure EmitFilePrintEAX(TypeIdx : Integer);
Var
  LblFalse, LblDone : TString;
  IsStrType : Boolean;
Begin
  IsStrType := (TypeIdx = TY_IDX_STRING) Or
               ((TypeIdx >= 0) And (TypeIdx < TypeCount) And
                (TypeTab[TypeIdx].Kind = TYK_STRING));
  If (TypeIdx >= 0) And (TypeIdx < TypeCount) And (TypeTab[TypeIdx].Kind = TYK_PCHAR) Then
  Begin
    { EAX = PChar : chaine ASCIIZ }
    EmitInstr('MOV ESI,EAX');
    EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR');
  End
  Else If IsStrType Then
  Begin
    EmitInstr('MOV ESI,EAX');
    If LastExprIsPascalStr Then
      EmitInstr('INC ESI');
    EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR');
  End
  Else If TypeIdx = TY_IDX_CHAR Then
  Begin
    EmitInstr('MOV BYTE PTR [STRTMP],AL');
    EmitInstr('MOV BYTE PTR [STRTMP+1],0');
    EmitInstr('LEA ESI,[STRTMP]');
    EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR');
  End
  Else If TypeIdx = TY_IDX_BOOLEAN Then
  Begin
    LblFalse := LabelGen;
    LblDone  := LabelGen;
    EmitInstr('TEST EAX,EAX');
    EmitInstr('JZ ' + LblFalse);
    EmitInstr('LEA ESI,[TRUE_STR]');
    EmitInstr('JMP ' + LblDone);
    EmitLabel(LblFalse);
    EmitInstr('LEA ESI,[FALSE_STR]');
    EmitLabel(LblDone);
    EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR');
  End
  Else
  Begin
    EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');
    EmitInstr('LEA ESI,[NUMBUF]');
    EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR');
  End;
End;

{ ------------------------------------------------------------ }
{ EmitWriteValue : afficher EAX (type TIdx) avec largeur        }
{ optionnelle (Width > 0 : constante ; -1 : deja dans ECX) sur  }
{ la sortie standard ou le fichier courant (FILE_WRHND)         }
{ ------------------------------------------------------------ }

Var
  CurFmtDec : Integer;   { decimales du Write/Str courant : -1 aucune, -2 dynamique (EDX) }

Procedure EmitWriteValue(TIdx : Integer; Width : Integer; ToFile : Boolean);
Var
  LblFalse, LblDone : TString;
  IsStrType : Boolean;
  Pfx : TString;
Begin
  If ToFile Then Pfx := 'F' Else Pfx := '';
  If TypeIsReal(TIdx) And W32Fpu Then
  Begin
    { reel : ST(0) -> chaine formatee (largeur ECX, decimales EDX, taille EBX) }
    If Width > 0 Then EmitInstr('MOV ECX,' + IntToStr_(Width))
    Else If Width = 0 Then EmitInstr('XOR ECX,ECX');
    If CurFmtDec >= 0 Then EmitInstr('MOV EDX,' + IntToStr_(CurFmtDec))
    Else If CurFmtDec = -1 Then EmitInstr('MOV EDX,-1');
    EmitInstr('MOV EBX,' + IntToStr_(RealSizeCode(TIdx)));
    EmitInstr('CALL ' + TP_RT_PFX + 'REALSTR');
    EmitInstr('MOV ESI,EAX');
    EmitInstr('INC ESI');
    EmitInstr('CALL ' + TP_RT_PFX + Pfx + 'PRINTSTR');
    LastVarTypeIdx := TY_IDX_INTEGER;   { ST(0) consomme }
    Exit;
  End;
  If Is68kTarget Or (Opts.DestTarget = DEST_CRAY1) Or (Width = 0) Then
  Begin
    If ToFile Then EmitFilePrintEAX(TIdx) Else EmitPrintEAX(TIdx);
    Exit;
  End;
  IsStrType := (TIdx = TY_IDX_STRING) Or
               ((TIdx >= 0) And (TIdx < TypeCount) And
                (TypeTab[TIdx].Kind = TYK_STRING));
  { ESI = chaine ASCIIZ a afficher }
  If (TIdx >= 0) And (TIdx < TypeCount) And (TypeTab[TIdx].Kind = TYK_PCHAR) Then
    EmitInstr('MOV ESI,EAX')
  Else If IsStrType Then
  Begin
    EmitInstr('MOV ESI,EAX');
    If LastExprIsPascalStr Then
      EmitInstr('INC ESI');
  End
  Else If TIdx = TY_IDX_CHAR Then
  Begin
    EmitInstr('MOVZX EAX,AL');
    EmitInstr('MOV [CHRBUF],EAX');
    EmitInstr('LEA ESI,[CHRBUF]');
  End
  Else If TIdx = TY_IDX_BOOLEAN Then
  Begin
    LblFalse := LabelGen;
    LblDone  := LabelGen;
    EmitInstr('TEST EAX,EAX');
    EmitInstr('JZ ' + LblFalse);
    EmitInstr('LEA ESI,[TRUE_STR]');
    EmitInstr('JMP ' + LblDone);
    EmitLabel(LblFalse);
    EmitInstr('LEA ESI,[FALSE_STR]');
    EmitLabel(LblDone);
  End
  Else
  Begin
    EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');
    EmitInstr('LEA ESI,[NUMBUF]');
  End;
  If Width > 0 Then
    EmitInstr('MOV ECX,' + IntToStr_(Width));
  EmitInstr('CALL ' + TP_RT_PFX + Pfx + 'PADPRINT');
End;

{ ------------------------------------------------------------ }
{ ParseWriteStmt : parser Write(args) ou WriteLn(args).         }
{ EP pointe apres WRITE/WRITELN deja consomme.                 }
{ Gere plusieurs arguments separes par virgule.                }
{ Gere le formatage :width (ignore pour l instant).            }
{ ------------------------------------------------------------ }

{ ============================================================== }
{ Apple II : etat d evaluation en temps de compilation pour      }
{ derouler les boucles For (cible 6502) avec corps minimal.      }
{ ============================================================== }
Const
  AII_CT_MAX_VARS  = 16;
  AII_CT_MAX_ARRS  = 16;
  AII_CT_MAX_ELEMS = 256;
Var
  AIICTVarCnt  : Integer;
  AIICTVarName : Array[0..AII_CT_MAX_VARS - 1] Of TString;
  AIICTVarVal  : Array[0..AII_CT_MAX_VARS - 1] Of LongInt;
  AIICTArrCnt  : Integer;
  AIICTArrName : Array[0..AII_CT_MAX_ARRS - 1] Of TString;
  AIICTArrIsCh : Array[0..AII_CT_MAX_ARRS - 1] Of Boolean;
  AIICTArrVal  : Array[0..AII_CT_MAX_ARRS - 1, 0..AII_CT_MAX_ELEMS - 1]
                 Of LongInt;

Function AIICTFindVar(Const N: TString): Integer;
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  AIICTFindVar := -1;
  For I := 0 To AIICTVarCnt - 1 Do
    If AIICTVarName[I] = U Then Begin AIICTFindVar := I; Exit; End;
End;

Procedure AIICTSetVar(Const N: TString; V: LongInt);
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  I := AIICTFindVar(U);
  If I < 0 Then
  Begin
    If AIICTVarCnt >= AII_CT_MAX_VARS Then Exit;
    I := AIICTVarCnt; Inc(AIICTVarCnt);
    AIICTVarName[I] := U;
  End;
  AIICTVarVal[I] := V;
End;

Function AIICTFindArr(Const N: TString): Integer;
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  AIICTFindArr := -1;
  For I := 0 To AIICTArrCnt - 1 Do
    If AIICTArrName[I] = U Then Begin AIICTFindArr := I; Exit; End;
End;

Function AIICTFindOrAddArr(Const N: TString; IsCh: Boolean): Integer;
Var I: Integer;
Begin
  I := AIICTFindArr(N);
  If I < 0 Then
  Begin
    If AIICTArrCnt >= AII_CT_MAX_ARRS Then
    Begin AIICTFindOrAddArr := -1; Exit; End;
    I := AIICTArrCnt; Inc(AIICTArrCnt);
    AIICTArrName[I] := StrUpperCase(N);
    AIICTArrIsCh[I] := IsCh;
  End;
  AIICTFindOrAddArr := I;
End;

{ Forward declarations pour evaluation/parsing CT Apple II }
Function AIICTEvalExpr(Var V: LongInt; Var IsCh: Boolean): Boolean; Forward;
Procedure ParseStmtAppleII; Forward;

{ Verifier si l identifiant est un BYTESTREAM (char) declare dans SymTab }
Function AIIIsByteStreamSym(Const N: TString): Boolean;
Var SI, TI: Integer;
Begin
  AIIIsByteStreamSym := False;
  SI := SymFind(StrUpperCase(N));
  If SI < 0 Then Exit;
  TI := SymTab[SI].TypeIdx;
  If (TI < 0) Or (TI >= TypeCount) Then Exit;
  If TypeTab[TI].Kind <> TYK_ARRAY Then Exit;
  AIIIsByteStreamSym := (StrUpperCase(TypeTab[TI].Name) = 'BYTESTREAM');
End;

Function AIIIsWordStreamSym(Const N: TString): Boolean;
Var SI, TI: Integer;
Begin
  AIIIsWordStreamSym := False;
  SI := SymFind(StrUpperCase(N));
  If SI < 0 Then Exit;
  TI := SymTab[SI].TypeIdx;
  If (TI < 0) Or (TI >= TypeCount) Then Exit;
  If TypeTab[TI].Kind <> TYK_ARRAY Then Exit;
  AIIIsWordStreamSym := (StrUpperCase(TypeTab[TI].Name) = 'WORDSTREAM');
End;

{ Evaluation primaire : litteraux, identifiants, indexation, parens, Chr/Ord }
Function AIICTEvalPrimary(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  Up : TString;
  K  : Integer;
  IdxV : LongInt;
  IdxCh : Boolean;
  ArrI : Integer;
Begin
  AIICTEvalPrimary := False;
  IsCh := False; V := 0;
  If EPAtEnd Then Exit;

  { Unaire +/- }
  If (TokenPool[EP].Kind = TK_OP) And
     ((TokenPool[EP].Val = '+') Or (TokenPool[EP].Val = '-')) Then
  Begin
    Up := TokenPool[EP].Val; Inc(EP);
    If Not AIICTEvalPrimary(V, IsCh) Then Exit;
    If Up = '-' Then V := -V;
    IsCh := False;
    AIICTEvalPrimary := True;
    Exit;
  End;

  { Parens }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(') Then
  Begin
    Inc(EP);
    If Not AIICTEvalExpr(V, IsCh) Then Exit;
    If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
       (TokenPool[EP].Val <> ')') Then Exit;
    Inc(EP);
    AIICTEvalPrimary := True;
    Exit;
  End;

  Case TokenPool[EP].Kind Of
    TK_INTEGER:
    Begin
      V := TokenPool[EP].IntVal; IsCh := False; Inc(EP);
      AIICTEvalPrimary := True;
    End;
    TK_CHAR:
    Begin
      V := TokenPool[EP].IntVal And $FF; IsCh := True; Inc(EP);
      AIICTEvalPrimary := True;
    End;
    TK_KEYWORD, TK_IDENT:
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      { TRUE / FALSE -> booleen }
      If Up = 'TRUE' Then
      Begin
        V := 1; IsCh := False; Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      If Up = 'FALSE' Then
      Begin
        V := 0; IsCh := False; Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      { Chr(expr) -> char }
      If (Up = 'CHR') Then
      Begin
        Inc(EP);
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> '(') Then Exit;
        Inc(EP);
        If Not AIICTEvalExpr(V, IsCh) Then Exit;
        IsCh := True;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ')') Then Exit;
        Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      If (Up = 'ORD') Then
      Begin
        Inc(EP);
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> '(') Then Exit;
        Inc(EP);
        If Not AIICTEvalExpr(V, IsCh) Then Exit;
        IsCh := False;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ')') Then Exit;
        Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;

      { Identifiant : variable CT ou tableau CT indexe }
      Inc(EP); { consommer ident }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        If Not AIICTEvalExpr(IdxV, IdxCh) Then Exit;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ']') Then Exit;
        Inc(EP);
        ArrI := AIICTFindArr(Up);
        If ArrI < 0 Then
        Begin
          { Tableau non encore vu : creer selon type declare }
          If AIIIsByteStreamSym(Up) Then
            ArrI := AIICTFindOrAddArr(Up, True)
          Else If AIIIsWordStreamSym(Up) Then
            ArrI := AIICTFindOrAddArr(Up, False)
          Else
            ArrI := AIICTFindOrAddArr(Up, False);
        End;
        If (ArrI < 0) Or (IdxV < 0) Or (IdxV >= AII_CT_MAX_ELEMS) Then Exit;
        V := AIICTArrVal[ArrI, IdxV];
        IsCh := AIICTArrIsCh[ArrI];
        AIICTEvalPrimary := True;
        Exit;
      End;

      K := AIICTFindVar(Up);
      If K >= 0 Then
      Begin
        V := AIICTVarVal[K]; IsCh := False;
        AIICTEvalPrimary := True;
      End;
    End;
  End;
End;

{ Terme : primaire ((* | div | mod) primaire)* }
Function AIICTEvalTerm(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  V2 : LongInt; IsCh2 : Boolean; Op : TString; Up : TString;
Begin
  AIICTEvalTerm := False;
  If Not AIICTEvalPrimary(V, IsCh) Then Exit;
  While Not EPAtEnd Do
  Begin
    Op := '';
    If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '*') Then
      Op := '*'
    Else If TokenPool[EP].Kind = TK_KEYWORD Then
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      If (Up = 'DIV') Or (Up = 'MOD') Or (Up = 'AND') Or (Up = 'SHL') Or
         (Up = 'SHR') Then Op := Up;
    End;
    If Op = '' Then Break;
    Inc(EP);
    If Not AIICTEvalPrimary(V2, IsCh2) Then Exit;
    If Op = '*' Then V := V * V2
    Else If Op = 'DIV' Then Begin If V2 = 0 Then Exit; V := V Div V2; End
    Else If Op = 'MOD' Then Begin If V2 = 0 Then Exit; V := V Mod V2; End
    Else If Op = 'AND' Then V := V And V2
    Else If Op = 'SHL' Then V := V Shl V2
    Else If Op = 'SHR' Then V := V Shr V2;
    IsCh := False;
  End;
  AIICTEvalTerm := True;
End;

{ Expression : terme ((+ | -) terme)* }
Function AIICTEvalExpr(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  V2 : LongInt; IsCh2 : Boolean; Op : TString; Up : TString;
Begin
  AIICTEvalExpr := False;
  If Not AIICTEvalTerm(V, IsCh) Then Exit;
  While Not EPAtEnd Do
  Begin
    Op := '';
    If TokenPool[EP].Kind = TK_OP Then
    Begin
      If (TokenPool[EP].Val = '+') Or (TokenPool[EP].Val = '-') Then
        Op := TokenPool[EP].Val;
    End
    Else If TokenPool[EP].Kind = TK_KEYWORD Then
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      If Up = 'OR' Then Op := 'OR';
    End;
    If Op = '' Then Break;
    Inc(EP);
    If Not AIICTEvalTerm(V2, IsCh2) Then Exit;
    If Op = '+' Then V := V + V2
    Else If Op = '-' Then V := V - V2
    Else If Op = 'OR' Then V := V Or V2;
    IsCh := False;
  End;
  AIICTEvalExpr := True;
End;

{ Evaluation comparaison : expr [op_rel expr] }
Function AIICTEvalCmp(Var V: LongInt): Boolean;
Var
  V1, V2 : LongInt; IsCh1, IsCh2 : Boolean; Op : TString;
Begin
  AIICTEvalCmp := False;
  If Not AIICTEvalExpr(V1, IsCh1) Then Exit;
  Op := '';
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) Then
  Begin
    If (TokenPool[EP].Val = '<') Or (TokenPool[EP].Val = '>') Or
       (TokenPool[EP].Val = '=') Or (TokenPool[EP].Val = '<=') Or
       (TokenPool[EP].Val = '>=') Or (TokenPool[EP].Val = '<>') Then
      Op := TokenPool[EP].Val;
  End;
  If Op = '' Then
  Begin
    V := V1;
    AIICTEvalCmp := True;
    Exit;
  End;
  Inc(EP);
  If Not AIICTEvalExpr(V2, IsCh2) Then Exit;
  If Op = '<' Then Begin If V1 <  V2 Then V := 1 Else V := 0; End
  Else If Op = '>'  Then Begin If V1 >  V2 Then V := 1 Else V := 0; End
  Else If Op = '='  Then Begin If V1 =  V2 Then V := 1 Else V := 0; End
  Else If Op = '<=' Then Begin If V1 <= V2 Then V := 1 Else V := 0; End
  Else If Op = '>=' Then Begin If V1 >= V2 Then V := 1 Else V := 0; End
  Else If Op = '<>' Then Begin If V1 <> V2 Then V := 1 Else V := 0; End;
  AIICTEvalCmp := True;
End;

{ Evaluation condition : cmp ((AND|OR) cmp)* }
Function AIICTEvalCond(Var V: LongInt): Boolean;
Var
  V2 : LongInt; Up : TString;
Begin
  AIICTEvalCond := False;
  If Not AIICTEvalCmp(V) Then Exit;
  While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) Do
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If (Up <> 'AND') And (Up <> 'OR') Then Break;
    Inc(EP);
    If Not AIICTEvalCmp(V2) Then Exit;
    If Up = 'AND' Then
      Begin If (V <> 0) And (V2 <> 0) Then V := 1 Else V := 0; End
    Else
      Begin If (V <> 0) Or  (V2 <> 0) Then V := 1 Else V := 0; End;
  End;
  AIICTEvalCond := True;
End;

{ Avancer EP au-dela d une instruction (BEGIN..END ou single stmt). }
Procedure AIISkipStmt;
Var
  D : Integer;
  Up : TString;
Begin
  If EPAtEnd Then Exit;
  D := 0;
  If (TokenPool[EP].Kind = TK_KEYWORD) And
     (StrUpperCase(TokenPool[EP].Val) = 'BEGIN') Then
  Begin
    D := 1; Inc(EP);
    While (Not EPAtEnd) And (D > 0) Do
    Begin
      If TokenPool[EP].Kind = TK_KEYWORD Then
      Begin
        Up := StrUpperCase(TokenPool[EP].Val);
        If (Up = 'BEGIN') Or (Up = 'CASE') Or (Up = 'RECORD') Then Inc(D)
        Else If Up = 'END' Then Dec(D);
      End;
      Inc(EP);
    End;
  End
  Else
  Begin
    While Not EPAtEnd Do
    Begin
      If TokenPool[EP].Kind = TK_PUNCT Then
      Begin
        If (TokenPool[EP].Val = '(') Or (TokenPool[EP].Val = '[') Then Inc(D)
        Else If (TokenPool[EP].Val = ')') Or (TokenPool[EP].Val = ']') Then Dec(D)
        Else If (D = 0) And (TokenPool[EP].Val = ';') Then Break;
      End
      Else If (D = 0) And (TokenPool[EP].Kind = TK_KEYWORD) Then
      Begin
        Up := StrUpperCase(TokenPool[EP].Val);
        If (Up = 'END') Or (Up = 'ELSE') Or (Up = 'UNTIL') Then Break;
      End;
      Inc(EP);
    End;
  End;
End;

{ Emission AII pour une valeur evaluee : char direct ou int via PRSTR }
Procedure AIIEmitWriteValue(V: LongInt; IsCh: Boolean);
Var
  Lbl, S : TString;
  Ch : Integer;
Begin
  If IsCh Then
  Begin
    Ch := V And $FF;
    If Opts.MSX Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD A,' + IntToStr_(Ch));
      EmitInstr('CALL $00A2');
    End
    Else If Opts.Adam Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD E,' + IntToStr_(Ch));
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
    End
    Else If Opts.TRS80 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD A,' + IntToStr_(Ch));
      EmitInstr('CALL $0033');
    End
    Else If Opts.CoCo3 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $A002');
    End
    Else If Opts.TO7 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $E803');
    End
    Else If Opts.C64 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $FFD2');
    End
    Else If Opts.Atari400 Or Opts.Atari800 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $9B; { ATASCII EOL }
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR _TPRT_ATARI_PUTC');
    End
    Else If Opts.NES Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR _TPRT_NES_PUTC');
    End
    Else
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $8D
      Else Ch := Ch Or $80;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $FDED');
    End;
  End
  Else
  Begin
    S := IntToStr_(V);
    Lbl := DataGetOrAddStr(S);
    If Opts.MSX Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_MSX_PRSTR');
    End
    Else If Opts.Adam Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_ADAM_PRSTR');
    End
    Else If Opts.TRS80 Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_TRS80_PRSTR');
    End
    Else If Opts.CoCo3 Then
    Begin
      EmitInstr('LDX #' + Lbl);
      EmitInstr('JSR _TPRT_COCO3_PRSTR');
    End
    Else If Opts.TO7 Then
    Begin
      EmitInstr('LDX #' + Lbl);
      EmitInstr('JSR _TPRT_TO7_PRSTR');
    End
    Else
    Begin
      EmitInstr('LDA #<' + Lbl);
      EmitInstr('LDY #>' + Lbl);
      EmitInstr('JSR _TPRT_AII_PRSTR');
    End;
  End;
End;

{ -------------------------------------------------------------- }
{ ParseWriteStmtAppleII : version specialisee Apple II.          }
{ Emet du code 6502 natif pour Write/WriteLn avec arguments      }
{ litteraux : chaine, char, entier. Les expressions complexes    }
{ (variables, indexation tableau) sont sautees silencieusement.  }
{ Utilise le runtime _TPRT_AII_PRSTR (impression chaine ASCIIZ). }
{ -------------------------------------------------------------- }
Procedure ParseWriteStmtAppleII(IsWriteLn : Boolean);
Var
  Lbl, S : TString;
  Depth, I : Integer;
  Ch : LongInt;
  Done : Boolean;
Begin
  If Opts.C64 Then
    EmitComment('writeln (C64)')
  Else If Opts.MSX Then
    EmitComment('writeln (MSX)')
  Else If Opts.Adam Then
    EmitComment('writeln (Coleco Adam)')
  Else If Opts.TRS80 Then
    EmitComment('writeln (TRS-80 Model I)')
  Else If Opts.CoCo3 Then
    EmitComment('writeln (CoCo 3)')
  Else If Opts.TO7 Then
    EmitComment('writeln (Thomson TO7)')
  Else
    EmitComment('writeln (Apple II)');
  { WriteLn sans arguments ou Write sans parenthese : juste CR LF si LN }
  If EPAtEnd Or
     Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsWriteLn Then
    Begin
      If Opts.C64 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $FFD2');
      End
      Else If Opts.MSX Then
      Begin
        EmitInstr('LD A,13');
        EmitInstr('CALL $00A2');
        EmitInstr('LD A,10');
        EmitInstr('CALL $00A2');
      End
      Else If Opts.Adam Then
      Begin
        EmitInstr('LD E,13');
        EmitInstr('LD C,2');
        EmitInstr('CALL 5');
        EmitInstr('LD E,10');
        EmitInstr('LD C,2');
        EmitInstr('CALL 5');
      End
      Else If Opts.TRS80 Then
      Begin
        EmitInstr('LD A,13');
        EmitInstr('CALL $0033');
      End
      Else If Opts.CoCo3 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $A002');
      End
      Else If Opts.TO7 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $E803');
      End
      Else If Opts.Atari400 Or Opts.Atari800 Then
      Begin
        EmitInstr('LDA #$9B');
        EmitInstr('JSR _TPRT_ATARI_PUTC');
      End
      Else If Opts.NES Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR _TPRT_NES_PUTC');
      End
      Else
      Begin
        EmitInstr('LDA #$8D');
        EmitInstr('JSR $FDED');
      End;
    End;
    Exit;
  End;

  Inc(EP); { consommer ( }

  { Boucler sur les arguments }
  While Not EPAtEnd Do
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Break;

    { Argument litteral chaine ? }
    If TokenPool[EP].Kind = TK_STRING Then
    Begin
      Lbl := DataGetOrAddStr(TokenPool[EP].Val);
      If Opts.MSX Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_MSX_PRSTR');
      End
      Else If Opts.Adam Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_ADAM_PRSTR');
      End
      Else If Opts.TRS80 Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_TRS80_PRSTR');
      End
      Else If Opts.CoCo3 Then
      Begin
        EmitInstr('LDX #' + Lbl);
        EmitInstr('JSR _TPRT_COCO3_PRSTR');
      End
      Else If Opts.TO7 Then
      Begin
        EmitInstr('LDX #' + Lbl);
        EmitInstr('JSR _TPRT_TO7_PRSTR');
      End
      Else
      Begin
        EmitInstr('LDA #<' + Lbl);
        EmitInstr('LDY #>' + Lbl);
        EmitInstr('JSR _TPRT_AII_PRSTR');
      End;
      Inc(EP);
    End
    Else
    Begin
      { Tenter une evaluation en temps de compilation (CT) }
      I := EP;  { sauvegarde }
      If AIICTEvalExpr(Ch, Done) Then
      Begin
        AIIEmitWriteValue(Ch, Done);
      End
      Else
      Begin
        { Echec : restaurer EP et sauter l expression en respectant les parens }
        EP := I;
        Depth := 0;
        Done := False;
        While (Not EPAtEnd) And (Not Done) Do
        Begin
          If TokenPool[EP].Kind = TK_PUNCT Then
          Begin
            If TokenPool[EP].Val = '(' Then Inc(Depth)
            Else If TokenPool[EP].Val = ')' Then
            Begin
              If Depth = 0 Then Begin Done := True; Continue; End;
              Dec(Depth);
            End
            Else If (Depth = 0) And (TokenPool[EP].Val = ',') Then
            Begin Done := True; Continue; End;
          End;
          Inc(EP);
        End;
      End;
    End;

    { Sauter format :width / :width:dec eventuel }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ':') Then
    Begin
      Inc(EP);
      For I := 1 To 2 Do
      Begin
        If EPAtEnd Then Break;
        If TokenPool[EP].Kind = TK_INTEGER Then Inc(EP);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ':') Then Inc(EP)
        Else Break;
      End;
    End;

    { Virgule entre arguments }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ',') Then
      Inc(EP)
    Else Break;
  End;

  { Consommer ) }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ')') Then
    Inc(EP);

  { WriteLn : ajouter CR }
  If IsWriteLn Then
  Begin
    If Opts.C64 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $FFD2');
    End
    Else If Opts.MSX Then
    Begin
      EmitInstr('LD A,13');
      EmitInstr('CALL $00A2');
      EmitInstr('LD A,10');
      EmitInstr('CALL $00A2');
    End
    Else If Opts.Adam Then
    Begin
      EmitInstr('LD E,13');
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
      EmitInstr('LD E,10');
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
    End
    Else If Opts.TRS80 Then
    Begin
      EmitInstr('LD A,13');
      EmitInstr('CALL $0033');
    End
    Else If Opts.CoCo3 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $A002');
    End
    Else If Opts.TO7 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $E803');
    End
    Else If Opts.Atari400 Or Opts.Atari800 Then
    Begin
      EmitInstr('LDA #$9B');
      EmitInstr('JSR _TPRT_ATARI_PUTC');
    End
    Else If Opts.NES Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR _TPRT_NES_PUTC');
    End
    Else
    Begin
      EmitInstr('LDA #$8D');
      EmitInstr('JSR $FDED');
    End;
  End;
End;

{ ============================================================== }
{ ParseStmtAppleII : mini-interpreteur en temps de compilation   }
{ pour le corps des boucles For deroulees (cible Apple II 6502). }
{ Reconnait :                                                     }
{   - BEGIN..END                                                  }
{   - Var := expr                  (assignation CT)               }
{   - Var[expr] := expr            (assignation indexee CT)       }
{   - Write/WriteLn(args)          (emission AII)                 }
{   - For Var := expr To/DOWNTO expr Do stmt  (deroulage CT)      }
{   - ; (separateur)                                              }
{ Toute autre construction est sautee silencieusement.            }
{ ============================================================== }
Procedure ParseStmtAppleII;
Var
  Up, IdName : TString;
  IdxV, RhsV : LongInt;
  IdxCh, RhsCh : Boolean;
  ArrI, AIIDepth : Integer;
  StartEP : Integer;
  LoopFrom, LoopTo, LoopI : LongInt;
  LoopCh : Boolean;
  IsDownTo : Boolean;
  BodyEP : Integer;
  SaveVal : LongInt;
  HadVar : Boolean;
  VIdx : Integer;
Begin
  If EPAtEnd Then Exit;

  { Sauter ; en tete }
  While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
        (TokenPool[EP].Val = ';') Do Inc(EP);
  If EPAtEnd Then Exit;

  { Mots-cles }
  If TokenPool[EP].Kind = TK_KEYWORD Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    If Up = 'END' Then Exit;
    If Up = 'UNTIL' Then Exit;
    If Up = 'ELSE' Then Exit;

    If Up = 'BEGIN' Then
    Begin
      Inc(EP);
      While Not EPAtEnd Do
      Begin
        If (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'END') Then
        Begin Inc(EP); Exit; End;
        StartEP := EP;
        ParseStmtAppleII;
        If EP = StartEP Then Inc(EP); { securite anti-boucle }
        While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
              (TokenPool[EP].Val = ';') Do Inc(EP);
      End;
      Exit;
    End;

    If (Up = 'WRITE') Or (Up = 'WRITELN') Then
    Begin
      Inc(EP);
      ParseWriteStmtAppleII(Up = 'WRITELN');
      Exit;
    End;

    If Up = 'IF' Then
    Begin
      Inc(EP); { consommer IF }
      If Not AIICTEvalCond(LoopFrom) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'THEN') Then Exit;
      Inc(EP); { consommer THEN }
      If LoopFrom <> 0 Then
      Begin
        ParseStmtAppleII;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'ELSE') Then
        Begin
          Inc(EP);
          AIISkipStmt;
        End;
      End
      Else
      Begin
        AIISkipStmt;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'ELSE') Then
        Begin
          Inc(EP);
          ParseStmtAppleII;
        End;
      End;
      Exit;
    End;

    If Up = 'WHILE' Then
    Begin
      Inc(EP); { consommer WHILE }
      BodyEP := EP; { CondEP : EP au debut de la condition }
      { Premiere passe : evaluer cond, lire DO, memoriser BodyEP }
      If Not AIICTEvalCond(LoopFrom) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Exit;
      Inc(EP); { consommer DO }
      StartEP := EP; { BodyEP }
      LoopI := 0;
      While (LoopFrom <> 0) And (LoopI < 100000) Do
      Begin
        EP := StartEP;
        ParseStmtAppleII;
        EP := BodyEP;
        If Not AIICTEvalCond(LoopFrom) Then Break;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
           (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Break;
        Inc(EP);
        Inc(LoopI);
      End;
      { Avancer EP apres le corps }
      EP := StartEP;
      AIISkipStmt;
      Exit;
    End;

    If Up = 'REPEAT' Then
    Begin
      Inc(EP); { consommer REPEAT }
      BodyEP := EP;
      LoopI := 0;
      LoopFrom := 0;
      While LoopI < 100000 Do
      Begin
        EP := BodyEP;
        { Parser stmts jusqu a UNTIL }
        While Not EPAtEnd Do
        Begin
          If (TokenPool[EP].Kind = TK_KEYWORD) And
             (StrUpperCase(TokenPool[EP].Val) = 'UNTIL') Then Break;
          StartEP := EP;
          ParseStmtAppleII;
          If EP = StartEP Then Inc(EP);
          While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
                (TokenPool[EP].Val = ';') Do Inc(EP);
        End;
        If EPAtEnd Then Exit;
        Inc(EP); { consommer UNTIL }
        If Not AIICTEvalCond(LoopFrom) Then Exit;
        Inc(LoopI);
        If LoopFrom <> 0 Then Break;
      End;
      Exit;
    End;

    If Up = 'FOR' Then
    Begin
      Inc(EP); { consommer FOR }
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_IDENT) Then Exit;
      IdName := StrUpperCase(TokenPool[EP].Val);
      Inc(EP);
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_OP) Or
         (TokenPool[EP].Val <> ':=') Then Exit;
      Inc(EP);
      If Not AIICTEvalExpr(LoopFrom, LoopCh) Then Exit;

      IsDownTo := False;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Then Exit;
      Up := StrUpperCase(TokenPool[EP].Val);
      If Up = 'TO' Then Inc(EP)
      Else If Up = 'DOWNTO' Then Begin IsDownTo := True; Inc(EP); End
      Else Exit;

      If Not AIICTEvalExpr(LoopTo, LoopCh) Then Exit;

      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Exit;
      Inc(EP); { consommer DO }

      BodyEP := EP;

      { Sauvegarder valeur precedente eventuelle }
      VIdx := AIICTFindVar(IdName);
      HadVar := VIdx >= 0;
      If HadVar Then SaveVal := AIICTVarVal[VIdx];

      LoopI := LoopFrom;
      If IsDownTo Then
      Begin
        While LoopI >= LoopTo Do
        Begin
          AIICTSetVar(IdName, LoopI);
          EP := BodyEP;
          ParseStmtAppleII;
          Dec(LoopI);
        End;
      End
      Else
      Begin
        While LoopI <= LoopTo Do
        Begin
          AIICTSetVar(IdName, LoopI);
          EP := BodyEP;
          ParseStmtAppleII;
          Inc(LoopI);
        End;
      End;

      { EP doit etre apres le corps : reparser une derniere fois pour avancer }
      EP := BodyEP;
      AIIDepth := 0;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
         (StrUpperCase(TokenPool[EP].Val) = 'BEGIN') Then
      Begin
        AIIDepth := 1; Inc(EP);
        While (Not EPAtEnd) And (AIIDepth > 0) Do
        Begin
          If TokenPool[EP].Kind = TK_KEYWORD Then
          Begin
            Up := StrUpperCase(TokenPool[EP].Val);
            If (Up = 'BEGIN') Or (Up = 'CASE') Or (Up = 'RECORD') Then
              Inc(AIIDepth)
            Else If Up = 'END' Then Dec(AIIDepth);
          End;
          Inc(EP);
        End;
      End
      Else
      Begin
        While Not EPAtEnd Do
        Begin
          If TokenPool[EP].Kind = TK_PUNCT Then
          Begin
            If (TokenPool[EP].Val = '(') Or (TokenPool[EP].Val = '[') Then
              Inc(AIIDepth)
            Else If (TokenPool[EP].Val = ')') Or (TokenPool[EP].Val = ']') Then
              Dec(AIIDepth)
            Else If (AIIDepth = 0) And (TokenPool[EP].Val = ';') Then Break;
          End
          Else If (AIIDepth = 0) And (TokenPool[EP].Kind = TK_KEYWORD) Then
          Begin
            Up := StrUpperCase(TokenPool[EP].Val);
            If (Up = 'END') Or (Up = 'ELSE') Or (Up = 'UNTIL') Then Break;
          End;
          Inc(EP);
        End;
      End;

      { Restaurer var loop precedente }
      If HadVar Then
      Begin
        VIdx := AIICTFindVar(IdName);
        If VIdx >= 0 Then AIICTVarVal[VIdx] := SaveVal;
      End;
      Exit;
    End;

    { Mot-cle non reconnu : sauter jusqu au ; }
    While (Not EPAtEnd) And
          Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';')) Do
      Inc(EP);
    Exit;
  End;

  { Identifiant : assignation simple ou indexee, ou Write/WriteLn }
  If TokenPool[EP].Kind = TK_IDENT Then
  Begin
    IdName := StrUpperCase(TokenPool[EP].Val);

    { Write / WriteLn (enregistres comme TK_IDENT via RegProc) }
    If (IdName = 'WRITE') Or (IdName = 'WRITELN') Then
    Begin
      Inc(EP);
      ParseWriteStmtAppleII(IdName = 'WRITELN');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    Inc(EP);

    { Indexation [expr] ? }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = '[') Then
    Begin
      Inc(EP);
      If Not AIICTEvalExpr(IdxV, IdxCh) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
         (TokenPool[EP].Val <> ']') Then Exit;
      Inc(EP);
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_OP) Or
         (TokenPool[EP].Val <> ':=') Then Exit;
      Inc(EP);
      If Not AIICTEvalExpr(RhsV, RhsCh) Then Exit;
      If AIIIsByteStreamSym(IdName) Then
        ArrI := AIICTFindOrAddArr(IdName, True)
      Else If AIIIsWordStreamSym(IdName) Then
        ArrI := AIICTFindOrAddArr(IdName, False)
      Else
        ArrI := AIICTFindOrAddArr(IdName, RhsCh);
      If (ArrI >= 0) And (IdxV >= 0) And (IdxV < AII_CT_MAX_ELEMS) Then
        AIICTArrVal[ArrI, IdxV] := RhsV;
      { Sauter ; }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    { Assignation simple Var := expr }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
       (TokenPool[EP].Val = ':=') Then
    Begin
      Inc(EP);
      If Not AIICTEvalExpr(RhsV, RhsCh) Then Exit;
      AIICTSetVar(IdName, RhsV);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    { Identifiant non reconnu : sauter jusqu au ; }
    While (Not EPAtEnd) And
          Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';')) Do
      Inc(EP);
    Exit;
  End;

  { Sinon : avancer pour eviter une boucle infinie }
  Inc(EP);
End;

Procedure ParseWriteStmt(PI : Integer; IsWriteLn : Boolean);
Var
  TIdx : Integer;
  FmtWidth : Integer;
  FmtDec   : Integer;
  IsFileWrite : Boolean;
  FVarTIdx    : Integer;
  FileArgTIdx : Integer;
  FileArgName : TString;
  Up          : TString;
  LI, SI      : Integer;
  SavedTIdx : Integer;
  SavedPascal : Boolean;
Begin
  { Branche specialisee 6502 (Apple II / C64) : code natif }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    ParseWriteStmtAppleII(IsWriteLn);
    Exit;
  End;

  If IsWriteLn Then
    EmitComment('writeln')
  Else
    EmitComment('write');

  IsFileWrite := False;

  { Gerer WriteLn sans arguments -> juste CR+LF }
  If EPAtEnd Then
  Begin
    If IsWriteLn Then
    Begin
      If Is68kTarget Then
      Begin
        EmitInstr('LEA CRLF,A0');
        EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
      End
      Else
      Begin
        EmitInstr('LEA ESI,[CRLF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
      End;
    End;
    Exit;
  End;

  { Si pas de parenthese, WriteLn sans args }
  If Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsWriteLn Then
    Begin
      If Is68kTarget Then
      Begin
        EmitInstr('LEA CRLF,A0');
        EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
      End
      Else
      Begin
        EmitInstr('LEA ESI,[CRLF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
      End;
    End;
    Exit;
  End;

  { Consommer ( }
  Inc(EP);

  { Detecter si le premier argument est une variable fichier Text }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    FVarTIdx := TY_IDX_INTEGER;
    If PI >= 0 Then
    Begin
      LI := FindLocal(PI, Up);
      If LI >= 0 Then
        FVarTIdx := ProcTab[PI].Locals[LI].TypeIdx
      Else
      Begin
        LI := FindParam(PI, Up);
        If LI >= 0 Then FVarTIdx := ProcTab[PI].Params[LI].TypeIdx;
      End;
    End;
    If FVarTIdx <> TY_IDX_TEXT Then
    Begin
      SI := SymFind(Up);
      If SI >= 0 Then FVarTIdx := SymTab[SI].TypeIdx;
    End;
    If (Up = 'OUTPUT') And (SymFind(Up) < 0) Then
    Begin
      { Write(Output, ...) : sortie standard }
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End
    Else If IsFileVarType(FVarTIdx) Then
    Begin
      { Ecriture dans un fichier }
      IsFileWrite := True;
      FileArgTIdx := FVarTIdx;
      FileArgName := TokenPool[EP].Val;
      GenLoadAddr(PI, TokenPool[EP].Val);
      Inc(EP);
      EmitInstr('MOV EBX,EAX');
      EmitInstr('CALL ' + TP_RT_PFX + 'FCHKOPEN');   { fichier ferme : erreur 103 }
      EmitIoCheck;
      EmitInstr('MOV EAX,DWORD PTR [EAX]');    { charger le handle }
      EmitInstr('MOV DWORD PTR [FILE_WRHND],EAX');
      { Sauter la virgule si presente }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End;
  End;

  If IsFileWrite And (TypeTab[FileArgTIdx].Kind = TYK_FILE) Then
  Begin
    { Write(F, V1, V2...) sur File Of T : BlockWrite d un enregistrement par variable }
    While Not EPAtEnd Do
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Break;
      If TokenPool[EP].Kind = TK_IDENT Then
      Begin
        GenLoadAddr(PI, FileArgName);
        EmitInstr('PUSH EAX');
        GenLoadAddr(PI, TokenPool[EP].Val);
        Inc(EP);
        EmitInstr('PUSH EAX');
        EmitInstr('PUSH 1');
        EmitInstr('CALL ' + TP_RT_PFX + 'BLOCKWRITE');
        EmitInstr('ADD ESP,12');
      End
      Else Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then Inc(EP)
      Else Break;
    End;
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Inc(EP);
    Exit;
  End;
  { Boucle sur les arguments }
  While Not EPAtEnd Do
  Begin
    { Fin des arguments ? }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Break;

    { Determiner le type de l argument }
    TIdx := InferExprType(PI);

    { Evaluer l expression }
    ParseExpr(PI);
    If (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) Then CoerceCharArray;
    { le type constate par l emetteur l emporte quand il est sur (chaine Pascal, Char, Boolean) }
    If LastExprIsPascalStr Then
      TIdx := TY_IDX_STRING
    Else If (LastVarTypeIdx = TY_IDX_CHAR) Or (LastVarTypeIdx = TY_IDX_BOOLEAN) Then
      TIdx := LastVarTypeIdx
    Else If TypeIsString(LastVarTypeIdx) And (Not TypeIsString(TIdx)) Then
      TIdx := LastVarTypeIdx
    Else If (TIdx = TY_IDX_BOOLEAN) And (LastVarTypeIdx >= 0) And
            (Not TypeIsString(LastVarTypeIdx)) Then
      TIdx := LastVarTypeIdx;             { Not I : entier, pas booleen }

    { une expression reelle (ST(0)) impose son type }
    If TypeIsReal(LastVarTypeIdx) And W32Fpu Then TIdx := LastVarTypeIdx;

    { Detecter formatage :width }
    FmtWidth := 0;
    FmtDec := -1;
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
      Begin
        Inc(EP); { consommer : }
        If Not EPAtEnd Then
        Begin
          If (TokenPool[EP].Kind = TK_INTEGER) And (EP + 1 < EPEnd) And
             (TokenPool[EP + 1].Kind = TK_PUNCT) And
             ((TokenPool[EP + 1].Val = ',') Or (TokenPool[EP + 1].Val = ')') Or
              (TokenPool[EP + 1].Val = ':')) Then
          Begin
            FmtWidth := TokenPool[EP].IntVal;
            Inc(EP);
          End
          Else
          Begin
            { Largeur dynamique (expression) : evaluer dans ECX }
            SavedTIdx := LastVarTypeIdx; SavedPascal := LastExprIsPascalStr;
            EmitInstr('PUSH EAX');
            ParseExpr(PI);
            EmitInstr('MOV ECX,EAX');
            EmitInstr('POP EAX');
            LastVarTypeIdx := SavedTIdx; LastExprIsPascalStr := SavedPascal;
            FmtWidth := -1;
          End;
        End;
        { :w:d (formatage des reels) : decimales constantes ou dynamiques (EDX) }
        If Not EPAtEnd Then
        Begin
          If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
          Begin
            Inc(EP);
            If Not EPAtEnd Then
            Begin
              If (TokenPool[EP].Kind = TK_INTEGER) And (EP + 1 < EPEnd) And
                 (TokenPool[EP + 1].Kind = TK_PUNCT) And
                 ((TokenPool[EP + 1].Val = ',') Or (TokenPool[EP + 1].Val = ')')) Then
              Begin
                FmtDec := TokenPool[EP].IntVal;
                Inc(EP);
              End
              Else
              Begin
                SavedTIdx := LastVarTypeIdx; SavedPascal := LastExprIsPascalStr;
                EmitInstr('PUSH ECX');
                EmitInstr('PUSH EAX');
                ParseExpr(PI);
                EmitInstr('MOV EDX,EAX');
                EmitInstr('POP EAX');
                EmitInstr('POP ECX');
                LastVarTypeIdx := SavedTIdx; LastExprIsPascalStr := SavedPascal;
                FmtDec := -2;
              End;
            End;
          End;
        End;
      End;
    End;

    { Afficher selon le type, avec padding si :width }
    CurFmtDec := FmtDec;
    EmitWriteValue(TIdx, FmtWidth, IsFileWrite);
    CurFmtDec := -1;

    { Virgule entre arguments }
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
        Inc(EP)
      Else
        Break;
    End;
  End;

  { Consommer ) }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Inc(EP);

  { WriteLn : ajouter CR+LF }
  If IsWriteLn Then
  Begin
    If Is68kTarget And (Not IsFileWrite) Then
    Begin
      EmitInstr('LEA CRLF,A0');
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
    End
    Else
    Begin
      EmitInstr('LEA ESI,[CRLF]');
      If IsFileWrite Then
        EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR')
      Else
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ ParseReadStmt : parser Read(vars) ou ReadLn(vars).            }
{ EP pointe apres READ/READLN deja consomme.                   }
{ Lit une ligne depuis STDIN, puis parse les variables.         }
{ ------------------------------------------------------------ }

Procedure ParseReadStmt(PI : Integer; IsReadLn : Boolean);
Var
  VName, Up : TString;
  SI, LI    : Integer;
  TIdx      : Integer;
  IsFileRead: Boolean;
  FVarTIdx  : Integer;
  FileArgName  : TString;   { variable fichier de Read(F, ...) }
  FileArgTIdx  : Integer;
  FileByRecord : Boolean;   { File Of T : un enregistrement par variable }
  FileByChar   : Boolean;   { Read(F, C) : caractere par caractere }
Begin
  FileArgName := ''; FileArgTIdx := -1; FileByRecord := False; FileByChar := False;
  If IsReadLn Then
    EmitComment('readln')
  Else
    EmitComment('read');

  { ReadLn sans arguments : lire et jeter une ligne }
  If EPAtEnd Or
     Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsReadLn Then
      EmitInstr('CALL ' + TP_RT_PFX + 'READLN');
    Exit;
  End;

  { Consommer ( }
  Inc(EP);

  { Detecter si le premier argument est une variable fichier Text }
  IsFileRead := False;
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    FVarTIdx := TY_IDX_INTEGER;  { defaut }
    If PI >= 0 Then
    Begin
      LI := FindLocal(PI, Up);
      If LI >= 0 Then
        FVarTIdx := ProcTab[PI].Locals[LI].TypeIdx
      Else
      Begin
        LI := FindParam(PI, Up);
        If LI >= 0 Then FVarTIdx := ProcTab[PI].Params[LI].TypeIdx;
      End;
    End;
    If FVarTIdx <> TY_IDX_TEXT Then
    Begin
      SI := SymFind(Up);
      If SI >= 0 Then FVarTIdx := SymTab[SI].TypeIdx;
    End;
    If (Up = 'INPUT') And (SymFind(Up) < 0) Then
    Begin
      { Read(Input, ...) : entree standard }
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End
    Else If IsFileVarType(FVarTIdx) Then
    Begin
      { Lecture depuis un fichier }
      IsFileRead := True;
      FileArgName := TokenPool[EP].Val;
      FileArgTIdx := FVarTIdx;
      Inc(EP);
      { Sauter la virgule si presente }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
      { Read(F, C) sur un Text : caractere par caractere ; File Of T : un enregistrement
        par variable ; sinon lecture d une ligne dans INBUF }
      If (TypeTab[FVarTIdx].Kind = TYK_FILE) Then
        FileByRecord := True
      Else If (Not IsReadLn) And (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) And
              (FileVarType(PI, TokenPool[EP].Val) = TY_IDX_CHAR) Then
        FileByChar := True
      Else
      Begin
        GenLoadAddr(PI, FileArgName);
        EmitInstr('PUSH EAX');  { adresse de la variable fichier }
        EmitInstr('CALL ' + TP_RT_PFX + 'READLN_FILE');
        EmitInstr('ADD ESP,4');
        EmitIoCheck;
      End;
    End;
  End;
  If FileByRecord Then
  Begin
    { Read(F, V1, V2...) sur File Of T : BlockRead d un enregistrement par variable }
    While Not EPAtEnd Do
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Break;
      If TokenPool[EP].Kind = TK_IDENT Then
      Begin
        VName := TokenPool[EP].Val;
        Inc(EP);
        GenLoadAddr(PI, FileArgName);
        EmitInstr('PUSH EAX');
        GenLoadAddr(PI, VName);
        EmitInstr('PUSH EAX');
        EmitInstr('PUSH 1');
        EmitInstr('CALL ' + TP_RT_PFX + 'BLOCKREAD');
        EmitInstr('ADD ESP,12');
        EmitIoCheck;
      End
      Else Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then Inc(EP)
      Else Break;
    End;
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Inc(EP);
    Exit;
  End;
  If FileByChar Then
  Begin
    { Read(F, C1, C2...) : un caractere par variable, sans consommer la fin de ligne }
    While Not EPAtEnd Do
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Break;
      If TokenPool[EP].Kind = TK_IDENT Then
      Begin
        VName := TokenPool[EP].Val;
        Inc(EP);
        GenLoadAddr(PI, FileArgName);
        EmitInstr('PUSH EAX');
        EmitInstr('CALL ' + TP_RT_PFX + 'READCH_FILE');
        EmitInstr('ADD ESP,4');
        EmitIoCheck;
        GenStoreVar(PI, VName);
      End
      Else Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then Inc(EP)
      Else Break;
    End;
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Inc(EP);
    Exit;
  End;

  If Not IsFileRead Then
  Begin
    { Lire une ligne depuis STDIN dans INBUF }
    EmitInstr('CALL ' + TP_RT_PFX + 'READLN');
  End;

  { Boucle sur les variables }
  While Not EPAtEnd Do
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Break;

    If TokenPool[EP].Kind = TK_IDENT Then
    Begin
      VName := TokenPool[EP].Val;
      Up := StrUpperCase(VName);
      Inc(EP);

      { Determiner le type de la variable }
      TIdx := TY_IDX_INTEGER;
      If PI >= 0 Then
      Begin
        LI := FindLocal(PI, Up);
        If LI >= 0 Then
          TIdx := ProcTab[PI].Locals[LI].TypeIdx
        Else
        Begin
          LI := FindParam(PI, Up);
          If LI >= 0 Then
            TIdx := ProcTab[PI].Params[LI].TypeIdx;
        End;
      End;
      If TIdx = TY_IDX_INTEGER Then
      Begin
        SI := SymFind(Up);
        If SI >= 0 Then
          TIdx := SymTab[SI].TypeIdx;
      End;

      If (TIdx = TY_IDX_STRING) Or (TIdx = TY_IDX_PCHAR) Then
      Begin
        { Copier INBUF vers la variable string }
        EmitInstr('LEA ESI,[INBUF]');
        GenLoadAddr(PI, VName);
        EmitInstr('MOV EDI,EAX');
        { Copier octet par octet }
        EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN');
      End
      Else If TIdx = TY_IDX_CHAR Then
      Begin
        { Prendre le premier caractere de INBUF }
        EmitInstr('MOVZX EAX,BYTE PTR [INBUF]');
        GenStoreVar(PI, VName);
      End
      Else If TypeIsReal(TIdx) And W32Fpu Then
      Begin
        { Reel : convertir INBUF (strtod) }
        EmitInstr('LEA ESI,[INBUF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'VALREAL');
        LastVarTypeIdx := TY_IDX_EXTENDED;
        LastExprIsPascalStr := False;
        GenStoreVar(PI, VName);
      End
      Else
      Begin
        { Integer : convertir INBUF en nombre }
        EmitInstr('LEA ESI,[INBUF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');
        LastVarTypeIdx := TY_IDX_INTEGER;
        GenStoreVar(PI, VName);
      End;
    End
    Else
      Inc(EP); { sauter token inconnu }

    { Virgule entre variables }
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
        Inc(EP)
      Else
        Break;
    End;
  End;

  { Consommer ) }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Inc(EP);
End;

{ ------------------------------------------------------------ }
{ ParseStrStmt : parser Str(N[:W], S)                          }
{ Convertit un nombre en chaine.                               }
{ ------------------------------------------------------------ }

Procedure ParseStrStmt(PI : Integer);
Var
  Width, T, Dec : Integer;
  IsRealArg : Boolean;
Begin
  EmitComment('str');

  If Not EPMatch('(') Then Exit;

  ParseExpr(PI);
  IsRealArg := TypeIsReal(LastVarTypeIdx) And W32Fpu;
  T := LastVarTypeIdx;
  Dec := -1;
  Width := 0;
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
  Begin
    Inc(EP);
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_INTEGER) And (EP + 1 < EPEnd) And
       (TokenPool[EP + 1].Kind = TK_PUNCT) And
       ((TokenPool[EP + 1].Val = ',') Or (TokenPool[EP + 1].Val = ':')) Then
    Begin
      Width := TokenPool[EP].IntVal;
      Inc(EP);
    End
    Else
    Begin
      EmitInstr('PUSH EAX');
      ParseExpr(PI);
      EmitInstr('MOV ECX,EAX');
      EmitInstr('POP EAX');
      Width := -1;
    End;
    { :w:d (reels) : decimales }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_INTEGER) And (EP + 1 < EPEnd) And
         (TokenPool[EP + 1].Kind = TK_PUNCT) And (TokenPool[EP + 1].Val = ',') Then
      Begin
        Dec := TokenPool[EP].IntVal;
        Inc(EP);
      End
      Else
      Begin
        EmitInstr('PUSH ECX'); EmitInstr('PUSH EAX');
        ParseExpr(PI);
        EmitInstr('MOV EDX,EAX');
        EmitInstr('POP EAX'); EmitInstr('POP ECX');
        Dec := -2;
      End;
    End;
  End;

  If IsRealArg Then
  Begin
    { reel : ST(0) -> chaine formatee dans l anneau STRRING }
    If Width > 0 Then EmitInstr('MOV ECX,' + IntToStr_(Width))
    Else If Width = 0 Then EmitInstr('XOR ECX,ECX');
    If Dec >= 0 Then EmitInstr('MOV EDX,' + IntToStr_(Dec))
    Else If Dec = -1 Then EmitInstr('MOV EDX,-1');
    EmitInstr('MOV EBX,' + IntToStr_(RealSizeCode(T)));
    EmitInstr('CALL ' + TP_RT_PFX + 'REALSTR');
    EmitInstr('MOV ESI,EAX');
    EmitInstr('INC ESI');
    LastVarTypeIdx := TY_IDX_INTEGER;   { ST(0) consomme }
  End
  Else
  Begin
  EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');
  If Width <> 0 Then
  Begin
    If Width > 0 Then
      EmitInstr('MOV ECX,' + IntToStr_(Width));
    EmitInstr('LEA ESI,[NUMBUF]');
    EmitInstr('LEA EDI,[STRBUF2]');
    EmitInstr('CALL ' + TP_RT_PFX + 'STRPAD');
    EmitInstr('LEA ESI,[STRBUF2]');
  End
  Else
    EmitInstr('LEA ESI,[NUMBUF]');
  End;

  EPMatch(',');

  { destination : variable, element de tableau, champ... }
  EmitInstr('PUSH ESI');
  If ParseLValueAddrW32(PI, T) Then
  Begin
    EmitInstr('MOV EDI,EAX');
    EmitInstr('POP ESI');
    EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN');
  End
  Else
    EmitInstr('POP ESI');

  EPMatch(')');
End;


Procedure ParseValStmt(PI : Integer);
Var
  T : Integer;
Begin
  EmitComment('val');

  If Not EPMatch('(') Then Exit;

  ParseExpr(PI);
  CoerceCharArray;
  If LastExprIsPascalStr Then
    EmitInstr('INC EAX');   { Pascal -> ASCIIZ : sauter l octet de longueur }
  EmitInstr('MOV ESI,EAX');

  EPMatch(',');

  { variable resultat : entier (STRTONUM) ou reel (VALREAL, strtod) selon son type }
  EmitInstr('PUSH ESI');
  If ParseLValueAddrW32(PI, T) Then
  Begin
    EmitInstr('MOV EBX,EAX');
    EmitInstr('POP ESI');
    If TypeIsReal(T) And W32Fpu Then
    Begin
      EmitInstr('CALL ' + TP_RT_PFX + 'VALREAL');   { ST(0) = valeur, VALCODE = code }
      LastVarTypeIdx := TY_IDX_EXTENDED;
    End
    Else
    Begin
      EmitInstr('PUSH EBX');
      EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');  { EAX = valeur, VALCODE = code d erreur }
      EmitInstr('POP EBX');
      LastVarTypeIdx := TY_IDX_INTEGER;
    End;
    LastExprIsPascalStr := False;
    GenStoreToAddr(T);
  End
  Else
  Begin
    EmitInstr('POP ESI');
    EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');
  End;

  { variable code }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
  Begin
    Inc(EP);
    If ParseLValueAddrW32(PI, T) Then
    Begin
      EmitInstr('MOV EBX,EAX');
      EmitInstr('MOV EAX,[VALCODE]');
      GenStoreToAddr(T);
    End;
  End;

  EPMatch(')');
End;


{ ------------------------------------------------------------ }
{ LoopPush : empiler un contexte de boucle (Break/Continue)     }
{ ------------------------------------------------------------ }

Procedure LoopPush(Const LblBreak, LblCont : TString);
Begin
  Inc(LoopTop);
  If LoopTop > 31 Then
  Begin
    WarnMsg('trop de boucles imbriquees');
    Dec(LoopTop);
    Exit;
  End;
  LoopBreakLbl[LoopTop] := LblBreak;
  LoopContLbl[LoopTop]  := LblCont;
End;

{ ------------------------------------------------------------ }
{ LoopPop : depiler un contexte de boucle                       }
{ ------------------------------------------------------------ }

Procedure LoopPop;
Begin
  If LoopTop >= 0 Then
    Dec(LoopTop);
End;

{ ------------------------------------------------------------ }
{ ParseIfStmt : parser IF cond THEN stmt [ELSE stmt]           }
{ EP pointe sur IF a l entree.                                  }
{ ------------------------------------------------------------ }

Procedure ParseIfStmt(PI : Integer);
Var
  LblElse  : TString;
  LblEndIf : TString;
  HasElse  : Boolean;
Begin
  EmitComment('if');

  Inc(EP);  { consommer IF }

  { Evaluer la condition }
  ParseExpr(PI);

  LblElse  := LabelGen;
  LblEndIf := LabelGen;

  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + LblElse);

  { Consommer THEN }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'THEN') Then
      Inc(EP);

  { Parser l instruction du THEN }
  ParseStmt(PI);

  { Detecter ELSE }
  HasElse := False;
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'ELSE') Then
      HasElse := True;

  If HasElse Then
  Begin
    EmitInstr('JMP ' + LblEndIf);
    EmitLabel(LblElse);
    Inc(EP);  { consommer ELSE }
    ParseStmt(PI);
    EmitLabel(LblEndIf);
  End
  Else
    EmitLabel(LblElse);
End;

{ ------------------------------------------------------------ }
{ ParseCaseStmt : parser CASE expr OF val: stmt; ... END       }
{ EP pointe sur CASE a l entree.                                }
{ ------------------------------------------------------------ }

Procedure ParseCaseStmt(PI : Integer);
Var
  LblEnd  : TString;
  LblNext : TString;
  LblHit  : TString;
  Up      : TString;
  CaseVal : LongInt;
  RangeHi : LongInt;
  SI      : Integer;
Begin
  EmitComment('case');

  Inc(EP);  { consommer CASE }

  { Evaluer l expression selecteur }
  ParseExpr(PI);
  EmitInstr('PUSH EAX');  { sauvegarder le selecteur sur la pile }

  { Consommer OF }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'OF') Then
      Inc(EP);

  LblEnd := LabelGen;

  { Boucle sur les branches du CASE }
  While Not EPAtEnd Do
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    { END ou ELSE : sortir de la boucle des branches }
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       ((Up = 'END') Or (Up = 'ELSE') Or (Up = 'OTHERWISE')) Then
      Break;

    { Semicolons isoles : sauter }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';') Then
    Begin
      Inc(EP);
      Continue;
    End;

    LblNext := LabelGen;
    LblHit  := LabelGen;

    { Analyser les valeurs separees par des virgules }
    While Not EPAtEnd Do
    Begin
      { Detecter ':' (fin des valeurs pour cette branche) }
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
        Break;

      { Lire la valeur : constante (entier, caractere, constante nommee, expression constante) }
      CaseVal := 0;
      If (TokenPool[EP].Kind = TK_INTEGER) Or (TokenPool[EP].Kind = TK_CHAR) Or
         ((TokenPool[EP].Kind = TK_STRING) And (Length(TokenPool[EP].Val) = 1)) Or
         ((TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '-')) Or
         ((TokenPool[EP].Kind = TK_IDENT) And (SymFind(StrUpperCase(TokenPool[EP].Val)) >= 0) And
          (SymTab[SymFind(StrUpperCase(TokenPool[EP].Val))].Kind = SK_CONST)) Then
      Begin
        CaseVal := ConstTokExprAt(EP);
      End
      Else
      Begin
        ParseExpr(PI);
        { Valeur dans EAX, stocker en EBX }
        EmitInstr('MOV EBX,EAX');
        EmitInstr('MOV EAX,DWORD PTR [ESP]');
        EmitInstr('CMP EAX,EBX');
        EmitInstr('JE ' + LblHit);

        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ',') Then
        Begin
          Inc(EP);
          Continue;
        End
        Else
          Break;
      End;

      { Detecter plage val1..val2 }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '..') Then
      Begin
        Inc(EP);  { consommer .. }
        RangeHi := ConstTokExprAt(EP);
        EmitInstr('MOV EAX,DWORD PTR [ESP]');
        EmitInstr('CMP EAX,' + IntToStr_(CaseVal));
        EmitInstr('JL ' + LblNext);
        EmitInstr('CMP EAX,' + IntToStr_(RangeHi));
        EmitInstr('JLE ' + LblHit);
        EmitInstr('JMP ' + LblNext);
      End
      Else
      Begin
        EmitInstr('MOV EAX,DWORD PTR [ESP]');
        EmitInstr('CMP EAX,' + IntToStr_(CaseVal));
        EmitInstr('JE ' + LblHit);
      End;

      { Virgule : valeurs multiples }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP)
      Else
        Break;
    End;

    { Aucune valeur ne correspond -> sauter a la branche suivante }
    EmitInstr('JMP ' + LblNext);
    EmitLabel(LblHit);

    { Consommer ':' }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ':') Then
      Inc(EP);

    { Parser l instruction de cette branche }
    ParseStmt(PI);

    { Consommer le ; optionnel }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ';') Then
      Inc(EP);

    { Sauter a la fin du CASE }
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblNext);
  End;

  { Gerer la clause ELSE / OTHERWISE }
  If Not EPAtEnd Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       ((Up = 'ELSE') Or (Up = 'OTHERWISE')) Then
    Begin
      Inc(EP);
      { Consommer ':' optionnel apres ELSE }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ':') Then
        Inc(EP);
      EmitComment('case default');
      { Parser les instructions de la clause par defaut jusqu a END }
      While Not EPAtEnd Do
      Begin
        If (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'END') Then
          Break;
        SI := EP;
        ParseStmt(PI);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        If EP = SI Then SkipStuckToken;
      End;
    End;
  End;

  EmitLabel(LblEnd);
  EmitInstr('POP EAX');  { depiler le selecteur }

  { Consommer END }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'END') Then
      Inc(EP);

  { Consommer ; optionnel apres END }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ';') Then
    Inc(EP);
End;

{ ------------------------------------------------------------ }
{ ParseWhileStmt : parser WHILE cond DO stmt                   }
{ EP pointe sur WHILE a l entree.                               }
{ Labels : _TPL_WTEST_N, _TPL_WEND_N                           }
{ ------------------------------------------------------------ }

Procedure ParseWhileStmt(PI : Integer);
Var
  LblTest : TString;
  LblEnd  : TString;
Begin
  EmitComment('while');

  { 6502 (Apple II / C64) : interpretation a la compilation }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    ParseStmtAppleII;
    Exit;
  End;

  Inc(EP);  { consommer WHILE }

  LblTest := LabelGen;
  LblEnd  := LabelGen;

  { Label de test }
  EmitLabel(LblTest);

  { Evaluer la condition }
  ParseExpr(PI);

  { TEST EAX,EAX / JZ fin }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + LblEnd);

  { Consommer DO }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'DO') Then
      Inc(EP);

  { Empiler le contexte de boucle }
  LoopPush(LblEnd, LblTest);

  { Parser le corps de la boucle }
  ParseStmt(PI);

  { Consommer ; optionnel apres le corps }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ';') Then
    Inc(EP);

  { Retour au test }
  EmitInstr('JMP ' + LblTest);

  { Label fin }
  EmitLabel(LblEnd);

  { Depiler le contexte de boucle }
  LoopPop;
End;

{ ------------------------------------------------------------ }
{ ParseRepeatStmt : parser REPEAT stmts UNTIL cond             }
{ EP pointe sur REPEAT a l entree.                              }
{ Labels : _TPL_RBEG_N, _TPL_REND_N                            }
{ ------------------------------------------------------------ }

Procedure ParseRepeatStmt(PI : Integer);
Var
  LblBeg : TString;
  LblEnd : TString;
  LblCont : TString;
  SI : Integer;
Begin
  EmitComment('repeat');

  { 6502 (Apple II / C64) : interpretation a la compilation }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    ParseStmtAppleII;
    Exit;
  End;

  Inc(EP);  { consommer REPEAT }

  LblBeg := LabelGen;
  LblEnd := LabelGen;
  LblCont := LabelGen;

  { Label debut }
  EmitLabel(LblBeg);

  { Empiler le contexte de boucle (Continue -> evaluation de la condition UNTIL) }
  LoopPush(LblEnd, LblCont);

  { Parser les instructions jusqu a UNTIL }
  While Not EPAtEnd Do
  Begin
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'UNTIL') Then
      Break;
    SI := EP;
    ParseStmt(PI);
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ';') Then
      Inc(EP);
    If EP = SI Then SkipStuckToken;
  End;

  { Consommer UNTIL }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'UNTIL') Then
      Inc(EP);

  { Evaluer la condition }
  EmitLabel(LblCont);
  ParseExpr(PI);

  { TEST EAX,EAX / JZ debut (si faux, on boucle) }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + LblBeg);

  { Label fin }
  EmitLabel(LblEnd);

  { Depiler le contexte de boucle }
  LoopPop;
End;

{ ------------------------------------------------------------ }
{ ParseForStmt : parser FOR id := lo TO|DOWNTO hi DO stmt      }
{ EP pointe sur FOR a l entree.                                 }
{ Labels : _TPL_FTEST_N, _TPL_FCONT_N, _TPL_FEND_N            }
{ ------------------------------------------------------------ }

Procedure ParseForStmt(PI : Integer);
Var
  VarName  : TString;
  LimLabel : TString;
  LblTest  : TString;
  LblEnd   : TString;
  LblCont  : TString;
  LblBody  : TString;
  IsDownTo : Boolean;
  AIIDepth : Integer;
  AIIUp    : TString;
Begin
  EmitComment('for');

  Inc(EP);  { consommer FOR }

  { Cible 6502 (Apple II / C64) : utiliser l interpreteur CT pour derouler. }
  { ParseStmtAppleII attend que EP pointe sur le mot-cle FOR ; or nous     }
  { l avons deja consomme. Reculer EP d un cran pour qu il y pointe a     }
  { nouveau, puis deleguer.                                                }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    Dec(EP);
    ParseStmtAppleII;
    Exit;
  End;

  { Lire la variable de boucle }
  If EPAtEnd Or (TokenPool[EP].Kind <> TK_IDENT) Then Exit;
  VarName := TokenPool[EP].Val;
  Inc(EP);

  { Consommer := }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = ':=') Then
      Inc(EP);

  { Evaluer l expression de depart }
  WantCharLit := (GetVarTypeIdx(PI, VarName) = TY_IDX_CHAR);
  ParseExpr(PI);
  WantCharLit := False;

  { Stocker la valeur de depart dans la variable }
  GenStoreVar(PI, VarName);

  { Detecter TO ou DOWNTO }
  IsDownTo := False;
  If Not EPAtEnd Then
  Begin
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'TO') Then
      Inc(EP)
    Else If (TokenPool[EP].Kind = TK_KEYWORD) And
            (StrUpperCase(TokenPool[EP].Val) = 'DOWNTO') Then
    Begin
      IsDownTo := True;
      Inc(EP);
    End;
  End;

  { Evaluer l expression limite }
  WantCharLit := (GetVarTypeIdx(PI, VarName) = TY_IDX_CHAR);
  ParseExpr(PI);
  WantCharLit := False;

  { Stocker la limite dans une variable data temporaire }
  LimLabel := LabelGen;
  DataAddDWord(LimLabel, 0);  { Allouer la variable temporaire pour la limite }
  EmitInstr('MOV DWORD PTR [' + LimLabel + '],EAX');

  { Generer les labels de boucle }
  LblTest := LabelGen;
  LblEnd  := LabelGen;
  LblCont := LabelGen;
  LblBody := LabelGen;

  { Consommer DO }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_KEYWORD) And
       (StrUpperCase(TokenPool[EP].Val) = 'DO') Then
      Inc(EP);

  { Label de test }
  EmitLabel(LblTest);

  { Test : CMP variable, limite }
  GenLoadVar(PI, VarName);
  EmitInstr('CMP EAX,DWORD PTR [' + LimLabel + ']');
  If IsDownTo Then
    EmitInstr('JL ' + LblEnd)
  Else
    EmitInstr('JG ' + LblEnd);
  EmitLabel(LblBody);

  { Empiler le contexte de boucle }
  LoopPush(LblEnd, LblCont);

  { Parser le corps de la boucle }
  ParseStmt(PI);

  { Consommer ; optionnel apres le corps }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ';') Then
    Inc(EP);

  { Label continue (increment) }
  EmitLabel(LblCont);
  { Fin de boucle quand la variable a atteint la limite AVANT de l incrementer : }
  { un compteur Word ou Byte (For J := N DownTo 0, For B := 0 To 255) ne deborde pas }
  GenLoadVar(PI, VarName);
  EmitInstr('CMP EAX,DWORD PTR [' + LimLabel + ']');
  EmitInstr('JE ' + LblEnd);
  If IsDownTo Then
    EmitInstr('DEC EAX')
  Else
    EmitInstr('INC EAX');
  GenStoreVar(PI, VarName);
  EmitInstr('JMP ' + LblBody);

  EmitLabel(LblEnd);

  { Depiler le contexte de boucle }
  LoopPop;

  { Ajouter la variable limite dans le segment de donnees }
  DataAddDWord(LimLabel, 0);
End;

{ ------------------------------------------------------------ }
{ ParseGotoStmt : parser GOTO label                            }
{ EP pointe sur GOTO a l entree.                                }
{ ------------------------------------------------------------ }

Procedure ParseGotoStmt(PI : Integer);
Var
  LblName : TString;
Begin
  EmitComment('goto');

  Inc(EP);  { consommer GOTO }

  If Not EPAtEnd Then
  Begin
    { Le label peut etre un nombre ou un identificateur }
    LblName := TokenPool[EP].Val;
    Inc(EP);
    EmitInstr('JMP ' + TP_LBL_PFX + StrUpperCase(LblName));
  End;

  { Consommer ; optionnel }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ';') Then
    Inc(EP);
End;

{ ------------------------------------------------------------ }
{ ParseStmt : parser UNE instruction Pascal.                    }
{ Gere : bloc BEGIN..END, IF, WHILE, REPEAT, FOR, CASE,       }
{ affectation, appel, Write/Read, Exit, Halt, Break, Continue, }
{ GOTO, WITH, labels numeriques.                                }
{ ------------------------------------------------------------ }

Procedure ParseStmt(PI : Integer);
Var
  Up    : TString;
  VName : TString;
  Lbl   : TString;
  ArgName : TString;      { variable resultat de BlockRead/BlockWrite }
  RecSz   : Integer;      { taille d enregistrement pour Reset/Rewrite }
  SI    : Integer;
  LI    : Integer;
  TIdx    : Integer;
  FOfs    : LongInt;
  FSize   : LongInt;
  ElemSz  : Integer;
  WI      : Integer;
Begin
  If EPAtEnd Then Exit;
  If Opts.DebugMode And Opts.Verbose Then
    WriteLn('  [stmt] ligne ', TokenPool[EP].Line, ' : ', TokenPool[EP].Val,
            ' @', BcGetCodeLen);   { offset dans le code (adresse = 401000h + offset) }

  { Cible 6502 (Apple II / C64) : interpretation pour tout le bloc }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    ParseStmtAppleII;
    Exit;
  End;

  { Point-virgule seul : instruction vide }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';') Then
  Begin
    Inc(EP);
    Exit;
  End;

  { Point final : fin du programme }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '.') Then
  Begin
    Inc(EP);
    Exit;
  End;

  { BREAK / CONTINUE : identificateurs (pas des mots reserves TP) ; saut vers la boucle englobante }
  If (TokenPool[EP].Kind = TK_IDENT) And (LoopTop >= 0) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If ((Up = 'BREAK') Or (Up = 'CONTINUE')) And
       ((SymFind(Up) < 0) Or SymTab[SymFind(Up)].IsExternal) Then
    Begin
      Inc(EP);
      If Up = 'BREAK' Then
        EmitInstr('JMP ' + LoopBreakLbl[LoopTop])
      Else
        EmitInstr('JMP ' + LoopContLbl[LoopTop]);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;
  End;

  { Mots-cles }
  If TokenPool[EP].Kind = TK_KEYWORD Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    { END : ne pas consommer, laisser l appelant gerer }
    If Up = 'END' Then Exit;

    { UNTIL : ne pas consommer, laisser ParseRepeatStmt gerer }
    If Up = 'UNTIL' Then Exit;

    { ELSE : ne pas consommer, laisser ParseIfStmt gerer }
    If Up = 'ELSE' Then Exit;

    { BEGIN : bloc imbrique }
    If Up = 'BEGIN' Then
    Begin
      Inc(EP);  { consommer BEGIN }
      While Not EPAtEnd Do
      Begin
        If (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'END') Then
        Begin
          Inc(EP);  { consommer END }
          { Consommer ; ou . optionnel apres END }
          If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
             ((TokenPool[EP].Val = ';') Or (TokenPool[EP].Val = '.')) Then
            Inc(EP);
          Break;
        End;
        SI := EP;  { sauvegarder position avant ParseStmt }
        ParseStmt(PI);
        { Consommer ; optionnel entre instructions }
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ';') Then
          Inc(EP);
        { Securite : si EP n a pas avance, forcer l avancement }
        If EP = SI Then SkipStuckToken;
      End;
      Exit;
    End;

    { IF }
    If Up = 'IF' Then Begin ParseIfStmt(PI); Exit; End;

    { WHILE }
    If Up = 'WHILE' Then Begin ParseWhileStmt(PI); Exit; End;

    { REPEAT }
    If Up = 'REPEAT' Then Begin ParseRepeatStmt(PI); Exit; End;

    { FOR }
    If Up = 'FOR' Then Begin ParseForStmt(PI); Exit; End;

    { CASE }
    If Up = 'CASE' Then Begin ParseCaseStmt(PI); Exit; End;

    { GOTO }
    If Up = 'GOTO' Then Begin ParseGotoStmt(PI); Exit; End;

    { WITH : resoudre les noms de champs implicitement }
    If Up = 'WITH' Then
    Begin
      EmitComment('with');
      Inc(EP);
      { Lire la ou les variables record (expressions : A[2], P^, R.Sub) }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
      Begin
        WI := 0;
        Repeat
          If Not ParseLValueAddrW32(PI, TIdx) Then Break;
          If WithDepth < 8 Then
          Begin
            EmitInstr('MOV [WITHPTR+' + IntToStr_(WithDepth * 4) + '],EAX');
            WithVarName[WithDepth] := '';
            WithVarPI[WithDepth]   := PI;
            WithTypeIdx[WithDepth] := TIdx;
            Inc(WithDepth);
            Inc(WI);
          End;
        Until Not EPMatch(',');
        { Attendre DO }
        While Not EPAtEnd Do
        Begin
          If (TokenPool[EP].Kind = TK_KEYWORD) And
             (StrUpperCase(TokenPool[EP].Val) = 'DO') Then
          Begin
            Inc(EP);
            Break;
          End;
          Inc(EP);
        End;
        ParseStmt(PI);
        { Depiler le contexte WITH }
        While WI > 0 Do
        Begin
          If WithDepth > 0 Then
            Dec(WithDepth);
          Dec(WI);
        End;
      End
      Else
      Begin
    { Pas de variable, avancer jusqu a DO }
        While Not EPAtEnd Do
        Begin
          If (TokenPool[EP].Kind = TK_KEYWORD) And
             (StrUpperCase(TokenPool[EP].Val) = 'DO') Then
          Begin
            Inc(EP);
            Break;
          End;
          Inc(EP);
        End;
        ParseStmt(PI);
      End;
      Exit;
    End;

    { EXIT : saut au label de retour }
    If Up = 'EXIT' Then
    Begin
      Inc(EP);
      EmitInstr('JMP ' + RetLbl);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { HALT : appel ExitProcess }
    If Up = 'HALT' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End
      Else
        EmitInstr('XOR EAX,EAX');
      EmitInstr('PUSH EAX');
      EmitInstr('CALL ' + TP_RT_PFX + 'OFLUSH');
      EmitInstr('CALL ExitProcess');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { RUNERROR(N) : appel ExitProcess avec code d erreur }
    If Up = 'RUNERROR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End
      Else
        EmitInstr('MOV EAX,0');
      EmitInstr('CALL ' + TP_RT_PFX + 'RTERROR');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { BREAK : saut vers fin de boucle englobante }
    If Up = 'BREAK' Then
    Begin
      Inc(EP);
      If LoopTop >= 0 Then
        EmitInstr('JMP ' + LoopBreakLbl[LoopTop])
      Else
        WarnMsg('break en dehors d une boucle');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { CONTINUE : saut vers test/increment de boucle englobante }
    If Up = 'CONTINUE' Then
    Begin
      Inc(EP);
      If LoopTop >= 0 Then
        EmitInstr('JMP ' + LoopContLbl[LoopTop])
      Else
        WarnMsg('continue en dehors d une boucle');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { ASM : bloc assembleur inline (TODO 17) }
    If Up = 'ASM' Then
    Begin
      ParseAsmBlock(PI);
      Exit;
    End;

    { LABEL : section de labels, sauter la declaration }
    If Up = 'LABEL' Then
    Begin
      Inc(EP);
      While Not EPAtEnd Do
      Begin
        If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';') Then
        Begin
          Inc(EP);
          Break;
        End;
        Inc(EP);
      End;
      Exit;
    End;

    { VAR, CONST, TYPE locaux : avancer sans gerer pour l instant }
    If (Up = 'VAR') Or (Up = 'CONST') Or (Up = 'TYPE') Then
    Begin
      Inc(EP);
      Exit;
    End;

    { INC/DEC/NEW/DISPOSE/GETMEM/FREEMEM/MOVE/FILLCHAR/MARK/RELEASE/SETTEXTBUF/CHDIR/MKDIR/RMDIR/GETDIR/INCLUDE/EXCLUDE comme keywords }
    If (Up = 'INC') Or (Up = 'DEC') Or (Up = 'NEW') Or
       (Up = 'DISPOSE') Or (Up = 'GETMEM') Or (Up = 'FREEMEM') Or
       (Up = 'MOVE') Or (Up = 'FILLCHAR') Or (Up = 'MARK') Or
       (Up = 'RELEASE') Or (Up = 'SETTEXTBUF') Or
       (Up = 'CHDIR') Or (Up = 'MKDIR') Or (Up = 'RMDIR') Or
       (Up = 'GETDIR') Or (Up = 'INCLUDE') Or (Up = 'EXCLUDE') Then
    Begin
      ParseExpr(PI);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { Autres mots-cles : avancer }
    Inc(EP);
    Exit;
  End;

  { Entier suivi de ':' = label numerique }
  If (TokenPool[EP].Kind = TK_INTEGER) Then
  Begin
    If (EP + 1 < EPEnd) And
       (TokenPool[EP + 1].Kind = TK_PUNCT) And
       (TokenPool[EP + 1].Val = ':') Then
    Begin
      EmitLabel(TP_LBL_PFX + TokenPool[EP].Val);
      Inc(EP, 2);  { consommer nombre et ':' }
      Exit;
    End;
  End;

  { Identificateur }
  If TokenPool[EP].Kind = TK_IDENT Then
  Begin
    VName := TokenPool[EP].Val;
    Up := StrUpperCase(VName);

    { Label identificateur : ident suivi de ':' (pas ':=') }
    If (EP + 1 < EPEnd) And
       (TokenPool[EP + 1].Kind = TK_PUNCT) And
       (TokenPool[EP + 1].Val = ':') And
       Not ((EP + 2 < EPEnd) And (TokenPool[EP + 2].Val = '=')) Then
    Begin
      EmitLabel(TP_LBL_PFX + Up);
      Inc(EP, 2);  { consommer ident et ':' }
      Exit;
    End;

    { Une variable locale ou un parametre masque les sous-programmes predefinis }
    { (ex: Var Str : String ; Str[I] := C) : affectation directe                 }
    If (((PI >= 0) And ((FindLocal(PI, Up) >= 0) Or (FindParam(PI, Up) >= 0) Or
         IsOuterVarName(PI, Up))) Or IsShadowGlobal(Up)) And
       (EP + 1 < EPEnd) And
       (((TokenPool[EP + 1].Kind = TK_OP) And
         ((TokenPool[EP + 1].Val = ':=') Or (TokenPool[EP + 1].Val = '^'))) Or
        ((TokenPool[EP + 1].Kind = TK_PUNCT) And
         ((TokenPool[EP + 1].Val = '[') Or (TokenPool[EP + 1].Val = '.')))) And
       (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) And (Not Opts.Dos16Mode) Then
    Begin
      ParseLValueAddrW32(PI, TIdx);   { EAX = adresse de la destination (et suffixes) }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
         (TokenPool[EP].Val = ':=') Then
      Begin
        Inc(EP);
        EmitInstr('PUSH EAX');
        WantCharLit := (TIdx = TY_IDX_CHAR);
        ParseExpr(PI);
        WantCharLit := False;
        EmitInstr('POP EBX');
        GenStoreToAddr(TIdx);
        If LastIndexIsStrLen Then
        Begin
          EmitInstr('MOVZX ECX,AL');
          EmitInstr('ADD ECX,EBX');
          EmitInstr('MOV BYTE PTR [ECX+1],0');
        End;
      End;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { INC/DEC/NEW/DISPOSE/GETMEM/FREEMEM/MOVE/FILLCHAR/MARK/RELEASE/SETTEXTBUF/CHDIR/MKDIR/RMDIR/GETDIR/INCLUDE/EXCLUDE }
    If (Up = 'INC') Or (Up = 'DEC') Or (Up = 'NEW') Or
       (Up = 'DISPOSE') Or (Up = 'GETMEM') Or (Up = 'FREEMEM') Or
       (Up = 'MOVE') Or (Up = 'FILLCHAR') Or (Up = 'MARK') Or
       (Up = 'RELEASE') Or (Up = 'SETTEXTBUF') Or
       (Up = 'CHDIR') Or (Up = 'MKDIR') Or (Up = 'RMDIR') Or
       (Up = 'GETDIR') Or (Up = 'INCLUDE') Or (Up = 'EXCLUDE') Then
    Begin
      ParseExpr(PI);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { HALT : appel ExitProcess (identifiant, pas mot-cle) }
    If Up = 'HALT' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End
      Else
        EmitInstr('XOR EAX,EAX');
      EmitInstr('PUSH EAX');
      EmitInstr('CALL ' + TP_RT_PFX + 'OFLUSH');
      EmitInstr('CALL ExitProcess');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { RUNERROR(N) : appel ExitProcess avec code d erreur (identifiant) }
    If Up = 'RUNERROR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End
      Else
        EmitInstr('MOV EAX,0');
      EmitInstr('CALL ' + TP_RT_PFX + 'RTERROR');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { EXIT : saut au label de retour (identifiant) }
    If Up = 'EXIT' Then
    Begin
      Inc(EP);
      EmitInstr('JMP ' + RetLbl);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { RANDOMIZE : initialiser la graine aleatoire }
    If Up = 'RANDOMIZE' Then
    Begin
      Inc(EP);
      EmitInstr('CALL ' + TP_RT_PFX + 'RANDOMIZE');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE SETEXCEPTION(e, b) / SETHALT(e, b) : no-op stubs (2 args) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'SETEXCEPTION') Or (Up = 'SETHALT') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(')');
      End;
      EmitComment('SANE ' + Up + ' stub : no-op');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE no-op stubs (1 arg, discarded) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'SETROUND') Or (Up = 'SETPRECISION') Or
       (Up = 'SETENVIRONMENT') Or (Up = 'PROCEXIT') Or
       (Up = 'SETHALTVECTOR') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      EmitComment('SANE ' + Up + ' stub : no-op');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE GETENVIRONMENT(Var e) / PROCENTRY(Var e) : store 0 --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'GETENVIRONMENT') Or (Up = 'PROCENTRY') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          EmitInstr('MOV DWORD PTR [EAX],0');
          Inc(EP);
        End;
        EPMatch(')');
      End;
      EmitComment('SANE ' + Up + ' stub : store 0');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE NUM2STR(f, x, Var s) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'NUM2STR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        If Not EPAtEnd Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          EmitInstr('PUSH EAX');
          Inc(EP);
        End;
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_NUM2STR');
      EmitInstr('ADD ESP,12');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE STR2DEC / CSTR2DEC (4 args, no-op) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'STR2DEC') Or (Up = 'CSTR2DEC') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(')');
      End;
      EmitComment('SANE ' + Up + ' stub : no-op');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { --- SANE NUM2DEC / DEC2STR (3 args, no-op) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'NUM2DEC') Or (Up = 'DEC2STR') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(',');
        ParseExpr(PI);
        EPMatch(')');
      End;
      EmitComment('SANE ' + Up + ' stub : no-op');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then
        Inc(EP);
      Exit;
    End;

    { Write / WriteLn }
    If (Up = 'WRITE') Or (Up = 'WRITELN') Then
    Begin
      Inc(EP);
      ParseWriteStmt(PI, Up = 'WRITELN');
