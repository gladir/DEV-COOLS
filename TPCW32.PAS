{ --- Parseur d operandes x86 --- }

Function BcParseReg32(Const S: TString): Integer;
Var U: TString;
Begin
  U := StrUpperCase(S);
  If U = 'EAX' Then BcParseReg32 := R_EAX
  Else If U = 'ECX' Then BcParseReg32 := R_ECX
  Else If U = 'EDX' Then BcParseReg32 := R_EDX
  Else If U = 'EBX' Then BcParseReg32 := R_EBX
  Else If U = 'ESP' Then BcParseReg32 := R_ESP
  Else If U = 'EBP' Then BcParseReg32 := R_EBP
  Else If U = 'ESI' Then BcParseReg32 := R_ESI
  Else If U = 'EDI' Then BcParseReg32 := R_EDI
  Else BcParseReg32 := -1;
End;

Function BcParseReg8(Const S: TString): Integer;
Var U: TString;
Begin
  U := StrUpperCase(S);
  If U = 'AL' Then BcParseReg8 := 0
  Else If U = 'CL' Then BcParseReg8 := 1
  Else If U = 'DL' Then BcParseReg8 := 2
  Else If U = 'BL' Then BcParseReg8 := 3
  Else If U = 'AH' Then BcParseReg8 := 4
  Else If U = 'CH' Then BcParseReg8 := 5
  Else If U = 'DH' Then BcParseReg8 := 6
  Else If U = 'BH' Then BcParseReg8 := 7
  Else BcParseReg8 := -1;
End;

Function BcParseReg16(Const S: TString): Integer;
Var U: TString;
Begin
  U := StrUpperCase(S);
  If U = 'AX' Then BcParseReg16 := 0
  Else If U = 'CX' Then BcParseReg16 := 1
  Else If U = 'DX' Then BcParseReg16 := 2
  Else If U = 'BX' Then BcParseReg16 := 3
  Else If U = 'SP' Then BcParseReg16 := 4
  Else If U = 'BP' Then BcParseReg16 := 5
  Else If U = 'SI' Then BcParseReg16 := 6
  Else If U = 'DI' Then BcParseReg16 := 7
  Else BcParseReg16 := -1;
End;

{$Q-}{$R-}  { Disable overflow/range checks: hex values like 80000000h exceed LongInt }
Function BcParseImm(Const S: TString; Var V: LongInt): Boolean;
Var T: TString; I: Integer; Neg: Boolean; Ch: Char; U: LongWord;
Begin
  BcParseImm := False; V := 0; U := 0;
  T := S;
  While (Length(T) > 0) And (T[1] = ' ') Do Delete(T, 1, 1);
  While (Length(T) > 0) And (T[Length(T)] = ' ') Do Delete(T, Length(T), 1);
  If T = '' Then Exit;
  { litteral caractere : 'x' }
  If (Length(T) = 3) And (T[1] = '''') And (T[3] = '''') Then
  Begin
    V := Ord(T[2]); BcParseImm := True; Exit;
  End;
  Neg := False;
  If T[1] = '-' Then Begin Neg := True; Delete(T, 1, 1); End;
  If T = '' Then Exit;
  If (Length(T) > 1) And (StrUpperCase(Copy(T, Length(T), 1)) = 'H') Then
  Begin
    Delete(T, Length(T), 1);
    If (Length(T) > 1) And (T[1] = '0') Then Delete(T, 1, 1);
    For I := 1 To Length(T) Do Begin
      Ch := UpCase(T[I]);
      If (Ch >= '0') And (Ch <= '9') Then U := U * 16 + LongWord(Ord(Ch) - Ord('0'))
      Else If (Ch >= 'A') And (Ch <= 'F') Then U := U * 16 + LongWord(Ord(Ch) - Ord('A') + 10)
      Else Exit;
    End;
  End
  Else If (Length(T) > 2) And (Copy(T, 1, 2) = '0x') Then
  Begin
    Delete(T, 1, 2);
    For I := 1 To Length(T) Do Begin
      Ch := UpCase(T[I]);
      If (Ch >= '0') And (Ch <= '9') Then U := U * 16 + LongWord(Ord(Ch) - Ord('0'))
      Else If (Ch >= 'A') And (Ch <= 'F') Then U := U * 16 + LongWord(Ord(Ch) - Ord('A') + 10)
      Else Exit;
    End;
  End
  Else Begin
    For I := 1 To Length(T) Do
      If (T[I] >= '0') And (T[I] <= '9') Then U := U * 10 + LongWord(Ord(T[I]) - Ord('0'))
      Else Exit;
  End;
  V := LongInt(U);
  If Neg Then V := -V;
  BcParseImm := True;
End;
{$Q+}{$R+}

{ Emettre ModR/M + SIB + displacement pour operande memoire }
{ Retourne True si l operande est un label de donnee (fixup necessaire) }
{ RegField est le champ /r (0-7) du ModR/M }
Function BcEmitMemRM(Const Mem: TString; RegField: Integer;
                     Var DataLbl: TString; Var DataAdd: LongInt): Boolean;
Var
  Inner, Part1, Part2, DP, DP2: TString;
  P, BaseReg, IdxReg, Idx: Integer;
  Disp: LongInt;
  HasDisp, Neg2: Boolean;
Begin
  BcEmitMemRM := False;
  DataLbl := ''; DataAdd := 0;
  { Extraire le contenu entre crochets }
  Inner := Mem;
  If (Length(Inner) > 0) And (Inner[1] = '[') Then Delete(Inner, 1, 1);
  If (Length(Inner) > 0) And (Inner[Length(Inner)] = ']') Then
    Delete(Inner, Length(Inner), 1);
  While (Length(Inner) > 0) And (Inner[1] = ' ') Do Delete(Inner, 1, 1);
  While (Length(Inner) > 0) And (Inner[Length(Inner)] = ' ') Do
    Delete(Inner, Length(Inner), 1);

  { Chercher un '+' ou '-' pour separer base et displacement }
  P := 0; Disp := 0; HasDisp := False;
  Part1 := ''; Part2 := '';
  { Trouver le premier + ou - apres le debut }
  { Attention : il peut y avoir des chiffres hex comme 0A1h }
  Begin
    Idx := 2; { commencer apres le 1er caractere }
    While Idx <= Length(Inner) Do
    Begin
      If (Inner[Idx] = '+') Or (Inner[Idx] = '-') Then
      Begin P := Idx; Break; End;
      Inc(Idx);
    End;
  End;

  If P > 0 Then
  Begin
    Part1 := Copy(Inner, 1, P - 1);
    While (Length(Part1) > 0) And (Part1[Length(Part1)] = ' ') Do
      Delete(Part1, Length(Part1), 1);
    Part2 := Copy(Inner, P, Length(Inner) - P + 1);
    While (Length(Part2) > 0) And (Part2[1] = ' ') Do Delete(Part2, 1, 1);
  End
  Else
  Begin
    Part1 := Inner; Part2 := '';
  End;

  BaseReg := BcParseReg32(Part1);

  If BaseReg >= 0 Then
  Begin
    { [reg] ou [reg+disp] ou [reg+reg] }
    IdxReg := -1;
    If Part2 <> '' Then
    Begin
      DP := Part2;
      If (DP[1] = '+') Then Delete(DP, 1, 1);
      While (Length(DP) > 0) And (DP[1] = ' ') Do Delete(DP, 1, 1);
      IdxReg := BcParseReg32(DP);
      If IdxReg < 0 Then
      Begin
        If Not BcParseImm(DP, Disp) Then
        Begin
          { Negatif ? }
          If (Part2[1] = '-') Then
          Begin
            Delete(Part2, 1, 1);
            While (Length(Part2) > 0) And (Part2[1] = ' ') Do Delete(Part2, 1, 1);
            If BcParseImm(Part2, Disp) Then
              Disp := -Disp
            Else Exit;
          End Else Exit;
        End;
        HasDisp := True;
      End;
    End;

    If IdxReg >= 0 Then
    Begin
      { [base+index] : ModR/M=04+RegField*8 SIB=base+index*8 }
      BcEmitB($04 Or (RegField Shl 3));
      BcEmitB(Byte(BaseReg) Or Byte(IdxReg Shl 3));
    End
    Else If (Not HasDisp) And (BaseReg <> R_EBP) Then
    Begin
      { [reg] : mod=00, r/m=reg }
      If BaseReg = R_ESP Then
      Begin BcEmitB($04 Or (RegField Shl 3)); BcEmitB($24); End
      Else BcEmitB(Byte(BaseReg) Or Byte(RegField Shl 3));
    End
    Else If HasDisp And (Disp >= -128) And (Disp <= 127) Then
    Begin
      { [reg+disp8] : mod=01 }
      If BaseReg = R_ESP Then
      Begin BcEmitB($44 Or (RegField Shl 3)); BcEmitB($24); End
      Else BcEmitB($40 Or Byte(BaseReg) Or Byte(RegField Shl 3));
      BcEmitB(Byte(Disp));
    End
    Else
    Begin
      { [reg+disp32] : mod=10 }
      If BaseReg = R_ESP Then
      Begin BcEmitB($84 Or (RegField Shl 3)); BcEmitB($24); End
      Else BcEmitB($80 Or Byte(BaseReg) Or Byte(RegField Shl 3));
      BcEmitD(Disp);
    End;
  End
  Else
  Begin
    { [label] ou [label+disp] ou [label+reg*scale] : disp32 }
    DataLbl := Part1;
    DataAdd := 0;
    If Part2 <> '' Then
    Begin
      DP2 := Part2;
      If (DP2[1] = '+') Then Delete(DP2, 1, 1);
      While (Length(DP2) > 0) And (DP2[1] = ' ') Do Delete(DP2, 1, 1);
      { Verifier si c est REG*SCALE (adressage indexe) }
      P := Pos('*', DP2);
      If P > 0 Then
      Begin
        DP := Copy(DP2, 1, P - 1);
        While (Length(DP) > 0) And (DP[Length(DP)] = ' ') Do
          Delete(DP, Length(DP), 1);
        IdxReg := BcParseReg32(DP);
        If IdxReg >= 0 Then
        Begin
          { [label + reg*scale] : SIB avec base=disp32 }
          DP := Copy(DP2, P + 1, Length(DP2) - P);
          While (Length(DP) > 0) And (DP[1] = ' ') Do Delete(DP, 1, 1);
          BcParseImm(DP, Disp);
          { scale: 1->SS=0, 2->SS=1, 4->SS=2, 8->SS=3 }
          Case Disp Of
            1: Disp := 0;
            2: Disp := 1;
            4: Disp := 2;
            8: Disp := 3;
          Else Disp := 0;
          End;
          { ModR/M: mod=00, reg=RegField, rm=100 (SIB) }
          BcEmitB($04 Or (RegField Shl 3));
          { SIB: SS=scale, index=IdxReg, base=101 (disp32) }
          BcEmitB(Byte(Disp Shl 6) Or Byte(IdxReg Shl 3) Or $05);
          If BcIsImport(DataLbl) Then
          Begin
            Idx := BcFindOrAddImport(DataLbl);
            BcAddFixup(BC_FIX_ABS32_IMP, BcImports[Idx].ApiName, Idx);
          End
          Else
            BcAddFixup(BC_FIX_ABS32_DATA, DataLbl, 0);
          BcEmitD(0); { placeholder disp32 }
          BcEmitMemRM := True;
          Exit;
        End;
      End;
      { Sinon, c est un displacement numerique }
      DP2 := Part2;
      If (DP2[1] = '+') Or (DP2[1] = '-') Then
      Begin
        Neg2 := (DP2[1] = '-');
        Delete(DP2, 1, 1);
        While (Length(DP2) > 0) And (DP2[1] = ' ') Do Delete(DP2, 1, 1);
        If BcParseImm(DP2, DataAdd) Then
        Begin If Neg2 Then DataAdd := -DataAdd; End;
      End;
    End;
    BcEmitB($05 Or (RegField Shl 3)); { mod=00, r/m=101 = disp32 direct }
    If BcIsImport(DataLbl) Then
    Begin
      Idx := BcFindOrAddImport(DataLbl);
      BcAddFixup(BC_FIX_ABS32_IMP, BcImports[Idx].ApiName, Idx);
    End
    Else
      BcAddFixup(BC_FIX_ABS32_DATA, DataLbl, DataAdd);
    BcEmitD(0); { placeholder, sera resolu }
    BcEmitMemRM := True;
  End;
End;

{ --- Assembleur principal --- }
Function BcGetCodeLen : LongInt;
Begin
  BcGetCodeLen := BcCodeLen;
End;

Procedure BcAssemble(Const S: TString);
Var
  Line, Mnem, Op1, Op2, Tmp, Rest, ImOp2, ImOp3, R2: TString;
  P, Reg1, Reg2, Imm8Reg, Slot, AluOp, Cp: Integer;
  ImmVal: LongInt;
  DataLbl: TString;
  DataAdd: LongInt;
  IsByte, IsWord, Neg3: Boolean;

  Procedure SplitOps(Const Rest: TString);
  Var J, Depth: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1; Depth := 0;
    While J <= Length(Rest) Do
    Begin
      If Rest[J] = '[' Then Inc(Depth)
      Else If Rest[J] = ']' Then Dec(Depth)
      Else If (Rest[J] = ',') And (Depth = 0) Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

  Function StartsWithBracket(Const X: TString): Boolean;
  Var I: Integer;
  Begin
    StartsWithBracket := False;
    For I := 1 To Length(X) Do
      If X[I] = '[' Then Begin StartsWithBracket := True; Exit; End
      Else If X[I] <> ' ' Then Exit;
  End;

  Function StripSizePrefix(Const X: TString): TString;
  Var U, Res: TString; Idx2: Integer;
  Begin
    U := StrUpperCase(X);
    If Copy(U, 1, 10) = 'DWORD PTR ' Then Res := Copy(X, 11, 255)
    Else If Copy(U, 1, 9) = 'BYTE PTR ' Then Res := Copy(X, 10, 255)
    Else If Copy(U, 1, 9) = 'WORD PTR ' Then Res := Copy(X, 10, 255)
    Else Begin
      Idx2 := Pos('PTR ', U);
      If Idx2 > 0 Then Res := Copy(X, Idx2 + 4, 255)
      Else Res := X;
    End;
    While (Length(Res) > 0) And (Res[1] = ' ') Do Delete(Res, 1, 1);
    StripSizePrefix := Res;
  End;

  Function HasBytePrefix(Const X: TString): Boolean;
  Begin HasBytePrefix := Pos('BYTE PTR', StrUpperCase(X)) > 0; End;

  Function HasWordPrefix(Const X: TString): Boolean;
  Var U: TString;
  Begin
    U := StrUpperCase(X);
    HasWordPrefix := (Pos('WORD PTR', U) > 0) And (Pos('DWORD PTR', U) = 0);
  End;

  Function HasDWordPrefix(Const X: TString): Boolean;
  Begin HasDWordPrefix := Pos('DWORD PTR', StrUpperCase(X)) > 0; End;

  { ParseOffsetOperand : 'OFFSET label[+/-disp]' -> label et deplacement }
  Procedure ParseOffsetOperand(Const X: TString; Var Lbl: TString; Var Add: LongInt);
  Var T2, R2: TString; Q: Integer; Ng: Boolean;
  Begin
    T2 := Copy(X, 8, 255);
    While (Length(T2) > 0) And (T2[1] = ' ') Do Delete(T2, 1, 1);
    Add := 0; Lbl := T2;
    Q := 2;
    While Q <= Length(T2) Do
    Begin
      If (T2[Q] = '+') Or (T2[Q] = '-') Then
      Begin
        Lbl := Copy(T2, 1, Q - 1);
        R2 := Copy(T2, Q, 255);
        Ng := (R2[1] = '-');
        Delete(R2, 1, 1);
        While (Length(R2) > 0) And (R2[1] = ' ') Do Delete(R2, 1, 1);
        BcParseImm(R2, Add);
        If Ng Then Add := -Add;
        Break;
      End;
      Inc(Q);
    End;
  End;

  { Assemble16 : formes 16 bits (prefixe 66h) de MOV/ADD/SUB/CMP/AND/OR/XOR/TEST/INC/DEC }
  { Retourne True si l instruction a ete traitee.                                      }
  Function Assemble16 : Boolean;
  Var R1, R2, AOp: Integer; Iv: LongInt; T2: TString;
  Begin
    Assemble16 := False;
    R1 := BcParseReg16(Op1);
    If (R1 < 0) And Not HasWordPrefix(Op1) Then Exit;
    If Mnem = 'ADD' Then AOp := 0
    Else If Mnem = 'OR' Then AOp := 1
    Else If Mnem = 'AND' Then AOp := 4
    Else If Mnem = 'SUB' Then AOp := 5
    Else If Mnem = 'XOR' Then AOp := 6
    Else If Mnem = 'CMP' Then AOp := 7
    Else If Mnem = 'MOV' Then AOp := -2
    Else If Mnem = 'INC' Then AOp := -3
    Else If Mnem = 'DEC' Then AOp := -4
    Else If Mnem = 'TEST' Then AOp := -5
    Else Exit;
    Assemble16 := True;
    BcEmitB($66);
    If R1 >= 0 Then
    Begin
      If AOp = -3 Then Begin BcEmitB($40 + R1); Exit; End;
      If AOp = -4 Then Begin BcEmitB($48 + R1); Exit; End;
      R2 := BcParseReg16(Op2);
      If R2 >= 0 Then
      Begin
        If AOp = -2 Then BcEmitB($89)
        Else If AOp = -5 Then BcEmitB($85)
        Else BcEmitB(AOp * 8 + 1);
        BcEmitB($C0 + R2 * 8 + R1);
        Exit;
      End;
      If BcParseImm(Op2, Iv) Then
      Begin
        If AOp = -2 Then Begin BcEmitB($B8 + R1); BcEmitW(Word(Iv)); End
        Else If AOp = -5 Then Begin BcEmitB($F7); BcEmitB($C0 + R1); BcEmitW(Word(Iv)); End
        Else If (Iv >= -128) And (Iv <= 127) Then
        Begin BcEmitB($83); BcEmitB($C0 + AOp * 8 + R1); BcEmitB(Byte(Iv)); End
        Else Begin BcEmitB($81); BcEmitB($C0 + AOp * 8 + R1); BcEmitW(Word(Iv)); End;
        Exit;
      End;
      T2 := StripSizePrefix(Op2);
      If Not StartsWithBracket(T2) Then T2 := Op2;
      If StartsWithBracket(T2) Then
      Begin
        If AOp = -2 Then BcEmitB($8B)
        Else If AOp = -5 Then BcEmitB($85)
        Else BcEmitB(AOp * 8 + 3);
        BcEmitMemRM(T2, R1, DataLbl, DataAdd);
      End;
      Exit;
    End;
    { WORD PTR [mem], ... }
    T2 := StripSizePrefix(Op1);
    If AOp = -3 Then Begin BcEmitB($FF); BcEmitMemRM(T2, 0, DataLbl, DataAdd); Exit; End;
    If AOp = -4 Then Begin BcEmitB($FF); BcEmitMemRM(T2, 1, DataLbl, DataAdd); Exit; End;
    R2 := BcParseReg16(Op2);
    If R2 >= 0 Then
    Begin
      If AOp = -2 Then BcEmitB($89)
      Else If AOp = -5 Then BcEmitB($85)
      Else BcEmitB(AOp * 8 + 1);
      BcEmitMemRM(T2, R2, DataLbl, DataAdd);
      Exit;
    End;
    If BcParseImm(Op2, Iv) Then
    Begin
      If AOp = -2 Then Begin BcEmitB($C7); BcEmitMemRM(T2, 0, DataLbl, DataAdd); BcEmitW(Word(Iv)); End
      Else If AOp = -5 Then Begin BcEmitB($F7); BcEmitMemRM(T2, 0, DataLbl, DataAdd); BcEmitW(Word(Iv)); End
      Else If (Iv >= -128) And (Iv <= 127) Then
      Begin BcEmitB($83); BcEmitMemRM(T2, AOp, DataLbl, DataAdd); BcEmitB(Byte(Iv)); End
      Else Begin BcEmitB($81); BcEmitMemRM(T2, AOp, DataLbl, DataAdd); BcEmitW(Word(Iv)); End;
    End;
  End;

  { AssembleX87 : instructions du coprocesseur (FLD, FSTP, FILD, FISTP, FADDP, ...) }
  Function AssembleX87 : Boolean;
  Var
    M : TString;
    Esc, RegF, Sz, I2 : Integer;

    Function MemSize(Const X : TString) : Integer;
    Var U : TString;
    Begin
      U := StrUpperCase(X);
      If Pos('QWORD PTR', U) > 0 Then MemSize := 8
      Else If Pos('TBYTE PTR', U) > 0 Then MemSize := 10
      Else If Pos('DWORD PTR', U) > 0 Then MemSize := 4
      Else If Pos('WORD PTR', U) > 0 Then MemSize := 2
      Else MemSize := 0;
    End;

    { StIdx : 'ST' -> 0, 'ST(i)' -> i, sinon -1 }
    Function StIdx(Const X : TString) : Integer;
    Var U : TString;
    Begin
      U := StrUpperCase(X);
      While (Length(U) > 0) And (U[1] = ' ') Do Delete(U, 1, 1);
      If U = 'ST' Then StIdx := 0
      Else If (Length(U) = 5) And (Copy(U, 1, 3) = 'ST(') And (U[5] = ')') And
              (U[4] >= '0') And (U[4] <= '7') Then StIdx := Ord(U[4]) - Ord('0')
      Else StIdx := -1;
    End;

    Procedure EmitMem(AEsc : Integer; ARegF : Integer);
    Begin
      BcEmitB(AEsc);
      BcEmitMemRM(StripSizePrefix(Op1), ARegF, DataLbl, DataAdd);
    End;

  Begin
    AssembleX87 := True;
    { sans operande }
    If Mnem = 'FCOMPP' Then Begin BcEmitB($DE); BcEmitB($D9); Exit; End;
    If Mnem = 'FUCOMPP' Then Begin BcEmitB($DA); BcEmitB($E9); Exit; End;
    If Mnem = 'FNSTSW' Then Begin BcEmitB($DF); BcEmitB($E0); Exit; End;   { FNSTSW AX }
    If Mnem = 'FCHS' Then Begin BcEmitB($D9); BcEmitB($E0); Exit; End;
    If Mnem = 'FABS' Then Begin BcEmitB($D9); BcEmitB($E1); Exit; End;
    If Mnem = 'FTST' Then Begin BcEmitB($D9); BcEmitB($E4); Exit; End;
    If Mnem = 'FSQRT' Then Begin BcEmitB($D9); BcEmitB($FA); Exit; End;
    If Mnem = 'FSIN' Then Begin BcEmitB($D9); BcEmitB($FE); Exit; End;
    If Mnem = 'FCOS' Then Begin BcEmitB($D9); BcEmitB($FF); Exit; End;
    If Mnem = 'FSINCOS' Then Begin BcEmitB($D9); BcEmitB($FB); Exit; End;
    If Mnem = 'FPATAN' Then Begin BcEmitB($D9); BcEmitB($F3); Exit; End;
    If Mnem = 'FPTAN' Then Begin BcEmitB($D9); BcEmitB($F2); Exit; End;
    If Mnem = 'FYL2X' Then Begin BcEmitB($D9); BcEmitB($F1); Exit; End;
    If Mnem = 'F2XM1' Then Begin BcEmitB($D9); BcEmitB($F0); Exit; End;
    If Mnem = 'FSCALE' Then Begin BcEmitB($D9); BcEmitB($FD); Exit; End;
    If Mnem = 'FRNDINT' Then Begin BcEmitB($D9); BcEmitB($FC); Exit; End;
    If Mnem = 'FPREM' Then Begin BcEmitB($D9); BcEmitB($F8); Exit; End;
    If Mnem = 'FXTRACT' Then Begin BcEmitB($D9); BcEmitB($F4); Exit; End;
    If Mnem = 'FLD1' Then Begin BcEmitB($D9); BcEmitB($E8); Exit; End;
    If Mnem = 'FLDZ' Then Begin BcEmitB($D9); BcEmitB($EE); Exit; End;
    If Mnem = 'FLDPI' Then Begin BcEmitB($D9); BcEmitB($EB); Exit; End;
    If Mnem = 'FLDL2E' Then Begin BcEmitB($D9); BcEmitB($EA); Exit; End;
    If Mnem = 'FLDLN2' Then Begin BcEmitB($D9); BcEmitB($ED); Exit; End;
    If Mnem = 'FLDL2T' Then Begin BcEmitB($D9); BcEmitB($E9); Exit; End;
    If Mnem = 'FLDLG2' Then Begin BcEmitB($D9); BcEmitB($EC); Exit; End;
    If Mnem = 'FNINIT' Then Begin BcEmitB($DB); BcEmitB($E3); Exit; End;
    If Mnem = 'FWAIT' Then Begin BcEmitB($9B); Exit; End;
    If Mnem = 'FXCH' Then
    Begin
      I2 := StIdx(Op1); If I2 < 0 Then I2 := 1;
      BcEmitB($D9); BcEmitB($C8 + I2); Exit;
    End;
    { FxxxP ST(i),ST }
    If (Mnem = 'FADDP') Or (Mnem = 'FMULP') Or (Mnem = 'FSUBP') Or (Mnem = 'FSUBRP') Or
       (Mnem = 'FDIVP') Or (Mnem = 'FDIVRP') Then
    Begin
      I2 := StIdx(Op1); If I2 < 0 Then I2 := 1;
      If Mnem = 'FADDP' Then RegF := $C0
      Else If Mnem = 'FMULP' Then RegF := $C8
      Else If Mnem = 'FSUBP' Then RegF := $E8
      Else If Mnem = 'FSUBRP' Then RegF := $E0
      Else If Mnem = 'FDIVP' Then RegF := $F8
      Else RegF := $F0;
      BcEmitB($DE); BcEmitB(RegF + I2); Exit;
    End;
    { Fxxx ST,ST(i) / Fxxx mem }
    If (Mnem = 'FADD') Or (Mnem = 'FMUL') Or (Mnem = 'FSUB') Or (Mnem = 'FSUBR') Or
       (Mnem = 'FDIV') Or (Mnem = 'FDIVR') Or (Mnem = 'FCOM') Or (Mnem = 'FCOMP') Then
    Begin
      If Mnem = 'FADD' Then RegF := 0
      Else If Mnem = 'FMUL' Then RegF := 1
      Else If Mnem = 'FCOM' Then RegF := 2
      Else If Mnem = 'FCOMP' Then RegF := 3
      Else If Mnem = 'FSUB' Then RegF := 4
      Else If Mnem = 'FSUBR' Then RegF := 5
      Else If Mnem = 'FDIV' Then RegF := 6
      Else RegF := 7;
      Sz := MemSize(Op1);
      If Sz = 8 Then Begin EmitMem($DC, RegF); Exit; End;
      If Sz = 4 Then Begin EmitMem($D8, RegF); Exit; End;
      I2 := StIdx(Op2); If I2 < 0 Then I2 := StIdx(Op1);
      If I2 < 0 Then I2 := 1;
      BcEmitB($D8); BcEmitB($C0 + RegF * 8 + I2); Exit;
    End;
    If Mnem = 'FLD' Then
    Begin
      Sz := MemSize(Op1);
      If Sz = 4 Then Begin EmitMem($D9, 0); Exit; End;
      If Sz = 8 Then Begin EmitMem($DD, 0); Exit; End;
      If Sz = 10 Then Begin EmitMem($DB, 5); Exit; End;
      I2 := StIdx(Op1); If I2 < 0 Then I2 := 0;
      BcEmitB($D9); BcEmitB($C0 + I2); Exit;
    End;
    If Mnem = 'FST' Then
    Begin
      Sz := MemSize(Op1);
      If Sz = 4 Then Begin EmitMem($D9, 2); Exit; End;
      If Sz = 8 Then Begin EmitMem($DD, 2); Exit; End;
      I2 := StIdx(Op1); If I2 < 0 Then I2 := 1;
      BcEmitB($DD); BcEmitB($D0 + I2); Exit;
    End;
    If Mnem = 'FSTP' Then
    Begin
      Sz := MemSize(Op1);
      If Sz = 4 Then Begin EmitMem($D9, 3); Exit; End;
      If Sz = 8 Then Begin EmitMem($DD, 3); Exit; End;
      If Sz = 10 Then Begin EmitMem($DB, 7); Exit; End;
      I2 := StIdx(Op1); If I2 < 0 Then I2 := 0;
      BcEmitB($DD); BcEmitB($D8 + I2); Exit;
    End;
    If Mnem = 'FILD' Then
    Begin
      Sz := MemSize(Op1);
      If Sz = 2 Then Begin EmitMem($DF, 0); Exit; End;
      If Sz = 8 Then Begin EmitMem($DF, 5); Exit; End;
      EmitMem($DB, 0); Exit;
    End;
    If Mnem = 'FIST' Then
    Begin
      If MemSize(Op1) = 2 Then EmitMem($DF, 2) Else EmitMem($DB, 2);
      Exit;
    End;
    If Mnem = 'FISTP' Then
    Begin
      Sz := MemSize(Op1);
      If Sz = 2 Then Begin EmitMem($DF, 3); Exit; End;
      If Sz = 8 Then Begin EmitMem($DF, 7); Exit; End;
      EmitMem($DB, 3); Exit;
    End;
    If Mnem = 'FLDCW' Then Begin EmitMem($D9, 5); Exit; End;
    If Mnem = 'FNSTCW' Then Begin EmitMem($D9, 7); Exit; End;
    If Mnem = 'FSTCW' Then Begin BcEmitB($9B); EmitMem($D9, 7); Exit; End;
    AssembleX87 := False;
  End;

Begin { BcAssemble }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;
  SplitOps(Tmp);

  { ---- Instructions sans operandes ---- }
  If Mnem = 'RET' Then
  Begin
    If (Op1 <> '') And BcParseImm(Op1, ImmVal) Then
    Begin BcEmitB($C2); BcEmitB(Byte(ImmVal)); BcEmitB(Byte(ImmVal Shr 8)); End
    Else
      BcEmitB($C3);
    Exit;
  End;
  If Mnem = 'PUSHAD' Then Begin BcEmitB($60); Exit; End;
  If Mnem = 'POPAD' Then Begin BcEmitB($61); Exit; End;
  If Mnem = 'CDQ' Then Begin BcEmitB($99); Exit; End;
  If Mnem = 'SAHF' Then Begin BcEmitB($9E); Exit; End;
  If Mnem = 'LAHF' Then Begin BcEmitB($9F); Exit; End;
  If (Length(Mnem) > 1) And (Mnem[1] = 'F') Then
    If AssembleX87 Then Exit;
  If Mnem = 'NOP' Then Begin BcEmitB($90); Exit; End;
  If Mnem = 'LODSB' Then Begin BcEmitB($AC); Exit; End;
  If Mnem = 'LODSD' Then Begin BcEmitB($AD); Exit; End;
  If Mnem = 'STOSB' Then Begin BcEmitB($AA); Exit; End;
  If Mnem = 'STOSD' Then Begin BcEmitB($AB); Exit; End;
  If Mnem = 'MOVSB' Then Begin BcEmitB($A4); Exit; End;
  If Mnem = 'MOVSD' Then Begin BcEmitB($A5); Exit; End;
  If Mnem = 'SCASB' Then Begin BcEmitB($AE); Exit; End;
  If Mnem = 'SCASD' Then Begin BcEmitB($AF); Exit; End;
  If Mnem = 'CMPSB' Then Begin BcEmitB($A6); Exit; End;
  If Mnem = 'CMPSD' Then Begin BcEmitB($A7); Exit; End;
  If Mnem = 'CLD' Then Begin BcEmitB($FC); Exit; End;
  If Mnem = 'STD' Then Begin BcEmitB($FD); Exit; End;
  If Mnem = 'REP' Then Begin BcEmitB($F3);
    { Le reste est l instruction suivante }
    If Op1 <> '' Then BcAssemble(Op1);
    Exit; End;
  If Mnem = 'REPE' Then Begin BcEmitB($F3);
    If Op1 <> '' Then BcAssemble(Op1);
    Exit; End;

  { ---- PUSH ---- }
  If Mnem = 'PUSH' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then { PUSH reg32 }
    Begin BcEmitB($50 + Reg1); Exit; End;
    If Pos('OFFSET ', StrUpperCase(Op1)) = 1 Then
    Begin { PUSH OFFSET label }
      Tmp := Copy(Op1, 8, 255);
      While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
      { Verifier si label+disp }
      DataAdd := 0;
      DataLbl := Tmp;
      P := 2;
      While P <= Length(Tmp) Do
      Begin
        If (Tmp[P] = '+') Or (Tmp[P] = '-') Then
        Begin
          DataLbl := Copy(Tmp, 1, P - 1);
          Rest := Copy(Tmp, P, Length(Tmp) - P + 1);
          If (Rest[1] = '+') Then Delete(Rest, 1, 1);
          While (Length(Rest) > 0) And (Rest[1] = ' ') Do Delete(Rest, 1, 1);
          Neg3 := False;
          If (Length(Rest) > 0) And (Rest[1] = '-') Then
          Begin Neg3 := True; Delete(Rest, 1, 1);
            While (Length(Rest) > 0) And (Rest[1] = ' ') Do Delete(Rest, 1, 1);
          End;
          BcParseImm(Rest, DataAdd);
          If Neg3 Then DataAdd := -DataAdd;
          Break;
        End;
        Inc(P);
      End;
      BcEmitB($68);
      BcAddFixup(BC_FIX_ABS32_DATA, DataLbl, DataAdd);
      BcEmitD(0);
      Exit;
    End;
    If HasDWordPrefix(Op1) Then
    Begin { PUSH DWORD PTR [mem] }
      Tmp := StripSizePrefix(Op1);
      BcEmitB($FF);
      BcEmitMemRM(Tmp, 6, DataLbl, DataAdd);
      Exit;
    End;
    If BcParseImm(Op1, ImmVal) Then
    Begin
      If (ImmVal >= -128) And (ImmVal <= 127) Then
      Begin BcEmitB($6A); BcEmitB(Byte(ImmVal)); End
      Else Begin BcEmitB($68); BcEmitD(ImmVal); End;
      Exit;
    End;
    Exit;
  End;

  { ---- POP ---- }
  If Mnem = 'POP' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then BcEmitB($58 + Reg1);
    Exit;
  End;

  { ---- CALL ---- }
  If Mnem = 'CALL' Then
  Begin
    If HasDWordPrefix(Op1) Then
    Begin { CALL DWORD PTR [mem] - indirect }
      Tmp := StripSizePrefix(Op1);
      BcEmitB($FF);
      BcEmitMemRM(Tmp, 2, DataLbl, DataAdd);
      Exit;
    End;
    { CALL reg32 : FF D0+reg }
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then
    Begin
      BcEmitB($FF); BcEmitB($D0 + Reg1);
      Exit;
    End;
    { CALL label ou CALL api }
    Tmp := Op1;
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
    If BcIsImport(Tmp) Then
    Begin
      { CALL [IAT+slot] : FF 15 abs32 }
      Slot := BcFindOrAddImport(Tmp);
      BcEmitB($FF); BcEmitB($15);
      BcAddFixup(BC_FIX_ABS32_IMP, BcImports[Slot].ApiName, Slot);
      BcEmitD(0);
    End
    Else
    Begin
      { CALL rel32 vers label interne }
      BcEmitB($E8);
      BcAddFixup(BC_FIX_REL32, Tmp, 0);
      BcEmitD(0);
    End;
    Exit;
  End;

  { ---- JMP / Jcc ---- }
  If (Mnem = 'JMP') Or (Mnem = 'JE') Or (Mnem = 'JNE') Or
     (Mnem = 'JZ') Or (Mnem = 'JNZ') Or (Mnem = 'JG') Or
     (Mnem = 'JGE') Or (Mnem = 'JL') Or (Mnem = 'JLE') Or
     (Mnem = 'JA') Or (Mnem = 'JB') Or (Mnem = 'JBE') Or
     (Mnem = 'JAE') Or (Mnem = 'JNC') Or
     (Mnem = 'JC') Or (Mnem = 'JS') Or (Mnem = 'JNS') Then
  Begin
    If Mnem = 'JMP' Then
    Begin BcEmitB($E9); End
    Else Begin
      BcEmitB($0F);
      If (Mnem = 'JE') Or (Mnem = 'JZ') Then BcEmitB($84)
      Else If (Mnem = 'JNE') Or (Mnem = 'JNZ') Then BcEmitB($85)
      Else If Mnem = 'JG' Then BcEmitB($8F)
      Else If Mnem = 'JGE' Then BcEmitB($8D)
      Else If Mnem = 'JL' Then BcEmitB($8C)
      Else If Mnem = 'JLE' Then BcEmitB($8E)
      Else If Mnem = 'JA' Then BcEmitB($87)
      Else If (Mnem = 'JB') Or (Mnem = 'JC') Then BcEmitB($82)
      Else If Mnem = 'JBE' Then BcEmitB($86)
      Else If (Mnem = 'JAE') Or (Mnem = 'JNC') Then BcEmitB($83)
      Else If Mnem = 'JS' Then BcEmitB($88)
      Else If Mnem = 'JNS' Then BcEmitB($89);
    End;
    BcAddFixup(BC_FIX_REL32, Op1, 0);
    BcEmitD(0);
    Exit;
  End;

  { ---- Formes 16 bits (AX, BX, ... / WORD PTR) ---- }
  If ((Mnem = 'MOV') Or (Mnem = 'ADD') Or (Mnem = 'SUB') Or (Mnem = 'CMP') Or
      (Mnem = 'AND') Or (Mnem = 'OR') Or (Mnem = 'XOR') Or (Mnem = 'TEST') Or
      (Mnem = 'INC') Or (Mnem = 'DEC')) And Assemble16 Then
    Exit;

  { ---- XCHG reg,reg ---- }
  If Mnem = 'XCHG' Then
  Begin
    Reg1 := BcParseReg32(Op1); Reg2 := BcParseReg32(Op2);
    If (Reg1 >= 0) And (Reg2 >= 0) Then
    Begin BcEmitB($87); BcEmitB($C0 + Reg1 * 8 + Reg2); Exit; End;
    Reg1 := BcParseReg8(Op1); Reg2 := BcParseReg8(Op2);
    If (Reg1 >= 0) And (Reg2 >= 0) Then
    Begin BcEmitB($86); BcEmitB($C0 + Reg1 * 8 + Reg2); Exit; End;
    Exit;
  End;

  { ---- MUL reg ---- }
  If Mnem = 'MUL' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F7); BcEmitB($E0 + Reg1); Exit; End;
    Reg1 := BcParseReg8(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F6); BcEmitB($E0 + Reg1); Exit; End;
    Tmp := StripSizePrefix(Op1);
    If StartsWithBracket(Tmp) Then
    Begin
      { MUL DWORD PTR [mem] : F7 /4 (EDX:EAX = EAX * [mem]) }
      BcEmitB($F7); BcEmitMemRM(Tmp, 4, DataLbl, DataAdd);
    End;
    Exit;
  End;

  { ---- MOV ---- }
  If Mnem = 'MOV' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then
    Begin
      Reg2 := BcParseReg32(Op2);
      If Reg2 >= 0 Then
      Begin { MOV reg32,reg32 }
        BcEmitB($89); BcEmitB($C0 + Reg2 * 8 + Reg1); Exit;
      End;
      If BcParseImm(Op2, ImmVal) Then
      Begin { MOV reg32,imm32 }
        BcEmitB($B8 + Reg1); BcEmitD(ImmVal); Exit;
      End;
      If Pos('OFFSET ', StrUpperCase(Op2)) = 1 Then
      Begin { MOV reg32,OFFSET label[+disp] : B8+r abs32 }
        ParseOffsetOperand(Op2, DataLbl, DataAdd);
        BcEmitB($B8 + Reg1);
        BcAddFixup(BC_FIX_ABS32_DATA, DataLbl, DataAdd);
        BcEmitD(0);
        Exit;
      End;
      If HasDWordPrefix(Op2) Or StartsWithBracket(Op2) Then
      Begin { MOV reg32,[mem] }
        Tmp := StripSizePrefix(Op2);
        If Not StartsWithBracket(Tmp) Then Tmp := Op2;
        If StartsWithBracket(Tmp) Then
        Begin
          BcEmitB($8B);
          BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
          Exit;
        End;
      End;
      Exit;
    End;
    { MOV reg8, ... }
    Reg1 := BcParseReg8(Op1);
    If Reg1 >= 0 Then
    Begin
      If HasBytePrefix(Op2) Or StartsWithBracket(Op2) Then
      Begin { MOV reg8,[mem] }
        Tmp := StripSizePrefix(Op2);
        If Not StartsWithBracket(Tmp) Then Tmp := Op2;
        If StartsWithBracket(Tmp) Then
        Begin
          BcEmitB($8A);
          BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
          Exit;
        End;
      End;
      Reg2 := BcParseReg8(Op2);
      If Reg2 >= 0 Then
      Begin BcEmitB($88); BcEmitB($C0 + Reg2 * 8 + Reg1); Exit; End;
      If BcParseImm(Op2, ImmVal) Then
      Begin { MOV reg8,imm8 : B0+r ib }
        BcEmitB($B0 + Reg1); BcEmitB(Byte(ImmVal)); Exit;
      End;
      Exit;
    End;
    { MOV [mem], ... }
    If HasBytePrefix(Op1) Or HasDWordPrefix(Op1) Or HasWordPrefix(Op1) Or
       StartsWithBracket(Op1) Then
    Begin
      IsByte := HasBytePrefix(Op1);
      IsWord := HasWordPrefix(Op1);
      Tmp := StripSizePrefix(Op1);
      If Not StartsWithBracket(Tmp) Then Tmp := Op1;

      If IsByte Then
      Begin
        Reg2 := BcParseReg8(Op2);
        If Reg2 >= 0 Then
        Begin { MOV BYTE PTR [mem], reg8 }
          BcEmitB($88);
          BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
          Exit;
        End;
        { MOV BYTE PTR [mem], imm8 }
        If BcParseImm(Op2, ImmVal) Then
        Begin
          BcEmitB($C6);
          BcEmitMemRM(Tmp, 0, DataLbl, DataAdd);
          BcEmitB(Byte(ImmVal));
          Exit;
        End;
        { MOV BYTE PTR [mem], 'c' }
        If (Length(Op2) = 3) And (Op2[1] = '''') And (Op2[3] = '''') Then
        Begin
          BcEmitB($C6);
          BcEmitMemRM(Tmp, 0, DataLbl, DataAdd);
          BcEmitB(Byte(Op2[2]));
          Exit;
        End;
        Exit;
      End;
      If IsWord Then
      Begin
        Reg2 := BcParseReg16(Op2);
        If Reg2 >= 0 Then
        Begin { MOV WORD PTR [mem], reg16 }
          BcEmitB($66); BcEmitB($89);
          BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
          Exit;
        End;
        Exit;
      End;
      { Check plain [mem],reg8 (e.g. MOV [EDI],AL without BYTE PTR) }
      Reg2 := BcParseReg8(Op2);
      If Reg2 >= 0 Then
      Begin { MOV [mem], reg8 }
        BcEmitB($88);
        BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
        Exit;
      End;
      { DWORD or plain [mem] }
      Reg2 := BcParseReg32(Op2);
      If Reg2 >= 0 Then
      Begin { MOV [mem], reg32 }
        BcEmitB($89);
        BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
        Exit;
      End;
      If BcParseImm(Op2, ImmVal) Then
      Begin { MOV DWORD PTR [mem], imm32 }
        BcEmitB($C7);
        BcEmitMemRM(Tmp, 0, DataLbl, DataAdd);
        BcEmitD(ImmVal);
        Exit;
      End;
      Exit;
    End;
    { MOV ESP,EBP special non attrape }
    Exit;
  End;

  { ---- LEA ---- }
  If Mnem = 'LEA' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then
    Begin
      Tmp := StripSizePrefix(Op2);
      If Not StartsWithBracket(Tmp) Then Tmp := Op2;
      If StartsWithBracket(Tmp) Then
      Begin
        BcEmitB($8D);
        BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
      End
      Else
      Begin { LEA reg,[label] sans crochets }
        BcEmitB($8D);
        BcEmitB($05 Or (Reg1 Shl 3));
        DataAdd := 0;
        P := 2;
        DataLbl := Tmp;
        While P <= Length(Tmp) Do
        Begin
          If (Tmp[P] = '+') Or (Tmp[P] = '-') Then
          Begin
            DataLbl := Copy(Tmp, 1, P - 1);
            R2 := Copy(Tmp, P, Length(Tmp) - P + 1);
            If R2[1] = '+' Then Delete(R2, 1, 1);
            BcParseImm(R2, DataAdd);
            Break;
          End;
          Inc(P);
        End;
        BcAddFixup(BC_FIX_ABS32_DATA, DataLbl, DataAdd);
        BcEmitD(0);
      End;
    End;
    Exit;
  End;

  { ---- MOVZX ---- }
  If (Mnem = 'MOVZX') Or (Mnem = 'MOVSX') Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then
    Begin
      BcEmitB($0F);
      Tmp := StripSizePrefix(Op2);
      If Not StartsWithBracket(Tmp) Then
      Begin
        Reg2 := BcParseReg8(Tmp);
        If Reg2 >= 0 Then
        Begin
          If Mnem = 'MOVZX' Then BcEmitB($B6) Else BcEmitB($BE);
          BcEmitB($C0 + Reg1 * 8 + Reg2); Exit;
        End;
        Reg2 := BcParseReg16(Tmp);
        If Reg2 >= 0 Then
        Begin
          If Mnem = 'MOVZX' Then BcEmitB($B7) Else BcEmitB($BF);
          BcEmitB($C0 + Reg1 * 8 + Reg2); Exit;
        End;
        Tmp := Op2;
      End;
      If HasWordPrefix(Op2) Then
      Begin If Mnem = 'MOVZX' Then BcEmitB($B7) Else BcEmitB($BF); End
      Else
      Begin If Mnem = 'MOVZX' Then BcEmitB($B6) Else BcEmitB($BE); End;
      If StartsWithBracket(Tmp) Then
        BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
    End;
    Exit;
  End;

  { ---- ADD/SUB/CMP/AND/OR/XOR/TEST ---- }
  If (Mnem = 'ADD') Or (Mnem = 'SUB') Or (Mnem = 'CMP') Or
     (Mnem = 'AND') Or (Mnem = 'OR') Or (Mnem = 'XOR') Or
     (Mnem = 'TEST') Then
  Begin
    If Mnem = 'ADD' Then AluOp := 0
    Else If Mnem = 'OR' Then AluOp := 1
    Else If Mnem = 'AND' Then AluOp := 4
    Else If Mnem = 'SUB' Then AluOp := 5
    Else If Mnem = 'XOR' Then AluOp := 6
    Else If Mnem = 'CMP' Then AluOp := 7
    Else AluOp := -1; { TEST }

    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then
    Begin
      Reg2 := BcParseReg32(Op2);
      If Reg2 >= 0 Then
      Begin { op reg,reg }
        If AluOp >= 0 Then
        Begin BcEmitB(AluOp * 8 + 1); BcEmitB($C0 + Reg2 * 8 + Reg1); End
        Else { TEST }
        Begin BcEmitB($85); BcEmitB($C0 + Reg1 * 8 + Reg2); End;
        Exit;
      End;
      If BcParseImm(Op2, ImmVal) Then
      Begin { op reg,imm }
        If AluOp >= 0 Then
        Begin
          If (ImmVal >= -128) And (ImmVal <= 127) Then
          Begin BcEmitB($83); BcEmitB($C0 + AluOp * 8 + Reg1);
            BcEmitB(Byte(ImmVal)); End
          Else
          Begin
            If Reg1 = R_EAX Then
            Begin BcEmitB(AluOp * 8 + 5); BcEmitD(ImmVal); End
            Else Begin BcEmitB($81); BcEmitB($C0 + AluOp * 8 + Reg1);
              BcEmitD(ImmVal); End;
          End;
        End Else Begin { TEST reg,imm }
          If Reg1 = R_EAX Then Begin BcEmitB($A9); BcEmitD(ImmVal); End
          Else Begin BcEmitB($F7); BcEmitB($C0 + Reg1); BcEmitD(ImmVal); End;
        End;
        Exit;
      End;
      { op reg32,[mem] : e.g. CMP EAX,DWORD PTR [label] }
      If HasDWordPrefix(Op2) Or StartsWithBracket(Op2) Then
      Begin
        Tmp := StripSizePrefix(Op2);
        If Not StartsWithBracket(Tmp) Then Tmp := Op2;
        If StartsWithBracket(Tmp) Then
        Begin
          If AluOp >= 0 Then
            BcEmitB(AluOp * 8 + 3)       { ADD=03 OR=0B AND=23 SUB=2B XOR=33 CMP=3B }
          Else
            BcEmitB($85);                 { TEST reg,[mem] }
          BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
          Exit;
        End;
      End;
      Exit;
    End;
    { op reg8,... }
    Reg1 := BcParseReg8(Op1);
    If Reg1 >= 0 Then
    Begin
      If BcParseImm(Op2, ImmVal) Then
      Begin
        If AluOp >= 0 Then
        Begin
          If Reg1 = 0 Then { AL }
          Begin BcEmitB(AluOp * 8 + 4); BcEmitB(Byte(ImmVal)); End
          Else Begin BcEmitB($80); BcEmitB($C0 + AluOp * 8 + Reg1);
            BcEmitB(Byte(ImmVal)); End;
        End Else Begin { TEST reg8,imm8 }
          If Reg1 = 0 Then Begin BcEmitB($A8); BcEmitB(Byte(ImmVal)); End
          Else Begin BcEmitB($F6); BcEmitB($C0 + Reg1); BcEmitB(Byte(ImmVal)); End;
        End;
        Exit;
      End;
      Reg2 := BcParseReg8(Op2);
      If Reg2 >= 0 Then
      Begin
        If AluOp >= 0 Then
        Begin BcEmitB(AluOp * 8); BcEmitB($C0 + Reg2 * 8 + Reg1); End
        Else Begin BcEmitB($84); BcEmitB($C0 + Reg1 * 8 + Reg2); End;
        Exit;
      End;
      Exit;
    End;
    { op [mem],reg32  /  op DWORD PTR [mem],imm32 }
    If HasDWordPrefix(Op1) Or (StartsWithBracket(Op1) And Not HasBytePrefix(Op1)) Then
    Begin
      Tmp := StripSizePrefix(Op1);
      If Not StartsWithBracket(Tmp) Then Tmp := Op1;
      Reg2 := BcParseReg32(Op2);
      If Reg2 >= 0 Then
      Begin
        If AluOp >= 0 Then BcEmitB(AluOp * 8 + 1) Else BcEmitB($85);
        BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
        Exit;
      End;
      Reg2 := BcParseReg8(Op2);
      If Reg2 >= 0 Then
      Begin
        If AluOp >= 0 Then BcEmitB(AluOp * 8) Else BcEmitB($84);
        BcEmitMemRM(Tmp, Reg2, DataLbl, DataAdd);
        Exit;
      End;
      If BcParseImm(Op2, ImmVal) Then
      Begin
        If AluOp < 0 Then
        Begin BcEmitB($F7); BcEmitMemRM(Tmp, 0, DataLbl, DataAdd); BcEmitD(ImmVal); End
        Else If (ImmVal >= -128) And (ImmVal <= 127) Then
        Begin BcEmitB($83); BcEmitMemRM(Tmp, AluOp, DataLbl, DataAdd); BcEmitB(Byte(ImmVal)); End
        Else
        Begin BcEmitB($81); BcEmitMemRM(Tmp, AluOp, DataLbl, DataAdd); BcEmitD(ImmVal); End;
        Exit;
      End;
      Exit;
    End;
    { CMP BYTE PTR [mem],imm }
    If HasBytePrefix(Op1) Then
    Begin
      Tmp := StripSizePrefix(Op1);
      If StartsWithBracket(Tmp) Then
      Begin
        If AluOp >= 0 Then BcEmitB($80)
        Else BcEmitB($F6);
        BcEmitMemRM(Tmp, AluOp And 7, DataLbl, DataAdd);
        If BcParseImm(Op2, ImmVal) Then BcEmitB(Byte(ImmVal));
      End;
      Exit;
    End;
    If HasDWordPrefix(Op1) Then
    Begin
      Tmp := StripSizePrefix(Op1);
      If StartsWithBracket(Tmp) Then
      Begin
        If BcParseImm(Op2, ImmVal) Then
        Begin
          If (ImmVal >= -128) And (ImmVal <= 127) And (AluOp >= 0) Then
          Begin
            BcEmitB($83);
            BcEmitMemRM(Tmp, AluOp And 7, DataLbl, DataAdd);
            BcEmitB(Byte(ImmVal));
          End
          Else
          Begin
            If AluOp >= 0 Then BcEmitB($81) Else BcEmitB($F7);
            BcEmitMemRM(Tmp, AluOp And 7, DataLbl, DataAdd);
            BcEmitD(ImmVal);
          End;
        End;
      End;
      Exit;
    End;
    Exit;
  End;

  { ---- INC / DEC ---- }
  If Mnem = 'INC' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then BcEmitB($40 + Reg1)
    Else If HasDWordPrefix(Op1) Then
    Begin Tmp := StripSizePrefix(Op1);
      BcEmitB($FF); BcEmitMemRM(Tmp, 0, DataLbl, DataAdd); End
    Else If HasBytePrefix(Op1) Or StartsWithBracket(Op1) Then
    Begin Tmp := StripSizePrefix(Op1);
      BcEmitB($FE); BcEmitMemRM(Tmp, 0, DataLbl, DataAdd); End;
    Exit;
  End;
  If Mnem = 'DEC' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then BcEmitB($48 + Reg1)
    Else If HasDWordPrefix(Op1) Then
    Begin Tmp := StripSizePrefix(Op1);
      BcEmitB($FF); BcEmitMemRM(Tmp, 1, DataLbl, DataAdd); End
    Else If HasBytePrefix(Op1) Or StartsWithBracket(Op1) Then
    Begin Tmp := StripSizePrefix(Op1);
      BcEmitB($FE); BcEmitMemRM(Tmp, 1, DataLbl, DataAdd); End;
    Exit;
  End;

  { ---- NEG / NOT / DIV / IMUL ---- }
  If Mnem = 'NEG' Then
  Begin Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F7); BcEmitB($D8 + Reg1); End;
    Exit; End;
  If Mnem = 'NOT' Then
  Begin Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F7); BcEmitB($D0 + Reg1); End;
    Exit; End;
  If Mnem = 'DIV' Then
  Begin Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F7); BcEmitB($F0 + Reg1); End
    Else Begin Reg1 := BcParseReg8(Op1);
      If Reg1 >= 0 Then Begin BcEmitB($F6); BcEmitB($F0 + Reg1); End; End;
    Exit; End;
  If Mnem = 'IDIV' Then
  Begin Reg1 := BcParseReg32(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($F7); BcEmitB($F8 + Reg1); End
    Else Begin Reg1 := BcParseReg8(Op1);
      If Reg1 >= 0 Then Begin BcEmitB($F6); BcEmitB($F8 + Reg1); End; End;
    Exit; End;
  If Mnem = 'IMUL' Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If (Op2 <> '') Then
    Begin
      { IMUL reg1,op2,imm  ou  IMUL reg1,reg2 }
      ImOp2 := Op2; ImOp3 := '';
      Cp := Pos(',', ImOp2);
      If Cp > 0 Then
      Begin ImOp3 := Copy(ImOp2, Cp + 1, 255); ImOp2 := Copy(ImOp2, 1, Cp - 1);
        While (Length(ImOp3) > 0) And (ImOp3[1] = ' ') Do Delete(ImOp3, 1, 1);
        While (Length(ImOp2) > 0) And (ImOp2[Length(ImOp2)] = ' ') Do
          Delete(ImOp2, Length(ImOp2), 1);
      End;
      If ImOp3 <> '' Then
      Begin
        Reg2 := BcParseReg32(ImOp2);
        If (Reg2 >= 0) And BcParseImm(ImOp3, ImmVal) Then
        Begin
          If (ImmVal >= -128) And (ImmVal <= 127) Then
          Begin BcEmitB($6B); BcEmitB($C0 + Reg1 * 8 + Reg2);
            BcEmitB(Byte(ImmVal)); End
          Else Begin BcEmitB($69); BcEmitB($C0 + Reg1 * 8 + Reg2);
            BcEmitD(ImmVal); End;
        End;
      End
      Else
      Begin
        Reg2 := BcParseReg32(ImOp2);
        If Reg2 >= 0 Then
        Begin BcEmitB($0F); BcEmitB($AF);
          BcEmitB($C0 + Reg1 * 8 + Reg2); End
        Else If BcParseImm(ImOp2, ImmVal) Then
        Begin
          { IMUL reg,imm -> encode as IMUL reg,reg,imm }
          If (ImmVal >= -128) And (ImmVal <= 127) Then
          Begin BcEmitB($6B); BcEmitB($C0 + Reg1 * 8 + Reg1);
            BcEmitB(Byte(ImmVal)); End
          Else Begin BcEmitB($69); BcEmitB($C0 + Reg1 * 8 + Reg1);
            BcEmitD(ImmVal); End;
        End
        Else If HasDWordPrefix(ImOp2) Or StartsWithBracket(ImOp2) Then
        Begin
          { IMUL reg,DWORD PTR [mem] }
          Tmp := ImOp2;
          If HasDWordPrefix(Tmp) Then Tmp := StripSizePrefix(Tmp);
          BcEmitB($0F); BcEmitB($AF);
          BcEmitMemRM(Tmp, Reg1, DataLbl, DataAdd);
        End;
      End;
    End
    Else If Reg1 >= 0 Then
    Begin BcEmitB($F7); BcEmitB($E8 + Reg1); End;
    Exit;
  End;

  { ---- SHL / SHR ---- }
  If (Mnem = 'SHL') Or (Mnem = 'SHR') Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If (Reg1 >= 0) And (StrUpperCase(Op2) = 'CL') Then
    Begin
      { SHL/SHR reg32,CL : D3 /4 ou /5 }
      BcEmitB($D3);
      If Mnem = 'SHL' Then BcEmitB($E0 + Reg1)
      Else BcEmitB($E8 + Reg1);
      Exit;
    End;
    If (Reg1 >= 0) And BcParseImm(Op2, ImmVal) Then
    Begin
      If ImmVal = 1 Then
      Begin BcEmitB($D1);
        If Mnem = 'SHL' Then BcEmitB($E0 + Reg1)
        Else BcEmitB($E8 + Reg1); End
      Else Begin BcEmitB($C1);
        If Mnem = 'SHL' Then BcEmitB($E0 + Reg1)
        Else BcEmitB($E8 + Reg1);
        BcEmitB(Byte(ImmVal)); End;
    End;
    Exit;
  End;

  { ---- ROL / ROR / SAR reg32,imm8 | CL : C1 /0 /1 /7, D3 /0 /1 /7 ---- }
  If (Mnem = 'ROL') Or (Mnem = 'ROR') Or (Mnem = 'SAR') Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If Mnem = 'ROL' Then Reg2 := $C0 Else If Mnem = 'ROR' Then Reg2 := $C8 Else Reg2 := $F8;
    If (Reg1 >= 0) And (StrUpperCase(Op2) = 'CL') Then
    Begin
      BcEmitB($D3); BcEmitB(Reg2 + Reg1);
      Exit;
    End;
    If (Reg1 >= 0) And BcParseImm(Op2, ImmVal) Then
    Begin
      If ImmVal = 1 Then Begin BcEmitB($D1); BcEmitB(Reg2 + Reg1); End
      Else Begin BcEmitB($C1); BcEmitB(Reg2 + Reg1); BcEmitB(Byte(ImmVal)); End;
    End;
    Exit;
  End;

  { ---- BT / BTS / BTR / BTC ---- }
  If (Mnem = 'BT') Or (Mnem = 'BTS') Or (Mnem = 'BTR') Or (Mnem = 'BTC') Then
  Begin
    Reg1 := BcParseReg32(Op1);
    If (Reg1 >= 0) And BcParseImm(Op2, ImmVal) Then
    Begin
      { reg, imm8 form: 0F BA /4|/5|/6|/7 ib }
      BcEmitB($0F); BcEmitB($BA);
      If Mnem = 'BT'  Then BcEmitB($E0 + Reg1)
      Else If Mnem = 'BTS' Then BcEmitB($E8 + Reg1)
      Else If Mnem = 'BTR' Then BcEmitB($F0 + Reg1)
      Else BcEmitB($F8 + Reg1);  { BTC }
      BcEmitB(Byte(ImmVal));
    End
    Else
    Begin
      { [reg1], reg2 form }
      Reg2 := BcParseReg32(Op2);
      If (Reg2 >= 0) Then
      Begin
        Tmp := Op1;
        If (Length(Tmp) > 2) And (Tmp[1] = '[') And (Tmp[Length(Tmp)] = ']') Then
        Begin
          Tmp := Copy(Tmp, 2, Length(Tmp) - 2);
          Reg1 := BcParseReg32(Tmp);
          If Reg1 >= 0 Then
          Begin
            BcEmitB($0F);
            If Mnem = 'BT'  Then BcEmitB($A3)
            Else If Mnem = 'BTS' Then BcEmitB($AB)
            Else If Mnem = 'BTR' Then BcEmitB($B3)
            Else BcEmitB($BB);  { BTC }
            BcEmitB((Reg2 Shl 3) Or Reg1);  { ModR/M [reg1], reg2 }
          End;
        End;
      End;
    End;
    Exit;
  End;

  { ---- INT ---- }
  If Mnem = 'INT' Then
  Begin
    If BcParseImm(Op1, ImmVal) Then
    Begin BcEmitB($CD); BcEmitB(Byte(ImmVal)); End;
    Exit;
  End;

  { ---- DD (data dans le code) ---- }
  If Mnem = 'DD' Then
  Begin
    If BcParseImm(Op1, ImmVal) Then BcEmitD(ImmVal)
    Else BcEmitD(0);
    Exit;
  End;

  { Instruction non reconnue : emettre NOP comme placeholder }
  { WriteLn('BcAssemble: non reconnu: [', S, ']'); }
End;

{ ============================================================ }
{ BcAssemble8086 - Mini-assembleur Intel 8086 (mode reel/prot) }
{ Traduit automatiquement les noms de registres 32 bits en 16  }
{ bits (EAX->AX, ESI->SI, etc.) pour supporter le code emis   }
{ par le compilateur en mode -CD (DOS 16 bits).                }
{ ============================================================ }

Procedure BcAssemble8086(Const S: TString);
Var
  Line, Mnem, Tmp, Op1, Op2: TString;
  P: Integer;
  Reg1, Reg2, ImmVal: LongInt;
  DataLbl: TString;
  DataAdd: LongInt;
  UOp1, UOp2: TString;

  Procedure SplitOps8086(Const Rest: TString);
  Var J: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1;
    While J <= Length(Rest) Do
    Begin
      If (Rest[J] = ',') Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

  Function Reg16(Const S: TString): Integer;
  { Retourne 0-7 pour registre 16 bits (traduit E?? en ??) }
  Var U: TString;
  Begin
    U := StrUpperCase(S);
    If (U = 'AX') Or (U = 'EAX') Then Reg16 := 0
    Else If (U = 'CX') Or (U = 'ECX') Then Reg16 := 1
    Else If (U = 'DX') Or (U = 'EDX') Then Reg16 := 2
    Else If (U = 'BX') Or (U = 'EBX') Then Reg16 := 3
    Else If (U = 'SP') Or (U = 'ESP') Then Reg16 := 4
    Else If (U = 'BP') Or (U = 'EBP') Then Reg16 := 5
    Else If (U = 'SI') Or (U = 'ESI') Then Reg16 := 6
    Else If (U = 'DI') Or (U = 'EDI') Then Reg16 := 7
    Else Reg16 := -1;
  End;

  Function Reg8(Const S: TString): Integer;
  Var U: TString;
  Begin
    U := StrUpperCase(S);
    If U = 'AL' Then Reg8 := 0
    Else If U = 'CL' Then Reg8 := 1
    Else If U = 'DL' Then Reg8 := 2
    Else If U = 'BL' Then Reg8 := 3
    Else If U = 'AH' Then Reg8 := 4
    Else If U = 'CH' Then Reg8 := 5
    Else If U = 'DH' Then Reg8 := 6
    Else If U = 'BH' Then Reg8 := 7
    Else Reg8 := -1;
  End;

  Function ParseImm16(Const S: TString; Var V: LongInt): Boolean;
  Var U: TString; Code: Integer; W: LongInt;
  Begin
    ParseImm16 := False;
    U := StrUpperCase(S);
    While (Length(U) > 0) And (U[1] = ' ') Do Delete(U, 1, 1);
    If U = '' Then Exit;
    If U[Length(U)] = 'H' Then
    Begin
      Delete(U, Length(U), 1);
      System.Val('$' + U, W, Code);
      If Code = 0 Then Begin V := W; ParseImm16 := True; End;
    End
    Else
    Begin
      System.Val(U, W, Code);
      If Code = 0 Then Begin V := W; ParseImm16 := True; End;
    End;
  End;

  Function StartsWithBracket16(Const S: TString): Boolean;
  Var U: TString;
  Begin
    U := S;
    While (Length(U) > 0) And (U[1] = ' ') Do Delete(U, 1, 1);
    StartsWithBracket16 := (Length(U) > 0) And (U[1] = '[');
  End;

  Procedure ParseMemLabel(Const S: TString; Var Lbl: TString; Var Disp: LongInt);
  { Parse [LABEL] or [LABEL+disp] or [LABEL-disp] }
  Var U, R2: TString; J: Integer;
  Begin
    Lbl := ''; Disp := 0;
    U := S;
    While (Length(U) > 0) And (U[1] = ' ') Do Delete(U, 1, 1);
    If (Length(U) > 0) And (U[1] = '[') Then Delete(U, 1, 1);
    If (Length(U) > 0) And (U[Length(U)] = ']') Then Delete(U, Length(U), 1);
    { Chercher + ou - pour extraire le deplacement }
    J := 2;
    While J <= Length(U) Do
    Begin
      If (U[J] = '+') Or (U[J] = '-') Then
      Begin
        Lbl := Copy(U, 1, J - 1);
        R2 := Copy(U, J, Length(U) - J + 1);
        If R2[1] = '+' Then Delete(R2, 1, 1);
        ParseImm16(R2, Disp);
        Exit;
      End;
      Inc(J);
    End;
    Lbl := U;
  End;

  Function IsDOS: Boolean;
  Begin
    IsDOS := (Opts.DestTarget = DEST_DOSR) Or (Opts.DestTarget = DEST_DOSP);
  End;

Begin { BcAssemble8086 }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin
    Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;

  SplitOps8086(Tmp);
  UOp1 := StrUpperCase(Op1);
  UOp2 := StrUpperCase(Op2);

  { ---- NOP ---- }
  If Mnem = 'NOP' Then Begin BcEmitB($90); Exit; End;

  { ---- RET / RETF ---- }
  If Mnem = 'RET' Then Begin BcEmitB($C3); Exit; End;
  If Mnem = 'RETF' Then Begin BcEmitB($CB); Exit; End;

  { ---- INT ---- }
  If Mnem = 'INT' Then
  Begin
    BcEmitB($CD);
    If ParseImm16(Op1, ImmVal) Then BcEmitB(Byte(ImmVal))
    Else If UOp1 = '21H' Then BcEmitB($21)
    Else If UOp1 = '20H' Then BcEmitB($20)
    Else If UOp1 = '10H' Then BcEmitB($10)
    Else BcEmitB($03);
    Exit;
  End;

  { ---- HLT ---- }
  If Mnem = 'HLT' Then Begin BcEmitB($F4); Exit; End;

  { ---- CLC / STC / CLI / STI / CLD / STD ---- }
  If Mnem = 'CLC' Then Begin BcEmitB($F8); Exit; End;
  If Mnem = 'STC' Then Begin BcEmitB($F9); Exit; End;
  If Mnem = 'CLI' Then Begin BcEmitB($FA); Exit; End;
  If Mnem = 'STI' Then Begin BcEmitB($FB); Exit; End;
  If Mnem = 'CLD' Then Begin BcEmitB($FC); Exit; End;
  If Mnem = 'STD' Then Begin BcEmitB($FD); Exit; End;

  { ---- PUSHAD -> PUSH AX/CX/DX/BX/SP/BP/SI/DI ---- }
  If Mnem = 'PUSHAD' Then
  Begin
    BcEmitB($50);BcEmitB($51);BcEmitB($52);BcEmitB($53);
    BcEmitB($54);BcEmitB($55);BcEmitB($56);BcEmitB($57);
    Exit;
  End;
  { ---- POPAD -> POP DI/SI/BP/xx/BX/DX/CX/AX ---- }
  If Mnem = 'POPAD' Then
  Begin
    BcEmitB($5F);BcEmitB($5E);BcEmitB($5D);BcEmitB($5C);
    BcEmitB($5B);BcEmitB($5A);BcEmitB($59);BcEmitB($58);
    Exit;
  End;

  { ---- PUSH reg16 (accepte aussi 32-bit names) ---- }
  If Mnem = 'PUSH' Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($50 + Reg1); Exit; End;
    { PUSH imm (80186+) }
    If ParseImm16(Op1, ImmVal) Then
    Begin
      If (ImmVal >= -128) And (ImmVal <= 127) Then
      Begin BcEmitB($6A); BcEmitB(Byte(ImmVal)); End
      Else
      Begin BcEmitB($68); BcEmitW(Word(ImmVal)); End;
      Exit;
    End;
    { PUSH OFFSET label -> push data offset }
    If Copy(UOp1, 1, 7) = 'OFFSET ' Then
    Begin
      Tmp := Copy(Op1, 8, Length(Op1) - 7);
      While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
      BcEmitB($68); { PUSH imm16 }
      BcAddFixup(BC_FIX_ABS16_DATA, Tmp, 0);
      BcEmitW(0);
      Exit;
    End;
    { PUSH DWORD PTR [...] / PUSH WORD PTR [...] -> skip pour Win32 }
    If (Pos('DWORD PTR', UOp1) > 0) Or (Pos('WORD PTR', UOp1) > 0) Then
      Exit;
    Exit;
  End;

  { ---- POP reg16 ---- }
  If Mnem = 'POP' Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($58 + Reg1); Exit; End;
    Exit;
  End;

  { ---- MOV ---- }
  If Mnem = 'MOV' Then
  Begin
    { MOV DS,AX  (8E D8+src) }
    If UOp1 = 'DS' Then
    Begin
      Reg2 := Reg16(Op2);
      If Reg2 >= 0 Then Begin BcEmitB($8E); BcEmitB($D8 + Reg2); End;
      Exit;
    End;
    If UOp1 = 'ES' Then
    Begin
      Reg2 := Reg16(Op2);
      If Reg2 >= 0 Then Begin BcEmitB($8E); BcEmitB($C0 + Reg2); End;
      Exit;
    End;
    { MOV reg16, reg16 : 8B C0+dst*8+src }
    Reg1 := Reg16(Op1); Reg2 := Reg16(Op2);
    If (Reg1 >= 0) And (Reg2 >= 0) Then
    Begin BcEmitB($8B); BcEmitB($C0 + Reg1 * 8 + Reg2); Exit; End;
    { MOV reg16, imm16 : B8+reg imm16 }
    If Reg1 >= 0 Then
    Begin
      If ParseImm16(Op2, ImmVal) Then
      Begin BcEmitB($B8 + Reg1); BcEmitW(Word(ImmVal)); Exit; End;
    End;
    { MOV reg8, imm8 : B0+reg imm8 }
    Reg1 := Reg8(Op1);
    If Reg1 >= 0 Then
    Begin
      Reg2 := Reg8(Op2);
      If Reg2 >= 0 Then
      Begin BcEmitB($8A); BcEmitB($C0 + Reg1 * 8 + Reg2); Exit; End;
      If ParseImm16(Op2, ImmVal) Then
      Begin BcEmitB($B0 + Reg1); BcEmitB(Byte(ImmVal)); Exit; End;
    End;
    { MOV BYTE PTR [label],imm8 / MOV BYTE PTR [label+d],imm8 }
    If (Pos('BYTE PTR', UOp1) > 0) Then
    Begin
      Tmp := Op1;
      P := Pos('[', Tmp);
      If P > 0 Then
      Begin
        Tmp := Copy(Tmp, P, Length(Tmp) - P + 1);
        ParseMemLabel(Tmp, DataLbl, DataAdd);
        { MOV [label], reg8 }
        Reg2 := Reg8(Op2);
        If Reg2 >= 0 Then
        Begin
          BcEmitB($88); BcEmitB($06 + Reg2 * 8); { ModRM: mod=00,rm=110 (disp16) }
          BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
          BcEmitW(0);
          Exit;
        End;
        { MOV BYTE PTR [label],imm8 }
        If ParseImm16(Op2, ImmVal) Then
        Begin
          BcEmitB($C6); BcEmitB($06); { ModRM: mod=00,reg=0,rm=110 }
          BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
          BcEmitW(0);
          BcEmitB(Byte(ImmVal));
          Exit;
        End;
      End;
    End;
    { MOV WORD PTR [label],imm16 / MOV [label],reg16 }
    If (Pos('WORD PTR', UOp1) > 0) Or (Pos('DWORD PTR', UOp1) > 0)
       Or StartsWithBracket16(Op1) Then
    Begin
      Tmp := Op1;
      P := Pos('[', Tmp);
      If P > 0 Then
      Begin
        Tmp := Copy(Tmp, P, Length(Tmp) - P + 1);
        ParseMemLabel(Tmp, DataLbl, DataAdd);
        Reg2 := Reg16(Op2);
        If Reg2 >= 0 Then
        Begin
          BcEmitB($89); BcEmitB($06 + Reg2 * 8); { MOV [disp16],reg16 }
          BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
          BcEmitW(0);
          Exit;
        End;
        If ParseImm16(Op2, ImmVal) Then
        Begin
          BcEmitB($C7); BcEmitB($06); { MOV WORD PTR [disp16],imm16 }
          BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
          BcEmitW(0);
          BcEmitW(Word(ImmVal));
          Exit;
        End;
      End;
    End;
    { MOV reg16,[label] - load from memory }
    Reg1 := Reg16(Op1);
    If (Reg1 >= 0) And StartsWithBracket16(Op2) Then
    Begin
      ParseMemLabel(Op2, DataLbl, DataAdd);
      BcEmitB($8B); BcEmitB($06 + Reg1 * 8); { MOV reg16,[disp16] }
      BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
      BcEmitW(0);
      Exit;
    End;
    Exit;
  End;

  { ---- LEA reg,[label] -> MOV reg, OFFSET label (en 16 bits) ---- }
  If Mnem = 'LEA' Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then
    Begin
      Tmp := Op2;
      While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
      If StartsWithBracket16(Tmp) Then
        ParseMemLabel(Tmp, DataLbl, DataAdd)
      Else
      Begin
        DataLbl := Tmp; DataAdd := 0;
        P := 2;
        While P <= Length(DataLbl) Do
        Begin
          If (DataLbl[P] = '+') Or (DataLbl[P] = '-') Then
          Begin
            Tmp := Copy(DataLbl, P, Length(DataLbl) - P + 1);
            DataLbl := Copy(DataLbl, 1, P - 1);
            If Tmp[1] = '+' Then Delete(Tmp, 1, 1);
            ParseImm16(Tmp, DataAdd);
            Break;
          End;
          Inc(P);
        End;
      End;
      { Emettre MOV reg16, imm16 avec fixup data }
      BcEmitB($B8 + Reg1); { MOV reg16, imm16 }
      BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
      BcEmitW(0);
    End;
    Exit;
  End;

  { ---- CALL label ---- }
  If Mnem = 'CALL' Then
  Begin
    Tmp := Op1;
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
    { Intercepter les API Win32 en mode DOS }
    If StrUpperCase(Tmp) = 'EXITPROCESS' Then
    Begin
      { MOV AX,4C00h / INT 21h }
      BcEmitB($B8); BcEmitW($4C00);  { MOV AX, 4C00h }
      BcEmitB($CD); BcEmitB($21);    { INT 21h }
      Exit;
    End;
    If (StrUpperCase(Tmp) = 'GETSTDHANDLE') Or
       (StrUpperCase(Tmp) = 'GETPROCESSHEAP') Or
       (StrUpperCase(Tmp) = 'WRITEFILE') Or
       (StrUpperCase(Tmp) = 'READFILE') Or
       (StrUpperCase(Tmp) = 'HEAPALLOC') Or
       (StrUpperCase(Tmp) = 'HEAPFREE') Then
      Exit; { Ignorer les API Win32 en mode DOS }
    { CALL DWORD PTR [...] -> ignorer en mode DOS }
    If Pos('DWORD PTR', StrUpperCase(Tmp)) > 0 Then Exit;
    { CALL near relative (E8 rel16) }
    BcEmitB($E8);
    BcAddFixup(BC_FIX_REL16, Tmp, 0);
    BcEmitW(0);
    Exit;
  End;

  { ---- JMP / Jcc labels ---- }
  If (Mnem = 'JMP') Or (Mnem = 'JE') Or (Mnem = 'JNE') Or
     (Mnem = 'JZ') Or (Mnem = 'JNZ') Or (Mnem = 'JG') Or
     (Mnem = 'JGE') Or (Mnem = 'JL') Or (Mnem = 'JLE') Or
     (Mnem = 'JA') Or (Mnem = 'JB') Or (Mnem = 'JBE') Or
     (Mnem = 'JAE') Or (Mnem = 'JNC') Or
     (Mnem = 'JC') Or (Mnem = 'JS') Or (Mnem = 'JNS') Then
  Begin
    If Mnem = 'JMP' Then
    Begin
      BcEmitB($E9); { JMP rel16 }
      BcAddFixup(BC_FIX_REL16, Op1, 0);
      BcEmitW(0);
    End
    Else
    Begin
      { Jcc : utiliser JNcc $+5 / JMP rel16 (compatible 8086) }
      { D abord l octet Jcc inverse qui saute par-dessus le JMP }
      If (Mnem = 'JE') Or (Mnem = 'JZ') Then BcEmitB($75)   { JNE }
      Else If (Mnem = 'JNE') Or (Mnem = 'JNZ') Then BcEmitB($74) { JE }
      Else If Mnem = 'JG'  Then BcEmitB($7E) { JLE }
      Else If Mnem = 'JGE' Then BcEmitB($7C) { JL }
      Else If Mnem = 'JL'  Then BcEmitB($7D) { JGE }
      Else If Mnem = 'JLE' Then BcEmitB($7F) { JG }
      Else If Mnem = 'JA'  Then BcEmitB($76) { JBE }
      Else If (Mnem = 'JB') Or (Mnem = 'JC') Then BcEmitB($73) { JNC }
      Else If Mnem = 'JBE' Then BcEmitB($77) { JA }
      Else If (Mnem = 'JAE') Or (Mnem = 'JNC') Then BcEmitB($72) { JB }
      Else If Mnem = 'JS'  Then BcEmitB($79) { JNS }
      Else If Mnem = 'JNS' Then BcEmitB($78); { JS }
      BcEmitB($03); { deplacement: sauter 3 octets (le JMP E9 XX XX) }
      { Puis le JMP inconditionnel }
      BcEmitB($E9); { JMP rel16 }
      BcAddFixup(BC_FIX_REL16, Op1, 0);
      BcEmitW(0);
    End;
    Exit;
  End;

  { ---- ADD / SUB / CMP / XOR / AND / OR / TEST ---- }
  If (Mnem = 'ADD') Or (Mnem = 'SUB') Or (Mnem = 'CMP') Or
     (Mnem = 'XOR') Or (Mnem = 'AND') Or (Mnem = 'OR') Or
     (Mnem = 'TEST') Then
  Begin
    Reg1 := Reg16(Op1); Reg2 := Reg16(Op2);
    { reg16, reg16 }
    If (Reg1 >= 0) And (Reg2 >= 0) Then
    Begin
      If Mnem = 'ADD'  Then Begin BcEmitB($01); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'SUB'  Then Begin BcEmitB($29); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'CMP'  Then Begin BcEmitB($39); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'XOR'  Then Begin BcEmitB($31); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'AND'  Then Begin BcEmitB($21); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'OR'   Then Begin BcEmitB($09); BcEmitB($C0 + Reg2*8 + Reg1); End
      Else If Mnem = 'TEST' Then Begin BcEmitB($85); BcEmitB($C0 + Reg2*8 + Reg1); End;
      Exit;
    End;
    { reg16, imm16 }
    If (Reg1 >= 0) And ParseImm16(Op2, ImmVal) Then
    Begin
      If Mnem = 'TEST' Then
      Begin
        If Reg1 = 0 Then Begin BcEmitB($A9); BcEmitW(Word(ImmVal)); End
        Else Begin BcEmitB($F7); BcEmitB($C0 + Reg1); BcEmitW(Word(ImmVal)); End;
      End
      Else
      Begin
        If (ImmVal >= -128) And (ImmVal <= 127) And (Mnem <> 'TEST') Then
        Begin
          { forme courte : 83 /r ib (sign-extended) }
          BcEmitB($83);
          If Mnem = 'ADD' Then BcEmitB($C0 + Reg1)
          Else If Mnem = 'SUB' Then BcEmitB($E8 + Reg1)
          Else If Mnem = 'CMP' Then BcEmitB($F8 + Reg1)
          Else If Mnem = 'XOR' Then BcEmitB($F0 + Reg1)
          Else If Mnem = 'AND' Then BcEmitB($E0 + Reg1)
          Else If Mnem = 'OR'  Then BcEmitB($C8 + Reg1);
          BcEmitB(Byte(ImmVal));
        End
        Else If Reg1 = 0 Then { AX, imm16 : forme courte }
        Begin
          If Mnem = 'ADD' Then BcEmitB($05)
          Else If Mnem = 'SUB' Then BcEmitB($2D)
          Else If Mnem = 'CMP' Then BcEmitB($3D)
          Else If Mnem = 'XOR' Then BcEmitB($35)
          Else If Mnem = 'AND' Then BcEmitB($25)
          Else If Mnem = 'OR'  Then BcEmitB($0D);
          BcEmitW(Word(ImmVal));
        End
        Else
        Begin { 81 /r iw }
          BcEmitB($81);
          If Mnem = 'ADD' Then BcEmitB($C0 + Reg1)
          Else If Mnem = 'SUB' Then BcEmitB($E8 + Reg1)
          Else If Mnem = 'CMP' Then BcEmitB($F8 + Reg1)
          Else If Mnem = 'XOR' Then BcEmitB($F0 + Reg1)
          Else If Mnem = 'AND' Then BcEmitB($E0 + Reg1)
          Else If Mnem = 'OR'  Then BcEmitB($C8 + Reg1);
          BcEmitW(Word(ImmVal));
        End;
      End;
      Exit;
    End;
    { CMP reg8, imm8 }
    Reg1 := Reg8(Op1);
    If (Reg1 >= 0) And ParseImm16(Op2, ImmVal) Then
    Begin
      If Mnem = 'CMP' Then
      Begin
        If Reg1 = 0 Then Begin BcEmitB($3C); BcEmitB(Byte(ImmVal)); End
        Else Begin BcEmitB($80); BcEmitB($F8 + Reg1); BcEmitB(Byte(ImmVal)); End;
      End
      Else If Mnem = 'TEST' Then
      Begin
        If Reg1 = 0 Then Begin BcEmitB($A8); BcEmitB(Byte(ImmVal)); End
        Else Begin BcEmitB($F6); BcEmitB($C0 + Reg1); BcEmitB(Byte(ImmVal)); End;
      End
      Else If Mnem = 'ADD' Then
      Begin BcEmitB($80); BcEmitB($C0 + Reg1); BcEmitB(Byte(ImmVal)); End
      Else If Mnem = 'SUB' Then
      Begin BcEmitB($80); BcEmitB($E8 + Reg1); BcEmitB(Byte(ImmVal)); End;
      Exit;
    End;
    { CMP BYTE PTR [ESI+ECX],0  -> utiliser LODSB-like pattern non supporté }
    { CMP BYTE PTR [label],imm8 }
    If (Pos('BYTE PTR', UOp1) > 0) And ParseImm16(Op2, ImmVal) Then
    Begin
      Tmp := Op1;
      P := Pos('[', Tmp);
      If P > 0 Then
      Begin
        Tmp := Copy(Tmp, P, Length(Tmp) - P + 1);
        ParseMemLabel(Tmp, DataLbl, DataAdd);
        If Mnem = 'CMP' Then
        Begin
          BcEmitB($80); BcEmitB($3E); { CMP BYTE PTR [disp16], imm8 }
          BcAddFixup(BC_FIX_ABS16_DATA, DataLbl, DataAdd);
          BcEmitW(0);
          BcEmitB(Byte(ImmVal));
          Exit;
        End;
      End;
    End;
    Exit;
  End;

  { ---- INC / DEC reg16 (accept 32-bit names) ---- }
  If Mnem = 'INC' Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($40 + Reg1); Exit; End;
    Exit;
  End;
  If Mnem = 'DEC' Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then Begin BcEmitB($48 + Reg1); Exit; End;
    Exit;
  End;

  { ---- NEG / NOT / MUL / IMUL / DIV / IDIV reg16 ---- }
  If (Mnem = 'NEG') Or (Mnem = 'NOT') Or
     (Mnem = 'MUL') Or (Mnem = 'IMUL') Or
     (Mnem = 'DIV') Or (Mnem = 'IDIV') Then
  Begin
    Reg1 := Reg16(Op1);
    If Reg1 >= 0 Then
    Begin
      BcEmitB($F7);
      If Mnem = 'NEG'  Then BcEmitB($D8 + Reg1)
      Else If Mnem = 'NOT'  Then BcEmitB($D0 + Reg1)
      Else If Mnem = 'MUL'  Then BcEmitB($E0 + Reg1)
      Else If Mnem = 'IMUL' Then BcEmitB($E8 + Reg1)
      Else If Mnem = 'DIV'  Then BcEmitB($F0 + Reg1)
      Else If Mnem = 'IDIV' Then BcEmitB($F8 + Reg1);
    End;
    Exit;
  End;

  { ---- XCHG AX,reg ---- }
  If Mnem = 'XCHG' Then
  Begin
    Reg1 := Reg16(Op1); Reg2 := Reg16(Op2);
    If (Reg1 = 0) And (Reg2 >= 0) Then Begin BcEmitB($90 + Reg2); Exit; End;
    If (Reg2 = 0) And (Reg1 >= 0) Then Begin BcEmitB($90 + Reg1); Exit; End;
  End;

  { ---- CBW / CWD ---- }
  If Mnem = 'CBW' Then Begin BcEmitB($98); Exit; End;
  If Mnem = 'CWD' Then Begin BcEmitB($99); Exit; End;

  { ---- MOVSB / MOVSW / LODSB / LODSW / STOSB / STOSW ---- }
  If Mnem = 'MOVSB' Then Begin BcEmitB($A4); Exit; End;
  If Mnem = 'MOVSW' Then Begin BcEmitB($A5); Exit; End;
  If Mnem = 'LODSB' Then Begin BcEmitB($AC); Exit; End;
  If Mnem = 'LODSW' Then Begin BcEmitB($AD); Exit; End;
  If Mnem = 'STOSB' Then Begin BcEmitB($AA); Exit; End;
  If Mnem = 'STOSW' Then Begin BcEmitB($AB); Exit; End;

  { ---- REP ---- }
  If Mnem = 'REP' Then Begin BcEmitB($F3);
    If Op1 <> '' Then BcAssemble8086(Op1);
    Exit; End;

  { ---- MOVZX -> en 8086, faire MOV reg8, [mem] puis XOR haut ---- }
  { Pour l instant, ignorer silencieusement }
  If Mnem = 'MOVZX' Then Exit;

  { ---- IMUL EAX,EAX,10 -> en 16 bits, utiliser MUL ---- }
  { Ignorer la forme 3 operandes, le runtime DOS n en a pas besoin }

  { Instruction non reconnue (ignoree silencieusement) }
  { WriteLn('BcAssemble8086: non reconnu: [', S, ']'); }
End;

{ ============================================================ }
{ BcAssembleZ80 - Mini-assembleur Zilog Z80                    }
{ ============================================================ }

Procedure BcAssembleZ80(Const S: TString);
Var
  Line, Mnem, Tmp, Op1, Op2: TString;
  P: LongInt;

  Procedure SplitOpsZ80(Const Rest: TString);
  Var J: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1;
    While J <= Length(Rest) Do
    Begin
      If (Rest[J] = ',') Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

Begin { BcAssembleZ80 }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin
    Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;

  SplitOpsZ80(Tmp);

  { ---- NOP ---- }
  If Mnem = 'NOP' Then Begin BcEmitB($00); Exit; End;

  { ---- HALT ---- }
  If Mnem = 'HALT' Then Begin BcEmitB($76); Exit; End;

  { ---- RET (sans condition seulement) ---- }
  If (Mnem = 'RET') And (Op1 = '') Then Begin BcEmitB($C9); Exit; End;

  { ---- DI / EI ---- }
  If Mnem = 'DI' Then Begin BcEmitB($F3); Exit; End;
  If Mnem = 'EI' Then Begin BcEmitB($FB); Exit; End;

  { ---- SCF / CCF / CPL / NEG / RLCA / RRCA / RLA / RRA ---- }
  If Mnem = 'SCF' Then Begin BcEmitB($37); Exit; End;
  If Mnem = 'CCF' Then Begin BcEmitB($3F); Exit; End;
  If Mnem = 'CPL' Then Begin BcEmitB($2F); Exit; End;
  If Mnem = 'RLCA' Then Begin BcEmitB($07); Exit; End;
  If Mnem = 'RRCA' Then Begin BcEmitB($0F); Exit; End;
  If Mnem = 'RLA' Then Begin BcEmitB($17); Exit; End;
  If Mnem = 'RRA' Then Begin BcEmitB($1F); Exit; End;
  If Mnem = 'DAA' Then Begin BcEmitB($27); Exit; End;

  { ---- NEG (prefixe ED) ---- }
  If Mnem = 'NEG' Then Begin BcEmitB($ED); BcEmitB($44); Exit; End;

  { ---- PUSH / POP paires de registres ---- }
  If Mnem = 'PUSH' Then
  Begin
    If StrUpperCase(Op1) = 'BC' Then Begin BcEmitB($C5); Exit; End;
    If StrUpperCase(Op1) = 'DE' Then Begin BcEmitB($D5); Exit; End;
    If StrUpperCase(Op1) = 'HL' Then Begin BcEmitB($E5); Exit; End;
    If StrUpperCase(Op1) = 'AF' Then Begin BcEmitB($F5); Exit; End;
  End;

  If Mnem = 'POP' Then
  Begin
    If StrUpperCase(Op1) = 'BC' Then Begin BcEmitB($C1); Exit; End;
    If StrUpperCase(Op1) = 'DE' Then Begin BcEmitB($D1); Exit; End;
    If StrUpperCase(Op1) = 'HL' Then Begin BcEmitB($E1); Exit; End;
    If StrUpperCase(Op1) = 'AF' Then Begin BcEmitB($F1); Exit; End;
  End;

  { ---- INC / DEC registres 8 bits ---- }
  If Mnem = 'INC' Then
  Begin
    If StrUpperCase(Op1) = 'A' Then Begin BcEmitB($3C); Exit; End;
    If StrUpperCase(Op1) = 'B' Then Begin BcEmitB($04); Exit; End;
    If StrUpperCase(Op1) = 'C' Then Begin BcEmitB($0C); Exit; End;
    If StrUpperCase(Op1) = 'D' Then Begin BcEmitB($14); Exit; End;
    If StrUpperCase(Op1) = 'E' Then Begin BcEmitB($1C); Exit; End;
    If StrUpperCase(Op1) = 'H' Then Begin BcEmitB($24); Exit; End;
    If StrUpperCase(Op1) = 'L' Then Begin BcEmitB($2C); Exit; End;
    { INC paires 16 bits }
    If StrUpperCase(Op1) = 'BC' Then Begin BcEmitB($03); Exit; End;
    If StrUpperCase(Op1) = 'DE' Then Begin BcEmitB($13); Exit; End;
    If StrUpperCase(Op1) = 'HL' Then Begin BcEmitB($23); Exit; End;
    If StrUpperCase(Op1) = 'SP' Then Begin BcEmitB($33); Exit; End;
  End;

  If Mnem = 'DEC' Then
  Begin
    If StrUpperCase(Op1) = 'A' Then Begin BcEmitB($3D); Exit; End;
    If StrUpperCase(Op1) = 'B' Then Begin BcEmitB($05); Exit; End;
    If StrUpperCase(Op1) = 'C' Then Begin BcEmitB($0D); Exit; End;
    If StrUpperCase(Op1) = 'D' Then Begin BcEmitB($15); Exit; End;
    If StrUpperCase(Op1) = 'E' Then Begin BcEmitB($1D); Exit; End;
    If StrUpperCase(Op1) = 'H' Then Begin BcEmitB($25); Exit; End;
    If StrUpperCase(Op1) = 'L' Then Begin BcEmitB($2D); Exit; End;
    { DEC paires 16 bits }
    If StrUpperCase(Op1) = 'BC' Then Begin BcEmitB($0B); Exit; End;
    If StrUpperCase(Op1) = 'DE' Then Begin BcEmitB($1B); Exit; End;
    If StrUpperCase(Op1) = 'HL' Then Begin BcEmitB($2B); Exit; End;
    If StrUpperCase(Op1) = 'SP' Then Begin BcEmitB($3B); Exit; End;
  End;

  { ---- EX DE,HL / EX AF,AF' / EXX ---- }
  If Mnem = 'EX' Then
  Begin
    If (StrUpperCase(Op1) = 'DE') And (StrUpperCase(Op2) = 'HL') Then
    Begin BcEmitB($EB); Exit; End;
  End;
  If Mnem = 'EXX' Then Begin BcEmitB($D9); Exit; End;

  { ---- LDIR / LDDR (prefixe ED) ---- }
  If Mnem = 'LDIR' Then Begin BcEmitB($ED); BcEmitB($B0); Exit; End;
  If Mnem = 'LDDR' Then Begin BcEmitB($ED); BcEmitB($B8); Exit; End;

  { ---- LD A,(HL) / LD (HL),A : doivent etre verifies AVANT LD A,n ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op1) = 'A') And
     (StrUpperCase(Op2) = '(HL)') Then
  Begin BcEmitB($7E); Exit; End;
  If (Mnem = 'LD') And (StrUpperCase(Op1) = '(HL)') And
     (StrUpperCase(Op2) = 'A') Then
  Begin BcEmitB($77); Exit; End;

  { ---- LD r,A (registres 8 bits depuis A) ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op2) = 'A') Then
  Begin
    If StrUpperCase(Op1) = 'B' Then Begin BcEmitB($47); Exit; End;
    If StrUpperCase(Op1) = 'C' Then Begin BcEmitB($4F); Exit; End;
    If StrUpperCase(Op1) = 'D' Then Begin BcEmitB($57); Exit; End;
    If StrUpperCase(Op1) = 'E' Then Begin BcEmitB($5F); Exit; End;
    If StrUpperCase(Op1) = 'H' Then Begin BcEmitB($67); Exit; End;
    If StrUpperCase(Op1) = 'L' Then Begin BcEmitB($6F); Exit; End;
  End;

  { ---- LD r,n (immediat 8 bits vers registre) ---- }
  If (Mnem = 'LD') And
     ((StrUpperCase(Op1) = 'B') Or (StrUpperCase(Op1) = 'C') Or
      (StrUpperCase(Op1) = 'D') Or (StrUpperCase(Op1) = 'E') Or
      (StrUpperCase(Op1) = 'H') Or (StrUpperCase(Op1) = 'L')) Then
  Begin
    If StrUpperCase(Op1) = 'B' Then BcEmitB($06)
    Else If StrUpperCase(Op1) = 'C' Then BcEmitB($0E)
    Else If StrUpperCase(Op1) = 'D' Then BcEmitB($16)
    Else If StrUpperCase(Op1) = 'E' Then BcEmitB($1E)
    Else If StrUpperCase(Op1) = 'H' Then BcEmitB($26)
    Else BcEmitB($2E);
    BcEmitB(Byte(BcParseNum6502(Op2) And $FF));
    Exit;
  End;

  { ---- LD A,n / LD A,$nn (immediat 8 bits) ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op1) = 'A') Then
  Begin
    BcEmitB($3E);
    BcEmitB(Byte(BcParseNum6502(Op2)));
    Exit;
  End;

  { ---- LD HL,$nnnn / LD HL,Lbl (immediat 16 bits ou label data) ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op1) = 'HL') Then
  Begin
    If (Length(Op2) > 0) And (Op2[1] = '$') Then
    Begin
      P := BcParseNum6502(Op2);
      BcEmitB($21); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($21);
      BcAddFixup(BC_FIX_ABS16_DATA_6502, Op2, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- LD DE,$nnnn / LD DE,Lbl ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op1) = 'DE') Then
  Begin
    If (Length(Op2) > 0) And (Op2[1] = '$') Then
    Begin
      P := BcParseNum6502(Op2);
      BcEmitB($11); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($11);
      BcAddFixup(BC_FIX_ABS16_DATA_6502, Op2, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- LD BC,$nnnn ---- }
  If (Mnem = 'LD') And (StrUpperCase(Op1) = 'BC') Then
  Begin
    If (Length(Op2) > 0) And (Op2[1] = '$') Then
    Begin
      P := BcParseNum6502(Op2);
      BcEmitB($01); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($01);
      BcAddFixup(BC_FIX_ABS16_DATA_6502, Op2, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- LD A,(HL) / LD (HL),A / OR A ---- }
  If (Mnem = 'OR') And (StrUpperCase(Op1) = 'A') Then
  Begin BcEmitB($B7); Exit; End;

  { ---- RET Z / RET NZ / RET C / RET NC ---- }
  If (Mnem = 'RET') And (StrUpperCase(Op1) = 'Z') Then
  Begin BcEmitB($C8); Exit; End;
  If (Mnem = 'RET') And (StrUpperCase(Op1) = 'NZ') Then
  Begin BcEmitB($C0); Exit; End;
  If (Mnem = 'RET') And (StrUpperCase(Op1) = 'C') Then
  Begin BcEmitB($D8); Exit; End;
  If (Mnem = 'RET') And (StrUpperCase(Op1) = 'NC') Then
  Begin BcEmitB($D0); Exit; End;

  { ---- CALL $nnnn / CALL nnnn / CALL Lbl ---- }
  If Mnem = 'CALL' Then
  Begin
    If (Length(Op1) > 0) And ((Op1[1] = '$') Or
       ((Op1[1] >= '0') And (Op1[1] <= '9'))) Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB($CD); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($CD);
      BcAddFixup(BC_FIX_ABS16_CODE_6502, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- JP $nnnn / JP nnnn / JP Lbl ---- }
  If Mnem = 'JP' Then
  Begin
    If (Length(Op1) > 0) And ((Op1[1] = '$') Or
       ((Op1[1] >= '0') And (Op1[1] <= '9'))) Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB($C3); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($C3);
      BcAddFixup(BC_FIX_ABS16_CODE_6502, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- RST ---- }
  If Mnem = 'RST' Then
  Begin
    If Op1 = '00H' Then Begin BcEmitB($C7); Exit; End;
    If Op1 = '08H' Then Begin BcEmitB($CF); Exit; End;
    If Op1 = '10H' Then Begin BcEmitB($D7); Exit; End;
    If Op1 = '18H' Then Begin BcEmitB($DF); Exit; End;
    If Op1 = '20H' Then Begin BcEmitB($E7); Exit; End;
    If Op1 = '28H' Then Begin BcEmitB($EF); Exit; End;
    If Op1 = '30H' Then Begin BcEmitB($F7); Exit; End;
    If Op1 = '38H' Then Begin BcEmitB($FF); Exit; End;
  End;

  { Instruction non reconnue (stub) }
  If Mnem = 'RST' Then
  Begin
    If Op1 = '00H' Then Begin BcEmitB($C7); Exit; End;
    If Op1 = '08H' Then Begin BcEmitB($CF); Exit; End;
    If Op1 = '10H' Then Begin BcEmitB($D7); Exit; End;
    If Op1 = '18H' Then Begin BcEmitB($DF); Exit; End;
    If Op1 = '20H' Then Begin BcEmitB($E7); Exit; End;
    If Op1 = '28H' Then Begin BcEmitB($EF); Exit; End;
    If Op1 = '30H' Then Begin BcEmitB($F7); Exit; End;
    If Op1 = '38H' Then Begin BcEmitB($FF); Exit; End;
  End;

  { Instruction non reconnue (stub) }
  { WriteLn('BcAssembleZ80: non reconnu: [', S, ']'); }
End;

{ ============================================================ }
{ BcAssemble6502 - Mini-assembleur MOS 6502                    }
{ ============================================================ }

{ Parser un nombre 6502 : decimal ou hex ($FF). }
Function BcParseNum6502(Const S: TString): LongInt;
Var
  T: TString;
  I: Integer;
  Neg: Boolean;
  V: LongInt;
  C: Char;
Begin
  T := S;
  While (Length(T) > 0) And (T[1] = ' ') Do Delete(T, 1, 1);
  While (Length(T) > 0) And (T[Length(T)] = ' ') Do Delete(T, Length(T), 1);
  Neg := False;
  If (Length(T) > 0) And (T[1] = '-') Then
  Begin Neg := True; Delete(T, 1, 1); End;
  V := 0;
  If (Length(T) > 0) And (T[1] = '$') Then
  Begin
    For I := 2 To Length(T) Do
    Begin
      C := T[I];
      If (C >= '0') And (C <= '9') Then V := V * 16 + (Ord(C) - Ord('0'))
      Else If (C >= 'A') And (C <= 'F') Then V := V * 16 + (Ord(C) - Ord('A') + 10)
      Else If (C >= 'a') And (C <= 'f') Then V := V * 16 + (Ord(C) - Ord('a') + 10)
      Else Break;
    End;
  End
  Else
  Begin
    For I := 1 To Length(T) Do
    Begin
      C := T[I];
      If (C >= '0') And (C <= '9') Then V := V * 10 + (Ord(C) - Ord('0'))
      Else Break;
    End;
  End;
  If Neg Then V := -V;
  BcParseNum6502 := V;
End;

Procedure BcAssemble6502(Const S: TString);
Var
  Line, Mnem, Tmp, Op1, Op2: TString;
  P: LongInt;

  Procedure SplitOps6502(Const Rest: TString);
  Var J: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1;
    While J <= Length(Rest) Do
    Begin
      If (Rest[J] = ',') Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

Begin { BcAssemble6502 }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin
    Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;

  SplitOps6502(Tmp);

  { ---- Instructions implicites (1 octet) ---- }
  If Mnem = 'BRK' Then Begin BcEmitB($00); Exit; End;
  If Mnem = 'NOP' Then Begin BcEmitB($EA); Exit; End;
  If Mnem = 'RTS' Then Begin BcEmitB($60); Exit; End;
  If Mnem = 'RTI' Then Begin BcEmitB($40); Exit; End;

  { ---- Pile ---- }
  If Mnem = 'PHA' Then Begin BcEmitB($48); Exit; End;
  If Mnem = 'PLA' Then Begin BcEmitB($68); Exit; End;
  If Mnem = 'PHP' Then Begin BcEmitB($08); Exit; End;
  If Mnem = 'PLP' Then Begin BcEmitB($28); Exit; End;

  { ---- Drapeaux ---- }
  If Mnem = 'CLC' Then Begin BcEmitB($18); Exit; End;
  If Mnem = 'SEC' Then Begin BcEmitB($38); Exit; End;
  If Mnem = 'CLI' Then Begin BcEmitB($58); Exit; End;
  If Mnem = 'SEI' Then Begin BcEmitB($78); Exit; End;
  If Mnem = 'CLV' Then Begin BcEmitB($B8); Exit; End;
  If Mnem = 'CLD' Then Begin BcEmitB($D8); Exit; End;
  If Mnem = 'SED' Then Begin BcEmitB($F8); Exit; End;

  { ---- Transferts de registres ---- }
  If Mnem = 'TAX' Then Begin BcEmitB($AA); Exit; End;
  If Mnem = 'TAY' Then Begin BcEmitB($A8); Exit; End;
  If Mnem = 'TXA' Then Begin BcEmitB($8A); Exit; End;
  If Mnem = 'TYA' Then Begin BcEmitB($98); Exit; End;
  If Mnem = 'TXS' Then Begin BcEmitB($9A); Exit; End;
  If Mnem = 'TSX' Then Begin BcEmitB($BA); Exit; End;

  { ---- Increments / Decrements registres ---- }
  If Mnem = 'INX' Then Begin BcEmitB($E8); Exit; End;
  If Mnem = 'INY' Then Begin BcEmitB($C8); Exit; End;
  If Mnem = 'DEX' Then Begin BcEmitB($CA); Exit; End;
  If Mnem = 'DEY' Then Begin BcEmitB($88); Exit; End;

  { ---- Decalages accumulateur ---- }
  If Mnem = 'ASLA' Then Begin BcEmitB($0A); Exit; End;
  If Mnem = 'ROLA' Then Begin BcEmitB($2A); Exit; End;
  If Mnem = 'LSRA' Then Begin BcEmitB($4A); Exit; End;
  If Mnem = 'RORA' Then Begin BcEmitB($6A); Exit; End;

  { ---- Decalages accumulateur (forme standard ASL A, etc.) ---- }
  If (Mnem = 'ASL') And (StrUpperCase(Op1) = 'A') Then
  Begin BcEmitB($0A); Exit; End;
  If (Mnem = 'ROL') And (StrUpperCase(Op1) = 'A') Then
  Begin BcEmitB($2A); Exit; End;
  If (Mnem = 'LSR') And (StrUpperCase(Op1) = 'A') Then
  Begin BcEmitB($4A); Exit; End;
  If (Mnem = 'ROR') And (StrUpperCase(Op1) = 'A') Then
  Begin BcEmitB($6A); Exit; End;

  { ====================================================== }
  { Operandes etendus : immediat, absolu, page zero, label  }
  { ====================================================== }
  Begin
    { Variables locales pour parser un operande }
  End;
  { Helper : analyser Op1 et emettre l octet/2 octets approprie }
  { OpKind : 1=#imm, 2=#<lbl, 3=#>lbl, 4=$abs(>=$100), 5=$zp,    }
  {          6=label code, 7=label data, 0=erreur                 }
  { Pour simplifier on inline le parsing.                          }

  { ---- LDA #imm / LDA #<LBL / LDA #>LBL / LDA $zp / LDA $abs / LDA LBL ---- }
  If Mnem = 'LDA' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '#') Then
    Begin
      Tmp := Copy(Op1, 2, Length(Op1) - 1);
      If (Length(Tmp) > 0) And (Tmp[1] = '<') Then
      Begin
        BcEmitB($A9);
        BcAddFixup(BC_FIX_LO_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else If (Length(Tmp) > 0) And (Tmp[1] = '>') Then
      Begin
        BcEmitB($A9);
        BcAddFixup(BC_FIX_HI_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else
      Begin
        BcEmitB($A9);
        BcEmitB(Byte(BcParseNum6502(Tmp)));
      End;
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] = '(') Then
    Begin
      { LDA ($zp),Y }
      Tmp := Copy(Op1, 2, Length(Op1) - 1);
      P := Pos(')', Tmp);
      If P > 0 Then Tmp := Copy(Tmp, 1, P - 1);
      BcEmitB($B1); BcEmitB(Byte(BcParseNum6502(Tmp)));
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      If P < $100 Then Begin BcEmitB($A5); BcEmitB(Byte(P)); End
      Else Begin BcEmitB($AD); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] In ['0'..'9']) Then
    Begin
      P := BcParseNum6502(Op1);
      If P < $100 Then Begin BcEmitB($A5); BcEmitB(Byte(P)); End
      Else Begin BcEmitB($AD); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
      Exit;
    End
    Else
    Begin
      { Label : LDA en mode absolu (suppose label data) }
      BcEmitB($AD);
      BcAddFixup(BC_FIX_ABS16_DATA_6502, Op1, 0);
      BcEmitB(0); BcEmitB(0);
      Exit;
    End;
  End;

  { ---- LDX #imm / LDX $zp / LDX $abs ---- }
  If Mnem = 'LDX' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '#') Then
    Begin
      Tmp := Copy(Op1, 2, Length(Op1) - 1);
      If (Length(Tmp) > 0) And (Tmp[1] = '<') Then
      Begin
        BcEmitB($A2);
        BcAddFixup(BC_FIX_LO_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else If (Length(Tmp) > 0) And (Tmp[1] = '>') Then
      Begin
        BcEmitB($A2);
        BcAddFixup(BC_FIX_HI_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else
      Begin BcEmitB($A2); BcEmitB(Byte(BcParseNum6502(Tmp))); End;
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      If P < $100 Then Begin BcEmitB($A6); BcEmitB(Byte(P)); End
      Else Begin BcEmitB($AE); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
      Exit;
    End;
  End;

  { ---- LDY #imm / LDY $zp / LDY $abs ---- }
  If Mnem = 'LDY' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '#') Then
    Begin
      Tmp := Copy(Op1, 2, Length(Op1) - 1);
      If (Length(Tmp) > 0) And (Tmp[1] = '<') Then
      Begin
        BcEmitB($A0);
        BcAddFixup(BC_FIX_LO_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else If (Length(Tmp) > 0) And (Tmp[1] = '>') Then
      Begin
        BcEmitB($A0);
        BcAddFixup(BC_FIX_HI_DATA_6502, Copy(Tmp, 2, Length(Tmp) - 1), 0);
        BcEmitB(0);
      End
      Else
      Begin BcEmitB($A0); BcEmitB(Byte(BcParseNum6502(Tmp))); End;
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      If P < $100 Then Begin BcEmitB($A4); BcEmitB(Byte(P)); End
      Else Begin BcEmitB($AC); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
      Exit;
    End;
  End;

  { ---- STA $zp / STA $abs / STA LBL / STA ($zp),Y ---- }
  If Mnem = 'STA' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '(') Then
    Begin
      { STA ($zp),Y : extraire $zp entre parentheses }
      Tmp := Copy(Op1, 2, Length(Op1) - 1);
      P := Pos(')', Tmp);
      If P > 0 Then Tmp := Copy(Tmp, 1, P - 1);
      BcEmitB($91); BcEmitB(Byte(BcParseNum6502(Tmp)));
      Exit;
    End
    Else If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      If P < $100 Then Begin BcEmitB($85); BcEmitB(Byte(P)); End
      Else Begin BcEmitB($8D); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
      Exit;
    End;
  End;

  { ---- STX, STY (page zero) ---- }
  If (Mnem = 'STX') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($86); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($8E); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;
  If (Mnem = 'STY') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($84); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($8C); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;

  { ---- JSR / JMP : absolu ($abs) ou label code ---- }
  If Mnem = 'JSR' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB($20); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($20);
      BcAddFixup(BC_FIX_ABS16_CODE_6502, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;
  If Mnem = 'JMP' Then
  Begin
    If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB($4C); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8));
    End
    Else
    Begin
      BcEmitB($4C);
      BcAddFixup(BC_FIX_ABS16_CODE_6502, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- CMP / ADC / SBC / AND / ORA / EOR : immediat et page zero ---- }
  If (Mnem = 'CMP') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($C9); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'CMP') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($C5); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($CD); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;
  If (Mnem = 'CPX') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($E0); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'CPY') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($C0); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'ADC') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($69); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'ADC') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($65); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($6D); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;
  If (Mnem = 'SBC') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($E9); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'SBC') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($E5); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($ED); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;
  If (Mnem = 'AND') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($29); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'ORA') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($09); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;
  If (Mnem = 'EOR') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin BcEmitB($49); BcEmitB(Byte(BcParseNum6502(Copy(Op1,2,Length(Op1)-1)))); Exit; End;

  { ---- INC / DEC page zero ---- }
  If (Mnem = 'INC') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($E6); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($EE); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;
  If (Mnem = 'DEC') And (Length(Op1) > 0) And (Op1[1] = '$') Then
  Begin
    P := BcParseNum6502(Op1);
    If P < $100 Then Begin BcEmitB($C6); BcEmitB(Byte(P)); End
    Else Begin BcEmitB($CE); BcEmitB(Byte(P)); BcEmitB(Byte(P Shr 8)); End;
    Exit;
  End;

  { ---- Branches relatives 8 bits vers label code ---- }
  If Mnem = 'BNE' Then
  Begin BcEmitB($D0); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BEQ' Then
  Begin BcEmitB($F0); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BCC' Then
  Begin BcEmitB($90); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BCS' Then
  Begin BcEmitB($B0); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BPL' Then
  Begin BcEmitB($10); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BMI' Then
  Begin BcEmitB($30); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BVC' Then
  Begin BcEmitB($50); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;
  If Mnem = 'BVS' Then
  Begin BcEmitB($70); BcAddFixup(BC_FIX_REL8_6502, Op1, 0); BcEmitB(0); Exit; End;

  { Instruction non reconnue (stub) }
  { WriteLn('BcAssemble6502: non reconnu: [', S, ']'); }
End;

{ ============================================================ }
{ BcAssemble6809 - Mini-assembleur Motorola 6809               }
{ ============================================================ }

Procedure BcAssemble6809(Const S: TString);
Var
  Line, Mnem, Tmp, Op1, Op2: TString;
  P: LongInt;

  Procedure SplitOps6809(Const Rest: TString);
  Var J: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1;
    While J <= Length(Rest) Do
    Begin
      If (Rest[J] = ',') Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

Begin { BcAssemble6809 }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin
    Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;

  SplitOps6809(Tmp);

  { ---- Instructions implicites (1 octet) ---- }
  If Mnem = 'NOP'  Then Begin BcEmitB($12); Exit; End;
  If Mnem = 'SYNC' Then Begin BcEmitB($13); Exit; End;
  If Mnem = 'DAA'  Then Begin BcEmitB($19); Exit; End;
  If Mnem = 'SEX'  Then Begin BcEmitB($1D); Exit; End;
  If Mnem = 'RTS'  Then Begin BcEmitB($39); Exit; End;
  If Mnem = 'ABX'  Then Begin BcEmitB($3A); Exit; End;
  If Mnem = 'RTI'  Then Begin BcEmitB($3B); Exit; End;
  If Mnem = 'MUL'  Then Begin BcEmitB($3D); Exit; End;
  If Mnem = 'SWI'  Then Begin BcEmitB($3F); Exit; End;

  { ---- Operations sur accumulateur A (implicite) ---- }
  If Mnem = 'NEGA' Then Begin BcEmitB($40); Exit; End;
  If Mnem = 'COMA' Then Begin BcEmitB($43); Exit; End;
  If Mnem = 'LSRA' Then Begin BcEmitB($44); Exit; End;
  If Mnem = 'RORA' Then Begin BcEmitB($46); Exit; End;
  If Mnem = 'ASRA' Then Begin BcEmitB($47); Exit; End;
  If Mnem = 'ASLA' Then Begin BcEmitB($48); Exit; End;
  If Mnem = 'ROLA' Then Begin BcEmitB($49); Exit; End;
  If Mnem = 'DECA' Then Begin BcEmitB($4A); Exit; End;
  If Mnem = 'INCA' Then Begin BcEmitB($4C); Exit; End;
  If Mnem = 'TSTA' Then Begin BcEmitB($4D); Exit; End;
  If Mnem = 'CLRA' Then Begin BcEmitB($4F); Exit; End;

  { ---- Operations sur accumulateur B (implicite) ---- }
  If Mnem = 'NEGB' Then Begin BcEmitB($50); Exit; End;
  If Mnem = 'COMB' Then Begin BcEmitB($53); Exit; End;
  If Mnem = 'LSRB' Then Begin BcEmitB($54); Exit; End;
  If Mnem = 'RORB' Then Begin BcEmitB($56); Exit; End;
  If Mnem = 'ASRB' Then Begin BcEmitB($57); Exit; End;
  If Mnem = 'ASLB' Then Begin BcEmitB($58); Exit; End;
  If Mnem = 'ROLB' Then Begin BcEmitB($59); Exit; End;
  If Mnem = 'DECB' Then Begin BcEmitB($5A); Exit; End;
  If Mnem = 'INCB' Then Begin BcEmitB($5C); Exit; End;
  If Mnem = 'TSTB' Then Begin BcEmitB($5D); Exit; End;
  If Mnem = 'CLRB' Then Begin BcEmitB($5F); Exit; End;

  { ---- Instructions page 2 (prefixe $10) ---- }
  If Mnem = 'SWI2' Then Begin BcEmitB($10); BcEmitB($3F); Exit; End;

  { ---- Instructions page 3 (prefixe $11) ---- }
  If Mnem = 'SWI3' Then Begin BcEmitB($11); BcEmitB($3F); Exit; End;

  { ---- LDA #imm8 / LDA #'X' ---- }
  If (Mnem = 'LDA') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin
    Tmp := Copy(Op1, 2, Length(Op1) - 1);
    P := BcParseNum6502(Tmp);
    BcEmitB($86); BcEmitB(Byte(P And $FF));
    Exit;
  End;

  { ---- LDA ,X+ ---- (post-incrementation indexee) }
  If (Mnem = 'LDA') And (Op1 = '') And (Op2 = 'X+') Then
  Begin
    BcEmitB($A6); BcEmitB($80);
    Exit;
  End;

  { ---- LDX #imm16 / LDX #Lbl ---- }
  If (Mnem = 'LDX') And (Length(Op1) > 0) And (Op1[1] = '#') Then
  Begin
    Tmp := Copy(Op1, 2, Length(Op1) - 1);
    BcEmitB($8E);
    If (Length(Tmp) > 0) And (Tmp[1] = '$') Then
    Begin
      P := BcParseNum6502(Tmp);
      BcEmitB(Byte((P Shr 8) And $FF)); BcEmitB(Byte(P And $FF));
    End
    Else
    Begin
      BcAddFixup(BC_FIX_ABS16_DATA_6809, Tmp, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- JMP $nnnn / JMP Lbl (mode etendu, $7E hi lo) ---- }
  If Mnem = 'JMP' Then
  Begin
    BcEmitB($7E);
    If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB(Byte((P Shr 8) And $FF)); BcEmitB(Byte(P And $FF));
    End
    Else
    Begin
      BcAddFixup(BC_FIX_ABS16_CODE_6809, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- JSR $nnnn / JSR Lbl (mode etendu, $BD hi lo) ---- }
  If Mnem = 'JSR' Then
  Begin
    BcEmitB($BD);
    If (Length(Op1) > 0) And (Op1[1] = '$') Then
    Begin
      P := BcParseNum6502(Op1);
      BcEmitB(Byte((P Shr 8) And $FF)); BcEmitB(Byte(P And $FF));
    End
    Else
    Begin
      BcAddFixup(BC_FIX_ABS16_CODE_6809, Op1, 0);
      BcEmitB(0); BcEmitB(0);
    End;
    Exit;
  End;

  { ---- Branches courtes BRA / BEQ / BNE / BCC / BCS ---- }
  If Mnem = 'BRA' Then
  Begin
    BcEmitB($20);
    BcAddFixup(BC_FIX_REL8_6809, Op1, 0);
    BcEmitB(0);
    Exit;
  End;
  If Mnem = 'BEQ' Then
  Begin
    BcEmitB($27);
    BcAddFixup(BC_FIX_REL8_6809, Op1, 0);
    BcEmitB(0);
    Exit;
  End;
  If Mnem = 'BNE' Then
  Begin
    BcEmitB($26);
    BcAddFixup(BC_FIX_REL8_6809, Op1, 0);
    BcEmitB(0);
    Exit;
  End;

  { Instruction non reconnue (stub) }
  { WriteLn('BcAssemble6809: non reconnu: [', S, ']'); }
End;

{ ============================================================ }
{ BcAssemble68000 - Mini-assembleur Motorola 68000             }
{ ============================================================ }

Procedure BcAssemble68000(Const S: TString);
Var
  Line, Mnem, Tmp, Op1, Op2: TString;
  P: Integer;
  Val: LongInt;

  Procedure SplitOps68000(Const Rest: TString);
  Var J: Integer;
  Begin
    Op1 := ''; Op2 := '';
    J := 1;
    While J <= Length(Rest) Do
    Begin
      If (Rest[J] = ',') Then
      Begin
        Op1 := Copy(Rest, 1, J - 1);
        Op2 := Copy(Rest, J + 1, Length(Rest) - J);
        While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
          Delete(Op1, Length(Op1), 1);
        While (Length(Op2) > 0) And (Op2[1] = ' ') Do Delete(Op2, 1, 1);
        Exit;
      End;
      Inc(J);
    End;
    Op1 := Rest;
    While (Length(Op1) > 0) And (Op1[Length(Op1)] = ' ') Do
      Delete(Op1, Length(Op1), 1);
  End;

  { Emettre un mot 16 bits big-endian }
  Procedure EmitW_BE(W: Word);
  Begin BcEmitB(Hi(W)); BcEmitB(Lo(W)); End;

  { Emettre un long mot 32 bits big-endian }
  Procedure EmitD_BE(D: LongInt);
  Begin
    BcEmitB(Byte(D Shr 24)); BcEmitB(Byte(D Shr 16));
    BcEmitB(Byte(D Shr 8)); BcEmitB(Byte(D));
  End;

  { Parser un numero de registre Dn ou An }
  Function ParseDn(Const S: TString): Integer;
  Begin
    ParseDn := -1;
    If (Length(S) = 2) And ((S[1] = 'D') Or (S[1] = 'd')) And
       (S[2] >= '0') And (S[2] <= '7') Then
      ParseDn := Ord(S[2]) - Ord('0');
  End;

  Function ParseAn(Const S: TString): Integer;
  Begin
    ParseAn := -1;
    If (Length(S) = 2) And ((S[1] = 'A') Or (S[1] = 'a')) And
       (S[2] >= '0') And (S[2] <= '7') Then
      ParseAn := Ord(S[2]) - Ord('0');
    If (StrUpperCase(S) = 'SP') Then ParseAn := 7;
  End;

  { Parser un immediat #xxx }
  Function ParseImm(Const S: TString; Var V: LongInt): Boolean;
  Var I: Integer; Neg: Boolean; C: Char;
  Begin
    ParseImm := False;
    If (Length(S) < 2) Or (S[1] <> '#') Then Exit;
    V := 0;
    Neg := False;
    I := 2;
    If (I <= Length(S)) And (S[I] = '-') Then Begin Neg := True; Inc(I); End;
    If (I <= Length(S)) And (S[I] = '$') Then
    Begin
      Inc(I);
      While I <= Length(S) Do
      Begin
        C := UpCase(S[I]);
        If (C >= '0') And (C <= '9') Then V := V * 16 + Ord(C) - Ord('0')
        Else If (C >= 'A') And (C <= 'F') Then V := V * 16 + Ord(C) - Ord('A') + 10
        Else Break;
        Inc(I);
      End;
    End
    Else
    Begin
      While I <= Length(S) Do
      Begin
        If (S[I] >= '0') And (S[I] <= '9') Then V := V * 10 + Ord(S[I]) - Ord('0')
        Else Break;
        Inc(I);
      End;
    End;
    If Neg Then V := -V;
    ParseImm := True;
  End;

  { Tester si Op est -(SP) ou -(A7) }
  Function IsPreDecSP(Const S: TString): Boolean;
  Var U: TString;
  Begin
    U := StrUpperCase(S);
    IsPreDecSP := (U = '-(SP)') Or (U = '-(A7)');
  End;

  { Tester si Op est (SP)+ ou (A7)+ }
  Function IsPostIncSP(Const S: TString): Boolean;
  Var U: TString;
  Begin
    U := StrUpperCase(S);
    IsPostIncSP := (U = '(SP)+') Or (U = '(A7)+');
  End;

  { Extraire le nom de label (Op1 sans prefixe ni suffixe) }
  Function IsLabel(Const S: TString): Boolean;
  Var I: Integer;
  Begin
    IsLabel := False;
    If Length(S) = 0 Then Exit;
    If (S[1] = '#') Or (S[1] = '(') Or (S[1] = '-') Then Exit;
    { Un label ne commence pas par un chiffre (sinon "4.W" serait pris }
    { pour un label, alors qu'il s'agit d'une adresse absolue courte). }
    If (S[1] >= '0') And (S[1] <= '9') Then Exit;
    For I := 1 To Length(S) Do
      If Not ((S[I] >= 'A') And (S[I] <= 'Z') Or
              (S[I] >= 'a') And (S[I] <= 'z') Or
              (S[I] >= '0') And (S[I] <= '9') Or
              (S[I] = '_') Or (S[I] = '.')) Then Exit;
    IsLabel := True;
  End;

  { Calculer le masque de registres pour MOVEM }
  Function ParseRegList(Const S: TString): Word;
  Var
    I, J, R1, R2: Integer;
    Mask: Word;
    U: TString;
    Part: TString;
  Begin
    Mask := 0;
    U := StrUpperCase(S);
    I := 1;
    While I <= Length(U) Do
    Begin
      Part := '';
      While (I <= Length(U)) And (U[I] <> '/') Do
      Begin Part := Part + U[I]; Inc(I); End;
      Inc(I); { sauter / }
      { Part = Dn-Dm ou Dn ou An-Am ou An }
      J := Pos('-', Part);
      If J > 0 Then
      Begin
        R1 := ParseDn(Copy(Part, 1, J-1));
        R2 := ParseDn(Copy(Part, J+1, Length(Part)-J));
        If (R1 >= 0) And (R2 >= 0) Then
          While R1 <= R2 Do Begin Mask := Mask Or (1 Shl R1); Inc(R1); End;
        R1 := ParseAn(Copy(Part, 1, J-1));
        R2 := ParseAn(Copy(Part, J+1, Length(Part)-J));
        If (R1 >= 0) And (R2 >= 0) Then
          While R1 <= R2 Do Begin Mask := Mask Or (1 Shl (R1+8)); Inc(R1); End;
      End
      Else
      Begin
        R1 := ParseDn(Part);
        If R1 >= 0 Then Mask := Mask Or (1 Shl R1);
        R1 := ParseAn(Part);
        If R1 >= 0 Then Mask := Mask Or (1 Shl (R1 + 8));
      End;
    End;
    ParseRegList := Mask;
  End;

  { Inverser les bits du masque MOVEM pour predecrement }
  Function ReverseMask(M: Word): Word;
  Var I: Integer; R: Word;
  Begin
    R := 0;
    For I := 0 To 15 Do
      If (M And (1 Shl I)) <> 0 Then
        R := R Or (1 Shl (15 - I));
    ReverseMask := R;
  End;

Begin { BcAssemble68000 }
  Line := S;
  While (Length(Line) > 0) And (Line[1] = ' ') Do Delete(Line, 1, 1);
  While (Length(Line) > 0) And (Line[Length(Line)] = ' ') Do
    Delete(Line, Length(Line), 1);
  If Line = '' Then Exit;

  { Extraire le mnemonique }
  P := Pos(' ', Line);
  If P > 0 Then
  Begin
    Mnem := StrUpperCase(Copy(Line, 1, P - 1));
    Tmp := Copy(Line, P + 1, Length(Line) - P);
    While (Length(Tmp) > 0) And (Tmp[1] = ' ') Do Delete(Tmp, 1, 1);
  End
  Else Begin Mnem := StrUpperCase(Line); Tmp := ''; End;

  SplitOps68000(Tmp);

  { ---- Instructions implicites (sans operande, 1 mot = 2 octets) ---- }
  If Mnem = 'NOP'     Then Begin EmitW_BE($4E71); Exit; End;
  If Mnem = 'RTS'     Then Begin EmitW_BE($4E75); Exit; End;
  If Mnem = 'RTE'     Then Begin EmitW_BE($4E73); Exit; End;
  If Mnem = 'RTR'     Then Begin EmitW_BE($4E77); Exit; End;
  If Mnem = 'TRAPV'   Then Begin EmitW_BE($4E76); Exit; End;
  If Mnem = 'RESET'   Then Begin EmitW_BE($4E70); Exit; End;
  If Mnem = 'ILLEGAL' Then Begin EmitW_BE($4AFC); Exit; End;

  { ---- TRAP #n ---- }
  If Mnem = 'TRAP' Then
  Begin
    If ParseImm(Op1, Val) Then
      EmitW_BE($4E40 Or (Word(Val) And $0F));
    Exit;
  End;

  { ---- MOVEQ #imm8,Dn ---- }
  If (Mnem = 'MOVEQ') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
      EmitW_BE($7000 Or (Word(ParseDn(Op2)) Shl 9) Or (Word(Val) And $00FF));
    Exit;
  End;

  { ---- JSR d16(An) / JSR label ---- }
  If (Mnem = 'JSR') Then
  Begin
    { Tester d abord le mode deplacement : JSR offset(An) }
    P := Pos('(', Op1);
    If P > 1 Then
    Begin
      Tmp := Copy(Op1, P + 1, Length(Op1) - P);
      If (Length(Tmp) > 0) And (Tmp[Length(Tmp)] = ')') Then
        Delete(Tmp, Length(Tmp), 1);
      Val := 0;
      If P > 1 Then
      Begin
        Tmp := StrUpperCase(Tmp);
        { Parser le deplacement (partie avant la parenthese) }
        Mnem := Copy(Op1, 1, P - 1);
        ParseImm('#' + Mnem, Val);
        { Parser le registre An }
        If ParseAn(Tmp) >= 0 Then
        Begin
          EmitW_BE($4EA8 Or Word(ParseAn(Tmp)));
          EmitW_BE(Word(Val));
          Mnem := 'JSR';
          Exit;
        End;
      End;
    End;
    { JSR label (adresse absolue long) }
    If IsLabel(Op1) Then
    Begin
      EmitW_BE($4EB9);
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
    End;
    Exit;
  End;

  { ---- CLR.W -(SP) / CLR.B Dn / CLR.L Dn ---- }
  If (Mnem = 'CLR.W') Then
  Begin
    If IsPreDecSP(Op1) Then EmitW_BE($4267) { CLR.W -(A7) }
    Else If ParseDn(Op1) >= 0 Then EmitW_BE($4240 Or ParseDn(Op1))
    Else EmitW_BE($4E71); { NOP fallback }
    Exit;
  End;
  If (Mnem = 'CLR.L') Then
  Begin
    If ParseDn(Op1) >= 0 Then EmitW_BE($4280 Or ParseDn(Op1))
    Else EmitW_BE($4E71);
    Exit;
  End;
  If (Mnem = 'CLR.B') Then
  Begin
    If ParseDn(Op1) >= 0 Then
    Begin EmitW_BE($4200 Or ParseDn(Op1)); Exit; End;
    { CLR.B (An) - indirect }
    Tmp := StrUpperCase(Op1);
    If (Length(Tmp) = 4) And (Tmp[1] = '(') And (Tmp[2] = 'A') And
       (Tmp[3] >= '0') And (Tmp[3] <= '7') And (Tmp[4] = ')') Then
    Begin
      P := Ord(Tmp[3]) - Ord('0');
      EmitW_BE($4210 Or Word(P));
      Exit;
    End;
    EmitW_BE($4E71);
    Exit;
  End;

  { ---- MOVE.L #imm,Dn ---- }
  If (Mnem = 'MOVE.L') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      { MOVE.L #imm,Dn : $203C + long }
      EmitW_BE($2000 Or (Word(ParseDn(Op2)) Shl 9) Or $003C);
      EmitD_BE(Val);
      Exit;
    End;
    If ParseImm(Op1, Val) And IsPreDecSP(Op2) Then
    Begin
      { MOVE.L #imm,-(SP) : $2F3C + long }
      EmitW_BE($2F3C);
      EmitD_BE(Val);
      Exit;
    End;
    If (ParseDn(Op1) >= 0) And (ParseAn(Op2) >= 0) Then
    Begin
      { MOVEA.L Dn,An : $2040 | (An<<9) | Dn }
      EmitW_BE($2040 Or (Word(ParseAn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
    If (ParseAn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      { MOVE.L An,Dn }
      EmitW_BE($2000 Or (Word(ParseDn(Op2)) Shl 9) Or $0008 Or Word(ParseAn(Op1)));
      Exit;
    End;
    If (ParseDn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      { MOVE.L Dn,Dm }
      EmitW_BE($2000 Or (Word(ParseDn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
    If (ParseDn(Op1) >= 0) And IsPreDecSP(Op2) Then
    Begin
      { MOVE.L Dn,-(SP) }
      EmitW_BE($2F00 Or Word(ParseDn(Op1)));
      Exit;
    End;
    If (ParseAn(Op1) >= 0) And IsPreDecSP(Op2) Then
    Begin
      { MOVE.L An,-(SP) }
      EmitW_BE($2F00 Or $0008 Or Word(ParseAn(Op1)));
      Exit;
    End;
    If IsPostIncSP(Op1) And (ParseDn(Op2) >= 0) Then
    Begin
      { MOVE.L (SP)+,Dn }
      EmitW_BE($2000 Or (Word(ParseDn(Op2)) Shl 9) Or $001F);
      Exit;
    End;
    { MOVE.L label,Dn - adresse absolue long }
    If IsLabel(Op1) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($2039 Or (Word(ParseDn(Op2)) Shl 9));
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
      Exit;
    End;
    { MOVE.L label,-(SP) }
    If IsLabel(Op1) And IsPreDecSP(Op2) Then
    Begin
      EmitW_BE($2F39);
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
      Exit;
    End;
    { MOVE.L An,Am (MOVEA.L) }
    If (ParseAn(Op1) >= 0) And (ParseAn(Op2) >= 0) Then
    Begin
      EmitW_BE($2048 Or (Word(ParseAn(Op2)) Shl 9) Or Word(ParseAn(Op1)));
      Exit;
    End;
    { MOVE.L label,An (MOVEA.L abs.L,An) }
    If IsLabel(Op1) And (ParseAn(Op2) >= 0) Then
    Begin
      EmitW_BE($2079 Or (Word(ParseAn(Op2)) Shl 9));
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
      Exit;
    End;
    { MOVE.L Dn,label (abs.L) }
    If (ParseDn(Op1) >= 0) And IsLabel(Op2) Then
    Begin
      EmitW_BE($23C0 Or Word(ParseDn(Op1)));
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op2, 0);
      EmitD_BE(0);
      Exit;
    End;
    { MOVE.L N.W,An (MOVEA.L abs.W,An) - ex: MOVE.L 4.W,A6 }
    P := Pos('.W', StrUpperCase(Op1));
    If (P > 1) And (ParseAn(Op2) >= 0) Then
    Begin
      Tmp := Copy(Op1, 1, P - 1);
      Val := 0;
      If ParseImm('#' + Tmp, Val) Then
      Begin
        EmitW_BE($2078 Or (Word(ParseAn(Op2)) Shl 9));
        EmitW_BE(Word(Val));
        Exit;
      End;
    End;
  End;

  { ---- MOVE.W #imm,-(SP) / MOVE.W Dn,-(SP) ---- }
  If (Mnem = 'MOVE.W') Then
  Begin
    If ParseImm(Op1, Val) And IsPreDecSP(Op2) Then
    Begin
      { MOVE.W #imm,-(SP) : $3F3C + word }
      EmitW_BE($3F3C);
      EmitW_BE(Word(Val));
      Exit;
    End;
    If (ParseDn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($3000 Or (Word(ParseDn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
    If (ParseDn(Op1) >= 0) And IsPreDecSP(Op2) Then
    Begin
      EmitW_BE($3F00 Or Word(ParseDn(Op1)));
      Exit;
    End;
  End;

  { ---- MOVE.B ---- }
  If (Mnem = 'MOVE.B') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($103C Or (Word(ParseDn(Op2)) Shl 9));
      EmitW_BE(Word(Val) And $FF);
      Exit;
    End;
    { MOVE.B #imm,(An)+ - ex: MOVE.B #45,(A0)+ }
    If ParseImm(Op1, Val) Then
    Begin
      Tmp := StrUpperCase(Op2);
      If (Length(Tmp) = 5) And (Tmp[1] = '(') And (Tmp[2] = 'A') And
         (Tmp[3] >= '0') And (Tmp[3] <= '7') And (Tmp[4] = ')') And (Tmp[5] = '+') Then
      Begin
        P := Ord(Tmp[3]) - Ord('0');
        EmitW_BE($10FC Or (Word(P) Shl 9));
        EmitW_BE(Word(Val) And $FF);
        Exit;
      End;
    End;
    { MOVE.B Dn,-(SP) }
    If (ParseDn(Op1) >= 0) And IsPreDecSP(Op2) Then
    Begin
      EmitW_BE($1F00 Or Word(ParseDn(Op1)));
      Exit;
    End;
    { MOVE.B Dn,label (abs.L) - ex: MOVE.B D0,CHRBUF }
    If (ParseDn(Op1) >= 0) And IsLabel(Op2) Then
    Begin
      EmitW_BE($13C0 Or Word(ParseDn(Op1)));
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op2, 0);
      EmitD_BE(0);
      Exit;
    End;
    { MOVE.B (SP)+,Dn }
    If IsPostIncSP(Op1) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($1000 Or (Word(ParseDn(Op2)) Shl 9) Or $001F);
      Exit;
    End;
    { MOVE.B (SP)+,(An)+ - ex: MOVE.B (SP)+,(A1)+ }
    If IsPostIncSP(Op1) Then
    Begin
      Tmp := StrUpperCase(Op2);
      If (Length(Tmp) = 5) And (Tmp[1] = '(') And (Tmp[2] = 'A') And
         (Tmp[3] >= '0') And (Tmp[3] <= '7') And (Tmp[4] = ')') And (Tmp[5] = '+') Then
      Begin
        P := Ord(Tmp[3]) - Ord('0');
        EmitW_BE($10DF Or (Word(P) Shl 9));
        Exit;
      End;
    End;
  End;

  { ---- LEA label,An ---- }
  If (Mnem = 'LEA') Then
  Begin
    If IsLabel(Op1) And (ParseAn(Op2) >= 0) Then
    Begin
      { LEA xxx.L,An : $41F9 + long }
      EmitW_BE($41F9 Or (Word(ParseAn(Op2)) Shl 9));
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
      Exit;
    End;
  End;

  { ---- PEA label ---- }
  If (Mnem = 'PEA') Then
  Begin
    If IsLabel(Op1) Then
    Begin
      { PEA xxx.L : $4879 + long }
      EmitW_BE($4879);
      BcAddFixup(BC_FIX_ABS32_DATA_BE, Op1, 0);
      EmitD_BE(0);
      Exit;
    End;
  End;

  { ---- ADDQ.L #imm,An/Dn ---- }
  If (Mnem = 'ADDQ.L') Then
  Begin
    If ParseImm(Op1, Val) Then
    Begin
      If (Val >= 1) And (Val <= 8) Then
      Begin
        If Val = 8 Then Val := 0; { codage special : 0 = 8 }
        If ParseAn(Op2) >= 0 Then
          EmitW_BE($5000 Or (Word(Val) Shl 9) Or $0088 Or Word(ParseAn(Op2)))
        Else If ParseDn(Op2) >= 0 Then
          EmitW_BE($5000 Or (Word(Val) Shl 9) Or $0080 Or Word(ParseDn(Op2)))
        Else If StrUpperCase(Op2) = 'SP' Then
          EmitW_BE($5000 Or (Word(Val) Shl 9) Or $008F);
      End;
      Exit;
    End;
  End;

  { ---- SUBQ.L #imm,An/Dn ---- }
  If (Mnem = 'SUBQ.L') Then
  Begin
    If ParseImm(Op1, Val) Then
    Begin
      If (Val >= 1) And (Val <= 8) Then
      Begin
        If Val = 8 Then Val := 0;
        If ParseAn(Op2) >= 0 Then
          EmitW_BE($5100 Or (Word(Val) Shl 9) Or $0088 Or Word(ParseAn(Op2)))
        Else If ParseDn(Op2) >= 0 Then
          EmitW_BE($5100 Or (Word(Val) Shl 9) Or $0080 Or Word(ParseDn(Op2)))
        Else If StrUpperCase(Op2) = 'SP' Then
          EmitW_BE($5100 Or (Word(Val) Shl 9) Or $008F);
      End;
      Exit;
    End;
  End;

  { ---- BSR label (branch to subroutine, 16-bit displacement) ---- }
  If (Mnem = 'BSR') Then
  Begin
    EmitW_BE($6100);  { BSR.W avec deplacement 16 bits }
    BcAddFixup(BC_FIX_REL16_BE, Op1, 0);
    EmitW_BE(0);
    Exit;
  End;

  { ---- BRA label ---- }
  If (Mnem = 'BRA') Then
  Begin
    EmitW_BE($6000);  { BRA.W }
    BcAddFixup(BC_FIX_REL16_BE, Op1, 0);
    EmitW_BE(0);
    Exit;
  End;

  { ---- BEQ / BNE / BPL / BMI / BCS / BCC / BGE / BLE / BGT / BLT ---- }
  If (Mnem = 'BEQ') Then Begin EmitW_BE($6700); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BNE') Then Begin EmitW_BE($6600); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BPL') Then Begin EmitW_BE($6A00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BMI') Then Begin EmitW_BE($6B00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BCS') Then Begin EmitW_BE($6500); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BCC') Then Begin EmitW_BE($6400); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BGE') Then Begin EmitW_BE($6C00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BLE') Then Begin EmitW_BE($6F00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BGT') Then Begin EmitW_BE($6E00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;
  If (Mnem = 'BLT') Then Begin EmitW_BE($6D00); BcAddFixup(BC_FIX_REL16_BE, Op1, 0); EmitW_BE(0); Exit; End;

  { ---- TST.L Dn ---- }
  If (Mnem = 'TST.L') Then
  Begin
    If ParseDn(Op1) >= 0 Then EmitW_BE($4A80 Or Word(ParseDn(Op1)));
    Exit;
  End;
  If (Mnem = 'TST.W') Then
  Begin
    If ParseDn(Op1) >= 0 Then EmitW_BE($4A40 Or Word(ParseDn(Op1)));
    Exit;
  End;
  { ---- TST.B Dn / TST.B (An)+ ---- }
  If (Mnem = 'TST.B') Then
  Begin
    If ParseDn(Op1) >= 0 Then
    Begin EmitW_BE($4A00 Or Word(ParseDn(Op1))); Exit; End;
    { TST.B (An)+ - post-increment }
    Tmp := StrUpperCase(Op1);
    If (Length(Tmp) = 5) And (Tmp[1] = '(') And (Tmp[2] = 'A') And
       (Tmp[3] >= '0') And (Tmp[3] <= '7') And (Tmp[4] = ')') And (Tmp[5] = '+') Then
    Begin
      P := Ord(Tmp[3]) - Ord('0');
      EmitW_BE($4A18 Or Word(P));
      Exit;
    End;
    Exit;
  End;

  { ---- NEG.L Dn ---- }
  If (Mnem = 'NEG.L') Then
  Begin
    If ParseDn(Op1) >= 0 Then EmitW_BE($4480 Or Word(ParseDn(Op1)));
    Exit;
  End;

  { ---- ADD.L Dn,Dm / ADD.B #imm,Dn ---- }
  If (Mnem = 'ADD.L') Then
  Begin
    If (ParseDn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($D080 Or (Word(ParseDn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      { ADDI.L #imm,Dn : $0680 }
      EmitW_BE($0680 Or Word(ParseDn(Op2)));
      EmitD_BE(Val);
      Exit;
    End;
  End;
  If (Mnem = 'ADD.B') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      { ADDI.B #imm,Dn : $0600 }
      EmitW_BE($0600 Or Word(ParseDn(Op2)));
      EmitW_BE(Word(Val) And $FF);
      Exit;
    End;
  End;

  { ---- SUB.L Dn,Dm ---- }
  If (Mnem = 'SUB.L') Then
  Begin
    If (ParseDn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($9080 Or (Word(ParseDn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
  End;

  { ---- CMP.L Dn,Dm ---- }
  If (Mnem = 'CMP.L') Then
  Begin
    If (ParseDn(Op1) >= 0) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($B080 Or (Word(ParseDn(Op2)) Shl 9) Or Word(ParseDn(Op1)));
      Exit;
    End;
  End;

  { ---- AND.W #imm,Dn ---- }
  If (Mnem = 'AND.W') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      EmitW_BE($0240 Or Word(ParseDn(Op2)));
      EmitW_BE(Word(Val));
      Exit;
    End;
  End;

  { ---- LSL.L #1,Dn ---- }
  If (Mnem = 'LSL.L') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      If Val = 0 Then Val := 8;
      EmitW_BE($E180 Or (Word(Val) Shl 9) Or $0008 Or Word(ParseDn(Op2)));
      Exit;
    End;
  End;

  { ---- ROXL.L #1,Dn ---- }
  If (Mnem = 'ROXL.L') Then
  Begin
    If ParseImm(Op1, Val) And (ParseDn(Op2) >= 0) Then
    Begin
      If Val = 0 Then Val := 8;
      EmitW_BE($E180 Or (Word(Val) Shl 9) Or $0010 Or Word(ParseDn(Op2)));
      Exit;
    End;
  End;

  { ---- MOVEM.L reglist,-(SP) / MOVEM.L (SP)+,reglist ---- }
  If (Mnem = 'MOVEM.L') Then
  Begin
    If IsPreDecSP(Op2) Then
    Begin
      { MOVEM.L reglist,-(A7) : $48E7 + mask (inversee) }
      EmitW_BE($48E7);
      EmitW_BE(ReverseMask(ParseRegList(Op1)));
      Exit;
    End;
    If IsPostIncSP(Op1) Then
    Begin
      { MOVEM.L (A7)+,reglist : $4CDF + mask }
      EmitW_BE($4CDF);
      EmitW_BE(ParseRegList(Op2));
      Exit;
    End;
  End;
  If (Mnem = 'MOVEM.W') Then
  Begin
    If IsPreDecSP(Op2) Then
    Begin
      EmitW_BE($48A7);
      EmitW_BE(ReverseMask(ParseRegList(Op1)));
      Exit;
    End;
    If IsPostIncSP(Op1) Then
    Begin
      EmitW_BE($4C9F);
      EmitW_BE(ParseRegList(Op2));
      Exit;
    End;
  End;

  { ---- DBRA Dn,label ---- }
  If (Mnem = 'DBRA') Then
  Begin
    If ParseDn(Op1) >= 0 Then
    Begin
      EmitW_BE($51C8 Or Word(ParseDn(Op1)));
      BcAddFixup(BC_FIX_REL16_BE, Op2, 0);
      EmitW_BE(0);
    End;
    Exit;
  End;

  { Instruction non reconnue : emettre un NOP pour garder la structure }
  { WriteLn('BcAssemble68000: non reconnu: [', S, ']'); }
End;

{ --- Construction de la section .data binaire --- }
Procedure BcBuildData;
Var I, J: Integer; S: TString;
Begin
  BcDataLen := 0; BcDLabelCnt := 0; BcDFixCnt := 0;

  If Is68kTarget Then
  Begin
    { Section DATA 68000 : buffers minimaux }
    If Opts.DestTarget = DEST_AMIGA Then
    Begin
      { Donnees specifiques Amiga }
      BcDefineDataLabel('DOS_NAME');  BcDataStr('dos.library');
      BcDefineDataLabel('DOS_BASE'); BcDataZeros(4);
      BcDefineDataLabel('STDOUT');   BcDataZeros(4);
      BcDefineDataLabel('CHRBUF');   BcDataZeros(4);
    End;
    BcDefineDataLabel('NUMBUF');    BcDataZeros(32);
    BcDefineDataLabel('CRLF');      BcDataB(13); BcDataB(10); BcDataB(0);
    BcDefineDataLabel('STRTMP');    BcDataZeros(256);
    BcDefineDataLabel('TRUE_STR');  BcDataStr('TRUE');
    BcDefineDataLabel('FALSE_STR'); BcDataStr('FALSE');
    { Constantes et donnees utilisateur depuis DataTab }
    For I := 0 To DataCount - 1 Do
    Begin
      BcDefineDataLabel(DataTab[I].LblName);
      Case DataTab[I].Kind Of
        DK_STR:
        Begin
          For J := 1 To Length(DataTab[I].StrVal) Do
            BcDataB(Byte(DataTab[I].StrVal[J]));
          BcDataB(0);
        End;
        DK_DWORD: BcDataZeros(4);
        DK_BYTE: BcDataB(0);
        DK_ARRAY: BcDataZeros(LongInt(DataTab[I].ElemCount) *
                              LongInt(DataTab[I].ElemSize));
        DK_RES: BcDataZeros(DataTab[I].IntVal);
        DK_STRUCT:
          If DataTab[I].IntVal > 0 Then BcDataZeros(DataTab[I].IntVal)
          Else BcDataZeros(4);
        DK_ZERO:
          If DataTab[I].IntVal > 0 Then BcDataZeros(DataTab[I].IntVal)
          Else BcDataZeros(4);
        DK_INIT:
          For J := 0 To DataTab[I].ElemCount - 1 Do
            BcDataB(DataInitPool[DataTab[I].IntVal + J]);
      End;
    End;
    Exit;
  End;

  { Cibles 8 bits (MSX, AppleII, C64, Z80, 6502, 6809) :              }
  { ne PAS emettre les variables runtime Win32. Seulement les chaines }
  { utilisateur du DataTab.                                           }
  If Opts.MSX Or Opts.ApplePascal Or Opts.C64 Or
     (Opts.DestTarget = DEST_Z80) Or
     (Opts.DestTarget = DEST_6502) Or
     (Opts.DestTarget = DEST_6809) Or
     (Opts.DestTarget = DEST_MSX) Or
     (Opts.DestTarget = DEST_TRS80) Or
     (Opts.DestTarget = DEST_ADAM) Then
  Begin
    For I := 0 To DataCount - 1 Do
    Begin
      BcDefineDataLabel(DataTab[I].LblName);
      Case DataTab[I].Kind Of
        DK_STR:
        Begin
          For J := 1 To Length(DataTab[I].StrVal) Do
