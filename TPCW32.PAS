          While (Not EPAtEnd) And (SI >= 0) And (SI < TypeCount) And
                (((TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '^')) Or
                 ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '.'))) Do
