{ ------------------------------------------------------------ }
{ EmitOpen : ouvrir le fichier .ASM de sortie                  }
{ ------------------------------------------------------------ }

Procedure EmitOpen(Const AsmFile : TString);
Begin
  Assign(OutF, AsmFile);
  {$I-}
  Rewrite(OutF);
  {$I+}
  If IOResult <> 0 Then
    FatalError('impossible d''ouvrir le fichier de sortie: ' + AsmFile);
  OutFOpen := True;
  EmitLabelSeq := 0;
End;

{ ------------------------------------------------------------ }
{ EmitClose : fermer le fichier de sortie                      }
{ La directive END indique le point d entree du programme       }
{ ------------------------------------------------------------ }

Procedure EmitClose;
Begin
  If OutFOpen Then
  Begin
    If HasProgram Then
      WriteLn(OutF, 'END ' + TP_FUNC_PFX + 'Main')
    Else
      WriteLn(OutF, 'END');
    Close(OutF);
    OutFOpen := False;
  End;
End;

{ ------------------------------------------------------------ }
{ EmitRaw : ecrire une ligne brute dans le fichier de sortie   }
{ ------------------------------------------------------------ }

Procedure EmitRaw(Const S : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, S);
End;

{ ------------------------------------------------------------ }
{ Declarations anticipees du mini-assembleur binaire           }
{ ------------------------------------------------------------ }

Procedure BcDefineLabel(Const Nm: TString); Forward;
Procedure BcAssemble(Const S: TString); Forward;
Procedure BcAssemble8086(Const S: TString); Forward;
Procedure BcAssembleZ80(Const S: TString); Forward;
Procedure BcAssemble6502(Const S: TString); Forward;
Procedure BcAssemble6809(Const S: TString); Forward;
Procedure BcAssemble68000(Const S: TString); Forward;
Procedure BcAssembleCray1(Const S: TString); Forward;
Procedure CrayDefineLabel(Const Name: TString); Forward;
Procedure BcEmitB(B: Byte); Forward;
Function  BcParseNum6502(Const S: TString): LongInt; Forward;
{ ------------------------------------------------------------ }
{ Is68kTarget : True si la cible est Motorola 68000            }
{ ------------------------------------------------------------ }

Function Is68kTarget : Boolean;
Begin
  Is68kTarget := (Opts.DestTarget = DEST_68000) Or
                 (Opts.DestTarget = DEST_ATARIST) Or
                 (Opts.DestTarget = DEST_AMIGA);
End;

{ ------------------------------------------------------------ }
{ Is6502Target : True si la cible utilise le CPU MOS 6502      }
{ (-C6502 ou -CAPPLEII)                                        }
{ ------------------------------------------------------------ }

Function Is6502Target : Boolean;
Begin
  Is6502Target := (Opts.DestTarget = DEST_6502);
End;

{ ------------------------------------------------------------ }
{ EmitLabel : ecrire un label suivi de ':'                     }
{ ------------------------------------------------------------ }

Procedure EmitLabel(Const Lbl : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, Lbl, ':');
  If BcActive Then
  Begin
    If Opts.DestTarget = DEST_CRAY1 Then
      CrayDefineLabel(Lbl)
    Else
      BcDefineLabel(Lbl);
  End;
End;

{ ------------------------------------------------------------ }
{ EmitInstr : ecrire une instruction avec 8 espaces d indent   }
{ ------------------------------------------------------------ }

Procedure EmitInstr(Const S : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, '        ', S);
  If BcActive Then
  Begin
    If Opts.DestTarget = DEST_Z80 Then
      BcAssembleZ80(S)
    Else If (Opts.DestTarget = DEST_MSX) Or
            (Opts.DestTarget = DEST_TRS80) Or
            (Opts.DestTarget = DEST_ADAM) Then
      BcAssembleZ80(S)
    Else If Is6502Target Then
      BcAssemble6502(S)
    Else If Opts.DestTarget = DEST_6809 Then
      BcAssemble6809(S)
    Else If (Opts.DestTarget = DEST_68000) Or
            (Opts.DestTarget = DEST_ATARIST) Or
            (Opts.DestTarget = DEST_AMIGA) Then
      BcAssemble68000(S)
    Else If Opts.DestTarget = DEST_CRAY1 Then
      BcAssembleCray1(S)
    Else If (Opts.DestTarget = DEST_DOSR) Or
            (Opts.DestTarget = DEST_DOSP) Then
      BcAssemble8086(S)
    Else
      BcAssemble(S);
  End;
End;

{ ------------------------------------------------------------ }
{ EmitComment : ecrire un commentaire ('; text')               }
{ ------------------------------------------------------------ }

Procedure EmitComment(Const S : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, '; ', S);
End;

{ ------------------------------------------------------------ }
{ EmitBlankLine : ecrire une ligne vide                        }
{ ------------------------------------------------------------ }

Procedure EmitBlankLine;
