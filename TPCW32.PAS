            If (EP < TokenCount) And (TokenPool[EP].Kind = TK_IDENT) Then
            Begin
              EmitInstr('LEA AX,[' + GenVarAddr(PI, TokenPool[EP].Val) + ']');
              Inc(EP);
            End
