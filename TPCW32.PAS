    'Procedure HLine(X1, X2, Y : Integer; C : Word);',
    'Var X : Integer;',
    'Begin',
    '  If X1 > X2 Then Begin X := X1; X1 := X2; X2 := X End;',
    '  For X := X1 To X2 Do VPixel(X, Y, C);',
    'End;',
    '',
    'Procedure ClearViewPort;',
    'Var Y : Integer;',
    'Begin',
    '  For Y := 0 To VP.Y2 - VP.Y1 Do HLine(0, VP.X2 - VP.X1, Y, BkColor);',
    '  CPX := 0; CPY := 0;',
    'End;',
