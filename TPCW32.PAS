      Begin
        If Not EPAtEnd Then
        Begin
          ParseExpr(PI);                  { valeur du pointeur }
          If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
             (TokenPool[EP].Val = ',') Then
          Begin
            Inc(EP);
            EmitInstr('PUSH EAX');
            ParseExpr(PI);  { ignorer la taille }
            EmitInstr('POP EAX');
          End;
          EmitInstr('PUSH EAX');
          EmitInstr('PUSH 0');
          EmitInstr('PUSH DWORD PTR [HHEAP]');
