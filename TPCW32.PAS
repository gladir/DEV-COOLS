          Begin
            { Win32 : appel runtime _TPRT_SETTEXTROWS([ESP+4]=rows -> EAX) }
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'SETTEXTROWS');
            EmitInstr('ADD ESP,4');
          End;
        End; { Case }
        EPMatch(')');
