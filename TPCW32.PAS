            EmitInstr('CMPD #0');
            EmitInstr('BNE ' + Lbl);
            EmitInstr('LDD #0');
            EmitInstr('BRA ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('LDD #1');
            EmitLabel(LblDone);
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            EmitInstr('TEST EAX,EAX');
            EmitInstr('SETNE AL');
            EmitInstr('MOVZX EAX,AL');
          End;
        End; { Case }
        EPMatch(')');
      End;
