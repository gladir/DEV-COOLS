{ ============================================================== }
{ Apple II : etat d evaluation en temps de compilation pour      }
{ derouler les boucles For (cible 6502) avec corps minimal.      }
{ ============================================================== }
Const
  AII_CT_MAX_VARS  = 16;
  AII_CT_MAX_ARRS  = 16;
  AII_CT_MAX_ELEMS = 256;
Var
  AIICTVarCnt  : Integer;
  AIICTVarName : Array[0..AII_CT_MAX_VARS - 1] Of TString;
  AIICTVarVal  : Array[0..AII_CT_MAX_VARS - 1] Of LongInt;
  AIICTArrCnt  : Integer;
  AIICTArrName : Array[0..AII_CT_MAX_ARRS - 1] Of TString;
  AIICTArrIsCh : Array[0..AII_CT_MAX_ARRS - 1] Of Boolean;
  AIICTArrVal  : Array[0..AII_CT_MAX_ARRS - 1, 0..AII_CT_MAX_ELEMS - 1]
                 Of LongInt;

Function AIICTFindVar(Const N: TString): Integer;
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  AIICTFindVar := -1;
  For I := 0 To AIICTVarCnt - 1 Do
    If AIICTVarName[I] = U Then Begin AIICTFindVar := I; Exit; End;
End;

Procedure AIICTSetVar(Const N: TString; V: LongInt);
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  I := AIICTFindVar(U);
  If I < 0 Then
  Begin
    If AIICTVarCnt >= AII_CT_MAX_VARS Then Exit;
    I := AIICTVarCnt; Inc(AIICTVarCnt);
    AIICTVarName[I] := U;
  End;
  AIICTVarVal[I] := V;
End;

Function AIICTFindArr(Const N: TString): Integer;
Var I: Integer; U: TString;
Begin
  U := StrUpperCase(N);
  AIICTFindArr := -1;
  For I := 0 To AIICTArrCnt - 1 Do
    If AIICTArrName[I] = U Then Begin AIICTFindArr := I; Exit; End;
End;

Function AIICTFindOrAddArr(Const N: TString; IsCh: Boolean): Integer;
Var I: Integer;
Begin
  I := AIICTFindArr(N);
  If I < 0 Then
  Begin
    If AIICTArrCnt >= AII_CT_MAX_ARRS Then
    Begin AIICTFindOrAddArr := -1; Exit; End;
    I := AIICTArrCnt; Inc(AIICTArrCnt);
    AIICTArrName[I] := StrUpperCase(N);
    AIICTArrIsCh[I] := IsCh;
  End;
  AIICTFindOrAddArr := I;
End;

{ Forward declarations pour evaluation/parsing CT Apple II }
Function AIICTEvalExpr(Var V: LongInt; Var IsCh: Boolean): Boolean; Forward;
Procedure ParseStmtAppleII; Forward;

{ Verifier si l identifiant est un BYTESTREAM (char) declare dans SymTab }
Function AIIIsByteStreamSym(Const N: TString): Boolean;
Var SI, TI: Integer;
Begin
  AIIIsByteStreamSym := False;
  SI := SymFind(StrUpperCase(N));
  If SI < 0 Then Exit;
  TI := SymTab[SI].TypeIdx;
  If (TI < 0) Or (TI >= TypeCount) Then Exit;
  If TypeTab[TI].Kind <> TYK_ARRAY Then Exit;
  AIIIsByteStreamSym := (StrUpperCase(TypeTab[TI].Name) = 'BYTESTREAM');
End;

Function AIIIsWordStreamSym(Const N: TString): Boolean;
Var SI, TI: Integer;
Begin
  AIIIsWordStreamSym := False;
  SI := SymFind(StrUpperCase(N));
  If SI < 0 Then Exit;
  TI := SymTab[SI].TypeIdx;
  If (TI < 0) Or (TI >= TypeCount) Then Exit;
  If TypeTab[TI].Kind <> TYK_ARRAY Then Exit;
  AIIIsWordStreamSym := (StrUpperCase(TypeTab[TI].Name) = 'WORDSTREAM');
End;

{ Evaluation primaire : litteraux, identifiants, indexation, parens, Chr/Ord }
Function AIICTEvalPrimary(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  Up : TString;
  K  : Integer;
  IdxV : LongInt;
  IdxCh : Boolean;
  ArrI : Integer;
Begin
  AIICTEvalPrimary := False;
  IsCh := False; V := 0;
  If EPAtEnd Then Exit;

  { Unaire +/- }
  If (TokenPool[EP].Kind = TK_OP) And
     ((TokenPool[EP].Val = '+') Or (TokenPool[EP].Val = '-')) Then
  Begin
    Up := TokenPool[EP].Val; Inc(EP);
    If Not AIICTEvalPrimary(V, IsCh) Then Exit;
    If Up = '-' Then V := -V;
    IsCh := False;
    AIICTEvalPrimary := True;
    Exit;
  End;

  { Parens }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(') Then
  Begin
    Inc(EP);
    If Not AIICTEvalExpr(V, IsCh) Then Exit;
    If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
       (TokenPool[EP].Val <> ')') Then Exit;
    Inc(EP);
    AIICTEvalPrimary := True;
    Exit;
  End;

  Case TokenPool[EP].Kind Of
    TK_INTEGER:
    Begin
      V := TokenPool[EP].IntVal; IsCh := False; Inc(EP);
      AIICTEvalPrimary := True;
    End;
    TK_CHAR:
    Begin
      V := TokenPool[EP].IntVal And $FF; IsCh := True; Inc(EP);
      AIICTEvalPrimary := True;
    End;
    TK_KEYWORD, TK_IDENT:
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      { TRUE / FALSE -> booleen }
      If Up = 'TRUE' Then
      Begin
        V := 1; IsCh := False; Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      If Up = 'FALSE' Then
      Begin
        V := 0; IsCh := False; Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      { Chr(expr) -> char }
      If (Up = 'CHR') Then
      Begin
        Inc(EP);
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> '(') Then Exit;
        Inc(EP);
        If Not AIICTEvalExpr(V, IsCh) Then Exit;
        IsCh := True;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ')') Then Exit;
        Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;
      If (Up = 'ORD') Then
      Begin
        Inc(EP);
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> '(') Then Exit;
        Inc(EP);
        If Not AIICTEvalExpr(V, IsCh) Then Exit;
        IsCh := False;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ')') Then Exit;
        Inc(EP);
        AIICTEvalPrimary := True;
        Exit;
      End;

      { Identifiant : variable CT ou tableau CT indexe }
      Inc(EP); { consommer ident }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        If Not AIICTEvalExpr(IdxV, IdxCh) Then Exit;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
           (TokenPool[EP].Val <> ']') Then Exit;
        Inc(EP);
        ArrI := AIICTFindArr(Up);
        If ArrI < 0 Then
        Begin
          { Tableau non encore vu : creer selon type declare }
          If AIIIsByteStreamSym(Up) Then
            ArrI := AIICTFindOrAddArr(Up, True)
          Else If AIIIsWordStreamSym(Up) Then
            ArrI := AIICTFindOrAddArr(Up, False)
          Else
            ArrI := AIICTFindOrAddArr(Up, False);
        End;
        If (ArrI < 0) Or (IdxV < 0) Or (IdxV >= AII_CT_MAX_ELEMS) Then Exit;
        V := AIICTArrVal[ArrI, IdxV];
        IsCh := AIICTArrIsCh[ArrI];
        AIICTEvalPrimary := True;
        Exit;
      End;

      K := AIICTFindVar(Up);
      If K >= 0 Then
      Begin
        V := AIICTVarVal[K]; IsCh := False;
        AIICTEvalPrimary := True;
      End;
    End;
  End;
End;

{ Terme : primaire ((* | div | mod) primaire)* }
Function AIICTEvalTerm(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  V2 : LongInt; IsCh2 : Boolean; Op : TString; Up : TString;
Begin
  AIICTEvalTerm := False;
  If Not AIICTEvalPrimary(V, IsCh) Then Exit;
  While Not EPAtEnd Do
  Begin
    Op := '';
    If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '*') Then
      Op := '*'
    Else If TokenPool[EP].Kind = TK_KEYWORD Then
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      If (Up = 'DIV') Or (Up = 'MOD') Or (Up = 'AND') Or (Up = 'SHL') Or
         (Up = 'SHR') Then Op := Up;
    End;
    If Op = '' Then Break;
    Inc(EP);
    If Not AIICTEvalPrimary(V2, IsCh2) Then Exit;
    If Op = '*' Then V := V * V2
    Else If Op = 'DIV' Then Begin If V2 = 0 Then Exit; V := V Div V2; End
    Else If Op = 'MOD' Then Begin If V2 = 0 Then Exit; V := V Mod V2; End
    Else If Op = 'AND' Then V := V And V2
    Else If Op = 'SHL' Then V := V Shl V2
    Else If Op = 'SHR' Then V := V Shr V2;
    IsCh := False;
  End;
  AIICTEvalTerm := True;
End;

{ Expression : terme ((+ | -) terme)* }
Function AIICTEvalExpr(Var V: LongInt; Var IsCh: Boolean): Boolean;
Var
  V2 : LongInt; IsCh2 : Boolean; Op : TString; Up : TString;
Begin
  AIICTEvalExpr := False;
  If Not AIICTEvalTerm(V, IsCh) Then Exit;
  While Not EPAtEnd Do
  Begin
    Op := '';
    If TokenPool[EP].Kind = TK_OP Then
    Begin
      If (TokenPool[EP].Val = '+') Or (TokenPool[EP].Val = '-') Then
        Op := TokenPool[EP].Val;
    End
    Else If TokenPool[EP].Kind = TK_KEYWORD Then
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      If Up = 'OR' Then Op := 'OR';
    End;
    If Op = '' Then Break;
    Inc(EP);
    If Not AIICTEvalTerm(V2, IsCh2) Then Exit;
    If Op = '+' Then V := V + V2
    Else If Op = '-' Then V := V - V2
    Else If Op = 'OR' Then V := V Or V2;
    IsCh := False;
  End;
  AIICTEvalExpr := True;
End;

{ Evaluation comparaison : expr [op_rel expr] }
Function AIICTEvalCmp(Var V: LongInt): Boolean;
Var
  V1, V2 : LongInt; IsCh1, IsCh2 : Boolean; Op : TString;
Begin
  AIICTEvalCmp := False;
  If Not AIICTEvalExpr(V1, IsCh1) Then Exit;
  Op := '';
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) Then
  Begin
    If (TokenPool[EP].Val = '<') Or (TokenPool[EP].Val = '>') Or
       (TokenPool[EP].Val = '=') Or (TokenPool[EP].Val = '<=') Or
       (TokenPool[EP].Val = '>=') Or (TokenPool[EP].Val = '<>') Then
      Op := TokenPool[EP].Val;
  End;
  If Op = '' Then
  Begin
    V := V1;
    AIICTEvalCmp := True;
    Exit;
  End;
  Inc(EP);
  If Not AIICTEvalExpr(V2, IsCh2) Then Exit;
  If Op = '<' Then Begin If V1 <  V2 Then V := 1 Else V := 0; End
  Else If Op = '>'  Then Begin If V1 >  V2 Then V := 1 Else V := 0; End
  Else If Op = '='  Then Begin If V1 =  V2 Then V := 1 Else V := 0; End
  Else If Op = '<=' Then Begin If V1 <= V2 Then V := 1 Else V := 0; End
  Else If Op = '>=' Then Begin If V1 >= V2 Then V := 1 Else V := 0; End
  Else If Op = '<>' Then Begin If V1 <> V2 Then V := 1 Else V := 0; End;
  AIICTEvalCmp := True;
End;

{ Evaluation condition : cmp ((AND|OR) cmp)* }
Function AIICTEvalCond(Var V: LongInt): Boolean;
Var
  V2 : LongInt; Up : TString;
Begin
  AIICTEvalCond := False;
  If Not AIICTEvalCmp(V) Then Exit;
  While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) Do
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    If (Up <> 'AND') And (Up <> 'OR') Then Break;
    Inc(EP);
    If Not AIICTEvalCmp(V2) Then Exit;
    If Up = 'AND' Then
      Begin If (V <> 0) And (V2 <> 0) Then V := 1 Else V := 0; End
    Else
      Begin If (V <> 0) Or  (V2 <> 0) Then V := 1 Else V := 0; End;
  End;
  AIICTEvalCond := True;
End;

{ Avancer EP au-dela d une instruction (BEGIN..END ou single stmt). }
Procedure AIISkipStmt;
Var
  D : Integer;
  Up : TString;
Begin
  If EPAtEnd Then Exit;
  D := 0;
  If (TokenPool[EP].Kind = TK_KEYWORD) And
     (StrUpperCase(TokenPool[EP].Val) = 'BEGIN') Then
  Begin
    D := 1; Inc(EP);
    While (Not EPAtEnd) And (D > 0) Do
    Begin
      If TokenPool[EP].Kind = TK_KEYWORD Then
      Begin
        Up := StrUpperCase(TokenPool[EP].Val);
        If (Up = 'BEGIN') Or (Up = 'CASE') Or (Up = 'RECORD') Then Inc(D)
        Else If Up = 'END' Then Dec(D);
      End;
      Inc(EP);
    End;
  End
  Else
  Begin
    While Not EPAtEnd Do
    Begin
      If TokenPool[EP].Kind = TK_PUNCT Then
      Begin
        If (TokenPool[EP].Val = '(') Or (TokenPool[EP].Val = '[') Then Inc(D)
        Else If (TokenPool[EP].Val = ')') Or (TokenPool[EP].Val = ']') Then Dec(D)
        Else If (D = 0) And (TokenPool[EP].Val = ';') Then Break;
      End
      Else If (D = 0) And (TokenPool[EP].Kind = TK_KEYWORD) Then
      Begin
        Up := StrUpperCase(TokenPool[EP].Val);
        If (Up = 'END') Or (Up = 'ELSE') Or (Up = 'UNTIL') Then Break;
      End;
      Inc(EP);
    End;
  End;
End;

{ Emission AII pour une valeur evaluee : char direct ou int via PRSTR }
Procedure AIIEmitWriteValue(V: LongInt; IsCh: Boolean);
Var
  Lbl, S : TString;
  Ch : Integer;
Begin
  If IsCh Then
  Begin
    Ch := V And $FF;
    If Opts.MSX Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD A,' + IntToStr_(Ch));
      EmitInstr('CALL $00A2');
    End
    Else If Opts.Adam Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD E,' + IntToStr_(Ch));
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
    End
    Else If Opts.TRS80 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LD A,' + IntToStr_(Ch));
      EmitInstr('CALL $0033');
    End
    Else If Opts.CoCo3 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $A002');
    End
    Else If Opts.TO7 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $E803');
    End
    Else If Opts.C64 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $FFD2');
    End
    Else If Opts.Atari400 Or Opts.Atari800 Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $9B; { ATASCII EOL }
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR _TPRT_ATARI_PUTC');
    End
    Else If Opts.NES Then
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $0D;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR _TPRT_NES_PUTC');
    End
    Else
    Begin
      If (Ch = 13) Or (Ch = 10) Then Ch := $8D
      Else Ch := Ch Or $80;
      EmitInstr('LDA #' + IntToStr_(Ch));
      EmitInstr('JSR $FDED');
    End;
  End
  Else
  Begin
    S := IntToStr_(V);
    Lbl := DataGetOrAddStr(S);
    If Opts.MSX Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_MSX_PRSTR');
    End
    Else If Opts.Adam Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_ADAM_PRSTR');
    End
    Else If Opts.TRS80 Then
    Begin
      EmitInstr('LD HL,' + Lbl);
      EmitInstr('CALL _TPRT_TRS80_PRSTR');
    End
    Else If Opts.CoCo3 Then
    Begin
      EmitInstr('LDX #' + Lbl);
      EmitInstr('JSR _TPRT_COCO3_PRSTR');
    End
    Else If Opts.TO7 Then
    Begin
      EmitInstr('LDX #' + Lbl);
      EmitInstr('JSR _TPRT_TO7_PRSTR');
    End
    Else
    Begin
      EmitInstr('LDA #<' + Lbl);
      EmitInstr('LDY #>' + Lbl);
      EmitInstr('JSR _TPRT_AII_PRSTR');
    End;
  End;
End;

{ -------------------------------------------------------------- }
{ ParseWriteStmtAppleII : version specialisee Apple II.          }
{ Emet du code 6502 natif pour Write/WriteLn avec arguments      }
{ litteraux : chaine, char, entier. Les expressions complexes    }
{ (variables, indexation tableau) sont sautees silencieusement.  }
{ Utilise le runtime _TPRT_AII_PRSTR (impression chaine ASCIIZ). }
{ -------------------------------------------------------------- }
Procedure ParseWriteStmtAppleII(IsWriteLn : Boolean);
Var
  Lbl, S : TString;
  Depth, I : Integer;
  Ch : LongInt;
  Done : Boolean;
Begin
  If Opts.C64 Then
    EmitComment('writeln (C64)')
  Else If Opts.MSX Then
    EmitComment('writeln (MSX)')
  Else If Opts.Adam Then
    EmitComment('writeln (Coleco Adam)')
  Else If Opts.TRS80 Then
    EmitComment('writeln (TRS-80 Model I)')
  Else If Opts.CoCo3 Then
    EmitComment('writeln (CoCo 3)')
  Else If Opts.TO7 Then
    EmitComment('writeln (Thomson TO7)')
  Else
    EmitComment('writeln (Apple II)');
  { WriteLn sans arguments ou Write sans parenthese : juste CR LF si LN }
  If EPAtEnd Or
     Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsWriteLn Then
    Begin
      If Opts.C64 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $FFD2');
      End
      Else If Opts.MSX Then
      Begin
        EmitInstr('LD A,13');
        EmitInstr('CALL $00A2');
        EmitInstr('LD A,10');
        EmitInstr('CALL $00A2');
      End
      Else If Opts.Adam Then
      Begin
        EmitInstr('LD E,13');
        EmitInstr('LD C,2');
        EmitInstr('CALL 5');
        EmitInstr('LD E,10');
        EmitInstr('LD C,2');
        EmitInstr('CALL 5');
      End
      Else If Opts.TRS80 Then
      Begin
        EmitInstr('LD A,13');
        EmitInstr('CALL $0033');
      End
      Else If Opts.CoCo3 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $A002');
      End
      Else If Opts.TO7 Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR $E803');
      End
      Else If Opts.Atari400 Or Opts.Atari800 Then
      Begin
        EmitInstr('LDA #$9B');
        EmitInstr('JSR _TPRT_ATARI_PUTC');
      End
      Else If Opts.NES Then
      Begin
        EmitInstr('LDA #$0D');
        EmitInstr('JSR _TPRT_NES_PUTC');
      End
      Else
      Begin
        EmitInstr('LDA #$8D');
        EmitInstr('JSR $FDED');
      End;
    End;
    Exit;
  End;

  Inc(EP); { consommer ( }

  { Boucler sur les arguments }
  While Not EPAtEnd Do
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then Break;

    { Argument litteral chaine ? }
    If TokenPool[EP].Kind = TK_STRING Then
    Begin
      Lbl := DataGetOrAddStr(TokenPool[EP].Val);
      If Opts.MSX Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_MSX_PRSTR');
      End
      Else If Opts.Adam Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_ADAM_PRSTR');
      End
      Else If Opts.TRS80 Then
      Begin
        EmitInstr('LD HL,' + Lbl);
        EmitInstr('CALL _TPRT_TRS80_PRSTR');
      End
      Else If Opts.CoCo3 Then
      Begin
        EmitInstr('LDX #' + Lbl);
        EmitInstr('JSR _TPRT_COCO3_PRSTR');
      End
      Else If Opts.TO7 Then
      Begin
        EmitInstr('LDX #' + Lbl);
        EmitInstr('JSR _TPRT_TO7_PRSTR');
      End
      Else
      Begin
        EmitInstr('LDA #<' + Lbl);
        EmitInstr('LDY #>' + Lbl);
        EmitInstr('JSR _TPRT_AII_PRSTR');
      End;
      Inc(EP);
    End
    Else
    Begin
      { Tenter une evaluation en temps de compilation (CT) }
      I := EP;  { sauvegarde }
      If AIICTEvalExpr(Ch, Done) Then
      Begin
        AIIEmitWriteValue(Ch, Done);
      End
      Else
      Begin
        { Echec : restaurer EP et sauter l expression en respectant les parens }
        EP := I;
        Depth := 0;
        Done := False;
        While (Not EPAtEnd) And (Not Done) Do
        Begin
          If TokenPool[EP].Kind = TK_PUNCT Then
          Begin
            If TokenPool[EP].Val = '(' Then Inc(Depth)
            Else If TokenPool[EP].Val = ')' Then
            Begin
              If Depth = 0 Then Begin Done := True; Continue; End;
              Dec(Depth);
            End
            Else If (Depth = 0) And (TokenPool[EP].Val = ',') Then
            Begin Done := True; Continue; End;
          End;
          Inc(EP);
        End;
      End;
    End;

    { Sauter format :width / :width:dec eventuel }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ':') Then
    Begin
      Inc(EP);
      For I := 1 To 2 Do
      Begin
        If EPAtEnd Then Break;
        If TokenPool[EP].Kind = TK_INTEGER Then Inc(EP);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
           (TokenPool[EP].Val = ':') Then Inc(EP)
        Else Break;
      End;
    End;

    { Virgule entre arguments }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ',') Then
      Inc(EP)
    Else Break;
  End;

  { Consommer ) }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
     (TokenPool[EP].Val = ')') Then
    Inc(EP);

  { WriteLn : ajouter CR }
  If IsWriteLn Then
  Begin
    If Opts.C64 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $FFD2');
    End
    Else If Opts.MSX Then
    Begin
      EmitInstr('LD A,13');
      EmitInstr('CALL $00A2');
      EmitInstr('LD A,10');
      EmitInstr('CALL $00A2');
    End
    Else If Opts.Adam Then
    Begin
      EmitInstr('LD E,13');
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
      EmitInstr('LD E,10');
      EmitInstr('LD C,2');
      EmitInstr('CALL 5');
    End
    Else If Opts.TRS80 Then
    Begin
      EmitInstr('LD A,13');
      EmitInstr('CALL $0033');
    End
    Else If Opts.CoCo3 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $A002');
    End
    Else If Opts.TO7 Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR $E803');
    End
    Else If Opts.Atari400 Or Opts.Atari800 Then
    Begin
      EmitInstr('LDA #$9B');
      EmitInstr('JSR _TPRT_ATARI_PUTC');
    End
    Else If Opts.NES Then
    Begin
      EmitInstr('LDA #$0D');
      EmitInstr('JSR _TPRT_NES_PUTC');
    End
    Else
    Begin
      EmitInstr('LDA #$8D');
      EmitInstr('JSR $FDED');
    End;
  End;
End;

{ ============================================================== }
{ ParseStmtAppleII : mini-interpreteur en temps de compilation   }
{ pour le corps des boucles For deroulees (cible Apple II 6502). }
{ Reconnait :                                                     }
{   - BEGIN..END                                                  }
{   - Var := expr                  (assignation CT)               }
{   - Var[expr] := expr            (assignation indexee CT)       }
{   - Write/WriteLn(args)          (emission AII)                 }
{   - For Var := expr To/DOWNTO expr Do stmt  (deroulage CT)      }
{   - ; (separateur)                                              }
{ Toute autre construction est sautee silencieusement.            }
{ ============================================================== }
Procedure ParseStmtAppleII;
Var
  Up, IdName : TString;
  IdxV, RhsV : LongInt;
  IdxCh, RhsCh : Boolean;
  ArrI, AIIDepth : Integer;
  StartEP : Integer;
  LoopFrom, LoopTo, LoopI : LongInt;
  LoopCh : Boolean;
  IsDownTo : Boolean;
  BodyEP : Integer;
  SaveVal : LongInt;
  HadVar : Boolean;
  VIdx : Integer;
Begin
  If EPAtEnd Then Exit;

  { Sauter ; en tete }
  While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
        (TokenPool[EP].Val = ';') Do Inc(EP);
  If EPAtEnd Then Exit;

  { Mots-cles }
  If TokenPool[EP].Kind = TK_KEYWORD Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    If Up = 'END' Then Exit;
    If Up = 'UNTIL' Then Exit;
    If Up = 'ELSE' Then Exit;

    If Up = 'BEGIN' Then
    Begin
      Inc(EP);
      While Not EPAtEnd Do
      Begin
        If (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'END') Then
        Begin Inc(EP); Exit; End;
        StartEP := EP;
        ParseStmtAppleII;
        If EP = StartEP Then Inc(EP); { securite anti-boucle }
        While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
              (TokenPool[EP].Val = ';') Do Inc(EP);
      End;
      Exit;
    End;

    If (Up = 'WRITE') Or (Up = 'WRITELN') Then
    Begin
      Inc(EP);
      ParseWriteStmtAppleII(Up = 'WRITELN');
      Exit;
    End;

    If Up = 'IF' Then
    Begin
      Inc(EP); { consommer IF }
      If Not AIICTEvalCond(LoopFrom) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'THEN') Then Exit;
      Inc(EP); { consommer THEN }
      If LoopFrom <> 0 Then
      Begin
        ParseStmtAppleII;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'ELSE') Then
        Begin
          Inc(EP);
          AIISkipStmt;
        End;
      End
      Else
      Begin
        AIISkipStmt;
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
           (StrUpperCase(TokenPool[EP].Val) = 'ELSE') Then
        Begin
          Inc(EP);
          ParseStmtAppleII;
        End;
      End;
      Exit;
    End;

    If Up = 'WHILE' Then
    Begin
      Inc(EP); { consommer WHILE }
      BodyEP := EP; { CondEP : EP au debut de la condition }
      { Premiere passe : evaluer cond, lire DO, memoriser BodyEP }
      If Not AIICTEvalCond(LoopFrom) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Exit;
      Inc(EP); { consommer DO }
      StartEP := EP; { BodyEP }
      LoopI := 0;
      While (LoopFrom <> 0) And (LoopI < 100000) Do
      Begin
        EP := StartEP;
        ParseStmtAppleII;
        EP := BodyEP;
        If Not AIICTEvalCond(LoopFrom) Then Break;
        If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
           (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Break;
        Inc(EP);
        Inc(LoopI);
      End;
      { Avancer EP apres le corps }
      EP := StartEP;
      AIISkipStmt;
      Exit;
    End;

    If Up = 'REPEAT' Then
    Begin
      Inc(EP); { consommer REPEAT }
      BodyEP := EP;
      LoopI := 0;
      LoopFrom := 0;
      While LoopI < 100000 Do
      Begin
        EP := BodyEP;
        { Parser stmts jusqu a UNTIL }
        While Not EPAtEnd Do
        Begin
          If (TokenPool[EP].Kind = TK_KEYWORD) And
             (StrUpperCase(TokenPool[EP].Val) = 'UNTIL') Then Break;
          StartEP := EP;
          ParseStmtAppleII;
          If EP = StartEP Then Inc(EP);
          While (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
                (TokenPool[EP].Val = ';') Do Inc(EP);
        End;
        If EPAtEnd Then Exit;
        Inc(EP); { consommer UNTIL }
        If Not AIICTEvalCond(LoopFrom) Then Exit;
        Inc(LoopI);
        If LoopFrom <> 0 Then Break;
      End;
      Exit;
    End;

    If Up = 'FOR' Then
    Begin
      Inc(EP); { consommer FOR }
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_IDENT) Then Exit;
      IdName := StrUpperCase(TokenPool[EP].Val);
      Inc(EP);
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_OP) Or
         (TokenPool[EP].Val <> ':=') Then Exit;
      Inc(EP);
      If Not AIICTEvalExpr(LoopFrom, LoopCh) Then Exit;

      IsDownTo := False;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Then Exit;
      Up := StrUpperCase(TokenPool[EP].Val);
      If Up = 'TO' Then Inc(EP)
      Else If Up = 'DOWNTO' Then Begin IsDownTo := True; Inc(EP); End
      Else Exit;

      If Not AIICTEvalExpr(LoopTo, LoopCh) Then Exit;

      If EPAtEnd Or (TokenPool[EP].Kind <> TK_KEYWORD) Or
         (StrUpperCase(TokenPool[EP].Val) <> 'DO') Then Exit;
      Inc(EP); { consommer DO }

      BodyEP := EP;

      { Sauvegarder valeur precedente eventuelle }
      VIdx := AIICTFindVar(IdName);
      HadVar := VIdx >= 0;
      If HadVar Then SaveVal := AIICTVarVal[VIdx];

      LoopI := LoopFrom;
      If IsDownTo Then
      Begin
        While LoopI >= LoopTo Do
        Begin
          AIICTSetVar(IdName, LoopI);
          EP := BodyEP;
          ParseStmtAppleII;
          Dec(LoopI);
        End;
      End
      Else
      Begin
        While LoopI <= LoopTo Do
        Begin
          AIICTSetVar(IdName, LoopI);
          EP := BodyEP;
          ParseStmtAppleII;
          Inc(LoopI);
        End;
      End;

      { EP doit etre apres le corps : reparser une derniere fois pour avancer }
      EP := BodyEP;
      AIIDepth := 0;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_KEYWORD) And
         (StrUpperCase(TokenPool[EP].Val) = 'BEGIN') Then
      Begin
        AIIDepth := 1; Inc(EP);
        While (Not EPAtEnd) And (AIIDepth > 0) Do
        Begin
          If TokenPool[EP].Kind = TK_KEYWORD Then
          Begin
            Up := StrUpperCase(TokenPool[EP].Val);
            If (Up = 'BEGIN') Or (Up = 'CASE') Or (Up = 'RECORD') Then
              Inc(AIIDepth)
            Else If Up = 'END' Then Dec(AIIDepth);
          End;
          Inc(EP);
        End;
      End
      Else
      Begin
        While Not EPAtEnd Do
        Begin
          If TokenPool[EP].Kind = TK_PUNCT Then
          Begin
            If (TokenPool[EP].Val = '(') Or (TokenPool[EP].Val = '[') Then
              Inc(AIIDepth)
            Else If (TokenPool[EP].Val = ')') Or (TokenPool[EP].Val = ']') Then
              Dec(AIIDepth)
            Else If (AIIDepth = 0) And (TokenPool[EP].Val = ';') Then Break;
          End
          Else If (AIIDepth = 0) And (TokenPool[EP].Kind = TK_KEYWORD) Then
          Begin
            Up := StrUpperCase(TokenPool[EP].Val);
            If (Up = 'END') Or (Up = 'ELSE') Or (Up = 'UNTIL') Then Break;
          End;
          Inc(EP);
        End;
      End;

      { Restaurer var loop precedente }
      If HadVar Then
      Begin
        VIdx := AIICTFindVar(IdName);
        If VIdx >= 0 Then AIICTVarVal[VIdx] := SaveVal;
      End;
      Exit;
    End;

    { Mot-cle non reconnu : sauter jusqu au ; }
    While (Not EPAtEnd) And
          Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';')) Do
      Inc(EP);
    Exit;
  End;

  { Identifiant : assignation simple ou indexee, ou Write/WriteLn }
  If TokenPool[EP].Kind = TK_IDENT Then
  Begin
    IdName := StrUpperCase(TokenPool[EP].Val);

    { Write / WriteLn (enregistres comme TK_IDENT via RegProc) }
    If (IdName = 'WRITE') Or (IdName = 'WRITELN') Then
    Begin
      Inc(EP);
      ParseWriteStmtAppleII(IdName = 'WRITELN');
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    Inc(EP);

    { Indexation [expr] ? }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = '[') Then
    Begin
      Inc(EP);
      If Not AIICTEvalExpr(IdxV, IdxCh) Then Exit;
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_PUNCT) Or
         (TokenPool[EP].Val <> ']') Then Exit;
      Inc(EP);
      If EPAtEnd Or (TokenPool[EP].Kind <> TK_OP) Or
         (TokenPool[EP].Val <> ':=') Then Exit;
      Inc(EP);
      If Not AIICTEvalExpr(RhsV, RhsCh) Then Exit;
      If AIIIsByteStreamSym(IdName) Then
        ArrI := AIICTFindOrAddArr(IdName, True)
      Else If AIIIsWordStreamSym(IdName) Then
        ArrI := AIICTFindOrAddArr(IdName, False)
      Else
        ArrI := AIICTFindOrAddArr(IdName, RhsCh);
      If (ArrI >= 0) And (IdxV >= 0) And (IdxV < AII_CT_MAX_ELEMS) Then
        AIICTArrVal[ArrI, IdxV] := RhsV;
      { Sauter ; }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    { Assignation simple Var := expr }
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_OP) And
       (TokenPool[EP].Val = ':=') Then
    Begin
      Inc(EP);
      If Not AIICTEvalExpr(RhsV, RhsCh) Then Exit;
      AIICTSetVar(IdName, RhsV);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
    End;

    { Identifiant non reconnu : sauter jusqu au ; }
    While (Not EPAtEnd) And
          Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ';')) Do
      Inc(EP);
    Exit;
  End;

  { Sinon : avancer pour eviter une boucle infinie }
  Inc(EP);
End;

Procedure ParseWriteStmt(PI : Integer; IsWriteLn : Boolean);
Var
  TIdx : Integer;
  FmtWidth : Integer;
  IsFileWrite : Boolean;
  FVarTIdx    : Integer;
  Up          : TString;
  LI, SI      : Integer;
Begin
  { Branche specialisee 6502 (Apple II / C64) : code natif }
  If Opts.AppleII Or Opts.C64 Or Opts.MSX Or Opts.CoCo3 Or Opts.TO7 Or Opts.Adam Or Opts.TRS80 Or Opts.Atari400 Or Opts.Atari800 Or Opts.NES Then
  Begin
    ParseWriteStmtAppleII(IsWriteLn);
    Exit;
  End;

  If IsWriteLn Then
    EmitComment('writeln')
  Else
    EmitComment('write');

  IsFileWrite := False;

  { Gerer WriteLn sans arguments -> juste CR+LF }
  If EPAtEnd Then
  Begin
    If IsWriteLn Then
    Begin
      If Is68kTarget Then
      Begin
        EmitInstr('LEA CRLF,A0');
        EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
      End
      Else
      Begin
        EmitInstr('LEA ESI,[CRLF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
      End;
    End;
    Exit;
  End;

  { Si pas de parenthese, WriteLn sans args }
  If Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsWriteLn Then
    Begin
      If Is68kTarget Then
      Begin
        EmitInstr('LEA CRLF,A0');
        EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
      End
      Else
      Begin
        EmitInstr('LEA ESI,[CRLF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
      End;
    End;
    Exit;
  End;

  { Consommer ( }
  Inc(EP);

  { Detecter si le premier argument est une variable fichier Text }
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    FVarTIdx := TY_IDX_INTEGER;
    If PI >= 0 Then
    Begin
      LI := FindLocal(PI, Up);
      If LI >= 0 Then
        FVarTIdx := ProcTab[PI].Locals[LI].TypeIdx
      Else
      Begin
        LI := FindParam(PI, Up);
        If LI >= 0 Then FVarTIdx := ProcTab[PI].Params[LI].TypeIdx;
      End;
    End;
    If FVarTIdx <> TY_IDX_TEXT Then
    Begin
      SI := SymFind(Up);
      If SI >= 0 Then FVarTIdx := SymTab[SI].TypeIdx;
    End;
    If FVarTIdx = TY_IDX_TEXT Then
    Begin
      { Ecriture dans un fichier }
      IsFileWrite := True;
      GenLoadAddr(PI, TokenPool[EP].Val);
      Inc(EP);
      EmitInstr('MOV EAX,DWORD PTR [EAX]');    { charger le handle }
      EmitInstr('MOV DWORD PTR [FILE_WRHND],EAX');
      { Sauter la virgule si presente }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End;
  End;

  { Boucle sur les arguments }
  While Not EPAtEnd Do
  Begin
    { Fin des arguments ? }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Break;

    { Determiner le type de l argument }
    TIdx := InferExprType(PI);

    { Evaluer l expression }
    ParseExpr(PI);

    { Detecter formatage :width }
    FmtWidth := 0;
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
      Begin
        Inc(EP); { consommer : }
        If Not EPAtEnd Then
        Begin
          If TokenPool[EP].Kind = TK_INTEGER Then
          Begin
            FmtWidth := TokenPool[EP].IntVal;
            Inc(EP);
          End
          Else
          Begin
            { Largeur dynamique : evaluer mais ignorer pour l instant }
            EmitInstr('PUSH EAX');
            ParseExpr(PI);
            EmitInstr('POP EAX');
          End;
        End;
        { Si :w:d (formatage flottant) : ignorer aussi d }
        If Not EPAtEnd Then
        Begin
          If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
          Begin
            Inc(EP);
            If Not EPAtEnd Then
            Begin
              If TokenPool[EP].Kind = TK_INTEGER Then
                Inc(EP)
              Else
                ParseExpr(PI);
            End;
          End;
        End;
      End;
    End;

    { Afficher selon le type, avec padding si :width }
    If (FmtWidth > 0) Then
    Begin
      EmitInstr('MOV ECX,' + IntToStr_(FmtWidth));
      EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');
      EmitInstr('LEA ESI,[NUMBUF]');
      EmitInstr('CALL ' + TP_RT_PFX + 'PADPRINT');
    End
    Else If IsFileWrite Then
      EmitFilePrintEAX(TIdx)
    Else
      EmitPrintEAX(TIdx);

    { Virgule entre arguments }
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
        Inc(EP)
      Else
        Break;
    End;
  End;

  { Consommer ) }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Inc(EP);

  { WriteLn : ajouter CR+LF }
  If IsWriteLn Then
  Begin
    If Is68kTarget And (Not IsFileWrite) Then
    Begin
      EmitInstr('LEA CRLF,A0');
      EmitInstr('BSR ' + TP_RT_PFX + 'PRINTSTR');
    End
    Else
    Begin
      EmitInstr('LEA ESI,[CRLF]');
      If IsFileWrite Then
        EmitInstr('CALL ' + TP_RT_PFX + 'FPRINTSTR')
      Else
        EmitInstr('CALL ' + TP_RT_PFX + 'PRINTSTR');
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ ParseReadStmt : parser Read(vars) ou ReadLn(vars).            }
{ EP pointe apres READ/READLN deja consomme.                   }
{ Lit une ligne depuis STDIN, puis parse les variables.         }
{ ------------------------------------------------------------ }

Procedure ParseReadStmt(PI : Integer; IsReadLn : Boolean);
Var
  VName, Up : TString;
  SI, LI    : Integer;
  TIdx      : Integer;
  IsFileRead: Boolean;
  FVarTIdx  : Integer;
Begin
  If IsReadLn Then
    EmitComment('readln')
  Else
    EmitComment('read');

  { ReadLn sans arguments : lire et jeter une ligne }
  If EPAtEnd Or
     Not ((TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(')) Then
  Begin
    If IsReadLn Then
      EmitInstr('CALL ' + TP_RT_PFX + 'READLN');
    Exit;
  End;

  { Consommer ( }
  Inc(EP);

  { Detecter si le premier argument est une variable fichier Text }
  IsFileRead := False;
  If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);
    FVarTIdx := TY_IDX_INTEGER;  { defaut }
    If PI >= 0 Then
    Begin
      LI := FindLocal(PI, Up);
      If LI >= 0 Then
        FVarTIdx := ProcTab[PI].Locals[LI].TypeIdx
      Else
      Begin
        LI := FindParam(PI, Up);
        If LI >= 0 Then FVarTIdx := ProcTab[PI].Params[LI].TypeIdx;
      End;
    End;
    If FVarTIdx <> TY_IDX_TEXT Then
    Begin
      SI := SymFind(Up);
      If SI >= 0 Then FVarTIdx := SymTab[SI].TypeIdx;
    End;
    If FVarTIdx = TY_IDX_TEXT Then
    Begin
      { Lecture depuis un fichier }
      IsFileRead := True;
      GenLoadAddr(PI, TokenPool[EP].Val);
      Inc(EP);
      EmitInstr('PUSH EAX');  { adresse de la variable fichier }
      EmitInstr('CALL ' + TP_RT_PFX + 'READLN_FILE');
      EmitInstr('ADD ESP,4');
      { Sauter la virgule si presente }
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End;
  End;

  If Not IsFileRead Then
  Begin
    { Lire une ligne depuis STDIN dans INBUF }
    EmitInstr('CALL ' + TP_RT_PFX + 'READLN');
  End;

  { Boucle sur les variables }
  While Not EPAtEnd Do
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Break;

    If TokenPool[EP].Kind = TK_IDENT Then
    Begin
      VName := TokenPool[EP].Val;
      Up := StrUpperCase(VName);
      Inc(EP);

      { Determiner le type de la variable }
      TIdx := TY_IDX_INTEGER;
      If PI >= 0 Then
      Begin
        LI := FindLocal(PI, Up);
        If LI >= 0 Then
          TIdx := ProcTab[PI].Locals[LI].TypeIdx
        Else
        Begin
          LI := FindParam(PI, Up);
          If LI >= 0 Then
            TIdx := ProcTab[PI].Params[LI].TypeIdx;
        End;
      End;
      If TIdx = TY_IDX_INTEGER Then
      Begin
        SI := SymFind(Up);
        If SI >= 0 Then
          TIdx := SymTab[SI].TypeIdx;
      End;

      If (TIdx = TY_IDX_STRING) Or (TIdx = TY_IDX_PCHAR) Then
      Begin
        { Copier INBUF vers la variable string }
        EmitInstr('LEA ESI,[INBUF]');
        GenLoadAddr(PI, VName);
        EmitInstr('MOV EDI,EAX');
        { Copier octet par octet }
        EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN');
      End
      Else If TIdx = TY_IDX_CHAR Then
      Begin
        { Prendre le premier caractere de INBUF }
        EmitInstr('MOVZX EAX,BYTE PTR [INBUF]');
        GenStoreVar(PI, VName);
      End
      Else
      Begin
        { Integer : convertir INBUF en nombre }
        EmitInstr('LEA ESI,[INBUF]');
        EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');
        GenStoreVar(PI, VName);
      End;
    End
    Else
      Inc(EP); { sauter token inconnu }

    { Virgule entre variables }
    If Not EPAtEnd Then
    Begin
      If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
        Inc(EP)
      Else
        Break;
    End;
  End;

  { Consommer ) }
  If Not EPAtEnd Then
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ')') Then
      Inc(EP);
End;

{ ------------------------------------------------------------ }
{ ParseStrStmt : parser Str(N[:W], S)                          }
{ Convertit un nombre en chaine.                               }
{ ------------------------------------------------------------ }

Procedure ParseStrStmt(PI : Integer);
Var
  VName : TString;
Begin
  EmitComment('str');

  { Consommer ( }
  If Not EPMatch('(') Then Exit;

  { Evaluer l expression numerique }
  ParseExpr(PI);

  { Ignorer le formatage :width }
  If Not EPAtEnd Then
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ':') Then
    Begin
      Inc(EP);
      If Not EPAtEnd Then
      Begin
        If TokenPool[EP].Kind = TK_INTEGER Then
          Inc(EP)
        Else
          ParseExpr(PI);
      End;
    End;
  End;

  { Convertir en chaine }
  EmitInstr('CALL ' + TP_RT_PFX + 'NUMTOSTR');

  { Consommer , }
  EPMatch(',');

  { Variable cible }
  If Not EPAtEnd Then
  Begin
    If TokenPool[EP].Kind = TK_IDENT Then
    Begin
      VName := TokenPool[EP].Val;
      Inc(EP);

      { Copier NUMBUF vers la variable string }
      EmitInstr('LEA ESI,[NUMBUF]');
      GenLoadAddr(PI, VName);
      EmitInstr('MOV EDI,EAX');
      EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN');
    End;
  End;

  { Consommer ) }
  EPMatch(')');
End;

{ ------------------------------------------------------------ }
{ ParseValStmt : parser Val(S, N, Code)                        }
{ Convertit une chaine en nombre.                              }
{ ------------------------------------------------------------ }

Procedure ParseValStmt(PI : Integer);
Var
  VName : TString;
Begin
  EmitComment('val');

  { Consommer ( }
  If Not EPMatch('(') Then Exit;

  { Evaluer l expression chaine }
  ParseExpr(PI);
  If LastExprIsPascalStr Then
    EmitInstr('INC EAX');   { Pascal -> ASCIIZ : sauter l octet de longueur }
  EmitInstr('MOV ESI,EAX');

  { Convertir en nombre }
  EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');

  { Consommer , }
  EPMatch(',');

  { Variable numerique cible }
  If Not EPAtEnd Then
  Begin
    If TokenPool[EP].Kind = TK_IDENT Then
    Begin
      VName := TokenPool[EP].Val;
      Inc(EP);
      GenStoreVar(PI, VName);
    End;
  End;

  { Troisieme argument Code : stocker 0 (pas d erreur) }
  If Not EPAtEnd Then
  Begin
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = ',') Then
    Begin
      Inc(EP);
      If Not EPAtEnd Then
      Begin
        If TokenPool[EP].Kind = TK_IDENT Then
        Begin
          VName := TokenPool[EP].Val;
          Inc(EP);
          EmitInstr('XOR EAX,EAX');
          GenStoreVar(PI, VName);
        End;
      End;
    End;
  End;

  { Consommer ) }
  EPMatch(')');
End;

