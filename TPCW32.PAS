          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);  EmitInstr('PUSH AX');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH AX');
            EmitInstr('CALL ' + TP_RT_PFX + 'STRECOPY');
            EmitInstr('ADD SP,4');
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);  EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH HL');
            EmitInstr('CALL ' + TP_RT_PFX + 'STRECOPY');
            EmitInstr('POP BC');
            EmitInstr('POP BC');
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);  EmitInstr('PHA');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PHA');
            EmitInstr('JSR ' + TP_RT_PFX + 'STRECOPY');
            EmitInstr('PLA');
            EmitInstr('PLA');
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);  EmitInstr('PSHS D');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PSHS D');
            EmitInstr('JSR ' + TP_RT_PFX + 'STRECOPY');
            EmitInstr('LEAS 4,S');
          End;
          Else
          Begin
            ParseExpr(PI);  EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'STRECOPY');
            EmitInstr('ADD ESP,8');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { ---- TODO 21 : Fonctions Overlay (retournent valeur dans EAX) ---- }

    { OVRGETBUF -> taille buffer overlay }
    If Up = 'OVRGETBUF' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVE.L OVR_BUFSIZE,D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('MOV AX,[OVR_BUFSIZE]');
        DEST_Z80:
          EmitInstr('LD HL,(OVR_BUFSIZE)');
        DEST_6502:
          EmitInstr('LDA OVR_BUFSIZE');
        DEST_6809:
          EmitInstr('LDD OVR_BUFSIZE');
        Else
          EmitInstr('MOV EAX,DWORD PTR [OVR_BUFSIZE]');
      End;
      Exit;
    End;

    { OVRGETRETURNCODE -> code retour overlay }
    If Up = 'OVRGETRETURNCODE' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVE.L OVR_RESULT,D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('MOV AX,[OVR_RESULT]');
        DEST_Z80:
          EmitInstr('LD HL,(OVR_RESULT)');
        DEST_6502:
          EmitInstr('LDA OVR_RESULT');
        DEST_6809:
          EmitInstr('LDD OVR_RESULT');
        Else
          EmitInstr('MOV EAX,DWORD PTR [OVR_RESULT]');
      End;
      Exit;
    End;

    { ---- TODO 21 : Fonctions Turbo3 (retournent valeur dans EAX) ---- }
    { GraphColorMode et GraphMode comme fonctions retournent mode }
    If Up = 'GRAPHCOLORMODE' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVEQ #4,D0');
        DEST_DOSR, DEST_DOSP:
        Begin
          EmitInstr('XOR AX,AX');
          EmitInstr('MOV AL,4');
        End;
        DEST_Z80:
          EmitInstr('LD HL,4');
        DEST_6502:
          EmitInstr('LDA #4');
        DEST_6809:
          EmitInstr('LDD #4');
        Else
        Begin
          EmitInstr('XOR EAX,EAX');
          EmitInstr('MOV AL,4');
        End;
      End;
      EmitComment('GraphColorMode (Turbo3 compat) -> 4');
      Exit;
    End;

    If Up = 'GRAPHMODE' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVEQ #6,D0');
        DEST_DOSR, DEST_DOSP:
        Begin
          EmitInstr('XOR AX,AX');
          EmitInstr('MOV AL,6');
        End;
        DEST_Z80:
          EmitInstr('LD HL,6');
        DEST_6502:
          EmitInstr('LDA #6');
        DEST_6809:
          EmitInstr('LDD #6');
        Else
        Begin
          EmitInstr('XOR EAX,EAX');
          EmitInstr('MOV AL,6');
        End;
      End;
      EmitComment('GraphMode (Turbo3 compat) -> 6');
      Exit;
    End;

    { ---- TODO 21 : Fonctions Objects (retournent valeur dans EAX) ---- }

    { NEWSTR(S) : allouer copie chaine sur le tas -> PString }
    If Up = 'NEWSTR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
        Begin
          EmitInstr('MOVE.L D0,-(SP)');
          EmitInstr('BSR ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('ADDQ.L #4,SP');
        End;
        DEST_DOSR, DEST_DOSP:
        Begin
          EmitInstr('PUSH AX');
          EmitInstr('CALL ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('ADD SP,2');
        End;
        DEST_Z80:
        Begin
          EmitInstr('PUSH HL');
          EmitInstr('CALL ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('POP BC');
        End;
        DEST_6502:
        Begin
          EmitInstr('PHA');
          EmitInstr('JSR ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('PLA');
        End;
        DEST_6809:
        Begin
          EmitInstr('PSHS D');
          EmitInstr('JSR ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('LEAS 2,S');
        End;
        Else
        Begin
          EmitInstr('PUSH EAX');
          EmitInstr('CALL ' + TP_RT_PFX + 'NEWSTR');
          EmitInstr('ADD ESP,4');
        End;
      End;
      Exit;
    End;

    { TCOLLECTION_COUNT -> retourne le nombre d elements }
    If Up = 'TCOLLECTION_COUNT' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('CLR.L D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('XOR AX,AX');
        DEST_Z80:
          EmitInstr('LD HL,0');
        DEST_6502:
          EmitInstr('LDA #0');
        DEST_6809:
          EmitInstr('LDD #0');
        Else
          EmitInstr('XOR EAX,EAX');
      End;
      EmitComment('TCollection.Count (stub) -> 0');
      Exit;
    End;

    { TCOLLECTION_AT(Index) -> retourne element a l index }
    If Up = 'TCOLLECTION_AT' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('CLR.L D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('XOR AX,AX');
        DEST_Z80:
          EmitInstr('LD HL,0');
        DEST_6502:
          EmitInstr('LDA #0');
        DEST_6809:
          EmitInstr('LDD #0');
        Else
          EmitInstr('XOR EAX,EAX');
      End;
      EmitComment('TCollection.At (stub) -> NIL');
      Exit;
    End;

    { TCOLLECTION_INDEXOF(Item) -> retourne index ou -1 }
    If Up = 'TCOLLECTION_INDEXOF' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVEQ #-1,D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('MOV AX,-1');
        DEST_Z80:
          EmitInstr('LD HL,-1');
        DEST_6502:
          EmitInstr('LDA #$FF');
        DEST_6809:
          EmitInstr('LDD #-1');
        Else
          EmitInstr('MOV EAX,-1');
      End;
      EmitComment('TCollection.IndexOf (stub) -> -1');
      Exit;
    End;

    { TSTREAM_GETPOS -> retourne position courante }
    If Up = 'TSTREAM_GETPOS' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVE.L OBJ_TMPPOS,D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('MOV AX,[OBJ_TMPPOS]');
        DEST_Z80:
          EmitInstr('LD HL,(OBJ_TMPPOS)');
        DEST_6502:
          EmitInstr('LDA OBJ_TMPPOS');
        DEST_6809:
          EmitInstr('LDD OBJ_TMPPOS');
        Else
          EmitInstr('MOV EAX,DWORD PTR [OBJ_TMPPOS]');
      End;
      Exit;
    End;

    { TSTREAM_GETSIZE -> retourne taille du stream }
    If Up = 'TSTREAM_GETSIZE' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('MOVE.L OBJ_TMPSIZ,D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('MOV AX,[OBJ_TMPSIZ]');
        DEST_Z80:
          EmitInstr('LD HL,(OBJ_TMPSIZ)');
        DEST_6502:
          EmitInstr('LDA OBJ_TMPSIZ');
        DEST_6809:
          EmitInstr('LDD OBJ_TMPSIZ');
        Else
          EmitInstr('MOV EAX,DWORD PTR [OBJ_TMPSIZ]');
      End;
      Exit;
    End;

    { TSTREAM_GET -> lire objet depuis stream (stub -> NIL) }
    If Up = 'TSTREAM_GET' Then
    Begin
      Inc(EP);
      Case Opts.DestTarget Of
        DEST_68000, DEST_ATARIST, DEST_AMIGA:
          EmitInstr('CLR.L D0');
        DEST_DOSR, DEST_DOSP:
          EmitInstr('XOR AX,AX');
        DEST_Z80:
          EmitInstr('LD HL,0');
        DEST_6502:
          EmitInstr('LDA #0');
        DEST_6809:
          EmitInstr('LDD #0');
        Else
          EmitInstr('XOR EAX,EAX');
      End;
      EmitComment('TStream.Get (stub) -> NIL');
      Exit;
    End;

    { TSTREAM_READ(Buf, Count) -> lire octets }
    If Up = 'TSTREAM_READ' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            EmitInstr('BSR ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('ADDQ.L #8,SP');
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            EmitInstr('CALL ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('ADD SP,4');
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            EmitInstr('CALL ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('POP BC');
            EmitInstr('POP BC');
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('PHA');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PHA');
            EmitInstr('JSR ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('PLA');
            EmitInstr('PLA');
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PSHS D');
            EmitInstr('JSR ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('LEAS 4,S');
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ',') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'STREAM_READ');
            EmitInstr('ADD ESP,8');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { ---- TODO 22 : Mem[Seg:Ofs] / MemW[Seg:Ofs] / MemL[Seg:Ofs] en lecture ---- }
    If (Up = 'MEM') Or (Up = 'MEMW') Or (Up = 'MEML') Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,D1');
            EmitInstr('MOVE.L (SP)+,D0');
            EmitInstr('BSR ' + TP_RT_PFX + 'READMEM');
            If Up = 'MEM' Then
              EmitInstr('AND.L #$FF,D0')
            Else If Up = 'MEMW' Then
              EmitInstr('AND.L #$FFFF,D0');
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('MOV DX,AX');
            EmitInstr('POP AX');
            EmitInstr('CALL ' + TP_RT_PFX + 'READMEM');
            If Up = 'MEM' Then
              EmitInstr('AND AX,00FFh')
            Else If Up = 'MEMW' Then
              EmitComment('MEMW : 16 bits, pas de masque');
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('POP DE');
            EmitInstr('CALL ' + TP_RT_PFX + 'READMEM');
            If Up = 'MEM' Then
              EmitInstr('LD H,0');
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('PHA');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('TAX');
            EmitInstr('PLA');
            EmitInstr('JSR ' + TP_RT_PFX + 'READMEM');
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('TFR D,X');
            EmitInstr('PULS D');
            EmitInstr('JSR ' + TP_RT_PFX + 'READMEM');
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ':') Then Inc(EP);
            ParseExpr(PI);
            EmitInstr('MOV EDX,EAX');
            EmitInstr('POP EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'READMEM');
            If Up = 'MEM' Then
              EmitInstr('AND EAX,0FFh')
            Else If Up = 'MEMW' Then
              EmitInstr('AND EAX,0FFFFh');
          End;
        End; { Case }
        EPMatch(']');
      End;
      Exit;
    End;

    { ---- TODO 22 : Port[$nn] / PortW[$nn] en lecture ---- }
    If (Up = 'PORT') Or (Up = 'PORTW') Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '[') Then
      Begin
        Inc(EP);
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            EmitInstr('BSR ' + TP_RT_PFX + 'INPORT');
            EmitInstr('ADDQ.L #4,SP');
            If Up = 'PORT' Then
              EmitInstr('AND.L #$FF,D0')
            Else
              EmitInstr('AND.L #$FFFF,D0');
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('MOV DX,AX');
            If Up = 'PORT' Then
              EmitInstr('IN AL,DX')
            Else
              EmitInstr('IN AX,DX');
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('LD C,L');
            EmitInstr('IN A,(C)');
            EmitInstr('LD L,A');
            EmitInstr('LD H,0');
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('JSR ' + TP_RT_PFX + 'INPORT');
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            EmitInstr('JSR ' + TP_RT_PFX + 'INPORT');
            EmitInstr('LEAS 2,S');
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('CALL ' + TP_RT_PFX + 'INPORT');
            If Up = 'PORT' Then
              EmitInstr('AND EAX,0FFh')
            Else
              EmitInstr('AND EAX,0FFFFh');
          End;
        End; { Case }
        EPMatch(']');
      End;
      Exit;
    End;

    { Appel de procedure/fonction ? }
    SI := SymFind(Up);
    If (SI >= 0) And (SymTab[SI].Kind = SK_PROC) And (Not SymTab[SI].IsExternal) And
       Not ((EP + 1 < EPEnd) And (TokenPool[EP + 1].Kind = TK_PUNCT) And
            (TokenPool[EP + 1].Val = '(')) Then
    Begin
      { nom de procedure dans une expression : son adresse (affectation a une variable procedure) }
      EmitInstr('LEA EAX,[' + SymTab[SI].MangledName + ']');
      LastVarTypeIdx := -1;
      Inc(EP);
      Exit;
    End;
    If (SI >= 0) And
       ((SymTab[SI].Kind = SK_PROC) Or (SymTab[SI].Kind = SK_FUNC)) Then
    Begin
      Inc(EP);
      ParseFuncCall(PI, Up);
      Exit;
    End;
    { Variable de type procedure/fonction suivie de '(' : appel indirect }
    LI := GetVarTypeIdx(PI, Up);
    If (LI >= 0) And (LI < TypeCount) And (TypeTab[LI].Kind = TYK_PROCVAR) And
       (EP + 1 < EPEnd) And (TokenPool[EP + 1].Kind = TK_PUNCT) And
       (TokenPool[EP + 1].Val = '(') Then
    Begin
      Inc(EP);
      ParseFuncCall(PI, Up);
      Exit;
    End;

    { Verifier aussi dans ProcTab }
    If SI < 0 Then
    Begin
      LI := 0;
      While LI < ProcCount Do
      Begin
        If ProcTab[LI].Name = Up Then
        Begin
          Inc(EP);
          If (Not ProcTab[LI].IsFunction) And
             Not ((Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
                  (TokenPool[EP].Val = '(')) Then
          Begin
            EmitInstr('LEA EAX,[' + TP_FUNC_PFX + Up + ']');
            LastVarTypeIdx := -1;
          End
          Else
            ParseFuncCall(PI, Up);
          Exit;
        End;
        Inc(LI);
      End;
    End;

    { WITH : resoudre champ implicite en lecture }
    If (WithDepth > 0) Then
    Begin
      WI := WithFieldIndex(Up, WFOfs);
      If WI >= 0 Then
      Begin
        EmitInstr('MOV EAX,[WITHPTR+' + IntToStr_(WI * 4) + ']');
        If WFOfs > 0 Then
          EmitInstr('ADD EAX,' + IntToStr_(WFOfs));
        LastVarTypeIdx := WithTypeIdx[WI];
        WJ := 0;
        While (WJ < TypeTab[LastVarTypeIdx].FieldCount) And
              (TypeTab[LastVarTypeIdx].Fields[WJ].Name <> Up) Do
          Inc(WJ);
        If WJ < TypeTab[LastVarTypeIdx].FieldCount Then
          GenLoadFromAddr(TypeTab[LastVarTypeIdx].Fields[WJ].TypeIdx)
        Else
          GenLoadFromAddr(-1);
        LastPrimaryName := Up;
        Inc(EP);
        Exit;
      End;
    End;

    { Variable ou constante : charger dans EAX }
    LastPrimaryName := Up;
    LastVarTypeIdx := GetVarTypeIdx(PI, Up);
    GenLoadVar(PI, Up);
    Inc(EP);
    Exit;
  End;

  { Constructeur d ensemble : [elem1, elem2, lo..hi, ...] -> tampon de 32 octets (256 bits) }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '[') Then
  Begin
    Inc(EP); { sauter '[' }
    Lbl := 'SETBUF+' + IntToStr_((SetBufSeq Mod 8) * 32);
    Inc(SetBufSeq);
    EmitInstr('LEA EDI,[' + Lbl + ']');
    EmitInstr('MOV ECX,8');
    EmitInstr('XOR EAX,EAX');
    EmitInstr('REP STOSD');
    WantCharLit := True;
    While (Not EPAtEnd) And
          Not ((TokenPool[EP].Kind = TK_PUNCT) And
               (TokenPool[EP].Val = ']')) Do
    Begin
      ParseExpr(PI);                  { EAX = valeur element (ou borne basse) }
      If (Not EPAtEnd) And (((TokenPool[EP].Kind = TK_PUNCT) Or (TokenPool[EP].Kind = TK_OP)) And
         (TokenPool[EP].Val = '..')) Then
      Begin
        Inc(EP);                      { sauter '..' }
        EmitInstr('PUSH EAX');        { sauvegarder lo }
        ParseExpr(PI);               { EAX = hi }
        EmitInstr('MOV EDX,EAX');
        EmitInstr('POP ECX');
        EmitInstr('LEA EBX,[' + Lbl + ']');
        EmitInstr('CALL ' + TP_RT_PFX + 'SETRANGE');
      End
      Else
      Begin
        EmitInstr('MOV ECX,EAX');
        EmitInstr('LEA EAX,[' + Lbl + ']');
        EmitInstr('CALL ' + TP_RT_PFX + 'SETINCL');
      End;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ',') Then
        Inc(EP);
    End;
    WantCharLit := False;
    If Not EPAtEnd Then Inc(EP);  { sauter ']' }
    EmitInstr('LEA EAX,[' + Lbl + ']');
    LastVarTypeIdx := SetGenTypeIdx;
    LastExprIsPascalStr := False;
    Exit;
  End;

  { Expression entre parentheses }
  If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '(') Then
  Begin
    Inc(EP);
    ParseExpr(PI);
    EPMatch(')');
    Exit;
  End;

  { Token non reconnu : avancer }
  Inc(EP);
End;

{ ------------------------------------------------------------ }
{ ParsePrimary : apres une fonction (integree ou utilisateur), le }
{ type de la derniere expression (LastVarTypeIdx) est celui du    }
{ resultat de la fonction et non celui de son dernier argument :  }
{ Length(S) = 0 compilait en comparaison de chaines et plantait.  }
{ ------------------------------------------------------------ }
Function BuiltinFuncResultKind(Const Up : TString) : Integer;
{ 0 = inconnu/entier, 1 = chaine, 2 = caractere, 3 = booleen }
Begin
  BuiltinFuncResultKind := 0;
  If (Up = 'COPY') Or (Up = 'CONCAT') Or (Up = 'PARAMSTR') Or (Up = 'STRPAS') Or
     (Up = 'GETENV') Or (Up = 'FEXPAND') Or (Up = 'FSEARCH') Or (Up = 'ENVSTR') Or
     (Up = 'GETDRIVERNAME') Or (Up = 'GETMODENAME') Or (Up = 'GRAPHERRORMSG') Or
     (Up = 'STRUPPER') Or (Up = 'STRLOWER') Or (Up = 'STRCAT') Or (Up = 'STRCOPY') Or
     (Up = 'STRECOPY') Or (Up = 'STREND') Or (Up = 'STRLCAT') Or (Up = 'STRLCOPY') Or
     (Up = 'STRMOVE') Or (Up = 'STRNEW') Or (Up = 'STRPOS') Or (Up = 'STRRSCAN') Or
     (Up = 'STRSCAN') Or (Up = 'STRPCOPY') Or (Up = 'NEWSTR') Then
    BuiltinFuncResultKind := 1
  Else If (Up = 'CHR') Or (Up = 'UPCASE') Or (Up = 'READKEY') Then
    BuiltinFuncResultKind := 2
  Else If (Up = 'EOF') Or (Up = 'EOLN') Or (Up = 'SEEKEOF') Or (Up = 'SEEKEOLN') Or
          (Up = 'KEYPRESSED') Or (Up = 'ODD') Or (Up = 'ASSIGNED') Then
    BuiltinFuncResultKind := 3;
End;

Procedure ParsePrimary(PI : Integer);
Var
  Up : TString; SI, K : Integer;
Begin
  Up := '';
  If (Not EPAtEnd) And ((TokenPool[EP].Kind = TK_IDENT) Or (TokenPool[EP].Kind = TK_KEYWORD)) Then
    Up := StrUpperCase(TokenPool[EP].Val);
  ParsePrimaryInner(PI);
  If Up = '' Then Exit;
  SI := SymFind(Up);
  If (SI < 0) Or (SymTab[SI].Kind <> SK_FUNC) Then Exit;
  If SymTab[SI].IsExternal Then
  Begin
    { fonction integree }
    If TypeIsReal(LastVarTypeIdx) And W32Fpu Then Exit;   { reel : type pose par l emetteur }
    K := BuiltinFuncResultKind(Up);
    If K = 1 Then Exit;                   { chaine : indicateurs poses par l emetteur }
    If ((Up = 'SUCC') Or (Up = 'PRED')) And (LastSuccPredType = TY_IDX_CHAR) Then
      K := 2;
    If K = 2 Then LastVarTypeIdx := TY_IDX_CHAR
    Else If K = 3 Then LastVarTypeIdx := TY_IDX_BOOLEAN
    Else LastVarTypeIdx := TY_IDX_INTEGER;
    LastExprIsPascalStr := False;
  End
  Else If (SymTab[SI].TypeIdx >= 0) And Not TypeIsString(SymTab[SI].TypeIdx) Then
  Begin
    { fonction utilisateur a resultat non chaine }
    LastVarTypeIdx := SymTab[SI].TypeIdx;
    LastExprIsPascalStr := False;
  End
  Else If (SymTab[SI].TypeIdx >= 0) Then
  Begin
    { fonction utilisateur a resultat chaine : pointeur Pascal dans l anneau STRRING }
    LastVarTypeIdx := TY_IDX_STRING;
    LastExprIsPascalStr := True;
  End;
End;

{ ------------------------------------------------------------ }
{ ParseIndexW32 : apres '[' ; EAX = adresse de base, T = type   }
{ (tableau, chaine ou PChar). Calcule l adresse de l element    }
{ (dimensions separees par ',') ; T devient le type element.    }
{ ------------------------------------------------------------ }

Procedure ParseIndexW32(PI : Integer; Var T : Integer);
Var
  ElemSz, ET : Integer;
  IsZero : Boolean;
Begin
  LastIndexIsStrLen := False;
  Repeat
    EmitInstr('PUSH EAX');
    IsZero := (Not EPAtEnd) And (TokenPool[EP].Kind = TK_INTEGER) And (TokenPool[EP].IntVal = 0) And
              (EP + 1 < EPEnd) And (TokenPool[EP + 1].Kind = TK_PUNCT) And (TokenPool[EP + 1].Val = ']');
    ParseExpr(PI);
    If (T >= 0) And (T < TypeCount) And (TypeTab[T].Kind = TYK_ARRAY) Then
    Begin
      If TypeTab[T].Lo <> 0 Then
        EmitInstr('SUB EAX,' + IntToStr_(TypeTab[T].Lo));
      ET := TypeTab[T].BaseTypeIdx;
      ElemSz := 4;
      If ET >= 0 Then ElemSz := TypeSizeofIdx(ET);
      If ElemSz = 1 Then
      Else If ElemSz = 2 Then EmitInstr('SHL EAX,1')
      Else If ElemSz = 4 Then EmitInstr('SHL EAX,2')
      Else If ElemSz = 8 Then EmitInstr('SHL EAX,3')
      Else EmitInstr('IMUL EAX,' + IntToStr_(ElemSz));
      T := ET;
    End
    Else If (T >= 0) And (T < TypeCount) And
            ((TypeTab[T].Kind = TYK_STRING) Or (TypeTab[T].Kind = TYK_PCHAR)) Then
    Begin
      If (TypeTab[T].Kind = TYK_STRING) And IsZero Then LastIndexIsStrLen := True;
      T := TY_IDX_CHAR;         { S[i] : octet i (S[0] = longueur) }
    End
    Else
    Begin
      EmitInstr('SHL EAX,2');
      T := -1;
    End;
    EmitInstr('POP EBX');
    EmitInstr('ADD EAX,EBX');
    If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
       (TokenPool[EP].Val = ',') Then
      Inc(EP)
    Else
      Break;
  Until False;
  EPMatch(']');
End;

{ ------------------------------------------------------------ }
{ ParseLValueW32 : variable deja consommee ; applique les        }
{ suffixes ^ [index] .champ et laisse dans EAX l adresse de la   }
{ destination, T = son type                                      }
{ ------------------------------------------------------------ }

Procedure ParseLValueSuffixW32(PI : Integer; Var T : Integer);
Var
  Up : TString;
  FOfs, FSize : LongInt;
  K : Integer;
Begin
  While Not EPAtEnd Do
  Begin
    { P^ : dereference }
    If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '^') Then
    Begin
      Inc(EP);
      EmitInstr('MOV EAX,[EAX]');
      If (T >= 0) And (T < TypeCount) And (TypeTab[T].Kind = TYK_POINTER) Then
        T := TypeTab[T].BaseTypeIdx
      Else If (T >= 0) And (T < TypeCount) And (TypeTab[T].Kind = TYK_PCHAR) Then
        T := TY_IDX_CHAR
      Else
        T := -1;
      Continue;
    End;
    { [index] }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '[') Then
    Begin
      Inc(EP);
      If (T >= 0) And (T < TypeCount) And (TypeTab[T].Kind = TYK_PCHAR) Then
        EmitInstr('MOV EAX,[EAX]');     { P[i] : la base est la valeur du pointeur }
      ParseIndexW32(PI, T);
      Continue;
    End;
    { .champ }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '.') Then
    Begin
      Inc(EP);
      If EPAtEnd Then Break;
      Up := StrUpperCase(TokenPool[EP].Val);
      Inc(EP);
      FSize := 4;
      FOfs := FindFieldOffset(T, Up, FSize);
      If FOfs >= 0 Then
      Begin
        If FOfs > 0 Then
          EmitInstr('ADD EAX,' + IntToStr_(FOfs));
        K := 0;
        While (K < TypeTab[T].FieldCount) And (TypeTab[T].Fields[K].Name <> Up) Do
          Inc(K);
        If K < TypeTab[T].FieldCount Then
          T := TypeTab[T].Fields[K].TypeIdx
        Else
          T := -1;
      End
      Else
      Begin
        EmitComment('champ inconnu: ' + Up + ' (type ' + IntToStr_(T) + ')');
        T := -1;
      End;
      Continue;
    End;
    Break;
  End;
End;

Procedure ParseLValueW32(PI : Integer; Const VName : TString; Var T : Integer);
Begin
  GenLoadAddr(PI, VName);
  T := GetVarTypeIdx(PI, VName);
  ParseLValueSuffixW32(PI, T);
End;

{ ------------------------------------------------------------ }
{ WithFieldIndex : l identificateur Up est-il un champ d un     }
{ WITH actif ? Retourne la profondeur (ou -1) et l offset       }
{ ------------------------------------------------------------ }

Function WithFieldIndex(Const Up : TString; Var FOfs : LongInt) : Integer;
Var
  WI : Integer;
  FSize : LongInt;
Begin
  WithFieldIndex := -1;
  WI := WithDepth - 1;
  While WI >= 0 Do
  Begin
    FSize := 4;
    FOfs := FindFieldOffset(WithTypeIdx[WI], Up, FSize);
    If FOfs >= 0 Then
    Begin
      WithFieldIndex := WI;
      Exit;
    End;
    Dec(WI);
  End;
End;

{ ------------------------------------------------------------ }
{ ParseLValueAddrW32 : le jeton courant est un identificateur    }
{ (variable ou champ d un WITH) ; consomme l identificateur et   }
{ ses suffixes, laisse l adresse dans EAX et le type dans T.     }
{ Retourne False si le jeton n est pas un identificateur.        }
{ ------------------------------------------------------------ }

Function ParseLValueAddrW32(PI : Integer; Var T : Integer) : Boolean;
Var
  Up : TString;
  WI, K : Integer;
  FOfs : LongInt;
Begin
  ParseLValueAddrW32 := False;
  T := -1;
  If EPAtEnd Then Exit;
  If (TokenPool[EP].Kind <> TK_IDENT) And (TokenPool[EP].Kind <> TK_KEYWORD) Then Exit;
  Up := StrUpperCase(TokenPool[EP].Val);
  ParseLValueAddrW32 := True;
  LastIndexIsStrLen := False;
  WI := -1;
  If WithDepth > 0 Then
    WI := WithFieldIndex(Up, FOfs);
  If WI >= 0 Then
  Begin
    Inc(EP);
    EmitInstr('MOV EAX,[WITHPTR+' + IntToStr_(WI * 4) + ']');
    If FOfs > 0 Then
      EmitInstr('ADD EAX,' + IntToStr_(FOfs));
    T := WithTypeIdx[WI];
    K := 0;
    While (K < TypeTab[T].FieldCount) And (TypeTab[T].Fields[K].Name <> Up) Do
      Inc(K);
    If K < TypeTab[T].FieldCount Then
      T := TypeTab[T].Fields[K].TypeIdx
    Else
      T := -1;
    ParseLValueSuffixW32(PI, T);
  End
  Else
  Begin
    Inc(EP);
    ParseLValueW32(PI, Up, T);
  End;
End;

{ ------------------------------------------------------------ }
{ ParsePostfix : parser les suffixes apres une expression       }
{ primaire : [index], .champ, ^dereference                     }
{ ------------------------------------------------------------ }

Procedure ParsePostfix(PI : Integer);
Var
  Up : TString;
  ElemSz : Integer;
  FOfs : LongInt;
  FSize : LongInt;
  SavedTypeIdx : Integer;
Begin
  While Not EPAtEnd Do
  Begin
    { Dereference : ^ }
    If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '^') Then
    Begin
      Inc(EP);
      SavedTypeIdx := LastVarTypeIdx;
      If (SavedTypeIdx >= 0) And (SavedTypeIdx < TypeCount) And
         (TypeTab[SavedTypeIdx].Kind = TYK_POINTER) Then
        GenLoadFromAddr(TypeTab[SavedTypeIdx].BaseTypeIdx)
      Else If (SavedTypeIdx >= 0) And (SavedTypeIdx < TypeCount) And
              (TypeTab[SavedTypeIdx].Kind = TYK_PCHAR) Then
        GenLoadFromAddr(TY_IDX_CHAR)
      Else
        GenLoadFromAddr(TY_IDX_INTEGER);
      Continue;
    End;

    { Acces tableau / chaine : [index] ou [i,j] multi-dimensionnel }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '[') Then
    Begin
      Inc(EP);
      SavedTypeIdx := LastVarTypeIdx;
      ParseIndexW32(PI, SavedTypeIdx);
      GenLoadFromAddr(SavedTypeIdx);
      Continue;
    End;

    { Acces champ : .field (record/objet) }
    If (TokenPool[EP].Kind = TK_PUNCT) And (TokenPool[EP].Val = '.') Then
    Begin
      Inc(EP);
      If Not EPAtEnd Then
      Begin
        Up := StrUpperCase(TokenPool[EP].Val);
        Inc(EP);
        FSize := 4;
        FOfs := FindFieldOffset(LastVarTypeIdx, Up, FSize);
        If FOfs >= 0 Then
        Begin
          If FOfs > 0 Then
            EmitInstr('ADD EAX,' + IntToStr_(FOfs));
          { Type du champ }
          SavedTypeIdx := -1;
          If (LastVarTypeIdx >= 0) And (LastVarTypeIdx < TypeCount) Then
          Begin
            For ElemSz := 0 To TypeTab[LastVarTypeIdx].FieldCount - 1 Do
              If TypeTab[LastVarTypeIdx].Fields[ElemSz].Name = Up Then
              Begin
                SavedTypeIdx := TypeTab[LastVarTypeIdx].Fields[ElemSz].TypeIdx;
                Break;
              End;
          End;
          If SavedTypeIdx >= 0 Then
            GenLoadFromAddr(SavedTypeIdx)
          Else If FSize = 1 Then
          Begin
            EmitInstr('MOVZX EAX,BYTE PTR [EAX]');
            LastVarTypeIdx := -1;
          End
          Else
          Begin
            EmitInstr('MOV EAX,[EAX]');
            LastVarTypeIdx := -1;
          End;
        End
        Else
          EmitComment('champ inconnu: ' + Up);
      End;
      Continue;
    End;

    Break;
  End;
End;

{ ------------------------------------------------------------ }
{ ParseUnary : parser les operateurs unaires prefixes           }
{ NOT, @, -, +                                                  }
{ ------------------------------------------------------------ }

Procedure ParseUnary(PI : Integer);
Var
  Up : TString;
  ATIdx : Integer;
Begin
  If EPAtEnd Then Exit;

  Up := StrUpperCase(TokenPool[EP].Val);

  { NOT }
  If (TokenPool[EP].Kind = TK_KEYWORD) And (Up = 'NOT') Then
  Begin
    Inc(EP);
    ParseUnary(PI);
    If LastVarTypeIdx = TY_IDX_BOOLEAN Then
      EmitInstr('XOR EAX,1')
    Else
      EmitInstr('NOT EAX');
    Exit;
  End;

  { Negation unaire - }
  If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '-') Then
  Begin
    Inc(EP);
    ParseUnary(PI);
    If TypeIsReal(LastVarTypeIdx) And W32Fpu Then
      EmitInstr('FCHS')
    Else
      EmitInstr('NEG EAX');
    Exit;
  End;

  { Plus unaire + (no-op) }
  If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '+') Then
  Begin
    Inc(EP);
    ParseUnary(PI);
    Exit;
  End;

  { Adresse @ : variable, element de tableau, champ, procedure }
  If (TokenPool[EP].Kind = TK_OP) And (TokenPool[EP].Val = '@') Then
  Begin
    Inc(EP);
    If Not EPAtEnd Then
    Begin
      Up := StrUpperCase(TokenPool[EP].Val);
      If (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) And (Not Opts.Dos16Mode) And
         (SymFind(Up) >= 0) And ((SymTab[SymFind(Up)].Kind = SK_PROC) Or (SymTab[SymFind(Up)].Kind = SK_FUNC)) Then
      Begin
        EmitInstr('LEA EAX,[' + SymTab[SymFind(Up)].MangledName + ']');
        Inc(EP);
      End
      Else If (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) And (Not Opts.Dos16Mode) Then
      Begin
        ParseLValueAddrW32(PI, ATIdx);
      End
      Else
      Begin
        GenLoadAddr(PI, Up);
        Inc(EP);
      End;
      LastVarTypeIdx := TY_IDX_POINTER;
      LastExprIsPascalStr := False;
    End;
    Exit;
  End;

  { Expression primaire }
  ParsePrimary(PI);
  ParsePostfix(PI);
End;

