{ ============================================================ }

{ ------------------------------------------------------------ }
{ BinOpPrec : retourner le niveau de precedence d un operateur  }
{ binaire Pascal. 0 = pas un operateur binaire.                 }
{ Niveaux de precedence Pascal (plus haut = lie plus fort) :    }
{   3 : * / DIV MOD AND SHL SHR  (multiplicatif)               }
{   2 : + - OR XOR               (additif)                     }
{   1 : = <> < > <= >= IN        (relationnel)                  }
{ ------------------------------------------------------------ }

Function BinOpPrec(Const Op : TString) : Integer;
Var
  U : TString;
Begin
  U := Op;
  If (U = '*') Or (U = '/') Or (U = 'DIV') Or (U = 'MOD') Or
     (U = 'AND') Or (U = 'SHL') Or (U = 'SHR') Then
    BinOpPrec := 3
  Else If (U = '+') Or (U = '-') Or (U = 'OR') Or (U = 'XOR') Then
    BinOpPrec := 2
  Else If (U = '=') Or (U = '<>') Or (U = '<') Or (U = '>') Or
          (U = '<=') Or (U = '>=') Or (U = 'IN') Then
    BinOpPrec := 1
  Else
    BinOpPrec := 0;
End;

{ ------------------------------------------------------------ }
{ EmitBinOp : emettre le code ASM pour EAX op EBX              }
{ Le resultat doit rester dans EAX.                             }
{ ------------------------------------------------------------ }

Procedure EmitBinOp(Const Op : TString);
Var
  LblTrue, LblEnd : TString;
Begin
  { Arithmetique }
  If Op = '+' Then
    EmitInstr('ADD EAX,EBX')
  Else If Op = '-' Then
    EmitInstr('SUB EAX,EBX')
  Else If Op = '*' Then
    EmitInstr('IMUL EAX,EBX')
  Else If (Op = '/') Or (Op = 'DIV') Then
  Begin
    EmitInstr('CDQ');
    EmitInstr('IDIV EBX');
  End
  Else If Op = 'MOD' Then
  Begin
    EmitInstr('CDQ');
    EmitInstr('IDIV EBX');
    EmitInstr('MOV EAX,EDX');
  End
  { Decalages }
  Else If Op = 'SHL' Then
  Begin
    EmitInstr('MOV ECX,EBX');
    EmitInstr('SHL EAX,CL');
  End
  Else If Op = 'SHR' Then
  Begin
    EmitInstr('MOV ECX,EBX');
    EmitInstr('SHR EAX,CL');
  End
  { Bit a bit / Logique }
  Else If Op = 'AND' Then
    EmitInstr('AND EAX,EBX')
  Else If Op = 'OR' Then
    EmitInstr('OR EAX,EBX')
  Else If Op = 'XOR' Then
    EmitInstr('XOR EAX,EBX')
  { Comparaisons }
  Else If Op = '=' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JE ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  Else If Op = '<>' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JNE ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  Else If Op = '<' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JL ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  Else If Op = '<=' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JLE ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  Else If Op = '>' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JG ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  Else If Op = '>=' Then
  Begin
    LblTrue := LabelGen;
    LblEnd  := LabelGen;
    EmitInstr('CMP EAX,EBX');
    EmitInstr('JGE ' + LblTrue);
    EmitInstr('XOR EAX,EAX');
    EmitInstr('JMP ' + LblEnd);
    EmitLabel(LblTrue);
    EmitInstr('MOV EAX,1');
    EmitLabel(LblEnd);
  End
  { IN (ensemble) : BT [set], val }
  Else If Op = 'IN' Then
  Begin
    { EAX = element, EBX = adresse de l ensemble (32 octets) }
    EmitInstr('CALL ' + TP_RT_PFX + 'SETIN');
  End
  Else
    EmitComment('; operateur binaire inconnu: ' + Op);
End;

{ ------------------------------------------------------------ }
{ ParseExprPrec : parseur de Pratt pour expressions Pascal      }
{ MinPrec = niveau de precedence minimal a capturer.            }
{ Le resultat est toujours dans EAX.                            }
{ Gere le court-circuit pour AND et OR booleens.                }
{ ------------------------------------------------------------ }

Procedure ParseExprPrec(PI : Integer; MinPrec : Integer);
Var
  Op       : TString;
  Prec     : Integer;
  LblF     : TString;
  LblE     : TString;
  LeftIsStr : Boolean;
  LeftPascal : Boolean;
  LeftReal, RightReal : Boolean;
  LeftT    : Integer;
Begin
  ParseUnary(PI);

  While Not EPAtEnd Do
  Begin
    { Lire l operateur courant }
    Op := '';
    If TokenPool[EP].Kind = TK_OP Then
      Op := StrUpperCase(TokenPool[EP].Val)
    Else If TokenPool[EP].Kind = TK_KEYWORD Then
      Op := StrUpperCase(TokenPool[EP].Val);

    Prec := BinOpPrec(Op);
    If (Prec = 0) Or (Prec < MinPrec) Then Break;

    { tableau de Char compare ou concatene : convertir en chaine }
    If IsCharArray(LastVarTypeIdx) And ((Prec = 1) Or (Op = '+')) And
       (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) Then
      CoerceCharArray;

    { Detecter si la partie gauche est une chaine }
    LeftIsStr := TypeIsString(LastVarTypeIdx);
    LeftPascal := LastExprIsPascalStr;

    Inc(EP); { consommer l operateur }
    { --- Comparaison Char = 'x' : le litteral d un seul caractere est un code, pas une adresse --- }
    If ((Op = '=') Or (Op = '<>') Or (Op = '<') Or (Op = '>') Or (Op = '<=') Or (Op = '>=')) And
       (LastVarTypeIdx = TY_IDX_CHAR) And (Not EPAtEnd) And (TokenPool[EP].Kind = TK_STRING) And
       (Length(TokenPool[EP].Val) = 1) And (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) Then
    Begin
      EmitInstr('MOV EBX,' + IntToStr_(Ord(TokenPool[EP].Val[1])));
      Inc(EP);
      EmitBinOp(Op);
      LastVarTypeIdx := TY_IDX_BOOLEAN;
      Continue;
    End;

    { --- Concatenation de chaines avec + (TODO 16) --- }
    { gauche : chaine ou Char ; la gauche est copiee dans un tampon sur la pile }
    { pour que l evaluation de la droite puisse utiliser STRBUF1 (imbrication)  }
    If (Op = '+') And (LeftIsStr Or (LastVarTypeIdx = TY_IDX_CHAR)) And
       (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) Then
    Begin
      If LeftIsStr Then
      Begin
        EmitInstr('MOV ESI,EAX');        { ESI = chaine gauche  }
        If LeftPascal Then
          EmitInstr('INC ESI');           { sauter l octet de longueur }
      End
      Else
      Begin
        EmitInstr('MOVZX EAX,AL');       { Char -> chaine d un caractere }
        EmitInstr('MOV [CHRBUF],EAX');
        EmitInstr('LEA ESI,[CHRBUF]');
      End;
      EmitInstr('SUB ESP,512');
      EmitInstr('MOV EDI,ESP');
      EmitInstr('CALL ' + TP_RT_PFX + 'STRASSIGN_PCHAR');
      ParseExprPrec(PI, Prec + 1);
      CoerceCharArray;
      If (LastVarTypeIdx = TY_IDX_CHAR) And (Not LastExprIsPascalStr) Then
      Begin
        EmitInstr('MOVZX EAX,AL');
        EmitInstr('MOV [CHRBUF],EAX');
        EmitInstr('LEA EDI,[CHRBUF]');
      End
      Else
      Begin
        EmitInstr('MOV EDI,EAX');        { EDI = chaine droite  }
        If LastExprIsPascalStr Then
          EmitInstr('INC EDI');           { sauter l octet de longueur }
      End;
      EmitInstr('MOV ESI,ESP');
      EmitInstr('CALL ' + TP_RT_PFX + 'CONCAT');
      EmitInstr('MOV ESI,ESP');
      EmitInstr('LEA EDI,[STRBUF1]');
      EmitInstr('CALL ' + TP_RT_PFX + 'STRCPY255');
      EmitInstr('ADD ESP,512');
      EmitInstr('LEA EAX,[STRBUF1]');
      LastVarTypeIdx := TY_IDX_STRING;
      LastExprIsPascalStr := False;     { STRBUF1 est ASCIIZ }
      Continue;
    End;

    { --- Comparaison de chaines (TODO 16) --- }
    If ((Op = '=') Or (Op = '<>') Or (Op = '<') Or (Op = '>') Or
        (Op = '<=') Or (Op = '>=')) And LeftIsStr Then
    Begin
      If LeftPascal Then
        EmitInstr('INC EAX');           { sauter l octet de longueur gauche }
      EmitInstr('PUSH EAX');            { sauver gauche }
      ParseExprPrec(PI, Prec + 1);
      CoerceCharArray;
      EmitInstr('MOV EDI,EAX');         { EDI = droite  }
      If LastExprIsPascalStr Then
        EmitInstr('INC EDI');           { sauter l octet de longueur droite }
      EmitInstr('POP ESI');             { ESI = gauche  }
      EmitInstr('CALL ' + TP_RT_PFX + 'STRCOMPARE');
      { EAX = resultat strcompare: <0, 0, >0 }
      LblF := LabelGen;
      LblE := LabelGen;
      If Op = '=' Then
      Begin
        EmitInstr('TEST EAX,EAX');
        EmitInstr('JZ ' + LblF);
      End
      Else If Op = '<>' Then
      Begin
        EmitInstr('TEST EAX,EAX');
        EmitInstr('JNZ ' + LblF);
      End
      Else If Op = '<' Then
      Begin
        EmitInstr('TEST EAX,EAX');
        EmitInstr('JS ' + LblF);
      End
      Else If Op = '>' Then
      Begin
        EmitInstr('CMP EAX,0');
        EmitInstr('JG ' + LblF);
      End
      Else If Op = '<=' Then
      Begin
        EmitInstr('CMP EAX,0');
        EmitInstr('JLE ' + LblF);
      End
      Else If Op = '>=' Then
      Begin
        EmitInstr('TEST EAX,EAX');
        EmitInstr('JNS ' + LblF);
      End;
      EmitInstr('XOR EAX,EAX');
      EmitInstr('JMP ' + LblE);
      EmitLabel(LblF);
      EmitInstr('MOV EAX,1');
      EmitLabel(LblE);
      LastVarTypeIdx := TY_IDX_BOOLEAN;
      Continue;
    End;

    { --- Court-circuit AND (ET logique) : seulement si la gauche est booleenne --- }
    If (Op = 'AND') And (LastVarTypeIdx = TY_IDX_BOOLEAN) Then
    Begin
      LblF := LabelGen;
      LblE := LabelGen;
      EmitInstr('TEST EAX,EAX');
      EmitInstr('JZ ' + LblF);
      ParseExprPrec(PI, Prec + 1);
      EmitInstr('TEST EAX,EAX');
      EmitInstr('JZ ' + LblF);
      EmitInstr('MOV EAX,1');
      EmitInstr('JMP ' + LblE);
      EmitLabel(LblF);
      EmitInstr('XOR EAX,EAX');
      EmitLabel(LblE);
      Continue;
    End;

    { --- Court-circuit OR (OU logique) : seulement si la gauche est booleenne --- }
    If (Op = 'OR') And (LastVarTypeIdx = TY_IDX_BOOLEAN) Then
    Begin
      LblF := LabelGen;
      LblE := LabelGen;
      EmitInstr('TEST EAX,EAX');
      EmitInstr('JNZ ' + LblF);
      ParseExprPrec(PI, Prec + 1);
      EmitInstr('TEST EAX,EAX');
      EmitInstr('JNZ ' + LblF);
      EmitInstr('XOR EAX,EAX');
      EmitInstr('JMP ' + LblE);
      EmitLabel(LblF);
      EmitInstr('MOV EAX,1');
      EmitLabel(LblE);
      Continue;
    End;

    { --- Ensembles : union + difference - intersection * egalite = <> --- }
    If (LastVarTypeIdx >= 0) And (LastVarTypeIdx < TypeCount) And
       (TypeTab[LastVarTypeIdx].Kind = TYK_SET) And
       ((Op = '+') Or (Op = '-') Or (Op = '*') Or (Op = '=') Or (Op = '<>') Or (Op = '<=') Or (Op = '>=')) And
       (Not Is68kTarget) And (Opts.DestTarget <> DEST_CRAY1) Then
    Begin
      EmitInstr('PUSH EAX');            { adresse ensemble gauche }
      ParseExprPrec(PI, Prec + 1);
      EmitInstr('MOV EDI,EAX');         { droite }
      EmitInstr('POP ESI');             { gauche }
      If (Op = '+') Or (Op = '-') Or (Op = '*') Then
      Begin
        LblF := 'SETBUF+' + IntToStr_((SetBufSeq Mod 8) * 32);
        Inc(SetBufSeq);
        EmitInstr('LEA EDX,[' + LblF + ']');
        If Op = '+' Then EmitInstr('CALL ' + TP_RT_PFX + 'SETUNION')
        Else If Op = '-' Then EmitInstr('CALL ' + TP_RT_PFX + 'SETDIFF')
        Else EmitInstr('CALL ' + TP_RT_PFX + 'SETINTER');
        EmitInstr('MOV EAX,EDX');
        LastVarTypeIdx := SetGenTypeIdx;
      End
      Else
      Begin
        If Op = '<=' Then
        Begin
          EmitInstr('MOV EAX,ESI');
          EmitInstr('MOV ESI,EDI');
          EmitInstr('MOV EDI,EAX');
          EmitInstr('CALL ' + TP_RT_PFX + 'SETSUB')     { droite contient gauche }
        End
        Else If Op = '>=' Then
          EmitInstr('CALL ' + TP_RT_PFX + 'SETSUB')
        Else
        Begin
          EmitInstr('CALL ' + TP_RT_PFX + 'SETEQ');
          If Op = '<>' Then EmitInstr('XOR EAX,1');
        End;
        LastVarTypeIdx := TY_IDX_BOOLEAN;
      End;
      LastExprIsPascalStr := False;
      Continue;
    End;

    { --- Operateurs binaires normaux --- }
    { Sauver la valeur gauche (EAX) sur la pile ; une valeur reelle reste dans ST(0) }
    LastExprIsLit := False;
    LeftT := LastVarTypeIdx;
    LeftReal := TypeIsReal(LeftT) And W32Fpu;
    If Opts.DestTarget = DEST_CRAY1 Then
      EmitInstr('CRSAVE')
    Else If Not LeftReal Then
      EmitInstr('PUSH EAX');

    ParseExprPrec(PI, Prec + 1);

    { --- Reels : + - * / et comparaisons ; la division / est toujours reelle --- }
    RightReal := TypeIsReal(LastVarTypeIdx) And W32Fpu;
    If (LeftReal Or RightReal Or ((Op = '/') And W32Fpu)) And
       ((Op = '+') Or (Op = '-') Or (Op = '*') Or (Op = '/') Or (Op = '=') Or (Op = '<>') Or
        (Op = '<') Or (Op = '>') Or (Op = '<=') Or (Op = '>=')) Then
    Begin
      { ST(0) = droite, ST(1) = gauche }
      If LeftReal And (Not RightReal) Then
        GenIntToReal
      Else If Not LeftReal Then
      Begin
        If Not RightReal Then GenIntToReal;      { droite -> ST(0) }
        EmitInstr('FILD DWORD PTR [ESP]');        { gauche (entier empile) -> ST(0) }
        EmitInstr('ADD ESP,4');
        EmitInstr('FXCH');
      End;
      If Op = '+' Then EmitInstr('FADDP ST(1),ST')
      Else If Op = '-' Then EmitInstr('FSUBP ST(1),ST')
      Else If Op = '*' Then EmitInstr('FMULP ST(1),ST')
      Else If Op = '/' Then EmitInstr('FDIVP ST(1),ST')
      Else
      Begin
        { comparaison : FCOMPP compare ST(0)=droite a ST(1)=gauche ; C0 : droite < gauche }
        EmitInstr('FCOMPP');
        EmitInstr('FNSTSW AX');
        EmitInstr('SAHF');
        LblF := LabelGen;
        LblE := LabelGen;
        If Op = '=' Then EmitInstr('JE ' + LblF)
        Else If Op = '<>' Then EmitInstr('JNE ' + LblF)
        Else If Op = '>' Then EmitInstr('JB ' + LblF)
        Else If Op = '<' Then EmitInstr('JA ' + LblF)
        Else If Op = '>=' Then EmitInstr('JBE ' + LblF)
        Else EmitInstr('JAE ' + LblF);
        EmitInstr('XOR EAX,EAX');
        EmitInstr('JMP ' + LblE);
        EmitLabel(LblF);
        EmitInstr('MOV EAX,1');
        EmitLabel(LblE);
        LastVarTypeIdx := TY_IDX_BOOLEAN;
        LastExprIsPascalStr := False;
        Continue;
      End;
      If LeftReal Or RightReal Then
        LastVarTypeIdx := RealResultType(LeftT, LastVarTypeIdx)
      Else
        LastVarTypeIdx := TY_IDX_REAL;
      LastExprIsPascalStr := False;
      Continue;
    End;
    If LeftReal Then
      EmitInstr('FSTP ST(0)');   { operateur non reel sur un reel : abandonner la valeur }

    If Opts.DestTarget = DEST_CRAY1 Then
    Begin
      { Cray-1 : pile registre, gauche = sommet, droite = S1 }
      If Op = '+' Then EmitInstr('CRADD')
      Else If Op = '-' Then EmitInstr('CRSUB')
      Else If Op = 'AND' Then EmitInstr('CRAND')
      Else If Op = 'OR'  Then EmitInstr('CROR')
      Else If Op = 'XOR' Then EmitInstr('CRXOR')
      Else If Op = '='   Then EmitInstr('CRCMPEQ')
      Else If Op = '<>'  Then EmitInstr('CRCMPNE')
      Else If Op = '<'   Then EmitInstr('CRCMPLT')
      Else If Op = '<='  Then EmitInstr('CRCMPLE')
      Else If Op = '>'   Then EmitInstr('CRCMPGT')
      Else If Op = '>='  Then EmitInstr('CRCMPGE')
      Else
      Begin
        EmitComment('CRAY: operateur ' + Op + ' non supporte (Phase 2h)');
        EmitInstr('CRDISC');
        { Forcer 0 dans S1 pour eviter pollution par valeur droite. }
        EmitInstr('LDIMM S1,0');
      End;
    End
    Else
    Begin
      { EAX = droite, pile = gauche }
      EmitInstr('MOV EBX,EAX');
      EmitInstr('POP EAX');
      EmitBinOp(Op);
      If (Op = '=') Or (Op = '<>') Or (Op = '<') Or (Op = '>') Or
         (Op = '<=') Or (Op = '>=') Or (Op = 'IN') Then
        LastVarTypeIdx := TY_IDX_BOOLEAN
      Else If LastVarTypeIdx <> TY_IDX_BOOLEAN Then
        LastVarTypeIdx := TY_IDX_INTEGER;
      LastExprIsPascalStr := False;
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ ParseExpr : parser une expression complete                    }
{ Appelle ParseExprPrec avec la precedence minimale (1).        }
{ ------------------------------------------------------------ }

Procedure ParseExpr(PI : Integer);
Begin
  ParseExprPrec(PI, 1);
End;

