          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);  EmitInstr('PUSH AX');   { Dx }
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH AX');   { Dy }
          End;
          Else
          Begin
            ParseExpr(PI);  EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH EAX');
