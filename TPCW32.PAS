      If EPMatch('(') Then
      Begin
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            ParseExpr(PI);
            EmitInstr('MOVE.L D0,-(SP)');
            EmitInstr('BSR ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('ADDQ.L #4,SP');
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH AX');
            EmitInstr('CALL ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('ADD SP,2');
          End;
          DEST_Z80:
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH HL');
            EmitInstr('CALL ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('POP BC');
          End;
          DEST_6502:
          Begin
            ParseExpr(PI);
            EmitInstr('PHA');
            EmitInstr('JSR ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('PLA');
          End;
          DEST_6809:
          Begin
            ParseExpr(PI);
            EmitInstr('PSHS D');
            EmitInstr('JSR ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('LEAS 2,S');
          End;
          Else
          Begin
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'SETVIDEOMODE');
            EmitInstr('ADD ESP,4');
          End;
        End; { Case }
        EPMatch(')');
      End
      Else
      Begin
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
            EmitInstr('MOVEQ #0,D0');
          DEST_DOSR, DEST_DOSP:
            EmitInstr('XOR AX,AX');
          DEST_Z80:
            EmitInstr('LD HL,0');
          DEST_6502:
            EmitInstr('LDA #0');
          DEST_6809:
          Begin
            EmitInstr('CLRA');
            EmitInstr('CLRB');
          End;
          Else
            EmitInstr('XOR EAX,EAX');
        End;
      End;
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = ';') Then Inc(EP);
      Exit;
