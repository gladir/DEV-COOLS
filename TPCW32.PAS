{ ------------------------------------------------------------ }
{ Is68kTarget : True si la cible est Motorola 68000            }
{ ------------------------------------------------------------ }

Function Is68kTarget : Boolean;
Begin
  Is68kTarget := (Opts.DestTarget = DEST_68000) Or
                 (Opts.DestTarget = DEST_ATARIST) Or
                 (Opts.DestTarget = DEST_AMIGA);
End;

{ ------------------------------------------------------------ }
{ Is6502Target : True si la cible utilise le CPU MOS 6502      }
{ (-C6502 ou -CAPPLEII)                                        }
{ ------------------------------------------------------------ }

Function Is6502Target : Boolean;
Begin
  Is6502Target := (Opts.DestTarget = DEST_6502);
End;

{ ------------------------------------------------------------ }
{ EmitLabel : ecrire un label suivi de ':'                     }
{ ------------------------------------------------------------ }

Procedure EmitLabel(Const Lbl : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, Lbl, ':');
  If BcActive Then
  Begin
    If Opts.DestTarget = DEST_CRAY1 Then
      CrayDefineLabel(Lbl)
    Else
      BcDefineLabel(Lbl);
  End;
End;

{ ------------------------------------------------------------ }
{ EmitInstr : ecrire une instruction avec 8 espaces d indent   }
{ ------------------------------------------------------------ }

Procedure EmitInstr(Const S : TString);
Var
  BcLenBefore : LongInt;
Begin
  If OutFOpen Then
    WriteLn(OutF, '        ', S);
  If BcActive Then
  Begin
    If Opts.DestTarget = DEST_Z80 Then
      BcAssembleZ80(S)
    Else If (Opts.DestTarget = DEST_MSX) Or
            (Opts.DestTarget = DEST_TRS80) Or
            (Opts.DestTarget = DEST_ADAM) Then
      BcAssembleZ80(S)
    Else If Is6502Target Then
      BcAssemble6502(S)
    Else If Opts.DestTarget = DEST_6809 Then
      BcAssemble6809(S)
    Else If (Opts.DestTarget = DEST_68000) Or
            (Opts.DestTarget = DEST_ATARIST) Or
            (Opts.DestTarget = DEST_AMIGA) Then
      BcAssemble68000(S)
    Else If Opts.DestTarget = DEST_CRAY1 Then
      BcAssembleCray1(S)
    Else If (Opts.DestTarget = DEST_DOSR) Or
            (Opts.DestTarget = DEST_DOSP) Then
      BcAssemble8086(S)
    Else
    Begin
      BcLenBefore := BcGetCodeLen;
      BcAssemble(S);
      If Opts.DebugMode And (BcGetCodeLen = BcLenBefore) Then
        WriteLn('  [asm] instruction non assemblee : ', S);
    End;
  End;
End;

{ ------------------------------------------------------------ }
{ EmitComment : ecrire un commentaire ('; text')               }
{ ------------------------------------------------------------ }

Procedure EmitComment(Const S : TString);
Begin
  If OutFOpen Then
    WriteLn(OutF, '; ', S);
End;

{ ------------------------------------------------------------ }
{ EmitBlankLine : ecrire une ligne vide                        }
{ ------------------------------------------------------------ }

Procedure EmitBlankLine;
Begin
  If OutFOpen Then
    WriteLn(OutF);
End;

{ ------------------------------------------------------------ }
{ LabelGen : generer un label unique _TPL_NNNNN               }
{ ------------------------------------------------------------ }

Function LabelGen : TString;
Begin
  Inc(EmitLabelSeq);
  LabelGen := TP_LBL_PFX + IntToStr_(EmitLabelSeq);
End;

