    Loaded    : Boolean;    { True si le fichier TPU/QPU a ete lu     }
    IsKnown   : Boolean;    { True si c est une unite connue (Crt...) }
    IsQPU     : Boolean;    { True si c est un fichier QPU (Quick Pascal) }
  End;

