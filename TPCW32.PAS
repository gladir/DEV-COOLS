            EmitInstr('CLD');
            EmitInstr('REP STOSB');
          End;
          DEST_Z80:
          Begin
            { --- Zilog Z80 --- }
            ParseExpr(PI);      { dest dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { count dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { value dans L }
            EmitInstr('LD A,L');   { A = value }
            EmitInstr('POP BC');   { BC = count }
            EmitInstr('POP HL');   { HL = dest }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('LD E,A');   { sauvegarder value dans E }
            EmitInstr('LD A,B');
            EmitInstr('OR C');
            EmitInstr('JR Z,' + LblDone);
            EmitInstr('LD A,E');   { restaurer value }
            EmitLabel(LblLoop);
            EmitInstr('LD (HL),A');
            EmitInstr('INC HL');
            EmitInstr('DEC BC');
            EmitInstr('LD E,A');   { sauvegarder A }
            EmitInstr('LD A,B');
            EmitInstr('OR C');
            EmitInstr('LD A,E');   { restaurer A }
            EmitInstr('JR NZ,' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_6502:
          Begin
            { --- MOS 6502 --- }
            ParseExpr(PI);      { dest }
            EmitInstr('STA $00');  { zero-page ptr dest low }
            EmitInstr('STX $01');  { zero-page ptr dest high }
            EPMatch(',');
            ParseExpr(PI);      { count }
            EmitInstr('TAX');     { X = count }
            EPMatch(',');
            ParseExpr(PI);      { value dans A }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('LDY #0');
            EmitInstr('CPX #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('STA ($00),Y');
            EmitInstr('INY');
            EmitInstr('DEX');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_6809:
          Begin
            { --- Motorola 6809 --- }
            ParseExpr(PI);      { dest }
            EmitInstr('TFR D,X');  { X = dest }
            EPMatch(',');
            ParseExpr(PI);      { count }
            EmitInstr('TFR D,Y');  { Y = count }
            EPMatch(',');
            ParseExpr(PI);      { value dans B (low byte de D) }
            EmitInstr('TFR B,A');  { A = value }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('CMPY #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('STA ,X+');
            EmitInstr('LEAY -1,Y');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            ParseVarArgAddr(PI);   { dest : adresse dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { count dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { value dans EAX }
            EmitInstr('POP ECX');   { count }
            EmitInstr('POP EDI');   { dest }
            EmitInstr('CLD');
            EmitInstr('REP STOSB');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { ASSIGNED(p) -> retourne p <> nil (0 ou 1) }
    If Up = 'ASSIGNED' Then
