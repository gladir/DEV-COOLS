            EmitInstr('LD A,H');
            EmitInstr('OR L');
            EmitInstr('JR NZ,' + Lbl);
            EmitInstr('LD HL,0');
            EmitInstr('JR ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('LD HL,1');
            EmitLabel(LblDone);
          End;
          DEST_6502:
          Begin
            { --- MOS 6502 --- }
            LblDone := LabelGen;
            EmitInstr('CMP #0');
            EmitInstr('BEQ ' + LblDone);
            EmitInstr('LDA #1');
            EmitLabel(LblDone);
          End;
          DEST_6809:
          Begin
            { --- Motorola 6809 --- }
            LblDone := LabelGen;
