    { LINETO(X, Y) }
    If Up = 'LINETO' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        Case Opts.DestTarget Of
          DEST_DOSR, DEST_DOSP:
          Begin
            ParseExpr(PI);  EmitInstr('PUSH AX');   { X }
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH AX');   { Y }
          End;
          Else
          Begin
            ParseExpr(PI);  EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);  EmitInstr('PUSH EAX');
          End;
        End; { Case }
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'LINETO');
      Case Opts.DestTarget Of
