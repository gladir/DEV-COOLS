  { ------ _TPRT_TEXTMODE : changer le mode texte -------------------- }
  { Parametre : [ESP+4] = mode (CO80=3, BW80=2, etc.)                 }
  { Reset TEXTATTR, WINDMIN, WINDMAX, appelle ClrScr                  }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'TEXTMODE');
  EmitInstr('CALL ' + TP_RT_PFX + 'OFLUSH');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EAX');
  { Sauver le mode courant dans LASTMODE }
  EmitInstr('MOV EAX,DWORD PTR [LASTMODE]');
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('AND EAX,0FFh');                       { ignorer Font8x8 bit }
  EmitInstr('MOV DWORD PTR [LASTMODE],EAX');
  { Reset TEXTATTR a $07 (LightGray sur Black) }
  EmitInstr('MOV DWORD PTR [TEXTATTR],7');
  { Reset WINDMIN/WINDMAX }
  EmitInstr('MOV DWORD PTR [WINDMIN],0');
  EmitInstr('MOV DWORD PTR [WINDMAX],184Fh');      { 24*256+79 }
  { Appliquer l attribut }
  EmitInstr('PUSH 7');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL SetConsoleTextAttribute');
  { Appeler ClrScr }
  EmitInstr('CALL ' + TP_RT_PFX + 'CLRSCR');
  EmitInstr('POP EAX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_SETTEXTROWS : changer nb de lignes console (Win32) --- }
  { Parametre : [ESP+4] = rows demandees (25, 43 ou 50)                 }
  { Retour    : EAX = rows si succes, 0 si valeur non supportee         }
  { Etape 1 : reduire la fenetre a 80x25 pour autoriser le resize du    }
  {           buffer sans conflit avec la fenetre courante.             }
  { Etape 2 : redimensionner le buffer console a 80 x rows.            }
  { Etape 3 : agrandir la fenetre au nombre de lignes demande.          }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'SETTEXTROWS');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  EmitInstr('MOV EBX,DWORD PTR [EBP+8]');     { EBX = rows demandees }
  { Valider : accepter seulement 25, 43 ou 50 }
  EmitInstr('CMP EBX,25');
  EmitInstr('JE ' + TP_RT_PFX + 'SETR_OK');
  EmitInstr('CMP EBX,43');
  EmitInstr('JE ' + TP_RT_PFX + 'SETR_OK');
  EmitInstr('CMP EBX,50');
  EmitInstr('JNE ' + TP_RT_PFX + 'SETR_DN');  { valeur non supportee -> 0 }
  EmitLabel(TP_RT_PFX + 'SETR_OK');
  { Etape 1 : fenetre minimale 80x25 pour eviter conflit avec le resize }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');   { Left   = 0  }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],0');   { Top    = 0  }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],79');  { Right  = 79 }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],24');  { Bottom = 24 (25 lignes min) }
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH 1');                           { bAbsolute = TRUE }
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleWindowInfo@12');
  { Etape 2 : redimensionner le buffer a 80 x rows }
  { COORD : 80 (colonnes) dans les 16 bits bas, rows dans les 16 bits hauts }
  EmitInstr('MOV EAX,EBX');
  EmitInstr('SHL EAX,16');
  EmitInstr('OR EAX,80');                        { COORD X=80 Y=rows }
  EmitInstr('PUSH EAX');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleScreenBufferSize@8');
  { Etape 3 : agrandir la fenetre au nombre de lignes demande }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+0],0');   { Left   = 0        }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+2],0');   { Top    = 0        }
  EmitInstr('MOV WORD PTR [CRT_SCROLL+4],79');  { Right  = 79       }
  EmitInstr('MOV EAX,EBX');
  EmitInstr('DEC EAX');
  EmitInstr('MOV WORD PTR [CRT_SCROLL+6],AX');  { Bottom = rows - 1 }
  EmitInstr('PUSH OFFSET CRT_SCROLL');
  EmitInstr('PUSH 1');                           { bAbsolute = TRUE }
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleWindowInfo@12');
  EmitInstr('MOV EAX,EBX');                     { retourner rows }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'SETR_DN');
  EmitInstr('XOR EAX,EAX');                     { retourner 0 : valeur invalide }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_DISPLAYCURSOR : afficher/cacher le curseur (Win32) -- }
  { Parametre : [ESP+4] = toggle (0=cacher, autre=montrer)             }
  { Retour    : EAX = etat precedent (0=cache, -1=visible)             }
  { Utilise SetConsoleCursorInfo(HSTDOUT, &CRT_CURINFO)                }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DISPLAYCURSOR');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH EBX');
  { Lire l etat precedent depuis CRT_CURSVIS }
  EmitInstr('MOV EBX,DWORD PTR [CRT_CURSVIS]');  { EBX = etat precedent (1=visible) }
  { Calculer la valeur de retour : etat precedent -> -1 si visible, 0 si cache }
  EmitInstr('TEST EBX,EBX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DC_PREV0');
  EmitInstr('MOV EBX,-1');                       { etait visible -> -1 }
  EmitLabel(TP_RT_PFX + 'DC_PREV0');
  { EBX = valeur de retour ; maintenant appliquer le nouveau toggle }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');        { EAX = toggle demande }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DC_HIDE');
  { Montrer le curseur : CRT_CURSVIS=1, CRT_CURINFO.bVisible=1 }
  EmitInstr('MOV DWORD PTR [CRT_CURSVIS],1');
  EmitInstr('MOV DWORD PTR [CRT_CURINFO+4],1'); { bVisible = TRUE }
  EmitInstr('JMP ' + TP_RT_PFX + 'DC_CALL');
  EmitLabel(TP_RT_PFX + 'DC_HIDE');
  { Cacher le curseur : CRT_CURSVIS=0, CRT_CURINFO.bVisible=0 }
  EmitInstr('MOV DWORD PTR [CRT_CURSVIS],0');
  EmitInstr('MOV DWORD PTR [CRT_CURINFO+4],0'); { bVisible = FALSE }
  EmitLabel(TP_RT_PFX + 'DC_CALL');
  EmitInstr('PUSH OFFSET CRT_CURINFO');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _SetConsoleCursorInfo@8');
  EmitInstr('MOV EAX,EBX');                     { retourner l etat precedent }
  EmitInstr('POP EBX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_GETTEXTCURSOR : lire la forme du curseur texte (Win32) - }
  { Retour : EAX = forme curseur compatible DOS-16 bits :                  }
  {   octet haut = scanline debut (bit 5=1 si cache), octet bas = fin.     }
  { Synthese depuis CRT_CURSVIS et CRT_CURINFO via GetConsoleCursorInfo.   }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'GETTEXTCURSOR');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH OFFSET CRT_CURINFO');
  EmitInstr('PUSH DWORD PTR [HSTDOUT]');
  EmitInstr('CALL _GetConsoleCursorInfo@8');     { met a jour CRT_CURINFO   }
  { CRT_CURINFO+0 = dwSize (1..100), CRT_CURINFO+4 = bVisible (0 ou 1)    }
  EmitInstr('MOV EAX,DWORD PTR [CRT_CURINFO+4]'); { EAX = bVisible          }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'GTC_HIDE');
  { Curseur visible : forme standard DOS CH=06h, CL=07h -> AX=0607h        }
  EmitInstr('MOV EAX,0607h');
  EmitInstr('JMP ' + TP_RT_PFX + 'GTC_DONE');
  EmitLabel(TP_RT_PFX + 'GTC_HIDE');
  { Curseur cache : CH=20h (bit 5 set), CL=00h -> AX=2000h                 }
  EmitInstr('MOV EAX,2000h');
  EmitLabel(TP_RT_PFX + 'GTC_DONE');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ============================================================ }
  { TODO 19 - ROUTINES RUNTIME DOS                [IMPLEMENTE]    }
  { ============================================================ }

  { ------ _TPRT_DOSVERSION : retourne version DOS emulee ------- }
  { Retourne 7 dans EAX (emulation DOS 7.0)                       }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DOSVERSION');
  EmitInstr('MOV EAX,7');
  EmitInstr('RET');

  { ------ _TPRT_DISKFREE : espace libre sur disque ------------- }
  { Parametre : [ESP+4] = numero de lecteur (0=courant, 1=A, ...) }
  { Retourne taille en octets dans EAX                              }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DISKFREE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  { Construire la chaine de lecteur "C:\" }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DF_CUR');
  EmitInstr('ADD AL,64');       { 1->A, 2->B, ... }
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF],AL');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+1],'':''');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+2],''\''');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+3],0');
  EmitInstr('MOV ECX,OFFSET DOS_PATHBUF');
  EmitInstr('JMP ' + TP_RT_PFX + 'DF_GO');
  EmitLabel(TP_RT_PFX + 'DF_CUR');
  EmitInstr('XOR ECX,ECX');          { NULL = lecteur courant }
  EmitLabel(TP_RT_PFX + 'DF_GO');
  { GetDiskFreeSpaceA(root, &SectPerClust, &BytesPerSect, &FreeClusters, &TotClusters) }
  EmitInstr('PUSH OFFSET DOS_DKFREE+12');    { TotalClusters  }
  EmitInstr('PUSH OFFSET DOS_DKFREE+8');     { FreeClusters   }
  EmitInstr('PUSH OFFSET DOS_DKFREE+4');     { BytesPerSector }
  EmitInstr('PUSH OFFSET DOS_DKFREE+0');     { SectorsPerCluster }
  EmitInstr('PUSH ECX');                            { lpRootPathName (1er parametre) }
  EmitInstr('CALL GetDiskFreeSpaceA');        { passe root en 5e param deja PUSH }
  EmitInstr('MOV ECX,-1');                           { echec (lecteur absent) : -1 }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DF_RES');
  { Resultat = FreeClusters * SectorsPerCluster * BytesPerSector (sature a MaxLongInt) }
  EmitInstr('MOV EAX,DWORD PTR [DOS_DKFREE+8]');    { FreeClusters }
  EmitInstr('MUL DWORD PTR [DOS_DKFREE+0]');        { * SectPerClust (EDX:EAX) }
  EmitInstr('MOV ECX,7FFFFFFFh');
  EmitInstr('TEST EDX,EDX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'DF_RES');
  EmitInstr('MUL DWORD PTR [DOS_DKFREE+4]');        { * BytesPerSect }
  EmitInstr('TEST EDX,EDX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'DF_RES');
  EmitInstr('CMP EAX,7FFFFFFFh');
  EmitInstr('JA ' + TP_RT_PFX + 'DF_RES');
  EmitInstr('MOV ECX,EAX');
  EmitLabel(TP_RT_PFX + 'DF_RES');
  EmitInstr('MOV DWORD PTR [EBP-4],ECX');            { sauver resultat }
  EmitInstr('POPAD');
  EmitInstr('MOV EAX,DWORD PTR [EBP-4]');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_DISKSIZE : taille totale disque ----------------- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'DISKSIZE');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DS_CUR');
  EmitInstr('ADD AL,64');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF],AL');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+1],'':''');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+2],''\''');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF+3],0');
  EmitInstr('MOV ECX,OFFSET DOS_PATHBUF');
  EmitInstr('JMP ' + TP_RT_PFX + 'DS_GO');
  EmitLabel(TP_RT_PFX + 'DS_CUR');
  EmitInstr('XOR ECX,ECX');
  EmitLabel(TP_RT_PFX + 'DS_GO');
  EmitInstr('PUSH OFFSET DOS_DKFREE+12');
  EmitInstr('PUSH OFFSET DOS_DKFREE+8');
  EmitInstr('PUSH OFFSET DOS_DKFREE+4');
  EmitInstr('PUSH OFFSET DOS_DKFREE+0');
  EmitInstr('PUSH ECX');                            { lpRootPathName (1er parametre) }
  EmitInstr('CALL GetDiskFreeSpaceA');
  EmitInstr('MOV ECX,-1');                           { echec (lecteur absent) : -1 }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'DS_RES');
  { TotalClusters * SectorsPerCluster * BytesPerSector (sature a MaxLongInt) }
  EmitInstr('MOV EAX,DWORD PTR [DOS_DKFREE+12]');
  EmitInstr('MUL DWORD PTR [DOS_DKFREE+0]');
  EmitInstr('MOV ECX,7FFFFFFFh');
  EmitInstr('TEST EDX,EDX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'DS_RES');
  EmitInstr('MUL DWORD PTR [DOS_DKFREE+4]');
  EmitInstr('TEST EDX,EDX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'DS_RES');
  EmitInstr('CMP EAX,7FFFFFFFh');
  EmitInstr('JA ' + TP_RT_PFX + 'DS_RES');
  EmitInstr('MOV ECX,EAX');
  EmitLabel(TP_RT_PFX + 'DS_RES');
  EmitInstr('MOV DWORD PTR [EBP-4],ECX');
  EmitInstr('POPAD');
  EmitInstr('MOV EAX,DWORD PTR [EBP-4]');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_GETENV : lire variable d environnement --------- }
  { Parametre : [ESP+4] = pointeur chaine ASCIIZ du nom de variable }
  { Retourne : EAX = pointeur vers chaine resultat ASCIIZ (DOS_ENVBUF) }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'GETENV');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  { Charger le pointeur vers le nom (deja ASCIIZ) }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  { GetEnvironmentVariableA(name, buf, bufsize) }
  EmitInstr('PUSH 255');
  EmitInstr('PUSH OFFSET DOS_ENVBUF');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL GetEnvironmentVariableA');
  { EAX = nombre de caracteres copies, 0 si pas trouve }
  { DOS_ENVBUF contient le resultat ASCIIZ             }
  { Si pas trouve, mettre NUL en debut de buffer       }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'GE_OK');
  EmitInstr('MOV BYTE PTR [DOS_ENVBUF],0');
  EmitLabel(TP_RT_PFX + 'GE_OK');
  EmitInstr('LEA EAX,[DOS_ENVBUF]');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_FEXPAND : retourner chemin complet -------------- }
  { Parametre : [ESP+4] = pointeur chaine chemin ASCIIZ              }
  { Retourne : EAX = pointeur vers DOS_PATHBUF (ASCIIZ)              }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FEXPAND');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDX');
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  { GetFullPathNameA(filename, bufsize, buf, &filepart) }
  EmitInstr('PUSH 0');        { lpFilePart (NULL) }
  EmitInstr('PUSH OFFSET DOS_PATHBUF');
  EmitInstr('PUSH 259');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL GetFullPathNameA');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JNZ ' + TP_RT_PFX + 'FE_OK');
  { chemin vide ou invalide : repertoire courant suivi de '' (comme FExpand de FPC) }
  EmitInstr('PUSH OFFSET DOS_PATHBUF');
  EmitInstr('PUSH 250');
  EmitInstr('CALL GetCurrentDirectoryA');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FE_EMPTY');
  EmitInstr('CMP EAX,249');
  EmitInstr('JA ' + TP_RT_PFX + 'FE_EMPTY');
  EmitInstr('LEA EDX,[DOS_PATHBUF]');
  EmitInstr('ADD EDX,EAX');
  EmitInstr('CMP BYTE PTR [EDX-1],''\''');
  EmitInstr('JE ' + TP_RT_PFX + 'FE_OK');
  EmitInstr('MOV BYTE PTR [EDX],''\''');
  EmitInstr('MOV BYTE PTR [EDX+1],0');
  EmitInstr('JMP ' + TP_RT_PFX + 'FE_OK');
  EmitLabel(TP_RT_PFX + 'FE_EMPTY');
  EmitInstr('MOV BYTE PTR [DOS_PATHBUF],0');
  EmitLabel(TP_RT_PFX + 'FE_OK');
  EmitInstr('LEA EAX,[DOS_PATHBUF]');
  EmitInstr('POP EDX');
  EmitInstr('POP ECX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_FSEARCH : chercher fichier dans liste dirs ------ }
  { Params : [ESP+4]=name ASCIIZ, [ESP+8]=dirlist ASCIIZ             }
  { Retourne pointeur vers chemin trouve ASCIIZ ou chaine vide       }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FSEARCH');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSH ECX');
  { Essayer GetFileAttributesA sur le nom seul d abord }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL GetFileAttributesA');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'FS_NF');
  { Fichier trouve - retourner le nom tel quel }
  EmitInstr('MOV EAX,DWORD PTR [EBP+8]');
  EmitInstr('JMP ' + TP_RT_PFX + 'FS_DN');
  EmitLabel(TP_RT_PFX + 'FS_NF');
  { Non trouve - retourner chaine vide }
  EmitInstr('MOV BYTE PTR [DOS_ENVBUF],0');
  EmitInstr('LEA EAX,[DOS_ENVBUF]');
  EmitLabel(TP_RT_PFX + 'FS_DN');
  EmitInstr('POP ECX');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_FSPLIT : decomposer chemin ---------------------- }
  { Stack (pushed L-to-R) : [EBP+20]=Path, [EBP+16]=Dir,          }
  {                         [EBP+12]=Name, [EBP+8]=Ext             }
  { Toutes des chaines Pascal. Remplit Dir, Name, Ext.             }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FSPLIT');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');

  { ESI = pointeur Path (chaine Pascal : [len][chars]) }
  EmitInstr('MOV ESI,DWORD PTR [EBP+20]');
  EmitInstr('MOVZX ECX,BYTE PTR [ESI]');
  EmitInstr('TEST ECX,ECX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_EMPTY');

  { Copier les chars dans DOS_PATHBUF pour manipulation ASCIIZ }
  EmitInstr('MOV DWORD PTR [DOS_PATHBUF+260],ECX');   { sauver longueur }
  EmitInstr('PUSH ECX');
  EmitInstr('INC ESI');
  EmitInstr('LEA EDI,[DOS_PATHBUF]');
  EmitInstr('REP MOVSB');
  EmitInstr('MOV BYTE PTR [EDI],0');     { NUL terminal }
  EmitInstr('POP ECX');                   { ECX = longueur totale }

  { Chercher le dernier separateur \ / : depuis la fin }
  EmitInstr('MOV EDX,-1');                { EDX = position du sep, -1=pas trouve }
  EmitInstr('MOV EBX,ECX');
  EmitInstr('DEC EBX');
  EmitLabel(TP_RT_PFX + 'FSP_SCN');
  EmitInstr('TEST EBX,EBX');
  EmitInstr('JS ' + TP_RT_PFX + 'FSP_SDN');
  EmitInstr('LEA EAX,[DOS_PATHBUF]');
  EmitInstr('ADD EAX,EBX');
  EmitInstr('MOVZX EAX,BYTE PTR [EAX]');
  EmitInstr('CMP AL,92');                 { backslash }
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_SFD');
  EmitInstr('CMP AL,47');                 { slash }
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_SFD');
  EmitInstr('CMP AL,58');                 { colon }
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_SFD');
  EmitInstr('DEC EBX');
  EmitInstr('JMP ' + TP_RT_PFX + 'FSP_SCN');
  EmitLabel(TP_RT_PFX + 'FSP_SFD');
  EmitInstr('MOV EDX,EBX');              { EDX = position du dernier sep (0-based) }
  EmitLabel(TP_RT_PFX + 'FSP_SDN');

  { DirLen = EDX+1 si sep trouve, 0 sinon }
  EmitInstr('MOV ECX,DWORD PTR [DOS_PATHBUF+260]'); { longueur totale }
  EmitInstr('CMP EDX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_NODIR');
  EmitInstr('MOV EBX,EDX');                { EBX = position du dernier sep (0-based) }
  EmitInstr('INC EBX');                    { EBX = DirLen (incl sep) }
  EmitInstr('JMP ' + TP_RT_PFX + 'FSP_CDIR');
  EmitLabel(TP_RT_PFX + 'FSP_NODIR');
  EmitInstr('XOR EBX,EBX');              { EBX = 0, pas de dir }
  EmitLabel(TP_RT_PFX + 'FSP_CDIR');

  { Copier Dir (EBX chars depuis DOS_PATHBUF) }
  EmitInstr('MOV EDI,DWORD PTR [EBP+16]');
  EmitInstr('MOV BYTE PTR [EDI],BL');
  EmitInstr('TEST EBX,EBX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_DD');
  EmitInstr('PUSH ECX');
  EmitInstr('MOV ECX,EBX');
  EmitInstr('INC EDI');
  EmitInstr('LEA ESI,[DOS_PATHBUF]');
  EmitInstr('REP MOVSB');
  EmitInstr('POP ECX');
  EmitLabel(TP_RT_PFX + 'FSP_DD');

  { Reste = filename part : ECX-EBX chars a partir de DOS_PATHBUF+EBX }
  EmitInstr('SUB ECX,EBX');               { ECX = restLen }

  { Chercher le dernier point dans le reste }
  EmitInstr('MOV EDX,-1');                { position du point, -1=pas trouve }
  EmitInstr('TEST ECX,ECX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_NDP');
  EmitInstr('PUSH ECX');
  EmitInstr('DEC ECX');
  EmitLabel(TP_RT_PFX + 'FSP_DSC');
  EmitInstr('TEST ECX,ECX');
  EmitInstr('JS ' + TP_RT_PFX + 'FSP_DNF');
  EmitInstr('LEA EAX,[DOS_PATHBUF]');
  EmitInstr('ADD EAX,EBX');
  EmitInstr('ADD EAX,ECX');
  EmitInstr('MOVZX EAX,BYTE PTR [EAX]');
  EmitInstr('CMP AL,46');                 { point }
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_DFD');
  EmitInstr('DEC ECX');
  EmitInstr('JMP ' + TP_RT_PFX + 'FSP_DSC');
  EmitLabel(TP_RT_PFX + 'FSP_DFD');
  EmitInstr('MOV EDX,ECX');              { EDX = position du point dans le reste }
  EmitLabel(TP_RT_PFX + 'FSP_DNF');
  EmitInstr('POP ECX');                   { ECX = restLen }
  EmitLabel(TP_RT_PFX + 'FSP_NDP');

  { Si point trouve : Name = reste[0..EDX-1], Ext = reste[EDX..end] }
  { Si pas de point  : Name = tout le reste, Ext = '' }
  EmitInstr('CMP EDX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'FSP_ALLNM');
  { Name = EDX chars }
  EmitInstr('MOV EDI,DWORD PTR [EBP+12]');
  EmitInstr('MOV BYTE PTR [EDI],DL');     { Name length }
  EmitInstr('TEST EDX,EDX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_ND');
  EmitInstr('PUSH ECX');
  EmitInstr('MOV ECX,EDX');
  EmitInstr('INC EDI');
  EmitInstr('LEA ESI,[DOS_PATHBUF]');
  EmitInstr('ADD ESI,EBX');
  EmitInstr('REP MOVSB');
  EmitInstr('POP ECX');
  EmitLabel(TP_RT_PFX + 'FSP_ND');
  { Ext = ECX-EDX chars }
  EmitInstr('MOV EAX,ECX');
  EmitInstr('SUB EAX,EDX');
  EmitInstr('MOV EDI,DWORD PTR [EBP+8]');
  EmitInstr('MOV BYTE PTR [EDI],AL');     { Ext length }
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_ED');
  EmitInstr('MOV ECX,EAX');
  EmitInstr('INC EDI');
  EmitInstr('LEA ESI,[DOS_PATHBUF]');
  EmitInstr('ADD ESI,EBX');
  EmitInstr('ADD ESI,EDX');
  EmitInstr('REP MOVSB');
  EmitLabel(TP_RT_PFX + 'FSP_ED');
  EmitInstr('JMP ' + TP_RT_PFX + 'FSP_RET');

  { Pas de point : Name = tout le reste }
  EmitLabel(TP_RT_PFX + 'FSP_ALLNM');
  EmitInstr('MOV EDI,DWORD PTR [EBP+12]');
  EmitInstr('MOV BYTE PTR [EDI],CL');     { Name length = restLen }
  EmitInstr('TEST ECX,ECX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FSP_AN');
  EmitInstr('INC EDI');
  EmitInstr('LEA ESI,[DOS_PATHBUF]');
  EmitInstr('ADD ESI,EBX');
  EmitInstr('REP MOVSB');
  EmitLabel(TP_RT_PFX + 'FSP_AN');
  { Ext = '' }
  EmitInstr('MOV EDI,DWORD PTR [EBP+8]');
  EmitInstr('MOV BYTE PTR [EDI],0');
  EmitInstr('JMP ' + TP_RT_PFX + 'FSP_RET');

  { Chemin vide : Dir='', Name='', Ext='' }
  EmitLabel(TP_RT_PFX + 'FSP_EMPTY');
  EmitInstr('MOV EDI,DWORD PTR [EBP+16]');
  EmitInstr('MOV BYTE PTR [EDI],0');
  EmitInstr('MOV EDI,DWORD PTR [EBP+12]');
  EmitInstr('MOV BYTE PTR [EDI],0');
  EmitInstr('MOV EDI,DWORD PTR [EBP+8]');
  EmitInstr('MOV BYTE PTR [EDI],0');
  EmitLabel(TP_RT_PFX + 'FSP_RET');
  { terminateurs NUL (vue ASCIIZ des chaines Pascal) }
  EmitInstr('MOV EDI,DWORD PTR [EBP+16]');
  EmitInstr('CALL ' + TP_RT_PFX + 'STRNUL');
  EmitInstr('MOV EDI,DWORD PTR [EBP+12]');
  EmitInstr('CALL ' + TP_RT_PFX + 'STRNUL');
  EmitInstr('MOV EDI,DWORD PTR [EBP+8]');
  EmitInstr('CALL ' + TP_RT_PFX + 'STRNUL');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_STRNUL : EDI = chaine Pascal -> ecrit le NUL apres les caracteres ---- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'STRNUL');
  EmitInstr('PUSH ECX');
  EmitInstr('PUSH EDI');
  EmitInstr('MOVZX ECX,BYTE PTR [EDI]');
  EmitInstr('ADD EDI,ECX');
  EmitInstr('MOV BYTE PTR [EDI+1],0');
  EmitInstr('POP EDI');
  EmitInstr('POP ECX');
  EmitInstr('RET');

  { ------ _TPRT_FCHKOPEN : EBX = enregistrement fichier ; fichier ferme -> erreur 103 ---- }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FCHKOPEN');
  EmitInstr('CMP DWORD PTR [EBX+' + IntToStr_(TFR_MODE) + '],0');
  EmitInstr('JNE ' + TP_RT_PFX + 'FCO_OK');
  EmitInstr('CMP DWORD PTR [FILE_IOERR],0');      { une erreur en attente (Reset sous $I-) est conservee }
  EmitInstr('JNE ' + TP_RT_PFX + 'FCO_OK');
  EmitInstr('MOV DWORD PTR [FILE_IOERR],103');
  EmitLabel(TP_RT_PFX + 'FCO_OK');
  EmitInstr('RET');

  { ------ _TPRT_FINDFIRST : FindFirst(Path, Attr, SR) ---------- }
  { Stack (pushed L-to-R) : [EBP+16]=Path, [EBP+12]=Attr, [EBP+8]=SR }
  { DosError mis a 0 si OK, 18 si pas trouve                        }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FINDFIRST');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  { FindFirstFileA(path, &finddata) }
  EmitInstr('MOV EAX,DWORD PTR [EBP+16]');  { Path (ASCIIZ, first pushed) }
  EmitInstr('PUSH OFFSET DOS_FINDDATA');
  EmitInstr('PUSH EAX');
  EmitInstr('CALL FindFirstFileA');
  EmitInstr('MOV DWORD PTR [DOS_FINDHDL],EAX');
  EmitInstr('CMP EAX,-1');
  EmitInstr('JE ' + TP_RT_PFX + 'FF_NF');
  EmitInstr('MOV EAX,DWORD PTR [EBP+12]');  { Attr demandes }
  EmitInstr('MOV DWORD PTR [DOS_FINDATTR],EAX');
  { Entrees '.' et '..' et attributs non demandes (cache, systeme, repertoire) : passer }
  EmitLabel(TP_RT_PFX + 'FF_CHK');
  EmitInstr('CALL ' + TP_RT_PFX + 'FF_WANT');
  EmitInstr('JNZ ' + TP_RT_PFX + 'FF_FILL');
  EmitInstr('PUSH OFFSET DOS_FINDDATA');
  EmitInstr('PUSH DWORD PTR [DOS_FINDHDL]');
  EmitInstr('CALL FindNextFileA');
  EmitInstr('TEST EAX,EAX');
  EmitInstr('JZ ' + TP_RT_PFX + 'FF_NF');
  EmitInstr('JMP ' + TP_RT_PFX + 'FF_CHK');
  EmitLabel(TP_RT_PFX + 'FF_FILL');
  { Succes : remplir SearchRec = (Attr:Word, Time:LongInt, Size:LongInt, Name:String) }
  EmitInstr('MOV EDI,DWORD PTR [EBP+8]');   { SearchRec addr (last pushed) }
  { Attr = dwFileAttributes (offset 0 dans WIN32_FIND_DATA) }
  EmitInstr('MOV EAX,DWORD PTR [DOS_FINDDATA]');
  EmitInstr('MOV WORD PTR [EDI],AX');        { SR.Attr }
  { Time = ftLastWriteTime.dwLowDateTime (stub: 0) }
  EmitInstr('CALL ' + TP_RT_PFX + 'FF_TIME');  { SR.Time = date/heure DOS }
  { Size = nFileSizeLow (offset 32) }
  EmitInstr('MOV EAX,DWORD PTR [DOS_FINDDATA+32]');
  EmitInstr('MOV DWORD PTR [EDI+8],EAX');   { SR.Size }
  { Name = cFileName (offset 44, ASCIIZ -> Pascal string) }
  EmitInstr('LEA ESI,[DOS_FINDDATA+44]');
  EmitInstr('LEA EDI,[EDI+12]');             { SR.Name }
  EmitInstr('PUSH EDI');
  EmitInstr('INC EDI');                       { sauter octet longueur }
  EmitInstr('XOR ECX,ECX');
  EmitLabel(TP_RT_PFX + 'FF_CP');
  EmitInstr('LODSB');
  EmitInstr('TEST AL,AL');
  EmitInstr('JZ ' + TP_RT_PFX + 'FF_CE');
  EmitInstr('STOSB');
  EmitInstr('INC ECX');
  EmitInstr('CMP ECX,255');
  EmitInstr('JB ' + TP_RT_PFX + 'FF_CP');
  EmitLabel(TP_RT_PFX + 'FF_CE');
  EmitInstr('MOV BYTE PTR [EDI],0');        { terminateur NUL }
  EmitInstr('POP EDI');
  EmitInstr('MOV BYTE PTR [EDI],CL');       { longueur Pascal }
  EmitInstr('MOV DWORD PTR [DOSERROR],0');
  EmitInstr('JMP ' + TP_RT_PFX + 'FF_DN');
  EmitLabel(TP_RT_PFX + 'FF_NF');
  EmitInstr('MOV DWORD PTR [DOSERROR],18'); { 18 = pas de fichier }
  EmitLabel(TP_RT_PFX + 'FF_DN');
  EmitInstr('POPAD');
  EmitInstr('POP EBP');
  EmitInstr('RET');

  { ------ _TPRT_FF_TIME : [EDI+4] = date/heure DOS (format TP) de ftLastWriteTime ------ }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FF_TIME');
  EmitInstr('PUSH OFFSET DOS_FTTMP');          { FILETIME locale }
  EmitInstr('PUSH OFFSET DOS_FINDDATA+20');    { ftLastWriteTime }
  EmitInstr('CALL FileTimeToLocalFileTime');
  EmitInstr('PUSH OFFSET DOS_FTTMP+10');       { heure DOS }
  EmitInstr('PUSH OFFSET DOS_FTTMP+8');        { date DOS }
  EmitInstr('PUSH OFFSET DOS_FTTMP');
  EmitInstr('CALL FileTimeToDosDateTime');
  EmitInstr('MOV EAX,DWORD PTR [DOS_FTTMP+8]'); { date dans le mot haut, heure dans le mot bas }
  EmitInstr('ROL EAX,16');
  EmitInstr('MOV DWORD PTR [EDI+4],EAX');
  EmitInstr('RET');

  { ------ _TPRT_FF_WANT : l entree de DOS_FINDDATA est-elle retenue ? ------ }
  { Sortie : ZF=0 (JNZ) si retenue ; ZF=1 si '.' / '..' ou attribut non demande }
  { (cache 2, systeme 4, repertoire 16 absents de DOS_FINDATTR)                 }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FF_WANT');
  EmitInstr('MOV AL,BYTE PTR [DOS_FINDDATA+44]');
  EmitInstr('CMP AL,''.''');
  EmitInstr('JNE ' + TP_RT_PFX + 'FFW_AT');
  EmitInstr('MOV AL,BYTE PTR [DOS_FINDDATA+45]');
  EmitInstr('TEST AL,AL');
  EmitInstr('JZ ' + TP_RT_PFX + 'FFW_NO');
  EmitInstr('CMP AL,''.''');
  EmitInstr('JNE ' + TP_RT_PFX + 'FFW_AT');
  EmitInstr('MOV AL,BYTE PTR [DOS_FINDDATA+46]');
  EmitInstr('TEST AL,AL');
  EmitInstr('JZ ' + TP_RT_PFX + 'FFW_NO');
  EmitLabel(TP_RT_PFX + 'FFW_AT');
  EmitInstr('MOV EAX,DWORD PTR [DOS_FINDDATA]');
  EmitInstr('AND EAX,16h');                 { cache, systeme, repertoire }
  EmitInstr('MOV ECX,DWORD PTR [DOS_FINDATTR]');
  EmitInstr('NOT ECX');
  EmitInstr('AND EAX,ECX');                 { attributs presents mais non demandes }
  EmitInstr('JNZ ' + TP_RT_PFX + 'FFW_NO');
  EmitInstr('MOV EAX,1');
  EmitInstr('TEST EAX,EAX');                { ZF=0 : retenue }
  EmitInstr('RET');
  EmitLabel(TP_RT_PFX + 'FFW_NO');
  EmitInstr('XOR EAX,EAX');                 { ZF=1 : passer }
  EmitInstr('RET');

  { ------ _TPRT_FINDNEXT : FindNext(SR) ------------------------ }
  { Parametre : [ESP+4] = SearchRec address                         }
  EmitBlankLine;
  EmitLabel(TP_RT_PFX + 'FINDNEXT');
  EmitInstr('PUSH EBP');
  EmitInstr('MOV EBP,ESP');
  EmitInstr('PUSHAD');
  { FindNextFileA(handle, &finddata) }
