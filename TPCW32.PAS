  EmitLabel(TP_RT_PFX + 'RS_S1');
  EmitInstr('MOV AL,BYTE PTR [EDI]');
  EmitInstr('TEST AL,AL');
  EmitInstr('JZ ' + TP_RT_PFX + 'RS_PAD');
  EmitInstr('CMP AL,''E''');
  EmitInstr('JE ' + TP_RT_PFX + 'RS_S2');
