{ ParseFuncCall : parser un appel de procedure/fonction         }
{ nom(arg1, arg2, ...) -> PUSH args, CALL _TPF_nom             }
{ Convention stdcall : args gauche-a-droite                     }
{ ------------------------------------------------------------ }

Procedure ParseFuncCall(PI : Integer; Const ProcName : TString);
Var
  ArgCount  : Integer;
  Up        : TString;
  SI        : Integer;
  MName     : TString;
  CalledPI  : Integer;
  J         : Integer;
  IsVarArg  : Boolean;
  ArgName   : TString;
Begin
  Up := StrUpperCase(ProcName);
  ArgCount := 0;

  { Trouver le symbole de la procedure/fonction }
  SI := SymFind(Up);
  If SI >= 0 Then
    MName := SymTab[SI].MangledName
  Else
    MName := TP_FUNC_PFX + Up;

  { Trouver l index dans ProcTab pour connaitre les params VAR }
  CalledPI := -1;
  For J := 0 To ProcCount - 1 Do
    If ProcTab[J].Name = Up Then
    Begin
      CalledPI := J;
      Break;
    End;

  { Consommer '(' si present }
  If EPMatch('(') Then
  Begin
    { Compter et compiler les arguments }
    If Not EPMatch(')') Then
    Begin
      Repeat
        { Determiner si le parametre courant est VAR }
        IsVarArg := False;
        If (CalledPI >= 0) And (ArgCount < ProcTab[CalledPI].ParamCount) Then
          IsVarArg := ProcTab[CalledPI].Params[ArgCount].IsVar;

        If IsVarArg Then
        Begin
          { Parametre VAR : pousser l adresse de la variable }
          If (Not EPAtEnd) And
             ((TokenPool[EP].Kind = TK_IDENT) Or
              (TokenPool[EP].Kind = TK_KEYWORD)) Then
          Begin
            ArgName := TokenPool[EP].Val;
            Inc(EP);
            GenLoadAddr(PI, ArgName);
            EmitInstr('PUSH EAX');
          End
          Else
          Begin
            { Fallback : evaluer et pousser (pas ideal pour VAR) }
            ParseExpr(PI);
            EmitInstr('PUSH EAX');
          End;
        End
        Else
        Begin
          { Parametre normal : evaluer et pousser la valeur }
          ParseExpr(PI);
          EmitInstr('PUSH EAX');
        End;
        Inc(ArgCount);
      Until Not EPMatch(',');
      If Not EPMatch(')') Then
        Inc(EP); { sauter le ')' manquant }
    End;
  End;

  EmitInstr('CALL ' + MName);

  { Nettoyer la pile (convention cdecl/stdcall-like pour nos procs Pascal) }
  If ArgCount > 0 Then
    EmitInstr('ADD ESP,' + IntToStr_(ArgCount * 4));
End;

{ ------------------------------------------------------------ }
{ ParsePrimary : parser une expression primaire                 }
{ Resultat dans EAX                                             }
{ ------------------------------------------------------------ }

Procedure ParsePrimary(PI : Integer);
Var
  Up     : TString;
  Lbl    : TString;
  SI     : Integer;
  LI     : Integer;
  ParI   : Integer;
  WI     : Integer;
  WFOfs  : Integer;
  WFSize : Integer;
  WJ     : Integer;
  LblDone : TString;
  LblLoop : TString;
Begin
  LastPrimaryName := '';
  LastVarTypeIdx := -1;
  LastExprIsPascalStr := False;

  If EPAtEnd Then Exit;

  { Litteral entier }
  If TokenPool[EP].Kind = TK_INTEGER Then
  Begin
    If Is68kTarget Then
      EmitInstr('MOVE.L #' + IntToStr_(TokenPool[EP].IntVal) + ',D0')
    Else If Opts.DestTarget = DEST_CRAY1 Then
      EmitInstr('LDIMM S1,' + IntToStr_(TokenPool[EP].IntVal))
    Else
      EmitInstr('MOV EAX,' + IntToStr_(TokenPool[EP].IntVal));
    Inc(EP);
    Exit;
  End;

  { Litteral caractere }
  If TokenPool[EP].Kind = TK_CHAR Then
  Begin
    If Is68kTarget Then
      EmitInstr('MOVE.L #' + IntToStr_(TokenPool[EP].IntVal) + ',D0')
    Else If Opts.DestTarget = DEST_CRAY1 Then
      EmitInstr('LDIMM S1,' + IntToStr_(TokenPool[EP].IntVal))
    Else
      EmitInstr('MOV EAX,' + IntToStr_(TokenPool[EP].IntVal));
    Inc(EP);
    Exit;
  End;

  { Litteral chaine }
  If TokenPool[EP].Kind = TK_STRING Then
  Begin
    Lbl := DataGetOrAddStr(TokenPool[EP].Val);
    If Is68kTarget Then
      EmitInstr('LEA ' + Lbl + ',A0')
    Else
      EmitInstr('LEA EAX,[' + Lbl + ']');
    LastVarTypeIdx := TY_IDX_STRING;
    LastExprIsPascalStr := False;  { literal ASCIIZ, pas format Pascal }
    Inc(EP);
    Exit;
  End;

  { Mot-cle ou identificateur }
  If (TokenPool[EP].Kind = TK_KEYWORD) Or
     (TokenPool[EP].Kind = TK_IDENT) Then
  Begin
    Up := StrUpperCase(TokenPool[EP].Val);

    { TRUE / FALSE }
    If Up = 'TRUE' Then
    Begin
      EmitInstr('MOV EAX,1');
      Inc(EP);
      Exit;
    End;
    If Up = 'FALSE' Then
    Begin
      EmitInstr('XOR EAX,EAX');
      Inc(EP);
      Exit;
    End;

    { NIL }
    If Up = 'NIL' Then
    Begin
      EmitInstr('XOR EAX,EAX');
      Inc(EP);
      Exit;
    End;

    { Typecast : TypeName(expr) -> evaluer expr, resultat dans EAX }
    If ((Up = 'INTEGER') Or (Up = 'LONGINT') Or (Up = 'WORD') Or
        (Up = 'BYTE') Or (Up = 'SHORTINT') Or (Up = 'CHAR') Or
        (Up = 'BOOLEAN') Or (Up = 'POINTER') Or (Up = 'PCHAR') Or
        (Up = 'REAL') Or (Up = 'SINGLE') Or (Up = 'DOUBLE') Or
        (Up = 'LONGWORD') Or (Up = 'COMP')) And
       (EP + 1 < EPEnd) And
       (TokenPool[EP + 1].Kind = TK_PUNCT) And
       (TokenPool[EP + 1].Val = '(') Then
    Begin
      Inc(EP);  { sauter le nom de type }
      Inc(EP);  { sauter '(' }
      ParseExpr(PI);
      EPMatch(')');
      { Masquer selon la taille du type cible }
      If (Up = 'BYTE') Or (Up = 'SHORTINT') Or (Up = 'CHAR') Or
         (Up = 'BOOLEAN') Then
        EmitInstr('AND EAX,0FFh')
      Else If Up = 'WORD' Then
        EmitInstr('AND EAX,0FFFFh');
      Exit;
    End;

    { SIZEOF(T) / SIZEOF(V) }
    If Up = 'SIZEOF' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Up := StrUpperCase(TokenPool[EP].Val);
          SI := TypeFindByName(Up);
          If SI >= 0 Then
            EmitInstr('MOV EAX,' + IntToStr_(TypeSizeofIdx(SI)))
          Else
          Begin
            { Chercher comme variable }
            LI := FindLocal(PI, Up);
            If LI >= 0 Then
              EmitInstr('MOV EAX,' + IntToStr_(ProcTab[PI].Locals[LI].Size))
            Else
            Begin
              SI := SymFind(Up);
              If (SI >= 0) And (SymTab[SI].TypeIdx >= 0) Then
                EmitInstr('MOV EAX,' + IntToStr_(TypeSizeofIdx(SymTab[SI].TypeIdx)))
              Else
                EmitInstr('MOV EAX,4');
            End;
          End;
          Inc(EP);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { ORD(x) -> resultat dans EAX (valeur ordinale) }
    If Up = 'ORD' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        { EAX contient deja la valeur ordinale }
        EmitInstr('AND EAX,0FFh');
        EPMatch(')');
      End;
      Exit;
    End;

    { CHR(x) -> resultat dans EAX (caractere) }
    If Up = 'CHR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('AND EAX,0FFh');
        EPMatch(')');
      End;
      Exit;
    End;

    { SUCC(x) -> x + 1 }
    If Up = 'SUCC' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('INC EAX');
        EPMatch(')');
      End;
      Exit;
    End;

    { PRED(x) -> x - 1 }
    If Up = 'PRED' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('DEC EAX');
        EPMatch(')');
      End;
      Exit;
    End;

    { LO(x) -> octet bas }
    If Up = 'LO' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('AND EAX,0FFh');
        EPMatch(')');
      End;
      Exit;
    End;

    { HI(x) -> octet haut }
    If Up = 'HI' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('SHR EAX,8');
        EmitInstr('AND EAX,0FFh');
        EPMatch(')');
      End;
      Exit;
    End;

    { ABS(x) -> valeur absolue }
    If Up = 'ABS' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CDQ');
        EmitInstr('XOR EAX,EDX');
        EmitInstr('SUB EAX,EDX');
        EPMatch(')');
      End;
      Exit;
    End;

    { SQR(x) -> x * x }
    If Up = 'SQR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('IMUL EAX,EAX');
        EPMatch(')');
      End;
      Exit;
    End;

    { ODD(x) -> x AND 1 }
    If Up = 'ODD' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('AND EAX,1');
        EPMatch(')');
      End;
      Exit;
    End;

    { SWAP(x) -> echanger octets bas et haut du word }
    If Up = 'SWAP' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('XCHG AL,AH');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- Fonctions math/trig : stubs en mode entier, FPU a venir --- }

    { SQRT(x) -> racine carree via FPU }
    If Up = 'SQRT' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SQRT');
        EPMatch(')');
      End;
      Exit;
    End;

    { SIN(x) -> sinus via FPU }
    If Up = 'SIN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SIN');
        EPMatch(')');
      End;
      Exit;
    End;

    { COS(x) -> cosinus via FPU }
    If Up = 'COS' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'COS');
        EPMatch(')');
      End;
      Exit;
    End;

    { ARCTAN(x) -> arc tangente via FPU }
    If Up = 'ARCTAN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'ARCTAN');
        EPMatch(')');
      End;
      Exit;
    End;

    { EXP(x) -> exponentielle via FPU }
    If Up = 'EXP' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'EXP');
        EPMatch(')');
      End;
      Exit;
    End;

    { LN(x) -> logarithme neperien via FPU }
    If Up = 'LN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'LN');
        EPMatch(')');
      End;
      Exit;
    End;

    { ATAN(x) -> arc tangente (TRANSCEND unit, Apple Pascal) }
    If Opts.ApplePascal And Not Opts.Sane Then
    If Up = 'ATAN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'ARCTAN');
        EPMatch(')');
      End;
      Exit;
    End;

    { LOG(x) -> logarithme base 10 (TRANSCEND unit, Apple Pascal) }
    If Opts.ApplePascal And Not Opts.Sane Then
    If Up = 'LOG' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_LOG10');
        EPMatch(')');
      End;
      Exit;
    End;

    { PWROFTEN(n) -> 10^n (TRANSCEND unit, Apple Pascal) }
    If Opts.ApplePascal And Not Opts.Sane Then
    If Up = 'PWROFTEN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_PWROFTEN');
        EPMatch(')');
      End;
      Exit;
    End;

    { FRAC(x) -> partie fractionnaire (stub: retourne 0 en mode entier) }
    If Up = 'FRAC' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitComment('FRAC() stub: retourne 0 en mode entier');
        EmitInstr('XOR EAX,EAX');
        EPMatch(')');
      End;
      Exit;
    End;

    { INT(x) -> partie entiere (en mode entier: identite) }
    If Up = 'INT' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        { En mode entier, Int(x) = x }
        EPMatch(')');
      End;
      Exit;
    End;

    { RANDOM / RANDOM(max) -> nombre aleatoire }
    If Up = 'RANDOM' Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '(') Then
      Begin
        Inc(EP);  { ( }
        ParseExpr(PI);  { max dans EAX }
        EPMatch(')');
        EmitInstr('PUSH EAX');    { sauver max }
        EmitInstr('CALL ' + TP_RT_PFX + 'RANDOM');
        EmitInstr('POP ECX');     { recuperer max }
        EmitInstr('XOR EDX,EDX');
        EmitInstr('DIV ECX');     { EAX / max }
        EmitInstr('MOV EAX,EDX');  { reste = resultat }
      End
      Else
      Begin
        { Random sans argument -> Random(MaxInt) }
        EmitInstr('CALL ' + TP_RT_PFX + 'RANDOM');
      End;
      Exit;
    End;

    { ROUND(x) / TRUNC(x) -> stub : juste retourner la valeur }
    If (Up = 'ROUND') Or (Up = 'TRUNC') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE identity functions (single arg, result = arg) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'NUM2INTEGER') Or (Up = 'NUM2LONGINT') Or (Up = 'NUM2REAL') Or
       (Up = 'NUM2DOUBLE') Or (Up = 'NUM2EXTENDED') Or (Up = 'NUM2COMP') Or
       (Up = 'RINT') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE stub functions returning 0 (single arg, discarded) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'DEC2NUM') Or (Up = 'LN1') Or (Up = 'NAN') Or
       (Up = 'TESTEXCEPTION') Or (Up = 'TESTHALT') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      EmitInstr('XOR EAX,EAX');
      Exit;
    End;

    { --- SANE stub functions returning 0 (no args) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'GETROUND') Or (Up = 'GETPRECISION') Or
       (Up = 'GETHALTVECTOR') Then
    Begin
      Inc(EP);
      EmitInstr('XOR EAX,EAX');
      Exit;
    End;

    { --- SANE STR2NUM(s) : string to number --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'STR2NUM' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('MOV ESI,EAX');
        EmitInstr('CALL ' + TP_RT_PFX + 'STRTONUM');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE LOGB(x) / LOG2(x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'LOGB') Or (Up = 'LOG2') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_LOG2');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE EXP2(x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'EXP2' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_EXP2');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE EXP1(x) : stub identity (e^x-1 ~ x for integers) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'EXP1' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE TAN(x) : stub returns 0 --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'TAN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitComment('SANE TAN stub : retourne 0 en mode entier');
        EmitInstr('XOR EAX,EAX');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE SIGNNUM(x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'SIGNNUM' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_SIGNNUM');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE CLASSxxx(x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'CLASSREAL') Or (Up = 'CLASSDOUBLE') Or
       (Up = 'CLASSCOMP') Or (Up = 'CLASSEXTENDED') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('CALL ' + TP_RT_PFX + 'SANE_CLASSNUM');
        EPMatch(')');
      End;
      Exit;
    End;

    { --- SANE COPYSIGN(x,y) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'COPYSIGN' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_COPYSIGN');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE NEXTxxx(x,y) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'NEXTREAL') Or (Up = 'NEXTDOUBLE') Or
       (Up = 'NEXTEXTENDED') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_NEXTNUM');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE XPWRI(x,i) / XPWRY(x,y) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If (Up = 'XPWRI') Or (Up = 'XPWRY') Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_XPWRI');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE COMPOUND(r,n) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'COMPOUND' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_COMPOUND');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE ANNUITY(r,n) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'ANNUITY' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_ANNUITY');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE RELATION(x,y) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'RELATION' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_RELATION');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE SCALB(n,x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'SCALB' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_SCALB');
      EmitInstr('ADD ESP,8');
      Exit;
    End;

    { --- SANE REMAINDER(x,y,Var Quo) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'REMAINDER' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        ParseExpr(PI);
        EmitInstr('PUSH EAX');
        EPMatch(',');
        { Quo is a VAR param - push address }
        If Not EPAtEnd Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          EmitInstr('PUSH EAX');
          Inc(EP);
        End;
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_REMAINDER');
      EmitInstr('ADD ESP,12');
      Exit;
    End;

    { --- SANE RANDOMX(Var x) --- }
    If Opts.ApplePascal Or Opts.Sane Then
    If Up = 'RANDOMX' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        { x is a VAR param - push address }
        If Not EPAtEnd Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          EmitInstr('PUSH EAX');
          Inc(EP);
        End;
        EPMatch(')');
      End;
      EmitInstr('CALL ' + TP_RT_PFX + 'SANE_RANDOMX');
      EmitInstr('ADD ESP,4');
      Exit;
    End;

    { EOF / EOF(f) : tester fin de fichier }
    If Up = 'EOF' Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '(') Then
      Begin
        Inc(EP);  { consommer ( }
        If Not EPAtEnd Then
        Begin
          Up := StrUpperCase(TokenPool[EP].Val);
          If Up = 'INPUT' Then
          Begin
            { EOF(Input) = EOF stdin }
            Inc(EP);
            EmitInstr('MOV EAX,DWORD PTR [STDIN_EOF]');
          End
          Else
          Begin
            { EOF(f) : f est une variable Text }
            GenLoadAddr(PI, TokenPool[EP].Val);
            Inc(EP);
            EmitInstr('PUSH EAX');
            EmitInstr('CALL ' + TP_RT_PFX + 'EOF_FILE');
            EmitInstr('ADD ESP,4');
          End;
        End;
        EPMatch(')');
      End
      Else
      Begin
        { EOF sans argument = EOF(Input) }
        EmitInstr('MOV EAX,DWORD PTR [STDIN_EOF]');
      End;
      Exit;
    End;

    { EOLN / EOLN(f) : tester si le caractere courant est CR/LF }
    If Up = 'EOLN' Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '(') Then
      Begin
        Inc(EP);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          Inc(EP);
          EmitInstr('PUSH EAX');
          EmitInstr('CALL ' + TP_RT_PFX + 'EOLN_FILE');
          EmitInstr('ADD ESP,4');
        End
        Else
        Begin
          { EOLN(Input) ou pas d argument avec parenthese }
          If Not EPAtEnd Then Inc(EP);
          EmitInstr('CALL ' + TP_RT_PFX + 'EOLN_STDIN');
        End;
        EPMatch(')');
      End
      Else
      Begin
        { EOLN sans argument = EOLN(Input) }
        EmitInstr('CALL ' + TP_RT_PFX + 'EOLN_STDIN');
      End;
      Exit;
    End;

    { SEEKEOF / SEEKEOF(f) : sauter blancs/tabs puis tester EOF }
    If Up = 'SEEKEOF' Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '(') Then
      Begin
        Inc(EP);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          Inc(EP);
          EmitInstr('PUSH EAX');
          EmitInstr('CALL ' + TP_RT_PFX + 'SEEKEOF_FILE');
          EmitInstr('ADD ESP,4');
        End
        Else
        Begin
          If Not EPAtEnd Then Inc(EP);
          EmitInstr('MOV EAX,DWORD PTR [STDIN_EOF]');
        End;
        EPMatch(')');
      End
      Else
      Begin
        EmitInstr('MOV EAX,DWORD PTR [STDIN_EOF]');
      End;
      Exit;
    End;

    { SEEKEOLN / SEEKEOLN(f) : sauter blancs/tabs puis tester EOL }
    If Up = 'SEEKEOLN' Then
    Begin
      Inc(EP);
      If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
         (TokenPool[EP].Val = '(') Then
      Begin
        Inc(EP);
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          Inc(EP);
          EmitInstr('PUSH EAX');
          EmitInstr('CALL ' + TP_RT_PFX + 'SEEKEOLN_FILE');
          EmitInstr('ADD ESP,4');
        End
        Else
        Begin
          If Not EPAtEnd Then Inc(EP);
          EmitInstr('XOR EAX,EAX');
        End;
        EPMatch(')');
      End
      Else
      Begin
        EmitInstr('XOR EAX,EAX');
      End;
      Exit;
    End;

    { IORESULT : retourne et remet a zero la derniere erreur I/O }
    If Up = 'IORESULT' Then
    Begin
      Inc(EP);
      EmitInstr('MOV EAX,DWORD PTR [FILE_IOERR]');
      EmitInstr('MOV DWORD PTR [FILE_IOERR],0');
      Exit;
    End;

    { FILEPOS(f) : retourne la position courante dans un fichier }
    If Up = 'FILEPOS' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          Inc(EP);
        End;
        EmitInstr('MOV EAX,DWORD PTR [EAX]');  { handle fichier }
        EPMatch(')');
      End;
      { SetFilePointer(handle, 0, NULL, FILE_CURRENT=1) -> retourne position }
      EmitInstr('PUSH 1');            { dwMoveMethod = FILE_CURRENT }
      EmitInstr('PUSH 0');            { lpDistanceToMoveHigh       }
      EmitInstr('PUSH 0');            { lDistanceToMove = 0        }
      EmitInstr('PUSH EAX');          { hFile                      }
      EmitInstr('CALL SetFilePointer');
      { EAX = position courante }
      Exit;
    End;

    { FILESIZE(f) : retourne la taille du fichier }
    If Up = 'FILESIZE' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_IDENT) Then
        Begin
          GenLoadAddr(PI, TokenPool[EP].Val);
          Inc(EP);
        End;
        EmitInstr('MOV EAX,DWORD PTR [EAX]');  { handle fichier }
        EPMatch(')');
      End;
      { GetFileSize(handle, NULL) -> retourne taille }
      EmitInstr('PUSH 0');            { lpFileSizeHigh }
      EmitInstr('PUSH EAX');          { hFile          }
      EmitInstr('CALL GetFileSize');
      { EAX = taille du fichier }
      Exit;
    End;

    { LOW(T) / HIGH(T) }
    If (Up = 'LOW') Or (Up = 'HIGH') Then
    Begin
      Lbl := Up;
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Up := StrUpperCase(TokenPool[EP].Val);
          SI := TypeFindByName(Up);
          If SI >= 0 Then
          Begin
            If Lbl = 'LOW' Then
              EmitInstr('MOV EAX,' + IntToStr_(TypeTab[SI].Lo))
            Else
              EmitInstr('MOV EAX,' + IntToStr_(TypeTab[SI].Hi));
          End
          Else
          Begin
            If Lbl = 'LOW' Then
              EmitInstr('MOV EAX,0')
            Else
              EmitInstr('MOV EAX,0');
          End;
          Inc(EP);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { INC(x[,n]) }
    If Up = 'INC' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          If EPMatch(',') Then
          Begin
            ParseExpr(PI);
            EmitInstr('MOV ECX,EAX');
            GenLoadVar(PI, Lbl);
            EmitInstr('ADD EAX,ECX');
          End
          Else
          Begin
            GenLoadVar(PI, Lbl);
            EmitInstr('INC EAX');
          End;
          GenStoreVar(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { DEC(x[,n]) }
    If Up = 'DEC' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          If EPMatch(',') Then
          Begin
            ParseExpr(PI);
            EmitInstr('MOV ECX,EAX');
            GenLoadVar(PI, Lbl);
            EmitInstr('SUB EAX,ECX');
          End
          Else
          Begin
            GenLoadVar(PI, Lbl);
            EmitInstr('DEC EAX');
          End;
          GenStoreVar(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { NEW(p) -> HeapAlloc }
    If Up = 'NEW' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          EmitInstr('PUSH 4');
          EmitInstr('PUSH 8');   { HEAP_ZERO_MEMORY }
          EmitInstr('PUSH DWORD PTR [HHEAP]');
          EmitInstr('CALL HeapAlloc');
          GenStoreVar(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { DISPOSE(p) -> HeapFree }
    If Up = 'DISPOSE' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          GenLoadVar(PI, Lbl);
          EmitInstr('PUSH EAX');
          EmitInstr('PUSH 0');
          EmitInstr('PUSH DWORD PTR [HHEAP]');
          EmitInstr('CALL HeapFree');
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { GETMEM(p, size) -> HeapAlloc }
    If Up = 'GETMEM' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          EPMatch(',');
          ParseExpr(PI);   { taille dans EAX }
          EmitInstr('PUSH EAX');
          EmitInstr('PUSH 8');   { HEAP_ZERO_MEMORY }
          EmitInstr('PUSH DWORD PTR [HHEAP]');
          EmitInstr('CALL HeapAlloc');
          GenStoreVar(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { FREEMEM(p, size) -> HeapFree }
    If Up = 'FREEMEM' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          If (Not EPAtEnd) And (TokenPool[EP].Kind = TK_PUNCT) And
             (TokenPool[EP].Val = ',') Then
          Begin
            Inc(EP);
            ParseExpr(PI);  { ignorer la taille }
          End;
          GenLoadVar(PI, Lbl);
          EmitInstr('PUSH EAX');
          EmitInstr('PUSH 0');
          EmitInstr('PUSH DWORD PTR [HHEAP]');
          EmitInstr('CALL HeapFree');
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { MOVE(source, dest, count) -> copie memoire }
    If Up = 'MOVE' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            { --- Motorola 68000 --- }
            ParseExpr(PI);               { source dans D0 }
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(',');
            ParseExpr(PI);               { dest dans D0 }
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(',');
            ParseExpr(PI);               { count dans D0 }
            EmitInstr('MOVE.L D0,D2');   { D2 = count }
            EmitInstr('MOVE.L (SP)+,A1');{ A1 = dest }
            EmitInstr('MOVE.L (SP)+,A0');{ A0 = source }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('TST.L D2');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('MOVE.B (A0)+,(A1)+');
            EmitInstr('SUBQ.L #1,D2');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            { --- Intel 8086 (DOS 16 bits) --- }
            ParseExpr(PI);      { source dans AX }
            EmitInstr('PUSH AX');
            EPMatch(',');
            ParseExpr(PI);      { dest dans AX }
            EmitInstr('PUSH AX');
            EPMatch(',');
            ParseExpr(PI);      { count dans AX }
            EmitInstr('MOV CX,AX');
            EmitInstr('POP DI');    { dest }
            EmitInstr('POP SI');    { source }
            EmitInstr('CLD');
            EmitInstr('REP MOVSB');
          End;
          DEST_Z80:
          Begin
            { --- Zilog Z80 --- }
            ParseExpr(PI);      { source dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { dest dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { count dans HL }
            EmitInstr('LD B,H');
            EmitInstr('LD C,L');   { BC = count }
            EmitInstr('POP DE');   { DE = dest }
            EmitInstr('POP HL');   { HL = source }
            LblDone := LabelGen;
            EmitInstr('LD A,B');
            EmitInstr('OR C');
            EmitInstr('JR Z,' + LblDone);
            EmitInstr('LDIR');
            EmitLabel(LblDone);
          End;
          DEST_6502:
          Begin
            { --- MOS 6502 --- }
            ParseExpr(PI);      { source }
            EmitInstr('STA $00');  { zero-page ptr source low }
            EmitInstr('STX $01');  { zero-page ptr source high }
            EPMatch(',');
            ParseExpr(PI);      { dest }
            EmitInstr('STA $02');  { zero-page ptr dest low }
            EmitInstr('STX $03');  { zero-page ptr dest high }
            EPMatch(',');
            ParseExpr(PI);      { count dans A }
            EmitInstr('TAX');     { X = count }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('LDY #0');
            EmitInstr('CPX #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('LDA ($00),Y');
            EmitInstr('STA ($02),Y');
            EmitInstr('INY');
            EmitInstr('DEX');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_6809:
          Begin
            { --- Motorola 6809 --- }
            ParseExpr(PI);      { source }
            EmitInstr('PSHS D');
            EPMatch(',');
            ParseExpr(PI);      { dest }
            EmitInstr('TFR D,X');  { X = dest }
            EPMatch(',');
            ParseExpr(PI);      { count }
            EmitInstr('TFR D,Y');  { Y = count }
            EmitInstr('PULS U');   { U = source }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('CMPY #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('LDA ,U+');
            EmitInstr('STA ,X+');
            EmitInstr('LEAY -1,Y');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            ParseExpr(PI);      { source dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { dest dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { count dans EAX }
            EmitInstr('MOV ECX,EAX');
            EmitInstr('POP EDI');   { dest }
            EmitInstr('POP ESI');   { source }
            EmitInstr('CLD');
            EmitInstr('REP MOVSB');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { FILLCHAR(dest, count, value) -> remplissage memoire }
    If Up = 'FILLCHAR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            { --- Motorola 68000 --- }
            ParseExpr(PI);               { dest dans D0 }
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(',');
            ParseExpr(PI);               { count dans D0 }
            EmitInstr('MOVE.L D0,-(SP)');
            EPMatch(',');
            ParseExpr(PI);               { value dans D0 }
            EmitInstr('MOVE.L (SP)+,D1');{ D1 = count }
            EmitInstr('MOVE.L (SP)+,A0');{ A0 = dest }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('TST.L D1');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('MOVE.B D0,(A0)+');
            EmitInstr('SUBQ.L #1,D1');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            { --- Intel 8086 (DOS 16 bits) --- }
            ParseExpr(PI);      { dest dans AX }
            EmitInstr('PUSH AX');
            EPMatch(',');
            ParseExpr(PI);      { count dans AX }
            EmitInstr('PUSH AX');
            EPMatch(',');
            ParseExpr(PI);      { value dans AX (AL = valeur) }
            EmitInstr('POP CX');    { count }
            EmitInstr('POP DI');    { dest }
            EmitInstr('CLD');
            EmitInstr('REP STOSB');
          End;
          DEST_Z80:
          Begin
            { --- Zilog Z80 --- }
            ParseExpr(PI);      { dest dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { count dans HL }
            EmitInstr('PUSH HL');
            EPMatch(',');
            ParseExpr(PI);      { value dans L }
            EmitInstr('LD A,L');   { A = value }
            EmitInstr('POP BC');   { BC = count }
            EmitInstr('POP HL');   { HL = dest }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('LD E,A');   { sauvegarder value dans E }
            EmitInstr('LD A,B');
            EmitInstr('OR C');
            EmitInstr('JR Z,' + LblDone);
            EmitInstr('LD A,E');   { restaurer value }
            EmitLabel(LblLoop);
            EmitInstr('LD (HL),A');
            EmitInstr('INC HL');
            EmitInstr('DEC BC');
            EmitInstr('LD E,A');   { sauvegarder A }
            EmitInstr('LD A,B');
            EmitInstr('OR C');
            EmitInstr('LD A,E');   { restaurer A }
            EmitInstr('JR NZ,' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_6502:
          Begin
            { --- MOS 6502 --- }
            ParseExpr(PI);      { dest }
            EmitInstr('STA $00');  { zero-page ptr dest low }
            EmitInstr('STX $01');  { zero-page ptr dest high }
            EPMatch(',');
            ParseExpr(PI);      { count }
            EmitInstr('TAX');     { X = count }
            EPMatch(',');
            ParseExpr(PI);      { value dans A }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('LDY #0');
            EmitInstr('CPX #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('STA ($00),Y');
            EmitInstr('INY');
            EmitInstr('DEX');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          DEST_6809:
          Begin
            { --- Motorola 6809 --- }
            ParseExpr(PI);      { dest }
            EmitInstr('TFR D,X');  { X = dest }
            EPMatch(',');
            ParseExpr(PI);      { count }
            EmitInstr('TFR D,Y');  { Y = count }
            EPMatch(',');
            ParseExpr(PI);      { value dans B (low byte de D) }
            EmitInstr('TFR B,A');  { A = value }
            LblDone := LabelGen;
            LblLoop := LabelGen;
            EmitInstr('CMPY #0');
            EmitInstr('BEQ ' + LblDone);
            EmitLabel(LblLoop);
            EmitInstr('STA ,X+');
            EmitInstr('LEAY -1,Y');
            EmitInstr('BNE ' + LblLoop);
            EmitLabel(LblDone);
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            ParseExpr(PI);      { dest dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { count dans EAX }
            EmitInstr('PUSH EAX');
            EPMatch(',');
            ParseExpr(PI);      { value dans EAX }
            EmitInstr('POP ECX');   { count }
            EmitInstr('POP EDI');   { dest }
            EmitInstr('CLD');
            EmitInstr('REP STOSB');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { ASSIGNED(p) -> retourne p <> nil (0 ou 1) }
    If Up = 'ASSIGNED' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);
        Case Opts.DestTarget Of
          DEST_68000, DEST_ATARIST, DEST_AMIGA:
          Begin
            { --- Motorola 68000 --- }
            LblDone := LabelGen;
            Lbl := LabelGen;
            EmitInstr('TST.L D0');
            EmitInstr('BNE ' + Lbl);
            EmitInstr('MOVEQ #0,D0');
            EmitInstr('BRA ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('MOVEQ #1,D0');
            EmitLabel(LblDone);
          End;
          DEST_DOSR, DEST_DOSP:
          Begin
            { --- Intel 8086 (DOS 16 bits) --- }
            LblDone := LabelGen;
            Lbl := LabelGen;
            EmitInstr('TEST AX,AX');
            EmitInstr('JNE ' + Lbl);
            EmitInstr('XOR AX,AX');
            EmitInstr('JMP ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('MOV AX,1');
            EmitLabel(LblDone);
          End;
          DEST_Z80:
          Begin
            { --- Zilog Z80 --- }
            LblDone := LabelGen;
            Lbl := LabelGen;
            EmitInstr('LD A,H');
            EmitInstr('OR L');
            EmitInstr('JR NZ,' + Lbl);
            EmitInstr('LD HL,0');
            EmitInstr('JR ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('LD HL,1');
            EmitLabel(LblDone);
          End;
          DEST_6502:
          Begin
            { --- MOS 6502 --- }
            LblDone := LabelGen;
            EmitInstr('CMP #0');
            EmitInstr('BEQ ' + LblDone);
            EmitInstr('LDA #1');
            EmitLabel(LblDone);
          End;
          DEST_6809:
          Begin
            { --- Motorola 6809 --- }
            LblDone := LabelGen;
            Lbl := LabelGen;
            EmitInstr('CMPD #0');
            EmitInstr('BNE ' + Lbl);
            EmitInstr('LDD #0');
            EmitInstr('BRA ' + LblDone);
            EmitLabel(Lbl);
            EmitInstr('LDD #1');
            EmitLabel(LblDone);
          End;
          Else
          Begin
            { --- Intel 80386 (Win32) --- }
            EmitInstr('TEST EAX,EAX');
            EmitInstr('SETNE AL');
            EmitInstr('MOVZX EAX,AL');
          End;
        End; { Case }
        EPMatch(')');
      End;
      Exit;
    End;

    { ADDR(x) -> adresse de la variable x dans EAX }
    If Up = 'ADDR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          GenLoadAddr(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { OFS(x) -> offset = adresse (en mode flat, identique a Addr) }
    If Up = 'OFS' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        If Not EPAtEnd Then
        Begin
          Lbl := TokenPool[EP].Val;
          Inc(EP);
          GenLoadAddr(PI, Lbl);
        End;
        EPMatch(')');
      End;
      Exit;
    End;

    { PTR(seg, ofs) -> retourne ofs (segment ignore en mode flat) }
    If Up = 'PTR' Then
    Begin
      Inc(EP);
      If EPMatch('(') Then
      Begin
        ParseExpr(PI);      { seg - ignore en mode flat/non-segmente }
