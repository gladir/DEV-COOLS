    'Procedure SetViewPort(X1, Y1, X2, Y2 : Integer; Clip : Boolean);',
    'Begin',
    '  If (X1 < 0) Or (Y1 < 0) Or (X2 > MaxX) Or (Y2 > MaxY) Or (X1 > X2) Or (Y1 > Y2) Then',
    '  Begin GResult := grError; Exit End;',
    '  VP.X1 := X1; VP.Y1 := Y1; VP.X2 := X2; VP.Y2 := Y2; VP.Clip := Clip;',
