  A('push ecx');
  A('push 1');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('pop ecx');
  A('mov byte ptr [eax+$STR_DATA], cl');
  A('mov edx, $STR');
  A('leave');
  A('ret');
  A('.empty:');
