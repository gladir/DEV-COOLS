  A('.eq:');
  A('mov eax, 1');
  A('jmp .out');
  A('.ne:');
  A('xor eax, eax');
  A('.out:');
  A('pop edi');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_str_cmp(pa, pb) -> EAX = -1, 0 ou 1 (ordre des octets) }
  A('proc _JSRT_str_cmp');
  A('push ebp');
  A('mov ebp, esp');
  A('push esi');
  A('push edi');
  A('sub esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+12]');
  A('mov eax, dword ptr [esi+$STR_LEN]');
  A('mov dword ptr [ebp-12], eax');
  A('mov eax, dword ptr [edi+$STR_LEN]');
  A('mov dword ptr [ebp-16], eax');
  A('mov ecx, dword ptr [ebp-12]');
  A('cmp ecx, dword ptr [ebp-16]');
  A('jbe .m');
  A('mov ecx, dword ptr [ebp-16]');
  A('.m:');
  A('add esi, $STR_DATA');
  A('add edi, $STR_DATA');
  A('.loop:');
  A('test ecx, ecx');
  A('jz .lens');
  A('movzx eax, byte ptr [esi]');
  A('movzx edx, byte ptr [edi]');
  A('cmp eax, edx');
  A('jb .less');
  A('ja .greater');
  A('inc esi');
  A('inc edi');
  A('dec ecx');
  A('jmp .loop');
  A('.lens:');
  A('mov eax, dword ptr [ebp-12]');
  A('cmp eax, dword ptr [ebp-16]');
  A('jb .less');
  A('ja .greater');
  A('xor eax, eax');
  A('jmp .out');
  A('.less:');
  A('mov eax, -1');
  A('jmp .out');
  A('.greater:');
  A('mov eax, 1');
  A('.out:');
  A('add esp, 8');
  A('pop edi');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');
End;

{ ---- Egalite et addition ---- }

Procedure RtEquality;
Begin
  { _JSRT_seq(a, b) : === ; booleen dans EDX:EAX }
  A('proc _JSRT_seq');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+12]');
  A('cmp eax, dword ptr [ebp+20]');
  A('jne .diff');
  A('cmp eax, $INT');
  A('jb .num');
  A('cmp eax, $STR');
  A('je .str');
  A('cmp eax, $UNDEF');
  A('je .true');
  A('cmp eax, $NULL');
  A('je .true');
  A('mov ecx, dword ptr [ebp+8]');
  A('cmp ecx, dword ptr [ebp+16]');
  A('jne .objdiff');
  A('.true:');
  A('mov eax, 1');
  A('jmp .ret');
  { deux BigInt (objets du prelude) sont egaux s'ils ont la meme valeur : __bseq }
  A('.objdiff:');
  A('cmp eax, $OBJ');
  A('jne .false');
  A('cmp dword ptr [_JSV___bigproto+4], $OBJ');
  A('jne .false');
  A('mov edx, dword ptr [_JSV___bigproto]');
  A('cmp dword ptr [ecx+$OBJ_PROTO], edx');
  A('jne .false');
  A('mov ecx, dword ptr [ebp+16]');
  A('cmp dword ptr [ecx+$OBJ_PROTO], edx');
  A('jne .false');
  A('mov ecx, offset _JSV___bseq');
  A('cmp dword ptr [ecx+4], $FN');
  A('jne .false');
  A('push $OBJ');
  A('push dword ptr [ebp+16]');
  A('push $OBJ');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [ecx]');
  A('call _JSRT_call1');
  A('add esp, 20');
  A('jmp .ret');
  A('.str:');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('jmp .ret');
  A('.num:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_num_eq');
  A('add esp, 16');
  A('jmp .ret');
  A('.diff:');
  A('cmp eax, $INT');
  A('ja .false');
  A('mov ecx, dword ptr [ebp+20]');
  A('cmp ecx, $INT');
  A('ja .false');
  A('jmp .num');
  A('.false:');
  A('xor eax, eax');
  A('.ret:');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_eq(a, b) : == }
  A('proc _JSRT_eq');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+12]');
  A('mov ecx, dword ptr [ebp+20]');
  A('cmp eax, ecx');
  A('je .same');
  A('cmp eax, $INT');
  A('jbe .an');
  A('cmp eax, $UNDEF');
  A('je .au');
  A('cmp eax, $NULL');
  A('je .au');
  A('jmp .slow');
  A('.an:');
  A('cmp ecx, $INT');
  A('jbe .same');
  A('jmp .slow');
  A('.au:');
  A('cmp ecx, $UNDEF');
  A('je .true');
  A('cmp ecx, $NULL');
  A('je .true');
  A('xor eax, eax');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('.true:');
  A('mov eax, 1');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('.same:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_seq');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('.slow:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_eq_slow');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_add(a, b) : + (concatenation ou addition numerique) }
  A('proc _JSRT_add');
  A('push ebp');
  A('mov ebp, esp');
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jne .a1');
  A('push 1');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+8], eax');
  A('mov dword ptr [ebp+12], edx');
  A('.a1:');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jne .b1');
  A('push 1');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+16], eax');
  A('mov dword ptr [ebp+20], edx');
  A('.b1:');
  A('cmp dword ptr [ebp+12], $STR');
  A('je .str');
  A('cmp dword ptr [ebp+20], $STR');
  A('je .str');
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jae .str');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jae .str');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_num_add');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('.str:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('endp');
End;

{ ---- Proprietes ---- }

Procedure RtProperties;
Begin
  { _JSRT_str_get_prop(pstr, pcle) : propriete d'une chaine par nom }
  A('proc _JSRT_str_get_prop');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push offset ' + RtStr('length'));
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .proto');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_ulen');
  A('add esp, 4');
  A('mov edx, $INT');
  A('leave');
  A('ret');
  A('.proto:');
  A('mov eax, dword ptr [ebp+8]');
  A('cmp byte ptr [eax+$STR_DATA], 1');
  A('jne .sp1');
  A('cmp dword ptr [_JSV___symproto+4], $OBJ');
  A('jne .sp1');
  { symbole (chaine marquee) : proprietes de Symbol.prototype, accesseurs compris }
  A('push dword ptr [ebp+12]');
  A('push dword ptr [_JSV___symproto]');
  A('call _JSRT_prop_lookup');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .symu');
  A('push $STR');
  A('push dword ptr [ebp+8]');
  A('push eax');
  A('call _JSRT_prop_get');
  A('add esp, 12');
  A('leave');
  A('ret');
  A('.symu:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('leave');
  A('ret');
  A('.sp1:');
  A('push dword ptr [ebp+12]');
  A('push offset _JSNO_string_proto');
  A('call _JSRT_obj_lookup_str');
  A('add esp, 8');
  A('leave');
  A('ret');
  A('endp');
End;

{ ---- console ---- }

Procedure RtConsoleFn(Const code, handle_var: TString; kind: LongInt; fast: Boolean);
Begin
  A('proc ' + code);
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('push edi');
  If fast Then
    Begin
      { chemin rapide : chaines, entiers, booleens, null, undefined, doubles ; le reste
        (objets, tableaux, fonctions, -0, formats %) passe par le formateur JS }
      A('cmp dword ptr [_JSRT_v_grp], 0');
      A('jne .js');
      A('xor esi, esi');
      A('.chk:');
      A('cmp esi, dword ptr [ebp+12]');
      A('jae .fast');
      A('mov ecx, esi');
      A('shl ecx, 3');
      A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
      A('add ecx, eax');
      A('mov eax, dword ptr [ecx]');
      A('mov edx, dword ptr [ecx+4]');
      A('cmp edx, $STR');
      A('jne .t1');
      A('cmp byte ptr [eax+$STR_DATA], 1');
      A('je .js');
      A('test esi, esi');
      A('jnz .nx');
      A('cmp dword ptr [ebp+12], 1');
      A('je .nx');
      A('mov ecx, dword ptr [eax+$STR_LEN]');
      A('lea edi, [eax+$STR_DATA]');
      A('.sc:');
      A('test ecx, ecx');
      A('jz .nx');
      A('cmp byte ptr [edi], 37');
      A('je .js');
      A('inc edi');
      A('dec ecx');
      A('jmp .sc');
      A('.t1:');
      A('cmp edx, $INT');
      A('jb .dbl');
      A('je .nx');
      A('cmp edx, $BOOL');
      A('je .nx');
      A('cmp edx, $UNDEF');
      A('je .nx');
      A('cmp edx, $NULL');
      A('je .nx');
      A('jmp .js');
      A('.dbl:');
      A('test eax, eax');
      A('jnz .nx');
      A('cmp edx, 0x80000000');
      A('je .js');
      A('.nx:');
      A('inc esi');
      A('jmp .chk');
      A('.fast:');
      A('mov edi, dword ptr [' + handle_var + ']');
      A('xor esi, esi');
      A('.loop:');
      A('cmp esi, dword ptr [ebp+12]');
      A('jae .nl');
      A('test esi, esi');
      A('jz .arg');
      A('push 1');
      A('push offset _JSRT_c_space');
      A('push edi');
      A('call _JSRT_write');
      A('add esp, 12');
      A('.arg:');
      A('mov ecx, esi');
      A('shl ecx, 3');
      A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
      A('add ecx, eax');
      A('push dword ptr [ecx+4]');
      A('push dword ptr [ecx]');
      A('call _JSRT_tostring');
      A('add esp, 8');
      A('push dword ptr [eax+$STR_LEN]');
      A('add eax, $STR_DATA');
      A('push eax');
      A('push edi');
      A('call _JSRT_write');
      A('add esp, 12');
      A('inc esi');
      A('jmp .loop');
      A('.nl:');
      A('push 1');
      A('push offset _JSRT_c_nl');
      A('push edi');
      A('call _JSRT_write');
      A('add esp, 12');
      A('xor eax, eax');
      A('mov edx, $UNDEF');
      A('jmp .out');
    End;
  { chemin du formateur : __i_console(genre, ...arguments) }
  A('.js:');
  A('call _JSRT_array_new');
  A('mov ebx, eax');
  A('push $INT');
  A('push ' + IntToStr(kind));
  A('push $ARR');
  A('push ebx');
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('xor esi, esi');
  A('.jl:');
  A('cmp esi, dword ptr [ebp+12]');
  A('jae .jgo');
  A('mov ecx, esi');
  A('shl ecx, 3');
  A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('add ecx, eax');
  A('push dword ptr [ecx+4]');
  A('push dword ptr [ecx]');
  A('push $ARR');
  A('push ebx');
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('inc esi');
  A('jmp .jl');
  A('.jgo:');
  A('push $ARR');
  A('push ebx');
  A('push $UNDEF');
  A('push 0');
  A('mov eax, offset _JSV___i_console');
  A('push dword ptr [eax+4]');
  A('push dword ptr [eax]');
  A('call _JSRT_call_array');
  A('add esp, 24');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('.out:');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');
End;

{ ---- Methodes de String (TODO 14) ----

  Les chaines sont des octets UTF-8 : length, les indices et les
  positions comptent des octets, ce qui est exact pour l'ASCII. Les
  methodes natives suivent la convention d'appel des fonctions : this en
  [EBP+16], argc en [EBP+12], arguments a partir de [EBP+24]. }

{ Entier d'un argument (valeur par defaut si absent ou undefined) dans EAX. }
Procedure MArgInt(i: LongInt; Const def: TString);
Var
  d, ok: TString;
Begin
  d := U('d');
  ok := U('k');
  A('cmp dword ptr [ebp+12], ' + IntToStr(i + 1));
  A('jb ' + d);
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i) + ']');
  A('mov edx, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i + 4) + ']');
  A('cmp edx, $INT');
  A('je ' + ok);
  A('cmp edx, $UNDEF');
  A('je ' + d);
  A('push edx');
  A('push eax');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('jmp ' + ok);
  A(d + ':');
  A('mov eax, ' + def);
  A(ok + ':');
End;

{ Chaine d'un argument (ToString) dans le registre reg. }
Procedure MArgStr(i: LongInt; Const reg: TString);
Var
  have, ok: TString;
Begin
  have := U('h');
  ok := U('k');
  A('cmp dword ptr [ebp+12], ' + IntToStr(i + 1));
  A('jae ' + have);
  A('mov eax, offset ' + RtStr('undefined'));
  A('jmp ' + ok);
  A(have + ':');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i) + ']');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A(ok + ':');
  A('mov ' + reg + ', eax');
End;

{ Debut d'une methode : this converti en chaine, pointeur dans ESI. }
Function HasU16Impl(Const nm: TString): Boolean;
Const
  Names = ',charAt,charCodeAt,indexOf,lastIndexOf,includes,startsWith,endsWith,toUpperCase,' +
          'toLowerCase,trim,trimStart,trimEnd,slice,substring,padStart,padEnd,split,';
Begin
  HasU16Impl := Pos(',' + nm + ',', Names) > 0;
End;

Procedure MethBegin(Const code: TString);
Var
  nm: TString;
Begin
  A('proc ' + code);
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('mov eax, dword ptr [ebp+16]');
  A('mov edx, dword ptr [ebp+20]');
  A('cmp edx, $STR');
  A('je .thisok');
  A('push edx');
  A('push eax');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('.thisok:');
  A('mov esi, eax');
  nm := Copy(code, 10, 40);
  If Copy(code, 1, 9) = '_JSRT_sm_' Then
    If HasU16Impl(nm) Then
      Begin
        { chaine non ASCII : indices en unites UTF-16, delegues au prelude (__su_nom) }
        A('cmp dword ptr [_JSRT_v_u16raw], 0');
        A('jne .u16ok');
        If (nm = 'padStart') Or (nm = 'padEnd') Then
          Begin
            A('cmp dword ptr [ebp+12], 2');
            A('jb .padthis');
            A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + '], $STR');
            A('jne .padthis');
            A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
            A('call _JSRT_str_isascii');
            A('add esp, 4');
            A('test eax, eax');
            A('jz .padjs');
            A('.padthis:');
          End;
        A('push esi');
        A('call _JSRT_str_isascii');
        A('add esp, 4');
        A('test eax, eax');
        A('jnz .u16ok');
        If (nm = 'padStart') Or (nm = 'padEnd') Then
          A('.padjs:');
        A('cmp dword ptr [_JSV___su_' + nm + '+4], $FN');
        A('jne .u16ok');
        A('mov eax, dword ptr [_JSV___su_' + nm + ']');
        A('mov dword ptr [ebp+8], eax');
        A('pop edi');
        A('pop esi');
        A('pop ebx');
        A('pop ebp');
        A('jmp dword ptr [eax+$FN_CODE]');
        A('.u16ok:');
      End;
End;

Procedure MethEnd;
Begin
  A('.ret:');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');
End;

{ Routines communes : conversions, recherche, extraction. }
Procedure RtStringHelpers;
Begin
  { _JSRT_str_ulen(chaine) -> longueur en unites UTF-16 (mise en cache dans l'en-tete) }
  A('proc _JSRT_str_ulen');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('mov esi, dword ptr [ebp+8]');
  A('mov eax, dword ptr [esi+$HDR_U16]');
  A('test eax, eax');
  A('jz .calc');
  A('dec eax');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('.calc:');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('lea edx, [esi+$STR_DATA]');
  A('xor eax, eax');
  A('.l:');
  A('test ecx, ecx');
  A('jz .done');
  A('movzx ebx, byte ptr [edx]');
  A('inc edx');
  A('dec ecx');
  A('cmp ebx, 128');
  A('jb .one');
  A('cmp ebx, 192');
  A('jb .l');
  A('cmp ebx, 240');
  A('jb .one');
  A('add eax, 2');
  A('jmp .l');
  A('.one:');
  A('inc eax');
  A('jmp .l');
  A('.done:');
  A('lea ecx, [eax+1]');
  A('mov dword ptr [esi+$HDR_U16], ecx');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_b2u(chaine, octets) -> unites UTF-16 des premiers octets }
  A('proc _JSRT_b2u');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+12]');
  A('cmp edi, dword ptr [esi+$STR_LEN]');
  A('jbe .go');
  A('mov edi, dword ptr [esi+$STR_LEN]');
  A('.go:');
  A('xor ebx, ebx');
  A('xor ecx, ecx');
  A('.l:');
  A('cmp ebx, edi');
  A('jae .done');
  A('movzx eax, byte ptr [esi+ebx+$STR_DATA]');
  A('inc ebx');
  A('cmp eax, 128');
  A('jb .c1');
  A('cmp eax, 192');
  A('jb .l');
  A('cmp eax, 240');
  A('jb .c1');
  A('add ecx, 2');
  A('jmp .l');
  A('.c1:');
  A('inc ecx');
  A('jmp .l');
  A('.done:');
  A('mov eax, ecx');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_u2b(chaine, unites) -> decalage en octets, -1 au milieu d'une paire }
  A('proc _JSRT_u2b');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
