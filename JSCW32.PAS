{ indexOf / lastIndexOf / includes ; mode 0 indexOf, 1 lastIndexOf, 2 includes }
Procedure ArrSearch(Const code: TString; mode: LongInt);
Begin
  ArrBegin(code, 3);
  ArgToLocals(0, 1, 2);
  If mode = 1 Then
    Begin
      A('mov ebx, dword ptr [esi+$ARR_LEN]');
      A('dec ebx');
      MArgInt(1, '2147483647');
      A('cmp eax, 2147483647');
      A('je .l');
      A('test eax, eax');
      A('jns .fp');
      A('add eax, dword ptr [esi+$ARR_LEN]');
      A('.fp:');
      A('cmp eax, ebx');
      A('jge .l');
      A('mov ebx, eax');
      A('.l:');
      A('test ebx, ebx');
      A('js .nf');
    End
  Else
    Begin
      MArgInt(1, '0');
      A('test eax, eax');
      A('jns .fp');
      A('add eax, dword ptr [esi+$ARR_LEN]');
      A('jns .fp');
      A('xor eax, eax');
      A('.fp:');
      A('mov ebx, eax');
      A('.l:');
      A('cmp ebx, dword ptr [esi+$ARR_LEN]');
      A('jae .nf');
    End;
  A('mov eax, ebx');
  A('shl eax, 3');
  A('add eax, dword ptr [esi+$ARR_ELEMS]');
  A('push ' + Lv(2));
  A('push ' + Lv(1));
  A('push dword ptr [eax+4]');
  A('push dword ptr [eax]');
  A('call _JSRT_seq');
  A('add esp, 16');
  A('test eax, eax');
  A('jnz .found');
  If mode = 2 Then
    Begin
      A('mov eax, ebx');
      A('shl eax, 3');
      A('add eax, dword ptr [esi+$ARR_ELEMS]');
      A('push dword ptr [eax+4]');
      A('push dword ptr [eax]');
      A('call _JSRT_is_nan_bits');
      A('add esp, 8');
      A('test eax, eax');
      A('jz .nonan');
      A('push ' + Lv(2));
      A('push ' + Lv(1));
      A('call _JSRT_is_nan_bits');
      A('add esp, 8');
      A('test eax, eax');
      A('jnz .found');
      A('.nonan:');
    End;
  If mode = 1 Then
    A('dec ebx')
  Else
    A('inc ebx');
  A('jmp .l');
  A('.found:');
  If mode = 2 Then
    Begin
      A('mov eax, 1');
      A('mov edx, $BOOL');
    End
  Else
    Begin
      A('mov eax, ebx');
      A('mov edx, $INT');
    End;
  A('jmp .ret');
  A('.nf:');
  If mode = 2 Then
    Begin
      A('xor eax, eax');
      A('mov edx, $BOOL');
    End
  Else
    Begin
      A('mov eax, -1');
      A('mov edx, $INT');
    End;
  A('jmp .ret');
  ArrEnd;
End;

{ Methodes a rappel : forEach, map, filter, some, every, find, findIndex }
Procedure ArrIter(Const code: TString; mode: LongInt);
Begin
  ArrBegin(code, 6);
  ArgToLocals(0, 1, 2);
  ArgToLocals(1, 3, 4);
  A('mov eax, dword ptr [esi+$ARR_LEN]');
  A('mov ' + Lv(5) + ', eax');
  If (mode = 1) Or (mode = 2) Then
    Begin
      A('call _JSRT_array_new');
      A('mov ' + Lv(6) + ', eax');
    End;
  A('xor ebx, ebx');
  A('.l:');
  A('cmp ebx, ' + Lv(5));
  A('jae .done');
  A('cmp ebx, dword ptr [esi+$ARR_LEN]');
  A('jae .done');
  A('mov eax, ebx');
  A('shl eax, 3');
  A('add eax, dword ptr [esi+$ARR_ELEMS]');
  A('push esi');
  A('push ebx');
  A('push eax');
  A('push ' + Lv(4));
  A('push ' + Lv(3));
  A('push ' + Lv(2));
  A('push ' + Lv(1));
  A('call _JSRT_arr_cb');
  A('add esp, 28');
  Case mode Of
    1:
      Begin
        A('push edx');
        A('push eax');
        A('push $ARR');
        A('push ' + Lv(6));
        A('call _JSRT_array_push');
        A('add esp, 16');
      End;
    2, 3, 4, 5, 6:
      Begin
        A('push edx');
        A('push eax');
        A('call _JSRT_truthy');
        A('add esp, 8');
        A('test eax, eax');
        Case mode Of
          2:
            Begin
              A('jz .skip');
              A('mov eax, ebx');
              A('shl eax, 3');
              A('add eax, dword ptr [esi+$ARR_ELEMS]');
              A('push dword ptr [eax+4]');
              A('push dword ptr [eax]');
              A('push $ARR');
              A('push ' + Lv(6));
              A('call _JSRT_array_push');
              A('add esp, 16');
            End;
          3: A('jnz .rtrue');
          4: A('jz .rfalse');
          5, 6:
            Begin
              A('jz .skip');
              If mode = 5 Then
                Begin
                  A('mov eax, ebx');
                  A('shl eax, 3');
                  A('add eax, dword ptr [esi+$ARR_ELEMS]');
                  A('mov edx, dword ptr [eax+4]');
                  A('mov eax, dword ptr [eax]');
                  A('jmp .ret');
                End
              Else
                Begin
                  A('mov eax, ebx');
                  A('mov edx, $INT');
                  A('jmp .ret');
                End;
            End;
        End;
      End;
  End;
  A('.skip:');
  A('inc ebx');
  A('jmp .l');
  A('.done:');
  Case mode Of
    1, 2:
      Begin
        A('mov eax, ' + Lv(6));
        A('mov edx, $ARR');
      End;
    3:
      Begin
        A('xor eax, eax');
        A('mov edx, $BOOL');
      End;
    4:
      Begin
        A('mov eax, 1');
        A('mov edx, $BOOL');
      End;
    6:
      Begin
        A('mov eax, -1');
        A('mov edx, $INT');
      End;
  Else
    Begin
      A('xor eax, eax');
      A('mov edx, $UNDEF');
    End;
  End;
  A('jmp .ret');
  If mode = 3 Then
    Begin
      A('.rtrue:');
      A('mov eax, 1');
      A('mov edx, $BOOL');
