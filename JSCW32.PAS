{ ---- Acces aux jetons ---- }

Function TkIsP(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsP := ((TokP(ctx.lex.tokens, i)^.kind = TK_PUNCT) Or
            (TokP(ctx.lex.tokens, i)^.kind = TK_OPERATOR)) And
           (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function TkIsKw(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsKw := (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) And
            (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function TkIsId(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsId := (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) And
            (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function CurIsP(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  CurIsP := TkIsP(ctx, ctx.ast.pt, s);
End;

Function CurIsKw(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  CurIsKw := TkIsKw(ctx, ctx.ast.pt, s);
End;

Function CurIsEof(Var ctx: TCompilerContext): Boolean;
Begin
  CurIsEof := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_EOF;
End;

{ Indice du jeton situe n positions apres le courant (borne par EOF). }
Function PeekIdx(Var ctx: TCompilerContext; n: LongInt): LongInt;
Begin
  If ctx.ast.pt + n > ctx.lex.token_count Then
    PeekIdx := ctx.lex.token_count
  Else
    PeekIdx := ctx.ast.pt + n;
End;

Procedure PAdvance(Var ctx: TCompilerContext);
Begin
  If ctx.ast.pt < ctx.lex.token_count Then
    Inc(ctx.ast.pt);
End;

Function TokenDesc(Var ctx: TCompilerContext; i: LongInt): TString;
Begin
  If TokP(ctx.lex.tokens, i)^.kind = TK_EOF Then
    TokenDesc := 'fin de fichier'
  Else
    TokenDesc := '"' + TokP(ctx.lex.tokens, i)^.text + '"';
End;

{ Une seule erreur par jeton, pour eviter les cascades. }
Procedure ParseError(Var ctx: TCompilerContext; i: LongInt; msg: TString);
Begin
  If i = ctx.ast.last_err_tok Then
    Exit;
  ctx.ast.last_err_tok := i;
  SourceErrorAt(ctx, TokP(ctx.lex.tokens, i)^.line, TokP(ctx.lex.tokens, i)^.col, msg);
End;

Function Expect(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  If CurIsP(ctx, s) Then
    Begin
      PAdvance(ctx);
      Expect := True;
    End
  Else
    Begin
      ParseError(ctx, ctx.ast.pt, '"' + s + '" attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Expect := False;
    End;
End;

{ Point-virgule explicite ou insertion automatique (ASI). }
Procedure ConsumeSemi(Var ctx: TCompilerContext);
Begin
  If CurIsP(ctx, ';') Then
    PAdvance(ctx)
  Else If CurIsP(ctx, '}') Or CurIsEof(ctx) Or
          TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    { ASI }
  Else
    ParseError(ctx, ctx.ast.pt, '";" attendu avant ' +
               TokenDesc(ctx, ctx.ast.pt));
End;

Function IsStmtStartKw(Var ctx: TCompilerContext; i: LongInt): Boolean;
Var
  s: TTokenText;
Begin
  s := TokP(ctx.lex.tokens, i)^.text;
  IsStmtStartKw := (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) And
    ((s = 'var') Or (s = 'let') Or (s = 'const') Or (s = 'function') Or
     (s = 'class') Or (s = 'if') Or (s = 'for') Or (s = 'while') Or
     (s = 'do') Or (s = 'return') Or (s = 'switch') Or (s = 'try') Or
     (s = 'throw') Or (s = 'break') Or (s = 'continue'));
End;

{ Reprise apres erreur : saute jusqu'a la fin de l'instruction. }
Procedure Synchronize(Var ctx: TCompilerContext);
Var
  first: Boolean;
Begin
  first := True;
  While Not CurIsEof(ctx) Do
    Begin
      If CurIsP(ctx, ';') Then
        Begin
          PAdvance(ctx);
          Exit;
        End;
      If CurIsP(ctx, '}') Then
        Exit;
      If Not first And TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before And
         IsStmtStartKw(ctx, ctx.ast.pt) Then
        Exit;
      first := False;
      PAdvance(ctx);
    End;
End;

{ ---- Noeuds et declarations ---- }

Function NewNode(Var ctx: TCompilerContext; kind: TNodeKind; tok: LongInt): LongInt;
Var
  n: LongInt;
Begin
  Inc(ctx.ast.node_count);
  n := ctx.ast.node_count;
  NodeP(ctx.ast.nodes, n)^.kind := kind;
  NodeP(ctx.ast.nodes, n)^.tok := tok;
  NodeP(ctx.ast.nodes, n)^.e1 := 0;
  NodeP(ctx.ast.nodes, n)^.e2 := 0;
  NodeP(ctx.ast.nodes, n)^.e3 := 0;
  NodeP(ctx.ast.nodes, n)^.e4 := 0;
  NodeP(ctx.ast.nodes, n)^.next := 0;
  NodeP(ctx.ast.nodes, n)^.flags := 0;
  NodeP(ctx.ast.nodes, n)^.paren := False;
  NodeP(ctx.ast.nodes, n)^.scope := 0;
  NodeP(ctx.ast.nodes, n)^.decl_head := 0;
  NodeP(ctx.ast.nodes, n)^.sym := 0;
  NodeP(ctx.ast.nodes, n)^.aux := 0;
  NodeP(ctx.ast.nodes, n)^.ds := 0;
  NewNode := n;
End;

{ Ajoute node a la liste (first, last). }
Procedure ListAdd(Var ctx: TCompilerContext; Var first, last: LongInt;
                  node: LongInt);
Begin
  If node = 0 Then
    Exit;
  If first = 0 Then
    first := node
  Else
    NodeP(ctx.ast.nodes, last)^.next := node;
  last := node;
End;

Procedure DeclareName(Var ctx: TCompilerContext; kind: TDeclKind;
                      name_tok, node: LongInt);
Var
  n: LongInt;
Begin
  Inc(ctx.ast.decl_count);
  n := ctx.ast.decl_count;
  DeclP(ctx.ast.decls, n)^.kind := kind;
  DeclP(ctx.ast.decls, n)^.name_tok := name_tok;
  DeclP(ctx.ast.decls, n)^.node := node;
  DeclP(ctx.ast.decls, n)^.origin := ctx.ast.cur_scope;
  If kind = DK_VAR Then
    DeclP(ctx.ast.decls, n)^.scope := ctx.ast.cur_func
  Else
    DeclP(ctx.ast.decls, n)^.scope := ctx.ast.cur_scope;
End;

{ ---- Declarations anticipees et contexte de fonction ---- }

Function ParseAssign(Var ctx: TCompilerContext; no_in: Boolean): LongInt; Forward;
Function ParseExpr(Var ctx: TCompilerContext; no_in: Boolean): LongInt; Forward;
Function ParseLHS(Var ctx: TCompilerContext): LongInt; Forward;
Function ParseClass(Var ctx: TCompilerContext; is_decl: Boolean): LongInt; Forward;
Procedure ParseParamList(Var ctx: TCompilerContext; node: LongInt); Forward;
Function ParseFuncBlock(Var ctx: TCompilerContext): LongInt; Forward;
Procedure ParseFuncRest(Var ctx: TCompilerContext; node: LongInt); Forward;

{ Entre dans la portee d'une fonction : memorise le contexte courant. }
Procedure EnterFunc(Var ctx: TCompilerContext; node: LongInt; Var sv: TFuncSave);
Begin
  sv.scope := ctx.ast.cur_scope;
  sv.func := ctx.ast.cur_func;
  sv.loop := ctx.ast.loop_depth;
  sv.switch := ctx.ast.switch_depth;
  sv.labels := ctx.ast.label_count;
  ctx.ast.cur_scope := node;
  ctx.ast.cur_func := node;
  ctx.ast.loop_depth := 0;
  ctx.ast.switch_depth := 0;
  Inc(ctx.ast.func_depth);
End;

Procedure LeaveFunc(Var ctx: TCompilerContext; Var sv: TFuncSave);
Begin
  Dec(ctx.ast.func_depth);
  ctx.ast.label_count := sv.labels;
  ctx.ast.switch_depth := sv.switch;
  ctx.ast.loop_depth := sv.loop;
  ctx.ast.cur_func := sv.func;
  ctx.ast.cur_scope := sv.scope;
End;

{ ---- Liaisons : identifiants et motifs de destructuration ---- }

Function ParseBindingTarget(Var ctx: TCompilerContext; dk: TDeclKind): LongInt; Forward;

Function ParseBindingDefault(Var ctx: TCompilerContext): LongInt;
Begin
  ParseBindingDefault := 0;
  If CurIsP(ctx, '=') Then
    Begin
      PAdvance(ctx);
      ParseBindingDefault := ParseAssign(ctx, False);
    End;
End;

Function IsPropertyNameTok(Var ctx: TCompilerContext; i: LongInt): Boolean;
Begin
  IsPropertyNameTok := (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_STRING) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_NUMBER);
End;

Function ParseArrayPattern(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node, el, first, last: LongInt;
  rest: Boolean;
Begin
  node := NewNode(ctx, N_ARRAY_PATTERN, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, ']') And Not CurIsEof(ctx) Do
    Begin
      el := NewNode(ctx, N_PATTERN_ELEM, ctx.ast.pt);
      If CurIsP(ctx, ',') Then
        { trou : element omis }
      Else
        Begin
          rest := CurIsP(ctx, '...');
          If rest Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, el)^.flags := PF_REST;
            End;
          NodeP(ctx.ast.nodes, el)^.e1 := ParseBindingTarget(ctx, dk);
          If Not rest Then
            NodeP(ctx.ast.nodes, el)^.e2 := ParseBindingDefault(ctx);
        End;
      ListAdd(ctx, first, last, el);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, ']');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseArrayPattern := node;
End;

Function ParseObjectPattern(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node, prop, first, last, key_tok, tgt: LongInt;
Begin
  node := NewNode(ctx, N_OBJECT_PATTERN, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) Do
    Begin
      prop := NewNode(ctx, N_PATTERN_PROP, ctx.ast.pt);
      If CurIsP(ctx, '...') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, prop)^.flags := PP_REST;
          NodeP(ctx.ast.nodes, prop)^.e1 := ParseBindingTarget(ctx, dk);
        End
      Else
        Begin
          If CurIsP(ctx, '[') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.flags := PP_COMPUTED;
              NodeP(ctx.ast.nodes, prop)^.e3 := ParseAssign(ctx, False);
              Expect(ctx, ']');
              key_tok := NodeP(ctx.ast.nodes, prop)^.tok;
            End
          Else If IsPropertyNameTok(ctx, ctx.ast.pt) Then
            Begin
              key_tok := ctx.ast.pt;
              NodeP(ctx.ast.nodes, prop)^.tok := key_tok;
              PAdvance(ctx);
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, 'nom de propriete attendu, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          If CurIsP(ctx, ':') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.e1 := ParseBindingTarget(ctx, dk);
            End
          Else If (TokP(ctx.lex.tokens, key_tok)^.kind = TK_IDENT) And
                  (NodeP(ctx.ast.nodes, prop)^.flags And PP_COMPUTED = 0) Then
            Begin
              { raccourci : a ou a = 1 dans les accolades }
              NodeP(ctx.ast.nodes, prop)^.flags := NodeP(ctx.ast.nodes, prop)^.flags Or
                                           PP_SHORTHAND;
              tgt := NewNode(ctx, N_BIND_IDENT, key_tok);
              DeclareName(ctx, dk, key_tok, tgt);
              NodeP(ctx.ast.nodes, prop)^.e1 := tgt;
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, '":" attendu dans le motif, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          NodeP(ctx.ast.nodes, prop)^.e2 := ParseBindingDefault(ctx);
        End;
      ListAdd(ctx, first, last, prop);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, '}');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseObjectPattern := node;
End;

Function ParseBindingTarget(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node: LongInt;
Begin
  ParseBindingTarget := 0;
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      node := NewNode(ctx, N_BIND_IDENT, ctx.ast.pt);
      DeclareName(ctx, dk, ctx.ast.pt, node);
      PAdvance(ctx);
      ParseBindingTarget := node;
    End
  Else If CurIsP(ctx, '[') Then
    ParseBindingTarget := ParseArrayPattern(ctx, dk)
  Else If CurIsP(ctx, '{') Then
    ParseBindingTarget := ParseObjectPattern(ctx, dk)
  Else
    ParseError(ctx, ctx.ast.pt, 'identifiant attendu, trouve ' +
               TokenDesc(ctx, ctx.ast.pt));
End;

{ ---- Declarations var / let / const ---- }

{ Le mot-cle de declaration est le jeton courant. in_for : acces depuis
  un en-tete de for (initialiseur facultatif pour for-in et for-of). }
Function ParseVarDecl(Var ctx: TCompilerContext; in_for: Boolean): LongInt;
Var
  node, decl, target, init, first, last, kw_tok: LongInt;
  dk: TDeclKind;
  is_pattern: Boolean;
Begin
  kw_tok := ctx.ast.pt;
  node := NewNode(ctx, N_VAR_DECL, kw_tok);
  If CurIsKw(ctx, 'var') Then
    Begin
      dk := DK_VAR;
      NodeP(ctx.ast.nodes, node)^.flags := DF_VAR;
    End
  Else If CurIsKw(ctx, 'let') Then
    Begin
      dk := DK_LET;
      NodeP(ctx.ast.nodes, node)^.flags := DF_LET;
    End
  Else
    Begin
      dk := DK_CONST;
      NodeP(ctx.ast.nodes, node)^.flags := DF_CONST;
    End;
  PAdvance(ctx);
  first := 0;
  last := 0;
  Repeat
    decl := NewNode(ctx, N_DECLARATOR, ctx.ast.pt);
    is_pattern := CurIsP(ctx, '[') Or CurIsP(ctx, '{');
    target := ParseBindingTarget(ctx, dk);
    If target = 0 Then
      Begin
        Synchronize(ctx);
        Break;
      End;
    NodeP(ctx.ast.nodes, decl)^.e1 := target;
    init := 0;
    If CurIsP(ctx, '=') Then
      Begin
        PAdvance(ctx);
        init := ParseAssign(ctx, in_for);
      End
    Else If Not in_for Then
      Begin
        If dk = DK_CONST Then
          ParseError(ctx, NodeP(ctx.ast.nodes, decl)^.tok,
                     'une constante doit etre initialisee')
        Else If is_pattern Then
          ParseError(ctx, NodeP(ctx.ast.nodes, decl)^.tok,
                     'la destructuration doit etre initialisee');
      End;
    NodeP(ctx.ast.nodes, decl)^.e2 := init;
    ListAdd(ctx, first, last, decl);
    If CurIsP(ctx, ',') Then
      PAdvance(ctx)
    Else
      Break;
  Until False;
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseVarDecl := node;
End;

{ ---- Expressions (TODO 5) ---- }

{ Precedence d'un operateur binaire, 0 si ce n'en est pas un. }
Function BinPrec(Const s: TTokenText): LongInt;
Begin
  BinPrec := 0;
  If s = '??' Then
    BinPrec := 1
  Else If s = '||' Then
    BinPrec := 2
  Else If s = '&&' Then
    BinPrec := 3
  Else If s = '|' Then
    BinPrec := 4
  Else If s = '^' Then
    BinPrec := 5
  Else If s = '&' Then
    BinPrec := 6
  Else If (s = '==') Or (s = '!=') Or (s = '===') Or (s = '!==') Then
    BinPrec := 7
  Else If (s = '<') Or (s = '>') Or (s = '<=') Or (s = '>=') Then
    BinPrec := 8
  Else If (s = '<<') Or (s = '>>') Or (s = '>>>') Then
    BinPrec := 9
  Else If (s = '+') Or (s = '-') Then
    BinPrec := 10
  Else If (s = '*') Or (s = '/') Or (s = '%') Then
    BinPrec := 11
  Else If s = '**' Then
    BinPrec := 12;
End;

Function IsAssignOp(Const s: TTokenText): Boolean;
Begin
  IsAssignOp := (s = '=') Or (s = '+=') Or (s = '-=') Or (s = '*=') Or
                (s = '/=') Or (s = '%=') Or (s = '**=') Or (s = '<<=') Or
                (s = '>>=') Or (s = '>>>=') Or (s = '&=') Or (s = '|=') Or
                (s = '^=') Or (s = '&&=') Or (s = '||=') Or (s = '??=');
End;

{ Cible d'une affectation simple : identifiant ou membre. }
Function IsSimpleTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsSimpleTarget := (n <> 0) And
    ((NodeP(ctx.ast.nodes, n)^.kind = N_IDENT) Or (NodeP(ctx.ast.nodes, n)^.kind = N_MEMBER) Or
     (NodeP(ctx.ast.nodes, n)^.kind = N_INDEX));
End;

{ Avec = : un tableau ou un objet litteral est aussi une cible
  (destructuration). }
Function IsPatternTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsPatternTarget := IsSimpleTarget(ctx, n) Or
    ((n <> 0) And ((NodeP(ctx.ast.nodes, n)^.kind = N_ARRAY_LIT) Or
                   (NodeP(ctx.ast.nodes, n)^.kind = N_OBJECT_LIT)));
End;

{ Index de la parenthese fermante qui correspond a la parenthese
  ouvrante du jeton i, ou 0. }
Function MatchClose(Var ctx: TCompilerContext; i: LongInt): LongInt;
Var
  depth: LongInt;
  s: TTokenText;
Begin
  MatchClose := 0;
  depth := 0;
  While TokP(ctx.lex.tokens, i)^.kind <> TK_EOF Do
    Begin
      s := TokP(ctx.lex.tokens, i)^.text;
      Case TokP(ctx.lex.tokens, i)^.kind Of
        TK_PUNCT, TK_OPERATOR:
          Begin
            If (s = '(') Or (s = '[') Or (s = '{') Then
              Inc(depth)
            Else If (s = ')') Or (s = ']') Or (s = '}') Then
              Begin
                Dec(depth);
                If depth = 0 Then
                  Begin
                    MatchClose := i;
                    Exit;
                  End;
              End;
          End;
        TK_TEMPLATE:
          Begin
            If TokP(ctx.lex.tokens, i)^.tpl = TP_HEAD Then
              Inc(depth)
            Else If TokP(ctx.lex.tokens, i)^.tpl = TP_TAIL Then
              Dec(depth);
          End;
      End;
      Inc(i);
    End;
End;

{ Le jeton courant commence-t-il une fonction fleche ? }
Function IsArrowAhead(Var ctx: TCompilerContext; Var is_async: Boolean): Boolean;
Var
  i, nx, j: LongInt;
Begin
  IsArrowAhead := False;
  is_async := False;
  i := ctx.ast.pt;
  nx := PeekIdx(ctx, 1);
  If TkIsId(ctx, i, 'async') And Not TokP(ctx.lex.tokens, nx)^.nl_before And
     Not TkIsP(ctx, nx, '=>') Then
    Begin
      If (TokP(ctx.lex.tokens, nx)^.kind = TK_IDENT) And
         TkIsP(ctx, PeekIdx(ctx, 2), '=>') Then
        Begin
          is_async := True;
          IsArrowAhead := True;
          Exit;
        End;
      If TkIsP(ctx, nx, '(') Then
        Begin
          j := MatchClose(ctx, nx);
          If (j > 0) And TkIsP(ctx, j + 1, '=>') And
             Not TokP(ctx.lex.tokens, j + 1)^.nl_before Then
            Begin
              is_async := True;
              IsArrowAhead := True;
              Exit;
            End;
        End;
    End;
  If (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) And TkIsP(ctx, nx, '=>') And
     Not TokP(ctx.lex.tokens, nx)^.nl_before Then
    IsArrowAhead := True
  Else If TkIsP(ctx, i, '(') Then
    Begin
      j := MatchClose(ctx, i);
      If (j > 0) And TkIsP(ctx, j + 1, '=>') And
         Not TokP(ctx.lex.tokens, j + 1)^.nl_before Then
        IsArrowAhead := True;
    End;
End;

{ Nom de propriete (ou crochet de nom calcule) au jeton i ? }
Function IsPropNameStart(Var ctx: TCompilerContext; i: LongInt): Boolean;
Begin
  IsPropNameStart := IsPropertyNameTok(ctx, i) Or TkIsP(ctx, i, '[');
End;

{ Arguments d'appel : ( a, ...b ). Retourne la liste des arguments. }
Function ParseCallArgs(Var ctx: TCompilerContext): LongInt;
Var
  first, last, a, sp: LongInt;
Begin
  first := 0;
  last := 0;
  If Expect(ctx, '(') Then
    Begin
      While Not CurIsP(ctx, ')') And Not CurIsEof(ctx) Do
        Begin
          If CurIsP(ctx, '...') Then
            Begin
              sp := NewNode(ctx, N_SPREAD, ctx.ast.pt);
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, sp)^.e1 := ParseAssign(ctx, False);
              a := sp;
            End
          Else
            a := ParseAssign(ctx, False);
          If a = 0 Then
            Break;
          ListAdd(ctx, first, last, a);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
      Expect(ctx, ')');
    End;
  ParseCallArgs := first;
End;

Function ParseTemplate(Var ctx: TCompilerContext): LongInt;
Var
  node, part, e, first, last: LongInt;
  done: Boolean;
Begin
  node := NewNode(ctx, N_TEMPLATE, ctx.ast.pt);
  first := 0;
  last := 0;
  part := NewNode(ctx, N_TEMPLATE_STR, ctx.ast.pt);
  ListAdd(ctx, first, last, part);
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl <> TP_NOSUB Then
    Begin
      PAdvance(ctx);
      done := False;
      While Not done Do
        Begin
          e := ParseExpr(ctx, False);
          If e = 0 Then
            Break;
          ListAdd(ctx, first, last, e);
          If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_TEMPLATE) And
             ((TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_MIDDLE) Or
              (TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_TAIL)) Then
            Begin
              part := NewNode(ctx, N_TEMPLATE_STR, ctx.ast.pt);
              ListAdd(ctx, first, last, part);
              If TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_TAIL Then
                done := True;
              If Not done Then
                PAdvance(ctx);
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, 'fin de gabarit attendue, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
        End;
    End;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseTemplate := node;
End;

{ Gabarit etiquete : tag`a...b` devient tag(__tpl(site, cuits..., bruts...), valeurs...). }
Function BuildTagged(Var ctx: TCompilerContext; tag: LongInt): LongInt;
Var
  t, p, nx, c, idx, id, call_tpl, outer, tpl_tok, site: LongInt;
  s_first, s_last, r_first, r_last, a_first, a_last: LongInt;
Begin
  tpl_tok := ctx.ast.pt;
  t := ParseTemplate(ctx);
  s_first := 0;
  s_last := 0;
  r_first := 0;
  r_last := 0;
  a_first := 0;
  a_last := 0;
  p := NodeP(ctx.ast.nodes, t)^.e1;
  While p <> 0 Do
    Begin
      nx := NodeP(ctx.ast.nodes, p)^.next;
      If NodeP(ctx.ast.nodes, p)^.kind = N_TEMPLATE_STR Then
        Begin
          c := NewNode(ctx, N_TEMPLATE_STR, NodeP(ctx.ast.nodes, p)^.tok);
          ListAdd(ctx, s_first, s_last, c);
          c := NewNode(ctx, N_TEMPLATE_STR, NodeP(ctx.ast.nodes, p)^.tok);
          NodeP(ctx.ast.nodes, c)^.flags := 1;
          ListAdd(ctx, r_first, r_last, c);
        End
      Else
        Begin
          NodeP(ctx.ast.nodes, p)^.next := 0;
          ListAdd(ctx, a_first, a_last, p);
        End;
      p := nx;
    End;
  NodeP(ctx.ast.nodes, s_last)^.next := r_first;
  { identifiant du site (indice du jeton du gabarit) : premier argument de __tpl }
  idx := AddToken(ctx, TK_NUMBER, TokP(ctx.lex.tokens, tpl_tok)^.line,
                  TokP(ctx.lex.tokens, tpl_tok)^.col, ctx.lex.pos);
  TokP(ctx.lex.tokens, idx)^.num_val := tpl_tok;
  site := NewNode(ctx, N_NUMBER, idx);
  NodeP(ctx.ast.nodes, site)^.next := s_first;
  s_first := site;
  idx := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, tpl_tok)^.line,
                  TokP(ctx.lex.tokens, tpl_tok)^.col, ctx.lex.pos);
  TokP(ctx.lex.tokens, idx)^.text := '__tpl';
  id := NewNode(ctx, N_IDENT, idx);
  call_tpl := NewNode(ctx, N_CALL, tpl_tok);
  NodeP(ctx.ast.nodes, call_tpl)^.e1 := id;
  NodeP(ctx.ast.nodes, call_tpl)^.e2 := s_first;
  NodeP(ctx.ast.nodes, call_tpl)^.next := a_first;
  outer := NewNode(ctx, N_CALL, tpl_tok);
  NodeP(ctx.ast.nodes, outer)^.e1 := tag;
  NodeP(ctx.ast.nodes, outer)^.e2 := call_tpl;
  BuildTagged := outer;
End;

Function ParseArrayLiteral(Var ctx: TCompilerContext): LongInt;
Var
  node, el, first, last: LongInt;
Begin
  node := NewNode(ctx, N_ARRAY_LIT, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, ']') And Not CurIsEof(ctx) Do
    Begin
      If CurIsP(ctx, ',') Then
        Begin
          el := NewNode(ctx, N_ELISION, ctx.ast.pt);
          PAdvance(ctx);
          ListAdd(ctx, first, last, el);
        End
      Else
        Begin
          If CurIsP(ctx, '...') Then
            Begin
              el := NewNode(ctx, N_SPREAD, ctx.ast.pt);
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, el)^.e1 := ParseAssign(ctx, False);
            End
          Else
            el := ParseAssign(ctx, False);
          If el = 0 Then
            Break;
          ListAdd(ctx, first, last, el);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
    End;
  Expect(ctx, ']');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseArrayLiteral := node;
End;

Function ParseObjectLiteral(Var ctx: TCompilerContext): LongInt;
Var
  node, prop, first, last, key_tok, fn, nx: LongInt;
  flags, fflags: LongInt;

  { Le jeton courant est un modificateur (get, set, async) si un nom de
    propriete le suit. }
  Function IsModifier: Boolean;
  Begin
    nx := PeekIdx(ctx, 1);
    IsModifier := IsPropNameStart(ctx, nx) Or
                  (TkIsP(ctx, nx, '*') And TkIsId(ctx, ctx.ast.pt, 'async'));
  End;

Begin
  node := NewNode(ctx, N_OBJECT_LIT, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) Do
    Begin
      prop := NewNode(ctx, N_PROP, ctx.ast.pt);
      flags := 0;
      fflags := FN_METHOD;
      If CurIsP(ctx, '...') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, prop)^.flags := PR_SPREAD;
          NodeP(ctx.ast.nodes, prop)^.e1 := ParseAssign(ctx, False);
        End
      Else
        Begin
          If TkIsId(ctx, ctx.ast.pt, 'async') And IsModifier And
             Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
            Begin
              PAdvance(ctx);
              fflags := fflags Or FN_ASYNC;
              flags := flags Or PR_METHOD;
            End;
          If CurIsP(ctx, '*') Then
            Begin
              PAdvance(ctx);
              fflags := fflags Or FN_GENERATOR;
              flags := flags Or PR_METHOD;
            End;
          If (TkIsId(ctx, ctx.ast.pt, 'get') Or TkIsId(ctx, ctx.ast.pt, 'set')) And
             IsModifier Then
            Begin
              If TkIsId(ctx, ctx.ast.pt, 'get') Then
                flags := flags Or PR_GETTER
              Else
                flags := flags Or PR_SETTER;
              PAdvance(ctx);
            End;
          key_tok := ctx.ast.pt;
          NodeP(ctx.ast.nodes, prop)^.tok := key_tok;
          If CurIsP(ctx, '[') Then
            Begin
              PAdvance(ctx);
              flags := flags Or PR_COMPUTED;
              NodeP(ctx.ast.nodes, prop)^.e2 := ParseAssign(ctx, False);
              Expect(ctx, ']');
            End
          Else If IsPropertyNameTok(ctx, key_tok) Then
            PAdvance(ctx)
          Else
            Begin
              ParseError(ctx, key_tok, 'nom de propriete attendu, trouve ' +
                         TokenDesc(ctx, key_tok));
              Break;
            End;
          If CurIsP(ctx, '(') Then
            Begin
              fn := NewNode(ctx, N_FUNC_EXPR, key_tok);
              NodeP(ctx.ast.nodes, fn)^.flags := fflags;
              flags := flags Or PR_METHOD;
              ParseFuncRest(ctx, fn);
              NodeP(ctx.ast.nodes, prop)^.e1 := fn;
            End
          Else If flags And (PR_METHOD Or PR_GETTER Or PR_SETTER) <> 0 Then
            Begin
              ParseError(ctx, ctx.ast.pt, '"(" attendu apres le nom de methode, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End
          Else If CurIsP(ctx, ':') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.e1 := ParseAssign(ctx, False);
            End
          Else If (TokP(ctx.lex.tokens, key_tok)^.kind = TK_IDENT) And
                  (flags And PR_COMPUTED = 0) And
                  (CurIsP(ctx, ',') Or CurIsP(ctx, '}') Or CurIsP(ctx, '=')) Then
            Begin
              flags := flags Or PR_SHORTHAND;
              fn := NewNode(ctx, N_IDENT, key_tok);
              NodeP(ctx.ast.nodes, prop)^.e1 := fn;
              { a = 1 : valeur par defaut d'un motif d'affectation }
              If CurIsP(ctx, '=') Then
                Begin
                  PAdvance(ctx);
                  flags := flags Or PR_DEFAULT;
                  NodeP(ctx.ast.nodes, prop)^.e3 := ParseAssign(ctx, False);
                End;
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, '":" attendu apres le nom de propriete, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          NodeP(ctx.ast.nodes, prop)^.flags := flags;
        End;
      ListAdd(ctx, first, last, prop);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, '}');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseObjectLiteral := node;
End;

Function ParseFunctionExpr(Var ctx: TCompilerContext; is_async: Boolean): LongInt;
Var
  node, name_tok, save_scope, flags: LongInt;
  has_name: Boolean;
Begin
  flags := 0;
  If is_async Then
    Begin
      flags := flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  name_tok := ctx.ast.pt;
  PAdvance(ctx);
  If CurIsP(ctx, '*') Then
    Begin
      flags := flags Or FN_GENERATOR;
      PAdvance(ctx);
    End;
  has_name := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT;
  If has_name Then
    name_tok := ctx.ast.pt;
  node := NewNode(ctx, N_FUNC_EXPR, name_tok);
  NodeP(ctx.ast.nodes, node)^.flags := flags;
  If has_name Then
    Begin
      PAdvance(ctx);
      { le nom d'une expression de fonction vit dans sa propre portee }
      save_scope := ctx.ast.cur_scope;
      ctx.ast.cur_scope := node;
      DeclareName(ctx, DK_FNAME, name_tok, node);
      ctx.ast.cur_scope := save_scope;
    End;
  ParseFuncRest(ctx, node);
  ParseFunctionExpr := node;
End;

{ Fonction fleche : x => ..., (a, b) => ..., async x => ... }
Function ParseArrowFn(Var ctx: TCompilerContext; is_async, no_in: Boolean): LongInt;
Var
  node, par, bnd: LongInt;
  sv: TFuncSave;
Begin
  node := NewNode(ctx, N_FUNC_EXPR, ctx.ast.pt);
  ParseArrowFn := node;
  NodeP(ctx.ast.nodes, node)^.flags := FN_ARROW;
  If is_async Then
    Begin
      NodeP(ctx.ast.nodes, node)^.flags := NodeP(ctx.ast.nodes, node)^.flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  EnterFunc(ctx, node, sv);
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      par := NewNode(ctx, N_PARAM, ctx.ast.pt);
      bnd := NewNode(ctx, N_BIND_IDENT, ctx.ast.pt);
      DeclareName(ctx, DK_PARAM, ctx.ast.pt, bnd);
      NodeP(ctx.ast.nodes, par)^.e1 := bnd;
      NodeP(ctx.ast.nodes, node)^.e1 := par;
      PAdvance(ctx);
    End
  Else
    ParseParamList(ctx, node);
  If Expect(ctx, '=>') Then
    Begin
      If CurIsP(ctx, '{') Then
        NodeP(ctx.ast.nodes, node)^.e2 := ParseFuncBlock(ctx)
      Else
        Begin
          NodeP(ctx.ast.nodes, node)^.flags := NodeP(ctx.ast.nodes, node)^.flags Or FN_EXPR_BODY;
          NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, no_in);
        End;
    End;
  LeaveFunc(ctx, sv);
End;

Function ParsePrimary(Var ctx: TCompilerContext): LongInt;
Var
  node, t, bg_tok, bg_str: LongInt;
  s: TTokenText;
Begin
  ParsePrimary := 0;
  t := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, t)^.text;
  Case TokP(ctx.lex.tokens, t)^.kind Of
    TK_IDENT:
      Begin
        If (s = 'async') And TkIsKw(ctx, PeekIdx(ctx, 1), 'function') And
           Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
          ParsePrimary := ParseFunctionExpr(ctx, True)
        Else
          Begin
            ParsePrimary := NewNode(ctx, N_IDENT, t);
            PAdvance(ctx);
          End;
      End;
    TK_NUMBER:
      Begin
        ParsePrimary := NewNode(ctx, N_NUMBER, t);
        PAdvance(ctx);
      End;
    TK_STRING:
      Begin
        node := NewNode(ctx, N_STRING, t);
        ParsePrimary := node;
        If TokP(ctx.lex.tokens, t)^.flag_len = 1 Then
          Begin
            { litteral BigInt : __BigInt("chiffres") }
            bg_tok := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, t)^.line,
                               TokP(ctx.lex.tokens, t)^.col, ctx.lex.pos);
            TokP(ctx.lex.tokens, bg_tok)^.text := '__BigInt';
            bg_str := node;
            node := NewNode(ctx, N_CALL, t);
            NodeP(ctx.ast.nodes, node)^.e1 := NewNode(ctx, N_IDENT, bg_tok);
            NodeP(ctx.ast.nodes, node)^.e2 := bg_str;
            ParsePrimary := node;
          End;
        PAdvance(ctx);
      End;
    TK_REGEX:
      Begin
        ParsePrimary := NewNode(ctx, N_REGEX, t);
        PAdvance(ctx);
      End;
    TK_TEMPLATE:
      Begin
        If (TokP(ctx.lex.tokens, t)^.tpl = TP_NOSUB) Or
           (TokP(ctx.lex.tokens, t)^.tpl = TP_HEAD) Then
          ParsePrimary := ParseTemplate(ctx)
        Else
          ParseError(ctx, t, 'gabarit inattendu');
      End;
    TK_KEYWORD:
      Begin
        If s = 'this' Then
          node := NewNode(ctx, N_THIS, t)
        Else If s = 'super' Then
          node := NewNode(ctx, N_SUPER, t)
        Else If s = 'null' Then
          node := NewNode(ctx, N_NULL, t)
        Else If (s = 'true') Or (s = 'false') Then
          node := NewNode(ctx, N_BOOL, t)
        Else If s = 'function' Then
          Begin
            ParsePrimary := ParseFunctionExpr(ctx, False);
            Exit;
          End
        Else If s = 'class' Then
          Begin
            ParsePrimary := ParseClass(ctx, False);
            Exit;
          End
        Else
          Begin
            ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
            Exit;
          End;
        PAdvance(ctx);
        ParsePrimary := node;
      End;
    TK_PUNCT:
      Begin
        If s = '(' Then
          Begin
            PAdvance(ctx);
            node := ParseExpr(ctx, False);
            Expect(ctx, ')');
            If node <> 0 Then
              NodeP(ctx.ast.nodes, node)^.paren := True;
            ParsePrimary := node;
          End
        Else If s = '[' Then
          ParsePrimary := ParseArrayLiteral(ctx)
        Else If s = '{' Then
          ParsePrimary := ParseObjectLiteral(ctx)
        Else
          ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
      End;
  Else
    ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
  End;
End;

{ new X(args) : le callee est un membre sans appel. }
Function ParseNew(Var ctx: TCompilerContext): LongInt;
Var
  node, callee, m, name_tok, nt_tok: LongInt;
Begin
  node := NewNode(ctx, N_NEW, ctx.ast.pt);
  ParseNew := node;
  PAdvance(ctx);
  If CurIsP(ctx, '.') Then
    Begin
      { new.target : identifiant cache resolu comme arguments }
      PAdvance(ctx);
      If Not ((TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT) And
              (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = 'target')) Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"target" attendu apres "new."');
          Exit;
        End;
      nt_tok := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, ctx.ast.pt)^.line,
                         TokP(ctx.lex.tokens, ctx.ast.pt)^.col, ctx.lex.pos);
      TokP(ctx.lex.tokens, nt_tok)^.text := 'new.target';
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.kind := N_IDENT;
      NodeP(ctx.ast.nodes, node)^.tok := nt_tok;
      Exit;
    End;
  If CurIsKw(ctx, 'new') Then
    callee := ParseNew(ctx)
  Else
    callee := ParsePrimary(ctx);
  While (callee <> 0) And (CurIsP(ctx, '.') Or CurIsP(ctx, '[')) Do
    Begin
      If CurIsP(ctx, '.') Then
        Begin
          PAdvance(ctx);
          name_tok := ctx.ast.pt;
          If Not IsPropertyNameTok(ctx, name_tok) Or
             (TokP(ctx.lex.tokens, name_tok)^.kind in [TK_STRING, TK_NUMBER]) Then
            Begin
              ParseError(ctx, name_tok, 'nom de propriete attendu apres ".", trouve ' +
                         TokenDesc(ctx, name_tok));
              Break;
            End;
          m := NewNode(ctx, N_MEMBER, name_tok);
          NodeP(ctx.ast.nodes, m)^.e1 := callee;
          PAdvance(ctx);
        End
      Else
        Begin
          m := NewNode(ctx, N_INDEX, ctx.ast.pt);
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, m)^.e1 := callee;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseExpr(ctx, False);
          Expect(ctx, ']');
        End;
      callee := m;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := callee;
  If CurIsP(ctx, '(') Then
    NodeP(ctx.ast.nodes, node)^.e2 := ParseCallArgs(ctx);
End;

{ Expression gauche : primaire suivi d'acces, d'appels, de ?. et de
  gabarits etiquetes. }
Function ParseLHS(Var ctx: TCompilerContext): LongInt;
Var
  e, m, name_tok: LongInt;
  optional: Boolean;
Begin
  If CurIsKw(ctx, 'new') Then
    e := ParseNew(ctx)
  Else
    e := ParsePrimary(ctx);
  ParseLHS := e;
  If e = 0 Then
    Exit;
  While True Do
    Begin
      optional := False;
      If CurIsP(ctx, '?.') Then
        Begin
          optional := True;
          PAdvance(ctx);
        End;
      If CurIsP(ctx, '(') Then
        Begin
          m := NewNode(ctx, N_CALL, ctx.ast.pt);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseCallArgs(ctx);
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
        End
      Else If CurIsP(ctx, '[') Then
        Begin
          m := NewNode(ctx, N_INDEX, ctx.ast.pt);
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseExpr(ctx, False);
          Expect(ctx, ']');
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
        End
      Else If optional Or CurIsP(ctx, '.') Then
        Begin
          If Not optional Then
            PAdvance(ctx);
          name_tok := ctx.ast.pt;
          If Not IsPropertyNameTok(ctx, name_tok) Or
             (TokP(ctx.lex.tokens, name_tok)^.kind in [TK_STRING, TK_NUMBER]) Then
            Begin
              ParseError(ctx, name_tok, 'nom de propriete attendu apres ".", trouve ' +
                         TokenDesc(ctx, name_tok));
              Exit;
            End;
          m := NewNode(ctx, N_MEMBER, name_tok);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
          PAdvance(ctx);
        End
      Else If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_TEMPLATE) And
              ((TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_NOSUB) Or
               (TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_HEAD)) Then
        Begin
          m := BuildTagged(ctx, e);
        End
      Else
        Break;
      e := m;
      ParseLHS := e;
    End;
End;

{ La fonction courante est-elle un generateur (gen) ou une fonction async ? }
Function CurFuncHas(Var ctx: TCompilerContext; gen: Boolean): Boolean;
Var
  f: LongInt;
Begin
  f := ctx.ast.cur_func;
  CurFuncHas := False;
  If (f = 0) Or (f = ctx.ast.root) Then
    Exit;
  If NodeP(ctx.ast.nodes, f)^.kind = N_METHOD Then
    Begin
      If gen Then
        CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And MF_GENERATOR <> 0
      Else
        CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And MF_ASYNC <> 0;
    End
  Else If gen Then
    CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And FN_GENERATOR <> 0
  Else
    CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And FN_ASYNC <> 0;
End;

{ Le jeton courant peut-il commencer une expression (apres yield) ? }
Function StartsExpr(Var ctx: TCompilerContext): Boolean;
Var
  t: LongInt;
  s: TTokenText;
Begin
  t := ctx.ast.pt;
  StartsExpr := True;
  If (TokP(ctx.lex.tokens, t)^.kind = TK_EOF) Or TokP(ctx.lex.tokens, t)^.nl_before Then
    StartsExpr := False
  Else If TokP(ctx.lex.tokens, t)^.kind = TK_PUNCT Then
    Begin
      s := TokP(ctx.lex.tokens, t)^.text;
      If (s = ')') Or (s = ']') Or (s = '}') Or (s = ',') Or (s = ';') Or (s = ':') Then
        StartsExpr := False;
    End;
End;

Function ParseUnary(Var ctx: TCompilerContext): LongInt;
Var
  node, t, operand: LongInt;
  s: TTokenText;
  is_op: Boolean;
Begin
  t := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, t)^.text;
  is_op := False;
  If TkIsId(ctx, t, 'await') And CurFuncHas(ctx, False) Then
    Begin
      node := NewNode(ctx, N_UNARY, t);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseUnary(ctx);
      ParseUnary := node;
      Exit;
    End;
  If TokP(ctx.lex.tokens, t)^.kind = TK_OPERATOR Then
    { & unaire : operateur de reference &fn, extension utilisee par test22.js }
    is_op := (s = '!') Or (s = '~') Or (s = '+') Or (s = '-') Or (s = '&')
  Else If TokP(ctx.lex.tokens, t)^.kind = TK_KEYWORD Then
    is_op := (s = 'typeof') Or (s = 'void') Or (s = 'delete');
  If is_op Then
    Begin
      node := NewNode(ctx, N_UNARY, t);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseUnary(ctx);
      ParseUnary := node;
    End
  Else If (TokP(ctx.lex.tokens, t)^.kind = TK_OPERATOR) And
          ((s = '++') Or (s = '--')) Then
    Begin
      node := NewNode(ctx, N_UPDATE, t);
      NodeP(ctx.ast.nodes, node)^.flags := UF_PREFIX;
      PAdvance(ctx);
      operand := ParseUnary(ctx);
      If (operand <> 0) And Not IsSimpleTarget(ctx, operand) Then
        ParseError(ctx, t, 'operande invalide pour ' + s);
      NodeP(ctx.ast.nodes, node)^.e1 := operand;
      ParseUnary := node;
    End
  Else
    Begin
      operand := ParseLHS(ctx);
      ParseUnary := operand;
      If (operand <> 0) And (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_OPERATOR) And
         ((TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '++') Or
          (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '--')) And
         Not TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
        Begin
          If Not IsSimpleTarget(ctx, operand) Then
            ParseError(ctx, ctx.ast.pt, 'operande invalide pour ' +
                       TokP(ctx.lex.tokens, ctx.ast.pt)^.text);
          node := NewNode(ctx, N_UPDATE, ctx.ast.pt);
          NodeP(ctx.ast.nodes, node)^.e1 := operand;
          PAdvance(ctx);
          ParseUnary := node;
        End;
    End;
End;

{ Operateurs binaires par escalade de precedence ; ** est associatif a
  droite. }
Function ParseBinary(Var ctx: TCompilerContext; min_prec: LongInt;
                     no_in: Boolean): LongInt;
Var
  left, right, node, op_tok, prec: LongInt;
  s: TTokenText;
  is_logical: Boolean;
Begin
  left := ParseUnary(ctx);
  ParseBinary := left;
  If left = 0 Then
    Exit;
  While True Do
    Begin
      op_tok := ctx.ast.pt;
      s := TokP(ctx.lex.tokens, op_tok)^.text;
      prec := 0;
      If TokP(ctx.lex.tokens, op_tok)^.kind = TK_OPERATOR Then
        prec := BinPrec(s)
      Else If TokP(ctx.lex.tokens, op_tok)^.kind = TK_KEYWORD Then
        Begin
          If (s = 'instanceof') Or ((s = 'in') And Not no_in) Then
            prec := 8;
        End;
      If (prec = 0) Or (prec < min_prec) Then
        Break;
      PAdvance(ctx);
      If s = '**' Then
        right := ParseBinary(ctx, prec, no_in)
      Else
        right := ParseBinary(ctx, prec + 1, no_in);
      is_logical := (s = '&&') Or (s = '||') Or (s = '??');
      If is_logical Then
        node := NewNode(ctx, N_LOGICAL, op_tok)
      Else
        node := NewNode(ctx, N_BINARY, op_tok);
      NodeP(ctx.ast.nodes, node)^.e1 := left;
      NodeP(ctx.ast.nodes, node)^.e2 := right;
      { -a ** b est ambigu et interdit }
      If (s = '**') And (NodeP(ctx.ast.nodes, left)^.kind = N_UNARY) And
         Not NodeP(ctx.ast.nodes, left)^.paren Then
        ParseError(ctx, op_tok, 'operande unaire interdit a gauche de **, ajouter des parentheses');
      { a ?? b || c est interdit sans parentheses }
      If is_logical Then
        Begin
          If (s = '??') Then
            Begin
              If ((NodeP(ctx.ast.nodes, left)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, left)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, left)^.tok)^.text <> '??')) Or
                 ((right <> 0) And (NodeP(ctx.ast.nodes, right)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, right)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, right)^.tok)^.text <> '??')) Then
                ParseError(ctx, op_tok, '?? ne peut pas etre melange avec || ou && sans parentheses');
            End
          Else
            Begin
              If ((NodeP(ctx.ast.nodes, left)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, left)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, left)^.tok)^.text = '??')) Or
                 ((right <> 0) And (NodeP(ctx.ast.nodes, right)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, right)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, right)^.tok)^.text = '??')) Then
                ParseError(ctx, op_tok, '?? ne peut pas etre melange avec || ou && sans parentheses');
            End;
        End;
      left := node;
      ParseBinary := left;
    End;
End;

Function ParseConditional(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  test, node: LongInt;
Begin
  test := ParseBinary(ctx, 1, no_in);
  ParseConditional := test;
  If (test <> 0) And CurIsP(ctx, '?') Then
    Begin
      node := NewNode(ctx, N_COND, ctx.ast.pt);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := test;
      NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, False);
      If Expect(ctx, ':') Then
        NodeP(ctx.ast.nodes, node)^.e3 := ParseAssign(ctx, no_in);
      ParseConditional := node;
    End;
End;

Function ParseAssign(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  left, right, node, op_tok: LongInt;
  s: TTokenText;
  is_async: Boolean;
Begin
  If TkIsId(ctx, ctx.ast.pt, 'yield') And CurFuncHas(ctx, True) Then
    Begin
      node := NewNode(ctx, N_UNARY, ctx.ast.pt);
      PAdvance(ctx);
      If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_OPERATOR) And
         (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '*') Then
        Begin
          NodeP(ctx.ast.nodes, node)^.flags := 1;
          PAdvance(ctx);
        End;
      If StartsExpr(ctx) Or (NodeP(ctx.ast.nodes, node)^.flags = 1) Then
        NodeP(ctx.ast.nodes, node)^.e1 := ParseAssign(ctx, no_in);
      ParseAssign := node;
      Exit;
    End;
  If IsArrowAhead(ctx, is_async) Then
    Begin
      ParseAssign := ParseArrowFn(ctx, is_async, no_in);
      Exit;
    End;
  left := ParseConditional(ctx, no_in);
  ParseAssign := left;
  If left = 0 Then
    Exit;
  op_tok := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, op_tok)^.text;
  If (TokP(ctx.lex.tokens, op_tok)^.kind = TK_OPERATOR) And IsAssignOp(s) Then
    Begin
      If s = '=' Then
        Begin
          If Not IsPatternTarget(ctx, left) Then
            ParseError(ctx, op_tok, 'cible d''affectation invalide');
        End
      Else If Not IsSimpleTarget(ctx, left) Then
        ParseError(ctx, op_tok, 'cible d''affectation invalide pour ' + s);
      PAdvance(ctx);
      right := ParseAssign(ctx, no_in);
      node := NewNode(ctx, N_ASSIGN, op_tok);
      NodeP(ctx.ast.nodes, node)^.e1 := left;
      NodeP(ctx.ast.nodes, node)^.e2 := right;
      ParseAssign := node;
    End;
End;

{ Expression complete, avec virgules (sequence). }
Function ParseExpr(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  first, last, e, seq: LongInt;
Begin
  e := ParseAssign(ctx, no_in);
  ParseExpr := e;
  If (e <> 0) And CurIsP(ctx, ',') Then
    Begin
      seq := NewNode(ctx, N_SEQUENCE, ctx.ast.pt);
      first := 0;
      last := 0;
      ListAdd(ctx, first, last, e);
      While CurIsP(ctx, ',') Do
        Begin
          PAdvance(ctx);
          e := ParseAssign(ctx, no_in);
          If e = 0 Then
            Break;
          ListAdd(ctx, first, last, e);
        End;
      NodeP(ctx.ast.nodes, seq)^.e1 := first;
      ParseExpr := seq;
    End;
End;

{ ---- Fonctions ---- }

Function ParseStatement(Var ctx: TCompilerContext): LongInt; Forward;
Function ParseBlock(Var ctx: TCompilerContext; new_scope: Boolean): LongInt; Forward;

Function ParseStmtList(Var ctx: TCompilerContext): LongInt;
Var
  first, last, st, before: LongInt;
Begin
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      st := ParseStatement(ctx);
      ListAdd(ctx, first, last, st);
      If ctx.ast.pt = before Then
        PAdvance(ctx);
      If ctx.errors >= MAX_ERRORS Then
        Break;
    End;
  ParseStmtList := first;
End;

Function ParseParam(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_PARAM, ctx.ast.pt);
  If CurIsP(ctx, '...') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.flags := PF_REST;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := ParseBindingTarget(ctx, DK_PARAM);
  If NodeP(ctx.ast.nodes, node)^.flags <> PF_REST Then
    NodeP(ctx.ast.nodes, node)^.e2 := ParseBindingDefault(ctx);
  ParseParam := node;
End;

{ Liste de parametres : ( a, b = 1, ...c ). Le jeton courant est la
  parenthese ouvrante ; la liste est rangee dans node.e1. }
Procedure ParseParamList(Var ctx: TCompilerContext; node: LongInt);
Var
  first, last, p: LongInt;
Begin
  first := 0;
  last := 0;
  If Expect(ctx, '(') Then
    Begin
      While Not CurIsP(ctx, ')') And Not CurIsEof(ctx) Do
        Begin
          p := ParseParam(ctx);
          If p = 0 Then
            Break;
          ListAdd(ctx, first, last, p);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
      Expect(ctx, ')');
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := first;
End;

{ Corps de fonction entre accolades, dans la portee de la fonction. }
Function ParseFuncBlock(Var ctx: TCompilerContext): LongInt;
Var
  body: LongInt;
Begin
  body := NewNode(ctx, N_BLOCK, ctx.ast.pt);
  NodeP(ctx.ast.nodes, body)^.flags := 1;
  If Expect(ctx, '{') Then
    Begin
      NodeP(ctx.ast.nodes, body)^.e1 := ParseStmtList(ctx);
      Expect(ctx, '}');
    End;
  ParseFuncBlock := body;
End;

{ Parametres puis corps, dans la portee du noeud fonction/methode. Le
  jeton courant est la parenthese ouvrante. }
Procedure ParseFuncRest(Var ctx: TCompilerContext; node: LongInt);
Var
  sv: TFuncSave;
Begin
  EnterFunc(ctx, node, sv);
  ParseParamList(ctx, node);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseFuncBlock(ctx);
  LeaveFunc(ctx, sv);
End;

{ function [*] nom (...) corps. Le jeton courant est function (ou async
  si is_async). }
Function ParseFunctionDecl(Var ctx: TCompilerContext; is_async: Boolean): LongInt;
Var
  node, name_tok: LongInt;
  flags: LongInt;
Begin
  flags := 0;
  If is_async Then
    Begin
      flags := flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  PAdvance(ctx);
  If CurIsP(ctx, '*') Then
    Begin
      flags := flags Or FN_GENERATOR;
      PAdvance(ctx);
    End;
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind <> TK_IDENT Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de fonction attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseFunctionDecl := 0;
      Exit;
    End;
  name_tok := ctx.ast.pt;
  node := NewNode(ctx, N_FUNC_DECL, name_tok);
  NodeP(ctx.ast.nodes, node)^.flags := flags;
  DeclareName(ctx, DK_FUNC, name_tok, node);
  PAdvance(ctx);
  ParseFuncRest(ctx, node);
  ParseFunctionDecl := node;
End;

{ ---- Classes ---- }

Function ParseClassMember(Var ctx: TCompilerContext; has_ctor: Boolean): LongInt;
Var
  node, key_tok, nx, blk: LongInt;
  flags: LongInt;
  is_method: Boolean;

  { Vrai si le jeton suivant est un nom : le jeton courant est alors un
    modificateur (static, async, get, set) et non le nom du membre. }
  Function IsModifier: Boolean;
  Begin
    nx := PeekIdx(ctx, 1);
    IsModifier := Not (TkIsP(ctx, nx, '(') Or TkIsP(ctx, nx, '=') Or
                       TkIsP(ctx, nx, ';') Or TkIsP(ctx, nx, '}')) And
                  (TokP(ctx.lex.tokens, nx)^.kind <> TK_EOF);
  End;

Begin
  ParseClassMember := 0;
  flags := 0;
  If CurIsKw(ctx, 'static') And IsModifier Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_STATIC;
      If CurIsP(ctx, '{') Then
        Begin
          node := NewNode(ctx, N_STATIC_BLOCK, ctx.ast.pt);
          NodeP(ctx.ast.nodes, node)^.flags := MF_STATIC;
          blk := ParseBlock(ctx, True);
          NodeP(ctx.ast.nodes, node)^.e1 := blk;
          ParseClassMember := node;
          Exit;
        End;
    End;
  If TkIsId(ctx, ctx.ast.pt, 'async') And IsModifier And
     Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_ASYNC;
    End;
  If CurIsP(ctx, '*') Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_GENERATOR;
    End;
  If (TkIsId(ctx, ctx.ast.pt, 'get') Or TkIsId(ctx, ctx.ast.pt, 'set')) And
     IsModifier Then
    Begin
      If TkIsId(ctx, ctx.ast.pt, 'get') Then
        flags := flags Or MF_GETTER
      Else
        flags := flags Or MF_SETTER;
      PAdvance(ctx);
    End;

  key_tok := ctx.ast.pt;
  node := NewNode(ctx, N_METHOD, key_tok);
  If CurIsP(ctx, '[') Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_COMPUTED;
      NodeP(ctx.ast.nodes, node)^.e3 := ParseAssign(ctx, False);
      Expect(ctx, ']');
    End
  Else If IsPropertyNameTok(ctx, ctx.ast.pt) Then
    PAdvance(ctx)
  Else
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de membre de classe attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseClassMember := 0;
      Exit;
    End;

  is_method := CurIsP(ctx, '(');
  If is_method Then
    Begin
      If (flags And (MF_STATIC Or MF_COMPUTED) = 0) And
         (TokP(ctx.lex.tokens, key_tok)^.text = 'constructor') And
         (TokP(ctx.lex.tokens, key_tok)^.kind <> TK_STRING) Then
        Begin
          flags := flags Or MF_CONSTRUCTOR;
          If has_ctor Then
            ParseError(ctx, key_tok, 'une classe ne peut avoir qu''un seul constructeur');
        End;
      NodeP(ctx.ast.nodes, node)^.flags := flags;
      ParseFuncRest(ctx, node);
    End
  Else
    Begin
      NodeP(ctx.ast.nodes, node)^.kind := N_FIELD;
      NodeP(ctx.ast.nodes, node)^.flags := flags;
      If CurIsP(ctx, '=') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, node)^.e1 := ParseAssign(ctx, False);
        End;
      ConsumeSemi(ctx);
    End;
  ParseClassMember := node;
End;

{ class [Nom] [extends expr] corps. Declaration (nom obligatoire) ou
  expression de classe. }
Function ParseClass(Var ctx: TCompilerContext; is_decl: Boolean): LongInt;
Var
  node, name_tok, first, last, m, before, save_scope: LongInt;
  has_ctor, has_name: Boolean;
Begin
  name_tok := ctx.ast.pt;
  PAdvance(ctx);
  has_name := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT;
  If is_decl And Not has_name Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de classe attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseClass := 0;
      Exit;
    End;
  If has_name Then
    name_tok := ctx.ast.pt;
  If is_decl Then
    node := NewNode(ctx, N_CLASS_DECL, name_tok)
  Else
    node := NewNode(ctx, N_CLASS_EXPR, name_tok);
  If is_decl Then
    DeclareName(ctx, DK_CLASS, name_tok, node);
  If has_name Then
    PAdvance(ctx);
  { la classe ouvre une portee : le nom d'une expression de classe y vit }
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;
  If has_name And Not is_decl Then
    DeclareName(ctx, DK_FNAME, name_tok, node);
  If CurIsKw(ctx, 'extends') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseLHS(ctx);
    End;
  first := 0;
  last := 0;
  has_ctor := False;
  If Expect(ctx, '{') Then
    Begin
      While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And
            Not ctx.ast.stop Do
        Begin
          If CurIsP(ctx, ';') Then
            PAdvance(ctx)
          Else
            Begin
              before := ctx.ast.pt;
              m := ParseClassMember(ctx, has_ctor);
              If (m <> 0) And (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
                 (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR <> 0) Then
                has_ctor := True;
              ListAdd(ctx, first, last, m);
              If ctx.ast.pt = before Then
                PAdvance(ctx);
              If ctx.errors >= MAX_ERRORS Then
                Break;
            End;
        End;
      Expect(ctx, '}');
    End;
  NodeP(ctx.ast.nodes, node)^.e2 := first;
  ctx.ast.cur_scope := save_scope;
  ParseClass := node;
End;

{ ---- Instructions ---- }

Function ParseBlock(Var ctx: TCompilerContext; new_scope: Boolean): LongInt;
Var
  node, save_scope: LongInt;
Begin
  node := NewNode(ctx, N_BLOCK, ctx.ast.pt);
  ParseBlock := node;
  If Not Expect(ctx, '{') Then
    Exit;
  save_scope := ctx.ast.cur_scope;
  If new_scope Then
    ctx.ast.cur_scope := node;
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStmtList(ctx);
  ctx.ast.cur_scope := save_scope;
  Expect(ctx, '}');
End;

{ Condition entre parentheses : ( expression ) }
Function ParseParenExpr(Var ctx: TCompilerContext): LongInt;
Begin
  ParseParenExpr := 0;
  If Not Expect(ctx, '(') Then
    Exit;
  ParseParenExpr := ParseExpr(ctx, False);
  Expect(ctx, ')');
End;

Function ParseIf(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_IF, ctx.ast.pt);
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseStatement(ctx);
  If CurIsKw(ctx, 'else') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseStatement(ctx);
    End;
  ParseIf := node;
End;

Function ParseWhile(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_WHILE, ctx.ast.pt);
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  Inc(ctx.ast.loop_depth);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseStatement(ctx);
  Dec(ctx.ast.loop_depth);
  ParseWhile := node;
End;

Function ParseDoWhile(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_DO_WHILE, ctx.ast.pt);
  PAdvance(ctx);
  Inc(ctx.ast.loop_depth);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStatement(ctx);
  Dec(ctx.ast.loop_depth);
  If CurIsKw(ctx, 'while') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e2 := ParseParenExpr(ctx);
    End
  Else
    ParseError(ctx, ctx.ast.pt, '"while" attendu, trouve ' +
               TokenDesc(ctx, ctx.ast.pt));
  { le point-virgule apres do-while est toujours facultatif }
  If CurIsP(ctx, ';') Then
    PAdvance(ctx);
  ParseDoWhile := node;
End;

Function ParseFor(Var ctx: TCompilerContext): LongInt;
Var
  node, save_scope, init, test, upd, body: LongInt;
  is_of, is_in: Boolean;
  kind: TNodeKind;
Begin
  node := NewNode(ctx, N_FOR, ctx.ast.pt);
  ParseFor := node;
  PAdvance(ctx);
  If TkIsId(ctx, ctx.ast.pt, 'await') Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'for await n''est pas supporte');
      Synchronize(ctx);
      Exit;
    End;
  If Not Expect(ctx, '(') Then
    Begin
      Synchronize(ctx);
      Exit;
    End;
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;

  init := 0;
  If CurIsP(ctx, ';') Then
    { pas d'initialisation }
  Else If CurIsKw(ctx, 'var') Or CurIsKw(ctx, 'let') Or CurIsKw(ctx, 'const') Then
    init := ParseVarDecl(ctx, True)
  Else
    init := ParseExpr(ctx, True);

  is_in := CurIsKw(ctx, 'in');
  is_of := TkIsId(ctx, ctx.ast.pt, 'of');
  If (is_in Or is_of) And (init <> 0) Then
    Begin
      If NodeP(ctx.ast.nodes, init)^.kind = N_VAR_DECL Then
        Begin
          If (NodeP(ctx.ast.nodes, init)^.e1 = 0) Or
             (NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, init)^.e1)^.next <> 0) Then
            ParseError(ctx, ctx.ast.pt,
                       'une seule variable est permise dans for-in / for-of')
          Else If NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, init)^.e1)^.e2 <> 0 Then
            ParseError(ctx, ctx.ast.pt,
                       'initialiseur interdit dans for-in / for-of');
        End;
      If is_of Then
        kind := N_FOR_OF
      Else
        kind := N_FOR_IN;
      NodeP(ctx.ast.nodes, node)^.kind := kind;
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := init;
      If is_in Then
        NodeP(ctx.ast.nodes, node)^.e2 := ParseExpr(ctx, False)
      Else
        NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, False);
      Expect(ctx, ')');
      Inc(ctx.ast.loop_depth);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseStatement(ctx);
      Dec(ctx.ast.loop_depth);
    End
  Else
    Begin
      NodeP(ctx.ast.nodes, node)^.e1 := init;
      If Expect(ctx, ';') Then
        Begin
          test := 0;
          If Not CurIsP(ctx, ';') Then
            test := ParseExpr(ctx, False);
          NodeP(ctx.ast.nodes, node)^.e2 := test;
          If Expect(ctx, ';') Then
            Begin
              upd := 0;
              If Not CurIsP(ctx, ')') Then
                upd := ParseExpr(ctx, False);
              NodeP(ctx.ast.nodes, node)^.e3 := upd;
              If Expect(ctx, ')') Then
                Begin
                  Inc(ctx.ast.loop_depth);
                  body := ParseStatement(ctx);
                  Dec(ctx.ast.loop_depth);
                  NodeP(ctx.ast.nodes, node)^.e4 := body;
                End;
            End;
        End;
    End;
  ctx.ast.cur_scope := save_scope;
End;

Function ParseSwitch(Var ctx: TCompilerContext): LongInt;
Var
  node, save_scope, cs, first, last, sfirst, slast, st, before: LongInt;
  has_default: Boolean;
Begin
  node := NewNode(ctx, N_SWITCH, ctx.ast.pt);
  ParseSwitch := node;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  If Not Expect(ctx, '{') Then
    Begin
      Synchronize(ctx);
      Exit;
    End;
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;
  Inc(ctx.ast.switch_depth);
  first := 0;
  last := 0;
  has_default := False;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      If CurIsKw(ctx, 'case') Or CurIsKw(ctx, 'default') Then
        Begin
          cs := NewNode(ctx, N_CASE, ctx.ast.pt);
          If CurIsKw(ctx, 'case') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, cs)^.e1 := ParseExpr(ctx, False);
            End
          Else
            Begin
              If has_default Then
                ParseError(ctx, ctx.ast.pt, '"default" en double dans le switch');
              has_default := True;
              PAdvance(ctx);
            End;
          Expect(ctx, ':');
          sfirst := 0;
          slast := 0;
          While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And
                Not CurIsKw(ctx, 'case') And Not CurIsKw(ctx, 'default') And
                Not ctx.ast.stop Do
            Begin
              before := ctx.ast.pt;
              st := ParseStatement(ctx);
              ListAdd(ctx, sfirst, slast, st);
              If ctx.ast.pt = before Then
                PAdvance(ctx);
              If ctx.errors >= MAX_ERRORS Then
                Break;
            End;
          NodeP(ctx.ast.nodes, cs)^.e2 := sfirst;
          ListAdd(ctx, first, last, cs);
        End
      Else
        Begin
          ParseError(ctx, ctx.ast.pt, '"case" ou "default" attendu, trouve ' +
                     TokenDesc(ctx, ctx.ast.pt));
          Synchronize(ctx);
          If ctx.ast.pt = before Then
            PAdvance(ctx);
        End;
      If ctx.errors >= MAX_ERRORS Then
        Break;
    End;
  NodeP(ctx.ast.nodes, node)^.e2 := first;
  Expect(ctx, '}');
  Dec(ctx.ast.switch_depth);
  ctx.ast.cur_scope := save_scope;
End;

Function ParseTry(Var ctx: TCompilerContext): LongInt;
Var
  node, cn, save_scope: LongInt;
Begin
  node := NewNode(ctx, N_TRY, ctx.ast.pt);
  ParseTry := node;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseBlock(ctx, True);
  If CurIsKw(ctx, 'catch') Then
    Begin
      cn := NewNode(ctx, N_CATCH, ctx.ast.pt);
      PAdvance(ctx);
      save_scope := ctx.ast.cur_scope;
      ctx.ast.cur_scope := cn;
      If CurIsP(ctx, '(') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, cn)^.e1 := ParseBindingTarget(ctx, DK_CATCH);
          Expect(ctx, ')');
        End;
      NodeP(ctx.ast.nodes, cn)^.e2 := ParseBlock(ctx, False);
      ctx.ast.cur_scope := save_scope;
      NodeP(ctx.ast.nodes, node)^.e2 := cn;
    End;
  If CurIsKw(ctx, 'finally') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseBlock(ctx, True);
    End;
  If (NodeP(ctx.ast.nodes, node)^.e2 = 0) And (NodeP(ctx.ast.nodes, node)^.e3 = 0) Then
    ParseError(ctx, NodeP(ctx.ast.nodes, node)^.tok,
               'try exige un bloc catch ou finally');
End;

Function FindLabel(Var ctx: TCompilerContext; tok: LongInt): LongInt;
Var
  i: LongInt;
Begin
  FindLabel := 0;
  For i := 1 To ctx.ast.label_count Do
    If TokP(ctx.lex.tokens, LabelRecP(ctx.ast.labels, i)^.tok)^.text = TokP(ctx.lex.tokens, tok)^.text Then
      FindLabel := i;
End;

Function ParseBreakContinue(Var ctx: TCompilerContext; is_break: Boolean): LongInt;
Var
  node, lbl, kw_tok: LongInt;
Begin
  kw_tok := ctx.ast.pt;
  If is_break Then
    node := NewNode(ctx, N_BREAK, kw_tok)
  Else
    node := NewNode(ctx, N_CONTINUE, kw_tok);
  PAdvance(ctx);
  If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT) And
     Not TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    Begin
      NodeP(ctx.ast.nodes, node)^.e1 := ctx.ast.pt;
      lbl := FindLabel(ctx, ctx.ast.pt);
      If lbl = 0 Then
        ParseError(ctx, ctx.ast.pt, 'etiquette inconnue: ' +
                   TokP(ctx.lex.tokens, ctx.ast.pt)^.text)
      Else If (Not is_break) And (Not LabelRecP(ctx.ast.labels, lbl)^.is_loop) Then
        ParseError(ctx, ctx.ast.pt, 'continue exige une etiquette de boucle: ' +
                   TokP(ctx.lex.tokens, ctx.ast.pt)^.text);
      PAdvance(ctx);
    End
  Else If is_break Then
    Begin
      If ctx.ast.loop_depth + ctx.ast.switch_depth = 0 Then
        ParseError(ctx, kw_tok, 'break en dehors d''une boucle ou d''un switch');
    End
  Else If ctx.ast.loop_depth = 0 Then
    ParseError(ctx, kw_tok, 'continue en dehors d''une boucle');
  ConsumeSemi(ctx);
  ParseBreakContinue := node;
End;

Function ParseReturnThrow(Var ctx: TCompilerContext; is_return: Boolean): LongInt;
Var
  node, kw_tok: LongInt;
Begin
  kw_tok := ctx.ast.pt;
  If is_return Then
    Begin
      node := NewNode(ctx, N_RETURN, kw_tok);
      If ctx.ast.func_depth = 0 Then
        ParseError(ctx, kw_tok, 'return en dehors d''une fonction');
    End
  Else
    node := NewNode(ctx, N_THROW, kw_tok);
  PAdvance(ctx);
  If CurIsP(ctx, ';') Or CurIsP(ctx, '}') Or CurIsEof(ctx) Or
     TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    Begin
      If Not is_return Then
        ParseError(ctx, ctx.ast.pt, 'expression attendue apres throw');
    End
  Else
    NodeP(ctx.ast.nodes, node)^.e1 := ParseExpr(ctx, False);
  ConsumeSemi(ctx);
  ParseReturnThrow := node;
End;

Function ParseLabeled(Var ctx: TCompilerContext): LongInt;
Var
  node, lbl_tok: LongInt;
Begin
  lbl_tok := ctx.ast.pt;
  node := NewNode(ctx, N_LABELED, lbl_tok);
  ParseLabeled := node;
  If FindLabel(ctx, lbl_tok) <> 0 Then
    ParseError(ctx, lbl_tok, 'etiquette en double: ' +
               TokP(ctx.lex.tokens, lbl_tok)^.text);
  PAdvance(ctx);
  PAdvance(ctx);
  Inc(ctx.ast.label_count);
  LabelRecP(ctx.ast.labels, ctx.ast.label_count)^.tok := lbl_tok;
  LabelRecP(ctx.ast.labels, ctx.ast.label_count)^.is_loop :=
    CurIsKw(ctx, 'for') Or CurIsKw(ctx, 'while') Or CurIsKw(ctx, 'do');
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStatement(ctx);
  Dec(ctx.ast.label_count);
End;

Function ParseExprStatement(Var ctx: TCompilerContext): LongInt;
Var
  node, ex: LongInt;
Begin
  node := NewNode(ctx, N_EXPR_STMT, ctx.ast.pt);
  ex := ParseExpr(ctx, False);
  If ex = 0 Then
    Begin
      Synchronize(ctx);
      ParseExprStatement := 0;
      Exit;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := ex;
  ConsumeSemi(ctx);
  ParseExprStatement := node;
End;

Function ParseStatement(Var ctx: TCompilerContext): LongInt;
Var
  node, nx: LongInt;
  s: TTokenText;
Begin
  ParseStatement := 0;
  s := TokP(ctx.lex.tokens, ctx.ast.pt)^.text;
  If CurIsP(ctx, '{') Then
    ParseStatement := ParseBlock(ctx, True)
  Else If CurIsP(ctx, ';') Then
    Begin
      ParseStatement := NewNode(ctx, N_EMPTY, ctx.ast.pt);
      PAdvance(ctx);
    End
  Else If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_KEYWORD Then
    Begin
      If (s = 'var') Or (s = 'let') Or (s = 'const') Then
        Begin
          node := ParseVarDecl(ctx, False);
          ConsumeSemi(ctx);
          ParseStatement := node;
        End
      Else If s = 'if' Then
        ParseStatement := ParseIf(ctx)
      Else If s = 'for' Then
        ParseStatement := ParseFor(ctx)
      Else If s = 'while' Then
        ParseStatement := ParseWhile(ctx)
      Else If s = 'do' Then
        ParseStatement := ParseDoWhile(ctx)
      Else If s = 'switch' Then
        ParseStatement := ParseSwitch(ctx)
      Else If s = 'break' Then
        ParseStatement := ParseBreakContinue(ctx, True)
      Else If s = 'continue' Then
        ParseStatement := ParseBreakContinue(ctx, False)
      Else If s = 'return' Then
        ParseStatement := ParseReturnThrow(ctx, True)
      Else If s = 'throw' Then
        ParseStatement := ParseReturnThrow(ctx, False)
      Else If s = 'try' Then
        ParseStatement := ParseTry(ctx)
      Else If s = 'function' Then
        ParseStatement := ParseFunctionDecl(ctx, False)
      Else If s = 'class' Then
        ParseStatement := ParseClass(ctx, True)
      Else If s = 'debugger' Then
        Begin
          node := NewNode(ctx, N_DEBUGGER, ctx.ast.pt);
          PAdvance(ctx);
          ConsumeSemi(ctx);
          ParseStatement := node;
        End
      Else If (s = 'with') Or (s = 'import') Or (s = 'export') Or
              (s = 'enum') Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"' + s + '" n''est pas supporte');
          Synchronize(ctx);
        End
      Else If (s = 'else') Or (s = 'case') Or (s = 'default') Or
              (s = 'catch') Or (s = 'finally') Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"' + s + '" inattendu');
          Synchronize(ctx);
        End
      Else
        ParseStatement := ParseExprStatement(ctx);
    End
  Else If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      nx := PeekIdx(ctx, 1);
      If TkIsP(ctx, nx, ':') Then
        ParseStatement := ParseLabeled(ctx)
      Else If (s = 'async') And TkIsKw(ctx, nx, 'function') And
              Not TokP(ctx.lex.tokens, nx)^.nl_before Then
        ParseStatement := ParseFunctionDecl(ctx, True)
      Else
        ParseStatement := ParseExprStatement(ctx);
    End
  Else If CurIsP(ctx, '}') Then
    Begin
      ParseError(ctx, ctx.ast.pt, '"}" inattendu');
      PAdvance(ctx);
    End
  Else
    ParseStatement := ParseExprStatement(ctx);
End;

Function ParseProgram(Var ctx: TCompilerContext): Boolean;
Var
  first, last, st, before: LongInt;
Begin
  ParseProgram := False;
  If ctx.lex.token_count = 0 Then
    Begin
      PipelineError(ctx, 'jetons absents avant l''analyse syntaxique');
      Exit;
    End;
  ctx.ast.node_count := 0;
  ctx.ast.decl_count := 0;
  ctx.ast.analyzed := False;
  ctx.ast.pt := 1;
  ctx.ast.stop := False;
  ctx.ast.last_err_tok := 0;
  ctx.ast.loop_depth := 0;
  ctx.ast.switch_depth := 0;
  ctx.ast.func_depth := 0;
  ctx.ast.label_count := 0;
  ctx.ast.root := NewNode(ctx, N_PROGRAM, 1);
  ctx.ast.cur_scope := ctx.ast.root;
  ctx.ast.cur_func := ctx.ast.root;
  first := 0;
  last := 0;
  While Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      st := ParseStatement(ctx);
      ListAdd(ctx, first, last, st);
      If ctx.ast.pt = before Then
        PAdvance(ctx);
      If ctx.errors >= MAX_ERRORS Then
        Begin
          PipelineError(ctx, 'trop d''erreurs, arret du parseur');
          Break;
        End;
    End;
  NodeP(ctx.ast.nodes, ctx.ast.root)^.e1 := first;
  If ctx.options.verbose Then
    Writeln('AST    : ', ctx.ast.node_count, ' noeuds, ',
            ctx.ast.decl_count, ' declarations');
  ParseProgram := ctx.errors = 0;
End;

{ ---- Affichage de l'AST (option -ast) ---- }

Function NodeKindName(kind: TNodeKind): TString;
Begin
  Case kind Of
    N_PROGRAM:        NodeKindName := 'Program';
    N_BLOCK:          NodeKindName := 'Block';
    N_EMPTY:          NodeKindName := 'Empty';
    N_EXPR_STMT:      NodeKindName := 'ExprStmt';
    N_VAR_DECL:       NodeKindName := 'VarDecl';
    N_DECLARATOR:     NodeKindName := 'Declarator';
    N_BIND_IDENT:     NodeKindName := 'Bind';
    N_ARRAY_PATTERN:  NodeKindName := 'ArrayPattern';
    N_OBJECT_PATTERN: NodeKindName := 'ObjectPattern';
    N_PATTERN_ELEM:   NodeKindName := 'PatternElem';
    N_PATTERN_PROP:   NodeKindName := 'PatternProp';
    N_IF:             NodeKindName := 'If';
    N_SWITCH:         NodeKindName := 'Switch';
    N_CASE:           NodeKindName := 'Case';
    N_WHILE:          NodeKindName := 'While';
    N_DO_WHILE:       NodeKindName := 'DoWhile';
    N_FOR:            NodeKindName := 'For';
    N_FOR_IN:         NodeKindName := 'ForIn';
    N_FOR_OF:         NodeKindName := 'ForOf';
    N_BREAK:          NodeKindName := 'Break';
    N_CONTINUE:       NodeKindName := 'Continue';
    N_RETURN:         NodeKindName := 'Return';
    N_THROW:          NodeKindName := 'Throw';
    N_TRY:            NodeKindName := 'Try';
    N_CATCH:          NodeKindName := 'Catch';
    N_LABELED:        NodeKindName := 'Labeled';
    N_DEBUGGER:       NodeKindName := 'Debugger';
    N_FUNC_DECL:      NodeKindName := 'FuncDecl';
    N_PARAM:          NodeKindName := 'Param';
    N_CLASS_DECL:     NodeKindName := 'ClassDecl';
    N_METHOD:         NodeKindName := 'Method';
    N_FIELD:          NodeKindName := 'Field';
    N_STATIC_BLOCK:   NodeKindName := 'StaticBlock';
    N_NUMBER:         NodeKindName := 'Number';
    N_STRING:         NodeKindName := 'String';
    N_REGEX:          NodeKindName := 'Regex';
    N_TEMPLATE:       NodeKindName := 'Template';
    N_TEMPLATE_STR:   NodeKindName := 'TemplateStr';
    N_IDENT:          NodeKindName := 'Ident';
    N_THIS:           NodeKindName := 'This';
    N_SUPER:          NodeKindName := 'Super';
    N_NULL:           NodeKindName := 'Null';
    N_BOOL:           NodeKindName := 'Bool';
    N_ARRAY_LIT:      NodeKindName := 'ArrayLit';
    N_ELISION:        NodeKindName := 'Elision';
    N_SPREAD:         NodeKindName := 'Spread';
    N_OBJECT_LIT:     NodeKindName := 'ObjectLit';
    N_PROP:           NodeKindName := 'Prop';
    N_FUNC_EXPR:      NodeKindName := 'FuncExpr';
    N_CLASS_EXPR:     NodeKindName := 'ClassExpr';
    N_UNARY:          NodeKindName := 'Unary';
    N_UPDATE:         NodeKindName := 'Update';
    N_BINARY:         NodeKindName := 'Binary';
    N_LOGICAL:        NodeKindName := 'Logical';
    N_ASSIGN:         NodeKindName := 'Assign';
    N_COND:           NodeKindName := 'Cond';
    N_CALL:           NodeKindName := 'Call';
    N_NEW:            NodeKindName := 'New';
    N_MEMBER:         NodeKindName := 'Member';
    N_INDEX:          NodeKindName := 'Index';
    N_SEQUENCE:       NodeKindName := 'Sequence';
    N_TAGGED:         NodeKindName := 'TaggedTemplate';
  Else
    NodeKindName := 'Node';
  End;
End;

Function DeclKindName(kind: TDeclKind): TString;
Begin
  Case kind Of
    DK_VAR:   DeclKindName := 'var';
    DK_LET:   DeclKindName := 'let';
    DK_CONST: DeclKindName := 'const';
    DK_FUNC:  DeclKindName := 'function';
    DK_CLASS: DeclKindName := 'class';
    DK_PARAM: DeclKindName := 'param';
    DK_CATCH: DeclKindName := 'catch';
    DK_FNAME: DeclKindName := 'fname';
    DK_ARGS:  DeclKindName := 'arguments';
    DK_NEWTARGET: DeclKindName := 'new.target';
  Else
    DeclKindName := '?';
  End;
End;

Procedure DumpNodeList(Var ctx: TCompilerContext; n, indent: LongInt); Forward;
Procedure WriteAnnotation(Var ctx: TCompilerContext; n: LongInt); Forward;

Procedure DumpNode(Var ctx: TCompilerContext; n, indent: LongInt);
Var
  i, e: LongInt;
  t: TTokenText;
  f: LongInt;
Begin
  If n = 0 Then
    Exit;
  For i := 1 To indent Do
    Write('  ');
  Write(NodeKindName(NodeP(ctx.ast.nodes, n)^.kind));
  f := NodeP(ctx.ast.nodes, n)^.flags;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_VAR_DECL:
      Case f Of
        DF_VAR:   Write(' var');
        DF_LET:   Write(' let');
        DF_CONST: Write(' const');
      End;
    N_BIND_IDENT, N_FUNC_DECL, N_CLASS_DECL, N_LABELED:
      Begin
        Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If (NodeP(ctx.ast.nodes, n)^.kind = N_FUNC_DECL) Then
          Begin
            If f And FN_ASYNC <> 0 Then
              Write(' async');
            If f And FN_GENERATOR <> 0 Then
              Write(' generator');
          End;
      End;
    N_BREAK, N_CONTINUE:
      If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
        Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.e1)^.text);
    N_PARAM:
      If f And PF_REST <> 0 Then
        Write(' ...');
    N_PATTERN_ELEM:
      Begin
        If f And PF_REST <> 0 Then
          Write(' ...');
        If NodeP(ctx.ast.nodes, n)^.e1 = 0 Then
          Write(' (trou)');
      End;
    N_PATTERN_PROP:
      Begin
        If f And PP_REST <> 0 Then
          Write(' ...')
        Else If f And PP_COMPUTED = 0 Then
          Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If f And PP_SHORTHAND <> 0 Then
          Write(' (raccourci)');
      End;
    N_METHOD, N_FIELD:
      Begin
        If f And MF_COMPUTED <> 0 Then
          Write(' [calcule]')
        Else
          Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If f And MF_STATIC <> 0 Then
          Write(' static');
        If f And MF_GETTER <> 0 Then
          Write(' get');
        If f And MF_SETTER <> 0 Then
          Write(' set');
        If f And MF_ASYNC <> 0 Then
          Write(' async');
        If f And MF_GENERATOR <> 0 Then
          Write(' generator');
        If f And MF_CONSTRUCTOR <> 0 Then
          Write(' constructor');
      End;
    N_NUMBER, N_STRING, N_REGEX, N_IDENT, N_BOOL, N_THIS, N_SUPER,
    N_NULL:
      Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
    N_TEMPLATE_STR:
      Begin
        Write(' "');
        PrintPoolText(ctx, TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.sval_off,
                      TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.sval_len);
        Write('"');
      End;
    N_UNARY, N_BINARY, N_LOGICAL, N_ASSIGN:
      Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
    N_UPDATE:
      Begin
        Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If f And UF_PREFIX <> 0 Then
          Write(' prefixe')
        Else
          Write(' postfixe');
      End;
    N_MEMBER:
      Begin
        Write(' .', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If f And EF_OPTIONAL <> 0 Then
          Write(' ?.');
      End;
    N_INDEX, N_CALL:
      If f And EF_OPTIONAL <> 0 Then
        Write(' ?.');
    N_PROP:
      Begin
        If f And PR_SPREAD <> 0 Then
          Write(' ...')
        Else If f And PR_COMPUTED = 0 Then
          Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text)
        Else
          Write(' [calcule]');
        If f And PR_SHORTHAND <> 0 Then
          Write(' (raccourci)');
        If f And PR_GETTER <> 0 Then
          Write(' get');
        If f And PR_SETTER <> 0 Then
          Write(' set');
        If f And PR_METHOD <> 0 Then
          Write(' methode');
      End;
    N_FUNC_EXPR:
      Begin
        If f And FN_ARROW <> 0 Then
          Write(' fleche')
        Else If f And FN_METHOD = 0 Then
          Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
        If f And FN_ASYNC <> 0 Then
          Write(' async');
        If f And FN_GENERATOR <> 0 Then
          Write(' generator');
        If f And FN_EXPR_BODY <> 0 Then
          Write(' (corps expression)');
      End;
    N_CLASS_EXPR:
      If TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.kind = TK_IDENT Then
        Write(' ', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text);
  End;
  If ctx.ast.analyzed Then
    WriteAnnotation(ctx, n);
  Write('  @', TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line, ':',
        TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.col);
  Writeln;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_PROGRAM, N_BLOCK, N_VAR_DECL, N_ARRAY_PATTERN, N_OBJECT_PATTERN,
    N_ARRAY_LIT, N_OBJECT_LIT, N_TEMPLATE, N_SEQUENCE:
      DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
    N_EXPR_STMT, N_RETURN, N_THROW, N_LABELED, N_SPREAD, N_UNARY, N_UPDATE,
    N_MEMBER:
      DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
    N_DECLARATOR, N_PATTERN_ELEM:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_PATTERN_PROP:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_IF:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
      End;
    N_WHILE, N_DO_WHILE:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_FOR:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e4, indent + 1);
      End;
    N_FOR_IN, N_FOR_OF:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
      End;
    N_SWITCH:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_CASE:
      Begin
        If NodeP(ctx.ast.nodes, n)^.e1 = 0 Then
          Begin
            For i := 0 To indent Do
              Write('  ');
            Writeln('default');
          End
        Else
          DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_TRY:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
      End;
    N_CATCH:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_BINARY, N_LOGICAL, N_ASSIGN, N_INDEX, N_TAGGED:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_COND:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
      End;
    N_CALL, N_NEW:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_PROP:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
      End;
    N_FUNC_DECL, N_METHOD, N_FUNC_EXPR:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
        DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_PARAM:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_CLASS_DECL, N_CLASS_EXPR:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
        DumpNodeList(ctx, NodeP(ctx.ast.nodes, n)^.e2, indent + 1);
      End;
    N_FIELD:
      Begin
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e3, indent + 1);
        DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
      End;
    N_STATIC_BLOCK:
      DumpNode(ctx, NodeP(ctx.ast.nodes, n)^.e1, indent + 1);
  End;
End;

Procedure DumpNodeList(Var ctx: TCompilerContext; n, indent: LongInt);
Begin
  While n <> 0 Do
    Begin
      DumpNode(ctx, n, indent);
      n := NodeP(ctx.ast.nodes, n)^.next;
    End;
End;

Procedure DumpAst(Var ctx: TCompilerContext);
Var
  i, sc: LongInt;
Begin
  Writeln('AST :');
  DumpNode(ctx, ctx.ast.root, 1);
  Writeln('Declarations (', ctx.ast.decl_count, ') :');
  For i := 1 To ctx.ast.decl_count Do
    Begin
      sc := DeclP(ctx.ast.decls, i)^.scope;
      Write('  ', DeclKindName(DeclP(ctx.ast.decls, i)^.kind), ' ',
            TokP(ctx.lex.tokens, DeclP(ctx.ast.decls, i)^.name_tok)^.text,
            '  portee ', NodeKindName(NodeP(ctx.ast.nodes, sc)^.kind), '@',
            TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, sc)^.tok)^.line);
      If DeclP(ctx.ast.decls, i)^.origin <> sc Then
        Write(' (hisse depuis ',
              NodeKindName(NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.origin)^.kind), '@',
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.origin)^.tok)^.line,
              ')');
      Writeln;
    End;
End;

{ ============================================================
  TODO 6 - ANALYSE SEMANTIQUE

  Une passe sur l'AST construit les portees (globale, fonction, bloc,
  classe, catch) et la table des symboles, puis resout chaque reference.
  Pour chaque identifiant, le noeud recoit le symbole (sym) et le genre
  de resolution (aux) : local, capture depuis une fonction englobante,
  global predefini, global implicite, arguments.

  Diagnostics : variable non declaree, redeclaration, reaffectation
  d'une const, zone morte temporelle (TDZ) detectee a la compilation,
  super hors d'une methode.

  Informations pour la generation de code : variables capturees par des
  fonctions imbriquees (liste des captures par fonction), symboles qui
  exigent une cellule, une copie par iteration de boucle, un test TDZ a
  l'execution, et la resolution de this (global, fonction, methode,
  constructeur, fleche).
  ============================================================ }

Function SemTokText(Var ctx: TCompilerContext; tok: LongInt): TTokenText;
Begin
  SemTokText := TokP(ctx.lex.tokens, tok)^.text;
End;

Procedure SemError(Var ctx: TCompilerContext; tok: LongInt; msg: TString);
Begin
  SourceErrorAt(ctx, TokP(ctx.lex.tokens, tok)^.line, TokP(ctx.lex.tokens, tok)^.col, msg);
End;

Procedure SemWarn(Var ctx: TCompilerContext; tok: LongInt; msg: TString);
Begin
  SourceWarnAt(ctx, TokP(ctx.lex.tokens, tok)^.line, TokP(ctx.lex.tokens, tok)^.col, msg);
End;

Function IsBuiltinGlobal(Const name: TTokenText): Boolean;
Var
  i: Integer;
Begin
  IsBuiltinGlobal := False;
  For i := 1 To BUILTIN_COUNT Do
    If Builtins[i] = name Then
      IsBuiltinGlobal := True;
End;

Function IsPreludeAlias(Const name: TTokenText): Boolean;
Var
  i: Integer;
Begin
  IsPreludeAlias := False;
  For i := 1 To PRELUDE_ALIAS_COUNT Do
    If PreludeAliases[i] = name Then
      IsPreludeAlias := True;
End;

Function IsLexicalKind(kind: TDeclKind): Boolean;
Begin
  IsLexicalKind := (kind = DK_LET) Or (kind = DK_CONST) Or (kind = DK_CLASS);
End;

Function LineOfTok(Var ctx: TCompilerContext; tok: LongInt): TString;
Var
  s: String[12];
Begin
  Str(TokP(ctx.lex.tokens, tok)^.line, s);
  LineOfTok := s;
End;

{ ---- Table des symboles ---- }

Procedure CreateSymbol(Var ctx: TCompilerContext; sc, d: LongInt);
Var
  old, sy: LongInt;
  name: TTokenText;
  conflict: Boolean;
Begin
  name := SemTokText(ctx, DeclP(ctx.ast.decls, d)^.name_tok);
  old := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While old <> 0 Do
    Begin
      If SemTokText(ctx, SymP(ctx.sem.syms, old)^.name_tok) = name Then
        Begin
          conflict := False;
          If (SymP(ctx.sem.syms, old)^.kind <> DK_FNAME) And
             (DeclP(ctx.ast.decls, d)^.kind <> DK_FNAME) Then
            Begin
              If IsLexicalKind(DeclP(ctx.ast.decls, d)^.kind) Or
                 IsLexicalKind(SymP(ctx.sem.syms, old)^.kind) Then
                conflict := True
              Else If (DeclP(ctx.ast.decls, d)^.kind = DK_PARAM) And
                      (SymP(ctx.sem.syms, old)^.kind = DK_PARAM) Then
                SemWarn(ctx, DeclP(ctx.ast.decls, d)^.name_tok,
                        'parametre en double: ' + name);
            End;
          If conflict Then
            Begin
              SemError(ctx, DeclP(ctx.ast.decls, d)^.name_tok,
                       'redeclaration de "' + name + '" (deja declare ligne ' +
                       LineOfTok(ctx, SymP(ctx.sem.syms, old)^.name_tok) + ')');
              Break;
            End;
          { var, function et parametre redeclares : meme variable }
          If (Not conflict) And (SymP(ctx.sem.syms, old)^.kind <> DK_FNAME) And
             (DeclP(ctx.ast.decls, d)^.kind <> DK_FNAME) And
             (SymP(ctx.sem.syms, old)^.kind In [DK_VAR, DK_FUNC, DK_PARAM]) And
             (DeclP(ctx.ast.decls, d)^.kind In [DK_VAR, DK_FUNC, DK_PARAM]) Then
            Begin
              If DeclP(ctx.ast.decls, d)^.kind = DK_FUNC Then
                Begin
                  SymP(ctx.sem.syms, old)^.kind := DK_FUNC;
                  SymP(ctx.sem.syms, old)^.node := DeclP(ctx.ast.decls, d)^.node;
                  SymP(ctx.sem.syms, old)^.flags := SymP(ctx.sem.syms, old)^.flags Or SF_HOISTED;
                End;
              NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, d)^.node)^.sym := old;
              Exit;
            End;
        End;
      old := SymP(ctx.sem.syms, old)^.next;
    End;
  Inc(ctx.sem.sym_count);
  sy := ctx.sem.sym_count;
  SymP(ctx.sem.syms, sy)^.name_tok := DeclP(ctx.ast.decls, d)^.name_tok;
  SymP(ctx.sem.syms, sy)^.kind := DeclP(ctx.ast.decls, d)^.kind;
  SymP(ctx.sem.syms, sy)^.scope := sc;
  SymP(ctx.sem.syms, sy)^.node := DeclP(ctx.ast.decls, d)^.node;
  SymP(ctx.sem.syms, sy)^.next := 0;
  SymP(ctx.sem.syms, sy)^.flags := 0;
  SymP(ctx.sem.syms, sy)^.refs := 0;
  SymP(ctx.sem.syms, sy)^.writes := 0;
  If (ScopeP(ctx.sem.scopes, sc)^.func = 1) And Not ScopeP(ctx.sem.scopes, sc)^.in_loop And
     (SymP(ctx.sem.syms, sy)^.kind In [DK_VAR, DK_LET, DK_CONST, DK_FUNC, DK_CLASS]) Then
    SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_STATIC;
  If (SymP(ctx.sem.syms, sy)^.kind = DK_VAR) Or (SymP(ctx.sem.syms, sy)^.kind = DK_FUNC) Then
    SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_HOISTED;
  NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, d)^.node)^.sym := sy;
  If ScopeP(ctx.sem.scopes, sc)^.first_sym = 0 Then
    ScopeP(ctx.sem.scopes, sc)^.first_sym := sy
  Else
    SymP(ctx.sem.syms, ScopeP(ctx.sem.scopes, sc)^.last_sym)^.next := sy;
  ScopeP(ctx.sem.scopes, sc)^.last_sym := sy;
End;

Function CreateArgsSymbol(Var ctx: TCompilerContext; prov, tok: LongInt;
                          kind: TDeclKind): LongInt; Forward;

Function EnterScope(Var ctx: TCompilerContext; node: LongInt;
                    kind: TScopeKind; fk: TFuncKind): LongInt;
Var
  sc, par, d: LongInt;
Begin
  EnterScope := ctx.sem.cur_scope;
  Inc(ctx.sem.scope_count);
  sc := ctx.sem.scope_count;
  par := ctx.sem.cur_scope;
  ScopeP(ctx.sem.scopes, sc)^.node := node;
  ScopeP(ctx.sem.scopes, sc)^.kind := kind;
  ScopeP(ctx.sem.scopes, sc)^.fkind := fk;
  ScopeP(ctx.sem.scopes, sc)^.parent := par;
  If (kind = SK_GLOBAL) Or (kind = SK_FUNCTION) Then
    ScopeP(ctx.sem.scopes, sc)^.func := sc
  Else
    ScopeP(ctx.sem.scopes, sc)^.func := ScopeP(ctx.sem.scopes, par)^.func;
  ScopeP(ctx.sem.scopes, sc)^.in_loop := (ctx.sem.loop_depth > 0) Or ctx.sem.next_in_loop;
  ctx.sem.next_in_loop := False;
  ScopeP(ctx.sem.scopes, sc)^.first_sym := 0;
  ScopeP(ctx.sem.scopes, sc)^.last_sym := 0;
  ScopeP(ctx.sem.scopes, sc)^.uses_this := False;
  ScopeP(ctx.sem.scopes, sc)^.this_captured := False;
  ScopeP(ctx.sem.scopes, sc)^.uses_arguments := False;
  ScopeP(ctx.sem.scopes, sc)^.has_nested := False;
  ScopeP(ctx.sem.scopes, sc)^.cap_count := 0;
  NodeP(ctx.ast.nodes, node)^.scope := sc;
  If (kind = SK_FUNCTION) And (par <> 0) Then
    ScopeP(ctx.sem.scopes, ScopeP(ctx.sem.scopes, par)^.func)^.has_nested := True;
  ctx.sem.cur_scope := sc;
  If (kind = SK_FUNCTION) And ((fk = FK_CTOR) Or (fk = FK_DERIVED_CTOR)) Then
    Begin
      { un constructeur de classe consomme toujours new.target }
      If ctx.sem.nt_tok = 0 Then
        Begin
          ctx.sem.nt_tok := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, node)^.tok)^.line,
                                     TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, node)^.tok)^.col, ctx.lex.pos);
          TokP(ctx.lex.tokens, ctx.sem.nt_tok)^.text := 'new.target';
        End;
      CreateArgsSymbol(ctx, sc, ctx.sem.nt_tok, DK_NEWTARGET);
    End;
  d := NodeP(ctx.ast.nodes, node)^.decl_head;
  While d <> 0 Do
    Begin
      CreateSymbol(ctx, sc, d);
      d := DeclP(ctx.ast.decls, d)^.next;
    End;
  EnterScope := sc;
End;

Procedure LeaveScope(Var ctx: TCompilerContext; sc: LongInt);
Begin
  If sc <> 0 Then
    ctx.sem.cur_scope := ScopeP(ctx.sem.scopes, sc)^.parent;
End;

Function LookupSymbol(Var ctx: TCompilerContext; Const name: TTokenText): LongInt;
Var
  sc, sy: LongInt;
Begin
  sc := ctx.sem.cur_scope;
  While sc <> 0 Do
    Begin
      sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
      While sy <> 0 Do
        Begin
          If SemTokText(ctx, SymP(ctx.sem.syms, sy)^.name_tok) = name Then
            Begin
              LookupSymbol := sy;
              Exit;
            End;
          sy := SymP(ctx.sem.syms, sy)^.next;
        End;
      sc := ScopeP(ctx.sem.scopes, sc)^.parent;
    End;
  LookupSymbol := 0;
End;

{ Cherche name de la portee courante jusqu'a la portee stop incluse. }
Function LookupWithin(Var ctx: TCompilerContext; Const name: TTokenText;
                      stop: LongInt): LongInt;
Var
  sc, sy: LongInt;
Begin
  sc := ctx.sem.cur_scope;
  While sc <> 0 Do
    Begin
      sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
      While sy <> 0 Do
        Begin
          If SemTokText(ctx, SymP(ctx.sem.syms, sy)^.name_tok) = name Then
            Begin
              LookupWithin := sy;
              Exit;
            End;
          sy := SymP(ctx.sem.syms, sy)^.next;
        End;
      If sc = stop Then
        Break;
      sc := ScopeP(ctx.sem.scopes, sc)^.parent;
    End;
  LookupWithin := 0;
End;

{ Symbole implicite arguments de la fonction prov. }
Function CreateArgsSymbol(Var ctx: TCompilerContext; prov, tok: LongInt;
                          kind: TDeclKind): LongInt;
Var
  sy: LongInt;
Begin
  CreateArgsSymbol := 0;
  Inc(ctx.sem.sym_count);
  sy := ctx.sem.sym_count;
  SymP(ctx.sem.syms, sy)^.name_tok := tok;
  SymP(ctx.sem.syms, sy)^.kind := kind;
  SymP(ctx.sem.syms, sy)^.scope := prov;
  SymP(ctx.sem.syms, sy)^.node := 0;
  SymP(ctx.sem.syms, sy)^.next := 0;
  SymP(ctx.sem.syms, sy)^.flags := 0;
  SymP(ctx.sem.syms, sy)^.refs := 0;
  SymP(ctx.sem.syms, sy)^.writes := 0;
  If ScopeP(ctx.sem.scopes, prov)^.first_sym = 0 Then
    ScopeP(ctx.sem.scopes, prov)^.first_sym := sy
  Else
    SymP(ctx.sem.syms, ScopeP(ctx.sem.scopes, prov)^.last_sym)^.next := sy;
  ScopeP(ctx.sem.scopes, prov)^.last_sym := sy;
  CreateArgsSymbol := sy;
End;

{ ---- Captures ---- }

Procedure AddCapture(Var ctx: TCompilerContext; fscope, sy: LongInt);
Var
  i: LongInt;
Begin
  For i := 1 To ctx.sem.cap_count Do
    If (CapP(ctx.sem.caps, i)^.fscope = fscope) And (CapP(ctx.sem.caps, i)^.sym = sy) Then
      Exit;
  Inc(ctx.sem.cap_count);
  CapP(ctx.sem.caps, ctx.sem.cap_count)^.fscope := fscope;
  CapP(ctx.sem.caps, ctx.sem.cap_count)^.sym := sy;
  Inc(ScopeP(ctx.sem.scopes, fscope)^.cap_count);
End;

{ ---- Resolution d'un identifiant ---- }

Function NearestNonArrow(Var ctx: TCompilerContext): LongInt;
Var
  sc: LongInt;
Begin
  sc := ctx.sem.cur_scope;
  While sc <> 0 Do
    Begin
      If ScopeP(ctx.sem.scopes, sc)^.kind = SK_GLOBAL Then
        Begin
          NearestNonArrow := sc;
          Exit;
        End;
      If (ScopeP(ctx.sem.scopes, sc)^.kind = SK_FUNCTION) And
         (ScopeP(ctx.sem.scopes, sc)^.fkind <> FK_ARROW) Then
        Begin
          NearestNonArrow := sc;
          Exit;
        End;
      sc := ScopeP(ctx.sem.scopes, sc)^.parent;
    End;
  NearestNonArrow := 1;
End;

Procedure ResolveIdent(Var ctx: TCompilerContext; n: LongInt; mode: Integer);
Var
  tok, sy, rf, sf, f, prov: LongInt;
  name: TTokenText;
  is_write, is_read: Boolean;
Begin
  tok := NodeP(ctx.ast.nodes, n)^.tok;
  name := SemTokText(ctx, tok);
  is_write := (mode = RM_WRITE) Or (mode = RM_READWRITE);
  is_read := (mode = RM_READ) Or (mode = RM_READWRITE);
  NodeP(ctx.ast.nodes, n)^.sym := 0;
  sy := 0;
  If name = 'arguments' Then
    Begin
      { objet arguments : symbole cache de la fonction englobante non
        fleche, capture comme une variable ordinaire par les fleches }
      prov := NearestNonArrow(ctx);
      If ScopeP(ctx.sem.scopes, prov)^.kind = SK_FUNCTION Then
        Begin
          sy := LookupWithin(ctx, name, prov);
          If sy = 0 Then
            sy := CreateArgsSymbol(ctx, prov, tok, DK_ARGS);
          ScopeP(ctx.sem.scopes, prov)^.uses_arguments := True;
        End;
    End;
  If name = 'new.target' Then
    Begin
      { new.target : symbole cache de la fonction englobante non fleche ;
        hors fonction, la valeur est undefined }
      prov := NearestNonArrow(ctx);
      If ScopeP(ctx.sem.scopes, prov)^.kind = SK_FUNCTION Then
        Begin
          sy := LookupWithin(ctx, name, prov);
          If sy = 0 Then
            sy := CreateArgsSymbol(ctx, prov, tok, DK_NEWTARGET);
        End
      Else
        Begin
          name := 'undefined';
          TokP(ctx.lex.tokens, tok)^.text := name;
        End;
    End;
  If sy = 0 Then
    sy := LookupSymbol(ctx, name);
  { globales fournies par le prelude JS : Map, Set, Date, Promise... (declarees
    sous le nom __Map, __Set... ; une declaration du programme a priorite) }
  If (sy = 0) And IsPreludeAlias(name) Then
    sy := LookupSymbol(ctx, '__' + name);
  If sy = 0 Then
    Begin
      If IsBuiltinGlobal(name) Then
        NodeP(ctx.ast.nodes, n)^.aux := RK_BUILTIN
      Else If is_write And Not is_read Then
        Begin
          { affectation a une variable non declaree : globale implicite }
          SemWarn(ctx, tok, 'affectation a la variable non declaree "' + name +
                  '" : creation d''une globale implicite');
            Inc(ctx.sem.sym_count);
            sy := ctx.sem.sym_count;
            SymP(ctx.sem.syms, sy)^.name_tok := tok;
            SymP(ctx.sem.syms, sy)^.kind := DK_VAR;
            SymP(ctx.sem.syms, sy)^.scope := 1;
            SymP(ctx.sem.syms, sy)^.node := n;
            SymP(ctx.sem.syms, sy)^.next := 0;
            SymP(ctx.sem.syms, sy)^.flags := SF_STATIC Or SF_IMPLICIT Or SF_REASSIGNED;
            SymP(ctx.sem.syms, sy)^.refs := 0;
            SymP(ctx.sem.syms, sy)^.writes := 1;
            If ScopeP(ctx.sem.scopes, 1)^.first_sym = 0 Then
              ScopeP(ctx.sem.scopes, 1)^.first_sym := sy
            Else
              SymP(ctx.sem.syms, ScopeP(ctx.sem.scopes, 1)^.last_sym)^.next := sy;
            ScopeP(ctx.sem.scopes, 1)^.last_sym := sy;
            NodeP(ctx.ast.nodes, n)^.sym := sy;
            NodeP(ctx.ast.nodes, n)^.aux := RK_GLOBAL_IMPLICIT;
        End
      Else If ctx.sem.in_typeof Then
        NodeP(ctx.ast.nodes, n)^.aux := RK_UNDECLARED_OK
      Else
        Begin
          SemError(ctx, tok, 'variable non declaree: ' + name);
          NodeP(ctx.ast.nodes, n)^.aux := RK_UNRESOLVED;
        End;
      Exit;
    End;

  NodeP(ctx.ast.nodes, n)^.sym := sy;
  rf := ScopeP(ctx.sem.scopes, ctx.sem.cur_scope)^.func;
  sf := ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, sy)^.scope)^.func;
  If is_read Then
    Inc(SymP(ctx.sem.syms, sy)^.refs);

  If rf = sf Then
    NodeP(ctx.ast.nodes, n)^.aux := RK_LOCAL
  Else
    Begin
      NodeP(ctx.ast.nodes, n)^.aux := RK_OUTER;
      SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_CAPTURED;
      If SymP(ctx.sem.syms, sy)^.flags And SF_STATIC = 0 Then
        Begin
          SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_CELL;
          f := rf;
          While (f <> sf) And (f <> 0) Do
            Begin
              AddCapture(ctx, f, sy);
              f := ScopeP(ctx.sem.scopes, ScopeP(ctx.sem.scopes, f)^.parent)^.func;
            End;
        End;
      If ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, sy)^.scope)^.in_loop And
         (SymP(ctx.sem.syms, sy)^.kind <> DK_VAR) Then
        SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_PER_ITER;
    End;

  { zone morte temporelle des declarations lexicales }
  If IsLexicalKind(SymP(ctx.sem.syms, sy)^.kind) Then
    Begin
      If rf = sf Then
        Begin
          If tok < SymP(ctx.sem.syms, sy)^.name_tok Then
            SemError(ctx, tok, '"' + name + '" utilise avant sa declaration ' +
                     '(zone morte temporelle, ligne ' +
                     LineOfTok(ctx, SymP(ctx.sem.syms, sy)^.name_tok) + ')')
          Else If SymP(ctx.sem.syms, sy)^.flags And SF_INITIALIZING <> 0 Then
            SemError(ctx, tok, '"' + name + '" utilise dans son propre ' +
                     'initialiseur (zone morte temporelle)');
        End
      Else
        Begin
          { fonction imbriquee ecrite avant la declaration : test a l'execution }
          f := rf;
          While ScopeP(ctx.sem.scopes, ScopeP(ctx.sem.scopes, f)^.parent)^.func <> sf Do
            f := ScopeP(ctx.sem.scopes, ScopeP(ctx.sem.scopes, f)^.parent)^.func;
          If NodeP(ctx.ast.nodes, ScopeP(ctx.sem.scopes, f)^.node)^.tok <
             SymP(ctx.sem.syms, sy)^.name_tok Then
            SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_TDZ_CHECK;
        End;
    End;

  If is_write Then
    Begin
      Inc(SymP(ctx.sem.syms, sy)^.writes);
      SymP(ctx.sem.syms, sy)^.flags := SymP(ctx.sem.syms, sy)^.flags Or SF_REASSIGNED;
      If SymP(ctx.sem.syms, sy)^.kind = DK_CONST Then
        SemError(ctx, tok, 'reaffectation de la constante "' + name + '"')
      Else If SymP(ctx.sem.syms, sy)^.kind = DK_FNAME Then
        SemWarn(ctx, tok, 'affectation ignoree au nom de fonction "' + name + '"');
    End;
End;

{ ---- Contexte de this et de super ---- }

Function ThisBindingOf(fk: TFuncKind): Integer;
Begin
  Case fk Of
    FK_GLOBAL:       ThisBindingOf := TB_GLOBAL;
    FK_FUNCTION:     ThisBindingOf := TB_FUNCTION;
    FK_METHOD:       ThisBindingOf := TB_METHOD;
    FK_CTOR:         ThisBindingOf := TB_CTOR;
    FK_DERIVED_CTOR: ThisBindingOf := TB_DERIVED_CTOR;
    FK_FIELD_INIT:   ThisBindingOf := TB_FIELD;
  Else
    ThisBindingOf := TB_STATIC;
  End;
End;

{ Portee qui fournit this : la plus proche non fleche. Les fleches
  traversees utilisent le this lexical. Retourne la portee et dit si au
  moins une fleche a ete traversee. }
Function FindThisProvider(Var ctx: TCompilerContext; Var via_arrow: Boolean): LongInt;
Var
  sc: LongInt;
Begin
  via_arrow := False;
  sc := ctx.sem.cur_scope;
  While sc <> 0 Do
    Begin
      If ScopeP(ctx.sem.scopes, sc)^.kind = SK_GLOBAL Then
        Break;
      If ScopeP(ctx.sem.scopes, sc)^.kind = SK_FUNCTION Then
        Begin
          If ScopeP(ctx.sem.scopes, sc)^.fkind <> FK_ARROW Then
            Break;
          via_arrow := True;
          ScopeP(ctx.sem.scopes, sc)^.uses_this := True;
        End;
      sc := ScopeP(ctx.sem.scopes, sc)^.parent;
    End;
  If sc = 0 Then
    sc := 1;
  FindThisProvider := sc;
End;

Procedure ResolveThis(Var ctx: TCompilerContext; n: LongInt);
Var
  prov: LongInt;
  via: Boolean;
Begin
  prov := FindThisProvider(ctx, via);
  ScopeP(ctx.sem.scopes, prov)^.uses_this := True;
  If via Then
    ScopeP(ctx.sem.scopes, prov)^.this_captured := True;
  NodeP(ctx.ast.nodes, n)^.sym := prov;
  NodeP(ctx.ast.nodes, n)^.aux := ThisBindingOf(ScopeP(ctx.sem.scopes, prov)^.fkind);
  If via Then
    NodeP(ctx.ast.nodes, n)^.e1 := 1;
End;

Procedure ResolveSuper(Var ctx: TCompilerContext; n: LongInt; is_call: Boolean);
Var
  prov: LongInt;
  via: Boolean;
  fk: TFuncKind;
Begin
  prov := FindThisProvider(ctx, via);
  fk := ScopeP(ctx.sem.scopes, prov)^.fkind;
  NodeP(ctx.ast.nodes, n)^.sym := prov;
  ScopeP(ctx.sem.scopes, prov)^.uses_this := True;
  If via Then
    Begin
      ScopeP(ctx.sem.scopes, prov)^.this_captured := True;
      NodeP(ctx.ast.nodes, n)^.e1 := 1;
    End;
  If is_call Then
    Begin
      If fk <> FK_DERIVED_CTOR Then
        SemError(ctx, NodeP(ctx.ast.nodes, n)^.tok,
                 'super(...) n''est permis que dans le constructeur d''une classe derivee');
    End
  Else If (fk = FK_GLOBAL) Or (fk = FK_FUNCTION) Then
    SemError(ctx, NodeP(ctx.ast.nodes, n)^.tok,
             'super en dehors d''une methode ou d''un constructeur');
End;

{ ---- Parcours generique ---- }

Function ChildSpec(kind: TNodeKind): String;
Begin
  Case kind Of
    N_PROGRAM, N_BLOCK, N_VAR_DECL, N_ARRAY_PATTERN, N_OBJECT_PATTERN,
    N_TEMPLATE, N_ARRAY_LIT, N_OBJECT_LIT, N_SEQUENCE:
      ChildSpec := 'l';
    N_EXPR_STMT, N_RETURN, N_THROW, N_LABELED, N_SPREAD, N_UNARY, N_MEMBER:
      ChildSpec := 'n';
    N_IF, N_TRY, N_COND, N_PATTERN_PROP:
      ChildSpec := 'nnn';
    N_CASE, N_CALL, N_NEW:
      ChildSpec := 'nl';
    N_WHILE, N_DO_WHILE, N_PARAM, N_PATTERN_ELEM, N_BINARY, N_LOGICAL,
    N_INDEX, N_TAGGED:
      ChildSpec := 'nn';
  Else
    ChildSpec := '';
  End;
End;

Function NodeField(Var ctx: TCompilerContext; n, slot: LongInt): LongInt;
Begin
  Case slot Of
    1: NodeField := NodeP(ctx.ast.nodes, n)^.e1;
    2: NodeField := NodeP(ctx.ast.nodes, n)^.e2;
    3: NodeField := NodeP(ctx.ast.nodes, n)^.e3;
  Else
    NodeField := NodeP(ctx.ast.nodes, n)^.e4;
  End;
End;

Procedure SemNode(Var ctx: TCompilerContext; n: LongInt); Forward;

Procedure SemList(Var ctx: TCompilerContext; n: LongInt);
Begin
  While n <> 0 Do
    Begin
      SemNode(ctx, n);
      n := NodeP(ctx.ast.nodes, n)^.next;
    End;
End;

Procedure SemChildren(Var ctx: TCompilerContext; n: LongInt);
Var
  spec: String;
  slot: Integer;
  e: LongInt;
Begin
  spec := ChildSpec(NodeP(ctx.ast.nodes, n)^.kind);
  For slot := 1 To Length(spec) Do
    Begin
      e := NodeField(ctx, n, slot);
      If spec[slot] = 'n' Then
        SemNode(ctx, e)
      Else
        SemList(ctx, e);
    End;
End;

{ Cible d'une affectation : ecriture d'un identifiant, ou destructuration. }
Procedure SemTarget(Var ctx: TCompilerContext; n: LongInt);
Var
  el, pr: LongInt;
Begin
  If n = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_IDENT:
      ResolveIdent(ctx, n, RM_WRITE);
    N_ARRAY_LIT:
      Begin
        el := NodeP(ctx.ast.nodes, n)^.e1;
        While el <> 0 Do
          Begin
            If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
              SemTarget(ctx, NodeP(ctx.ast.nodes, el)^.e1)
            Else
              SemTarget(ctx, el);
            el := NodeP(ctx.ast.nodes, el)^.next;
          End;
      End;
    N_OBJECT_LIT:
      Begin
        pr := NodeP(ctx.ast.nodes, n)^.e1;
        While pr <> 0 Do
          Begin
            If NodeP(ctx.ast.nodes, pr)^.flags And PR_SPREAD <> 0 Then
              SemTarget(ctx, NodeP(ctx.ast.nodes, pr)^.e1)
            Else
              Begin
                SemNode(ctx, NodeP(ctx.ast.nodes, pr)^.e2);
                SemTarget(ctx, NodeP(ctx.ast.nodes, pr)^.e1);
                SemNode(ctx, NodeP(ctx.ast.nodes, pr)^.e3);
              End;
            pr := NodeP(ctx.ast.nodes, pr)^.next;
          End;
      End;
    N_ASSIGN:
      Begin
        SemTarget(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      End;
  Else
    SemNode(ctx, n);
  End;
End;

{ Marque (ou demarque) les symboles lies par un motif de declaration. }
Procedure SetInitializing(Var ctx: TCompilerContext; n: LongInt; on: Boolean);
Var
  e: LongInt;
Begin
  If n = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_BIND_IDENT:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.sym;
        If e <> 0 Then
          If on Then
            SymP(ctx.sem.syms, e)^.flags := SymP(ctx.sem.syms, e)^.flags Or SF_INITIALIZING
          Else
            SymP(ctx.sem.syms, e)^.flags := SymP(ctx.sem.syms, e)^.flags And Not SF_INITIALIZING;
      End;
    N_ARRAY_PATTERN, N_OBJECT_PATTERN:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        While e <> 0 Do
          Begin
            SetInitializing(ctx, e, on);
            e := NodeP(ctx.ast.nodes, e)^.next;
          End;
      End;
    N_PATTERN_ELEM, N_PATTERN_PROP:
      SetInitializing(ctx, NodeP(ctx.ast.nodes, n)^.e1, on);
  End;
End;

Function FuncKindOf(Var ctx: TCompilerContext; n: LongInt): TFuncKind;
Var
  f: LongInt;
Begin
  f := NodeP(ctx.ast.nodes, n)^.flags;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_FUNC_DECL:
      FuncKindOf := FK_FUNCTION;
    N_FUNC_EXPR:
      Begin
        If f And FN_ARROW <> 0 Then
          FuncKindOf := FK_ARROW
        Else If f And FN_METHOD <> 0 Then
          FuncKindOf := FK_METHOD
        Else
          FuncKindOf := FK_FUNCTION;
      End;
    N_METHOD:
      Begin
        If f And MF_STATIC <> 0 Then
          FuncKindOf := FK_STATIC_METHOD
        Else If f And MF_CONSTRUCTOR <> 0 Then
          Begin
            If (ctx.sem.cur_class <> 0) And
               (NodeP(ctx.ast.nodes, ctx.sem.cur_class)^.e1 <> 0) Then
              FuncKindOf := FK_DERIVED_CTOR
            Else
              FuncKindOf := FK_CTOR;
          End
        Else
          FuncKindOf := FK_METHOD;
      End;
  Else
    FuncKindOf := FK_FUNCTION;
  End;
End;

Procedure SemFunction(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, save_loop: LongInt;
Begin
  save_loop := ctx.sem.loop_depth;
  ctx.sem.loop_depth := 0;
  sc := EnterScope(ctx, n, SK_FUNCTION, FuncKindOf(ctx, n));
  SemList(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  LeaveScope(ctx, sc);
  ctx.sem.loop_depth := save_loop;
End;

Procedure SemClass(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, save_class, m, sc2, save_loop: LongInt;
Begin
  save_class := ctx.sem.cur_class;
  sc := EnterScope(ctx, n, SK_CLASS, FK_NONE);
  ctx.sem.cur_class := n;
  SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      Case NodeP(ctx.ast.nodes, m)^.kind Of
        N_METHOD:
          Begin
            SemNode(ctx, NodeP(ctx.ast.nodes, m)^.e3);
            SemFunction(ctx, m);
          End;
        N_FIELD:
          Begin
            SemNode(ctx, NodeP(ctx.ast.nodes, m)^.e3);
            If NodeP(ctx.ast.nodes, m)^.e1 <> 0 Then
              Begin
                save_loop := ctx.sem.loop_depth;
                ctx.sem.loop_depth := 0;
                If NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0 Then
                  sc2 := EnterScope(ctx, m, SK_FUNCTION, FK_STATIC_FIELD_INIT)
                Else
                  sc2 := EnterScope(ctx, m, SK_FUNCTION, FK_FIELD_INIT);
                SemNode(ctx, NodeP(ctx.ast.nodes, m)^.e1);
                LeaveScope(ctx, sc2);
                ctx.sem.loop_depth := save_loop;
              End;
          End;
        N_STATIC_BLOCK:
          Begin
            save_loop := ctx.sem.loop_depth;
            ctx.sem.loop_depth := 0;
            sc2 := EnterScope(ctx, m, SK_FUNCTION, FK_STATIC_BLOCK);
            SemNode(ctx, NodeP(ctx.ast.nodes, m)^.e1);
            LeaveScope(ctx, sc2);
            ctx.sem.loop_depth := save_loop;
          End;
      End;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  LeaveScope(ctx, sc);
  ctx.sem.cur_class := save_class;
End;

Procedure SemNode(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, e, decl_target: LongInt;
  s: TTokenText;
  was_typeof: Boolean;
Begin
  If (n = 0) Or ctx.sem.stop Then
    Exit;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_BLOCK:
      Begin
        If NodeP(ctx.ast.nodes, n)^.flags = 1 Then
          SemList(ctx, NodeP(ctx.ast.nodes, n)^.e1)
        Else
          Begin
            sc := EnterScope(ctx, n, SK_BLOCK, FK_NONE);
            SemList(ctx, NodeP(ctx.ast.nodes, n)^.e1);
            LeaveScope(ctx, sc);
          End;
      End;
    N_DECLARATOR:
      Begin
        decl_target := NodeP(ctx.ast.nodes, n)^.e1;
        SetInitializing(ctx, decl_target, NodeP(ctx.ast.nodes, n)^.e2 <> 0);
        SemNode(ctx, decl_target);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
        SetInitializing(ctx, decl_target, False);
      End;
    N_FOR, N_FOR_IN, N_FOR_OF:
      Begin
        ctx.sem.next_in_loop := True;
        sc := EnterScope(ctx, n, SK_BLOCK, FK_NONE);
        If NodeP(ctx.ast.nodes, n)^.kind = N_FOR Then
          Begin
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e3);
            Inc(ctx.sem.loop_depth);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e4);
            Dec(ctx.sem.loop_depth);
          End
        Else
          Begin
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
            e := NodeP(ctx.ast.nodes, n)^.e1;
            If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_VAR_DECL) Then
              SemNode(ctx, e)
            Else
              SemTarget(ctx, e);
            Inc(ctx.sem.loop_depth);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e3);
            Dec(ctx.sem.loop_depth);
          End;
        LeaveScope(ctx, sc);
      End;
    N_WHILE:
      Begin
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Inc(ctx.sem.loop_depth);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
        Dec(ctx.sem.loop_depth);
      End;
    N_DO_WHILE:
      Begin
        Inc(ctx.sem.loop_depth);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Dec(ctx.sem.loop_depth);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      End;
    N_SWITCH:
      Begin
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        sc := EnterScope(ctx, n, SK_BLOCK, FK_NONE);
        SemList(ctx, NodeP(ctx.ast.nodes, n)^.e2);
        LeaveScope(ctx, sc);
      End;
    N_CATCH:
      Begin
        sc := EnterScope(ctx, n, SK_CATCH, FK_NONE);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        e := NodeP(ctx.ast.nodes, n)^.e2;
        If e <> 0 Then
          SemList(ctx, NodeP(ctx.ast.nodes, e)^.e1);
        LeaveScope(ctx, sc);
      End;
    N_FUNC_DECL, N_FUNC_EXPR, N_METHOD:
      SemFunction(ctx, n);
    N_CLASS_DECL, N_CLASS_EXPR:
      SemClass(ctx, n);
    N_IDENT:
      ResolveIdent(ctx, n, RM_READ);
    N_THIS:
      ResolveThis(ctx, n);
    N_SUPER:
      ResolveSuper(ctx, n, False);
    N_ASSIGN:
      Begin
        s := SemTokText(ctx, NodeP(ctx.ast.nodes, n)^.tok);
        e := NodeP(ctx.ast.nodes, n)^.e1;
        If s = '=' Then
          SemTarget(ctx, e)
        Else If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_IDENT) Then
          ResolveIdent(ctx, e, RM_READWRITE)
        Else
          SemNode(ctx, e);
        SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      End;
    N_UPDATE:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_IDENT) Then
          ResolveIdent(ctx, e, RM_READWRITE)
        Else
          SemNode(ctx, e);
      End;
    N_UNARY:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        was_typeof := ctx.sem.in_typeof;
        If (SemTokText(ctx, NodeP(ctx.ast.nodes, n)^.tok) = 'typeof') And (e <> 0) And
           (NodeP(ctx.ast.nodes, e)^.kind = N_IDENT) Then
          ctx.sem.in_typeof := True;
        SemNode(ctx, e);
        ctx.sem.in_typeof := was_typeof;
      End;
    N_CALL:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_SUPER) Then
          ResolveSuper(ctx, e, True)
        Else
          SemNode(ctx, e);
        SemList(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      End;
    N_PROP:
      Begin
        If NodeP(ctx.ast.nodes, n)^.flags And PR_SPREAD <> 0 Then
          SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1)
        Else
          Begin
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e2);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e1);
            SemNode(ctx, NodeP(ctx.ast.nodes, n)^.e3);
          End;
      End;
  Else
    SemChildren(ctx, n);
  End;
End;

{ var declare dans un bloc imbrique : ne doit pas croiser un let/const/class
  du meme nom dans les portees traversees. }
Procedure CheckVarHoisting(Var ctx: TCompilerContext);
Var
  i, sc, target, sy: LongInt;
  name: TTokenText;
Begin
  For i := 1 To ctx.ast.decl_count Do
    If (DeclP(ctx.ast.decls, i)^.kind = DK_VAR) And
       (DeclP(ctx.ast.decls, i)^.origin <> DeclP(ctx.ast.decls, i)^.scope) Then
      Begin
        name := SemTokText(ctx, DeclP(ctx.ast.decls, i)^.name_tok);
        target := NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.scope)^.scope;
        sc := NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.origin)^.scope;
        While (sc <> 0) And (sc <> target) Do
          Begin
            sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
            While sy <> 0 Do
              Begin
                If IsLexicalKind(SymP(ctx.sem.syms, sy)^.kind) And
                   (SemTokText(ctx, SymP(ctx.sem.syms, sy)^.name_tok) = name) Then
                  SemError(ctx, DeclP(ctx.ast.decls, i)^.name_tok,
                           'redeclaration de "' + name +
                           '" (let/const/class ligne ' +
                           LineOfTok(ctx, SymP(ctx.sem.syms, sy)^.name_tok) +
                           ' dans une portee englobante)');
                sy := SymP(ctx.sem.syms, sy)^.next;
              End;
            sc := ScopeP(ctx.sem.scopes, sc)^.parent;
          End;
      End;
End;

Function AnalyzeProgram(Var ctx: TCompilerContext): Boolean;
Var
  i, sc: LongInt;
Begin
  AnalyzeProgram := False;
  If ctx.ast.root = 0 Then
    Begin
      PipelineError(ctx, 'AST absent avant l''analyse semantique');
      Exit;
    End;
  ctx.sem.scope_count := 0;
  ctx.sem.sym_count := 0;
  ctx.sem.cap_count := 0;
  ctx.sem.cur_scope := 0;
  ctx.sem.loop_depth := 0;
  ctx.sem.cur_class := 0;
  ctx.sem.nt_tok := 0;
  ctx.sem.in_typeof := False;
  ctx.sem.stop := False;
  ctx.sem.next_in_loop := False;
  { liste des declarations de chaque portee, dans l'ordre du source }
  For i := 1 To ctx.ast.node_count Do
    Begin
      NodeP(ctx.ast.nodes, i)^.decl_head := 0;
      NodeP(ctx.ast.nodes, i)^.scope := 0;
      NodeP(ctx.ast.nodes, i)^.sym := 0;
      NodeP(ctx.ast.nodes, i)^.aux := 0;
    End;
  For i := ctx.ast.decl_count Downto 1 Do
    Begin
      DeclP(ctx.ast.decls, i)^.next := NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.scope)^.decl_head;
      NodeP(ctx.ast.nodes, DeclP(ctx.ast.decls, i)^.scope)^.decl_head := i;
    End;
  sc := EnterScope(ctx, ctx.ast.root, SK_GLOBAL, FK_GLOBAL);
  SemList(ctx, NodeP(ctx.ast.nodes, ctx.ast.root)^.e1);
  CheckVarHoisting(ctx);
  ctx.ast.analyzed := True;
  If ctx.options.verbose Then
    Writeln('Semant.: ', ctx.sem.scope_count, ' portees, ', ctx.sem.sym_count,
            ' symboles, ', ctx.sem.cap_count, ' captures');
  AnalyzeProgram := ctx.errors = 0;
End;

{ ---- Affichage des portees et des symboles (option -scopes) ---- }

Function ScopeKindName(kind: TScopeKind): TString;
Begin
  Case kind Of
    SK_GLOBAL:   ScopeKindName := 'globale';
    SK_FUNCTION: ScopeKindName := 'fonction';
    SK_BLOCK:    ScopeKindName := 'bloc';
    SK_CLASS:    ScopeKindName := 'classe';
    SK_CATCH:    ScopeKindName := 'catch';
  Else
    ScopeKindName := '?';
  End;
End;

Function FuncKindName(fk: TFuncKind): TString;
Begin
  Case fk Of
    FK_GLOBAL:            FuncKindName := 'global';
    FK_FUNCTION:          FuncKindName := 'fonction';
    FK_ARROW:             FuncKindName := 'fleche';
    FK_METHOD:            FuncKindName := 'methode';
    FK_CTOR:              FuncKindName := 'constructeur';
    FK_DERIVED_CTOR:      FuncKindName := 'constructeur-derive';
    FK_STATIC_METHOD:     FuncKindName := 'methode-statique';
    FK_STATIC_BLOCK:      FuncKindName := 'bloc-statique';
    FK_FIELD_INIT:        FuncKindName := 'champ';
    FK_STATIC_FIELD_INIT: FuncKindName := 'champ-statique';
  Else
    FuncKindName := '';
  End;
End;

Function ThisBindingName(b: LongInt): TString;
Begin
  Case b Of
    TB_GLOBAL:       ThisBindingName := 'global';
    TB_FUNCTION:     ThisBindingName := 'fonction';
    TB_METHOD:       ThisBindingName := 'methode';
    TB_CTOR:         ThisBindingName := 'constructeur';
    TB_DERIVED_CTOR: ThisBindingName := 'constructeur-derive';
    TB_STATIC:       ThisBindingName := 'classe';
    TB_FIELD:        ThisBindingName := 'instance-champ';
  Else
    ThisBindingName := '?';
  End;
End;

Procedure DumpScopes(Var ctx: TCompilerContext);
Var
  i, sy, k: LongInt;
  fl: LongInt;
Begin
  Writeln('Portees (', ctx.sem.scope_count, ') :');
  For i := 1 To ctx.sem.scope_count Do
    Begin
      If ScopeP(ctx.sem.scopes, i)^.kind = SK_FUNCTION Then
        Write('  #', i, ' ', FuncKindName(ScopeP(ctx.sem.scopes, i)^.fkind))
      Else
        Write('  #', i, ' ', ScopeKindName(ScopeP(ctx.sem.scopes, i)^.kind));
      Write(' (', NodeKindName(NodeP(ctx.ast.nodes, ScopeP(ctx.sem.scopes, i)^.node)^.kind), '@',
            TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, ScopeP(ctx.sem.scopes, i)^.node)^.tok)^.line, ')');
      If ctx.ir.built And (ScopeP(ctx.sem.scopes, i)^.frame_size > 0) Then
        Write(' trame=', ScopeP(ctx.sem.scopes, i)^.frame_size);
      If ScopeP(ctx.sem.scopes, i)^.parent <> 0 Then
        Write(' parent=#', ScopeP(ctx.sem.scopes, i)^.parent);
      If ScopeP(ctx.sem.scopes, i)^.in_loop Then
        Write(' boucle');
      If ScopeP(ctx.sem.scopes, i)^.uses_this Then
        Write(' this');
      If ScopeP(ctx.sem.scopes, i)^.this_captured Then
        Write(' this-capture');
      If ScopeP(ctx.sem.scopes, i)^.uses_arguments Then
        Write(' arguments');
      Writeln;
      sy := ScopeP(ctx.sem.scopes, i)^.first_sym;
      While sy <> 0 Do
        Begin
          fl := SymP(ctx.sem.syms, sy)^.flags;
          Write('      ', DeclKindName(SymP(ctx.sem.syms, sy)^.kind), ' ',
                SemTokText(ctx, SymP(ctx.sem.syms, sy)^.name_tok), ' (#', sy, ')');
          If ctx.ir.built And (SymP(ctx.sem.syms, sy)^.slot > 0) Then
            Write(' [ebp-', 8 * SymP(ctx.sem.syms, sy)^.slot, ']');
          If fl And SF_HOISTED <> 0 Then
            Write(' hisse');
          If fl And SF_STATIC <> 0 Then
            Write(' statique');
          If fl And SF_CAPTURED <> 0 Then
            Write(' capture');
          If fl And SF_CELL <> 0 Then
            Write(' cellule');
          If fl And SF_PER_ITER <> 0 Then
            Write(' par-iteration');
          If fl And SF_TDZ_CHECK <> 0 Then
            Write(' test-tdz');
          If fl And SF_REASSIGNED <> 0 Then
            Write(' reaffecte');
          If fl And SF_IMPLICIT <> 0 Then
            Write(' implicite');
          Writeln;
          sy := SymP(ctx.sem.syms, sy)^.next;
        End;
    End;
  Writeln('Captures (', ctx.sem.cap_count, ') :');
  For k := 1 To ctx.sem.cap_count Do
    Writeln('  portee #', CapP(ctx.sem.caps, k)^.fscope, ' capture ',
            SemTokText(ctx, SymP(ctx.sem.syms, CapP(ctx.sem.caps, k)^.sym)^.name_tok),
            ' (#', CapP(ctx.sem.caps, k)^.sym, ')');
End;


Procedure WriteAnnotation(Var ctx: TCompilerContext; n: LongInt);
Begin
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_IDENT:
      Begin
        Write(' ->');
        Case NodeP(ctx.ast.nodes, n)^.aux Of
          RK_LOCAL:           Write(' local #', NodeP(ctx.ast.nodes, n)^.sym);
          RK_OUTER:           Write(' capture #', NodeP(ctx.ast.nodes, n)^.sym);
          RK_BUILTIN:         Write(' predefini');
          RK_GLOBAL_IMPLICIT: Write(' globale-implicite #', NodeP(ctx.ast.nodes, n)^.sym);
          RK_ARGUMENTS:       Write(' arguments');
          RK_UNDECLARED_OK:   Write(' non-declare (typeof)');
        Else
          Write(' non-resolu');
        End;
      End;
    N_THIS:
      Begin
        Write(' -> this ', ThisBindingName(NodeP(ctx.ast.nodes, n)^.aux));
        If NodeP(ctx.ast.nodes, n)^.e1 = 1 Then
          Write(' lexical (portee #', NodeP(ctx.ast.nodes, n)^.sym, ')');
      End;
    N_BIND_IDENT, N_FUNC_DECL, N_CLASS_DECL:
      If NodeP(ctx.ast.nodes, n)^.sym <> 0 Then
        Write(' #', NodeP(ctx.ast.nodes, n)^.sym);
  End;
End;

{ ============================================================
  TODO 7 - MODELE DE VALEURS RUNTIME ET GESTIONNAIRE MEMOIRE

  Valeur JavaScript : 8 octets (deux DWORD), passee et rangee telle
  quelle dans les variables, les tableaux, les proprietes et les
  cellules. Le DWORD bas (lo) est la charge utile, le DWORD haut (hi)
  est l'etiquette.

    hi <  FFF90000h  nombre IEEE 754 double (lo:hi = les 8 octets du
                     double, lisible directement par fld qword)
    hi >= FFF90000h  valeur etiquetee : hi = FFF90000h + type

  Types : 0 int32, 1 undefined, 2 null, 3 boolean, 4 string, 5 object,
  6 array, 7 function, 8 regexp, 9 marque TDZ et 10 fin d'iteration
  (internes). Un nombre est donc soit un double,
  soit un int32 (chemin rapide entier : add/sub/imul avec test de
  depassement, repli sur le FPU). Les deux formes sont equivalentes ;
  les operations acceptent les deux et la forme canonique n'est pas
  imposee. Un int32 ne represente pas -0 : toute operation qui peut
  produire -0 passe par le double. Le NaN materiel (FFF80000h:0) est un
  double valide.

  Tas : ramasse-miettes conservatif sans deplacement (marquage et balayage).
  Les petites cellules (16 octets a 32 Ko) vivent dans des pages de 16 Ko ou
  de 64 Ko par classe de taille, les cellules plus grandes dans des blocs
  obtenus par VirtualAlloc (et rendus par VirtualFree), les cellules sans
  pointeur (chaines) dans des pages a part qui ne sont pas parcourues. Un
  repertoire d'une entree par fenetre de 64 Ko retrouve la page ou le bloc de
  n'importe quelle adresse. Une collecte part des piles (principale et
  coroutines), des registres et de la section .data ; tout mot qui designe
  l'interieur d'une cellule allouee la retient (pointeurs internes compris),
  d'ou un risque de retention a tort mais jamais de cellule liberee a tort.
  Declenchement : apres 8 Mo alloues depuis la derniere collecte (puis autant
  que de memoire vivante). Les cellules sont rendues a zero a l'allocation.
  Les tableaux et tables de proprietes grandissent par doublement pour borner
  le gaspillage a 2 fois la taille finale. __gc() force une collecte,
  __gcstats() rend [octets vivants, collectes], __gcstress(n) collecte tous les
  n octets alloues (essais). Memoire epuisee : message sur stderr et ExitProcess(3).
  ============================================================ }

{ ---- Outils de description du modele ---- }

Function RtHex4(v: LongInt): TString;
Const
  H = '0123456789ABCDEF';
Begin
  RtHex4 := H[((v Shr 12) And 15) + 1] + H[((v Shr 8) And 15) + 1] +
            H[((v Shr 4) And 15) + 1] + H[(v And 15) + 1];
End;

{ Etiquette complete (hi) d'un type, en hexadecimal assembleur. }
Function RtTagHex(t: LongInt): TString;
Begin
  RtTagHex := RT_TAG_PREFIX + RtHex4(t) + 'h';
End;

Function RtTagName(t: LongInt): TString;
Begin
  Case t Of
    RT_T_INT32:     RtTagName := 'int32';
    RT_T_UNDEFINED: RtTagName := 'undefined';
    RT_T_NULL:      RtTagName := 'null';
    RT_T_BOOLEAN:   RtTagName := 'boolean';
    RT_T_STRING:    RtTagName := 'string';
    RT_T_OBJECT:    RtTagName := 'object';
    RT_T_ARRAY:     RtTagName := 'array';
    RT_T_FUNCTION:  RtTagName := 'function';
    RT_T_REGEXP:    RtTagName := 'regexp';
    RT_T_TDZ:       RtTagName := 'tdz (interne)';
    RT_T_DONE:      RtTagName := 'fin d''iteration (interne)';
  Else
    RtTagName := '?';
  End;
End;

Function RtComponentName(bit: LongInt): TString;
Begin
  Case bit Of
    RC_HEAP:           RtComponentName := 'tas';
    RC_FPU:            RtComponentName := 'fpu';
    RC_STRING:         RtComponentName := 'chaines';
    RC_NUMTOSTR:       RtComponentName := 'nombre->chaine';
    RC_ARRAY:          RtComponentName := 'tableaux';
    RC_OBJECT:         RtComponentName := 'objets';
    RC_FUNCTION:       RtComponentName := 'fonctions';
    RC_CELL:           RtComponentName := 'cellules';
    RC_CLASS:          RtComponentName := 'classes';
    RC_EXCEPTION:      RtComponentName := 'exceptions';
    RC_REGEXP:         RtComponentName := 'regexp';
    RC_CONSOLE:        RtComponentName := 'console';
    RC_PROCESS:        RtComponentName := 'process';
    RC_MATH:           RtComponentName := 'math';
    RC_JSON:           RtComponentName := 'json';
    RC_STRING_METHODS: RtComponentName := 'methodes-string';
    RC_ARRAY_METHODS:  RtComponentName := 'methodes-tableau';
    RC_OBJECT_STATICS: RtComponentName := 'statiques-object';
    RC_NUMBER_FUNCS:   RtComponentName := 'fonctions-nombre';
    RC_CONVERT:        RtComponentName := 'conversions';
    RC_STDIN:          RtComponentName := 'stdin';
    RC_TYPEOF:         RtComponentName := 'typeof';
    RC_INSTANCEOF:     RtComponentName := 'instanceof/in';
    RC_ARGUMENTS:      RtComponentName := 'arguments';
  Else
    RtComponentName := '?';
  End;
End;

{ Composants du runtime qu'impose l'usage d'une propriete par son nom. }
Function MemberComponents(Const name: TTokenText): LongInt;
Begin
  MemberComponents := 0;
  If (name = 'charAt') Or (name = 'charCodeAt') Or (name = 'toUpperCase') Or
     (name = 'toLowerCase') Or (name = 'trim') Or (name = 'padStart') Or
     (name = 'padEnd') Or (name = 'repeat') Or (name = 'startsWith') Or
     (name = 'endsWith') Or (name = 'substring') Or (name = 'split') Or
     (name = 'replace') Or (name = 'match') Or (name = 'search') Or
     (name = 'lastIndexOf') Or (name = 'fromCharCode') Then
    MemberComponents := RC_STRING Or RC_STRING_METHODS
  Else If (name = 'push') Or (name = 'pop') Or (name = 'shift') Or
          (name = 'unshift') Or (name = 'reverse') Or (name = 'sort') Or
          (name = 'forEach') Or (name = 'map') Or (name = 'filter') Or
          (name = 'reduce') Or (name = 'join') Or (name = 'concat') Or
          (name = 'splice') Or (name = 'isArray') Then
    MemberComponents := RC_ARRAY Or RC_ARRAY_METHODS Or RC_FUNCTION
  Else If (name = 'indexOf') Or (name = 'includes') Or (name = 'slice') Or
          (name = 'length') Then
    MemberComponents := RC_STRING Or RC_ARRAY
  Else If (name = 'keys') Or (name = 'values') Or (name = 'entries') Or
          (name = 'assign') Or (name = 'create') Or (name = 'freeze') Or
          (name = 'getPrototypeOf') Or (name = 'hasOwnProperty') Then
    MemberComponents := RC_OBJECT Or RC_OBJECT_STATICS Or RC_ARRAY
  Else If (name = 'isInteger') Or (name = 'toFixed') Or (name = 'toString') Then
    MemberComponents := RC_NUMBER_FUNCS Or RC_NUMTOSTR Or RC_STRING
  Else If (name = 'stringify') Or (name = 'parse') Then
    MemberComponents := RC_JSON Or RC_STRING Or RC_OBJECT
  Else If (name = 'test') Or (name = 'exec') Then
    MemberComponents := RC_REGEXP Or RC_STRING
  Else If (name = 'write') Or (name = 'exit') Then
    MemberComponents := RC_PROCESS;
End;

{ Composants imposes par un global predefini. }
Function BuiltinComponents(Const name: TTokenText): LongInt;
Begin
  BuiltinComponents := 0;
  If name = 'console' Then
    BuiltinComponents := RC_CONSOLE Or RC_CONVERT Or RC_NUMTOSTR Or RC_STRING
  Else If (name = 'alert') Then
    BuiltinComponents := RC_CONSOLE Or RC_CONVERT Or RC_NUMTOSTR Or RC_STRING
  Else If name = 'prompt' Then
    BuiltinComponents := RC_STDIN Or RC_STRING
  Else If name = 'process' Then
    BuiltinComponents := RC_PROCESS
  Else If name = 'Math' Then
    BuiltinComponents := RC_MATH Or RC_FPU
  Else If name = 'JSON' Then
    BuiltinComponents := RC_JSON Or RC_STRING Or RC_OBJECT
  Else If name = 'Object' Then
    BuiltinComponents := RC_OBJECT Or RC_OBJECT_STATICS
  Else If name = 'Array' Then
    BuiltinComponents := RC_ARRAY
  Else If (name = 'String') Or (name = 'Number') Or (name = 'Boolean') Or
          (name = 'parseInt') Or (name = 'parseFloat') Or (name = 'isNaN') Or
          (name = 'isFinite') Then
    BuiltinComponents := RC_NUMBER_FUNCS Or RC_CONVERT Or RC_STRING
  Else If name = 'RegExp' Then
    BuiltinComponents := RC_REGEXP Or RC_STRING
  Else If (name = 'Error') Or (name = 'TypeError') Or (name = 'RangeError') Or
          (name = 'SyntaxError') Or (name = 'ReferenceError') Or
          (name = 'EvalError') Or (name = 'URIError') Then
    BuiltinComponents := RC_EXCEPTION Or RC_OBJECT Or RC_STRING
  Else If (name = 'NaN') Or (name = 'Infinity') Then
    BuiltinComponents := RC_FPU;
End;

{ ---- Construction du modele a partir du programme ---- }

{ Un litteral entier qui tient dans un int32 reste en TAG_INT32. }
Function FitsInt32(v: Double): Boolean;
Begin
  FitsInt32 := (v >= -2147483648.0) And (v <= 2147483647.0) And (Int(v) = v);
End;

Function BuildRuntimeModel(Var ctx: TCompilerContext): Boolean;
Var
  i, e, sy: LongInt;
  name: TTokenText;
  s: TTokenText;
Begin
  BuildRuntimeModel := False;
  If Not ctx.ast.analyzed Then
    Begin
      PipelineError(ctx, 'analyse semantique absente avant le modele runtime');
      Exit;
    End;
  ctx.rt.comps := RC_HEAP;
  ctx.rt.int_literals := 0;
  ctx.rt.double_literals := 0;
  ctx.rt.string_literals := 0;
  ctx.rt.template_literals := 0;
  ctx.rt.regex_literals := 0;
  ctx.rt.array_literals := 0;
  ctx.rt.object_literals := 0;
  ctx.rt.functions := 0;
  ctx.rt.closures := 0;
  ctx.rt.classes := 0;
  ctx.rt.cells := 0;
  ctx.rt.try_blocks := 0;
  ctx.rt.throws := 0;
  ctx.rt.calls := 0;
  ctx.rt.news := 0;

  For i := 1 To ctx.ast.node_count Do
    Case NodeP(ctx.ast.nodes, i)^.kind Of
      N_NUMBER:
        Begin
          If FitsInt32(TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.num_val) Then
            Inc(ctx.rt.int_literals)
          Else
            Begin
              Inc(ctx.rt.double_literals);
              ctx.rt.comps := ctx.rt.comps Or RC_FPU;
            End;
        End;
      N_STRING:
        Begin
          Inc(ctx.rt.string_literals);
          ctx.rt.comps := ctx.rt.comps Or RC_STRING;
        End;
      N_TEMPLATE:
        Begin
          Inc(ctx.rt.template_literals);
          ctx.rt.comps := ctx.rt.comps Or RC_STRING Or RC_NUMTOSTR Or RC_CONVERT;
        End;
      N_TAGGED:
        ctx.rt.comps := ctx.rt.comps Or RC_FUNCTION Or RC_ARRAY Or RC_STRING;
      N_REGEX:
        Begin
          Inc(ctx.rt.regex_literals);
          ctx.rt.comps := ctx.rt.comps Or RC_REGEXP Or RC_STRING;
        End;
      N_ARRAY_LIT:
        Begin
          Inc(ctx.rt.array_literals);
          ctx.rt.comps := ctx.rt.comps Or RC_ARRAY;
        End;
      N_OBJECT_LIT:
        Begin
          Inc(ctx.rt.object_literals);
          ctx.rt.comps := ctx.rt.comps Or RC_OBJECT;
        End;
      N_FUNC_DECL, N_FUNC_EXPR, N_METHOD:
        Begin
          Inc(ctx.rt.functions);
          ctx.rt.comps := ctx.rt.comps Or RC_FUNCTION;
          If ScopeP(ctx.sem.scopes, NodeP(ctx.ast.nodes, i)^.scope)^.cap_count > 0 Then
            Inc(ctx.rt.closures);
        End;
      N_CLASS_DECL, N_CLASS_EXPR:
        Begin
          Inc(ctx.rt.classes);
          ctx.rt.comps := ctx.rt.comps Or RC_CLASS Or RC_OBJECT Or RC_FUNCTION;
        End;
      N_TRY:
        Begin
          Inc(ctx.rt.try_blocks);
          ctx.rt.comps := ctx.rt.comps Or RC_EXCEPTION;
        End;
      N_THROW:
        Begin
          Inc(ctx.rt.throws);
          ctx.rt.comps := ctx.rt.comps Or RC_EXCEPTION;
        End;
      N_CALL:
        Inc(ctx.rt.calls);
      N_NEW:
        Begin
          Inc(ctx.rt.news);
          ctx.rt.comps := ctx.rt.comps Or RC_OBJECT Or RC_FUNCTION;
        End;
      N_MEMBER:
        ctx.rt.comps := ctx.rt.comps Or RC_OBJECT Or
          MemberComponents(TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text);
      N_INDEX:
        ctx.rt.comps := ctx.rt.comps Or RC_OBJECT Or RC_ARRAY Or RC_STRING;
      N_PROP:
        ctx.rt.comps := ctx.rt.comps Or RC_OBJECT;
      N_UNARY:
        Begin
          s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text;
          If s = 'typeof' Then
            ctx.rt.comps := ctx.rt.comps Or RC_TYPEOF Or RC_STRING
          Else If s = 'delete' Then
            ctx.rt.comps := ctx.rt.comps Or RC_OBJECT;
          { -0 : litteral zero precede d'un moins }
          e := NodeP(ctx.ast.nodes, i)^.e1;
          If (s = '-') And (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_NUMBER) And
             (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, e)^.tok)^.num_val = 0) Then
            ctx.rt.comps := ctx.rt.comps Or RC_FPU;
        End;
      N_BINARY:
        Begin
          s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text;
          If s = '+' Then
            ctx.rt.comps := ctx.rt.comps Or RC_STRING Or RC_CONVERT
          Else If (s = '/') Or (s = '**') Or (s = '%') Then
            ctx.rt.comps := ctx.rt.comps Or RC_FPU
          Else If (s = 'instanceof') Or (s = 'in') Then
            ctx.rt.comps := ctx.rt.comps Or RC_INSTANCEOF Or RC_OBJECT
          Else If (s = '==') Or (s = '!=') Or (s = '<') Or (s = '>') Or
                  (s = '<=') Or (s = '>=') Then
            ctx.rt.comps := ctx.rt.comps Or RC_CONVERT;
        End;
      N_ASSIGN:
        Begin
          s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text;
          If s = '+=' Then
            ctx.rt.comps := ctx.rt.comps Or RC_STRING Or RC_CONVERT
          Else If (s = '/=') Or (s = '**=') Or (s = '%=') Then
            ctx.rt.comps := ctx.rt.comps Or RC_FPU;
        End;
      N_IDENT:
        Begin
          If NodeP(ctx.ast.nodes, i)^.aux = RK_BUILTIN Then
            ctx.rt.comps := ctx.rt.comps Or
              BuiltinComponents(TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text)
          Else If (NodeP(ctx.ast.nodes, i)^.sym <> 0) And
                  (SymP(ctx.sem.syms, NodeP(ctx.ast.nodes, i)^.sym)^.kind = DK_ARGS) Then
            ctx.rt.comps := ctx.rt.comps Or RC_ARGUMENTS Or RC_ARRAY;
        End;
    End;

  For sy := 1 To ctx.sem.sym_count Do
    If SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0 Then
      Inc(ctx.rt.cells);
  If ctx.rt.cells > 0 Then
    ctx.rt.comps := ctx.rt.comps Or RC_CELL Or RC_FUNCTION;

  ctx.rt.built := True;
  If ctx.options.verbose Then
    Writeln('Runtime: valeur ', RT_VALUE_SIZE, ' octets, ',
            ctx.rt.int_literals, ' entiers, ', ctx.rt.double_literals,
            ' flottants, ', ctx.rt.string_literals, ' chaines, ',
            ctx.rt.functions, ' fonctions (', ctx.rt.closures,
            ' avec environnement), ', ctx.rt.cells, ' cellules');
  BuildRuntimeModel := ctx.errors = 0;
End;

{ ---- Affichage du modele (option -runtime) ---- }

Procedure DumpRuntimeModel(Var ctx: TCompilerContext);
Var
  b: LongInt;
  first: Boolean;
Begin
  Writeln('Modele runtime (32 bits) :');
  Writeln('  Valeur : ', RT_VALUE_SIZE, ' octets, lo = charge utile (+', RT_VAL_LO,
          '), hi = etiquette (+', RT_VAL_HI, ')');
  Writeln('    hi < ', RT_TAG_PREFIX, '0000h : nombre double IEEE 754');
  For b := RT_T_INT32 To RT_T_DONE Do
    Writeln('    ', RtTagHex(b), '  ', RtTagName(b));
  Writeln('    nombre = double ou int32 ; -0 et depassement passent par le FPU');
  Writeln('    FPU : mot de controle ', RT_FPU_CW, 'h (double precision, arrondi au plus pres)');
  Writeln('  Cellule du tas : en-tete de ', RT_HDR_SIZE, ' octets, alignement ',
          RT_ALIGN);
  Writeln('    +', RT_HDR_KIND, ' kind(1)  +', RT_HDR_GC, ' gc(1)  +',
          RT_HDR_FLAGS, ' flags(2)  +', RT_HDR_U16, ' u16len+1(4)');
  Writeln('  Dispositions :');
  Writeln('    kinds    : ', RT_OK_STRING, ' chaine, ', RT_OK_ARRAY, ' tableau, ',
          RT_OK_OBJECT, ' objet, ', RT_OK_FUNCTION, ' fonction, ', RT_OK_CELL,
          ' cellule, ', RT_OK_REGEXP, ' regexp, ', RT_OK_ENV, ' environnement');
  Writeln('    chaine   : len +', RT_STR_LEN, ', hash +', RT_STR_HASH,
          ', octets UTF-8 +', RT_STR_DATA, ' (zero final)');
  Writeln('    tableau  : len +', RT_ARR_LEN, ', cap +', RT_ARR_CAP,
          ', elements +', RT_ARR_ELEMS, ' (taille ', RT_ARR_SIZE, ')');
  Writeln('    objet    : proto +', RT_OBJ_PROTO, ', props +', RT_OBJ_PROPS,
          ', nb +', RT_OBJ_COUNT, ', cap +', RT_OBJ_CAP, ', classe +',
          RT_OBJ_CLASS, ' (taille ', RT_OBJ_SIZE, ')');
  Writeln('    propriete: cle +', RT_PROP_KEY, ', drapeaux +', RT_PROP_FLAGS,
          ', valeur +', RT_PROP_VALUE, ' (', RT_PROP_SIZE, ' octets)');
  Writeln('    fonction : code +', RT_FN_CODE, ', env +', RT_FN_ENV,
          ', descripteur +', RT_FN_DESC, ', props +', RT_FN_PROPS,
          ', this lexical +', RT_FN_THIS, ' (taille ', RT_FN_SIZE, ')');
  Writeln('    descript.: nom +', RT_FD_NAME, ', nb params +', RT_FD_NPARAMS,
          ', drapeaux +', RT_FD_FLAGS, ', nb cellules +', RT_FD_NCELLS,
          ' (', RT_FD_SIZE, ' octets, en .rdata)');
  Writeln('    classe   : nom +', RT_CD_NAME, ', ctor +', RT_CD_CTOR, ', drapeaux +',
          RT_CD_FLAGS, ', nb membres +', RT_CD_NMEMBERS, ', membres +',
          RT_CD_MEMBERS, ' (', RT_CM_SIZE, ' octets : cle, drapeaux, descripteur)');
  Writeln('    cellule  : valeur +', RT_CELL_VALUE, ' (taille ', RT_CELL_SIZE, ')');
  Writeln('    environ. : nb +', RT_ENV_COUNT, ', pointeurs de cellules +',
          RT_ENV_CELLS);
  Writeln('    regexp   : source +', RT_RX_SOURCE, ', drapeaux +', RT_RX_FLAGS,
          ', programme +', RT_RX_PROG, ', lastIndex +', RT_RX_LASTINDEX,
          ' (taille ', RT_RX_SIZE, ')');
  Writeln('  Tas : ramasse-miettes conservatif (marquage et balayage), pages de 16 Ko et 64 Ko,');
  Writeln('    grands blocs par VirtualAlloc, collecte tous les 8 Mo alloues ; chaines : longueur');
  Writeln('    UTF-16 + 1 (+', RT_HDR_U16, ')');
  Writeln('  Pile : reserve ', RT_STACK_RESERVE Div 1024, ' Ko, limite souple ',
          RT_STACK_GUARD Div 1024, ' Ko (RangeError si depassee)');
  Writeln('    appel : [EBP+', RT_FRAME_CLOSURE, '] fonction, [EBP+',
          RT_FRAME_ARGC, '] argc, [EBP+', RT_FRAME_THIS, '] this (8 octets),');
  Writeln('            [EBP+', RT_FRAME_ARGS, '] arguments (8 octets chacun)');
  Writeln('            locaux sous EBP par pas de ', RT_VALUE_SIZE,
          ' ; retour dans EDX:EAX ; EBX, ESI, EDI preserves ; appelant nettoie');
  Writeln('    gestionnaire d''exception : prec +', RT_EH_PREV, ', esp +',
          RT_EH_ESP, ', ebp +', RT_EH_EBP, ', catch +', RT_EH_CATCH,
          ' (', RT_EH_SIZE, ' octets)');
  If ctx.rt.built Then
    Begin
      Writeln('Programme :');
      Writeln('  litteraux : ', ctx.rt.int_literals, ' entiers, ',
              ctx.rt.double_literals, ' flottants, ', ctx.rt.string_literals,
              ' chaines, ', ctx.rt.template_literals, ' gabarits, ',
              ctx.rt.regex_literals, ' regexp, ', ctx.rt.array_literals,
              ' tableaux, ', ctx.rt.object_literals, ' objets');
      Writeln('  code : ', ctx.rt.functions, ' fonctions (', ctx.rt.closures,
              ' avec captures), ', ctx.rt.classes, ' classes, ', ctx.rt.cells,
              ' cellules, ', ctx.rt.calls, ' appels, ', ctx.rt.news, ' new, ',
              ctx.rt.try_blocks, ' try, ', ctx.rt.throws, ' throw');
      Write('  composants du runtime a lier :');
      first := True;
      b := 1;
      While b <= RC_LAST Do
        Begin
          If ctx.rt.comps And b <> 0 Then
            Begin
              If Not first Then
                Write(',');
              Write(' ', RtComponentName(b));
              first := False;
            End;
          b := b * 2;
        End;
      Writeln;
    End;
End;

{ ============================================================
  TODO 8 - POOL DE CONSTANTES ET DE DONNEES

  Toutes les donnees statiques du programme sont construites ici, en
  octets, avec leurs symboles et leurs relocations :

    .rdata  chaines internees (une cellule de chaine par chaine
            distincte), constantes double, descripteurs de fonctions,
            descripteurs de classes, table des atomes.
    .data   variables du runtime et variables globales du programme
            (8 octets chacune, initialisees a undefined ou a la marque
            TDZ).

  Une chaine litterale et un nom de propriete identiques partagent la
  meme cellule. Les noms de proprietes sont des atomes : comme les
  atomes sont internes, une propriete se retrouve par comparaison de
  pointeurs. La table des atomes permet au runtime de les enregistrer
  dans sa table de hachage au demarrage. Le hachage des chaines est
  FNV-1a 32 bits sur les octets UTF-8.

  Nommage des symboles (stable, prefixe) :
    _JSK_nnnn  chaine        _JSD_nnnn  constante double
    _JSFD_nnnn descripteur   _JSF_nnnn_nom  code d'une fonction
    _JSC_nnnn  classe        _JSV_nom  variable globale
    _JSL_nnnn  etiquette     _JSRT_nom routine ou donnee du runtime
    _JSATOMS   table des atomes
  ============================================================ }

{ ---- Nommage ---- }

Function Pad4(n: LongInt): TString;
Var
  s: String[12];
Begin
  Str(n, s);
  While Length(s) < 4 Do
    s := '0' + s;
  Pad4 := s;
End;

{ Identifiant JavaScript -> suffixe de symbole : lettres, chiffres et _
  gardes ; $ devient _S_ ; les octets non ASCII deviennent _xHH. }
Function MangleIdent(Const s: TTokenText): TString;
Var
  r: TString;
  i: Integer;
  c: Char;
Begin
  r := '';
  For i := 1 To Length(s) Do
    Begin
      c := s[i];
      If ((c >= 'A') And (c <= 'Z')) Or ((c >= 'a') And (c <= 'z')) Or
         ((c >= '0') And (c <= '9')) Or (c = '_') Then
        r := r + c
      Else If c = '$' Then
        r := r + '_S_'
      Else
        r := r + '_x' + Copy(RtHex4(Ord(c)), 3, 2);
    End;
  MangleIdent := r;
End;

Function SymStr(id: LongInt): TString;
Begin
  SymStr := '_JSK_' + Pad4(id);
End;

Function SymDbl(id: LongInt): TString;
Begin
  SymDbl := '_JSD_' + Pad4(id);
End;

Function SymFdesc(id: LongInt): TString;
Begin
  SymFdesc := '_JSFD_' + Pad4(id);
End;

Function SymClassDesc(id: LongInt): TString;
Begin
  SymClassDesc := '_JSC_' + Pad4(id);
End;

Function SymLabel(id: LongInt): TString;
Begin
  SymLabel := '_JSL_' + Pad4(id);
End;

Function SymRt(Const name: TString): TString;
Begin
  SymRt := '_JSRT_' + name;
End;

{ ---- Ecriture dans les images de sections ---- }

Procedure DataFail(Var ctx: TCompilerContext; Const msg: TString);
Begin
  If Not ctx.data.failed Then
    PipelineError(ctx, msg);
  ctx.data.failed := True;
End;

Procedure PutByte(Var ctx: TCompilerContext; sec: Integer; ofs: LongInt; b: LongInt);
Begin
  If sec = SEC_RDATA Then
    Begin
      RdP(ctx.data.rd, ofs)^ := Byte(b And $FF);
    End
  Else
    Begin
      DtP(ctx.data.dt, ofs)^ := Byte(b And $FF);
    End;
End;

{ Ecrit un DWORD petit-boutiste ; v peut etre non signe (Int64). }
Procedure PutDword(Var ctx: TCompilerContext; sec: Integer; ofs: LongInt; v: Int64);
Var
  i: Integer;
  w: Int64;
Begin
  w := v And $FFFFFFFF;
  For i := 0 To 3 Do
    Begin
      PutByte(ctx, sec, ofs + i, w And $FF);
      w := w Shr 8;
    End;
End;

Function SecSize(Var ctx: TCompilerContext; sec: Integer): LongInt;
Begin
  If sec = SEC_RDATA Then
    SecSize := ctx.data.rd_size
  Else
    SecSize := ctx.data.dt_size;
End;

{ Reserve n octets alignes sur 8 ; retourne l'offset. }
Function SecAlloc(Var ctx: TCompilerContext; sec: Integer; n: LongInt): LongInt;
Var
  ofs: LongInt;
Begin
  If sec = SEC_RDATA Then
    Begin
      ofs := (ctx.data.rd_size + 7) And Not 7;
      ctx.data.rd_size := ofs + n;
    End
  Else
    Begin
      ofs := (ctx.data.dt_size + 7) And Not 7;
      ctx.data.dt_size := ofs + n;
    End;
  SecAlloc := ofs;
End;

Function NameHash(Const s: TString): LongInt;
Var
  h: Int64;
  i: Integer;
Begin
  h := 2166136261;
  For i := 1 To Length(s) Do
    Begin
      h := h Xor Ord(s[i]);
      h := (h * 16777619) And $FFFFFFFF;
    End;
  NameHash := h And 65535;
End;

{ Indice du symbole de donnees de ce nom, ou 0. }
Function DsymFind(Var ctx: TCompilerContext; Const name: TString): LongInt;
Var
  slot, id: LongInt;
Begin
  slot := NameHash(name);
  DsymFind := 0;
  id := DhashP(ctx.data.dhash, slot)^;
  While id <> 0 Do
    Begin
      If DsymP(ctx.data.syms, id)^.name = name Then
        Begin
          DsymFind := id;
          Exit;
        End;
      id := DsymP(ctx.data.syms, id)^.chain;
    End;
End;

Function NewDataSym(Var ctx: TCompilerContext; Const name: TString;
                    sec: Integer; ofs, size: LongInt; kind: Integer): LongInt;
Var
  slot, id: LongInt;
Begin
  NewDataSym := 0;
  Inc(ctx.data.sym_count);
  DsymP(ctx.data.syms, ctx.data.sym_count)^.name := name;
  DsymP(ctx.data.syms, ctx.data.sym_count)^.sec := sec;
  DsymP(ctx.data.syms, ctx.data.sym_count)^.ofs := ofs;
  DsymP(ctx.data.syms, ctx.data.sym_count)^.size := size;
  DsymP(ctx.data.syms, ctx.data.sym_count)^.kind := kind;
  slot := NameHash(name);
  DsymP(ctx.data.syms, ctx.data.sym_count)^.chain := 0;
  If DhashP(ctx.data.dhash, slot)^ = 0 Then
    DhashP(ctx.data.dhash, slot)^ := ctx.data.sym_count
  Else
    Begin
      { ajoute en fin de file : le premier symbole du nom reste le premier trouve }
      id := DhashP(ctx.data.dhash, slot)^;
      While DsymP(ctx.data.syms, id)^.chain <> 0 Do
        id := DsymP(ctx.data.syms, id)^.chain;
      DsymP(ctx.data.syms, id)^.chain := ctx.data.sym_count;
    End;
  NewDataSym := ctx.data.sym_count;
End;

{ Le DWORD a (sec, ofs) contient l'adresse du symbole target. }
Procedure AddReloc(Var ctx: TCompilerContext; sec: Integer; ofs, target: LongInt);
Begin
  Inc(ctx.data.reloc_count);
  RelocP(ctx.data.relocs, ctx.data.reloc_count)^.sec := sec;
  RelocP(ctx.data.relocs, ctx.data.reloc_count)^.tkind := SYMK_D;
  RelocP(ctx.data.relocs, ctx.data.reloc_count)^.ofs := ofs;
  RelocP(ctx.data.relocs, ctx.data.reloc_count)^.target := target;
End;

{ Relocation vers un symbole de code ou externe (indice de xsyms). }
Procedure AddRelocX(Var ctx: TCompilerContext; sec: Integer; ofs, target: LongInt);
Begin
  AddReloc(ctx, sec, ofs, target);
  If ctx.data.reloc_count > 0 Then
    RelocP(ctx.data.relocs, ctx.data.reloc_count)^.tkind := SYMK_X;
End;

{ ---- Chaines internees ---- }

Function JsHash(Var ctx: TCompilerContext; off, len: LongInt): Int64;
Var
  h: Int64;
  i: LongInt;
Begin
  h := 2166136261;
  For i := 0 To len - 1 Do
    Begin
      h := h Xor Ord(DpoolP(ctx.data.dpool, off + i)^);
      h := (h * 16777619) And $FFFFFFFF;
    End;
  JsHash := h;
End;

{ La chaine est deja copiee dans dpool a partir de off ; la retire si elle
  existe deja. Retourne son identifiant. }
Function InternAt(Var ctx: TCompilerContext; off, len: LongInt): LongInt;
Var
  h: Int64;
  slot, id, i: LongInt;
  same: Boolean;
Begin
  InternAt := 0;
  h := JsHash(ctx, off, len);
  slot := h And (HASH_SIZE - 1);
  id := HashP(ctx.data.hash, slot)^;
  While id <> 0 Do
    Begin
      If (StrP(ctx.data.strs, id)^.len = len) And (StrP(ctx.data.strs, id)^.hash = h) Then
        Begin
          same := True;
          For i := 0 To len - 1 Do
            If DpoolP(ctx.data.dpool, StrP(ctx.data.strs, id)^.off + i)^ <> DpoolP(ctx.data.dpool, off + i)^ Then
              same := False;
          If same Then
            Begin
              ctx.data.dpool_len := off;
              InternAt := id;
              Exit;
            End;
        End;
      id := StrP(ctx.data.strs, id)^.chain;
    End;
  Inc(ctx.data.str_count);
  id := ctx.data.str_count;
  StrP(ctx.data.strs, id)^.off := off;
  StrP(ctx.data.strs, id)^.len := len;
  StrP(ctx.data.strs, id)^.hash := h;
  StrP(ctx.data.strs, id)^.atom_id := 0;
  StrP(ctx.data.strs, id)^.sym := 0;
  StrP(ctx.data.strs, id)^.chain := HashP(ctx.data.hash, slot)^;
  HashP(ctx.data.hash, slot)^ := id;
  InternAt := id;
End;

Procedure DpoolPut(Var ctx: TCompilerContext; c: Char);
Begin
  DpoolP(ctx.data.dpool, ctx.data.dpool_len)^ := c;
  Inc(ctx.data.dpool_len);
End;

Function InternPool(Var ctx: TCompilerContext; off, len: LongInt): LongInt;
Var
  start, i: LongInt;
Begin
  start := ctx.data.dpool_len;
  For i := 0 To len - 1 Do
    DpoolPut(ctx, PoolP(ctx.lex.pool, off + i)^);
  InternPool := InternAt(ctx, start, len);
End;

Function InternText(Var ctx: TCompilerContext; Const s: TString): LongInt;
Var
  start, i: LongInt;
Begin
  start := ctx.data.dpool_len;
  For i := 1 To Length(s) Do
    DpoolPut(ctx, s[i]);
  InternText := InternAt(ctx, start, Length(s));
End;

{ Marque une chaine comme atome (nom de propriete). }
Function MarkAtom(Var ctx: TCompilerContext; id: LongInt): LongInt;
Begin
  If (id <> 0) And (StrP(ctx.data.strs, id)^.atom_id = 0) Then
    Begin
      Inc(ctx.data.atom_count);
      StrP(ctx.data.strs, id)^.atom_id := ctx.data.atom_count;
      AtomP(ctx.data.atoms, ctx.data.atom_count)^ := id;
    End;
  MarkAtom := id;
End;

{ Nom de propriete porte par un jeton : identifiant, mot-cle, chaine ou
  nombre (forme canonique si entier). }
Function KeyString(Var ctx: TCompilerContext; tok: LongInt): LongInt;
Var
  s: String[24];
  v: Double;
Begin
  KeyString := 0;
  Case TokP(ctx.lex.tokens, tok)^.kind Of
    TK_IDENT, TK_KEYWORD:
      KeyString := InternText(ctx, TokP(ctx.lex.tokens, tok)^.text);
    TK_STRING:
      KeyString := InternPool(ctx, TokP(ctx.lex.tokens, tok)^.sval_off,
                              TokP(ctx.lex.tokens, tok)^.sval_len);
    TK_NUMBER:
      Begin
        v := TokP(ctx.lex.tokens, tok)^.num_val;
        If FitsInt32(v) Then
          Begin
            Str(Trunc(v), s);
            KeyString := InternText(ctx, s);
          End
        Else
          KeyString := InternText(ctx, TokP(ctx.lex.tokens, tok)^.text);
      End;
  End;
End;

{ ---- Constantes double ---- }

Function AddDoubleBits(Var ctx: TCompilerContext; lo, hi: Int64): LongInt;
Var
  i: LongInt;
Begin
  For i := 1 To ctx.data.dbl_count Do
    If (DblP(ctx.data.dbls, i)^.lo = lo) And (DblP(ctx.data.dbls, i)^.hi = hi) Then
      Begin
        AddDoubleBits := i;
        Exit;
      End;
  AddDoubleBits := 0;
  Inc(ctx.data.dbl_count);
  DblP(ctx.data.dbls, ctx.data.dbl_count)^.lo := lo;
  DblP(ctx.data.dbls, ctx.data.dbl_count)^.hi := hi;
  DblP(ctx.data.dbls, ctx.data.dbl_count)^.sym := 0;
  AddDoubleBits := ctx.data.dbl_count;
End;

Function AddDouble(Var ctx: TCompilerContext; v: Double): LongInt;
Var
  w: Array[0..1] Of LongInt;
Begin
  Move(v, w, 8);
  AddDouble := AddDoubleBits(ctx, Int64(w[0]) And $FFFFFFFF,
                             Int64(w[1]) And $FFFFFFFF);
End;

Function StrText(Var ctx: TCompilerContext; id: LongInt): TString;
Var
  r: TString;
  i, n: LongInt;
Begin
  n := StrP(ctx.data.strs, id)^.len;
  If n > 250 Then
    n := 250;
  r := '';
  For i := 0 To n - 1 Do
    r := r + DpoolP(ctx.data.dpool, StrP(ctx.data.strs, id)^.off + i)^;
  StrText := r;
End;

{ ---- Descripteurs ---- }

Function NodeFuncName(Var ctx: TCompilerContext; n: LongInt): LongInt;
Var
  t: LongInt;
Begin
  NodeFuncName := InternText(ctx, '');
  t := NodeP(ctx.ast.nodes, n)^.tok;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_FUNC_DECL, N_CLASS_DECL:
      NodeFuncName := KeyString(ctx, t);
    N_FUNC_EXPR, N_CLASS_EXPR:
      Begin
        If (NodeP(ctx.ast.nodes, n)^.kind = N_FUNC_EXPR) And
           (NodeP(ctx.ast.nodes, n)^.flags And FN_ARROW <> 0) Then
          { une fleche est anonyme : son nom vient de sa cible }
        Else If TokP(ctx.lex.tokens, t)^.kind = TK_IDENT Then
          NodeFuncName := KeyString(ctx, t)
        Else If (NodeP(ctx.ast.nodes, n)^.flags And FN_METHOD <> 0) And
                (TokP(ctx.lex.tokens, t)^.kind <> TK_PUNCT) Then
          NodeFuncName := KeyString(ctx, t);
      End;
    N_METHOD, N_FIELD:
      If NodeP(ctx.ast.nodes, n)^.flags And MF_COMPUTED = 0 Then
        NodeFuncName := KeyString(ctx, t);
  End;
End;

Function ParamLength(Var ctx: TCompilerContext; n: LongInt): LongInt;
Var
  p, cnt: LongInt;
  stop: Boolean;
Begin
  cnt := 0;
  stop := False;
  p := NodeP(ctx.ast.nodes, n)^.e1;
  If NodeP(ctx.ast.nodes, n)^.kind = N_FIELD Then
    p := 0;
  If NodeP(ctx.ast.nodes, n)^.kind = N_STATIC_BLOCK Then
    p := 0;
  While (p <> 0) And Not stop Do
    Begin
      If (NodeP(ctx.ast.nodes, p)^.flags And PF_REST <> 0) Or (NodeP(ctx.ast.nodes, p)^.e2 <> 0) Then
        stop := True
      Else
        Inc(cnt);
      p := NodeP(ctx.ast.nodes, p)^.next;
    End;
  ParamLength := cnt;
End;

Procedure AddFuncDesc(Var ctx: TCompilerContext; n: LongInt);
Var
  id, fl, sc, nsy: LongInt;
  nm: LongInt;
Begin
  Inc(ctx.data.fd_count);
  id := ctx.data.fd_count;
  fl := 0;
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_FUNC_DECL, N_FUNC_EXPR:
      Begin
        If NodeP(ctx.ast.nodes, n)^.flags And FN_ARROW <> 0 Then
          fl := fl Or FDF_ARROW;
        If NodeP(ctx.ast.nodes, n)^.flags And FN_ASYNC <> 0 Then
          fl := fl Or FDF_ASYNC;
        If NodeP(ctx.ast.nodes, n)^.flags And FN_GENERATOR <> 0 Then
          fl := fl Or FDF_GENERATOR;
        If NodeP(ctx.ast.nodes, n)^.flags And FN_METHOD <> 0 Then
          fl := fl Or FDF_METHOD;
        If NodeP(ctx.ast.nodes, n)^.flags And FN_EXPR_BODY <> 0 Then
          fl := fl Or FDF_EXPR_BODY;
      End;
    N_METHOD:
      Begin
        fl := fl Or FDF_METHOD;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_STATIC <> 0 Then
          fl := fl Or FDF_STATIC;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_GETTER <> 0 Then
          fl := fl Or FDF_GETTER;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_SETTER <> 0 Then
          fl := fl Or FDF_SETTER;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_ASYNC <> 0 Then
          fl := fl Or FDF_ASYNC;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_GENERATOR <> 0 Then
          fl := fl Or FDF_GENERATOR;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_CONSTRUCTOR <> 0 Then
          Begin
            fl := fl Or FDF_CTOR;
            If ScopeP(ctx.sem.scopes, sc)^.fkind = FK_DERIVED_CTOR Then
              fl := fl Or FDF_DERIVED;
          End;
      End;
    N_FIELD:
      Begin
        fl := fl Or FDF_FIELD_INIT;
        If NodeP(ctx.ast.nodes, n)^.flags And MF_STATIC <> 0 Then
          fl := fl Or FDF_STATIC;
      End;
    N_STATIC_BLOCK:
      fl := fl Or FDF_STATIC_BLOCK Or FDF_STATIC;
  End;
  If sc <> 0 Then
    Begin
      If ScopeP(ctx.sem.scopes, sc)^.uses_this Then
        fl := fl Or FDF_USES_THIS;
      If ScopeP(ctx.sem.scopes, sc)^.uses_arguments Then
        fl := fl Or FDF_USES_ARGS;
      If ScopeP(ctx.sem.scopes, sc)^.this_captured Then
        fl := fl Or FDF_THIS_CAPTURED;
      nsy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
      While nsy <> 0 Do
        Begin
          If SymP(ctx.sem.syms, nsy)^.kind = DK_NEWTARGET Then
            fl := fl Or FDF_USES_NT;
          nsy := SymP(ctx.sem.syms, nsy)^.next;
        End;
      FdescP(ctx.data.fdescs, id)^.ncells := ScopeP(ctx.sem.scopes, sc)^.cap_count;
    End
  Else
    FdescP(ctx.data.fdescs, id)^.ncells := 0;
  nm := NodeFuncName(ctx, n);
  FdescP(ctx.data.fdescs, id)^.node := n;
  FdescP(ctx.data.fdescs, id)^.name_str := nm;
  FdescP(ctx.data.fdescs, id)^.nparams := ParamLength(ctx, n);
  FdescP(ctx.data.fdescs, id)^.flags := fl;
  FdescP(ctx.data.fdescs, id)^.sym := 0;
  FdescP(ctx.data.fdescs, id)^.code_sym := '_JSF_' + Pad4(id);
  If StrP(ctx.data.strs, nm)^.len > 0 Then
    FdescP(ctx.data.fdescs, id)^.code_sym := FdescP(ctx.data.fdescs, id)^.code_sym + '_' +
      MangleIdent(Copy(StrText(ctx, nm), 1, 40));
  NodeP(ctx.ast.nodes, n)^.ds := id;
End;

Procedure AddClassDesc(Var ctx: TCompilerContext; n: LongInt);
Var
  id, m, f: LongInt;
  cm: LongInt;
Begin
  Inc(ctx.data.cd_count);
  id := ctx.data.cd_count;
  CdescP(ctx.data.cdescs, id)^.node := n;
  CdescP(ctx.data.cdescs, id)^.name_str := NodeFuncName(ctx, n);
  CdescP(ctx.data.cdescs, id)^.ctor_fd := 0;
  CdescP(ctx.data.cdescs, id)^.flags := 0;
  CdescP(ctx.data.cdescs, id)^.first_member := ctx.data.cm_count + 1;
  CdescP(ctx.data.cdescs, id)^.member_count := 0;
  CdescP(ctx.data.cdescs, id)^.sym := 0;
  If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
    CdescP(ctx.data.cdescs, id)^.flags := CdescP(ctx.data.cdescs, id)^.flags Or CDF_DERIVED;
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      Inc(ctx.data.cm_count);
      cm := ctx.data.cm_count;
      f := 0;
      CmemP(ctx.data.cmembers, cm)^.key_str := 0;
      CmemP(ctx.data.cmembers, cm)^.fd := NodeP(ctx.ast.nodes, m)^.ds;
      Case NodeP(ctx.ast.nodes, m)^.kind Of
        N_METHOD:
          Begin
            f := f Or CM_METHOD;
            If NodeP(ctx.ast.nodes, m)^.flags And MF_GETTER <> 0 Then
              f := f Or CM_GETTER;
            If NodeP(ctx.ast.nodes, m)^.flags And MF_SETTER <> 0 Then
              f := f Or CM_SETTER;
            If NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR <> 0 Then
              Begin
                f := f Or CM_CTOR;
                CdescP(ctx.data.cdescs, id)^.ctor_fd := NodeP(ctx.ast.nodes, m)^.ds;
              End;
          End;
        N_FIELD:
          f := f Or CM_FIELD;
        N_STATIC_BLOCK:
          f := f Or CM_STATIC_BLOCK;
      End;
      If NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0 Then
        f := f Or CM_STATIC;
      If NodeP(ctx.ast.nodes, m)^.flags And MF_COMPUTED <> 0 Then
        f := f Or CM_COMPUTED;
      CmemP(ctx.data.cmembers, cm)^.flags := f;
      If NodeP(ctx.ast.nodes, m)^.kind <> N_STATIC_BLOCK Then
        CmemP(ctx.data.cmembers, cm)^.key_str := NodeP(ctx.ast.nodes, m)^.aux;
      Inc(CdescP(ctx.data.cdescs, id)^.member_count);
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  NodeP(ctx.ast.nodes, n)^.ds := id;
End;

{ ---- Chaines et constantes standard du runtime ---- }

Procedure AddStandardData(Var ctx: TCompilerContext);
Var
  i: Integer;
  id: LongInt;
Begin
  For i := 1 To STD_STR_COUNT Do
    Begin
      id := InternText(ctx, StdStrings[i]);
      If i >= STD_ATOM_FIRST Then
        MarkAtom(ctx, id);
    End;
  { 0, 1, -0, NaN, +Inf, -Inf, 2^31, 2^32, 1e21, 10 }
  AddDoubleBits(ctx, 0, 0);
  AddDoubleBits(ctx, 0, $3FF00000);
  AddDoubleBits(ctx, 0, $80000000);
  AddDoubleBits(ctx, 0, $FFF80000);
  AddDoubleBits(ctx, 0, $7FF00000);
  AddDoubleBits(ctx, 0, $FFF00000);
  AddDoubleBits(ctx, 0, $41E00000);
  AddDoubleBits(ctx, 0, $41F00000);
  AddDoubleBits(ctx, $D6E2EF50, $444B1AE4);
  AddDoubleBits(ctx, 0, $40240000);
End;

{ ---- Collecte dans l'AST ---- }

{ Le nom d'une fonction ou d'une classe anonyme vient de sa cible (variable, propriete de litteral
  ou affectation) ; le constructeur d'une classe porte le nom de la classe. }
Procedure NameFuncNode(Var ctx: TCompilerContext; v, tok: LongInt);
Var
  nm: LongInt;
Begin
  If v = 0 Then
    Exit;
  nm := KeyString(ctx, tok);
  Case NodeP(ctx.ast.nodes, v)^.kind Of
    N_FUNC_EXPR:
      If (NodeP(ctx.ast.nodes, v)^.ds > 0) And
         (StrP(ctx.data.strs, FdescP(ctx.data.fdescs, NodeP(ctx.ast.nodes, v)^.ds)^.name_str)^.len = 0) Then
        FdescP(ctx.data.fdescs, NodeP(ctx.ast.nodes, v)^.ds)^.name_str := nm;
    N_CLASS_EXPR:
      If (NodeP(ctx.ast.nodes, v)^.ds > 0) And
         (StrP(ctx.data.strs, CdescP(ctx.data.cdescs, NodeP(ctx.ast.nodes, v)^.ds)^.name_str)^.len = 0) Then
        CdescP(ctx.data.cdescs, NodeP(ctx.ast.nodes, v)^.ds)^.name_str := nm;
  End;
End;

Procedure InferFuncNames(Var ctx: TCompilerContext);
Var
  i, t: LongInt;
Begin
  For i := 1 To ctx.ast.node_count Do
    Case NodeP(ctx.ast.nodes, i)^.kind Of
      N_DECLARATOR:
        Begin
          t := NodeP(ctx.ast.nodes, i)^.e1;
          If (t <> 0) And (NodeP(ctx.ast.nodes, t)^.kind = N_BIND_IDENT) Then
            NameFuncNode(ctx, NodeP(ctx.ast.nodes, i)^.e2, NodeP(ctx.ast.nodes, t)^.tok);
        End;
      N_PROP:
        If NodeP(ctx.ast.nodes, i)^.flags And (PR_SPREAD Or PR_COMPUTED Or PR_METHOD) = 0 Then
          NameFuncNode(ctx, NodeP(ctx.ast.nodes, i)^.e1, NodeP(ctx.ast.nodes, i)^.tok);
      N_ASSIGN:
        Begin
          t := NodeP(ctx.ast.nodes, i)^.e1;
          If (t <> 0) And (NodeP(ctx.ast.nodes, t)^.kind = N_IDENT) And
             (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text = '=') Then
            NameFuncNode(ctx, NodeP(ctx.ast.nodes, i)^.e2, NodeP(ctx.ast.nodes, t)^.tok);
        End;
    End;
  For i := 1 To ctx.data.cd_count Do
    If CdescP(ctx.data.cdescs, i)^.ctor_fd <> 0 Then
      FdescP(ctx.data.fdescs, CdescP(ctx.data.cdescs, i)^.ctor_fd)^.name_str := CdescP(ctx.data.cdescs, i)^.name_str;
End;

Procedure CollectData(Var ctx: TCompilerContext);
Var
  i, e, tpl_end, tpl_off: LongInt;
  v: Double;
  s: TTokenText;
  eval_on: Boolean;
Begin
  For i := 1 To ctx.ast.node_count Do
    Begin
      NodeP(ctx.ast.nodes, i)^.ds := 0;
      Case NodeP(ctx.ast.nodes, i)^.kind Of
        N_STRING, N_TEMPLATE_STR:
          Begin
            If (NodeP(ctx.ast.nodes, i)^.kind = N_TEMPLATE_STR) And
               (NodeP(ctx.ast.nodes, i)^.flags = 1) Then
              Begin
                { texte brut du gabarit etiquete : entre les delimiteurs }
                e := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.pos + 1;
                tpl_end := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.pos +
                           TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.len;
                If (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.tpl = TP_NOSUB) Or
                   (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.tpl = TP_TAIL) Then
                  Dec(tpl_end)
                Else
                  Dec(tpl_end, 2);
                tpl_off := ctx.lex.pool_len;
                While e < tpl_end Do
                  Begin
                    PoolAppend(ctx, SrcCharP(ctx.source.buf, e)^);
                    Inc(e);
                  End;
                NodeP(ctx.ast.nodes, i)^.ds := InternPool(ctx, tpl_off,
                                                  ctx.lex.pool_len - tpl_off);
              End
            Else
              NodeP(ctx.ast.nodes, i)^.ds := InternPool(ctx,
                TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_off,
                TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_len);
          End;
        N_REGEX:
          Begin
            NodeP(ctx.ast.nodes, i)^.ds := InternPool(ctx,
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_off,
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_len);
            NodeP(ctx.ast.nodes, i)^.aux := InternPool(ctx,
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_off +
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.sval_len,
              TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.flag_len);
          End;
        N_NUMBER:
          Begin
            v := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.num_val;
            If Not FitsInt32(v) Then
              NodeP(ctx.ast.nodes, i)^.ds := AddDouble(ctx, v);
          End;
        N_UNARY:
          Begin
            s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text;
            e := NodeP(ctx.ast.nodes, i)^.e1;
            If (s = '-') And (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_NUMBER) And
               (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, e)^.tok)^.num_val = 0) Then
              NodeP(ctx.ast.nodes, i)^.ds := STD_DBL_NEGZERO;
          End;
        N_MEMBER:
          NodeP(ctx.ast.nodes, i)^.aux := MarkAtom(ctx,
            InternText(ctx, TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, i)^.tok)^.text));
        N_PROP:
          If NodeP(ctx.ast.nodes, i)^.flags And (PR_SPREAD Or PR_COMPUTED) = 0 Then
            NodeP(ctx.ast.nodes, i)^.aux := MarkAtom(ctx, KeyString(ctx, NodeP(ctx.ast.nodes, i)^.tok));
        N_PATTERN_PROP:
          If NodeP(ctx.ast.nodes, i)^.flags And (PP_REST Or PP_COMPUTED) = 0 Then
            NodeP(ctx.ast.nodes, i)^.aux := MarkAtom(ctx, KeyString(ctx, NodeP(ctx.ast.nodes, i)^.tok));
        N_FUNC_DECL, N_FUNC_EXPR, N_STATIC_BLOCK:
          AddFuncDesc(ctx, i);
        N_METHOD:
          Begin
            If NodeP(ctx.ast.nodes, i)^.flags And MF_COMPUTED = 0 Then
              NodeP(ctx.ast.nodes, i)^.aux := MarkAtom(ctx, KeyString(ctx, NodeP(ctx.ast.nodes, i)^.tok));
            AddFuncDesc(ctx, i);
          End;
        N_FIELD:
          Begin
            If NodeP(ctx.ast.nodes, i)^.flags And MF_COMPUTED = 0 Then
              NodeP(ctx.ast.nodes, i)^.aux := MarkAtom(ctx, KeyString(ctx, NodeP(ctx.ast.nodes, i)^.tok));
            If NodeP(ctx.ast.nodes, i)^.e1 <> 0 Then
              AddFuncDesc(ctx, i);
          End;
      End;
    End;
  { eval present (bloc optionnel du prelude) : les globales du programme sont
    exposees par nom a l'interprete }
  eval_on := False;
  For i := 1 To ctx.sem.sym_count Do
    If (SymP(ctx.sem.syms, i)^.flags And SF_STATIC <> 0) And (SymP(ctx.sem.syms, i)^.scope = 1) And
       (TokP(ctx.lex.tokens, SymP(ctx.sem.syms, i)^.name_tok)^.text = '__eval') Then
      eval_on := True;
  { noms des variables qui exigent un test TDZ a l'execution }
  For i := 1 To ctx.sem.sym_count Do
    Begin
      SymP(ctx.sem.syms, i)^.name_str := 0;
      If (SymP(ctx.sem.syms, i)^.flags And SF_TDZ_CHECK <> 0) Or
         (eval_on And (SymP(ctx.sem.syms, i)^.flags And SF_STATIC <> 0) And
          (SymP(ctx.sem.syms, i)^.scope = 1) And
          (Copy(TokP(ctx.lex.tokens, SymP(ctx.sem.syms, i)^.name_tok)^.text, 1, 2) <> '__')) Then
        SymP(ctx.sem.syms, i)^.name_str :=
          InternText(ctx, TokP(ctx.lex.tokens, SymP(ctx.sem.syms, i)^.name_tok)^.text);
    End;
  { descripteurs de classes : apres ceux des membres }
  For i := 1 To ctx.ast.node_count Do
    If (NodeP(ctx.ast.nodes, i)^.kind = N_CLASS_DECL) Or
       (NodeP(ctx.ast.nodes, i)^.kind = N_CLASS_EXPR) Then
      AddClassDesc(ctx, i);
  InferFuncNames(ctx);
End;

{ ---- Emission des sections ---- }

Procedure EmitStringCell(Var ctx: TCompilerContext; id: LongInt);
Var
  ofs, i, len, u16, b0: LongInt;
Begin
  len := StrP(ctx.data.strs, id)^.len;
  ofs := SecAlloc(ctx, SEC_RDATA, RT_STR_DATA + len + 1);
  If ctx.data.failed Then
    Exit;
  PutByte(ctx, SEC_RDATA, ofs + RT_HDR_KIND, RT_OK_STRING);
  PutByte(ctx, SEC_RDATA, ofs + RT_HDR_GC, 0);
  PutByte(ctx, SEC_RDATA, ofs + RT_HDR_FLAGS, OF_STATIC);
  PutDword(ctx, SEC_RDATA, ofs + RT_STR_LEN, len);
  u16 := 0;
  For i := 0 To len - 1 Do
    Begin
      b0 := Ord(DpoolP(ctx.data.dpool, StrP(ctx.data.strs, id)^.off + i)^);
      If b0 < $80 Then
        Inc(u16)
      Else If b0 >= $F0 Then
        Inc(u16, 2)
      Else If b0 >= $C0 Then
        Inc(u16);
    End;
  PutDword(ctx, SEC_RDATA, ofs + RT_HDR_U16, u16 + 1);
  PutDword(ctx, SEC_RDATA, ofs + RT_STR_HASH, StrP(ctx.data.strs, id)^.hash);
  For i := 0 To len - 1 Do
    PutByte(ctx, SEC_RDATA, ofs + RT_STR_DATA + i,
            Ord(DpoolP(ctx.data.dpool, StrP(ctx.data.strs, id)^.off + i)^));
  PutByte(ctx, SEC_RDATA, ofs + RT_STR_DATA + len, 0);
  StrP(ctx.data.strs, id)^.sym := NewDataSym(ctx, SymStr(id), SEC_RDATA, ofs,
                                      RT_STR_DATA + len + 1, DS_STRING);
End;

Procedure EmitDoubles(Var ctx: TCompilerContext);
Var
  i, ofs: LongInt;
Begin
  For i := 1 To ctx.data.dbl_count Do
    Begin
      ofs := SecAlloc(ctx, SEC_RDATA, 8);
      PutDword(ctx, SEC_RDATA, ofs, DblP(ctx.data.dbls, i)^.lo);
      PutDword(ctx, SEC_RDATA, ofs + 4, DblP(ctx.data.dbls, i)^.hi);
      DblP(ctx.data.dbls, i)^.sym := NewDataSym(ctx, SymDbl(i), SEC_RDATA, ofs, 8, DS_DOUBLE);
    End;
End;

Procedure EmitFuncDescs(Var ctx: TCompilerContext);
Var
  i, ofs: LongInt;
Begin
  For i := 1 To ctx.data.fd_count Do
    Begin
      ofs := SecAlloc(ctx, SEC_RDATA, RT_FD_SIZE);
      PutDword(ctx, SEC_RDATA, ofs + RT_FD_NAME, 0);
      AddReloc(ctx, SEC_RDATA, ofs + RT_FD_NAME,
               StrP(ctx.data.strs, FdescP(ctx.data.fdescs, i)^.name_str)^.sym);
      PutDword(ctx, SEC_RDATA, ofs + RT_FD_NPARAMS, FdescP(ctx.data.fdescs, i)^.nparams);
      PutDword(ctx, SEC_RDATA, ofs + RT_FD_FLAGS, FdescP(ctx.data.fdescs, i)^.flags);
      PutDword(ctx, SEC_RDATA, ofs + RT_FD_NCELLS, FdescP(ctx.data.fdescs, i)^.ncells);
      FdescP(ctx.data.fdescs, i)^.sym := NewDataSym(ctx, SymFdesc(i), SEC_RDATA, ofs,
                                           RT_FD_SIZE, DS_FDESC);
    End;
End;

Procedure EmitClassDescs(Var ctx: TCompilerContext);
Var
  i, j, ofs, size, mo, cm: LongInt;
Begin
  For i := 1 To ctx.data.cd_count Do
    Begin
      size := RT_CD_MEMBERS + RT_CM_SIZE * CdescP(ctx.data.cdescs, i)^.member_count;
      ofs := SecAlloc(ctx, SEC_RDATA, size);
      AddReloc(ctx, SEC_RDATA, ofs + RT_CD_NAME,
               StrP(ctx.data.strs, CdescP(ctx.data.cdescs, i)^.name_str)^.sym);
      If CdescP(ctx.data.cdescs, i)^.ctor_fd <> 0 Then
        AddReloc(ctx, SEC_RDATA, ofs + RT_CD_CTOR,
                 FdescP(ctx.data.fdescs, CdescP(ctx.data.cdescs, i)^.ctor_fd)^.sym);
      PutDword(ctx, SEC_RDATA, ofs + RT_CD_FLAGS, CdescP(ctx.data.cdescs, i)^.flags);
      PutDword(ctx, SEC_RDATA, ofs + RT_CD_NMEMBERS, CdescP(ctx.data.cdescs, i)^.member_count);
      For j := 0 To CdescP(ctx.data.cdescs, i)^.member_count - 1 Do
        Begin
          cm := CdescP(ctx.data.cdescs, i)^.first_member + j;
          mo := ofs + RT_CD_MEMBERS + RT_CM_SIZE * j;
          If CmemP(ctx.data.cmembers, cm)^.key_str <> 0 Then
            AddReloc(ctx, SEC_RDATA, mo + RT_CM_KEY,
                     StrP(ctx.data.strs, CmemP(ctx.data.cmembers, cm)^.key_str)^.sym);
          PutDword(ctx, SEC_RDATA, mo + RT_CM_FLAGS, CmemP(ctx.data.cmembers, cm)^.flags);
          If CmemP(ctx.data.cmembers, cm)^.fd <> 0 Then
            AddReloc(ctx, SEC_RDATA, mo + RT_CM_DESC,
                     FdescP(ctx.data.fdescs, CmemP(ctx.data.cmembers, cm)^.fd)^.sym);
        End;
      CdescP(ctx.data.cdescs, i)^.sym := NewDataSym(ctx, SymClassDesc(i), SEC_RDATA, ofs,
                                           size, DS_CLASSDESC);
    End;
End;

Procedure EmitAtomTable(Var ctx: TCompilerContext);
Var
  i, ofs: LongInt;
Begin
  ofs := SecAlloc(ctx, SEC_RDATA, 4 + 4 * ctx.data.atom_count);
  PutDword(ctx, SEC_RDATA, ofs, ctx.data.atom_count);
  For i := 1 To ctx.data.atom_count Do
    AddReloc(ctx, SEC_RDATA, ofs + 4 * i, StrP(ctx.data.strs, AtomP(ctx.data.atoms, i)^)^.sym);
  ctx.data.atom_table_sym := NewDataSym(ctx, '_JSATOMS', SEC_RDATA, ofs,
                                        4 + 4 * ctx.data.atom_count, DS_ATOMS);
End;

{ Valeur initiale d'une variable : undefined, ou la marque TDZ. }
Procedure PutValue(Var ctx: TCompilerContext; ofs, tag: LongInt);
Begin
  PutDword(ctx, SEC_DATA, ofs + RT_VAL_LO, 0);
  PutDword(ctx, SEC_DATA, ofs + RT_VAL_HI, RT_TAG_BASE + tag);
End;

Procedure EmitDataSection(Var ctx: TCompilerContext);
Var
  i, ofs, sy: LongInt;
  nm: TString;
Begin
  For i := 1 To RT_DATA_VAR_COUNT Do
    Begin
      ofs := SecAlloc(ctx, SEC_DATA, 8);
      nm := SymRt('v_' + RtDataVars[i]);
      NewDataSym(ctx, nm, SEC_DATA, ofs, 8, DS_RTVAR);
    End;
  For sy := 1 To ctx.sem.sym_count Do
    If (SymP(ctx.sem.syms, sy)^.flags And SF_STATIC <> 0) And
       ((SymP(ctx.sem.syms, sy)^.kind = DK_VAR) Or (SymP(ctx.sem.syms, sy)^.kind = DK_LET) Or
        (SymP(ctx.sem.syms, sy)^.kind = DK_CONST) Or (SymP(ctx.sem.syms, sy)^.kind = DK_FUNC) Or
        (SymP(ctx.sem.syms, sy)^.kind = DK_CLASS)) Then
      Begin
        ofs := SecAlloc(ctx, SEC_DATA, RT_VALUE_SIZE);
        nm := '_JSV_' + MangleIdent(TokP(ctx.lex.tokens, SymP(ctx.sem.syms, sy)^.name_tok)^.text);
        If SymP(ctx.sem.syms, sy)^.scope <> 1 Then
          nm := nm + '_' + Pad4(sy);
        If IsLexicalKind(SymP(ctx.sem.syms, sy)^.kind) And
           (SymP(ctx.sem.syms, sy)^.flags And SF_TDZ_CHECK <> 0) Then
          PutValue(ctx, ofs, RT_T_TDZ)
        Else
          PutValue(ctx, ofs, RT_T_UNDEFINED);
        SymP(ctx.sem.syms, sy)^.ds := NewDataSym(ctx, nm, SEC_DATA, ofs, RT_VALUE_SIZE,
                                          DS_GLOBAL);
        Inc(ctx.data.global_count);
      End;
End;

Function BuildDataPool(Var ctx: TCompilerContext): Boolean;
Var
  i: LongInt;
Begin
  BuildDataPool := False;
  If Not ctx.rt.built Then
    Begin
      PipelineError(ctx, 'modele runtime absent avant le pool de donnees');
      Exit;
    End;
  ctx.data.failed := False;
  ctx.data.str_count := 0;
  ctx.data.dpool_len := 0;
  ctx.data.atom_count := 0;
  ctx.data.dbl_count := 0;
  ctx.data.fd_count := 0;
  ctx.data.cd_count := 0;
  ctx.data.cm_count := 0;
  ctx.data.sym_count := 0;
  ctx.data.reloc_count := 0;
  ctx.data.rd_size := 0;
  ctx.data.dt_size := 0;
  ctx.data.global_count := 0;
  DlClear(ctx.data.hash);
  DlClear(ctx.data.dhash);
  For i := 1 To ctx.sem.sym_count Do
    SymP(ctx.sem.syms, i)^.ds := 0;

  AddStandardData(ctx);
  CollectData(ctx);

  For i := 1 To ctx.data.str_count Do
    If Not ctx.data.failed Then
      EmitStringCell(ctx, i);
  If Not ctx.data.failed Then
    EmitDoubles(ctx);
  If Not ctx.data.failed Then
    EmitFuncDescs(ctx);
  If Not ctx.data.failed Then
    EmitClassDescs(ctx);
  If Not ctx.data.failed Then
    EmitAtomTable(ctx);
  If Not ctx.data.failed Then
    EmitDataSection(ctx);

  ctx.data.built := Not ctx.data.failed;
  If ctx.options.verbose And ctx.data.built Then
    Writeln('Donnees: .rdata ', ctx.data.rd_size, ' octets (',
            ctx.data.str_count, ' chaines, ', ctx.data.atom_count, ' atomes, ',
            ctx.data.dbl_count, ' doubles, ', ctx.data.fd_count,
            ' fonctions, ', ctx.data.cd_count, ' classes), .data ',
            ctx.data.dt_size, ' octets (', ctx.data.global_count,
            ' globales), ', ctx.data.reloc_count, ' relocations');
  BuildDataPool := ctx.data.built And (ctx.errors = 0);
End;

{ ---- Affichage du pool (option -data) ---- }

Function DataSecName(sec: Integer): TString;
Begin
  If sec = SEC_RDATA Then
    DataSecName := '.rdata'
  Else
    DataSecName := '.data';
End;

Procedure PrintQuoted(Var ctx: TCompilerContext; id: LongInt);
Var
  i, n: LongInt;
  c: Char;
Begin
  n := StrP(ctx.data.strs, id)^.len;
  Write('"');
  For i := 0 To n - 1 Do
    Begin
      If i >= 40 Then
        Begin
          Write('...');
          Break;
        End;
      c := DpoolP(ctx.data.dpool, StrP(ctx.data.strs, id)^.off + i)^;
      If c = #10 Then
        Write('\n')
      Else If c < ' ' Then
        Write('?')
      Else
        Write(c);
    End;
  Write('"');
End;

Procedure DumpDataPool(Var ctx: TCompilerContext);
Var
  i, j, k: LongInt;
  fl: LongInt;
  line: LongInt;
Begin
  If Not ctx.data.built Then
    Exit;
  Writeln('Pool de donnees :');
  Writeln('  .rdata ', ctx.data.rd_size, ' octets, .data ', ctx.data.dt_size,
          ' octets, ', ctx.data.sym_count, ' symboles, ', ctx.data.reloc_count,
          ' relocations');
  Writeln('  Chaines (', ctx.data.str_count, ') :');
  For i := 1 To ctx.data.str_count Do
    Begin
      Write('    ', SymStr(i), ' ', DataSecName(DsymP(ctx.data.syms, StrP(ctx.data.strs, i)^.sym)^.sec),
            '+', DsymP(ctx.data.syms, StrP(ctx.data.strs, i)^.sym)^.ofs, ' ');
      PrintQuoted(ctx, i);
      Write(' len=', StrP(ctx.data.strs, i)^.len);
      If StrP(ctx.data.strs, i)^.atom_id <> 0 Then
        Write(' atome#', StrP(ctx.data.strs, i)^.atom_id);
      Writeln;
    End;
  Writeln('  Doubles (', ctx.data.dbl_count, ') :');
  For i := 1 To ctx.data.dbl_count Do
    Writeln('    ', SymDbl(i), ' hi=', RtHex4(DblP(ctx.data.dbls, i)^.hi Shr 16),
            RtHex4(DblP(ctx.data.dbls, i)^.hi), ' lo=', RtHex4(DblP(ctx.data.dbls, i)^.lo Shr 16),
            RtHex4(DblP(ctx.data.dbls, i)^.lo));
  Writeln('  Descripteurs de fonctions (', ctx.data.fd_count, ') :');
  For i := 1 To ctx.data.fd_count Do
    Begin
      fl := FdescP(ctx.data.fdescs, i)^.flags;
      Write('    ', SymFdesc(i), ' nom=');
      PrintQuoted(ctx, FdescP(ctx.data.fdescs, i)^.name_str);
      Write(' params=', FdescP(ctx.data.fdescs, i)^.nparams, ' cellules=',
            FdescP(ctx.data.fdescs, i)^.ncells, ' code=', FdescP(ctx.data.fdescs, i)^.code_sym);
      If fl And FDF_ARROW <> 0 Then Write(' fleche');
      If fl And FDF_ASYNC <> 0 Then Write(' async');
      If fl And FDF_GENERATOR <> 0 Then Write(' generateur');
      If fl And FDF_METHOD <> 0 Then Write(' methode');
      If fl And FDF_CTOR <> 0 Then Write(' constructeur');
      If fl And FDF_DERIVED <> 0 Then Write(' derive');
      If fl And FDF_STATIC <> 0 Then Write(' statique');
      If fl And FDF_GETTER <> 0 Then Write(' get');
      If fl And FDF_SETTER <> 0 Then Write(' set');
      If fl And FDF_USES_THIS <> 0 Then Write(' this');
      If fl And FDF_USES_ARGS <> 0 Then Write(' arguments');
      If fl And FDF_THIS_CAPTURED <> 0 Then Write(' this-capture');
      If fl And FDF_FIELD_INIT <> 0 Then Write(' champ');
      If fl And FDF_STATIC_BLOCK <> 0 Then Write(' bloc-statique');
      Writeln;
    End;
  Writeln('  Classes (', ctx.data.cd_count, ') :');
  For i := 1 To ctx.data.cd_count Do
    Begin
      Write('    ', SymClassDesc(i), ' nom=');
      PrintQuoted(ctx, CdescP(ctx.data.cdescs, i)^.name_str);
      Write(' membres=', CdescP(ctx.data.cdescs, i)^.member_count);
      If CdescP(ctx.data.cdescs, i)^.flags And CDF_DERIVED <> 0 Then
        Write(' derivee');
      If CdescP(ctx.data.cdescs, i)^.ctor_fd <> 0 Then
        Write(' ctor=', SymFdesc(CdescP(ctx.data.cdescs, i)^.ctor_fd));
      Writeln;
      For j := 0 To CdescP(ctx.data.cdescs, i)^.member_count - 1 Do
        Begin
          k := CdescP(ctx.data.cdescs, i)^.first_member + j;
          fl := CmemP(ctx.data.cmembers, k)^.flags;
          Write('      ');
          If CmemP(ctx.data.cmembers, k)^.key_str <> 0 Then
            PrintQuoted(ctx, CmemP(ctx.data.cmembers, k)^.key_str)
          Else
            Write('(sans cle)');
          If fl And CM_STATIC <> 0 Then Write(' statique');
          If fl And CM_METHOD <> 0 Then Write(' methode');
          If fl And CM_FIELD <> 0 Then Write(' champ');
          If fl And CM_GETTER <> 0 Then Write(' get');
          If fl And CM_SETTER <> 0 Then Write(' set');
          If fl And CM_CTOR <> 0 Then Write(' constructeur');
          If fl And CM_COMPUTED <> 0 Then Write(' calcule');
          If fl And CM_STATIC_BLOCK <> 0 Then Write(' bloc-statique');
          If CmemP(ctx.data.cmembers, k)^.fd <> 0 Then
            Write(' ', SymFdesc(CmemP(ctx.data.cmembers, k)^.fd));
          Writeln;
        End;
    End;
  Writeln('  Atomes : ', ctx.data.atom_count, ' dans _JSATOMS (.rdata+',
          DsymP(ctx.data.syms, ctx.data.atom_table_sym)^.ofs, ')');
  Writeln('  Donnees (.data) :');
  For i := 1 To ctx.data.sym_count Do
    If DsymP(ctx.data.syms, i)^.sec = SEC_DATA Then
      Writeln('    ', DsymP(ctx.data.syms, i)^.name, ' .data+', DsymP(ctx.data.syms, i)^.ofs,
              ' (', DsymP(ctx.data.syms, i)^.size, ' octets)');
  Writeln('  Octets .rdata (debut) :');
  i := 0;
  line := 0;
  While (i < ctx.data.rd_size) And (line < 24) Do
    Begin
      Write('    ', RtHex4(i), ':');
      For j := 0 To 15 Do
        If i + j < ctx.data.rd_size Then
          Write(' ', Copy(RtHex4(RdP(ctx.data.rd, i + j)^), 3, 2));
      Writeln;
      Inc(i, 16);
      Inc(line);
    End;
End;

{ ============================================================
  TODO 9 - CODE 80386 DES VARIABLES ET DES PORTEES

  Representation intermediaire (IR) : une liste d'instructions 80386
  symboliques (mnemonique, deux operandes, etiquettes, commentaires,
  debut et fin de procedure). Le TODO 22 l'ecrira en texte assembleur
  et le TODO 23 l'encodera en octets COFF ; les routines du runtime sont
  appelees par leur nom (_JSRT_nom) et resolues plus tard.

  Convention : toute expression laisse sa valeur de 8 octets dans
  EDX:EAX (hi:lo). ECX sert de registre de travail. Les routines du
  runtime sont appelees en cdecl, valeurs de 8 octets poussees sur la
  pile (poids fort d'abord), resultat dans EDX:EAX.

  Variables :
    statique   variable globale du programme : [_JSV_nom] dans .data
    locale     emplacement de 8 octets sous EBP : [EBP-8*n]
    cellule    l'emplacement contient un pointeur vers une cellule du
               tas (variable capturee par une fonction imbriquee) ;
               la valeur est a cellule+8
    externe    variable d'une fonction englobante : closure en
               [EBP+8], environnement en closure+12, pointeur de
               cellule en environnement+12+4*(k-1)
  Les symboles lexicaux qui exigent un test TDZ sont ranges avec la
  marque TDZ jusqu'a leur initialisation ; chaque lecture ou ecriture
  teste la marque et appelle _JSRT_throw_tdz.

  Les constructions dont le code est ecrit par les TODO suivants
  (operateurs, appels, controle de flux, fermetures, classes...) sont
  emises comme un commentaire EN ATTENTE, avec la valeur undefined, et
  comptees : le TODO 22 refusera de produire un programme tant qu'il en
  reste.
  ============================================================ }

{ ---- Operandes et instructions ---- }

Function ToLong(v: Int64): LongInt;
Begin
  v := v And $FFFFFFFF;
  If v > 2147483647 Then
    ToLong := v - 4294967296
  Else
    ToLong := v;
End;

Function TagImm(t: LongInt): LongInt;
Begin
  TagImm := ToLong(RT_TAG_BASE + t);
End;

Function RegOp(r: TReg): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_REG;
  o.reg := r;
  RegOp := o;
End;

Function ImmOp(v: LongInt): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_IMM;
  o.disp := v;
  ImmOp := o;
End;

Function MemReg(base: TReg; disp: LongInt): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_MEM;
  o.base := base;
  o.disp := disp;
  MemReg := o;
End;

{ Memoire a l'adresse d'un symbole de donnees (pool) ou externe. }
Function MemSym(symkind, sym, disp: LongInt): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_MEM;
  o.symkind := symkind;
  o.sym := sym;
  o.disp := disp;
  MemSym := o;
End;

Function AddrSym(symkind, sym: LongInt): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_ADDR;
  o.symkind := symkind;
  o.sym := sym;
  AddrSym := o;
End;

Function LabelOp(id: LongInt): TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  o.kind := OD_LABEL;
  o.disp := id;
  LabelOp := o;
End;

Function NoOp: TOperand;
Var
  o: TOperand;
Begin
  FillChar(o, SizeOf(o), 0);
  NoOp := o;
End;

Procedure Emit(Var ctx: TCompilerContext; op: TOpc; a, b: TOperand);
Begin
  Inc(ctx.ir.count);
  InstrP(ctx.ir.instrs, ctx.ir.count)^.op := op;
  InstrP(ctx.ir.instrs, ctx.ir.count)^.a := a;
  InstrP(ctx.ir.instrs, ctx.ir.count)^.b := b;
  InstrP(ctx.ir.instrs, ctx.ir.count)^.line := ctx.ir.cur_line;
End;

Procedure Emit0(Var ctx: TCompilerContext; op: TOpc);
Begin
  Emit(ctx, op, NoOp, NoOp);
End;

Procedure Emit1(Var ctx: TCompilerContext; op: TOpc; a: TOperand);
Begin
  Emit(ctx, op, a, NoOp);
End;

Function NewLabel(Var ctx: TCompilerContext): LongInt;
Begin
  Inc(ctx.ir.label_count);
  NewLabel := ctx.ir.label_count;
End;

Procedure PlaceLabel(Var ctx: TCompilerContext; id: LongInt);
Begin
  Emit1(ctx, OP_LABEL, LabelOp(id));
End;

Procedure EmitComment(Var ctx: TCompilerContext; Const text: TString);
Begin
  Inc(ctx.ir.comment_count);
  CommentP(ctx.ir.comments, ctx.ir.comment_count)^ := text;
  Emit1(ctx, OP_COMMENT, ImmOp(ctx.ir.comment_count));
End;

{ Symbole externe ou de code, retrouve par son nom. }
Function XSym(Var ctx: TCompilerContext; Const name: TString): LongInt;
Var
  i, slot: LongInt;
Begin
  slot := NameHash(name);
  i := XhashP(ctx.ir.xhash, slot)^;
  While i <> 0 Do
    Begin
      If XsymP(ctx.ir.xsyms, i)^.name = name Then
        Begin
          XSym := i;
          Exit;
        End;
      i := XsymP(ctx.ir.xsyms, i)^.chain;
    End;
  Inc(ctx.ir.xsym_count);
  XsymP(ctx.ir.xsyms, ctx.ir.xsym_count)^.name := name;
  XsymP(ctx.ir.xsyms, ctx.ir.xsym_count)^.defined := False;
  XsymP(ctx.ir.xsyms, ctx.ir.xsym_count)^.runtime := False;
  XsymP(ctx.ir.xsyms, ctx.ir.xsym_count)^.chain := XhashP(ctx.ir.xhash, slot)^;
  XhashP(ctx.ir.xhash, slot)^ := ctx.ir.xsym_count;
  XSym := ctx.ir.xsym_count;
End;

{ Appel d'une routine du runtime : nargbytes octets d'arguments a retirer. }
Procedure CallRt(Var ctx: TCompilerContext; Const name: TString; nargbytes: LongInt);
Begin
  Emit1(ctx, OP_CALL, AddrSym(SYMK_X, XSym(ctx, SymRt(name))));
  If nargbytes > 0 Then
    Emit(ctx, OP_ADD, RegOp(R_ESP), ImmOp(nargbytes));
End;

Procedure LoadUndefined(Var ctx: TCompilerContext);
Begin
  Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX));
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
End;

{ ---- Disposition des trames ---- }

Procedure LayoutFrames(Var ctx: TCompilerContext);
Var
  i, fs: LongInt;
Begin
  For i := 1 To ctx.sem.scope_count Do
    Begin
      ScopeP(ctx.sem.scopes, i)^.nslots := 1;        { emplacement 1 : ligne courante }
      ScopeP(ctx.sem.scopes, i)^.args_slot := 0;
    End;
  For i := 1 To ctx.sem.sym_count Do
    Begin
      SymP(ctx.sem.syms, i)^.slot := 0;
      If SymP(ctx.sem.syms, i)^.flags And SF_STATIC = 0 Then
        Begin
          fs := ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, i)^.scope)^.func;
          Inc(ScopeP(ctx.sem.scopes, fs)^.nslots);
          SymP(ctx.sem.syms, i)^.slot := ScopeP(ctx.sem.scopes, fs)^.nslots;
        End;
    End;
End;

Function AllocTemp(Var ctx: TCompilerContext): LongInt;
Begin
  Inc(ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots);
  AllocTemp := ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots;
End;

Function SlotDisp(slot: LongInt): LongInt;
Begin
  SlotDisp := -RT_VALUE_SIZE * slot;
End;

{ Position de sy dans l'environnement de la fonction fs (1 = premier). }
Function CapIndex(Var ctx: TCompilerContext; fs, sy: LongInt): LongInt;
Var
  i, k: LongInt;
Begin
  k := 0;
  CapIndex := 0;
  For i := 1 To ctx.sem.cap_count Do
    If CapP(ctx.sem.caps, i)^.fscope = fs Then
      Begin
        Inc(k);
        If CapP(ctx.sem.caps, i)^.sym = sy Then
          Begin
            CapIndex := k;
            Exit;
          End;
      End;
End;

{ ---- Acces aux symboles ---- }

{ Operandes memoire des deux moities (lo, hi) de la valeur du symbole.
  Peut emettre du code qui charge ECX (cellule ou environnement). }
Procedure SymAccess(Var ctx: TCompilerContext; sy: LongInt; Var lo, hi: TOperand);
Var
  sf, k: LongInt;
Begin
  sf := ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, sy)^.scope)^.func;
  If SymP(ctx.sem.syms, sy)^.flags And SF_STATIC <> 0 Then
    Begin
      lo := MemSym(SYMK_D, SymP(ctx.sem.syms, sy)^.ds, 0);
      hi := MemSym(SYMK_D, SymP(ctx.sem.syms, sy)^.ds, 4);
    End
  Else If sf = ctx.ir.cg_fs Then
    Begin
      If SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0 Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_ECX),
               MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)));
          lo := MemReg(R_ECX, RT_CELL_VALUE);
          hi := MemReg(R_ECX, RT_CELL_VALUE + 4);
        End
      Else
        Begin
          lo := MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot));
          hi := MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot) + 4);
        End;
    End
  Else
    Begin
      k := CapIndex(ctx, ctx.ir.cg_fs, sy);
      If k = 0 Then
        Begin
          PipelineError(ctx, 'capture introuvable pour ' +
                        TokP(ctx.lex.tokens, SymP(ctx.sem.syms, sy)^.name_tok)^.text);
          k := 1;
        End;
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_ECX, RT_FN_ENV));
      Emit(ctx, OP_MOV, RegOp(R_ECX),
           MemReg(R_ECX, RT_ENV_CELLS + 4 * (k - 1)));
      lo := MemReg(R_ECX, RT_CELL_VALUE);
      hi := MemReg(R_ECX, RT_CELL_VALUE + 4);
    End;
End;

{ Leve ReferenceError si la valeur d'octet haut hi est la marque TDZ. }
Procedure TdzCheck(Var ctx: TCompilerContext; sy: LongInt; hi: TOperand);
Var
  ok: LongInt;
Begin
  ok := NewLabel(ctx);
  Emit(ctx, OP_CMP, hi, ImmOp(TagImm(RT_T_TDZ)));
  Emit1(ctx, OP_JNE, LabelOp(ok));
  Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, SymP(ctx.sem.syms, sy)^.name_str)^.sym));
  CallRt(ctx, 'throw_tdz', 4);
  PlaceLabel(ctx, ok);
End;

Procedure LoadSym(Var ctx: TCompilerContext; sy: LongInt);
Var
  lo, hi: TOperand;
Begin
  SymAccess(ctx, sy, lo, hi);
  Emit(ctx, OP_MOV, RegOp(R_EAX), lo);
  Emit(ctx, OP_MOV, RegOp(R_EDX), hi);
  If SymP(ctx.sem.syms, sy)^.flags And SF_TDZ_CHECK <> 0 Then
    TdzCheck(ctx, sy, RegOp(R_EDX));
End;

{ Range EDX:EAX dans le symbole. init : premiere initialisation (pas de
  test TDZ). }
Procedure StoreSym(Var ctx: TCompilerContext; sy: LongInt; init: Boolean);
Var
  lo, hi: TOperand;
Begin
  If (SymP(ctx.sem.syms, sy)^.kind = DK_FNAME) And Not init Then
    Exit;
  SymAccess(ctx, sy, lo, hi);
  If (Not init) And (SymP(ctx.sem.syms, sy)^.flags And SF_TDZ_CHECK <> 0) Then
    TdzCheck(ctx, sy, hi);
  Emit(ctx, OP_MOV, lo, RegOp(R_EAX));
  Emit(ctx, OP_MOV, hi, RegOp(R_EDX));
End;

{ ---- Constructions en attente ---- }

Procedure PendingNote(Var ctx: TCompilerContext; n: LongInt; Const what: TString);
Begin
  Inc(ctx.ir.pending_count);
  PendingP(ctx.ir.pendings, ctx.ir.pending_count)^.line :=
    TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line;
  PendingP(ctx.ir.pendings, ctx.ir.pending_count)^.what := what;
  EmitComment(ctx, 'EN ATTENTE : ' + what + ' (ligne ' +
              LineOfTok(ctx, NodeP(ctx.ast.nodes, n)^.tok) + ')');
End;

Procedure PendingExpr(Var ctx: TCompilerContext; n: LongInt);
Var
  what: TString;
Begin
  what := NodeKindName(NodeP(ctx.ast.nodes, n)^.kind);
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_UNARY, N_BINARY, N_LOGICAL, N_ASSIGN, N_UPDATE:
      what := what + ' ' + TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  End;
  PendingNote(ctx, n, what);
  LoadUndefined(ctx);
End;

{ ---- Expressions prises en charge par ce TODO ---- }

Procedure GenExpr(Var ctx: TCompilerContext; n: LongInt); Forward;
Procedure BindTo(Var ctx: TCompilerContext; node, tslot: LongInt; init: Boolean); Forward;
Procedure GenScopeEnter(Var ctx: TCompilerContext; sc: LongInt); Forward;
Function RtVarSym(Var ctx: TCompilerContext; Const name: TString): LongInt; Forward;

Procedure LoadTag(Var ctx: TCompilerContext; lo: LongInt; tag: LongInt);
Begin
  If lo = 0 Then
    Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX))
  Else
    Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(lo));
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(tag)));
End;

Procedure LoadDouble(Var ctx: TCompilerContext; id: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, DblP(ctx.data.dbls, id)^.sym, 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, DblP(ctx.data.dbls, id)^.sym, 4));
End;

Procedure LoadStringConst(Var ctx: TCompilerContext; id: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), AddrSym(SYMK_D, StrP(ctx.data.strs, id)^.sym));
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_STRING)));
End;

Procedure GenThis(Var ctx: TCompilerContext; n: LongInt);
Begin
  If NodeP(ctx.ast.nodes, n)^.aux = TB_GLOBAL Then
    CallRt(ctx, 'global_this', 0)
  Else If NodeP(ctx.ast.nodes, n)^.e1 = 1 Then
    Begin
      { fleche : this lexical memorise dans la closure }
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
    End
  Else
    Begin
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
    End;
End;

Procedure GenIdent(Var ctx: TCompilerContext; n: LongInt);
Var
  name: TTokenText;
  xs: LongInt;
Begin
  name := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  Case NodeP(ctx.ast.nodes, n)^.aux Of
    RK_LOCAL, RK_OUTER, RK_GLOBAL_IMPLICIT:
      LoadSym(ctx, NodeP(ctx.ast.nodes, n)^.sym);
    RK_BUILTIN:
      Begin
        If name = 'undefined' Then
          LoadUndefined(ctx)
        Else If name = 'NaN' Then
          LoadDouble(ctx, STD_DBL_NAN)
        Else If name = 'Infinity' Then
          LoadDouble(ctx, STD_DBL_INF)
        Else
          Begin
            { objet global fourni par le runtime }
            xs := XSym(ctx, SymRt('g_' + name));
            Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_X, xs, 0));
            Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_X, xs, 4));
          End;
      End;
    RK_UNDECLARED_OK:
      LoadUndefined(ctx);
    RK_ARGUMENTS:
      Begin
        If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot <> 0 Then
          Begin
            Emit(ctx, OP_MOV, RegOp(R_EAX),
                 MemReg(R_EBP, SlotDisp(ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot)));
            Emit(ctx, OP_MOV, RegOp(R_EDX),
                 MemReg(R_EBP, SlotDisp(ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot) + 4));
          End
        Else
          PendingExpr(ctx, n);
      End;
  Else
    PendingExpr(ctx, n);
  End;
End;

Procedure PushTemp(Var ctx: TCompilerContext; slot: LongInt); Forward;

{ ---- Expressions (TODO 10) ----

  Strategie : une operation arithmetique, bit a bit ou relationnelle
  dont les deux operandes sont des int32 s'execute en ligne (add, sub,
  imul avec test de depassement, idiv, decalages, cmp). Dans tous les
  autres cas (double, chaine, objet, depassement, -0) le code appelle
  la routine du runtime de meme nom : _JSRT_add, _JSRT_sub, _JSRT_div,
  _JSRT_pow, _JSRT_lt, _JSRT_eq... qui appliquent ToPrimitive,
  ToNumber et ToString. Le runtime calcule en double avec le FPU
  (division par zero = Infinity ou NaN).

  Operande gauche : rangee dans un temporaire de la trame pendant que
  l'operande droit est evalue (la droite arrive dans EDX:EAX). Les
  routines du runtime recoivent (gauche, droite) en cdecl.

  Les expressions entierement constantes sont repliees a la
  compilation quand le resultat est un int32, un booleen, null ou
  undefined ; sinon le code ordinaire est genere. }

Function TempAcquire(Var ctx: TCompilerContext): LongInt;
Begin
  If ctx.ir.tmp_free_count > 0 Then
    Begin
      TempAcquire := TmpFreeP(ctx.ir.tmp_free, ctx.ir.tmp_free_count)^;
      Dec(ctx.ir.tmp_free_count);
    End
  Else
    TempAcquire := AllocTemp(ctx);
End;

Procedure TempRelease(Var ctx: TCompilerContext; t: LongInt);
Begin
  Inc(ctx.ir.tmp_free_count);
  TmpFreeP(ctx.ir.tmp_free, ctx.ir.tmp_free_count)^ := t;
End;

Procedure SaveTemp(Var ctx: TCompilerContext; t: LongInt);
Begin
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t)), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t) + 4), RegOp(R_EDX));
End;

Procedure LoadTemp(Var ctx: TCompilerContext; t: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, SlotDisp(t)));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, SlotDisp(t) + 4));
End;

Function TempLo(t: LongInt): TOperand;
Begin
  TempLo := MemReg(R_EBP, SlotDisp(t));
End;

Function TempHi(t: LongInt): TOperand;
Begin
  TempHi := MemReg(R_EBP, SlotDisp(t) + 4);
End;

{ EAX := 0 ou 1 selon la verite de EDX:EAX (ToBoolean). }
Procedure GenTruthy(Var ctx: TCompilerContext);
Var
  num, fls, done: LongInt;
Begin
  num := NewLabel(ctx);
  fls := NewLabel(ctx);
  done := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JE, LabelOp(num));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_BOOLEAN)));
  Emit1(ctx, OP_JE, LabelOp(num));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'truthy', 8);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, num);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(1));
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, fls);
  Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX));
  PlaceLabel(ctx, done);
End;

{ EAX = 0/1 vers un booleen JavaScript dans EDX:EAX. }
Procedure BoolFromEax(Var ctx: TCompilerContext);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_BOOLEAN)));
End;

{ Appel d'une routine binaire (gauche = temporaire t, droite = EDX:EAX). }
Procedure CallBinary(Var ctx: TCompilerContext; Const name: TString; t: LongInt);
Begin
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  PushTemp(ctx, t);
  CallRt(ctx, name, 16);
End;

{ Saute vers slow si l'un des deux operandes (gauche en t, droite dans
  EDX) n'est pas un int32. }
Procedure CheckBothInt(Var ctx: TCompilerContext; t, slow: LongInt);
Begin
  Emit(ctx, OP_CMP, TempHi(t), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
End;

{ Operation binaire op : gauche dans le temporaire t, droite dans
  EDX:EAX. Resultat dans EDX:EAX. t n'est pas libere. }
Procedure GenBinaryCore(Var ctx: TCompilerContext; Const op: TTokenText; t: LongInt);
Var
  slow, done, okm, slowr, lb: LongInt;
  opc, jcc: TOpc;
  rt: TString;
  flip, is_shift, is_bit, is_cmp: Boolean;
Begin
  slow := NewLabel(ctx);
  done := NewLabel(ctx);
  rt := '';
  flip := False;
  is_shift := False;
  is_bit := False;
  is_cmp := False;
  opc := OP_NONE;
  jcc := OP_NONE;
  If op = '+' Then
    Begin
      rt := 'add';
      opc := OP_ADD;
    End
  Else If op = '-' Then
    Begin
      rt := 'sub';
      opc := OP_SUB;
    End
  Else If op = '*' Then
    rt := 'mul'
  Else If op = '/' Then
    rt := 'div'
  Else If op = '%' Then
    rt := 'mod'
  Else If op = '**' Then
    rt := 'pow'
  Else If op = '&' Then
    Begin
      rt := 'band';
      opc := OP_AND;
      is_bit := True;
    End
  Else If op = '|' Then
    Begin
      rt := 'bor';
      opc := OP_OR;
      is_bit := True;
    End
  Else If op = '^' Then
    Begin
      rt := 'bxor';
      opc := OP_XOR;
      is_bit := True;
    End
  Else If op = '<<' Then
    Begin
      rt := 'shl';
      opc := OP_SHL;
      is_shift := True;
    End
  Else If op = '>>' Then
    Begin
      rt := 'sar';
      opc := OP_SAR;
      is_shift := True;
    End
  Else If op = '>>>' Then
    Begin
      rt := 'shr';
      opc := OP_SHR;
      is_shift := True;
    End
  Else If op = '<' Then
    Begin
      rt := 'lt';
      jcc := OP_JL;
      is_cmp := True;
    End
  Else If op = '<=' Then
    Begin
      rt := 'le';
      jcc := OP_JLE;
      is_cmp := True;
    End
  Else If op = '>' Then
    Begin
      rt := 'gt';
      jcc := OP_JG;
      is_cmp := True;
    End
  Else If op = '>=' Then
    Begin
      rt := 'ge';
      jcc := OP_JGE;
      is_cmp := True;
    End
  Else If op = '==' Then
    Begin
      rt := 'eq';
      jcc := OP_JE;
      is_cmp := True;
    End
  Else If op = '!=' Then
    Begin
      rt := 'eq';
      jcc := OP_JNE;
      is_cmp := True;
      flip := True;
    End
  Else If op = '===' Then
    Begin
      rt := 'seq';
      jcc := OP_JE;
      is_cmp := True;
    End
  Else If op = '!==' Then
    Begin
      rt := 'seq';
      jcc := OP_JNE;
      is_cmp := True;
      flip := True;
    End
  Else If op = 'instanceof' Then
    rt := 'instanceof'
  Else If op = 'in' Then
    rt := 'in'
  Else
    Begin
      PipelineError(ctx, 'operateur binaire inconnu: ' + op);
      Exit;
    End;

  If (opc = OP_ADD) Or (opc = OP_SUB) Then
    Begin
      { int32 avec test de depassement }
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, opc, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JO, LabelOp(slow));
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If op = '*' Then
    Begin
      okm := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_IMUL, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JO, LabelOp(slow));
      Emit(ctx, OP_TEST, RegOp(R_ECX), RegOp(R_ECX));
      Emit1(ctx, OP_JNE, LabelOp(okm));
      { resultat 0 : -0 si un operande est negatif }
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_OR, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JS, LabelOp(slow));
      Emit(ctx, OP_XOR, RegOp(R_ECX), RegOp(R_ECX));
      PlaceLabel(ctx, okm);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If op = '%' Then
    Begin
      okm := NewLabel(ctx);
      slowr := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_TEST, RegOp(R_ECX), RegOp(R_ECX));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit(ctx, OP_CMP, RegOp(R_ECX), ImmOp(-1));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(t));
      Emit0(ctx, OP_CDQ);
      Emit1(ctx, OP_IDIV, RegOp(R_ECX));
      Emit(ctx, OP_TEST, RegOp(R_EDX), RegOp(R_EDX));
      Emit1(ctx, OP_JNE, LabelOp(okm));
      { reste 0 : -0 si le dividende est negatif }
      Emit(ctx, OP_CMP, TempLo(t), ImmOp(0));
      Emit1(ctx, OP_JL, LabelOp(slowr));
      PlaceLabel(ctx, okm);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_EDX));
      Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, slowr);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
    End
  Else If is_bit Then
    Begin
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, opc, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If is_shift Then
    Begin
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(t));
      Emit(ctx, opc, RegOp(R_EAX), RegOp(R_CL));
      If op = '>>>' Then
        Begin
          { hors int32 si le bit de signe est positionne : repli }
          slowr := NewLabel(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          Emit1(ctx, OP_JS, LabelOp(slowr));
          Emit1(ctx, OP_JMP, LabelOp(done));
          PlaceLabel(ctx, slowr);
          Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
          Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
        End
      Else
        Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If is_cmp Then
    Begin
      lb := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_CMP, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(1));
      Emit1(ctx, jcc, LabelOp(lb));
      Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX));
      PlaceLabel(ctx, lb);
      BoolFromEax(ctx);
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  ;

  PlaceLabel(ctx, slow);
  If (rt <> 'instanceof') And (rt <> 'in') Then
    CallBinary(ctx, 'bw_' + rt, t)
  Else
    CallBinary(ctx, rt, t);
  If flip Then
    Begin
      Emit(ctx, OP_XOR, RegOp(R_EAX), ImmOp(1));
      BoolFromEax(ctx);
    End;
  PlaceLabel(ctx, done);
End;

{ ---- Repli de constantes ---- }

Function ToInt32Of(v: Double): LongInt;
Var
  w: Int64;
Begin
  If (v <> v) Or (v > 1.9E25) Or (v < -1.9E25) Then
    ToInt32Of := 0
  Else
    Begin
      v := Int(v);
      v := v - 4294967296.0 * Int(v / 4294967296.0);
      w := Trunc(v);
      ToInt32Of := ToLong(w);
    End;
End;

Function IsNegZero(v: Double): Boolean;
Var
  w: Array[0..1] Of LongInt;
Begin
  Move(v, w, 8);
  IsNegZero := (v = 0) And (w[1] < 0);
End;

Function ConstTruthy(Var c: TConst): Boolean;
Begin
  Case c.k Of
    CK_NUM:  ConstTruthy := (c.n <> 0) And (c.n = c.n);
    CK_BOOL: ConstTruthy := c.b;
  Else
    ConstTruthy := False;
  End;
End;

Function EvalConst(Var ctx: TCompilerContext; n: LongInt; Var c: TConst): Boolean;
Var
  a, b: TConst;
  s: TTokenText;
  x, y: Double;
  ix, iy: Int64;
  r: Boolean;
Begin
  EvalConst := False;
  c.k := CK_NONE;
  If n = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_NUMBER:
      Begin
        c.k := CK_NUM;
        c.n := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.num_val;
        EvalConst := True;
      End;
    N_BOOL:
      Begin
        c.k := CK_BOOL;
        c.b := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'true';
        EvalConst := True;
      End;
    N_NULL:
      Begin
        c.k := CK_NULL;
        EvalConst := True;
      End;
    N_IDENT:
      If (NodeP(ctx.ast.nodes, n)^.aux = RK_BUILTIN) And
         (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'undefined') Then
        Begin
          c.k := CK_UNDEF;
          EvalConst := True;
        End;
    N_UNARY:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If s = '!' Then
          Begin
            c.k := CK_BOOL;
            c.b := Not ConstTruthy(a);
            EvalConst := True;
          End
        Else If s = 'void' Then
          Begin
            c.k := CK_UNDEF;
            EvalConst := True;
          End
        Else If a.k = CK_NUM Then
          Begin
            If s = '-' Then
              Begin
                c.k := CK_NUM;
                c.n := -a.n;
                EvalConst := True;
              End
            Else If s = '+' Then
              Begin
                c := a;
                EvalConst := True;
              End
            Else If s = '~' Then
              Begin
                c.k := CK_NUM;
                c.n := Not ToInt32Of(a.n);
                EvalConst := True;
              End;
          End;
      End;
    N_BINARY:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not (EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) And
                EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, b)) Then
          Exit;
        If (a.k <> CK_NUM) Or (b.k <> CK_NUM) Then
          Exit;
        x := a.n;
        y := b.n;
        If (x <> x) Or (y <> y) Or (Abs(x) > 9.0E15) Or (Abs(y) > 9.0E15) Then
          Exit;
        c.k := CK_NUM;
        r := True;
        If s = '+' Then
          c.n := x + y
        Else If s = '-' Then
          c.n := x - y
        Else If s = '*' Then
          c.n := x * y
        Else If s = '/' Then
          Begin
            If y = 0 Then
              r := False
            Else
              c.n := x / y;
          End
        Else If s = '%' Then
          Begin
            ix := Trunc(x);
            iy := Trunc(y);
            If (ix <> x) Or (iy <> y) Or (iy = 0) Or (ix < 0) Then
              r := False
            Else
              c.n := ix Mod iy;
          End
        Else If s = '**' Then
          Begin
            If (y < 0) Or (y > 62) Or (Int(y) <> y) Or (Int(x) <> x) Or
               (Abs(x) > 65536) Then
              r := False
            Else
              Begin
                c.n := 1;
                ix := Trunc(y);
                While ix > 0 Do
                  Begin
                    c.n := c.n * x;
                    Dec(ix);
                  End;
              End;
          End
        Else If s = '&' Then
          c.n := ToInt32Of(x) And ToInt32Of(y)
        Else If s = '|' Then
          c.n := ToInt32Of(x) Or ToInt32Of(y)
        Else If s = '^' Then
          c.n := ToInt32Of(x) Xor ToInt32Of(y)
        Else If s = '<<' Then
          c.n := ToInt32Of(ToInt32Of(x) Shl (ToInt32Of(y) And 31))
        Else If s = '>>' Then
          Begin
            ix := ToInt32Of(x);
            If ix >= 0 Then
              c.n := ix Shr (ToInt32Of(y) And 31)
            Else
              c.n := Not ((Not ix) Shr (ToInt32Of(y) And 31));
          End
        Else If s = '>>>' Then
          c.n := (Int64(ToInt32Of(x)) And $FFFFFFFF) Shr (ToInt32Of(y) And 31)
        Else If s = '<' Then
          Begin
            c.k := CK_BOOL;
            c.b := x < y;
          End
        Else If s = '<=' Then
          Begin
            c.k := CK_BOOL;
            c.b := x <= y;
          End
        Else If s = '>' Then
          Begin
            c.k := CK_BOOL;
            c.b := x > y;
          End
        Else If s = '>=' Then
          Begin
            c.k := CK_BOOL;
            c.b := x >= y;
          End
        Else If (s = '==') Or (s = '===') Then
          Begin
            c.k := CK_BOOL;
            c.b := x = y;
          End
        Else If (s = '!=') Or (s = '!==') Then
          Begin
            c.k := CK_BOOL;
            c.b := x <> y;
          End
        Else
          r := False;
        EvalConst := r;
      End;
    N_LOGICAL:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If s = '&&' Then
          Begin
            If ConstTruthy(a) Then
              EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
            Else
              Begin
                c := a;
                EvalConst := True;
              End;
          End
        Else If s = '||' Then
          Begin
            If ConstTruthy(a) Then
              Begin
                c := a;
                EvalConst := True;
              End
            Else
              EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c);
          End
        Else If (a.k = CK_NULL) Or (a.k = CK_UNDEF) Then
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
        Else
          Begin
            c := a;
            EvalConst := True;
          End;
      End;
    N_COND:
      Begin
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If ConstTruthy(a) Then
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
        Else
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e3, c);
      End;
  End;
End;

{ Emet la constante si le programme l'exprime sans nouvelle donnee
  statique : int32 (hors -0), booleen, null ou undefined. }
Function TryFold(Var ctx: TCompilerContext; n: LongInt): Boolean;
Var
  c: TConst;
Begin
  TryFold := False;
  If Not EvalConst(ctx, n, c) Then
    Exit;
  Case c.k Of
    CK_NUM:
      Begin
        If (c.n <> c.n) Or (Int(c.n) <> c.n) Or (c.n < -2147483648.0) Or
           (c.n > 2147483647.0) Or IsNegZero(c.n) Then
          Exit;
        LoadTag(ctx, Trunc(c.n), RT_T_INT32);
      End;
    CK_BOOL:
      Begin
        If c.b Then
          LoadTag(ctx, 1, RT_T_BOOLEAN)
        Else
          LoadTag(ctx, 0, RT_T_BOOLEAN);
      End;
    CK_NULL:
      LoadTag(ctx, 0, RT_T_NULL);
    CK_UNDEF:
      LoadUndefined(ctx);
  Else
    Exit;
  End;
  TryFold := True;
End;

{ ---- Operateurs ---- }

Procedure GenBinary(Var ctx: TCompilerContext; n: LongInt);
Var
  t: LongInt;
Begin
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  t := TempAcquire(ctx);
  SaveTemp(ctx, t);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  GenBinaryCore(ctx, TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text, t);
  TempRelease(ctx, t);
End;

{ && || ?? avec court-circuit : le resultat est l'un des operandes. }
Procedure GenLogical(Var ctx: TCompilerContext; n: LongInt);
Var
  t, short, done, evalr: LongInt;
  op: TTokenText;
Begin
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  t := TempAcquire(ctx);
  short := NewLabel(ctx);
  done := NewLabel(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  SaveTemp(ctx, t);
  If op = '??' Then
    Begin
      evalr := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
      Emit1(ctx, OP_JE, LabelOp(evalr));
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
      Emit1(ctx, OP_JNE, LabelOp(done));
      PlaceLabel(ctx, evalr);
    End
  Else
    Begin
      GenTruthy(ctx);
      Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
      If op = '&&' Then
        Emit1(ctx, OP_JE, LabelOp(short))
      Else
        Emit1(ctx, OP_JNE, LabelOp(short));
    End;
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, short);
  LoadTemp(ctx, t);
  PlaceLabel(ctx, done);
  { sur ?? sans evaluation de la droite, EDX:EAX contient deja la gauche }
  TempRelease(ctx, t);
End;

Procedure GenCond(Var ctx: TCompilerContext; n: LongInt);
Var
  els, done: LongInt;
Begin
  els := NewLabel(ctx);
  done := NewLabel(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(els));
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, els);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  PlaceLabel(ctx, done);
End;

Procedure GenUnary(Var ctx: TCompilerContext; n: LongInt);
Var
  s: TTokenText;
  e, slow, done, t: LongInt;
Begin
  s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  e := NodeP(ctx.ast.nodes, n)^.e1;
  slow := NewLabel(ctx);
  done := NewLabel(ctx);
  If (s = 'yield') Or (s = 'await') Then
    Begin
      { suspension de la coroutine : la valeur envoyee (ou rendue par la promesse)
        revient dans EDX:EAX }
      If e <> 0 Then
        GenExpr(ctx, e)
      Else
        LoadUndefined(ctx);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      If (s = 'yield') And (NodeP(ctx.ast.nodes, n)^.flags = 1) Then
        CallRt(ctx, 'yield_star', 8)
      Else
        CallRt(ctx, 'yield', 8);
    End
  Else If s = '!' Then
    Begin
      GenExpr(ctx, e);
      GenTruthy(ctx);
      Emit(ctx, OP_XOR, RegOp(R_EAX), ImmOp(1));
      BoolFromEax(ctx);
    End
  Else If s = '-' Then
    Begin
      GenExpr(ctx, e);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JNE, LabelOp(slow));
      { 0 donne -0 et INT_MIN depasse : repli sur le runtime }
      Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit1(ctx, OP_NEG, RegOp(R_EAX));
      Emit1(ctx, OP_JNO, LabelOp(done));
      PlaceLabel(ctx, slow);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'bw_neg', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = '+' Then
    Begin
      GenExpr(ctx, e);
      { int32 et double sont deja des nombres }
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JBE, LabelOp(done));
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumber', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = '~' Then
    Begin
      GenExpr(ctx, e);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JNE, LabelOp(slow));
      Emit1(ctx, OP_NOT, RegOp(R_EAX));
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, slow);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'bw_bnot', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = 'typeof' Then
    Begin
      GenExpr(ctx, e);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'typeof', 8);
    End
  Else If s = 'void' Then
    Begin
      GenExpr(ctx, e);
      LoadUndefined(ctx);
    End
  Else If s = '&' Then
    { operateur de reference &fn (extension) : la valeur de la fonction }
    GenExpr(ctx, e)
  Else If s = 'delete' Then
    Begin
      If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_MEMBER) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e1);
          Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
                StrP(ctx.data.strs, NodeP(ctx.ast.nodes, e)^.aux)^.sym));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'delete_prop', 12);
        End
      Else If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_INDEX) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e1);
          t := TempAcquire(ctx);
          SaveTemp(ctx, t);
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e2);
          CallBinary(ctx, 'delete_member', t);
          TempRelease(ctx, t);
        End
      Else If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_IDENT) Then
        { une variable ne se supprime pas }
        LoadTag(ctx, 0, RT_T_BOOLEAN)
      Else
        Begin
          GenExpr(ctx, e);
          LoadTag(ctx, 1, RT_T_BOOLEAN);
        End;
    End
  Else
    PendingExpr(ctx, n);
End;

{ ++ et -- sur une variable : le resultat est la nouvelle valeur
  (prefixe) ou l'ancienne valeur convertie en nombre (postfixe). }
{ ---- Cibles membre : objet.nom et objet[cle] en ecriture (TODO 15) ----

  L'objet (et la cle d'un acces par crochets) sont evalues une seule
  fois dans des temporaires ; la valeur courante est lue par
  _JSRT_get_prop / _JSRT_get_member et ecrite par _JSRT_set_prop(objet,
  atome, valeur) ou _JSRT_set_member(objet, cle, valeur), qui rendent la
  valeur ecrite dans EDX:EAX. }

Procedure MemberPrep(Var ctx: TCompilerContext; m: LongInt; Var tobj, tkey: LongInt);
Begin
  tobj := TempAcquire(ctx);
  tkey := 0;
  GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e1);
  SaveTemp(ctx, tobj);
  If NodeP(ctx.ast.nodes, m)^.kind = N_INDEX Then
    Begin
      tkey := TempAcquire(ctx);
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
      SaveTemp(ctx, tkey);
    End;
End;

Procedure MemberDone(Var ctx: TCompilerContext; tobj, tkey: LongInt);
Begin
  If tkey <> 0 Then
    TempRelease(ctx, tkey);
  TempRelease(ctx, tobj);
End;

Procedure MemberFetch(Var ctx: TCompilerContext; m, tobj, tkey: LongInt);
Begin
  If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_prop', 12);
    End
  Else
    Begin
      PushTemp(ctx, tkey);
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_member', 16);
    End;
End;

{ Ecrit EDX:EAX dans la propriete ; la valeur reste dans EDX:EAX. }
Procedure MemberStore(Var ctx: TCompilerContext; m, tobj, tkey: LongInt);
Begin
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'set_prop', 20);
    End
  Else
    Begin
      PushTemp(ctx, tkey);
      PushTemp(ctx, tobj);
      CallRt(ctx, 'set_member', 24);
    End;
End;

Function IsMemberTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsMemberTarget := (n <> 0) And ((NodeP(ctx.ast.nodes, n)^.kind = N_MEMBER) Or
                                  (NodeP(ctx.ast.nodes, n)^.kind = N_INDEX)) And
                    (NodeP(ctx.ast.nodes, n)^.flags And EF_OPTIONAL = 0);
End;

{ x.p++, --a[i]... }
Procedure GenUpdateMember(Var ctx: TCompilerContext; n, e: LongInt);
Var
  slow, store, t, tobj, tkey: LongInt;
  inc_op, prefix: Boolean;
Begin
  inc_op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = '++';
  prefix := NodeP(ctx.ast.nodes, n)^.flags And UF_PREFIX <> 0;
  slow := NewLabel(ctx);
  store := NewLabel(ctx);
  t := TempAcquire(ctx);
  MemberPrep(ctx, e, tobj, tkey);
  MemberFetch(ctx, e, tobj, tkey);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
  If inc_op Then
    Emit(ctx, OP_ADD, RegOp(R_ECX), ImmOp(1))
  Else
    Emit(ctx, OP_SUB, RegOp(R_ECX), ImmOp(1));
  Emit1(ctx, OP_JO, LabelOp(slow));
  If Not prefix Then
    SaveTemp(ctx, t);
  Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
  Emit1(ctx, OP_JMP, LabelOp(store));
  PlaceLabel(ctx, slow);
  If Not prefix Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumeric', 8);
      SaveTemp(ctx, t);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If inc_op Then
    CallRt(ctx, 'bw_inc', 8)
  Else
    CallRt(ctx, 'bw_dec', 8);
  PlaceLabel(ctx, store);
  MemberStore(ctx, e, tobj, tkey);
  If Not prefix Then
    LoadTemp(ctx, t);
  MemberDone(ctx, tobj, tkey);
  TempRelease(ctx, t);
End;

{ x.p op= v, a[i] op= v, a[i] &&= v... }
Procedure GenCompoundMember(Var ctx: TCompilerContext; n, lhs: LongInt);
Var
  t, tobj, tkey, keep, done, evalr: LongInt;
  op: TTokenText;
Begin
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  t := TempAcquire(ctx);
  MemberPrep(ctx, lhs, tobj, tkey);
  MemberFetch(ctx, lhs, tobj, tkey);
  SaveTemp(ctx, t);
  If (op = '&&=') Or (op = '||=') Or (op = '??=') Then
    Begin
      keep := NewLabel(ctx);
      done := NewLabel(ctx);
      If op = '??=' Then
        Begin
          evalr := NewLabel(ctx);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
          Emit1(ctx, OP_JE, LabelOp(evalr));
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
          Emit1(ctx, OP_JNE, LabelOp(keep));
          PlaceLabel(ctx, evalr);
        End
      Else
        Begin
          GenTruthy(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          If op = '&&=' Then
            Emit1(ctx, OP_JE, LabelOp(keep))
          Else
            Emit1(ctx, OP_JNE, LabelOp(keep));
        End;
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      MemberStore(ctx, lhs, tobj, tkey);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, keep);
      LoadTemp(ctx, t);
      PlaceLabel(ctx, done);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      GenBinaryCore(ctx, Copy(op, 1, Length(op) - 1), t);
      MemberStore(ctx, lhs, tobj, tkey);
    End;
  MemberDone(ctx, tobj, tkey);
  TempRelease(ctx, t);
End;

Procedure GenUpdate(Var ctx: TCompilerContext; n: LongInt);
Var
  e, sy, slow, store, t: LongInt;
  inc_op: Boolean;
  prefix: Boolean;
Begin
  e := NodeP(ctx.ast.nodes, n)^.e1;
  If IsMemberTarget(ctx, e) Then
    Begin
      GenUpdateMember(ctx, n, e);
      Exit;
    End;
  If (e = 0) Or (NodeP(ctx.ast.nodes, e)^.kind <> N_IDENT) Or
     Not ((NodeP(ctx.ast.nodes, e)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, e)^.aux = RK_OUTER) Or
          (NodeP(ctx.ast.nodes, e)^.aux = RK_GLOBAL_IMPLICIT)) Then
    Begin
      PendingExpr(ctx, n);
      Exit;
    End;
  sy := NodeP(ctx.ast.nodes, e)^.sym;
  inc_op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = '++';
  prefix := NodeP(ctx.ast.nodes, n)^.flags And UF_PREFIX <> 0;
  slow := NewLabel(ctx);
  store := NewLabel(ctx);
  t := TempAcquire(ctx);
  LoadSym(ctx, sy);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
  If inc_op Then
    Emit(ctx, OP_ADD, RegOp(R_ECX), ImmOp(1))
  Else
    Emit(ctx, OP_SUB, RegOp(R_ECX), ImmOp(1));
  Emit1(ctx, OP_JO, LabelOp(slow));
  If Not prefix Then
    SaveTemp(ctx, t);
  Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
  Emit1(ctx, OP_JMP, LabelOp(store));
  PlaceLabel(ctx, slow);
  If Not prefix Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumeric', 8);
      SaveTemp(ctx, t);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If inc_op Then
    CallRt(ctx, 'bw_inc', 8)
  Else
    CallRt(ctx, 'bw_dec', 8);
  PlaceLabel(ctx, store);
  StoreSym(ctx, sy, False);
  If Not prefix Then
    LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Affectation composee sur une variable : x op= v, x &&= v, x ||= v, x ??= v. }
Procedure GenCompound(Var ctx: TCompilerContext; n: LongInt);
Var
  lhs, sy, t, keep, done, evalr: LongInt;
  op: TTokenText;
Begin
  lhs := NodeP(ctx.ast.nodes, n)^.e1;
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  If IsMemberTarget(ctx, lhs) Then
    Begin
      GenCompoundMember(ctx, n, lhs);
      Exit;
    End;
  If (lhs = 0) Or (NodeP(ctx.ast.nodes, lhs)^.kind <> N_IDENT) Or
     Not ((NodeP(ctx.ast.nodes, lhs)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, lhs)^.aux = RK_OUTER) Or
          (NodeP(ctx.ast.nodes, lhs)^.aux = RK_GLOBAL_IMPLICIT)) Then
    Begin
      PendingExpr(ctx, n);
      Exit;
    End;
  sy := NodeP(ctx.ast.nodes, lhs)^.sym;
  t := TempAcquire(ctx);
  GenExpr(ctx, lhs);
  SaveTemp(ctx, t);
  If (op = '&&=') Or (op = '||=') Or (op = '??=') Then
    Begin
      keep := NewLabel(ctx);
      done := NewLabel(ctx);
      If op = '??=' Then
        Begin
          evalr := NewLabel(ctx);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
          Emit1(ctx, OP_JE, LabelOp(evalr));
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
          Emit1(ctx, OP_JNE, LabelOp(keep));
          PlaceLabel(ctx, evalr);
        End
      Else
        Begin
          GenTruthy(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          If op = '&&=' Then
            Emit1(ctx, OP_JE, LabelOp(keep))
          Else
            Emit1(ctx, OP_JNE, LabelOp(keep));
        End;
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      StoreSym(ctx, sy, False);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, keep);
      LoadTemp(ctx, t);
      PlaceLabel(ctx, done);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      GenBinaryCore(ctx, Copy(op, 1, Length(op) - 1), t);
      StoreSym(ctx, sy, False);
    End;
  TempRelease(ctx, t);
End;

{ ---- Fonctions, appels et acces aux membres (TODO 12) ----

  Convention d'appel interne. L'appelant reserve sur la pile, de bas en
  haut : la closure (4 octets), argc (4), this (8) puis les arguments
  (8 octets chacun), appelle [closure+code] et retire le tout. Dans la
  fonction appelee, apres push ebp : [EBP+8] closure, [EBP+12] argc,
  [EBP+16] this, [EBP+24] argument 0. Resultat dans EDX:EAX. Les
  arguments sont evalues de gauche a droite directement dans l'espace
  reserve. Avec un argument ...spread, les arguments sont rassembles
  dans un tableau et _JSRT_call_array(fonction, this, tableau) fait
  l'appel.

  Objet fonction : _JSRT_new_function(descripteur, code, environnement,
  this) ; l'environnement (_JSRT_new_env(n)) recoit les pointeurs des
  cellules capturees, dans l'ordre de la table des captures de la
  fonction. Une fleche memorise le this de son createur.

  Acces aux membres en lecture : _JSRT_get_prop(objet, atome) et
  _JSRT_get_member(objet, cle). Un appel de methode passe l'objet comme
  this. Le chainage optionnel a?.b.c() saute a la fin de la chaine avec
  undefined des qu'un maillon ?. rencontre null ou undefined. }

{ this du contexte courant, pour le memoriser dans une fleche. }
Procedure LoadCurrentThis(Var ctx: TCompilerContext);
Begin
  If ctx.ir.cg_fs = 1 Then
    LoadUndefined(ctx)
  Else If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
    Begin
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
    End
  Else
    Begin
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
    End;
End;

{ Cree l'objet fonction du noeud n (declaration, expression, fleche) ;
  le resultat est dans EDX:EAX. }
Procedure GenMakeClosure(Var ctx: TCompilerContext; n: LongInt);
Var
  fd, sc, ncells, i, k, kk, sy, e: LongInt;
  is_arrow: Boolean;
Begin
  fd := NodeP(ctx.ast.nodes, n)^.ds;
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  ncells := ScopeP(ctx.sem.scopes, sc)^.cap_count;
  is_arrow := ScopeP(ctx.sem.scopes, sc)^.fkind = FK_ARROW;
  e := 0;
  If ncells > 0 Then
    Begin
      e := TempAcquire(ctx);
      Emit1(ctx, OP_PUSH, ImmOp(ncells));
      CallRt(ctx, 'new_env', 4);
      Emit(ctx, OP_MOV, TempLo(e), RegOp(R_EAX));
      k := 0;
      For i := 1 To ctx.sem.cap_count Do
        If CapP(ctx.sem.caps, i)^.fscope = sc Then
          Begin
            Inc(k);
            sy := CapP(ctx.sem.caps, i)^.sym;
            If ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, sy)^.scope)^.func = ctx.ir.cg_fs Then
              Emit(ctx, OP_MOV, RegOp(R_ECX),
                   MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)))
            Else
              Begin
                kk := CapIndex(ctx, ctx.ir.cg_fs, sy);
                If kk = 0 Then
                  Begin
                    PipelineError(ctx, 'capture introuvable pour ' +
                                  TokP(ctx.lex.tokens, SymP(ctx.sem.syms, sy)^.name_tok)^.text);
                    kk := 1;
                  End;
                Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
                Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_ECX, RT_FN_ENV));
                Emit(ctx, OP_MOV, RegOp(R_ECX),
                     MemReg(R_ECX, RT_ENV_CELLS + 4 * (kk - 1)));
              End;
            Emit(ctx, OP_MOV, RegOp(R_EDX), TempLo(e));
            Emit(ctx, OP_MOV, MemReg(R_EDX, RT_ENV_CELLS + 4 * (k - 1)), RegOp(R_ECX));
          End;
    End;
  { new_function(descripteur, code, environnement, this) }
  If is_arrow Then
    LoadCurrentThis(ctx)
  Else
    LoadUndefined(ctx);
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If ncells > 0 Then
    Emit1(ctx, OP_PUSH, TempLo(e))
  Else
    Emit1(ctx, OP_PUSH, ImmOp(0));
  Emit1(ctx, OP_PUSH, AddrSym(SYMK_X, XSym(ctx, FdescP(ctx.data.fdescs, fd)^.code_sym)));
  Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, FdescP(ctx.data.fdescs, fd)^.sym));
  CallRt(ctx, 'new_function', 20);
  If is_arrow And (ctx.ir.cg_fs > 1) Then
    Begin
      { methode d'accueil de super : la fermeture courante, ou celle de la fleche englobante }
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
        Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_ECX, RT_FN_HOME));
      Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_HOME), RegOp(R_ECX));
    End;
  If e <> 0 Then
    TempRelease(ctx, e);
End;

{ ---- Chaines d'acces et d'appels ---- }

Function IsChainKind(k: TNodeKind): Boolean;
Begin
  IsChainKind := (k = N_MEMBER) Or (k = N_INDEX) Or (k = N_CALL);
End;

{ Si le maillon est optionnel et que la valeur EDX:EAX est null ou
  undefined, saute a la fin de la chaine avec undefined. }
Procedure ChainNullCheck(Var ctx: TCompilerContext);
Var
  isnull, ok: LongInt;
Begin
  isnull := NewLabel(ctx);
  ok := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JE, LabelOp(isnull));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
  Emit1(ctx, OP_JNE, LabelOp(ok));
  PlaceLabel(ctx, isnull);
  LoadUndefined(ctx);
  Emit1(ctx, OP_JMP, LabelOp(ctx.ir.chain_end));
  ctx.ir.chain_used := True;
  PlaceLabel(ctx, ok);
End;

{ Evalue l'objet d'un maillon membre ou indice et le range dans tobj. }
Procedure GenChainBase(Var ctx: TCompilerContext; m, tobj: LongInt);
Begin
  ctx.ir.in_chain := True;
  GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e1);
  ctx.ir.in_chain := False;
  If NodeP(ctx.ast.nodes, m)^.flags And EF_OPTIONAL <> 0 Then
    ChainNullCheck(ctx);
  SaveTemp(ctx, tobj);
End;

{ L'objet est dans tobj : lit la propriete dans EDX:EAX. }
Procedure GenPropFetch(Var ctx: TCompilerContext; m, tobj: LongInt);
Begin
  If (NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, m)^.e1)^.kind = N_SUPER) And
     (ctx.ir.cg_fs > 1) Then
    Begin
      { super.nom / super[cle] : recherche dans le prototype de l'objet d'accueil }
      If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
        Begin
          PushTemp(ctx, tobj);
          Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
                StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
        End
      Else
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'tokey', 8);
          PushTemp(ctx, tobj);
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
        End;
      If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit1(ctx, OP_PUSH, MemReg(R_ECX, RT_FN_HOME));
        End
      Else
        Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'super_get', 16);
    End
  Else If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
            StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_prop', 12);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
      CallBinary(ctx, 'get_member', tobj);
    End;
End;

Procedure GenMember(Var ctx: TCompilerContext; n: LongInt);
Var
  t, old_end: LongInt;
  top, old_used: Boolean;
Begin
  top := Not ctx.ir.in_chain;
  old_end := ctx.ir.chain_end;
  old_used := ctx.ir.chain_used;
  If top Then
    Begin
      ctx.ir.chain_end := NewLabel(ctx);
      ctx.ir.chain_used := False;
    End;
  t := TempAcquire(ctx);
  GenChainBase(ctx, n, t);
  GenPropFetch(ctx, n, t);
  TempRelease(ctx, t);
  If top Then
    Begin
      If ctx.ir.chain_used Then
        PlaceLabel(ctx, ctx.ir.chain_end);
      ctx.ir.chain_end := old_end;
      ctx.ir.chain_used := old_used;
    End;
  ctx.ir.in_chain := Not top;
End;

Procedure GenCall(Var ctx: TCompilerContext; n: LongInt);
Var
  callee, a, nargs, i, tf, tt, notfn, lbl, old_end, usethis, okl: LongInt;
  top, has_spread, old_used, is_new, is_super: Boolean;
  nt_old, nt_res: LongInt;

  { new.target : sauvegarde puis positionne la cible (new : le constructeur
    lui-meme ; super(...) : new.target du constructeur courant) pour un
    appele qui la consomme, restaure apres l'appel }
  Procedure NtEnter;
  Var
    hsy: LongInt;
  Begin
    If Not (is_new Or is_super) Then
      Exit;
    If is_new Then
      PushTemp(ctx, tf)
    Else
      Begin
        hsy := ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.first_sym;
        While (hsy <> 0) And (SymP(ctx.sem.syms, hsy)^.kind <> DK_NEWTARGET) Do
          hsy := SymP(ctx.sem.syms, hsy)^.next;
        If hsy <> 0 Then
          LoadSym(ctx, hsy)
        Else
          LoadUndefined(ctx);
        Emit1(ctx, OP_PUSH, RegOp(R_EDX));
        Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      End;
    PushTemp(ctx, tf);
    CallRt(ctx, 'nt_enter', 16);
    SaveTemp(ctx, nt_old);
  End;

  Procedure NtLeave;
  Begin
    If Not (is_new Or is_super) Then
      Exit;
    SaveTemp(ctx, nt_res);
    PushTemp(ctx, nt_old);
    CallRt(ctx, 'nt_leave', 8);
    LoadTemp(ctx, nt_res);
  End;

Begin
  callee := NodeP(ctx.ast.nodes, n)^.e1;
  is_new := NodeP(ctx.ast.nodes, n)^.kind = N_NEW;
  is_super := (callee <> 0) And (NodeP(ctx.ast.nodes, callee)^.kind = N_SUPER);
  If is_super And ((ctx.ir.cg_fs <= 1) Or
     (ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind <> FK_DERIVED_CTOR)) Then
    Begin
      PendingNote(ctx, n, 'super(...) hors du constructeur d''une classe derivee');
      LoadUndefined(ctx);
      Exit;
    End;
  top := Not ctx.ir.in_chain;
  old_end := ctx.ir.chain_end;
  old_used := ctx.ir.chain_used;
  If top Then
    Begin
      ctx.ir.chain_end := NewLabel(ctx);
      ctx.ir.chain_used := False;
    End;
  nargs := 0;
  has_spread := False;
  a := NodeP(ctx.ast.nodes, n)^.e2;
  While a <> 0 Do
    Begin
      Inc(nargs);
      If NodeP(ctx.ast.nodes, a)^.kind = N_SPREAD Then
        has_spread := True;
      a := NodeP(ctx.ast.nodes, a)^.next;
    End;
  tf := TempAcquire(ctx);
  tt := TempAcquire(ctx);
  nt_old := 0;
  nt_res := 0;
  If is_new Or is_super Then
    Begin
      nt_old := TempAcquire(ctx);
      nt_res := TempAcquire(ctx);
    End;

  { callee et this }
  If (Not is_new) And (callee <> 0) And ((NodeP(ctx.ast.nodes, callee)^.kind = N_MEMBER) Or
                        (NodeP(ctx.ast.nodes, callee)^.kind = N_INDEX)) Then
    Begin
      GenChainBase(ctx, callee, tt);
      GenPropFetch(ctx, callee, tt);
    End
  Else
    Begin
      If is_super Then
        Begin
          { constructeur parent : champ this de la classe courante }
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
        End
      Else
        Begin
          ctx.ir.in_chain := True;
          GenExpr(ctx, callee);
          ctx.ir.in_chain := False;
        End;
      SaveTemp(ctx, tf);
      If is_super Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
        End
      Else
        LoadUndefined(ctx);
      SaveTemp(ctx, tt);
      If is_new Then
        Begin
          { this d'un appel new : objet neuf, ou undefined pour un natif }
          usethis := NewLabel(ctx);
          LoadTemp(ctx, tf);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
          Emit1(ctx, OP_JNE, LabelOp(usethis));
          PushTemp(ctx, tf);
          CallRt(ctx, 'new_this', 8);
          SaveTemp(ctx, tt);
          PlaceLabel(ctx, usethis);
        End;
      LoadTemp(ctx, tf);
    End;
  If NodeP(ctx.ast.nodes, n)^.flags And EF_OPTIONAL <> 0 Then
    ChainNullCheck(ctx);
  SaveTemp(ctx, tf);
  { la valeur appelee doit etre une fonction }
  notfn := NewLabel(ctx);
  lbl := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
  Emit1(ctx, OP_JNE, LabelOp(notfn));

  If has_spread Then
    Begin
      { arguments rassembles dans un tableau }
      CallRt(ctx, 'array_new', 0);
      i := TempAcquire(ctx);
      SaveTemp(ctx, i);
      a := NodeP(ctx.ast.nodes, n)^.e2;
      While a <> 0 Do
        Begin
          If NodeP(ctx.ast.nodes, a)^.kind = N_SPREAD Then
            Begin
              GenExpr(ctx, NodeP(ctx.ast.nodes, a)^.e1);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, i);
              CallRt(ctx, 'array_spread', 16);
            End
          Else
            Begin
              GenExpr(ctx, a);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, i);
              CallRt(ctx, 'array_push', 16);
            End;
          a := NodeP(ctx.ast.nodes, a)^.next;
        End;
      NtEnter;
      PushTemp(ctx, i);
      PushTemp(ctx, tt);
      PushTemp(ctx, tf);
      CallRt(ctx, 'call_array', 24);
      NtLeave;
      TempRelease(ctx, i);
    End
  Else
    Begin
      Emit(ctx, OP_SUB, RegOp(R_ESP), ImmOp(16 + RT_VALUE_SIZE * nargs));
      i := 0;
      a := NodeP(ctx.ast.nodes, n)^.e2;
      While a <> 0 Do
        Begin
          GenExpr(ctx, a);
          Emit(ctx, OP_MOV, MemReg(R_ESP, 16 + RT_VALUE_SIZE * i), RegOp(R_EAX));
          Emit(ctx, OP_MOV, MemReg(R_ESP, 16 + RT_VALUE_SIZE * i + 4), RegOp(R_EDX));
          Inc(i);
          a := NodeP(ctx.ast.nodes, a)^.next;
        End;
      NtEnter;
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(tf));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 0), RegOp(R_EAX));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 4), ImmOp(nargs));
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(tt));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 8), RegOp(R_ECX));
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempHi(tt));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 12), RegOp(R_ECX));
      Emit1(ctx, OP_CALL, MemReg(R_EAX, RT_FN_CODE));
      Emit(ctx, OP_ADD, RegOp(R_ESP), ImmOp(16 + RT_VALUE_SIZE * nargs));
      NtLeave;
    End;
  If is_new Then
    Begin
      { le resultat d'un constructeur n'est retenu que s'il est un objet }
      usethis := NewLabel(ctx);
      okl := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_OBJECT)));
      Emit1(ctx, OP_JB, LabelOp(usethis));
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_REGEXP)));
      Emit1(ctx, OP_JBE, LabelOp(okl));
      PlaceLabel(ctx, usethis);
      LoadTemp(ctx, tt);
      PlaceLabel(ctx, okl);
    End;
  If is_super Then
    Begin
      { champs d'instance de cette classe, puis la valeur de l'expression est this }
      PushTemp(ctx, tt);
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'init_fields', 12);
      LoadTemp(ctx, tt);
    End;
  Emit1(ctx, OP_JMP, LabelOp(lbl));
  PlaceLabel(ctx, notfn);
  CallRt(ctx, 'throw_notfunc', 0);
  PlaceLabel(ctx, lbl);
  If is_new Or is_super Then
    Begin
      TempRelease(ctx, nt_res);
      TempRelease(ctx, nt_old);
    End;
  TempRelease(ctx, tt);
  TempRelease(ctx, tf);
  If top Then
    Begin
      If ctx.ir.chain_used Then
        PlaceLabel(ctx, ctx.ir.chain_end);
      ctx.ir.chain_end := old_end;
      ctx.ir.chain_used := old_used;
    End;
  ctx.ir.in_chain := Not top;
End;

{ Gabarit avec interpolation : les segments constants et les expressions converties
  par ToString sont concatenes de gauche a droite. }
Procedure GenTemplate(Var ctx: TCompilerContext; n: LongInt);
Var
  e, t: LongInt;
Begin
  e := NodeP(ctx.ast.nodes, n)^.e1;
  If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.next = 0) Then
    Begin
      LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
      Exit;
    End;
  t := TempAcquire(ctx);
  LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
  SaveTemp(ctx, t);
  e := NodeP(ctx.ast.nodes, e)^.next;
  While e <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, e)^.kind = N_TEMPLATE_STR Then
        Begin
          If StrP(ctx.data.strs, NodeP(ctx.ast.nodes, e)^.ds)^.len > 0 Then
            Begin
              LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, t);
              CallRt(ctx, 'concat', 16);
              SaveTemp(ctx, t);
            End;
        End
      Else
        Begin
          GenExpr(ctx, e);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'tostring', 8);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'concat', 16);
          SaveTemp(ctx, t);
        End;
      e := NodeP(ctx.ast.nodes, e)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Affectation simple ou destructurante ; la valeur reste dans EDX:EAX. }
Procedure GenAssign(Var ctx: TCompilerContext; n: LongInt);
Var
  lhs, t, tobj, tkey: LongInt;
Begin
  lhs := NodeP(ctx.ast.nodes, n)^.e1;
  If TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text <> '=' Then
    Begin
      GenCompound(ctx, n);
      Exit;
    End;
  If (lhs <> 0) And (NodeP(ctx.ast.nodes, lhs)^.kind = N_IDENT) Then
    Begin
      If (NodeP(ctx.ast.nodes, lhs)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, lhs)^.aux = RK_OUTER) Or
         (NodeP(ctx.ast.nodes, lhs)^.aux = RK_GLOBAL_IMPLICIT) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
          StoreSym(ctx, NodeP(ctx.ast.nodes, lhs)^.sym, False);
        End
      Else
        PendingExpr(ctx, n);
    End
  Else If IsMemberTarget(ctx, lhs) Then
    Begin
      MemberPrep(ctx, lhs, tobj, tkey);
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      MemberStore(ctx, lhs, tobj, tkey);
      MemberDone(ctx, tobj, tkey);
    End
  Else If (lhs <> 0) And ((NodeP(ctx.ast.nodes, lhs)^.kind = N_ARRAY_LIT) Or
                          (NodeP(ctx.ast.nodes, lhs)^.kind = N_OBJECT_LIT)) Then
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      t := AllocTemp(ctx);
      Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t)), RegOp(R_EAX));
      Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t) + 4), RegOp(R_EDX));
      BindTo(ctx, lhs, t, False);
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, SlotDisp(t)));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, SlotDisp(t) + 4));
    End
  Else
    PendingExpr(ctx, n);
End;

{ Litteral de tableau : array_new puis array_push / array_spread. }
Procedure GenArrayLit(Var ctx: TCompilerContext; n: LongInt);
Var
  t, el: LongInt;
Begin
  t := TempAcquire(ctx);
  CallRt(ctx, 'array_new', 0);
  SaveTemp(ctx, t);
  el := NodeP(ctx.ast.nodes, n)^.e1;
  While el <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
        GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e1)
      Else If NodeP(ctx.ast.nodes, el)^.kind = N_ELISION Then
        LoadUndefined(ctx)
      Else
        GenExpr(ctx, el);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      PushTemp(ctx, t);
      If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
        CallRt(ctx, 'array_spread', 16)
      Else
        CallRt(ctx, 'array_push', 16);
      el := NodeP(ctx.ast.nodes, el)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Litteral d'objet : obj_new puis obj_define / obj_define_acc / obj_spread. }
Procedure GenObjectLit(Var ctx: TCompilerContext; n: LongInt);
Var
  t, tk, p, fl: LongInt;
Begin
  t := TempAcquire(ctx);
  CallRt(ctx, 'obj_new', 0);
  SaveTemp(ctx, t);
  p := NodeP(ctx.ast.nodes, n)^.e1;
  While p <> 0 Do
    Begin
      fl := NodeP(ctx.ast.nodes, p)^.flags;
      If fl And PR_SPREAD <> 0 Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'obj_spread', 16);
        End
      Else If (fl And (PR_COMPUTED Or PR_SHORTHAND Or PR_METHOD Or PR_GETTER Or PR_SETTER) = 0) And
              (StrText(ctx, NodeP(ctx.ast.nodes, p)^.aux) = '__proto__') Then
        Begin
          { litteral avec une cle __proto__ : fixe le prototype de l objet }
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'obj_set_proto_lit', 12);
        End
      Else
        Begin
          tk := 0;
          If fl And PR_COMPUTED <> 0 Then
            Begin
              tk := TempAcquire(ctx);
              GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e2);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              CallRt(ctx, 'tokey', 8);
              SaveTemp(ctx, tk);
            End;
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          If fl And (PR_METHOD Or PR_GETTER Or PR_SETTER) <> 0 Then
            Begin
              { objet d'accueil de la methode : super.m() }
              Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
              Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_THIS), RegOp(R_ECX));
              Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_THIS + 4), ImmOp(TagImm(RT_T_OBJECT)));
            End;
          If fl And PR_SETTER <> 0 Then
            Emit1(ctx, OP_PUSH, ImmOp(1))
          Else If fl And PR_GETTER <> 0 Then
            Emit1(ctx, OP_PUSH, ImmOp(0));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          If tk <> 0 Then
            Emit1(ctx, OP_PUSH, TempLo(tk))
          Else
            Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, p)^.aux)^.sym));
          Emit1(ctx, OP_PUSH, TempLo(t));
          If fl And (PR_GETTER Or PR_SETTER) <> 0 Then
            CallRt(ctx, 'obj_define_acc', 20)
          Else
            CallRt(ctx, 'obj_define', 16);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End;
      p := NodeP(ctx.ast.nodes, p)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ ---- Classes (TODO 17) ----

  Une classe est la fonction constructeur elle-meme (objet fonction), avec
  un objet de proprietes (membres statiques, prototype herite de la classe
  parente) et un objet prototype (methodes, accesseurs, constructor).
  _JSRT_class_setup(classe, parent) cree ces deux objets et memorise la
  classe parente dans le champ this de la fonction, que super(...) lit.
  Une methode memorise son objet d'accueil dans ce meme champ, ce qui
  permet super.m(...). Les champs d'instance sont enregistres dans la
  propriete cachee #fields du prototype ; _JSRT_init_fields(classe,
  this) les initialise (au debut du constructeur de base, ou juste apres
  super(...) dans une classe derivee). }

Function ClassCtor(Var ctx: TCompilerContext; n: LongInt): LongInt;
Var
  m: LongInt;
Begin
  ClassCtor := 0;
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR <> 0) Then
        ClassCtor := m;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
End;

{ Cle d'un membre de classe : EAX = chaine ; resultat dans le temporaire tk
  (calculee) ou 0 si la cle est un atome. }
Function ClassKeyTemp(Var ctx: TCompilerContext; m: LongInt): LongInt;
Var
  tk: LongInt;
Begin
  tk := 0;
  If NodeP(ctx.ast.nodes, m)^.flags And MF_COMPUTED <> 0 Then
    Begin
      tk := TempAcquire(ctx);
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e3);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tokey', 8);
      SaveTemp(ctx, tk);
    End;
  ClassKeyTemp := tk;
End;

Procedure PushClassKey(Var ctx: TCompilerContext; m, tk: LongInt);
Begin
  If tk <> 0 Then
    Emit1(ctx, OP_PUSH, TempLo(tk))
  Else
    Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
End;

Procedure PushUndefinedValue(Var ctx: TCompilerContext);
Begin
  Emit1(ctx, OP_PUSH, ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_PUSH, ImmOp(0));
End;

Procedure GenClass(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, tcls, tpar, tproto, tk, m, ctor, sy, kind: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  If sc <> 0 Then
    GenScopeEnter(ctx, sc);
  tcls := TempAcquire(ctx);
  tpar := TempAcquire(ctx);
  tproto := TempAcquire(ctx);
  If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
    GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1)
  Else
    LoadUndefined(ctx);
  SaveTemp(ctx, tpar);
  ctor := ClassCtor(ctx, n);
  If ctor <> 0 Then
    GenMakeClosure(ctx, ctor)
  Else
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
            StrP(ctx.data.strs, CdescP(ctx.data.cdescs, NodeP(ctx.ast.nodes, n)^.ds)^.name_str)^.sym));
      If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
        Emit1(ctx, OP_PUSH, ImmOp(1))
      Else
        Emit1(ctx, OP_PUSH, ImmOp(0));
      CallRt(ctx, 'make_default_ctor', 8);
    End;
  SaveTemp(ctx, tcls);
  PushTemp(ctx, tpar);
  PushTemp(ctx, tcls);
  CallRt(ctx, 'class_setup', 16);
  PushTemp(ctx, tcls);
  CallRt(ctx, 'class_proto', 8);
  SaveTemp(ctx, tproto);
  { liaison du nom : exterieure pour une declaration, interieure pour une expression }
  If NodeP(ctx.ast.nodes, n)^.kind = N_CLASS_DECL Then
    Begin
      If NodeP(ctx.ast.nodes, n)^.sym <> 0 Then
        Begin
          LoadTemp(ctx, tcls);
          StoreSym(ctx, NodeP(ctx.ast.nodes, n)^.sym, True);
        End;
    End
  Else If sc <> 0 Then
    Begin
      sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
      While sy <> 0 Do
        Begin
          If SymP(ctx.sem.syms, sy)^.kind = DK_FNAME Then
            Begin
              LoadTemp(ctx, tcls);
              StoreSym(ctx, sy, True);
            End;
          sy := SymP(ctx.sem.syms, sy)^.next;
        End;
    End;
  { premiere passe : methodes, accesseurs et champs d'instance }
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR = 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          GenMakeClosure(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.flags And MF_GETTER <> 0 Then
            kind := 1
          Else If NodeP(ctx.ast.nodes, m)^.flags And MF_SETTER <> 0 Then
            kind := 2
          Else
            kind := 0;
          Emit1(ctx, OP_PUSH, ImmOp(kind));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          If NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0 Then
            PushTemp(ctx, tcls)
          Else
            PushTemp(ctx, tproto);
          CallRt(ctx, 'class_member', 24);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End
      Else If (NodeP(ctx.ast.nodes, m)^.kind = N_FIELD) And
              (NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC = 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.e1 <> 0 Then
            GenMakeClosure(ctx, m)
          Else
            LoadUndefined(ctx);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          PushTemp(ctx, tproto);
          CallRt(ctx, 'class_field', 20);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  { seconde passe : champs statiques et blocs statiques, dans l'ordre }
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_FIELD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.e1 <> 0 Then
            GenMakeClosure(ctx, m)
          Else
            LoadUndefined(ctx);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          PushTemp(ctx, tcls);
          CallRt(ctx, 'class_static', 20);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End
      Else If NodeP(ctx.ast.nodes, m)^.kind = N_STATIC_BLOCK Then
        Begin
          GenMakeClosure(ctx, m);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, tcls);
          CallRt(ctx, 'class_block', 16);
        End;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  LoadTemp(ctx, tcls);
  TempRelease(ctx, tproto);
  TempRelease(ctx, tpar);
  TempRelease(ctx, tcls);
End;

Procedure GenExpr(Var ctx: TCompilerContext; n: LongInt);
Var
  e: LongInt;
  save_chain: Boolean;
Begin
  If n = 0 Then
    Begin
      LoadUndefined(ctx);
      Exit;
    End;
  save_chain := ctx.ir.in_chain;
  If Not IsChainKind(NodeP(ctx.ast.nodes, n)^.kind) Then
    ctx.ir.in_chain := False;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_CALL, N_NEW:
      GenCall(ctx, n);
    N_REGEX:
      Begin
        { litteral /motif/drapeaux : objet RegExp cree a chaque evaluation }
        Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, n)^.aux)^.sym));
        Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, n)^.ds)^.sym));
        CallRt(ctx, 'regex_new', 8);
      End;
    N_ARRAY_LIT:
      GenArrayLit(ctx, n);
    N_OBJECT_LIT:
      GenObjectLit(ctx, n);
    N_CLASS_EXPR:
      GenClass(ctx, n);
    N_SUPER:
      If NodeP(ctx.ast.nodes, n)^.e1 = 1 Then
        Begin
          { fleche : this lexical memorise dans la fermeture }
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
        End
      Else
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
        End;
    N_MEMBER, N_INDEX:
      GenMember(ctx, n);
    N_FUNC_EXPR:
      GenMakeClosure(ctx, n);
    N_NUMBER:
      Begin
        If NodeP(ctx.ast.nodes, n)^.ds <> 0 Then
          LoadDouble(ctx, NodeP(ctx.ast.nodes, n)^.ds)
        Else
          LoadTag(ctx, Trunc(TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.num_val),
                  RT_T_INT32);
      End;
    N_STRING, N_TEMPLATE_STR:
      LoadStringConst(ctx, NodeP(ctx.ast.nodes, n)^.ds);
    N_TEMPLATE:
      GenTemplate(ctx, n);
    N_BOOL:
      Begin
        If TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'true' Then
          LoadTag(ctx, 1, RT_T_BOOLEAN)
        Else
          LoadTag(ctx, 0, RT_T_BOOLEAN);
      End;
    N_NULL:
      LoadTag(ctx, 0, RT_T_NULL);
    N_IDENT:
      GenIdent(ctx, n);
    N_THIS:
      GenThis(ctx, n);
    N_ASSIGN:
      GenAssign(ctx, n);
    N_UNARY:
      Begin
        If Not TryFold(ctx, n) Then
          GenUnary(ctx, n);
      End;
    N_BINARY:
      Begin
        If Not TryFold(ctx, n) Then
          GenBinary(ctx, n);
      End;
    N_LOGICAL:
      Begin
        If Not TryFold(ctx, n) Then
          GenLogical(ctx, n);
      End;
    N_COND:
      Begin
        If Not TryFold(ctx, n) Then
          GenCond(ctx, n);
      End;
    N_UPDATE:
      GenUpdate(ctx, n);
    N_SEQUENCE:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        While e <> 0 Do
          Begin
            GenExpr(ctx, e);
            e := NodeP(ctx.ast.nodes, e)^.next;
          End;
      End;
  Else
    PendingExpr(ctx, n);
  End;
  ctx.ir.in_chain := save_chain;
End;

{ ---- Destructuration ---- }

Procedure StoreTemp(Var ctx: TCompilerContext; slot: LongInt);
Begin
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(slot)), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(slot) + 4), RegOp(R_EDX));
End;

Procedure PushTemp(Var ctx: TCompilerContext; slot: LongInt);
Begin
  Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(slot) + 4));
  Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(slot)));
End;

{ Si EDX:EAX vaut undefined, evalue la valeur par defaut. }
Procedure GenDefault(Var ctx: TCompilerContext; def: LongInt);
Var
  skip: LongInt;
Begin
  If def = 0 Then
    Exit;
  skip := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JNE, LabelOp(skip));
  GenExpr(ctx, def);
  PlaceLabel(ctx, skip);
End;

{ Lie EDX:EAX a la cible (identifiant ou sous-motif). }
Procedure BindValue(Var ctx: TCompilerContext; target: LongInt; init: Boolean);
Var
  t, tobj, tkey: LongInt;
Begin
  If target = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, target)^.kind Of
    N_BIND_IDENT:
      StoreSym(ctx, NodeP(ctx.ast.nodes, target)^.sym, True);
    N_IDENT:
      Begin
        If (NodeP(ctx.ast.nodes, target)^.aux = RK_LOCAL) Or
           (NodeP(ctx.ast.nodes, target)^.aux = RK_OUTER) Or
           (NodeP(ctx.ast.nodes, target)^.aux = RK_GLOBAL_IMPLICIT) Then
          StoreSym(ctx, NodeP(ctx.ast.nodes, target)^.sym, init)
        Else
          PendingNote(ctx, target, 'cible d''affectation ' +
                      NodeKindName(NodeP(ctx.ast.nodes, target)^.kind));
      End;
    N_ARRAY_PATTERN, N_OBJECT_PATTERN, N_ARRAY_LIT, N_OBJECT_LIT:
      Begin
        t := AllocTemp(ctx);
        StoreTemp(ctx, t);
        BindTo(ctx, target, t, init);
      End;
    N_MEMBER, N_INDEX:
      Begin
        t := TempAcquire(ctx);
        SaveTemp(ctx, t);
        MemberPrep(ctx, target, tobj, tkey);
        LoadTemp(ctx, t);
        MemberStore(ctx, target, tobj, tkey);
        MemberDone(ctx, tobj, tkey);
        TempRelease(ctx, t);
      End;
  Else
    PendingNote(ctx, target, 'cible d''affectation ' +
                NodeKindName(NodeP(ctx.ast.nodes, target)^.kind));
  End;
End;

{ Destructure la valeur rangee dans le temporaire tslot. node est un
  motif de declaration ou un litteral utilise comme cible. }
Procedure BindTo(Var ctx: TCompilerContext; node, tslot: LongInt; init: Boolean);
Var
  el, idx, target, def, key_atom, nkeys, tex, tk: LongInt;
  rest, hole, pattern_kind, has_rest: Boolean;
  fl: LongInt;
  kn: TNodeKind;
Begin
  kn := NodeP(ctx.ast.nodes, node)^.kind;
  If (kn = N_ARRAY_PATTERN) Or (kn = N_ARRAY_LIT) Then
    Begin
      idx := 0;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          rest := False;
          hole := False;
          def := 0;
          target := 0;
          If NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_ELEM Then
            Begin
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
              rest := NodeP(ctx.ast.nodes, el)^.flags And PF_REST <> 0;
              hole := target = 0;
            End
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_ELISION Then
            hole := True
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
            Begin
              rest := True;
              target := NodeP(ctx.ast.nodes, el)^.e1;
            End
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_ASSIGN Then
            Begin
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
            End
          Else
            target := el;
          If Not hole Then
            Begin
              If rest Then
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(idx));
                  PushTemp(ctx, tslot);
                  CallRt(ctx, 'array_rest', 12);
                End
              Else
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(idx));
                  PushTemp(ctx, tslot);
                  CallRt(ctx, 'get_index', 12);
                  GenDefault(ctx, def);
                End;
              BindValue(ctx, target, init);
            End;
          Inc(idx);
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
    End
  Else
    Begin
      nkeys := 0;
      tex := 0;
      has_rest := False;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          If ((NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_PROP) And
              (NodeP(ctx.ast.nodes, el)^.flags And PP_REST <> 0)) Or
             ((NodeP(ctx.ast.nodes, el)^.kind <> N_PATTERN_PROP) And
              (NodeP(ctx.ast.nodes, el)^.flags And PR_SPREAD <> 0)) Then
            has_rest := True;
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
      If has_rest Then
        Begin
          { liste des cles deja prises, pour le reste de l'objet }
          tex := TempAcquire(ctx);
          CallRt(ctx, 'array_new', 0);
          SaveTemp(ctx, tex);
        End;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          If NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_PROP Then
            Begin
              fl := NodeP(ctx.ast.nodes, el)^.flags;
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
              rest := fl And PP_REST <> 0;
              pattern_kind := fl And PP_COMPUTED <> 0;
              key_atom := NodeP(ctx.ast.nodes, el)^.aux;
              If pattern_kind Then
                Begin
                  GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e3);
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                  CallRt(ctx, 'tokey', 8);
                  If has_rest And Not rest Then
                    Begin
                      tk := TempAcquire(ctx);
                      SaveTemp(ctx, tk);
                      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                      PushTemp(ctx, tex);
                      CallRt(ctx, 'array_push', 16);
                      LoadTemp(ctx, tk);
                      TempRelease(ctx, tk);
                    End;
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                End;
            End
          Else
            Begin
              fl := NodeP(ctx.ast.nodes, el)^.flags;
              rest := fl And PR_SPREAD <> 0;
              pattern_kind := fl And PR_COMPUTED <> 0;
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e3;
              key_atom := NodeP(ctx.ast.nodes, el)^.aux;
              If pattern_kind Then
                Begin
                  GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e2);
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                  CallRt(ctx, 'tokey', 8);
                  If has_rest And Not rest Then
                    Begin
                      tk := TempAcquire(ctx);
                      SaveTemp(ctx, tk);
                      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                      PushTemp(ctx, tex);
                      CallRt(ctx, 'array_push', 16);
                      LoadTemp(ctx, tk);
                      TempRelease(ctx, tk);
                    End;
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                End;
              { dans a: b = 1, la valeur par defaut enveloppe la cible }
              If (target <> 0) And (NodeP(ctx.ast.nodes, target)^.kind = N_ASSIGN) And
                 (fl And PR_SHORTHAND = 0) Then
                Begin
                  def := NodeP(ctx.ast.nodes, target)^.e2;
                  target := NodeP(ctx.ast.nodes, target)^.e1;
                End;
            End;
          If rest Then
            Begin
              { le reste d'objet : copie sans les cles deja prises }
              PushTemp(ctx, tex);
              PushTemp(ctx, tslot);
              CallRt(ctx, 'obj_rest', 16);
            End
          Else If pattern_kind Then
            Begin
              { cle calculee deja poussee : valeur puis cle }
              PushTemp(ctx, tslot);
              CallRt(ctx, 'get_member', 16);
              GenDefault(ctx, def);
            End
          Else
            Begin
              If has_rest Then
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(TagImm(RT_T_STRING)));
                  Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, key_atom)^.sym));
                  PushTemp(ctx, tex);
                  CallRt(ctx, 'array_push', 16);
                End;
              Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, key_atom)^.sym));
              PushTemp(ctx, tslot);
              CallRt(ctx, 'get_prop', 12);
              GenDefault(ctx, def);
            End;
          BindValue(ctx, target, init);
          Inc(nkeys);
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
      If has_rest Then
        TempRelease(ctx, tex);
    End;
End;

{ ---- Entree de portee, declarations, instructions ---- }

Procedure GenScopeEnter(Var ctx: TCompilerContext; sc: LongInt);
Var
  sy, tag: LongInt;
Begin
  { premiere passe : cellules et valeurs initiales }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.flags And SF_STATIC = 0 Then
        Begin
          tag := RT_T_UNDEFINED;
          If IsLexicalKind(SymP(ctx.sem.syms, sy)^.kind) And
             (SymP(ctx.sem.syms, sy)^.flags And SF_TDZ_CHECK <> 0) Then
            tag := RT_T_TDZ;
          If SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0 Then
            Begin
              Emit1(ctx, OP_PUSH, ImmOp(TagImm(tag)));
              CallRt(ctx, 'new_cell', 4);
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
                   RegOp(R_EAX));
            End
          Else If (SymP(ctx.sem.syms, sy)^.kind = DK_VAR) Or
                  (SymP(ctx.sem.syms, sy)^.kind = DK_FUNC) Or (tag = RT_T_TDZ) Then
            Begin
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
                   ImmOp(0));
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot) + 4),
                   ImmOp(TagImm(tag)));
            End;
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  { seconde passe : les declarations de fonctions sont hissees avec leur valeur }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_FUNC Then
        Begin
          GenMakeClosure(ctx, SymP(ctx.sem.syms, sy)^.node);
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
End;

Procedure GenVarDecl(Var ctx: TCompilerContext; n: LongInt);
Var
  d, target, init, sy: LongInt;
  t: LongInt;
Begin
  d := NodeP(ctx.ast.nodes, n)^.e1;
  While d <> 0 Do
    Begin
      target := NodeP(ctx.ast.nodes, d)^.e1;
      init := NodeP(ctx.ast.nodes, d)^.e2;
      If (target <> 0) And (NodeP(ctx.ast.nodes, target)^.kind = N_BIND_IDENT) Then
        Begin
          sy := NodeP(ctx.ast.nodes, target)^.sym;
          If init <> 0 Then
            Begin
              GenExpr(ctx, init);
              StoreSym(ctx, sy, True);
            End
          Else If SymP(ctx.sem.syms, sy)^.kind = DK_LET Then
            Begin
              LoadUndefined(ctx);
              StoreSym(ctx, sy, True);
            End;
        End
      Else If target <> 0 Then
        Begin
          GenExpr(ctx, init);
          t := AllocTemp(ctx);
          StoreTemp(ctx, t);
          BindTo(ctx, target, t, True);
        End;
      d := NodeP(ctx.ast.nodes, d)^.next;
    End;
End;

Procedure GenStmtList(Var ctx: TCompilerContext; n: LongInt); Forward;

{ ---- Controle de flux (TODO 11) ----

  Chaque structure recoit ses etiquettes uniques (_JSL_nnnn). Une pile
  de cibles de saut memorise, pour chaque boucle, switch ou instruction
  etiquetee, l'etiquette de break, celle de continue et ses noms
  d'etiquettes. Une condition constante est resolue a la compilation
  (while (1), if (0)...).

  for-in et for-of passent par le runtime : _JSRT_iter_new(valeur)
  cree un iterateur (tableau ou chaine), _JSRT_iter_next(iterateur)
  rend la valeur suivante ou la marque DONE ; for-in parcourt
  _JSRT_forin_keys(objet), le tableau des noms de proprietes. Les
  variables let capturees de l'en-tete d'un for recoivent une nouvelle
  cellule a chaque iteration (_JSRT_cell_copy). }

{ Memorise la ligne courante dans l'emplacement 1 de la trame (trace de pile). Les
  lignes du prelude donnent 0 ; le programme principal ajoute le drapeau $40000000. }
Procedure EmitLineMarker(Var ctx: TCompilerContext; line: LongInt);
Var
  v: LongInt;
Begin
  If line = ctx.ir.last_stmt_line Then
    Exit;
  ctx.ir.last_stmt_line := line;
  v := line;
  If v > ctx.source.user_lines Then
    v := 0;
  If ctx.ir.cg_fs = 1 Then
    v := v Or $40000000;
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(1)), ImmOp(v));
End;

Procedure GenStmt(Var ctx: TCompilerContext; n: LongInt); Forward;

Procedure PushTarget(Var ctx: TCompilerContext; kind, brk, cont: LongInt);
Var
  i: LongInt;
Begin
  Inc(ctx.ir.jt_count);
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.kind := kind;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.brk := brk;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.cont := cont;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.nlabels := ctx.ir.plabel_count;
  For i := 1 To ctx.ir.plabel_count Do
    JtLabelP(JtP(ctx.ir.jt, ctx.ir.jt_count)^.labels, i)^ := PlabelP(ctx.ir.plabels, i)^;
  ctx.ir.plabel_count := 0;
End;

Procedure PopTarget(Var ctx: TCompilerContext);
Begin
  If ctx.ir.jt_count > 0 Then
    Dec(ctx.ir.jt_count);
End;

{ Cible d'un break ou continue : sans etiquette, la plus proche boucle
  (ou switch pour break) ; avec etiquette, celle qui la porte. }
Function FindTarget(Var ctx: TCompilerContext; label_tok: LongInt;
                    is_break: Boolean): LongInt;
Var
  i, j: LongInt;
Begin
  FindTarget := 0;
  For i := ctx.ir.jt_count Downto 1 Do
    Begin
      If label_tok = 0 Then
        Begin
          If (JtP(ctx.ir.jt, i)^.kind = JT_LOOP) Or
             (is_break And (JtP(ctx.ir.jt, i)^.kind = JT_SWITCH)) Then
            Begin
              FindTarget := i;
              Exit;
            End;
        End
      Else
        For j := 1 To JtP(ctx.ir.jt, i)^.nlabels Do
          If TokP(ctx.lex.tokens, JtLabelP(JtP(ctx.ir.jt, i)^.labels, j)^)^.text =
             TokP(ctx.lex.tokens, label_tok)^.text Then
            Begin
              FindTarget := i;
              Exit;
            End;
    End;
End;

{ Saute vers lfalse si la condition est fausse. }
Procedure GenCondJumpFalse(Var ctx: TCompilerContext; e, lfalse: LongInt);
Var
  c: TConst;
Begin
  If e = 0 Then
    Exit;
  If EvalConst(ctx, e, c) Then
    Begin
      If Not ConstTruthy(c) Then
        Emit1(ctx, OP_JMP, LabelOp(lfalse));
      Exit;
    End;
  GenExpr(ctx, e);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(lfalse));
End;

{ Saute vers ltrue si la condition est vraie. }
Procedure GenCondJumpTrue(Var ctx: TCompilerContext; e, ltrue: LongInt);
Var
  c: TConst;
Begin
  If e = 0 Then
    Begin
      Emit1(ctx, OP_JMP, LabelOp(ltrue));
      Exit;
    End;
  If EvalConst(ctx, e, c) Then
    Begin
      If ConstTruthy(c) Then
        Emit1(ctx, OP_JMP, LabelOp(ltrue));
      Exit;
    End;
  GenExpr(ctx, e);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JNE, LabelOp(ltrue));
End;

Procedure GenIf(Var ctx: TCompilerContext; n: LongInt);
Var
  els, done: LongInt;
Begin
  els := NewLabel(ctx);
  GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e1, els);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  If NodeP(ctx.ast.nodes, n)^.e3 <> 0 Then
    Begin
      done := NewLabel(ctx);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, els);
      GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e3);
      PlaceLabel(ctx, done);
    End
  Else
    PlaceLabel(ctx, els);
End;

Procedure GenWhile(Var ctx: TCompilerContext; n: LongInt);
Var
  top, brk: LongInt;
Begin
  top := NewLabel(ctx);
  brk := NewLabel(ctx);
  PlaceLabel(ctx, top);
  GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e1, brk);
  PushTarget(ctx, JT_LOOP, brk, top);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  PopTarget(ctx);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
End;

Procedure GenDoWhile(Var ctx: TCompilerContext; n: LongInt);
Var
  top, cont, brk: LongInt;
Begin
  top := NewLabel(ctx);
  cont := NewLabel(ctx);
  brk := NewLabel(ctx);
  PlaceLabel(ctx, top);
  PushTarget(ctx, JT_LOOP, brk, cont);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  PopTarget(ctx);
  PlaceLabel(ctx, cont);
  GenCondJumpTrue(ctx, NodeP(ctx.ast.nodes, n)^.e2, top);
  PlaceLabel(ctx, brk);
End;

{ Nouvelle cellule (copie) pour chaque variable de l'en-tete capturee. }
Procedure GenPerIterationCopy(Var ctx: TCompilerContext; sc: LongInt);
Var
  sy: LongInt;
Begin
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If (SymP(ctx.sem.syms, sy)^.flags And SF_PER_ITER <> 0) And
         (SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0) Then
        Begin
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)));
          CallRt(ctx, 'cell_copy', 4);
          Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
               RegOp(R_EAX));
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
End;

Procedure GenFor(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, top, cont, brk, init: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  top := NewLabel(ctx);
  cont := NewLabel(ctx);
  brk := NewLabel(ctx);
  GenScopeEnter(ctx, sc);
  init := NodeP(ctx.ast.nodes, n)^.e1;
  If init <> 0 Then
    Begin
      If NodeP(ctx.ast.nodes, init)^.kind = N_VAR_DECL Then
        GenVarDecl(ctx, init)
      Else
        GenExpr(ctx, init);
    End;
  PlaceLabel(ctx, top);
  If NodeP(ctx.ast.nodes, n)^.e2 <> 0 Then
    GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e2, brk);
  PushTarget(ctx, JT_LOOP, brk, cont);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e4);
  PopTarget(ctx);
  PlaceLabel(ctx, cont);
  GenPerIterationCopy(ctx, sc);
  If NodeP(ctx.ast.nodes, n)^.e3 <> 0 Then
    GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
End;

{ for (x of valeur) et for (x in objet). }
Procedure GenForInOf(Var ctx: TCompilerContext; n: LongInt; is_of: Boolean);
Var
  sc, top, brk, iter, v, left, target: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  top := NewLabel(ctx);
  brk := NewLabel(ctx);
  iter := TempAcquire(ctx);
  v := TempAcquire(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  If Not is_of Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'forin_keys', 8);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'iter_new', 8);
  SaveTemp(ctx, iter);
  PlaceLabel(ctx, top);
  PushTemp(ctx, iter);
  CallRt(ctx, 'iter_next', 8);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_DONE)));
  Emit1(ctx, OP_JE, LabelOp(brk));
  SaveTemp(ctx, v);
  { nouvelle portee (nouvelles cellules) a chaque iteration }
  GenScopeEnter(ctx, sc);
  LoadTemp(ctx, v);
  left := NodeP(ctx.ast.nodes, n)^.e1;
  If (left <> 0) And (NodeP(ctx.ast.nodes, left)^.kind = N_VAR_DECL) Then
    Begin
      target := NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, left)^.e1)^.e1;
      BindValue(ctx, target, True);
    End
  Else
    BindValue(ctx, left, False);
  PushTarget(ctx, JT_LOOP, brk, top);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  PopTarget(ctx);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
  TempRelease(ctx, v);
  TempRelease(ctx, iter);
End;

Procedure GenSwitch(Var ctx: TCompilerContext; n: LongInt);
Var
  t, brk, base, cs, i, ncases, dflt: LongInt;
Begin
  brk := NewLabel(ctx);
  ncases := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      Inc(ncases);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  base := ctx.ir.label_count + 1;
  Inc(ctx.ir.label_count, ncases);
  t := TempAcquire(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  SaveTemp(ctx, t);
  GenScopeEnter(ctx, NodeP(ctx.ast.nodes, n)^.scope);
  { tests dans l'ordre : discriminant === valeur du case }
  dflt := 0;
  i := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, cs)^.e1 = 0 Then
        dflt := base + i
      Else
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, cs)^.e1);
          GenBinaryCore(ctx, '===', t);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          Emit1(ctx, OP_JNE, LabelOp(base + i));
        End;
      Inc(i);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  If dflt <> 0 Then
    Emit1(ctx, OP_JMP, LabelOp(dflt))
  Else
    Emit1(ctx, OP_JMP, LabelOp(brk));
  PushTarget(ctx, JT_SWITCH, brk, 0);
  i := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      PlaceLabel(ctx, base + i);
      GenStmtList(ctx, NodeP(ctx.ast.nodes, cs)^.e2);
      Inc(i);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  PopTarget(ctx);
  PlaceLabel(ctx, brk);
  TempRelease(ctx, t);
End;

{ ---- Exceptions (TODO 18) ----

  Un try ouvre un enregistrement de gestionnaire de 32 octets dans la
  trame (4 emplacements) : precedent +0, esp +4, ebp +8, adresse du
  catch +12, ebx +16, esi +20, edi +24. Il est chaine dans la variable
  du runtime handler_top. _JSRT_throw(valeur) range la valeur dans la
  variable exc, depile le gestionnaire, restaure esp, ebp, ebx, esi, edi
  et saute a l'adresse du catch. L'adresse est obtenue par l'astuce
  call / pop : le point de reprise est l'instruction jmp qui suit le
  call. Un return, break ou continue qui sort d'un try depile son
  gestionnaire et recopie le bloc finally a cet endroit. }

Function AllocHandler(Var ctx: TCompilerContext): LongInt;
Var
  a, b, c, d: LongInt;
Begin
  a := AllocTemp(ctx);
  b := AllocTemp(ctx);
  c := AllocTemp(ctx);
  d := AllocTemp(ctx);
  AllocHandler := SlotDisp(d);
End;

Procedure HandlerSetup(Var ctx: TCompilerContext; base, lcatch: LongInt);
Var
  lset: LongInt;
Begin
  lset := NewLabel(ctx);
  Emit1(ctx, OP_CALL, LabelOp(lset));
  Emit1(ctx, OP_JMP, LabelOp(lcatch));
  PlaceLabel(ctx, lset);
  Emit1(ctx, OP_POP, RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_CATCH), RegOp(R_EAX));
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_PREV), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_ESP), RegOp(R_ESP));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_EBP), RegOp(R_EBP));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 16), RegOp(R_EBX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 20), RegOp(R_ESI));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 24), RegOp(R_EDI));
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'newtarget'), 0));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 28), RegOp(R_EAX));
  Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, base));
  Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0), RegOp(R_EAX));
End;

Procedure HandlerPop(Var ctx: TCompilerContext; base: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, base + RT_EH_PREV));
  Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0), RegOp(R_EAX));
End;

Procedure TryPush(Var ctx: TCompilerContext; base, fin: LongInt);
Begin
  Inc(ctx.ir.try_count);
  TryRecP(ctx.ir.try_rec, ctx.ir.try_count)^ := base;
  TryFinP(ctx.ir.try_fin, ctx.ir.try_count)^ := fin;
  TryJtP(ctx.ir.try_jt, ctx.ir.try_count)^ := ctx.ir.jt_count;
End;

{ Sort des try dont l'etiquette de saut est jt >= mint : depile leur
  gestionnaire et execute leur finally (return : mint = 0). }
Procedure GenExitTries(Var ctx: TCompilerContext; mint: LongInt);
Var
  saved, i, fin, base: LongInt;
Begin
  saved := ctx.ir.try_count;
  i := saved;
  While (i >= 1) And (TryJtP(ctx.ir.try_jt, i)^ >= mint) Do
    Begin
      base := TryRecP(ctx.ir.try_rec, i)^;
      fin := TryFinP(ctx.ir.try_fin, i)^;
      HandlerPop(ctx, base);
      ctx.ir.try_count := i - 1;
      If fin <> 0 Then
        GenStmt(ctx, fin);
      Dec(i);
    End;
  ctx.ir.try_count := saved;
End;

Procedure GenTryCatch(Var ctx: TCompilerContext; n: LongInt);
Var
  base, lcatch, lend, cn, par, cnt: LongInt;
Begin
  base := AllocHandler(ctx);
  lcatch := NewLabel(ctx);
  lend := NewLabel(ctx);
  HandlerSetup(ctx, base, lcatch);
  TryPush(ctx, base, 0);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  Dec(ctx.ir.try_count);
  HandlerPop(ctx, base);
  Emit1(ctx, OP_JMP, LabelOp(lend));
  PlaceLabel(ctx, lcatch);
  cn := NodeP(ctx.ast.nodes, n)^.e2;
  GenScopeEnter(ctx, NodeP(ctx.ast.nodes, cn)^.scope);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 4));
  { return() d'un generateur : la valeur sentinelle traverse les catch }
  cnt := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EAX), AddrSym(SYMK_X, XSym(ctx, '_JSNO_function_proto')));
  Emit1(ctx, OP_JNE, LabelOp(cnt));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_OBJECT)));
  Emit1(ctx, OP_JNE, LabelOp(cnt));
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'throw', 8);
  PlaceLabel(ctx, cnt);
  par := NodeP(ctx.ast.nodes, cn)^.e1;
  If par <> 0 Then
    BindValue(ctx, par, True);
  If NodeP(ctx.ast.nodes, cn)^.e2 <> 0 Then
    GenStmtList(ctx, NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, cn)^.e2)^.e1);
  PlaceLabel(ctx, lend);
End;

Procedure GenTry(Var ctx: TCompilerContext; n: LongInt);
Var
  base, lcatch, lend, tx, fin: LongInt;
Begin
  fin := NodeP(ctx.ast.nodes, n)^.e3;
  If fin = 0 Then
    Begin
      GenTryCatch(ctx, n);
      Exit;
    End;
  base := AllocHandler(ctx);
  lcatch := NewLabel(ctx);
  lend := NewLabel(ctx);
  HandlerSetup(ctx, base, lcatch);
  TryPush(ctx, base, fin);
  If NodeP(ctx.ast.nodes, n)^.e2 <> 0 Then
    GenTryCatch(ctx, n)
  Else
    GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  Dec(ctx.ir.try_count);
  HandlerPop(ctx, base);
  GenStmt(ctx, fin);
  Emit1(ctx, OP_JMP, LabelOp(lend));
  PlaceLabel(ctx, lcatch);
  tx := TempAcquire(ctx);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 4));
  SaveTemp(ctx, tx);
  GenStmt(ctx, fin);
  PushTemp(ctx, tx);
  CallRt(ctx, 'throw', 8);
  TempRelease(ctx, tx);
  PlaceLabel(ctx, lend);
End;

Procedure GenBreakContinue(Var ctx: TCompilerContext; n: LongInt; is_break: Boolean);
Var
  i: LongInt;
Begin
  i := FindTarget(ctx, NodeP(ctx.ast.nodes, n)^.e1, is_break);
  If i = 0 Then
    Begin
      PendingNote(ctx, n, 'cible de break/continue introuvable');
      Exit;
    End;
  GenExitTries(ctx, i);
  If is_break Then
    Emit1(ctx, OP_JMP, LabelOp(JtP(ctx.ir.jt, i)^.brk))
  Else
    Emit1(ctx, OP_JMP, LabelOp(JtP(ctx.ir.jt, i)^.cont));
End;

Procedure GenLabeled(Var ctx: TCompilerContext; n: LongInt);
Var
  inner, brk: LongInt;
Begin
  inner := NodeP(ctx.ast.nodes, n)^.e1;
  Inc(ctx.ir.plabel_count);
  PlabelP(ctx.ir.plabels, ctx.ir.plabel_count)^ := NodeP(ctx.ast.nodes, n)^.tok;
  If (inner <> 0) And
     ((NodeP(ctx.ast.nodes, inner)^.kind = N_WHILE) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_DO_WHILE) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR_IN) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR_OF) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_SWITCH) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_LABELED)) Then
    GenStmt(ctx, inner)
  Else
    Begin
      { instruction etiquetee quelconque : seul break etiquete est permis }
      brk := NewLabel(ctx);
      PushTarget(ctx, JT_BLOCK, brk, 0);
      GenStmt(ctx, inner);
      PopTarget(ctx);
      PlaceLabel(ctx, brk);
    End;
End;

Procedure GenStmt(Var ctx: TCompilerContext; n: LongInt);
Var
  tx: LongInt;
Begin
  If n = 0 Then
    Exit;
  ctx.ir.cur_line := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line;
  If Not (NodeP(ctx.ast.nodes, n)^.kind In [N_BLOCK, N_EMPTY, N_FUNC_DECL, N_LABELED,
                                            N_BREAK, N_CONTINUE]) Then
    EmitLineMarker(ctx, ctx.ir.cur_line);
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_VAR_DECL:
      GenVarDecl(ctx, n);
    N_EXPR_STMT:
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
    N_CLASS_DECL:
      GenClass(ctx, n);
    N_EMPTY, N_FUNC_DECL:
      ;
    N_DEBUGGER:
      Emit0(ctx, OP_NOP);
    N_BLOCK:
      Begin
        If NodeP(ctx.ast.nodes, n)^.flags <> 1 Then
          GenScopeEnter(ctx, NodeP(ctx.ast.nodes, n)^.scope);
        GenStmtList(ctx, NodeP(ctx.ast.nodes, n)^.e1);
      End;
    N_RETURN:
      Begin
        If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
          GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1)
        Else
          LoadUndefined(ctx);
        If ctx.ir.try_count > 0 Then
          Begin
            tx := TempAcquire(ctx);
            SaveTemp(ctx, tx);
            GenExitTries(ctx, 0);
            LoadTemp(ctx, tx);
            TempRelease(ctx, tx);
          End;
        Emit0(ctx, OP_LEAVE);
        Emit0(ctx, OP_RET);
      End;
    N_THROW:
      Begin
        GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Emit1(ctx, OP_PUSH, RegOp(R_EDX));
        Emit1(ctx, OP_PUSH, RegOp(R_EAX));
        CallRt(ctx, 'throw', 8);
      End;
    N_TRY:
      GenTry(ctx, n);
    N_IF:
      GenIf(ctx, n);
    N_WHILE:
      GenWhile(ctx, n);
    N_DO_WHILE:
      GenDoWhile(ctx, n);
    N_FOR:
      GenFor(ctx, n);
    N_FOR_IN:
      GenForInOf(ctx, n, False);
    N_FOR_OF:
      GenForInOf(ctx, n, True);
    N_SWITCH:
      GenSwitch(ctx, n);
    N_BREAK:
      GenBreakContinue(ctx, n, True);
    N_CONTINUE:
      GenBreakContinue(ctx, n, False);
    N_LABELED:
      GenLabeled(ctx, n);
  Else
    PendingNote(ctx, n, NodeKindName(NodeP(ctx.ast.nodes, n)^.kind));
  End;
End;

Procedure GenStmtList(Var ctx: TCompilerContext; n: LongInt);
Begin
  While n <> 0 Do
    Begin
      GenStmt(ctx, n);
      n := NodeP(ctx.ast.nodes, n)^.next;
    End;
End;

{ ---- Procedures ---- }

{ Symbole de donnees d'une variable du runtime (_JSRT_v_nom). }
Function RtVarSym(Var ctx: TCompilerContext; Const name: TString): LongInt;
Var
  i: LongInt;
Begin
  i := DsymFind(ctx, SymRt('v_' + name));
  If (i <> 0) And (DsymP(ctx.data.syms, i)^.sec <> SEC_DATA) Then
    i := 0;
  RtVarSym := i;
End;

Procedure BeginProc(Var ctx: TCompilerContext; Const name: TString; fs: LongInt);
Var
  xs, ok: LongInt;
Begin
  xs := XSym(ctx, name);
  XsymP(ctx.ir.xsyms, xs)^.defined := True;
  Inc(ctx.ir.proc_count);
  ctx.ir.cg_fs := fs;
  ctx.ir.tmp_free_count := 0;
  ctx.ir.jt_count := 0;
  ctx.ir.try_count := 0;
  ctx.ir.plabel_count := 0;
  ctx.ir.in_chain := False;
  ctx.ir.last_stmt_line := -1;
  Emit1(ctx, OP_PROC, AddrSym(SYMK_X, xs));
  Emit1(ctx, OP_PUSH, RegOp(R_EBP));
  Emit(ctx, OP_MOV, RegOp(R_EBP), RegOp(R_ESP));
  Emit(ctx, OP_SUB, RegOp(R_ESP), ImmOp(0));
  ctx.ir.frame_patch := ctx.ir.count;
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(1)), ImmOp(0));
  If fs <> 1 Then
    Begin
      { depassement de pile : RangeError }
      ok := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_ESP),
           MemSym(SYMK_D, RtVarSym(ctx, 'stack_limit'), 0));
      Emit1(ctx, OP_JAE, LabelOp(ok));
      CallRt(ctx, 'stack_overflow', 0);
      PlaceLabel(ctx, ok);
    End;
End;

Procedure EndProc(Var ctx: TCompilerContext);
Begin
  LoadUndefined(ctx);
  Emit0(ctx, OP_LEAVE);
  Emit0(ctx, OP_RET);
  Emit1(ctx, OP_ENDP, NoOp);
  { taille definitive de la trame }
  InstrP(ctx.ir.instrs, ctx.ir.frame_patch)^.b.disp :=
    RT_VALUE_SIZE * ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots;
  ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.frame_size :=
    RT_VALUE_SIZE * ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots;
End;

{ Charge l'argument i (undefined s'il n'a pas ete fourni). }
Procedure LoadArg(Var ctx: TCompilerContext; i: LongInt);
Var
  have, done: LongInt;
Begin
  have := NewLabel(ctx);
  done := NewLabel(ctx);
  Emit(ctx, OP_CMP, MemReg(R_EBP, RT_FRAME_ARGC), ImmOp(i + 1));
  Emit1(ctx, OP_JAE, LabelOp(have));
  LoadUndefined(ctx);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, have);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS + RT_VALUE_SIZE * i));
  Emit(ctx, OP_MOV, RegOp(R_EDX),
       MemReg(R_EBP, RT_FRAME_ARGS + RT_VALUE_SIZE * i + 4));
  PlaceLabel(ctx, done);
End;

Procedure GenParams(Var ctx: TCompilerContext; fn: LongInt);
Var
  p, i, target: LongInt;
Begin
  p := NodeP(ctx.ast.nodes, fn)^.e1;
  i := 0;
  While p <> 0 Do
    Begin
      target := NodeP(ctx.ast.nodes, p)^.e1;
      If NodeP(ctx.ast.nodes, p)^.flags And PF_REST <> 0 Then
        Begin
          Emit1(ctx, OP_PUSH, ImmOp(i));
          Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
          CallRt(ctx, 'args_rest', 12);
        End
      Else
        Begin
          LoadArg(ctx, i);
          GenDefault(ctx, NodeP(ctx.ast.nodes, p)^.e2);
        End;
      BindValue(ctx, target, True);
      Inc(i);
      p := NodeP(ctx.ast.nodes, p)^.next;
    End;
End;

{ Procedure d'une fonction, d'une methode, d'un initialiseur de champ ou
  d'un bloc statique decrit par le descripteur fd. }
Procedure GenFuncProc(Var ctx: TCompilerContext; fd: LongInt);
Var
  n, sc, sy, body: LongInt;
Begin
  n := FdescP(ctx.data.fdescs, fd)^.node;
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  BeginProc(ctx, FdescP(ctx.data.fdescs, fd)^.code_sym, sc);
  ctx.ir.cur_line := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line;
  EmitLineMarker(ctx, ctx.ir.cur_line);
  If FdescP(ctx.data.fdescs, fd)^.flags And (FDF_GENERATOR Or FDF_ASYNC) <> 0 Then
    Begin
      { generateur / async : l'appel cree la coroutine ; le corps s'execute lors de la
        premiere reprise (drapeau genflag positionne par la coroutine) }
      body := NewLabel(ctx);
      Emit(ctx, OP_CMP, MemSym(SYMK_D, RtVarSym(ctx, 'genflag'), 0), ImmOp(0));
      Emit1(ctx, OP_JNE, LabelOp(body));
      Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS + 4));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      If FdescP(ctx.data.fdescs, fd)^.flags And FDF_GENERATOR <> 0 Then
        Emit1(ctx, OP_PUSH, ImmOp(0))
      Else
        Emit1(ctx, OP_PUSH, ImmOp(1));
      CallRt(ctx, 'gen_new', 24);
      Emit0(ctx, OP_LEAVE);
      Emit0(ctx, OP_RET);
      PlaceLabel(ctx, body);
      Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'genflag'), 0), ImmOp(0));
    End;
  EmitComment(ctx, 'fonction ' + StrText(ctx, FdescP(ctx.data.fdescs, fd)^.name_str) +
              ' (' + SymFdesc(fd) + ')');
  If (NodeP(ctx.ast.nodes, n)^.kind = N_METHOD) And
     ((ScopeP(ctx.sem.scopes, sc)^.fkind = FK_CTOR) Or
      (ScopeP(ctx.sem.scopes, sc)^.fkind = FK_DERIVED_CTOR)) Then
    Begin
      { un constructeur de classe exige new }
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'class_call_check', 4);
    End;
  GenScopeEnter(ctx, sc);
  { nom d'une expression de fonction : la closure elle-meme }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_FNAME Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_ARGS Then
        Begin
          Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
          CallRt(ctx, 'make_arguments', 8);
          StoreSym(ctx, sy, True);
        End
      Else If SymP(ctx.sem.syms, sy)^.kind = DK_NEWTARGET Then
        Begin
          { new.target de cette invocation : lu puis efface, pour que les appels
            ordinaires faits depuis le corps ne le voient pas }
          CallRt(ctx, 'nt_take', 0);
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_FUNC_DECL, N_FUNC_EXPR, N_METHOD:
      Begin
        GenParams(ctx, n);
        If (NodeP(ctx.ast.nodes, n)^.kind = N_METHOD) And
           (ScopeP(ctx.sem.scopes, sc)^.fkind = FK_CTOR) Then
          Begin
            { constructeur de base : champs d'instance avant le corps }
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS + 4));
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS));
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
            CallRt(ctx, 'init_fields', 12);
          End;
        body := NodeP(ctx.ast.nodes, n)^.e2;
        If (NodeP(ctx.ast.nodes, n)^.kind = N_FUNC_EXPR) And
           (NodeP(ctx.ast.nodes, n)^.flags And FN_EXPR_BODY <> 0) Then
          Begin
            { corps expression d'une fleche : sa valeur est le resultat }
            GenExpr(ctx, body);
            Emit0(ctx, OP_LEAVE);
            Emit0(ctx, OP_RET);
          End
        Else
          GenStmtList(ctx, NodeP(ctx.ast.nodes, body)^.e1);
      End;
    N_FIELD:
      Begin
        GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Emit0(ctx, OP_LEAVE);
        Emit0(ctx, OP_RET);
      End;
    N_STATIC_BLOCK:
      GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  End;
  EndProc(ctx);
End;

Procedure EmitRuntime(Var ctx: TCompilerContext); Forward;

Function BuildIR(Var ctx: TCompilerContext): Boolean;
Var
  i: LongInt;
Begin
  BuildIR := False;
  If Not ctx.data.built Then
    Begin
      PipelineError(ctx, 'pool de donnees absent avant la generation du code');
      Exit;
    End;
  ctx.ir.count := 0;
  ctx.ir.xsym_count := 0;
  DlClear(ctx.ir.xhash);
  ctx.ir.comment_count := 0;
  ctx.ir.label_count := 0;
  ctx.ir.proc_count := 0;
  ctx.ir.pending_count := 0;
  ctx.ir.failed := False;
  ctx.ir.cur_line := 1;
  LayoutFrames(ctx);

  { programme principal : portee globale }
  BeginProc(ctx, SymRt('main'), 1);
  EmitLineMarker(ctx, 1);
  EmitComment(ctx, 'programme principal');
  GenScopeEnter(ctx, 1);
  CallRt(ctx, 'prelude_init', 0);
  GenStmtList(ctx, NodeP(ctx.ast.nodes, ctx.ast.root)^.e1);
  CallRt(ctx, 'prelude_run', 0);
  EndProc(ctx);

  For i := 1 To ctx.data.fd_count Do
    If Not ctx.ir.failed Then
      GenFuncProc(ctx, i);

  If Not ctx.ir.failed Then
    EmitRuntime(ctx);
  ctx.ir.built := Not ctx.ir.failed;
  If ctx.options.verbose Then
    Writeln('Code   : ', ctx.ir.proc_count, ' procedures, ', ctx.ir.count,
            ' instructions, ', ctx.ir.pending_count,
            ' constructions en attente');
  BuildIR := ctx.ir.built And (ctx.errors = 0);
End;

