    '    if (isP(''('')) { p++; r = expr(); expect('')''); return r; }',
    '    if (isP(''['')) {',
    '      p++; a = [];',
    '      while (!isP('']'')) { a.push(assign()); if (isP('','')) p++; else break; }',
    '      expect('']'');',
    '      return [''arr'', a];',
    '    }',
    '    if (isP(''{'')) {',
    '      p++; a = [];',
    '      while (!isP(''}'')) {',
    '        k = toks[p]; p++;',
    '        if (isP('':'')) { p++; a.push([k.v, assign()]); } else a.push([k.v, [''id'', k.v]]);',
    '        if (isP('','')) p++; else break;',
    '      }',
    '      expect(''}'');',
    '      return [''obj'', a];',
    '    }',
    '    throw new SyntaxError("Unexpected token ''" + t.v + "''");',
    '  }',
    '  function postfix() {',
    '    var e = primary(), a;',
    '    for (;;) {',
    '      if (isP(''.'') || isP(''?.'')) {',
    '        var opt = isP(''?.'');',
    '        p++;',
    '        if (opt && isP(''('')) { e = [''call'', e, args(), true]; continue; }',
    '        if (opt && isP(''['')) { p++; var ix = expr(); expect('']''); e = [''mem'', e, ix, true]; continue; }',
    '        e = [''mem'', e, [''v'', toks[p].v], opt]; p++;',
    '      } else if (isP(''['')) { p++; var ix2 = expr(); expect('']''); e = [''mem'', e, ix2, false]; }',
    '      else if (isP(''('')) e = [''call'', e, args(), false];',
    '      else break;',
    '    }',
    '    return e;',
    '  }',
    '  function args() {',
    '    expect(''('');',
    '    var a = [];',
    '    while (!isP('')'')) { a.push(assign()); if (isP('','')) p++; else break; }',
    '    expect('')'');',
    '    return a;',
    '  }',
    '  function unary() {',
    '    var t = toks[p];',
    '    if (t.k === ''p'' && (t.v === ''-'' || t.v === ''+'' || t.v === ''!'' || t.v === ''~'')) { p++; return [''un'', t.v, unary()]; }',
    '    if (t.k === ''i'' && (t.v === ''typeof'' || t.v === ''void'')) { p++; return [''un'', t.v, unary()]; }',
    '    return postfix();',
    '  }',
    '  function binary(minp) {',
    '    var l = unary(), t, pr, r;',
    '    for (;;) {',
    '      t = toks[p];',
    '      if (!((t.k === ''p'' || (t.k === ''i'' && (t.v === ''in'' || t.v === ''instanceof''))) && prec[t.v] !== undefined)) break;',
    '      pr = prec[t.v];',
    '      if (pr < minp) break;',
    '      p++;',
    '      r = t.v === ''**'' ? binary(pr) : binary(pr + 1);',
    '      l = [(t.v === ''&&'' || t.v === ''||'' || t.v === ''??'') ? ''lg'' : ''bin'', t.v, l, r];',
    '    }',
    '    return l;',
    '  }',
    '  function assign() {',
    '    var c = binary(1), a, b;',
    '    if (isP(''?'')) { p++; a = assign(); expect('':''); b = assign(); return [''cond'', c, a, b]; }',
    '    return c;',
    '  }',
    '  function expr() {',
    '    var e = assign();',
    '    while (isP('','')) { p++; e = [''seq'', e, assign()]; }',
    '    return e;',
    '  }',
    '  var list = [];',
    '  while (peek().k !== ''e'') {',
    '    if (isP('';'')) { p++; continue; }',
    '    list.push(expr());',
    '    if (peek().k !== ''e'' && !isP('';'')) throw new SyntaxError("Unexpected token ''" + peek().v + "''");',
    '  }',
    '  return list;',
    '}',
    'function __evrun(n, env) {',
    '  var t = n[0], a, b, i, o, f, args, c;',
    '  if (t === ''v'') return n[1];',
    '  if (t === ''id'') {',
    '    if (n[1] === ''undefined'') return undefined;',
    '    if (n[1] === ''NaN'') return NaN;',
    '    if (n[1] === ''Infinity'') return Infinity;',
    '    if (env[n[1]] !== undefined) return env[n[1]]();',
    '    throw new ReferenceError(n[1] + '' is not defined'');',
    '  }',
    '  if (t === ''arr'') { a = []; for (i = 0; i < n[1].length; i++) a.push(__evrun(n[1][i], env)); return a; }',
    '  if (t === ''obj'') { o = {}; for (i = 0; i < n[1].length; i++) o[n[1][i][0]] = __evrun(n[1][i][1], env); return o; }',
    '  if (t === ''cond'') return __evrun(n[1], env) ? __evrun(n[2], env) : __evrun(n[3], env);',
    '  if (t === ''seq'') { __evrun(n[1], env); return __evrun(n[2], env); }',
    '  if (t === ''un'') {',
    '    if (n[1] === ''typeof'' && n[2][0] === ''id'' && env[n[2][1]] === undefined && n[2][1] !== ''undefined'') return ''undefined'';',
    '    a = __evrun(n[2], env);',
    '    switch (n[1]) {',
    '      case ''-'': return -a;',
    '      case ''+'': return +a;',
    '      case ''!'': return !a;',
    '      case ''~'': return ~a;',
    '      case ''typeof'': return typeof a;',
    '      default: return undefined;',
    '    }',
    '  }',
    '  if (t === ''lg'') {',
    '    a = __evrun(n[2], env);',
    '    if (n[1] === ''&&'') return a ? __evrun(n[3], env) : a;',
    '    if (n[1] === ''||'') return a ? a : __evrun(n[3], env);',
    '    return (a === null || a === undefined) ? __evrun(n[3], env) : a;',
    '  }',
    '  if (t === ''bin'') {',
    '    a = __evrun(n[2], env);',
    '    b = __evrun(n[3], env);',
    '    switch (n[1]) {',
    '      case ''+'': return a + b;',
    '      case ''-'': return a - b;',
    '      case ''*'': return a * b;',
    '      case ''/'': return a / b;',
    '      case ''%'': return a % b;',
    '      case ''**'': return a ** b;',
    '      case ''=='': return a == b;',
    '      case ''!='': return a != b;',
    '      case ''==='': return a === b;',
    '      case ''!=='': return a !== b;',
    '      case ''<'': return a < b;',
    '      case ''>'': return a > b;',
    '      case ''<='': return a <= b;',
    '      case ''>='': return a >= b;',
    '      case ''&'': return a & b;',
    '      case ''|'': return a | b;',
    '      case ''^'': return a ^ b;',
    '      case ''<<'': return a << b;',
    '      case ''>>'': return a >> b;',
    '      case ''>>>'': return a >>> b;',
    '      case ''in'': return a in b;',
    '      default: return a instanceof b;',
    '    }',
    '  }',
    '  if (t === ''mem'') {',
    '    o = __evrun(n[1], env);',
    '    if (n[3] && (o === null || o === undefined)) return undefined;',
    '    return o[__evrun(n[2], env)];',
    '  }',
    '  if (t === ''call'') {',
    '    args = [];',
    '    for (i = 0; i < n[2].length; i++) args.push(__evrun(n[2][i], env));',
    '    if (n[1][0] === ''mem'') {',
    '      o = __evrun(n[1][1], env);',
    '      if (n[1][3] && (o === null || o === undefined)) return undefined;',
    '      f = o[__evrun(n[1][2], env)];',
    '      if (n[3] && (f === null || f === undefined)) return undefined;',
    '      return f.apply(o, args);',
    '    }',
    '    f = __evrun(n[1], env);',
    '    if (n[3] && (f === null || f === undefined)) return undefined;',
    '    return f.apply(undefined, args);',
    '  }',
    '  throw new SyntaxError(''eval: unsupported expression'');',
    '}',
    'function __eval(x) {',
    '  if (typeof x !== ''string'') return x;',
    '  var env = {',
    '    Math: function () { return Math; }, JSON: function () { return JSON; }, Number: function () { return Number; },',
    '    String: function () { return String; }, Array: function () { return Array; }, Object: function () { return Object; },',
    '    Boolean: function () { return Boolean; }, parseInt: function () { return parseInt; }, parseFloat: function () { return parseFloat; },',
    '    isNaN: function () { return isNaN; }, isFinite: function () { return isFinite; }, Date: function () { return __Date; },',
    '    Map: function () { return __Map; }, Set: function () { return __Set; }, BigInt: function () { return __BigInt; }',
    '  };',
    '  var list = __evparse(__evtok(x)), r, i;',
    '  for (i = 0; i < list.length; i++) r = __evrun(list[i], env);',
    '  return r;',
    '}'
  );
{ PRELUDE-END }

{ Ajoute a la fin du source le prelude JS (formateur de console). Les lignes du
  programme gardent leur numero : le prelude est place apres. }
Function AppendPrelude(Var ctx: TCompilerContext): Boolean;
Var
  i, j, line_len: LongInt;
  ok: Boolean;

  Procedure Put(c: Char);
  Begin
    If Not ok Then
      Exit;
    SrcCharP(ctx.source.buf, ctx.source.char_count)^ := c;
    Inc(ctx.source.char_count);
    If c = #10 Then
      Begin
        line_len := ctx.source.char_count - 1 -
                    LineStartP(ctx.source.line_start, ctx.source.line_count)^;
        If line_len > ctx.source.max_line_len Then
          ctx.source.max_line_len := line_len;
        Inc(ctx.source.line_count);
        LineStartP(ctx.source.line_start, ctx.source.line_count)^ := ctx.source.char_count;
      End;
  End;

Begin
  ok := True;
  Put(#10);
  For i := 1 To PRELUDE_LINES Do
    Begin
      For j := 1 To Length(PreludeText[i]) Do
        Put(PreludeText[i][j]);
      Put(#10);
    End;
  AppendPrelude := ok;
End;

Function LoadSource(Var ctx: TCompilerContext): Boolean;
Var
  f: File;
  chunk: Array[0..4095] Of Char;
  got: Word;
  i, first_i, io: Integer;
  c: Char;
  first, prev_cr, skip, failed: Boolean;
  line_len: LongInt;
Begin
  LoadSource := False;
  ctx.source.loaded := False;
  ctx.source.char_count := 0;
  ctx.source.line_count := 1;
  LineStartP(ctx.source.line_start, 1)^ := 0;
  ctx.source.max_line_len := 0;

  Assign(f, NormalizePath(ctx.source_name));
  FileMode := 0;
  Reset(f, 1);
  io := IOResult;
  If io <> 0 Then
    Begin
      PipelineError(ctx, 'impossible d''ouvrir le fichier source: ' +
                         ctx.source_name);
      Exit;
    End;

  first := True;
  prev_cr := False;
  failed := False;
  Repeat
    BlockRead(f, chunk, SizeOf(chunk), got);
    io := IOResult;
    If io <> 0 Then
      Begin
        PipelineError(ctx, 'erreur de lecture du fichier source');
        failed := True;
      End
    Else If got > 0 Then
      Begin
        first_i := 0;
        If first Then
          Begin
            first := False;
            If (got >= 3) And (chunk[0] = #$EF) And (chunk[1] = #$BB) And
               (chunk[2] = #$BF) Then
              first_i := 3
            Else If (got >= 2) And (((chunk[0] = #$FF) And (chunk[1] = #$FE)) Or
                    ((chunk[0] = #$FE) And (chunk[1] = #$FF))) Then
              Begin
                PipelineError(ctx, 'encodage UTF-16 non supporte (UTF-8 attendu): ' +
                                   ctx.source_name);
                failed := True;
              End;
          End;
        i := first_i;
        While (i < got) And Not failed Do
          Begin
            c := chunk[i];
            skip := False;
            If c = #13 Then
              Begin
                c := #10;
                prev_cr := True;
              End
            Else
              Begin
                If (c = #10) And prev_cr Then
                  skip := True;
                prev_cr := False;
              End;
            If Not skip Then
              Begin
                Begin
                    SrcCharP(ctx.source.buf, ctx.source.char_count)^ := c;
                    Inc(ctx.source.char_count);
                    If c = #10 Then
                      Begin
                        line_len := ctx.source.char_count - 1 -
                                    LineStartP(ctx.source.line_start, ctx.source.line_count)^;
                        If line_len > ctx.source.max_line_len Then
                          ctx.source.max_line_len := line_len;
                        Inc(ctx.source.line_count);
                        LineStartP(ctx.source.line_start, ctx.source.line_count)^ :=
                          ctx.source.char_count;
                      End;
                  End;
              End;
            Inc(i);
          End;
      End;
  Until (got = 0) Or failed;

  Close(f);
  io := IOResult;
  If failed Then
    Exit;
  ctx.source.user_lines := ctx.source.line_count;
  If Not (ctx.options.dump_tokens Or ctx.options.dump_ast Or ctx.options.dump_scopes) Then
    If Not AppendPrelude(ctx) Then
      Exit;

  line_len := ctx.source.char_count -
              LineStartP(ctx.source.line_start, ctx.source.line_count)^;
  If line_len > ctx.source.max_line_len Then
    ctx.source.max_line_len := line_len;
  LineStartP(ctx.source.line_start, ctx.source.line_count + 1)^ := ctx.source.char_count + 1;
  ctx.source.loaded := True;
  If ctx.options.verbose Then
    Writeln('Source chargee: ', ctx.source.line_count, ' lignes, ',
            ctx.source.char_count, ' octets, ligne max ',
            ctx.source.max_line_len);
  LoadSource := True;
End;

{ ---- Primitives du lexer ---- }

Function LxCur(Var ctx: TCompilerContext): Char;
Begin
  If ctx.lex.pos < ctx.source.char_count Then
    LxCur := SrcCharP(ctx.source.buf, ctx.lex.pos)^
  Else
    LxCur := #0;
End;

Function LxPeek(Var ctx: TCompilerContext; n: LongInt): Char;
Begin
  If ctx.lex.pos + n < ctx.source.char_count Then
    LxPeek := SrcCharP(ctx.source.buf, ctx.lex.pos + n)^
  Else
    LxPeek := #0;
End;

Function LxAtEnd(Var ctx: TCompilerContext): Boolean;
Begin
  LxAtEnd := ctx.lex.pos >= ctx.source.char_count;
End;

Function LxCol(Var ctx: TCompilerContext): LongInt;
Begin
  LxCol := ctx.lex.pos - ctx.lex.line_pos + 1;
End;

Procedure LxAdvance(Var ctx: TCompilerContext);
Begin
  If ctx.lex.pos < ctx.source.char_count Then
    Begin
      If SrcCharP(ctx.source.buf, ctx.lex.pos)^ = #10 Then
        Begin
          Inc(ctx.lex.line);
          ctx.lex.line_pos := ctx.lex.pos + 1;
        End;
      Inc(ctx.lex.pos);
    End;
End;

Procedure LxAdvanceN(Var ctx: TCompilerContext; n: LongInt);
Var
  i: LongInt;
Begin
  For i := 1 To n Do
    LxAdvance(ctx);
End;

Function RawText(Var ctx: TCompilerContext; tp, rl: LongInt): TTokenText;
Var
  t: TTokenText;
  k, i: LongInt;
Begin
  k := rl;
  If k > MAX_TOKEN_TEXT Then
    k := MAX_TOKEN_TEXT;
  t[0] := Chr(k);
  For i := 1 To k Do
    t[i] := SrcCharP(ctx.source.buf, tp + i - 1)^;
  RawText := t;
End;

{ Cree un jeton couvrant le source de tp jusqu'a la position courante. }
Function AddToken(Var ctx: TCompilerContext; kind: TTokenKind;
                  tl, tc, tp: LongInt): LongInt;
Var
  n: LongInt;
Begin
  Inc(ctx.lex.token_count);
  n := ctx.lex.token_count;
  TokP(ctx.lex.tokens, n)^.kind := kind;
  TokP(ctx.lex.tokens, n)^.tpl := TP_NONE;
  TokP(ctx.lex.tokens, n)^.text := RawText(ctx, tp, ctx.lex.pos - tp);
  TokP(ctx.lex.tokens, n)^.line := tl;
  TokP(ctx.lex.tokens, n)^.col := tc;
  TokP(ctx.lex.tokens, n)^.pos := tp;
  TokP(ctx.lex.tokens, n)^.len := ctx.lex.pos - tp;
  TokP(ctx.lex.tokens, n)^.sval_off := 0;
  TokP(ctx.lex.tokens, n)^.sval_len := 0;
  TokP(ctx.lex.tokens, n)^.flag_len := 0;
  TokP(ctx.lex.tokens, n)^.num_val := 0;
  TokP(ctx.lex.tokens, n)^.nl_before := ctx.lex.nl_pending;
  ctx.lex.nl_pending := False;
  Case kind Of
    TK_IDENT:    Inc(ctx.lex.ident_count);
    TK_KEYWORD:  Inc(ctx.lex.keyword_count);
    TK_NUMBER:   Inc(ctx.lex.number_count);
    TK_STRING:   Inc(ctx.lex.string_count);
    TK_TEMPLATE: Inc(ctx.lex.template_count);
    TK_REGEX:    Inc(ctx.lex.regex_count);
    TK_OPERATOR: Inc(ctx.lex.operator_count);
    TK_PUNCT:    Inc(ctx.lex.punct_count);
  End;
  AddToken := n;
End;

Procedure PoolAppend(Var ctx: TCompilerContext; c: Char);
Begin
  PoolP(ctx.lex.pool, ctx.lex.pool_len)^ := c;
  Inc(ctx.lex.pool_len);
End;

{ Ajoute un point de code Unicode encode en UTF-8. }
Procedure PoolAppendCP(Var ctx: TCompilerContext; cp: LongInt);
Begin
  If cp < $80 Then
    PoolAppend(ctx, Chr(cp))
  Else If cp < $800 Then
    Begin
      PoolAppend(ctx, Chr($C0 Or (cp Shr 6)));
      PoolAppend(ctx, Chr($80 Or (cp And $3F)));
    End
  Else If cp < $10000 Then
    Begin
      PoolAppend(ctx, Chr($E0 Or (cp Shr 12)));
      PoolAppend(ctx, Chr($80 Or ((cp Shr 6) And $3F)));
      PoolAppend(ctx, Chr($80 Or (cp And $3F)));
    End
  Else
    Begin
      PoolAppend(ctx, Chr($F0 Or (cp Shr 18)));
      PoolAppend(ctx, Chr($80 Or ((cp Shr 12) And $3F)));
      PoolAppend(ctx, Chr($80 Or ((cp Shr 6) And $3F)));
      PoolAppend(ctx, Chr($80 Or (cp And $3F)));
    End;
End;

{ Valeur de n chiffres hexadecimaux situes a pos+ofs, ou -1. }
Function LxHexAt(Var ctx: TCompilerContext; ofs, n: LongInt): LongInt;
Var
  i, v: LongInt;
Begin
  v := 0;
  For i := 0 To n - 1 Do
    Begin
      If Not IsHexDigit(LxPeek(ctx, ofs + i)) Then
        Begin
          LxHexAt := -1;
          Exit;
        End;
      v := v * 16 + HexVal(LxPeek(ctx, ofs + i));
    End;
  LxHexAt := v;
End;

{ ---- Echappements des chaines et des gabarits ---- }

Procedure LxEscape(Var ctx: TCompilerContext; in_template: Boolean);
Var
  tl, tc, v, hv, lo, p, n, maxd: LongInt;
  c: Char;
  bad: Boolean;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  LxAdvance(ctx);
  If LxAtEnd(ctx) Then
    Begin
      SourceErrorAt(ctx, tl, tc, 'sequence d''echappement incomplete');
      Exit;
    End;
  c := LxCur(ctx);
  Case c Of
    'n': Begin PoolAppend(ctx, #10); LxAdvance(ctx); End;
    't': Begin PoolAppend(ctx, #9);  LxAdvance(ctx); End;
    'r': Begin PoolAppend(ctx, #13); LxAdvance(ctx); End;
    'b': Begin PoolAppend(ctx, #8);  LxAdvance(ctx); End;
    'f': Begin PoolAppend(ctx, #12); LxAdvance(ctx); End;
    'v': Begin PoolAppend(ctx, #11); LxAdvance(ctx); End;
    #10: LxAdvance(ctx);
    '0'..'7':
      Begin
        If (c = '0') And Not IsDigit(LxPeek(ctx, 1)) Then
          Begin
            PoolAppend(ctx, #0);
            LxAdvance(ctx);
          End
        Else If in_template Then
          Begin
            SourceErrorAt(ctx, tl, tc,
              'sequence octale interdite dans un gabarit');
            LxAdvance(ctx);
          End
        Else
          Begin
            maxd := 2;
            If c <= '3' Then
              maxd := 3;
            n := 0;
            v := 0;
            While (n < maxd) And (LxCur(ctx) >= '0') And (LxCur(ctx) <= '7') Do
              Begin
                v := v * 8 + (Ord(LxCur(ctx)) - Ord('0'));
                LxAdvance(ctx);
                Inc(n);
              End;
            PoolAppendCP(ctx, v);
          End;
      End;
    'x':
      Begin
        hv := LxHexAt(ctx, 1, 2);
        If hv < 0 Then
          Begin
            SourceErrorAt(ctx, tl, tc, 'sequence \x invalide (2 chiffres hexa)');
            LxAdvance(ctx);
          End
        Else
          Begin
            LxAdvanceN(ctx, 3);
            PoolAppendCP(ctx, hv);
          End;
      End;
    'u':
      Begin
        If LxPeek(ctx, 1) = '{' Then
          Begin
            p := 2;
            n := 0;
            v := 0;
            bad := False;
            While IsHexDigit(LxPeek(ctx, p)) Do
              Begin
                If v > $10FFFF Then
                  bad := True
                Else
                  v := v * 16 + HexVal(LxPeek(ctx, p));
                Inc(n);
                Inc(p);
              End;
            If (n = 0) Or (LxPeek(ctx, p) <> '}') Or bad Or (v > $10FFFF) Then
              Begin
                SourceErrorAt(ctx, tl, tc, 'sequence \u{...} invalide');
                LxAdvance(ctx);
              End
            Else
              Begin
                LxAdvanceN(ctx, p + 1);
                PoolAppendCP(ctx, v);
              End;
          End
        Else
          Begin
            hv := LxHexAt(ctx, 1, 4);
            If hv < 0 Then
              Begin
                SourceErrorAt(ctx, tl, tc,
                  'sequence \u invalide (4 chiffres hexa)');
                LxAdvance(ctx);
              End
            Else
              Begin
                LxAdvanceN(ctx, 5);
                If (hv >= $D800) And (hv <= $DBFF) And (LxCur(ctx) = '\') And
                   (LxPeek(ctx, 1) = 'u') Then
                  Begin
                    lo := LxHexAt(ctx, 2, 4);
                    If (lo >= $DC00) And (lo <= $DFFF) Then
                      Begin
                        LxAdvanceN(ctx, 6);
                        hv := $10000 + ((hv - $D800) Shl 10) + (lo - $DC00);
                      End;
                  End;
                PoolAppendCP(ctx, hv);
              End;
          End;
      End;
  Else
    Begin
      PoolAppend(ctx, c);
      LxAdvance(ctx);
    End;
  End;
End;

{ ---- Identifiants et mots-cles ---- }

Procedure LxIdent(Var ctx: TCompilerContext);
Var
  tl, tc, tp, idx: LongInt;
  kind: TTokenKind;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  { #nom : membre prive, traite comme un nom de propriete cache }
  If LxCur(ctx) = '#' Then
    LxAdvance(ctx);
  While IsIdentPart(LxCur(ctx)) Do
    LxAdvance(ctx);
  If ctx.lex.pos - tp > MAX_TOKEN_TEXT Then
    SourceErrorAt(ctx, tl, tc, 'identifiant trop long (80 octets maximum)');
  If IsKeyword(RawText(ctx, tp, ctx.lex.pos - tp)) Then
    kind := TK_KEYWORD
  Else
    kind := TK_IDENT;
  idx := AddToken(ctx, kind, tl, tc, tp);
End;

{ ---- Nombres ---- }

Procedure LxNumber(Var ctx: TCompilerContext);
Var
  tl, tc, tp, idx, digits, base: LongInt;
  c, c2: Char;
  v: Double;
  ip, fp, ep: TString;
  esign: Char;
  txt: TString;
  code: Integer;
  has_dot, has_exp, bad_sep, last_us, octal_ok: Boolean;
  i: Integer;
  bg_off, bg_i: LongInt;

  { Lit des chiffres decimaux avec separateurs _ ; s recoit les chiffres. }
  Procedure ReadDigits(Var s: TString);
  Begin
    While IsDigit(LxCur(ctx)) Or (LxCur(ctx) = '_') Do
      Begin
        If LxCur(ctx) = '_' Then
          Begin
            If (Length(s) = 0) Or Not IsDigit(LxPeek(ctx, 1)) Then
              bad_sep := True;
          End
        Else If Length(s) < 250 Then
          s := s + LxCur(ctx);
        LxAdvance(ctx);
      End;
  End;

Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  c := LxCur(ctx);
  c2 := UpCase(LxPeek(ctx, 1));
  v := 0;
  bad_sep := False;
  has_dot := False;
  has_exp := False;
  If (c = '0') And ((c2 = 'X') Or (c2 = 'B') Or (c2 = 'O')) Then
    Begin
      If c2 = 'X' Then
        base := 16
      Else If c2 = 'B' Then
        base := 2
      Else
        base := 8;
      LxAdvanceN(ctx, 2);
      digits := 0;
      last_us := False;
      While True Do
        Begin
          c := LxCur(ctx);
          If c = '_' Then
            Begin
              If (digits = 0) Or last_us Then
                bad_sep := True;
              last_us := True;
              LxAdvance(ctx);
            End
          Else If IsHexDigit(c) And (HexVal(c) < base) Then
            Begin
              v := v * base + HexVal(c);
              Inc(digits);
              last_us := False;
              LxAdvance(ctx);
            End
          Else
            Break;
        End;
      If digits = 0 Then
        SourceErrorAt(ctx, tl, tc, 'chiffres attendus apres le prefixe numerique')
      Else If IsDigit(LxCur(ctx)) Then
        Begin
          SourceErrorAt(ctx, tl, LxCol(ctx), 'chiffre invalide pour cette base');
          While IsDigit(LxCur(ctx)) Do
            LxAdvance(ctx);
        End
      Else If bad_sep Or last_us Then
        SourceErrorAt(ctx, tl, tc, 'separateur numerique "_" mal place');
    End
  Else
    Begin
      ip := '';
      fp := '';
      ep := '';
      esign := '+';
      has_dot := False;
      has_exp := False;
      If c <> '.' Then
        ReadDigits(ip);
      If LxCur(ctx) = '.' Then
        Begin
          has_dot := True;
          LxAdvance(ctx);
          ReadDigits(fp);
        End;
      If UpCase(LxCur(ctx)) = 'E' Then
        If IsDigit(LxPeek(ctx, 1)) Or
           (((LxPeek(ctx, 1) = '+') Or (LxPeek(ctx, 1) = '-')) And
            IsDigit(LxPeek(ctx, 2))) Then
          Begin
            has_exp := True;
            LxAdvance(ctx);
            If (LxCur(ctx) = '+') Or (LxCur(ctx) = '-') Then
              Begin
                esign := LxCur(ctx);
                LxAdvance(ctx);
              End;
            ReadDigits(ep);
          End;
      If bad_sep Then
        SourceErrorAt(ctx, tl, tc, 'separateur numerique "_" mal place');
      { Ancien octal : 0 suivi uniquement de chiffres 0 a 7. }
      octal_ok := (Not has_dot) And (Not has_exp) And (Length(ip) > 1) And
                  (ip[1] = '0');
      If octal_ok Then
        For i := 2 To Length(ip) Do
          If ip[i] > '7' Then
            octal_ok := False;
      If octal_ok Then
        Begin
          For i := 2 To Length(ip) Do
            v := v * 8 + (Ord(ip[i]) - Ord('0'));
        End
      Else
        Begin
          If ip = '' Then
            ip := '0';
          If fp = '' Then
            fp := '0';
          txt := ip + '.' + fp;
          If has_exp Then
            txt := txt + 'e' + esign + ep;
          Val(txt, v, code);
          If code <> 0 Then
            Begin
              SourceErrorAt(ctx, tl, tc, 'nombre invalide');
              v := 0;
            End;
        End;
    End;
  If (LxCur(ctx) = 'n') And (Not has_dot) And (Not has_exp) And
     Not IsIdentPart(LxPeek(ctx, 1)) Then
    Begin
      { litteral BigInt : jeton chaine (chiffres) marque flag_len = 1 }
      bg_off := ctx.lex.pool_len;
      bg_i := tp;
      While bg_i < ctx.lex.pos Do
        Begin
          If SrcCharP(ctx.source.buf, bg_i)^ <> '_' Then
            PoolAppend(ctx, SrcCharP(ctx.source.buf, bg_i)^);
          Inc(bg_i);
        End;
      LxAdvance(ctx);
      idx := AddToken(ctx, TK_STRING, tl, tc, tp);
      TokP(ctx.lex.tokens, idx)^.sval_off := bg_off;
      TokP(ctx.lex.tokens, idx)^.sval_len := ctx.lex.pool_len - bg_off;
      TokP(ctx.lex.tokens, idx)^.flag_len := 1;
      Exit;
    End;
  If IsIdentStart(LxCur(ctx)) Or IsDigit(LxCur(ctx)) Then
    Begin
      SourceErrorAt(ctx, tl, LxCol(ctx), 'caractere invalide apres un nombre');
      While IsIdentPart(LxCur(ctx)) Do
        LxAdvance(ctx);
    End;
  idx := AddToken(ctx, TK_NUMBER, tl, tc, tp);
  TokP(ctx.lex.tokens, idx)^.num_val := v;
End;

{ ---- Chaines ---- }

Procedure LxString(Var ctx: TCompilerContext; quote: Char);
Var
  tl, tc, tp, idx, off: LongInt;
  c: Char;
  closed: Boolean;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  LxAdvance(ctx);
  off := ctx.lex.pool_len;
  closed := False;
  While Not closed Do
    Begin
      If LxAtEnd(ctx) Or (LxCur(ctx) = #10) Then
        Begin
          SourceErrorAt(ctx, tl, tc, 'chaine non terminee');
          Break;
        End;
      c := LxCur(ctx);
      If c = quote Then
        Begin
          LxAdvance(ctx);
          closed := True;
        End
      Else If c = '\' Then
        LxEscape(ctx, False)
      Else
        Begin
          PoolAppend(ctx, c);
          LxAdvance(ctx);
        End;
    End;
  idx := AddToken(ctx, TK_STRING, tl, tc, tp);
  TokP(ctx.lex.tokens, idx)^.sval_off := off;
  TokP(ctx.lex.tokens, idx)^.sval_len := ctx.lex.pool_len - off;
End;

{ ---- Gabarits `...` ---- }

Procedure LxTemplate(Var ctx: TCompilerContext; resume: Boolean);
Var
  tl, tc, tp, idx, off: LongInt;
  part: TTemplatePart;
  done: Boolean;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  If resume Then
    Dec(ctx.lex.tpl_top);
  LxAdvance(ctx);
  off := ctx.lex.pool_len;
  done := False;
  If resume Then
    part := TP_TAIL
  Else
    part := TP_NOSUB;
  While Not done Do
    Begin
      If LxAtEnd(ctx) Then
        Begin
          SourceErrorAt(ctx, tl, tc, 'gabarit non termine');
          Break;
        End;
      If LxCur(ctx) = '`' Then
        Begin
          LxAdvance(ctx);
          done := True;
        End
      Else If (LxCur(ctx) = '$') And (LxPeek(ctx, 1) = '{') Then
        Begin
          LxAdvanceN(ctx, 2);
          If resume Then
            part := TP_MIDDLE
          Else
            part := TP_HEAD;
          Inc(ctx.lex.tpl_top);
          TplStackP(ctx.lex.tpl_stack, ctx.lex.tpl_top)^ := ctx.lex.brace_depth;
          done := True;
        End
      Else If LxCur(ctx) = '\' Then
        LxEscape(ctx, True)
      Else
        Begin
          PoolAppend(ctx, LxCur(ctx));
          LxAdvance(ctx);
        End;
    End;
  idx := AddToken(ctx, TK_TEMPLATE, tl, tc, tp);
  TokP(ctx.lex.tokens, idx)^.tpl := part;
  TokP(ctx.lex.tokens, idx)^.sval_off := off;
  TokP(ctx.lex.tokens, idx)^.sval_len := ctx.lex.pool_len - off;
End;

{ ---- Expressions regulieres ---- }

{ Vrai si un / a cette position commence une RegExp (sinon division). }
Function RegexAllowed(Var ctx: TCompilerContext): Boolean;
Var
  t: TToken;
Begin
  If ctx.lex.token_count = 0 Then
    Begin
      RegexAllowed := True;
      Exit;
    End;
  t := TokP(ctx.lex.tokens, ctx.lex.token_count)^;
  Case t.kind Of
    TK_NUMBER, TK_STRING, TK_REGEX, TK_IDENT:
      RegexAllowed := False;
    TK_TEMPLATE:
      RegexAllowed := (t.tpl = TP_HEAD) Or (t.tpl = TP_MIDDLE);
    TK_KEYWORD:
      RegexAllowed := Not ((t.text = 'this') Or (t.text = 'super') Or
                           (t.text = 'null') Or (t.text = 'true') Or
                           (t.text = 'false'));
    TK_OPERATOR, TK_PUNCT:
      RegexAllowed := Not ((t.text = ')') Or (t.text = ']') Or
                           (t.text = '}') Or (t.text = '++') Or
                           (t.text = '--'));
  Else
    RegexAllowed := True;
  End;
End;

Procedure LxRegex(Var ctx: TCompilerContext);
Var
  tl, tc, tp, idx, off, nflags: LongInt;
  c: Char;
  in_class, closed: Boolean;
  flags: String[16];
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  LxAdvance(ctx);
  off := ctx.lex.pool_len;
  in_class := False;
  closed := False;
  While Not closed Do
    Begin
      If LxAtEnd(ctx) Or (LxCur(ctx) = #10) Then
        Begin
          SourceErrorAt(ctx, tl, tc, 'expression reguliere non terminee');
          Break;
        End;
      c := LxCur(ctx);
      If c = '\' Then
        Begin
          PoolAppend(ctx, c);
          LxAdvance(ctx);
          If Not LxAtEnd(ctx) And (LxCur(ctx) <> #10) Then
            Begin
              PoolAppend(ctx, LxCur(ctx));
              LxAdvance(ctx);
            End;
        End
      Else
        Begin
          If c = '[' Then
            in_class := True
          Else If c = ']' Then
            in_class := False;
          If (c = '/') And Not in_class Then
            closed := True
          Else
            PoolAppend(ctx, c);
          LxAdvance(ctx);
        End;
    End;
  idx := AddToken(ctx, TK_REGEX, tl, tc, tp);
  TokP(ctx.lex.tokens, idx)^.sval_off := off;
  TokP(ctx.lex.tokens, idx)^.sval_len := ctx.lex.pool_len - off;
  { Drapeaux : stockes dans le pool juste apres le corps. }
  flags := '';
  nflags := 0;
  While IsIdentPart(LxCur(ctx)) Do
    Begin
      c := LxCur(ctx);
      If Pos(c, flags) > 0 Then
        SourceErrorAt(ctx, ctx.lex.line, LxCol(ctx),
                      'drapeau de RegExp en double: ' + c)
      Else If Pos(c, 'dgimsuvy') = 0 Then
        SourceWarnAt(ctx, ctx.lex.line, LxCol(ctx),
                     'drapeau de RegExp non standard: ' + c);
      If Length(flags) < 16 Then
        flags := flags + c;
      PoolAppend(ctx, c);
      Inc(nflags);
      LxAdvance(ctx);
    End;
  TokP(ctx.lex.tokens, idx)^.flag_len := nflags;
  { L'etendue brute inclut les drapeaux. }
  TokP(ctx.lex.tokens, idx)^.len := ctx.lex.pos - tp;
  TokP(ctx.lex.tokens, idx)^.text := RawText(ctx, tp, ctx.lex.pos - tp);
End;

{ ---- Commentaires ---- }

Procedure LxLineComment(Var ctx: TCompilerContext);
Begin
  While Not LxAtEnd(ctx) And (LxCur(ctx) <> #10) Do
    LxAdvance(ctx);
  Inc(ctx.lex.comment_count);
End;

Procedure LxBlockComment(Var ctx: TCompilerContext);
Var
  tl, tc: LongInt;
  closed: Boolean;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  LxAdvanceN(ctx, 2);
  closed := False;
  While Not closed Do
    Begin
      If LxAtEnd(ctx) Then
        Begin
          SourceErrorAt(ctx, tl, tc, 'commentaire /* non termine');
          Break;
        End;
      If (LxCur(ctx) = '*') And (LxPeek(ctx, 1) = '/') Then
        Begin
          LxAdvanceN(ctx, 2);
          closed := True;
        End
      Else
        Begin
          If LxCur(ctx) = #10 Then
            ctx.lex.nl_pending := True;
          LxAdvance(ctx);
        End;
    End;
  Inc(ctx.lex.comment_count);
End;

{ ---- Operateurs et ponctuation ---- }

Procedure LxOperator(Var ctx: TCompilerContext);
Var
  tl, tc, tp, idx, i, j, sel: LongInt;
  op: String[4];
  ok: Boolean;
  c: Char;
  num: String[12];
  kind: TTokenKind;
Begin
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  tp := ctx.lex.pos;
  sel := 0;
  i := 1;
  While (sel = 0) And (i <= OP_COUNT) Do
    Begin
      op := Ops[i];
      ok := True;
      For j := 1 To Length(op) Do
        If LxPeek(ctx, j - 1) <> op[j] Then
          ok := False;
      { a?.5:1 est un ternaire, pas un acces optionnel. }
      If ok And (op = '?.') And IsDigit(LxPeek(ctx, 2)) Then
        ok := False;
      If ok Then
        sel := i;
      Inc(i);
    End;
  If sel = 0 Then
    Begin
      c := LxCur(ctx);
      If (c < ' ') Or (c > '~') Then
        Begin
          Str(Ord(c), num);
          SourceErrorAt(ctx, tl, tc, 'caractere inattendu (code ' + num + ')');
        End
      Else
        SourceErrorAt(ctx, tl, tc, 'caractere inattendu: ' + c);
      LxAdvance(ctx);
      Exit;
    End;
  op := Ops[sel];
  LxAdvanceN(ctx, Length(op));
  kind := TK_OPERATOR;
  If (op = '(') Or (op = ')') Or (op = '[') Or (op = ']') Or (op = '{') Or
     (op = '}') Or (op = ';') Or (op = ',') Or (op = ':') Or (op = '.') Or
     (op = '...') Or (op = '=>') Then
    kind := TK_PUNCT;
  If op = '{' Then
    Inc(ctx.lex.brace_depth)
  Else If (op = '}') And (ctx.lex.brace_depth > 0) Then
    Dec(ctx.lex.brace_depth);
  idx := AddToken(ctx, kind, tl, tc, tp);
End;

{ ---- Boucle principale du lexer ---- }

Function LexSource(Var ctx: TCompilerContext): Boolean;
Var
  c: Char;
  tl, tc, idx: LongInt;
Begin
  LexSource := False;
  If Not ctx.source.loaded Then
    Begin
      PipelineError(ctx, 'source non charge avant lexing');
      Exit;
    End;
  ctx.lex.ident_count := 0;
  ctx.lex.keyword_count := 0;
  ctx.lex.number_count := 0;
  ctx.lex.string_count := 0;
  ctx.lex.template_count := 0;
  ctx.lex.regex_count := 0;
  ctx.lex.operator_count := 0;
  ctx.lex.punct_count := 0;
  ctx.lex.pos := 0;
  ctx.lex.line := 1;
  ctx.lex.line_pos := 0;
  ctx.lex.nl_pending := False;
  ctx.lex.brace_depth := 0;
  ctx.lex.tpl_top := 0;
  ctx.lex.token_count := 0;
  ctx.lex.pool_len := 0;
  ctx.lex.stop := False;
  ctx.lex.comment_count := 0;

  { Ligne hashbang (#!) acceptee en tete de fichier. }
  If (LxCur(ctx) = '#') And (LxPeek(ctx, 1) = '!') Then
    LxLineComment(ctx);

  While Not LxAtEnd(ctx) And Not ctx.lex.stop Do
    Begin
      c := LxCur(ctx);
      If c = #10 Then
        Begin
          ctx.lex.nl_pending := True;
          LxAdvance(ctx);
        End
      Else If (c = ' ') Or (c = #9) Or (c = #11) Or (c = #12) Or (c = #13) Then
        LxAdvance(ctx)
      Else If (c = #$C2) And (LxPeek(ctx, 1) = #$A0) Then
        LxAdvanceN(ctx, 2)
      Else If (c = '/') And (LxPeek(ctx, 1) = '/') Then
        LxLineComment(ctx)
      Else If (c = '/') And (LxPeek(ctx, 1) = '*') Then
        LxBlockComment(ctx)
      Else If IsIdentStart(c) Or ((c = '#') And IsIdentStart(LxPeek(ctx, 1))) Then
        LxIdent(ctx)
      Else If IsDigit(c) Or ((c = '.') And IsDigit(LxPeek(ctx, 1))) Then
        LxNumber(ctx)
      Else If (c = '"') Or (c = '''') Then
        LxString(ctx, c)
      Else If c = '`' Then
        LxTemplate(ctx, False)
      Else If (c = '}') And (ctx.lex.tpl_top > 0) And
              (TplStackP(ctx.lex.tpl_stack, ctx.lex.tpl_top)^ = ctx.lex.brace_depth) Then
        LxTemplate(ctx, True)
      Else If (c = '/') And RegexAllowed(ctx) Then
        LxRegex(ctx)
      Else
        LxOperator(ctx);
      If ctx.errors >= MAX_ERRORS Then
        Begin
          PipelineError(ctx, 'trop d''erreurs, arret du lexer');
          Break;
        End;
    End;

  If ctx.lex.tpl_top > 0 Then
    SourceErrorAt(ctx, ctx.lex.line, LxCol(ctx), 'gabarit non termine');
  tl := ctx.lex.line;
  tc := LxCol(ctx);
  idx := AddToken(ctx, TK_EOF, tl, tc, ctx.lex.pos);
  If ctx.options.verbose Then
    Writeln('Tokens : ', ctx.lex.token_count,
            ' (mots-cles=', ctx.lex.keyword_count,
            ', ident=', ctx.lex.ident_count,
            ', nombres=', ctx.lex.number_count,
            ', chaines=', ctx.lex.string_count,
            ', gabarits=', ctx.lex.template_count,
            ', regexp=', ctx.lex.regex_count,
            ', ops=', ctx.lex.operator_count,
            ', ponct=', ctx.lex.punct_count,
            ', commentaires=', ctx.lex.comment_count, ')');
  LexSource := ctx.errors = 0;
End;

{ ---- Affichage des jetons (option -tokens) ---- }

Function TokenKindName(kind: TTokenKind): TString;
Begin
  Case kind Of
    TK_EOF:      TokenKindName := 'EOF';
    TK_IDENT:    TokenKindName := 'IDENT';
    TK_KEYWORD:  TokenKindName := 'KEYWORD';
    TK_NUMBER:   TokenKindName := 'NUMBER';
    TK_STRING:   TokenKindName := 'STRING';
    TK_TEMPLATE: TokenKindName := 'TEMPLATE';
    TK_REGEX:    TokenKindName := 'REGEX';
    TK_OPERATOR: TokenKindName := 'OPERATOR';
    TK_PUNCT:    TokenKindName := 'PUNCT';
  Else
    TokenKindName := 'UNKNOWN';
  End;
End;

Function TemplatePartName(part: TTemplatePart): TString;
Begin
  Case part Of
    TP_NOSUB:  TemplatePartName := 'nosub';
    TP_HEAD:   TemplatePartName := 'head';
    TP_MIDDLE: TemplatePartName := 'middle';
    TP_TAIL:   TemplatePartName := 'tail';
  Else
    TemplatePartName := '';
  End;
End;

Procedure PrintPoolText(Var ctx: TCompilerContext; off, len: LongInt);
Var
  i: LongInt;
  c: Char;
Const
  HEX_CHARS = '0123456789ABCDEF';
Begin
  For i := 0 To len - 1 Do
    Begin
      c := PoolP(ctx.lex.pool, off + i)^;
      If c = #10 Then
        Write('\n')
      Else If c = #9 Then
        Write('\t')
      Else If c = #13 Then
        Write('\r')
      Else If c < ' ' Then
        Write('\x', HEX_CHARS[Ord(c) Div 16 + 1], HEX_CHARS[Ord(c) Mod 16 + 1])
      Else
        Write(c);
    End;
End;

Procedure DumpTokens(Var ctx: TCompilerContext);
Var
  i: LongInt;
  t: TToken;
Begin
  Writeln('Jetons (', ctx.lex.token_count, ') :');
  For i := 1 To ctx.lex.token_count Do
    Begin
      t := TokP(ctx.lex.tokens, i)^;
      Write('  ', t.line:4, ':', t.col, ' ');
      Write(TokenKindName(t.kind));
      If t.nl_before Then
        Write(' [nl]');
      Write(' ');
      Case t.kind Of
        TK_STRING:
          Begin
            Write('"');
            PrintPoolText(ctx, t.sval_off, t.sval_len);
            Write('"');
          End;
        TK_TEMPLATE:
          Begin
            Write('(', TemplatePartName(t.tpl), ') "');
            PrintPoolText(ctx, t.sval_off, t.sval_len);
            Write('"');
          End;
        TK_REGEX:
          Begin
            Write('/');
            PrintPoolText(ctx, t.sval_off, t.sval_len);
            Write('/');
            PrintPoolText(ctx, t.sval_off + t.sval_len, t.flag_len);
          End;
        TK_NUMBER:
          Write(t.text, ' = ', t.num_val);
      Else
        Write(t.text);
      End;
      Writeln;
    End;
End;

