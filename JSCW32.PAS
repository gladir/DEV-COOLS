Type
  TString = String[MAX_PATH_LEN];
  TTokenText = String[MAX_TOKEN_TEXT];

  { Liste chainee par blocs sur le tas : chaque bloc contient 'per' elements
    contigus ; les blocs sont relies par next/prev. Le numero d'element
    (base 0) est converti en bloc par un curseur (dernier bloc utilise). La
    liste grandit a la demande ; les nouveaux elements sont a zero. }
  PDlChunk = ^TDlChunk;
  TDlChunk = Record
    next, prev: PDlChunk;
    first: LongInt;            { numero du premier element du bloc }
    pad: LongInt;
  End;

  TDynList = Record
    esize, per, count: LongInt;
    head, tail, cur: PDlChunk;
  End;

  TCompileStage = (
    CS_LOAD_SOURCE,
    CS_LEX_TOKENS,
    CS_PARSE_AST,
    CS_ANALYZE,
    CS_BUILD_IR,
    CS_EMIT_ASM386,
    CS_BUILD_OBJ,
    CS_LINK_EXE
  );

  TArtifactKind = (
    AK_NONE,
    AK_SOURCE_JS,
    AK_TOKEN_STREAM,
    AK_AST,
    AK_AST_ANALYZED,
    AK_IR,
    AK_ASM_386,
    AK_OBJ_COFF,
    AK_EXE_PE32
  );

  TOutputMode = (
    OM_EXE,
    OM_OBJ
  );

  TPipelineOptions = Record
    output_mode : TOutputMode;
    emit_asm    : Boolean;
    verbose     : Boolean;
    show_help   : Boolean;
    show_version: Boolean;
    dump_tokens : Boolean;
    dump_ast    : Boolean;
    dump_scopes : Boolean;
    dump_runtime: Boolean;
    dump_data   : Boolean;
    dump_ir     : Boolean;
    dump_rt     : Boolean;
    run         : Boolean;
    test        : Boolean;
    keep        : Boolean;
    output_name : TString;
  End;

  TTokenKind = (
    TK_EOF,
    TK_IDENT,
    TK_KEYWORD,
    TK_NUMBER,
    TK_STRING,
    TK_TEMPLATE,
    TK_REGEX,
    TK_OPERATOR,
    TK_PUNCT
