Procedure RtRxParse;
Begin
  { _JSRT_rx_class_esc(table, lettre) : ajoute \d \w \s a la table ; 1 si connu }
  FBegin('_JSRT_rx_class_esc', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov eax, dword ptr [ebp+12]');
  A('cmp eax, 100');
  A('je .d');
  A('cmp eax, 119');
  A('je .w');
  A('cmp eax, 115');
  A('je .s');
  A('xor eax, eax');
  A('jmp .ret');
  A('.d:');
  A('push 57');
  A('push 48');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('mov eax, 1');
  A('jmp .ret');
  A('.w:');
  A('push 57');
  A('push 48');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('push 90');
  A('push 65');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('push 122');
  A('push 97');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('push 95');
  A('push 95');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('mov eax, 1');
  A('jmp .ret');
  A('.s:');
  A('push 13');
  A('push 9');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('push 32');
  A('push 32');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('mov eax, 1');
  FEnd;

  { _JSRT_rx_esc_char(C) -> octet d'un echappement simple (curseur apres la lettre) ou -1 }
  FBegin('_JSRT_rx_esc_char', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [esi]');
  A('movzx eax, byte ptr [ebx]');
  A('inc ebx');
  A('mov dword ptr [esi], ebx');
  A('cmp eax, 110');
  A('jne .a');
  A('mov eax, 10');
  A('jmp .ret');
  A('.a:');
  A('cmp eax, 114');
  A('jne .b');
  A('mov eax, 13');
  A('jmp .ret');
  A('.b:');
  A('cmp eax, 116');
  A('jne .c');
  A('mov eax, 9');
  A('jmp .ret');
  A('.c:');
  A('cmp eax, 102');
  A('jne .d');
  A('mov eax, 12');
  A('jmp .ret');
  A('.d:');
  A('cmp eax, 118');
  A('jne .e');
  A('mov eax, 11');
  A('jmp .ret');
  A('.e:');
  A('cmp eax, 48');
  A('jne .f');
  A('xor eax, eax');
  A('jmp .ret');
  A('.f:');
  A('cmp eax, 120');
  A('jne .g');
  A('push 2');
  A('push esi');
  A('call _JSRT_rx_hexn');
  A('add esp, 8');
  A('cmp eax, -1');
  A('jne .ret');
  A('mov eax, 120');
  A('jmp .ret');
  A('.g:');
  A('cmp eax, 117');
  A('jne .ret');
  A('push 4');
  A('push esi');
  A('call _JSRT_rx_hexn');
  A('add esp, 8');
  A('cmp eax, -1');
  A('jne .ret');
  A('mov eax, 117');
  FEnd;

  { _JSRT_rx_class(C) : analyse [...] ; le curseur est sur le crochet ouvrant }
  FBegin('_JSRT_rx_class', 4);
  A('mov esi, dword ptr [ebp+8]');
  A('push 32');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov ' + Lv(1) + ', eax');
  A('mov ' + Lv(2) + ', 0');
  A('mov ebx, dword ptr [esi]');
  A('inc ebx');
  A('mov dword ptr [esi], ebx');
  A('cmp ebx, dword ptr [esi+4]');
  A('jae .unterm');
  A('cmp byte ptr [ebx], 94');
  A('jne .items');
  A('mov ' + Lv(2) + ', 1');
  A('inc ebx');
  A('mov dword ptr [esi], ebx');
  A('.items:');
  A('mov ebx, dword ptr [esi]');
  A('cmp ebx, dword ptr [esi+4]');
  A('jae .unterm');
  A('movzx eax, byte ptr [ebx]');
  A('cmp eax, 93');
  A('je .close');
  A('inc ebx');
