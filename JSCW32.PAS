  A('push offset ' + RtStr(': '));
  A('push $STR');
  A('push ebx');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push $STR');
  A('push esi');
  A('push $STR');
  A('push eax');
  A('call _JSRT_concat');
