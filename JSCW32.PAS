  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('jmp dword ptr [eax+$FN_CODE]');
  A('.allascii:');
  A('xor ebx, ebx');
  A('xor esi, esi');
  A('.count:');
  A('cmp esi, dword ptr [ebp+12]');
  A('jae .alloc');
  A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov ecx, esi');
  A('shl ecx, 3');
  A('push dword ptr [eax+ecx+4]');
  A('push dword ptr [eax+ecx]');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('and eax, 65535');
  A('inc ebx');
  A('cmp eax, 128');
  A('jb .cn');
  A('inc ebx');
  A('cmp eax, 2048');
  A('jb .cn');
  A('inc ebx');
  A('.cn:');
  A('inc esi');
  A('jmp .count');
  A('.alloc:');
  A('push ebx');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('push eax');
  A('mov edi, eax');
  A('add edi, $STR_DATA');
  A('xor esi, esi');
  A('.fill:');
  A('cmp esi, dword ptr [ebp+12]');
  A('jae .done');
  A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov ecx, esi');
  A('shl ecx, 3');
  A('push dword ptr [eax+ecx+4]');
  A('push dword ptr [eax+ecx]');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('and eax, 65535');
  A('cmp eax, 128');
  A('jae .two');
  A('mov byte ptr [edi], al');
  A('inc edi');
  A('jmp .next');
  A('.two:');
  A('cmp eax, 2048');
  A('jae .three');
  A('mov ecx, eax');
  A('shr ecx, 6');
  A('or ecx, 192');
  A('mov byte ptr [edi], cl');
  A('and eax, 63');
  A('or eax, 128');
  A('mov byte ptr [edi+1], al');
  A('add edi, 2');
  A('jmp .next');
  A('.three:');
  A('mov ecx, eax');
  A('shr ecx, 12');
  A('or ecx, 224');
  A('mov byte ptr [edi], cl');
  A('mov ecx, eax');
  A('shr ecx, 6');
  A('and ecx, 63');
  A('or ecx, 128');
  A('mov byte ptr [edi+1], cl');
