Procedure EmitRuntime(Var ctx: TCompilerContext);
Begin
  asm_ctx := @ctx;
  asm_failed := False;
  gl_n := 0;
  asm_uniq := 0;
  asm_lbl_count := 0;
  ctx.ir.user_count := ctx.ir.count;
  { fin du code utilisateur (traces de pile) }
  A('proc _JSRT_utext_end');
  A('ret');
  A('endp');
  RtStaticData;
  RtStartAndAlloc;
  RtStrings;
  RtEquality;
  RtProperties;
  RtConsoleFn('_JSRT_console_log', '_JSRT_v_stdout', 0, True);
  RtConsoleFn('_JSRT_console_error', '_JSRT_v_stderr', 1, True);
  RtConsoleFn('_JSRT_console_dir', '_JSRT_v_stdout', 2, False);
  RtConsoleFn('_JSRT_console_assert', '_JSRT_v_stdout', 3, False);
  RtConsoleFn('_JSRT_console_group', '_JSRT_v_stdout', 4, False);
  RtConsoleFn('_JSRT_console_groupEnd', '_JSRT_v_stdout', 5, False);
  RtHost;
  RtStringMethods;
  RtArrays;
  RtObjects;
  RtClasses;
  RtErrors;
  RtNumCore;
  RtNumOps;
  RtRelational;
  RtNumConv;
  RtMathFns;
  RtNumMisc;
  RtNumberFns;
  RtJson;
  RtRxBasics;
  RtRxParse;
  RtRxVm;
  RtRxApi;
  RtPreludeHooks;
  RtBigWrappers;
  RtCoroutines;
  RtGlobalBridge(ctx);
  RtBinary;
  RtSys;
  { bornes de la section .data : racines du ramasse-miettes }
  NewDataSym(ctx, '_JSRT_data_begin', SEC_DATA, 0, 0, DS_RTVAR);
  NewDataSym(ctx, '_JSRT_data_end', SEC_DATA, (ctx.data.dt_size + 7) And Not 7, 0, DS_RTVAR);
End;

{ ============================================================
  EMULATEUR 80386 (option -run)

  Execute l'IR directement : memoire plate de 64 Mo, les sections
  .rdata et .data chargees avec leurs relocations, les procedures du
  programme et du runtime, la pile des appels et les drapeaux. Les
  appels systeme Windows importes (VirtualAlloc, GetStdHandle,
  WriteFile, ReadFile, ExitProcess) sont simules. Sert a verifier le
  programme compile sans edition de liens ni machine Windows.
  ============================================================ }

Const
  EMU_MEM_SIZE = 67108864;
  EMU_BASE     = $00400000;
  EMU_CODE     = $60000000;
  EMU_TRAP     = $70000000;
  EMU_HALTADDR     = $7FFFFFF0;
  EMU_HEAP     = $01000000;
  EMU_STACK    = $043FFF00;
  EMU_STEPLIMIT    = 400000000;

Type
  TEmuMem = Array[0..0] Of Byte;
  PEmuMem = ^TEmuMem;

Var
  emu_mem: PEmuMem;
  emu_reg: Array[0..12] Of LongWord;
  emu_zf, emu_sf, emu_cf, emu_of: Boolean;
  emu_pc: LongInt;
  emu_halt: Boolean;
  emu_exit: LongInt;
  emu_fault_msg: String[120];
  emu_steps: Int64;
  emu_rd_base, emu_dt_base, emu_brk: LongWord;
  emu_xaddr: TDynList;
  emu_lbl: TDynList;
  emu_ctx: PCtx;
  emu_trap_count: LongInt;
  emu_iat_next: LongWord;

Type
  P_emu_lbl = ^LongInt;

Function emu_lblP(Var l: TDynList; i: LongInt): P_emu_lbl;
Begin
  emu_lblP := P_emu_lbl(DlPtr(l, i - 0, SizeOf(LongInt)));
End;

Type
  P_emu_xaddr = ^LongWord;

Function emu_xaddrP(Var l: TDynList; i: LongInt): P_emu_xaddr;
Begin
  emu_xaddrP := P_emu_xaddr(DlPtr(l, i - 1, SizeOf(LongWord)));
End;

Procedure EmuFault(Const msg: TString);
Begin
  If Not emu_halt Then
    Begin
      emu_fault_msg := msg;
      emu_exit := -1;
    End;
  emu_halt := True;
End;

Function MemOk(a: LongWord; n: LongWord): Boolean;
Begin
  MemOk := (a >= EMU_BASE) And (Int64(a) + n <= Int64(EMU_BASE) + EMU_MEM_SIZE);
End;

Function MemRd(a: LongWord; size: Integer): LongWord;
Var
  v: LongWord;
Begin
  MemRd := 0;
  If Not MemOk(a, size) Then
    Begin
      EmuFault('lecture hors memoire a ' + HexU(a));
      Exit;
    End;
  v := 0;
  Move(emu_mem^[a - EMU_BASE], v, size);
  MemRd := v;
End;

Procedure MemWr(a: LongWord; v: LongWord; size: Integer);
Begin
  If Not MemOk(a, size) Then
    Begin
      EmuFault('ecriture hors memoire a ' + HexU(a));
      Exit;
    End;
  Move(v, emu_mem^[a - EMU_BASE], size);
End;

Function DsymAddr(Var ctx: TCompilerContext; d: LongInt): LongWord;
Begin
  If DsymP(ctx.data.syms, d)^.sec = SEC_RDATA Then
    DsymAddr := emu_rd_base + DsymP(ctx.data.syms, d)^.ofs
  Else
    DsymAddr := emu_dt_base + DsymP(ctx.data.syms, d)^.ofs;
End;

Function SymAddr(Var ctx: TCompilerContext; symkind, sym: LongInt): LongWord;
Begin
  If symkind = SYMK_D Then
    SymAddr := DsymAddr(ctx, sym)
  Else
    SymAddr := emu_xaddrP(emu_xaddr, sym)^;
End;

Function RegIdx(r: TReg): Integer;
Begin
  Case r Of
    R_AL: RegIdx := Ord(R_EAX);
    R_CL: RegIdx := Ord(R_ECX);
    R_DL: RegIdx := Ord(R_EDX);
    R_BL: RegIdx := Ord(R_EBX);
  Else
    RegIdx := Ord(r);
  End;
End;

Function EffAddr(Var ctx: TCompilerContext; Var o: TOperand): LongWord;
Var
  a: Int64;
Begin
  a := o.disp;
  If o.base <> R_NONE Then
    a := a + emu_reg[RegIdx(o.base)];
  If o.index <> R_NONE Then
    a := a + emu_reg[RegIdx(o.index)];
  If o.symkind <> 0 Then
    a := a + SymAddr(ctx, o.symkind, o.sym);
  EffAddr := LongWord(a And $FFFFFFFF);
End;

{ Taille de l'operation : octet si un registre ou une memoire 8 bits. }
Function OpSz(Var o: TOperand): Integer;
Begin
  OpSz := 4;
  If o.kind = OD_REG Then
    Begin
      If IsReg8(o.reg) Then
        OpSz := 1;
    End
  Else If (o.kind = OD_MEM) And (o.size = 1) Then
    OpSz := 1;
End;

Function OpRd(Var ctx: TCompilerContext; Var o: TOperand; size: Integer): LongWord;
Var
  v: LongWord;
Begin
  v := 0;
  Case o.kind Of
    OD_REG:
      Begin
        v := emu_reg[RegIdx(o.reg)];
        If IsReg8(o.reg) Then
          v := v And $FF;
      End;
    OD_IMM:
      v := LongWord(Int64(o.disp) And $FFFFFFFF);
    OD_MEM:
      v := MemRd(EffAddr(ctx, o), size);
    OD_ADDR:
      v := SymAddr(ctx, o.symkind, o.sym);
  End;
  If size = 1 Then
    v := v And $FF;
  OpRd := v;
End;

Procedure OpWr(Var ctx: TCompilerContext; Var o: TOperand; v: LongWord; size: Integer);
Var
  i: Integer;
Begin
  Case o.kind Of
    OD_REG:
      Begin
        i := RegIdx(o.reg);
        If IsReg8(o.reg) Then
          emu_reg[i] := (emu_reg[i] And $FFFFFF00) Or (v And $FF)
        Else
          emu_reg[i] := v;
      End;
    OD_MEM:
      MemWr(EffAddr(ctx, o), v, size);
  Else
    EmuFault('destination invalide');
  End;
End;

Procedure EmuPush(v: LongWord);
Begin
  emu_reg[Ord(R_ESP)] := emu_reg[Ord(R_ESP)] - 4;
  MemWr(emu_reg[Ord(R_ESP)], v, 4);
End;

Function EmuPop: LongWord;
Begin
  EmuPop := MemRd(emu_reg[Ord(R_ESP)], 4);
  emu_reg[Ord(R_ESP)] := emu_reg[Ord(R_ESP)] + 4;
End;

Procedure SetZS(res: LongWord; size: Integer);
Begin
  If size = 1 Then
    Begin
      emu_zf := (res And $FF) = 0;
      emu_sf := (res And $80) <> 0;
    End
  Else
    Begin
      emu_zf := res = 0;
      emu_sf := (res And $80000000) <> 0;
    End;
End;

Function AluAdd(a, b: LongWord; size: Integer): LongWord;
Var
  r, m, sb: Int64;
Begin
  If size = 1 Then
    Begin
      m := $FF;
      sb := $80;
    End
  Else
    Begin
      m := $FFFFFFFF;
      sb := $80000000;
    End;
  r := Int64(a) + Int64(b);
  emu_cf := r > m;
  r := r And m;
  emu_of := ((Int64(a) Xor r) And (Int64(b) Xor r) And sb) <> 0;
  SetZS(r, size);
  AluAdd := r;
End;

Function AluSub(a, b: LongWord; size: Integer): LongWord;
Var
  r, m, sb: Int64;
Begin
  If size = 1 Then
    Begin
      m := $FF;
      sb := $80;
    End
  Else
    Begin
      m := $FFFFFFFF;
      sb := $80000000;
    End;
  emu_cf := Int64(a) < Int64(b);
  r := (Int64(a) - Int64(b)) And m;
  emu_of := ((Int64(a) Xor Int64(b)) And (Int64(a) Xor r) And sb) <> 0;
  SetZS(r, size);
  AluSub := r;
End;

Function EmuCond(op: TOpc): Boolean;
Begin
  Case op Of
    OP_JE:  EmuCond := emu_zf;
    OP_JNE: EmuCond := Not emu_zf;
    OP_JL:  EmuCond := emu_sf <> emu_of;
    OP_JLE: EmuCond := emu_zf Or (emu_sf <> emu_of);
    OP_JG:  EmuCond := (Not emu_zf) And (emu_sf = emu_of);
    OP_JGE: EmuCond := emu_sf = emu_of;
    OP_JB:  EmuCond := emu_cf;
    OP_JAE: EmuCond := Not emu_cf;
    OP_JA:  EmuCond := (Not emu_cf) And (Not emu_zf);
    OP_JBE: EmuCond := emu_cf Or emu_zf;
    OP_JO:  EmuCond := emu_of;
    OP_JNO: EmuCond := Not emu_of;
    OP_JS:  EmuCond := emu_sf;
    OP_JNS: EmuCond := Not emu_sf;
  Else
    EmuCond := False;
  End;
End;

{ Appels systeme simules (stdcall : l'appele retire ses arguments). }
Var
  emu_vclock: Int64;
  emu_base_ms: Int64;

{ Heure de depart (ms depuis 1970, UTC) d'apres l'horloge du systeme. }
Function EmuUnixMs: Int64;
Var
  y, mo, d, dow, h, mi, sec, hund: Word;
  yy, mm, era, yoe, doy, doe, days: Int64;
Begin
  If emu_base_ms = 0 Then
    Begin
      GetDate(y, mo, d, dow);
      GetTime(h, mi, sec, hund);
      yy := y;
      mm := mo;
      If mm <= 2 Then
        Dec(yy);
      era := yy Div 400;
      yoe := yy - era * 400;
      If mo > 2 Then
        doy := (153 * (mm - 3) + 2) Div 5 + d - 1
      Else
        doy := (153 * (mm + 9) + 2) Div 5 + d - 1;
      doe := yoe * 365 + yoe Div 4 - yoe Div 100 + doy;
      days := era * 146097 + doe - 719468;
      emu_base_ms := ((days * 24 + h) * 60 + mi) * 60 * 1000 + sec * 1000 + hund * 10;
    End;
  EmuUnixMs := emu_base_ms;
End;

{ ---- Appels systeme KERNEL32 simules : fichiers, repertoires, processus, environnement ---- }
Const
  EMU_FILES = 64;
  EMU_FIND = 16;
  EMU_PIPES = 16;
Type
  TEmuPipe = Record
    used: Boolean;
    data: Pointer;
    size, pos: LongInt;
  End;
Var
  emu_fh: Array[1..EMU_FILES] Of File;
  emu_fused: Array[1..EMU_FILES] Of Boolean;
  emu_fapp: Array[1..EMU_FILES] Of Boolean;
  emu_sr: Array[1..EMU_FIND] Of SearchRec;
  emu_sused: Array[1..EMU_FIND] Of Boolean;
  emu_pipe: Array[1..EMU_PIPES] Of TEmuPipe;
  emu_lasterr: LongWord;
  emu_procexit: LongInt;
  emu_tmpn: LongInt;

Function EmuWStr(a: LongWord): String;
Var
  r: String;
  c, c2: LongWord;
  n: LongInt;
Begin
  r := '';
  n := 0;
  While n < 250 Do
    Begin
      c := MemRd(a + 2 * LongWord(n), 2);
      Inc(n);
      If c = 0 Then
        Break;
      If (c >= $D800) And (c < $DC00) Then
        Begin
          c2 := MemRd(a + 2 * LongWord(n), 2);
          If (c2 >= $DC00) And (c2 < $E000) Then
            Begin
              Inc(n);
              c := $10000 + ((c - $D800) Shl 10) + (c2 - $DC00);
            End;
        End;
      If c < $80 Then
        r := r + Chr(c)
      Else If c < $800 Then
        r := r + Chr($C0 Or (c Shr 6)) + Chr($80 Or (c And $3F))
      Else If c < $10000 Then
        r := r + Chr($E0 Or (c Shr 12)) + Chr($80 Or ((c Shr 6) And $3F)) + Chr($80 Or (c And $3F))
      Else
        r := r + Chr($F0 Or (c Shr 18)) + Chr($80 Or ((c Shr 12) And $3F)) + Chr($80 Or ((c Shr 6) And $3F)) + Chr($80 Or (c And $3F));
    End;
  EmuWStr := r;
End;

{ Ecrit s (UTF-8) en UTF-16 + zero final dans la memoire simulee (maxc caracteres au plus) ; rend le nombre de caracteres. }
Function EmuPutW(a: LongWord; Const s: String; maxc: LongWord): LongWord;
Var
  i, n: LongWord;
  c: LongWord;
Begin
  i := 1;
  n := 0;
  While i <= Length(s) Do
    Begin
      c := Ord(s[i]);
      Inc(i);
      If (c >= $F0) And (i + 2 <= Length(s) + 1) Then
        Begin
          c := ((c And 7) Shl 18) Or ((Ord(s[i]) And $3F) Shl 12) Or ((Ord(s[i + 1]) And $3F) Shl 6) Or (Ord(s[i + 2]) And $3F);
          Inc(i, 3);
        End
      Else If (c >= $E0) And (i + 1 <= Length(s) + 1) Then
        Begin
          c := ((c And 15) Shl 12) Or ((Ord(s[i]) And $3F) Shl 6) Or (Ord(s[i + 1]) And $3F);
          Inc(i, 2);
        End
      Else If (c >= $C0) And (i <= Length(s) + 1) Then
        Begin
          c := ((c And 31) Shl 6) Or (Ord(s[i]) And $3F);
          Inc(i);
        End;
      If c >= $10000 Then
        Begin
          If n + 2 >= maxc Then
            Break;
          c := c - $10000;
          MemWr(a + 2 * n, $D800 + (c Shr 10), 2);
          MemWr(a + 2 * n + 2, $DC00 + (c And $3FF), 2);
          Inc(n, 2);
        End
      Else
        Begin
          If n + 1 >= maxc Then
            Break;
          MemWr(a + 2 * n, c, 2);
          Inc(n);
        End;
    End;
  If maxc > 0 Then
    MemWr(a + 2 * n, 0, 2);
  EmuPutW := n;
End;

{ Date DOS empaquetee -> FILETIME (intervalles de 100 ns depuis 1601). }
Function EmuFileTime(t: LongInt): Int64;
Var
  dt: DateTime;
  yy, mm, era, yoe, doy, doe, days: Int64;
Begin
  UnpackTime(t, dt);
  yy := dt.Year;
  mm := dt.Month;
  If mm <= 2 Then
    Dec(yy);
  era := yy Div 400;
  yoe := yy - era * 400;
  If dt.Month > 2 Then
    doy := (153 * (mm - 3) + 2) Div 5 + dt.Day - 1
  Else
    doy := (153 * (mm + 9) + 2) Div 5 + dt.Day - 1;
  doe := yoe * 365 + yoe Div 4 - yoe Div 100 + doy;
  days := era * 146097 + doe - 719468;
  EmuFileTime := ((days * 86400 + dt.Hour * 3600 + dt.Min * 60 + dt.Sec + 11644473600) * 10000000);
End;

Function EmuWinAttr(a: Byte): LongWord;
Var
  r: LongWord;
Begin
  r := 0;
  If (a And Directory) <> 0 Then
    r := r Or $10;
  If (a And ReadOnly) <> 0 Then
    r := r Or 1;
  If r = 0 Then
    r := $80;
  EmuWinAttr := r;
End;

Procedure EmuPut64(a: LongWord; v: Int64);
Begin
  MemWr(a, LongWord(v And $FFFFFFFF), 4);
  MemWr(a + 4, LongWord((v Shr 32) And $FFFFFFFF), 4);
End;

Procedure EmuFillFind(p: LongWord; Const sr: SearchRec);
Var
  t: Int64;
Begin
  t := EmuFileTime(sr.Time);
  MemWr(p, EmuWinAttr(sr.Attr), 4);
  EmuPut64(p + 4, t);
  EmuPut64(p + 12, t);
  EmuPut64(p + 20, t);
  MemWr(p + 28, 0, 4);
  MemWr(p + 32, LongWord(sr.Size), 4);
  EmuPutW(p + 44, sr.Name, 260);
End;

Function EmuDirExists(Const name: String): Boolean;
Var
  sr: SearchRec;
Begin
  FindFirst(name, AnyFile, sr);
  EmuDirExists := (DosError = 0) And ((sr.Attr And Directory) <> 0);
  FindClose(sr);
End;

Function EmuFileExists(Const name: String): Boolean;
Var
  sr: SearchRec;
Begin
  FindFirst(name, AnyFile, sr);
  EmuFileExists := (DosError = 0) And ((sr.Attr And Directory) = 0);
  FindClose(sr);
End;

