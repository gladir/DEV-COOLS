{ ---- Nombres : pow, Math, Number et fonctions globales ---- }

{ Argument i d'une native converti en nombre, dans les locaux lo/hi
  (NaN si absent). }
Procedure NatNum(i: LongInt; Const lo, hi: TString);
Var
  have, ok: TString;
Begin
  have := U('h');
  ok := U('k');
  A('cmp dword ptr [ebp+12], ' + IntToStr(i + 1));
  A('jae ' + have);
  A('mov ' + lo + ', 0');
  A('mov ' + hi + ', 0xFFF80000');
  A('jmp ' + ok);
  A(have + ':');
  CallToNumber('dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i) + ']',
               'dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i + 4) + ']', lo, hi);
  A(ok + ':');
End;

{ Fonction de Math a un argument : ops agissent sur ST0 ; ext = precision etendue }
Procedure MathFn1(Const name: TString; ext: Boolean; Const ops: Array Of TString);
Var
  i: LongInt;
Begin
  FBegin(name, 2);
  NatNum(0, Lv(1), Lv(2));
  If ext Then
    A('fldcw word ptr [_JSRT_cw_ext]');
  CallFld(Lv(1), Lv(2));
  For i := 0 To High(ops) Do
    A(ops[i]);
  If ext Then
    A('fldcw word ptr [_JSRT_cw_dbl]');
  A('call _JSRT_fst_result');
  FEnd;
End;

{ floor / ceil / trunc / round : mode d'arrondi du mot de controle cwsym }
Procedure MathRound(Const name, cwsym: TString; plushalf: Boolean);
Begin
  FBegin(name, 2);
  NatNum(0, Lv(1), Lv(2));
  A('cmp ' + Lv(2) + ', $INT');
  A('jne .d');
  A('mov eax, ' + Lv(1));
  A('mov edx, $INT');
  A('jmp .ret');
  A('.d:');
  A('fldcw word ptr [' + cwsym + ']');
  CallFld(Lv(1), Lv(2));
  If plushalf Then
    A('fadd qword ptr [_JSRT_chalf]');
  A('frndint');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('call _JSRT_fst_result');
  FEnd;
End;

Procedure RtMathFns;
Begin
  MathRound('_JSRT_Math_floor', '_JSRT_cw_down', False);
  MathRound('_JSRT_Math_ceil', '_JSRT_cw_up', False);
  MathRound('_JSRT_Math_trunc', '_JSRT_cw_trunc', False);
  MathRound('_JSRT_Math_round', '_JSRT_cw_down', True);
  MathFn1('_JSRT_Math_sqrt', False, ['fsqrt']);
  MathFn1('_JSRT_Math_sin', True, ['fsin']);
  MathFn1('_JSRT_Math_cos', True, ['fcos']);
  MathFn1('_JSRT_Math_tan', True, ['fld 0', 'fsin', 'fxch', 'fcos', 'fdivp']);
  MathFn1('_JSRT_Math_atan', True, ['fld1', 'fpatan']);
  MathFn1('_JSRT_Math_asin', True, ['fld 0', 'fmul 0', 'fld1', 'fsubrp', 'fsqrt', 'fpatan']);
  MathFn1('_JSRT_Math_acos', True,
          ['fld 0', 'fmul 0', 'fld1', 'fsubrp', 'fsqrt', 'fxch', 'fpatan']);
  MathFn1('_JSRT_Math_exp', True,
          ['fldl2e', 'fmulp', 'fld 0', 'frndint', 'fxch', 'fsub 1', 'f2xm1', 'fld1', 'faddp',
           'fscale', 'fxch', 'fpop']);
  MathFn1('_JSRT_Math_log', True, ['fldln2', 'fxch', 'fyl2x']);
  MathFn1('_JSRT_Math_log2', True, ['fld1', 'fxch', 'fyl2x']);
  MathFn1('_JSRT_Math_log10', True, ['fldlg2', 'fxch', 'fyl2x']);

  { Math.abs }
  FBegin('_JSRT_Math_abs', 2);
  NatNum(0, Lv(1), Lv(2));
  A('mov eax, ' + Lv(1));
  A('mov edx, ' + Lv(2));
  A('cmp edx, $INT');
  A('jne .d');
  A('test eax, eax');
  A('jns .ret');
  A('cmp eax, 0x80000000');
  A('je .d');
  A('neg eax');
  A('jmp .ret');
  A('.d:');
  CallFld(Lv(1), Lv(2));
  A('fabs');
  A('call _JSRT_fst_result');
  FEnd;

  { Math.sign }
  FBegin('_JSRT_Math_sign', 2);
  NatNum(0, Lv(1), Lv(2));
  CallFld(Lv(1), Lv(2));
  A('ftst');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4500');
  A('je .nan');
  A('cmp eax, 0x4000');
  A('je .zero');
  A('fpop');
  A('cmp eax, 0x0100');
  A('je .neg');
  A('mov eax, 1');
  A('mov edx, $INT');
  A('jmp .ret');
  A('.neg:');
  A('mov eax, -1');
  A('mov edx, $INT');
  A('jmp .ret');
  A('.zero:');
  A('call _JSRT_fst_result');
  A('jmp .ret');
  A('.nan:');
  A('fpop');
  A('xor eax, eax');
  A('mov edx, 0xFFF80000');
  FEnd;

  { Math.max / Math.min ; mode 0 max, 1 min }
  FBegin('_JSRT_Math_max', 4);
  A('mov ' + Lv(1) + ', 0');
  A('mov ' + Lv(2) + ', 0xFFF00000');
  A('xor ebx, ebx');
  A('.l:');
  A('cmp ebx, dword ptr [ebp+12]');
  A('jae .done');
  A('mov eax, ebx');
  A('shl eax, 3');
  A('lea esi, [ebp+eax+' + IntToStr(RT_FRAME_ARGS) + ']');
  CallToNumber('dword ptr [esi]', 'dword ptr [esi+4]', Lv(3), Lv(4));
  CallFld(Lv(3), Lv(4));
  CallFld(Lv(1), Lv(2));
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4500');
  A('je .nan');
  A('cmp eax, 0x0100');
  A('jne .nx');
  A('mov eax, ' + Lv(3));
  A('mov ' + Lv(1) + ', eax');
  A('mov eax, ' + Lv(4));
  A('mov ' + Lv(2) + ', eax');
  A('.nx:');
  A('inc ebx');
  A('jmp .l');
  A('.nan:');
  A('xor eax, eax');
  A('mov edx, 0xFFF80000');
  A('jmp .ret');
  A('.done:');
  A('push ' + Lv(2));
  A('push ' + Lv(1));
  A('call _JSRT_norm_num');
  A('add esp, 8');
  FEnd;

  FBegin('_JSRT_Math_min', 4);
  A('mov ' + Lv(1) + ', 0');
  A('mov ' + Lv(2) + ', 0x7FF00000');
  A('xor ebx, ebx');
  A('.l:');
  A('cmp ebx, dword ptr [ebp+12]');
  A('jae .done');
  A('mov eax, ebx');
  A('shl eax, 3');
  A('lea esi, [ebp+eax+' + IntToStr(RT_FRAME_ARGS) + ']');
  CallToNumber('dword ptr [esi]', 'dword ptr [esi+4]', Lv(3), Lv(4));
  CallFld(Lv(3), Lv(4));
  CallFld(Lv(1), Lv(2));
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4500');
  A('je .nan');
  A('test eax, eax');
  A('jnz .nx');
  A('mov eax, ' + Lv(3));
  A('mov ' + Lv(1) + ', eax');
  A('mov eax, ' + Lv(4));
  A('mov ' + Lv(2) + ', eax');
  A('.nx:');
  A('inc ebx');
  A('jmp .l');
  A('.nan:');
  A('xor eax, eax');
  A('mov edx, 0xFFF80000');
  A('jmp .ret');
  A('.done:');
  A('push ' + Lv(2));
  A('push ' + Lv(1));
  A('call _JSRT_norm_num');
  A('add esp, 8');
  FEnd;

  { _JSRT_norm_num(valeur) : normalise un double entier en int32 }
  A('proc _JSRT_norm_num');
  A('push ebp');
  A('mov ebp, esp');
  A('cmp dword ptr [ebp+12], $INT');
  A('jne .d');
  A('mov eax, dword ptr [ebp+8]');
  A('mov edx, $INT');
  A('leave');
  A('ret');
  A('.d:');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_fld');
  A('add esp, 8');
  A('call _JSRT_fst_result');
  A('leave');
  A('ret');
  A('endp');

  { Math.atan2(y, x) et Math.hypot }
  FBegin('_JSRT_Math_atan2', 4);
  NatNum(0, Lv(1), Lv(2));
  NatNum(1, Lv(3), Lv(4));
  A('fldcw word ptr [_JSRT_cw_ext]');
  CallFld(Lv(1), Lv(2));
  CallFld(Lv(3), Lv(4));
  A('fpatan');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('call _JSRT_fst_result');
  FEnd;

  FBegin('_JSRT_Math_hypot', 4);
  A('fldcw word ptr [_JSRT_cw_ext]');
  A('fldz');
  A('xor ebx, ebx');
  A('.l:');
  A('cmp ebx, dword ptr [ebp+12]');
  A('jae .d');
  A('mov eax, ebx');
  A('shl eax, 3');
  A('lea esi, [ebp+eax+' + IntToStr(RT_FRAME_ARGS) + ']');
  CallToNumber('dword ptr [esi]', 'dword ptr [esi+4]', Lv(1), Lv(2));
  CallFld(Lv(1), Lv(2));
  A('fmul 0');
  A('faddp');
  A('inc ebx');
  A('jmp .l');
  A('.d:');
  A('fsqrt');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('call _JSRT_fst_result');
  FEnd;

  { Math.pow(x, y) }
  FBegin('_JSRT_Math_pow', 4);
  NatNum(0, Lv(1), Lv(2));
  NatNum(1, Lv(3), Lv(4));
  A('push ' + Lv(4));
  A('push ' + Lv(3));
  A('push ' + Lv(2));
  A('push ' + Lv(1));
  A('call _JSRT_pow');
  FEnd;

  { Math.imul(a, b) }
  FBegin('_JSRT_Math_imul', 0);
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('mov ebx, eax');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('imul eax, ebx');
  A('mov edx, $INT');
  FEnd;

  { Math.random() : xorshift 32 bits, deux tirages pour 52 bits de mantisse }
  FBegin('_JSRT_Math_random', 2);
  A('mov eax, dword ptr [_JSRT_v_rng]');
  A('test eax, eax');
  A('jnz .seeded');
  A('call dword ptr [__imp__GetTickCount@0]');
  A('xor eax, 0x9E3779B9');
  A('or eax, 1');
  A('.seeded:');
  A('mov ecx, eax');
  A('shl ecx, 13');
  A('xor eax, ecx');
  A('mov ecx, eax');
  A('shr ecx, 17');
  A('xor eax, ecx');
  A('mov ecx, eax');
  A('shl ecx, 5');
  A('xor eax, ecx');
  A('mov ' + Lv(1) + ', eax');
  A('mov ecx, eax');
  A('shl ecx, 13');
  A('xor eax, ecx');
  A('mov ecx, eax');
  A('shr ecx, 17');
  A('xor eax, ecx');
  A('mov ecx, eax');
  A('shl ecx, 5');
  A('xor eax, ecx');
  A('mov dword ptr [_JSRT_v_rng], eax');
  A('mov ' + Lv(2) + ', eax');
  A('mov eax, ' + Lv(1));
  A('shr eax, 12');
  A('or eax, 0x3FF00000');
  A('push eax');
  A('push ' + Lv(2));
  A('fld qword ptr [esp]');
  A('add esp, 8');
  A('fld1');
  A('fsubp');
  A('call _JSRT_fst_result');
  FEnd;
End;

{ ---- Nombres : pow, Number, fonctions globales ---- }

Procedure RtNumMisc;
Begin
  { _JSRT_fclass(double) : 0 fini non nul, 1 zero, 2 infini, 3 NaN }
  A('proc _JSRT_fclass');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+12]');
  A('mov ecx, eax');
  A('and ecx, 0x7FF00000');
  A('cmp ecx, 0x7FF00000');
  A('jne .fin');
  A('and eax, 0xFFFFF');
  A('or eax, dword ptr [ebp+8]');
  A('jnz .nan');
  A('mov eax, 2');
  A('leave');
  A('ret');
  A('.nan:');
  A('mov eax, 3');
  A('leave');
  A('ret');
  A('.fin:');
  A('mov eax, dword ptr [ebp+12]');
  A('and eax, 0x7FFFFFFF');
  A('or eax, dword ptr [ebp+8]');
  A('jz .zero');
  A('xor eax, eax');
  A('leave');
  A('ret');
  A('.zero:');
  A('mov eax, 1');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_int_class(double) : 0 non entier ou non fini, 1 entier pair, 2 entier impair }
  A('proc _JSRT_int_class');
  A('push ebp');
  A('mov ebp, esp');
  A('sub esp, 8');
  A('mov ecx, dword ptr [ebp+12]');
  A('and ecx, 0x7FF00000');
  A('cmp ecx, 0x7FF00000');
  A('je .no');
  A('fld qword ptr [ebp+8]');
  A('frndint');
  A('fld qword ptr [ebp+8]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4000');
  A('jne .no');
  A('fld qword ptr [ebp+8]');
  A('fabs');
  A('fld qword ptr [_JSRT_c2p53]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('jnz .even');
  A('fld qword ptr [ebp+8]');
  A('fabs');
  A('fistp qword ptr [esp]');
  A('mov eax, dword ptr [esp]');
  A('and eax, 1');
  A('inc eax');
  A('leave');
  A('ret');
  A('.even:');
  A('mov eax, 1');
  A('leave');
  A('ret');
  A('.no:');
  A('xor eax, eax');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_pow(a, b) : a ** b }
  FBegin('_JSRT_pow', 14);
  NumPrep2;
  CallFld(Lv(1), Lv(2));
  A('fstp ' + LvQ(6));
  CallFld(Lv(3), Lv(4));
  A('fstp ' + LvQ(8));
  A('push ' + Lv(7));
  A('push ' + Lv(8));
  A('call _JSRT_fclass');
  A('add esp, 8');
  A('mov ' + Lv(9) + ', eax');
  A('push ' + Lv(5));
  A('push ' + Lv(6));
  A('call _JSRT_fclass');
  A('add esp, 8');
  A('mov ' + Lv(10) + ', eax');
  A('push ' + Lv(7));
  A('push ' + Lv(8));
  A('call _JSRT_int_class');
  A('add esp, 8');
  A('mov ' + Lv(11) + ', eax');
  A('mov eax, ' + Lv(5));
  A('shr eax, 31');
  A('mov ' + Lv(12) + ', eax');
  A('cmp ' + Lv(9) + ', 1');
  A('je .one');
  A('cmp ' + Lv(10) + ', 3');
  A('je .nan');
  A('cmp ' + Lv(9) + ', 3');
  A('je .nan');
  A('cmp ' + Lv(9) + ', 2');
  A('je .binf');
  A('cmp ' + Lv(10) + ', 2');
  A('je .ainf');
  A('cmp ' + Lv(10) + ', 1');
  A('je .azero');
  { general }
  A('cmp ' + Lv(12) + ', 0');
  A('je .pos');
  A('cmp ' + Lv(11) + ', 0');
  A('je .nan');
  A('.pos:');
  A('fldcw word ptr [_JSRT_cw_ext]');
  A('cmp ' + Lv(11) + ', 0');
  A('je .logpow');
  A('fld ' + LvQ(8));
  A('fabs');
  A('fld qword ptr [_JSRT_c4096]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('jnz .logpow');
  A('fld ' + LvQ(8));
  A('fabs');
  A('fistp ' + Lv(13));
  A('mov ecx, ' + Lv(13));
  A('fld1');
  A('fld ' + LvQ(6));
  A('fabs');
  A('.sq:');
  A('test ecx, ecx');
  A('jz .sqd');
  A('test ecx, 1');
  A('jz .sqs');
  A('fxch');
  A('fmul 1');
  A('fxch');
  A('.sqs:');
  A('shr ecx, 1');
  A('fmul 0');
  A('jmp .sq');
  A('.sqd:');
  A('fpop');
  A('mov eax, ' + Lv(7));
  A('test eax, eax');
  A('jns .pdone');
  A('fld1');
  A('fdivrp');
  A('jmp .pdone');
  A('.logpow:');
  A('fld ' + LvQ(8));
  A('fld ' + LvQ(6));
  A('fabs');
  A('fyl2x');
  A('fld 0');
  A('frndint');
  A('fxch');
  A('fsub 1');
  A('f2xm1');
  A('fld1');
  A('faddp');
  A('fscale');
  A('fxch');
  A('fpop');
  A('.pdone:');
  A('cmp ' + Lv(12) + ', 0');
  A('je .fin');
  A('cmp ' + Lv(11) + ', 2');
  A('jne .fin');
  A('fchs');
  A('.fin:');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('call _JSRT_fst_result');
  A('jmp .ret');
