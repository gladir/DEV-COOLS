  A('add edi, ecx');
  A('sub edi, 3');
  A('cmp byte ptr [edi], 237');
  A('jne .plain');
  A('movzx edx, byte ptr [edi+1]');
  A('cmp edx, 160');
  A('jb .plain');
  A('cmp edx, 175');
  A('ja .plain');
  A('and edx, 63');
  A('shl edx, 6');
  A('movzx ecx, byte ptr [edi+2]');
  A('and ecx, 63');
  A('or edx, ecx');
  A('sub edx, 2048');
