End;

{ ---- Expressions regulieres : compilation (TODO 20) ----

  Le motif est compile en un programme pour une machine a retour sur
  trace. Instruction de 16 octets : code, a, b, reserve. Les sauts sont
  relatifs, ce qui permet d'inserer du code devant un atome (quantificateurs,
  alternatives) en decalant simplement les instructions deja emises.

  Programme : ninstr +0, nombre de groupes (groupe 0 compris) +4, nombre
  de marques de boucle +8, drapeaux +12, instructions +16.
  Contexte de compilation C : curseur +0, fin +4, code +8, nombre +12,
  capacite +16, drapeaux +20, groupes +24, marques +28, motif +32. }

Const
  RXI_MATCH = 0;
  RXI_CHAR = 1;
  RXI_CHARI = 2;
  RXI_ANY = 3;
  RXI_ANYNL = 4;
  RXI_CLASS = 5;
  RXI_SPLIT = 6;
  RXI_JMP = 7;
  RXI_SAVE = 8;
  RXI_MARK = 9;
  RXI_CHECK = 10;
  RXI_BOL = 11;
  RXI_BOLM = 12;
  RXI_EOL = 13;
  RXI_EOLM = 14;
  RXI_WORDB = 15;
  RXI_NWORDB = 16;
  RXI_BACKREF = 17;
  RXI_LOOK = 18;
  RXI_LOOKEND = 19;
  RXI_BACKREFI = 20;
  RXI_RESET = 21;
  RXF_I = 1;
  RXF_G = 2;
  RXF_M = 4;
  RXF_S = 8;
  RXF_Y = 16;

{ Emet une instruction depuis le contexte ESI. }
Procedure RxEmit(op, oa, ob: TString);
Begin
  A('push ' + ob);
  A('push ' + oa);
  A('push ' + op);
  A('push esi');
  A('call _JSRT_rx_emit');
  A('add esp, 16');
End;

Procedure RxInsert(at, op, oa, ob: TString);
Begin
  A('push ' + ob);
  A('push ' + oa);
  A('push ' + op);
  A('push ' + at);
  A('push esi');
  A('call _JSRT_rx_insert');
  A('add esp, 20');
End;

Procedure RxErr(Const msg: TString);
Begin
  A('push offset ' + RtStr(msg));
  A('push esi');
  A('call _JSRT_rx_err');
End;

Procedure RtRxBasics;
Begin
  { _JSRT_rx_reserve(C, n) }
  FBegin('_JSRT_rx_reserve', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov eax, dword ptr [esi+12]');
  A('add eax, dword ptr [ebp+12]');
  A('cmp eax, dword ptr [esi+16]');
  A('jbe .ret');
  A('mov ebx, dword ptr [esi+16]');
  A('add ebx, ebx');
  A('cmp ebx, 16');
  A('jae .a');
  A('mov ebx, 16');
  A('.a:');
  A('cmp ebx, eax');
  A('jae .b');
  A('mov ebx, eax');
  A('.b:');
  A('mov ecx, ebx');
  A('shl ecx, 4');
  A('push ecx');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov edi, eax');
  A('mov ecx, dword ptr [esi+12]');
  A('shl ecx, 4');
  A('push ecx');
  A('push dword ptr [esi+8]');
  A('push edi');
  A('call _JSRT_memmove');
  A('add esp, 12');
  A('mov dword ptr [esi+8], edi');
  A('mov dword ptr [esi+16], ebx');
  FEnd;

  { _JSRT_rx_emit(C, op, a, b) -> indice }
  FBegin('_JSRT_rx_emit', 0);
  A('push 1');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_rx_reserve');
  A('add esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edx, dword ptr [esi+12]');
  A('mov ecx, edx');
  A('shl ecx, 4');
  A('add ecx, dword ptr [esi+8]');
  A('mov eax, dword ptr [ebp+12]');
  A('mov dword ptr [ecx], eax');
  A('mov eax, dword ptr [ebp+16]');
  A('mov dword ptr [ecx+4], eax');
  A('mov eax, dword ptr [ebp+20]');
  A('mov dword ptr [ecx+8], eax');
  A('mov dword ptr [ecx+12], 0');
  A('inc edx');
  A('mov dword ptr [esi+12], edx');
  A('lea eax, [edx-1]');
  FEnd;

  { _JSRT_rx_insert(C, position, op, a, b) : decale le code a partir de la position }
  FBegin('_JSRT_rx_insert', 0);
  A('push 1');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_rx_reserve');
  A('add esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edx, dword ptr [ebp+12]');
  A('mov ecx, dword ptr [esi+12]');
  A('sub ecx, edx');
  A('shl ecx, 4');
  A('shl edx, 4');
  A('add edx, dword ptr [esi+8]');
  A('lea eax, [edx+16]');
  A('push ecx');
  A('push edx');
  A('push eax');
  A('call _JSRT_memmove');
  A('add esp, 12');
  A('mov esi, dword ptr [ebp+8]');
  A('mov ecx, dword ptr [ebp+12]');
  A('shl ecx, 4');
  A('add ecx, dword ptr [esi+8]');
  A('mov eax, dword ptr [ebp+16]');
  A('mov dword ptr [ecx], eax');
  A('mov eax, dword ptr [ebp+20]');
  A('mov dword ptr [ecx+4], eax');
  A('mov eax, dword ptr [ebp+24]');
  A('mov dword ptr [ecx+8], eax');
  A('mov dword ptr [ecx+12], 0');
  A('inc dword ptr [esi+12]');
  FEnd;

  { _JSRT_rx_dup(C, debut, fin) : recopie [debut, fin) a la fin du code }
  FBegin('_JSRT_rx_dup', 0);
  A('mov ebx, dword ptr [ebp+16]');
  A('sub ebx, dword ptr [ebp+12]');
  A('push ebx');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_rx_reserve');
  A('add esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [esi+12]');
  A('shl edi, 4');
  A('add edi, dword ptr [esi+8]');
  A('mov edx, dword ptr [ebp+12]');
  A('shl edx, 4');
  A('add edx, dword ptr [esi+8]');
  A('mov ecx, ebx');
  A('shl ecx, 4');
  A('push ecx');
  A('push edx');
  A('push edi');
  A('call _JSRT_memmove');
  A('add esp, 12');
  A('add dword ptr [esi+12], ebx');
  FEnd;

  { _JSRT_rx_set(table de 256 bits, bas, haut) }
  FBegin('_JSRT_rx_set', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('.l:');
  A('cmp ebx, dword ptr [ebp+16]');
  A('jg .ret');
  A('mov ecx, ebx');
  A('and ecx, 7');
  A('mov eax, 1');
  A('shl eax, cl');
  A('mov edx, ebx');
  A('shr edx, 3');
  A('mov ecx, eax');
  A('mov al, byte ptr [esi+edx]');
  A('or eax, ecx');
  A('mov byte ptr [esi+edx], al');
  A('inc ebx');
  A('jmp .l');
  FEnd;

  { _JSRT_rx_err(C, message) : SyntaxError }
  FBegin('_JSRT_rx_err', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('push $STR');
  A('push dword ptr [ebp+12]');
  A('push $STR');
  A('push offset ' + RtStr('/: '));
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push $STR');
  A('push eax');
  A('push $STR');
  A('push dword ptr [esi+32]');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push $STR');
  A('push eax');
  A('push $STR');
  A('push offset ' + RtStr('Invalid regular expression: /'));
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push eax');
  A('push offset _JSNO_SyntaxError_proto');
  A('call _JSRT_throw_msg');
  FEnd;

  { _JSRT_rx_hexn(C, n) -> valeur de n chiffres hexadecimaux ou -1 (curseur avance si succes) }
  FBegin('_JSRT_rx_hexn', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [esi]');
  A('xor edi, edi');
  A('mov ecx, dword ptr [ebp+12]');
  A('.l:');
  A('test ecx, ecx');
  A('jz .ok');
  A('cmp ebx, dword ptr [esi+4]');
  A('jae .no');
  A('movzx eax, byte ptr [ebx]');
  A('push ecx');
  A('push eax');
  A('call _JSRT_digit_val');
  A('add esp, 4');
  A('pop ecx');
  A('cmp eax, 16');
  A('jae .no');
  A('shl edi, 4');
  A('or edi, eax');
  A('inc ebx');
  A('dec ecx');
  A('jmp .l');
  A('.ok:');
  A('mov dword ptr [esi], ebx');
  A('mov eax, edi');
  A('jmp .ret');
  A('.no:');
  A('mov eax, -1');
  FEnd;

  { _JSRT_rx_cp(C, point de code) : emet les octets UTF-8 en CHAR }
  FBegin('_JSRT_rx_cp', 4);
  A('mov esi, dword ptr [ebp+8]');
  A('mov eax, dword ptr [ebp+12]');
  A('cmp eax, 128');
  A('jae .two');
  A('mov ' + Lv(1) + ', eax');
  A('mov ' + Lv(2) + ', 1');
  A('jmp .go');
  A('.two:');
  A('cmp eax, 2048');
  A('jae .three');
  A('mov ecx, eax');
  A('shr ecx, 6');
  A('or ecx, 192');
  A('mov ' + Lv(1) + ', ecx');
  A('and eax, 63');
  A('or eax, 128');
  A('shl eax, 8');
  A('or ' + Lv(1) + ', eax');
  A('mov ' + Lv(2) + ', 2');
  A('jmp .go');
  A('.three:');
  A('cmp eax, 65536');
  A('jae .four');
  A('mov ecx, eax');
  A('shr ecx, 12');
  A('or ecx, 224');
  A('mov ' + Lv(1) + ', ecx');
  A('mov ecx, eax');
  A('shr ecx, 6');
  A('and ecx, 63');
  A('or ecx, 128');
  A('shl ecx, 8');
  A('or ' + Lv(1) + ', ecx');
  A('and eax, 63');
  A('or eax, 128');
  A('shl eax, 16');
  A('or ' + Lv(1) + ', eax');
  A('mov ' + Lv(2) + ', 3');
  A('jmp .go');
  A('.four:');
  A('mov ecx, eax');
  A('shr ecx, 18');
  A('or ecx, 240');
  A('mov ' + Lv(1) + ', ecx');
  A('mov ecx, eax');
  A('shr ecx, 12');
  A('and ecx, 63');
  A('or ecx, 128');
  A('shl ecx, 8');
  A('or ' + Lv(1) + ', ecx');
  A('mov ecx, eax');
  A('shr ecx, 6');
  A('and ecx, 63');
  A('or ecx, 128');
  A('shl ecx, 16');
  A('or ' + Lv(1) + ', ecx');
  A('and eax, 63');
  A('or eax, 128');
  A('shl eax, 24');
  A('or ' + Lv(1) + ', eax');
  A('mov ' + Lv(2) + ', 4');
  A('.go:');
  A('xor ebx, ebx');
  A('.l:');
  A('cmp ebx, ' + Lv(2));
  A('jae .ret');
  A('mov eax, ' + Lv(1));
  A('mov ecx, ebx');
  A('shl ecx, 3');
  A('shr eax, cl');
  A('and eax, 255');
  RxEmit('1', 'eax', '0');
  A('inc ebx');
  A('jmp .l');
  FEnd;
End;

{ ---- Expressions regulieres : analyse du motif ---- }

Procedure RtRxParse;
Begin
  { _JSRT_rx_addrange(table, lo, hi) : membre d'une classe ; au dela de l'ASCII, la
    plage va dans la liste de points de code rangee en [table+28] (nombre, capacite, paires) }
  FBegin('_JSRT_rx_addrange', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('mov edi, dword ptr [ebp+16]');
  A('cmp ebx, 127');
  A('ja .big');
  A('cmp edi, 127');
  A('jbe .asc');
  A('push 127');
  A('push ebx');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('mov ebx, 128');
  A('jmp .big');
  A('.asc:');
  A('push edi');
  A('push ebx');
  A('push esi');
  A('call _JSRT_rx_set');
  A('add esp, 12');
  A('jmp .ret');
  A('.big:');
  A('mov eax, dword ptr [esi+28]');
  A('test eax, eax');
  A('jnz .have');
  A('push 72');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov dword ptr [eax+4], 8');
  A('mov dword ptr [esi+28], eax');
  A('.have:');
  A('mov ecx, dword ptr [eax]');
  A('cmp ecx, dword ptr [eax+4]');
  A('jb .room');
  A('mov edx, dword ptr [eax+4]');
  A('add edx, edx');
  A('push edx');
  A('mov ecx, edx');
  A('shl ecx, 3');
  A('add ecx, 8');
  A('push ecx');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('pop edx');
  A('mov ecx, dword ptr [esi+28]');
  A('push esi');
  A('push edi');
  A('mov edi, eax');
  A('mov esi, ecx');
  A('mov ecx, dword ptr [esi]');
  A('add ecx, ecx');
  A('add ecx, 2');
  A('shl ecx, 2');
  A('rep movsb');
  A('pop edi');
  A('pop esi');
  A('mov dword ptr [eax+4], edx');
  A('mov dword ptr [esi+28], eax');
  A('mov ecx, dword ptr [eax]');
  A('.room:');
  A('mov edx, ecx');
  A('shl edx, 3');
  A('lea edx, [eax+edx+8]');
  A('mov dword ptr [edx], ebx');
  A('mov dword ptr [edx+4], edi');
  A('inc dword ptr [eax]');
  FEnd;

  { _JSRT_rx_inrange(table, point de code) -> 1 si dans la liste }
  FBegin('_JSRT_rx_inrange', 0);
  A('mov eax, dword ptr [ebp+8]');
  A('mov eax, dword ptr [eax+28]');
  A('test eax, eax');
  A('jz .no');
  A('mov ecx, dword ptr [eax]');
  A('lea edx, [eax+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('.l:');
  A('test ecx, ecx');
  A('jz .no');
  A('cmp ebx, dword ptr [edx]');
  A('jb .nx');
  A('cmp ebx, dword ptr [edx+4]');
  A('ja .nx');
  A('mov eax, 1');
  A('jmp .ret');
  A('.nx:');
  A('add edx, 8');
  A('dec ecx');
  A('jmp .l');
  A('.no:');
  A('xor eax, eax');
  FEnd;

  { _JSRT_rx_dec(ptr) -> EAX point de code, EDX longueur de la sequence UTF-8 }
  FBegin('_JSRT_rx_dec', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('movzx eax, byte ptr [esi]');
  A('mov edx, 1');
  A('cmp eax, 192');
  A('jb .ret');
  A('cmp eax, 224');
  A('jae .t3');
  A('and eax, 31');
  A('shl eax, 6');
  A('movzx ecx, byte ptr [esi+1]');
  A('and ecx, 63');
  A('or eax, ecx');
  A('mov edx, 2');
  A('jmp .ret');
  A('.t3:');
  A('cmp eax, 240');
  A('jae .t4');
  A('and eax, 15');
  A('shl eax, 12');
  A('movzx ecx, byte ptr [esi+1]');
  A('and ecx, 63');
  A('shl ecx, 6');
  A('or eax, ecx');
  A('movzx ecx, byte ptr [esi+2]');
  A('and ecx, 63');
  A('or eax, ecx');
  A('mov edx, 3');
  A('jmp .ret');
  A('.t4:');
  A('and eax, 7');
  A('shl eax, 18');
  A('movzx ecx, byte ptr [esi+1]');
  A('and ecx, 63');
  A('shl ecx, 12');
  A('or eax, ecx');
  A('movzx ecx, byte ptr [esi+2]');
  A('and ecx, 63');
  A('shl ecx, 6');
  A('or eax, ecx');
  A('movzx ecx, byte ptr [esi+3]');
  A('and ecx, 63');
  A('or eax, ecx');
  A('mov edx, 4');
  FEnd;

  { _JSRT_rx_getcp(C) -> point de code au curseur ; le curseur avance }
  FBegin('_JSRT_rx_getcp', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('push dword ptr [esi]');
  A('call _JSRT_rx_dec');
  A('add esp, 4');
  A('add dword ptr [esi], edx');
  FEnd;

  { _JSRT_rx_class_esc(table, lettre) : ajoute \d \w \s a la table ; 1 si connu }
  FBegin('_JSRT_rx_class_esc', 0);
