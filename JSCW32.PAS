Procedure DumpIR(Var ctx: TCompilerContext);
Var
  i, limit: LongInt;
  a, b: TString;
  op: TOpc;
Begin
  If Not ctx.ir.built Then
    Exit;
  Writeln('Code (', ctx.ir.proc_count, ' procedures, ', ctx.ir.count,
          ' instructions) :');
  If ctx.options.dump_rt Then
    limit := ctx.ir.count
  Else
    limit := ctx.ir.user_count;
  For i := 1 To limit Do
    Begin
      op := InstrP(ctx.ir.instrs, i)^.op;
      Case op Of
        OP_LABEL:
          Writeln(OperandText(ctx, InstrP(ctx.ir.instrs, i)^.a), ':');
        OP_COMMENT:
          Writeln('        ; ', CommentP(ctx.ir.comments, InstrP(ctx.ir.instrs, i)^.a.disp)^);
        OP_PROC:
          Begin
            Writeln;
            Writeln(SymNameOf(ctx, InstrP(ctx.ir.instrs, i)^.a.symkind, InstrP(ctx.ir.instrs, i)^.a.sym), ' proc');
          End;
        OP_ENDP:
          Writeln('        endp');
      Else
        Begin
          a := OperandText(ctx, InstrP(ctx.ir.instrs, i)^.a);
          b := OperandText(ctx, InstrP(ctx.ir.instrs, i)^.b);
          If (op = OP_CALL) And (InstrP(ctx.ir.instrs, i)^.a.kind = OD_ADDR) Then
            a := SymNameOf(ctx, InstrP(ctx.ir.instrs, i)^.a.symkind, InstrP(ctx.ir.instrs, i)^.a.sym);
          Write('        ', OpName(op));
          If a <> '' Then
            Write(' ', a);
          If b <> '' Then
            Write(', ', b);
          Writeln;
        End;
      End;
    End;
  Writeln('Symboles externes non definis :');
  For i := 1 To ctx.ir.xsym_count Do
    If Not XsymP(ctx.ir.xsyms, i)^.defined And
       (DsymFind(ctx, XsymP(ctx.ir.xsyms, i)^.name) = 0) Then
      Writeln('  ', XsymP(ctx.ir.xsyms, i)^.name);
  If ctx.ir.pending_count > 0 Then
    Begin
      Writeln('Constructions en attente (', ctx.ir.pending_count, ') :');
      For i := 1 To ctx.ir.pending_count Do
        Writeln('  ligne ', PendingP(ctx.ir.pendings, i)^.line, ' : ',
                PendingP(ctx.ir.pendings, i)^.what);
    End;
End;

Function IntToStr(n: LongInt): TString;
Var
  s: String[12];
Begin
  Str(n, s);
  IntToStr := s;
End;

{ ============================================================
  MINI-ASSEMBLEUR ET GENERATEUR DU RUNTIME (TODO 14)

  Le runtime est ecrit en assembleur 80386 sous forme de lignes de texte
  (A('mov eax, [ebp+8]')) assemblees vers la meme IR que le code genere.
  Syntaxe : mnemoniques en minuscules, registres eax..edi et al, cl, dl,
  bl ; operandes memoire [base+index+deplacement], dword ptr / byte ptr
  facultatifs ; offset symbole ; etiquettes locales .nom ; macros $NOM
  (etiquettes de type $STR, deplacements $STR_LEN...). Un symbole inconnu
  est un symbole externe, resolu a l'edition de liens.

  Convention du runtime : cdecl, arguments de 8 octets (valeurs) ou de 4
  octets (pointeurs, entiers), resultat dans EDX:EAX ou EAX ; EBX, ESI,
  EDI et EBP preserves ; ECX, EDX et EAX libres.
  ============================================================ }

Type
  PCtx = ^TCompilerContext;

Var
  asm_ctx: PCtx;
  asm_lbl_name: TDynList;
  asm_lbl_id: TDynList;
  asm_lbl_count: LongInt;
  asm_uniq: LongInt;
  asm_failed: Boolean;

Type
  P_asm_lbl_id = ^LongInt;

Function asm_lbl_idP(Var l: TDynList; i: LongInt): P_asm_lbl_id;
Begin
  asm_lbl_idP := P_asm_lbl_id(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  T_asm_lbl_name = String[24];
  P_asm_lbl_name = ^T_asm_lbl_name;

Function asm_lbl_nameP(Var l: TDynList; i: LongInt): P_asm_lbl_name;
Begin
  asm_lbl_nameP := P_asm_lbl_name(DlPtr(l, i - 1, SizeOf(T_asm_lbl_name)));
End;

Function AsmTrim(s: TString): TString;
Begin
  While (Length(s) > 0) And (s[1] = ' ') Do
    Delete(s, 1, 1);
  While (Length(s) > 0) And (s[Length(s)] = ' ') Do
    Delete(s, Length(s), 1);
  AsmTrim := s;
End;

Procedure AsmFail(Const msg, line: TString);
Begin
  If Not asm_failed Then
    PipelineError(asm_ctx^, 'assembleur interne: ' + msg + ' : ' + line);
  asm_failed := True;
End;

{ Valeur d'une macro $NOM. }
Function AsmMacro(Const nm: TString; Var v: LongInt): Boolean;
Begin
  AsmMacro := True;
  If nm = 'INT' Then v := TagImm(RT_T_INT32)
  Else If nm = 'UNDEF' Then v := TagImm(RT_T_UNDEFINED)
  Else If nm = 'NULL' Then v := TagImm(RT_T_NULL)
  Else If nm = 'BOOL' Then v := TagImm(RT_T_BOOLEAN)
  Else If nm = 'STR' Then v := TagImm(RT_T_STRING)
  Else If nm = 'OBJ' Then v := TagImm(RT_T_OBJECT)
  Else If nm = 'ARR' Then v := TagImm(RT_T_ARRAY)
  Else If nm = 'FN' Then v := TagImm(RT_T_FUNCTION)
  Else If nm = 'RX' Then v := TagImm(RT_T_REGEXP)
  Else If nm = 'TDZ' Then v := TagImm(RT_T_TDZ)
  Else If nm = 'DONE' Then v := TagImm(RT_T_DONE)
  Else If nm = 'STR_LEN' Then v := RT_STR_LEN
  Else If nm = 'STR_HASH' Then v := RT_STR_HASH
  Else If nm = 'STR_DATA' Then v := RT_STR_DATA
  Else If nm = 'ARR_LEN' Then v := RT_ARR_LEN
  Else If nm = 'ARR_CAP' Then v := RT_ARR_CAP
  Else If nm = 'ARR_ELEMS' Then v := RT_ARR_ELEMS
  Else If nm = 'OBJ_PROTO' Then v := RT_OBJ_PROTO
  Else If nm = 'OBJ_PROPS' Then v := RT_OBJ_PROPS
  Else If nm = 'OBJ_COUNT' Then v := RT_OBJ_COUNT
  Else If nm = 'OBJ_CAP' Then v := RT_OBJ_CAP
  Else If nm = 'OBJ_CLASS' Then v := RT_OBJ_CLASS
  Else If nm = 'FN_CODE' Then v := RT_FN_CODE
  Else If nm = 'FN_ENV' Then v := RT_FN_ENV
  Else If nm = 'FN_DESC' Then v := RT_FN_DESC
  Else If nm = 'FN_PROPS' Then v := RT_FN_PROPS
  Else If nm = 'FN_THIS' Then v := RT_FN_THIS
  Else If nm = 'FN_HOME' Then v := RT_FN_HOME
  Else If nm = 'CELL_VALUE' Then v := RT_CELL_VALUE
  Else If nm = 'ENV_CELLS' Then v := RT_ENV_CELLS
  Else If nm = 'HDR_SIZE' Then v := RT_HDR_SIZE
  Else If nm = 'OK_STRING' Then v := RT_OK_STRING
  Else If nm = 'OK_ARRAY' Then v := RT_OK_ARRAY
  Else If nm = 'OK_OBJECT' Then v := RT_OK_OBJECT
  Else If nm = 'OK_FUNCTION' Then v := RT_OK_FUNCTION
  Else If nm = 'OK_CELL' Then v := RT_OK_CELL
  Else If nm = 'OK_ENV' Then v := RT_OK_ENV
  Else If nm = 'OK_REGEXP' Then v := RT_OK_REGEXP
  Else If nm = 'RX_SOURCE' Then v := RT_RX_SOURCE
  Else If nm = 'RX_FLAGS' Then v := RT_RX_FLAGS
  Else If nm = 'RX_PROG' Then v := RT_RX_PROG
  Else If nm = 'RX_LASTINDEX' Then v := RT_RX_LASTINDEX
  Else
    AsmMacro := False;
End;

Function AsmHexVal(c: Char): LongInt;
Begin
  If (c >= '0') And (c <= '9') Then
    AsmHexVal := Ord(c) - 48
  Else If (c >= 'a') And (c <= 'f') Then
    AsmHexVal := Ord(c) - 87
  Else If (c >= 'A') And (c <= 'F') Then
    AsmHexVal := Ord(c) - 55
  Else
    AsmHexVal := -1;
End;

{ Nombre decimal, hexadecimal 0x..., caractere 'c' ou macro $NOM. }
Function AsmNumber(Const t: TString; Var v: LongInt): Boolean;
Var
  i: Integer;
  neg: Boolean;
  w: Int64;
  d: LongInt;
Begin
  AsmNumber := False;
  If t = '' Then
    Exit;
  If t[1] = '$' Then
    Begin
      AsmNumber := AsmMacro(Copy(t, 2, Length(t) - 1), v);
      Exit;
    End;
  If (Length(t) = 3) And (t[1] = '''') And (t[3] = '''') Then
    Begin
      v := Ord(t[2]);
      AsmNumber := True;
      Exit;
    End;
  i := 1;
  neg := False;
  If t[1] = '-' Then
    Begin
      neg := True;
      i := 2;
    End;
  If i > Length(t) Then
    Exit;
  w := 0;
  If (Length(t) >= i + 2) And (t[i] = '0') And ((t[i + 1] = 'x') Or (t[i + 1] = 'X')) Then
    Begin
      Inc(i, 2);
      If i > Length(t) Then
        Exit;
      While i <= Length(t) Do
        Begin
          d := AsmHexVal(t[i]);
          If d < 0 Then
            Exit;
          w := w * 16 + d;
          Inc(i);
        End;
    End
  Else
    While i <= Length(t) Do
      Begin
        If (t[i] < '0') Or (t[i] > '9') Then
          Exit;
        w := w * 10 + (Ord(t[i]) - 48);
        Inc(i);
      End;
  If neg Then
    w := -w;
  v := ToLong(w);
  AsmNumber := True;
End;

Function AsmReg(Const t: TString): TReg;
Begin
  AsmReg := R_NONE;
  If t = 'eax' Then AsmReg := R_EAX
  Else If t = 'ecx' Then AsmReg := R_ECX
  Else If t = 'edx' Then AsmReg := R_EDX
  Else If t = 'ebx' Then AsmReg := R_EBX
  Else If t = 'esp' Then AsmReg := R_ESP
  Else If t = 'ebp' Then AsmReg := R_EBP
  Else If t = 'esi' Then AsmReg := R_ESI
  Else If t = 'edi' Then AsmReg := R_EDI
  Else If t = 'al' Then AsmReg := R_AL
  Else If t = 'cl' Then AsmReg := R_CL
  Else If t = 'dl' Then AsmReg := R_DL
  Else If t = 'bl' Then AsmReg := R_BL;
End;

Function IsReg8(r: TReg): Boolean;
Begin
  IsReg8 := (r = R_AL) Or (r = R_CL) Or (r = R_DL) Or (r = R_BL);
End;

Function AsmLabelId(Const nm: TString): LongInt;
Var
  i: LongInt;
Begin
  For i := 1 To asm_lbl_count Do
    If asm_lbl_nameP(asm_lbl_name, i)^ = nm Then
      Begin
        AsmLabelId := asm_lbl_idP(asm_lbl_id, i)^;
        Exit;
      End;
  Inc(asm_lbl_count);
  asm_lbl_nameP(asm_lbl_name, asm_lbl_count)^ := nm;
  asm_lbl_idP(asm_lbl_id, asm_lbl_count)^ := NewLabel(asm_ctx^);
  AsmLabelId := asm_lbl_idP(asm_lbl_id, asm_lbl_count)^;
End;

{ Symbole de donnees (pool) ou, a defaut, symbole de code ou externe. }
Procedure AsmSymbol(Const nm: TString; Var symkind, sym: LongInt);
Var
  d: LongInt;
Begin
  d := DsymFind(asm_ctx^, nm);
  If d <> 0 Then
    Begin
      symkind := SYMK_D;
      sym := d;
    End
  Else
    Begin
      symkind := SYMK_X;
      sym := XSym(asm_ctx^, nm);
    End;
End;

Function AsmIsIdentStart(c: Char): Boolean;
Begin
  AsmIsIdentStart := ((c >= 'A') And (c <= 'Z')) Or ((c >= 'a') And (c <= 'z')) Or
                     (c = '_') Or (c = '@');
End;

Procedure AsmMemory(Const inner: TString; Var o: TOperand; Const line: TString);
Var
  i, j: Integer;
  sign, v: LongInt;
  tok: TString;
  r: TReg;
Begin
  i := 1;
  sign := 1;
  While i <= Length(inner) Do
    Begin
      If inner[i] = ' ' Then
        Inc(i)
      Else If inner[i] = '+' Then
        Begin
          sign := 1;
          Inc(i);
        End
      Else If inner[i] = '-' Then
        Begin
          sign := -1;
          Inc(i);
        End
      Else
        Begin
          j := i;
          While (j <= Length(inner)) And (inner[j] <> '+') And (inner[j] <> '-') And
                (inner[j] <> ' ') Do
            Inc(j);
          tok := Copy(inner, i, j - i);
          i := j;
          r := AsmReg(tok);
          If r <> R_NONE Then
            Begin
              If o.base = R_NONE Then
                o.base := r
              Else
                o.index := r;
            End
          Else If AsmNumber(tok, v) Then
            o.disp := o.disp + sign * v
          Else If AsmIsIdentStart(tok[1]) Then
            AsmSymbol(tok, o.symkind, o.sym)
          Else
            AsmFail('terme memoire invalide ' + tok, line);
          sign := 1;
        End;
    End;
End;

Procedure AsmOperand(Const txt0: TString; Var o: TOperand; Const line: TString);
Var
  txt: TString;
  v: LongInt;
  r: TReg;
  sz: Byte;
Begin
  FillChar(o, SizeOf(o), 0);
  txt := AsmTrim(txt0);
  sz := 0;
  If Copy(txt, 1, 10) = 'dword ptr ' Then
    Begin
      Delete(txt, 1, 10);
      sz := 4;
    End
  Else If Copy(txt, 1, 9) = 'byte ptr ' Then
    Begin
      Delete(txt, 1, 9);
      sz := 1;
    End
  Else If Copy(txt, 1, 10) = 'qword ptr ' Then
    Begin
      Delete(txt, 1, 10);
      sz := 8;
    End
  Else If Copy(txt, 1, 9) = 'word ptr ' Then
    Begin
      Delete(txt, 1, 9);
      sz := 2;
    End;
  If txt = '' Then
    Exit;
  If txt[1] = '[' Then
    Begin
      o.kind := OD_MEM;
      o.size := sz;
      AsmMemory(Copy(txt, 2, Length(txt) - 2), o, line);
      Exit;
    End;
  If Copy(txt, 1, 7) = 'offset ' Then
    Begin
      o.kind := OD_ADDR;
      AsmSymbol(AsmTrim(Copy(txt, 8, Length(txt) - 7)), o.symkind, o.sym);
      Exit;
    End;
  r := AsmReg(txt);
  If r <> R_NONE Then
    Begin
      o.kind := OD_REG;
      o.reg := r;
      Exit;
    End;
  If AsmNumber(txt, v) Then
    Begin
      o.kind := OD_IMM;
      o.disp := v;
      Exit;
    End;
  If txt[1] = '.' Then
    Begin
      o.kind := OD_LABEL;
      o.disp := AsmLabelId(txt);
      Exit;
    End;
  If AsmIsIdentStart(txt[1]) Then
    Begin
      o.kind := OD_ADDR;
      AsmSymbol(txt, o.symkind, o.sym);
      Exit;
    End;
  AsmFail('operande invalide ' + txt, line);
End;

Function AsmFindOp(Const m: TString): TOpc;
Var
  op: TOpc;
Begin
  AsmFindOp := OP_NONE;
  If m = 'jz' Then
    AsmFindOp := OP_JE
  Else If m = 'jnz' Then
    AsmFindOp := OP_JNE
  Else If m = 'jc' Then
    AsmFindOp := OP_JB
  Else If m = 'jnc' Then
    AsmFindOp := OP_JAE
  Else
    For op := OP_MOV To OP_FLDLG2 Do
      If OpName(op) = m Then
        AsmFindOp := op;
End;

{ Assemble une ligne : etiquette locale, directive proc/endp ou
  instruction. }
Procedure A(Const line0: TString);
Var
  line, m, rest, a1, a2: TString;
  p, i, depth: Integer;
  op: TOpc;
  oa, ob: TOperand;
  xs: LongInt;
Begin
  line := line0;
  p := Pos(';', line);
  If p > 0 Then
    line := Copy(line, 1, p - 1);
  line := AsmTrim(line);
  If line = '' Then
    Exit;
  If (line[1] = '.') And (line[Length(line)] = ':') Then
    Begin
      PlaceLabel(asm_ctx^, AsmLabelId(Copy(line, 1, Length(line) - 1)));
      Exit;
    End;
  If Copy(line, 1, 5) = 'proc ' Then
    Begin
      xs := XSym(asm_ctx^, AsmTrim(Copy(line, 6, Length(line) - 5)));
      XsymP(asm_ctx^.ir.xsyms, xs)^.defined := True;
      XsymP(asm_ctx^.ir.xsyms, xs)^.runtime := True;
      Inc(asm_ctx^.ir.proc_count);
      asm_lbl_count := 0;
      Emit1(asm_ctx^, OP_PROC, AddrSym(SYMK_X, xs));
      Exit;
    End;
  If line = 'endp' Then
    Begin
      Emit1(asm_ctx^, OP_ENDP, NoOp);
      Exit;
    End;
  If line = 'rep movsb' Then
    Begin
      Emit0(asm_ctx^, OP_REP_MOVSB);
      Exit;
    End;
  p := Pos(' ', line);
  If p = 0 Then
    Begin
      m := line;
      rest := '';
    End
  Else
    Begin
      m := Copy(line, 1, p - 1);
      rest := AsmTrim(Copy(line, p + 1, Length(line) - p));
    End;
  op := AsmFindOp(m);
  If op = OP_NONE Then
    Begin
      AsmFail('mnemonique inconnu ' + m, line0);
      Exit;
    End;
  { separer les deux operandes a la premiere virgule hors crochets }
  a1 := rest;
  a2 := '';
  depth := 0;
  For i := 1 To Length(rest) Do
    Begin
      If rest[i] = '[' Then
        Inc(depth)
      Else If rest[i] = ']' Then
        Dec(depth)
      Else If (rest[i] = ',') And (depth = 0) Then
        Begin
          a1 := Copy(rest, 1, i - 1);
          a2 := Copy(rest, i + 1, Length(rest) - i);
          Break;
        End;
    End;
  If op = OP_FNSTSW Then
    a1 := '';
  AsmOperand(a1, oa, line0);
  AsmOperand(a2, ob, line0);
  { un registre 8 bits impose la taille octet a l'autre operande memoire }
  If ((oa.kind = OD_REG) And IsReg8(oa.reg) And (op <> OP_SHL) And (op <> OP_SHR) And
      (op <> OP_SAR)) Or ((ob.kind = OD_REG) And IsReg8(ob.reg) And (op <> OP_SHL) And
      (op <> OP_SHR) And (op <> OP_SAR)) Then
    Begin
      If oa.kind = OD_MEM Then
        oa.size := 1;
      If ob.kind = OD_MEM Then
        ob.size := 1;
    End;
  Emit(asm_ctx^, op, oa, ob);
End;

{ Etiquette locale unique pour les macros d'assembleur. }
Function U(Const prefix: TString): TString;
Var
  s: String[12];
Begin
  Inc(asm_uniq);
  Str(asm_uniq, s);
  U := '.' + prefix + s;
End;

{ ---- Donnees statiques du runtime ---- }

{ Symbole de la chaine statique text (elle est creee si besoin). }
Function RtStr(Const text: TString): TString;
Var
  id: LongInt;
Begin
  id := InternText(asm_ctx^, text);
  If (id <> 0) And (StrP(asm_ctx^.data.strs, id)^.sym = 0) Then
    EmitStringCell(asm_ctx^, id);
  RtStr := SymStr(id);
End;

{ Octets d'une chaine C (zero final) dans .rdata. }
Procedure RtCString(Const name, text: TString);
Var
  ofs, i: LongInt;
Begin
  ofs := SecAlloc(asm_ctx^, SEC_RDATA, Length(text) + 1);
  For i := 1 To Length(text) Do
    PutByte(asm_ctx^, SEC_RDATA, ofs + i - 1, Ord(text[i]));
  NewDataSym(asm_ctx^, name, SEC_RDATA, ofs, Length(text) + 1, DS_STRING);
End;

{ Constante de 8 octets (double) en .rdata. }
Procedure RtQword(Const name: TString; v: Double);
Var
  q: Int64;
  ofs: LongInt;
Begin
  Move(v, q, 8);
  ofs := SecAlloc(asm_ctx^, SEC_RDATA, 8);
  PutDword(asm_ctx^, SEC_RDATA, ofs, ToLong(q And $FFFFFFFF));
  PutDword(asm_ctx^, SEC_RDATA, ofs + 4, ToLong((q Shr 32) And $FFFFFFFF));
  NewDataSym(asm_ctx^, name, SEC_RDATA, ofs, 8, DS_FDESC);
End;

{ Mot de 4 octets en .rdata. }
Procedure RtDword(Const name: TString; v: LongInt);
Var
  ofs: LongInt;
Begin
  ofs := SecAlloc(asm_ctx^, SEC_RDATA, 4);
  PutDword(asm_ctx^, SEC_RDATA, ofs, v);
  NewDataSym(asm_ctx^, name, SEC_RDATA, ofs, 4, DS_FDESC);
End;

{ Nom de symbole de donnees unique (un meme code peut avoir plusieurs objets fonction). }
Function UniqDName(Const base: TString): TString;
Var
  k: LongInt;
  r: TString;
Begin
  r := base;
  k := 1;
  While DsymFind(asm_ctx^, r) <> 0 Do
    Begin
      Inc(k);
      r := base + '_' + IntToStr(k);
    End;
  UniqDName := r;
End;

{ Descripteur de fonction statique pour le code ; retourne son symbole. }
Function RtDescSym(Const jsname, code: TString; nparams, flags: LongInt): LongInt;
Var
  fd_ofs: LongInt;
Begin
  fd_ofs := SecAlloc(asm_ctx^, SEC_RDATA, RT_FD_SIZE);
  AddReloc(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_NAME,
           DsymFind(asm_ctx^, RtStr(jsname)));
  PutDword(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_NPARAMS, nparams);
  PutDword(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_FLAGS, flags);
  RtDescSym := NewDataSym(asm_ctx^, UniqDName('_JSND_' + code), SEC_RDATA, fd_ofs, RT_FD_SIZE,
                          DS_FDESC);
End;

{ Objet fonction natif statique ; retourne le symbole de donnees. }
Function RtFuncObjP(Const jsname, code: TString; nparams, props: LongInt): LongInt;
Var
  fd_ofs, fo_ofs, fd_sym, fsec, ffl: LongInt;
Begin
  { les constructeurs a proprietes statiques sont modifiables (Array.from = ...) }
  If props <> 0 Then
    Begin
      fsec := SEC_DATA;
      ffl := 0;
    End
  Else
    Begin
      fsec := SEC_RDATA;
      ffl := OF_STATIC;
    End;
  fd_ofs := SecAlloc(asm_ctx^, SEC_RDATA, RT_FD_SIZE);
  AddReloc(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_NAME,
           DsymFind(asm_ctx^, RtStr(jsname)));
  PutDword(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_NPARAMS, nparams);
  PutDword(asm_ctx^, SEC_RDATA, fd_ofs + RT_FD_FLAGS, FDF_NATIVE);
  fd_sym := NewDataSym(asm_ctx^, UniqDName('_JSND_' + code), SEC_RDATA, fd_ofs, RT_FD_SIZE,
                       DS_FDESC);
  fo_ofs := SecAlloc(asm_ctx^, fsec, RT_FN_SIZE);
  PutByte(asm_ctx^, fsec, fo_ofs + RT_HDR_KIND, RT_OK_FUNCTION);
  PutByte(asm_ctx^, fsec, fo_ofs + RT_HDR_FLAGS, ffl);
  AddRelocX(asm_ctx^, fsec, fo_ofs + RT_FN_CODE, XSym(asm_ctx^, code));
  AddReloc(asm_ctx^, fsec, fo_ofs + RT_FN_DESC, fd_sym);
  If props <> 0 Then
    AddReloc(asm_ctx^, fsec, fo_ofs + RT_FN_PROPS, props);
  PutDword(asm_ctx^, fsec, fo_ofs + RT_FN_THIS + 4, TagImm(RT_T_UNDEFINED));
  RtFuncObjP := NewDataSym(asm_ctx^, UniqDName('_JSNF_' + code), fsec, fo_ofs, RT_FN_SIZE,
                          DS_FDESC);
End;

Function RtFuncObj(Const jsname, code: TString; nparams: LongInt): LongInt;
Begin
  RtFuncObj := RtFuncObjP(jsname, code, nparams, 0);
End;

{ Construction d'un objet statique : proprietes ajoutees puis objet cree. }
Var
  bo_key: TDynList;
  bo_val: TDynList;
  bo_tag: TDynList;
  bo_hi: TDynList;
  bo_n: LongInt;

Type
  P_bo_hi = ^LongInt;

Function bo_hiP(Var l: TDynList; i: LongInt): P_bo_hi;
Begin
  bo_hiP := P_bo_hi(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_bo_tag = ^LongInt;

Function bo_tagP(Var l: TDynList; i: LongInt): P_bo_tag;
Begin
  bo_tagP := P_bo_tag(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_bo_val = ^LongInt;

Function bo_valP(Var l: TDynList; i: LongInt): P_bo_val;
Begin
  bo_valP := P_bo_val(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  T_bo_key = String[40];
  P_bo_key = ^T_bo_key;

Function bo_keyP(Var l: TDynList; i: LongInt): P_bo_key;
Begin
  bo_keyP := P_bo_key(DlPtr(l, i - 1, SizeOf(T_bo_key)));
End;

Procedure BoReset;
Begin
  bo_n := 0;
End;

Procedure BoAdd(Const key: TString; valsym, tag: LongInt);
Begin
  Inc(bo_n);
  bo_keyP(bo_key, bo_n)^ := key;
  bo_valP(bo_val, bo_n)^ := valsym;
  bo_tagP(bo_tag, bo_n)^ := tag;
End;

{ Propriete dont la valeur est une constante de 8 octets (nombre). }
Procedure BoAddNum(Const key: TString; v: Double);
Var
  q: Int64;
Begin
  Move(v, q, 8);
  Inc(bo_n);
  bo_keyP(bo_key, bo_n)^ := key;
  bo_valP(bo_val, bo_n)^ := ToLong(q And $FFFFFFFF);
  bo_hiP(bo_hi, bo_n)^ := ToLong((q Shr 32) And $FFFFFFFF);
  bo_tagP(bo_tag, bo_n)^ := -1;
End;

{ proto : symbole de donnees du prototype (0 aucun). }
Function BoFinish(Const name: TString; proto: LongInt): LongInt;
Var
  props_ofs, obj_ofs, i, props_sym: LongInt;
Begin
  props_sym := 0;
  props_ofs := 0;
  If bo_n > 0 Then
    Begin
      props_ofs := SecAlloc(asm_ctx^, SEC_RDATA, RT_PROP_SIZE * bo_n);
      For i := 1 To bo_n Do
        Begin
          AddReloc(asm_ctx^, SEC_RDATA, props_ofs + RT_PROP_SIZE * (i - 1) + RT_PROP_KEY,
                   DsymFind(asm_ctx^, RtStr(bo_keyP(bo_key, i)^)));
          If bo_tagP(bo_tag, i)^ = -1 Then
            Begin
              PutDword(asm_ctx^, SEC_RDATA,
                       props_ofs + RT_PROP_SIZE * (i - 1) + RT_PROP_VALUE, bo_valP(bo_val, i)^);
              PutDword(asm_ctx^, SEC_RDATA,
                       props_ofs + RT_PROP_SIZE * (i - 1) + RT_PROP_VALUE + 4, bo_hiP(bo_hi, i)^);
            End
          Else
            Begin
              AddReloc(asm_ctx^, SEC_RDATA,
                       props_ofs + RT_PROP_SIZE * (i - 1) + RT_PROP_VALUE, bo_valP(bo_val, i)^);
              PutDword(asm_ctx^, SEC_RDATA,
                       props_ofs + RT_PROP_SIZE * (i - 1) + RT_PROP_VALUE + 4,
                       TagImm(bo_tagP(bo_tag, i)^));
            End;
        End;
      props_sym := NewDataSym(asm_ctx^, name + '_props', SEC_RDATA, props_ofs,
                              RT_PROP_SIZE * bo_n, DS_FDESC);
    End;
  { l'en-tete est dans .data (modifiable) ; le tableau de proprietes reste
    en lecture seule et est copie au premier changement }
  obj_ofs := SecAlloc(asm_ctx^, SEC_DATA, RT_OBJ_SIZE);
  PutByte(asm_ctx^, SEC_DATA, obj_ofs + RT_HDR_KIND, RT_OK_OBJECT);
  If bo_n > 0 Then
    PutByte(asm_ctx^, SEC_DATA, obj_ofs + RT_HDR_FLAGS, OF_STATIC Or OF_ROPROPS)
  Else
    PutByte(asm_ctx^, SEC_DATA, obj_ofs + RT_HDR_FLAGS, OF_STATIC);
  If proto <> 0 Then
    AddReloc(asm_ctx^, SEC_DATA, obj_ofs + RT_OBJ_PROTO, proto);
  If bo_n > 0 Then
    AddReloc(asm_ctx^, SEC_DATA, obj_ofs + RT_OBJ_PROPS, props_sym);
  PutDword(asm_ctx^, SEC_DATA, obj_ofs + RT_OBJ_COUNT, bo_n);
  PutDword(asm_ctx^, SEC_DATA, obj_ofs + RT_OBJ_CAP, bo_n);
  BoFinish := NewDataSym(asm_ctx^, name, SEC_DATA, obj_ofs, RT_OBJ_SIZE, DS_GLOBAL);
End;

{ Variable globale du runtime _JSRT_g_nom (valeur de 8 octets) qui designe
  l'objet ou la fonction de symbole sym. }
Var
  gl_name: TDynList;
  gl_sym: TDynList;
  gl_tag: TDynList;
  gl_n: LongInt;

Type
  P_gl_tag = ^LongInt;

Function gl_tagP(Var l: TDynList; i: LongInt): P_gl_tag;
Begin
  gl_tagP := P_gl_tag(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_gl_sym = ^LongInt;

Function gl_symP(Var l: TDynList; i: LongInt): P_gl_sym;
Begin
  gl_symP := P_gl_sym(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  T_gl_name = String[20];
  P_gl_name = ^T_gl_name;

Function gl_nameP(Var l: TDynList; i: LongInt): P_gl_name;
Begin
  gl_nameP := P_gl_name(DlPtr(l, i - 1, SizeOf(T_gl_name)));
End;

Procedure RtGlobal(Const name: TString; sym, tag: LongInt);
Var
  ofs: LongInt;
Begin
  Inc(gl_n);
  gl_nameP(gl_name, gl_n)^ := name;
  gl_symP(gl_sym, gl_n)^ := sym;
  gl_tagP(gl_tag, gl_n)^ := tag;
  ofs := SecAlloc(asm_ctx^, SEC_DATA, RT_VALUE_SIZE);
  AddReloc(asm_ctx^, SEC_DATA, ofs, sym);
  PutDword(asm_ctx^, SEC_DATA, ofs + 4, TagImm(tag));
  NewDataSym(asm_ctx^, SymRt('g_' + name), SEC_DATA, ofs, RT_VALUE_SIZE, DS_GLOBAL);
End;

{ ---- Demarrage, allocateur, erreurs ---- }

Procedure RtStartAndAlloc;
Begin
  A('proc _JSSTART');
  A('call _JSRT_init');
  A('call _JSRT_main');
  A('push 0');
  A('call dword ptr [__imp__ExitProcess@4]');
  A('endp');

  A('proc _JSRT_init');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, esp');
  A('sub eax, ' + IntToStr(RT_STACK_RESERVE - RT_STACK_GUARD));
  A('mov dword ptr [_JSRT_v_stack_limit], eax');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('push -11');
  A('call dword ptr [__imp__GetStdHandle@4]');
  A('mov dword ptr [_JSRT_v_stdout], eax');
  A('push -12');
  A('call dword ptr [__imp__GetStdHandle@4]');
  A('mov dword ptr [_JSRT_v_stderr], eax');
  A('push -10');
  A('call dword ptr [__imp__GetStdHandle@4]');
  A('mov dword ptr [_JSRT_v_stdin], eax');
  A('call _JSRT_args_init');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_alloc(taille) -> EAX : bloc de 8 octets alignes, mis a zero }
  A('proc _JSRT_alloc');
  A('push ebp');
  A('mov ebp, esp');
  A('mov ecx, dword ptr [ebp+8]');
  A('add ecx, 7');
  A('and ecx, -8');
  A('cmp ecx, ' + IntToStr(RT_BIG_ALLOC));
  A('jae .big');
  A('mov eax, dword ptr [_JSRT_v_heap_cur]');
  A('lea edx, [eax+ecx]');
  A('cmp edx, dword ptr [_JSRT_v_heap_end]');
  A('ja .grow');
  A('mov dword ptr [_JSRT_v_heap_cur], edx');
  A('leave');
  A('ret');
  A('.grow:');
  A('push ecx');
  A('push 4');
  A('push 12288');
  A('push ' + IntToStr(RT_ARENA_SIZE));
  A('push 0');
  A('call dword ptr [__imp__VirtualAlloc@16]');
  A('pop ecx');
  A('test eax, eax');
  A('jz .oom');
  A('lea edx, [eax+ecx]');
  A('mov dword ptr [_JSRT_v_heap_cur], edx');
  A('lea edx, [eax+' + IntToStr(RT_ARENA_SIZE) + ']');
  A('mov dword ptr [_JSRT_v_heap_end], edx');
  A('leave');
  A('ret');
  A('.big:');
  A('push 4');
  A('push 12288');
  A('push ecx');
  A('push 0');
  A('call dword ptr [__imp__VirtualAlloc@16]');
  A('test eax, eax');
  A('jz .oom');
  A('leave');
  A('ret');
  A('.oom:');
  A('push offset _JSRT_c_oom');
  A('call _JSRT_fatal');
  A('endp');

  { _JSRT_write(handle, octets, nombre) }
  A('proc _JSRT_write');
  A('push ebp');
  A('mov ebp, esp');
  A('sub esp, 4');
  A('push 0');
  A('lea eax, [ebp-4]');
  A('push eax');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call dword ptr [__imp__WriteFile@20]');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_write_cstr(handle, chaine C) }
  A('proc _JSRT_write_cstr');
  A('push ebp');
  A('mov ebp, esp');
  A('push esi');
  A('mov esi, dword ptr [ebp+12]');
  A('xor ecx, ecx');
  A('.len:');
  A('cmp byte ptr [esi+ecx], 0');
  A('je .got');
  A('inc ecx');
  A('jmp .len');
  A('.got:');
  A('push ecx');
  A('push esi');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_write');
  A('add esp, 12');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_fatal(chaine C) : message sur stderr puis fin du processus }
  A('proc _JSRT_die');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [_JSRT_v_stderr]');
  A('call _JSRT_write_cstr');
  A('add esp, 8');
  A('push 1');
  A('call dword ptr [__imp__ExitProcess@4]');
  A('leave');
  A('ret');
  A('endp');

  A('proc _JSRT_throw_notfunc');
  A('push offset _JSRT_c_notfunc');
  A('call _JSRT_fatal');
  A('endp');

  A('proc _JSRT_throw_type');
  A('push offset _JSRT_c_type');
  A('call _JSRT_fatal');
  A('endp');

  A('proc _JSRT_stack_overflow');
  A('push offset _JSRT_c_stack');
  A('call _JSRT_fatal');
  A('endp');

End;

{ ---- Chaines : creation, concatenation, conversions ---- }

Procedure RtStrings;
Begin
  { _JSRT_str_new(longueur) -> EAX : cellule de chaine (octets a ecrire) }
  A('proc _JSRT_str_new');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+8]');
  A('add eax, ' + IntToStr(RT_STR_DATA + 1));
  A('push eax');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov byte ptr [eax], $OK_STRING');
  A('mov ecx, dword ptr [ebp+8]');
  A('mov dword ptr [eax+$STR_LEN], ecx');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_concat(a, b) : deux chaines -> chaine }
  A('proc _JSRT_concat');
  A('push ebp');
  A('mov ebp, esp');
  A('push esi');
  A('push edi');
  A('push ebx');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+16]');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('test ecx, ecx');
  A('jnz .a_ok');
  A('mov eax, edi');
  A('jmp .done');
  A('.a_ok:');
  A('mov edx, dword ptr [edi+$STR_LEN]');
  A('test edx, edx');
  A('jnz .both');
  A('mov eax, esi');
  A('jmp .done');
  A('.both:');
  A('lea ebx, [ecx+edx]');
  A('push ebx');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('push eax');
  A('mov edi, eax');
  A('add edi, $STR_DATA');
  A('mov esi, dword ptr [ebp+8]');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('add esi, $STR_DATA');
  A('rep movsb');
  A('mov esi, dword ptr [ebp+16]');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('add esi, $STR_DATA');
  A('rep movsb');
  A('pop eax');
  A('.done:');
  A('mov edx, $STR');
  A('pop ebx');
  A('pop edi');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_int_to_str(n) : entier signe -> chaine decimale }
  A('proc _JSRT_int_to_str');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('sub esp, 16');
  A('mov eax, dword ptr [ebp+8]');
  A('mov ebx, eax');
  A('test eax, eax');
  A('jns .pos');
  A('neg eax');
  A('.pos:');
  A('lea esi, [ebp-12]');
  A('mov ecx, 10');
  A('.loop:');
  A('xor edx, edx');
  A('div ecx');
  A('add edx, 48');
  A('dec esi');
  A('mov byte ptr [esi], dl');
  A('test eax, eax');
  A('jnz .loop');
  A('test ebx, ebx');
  A('jns .nosign');
  A('dec esi');
  A('mov byte ptr [esi], 45');
  A('.nosign:');
  A('lea eax, [ebp-12]');
  A('sub eax, esi');
  A('mov edi, eax');
  A('push edi');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('mov ecx, edi');
  A('mov edi, eax');
  A('add edi, $STR_DATA');
  A('rep movsb');
  A('mov edx, $STR');
  A('add esp, 16');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_tostring(v) -> chaine (ToString des primitives) }
  A('proc _JSRT_tostring');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+8]');
  A('mov edx, dword ptr [ebp+12]');
  A('cmp edx, $STR');
  A('je .self');
  A('cmp edx, $INT');
  A('je .int');
  A('jb .dbl');
  A('cmp edx, $BOOL');
  A('je .bool');
  A('cmp edx, $UNDEF');
  A('je .undef');
  A('cmp edx, $NULL');
  A('je .null');
  A('cmp edx, $FN');
  A('je .fn');
  A('cmp edx, $ARR');
  A('je .arr');
  A('cmp edx, $OBJ');
  A('je .objs');
  A('cmp edx, $RX');
  A('je .rx');
  A('mov eax, offset ' + RtStr('[object Object]'));
  A('jmp .str');
  A('.rx:');
  A('push eax');
  A('call _JSRT_rx_tostring');
  A('leave');
  A('ret');
  A('.arr:');
  A('push offset ' + RtStr(','));
  A('push eax');
  A('call _JSRT_arr_join');
  A('leave');
  A('ret');
  A('.objs:');
  A('push offset ' + RtStr('toString'));
  A('push eax');
  A('call _JSRT_prop_lookup');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .objdef');
  A('test dword ptr [eax+4], 2');
  A('jnz .objdef');
  A('cmp dword ptr [eax+12], $FN');
  A('jne .objdef');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [eax+8]');
  A('call _JSRT_call0');
  A('add esp, 12');
  A('cmp edx, $STR');
  A('je .objret');
  A('.objdef:');
  A('mov eax, offset ' + RtStr('[object Object]'));
  A('mov edx, $STR');
  A('.objret:');
  A('leave');
  A('ret');
  A('.fn:');
  A('mov eax, offset ' + RtStr('function'));
  A('jmp .str');
  A('.bool:');
  A('test eax, eax');
  A('jz .false');
  A('mov eax, offset ' + RtStr('true'));
  A('jmp .str');
  A('.false:');
  A('mov eax, offset ' + RtStr('false'));
  A('jmp .str');
  A('.undef:');
  A('mov eax, offset ' + RtStr('undefined'));
  A('jmp .str');
  A('.null:');
  A('mov eax, offset ' + RtStr('null'));
  A('.str:');
  A('mov edx, $STR');
  A('.self:');
  A('leave');
  A('ret');
  A('.int:');
  A('push eax');
  A('call _JSRT_int_to_str');
  A('add esp, 4');
  A('leave');
  A('ret');
  A('.dbl:');
  A('push edx');
  A('push eax');
  A('call _JSRT_double_to_str');
  A('add esp, 8');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_str_equal(pa, pb) -> EAX = 0 ou 1 (contenu des chaines) }
  A('proc _JSRT_str_equal');
  A('push ebp');
  A('mov ebp, esp');
  A('push esi');
  A('push edi');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+12]');
  A('cmp esi, edi');
  A('je .eq');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('cmp ecx, dword ptr [edi+$STR_LEN]');
  A('jne .ne');
  A('add esi, $STR_DATA');
  A('add edi, $STR_DATA');
  A('.loop:');
  A('test ecx, ecx');
  A('jz .eq');
  A('mov al, byte ptr [esi]');
  A('cmp al, byte ptr [edi]');
  A('jne .ne');
  A('inc esi');
  A('inc edi');
  A('dec ecx');
  A('jmp .loop');
  A('.eq:');
  A('mov eax, 1');
  A('jmp .out');
  A('.ne:');
  A('xor eax, eax');
  A('.out:');
  A('pop edi');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_str_cmp(pa, pb) -> EAX = -1, 0 ou 1 (ordre des octets) }
  A('proc _JSRT_str_cmp');
  A('push ebp');
  A('mov ebp, esp');
  A('push esi');
  A('push edi');
  A('sub esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+12]');
  A('mov eax, dword ptr [esi+$STR_LEN]');
  A('mov dword ptr [ebp-12], eax');
  A('mov eax, dword ptr [edi+$STR_LEN]');
  A('mov dword ptr [ebp-16], eax');
  A('mov ecx, dword ptr [ebp-12]');
  A('cmp ecx, dword ptr [ebp-16]');
  A('jbe .m');
  A('mov ecx, dword ptr [ebp-16]');
  A('.m:');
  A('add esi, $STR_DATA');
  A('add edi, $STR_DATA');
  A('.loop:');
  A('test ecx, ecx');
  A('jz .lens');
  A('movzx eax, byte ptr [esi]');
  A('movzx edx, byte ptr [edi]');
  A('cmp eax, edx');
  A('jb .less');
  A('ja .greater');
  A('inc esi');
  A('inc edi');
  A('dec ecx');
  A('jmp .loop');
  A('.lens:');
  A('mov eax, dword ptr [ebp-12]');
  A('cmp eax, dword ptr [ebp-16]');
  A('jb .less');
  A('ja .greater');
  A('xor eax, eax');
  A('jmp .out');
  A('.less:');
  A('mov eax, -1');
  A('jmp .out');
  A('.greater:');
  A('mov eax, 1');
  A('.out:');
  A('add esp, 8');
  A('pop edi');
  A('pop esi');
  A('pop ebp');
  A('ret');
  A('endp');
End;

{ ---- Egalite et addition ---- }

Procedure RtEquality;
Begin
  { _JSRT_seq(a, b) : === ; booleen dans EDX:EAX }
  A('proc _JSRT_seq');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+12]');
  A('cmp eax, dword ptr [ebp+20]');
  A('jne .diff');
  A('cmp eax, $INT');
  A('jb .num');
  A('cmp eax, $STR');
  A('je .str');
  A('cmp eax, $UNDEF');
  A('je .true');
  A('cmp eax, $NULL');
  A('je .true');
  A('mov ecx, dword ptr [ebp+8]');
  A('cmp ecx, dword ptr [ebp+16]');
  A('jne .false');
  A('.true:');
  A('mov eax, 1');
  A('jmp .ret');
  A('.str:');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('jmp .ret');
  A('.num:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_num_eq');
  A('add esp, 16');
  A('jmp .ret');
  A('.diff:');
  A('cmp eax, $INT');
  A('ja .false');
  A('mov ecx, dword ptr [ebp+20]');
  A('cmp ecx, $INT');
  A('ja .false');
  A('jmp .num');
  A('.false:');
  A('xor eax, eax');
  A('.ret:');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_eq(a, b) : == }
  A('proc _JSRT_eq');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+12]');
  A('mov ecx, dword ptr [ebp+20]');
  A('cmp eax, ecx');
  A('je .same');
  A('cmp eax, $INT');
  A('jbe .an');
  A('cmp eax, $UNDEF');
  A('je .au');
  A('cmp eax, $NULL');
  A('je .au');
  A('jmp .slow');
  A('.an:');
  A('cmp ecx, $INT');
  A('jbe .same');
  A('jmp .slow');
  A('.au:');
  A('cmp ecx, $UNDEF');
  A('je .true');
  A('cmp ecx, $NULL');
  A('je .true');
  A('xor eax, eax');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('.true:');
  A('mov eax, 1');
  A('mov edx, $BOOL');
  A('leave');
  A('ret');
  A('.same:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_seq');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('.slow:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_eq_slow');
  A('add esp, 16');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_add(a, b) : + (concatenation ou addition numerique) }
  A('proc _JSRT_add');
  A('push ebp');
  A('mov ebp, esp');
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jne .a1');
  A('push 1');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+8], eax');
  A('mov dword ptr [ebp+12], edx');
  A('.a1:');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jne .b1');
  A('push 1');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+16], eax');
  A('mov dword ptr [ebp+20], edx');
  A('.b1:');
