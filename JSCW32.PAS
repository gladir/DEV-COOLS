{ ---- Nombres : conversions texte <-> nombre ---- }

Function LvQ(k: LongInt): TString;
Begin
  LvQ := 'qword ptr [ebp-' + IntToStr(12 + 4 * k) + ']';
End;

Procedure RtNumConv;
Const
  NL = 48;
