  A('je .done');
  A('or eax, 2');
  A('jmp .done');
  A('.none:');
  A('xor eax, eax');
  A('.done:');
  A('mov edx, $INT');
  FEnd;

  { __write(fd, chaine) : ecriture brute }
  FBegin('_JSRT_n_write', 0);
  A('cmp dword ptr [ebp+12], 2');
  A('jb .ret');
  A('mov eax, dword ptr [_JSRT_v_stdout]');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + '], 2');
  A('jne .go');
  A('mov eax, dword ptr [_JSRT_v_stderr]');
  A('.go:');
  A('mov ebx, eax');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push dword ptr [eax+$STR_LEN]');
  A('add eax, $STR_DATA');
  A('push eax');
  A('push ebx');
  A('call _JSRT_write');
  A('add esp, 12');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { __setgrp(n) : indicateur d'indentation de console.group }
  FBegin('_JSRT_n_setgrp', 0);
  A('xor eax, eax');
  A('cmp dword ptr [ebp+12], 1');
  A('jb .set');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('.set:');
  A('mov dword ptr [_JSRT_v_grp], eax');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  HostWrite('_JSRT_stdout_write', '_JSRT_v_stdout');
  HostWrite('_JSRT_stderr_write', '_JSRT_v_stderr');

  { prompt(message) : lit une ligne sur stdin, null en fin de fichier }
  FBegin('_JSRT_prompt', 2);
  A('cmp dword ptr [ebp+12], 1');
  A('jb .read');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push dword ptr [eax+$STR_LEN]');
  A('add eax, $STR_DATA');
  A('push eax');
  A('push dword ptr [_JSRT_v_stdout]');
  A('call _JSRT_write');
  A('add esp, 12');
  A('.read:');
  A('call _JSRT_sb_new');
  A('mov esi, eax');
  A('xor edi, edi');
  A('.l:');
  A('mov ' + Lv(2) + ', 0');
  A('push 0');
  A('lea eax, [ebp-' + IntToStr(12 + 4 * 2) + ']');
  A('push eax');
  A('push 1');
  A('lea eax, [ebp-' + IntToStr(12 + 4 * 1) + ']');
  A('push eax');
  A('push dword ptr [_JSRT_v_stdin]');
  A('call dword ptr [__imp__ReadFile@20]');
  A('test eax, eax');
  A('jz .eof');
  A('cmp ' + Lv(2) + ', 0');
  A('je .eof');
  A('mov eax, ' + Lv(1));
  A('and eax, 255');
  A('cmp eax, 10');
  A('je .done');
  A('cmp eax, 13');
  A('je .l');
  A('push eax');
  A('push esi');
  A('call _JSRT_sb_addb');
  A('add esp, 8');
  A('inc edi');
  A('jmp .l');
  A('.eof:');
  A('test edi, edi');
  A('jnz .done');
  A('xor eax, eax');
  A('mov edx, $NULL');
  A('jmp .ret');
  A('.done:');
  A('push esi');
  A('call _JSRT_sb_str');
  A('add esp, 4');
  FEnd;

  { _JSRT_args_init : process.argv depuis GetCommandLineA ;
    argv = [executable, executable (comme le script de node), arguments...] }
  FBegin('_JSRT_args_init', 2);
  A('call dword ptr [__imp__GetCommandLineA@0]');
  A('mov esi, eax');
  A('mov ' + Lv(1) + ', 0');
  A('.tok:');
  A('movzx eax, byte ptr [esi]');
  A('cmp eax, 32');
  A('jne .nsp');
  A('inc esi');
  A('jmp .tok');
  A('.nsp:');
  A('test eax, eax');
  A('jz .ret');
  A('call _JSRT_sb_new');
  A('mov ebx, eax');
  A('xor edi, edi');
  A('.ch:');
  A('movzx eax, byte ptr [esi]');
  A('test eax, eax');
  A('jz .end');
  A('cmp eax, 34');
  A('jne .nq');
  A('xor edi, 1');
  A('inc esi');
  A('jmp .ch');
  A('.nq:');
  A('cmp eax, 32');
  A('jne .add');
  A('test edi, edi');
  A('jz .end');
  A('.add:');
  A('push eax');
  A('push ebx');
  A('call _JSRT_sb_addb');
  A('add esp, 8');
  A('inc esi');
  A('jmp .ch');
  A('.end:');
  A('push ebx');
  A('call _JSRT_sb_str');
  A('add esp, 4');
  A('mov ebx, eax');
  A('push $STR');
  A('push ebx');
  A('push $ARR');
  A('push offset _JSNO_argv');
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('cmp ' + Lv(1) + ', 0');
  A('jne .nodup');
  A('push $STR');
  A('push ebx');
  A('push $ARR');
  A('push offset _JSNO_argv');
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('.nodup:');
  A('inc ' + Lv(1));
  A('jmp .tok');
  FEnd;
End;

{ Objet process et globales de l'hote. }
Procedure RtProcessData(oproto: LongInt);
Var
  ofs, argv_sym, so, se, env: LongInt;
Begin
  { tableau argv statique (rempli par _JSRT_args_init) }
  ofs := SecAlloc(asm_ctx^, SEC_DATA, RT_ARR_SIZE);
  PutByte(asm_ctx^, SEC_DATA, ofs + RT_HDR_KIND, RT_OK_ARRAY);
  argv_sym := NewDataSym(asm_ctx^, '_JSNO_argv', SEC_DATA, ofs, RT_ARR_SIZE, DS_GLOBAL);
  BoReset;
  BoAdd('write', RtFuncObj('write', '_JSRT_stdout_write', 1), RT_T_FUNCTION);
  so := BoFinish('_JSNO_process_stdout', oproto);
  BoReset;
  BoAdd('write', RtFuncObj('write', '_JSRT_stderr_write', 1), RT_T_FUNCTION);
  se := BoFinish('_JSNO_process_stderr', oproto);
  BoReset;
  env := BoFinish('_JSNO_process_env', oproto);
  BoReset;
  BoAdd('exit', RtFuncObj('exit', '_JSRT_process_exit', 1), RT_T_FUNCTION);
  BoAdd('argv', argv_sym, RT_T_ARRAY);
  BoAdd('stdout', so, RT_T_OBJECT);
  BoAdd('stderr', se, RT_T_OBJECT);
  BoAdd('env', env, RT_T_OBJECT);
  BoAdd('platform', DsymFind(asm_ctx^, RtStr('win32')), RT_T_STRING);
  RtGlobal('process', BoFinish('_JSNO_process', oproto), RT_T_OBJECT);
  RtGlobal('alert', RtFuncObj('alert', '_JSRT_console_log', 1), RT_T_FUNCTION);
  RtGlobal('prompt', RtFuncObj('prompt', '_JSRT_prompt', 1), RT_T_FUNCTION);
  RtGlobal('__fname', RtFuncObj('__fname', '_JSRT_n_fname', 1), RT_T_FUNCTION);
  RtGlobal('__fflags', RtFuncObj('__fflags', '_JSRT_n_fflags', 1), RT_T_FUNCTION);
  RtGlobal('__fparent', RtFuncObj('__fparent', '_JSRT_n_fparent', 1), RT_T_FUNCTION);
  RtGlobal('__extras', RtFuncObj('__extras', '_JSRT_n_extras', 1), RT_T_FUNCTION);
  RtGlobal('__acc', RtFuncObj('__acc', '_JSRT_n_acc', 2), RT_T_FUNCTION);
  RtGlobal('__write', RtFuncObj('__write', '_JSRT_n_write', 2), RT_T_FUNCTION);
  RtGlobal('__setgrp', RtFuncObj('__setgrp', '_JSRT_n_setgrp', 1), RT_T_FUNCTION);
  RtGlobal('__ptr', RtFuncObj('__ptr', '_JSRT_n_ptr', 1), RT_T_FUNCTION);
  RtGlobal('__ftime', RtFuncObj('__ftime', '_JSRT_n_ftime', 1), RT_T_FUNCTION);
  RtGlobal('__sleep', RtFuncObj('__sleep', '_JSRT_n_sleep', 1), RT_T_FUNCTION);
  RtGlobal('__gc', RtFuncObj('__gc', '_JSRT_n_gc', 0), RT_T_FUNCTION);
  RtGlobal('__gcstats', RtFuncObj('__gcstats', '_JSRT_n_gcstats', 0), RT_T_FUNCTION);
  RtGlobal('__gcstress', RtFuncObj('__gcstress', '_JSRT_n_gcstress', 1), RT_T_FUNCTION);
  RtGlobal('__gen_resume', RtFuncObj('__gen_resume', '_JSRT_n_gen_resume', 3), RT_T_FUNCTION);
  RtGlobal('__gen_done', RtFuncObj('__gen_done', '_JSRT_n_gen_done', 1), RT_T_FUNCTION);
  RtGlobal('__invoke', RtFuncObj('__invoke', '_JSRT_n_invoke', 3), RT_T_FUNCTION);
  RtGlobal('__newtarget', RtFuncObj('__newtarget', '_JSRT_n_newtarget', 0), RT_T_FUNCTION);
  RtGlobal('__fproto', RtFuncObj('__fproto', '_JSRT_n_fproto', 0), RT_T_FUNCTION);
  RtGlobal('__u16', RtFuncObj('__u16', '_JSRT_n_u16', 1), RT_T_FUNCTION);
  RtGlobal('__fromu16', RtFuncObj('__fromu16', '_JSRT_n_fromu16', 1), RT_T_FUNCTION);
  RtGlobal('__b2u', RtFuncObj('__b2u', '_JSRT_n_b2u', 2), RT_T_FUNCTION);
  RtGlobal('__u2b', RtFuncObj('__u2b', '_JSRT_n_u2b', 2), RT_T_FUNCTION);
  RtGlobal('__raw', RtFuncObj('__raw', '_JSRT_n_raw', 1), RT_T_FUNCTION);
  { methodes natives de chaine, octets : __nsm.nom.call(chaine, ...) avec __raw(1) }
  BoReset;
  BoAdd('indexOf', RtFuncObj('indexOf', '_JSRT_sm_indexOf', 1), RT_T_FUNCTION);
  BoAdd('lastIndexOf', RtFuncObj('lastIndexOf', '_JSRT_sm_lastIndexOf', 1), RT_T_FUNCTION);
  BoAdd('startsWith', RtFuncObj('startsWith', '_JSRT_sm_startsWith', 1), RT_T_FUNCTION);
  BoAdd('endsWith', RtFuncObj('endsWith', '_JSRT_sm_endsWith', 1), RT_T_FUNCTION);
  BoAdd('slice', RtFuncObj('slice', '_JSRT_sm_slice', 2), RT_T_FUNCTION);
  BoAdd('substring', RtFuncObj('substring', '_JSRT_sm_substring', 2), RT_T_FUNCTION);
  BoAdd('split', RtFuncObj('split', '_JSRT_sm_split', 2), RT_T_FUNCTION);
  BoAdd('trim', RtFuncObj('trim', '_JSRT_sm_trim', 0), RT_T_FUNCTION);
  BoAdd('repeat', RtFuncObj('repeat', '_JSRT_sm_repeat', 1), RT_T_FUNCTION);
  RtGlobal('__nsm', BoFinish('_JSNO_nsm', oproto), RT_T_OBJECT);
End;


{ ---- Crochets du prelude : initialisation, boucle d'evenements, natives ---- }
{ Operateurs et BigInt : si un operande est un BigInt (objet dont le prototype est
  __bigproto), l'operation est confiee a __bigop(code, a, b) du prelude. }
Procedure RtBigWrappers;
Const
  BN = 17;
  BinOps: Array[1..BN] Of String[5] = ('add', 'sub', 'mul', 'div', 'mod', 'pow',
    'band', 'bor', 'bxor', 'shl', 'sar', 'shr', 'lt', 'le', 'gt', 'ge', 'eq');
  UnOps: Array[1..4] Of String[5] = ('neg', 'inc', 'dec', 'bnot');
Var
  i: LongInt;

  Procedure One(Const nm: TString; code: LongInt; unary: Boolean);
  Begin
    A('proc _JSRT_bw_' + nm);
    A('push ebp');
    A('mov ebp, esp');
    A('cmp dword ptr [_JSV___bigproto+4], $OBJ');
    A('jne .norm');
    A('cmp dword ptr [ebp+12], $OBJ');
    A('jne .ob');
    A('mov eax, dword ptr [ebp+8]');
    A('mov ecx, dword ptr [eax+$OBJ_PROTO]');
    A('cmp ecx, dword ptr [_JSV___bigproto]');
    A('je .big');
    A('.ob:');
    If Not unary Then
      Begin
        A('cmp dword ptr [ebp+20], $OBJ');
        A('jne .norm');
        A('mov eax, dword ptr [ebp+16]');
        A('mov ecx, dword ptr [eax+$OBJ_PROTO]');
        A('cmp ecx, dword ptr [_JSV___bigproto]');
        A('je .big');
      End;
    A('.norm:');
    A('leave');
    A('jmp _JSRT_' + nm);
    A('.big:');
    A('sub esp, 40');
    A('mov eax, dword ptr [_JSV___bigop]');
    A('mov dword ptr [esp], eax');
    A('mov dword ptr [esp+4], 3');
    A('mov dword ptr [esp+8], 0');
    A('mov dword ptr [esp+12], $UNDEF');
    A('mov dword ptr [esp+16], ' + IntToStr(code));
    A('mov dword ptr [esp+20], $INT');
    A('mov ecx, dword ptr [ebp+8]');
    A('mov dword ptr [esp+24], ecx');
    A('mov ecx, dword ptr [ebp+12]');
    A('mov dword ptr [esp+28], ecx');
    If unary Then
      Begin
        A('mov dword ptr [esp+32], 0');
        A('mov dword ptr [esp+36], $UNDEF');
      End
    Else
      Begin
        A('mov ecx, dword ptr [ebp+16]');
        A('mov dword ptr [esp+32], ecx');
        A('mov ecx, dword ptr [ebp+20]');
        A('mov dword ptr [esp+36], ecx');
      End;
    A('call dword ptr [eax+$FN_CODE]');
    A('leave');
    A('ret');
    A('endp');
  End;

Begin
  For i := 1 To BN Do
    One(BinOps[i], i - 1, False);
  One('seq', BN, False);
  { ToNumeric : un BigInt reste tel quel, le reste passe par ToNumber }
  A('proc _JSRT_tonumeric');
  A('push ebp');
  A('mov ebp, esp');
  A('cmp dword ptr [_JSV___bigproto+4], $OBJ');
  A('jne .norm');
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jne .norm');
  A('mov eax, dword ptr [ebp+8]');
  A('mov ecx, dword ptr [eax+$OBJ_PROTO]');
  A('cmp ecx, dword ptr [_JSV___bigproto]');
  A('jne .norm');
  A('mov edx, dword ptr [ebp+12]');
  A('leave');
  A('ret');
  A('.norm:');
  A('leave');
  A('jmp _JSRT_tonumber');
  A('endp');
  For i := 1 To 4 Do
    One(UnOps[i], BN + i, True);
End;

Procedure RtPreludeHooks;
  Procedure CallSlot(Const code, slot: TString);
  Begin
    FBegin(code, 0);
    A('mov eax, offset ' + slot);
    A('cmp dword ptr [eax+4], $FN');
    A('jne .ret');
    A('push $UNDEF');
    A('push 0');
    A('push dword ptr [eax]');
    A('call _JSRT_call0');
    A('add esp, 12');
    FEnd;
  End;
Begin
  CallSlot('_JSRT_prelude_init', '_JSV___i_init');
  CallSlot('_JSRT_prelude_run', '_JSV___i_run');
  { __invoke(f, this, tableau) : appel avec this et les elements du tableau }
  FBegin('_JSRT_n_invoke', 0);
  A('cmp dword ptr [ebp+12], 3');
  A('jb .bad');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $FN');
  A('jne .bad');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 20) + '], $ARR');
  A('jne .bad');
  A('push $ARR');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 16) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_call_array');
  A('add esp, 24');
  A('jmp .ret');
  A('.bad:');
  A('push offset _JSRT_c_notfunc');
  A('call _JSRT_fatal');
  FEnd;

  { this de niveau global : module.exports (objet vide), comme sous Node }
  A('proc _JSRT_global_this');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [_JSV___exports]');
  A('mov edx, dword ptr [_JSV___exports+4]');
  A('cmp edx, $OBJ');
  A('je .r');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('.r:');
  A('leave');
  A('ret');
  A('endp');

  { ---- Chaines UTF-16 : natives du prelude ---- }
  { __u16(chaine) -> tableau des unites UTF-16 (le dernier resultat est memorise) }
  FBegin('_JSRT_n_u16', 3);
  A('mov esi, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov eax, dword ptr [_JSRT_v_u16s]');
  A('cmp eax, esi');
  A('jne .build');
  A('mov eax, dword ptr [_JSRT_v_u16a]');
  A('mov edx, $ARR');
  A('jmp .ret');
  A('.build:');
  A('call _JSRT_array_new');
  A('mov ' + Lv(3) + ', eax');
  A('mov ' + Lv(1) + ', 0');
  A('mov eax, dword ptr [esi+$STR_LEN]');
  A('mov ' + Lv(2) + ', eax');
  A('.l:');
  A('mov ecx, ' + Lv(1));
  A('cmp ecx, ' + Lv(2));
  A('jae .done');
  A('movzx eax, byte ptr [esi+ecx+$STR_DATA]');
  A('mov edi, 1');
  A('mov ebx, eax');
  A('cmp eax, 128');
  A('jb .emit');
  A('mov ebx, 65533');
  A('cmp eax, 192');
  A('jb .emit');
  A('cmp eax, 224');
  A('jae .t3');
  A('and eax, 31');
  A('shl eax, 6');
  A('movzx ebx, byte ptr [esi+ecx+$STR_DATA+1]');
  A('and ebx, 63');
  A('or ebx, eax');
  A('mov edi, 2');
  A('jmp .emit');
  A('.t3:');
  A('cmp eax, 240');
  A('jae .t4');
  A('and eax, 15');
  A('shl eax, 12');
  A('movzx ebx, byte ptr [esi+ecx+$STR_DATA+1]');
  A('and ebx, 63');
  A('shl ebx, 6');
  A('or ebx, eax');
  A('movzx eax, byte ptr [esi+ecx+$STR_DATA+2]');
  A('and eax, 63');
  A('or ebx, eax');
  A('mov edi, 3');
  A('jmp .emit');
  A('.t4:');
  A('and eax, 7');
  A('shl eax, 18');
  A('movzx ebx, byte ptr [esi+ecx+$STR_DATA+1]');
  A('and ebx, 63');
  A('shl ebx, 12');
  A('or ebx, eax');
  A('movzx eax, byte ptr [esi+ecx+$STR_DATA+2]');
  A('and eax, 63');
  A('shl eax, 6');
  A('or ebx, eax');
  A('movzx eax, byte ptr [esi+ecx+$STR_DATA+3]');
  A('and eax, 63');
  A('or ebx, eax');
  A('sub ebx, 65536');
  A('mov eax, ebx');
  A('shr eax, 10');
  A('add eax, 55296');
  A('and ebx, 1023');
  A('add ebx, 56320');
  A('push ebx');
  A('push $INT');
  A('push eax');
  A('push $ARR');
  A('push ' + Lv(3));
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('pop ebx');
  A('push $INT');
  A('push ebx');
  A('push $ARR');
  A('push ' + Lv(3));
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('add ' + Lv(1) + ', 4');
  A('jmp .l');
  A('.emit:');
  A('push $INT');
  A('push ebx');
  A('push $ARR');
  A('push ' + Lv(3));
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('add ' + Lv(1) + ', edi');
  A('jmp .l');
  A('.done:');
  A('mov eax, ' + Lv(3));
  A('mov dword ptr [_JSRT_v_u16s], esi');
  A('mov dword ptr [_JSRT_v_u16a], eax');
  A('mov edx, $ARR');
  FEnd;

  { __fromu16(tableau d'unites) -> chaine (paires de substitution reunies) }
  FBegin('_JSRT_n_fromu16', 2);
  A('mov esi, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_sb_new');
  A('mov ebx, eax');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $ARR');
  A('jne .done');
  A('mov eax, dword ptr [esi+$ARR_LEN]');
  A('mov ' + Lv(2) + ', eax');
  A('mov ' + Lv(1) + ', 0');
  A('.l:');
  A('mov eax, ' + Lv(1));
  A('cmp eax, ' + Lv(2));
  A('jae .done');
  A('push eax');
  A('push esi');
  A('call _JSRT_arr_get');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('and eax, 65535');
  A('mov edi, eax');
  A('inc ' + Lv(1));
  A('cmp edi, 55296');
  A('jb .enc');
  A('cmp edi, 56319');
  A('ja .enc');
  A('mov eax, ' + Lv(1));
  A('cmp eax, ' + Lv(2));
  A('jae .enc');
  A('push eax');
  A('push esi');
  A('call _JSRT_arr_get');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('and eax, 65535');
  A('cmp eax, 56320');
  A('jb .enc');
  A('cmp eax, 57343');
  A('ja .enc');
  A('sub edi, 55296');
  A('shl edi, 10');
  A('sub eax, 56320');
  A('add edi, eax');
  A('add edi, 65536');
  A('inc ' + Lv(1));
  A('.enc:');
  A('push edi');
  A('push ebx');
  A('call _JSRT_sb_addcp');
  A('add esp, 8');
  A('jmp .l');
  A('.done:');
  A('push ebx');
  A('call _JSRT_sb_str');
  A('add esp, 4');
  A('mov edx, $STR');
  FEnd;

  { __b2u(chaine, octets) -> unites UTF-16 contenues dans les premiers octets }
  FBegin('_JSRT_n_b2u', 0);
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_b2u');
  A('add esp, 8');
  A('mov edx, $INT');
  FEnd;

  { __u2b(chaine, unites) -> decalage en octets, -1 au milieu d'une paire de substitution }
  FBegin('_JSRT_n_u2b', 0);
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_u2b');
  A('add esp, 8');
  A('mov edx, $INT');
  FEnd;

  { __raw(n) : n <> 0 desactive le renvoi des methodes de chaine vers le prelude }
  FBegin('_JSRT_n_raw', 0);
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov dword ptr [_JSRT_v_u16raw], eax');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { __fproto() -> Function.prototype }
  FBegin('_JSRT_n_fproto', 0);
  A('mov eax, offset _JSNO_function_proto');
  A('mov edx, $OBJ');
  FEnd;

  { _JSRT_sym_str(cle) -> 'Symbol(description)' }
  FBegin('_JSRT_sym_str', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('mov edx, 1');
  A('.l:');
  A('cmp edx, ecx');
  A('jae .e');
  A('cmp byte ptr [esi+edx+$STR_DATA], 2');
  A('je .e');
  A('inc edx');
  A('jmp .l');
  A('.e:');
  A('push edx');
  A('push 1');
  A('push esi');
  A('call _JSRT_str_sub');
  A('add esp, 12');
  A('push $STR');
  A('push eax');
  A('push $STR');
  A('push offset ' + RtStr('Symbol('));
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push $STR');
  A('push offset ' + RtStr(')'));
  A('push $STR');
  A('push eax');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('mov edx, $STR');
  FEnd;

  { __ftime(0|1) : mot bas / haut de GetSystemTimeAsFileTime ; __sleep(ms) }
  FBegin('_JSRT_n_ftime', 2);
  A('lea eax, [ebp-20]');
  A('push eax');
  A('call dword ptr [__imp__GetSystemTimeAsFileTime@4]');
  A('mov eax, ' + Lv(2));
  A('cmp dword ptr [ebp+12], 1');
  A('jb .r');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + '], 0');
  A('je .r');
  A('mov eax, ' + Lv(1));
  A('.r:');
  A('mov edx, $INT');
  FEnd;

  FBegin('_JSRT_n_sleep', 0);
  A('cmp dword ptr [ebp+12], 1');
  A('jb .r');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('push eax');
  A('call dword ptr [__imp__Sleep@4]');
  A('.r:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { __ptr(v) -> adresse (entier) d'une chaine, d'un objet ou d'une fonction : identite stable }
  FBegin('_JSRT_n_ptr', 0);
  A('xor eax, eax');
  A('cmp dword ptr [ebp+12], 1');
  A('jb .r');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('shr eax, 3');
  A('.r:');
  A('mov edx, $INT');
  FEnd;
End;


{ ---- Coroutines : generateurs et fonctions async ----

  Chaque generateur (ou appel de fonction async) s'execute sur sa propre pile
  de 64 Ko ; yield / await commutent de pile (registres sauvegardes, chaine
  des gestionnaires d'exceptions et limite de pile propres a chaque
  coroutine). Une fonction generateur appelee normalement cree la coroutine
  et rend l'objet generateur (prologue genere par le compilateur) ; la
  premiere reprise appelle le meme code avec _JSRT_v_genflag a 1 pour entrer
  dans le corps. Enregistrement (80 octets) : etat +0 (0 neuf, 1 suspendu,
  2 en cours, 3 termine), esp / gestionnaire / limite du generateur +4 +8 +12,
  de l'appelant +16 +20 +24, coroutine precedente +28, base de pile +32,
  fonction +36, argc +40, this +44 +48, arguments +52, valeur +56 +60,
  genre de fin +64 (0 yield, 1 return, 2 throw), mode de reprise +68
  (0 next, 1 throw, 2 return), valeur envoyee +72 +76. }
Const
  GEN_STACK = 65536;

Procedure RtCoroutines;
Begin
  { _JSRT_co_enter(co) : bascule vers la pile du generateur }
  A('proc _JSRT_co_enter');
  A('push ebp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('mov esi, dword ptr [esp+20]');
  A('mov dword ptr [esi+16], esp');
  A('mov eax, dword ptr [_JSRT_v_handler_top]');
  A('mov dword ptr [esi+20], eax');
  A('mov eax, dword ptr [_JSRT_v_stack_limit]');
  A('mov dword ptr [esi+24], eax');
  A('mov eax, dword ptr [_JSRT_v_curco]');
  A('mov dword ptr [esi+28], eax');
  A('mov dword ptr [_JSRT_v_curco], esi');
  A('mov dword ptr [esi], 2');
  A('mov eax, dword ptr [esi+8]');
  A('mov dword ptr [_JSRT_v_handler_top], eax');
  A('mov eax, dword ptr [esi+12]');
  A('mov dword ptr [_JSRT_v_stack_limit], eax');
  A('mov esp, dword ptr [esi+4]');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { _JSRT_co_leave() : retour vers la pile de l'appelant (suspension ou fin) }
  A('proc _JSRT_co_leave');
  A('push ebp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('mov esi, dword ptr [_JSRT_v_curco]');
  A('mov dword ptr [esi+4], esp');
  A('mov eax, dword ptr [_JSRT_v_handler_top]');
  A('mov dword ptr [esi+8], eax');
  A('mov eax, dword ptr [_JSRT_v_stack_limit]');
  A('mov dword ptr [esi+12], eax');
  A('mov eax, dword ptr [esi+20]');
  A('mov dword ptr [_JSRT_v_handler_top], eax');
  A('mov eax, dword ptr [esi+24]');
  A('mov dword ptr [_JSRT_v_stack_limit], eax');
  A('mov eax, dword ptr [esi+28]');
  A('mov dword ptr [_JSRT_v_curco], eax');
  A('mov esp, dword ptr [esi+16]');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { point d'entree d'une coroutine (atteint par ret depuis co_enter) }
  A('proc _JSRT_gen_entry');
  A('push ebp');
  A('mov ebp, esp');
  A('sub esp, 48');
  A('mov dword ptr [ebp-32], 0');
  A('mov dword ptr [ebp-28], esp');
  A('mov dword ptr [ebp-24], ebp');
  A('mov dword ptr [ebp-20], offset _JSRT_gen_caught');
  A('mov dword ptr [ebp-16], ebx');
  A('mov dword ptr [ebp-12], esi');
  A('mov dword ptr [ebp-8], edi');
  A('lea eax, [ebp-32]');
  A('mov dword ptr [_JSRT_v_handler_top], eax');
  A('mov esi, dword ptr [_JSRT_v_curco]');
  A('mov dword ptr [ebp-36], esi');
  A('mov dword ptr [_JSRT_v_genflag], 1');
  A('mov ecx, dword ptr [esi+40]');
  A('shl ecx, 3');
  A('add ecx, 16');
  A('sub esp, ecx');
  A('mov eax, dword ptr [esi+36]');
  A('mov dword ptr [esp], eax');
  A('mov ecx, dword ptr [esi+40]');
  A('mov dword ptr [esp+4], ecx');
  A('mov ecx, dword ptr [esi+44]');
  A('mov dword ptr [esp+8], ecx');
  A('mov ecx, dword ptr [esi+48]');
  A('mov dword ptr [esp+12], ecx');
  A('lea edi, [esp+16]');
  A('mov ecx, dword ptr [esi+40]');
  A('shl ecx, 3');
  A('mov esi, dword ptr [esi+52]');
  A('rep movsb');
  A('call dword ptr [eax+$FN_CODE]');
  A('mov esi, dword ptr [ebp-36]');
  A('mov dword ptr [esi+56], eax');
  A('mov dword ptr [esi+60], edx');
  A('mov dword ptr [esi+64], 1');
  A('jmp _JSRT_gen_finish');
  A('endp');

  { exception non rattrapee dans la coroutine (ebp = trame de gen_entry) }
  A('proc _JSRT_gen_caught');
  A('mov esi, dword ptr [ebp-36]');
  A('mov eax, dword ptr [_JSRT_v_exc]');
  A('mov edx, dword ptr [_JSRT_v_exc+4]');
  A('cmp edx, $OBJ');
  A('jne .real');
  A('cmp eax, offset _JSNO_function_proto');
  A('jne .real');
  { return() demande par l''appelant : fin normale avec la valeur envoyee }
  A('mov eax, dword ptr [esi+72]');
  A('mov edx, dword ptr [esi+76]');
  A('mov dword ptr [esi+64], 1');
  A('jmp .store');
  A('.real:');
  A('mov dword ptr [esi+64], 2');
  A('.store:');
  A('mov dword ptr [esi+56], eax');
  A('mov dword ptr [esi+60], edx');
  A('jmp _JSRT_gen_finish');
  A('endp');

  A('proc _JSRT_gen_finish');
  A('mov dword ptr [esi], 3');
  A('.again:');
  A('call _JSRT_co_leave');
  A('jmp .again');
  A('endp');

  { _JSRT_gen_new(genre, fonction, argc, this lo, this hi, arguments) -> objet generateur
    ou promesse (genre 1 = async) }
  FBegin('_JSRT_gen_new', 0);
  A('push 80');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov ebx, eax');
  A('mov ecx, dword ptr [ebp+16]');
  A('shl ecx, 3');
  A('add ecx, 8');
  A('push ecx');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov dword ptr [ebx+52], eax');
  A('mov ecx, dword ptr [ebp+16]');
  A('shl ecx, 3');
  A('push ecx');
  A('push dword ptr [ebp+28]');
  A('push eax');
  A('call _JSRT_memmove');
  A('add esp, 12');
  A('mov eax, dword ptr [ebp+12]');
  A('mov dword ptr [ebx+36], eax');
  A('mov eax, dword ptr [ebp+16]');
  A('mov dword ptr [ebx+40], eax');
  A('mov eax, dword ptr [ebp+20]');
  A('mov dword ptr [ebx+44], eax');
  A('mov eax, dword ptr [ebp+24]');
  A('mov dword ptr [ebx+48], eax');
  { pile : liste libre ou nouvelle }
  A('mov eax, dword ptr [_JSRT_v_genfree]');
  A('test eax, eax');
  A('jz .new');
  A('mov ecx, dword ptr [eax]');
  A('mov dword ptr [_JSRT_v_genfree], ecx');
  A('jmp .have');
  A('.new:');
  A('push ' + IntToStr(GEN_STACK));
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('.have:');
  A('mov dword ptr [ebx+32], eax');
  A('lea ecx, [eax+' + IntToStr(GEN_STACK - 32) + ']');
  A('mov dword ptr [ecx], 0');
  A('mov dword ptr [ecx+4], 0');
  A('mov dword ptr [ecx+8], 0');
  A('mov dword ptr [ecx+12], 0');
  A('mov dword ptr [ecx+16], offset _JSRT_gen_entry');
  A('mov dword ptr [ecx+20], 0');
  A('mov dword ptr [ebx+4], ecx');
  A('mov dword ptr [ebx+8], 0');
  A('add eax, 8192');
  A('mov dword ptr [ebx+12], eax');
  A('mov dword ptr [ebx], 0');
  { objet generateur }
  A('mov ecx, offset _JSV___GenProto');
  A('mov eax, offset _JSNO_object_proto');
  A('cmp dword ptr [ecx+4], $OBJ');
  A('jne .proto');
  A('mov eax, dword ptr [ecx]');
  A('.proto:');
  A('push eax');
  A('call _JSRT_obj_new_proto');
  A('add esp, 4');
  A('mov edi, eax');
  A('push $INT');
  A('push ebx');
  A('push 1');
  A('push offset ' + RtStr(#1 + 'co'));
  A('push edi');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  A('cmp dword ptr [ebp+8], 1');
  A('je .async');
  A('mov eax, edi');
  A('mov edx, $OBJ');
  A('jmp .ret');
  A('.async:');
  A('mov eax, offset _JSV___i_async');
  A('push $OBJ');
  A('push edi');
  A('push $UNDEF');
  A('push 0');
  A('push dword ptr [eax]');
  A('call _JSRT_call1');
  A('add esp, 20');
  FEnd;

  { _JSRT_yield(valeur) : suspend la coroutine courante, rend la valeur envoyee }
  FBegin('_JSRT_yield', 0);
  A('mov esi, dword ptr [_JSRT_v_curco]');
  A('test esi, esi');
  A('jz .bad');
  A('mov eax, dword ptr [ebp+8]');
  A('mov dword ptr [esi+56], eax');
  A('mov eax, dword ptr [ebp+12]');
  A('mov dword ptr [esi+60], eax');
  A('mov dword ptr [esi+64], 0');
  A('mov dword ptr [esi], 1');
  A('call _JSRT_co_leave');
  A('mov esi, dword ptr [_JSRT_v_curco]');
  A('mov eax, dword ptr [esi+72]');
  A('mov edx, dword ptr [esi+76]');
  A('mov ecx, dword ptr [esi+68]');
  A('test ecx, ecx');
  A('jz .ret');
  A('cmp ecx, 1');
  A('jne .ret2');
  A('push edx');
  A('push eax');
  A('call _JSRT_throw');
  A('.ret2:');
  A('push $OBJ');
  A('push offset _JSNO_function_proto');
  A('call _JSRT_throw');
  A('.bad:');
  A('push offset _JSRT_c_type');
  A('call _JSRT_fatal');
  FEnd;

  { _JSRT_yield_star(iterable) : delegue a un autre iterable }
  FBegin('_JSRT_yield_star', 0);
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_iter_new');
  A('add esp, 8');
  A('mov esi, eax');
  A('.l:');
  A('push $OBJ');
  A('push esi');
  A('call _JSRT_iter_next');
  A('add esp, 8');
  A('cmp edx, $DONE');
  A('je .d');
  A('push edx');
  A('push eax');
  A('call _JSRT_yield');
  A('add esp, 8');
  A('jmp .l');
  A('.d:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { _JSRT_gen_resume(co, mode, valeur lo, hi) -> valeur rendue (EDX:EAX) }
  FBegin('_JSRT_gen_resume', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov eax, dword ptr [esi]');
  A('cmp eax, 2');
  A('je .running');
  A('cmp eax, 3');
  A('je .finished');
  A('test eax, eax');
  A('jnz .go');
  A('cmp dword ptr [ebp+12], 0');
  A('je .go');
  { throw / return avant le premier next : fin immediate }
  A('mov dword ptr [esi], 3');
  A('jmp .finished');
  A('.go:');
  A('mov eax, dword ptr [ebp+12]');
  A('mov dword ptr [esi+68], eax');
  A('mov eax, dword ptr [ebp+16]');
  A('mov dword ptr [esi+72], eax');
  A('mov eax, dword ptr [ebp+20]');
  A('mov dword ptr [esi+76], eax');
  A('push esi');
  A('call _JSRT_co_enter');
  A('add esp, 4');
  A('mov esi, dword ptr [ebp+8]');
  A('cmp dword ptr [esi], 3');
  A('jne .nofree');
  A('mov eax, dword ptr [esi+32]');
  A('test eax, eax');
  A('jz .nofree');
  A('mov ecx, dword ptr [_JSRT_v_genfree]');
  A('mov dword ptr [eax], ecx');
  A('mov dword ptr [_JSRT_v_genfree], eax');
  A('mov dword ptr [esi+32], 0');
  A('.nofree:');
  A('mov eax, dword ptr [esi+56]');
  A('mov edx, dword ptr [esi+60]');
  A('cmp dword ptr [esi+64], 2');
  A('jne .ret');
  A('push edx');
  A('push eax');
  A('call _JSRT_throw');
  A('.finished:');
  A('mov ecx, dword ptr [ebp+12]');
  A('cmp ecx, 1');
  A('je .rethrow');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('cmp ecx, 2');
  A('jne .ret');
  A('mov eax, dword ptr [ebp+16]');
  A('mov edx, dword ptr [ebp+20]');
  A('jmp .ret');
  A('.rethrow:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_throw');
  A('.running:');
  A('push offset ' + RtStr('Generator is already running'));
  A('push offset _JSNO_TypeError_proto');
  A('call _JSRT_throw_msg');
  FEnd;

  { __gen_resume(generateur, mode, valeur) et __gen_done(generateur) }
  FBegin('_JSRT_n_gen_resume', 0);
  A('cmp dword ptr [ebp+12], 3');
  A('jb .bad');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $OBJ');
  A('jne .bad');
  A('push offset ' + RtStr(#1 + 'co'));
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_prop_find');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .bad');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 20) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 16) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('push dword ptr [eax+8]');
  A('call _JSRT_gen_resume');
  A('add esp, 16');
  A('jmp .ret');
  A('.bad:');
  A('push offset _JSRT_c_type');
  A('call _JSRT_fatal');
  FEnd;

  FBegin('_JSRT_n_gen_done', 0);
  A('mov edx, $BOOL');
  A('xor eax, eax');
  A('cmp dword ptr [ebp+12], 1');
  A('jb .ret');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $OBJ');
  A('jne .ret');
  A('push offset ' + RtStr(#1 + 'co'));
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_prop_find');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .ret');
  A('mov ecx, dword ptr [eax+8]');
  A('xor eax, eax');
  A('cmp dword ptr [ecx], 3');
  A('jne .no');
  A('mov eax, 1');
  A('.no:');
  A('mov edx, $BOOL');
  FEnd;
End;

{ ---- Assemblage du runtime ---- }

Procedure RtStaticData;
Var
  f_log, f_err, f_warn, proto, cons, oproto, k: LongInt;
Begin
  RtCString('_JSRT_c_oom', 'JSCW32: memoire epuisee' + #10);
  RtCString('_JSRT_c_notfunc', 'TypeError: la valeur appelee n''est pas une fonction' + #10);
  RtCString('_JSRT_c_type', 'TypeError: operation invalide pour ce type de valeur' + #10);
  RtCString('_JSRT_c_stack', 'RangeError: pile d''appels epuisee' + #10);
  RtCString('_JSRT_c_read', 'TypeError: lecture d''une propriete de null ou undefined' + #10);
  RtCString('_JSRT_c_tdz1', 'ReferenceError: ');
  RtCString('_JSRT_c_tdz2', ' ne peut pas etre utilise avant son initialisation' + #10);
  RtCString('_JSRT_c_space', ' ');
  RtCString('_JSRT_c_nl', #10);
  RtNumData;
  RtCString('_JSRT_c_uncaught', 'Uncaught ');
  RtCString('_JSRT_c_circ', 'TypeError: Converting circular structure to JSON' + #10);
  RtCString('_JSRT_c_setundef', 'TypeError: impossible de definir une propriete de null ou undefined' + #10);
  RtCString('_JSRT_c_noiter', 'TypeError: la valeur n''est pas iterable' + #10);
  RtCString('_JSRT_c_setprop', 'TypeError: affectation de propriete non prise en charge pour cet objet' + #10);
  RtCString('_JSRT_c_range', 'RangeError: argument invalide' + #10);

  { prototype des chaines : les methodes natives }
  RtClassData;
  BoReset;
  RtObjectProtoMethods;
  oproto := BoFinish('_JSNO_object_proto', 0);
  RtErrorData(oproto);
  RtNumObjects(oproto);
  RtJsonObject(oproto);
  RtRegExpData(oproto);
  BoReset;
  BoFinish('_JSNO_function_proto', oproto);

  BoReset;
  RtStringProtoMethods;
  proto := BoFinish('_JSNO_string_proto', oproto);

  BoReset;
  RtArrayProtoMethods;
  BoFinish('_JSNO_array_proto', oproto);

  f_log := RtFuncObj('log', '_JSRT_console_log', 0);
  f_err := RtFuncObj('error', '_JSRT_console_error', 0);
  f_warn := RtFuncObj('warn', '_JSRT_console_error', 0);
  BoReset;
  BoAdd('log', f_log, RT_T_FUNCTION);
  BoAdd('error', f_err, RT_T_FUNCTION);
  BoAdd('warn', f_warn, RT_T_FUNCTION);
  BoAdd('info', RtFuncObj('info', '_JSRT_console_log', 0), RT_T_FUNCTION);
  BoAdd('debug', RtFuncObj('debug', '_JSRT_console_log', 0), RT_T_FUNCTION);
  BoAdd('dir', RtFuncObj('dir', '_JSRT_console_dir', 0), RT_T_FUNCTION);
  BoAdd('assert', RtFuncObj('assert', '_JSRT_console_assert', 0), RT_T_FUNCTION);
  BoAdd('group', RtFuncObj('group', '_JSRT_console_group', 0), RT_T_FUNCTION);
  BoAdd('groupCollapsed', RtFuncObj('groupCollapsed', '_JSRT_console_group', 0), RT_T_FUNCTION);
  BoAdd('groupEnd', RtFuncObj('groupEnd', '_JSRT_console_groupEnd', 0), RT_T_FUNCTION);
  cons := BoFinish('_JSNO_console', 0);
  RtGlobal('console', cons, RT_T_OBJECT);
  RtStaticGlobals;
  RtProcessData(oproto);
  RtArrayGlobals;
  RtObjectGlobals;
  { globalThis : les objets globaux predefinis }
  BoReset;
  For k := 1 To gl_n Do
    BoAdd(gl_nameP(gl_name, k)^, gl_symP(gl_sym, k)^, gl_tagP(gl_tag, k)^);
  RtGlobal('globalThis', BoFinish('_JSNO_globalThis', oproto), RT_T_OBJECT);
End;

{ ---- Pont eval : globales du programme par nom, constructeur Function ----

  _JSRT_gtab (.rdata) : nombre, puis par globale du programme (hors noms en __)
  trois mots : chaine du nom, adresse de la cellule de 8 octets, genre (0 var,
  fonction ou classe, 1 let, 2 const). Les natives __gget / __gset / __ginfo
  y accedent ; Function(...) appelle __newfn (bloc optionnel eval du prelude). }
Procedure RtGlobalBridge(Var ctx: TCompilerContext);
Var
  i, n, ofs, e, props, f: LongInt;
  nm: TString;
Begin
  n := 0;
  For i := 1 To ctx.sem.sym_count Do
    If (SymP(ctx.sem.syms, i)^.name_str <> 0) And (SymP(ctx.sem.syms, i)^.ds <> 0) And
       (SymP(ctx.sem.syms, i)^.flags And SF_STATIC <> 0) And (SymP(ctx.sem.syms, i)^.scope = 1) Then
      Inc(n);
  ofs := SecAlloc(ctx, SEC_RDATA, 4 + 12 * n);
  PutDword(ctx, SEC_RDATA, ofs, n);
  e := 0;
  For i := 1 To ctx.sem.sym_count Do
    If (SymP(ctx.sem.syms, i)^.name_str <> 0) And (SymP(ctx.sem.syms, i)^.ds <> 0) And
       (SymP(ctx.sem.syms, i)^.flags And SF_STATIC <> 0) And (SymP(ctx.sem.syms, i)^.scope = 1) Then
      Begin
        AddReloc(ctx, SEC_RDATA, ofs + 4 + 12 * e, StrP(ctx.data.strs, SymP(ctx.sem.syms, i)^.name_str)^.sym);
        AddReloc(ctx, SEC_RDATA, ofs + 8 + 12 * e, SymP(ctx.sem.syms, i)^.ds);
        Case SymP(ctx.sem.syms, i)^.kind Of
          DK_LET: PutDword(ctx, SEC_RDATA, ofs + 12 + 12 * e, 1);
          DK_CONST: PutDword(ctx, SEC_RDATA, ofs + 12 + 12 * e, 2);
        Else
          PutDword(ctx, SEC_RDATA, ofs + 12 + 12 * e, 0);
        End;
        Inc(e);
      End;
  NewDataSym(ctx, '_JSRT_gtab', SEC_RDATA, ofs, 4 + 12 * n, DS_FDESC);

  { _JSRT_gfind(chaine) -> entree ou 0 }
  A('proc _JSRT_gfind');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('mov esi, offset _JSRT_gtab');
  A('mov ebx, dword ptr [esi]');
  A('add esi, 4');
  A('.l:');
  A('test ebx, ebx');
  A('jz .no');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [esi]');
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('test eax, eax');
  A('jnz .yes');
  A('add esi, 12');
  A('dec ebx');
  A('jmp .l');
  A('.yes:');
  A('mov eax, esi');
  A('jmp .out');
  A('.no:');
  A('xor eax, eax');
  A('.out:');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');

  { __ginfo(nom) -> -1 si inconnue, sinon le genre }
  FBegin('_JSRT_n_ginfo', 0);
  A('mov eax, -1');
  A('cmp dword ptr [ebp+12], 1');
  A('jb .r');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $STR');
  A('jne .r');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_gfind');
  A('add esp, 4');
  A('test eax, eax');
  A('jz .nf');
  A('mov eax, dword ptr [eax+8]');
  A('jmp .r');
  A('.nf:');
  A('mov eax, -1');
  A('.r:');
  A('mov edx, $INT');
  FEnd;

  { __gget(nom) -> valeur (ReferenceError si la variable est encore dans sa zone morte) }
  FBegin('_JSRT_n_gget', 0);
  A('cmp dword ptr [ebp+12], 1');
  A('jb .u');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $STR');
  A('jne .u');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_gfind');
  A('add esp, 4');
  A('test eax, eax');
  A('jz .u');
  A('mov ecx, dword ptr [eax+4]');
  A('cmp dword ptr [ecx+4], $TDZ');
  A('jne .ok');
  A('push dword ptr [eax]');
  A('call _JSRT_throw_tdz');
  A('.ok:');
  A('mov eax, dword ptr [ecx]');
  A('mov edx, dword ptr [ecx+4]');
  A('jmp .ret');
  A('.u:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { __gset(nom, valeur) -> true si la globale existe (et a ete affectee) }
  FBegin('_JSRT_n_gset', 0);
  A('xor eax, eax');
  A('cmp dword ptr [ebp+12], 2');
  A('jb .r');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $STR');
  A('jne .r');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_gfind');
  A('add esp, 4');
  A('test eax, eax');
  A('jz .r');
  A('mov ecx, dword ptr [eax+4]');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('mov edx, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('mov dword ptr [ecx], eax');
  A('mov dword ptr [ecx+4], edx');
  A('mov eax, 1');
  A('.r:');
  A('mov edx, $BOOL');
  FEnd;

  { Function(args..., corps) : delegue au prelude (__newfn) avec les arguments en tableau }
  FBegin('_JSRT_Function_call', 0);
  A('call _JSRT_array_new');
  A('mov ebx, eax');
  A('xor esi, esi');
  A('.l:');
  A('cmp esi, dword ptr [ebp+12]');
  A('jae .go');
  A('mov ecx, esi');
  A('shl ecx, 3');
  A('lea eax, [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('add ecx, eax');
  A('push dword ptr [ecx+4]');
  A('push dword ptr [ecx]');
  A('push $ARR');
  A('push ebx');
  A('call _JSRT_array_push');
  A('add esp, 16');
  A('inc esi');
  A('jmp .l');
  A('.go:');
  A('mov eax, offset _JSV___newfn');
  A('cmp dword ptr [eax+4], $FN');
  A('jne .none');
  A('push $ARR');
  A('push ebx');
  A('push $UNDEF');
  A('push 0');
  A('push dword ptr [eax]');
  A('call _JSRT_call1');
  A('add esp, 20');
  A('jmp .ret');
  A('.none:');
  A('push offset _JSRT_c_nofn');
  A('call _JSRT_fatal');
  FEnd;
  RtCString('_JSRT_c_nofn', 'EvalError: Function() indisponible (bloc eval absent)' + #10);

  BoReset;
  BoAdd('prototype', DsymFind(ctx, '_JSNO_function_proto'), RT_T_OBJECT);
  props := BoFinish('_JSNO_Function_props', 0);
  f := RtFuncObjP('Function', '_JSRT_Function_call', 1, props);
  RtGlobal('Function', f, RT_T_FUNCTION);
  RtGlobal('__gget', RtFuncObj('__gget', '_JSRT_n_gget', 1), RT_T_FUNCTION);
  RtGlobal('__gset', RtFuncObj('__gset', '_JSRT_n_gset', 2), RT_T_FUNCTION);
  RtGlobal('__ginfo', RtFuncObj('__ginfo', '_JSRT_n_ginfo', 1), RT_T_FUNCTION);
  RtGlobal('__oflags', RtFuncObj('__oflags', '_JSRT_n_oflags', 2), RT_T_FUNCTION);
  RtGlobal('__propinfo', RtFuncObj('__propinfo', '_JSRT_n_propinfo', 2), RT_T_FUNCTION);
End;

{ ---- Donnees binaires : ArrayBuffer et tableaux types ----

  ArrayBuffer : objet de 48 octets, drapeau OF_ABUF, donnees (bloc sans pointeur) +32,
  longueur +36. Tableau type : objet de 48 octets, drapeau OF_TYPED, tampon +32,
  decalage en octets +36, longueur +40, genre +44 (0 Int8, 1 Uint8, 2 Uint8Clamped,
  3 Int16, 4 Uint16, 5 Int32, 6 Uint32, 7 Float32, 8 Float64). Les acces a t[i]
  passent par _JSRT_ta_get / _JSRT_ta_set (voir get_member et set_member). }
Const
  K32_COUNT = 42;
  K32Names: Array[1..K32_COUNT] Of String[32] = (
    'CreateFileW@28',
    'CloseHandle@4',
    'ReadFile@20',
    'WriteFile@20',
    'SetFilePointer@16',
    'GetFileSize@8',
    'DeleteFileW@4',
    'CreateDirectoryW@8',
    'RemoveDirectoryW@4',
    'MoveFileW@8',
    'CopyFileW@12',
    'GetFileAttributesExW@12',
    'FindFirstFileW@8',
    'FindNextFileW@8',
    'FindClose@4',
    'GetCurrentDirectoryW@8',
    'GetEnvironmentVariableW@12',
    'GetEnvironmentStringsW@0',
    'CreatePipe@16',
    'CreateProcessW@40',
    'WaitForSingleObject@8',
    'GetExitCodeProcess@8',
    'GetTimeZoneInformation@4',
    'SetCurrentDirectoryW@4',
    'GetStdHandle@4',
    'SetHandleInformation@12',
    'PeekNamedPipe@24',
    'GetLastError@0',
    'SetEndOfFile@4',
    'FlushFileBuffers@4',
    'SetFileAttributesW@8',
    'GetTempPathW@8',
    'GetFullPathNameW@16',
    'FreeEnvironmentStringsW@4',
    'SetEnvironmentVariableW@8',
    'GetFileAttributesW@4',
    'SetFileTime@16',
    'GetCurrentProcessId@0',
    'GetFileInformationByHandle@8',
    'TerminateProcess@8',
    'RtlMoveMemory@12',
    'lstrlenW@4'
  );

{ Appels systeme KERNEL32 generiques : fichiers, repertoires, processus, environnement. }
Procedure RtSys;
Var
  id, j, na: LongInt;
Begin
  { __k32(id, a1..a10) : appelle une fonction KERNEL32 (stdcall). Entiers tels quels, chaines -> pointeur
    des donnees, ArrayBuffer / tableaux types -> pointeur des octets. Resultat : EAX en entier. }
  FBegin('_JSRT_n_k32', 11);
  A('xor ebx, ebx');
  A('.cl:');
  A('cmp ebx, 11');
  A('jae .cd');
  A('xor eax, eax');
  A('cmp ebx, dword ptr [ebp+12]');
  A('jae .st');
  A('mov esi, ebx');
  A('shl esi, 3');
  A('add esi, ebp');
  A('mov eax, dword ptr [esi+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov ecx, dword ptr [esi+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('call .conv');
  A('.st:');
  A('mov edi, ebx');
  A('shl edi, 2');
  A('neg edi');
  A('add edi, ebp');
  A('mov dword ptr [edi-16], eax');
  A('inc ebx');
  A('jmp .cl');
  A('.conv:');
  A('cmp ecx, $INT');
  A('je .cok');
  A('cmp ecx, $BOOL');
  A('je .cok');
  A('cmp ecx, $STR');
  A('jne .c1');
  A('add eax, $STR_DATA');
  A('ret');
  A('.c1:');
  A('cmp ecx, $OBJ');
  A('jne .c2');
  A('test byte ptr [eax+2], ' + IntToStr(OF_ABUF));
  A('jz .c3');
  A('mov eax, dword ptr [eax+32]');
  A('ret');
  A('.c3:');
  A('test byte ptr [eax+2], ' + IntToStr(OF_TYPED));
  A('jz .czero');
  A('mov edx, dword ptr [eax+32]');
  A('mov edx, dword ptr [edx+32]');
  A('add edx, dword ptr [eax+36]');
  A('mov eax, edx');
  A('ret');
  A('.c2:');
  A('cmp ecx, $INT');
  A('ja .czero');
  A('push ecx');
  A('push eax');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('.cok:');
  A('ret');
  A('.czero:');
  A('xor eax, eax');
  A('ret');
  A('.cd:');
  For id := 1 To K32_COUNT Do
    Begin
      na := 0;
      j := Pos('@', K32Names[id]);
      Val(Copy(K32Names[id], j + 1, 3), na, j);
      na := na Div 4;
      A('cmp dword ptr [ebp-16], ' + IntToStr(id));
      A('jne .n' + IntToStr(id));
      For j := na Downto 1 Do
        A('push dword ptr [ebp-' + IntToStr(16 + 4 * j) + ']');
      A('call dword ptr [__imp__' + K32Names[id] + ']');
      A('jmp .out');
      A('.n' + IntToStr(id) + ':');
    End;
  A('xor eax, eax');
  A('.out:');
  A('mov edx, $INT');
  FEnd;
  RtGlobal('__k32', RtFuncObj('__k32', '_JSRT_n_k32', 11), RT_T_FUNCTION);
End;

Procedure RtBinary;
Begin
  { _JSRT_ab_load(adresse, genre) -> nombre }
  FBegin('_JSRT_ab_load', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('cmp ebx, 3');
  A('jb .s1');
  A('cmp ebx, 5');
  A('jb .s2');
  A('cmp ebx, 7');
  A('jb .s4');
  A('je .f32');
  A('fld qword ptr [esi]');
  A('call _JSRT_fst_result');
  A('jmp .fix');
  A('.f32:');
  A('fld dword ptr [esi]');
  A('call _JSRT_fst_result');
  A('jmp .fix');
  A('.s4:');
  A('mov eax, dword ptr [esi]');
  A('cmp ebx, 6');
  A('jne .int');
  A('test eax, eax');
  A('jns .int');
  A('push 0');
  A('push eax');
  A('fild qword ptr [esp]');
  A('add esp, 8');
  A('call _JSRT_fst_result');
  A('jmp .ret');
  A('.s2:');
  A('movzx eax, byte ptr [esi]');
  A('movzx edx, byte ptr [esi+1]');
  A('shl edx, 8');
  A('or eax, edx');
  A('cmp ebx, 3');
  A('jne .int');
  A('shl eax, 16');
  A('sar eax, 16');
  A('jmp .int');
  A('.s1:');
  A('movzx eax, byte ptr [esi]');
  A('test ebx, ebx');
  A('jnz .int');
  A('shl eax, 24');
  A('sar eax, 24');
  A('.int:');
  A('mov edx, $INT');
  A('jmp .ret');
  A('.fix:');
  A('cmp edx, $INT');
  A('jbe .ret');
  A('xor eax, eax');
  A('mov edx, 0xFFF80000');
  FEnd;

  { _JSRT_ab_store(adresse, genre, valeur lo, hi) }
  FBegin('_JSRT_ab_store', 1);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('mov ' + Lv(1) + ', eax');
  A('mov edi, edx');
  A('cmp ebx, 7');
  A('jae .fl');
  A('cmp ebx, 2');
  A('je .clamp');
  A('push edi');
  A('push ' + Lv(1));
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('.wint:');
  A('cmp ebx, 3');
  A('jb .w1');
  A('cmp ebx, 5');
  A('jb .w2');
  A('mov dword ptr [esi], eax');
  A('jmp .ret');
  A('.w2:');
  A('mov byte ptr [esi], al');
  A('shr eax, 8');
  A('mov byte ptr [esi+1], al');
  A('jmp .ret');
  A('.w1:');
  A('mov byte ptr [esi], al');
  A('jmp .ret');
  A('.clamp:');
  A('cmp edi, $INT');
  A('jne .cdbl');
  A('mov eax, ' + Lv(1));
  A('test eax, eax');
  A('jns .c1');
  A('xor eax, eax');
  A('.c1:');
  A('cmp eax, 255');
  A('jbe .wint');
  A('mov eax, 255');
  A('jmp .wint');
  A('.cdbl:');
  A('mov ecx, edi');
  A('and ecx, 0x7FF00000');
  A('cmp ecx, 0x7FF00000');
  A('jne .cn');
  A('mov ecx, edi');
  A('and ecx, 0xFFFFF');
  A('or ecx, ' + Lv(1));
  A('jnz .c0');
  A('test edi, edi');
  A('js .c0');
  A('jmp .c255');
  A('.cn:');
  A('test edi, edi');
  A('js .c0');
  A('cmp edi, 0x406FE000');
  A('jae .c255');
  A('push edi');
  A('push ' + Lv(1));
  A('call _JSRT_fld');
  A('add esp, 8');
  A('fistp ' + Lv(1));
  A('mov eax, ' + Lv(1));
  A('jmp .wint');
  A('.c0:');
  A('xor eax, eax');
  A('jmp .wint');
  A('.c255:');
  A('mov eax, 255');
  A('jmp .wint');
  A('.fl:');
  A('push edi');
  A('push ' + Lv(1));
  A('call _JSRT_fld');
  A('add esp, 8');
  A('cmp ebx, 7');
  A('jne .f64');
  A('fstp dword ptr [esi]');
  A('jmp .ret');
  A('.f64:');
  A('fstp qword ptr [esi]');
  FEnd;

  { _JSRT_ta_addr(objet, indice) -> adresse de l'element ou 0 ; EDX = genre }
  FBegin('_JSRT_ta_addr', 0);
  A('mov ecx, dword ptr [ebp+8]');
  A('mov eax, dword ptr [ebp+12]');
  A('cmp eax, dword ptr [ecx+40]');
  A('jae .no');
  A('mov esi, dword ptr [ecx+32]');
  A('mov esi, dword ptr [esi+32]');
  A('add esi, dword ptr [ecx+36]');
  A('mov edx, dword ptr [ecx+44]');
  A('cmp edx, 3');
  A('jb .a1');
  A('cmp edx, 5');
  A('jb .a2');
  A('cmp edx, 8');
  A('jb .a4');
  A('shl eax, 3');
  A('jmp .add');
  A('.a4:');
  A('shl eax, 2');
  A('jmp .add');
  A('.a2:');
  A('shl eax, 1');
  A('.a1:');
  A('.add:');
  A('add eax, esi');
  A('jmp .ret');
  A('.no:');
  A('xor eax, eax');
  FEnd;

  { _JSRT_ta_get(objet, indice) -> element ou undefined }
  FBegin('_JSRT_ta_get', 0);
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_ta_addr');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .u');
  A('push edx');
  A('push eax');
  A('call _JSRT_ab_load');
  A('add esp, 8');
  A('jmp .ret');
  A('.u:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;

  { _JSRT_ta_set(objet, indice, valeur lo, hi) }
  FBegin('_JSRT_ta_set', 0);
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_ta_addr');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .done');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push edx');
  A('push eax');
  A('call _JSRT_ab_store');
  A('add esp, 16');
  A('.done:');
  A('mov eax, dword ptr [ebp+16]');
  A('mov edx, dword ptr [ebp+20]');
  FEnd;

  { __abnew(prototype, longueur) -> ArrayBuffer }
  FBegin('_JSRT_n_abnew', 0);
  A('mov ecx, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('cmp dword ptr [ebp+12], 2');
  A('jb .bad');
  A('cmp ecx, 1073741824');
  A('ja .bad');
  A('push 48');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov ebx, eax');
  A('mov byte ptr [ebx], $OK_OBJECT');
  A('mov byte ptr [ebx+2], ' + IntToStr(OF_ABUF));
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov dword ptr [ebx+$OBJ_PROTO], eax');
  A('mov ecx, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('mov dword ptr [ebx+36], ecx');
  A('push ecx');
  A('call _JSRT_alloc_atomic');
  A('add esp, 4');
  A('mov dword ptr [ebx+32], eax');
  A('mov eax, ebx');
  A('mov edx, $OBJ');
  A('jmp .ret');
  A('.bad:');
  A('push offset _JSRT_c_range');
  A('call _JSRT_fatal');
  FEnd;

  { __tanew(prototype, tampon, decalage, longueur, genre) -> tableau type }
  FBegin('_JSRT_n_tanew', 0);
  A('push 48');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov ebx, eax');
  A('mov byte ptr [ebx], $OK_OBJECT');
  A('mov byte ptr [ebx+2], ' + IntToStr(OF_TYPED));
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('mov dword ptr [ebx+$OBJ_PROTO], eax');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('mov dword ptr [ebx+32], eax');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 16) + ']');
  A('mov dword ptr [ebx+36], eax');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 24) + ']');
  A('mov dword ptr [ebx+40], eax');
  A('mov eax, dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 32) + ']');
  A('mov dword ptr [ebx+44], eax');
  A('mov eax, ebx');
  A('mov edx, $OBJ');
  FEnd;

