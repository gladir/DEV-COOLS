  A('cmp eax, edx');
  A('je .brn');
  A('cmp ' + Lv(7) + ', 0');
  A('je .brf');
  A('push edx');
  A('mov edx, eax');
  A('sub edx, 65');
  A('cmp edx, 25');
  A('ja .brx');
  A('or eax, 32');
  A('.brx:');
  A('pop edx');
  A('push eax');
  A('mov eax, edx');
  A('sub eax, 65');
  A('cmp eax, 25');
  A('ja .bry');
  A('or edx, 32');
  A('.bry:');
  A('pop eax');
  A('cmp eax, edx');
  A('jne .brf');
  A('.brn:');
  A('inc ecx');
  A('jmp .brl');
  A('.brf:');
  A('mov edi, dword ptr [esi]');
  A('jmp .fail');
  A('.brd:');
  A('add ebx, ' + Lv(6));
  A('mov edi, dword ptr [esi]');
  A('jmp .next');

  { anticipation : (?= ...) (?! ...), a = longueur, b = negation }
  A('.look:');
  A('mov eax, dword ptr [ecx+4]');
  A('mov ' + Lv(5) + ', eax');
  A('mov eax, dword ptr [ecx+8]');
  A('mov ' + Lv(6) + ', eax');
  A('mov eax, ' + Lv(3));
  A('mov ' + Lv(4) + ', eax');
  A('mov dword ptr [esi+20], eax');
  A('mov eax, ' + Lv(1));
  A('inc eax');
  A('push ebx');
  A('push eax');
  A('push esi');
  A('call _JSRT_rx_match');
  A('add esp, 12');
  A('mov edi, dword ptr [esi]');
  A('mov edx, dword ptr [esi+20]');
  A('mov ' + Lv(3) + ', edx');
  A('cmp ' + Lv(6) + ', 0');
  A('jne .nlk');
  A('test eax, eax');
  A('jz .fail');
  A('mov eax, ' + Lv(5));
  A('add ' + Lv(1) + ', eax');
  A('jmp .step');
  A('.nlk:');
  A('test eax, eax');
  A('jz .nlok');
  { la sous-expression a reussi : on defait ses effets puis on echoue }
  A('.unw:');
  A('mov ecx, ' + Lv(3));
  A('cmp ecx, ' + Lv(4));
  A('jbe .fail');
  A('sub ecx, 12');
  A('mov ' + Lv(3) + ', ecx');
  A('mov eax, dword ptr [ecx]');
  A('test eax, eax');
  A('jz .unw');
  A('mov edx, dword ptr [ecx+4]');
  A('shl edx, 2');
  A('cmp eax, 1');
  A('jne .unm');
  A('add edx, dword ptr [esi+12]');
  A('jmp .unp');
  A('.unm:');
  A('add edx, dword ptr [esi+16]');
  A('.unp:');
  A('mov eax, dword ptr [ecx+8]');
  A('mov dword ptr [edx], eax');
  A('jmp .unw');
  A('.nlok:');
  A('mov eax, ' + Lv(5));
  A('add ' + Lv(1) + ', eax');
  A('jmp .step');
  FEnd;
End;

{ ---- Expressions regulieres : objets RegExp et methodes des chaines ----

  Programme compile : instructions +0, nombre +4, groupes +8, marques +12,
  drapeaux +16, contexte d'execution reutilise +20. Cellule RegExp :
  source +8, drapeaux (texte) +12, programme +16, lastIndex +20. }

Const
  RX_STACK_BYTES = 4194304;

{ Avance la position (local loc) d'un caractere dans la chaine du registre textreg. }
Procedure RxAdv(Const loc, textreg: TString);
Var
  la, ld: TString;
Begin
  la := U('a');
  ld := U('d');
  A('inc ' + loc);
  A(la + ':');
  A('mov eax, ' + loc);
  A('cmp eax, dword ptr [' + textreg + '+$STR_LEN]');
  A('jae ' + ld);
  A('movzx edx, byte ptr [' + textreg + '+eax+$STR_DATA]');
  A('and edx, 192');
  A('cmp edx, 128');
  A('jne ' + ld);
  A('inc ' + loc);
  A('jmp ' + la);
  A(ld + ':');
End;

{ Empile l'argument i (undefined si absent), valeur de 8 octets. }
Procedure RxPushArg(i: LongInt);
Var
  l1, l2: TString;
Begin
  l1 := U('h');
  l2 := U('e');
  A('cmp dword ptr [ebp+12], ' + IntToStr(i + 1));
  A('jae ' + l1);
  A('push $UNDEF');
  A('push 0');
  A('jmp ' + l2);
  A(l1 + ':');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8 * i) + ']');
  A(l2 + ':');
End;

{ Compare le nom [ebp+12] au texte et saute vers lbl s'il est egal. }
Procedure RxNameIs(Const text, lbl: TString);
Begin
  A('push dword ptr [ebp+12]');
  A('push offset ' + RtStr(text));
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('test eax, eax');
  A('jnz ' + lbl);
End;

Procedure RtRxApi;
Begin
