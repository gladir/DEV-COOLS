  A('shl ecx, 2');
  A('push ecx');
  A('call _JSRT_alloc');
  A('add esp, 4');
  A('mov dword ptr [esi+16], eax');
  A('mov eax, dword ptr [ebx+16]');
  A('mov dword ptr [esi+28], eax');
  A('mov ecx, dword ptr [esi+32]');
  A('mov edx, dword ptr [esi+12]');
  A('.f1:');
  A('test ecx, ecx');
  A('jz .f1d');
  A('mov dword ptr [edx], -1');
  A('add edx, 4');
  A('dec ecx');
  A('jmp .f1');
  A('.f1d:');
  A('mov ecx, dword ptr [esi+36]');
