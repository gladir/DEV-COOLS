Function HexU(v: Int64): TString;
Const
  H = '0123456789ABCDEF';
Var
  s: TString;
  i: Integer;
Begin
  v := v And $FFFFFFFF;
  s := '';
  For i := 1 To 8 Do
    Begin
      s := H[(v And 15) + 1] + s;
      v := v Shr 4;
    End;
  HexU := s;
End;

Function ImmText(v: LongInt): TString;
Var
  s: String[12];
Begin
  If (v > -65536) And (v < 1048576) Then
    Begin
      Str(v, s);
      ImmText := s;
    End
  Else
    ImmText := '0' + HexU(v) + 'h';
End;

Function RegName(r: TReg): TString;
Begin
  Case r Of
    R_EAX: RegName := 'eax';
    R_ECX: RegName := 'ecx';
    R_EDX: RegName := 'edx';
    R_EBX: RegName := 'ebx';
    R_ESP: RegName := 'esp';
    R_EBP: RegName := 'ebp';
    R_ESI: RegName := 'esi';
    R_EDI: RegName := 'edi';
    R_CL:  RegName := 'cl';
    R_AL:  RegName := 'al';
    R_DL:  RegName := 'dl';
    R_BL:  RegName := 'bl';
  Else
    RegName := '?';
  End;
End;

Function SymNameOf(Var ctx: TCompilerContext; symkind, sym: LongInt): TString;
Begin
  If symkind = SYMK_D Then
    SymNameOf := DsymP(ctx.data.syms, sym)^.name
  Else
    SymNameOf := XsymP(ctx.ir.xsyms, sym)^.name;
End;

Function DispText(d: LongInt): TString;
Var
  s: String[12];
Begin
  If d = 0 Then
    DispText := ''
  Else If d > 0 Then
    Begin
      Str(d, s);
      DispText := '+' + s;
    End
  Else
    Begin
      Str(d, s);
      DispText := s;
    End;
End;

Function OperandText(Var ctx: TCompilerContext; Var o: TOperand): TString;
Var
  pfx, inner: TString;
Begin
  Case o.kind Of
    OD_REG:
      OperandText := RegName(o.reg);
    OD_IMM:
      OperandText := ImmText(o.disp);
    OD_MEM:
      Begin
        Begin
          If o.size = 1 Then
            pfx := 'byte ptr ['
          Else If o.size = 2 Then
            pfx := 'word ptr ['
          Else If o.size = 8 Then
            pfx := 'qword ptr ['
          Else
            pfx := 'dword ptr [';
          inner := '';
          If o.base <> R_NONE Then
            inner := RegName(o.base);
          If o.index <> R_NONE Then
            Begin
              If inner <> '' Then
                inner := inner + '+';
              inner := inner + RegName(o.index);
            End;
          If o.symkind <> 0 Then
            Begin
              If inner <> '' Then
                inner := inner + '+';
              inner := inner + SymNameOf(ctx, o.symkind, o.sym);
            End;
          OperandText := pfx + inner + DispText(o.disp) + ']';
        End;
      End;
    OD_ADDR:
      OperandText := 'offset ' + SymNameOf(ctx, o.symkind, o.sym);
    OD_LABEL:
      OperandText := SymLabel(o.disp);
  Else
    OperandText := '';
  End;
End;

