        k := MemRd(esp + 40, 4);
        MemWr(k, 400, 4);
        MemWr(k + 4, 401, 4);
        MemWr(k + 8, 4243, 4);
        MemWr(k + 12, 4244, 4);
        emu_reg[Ord(R_EAX)] := 1;
      End;
    21: { WaitForSingleObject }
      Begin
        n := 8;
        emu_reg[Ord(R_EAX)] := 0;
      End;
    22: { GetExitCodeProcess(h, ptr) }
      Begin
        n := 8;
        MemWr(a2, LongWord(emu_procexit), 4);
        emu_reg[Ord(R_EAX)] := 1;
      End;
    23: { GetTimeZoneInformation(ptr) : UTC }
      Begin
        n := 4;
        For k := 0 To 42 Do
          MemWr(a1 + 4 * LongWord(k), 0, 4);
        emu_reg[Ord(R_EAX)] := 0;
      End;
    28: { GetLastError }
      Begin
        n := 0;
        emu_reg[Ord(R_EAX)] := emu_lasterr;
      End;
    29: { SetEndOfFile }
      Begin
        n := 4;
        If (a1 >= 100) And (a1 < 100 + EMU_FILES) Then
          Begin
            {$I-}
            Truncate(emu_fh[a1 - 99]);
            {$I-}
            If IOResult = 0 Then
              emu_reg[Ord(R_EAX)] := 1;
          End;
      End;
    30: { FlushFileBuffers }
      Begin
        n := 4;
        emu_reg[Ord(R_EAX)] := 1;
      End;
    31: { SetFileAttributesW }
      Begin
        n := 8;
        emu_reg[Ord(R_EAX)] := 1;
      End;
    32: { GetTempPathW(taille, tampon) }
      Begin
        n := 8;
        emu_reg[Ord(R_EAX)] := EmuPutW(a2, '/tmp/', a1);
      End;
    33: { GetFullPathNameW(nom, taille, tampon, ptrfichier) }
      Begin
        n := 16;
        s := EmuWStr(a1);
        If (s = '') Or (s[1] <> '/') Then
          Begin
            GetDir(0, s2);
            s := s2 + '/' + s;
          End;
        emu_reg[Ord(R_EAX)] := EmuPutW(a3, s, a2);
      End;
    37: { SetFileTime }
      Begin
        n := 16;
        emu_reg[Ord(R_EAX)] := 1;
      End;
    38: { GetCurrentProcessId }
      Begin
        n := 0;
        emu_reg[Ord(R_EAX)] := 4242;
      End;
    39: { GetFileInformationByHandle }
      Begin
        n := 8;
      End;
    40: { TerminateProcess }
      Begin
        n := 8;
        emu_reg[Ord(R_EAX)] := 1;
      End;
    41: { RtlMoveMemory(dst, src, n) }
      Begin
        n := 12;
        For k := 0 To LongInt(a3) - 1 Do
          MemWr(a1 + LongWord(k), MemRd(a2 + LongWord(k), 1), 1);
      End;
    42: { lstrlenW(ptr) }
      Begin
        n := 4;
        k := 0;
        While (MemRd(a1 + 2 * LongWord(k), 2) <> 0) And Not emu_halt Do
          Inc(k);
        emu_reg[Ord(R_EAX)] := k;
      End;
  Else
    EmuFault('appel systeme inconnu ' + IntToStr(i));
  End;
  emu_reg[Ord(R_ESP)] := emu_reg[Ord(R_ESP)] + 4 + n;
  If Not emu_halt Then
    Begin
      emu_pc := (MemRd(esp, 4) - EMU_CODE) Div 4;
      If MemRd(esp, 4) = EMU_HALTADDR Then
        emu_halt := True;
    End;
End;

Procedure EmuTrap(id: LongInt);
Var
  esp, a1, a2, a3, a4, n, i: LongWord;
  k: LongInt;
  c: Byte;
  ch: Char;
  s: String;
  vq: Int64;
Begin
  esp := emu_reg[Ord(R_ESP)];
  a1 := MemRd(esp + 4, 4);
  a2 := MemRd(esp + 8, 4);
  a3 := MemRd(esp + 12, 4);
  a4 := MemRd(esp + 16, 4);
  n := 0;
  If id >= 100 Then
    Begin
      EmuSys(id - 100);
      Exit;
    End;
  Case id Of
    1: { VirtualAlloc(adresse, taille, type, protection) }
      Begin
        n := 16;
        a2 := (a2 + $FFF) And $FFFFF000;
        { fenetres de 64 Ko : le ramasse-miettes retrouve les blocs par adresse }
        emu_brk := (emu_brk + $FFFF) And $FFFF0000;
        If emu_brk + a2 > EMU_BASE + EMU_MEM_SIZE - $500000 Then
          emu_reg[Ord(R_EAX)] := 0
        Else
          Begin
            emu_reg[Ord(R_EAX)] := emu_brk;
            emu_brk := emu_brk + a2;
          End;
      End;
    2: { ExitProcess(code) }
      Begin
        n := 4;
        emu_exit := a1;
        emu_halt := True;
      End;
    3: { GetStdHandle(n) : 0 stdin, 1 stdout, 2 stderr }
      Begin
        n := 4;
        If LongInt(a1) = -10 Then
          emu_reg[Ord(R_EAX)] := 0
        Else If LongInt(a1) = -11 Then
          emu_reg[Ord(R_EAX)] := 1
        Else
          emu_reg[Ord(R_EAX)] := 2;
      End;
    4: { WriteFile(handle, tampon, nombre, ecrits, recouvrement) }
      Begin
        n := 20;
        If a1 >= 100 Then
          Begin
            k := EmuHWrite(a1, a2, a3);
            If k < 0 Then
              Begin
                emu_lasterr := 6;
                emu_reg[Ord(R_EAX)] := 0;
              End
            Else
              Begin
                If a4 <> 0 Then
                  MemWr(a4, LongWord(k), 4);
                emu_reg[Ord(R_EAX)] := 1;
              End;
          End
        Else
          Begin
            s := '';
            i := 0;
            While i < a3 Do
              Begin
                c := MemRd(a2 + i, 1);
                If c <> 13 Then
                  s := s + Chr(c);
                If Length(s) >= 200 Then
                  Begin
                    If a1 = 2 Then
                      Write(ErrOutput, s)
                    Else
                      Write(s);
                    s := '';
                  End;
                Inc(i);
              End;
            If a1 = 2 Then
              Write(ErrOutput, s)
            Else
              Write(s);
            Flush(Output);
            If a4 <> 0 Then
              MemWr(a4, a3, 4);
            emu_reg[Ord(R_EAX)] := 1;
          End;
      End;
    6: { GetTickCount() }
      Begin
        n := 0;
        emu_reg[Ord(R_EAX)] := 123456789;
      End;
    5: { ReadFile(handle, tampon, nombre, lus, recouvrement) : lit l'entree standard }
      Begin
        n := 20;
        If a1 >= 100 Then
          Begin
            k := EmuHRead(a1, a2, a3);
            If k < 0 Then
              Begin
                emu_lasterr := 6;
                emu_reg[Ord(R_EAX)] := 0;
              End
            Else
              Begin
                If a4 <> 0 Then
                  MemWr(a4, LongWord(k), 4);
                emu_reg[Ord(R_EAX)] := 1;
              End;
          End
        Else
          Begin
            i := 0;
            If a1 = 0 Then
              While (i < a3) And Not Eof(Input) Do
                Begin
                  Read(Input, ch);
                  MemWr(a2 + i, Ord(ch), 1);
                  Inc(i);
                  If ch = #10 Then
                    Break;
                End;
            If a4 <> 0 Then
              MemWr(a4, i, 4);
            emu_reg[Ord(R_EAX)] := 1;
          End;
      End;
    8: { GetSystemTimeAsFileTime(ptr) : horloge simulee (heure de depart + temps ecoule) }
      Begin
        n := 4;
        vq := (EmuUnixMs + emu_vclock + Int64(emu_steps) Div 1000000 + 11644473600000) * 10000;
        MemWr(a1, LongWord(vq And $FFFFFFFF), 4);
        MemWr(a1 + 4, LongWord((vq Shr 32) And $FFFFFFFF), 4);
        emu_reg[Ord(R_EAX)] := 0;
      End;
    10: { VirtualFree(adresse, taille, type) : la memoire simulee n'est pas reutilisee }
      Begin
        n := 12;
        emu_reg[Ord(R_EAX)] := 1;
      End;
    9: { Sleep(ms) : avance l'horloge simulee sans attendre }
      Begin
        n := 4;
        emu_vclock := emu_vclock + a1;
        emu_reg[Ord(R_EAX)] := 0;
      End;
    7: { GetCommandLineA() : ligne de commande simulee }
      Begin
        n := 0;
        a2 := emu_brk;
        emu_brk := emu_brk + $1000;
        For i := 0 To 11 Do
          MemWr(a2 + i, Ord('prog.exe'#0#0#0#0[i + 1]), 1);
        emu_reg[Ord(R_EAX)] := a2;
      End;
  Else
    EmuFault('appel systeme inconnu');
  End;
  { retour a l'appelant : adresse puis arguments }
  emu_reg[Ord(R_ESP)] := emu_reg[Ord(R_ESP)] + 4 + n;
  If Not emu_halt Then
    Begin
      emu_pc := (MemRd(esp, 4) - EMU_CODE) Div 4;
      If MemRd(esp, 4) = EMU_HALTADDR Then
        emu_halt := True;
    End;
End;

{ Transfere l'execution a l'adresse de code a ; ret est l'adresse de
  retour a empiler (0 pour un saut). }
Procedure EmuCall(a: LongWord; ret: LongWord);
Begin
  If ret <> 0 Then
    EmuPush(ret);
  If a >= EMU_TRAP Then
    Begin
      EmuTrap((a - EMU_TRAP) Div 4);
      Exit;
    End;
  If (a < EMU_CODE) Or (a >= EMU_TRAP) Then
    Begin
      EmuFault('appel vers une adresse invalide ' + HexU(a));
      Exit;
    End;
  emu_pc := (a - EMU_CODE) Div 4;
End;

{ ---- FPU x87 simulee (TODO 19) ---- }

Var
  fpu_st: Array[0..7] Of Extended;
  fpu_n: Integer;
  fpu_cw: Word;
  fpu_sw: Word;

Procedure FpuPush(v: Extended);
Var
  i: Integer;
Begin
  If fpu_n >= 8 Then
    Begin
      EmuFault('depassement de la pile x87');
      Exit;
    End;
  Inc(fpu_n);
  fpu_st[fpu_n - 1] := v;
End;

Function FpuPop: Extended;
Begin
  If fpu_n <= 0 Then
    Begin
      EmuFault('pile x87 vide');
      FpuPop := 0;
      Exit;
    End;
  FpuPop := fpu_st[fpu_n - 1];
  Dec(fpu_n);
End;

{ Arrondi selon le mode d'arrondi du mot de controle. }
Function FpuRound(x: Extended): Extended;
Var
  t, d: Extended;
  rc: Integer;
Begin
  rc := (fpu_cw Shr 10) And 3;
  t := Int(x);
  d := x - t;
  Case rc Of
    3: FpuRound := t;
    1: If d < 0 Then FpuRound := t - 1 Else FpuRound := t;
    2: If d > 0 Then FpuRound := t + 1 Else FpuRound := t;
  Else
    Begin
      If d > 0.5 Then
        FpuRound := t + 1
      Else If d < -0.5 Then
        FpuRound := t - 1
      Else If d = 0.5 Then
        Begin
          If Frac(t / 2) <> 0 Then FpuRound := t + 1 Else FpuRound := t;
        End
      Else If d = -0.5 Then
        Begin
          If Frac(t / 2) <> 0 Then FpuRound := t - 1 Else FpuRound := t;
        End
      Else
        FpuRound := t;
    End;
  End;
End;

{ Precision de 53 bits quand le mot de controle le demande. }
Function FpuPC(x: Extended): Extended;
Var
  d: Double;
Begin
  If (fpu_cw Shr 8) And 3 = 2 Then
    Begin
      d := x;
      FpuPC := d;
    End
  Else
    FpuPC := x;
End;

Function FpuRdMem(Var ctx: TCompilerContext; Var o: TOperand): Extended;
Var
  a: LongWord;
  d: Double;
  sg: Single;
  q: Int64;
  l: LongInt;
  w: SmallInt;
Begin
  FpuRdMem := 0;
  a := EffAddr(ctx, o);
  If Not MemOk(a, 8) Then
    Begin
      EmuFault('lecture hors memoire a ' + HexU(a));
      Exit;
    End;
  If o.size = 4 Then
    Begin
      Move(emu_mem^[a - EMU_BASE], sg, 4);
      FpuRdMem := sg;
    End
  Else
    Begin
      Move(emu_mem^[a - EMU_BASE], d, 8);
      FpuRdMem := d;
    End;
End;

Procedure FpuWrMem(Var ctx: TCompilerContext; Var o: TOperand; v: Extended);
Var
  a: LongWord;
  d: Double;
  sg: Single;
Begin
  a := EffAddr(ctx, o);
  If Not MemOk(a, 8) Then
    Begin
      EmuFault('ecriture hors memoire a ' + HexU(a));
      Exit;
    End;
  If o.size = 4 Then
    Begin
      sg := v;
      Move(sg, emu_mem^[a - EMU_BASE], 4);
    End
  Else
    Begin
      d := v;
      Move(d, emu_mem^[a - EMU_BASE], 8);
    End;
End;

Procedure FpuCompare(x, y: Extended);
Begin
  fpu_sw := fpu_sw And Not ($4500);
  If (x <> x) Or (y <> y) Then
    fpu_sw := fpu_sw Or $4500
  Else If x > y Then
    fpu_sw := fpu_sw
  Else If x < y Then
    fpu_sw := fpu_sw Or $0100
  Else
    fpu_sw := fpu_sw Or $4000;
End;

{ Reste exact (fprem) : le quotient peut depasser 2^64. }
Function FpuRem(x, y: Extended): Extended;
{$IFDEF FPC}
Var
  r: Extended;
Begin
  r := 0;
  asm
    fld tbyte ptr y
    fld tbyte ptr x
  @loop:
    fprem
    fnstsw ax
    test ah, 4
    jnz @loop
    fstp tbyte ptr r
    fstp st(0)
  end;
  FpuRem := r;
End;
{$ELSE}
Begin
  FpuRem := x - y * Int(x / y);
End;
{$ENDIF}

Procedure FpuBinary(op: TOpc; Var x: Extended; y: Extended);
Begin
  Case op Of
    OP_FADD, OP_FADDP: x := x + y;
    OP_FSUB, OP_FSUBP: x := x - y;
    OP_FSUBR, OP_FSUBRP: x := y - x;
    OP_FMUL, OP_FMULP: x := x * y;
    OP_FDIV, OP_FDIVP: x := x / y;
    OP_FDIVR, OP_FDIVRP: x := y / x;
  End;
  x := FpuPC(x);
End;

Procedure EmuFpu(Var ctx: TCompilerContext; Var ins: TInstr);
Var
  x, y, t: Extended;
  q: Int64;
  l: LongInt;
  w: SmallInt;
  a: LongWord;
  n: LongInt;
Begin
  Case ins.op Of
    OP_FLD:
      Begin
        If ins.a.kind = OD_IMM Then
          FpuPush(fpu_st[fpu_n - 1 - ins.a.disp])
        Else
          FpuPush(FpuRdMem(ctx, ins.a));
      End;
    OP_FILD:
      Begin
        a := EffAddr(ctx, ins.a);
        If Not MemOk(a, 8) Then
          EmuFault('lecture hors memoire a ' + HexU(a))
        Else If ins.a.size = 8 Then
          Begin
            Move(emu_mem^[a - EMU_BASE], q, 8);
            FpuPush(q);
          End
        Else If ins.a.size = 2 Then
          Begin
            Move(emu_mem^[a - EMU_BASE], w, 2);
            FpuPush(w);
          End
        Else
          Begin
            Move(emu_mem^[a - EMU_BASE], l, 4);
            FpuPush(l);
          End;
      End;
    OP_FST, OP_FSTP:
      Begin
        x := fpu_st[fpu_n - 1];
        FpuWrMem(ctx, ins.a, x);
        If ins.op = OP_FSTP Then
          FpuPop;
      End;
    OP_FISTP:
      Begin
        x := FpuRound(FpuPop);
        a := EffAddr(ctx, ins.a);
        If Not MemOk(a, 8) Then
          EmuFault('ecriture hors memoire a ' + HexU(a))
        Else If ins.a.size = 8 Then
          Begin
            If (x <> x) Or (Abs(x) >= 9.2233720368547758E18) Then
              q := Int64($8000000000000000)
            Else
              q := Trunc(x);
            Move(q, emu_mem^[a - EMU_BASE], 8);
          End
        Else If ins.a.size = 2 Then
          Begin
            If (x <> x) Or (Abs(x) >= 32768) Then
              w := -32768
            Else
              w := Trunc(x);
            Move(w, emu_mem^[a - EMU_BASE], 2);
          End
        Else
          Begin
            If (x <> x) Or (x >= 2147483648.0) Or (x < -2147483648.0) Then
              l := LongInt($80000000)
            Else
              l := Trunc(x);
            Move(l, emu_mem^[a - EMU_BASE], 4);
          End;
      End;
    OP_FADD, OP_FSUB, OP_FSUBR, OP_FMUL, OP_FDIV, OP_FDIVR:
      Begin
        If ins.a.kind = OD_IMM Then
          y := fpu_st[fpu_n - 1 - ins.a.disp]
        Else
          y := FpuRdMem(ctx, ins.a);
        FpuBinary(ins.op, fpu_st[fpu_n - 1], y);
      End;
    OP_FADDP, OP_FSUBP, OP_FSUBRP, OP_FMULP, OP_FDIVP, OP_FDIVRP:
      Begin
        If fpu_n < 2 Then
          EmuFault('pile x87 insuffisante')
        Else
          Begin
            y := fpu_st[fpu_n - 1];
            Case ins.op Of
              OP_FSUBRP: FpuBinary(OP_FSUBR, fpu_st[fpu_n - 2], y);
              OP_FDIVRP: FpuBinary(OP_FDIVR, fpu_st[fpu_n - 2], y);
              OP_FADDP: FpuBinary(OP_FADD, fpu_st[fpu_n - 2], y);
              OP_FSUBP: FpuBinary(OP_FSUB, fpu_st[fpu_n - 2], y);
              OP_FMULP: FpuBinary(OP_FMUL, fpu_st[fpu_n - 2], y);
              OP_FDIVP: FpuBinary(OP_FDIV, fpu_st[fpu_n - 2], y);
            End;
            Dec(fpu_n);
          End;
      End;
    OP_FCHS:
      fpu_st[fpu_n - 1] := -fpu_st[fpu_n - 1];
    OP_FABS:
      fpu_st[fpu_n - 1] := Abs(fpu_st[fpu_n - 1]);
    OP_FSQRT:
      fpu_st[fpu_n - 1] := FpuPC(Sqrt(fpu_st[fpu_n - 1]));
    OP_FXCH:
      Begin
        n := 1;
        If ins.a.kind = OD_IMM Then
          n := ins.a.disp;
        If fpu_n < n + 1 Then
          EmuFault('pile x87 insuffisante')
        Else
          Begin
            t := fpu_st[fpu_n - 1];
            fpu_st[fpu_n - 1] := fpu_st[fpu_n - 1 - n];
            fpu_st[fpu_n - 1 - n] := t;
          End;
      End;
    OP_FLD1: FpuPush(1);
    OP_FLDZ: FpuPush(0);
    OP_FLDPI: FpuPush(Pi);
    OP_FLDLN2: FpuPush(Ln(2.0));
    OP_FLDL2E: FpuPush(1.0 / Ln(2.0));
    OP_FLDLG2: FpuPush(Ln(2.0) / Ln(10.0));
    OP_FYL2X:
      Begin
        x := FpuPop;
        fpu_st[fpu_n - 1] := fpu_st[fpu_n - 1] * (Ln(x) / Ln(2.0));
      End;
    OP_F2XM1:
      fpu_st[fpu_n - 1] := Exp(fpu_st[fpu_n - 1] * Ln(2.0)) - 1;
    OP_FSCALE:
      Begin
        x := fpu_st[fpu_n - 1];
        n := Trunc(fpu_st[fpu_n - 2]);
        y := x;
        If n > 0 Then
          While n > 0 Do
            Begin
              y := y * 2;
              Dec(n);
            End
        Else
          While n < 0 Do
            Begin
              y := y / 2;
              Inc(n);
            End;
        fpu_st[fpu_n - 1] := y;
      End;
    OP_FPREM:
      Begin
        x := fpu_st[fpu_n - 1];
        y := fpu_st[fpu_n - 2];
        If (y = 0) Or (x <> x) Or (y <> y) Then
          fpu_st[fpu_n - 1] := 0.0 / 0.0
        Else If Abs(y) = 1.0 / 0.0 Then
          fpu_st[fpu_n - 1] := x
        Else
          fpu_st[fpu_n - 1] := FpuRem(x, y);
        fpu_sw := fpu_sw And Not $0400;
      End;
    OP_FRNDINT:
      fpu_st[fpu_n - 1] := FpuRound(fpu_st[fpu_n - 1]);
    OP_FSIN:
      fpu_st[fpu_n - 1] := Sin(fpu_st[fpu_n - 1]);
    OP_FCOS:
      fpu_st[fpu_n - 1] := Cos(fpu_st[fpu_n - 1]);
    OP_FPATAN:
      Begin
        x := FpuPop;
        fpu_st[fpu_n - 1] := ArcTan2(fpu_st[fpu_n - 1], x);
      End;
    OP_FCOMPP:
      Begin
        x := FpuPop;
        y := FpuPop;
        FpuCompare(x, y);
      End;
    OP_FTST:
      FpuCompare(fpu_st[fpu_n - 1], 0);
    OP_FNSTSW:
      emu_reg[Ord(R_EAX)] := (emu_reg[Ord(R_EAX)] And $FFFF0000) Or fpu_sw;
    OP_FNSTCW:
      Begin
        a := EffAddr(ctx, ins.a);
        MemWr(a, fpu_cw, 2);
      End;
    OP_FLDCW:
      Begin
        a := EffAddr(ctx, ins.a);
        fpu_cw := MemRd(a, 2);
      End;
    OP_FPOP:
      FpuPop;
  End;
End;

Procedure EmuStep(Var ctx: TCompilerContext);
Var
  ins: ^TInstr;
  sz, tmp, i: Integer;
  a, b, r: LongWord;
  w: Int64;
  cnt: Integer;
  d: LongWord;
  si, di, cx: LongWord;
Begin
  If (emu_pc < 1) Or (emu_pc > ctx.ir.count) Then
    Begin
      EmuFault('compteur ordinal hors programme');
      Exit;
    End;
  ins := @InstrP(ctx.ir.instrs, emu_pc)^;
  Inc(emu_pc);
  Case ins^.op Of
    OP_NONE, OP_LABEL, OP_COMMENT, OP_PROC, OP_ENDP, OP_NOP:
      ;
    OP_MOV:
      Begin
        sz := OpSz(ins^.a);
        OpWr(ctx, ins^.a, OpRd(ctx, ins^.b, sz), sz);
      End;
    OP_LEA:
      OpWr(ctx, ins^.a, EffAddr(ctx, ins^.b), 4);
    OP_MOVZX:
      Begin
        sz := OpSz(ins^.b);
        If (ins^.b.kind = OD_MEM) And (ins^.b.size = 0) Then
          sz := 1;
        OpWr(ctx, ins^.a, OpRd(ctx, ins^.b, sz), 4);
      End;
    OP_PUSH:
      EmuPush(OpRd(ctx, ins^.a, 4));
    OP_POP:
      Begin
        r := EmuPop;
        OpWr(ctx, ins^.a, r, 4);
      End;
    OP_ADD:
      Begin
        sz := OpSz(ins^.a);
        OpWr(ctx, ins^.a, AluAdd(OpRd(ctx, ins^.a, sz), OpRd(ctx, ins^.b, sz), sz), sz);
      End;
    OP_SUB:
      Begin
        sz := OpSz(ins^.a);
        OpWr(ctx, ins^.a, AluSub(OpRd(ctx, ins^.a, sz), OpRd(ctx, ins^.b, sz), sz), sz);
      End;
    OP_CMP:
      Begin
        sz := OpSz(ins^.a);
        AluSub(OpRd(ctx, ins^.a, sz), OpRd(ctx, ins^.b, sz), sz);
      End;
    OP_AND, OP_OR, OP_XOR, OP_TEST:
      Begin
        sz := OpSz(ins^.a);
        a := OpRd(ctx, ins^.a, sz);
        b := OpRd(ctx, ins^.b, sz);
        Case ins^.op Of
          OP_AND, OP_TEST: r := a And b;
          OP_OR:           r := a Or b;
        Else
          r := a Xor b;
        End;
        emu_cf := False;
        emu_of := False;
        SetZS(r, sz);
        If ins^.op <> OP_TEST Then
          OpWr(ctx, ins^.a, r, sz);
      End;
    OP_NOT:
      Begin
        sz := OpSz(ins^.a);
        OpWr(ctx, ins^.a, Not OpRd(ctx, ins^.a, sz), sz);
      End;
    OP_NEG:
      Begin
        sz := OpSz(ins^.a);
        a := OpRd(ctx, ins^.a, sz);
        r := AluSub(0, a, sz);
        OpWr(ctx, ins^.a, r, sz);
      End;
    OP_INC, OP_DEC:
      Begin
        sz := OpSz(ins^.a);
        a := OpRd(ctx, ins^.a, sz);
        If emu_cf Then
          d := 1
        Else
          d := 0;
        If ins^.op = OP_INC Then
          r := AluAdd(a, 1, sz)
        Else
          r := AluSub(a, 1, sz);
        emu_cf := d <> 0;
        OpWr(ctx, ins^.a, r, sz);
      End;
    OP_IMUL:
      Begin
        w := Int64(LongInt(OpRd(ctx, ins^.a, 4))) * Int64(LongInt(OpRd(ctx, ins^.b, 4)));
        r := LongWord(w And $FFFFFFFF);
        emu_of := (w > 2147483647) Or (w < -2147483648);
        emu_cf := emu_of;
        SetZS(r, 4);
        OpWr(ctx, ins^.a, r, 4);
      End;
    OP_CDQ:
      Begin
        If (emu_reg[Ord(R_EAX)] And $80000000) <> 0 Then
          emu_reg[Ord(R_EDX)] := $FFFFFFFF
        Else
          emu_reg[Ord(R_EDX)] := 0;
      End;
    OP_IDIV:
      Begin
        b := OpRd(ctx, ins^.a, 4);
        If b = 0 Then
          Begin
            EmuFault('division entiere par zero');
            Exit;
          End;
        w := (Int64(LongInt(emu_reg[Ord(R_EDX)])) Shl 32) Or Int64(emu_reg[Ord(R_EAX)]);
        If (w Div Int64(LongInt(b)) > 2147483647) Or (w Div Int64(LongInt(b)) < -2147483648) Then
          Begin
            EmuFault('depassement de idiv');
            Exit;
          End;
        emu_reg[Ord(R_EAX)] := LongWord((w Div Int64(LongInt(b))) And $FFFFFFFF);
        emu_reg[Ord(R_EDX)] := LongWord((w Mod Int64(LongInt(b))) And $FFFFFFFF);
      End;
    OP_DIV:
      Begin
        b := OpRd(ctx, ins^.a, 4);
        If b = 0 Then
          Begin
            EmuFault('division entiere par zero');
            Exit;
          End;
        w := (Int64(emu_reg[Ord(R_EDX)]) Shl 32) Or Int64(emu_reg[Ord(R_EAX)]);
        If (w Div Int64(b)) > $FFFFFFFF Then
          Begin
            EmuFault('depassement de div');
            Exit;
          End;
        emu_reg[Ord(R_EAX)] := LongWord((w Div Int64(b)) And $FFFFFFFF);
        emu_reg[Ord(R_EDX)] := LongWord((w Mod Int64(b)) And $FFFFFFFF);
      End;
    OP_SHL, OP_SHR, OP_SAR:
      Begin
        sz := OpSz(ins^.a);
        a := OpRd(ctx, ins^.a, sz);
        cnt := OpRd(ctx, ins^.b, 1) And 31;
        If cnt > 0 Then
          Begin
            If ins^.op = OP_SHL Then
              Begin
                w := Int64(a) Shl cnt;
                emu_cf := ((Int64(a) Shr (sz * 8 - cnt)) And 1) <> 0;
                r := LongWord(w And $FFFFFFFF);
              End
            Else If ins^.op = OP_SHR Then
              Begin
                emu_cf := ((a Shr (cnt - 1)) And 1) <> 0;
                r := a Shr cnt;
              End
            Else
              Begin
                emu_cf := ((a Shr (cnt - 1)) And 1) <> 0;
                r := LongWord(LongInt(a) Shr cnt);
                If (a And $80000000) <> 0 Then
                  r := r Or (LongWord($FFFFFFFF) Shl (32 - cnt));
              End;
            emu_of := False;
            SetZS(r, sz);
            OpWr(ctx, ins^.a, r, sz);
          End;
      End;
    OP_JMP:
      Begin
        If ins^.a.kind = OD_LABEL Then
          emu_pc := emu_lblP(emu_lbl, ins^.a.disp)^
        Else
          Begin
            r := OpRd(ctx, ins^.a, 4);
            If (r < EMU_CODE) Or (r >= EMU_TRAP) Then
              EmuFault('saut vers une adresse invalide ' + HexU(r))
            Else
              emu_pc := (r - EMU_CODE) Div 4;
          End;
      End;
    OP_JE, OP_JNE, OP_JL, OP_JLE, OP_JG, OP_JGE, OP_JB, OP_JAE, OP_JA, OP_JBE,
    OP_JO, OP_JNO, OP_JS, OP_JNS:
      If EmuCond(ins^.op) Then
        emu_pc := emu_lblP(emu_lbl, ins^.a.disp)^;
    OP_CALL:
      Begin
        If (ins^.a.kind = OD_ADDR) And
           (SymAddr(ctx, ins^.a.symkind, ins^.a.sym) = 0) Then
          EmuFault('symbole non resolu : ' + SymNameOf(ctx, ins^.a.symkind, ins^.a.sym))
        Else If ins^.a.kind = OD_ADDR Then
          EmuCall(SymAddr(ctx, ins^.a.symkind, ins^.a.sym), EMU_CODE + 4 * LongWord(emu_pc))
        Else If ins^.a.kind = OD_LABEL Then
          EmuCall(EMU_CODE + 4 * LongWord(emu_lblP(emu_lbl, ins^.a.disp)^), EMU_CODE + 4 * LongWord(emu_pc))
        Else
          EmuCall(OpRd(ctx, ins^.a, 4), EMU_CODE + 4 * LongWord(emu_pc));
      End;
    OP_RET:
      Begin
        r := EmuPop;
        If r = EMU_HALTADDR Then
          emu_halt := True
        Else If (r < EMU_CODE) Or (r >= EMU_TRAP) Then
          EmuFault('retour vers une adresse invalide ' + HexU(r))
        Else
          emu_pc := (r - EMU_CODE) Div 4;
      End;
    OP_LEAVE:
      Begin
        emu_reg[Ord(R_ESP)] := emu_reg[Ord(R_EBP)];
        emu_reg[Ord(R_EBP)] := EmuPop;
      End;
    OP_REP_MOVSB:
      Begin
        si := emu_reg[Ord(R_ESI)];
        di := emu_reg[Ord(R_EDI)];
        cx := emu_reg[Ord(R_ECX)];
        While (cx > 0) And Not emu_halt Do
          Begin
            MemWr(di, MemRd(si, 1), 1);
            Inc(si);
            Inc(di);
            Dec(cx);
          End;
        emu_reg[Ord(R_ESI)] := si;
        emu_reg[Ord(R_EDI)] := di;
        emu_reg[Ord(R_ECX)] := cx;
      End;
  Else
    If ins^.op >= OP_FLD Then
      EmuFpu(ctx, ins^)
    Else
      EmuFault('instruction non emulee : ' + OpName(ins^.op));
  End;
End;

{ Charge le programme et l'execute depuis _JSSTART. Retourne le code de
  sortie. }
{ Nom de la procedure qui contient l'instruction idx. }
Function EmuProcAt(Var ctx: TCompilerContext; idx: LongInt): TString;
Begin
  EmuProcAt := '?';
  While (idx >= 1) And (idx <= ctx.ir.count) Do
    Begin
      If InstrP(ctx.ir.instrs, idx)^.op = OP_PROC Then
        Begin
          EmuProcAt := SymNameOf(ctx, InstrP(ctx.ir.instrs, idx)^.a.symkind, InstrP(ctx.ir.instrs, idx)^.a.sym);
          Exit;
        End;
      Dec(idx);
    End;
End;

{ Pile des appels au moment d'une erreur d'emulation (chaine des EBP). }
Procedure EmuBacktrace(Var ctx: TCompilerContext; fault_pc: LongInt);
Var
  bp, ret: LongWord;
  n: LongInt;
Begin
  Writeln('  dans ', EmuProcAt(ctx, fault_pc));
  bp := emu_reg[Ord(R_EBP)];
  n := 0;
  While (n < 12) And MemOk(bp, 8) Do
    Begin
      ret := 0;
      Move(emu_mem^[bp + 4 - EMU_BASE], ret, 4);
      If (ret < EMU_CODE) Or (ret >= EMU_TRAP) Then
        Break;
      Writeln('  appelee par ', EmuProcAt(ctx, LongInt((ret - EMU_CODE) Div 4)));
      Move(emu_mem^[bp - EMU_BASE], bp, 4);
      Inc(n);
    End;
End;

Function RunEmulator(Var ctx: TCompilerContext): LongInt;
Var
  i, j, start_idx: LongInt;
  nm: TString;
  d: LongInt;
  rdsz, a: LongWord;
  names_done: Boolean;
Begin
  RunEmulator := 1;
  emu_ctx := @ctx;
  GetMem(emu_mem, EMU_MEM_SIZE);
  FillChar(emu_mem^, EMU_MEM_SIZE, 0);
  FillChar(emu_reg, SizeOf(emu_reg), 0);
  emu_halt := False;
  fpu_n := 0;
  fpu_cw := $037F;
  fpu_sw := 0;
  emu_exit := 0;
  emu_fault_msg := '';
  emu_steps := 0;
  emu_zf := False;
  emu_sf := False;
  emu_cf := False;
  emu_of := False;
  emu_rd_base := EMU_BASE + $10000;
  rdsz := (ctx.data.rd_size + $FFF) And $FFFFF000;
  emu_dt_base := emu_rd_base + rdsz + $1000;
  emu_brk := EMU_HEAP;
  emu_iat_next := EMU_BASE + $1000;
  If ctx.data.rd_size > 0 Then
    DlCopyOut(ctx.data.rd, 0, @emu_mem^[emu_rd_base - EMU_BASE], ctx.data.rd_size);
  If ctx.data.dt_size > 0 Then
    DlCopyOut(ctx.data.dt, 0, @emu_mem^[emu_dt_base - EMU_BASE], ctx.data.dt_size);

  { etiquettes et procedures }
  DlClear(emu_lbl);
  DlClear(emu_xaddr);
  For i := 1 To ctx.ir.count Do
    Begin
      If InstrP(ctx.ir.instrs, i)^.op = OP_LABEL Then
        emu_lblP(emu_lbl, InstrP(ctx.ir.instrs, i)^.a.disp)^ := i
      Else If InstrP(ctx.ir.instrs, i)^.op = OP_PROC Then
        emu_xaddrP(emu_xaddr, InstrP(ctx.ir.instrs, i)^.a.sym)^ := EMU_CODE + 4 * LongWord(i);
    End;
  { symboles externes : donnees du pool par leur nom, appels systeme }
  For i := 1 To ctx.ir.xsym_count Do
    If emu_xaddrP(emu_xaddr, i)^ = 0 Then
      Begin
        nm := XsymP(ctx.ir.xsyms, i)^.name;
        d := DsymFind(ctx, nm);
        If d <> 0 Then
          emu_xaddrP(emu_xaddr, i)^ := DsymAddr(ctx, d)
        Else If Copy(nm, 1, 6) = '__imp_' Then
          Begin
            { cellule de la table d'import pointant vers un piege }
            a := 0;
            If nm = '__imp__VirtualAlloc@16' Then a := 1
            Else If nm = '__imp__ExitProcess@4' Then a := 2
            Else If nm = '__imp__GetStdHandle@4' Then a := 3
            Else If nm = '__imp__WriteFile@20' Then a := 4
            Else If nm = '__imp__ReadFile@20' Then a := 5
            Else If nm = '__imp__GetTickCount@0' Then a := 6
            Else If nm = '__imp__GetCommandLineA@0' Then a := 7
            Else If nm = '__imp__GetSystemTimeAsFileTime@4' Then a := 8
            Else If nm = '__imp__Sleep@4' Then a := 9
            Else If nm = '__imp__VirtualFree@12' Then a := 10;
            If a = 0 Then
              For j := 1 To K32_COUNT Do
                If nm = '__imp__' + K32Names[j] Then
                  a := 100 + j;
            If a <> 0 Then
              Begin
                MemWr(emu_iat_next, EMU_TRAP + 4 * a, 4);
                emu_xaddrP(emu_xaddr, i)^ := emu_iat_next;
                emu_iat_next := emu_iat_next + 4;
              End;
          End;
      End;
  { relocations }
  For i := 1 To ctx.data.reloc_count Do
    Begin
      If RelocP(ctx.data.relocs, i)^.tkind = SYMK_D Then
        a := DsymAddr(ctx, RelocP(ctx.data.relocs, i)^.target)
      Else
        a := emu_xaddrP(emu_xaddr, RelocP(ctx.data.relocs, i)^.target)^;
      If RelocP(ctx.data.relocs, i)^.sec = SEC_RDATA Then
        MemWr(emu_rd_base + RelocP(ctx.data.relocs, i)^.ofs, a, 4)
      Else
        MemWr(emu_dt_base + RelocP(ctx.data.relocs, i)^.ofs, a, 4);
    End;

  d := XSym(ctx, '_JSSTART');
  If emu_xaddrP(emu_xaddr, d)^ = 0 Then
    Begin
      Writeln('JSCW32: _JSSTART introuvable');
      Exit;
    End;
  start_idx := (emu_xaddrP(emu_xaddr, d)^ - EMU_CODE) Div 4;
  emu_pc := start_idx;
  emu_reg[Ord(R_ESP)] := EMU_STACK;
  EmuPush(EMU_HALTADDR);
  While Not emu_halt Do
    Begin
      Inc(emu_steps);
      If emu_steps > EMU_STEPLIMIT Then
        EmuFault('limite d''instructions depassee')
      Else
        EmuStep(ctx);
    End;
  If emu_fault_msg <> '' Then
    Begin
      Writeln;
      Writeln('JSCW32: erreur d''emulation : ', emu_fault_msg, ' (instruction ',
              emu_pc - 1, ', ligne ', InstrP(ctx.ir.instrs, emu_pc - 1)^.line, ')');
      EmuBacktrace(ctx, emu_pc - 1);
      RunEmulator := 3;
    End
  Else
    RunEmulator := emu_exit;
  FreeMem(emu_mem, EMU_MEM_SIZE);
End;

{ Les etapes sont implementees par les TODO suivants. Tant qu'une etape
  n'existe pas, elle echoue explicitement au lieu de produire un faux
  resultat. }
{ ---- Generateur ASM 80386 (TODO 22) ----

  Ecrit le programme en syntaxe NASM Win32 (BITS 32, section .text / .rdata /
  .data, extern pour les imports kernel32, global pour le point d'entree), a
  partir de l'IR et du pool de donnees. Seulement sur demande (-asm). Les
  lignes JavaScript d'origine sont reprises en commentaires ; les routines du
  runtime gardent leurs noms _JSRT_*. Le fichier peut etre assemble tel quel :
  nasm -f win32 prog.asm }

Var
  ag_f: Text;
  ag_lines: LongInt;
  ag_ord: TDynList;
  ag_rord: TDynList;

Type
  P_ag_rord = ^LongInt;

Function ag_rordP(Var l: TDynList; i: LongInt): P_ag_rord;
Begin
  ag_rordP := P_ag_rord(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_ag_ord = ^LongInt;

Function ag_ordP(Var l: TDynList; i: LongInt): P_ag_ord;
Begin
  ag_ordP := P_ag_ord(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Procedure AgLine(Const s: TString);
Begin
  Writeln(ag_f, s);
  Inc(ag_lines);
End;

Function AgInt(v: LongInt): TString;
Var
  s: String[12];
Begin
  Str(v, s);
  AgInt := s;
End;

{ Operande memoire en syntaxe NASM, avec le prefixe de taille. }
Function AgMem(Var ctx: TCompilerContext; Var o: TOperand; Const size: TString): TString;
Var
  inner: TString;
Begin
  inner := '';
  If o.base <> R_NONE Then
    inner := RegName(o.base);
  If o.index <> R_NONE Then
    Begin
      If inner <> '' Then
        inner := inner + '+';
      inner := inner + RegName(o.index);
    End;
  If o.symkind <> 0 Then
    Begin
      If inner <> '' Then
        inner := inner + '+';
      inner := inner + SymNameOf(ctx, o.symkind, o.sym);
    End;
  AgMem := size + ' [' + inner + DispText(o.disp) + ']';
End;

Function AgSize(Var o: TOperand; fp: Boolean): TString;
Begin
  If o.size = 1 Then
    AgSize := 'byte'
  Else If o.size = 2 Then
    AgSize := 'word'
  Else If o.size = 8 Then
    AgSize := 'qword'
  Else If fp And (o.size <> 4) Then
    AgSize := 'qword'
  Else
    AgSize := 'dword';
End;

Function AgOperand(Var ctx: TCompilerContext; Var o: TOperand; fp: Boolean): TString;
Begin
  Case o.kind Of
    OD_REG:   AgOperand := RegName(o.reg);
    OD_IMM:   AgOperand := ImmText(o.disp);
    OD_MEM:   AgOperand := AgMem(ctx, o, AgSize(o, fp));
    OD_ADDR:  AgOperand := SymNameOf(ctx, o.symkind, o.sym);
    OD_LABEL: AgOperand := SymLabel(o.disp);
  Else
    AgOperand := '';
  End;
End;

Procedure AgInstr(Var ctx: TCompilerContext; Var ins: TInstr);
Var
  nm, a, b, t: TString;
  fp: Boolean;
Begin
  nm := OpName(ins.op);
  fp := ins.op >= OP_FLD;
  a := AgOperand(ctx, ins.a, fp);
  b := AgOperand(ctx, ins.b, fp);
  t := '';
  Case ins.op Of
    OP_FNSTSW:
      t := 'fnstsw ax';
    OP_FPOP:
      t := 'fstp st0';
    OP_FLD, OP_FADD, OP_FSUB, OP_FSUBR, OP_FMUL, OP_FDIV, OP_FDIVR:
      If ins.a.kind = OD_IMM Then
        Begin
          If ins.op = OP_FLD Then
            t := 'fld st' + AgInt(ins.a.disp)
          Else
            t := nm + ' st0, st' + AgInt(ins.a.disp);
        End;
    OP_FXCH:
      If ins.a.kind = OD_IMM Then
        t := 'fxch st' + AgInt(ins.a.disp);
    OP_FADDP, OP_FSUBP, OP_FSUBRP, OP_FMULP, OP_FDIVP, OP_FDIVRP:
      t := nm + ' st1, st0';
  End;
  If t = '' Then
    Begin
      t := nm;
      If a <> '' Then
        t := t + ' ' + a;
      If b <> '' Then
        t := t + ', ' + b;
    End;
  AgLine('        ' + t);
End;

{ Texte de la ligne JS (sans retour a la ligne, tronque). }
Function AgSourceLine(Var ctx: TCompilerContext; ln: LongInt): TString;
Var
  a, b, i, k: LongInt;
  r: TString;
Begin
  a := LineStartP(ctx.source.line_start, ln)^;
  b := LineStartP(ctx.source.line_start, ln + 1)^ - 1;
  r := '';
  k := 0;
  For i := a To b - 1 Do
    Begin
      If SrcCharP(ctx.source.buf, i)^ <> #10 Then
        Begin
          If k < 100 Then
            r := r + SrcCharP(ctx.source.buf, i)^;
          Inc(k);
        End;
    End;
  While (Length(r) > 0) And ((r[1] = ' ') Or (r[1] = #9)) Do
    Delete(r, 1, 1);
  If k > 100 Then
    r := r + ' ...';
  AgSourceLine := r;
End;

Procedure AgCode(Var ctx: TCompilerContext);
Var
  i, last_line: LongInt;
  op: TOpc;
  nm: TString;
Begin
  AgLine('section .text use32 class=CODE');
  AgLine('');
  last_line := 0;
  For i := 1 To ctx.ir.count Do
    Begin
      op := InstrP(ctx.ir.instrs, i)^.op;
      Case op Of
        OP_LABEL:
          AgLine(SymLabel(InstrP(ctx.ir.instrs, i)^.a.disp) + ':');
        OP_COMMENT:
          AgLine('        ; ' + CommentP(ctx.ir.comments, InstrP(ctx.ir.instrs, i)^.a.disp)^);
        OP_PROC:
          Begin
            nm := SymNameOf(ctx, InstrP(ctx.ir.instrs, i)^.a.symkind, InstrP(ctx.ir.instrs, i)^.a.sym);
            AgLine('');
            If i <= ctx.ir.user_count Then
              AgLine('; ---- ' + nm + ' ----')
            Else
              AgLine('; ---- runtime : ' + nm + ' ----');
            AgLine(nm + ':');
            last_line := 0;
          End;
        OP_ENDP:
          ;
      Else
        Begin
          If (i <= ctx.ir.user_count) And (InstrP(ctx.ir.instrs, i)^.line <> last_line) Then
            Begin
              last_line := InstrP(ctx.ir.instrs, i)^.line;
              If (last_line >= 1) And (last_line <= ctx.source.user_lines) Then
                AgLine('        ; js:' + AgInt(last_line) + ': ' + AgSourceLine(ctx, last_line));
            End;
          AgInstr(ctx, InstrP(ctx.ir.instrs, i)^);
        End;
      End;
    End;
  AgLine('');
End;

{ Trie les indices par decalage (insertion, listes courtes en pratique). }
Procedure AgSortSyms(Var ctx: TCompilerContext; sec: LongInt; Var n: LongInt);
Var
  i, j, t: LongInt;
Begin
  n := 0;
  For i := 1 To ctx.data.sym_count Do
    If DsymP(ctx.data.syms, i)^.sec = sec Then
      Begin
        Inc(n);
        ag_ordP(ag_ord, n)^ := i;
      End;
  For i := 2 To n Do
    Begin
      t := ag_ordP(ag_ord, i)^;
      j := i - 1;
      While (j >= 1) And (DsymP(ctx.data.syms, ag_ordP(ag_ord, j)^)^.ofs > DsymP(ctx.data.syms, t)^.ofs) Do
        Begin
          ag_ordP(ag_ord, j + 1)^ := ag_ordP(ag_ord, j)^;
          Dec(j);
        End;
      ag_ordP(ag_ord, j + 1)^ := t;
    End;
End;

Procedure AgSortRelocs(Var ctx: TCompilerContext; sec: LongInt; Var n: LongInt);
Var
  i, j, t: LongInt;
Begin
  n := 0;
  For i := 1 To ctx.data.reloc_count Do
    If RelocP(ctx.data.relocs, i)^.sec = sec Then
      Begin
        Inc(n);
        ag_rordP(ag_rord, n)^ := i;
      End;
  For i := 2 To n Do
    Begin
      t := ag_rordP(ag_rord, i)^;
      j := i - 1;
      While (j >= 1) And (RelocP(ctx.data.relocs, ag_rordP(ag_rord, j)^)^.ofs > RelocP(ctx.data.relocs, t)^.ofs) Do
        Begin
          ag_rordP(ag_rord, j + 1)^ := ag_rordP(ag_rord, j)^;
          Dec(j);
        End;
      ag_rordP(ag_rord, j + 1)^ := t;
    End;
End;

Function AgImgByte(Var ctx: TCompilerContext; sec, ofs: LongInt): LongInt;
Begin
  If sec = SEC_RDATA Then
    AgImgByte := RdP(ctx.data.rd, ofs)^
  Else
    AgImgByte := DtP(ctx.data.dt, ofs)^;
End;

Function AgImgDword(Var ctx: TCompilerContext; sec, ofs: LongInt): LongInt;
Var
  v: Int64;
Begin
  v := AgImgByte(ctx, sec, ofs) + AgImgByte(ctx, sec, ofs + 1) * 256 +
       AgImgByte(ctx, sec, ofs + 2) * 65536 + Int64(AgImgByte(ctx, sec, ofs + 3)) * 16777216;
  If v >= 2147483648 Then
    v := v - 4294967296;
  AgImgDword := v;
End;

{ Une section de donnees : etiquettes, relocations (dd symbole), mots et octets. }
Procedure AgData(Var ctx: TCompilerContext; sec: LongInt; Const header: TString);
Var
  size, ns, nr, si, ri, pos, nb, k, t, add_: LongInt;
  txt_a, txt_b: LongInt;
  line, nmr: TString;
  c: LongInt;
Begin
  If sec = SEC_RDATA Then
    size := ctx.data.rd_size
  Else
    size := ctx.data.dt_size;
  AgLine(header);
  AgSortSyms(ctx, sec, ns);
  AgSortRelocs(ctx, sec, nr);
  si := 1;
  ri := 1;
  pos := 0;
  txt_a := -1;
  txt_b := -1;
  While pos < size Do
    Begin
      While (si <= ns) And (DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.ofs <= pos) Do
        Begin
          AgLine(DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.name + ':');
          If DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.kind = DS_STRING Then
            Begin
              txt_a := DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.ofs + RT_STR_DATA;
              txt_b := DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.ofs + DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.size - 1;
            End;
          Inc(si);
        End;
      While (ri <= nr) And (RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.ofs < pos) Do
        Inc(ri);
      If (ri <= nr) And (RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.ofs = pos) Then
        Begin
          If RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.tkind = SYMK_D Then
            nmr := DsymP(ctx.data.syms, RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.target)^.name
          Else
            nmr := XsymP(ctx.ir.xsyms, RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.target)^.name;
          add_ := AgImgDword(ctx, sec, pos);
          If add_ = 0 Then
            AgLine('        dd ' + nmr)
          Else
            AgLine('        dd ' + nmr + DispText(add_));
          Inc(pos, 4);
          Inc(ri);
          Continue;
        End;
      { fin du bloc : prochain symbole ou prochaine relocation }
      nb := size;
      If (si <= ns) And (DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.ofs < nb) Then
        nb := DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.ofs;
      If (ri <= nr) And (RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.ofs < nb) Then
        nb := RelocP(ctx.data.relocs, ag_rordP(ag_rord, ri)^)^.ofs;
      If (pos >= txt_a) And (pos < txt_b) Then
        Begin
          { texte d'une chaine : ASCII imprimable entre guillemets }
          If txt_b < nb Then
            nb := txt_b;
          line := '';
          t := 0;
          k := pos;
          While k < nb Do
            Begin
              c := AgImgByte(ctx, sec, k);
              If (c >= 32) And (c < 127) And (c <> 34) And (c <> 39) And (c <> 96) Then
                Begin
                  If t = 0 Then
                    Begin
                      If line <> '' Then
                        line := line + ',';
                      line := line + '"';
                      t := 1;
                    End;
                  line := line + Chr(c);
                End
              Else
                Begin
                  If t = 1 Then
                    Begin
                      line := line + '"';
                      t := 0;
                    End;
                  If line <> '' Then
                    line := line + ',';
                  line := line + AgInt(c);
                End;
              Inc(k);
              If Length(line) > 100 Then
                Begin
                  If t = 1 Then
                    line := line + '"';
                  AgLine('        db ' + line);
                  line := '';
                  t := 0;
                End;
            End;
          If t = 1 Then
            line := line + '"';
          If line <> '' Then
            AgLine('        db ' + line);
          pos := nb;
        End
      Else
        Begin
          If (pos >= txt_b) And (pos < txt_b + 1) And (txt_b >= 0) And (nb > pos) Then
            nb := pos + 1;
          If (pos + 4 <= nb) And (pos Mod 4 = 0) And (pos < txt_a) Then
            Begin
              { mots de 4 octets alignes }
              line := '';
              k := 0;
              While (pos + 4 <= nb) And (k < 4) And (pos Mod 4 = 0) And
                    ((txt_a < 0) Or (pos + 4 <= txt_a) Or (pos >= txt_b + 1)) Do
                Begin
                  If line <> '' Then
                    line := line + ', ';
                  line := line + ImmText(AgImgDword(ctx, sec, pos));
                  Inc(pos, 4);
                  Inc(k);
                End;
              AgLine('        dd ' + line);
            End
          Else
            Begin
              line := '';
              k := 0;
              While (pos < nb) And (k < 16) Do
                Begin
                  If line <> '' Then
                    line := line + ', ';
                  line := line + AgInt(AgImgByte(ctx, sec, pos));
                  Inc(pos);
                  Inc(k);
                  If (pos Mod 4 = 0) And (pos + 4 <= nb) And ((txt_a < 0) Or (pos + 4 <= txt_a)) Then
                    Break;
                End;
              AgLine('        db ' + line);
            End;
        End;
    End;
  { symboles places a la fin de la section }
  While si <= ns Do
    Begin
      AgLine(DsymP(ctx.data.syms, ag_ordP(ag_ord, si)^)^.name + ':');
      Inc(si);
    End;
  AgLine('');
End;

Function EmitAsm386(Var ctx: TCompilerContext): Boolean;
Var
  i, nimp: LongInt;
  io: Integer;
Begin
  EmitAsm386 := True;
  If Not ctx.options.emit_asm Then
    Exit;
  EmitAsm386 := False;
  Assign(ag_f, NormalizePath(ctx.asm_name));
  Rewrite(ag_f);
  io := IOResult;
  If io <> 0 Then
    Begin
      PipelineError(ctx, 'impossible de creer le fichier ' + ctx.asm_name);
      Exit;
    End;
  ag_lines := 0;
  AgLine('; Genere par JSCW32 ' + JSCW32_VERSION);
  AgLine('; Source: ' + ctx.source_name);
  AgLine('; Cible: 80386 Win32 (COFF), syntaxe NASM : nasm -f win32 ' + ctx.asm_name);
  AgLine('; Emission demandee explicitement par -asm');
  AgLine('; ' + AgInt(ctx.ir.proc_count) + ' procedures, ' + AgInt(ctx.ir.count) +
         ' instructions, .rdata ' + AgInt(ctx.data.rd_size) + ' octets, .data ' +
         AgInt(ctx.data.dt_size) + ' octets');
  AgLine('');
  AgLine('BITS 32');
  AgLine('global _JSSTART');
  nimp := 0;
  For i := 1 To ctx.ir.xsym_count Do
    If Not XsymP(ctx.ir.xsyms, i)^.defined And (DsymFind(ctx, XsymP(ctx.ir.xsyms, i)^.name) = 0) Then
      Begin
        AgLine('extern ' + XsymP(ctx.ir.xsyms, i)^.name);
        Inc(nimp);
      End;
  AgLine('');
  AgCode(ctx);
  AgData(ctx, SEC_RDATA, 'section .rdata align=4 class=CONST');
  AgData(ctx, SEC_DATA, 'section .data align=4 class=DATA');
  Close(ag_f);
  io := IOResult;
  If ctx.options.verbose Then
    Writeln('  ASM: ', ctx.asm_name, ' (', ag_lines, ' lignes, ', nimp, ' imports)');
  EmitAsm386 := True;
End;

{ ---- Generateur OBJ COFF i386 (TODO 23) ----

  Encode l'IR en code machine 80386 (formes courtes comme NASM : imm8, jumps
  courts relaxes sur plusieurs passes), construit la table des symboles et
  les relocations (DIR32 pour les adresses absolues, REL32 pour les appels),
  puis ecrit l'objet : en-tete, sections .text / .rdata / .data / .bss,
  relocations, symboles (tous externes, imports kernel32 non definis) et
  table des chaines. L'objet est toujours construit en memoire (le linker
  PE32 interne l'utilise) ; le fichier .obj n'est ecrit qu'en mode OBJ. }

Const
  COFF_DIR32 = 6;
  COFF_REL32 = 20;

Type
  TCoRel = Record
    ofs, typ: LongInt;
    symkind, sym: LongInt;
  End;

Var
  co_text: TDynList;
  co_len: LongInt;
  co_rel: TDynList;
  co_nrel: LongInt;
  co_lbl: TDynList;
  co_jlong: TDynList;
  co_proc_ofs: TDynList;
  co_final, co_fail: Boolean;
  co_changed, co_poschg: Boolean;
  co_pass: LongInt;
  co_lblpass: TDynList;
  co_jofs: TDynList;
  co_size: LongInt;                 { taille du fichier ecrit }

Type
  P_co_jofs = ^LongInt;

Function co_jofsP(Var l: TDynList; i: LongInt): P_co_jofs;
Begin
  co_jofsP := P_co_jofs(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_co_lblpass = ^SmallInt;

Function co_lblpassP(Var l: TDynList; i: LongInt): P_co_lblpass;
Begin
  co_lblpassP := P_co_lblpass(DlPtr(l, i - 0, SizeOf(SmallInt)));
End;

Type
  P_co_proc_ofs = ^LongInt;

Function co_proc_ofsP(Var l: TDynList; i: LongInt): P_co_proc_ofs;
Begin
  co_proc_ofsP := P_co_proc_ofs(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_co_jlong = ^Boolean;

Function co_jlongP(Var l: TDynList; i: LongInt): P_co_jlong;
Begin
  co_jlongP := P_co_jlong(DlPtr(l, i - 1, SizeOf(Boolean)));
End;

Type
  P_co_lbl = ^LongInt;

Function co_lblP(Var l: TDynList; i: LongInt): P_co_lbl;
Begin
  co_lblP := P_co_lbl(DlPtr(l, i - 0, SizeOf(LongInt)));
End;

Type
  P_co_rel = ^TCoRel;

Function co_relP(Var l: TDynList; i: LongInt): P_co_rel;
Begin
  co_relP := P_co_rel(DlPtr(l, i - 1, SizeOf(TCoRel)));
End;

Type
  P_co_text = ^Byte;

Function co_textP(Var l: TDynList; i: LongInt): P_co_text;
Begin
  co_textP := P_co_text(DlPtr(l, i - 0, SizeOf(Byte)));
End;

Procedure CoB(b: LongInt);
Begin
  co_textP(co_text, co_len)^ := b And 255;
  Inc(co_len);
End;

Procedure CoD(v: LongInt);
Begin
  CoB(v);
  CoB(v Shr 8);
  CoB(v Shr 16);
  CoB(v Shr 24);
End;

Procedure CoReloc(typ, symkind, sym: LongInt);
Begin
  If Not co_final Then
    Exit;
  Inc(co_nrel);
  co_relP(co_rel, co_nrel)^.ofs := co_len;
  co_relP(co_rel, co_nrel)^.typ := typ;
  co_relP(co_rel, co_nrel)^.symkind := symkind;
  co_relP(co_rel, co_nrel)^.sym := sym;
End;

Function CoRegNum(r: TReg): LongInt;
Begin
  Case r Of
    R_EAX, R_AL: CoRegNum := 0;
    R_ECX, R_CL: CoRegNum := 1;
    R_EDX, R_DL: CoRegNum := 2;
    R_EBX, R_BL: CoRegNum := 3;
    R_ESP: CoRegNum := 4;
    R_EBP: CoRegNum := 5;
    R_ESI: CoRegNum := 6;
    R_EDI: CoRegNum := 7;
  Else
    CoRegNum := 0;
  End;
End;

Function CoIsReg8(r: TReg): Boolean;
Begin
  CoIsReg8 := (r = R_CL) Or (r = R_AL) Or (r = R_DL) Or (r = R_BL);
End;

Function CoFits8(v: LongInt): Boolean;
Begin
  CoFits8 := (v >= -128) And (v <= 127);
End;

Procedure CoDisp32(Var o: TOperand);
Begin
  If o.symkind <> 0 Then
    CoReloc(COFF_DIR32, o.symkind, o.sym);
  CoD(o.disp);
End;

{ Octet ModRM (+ SIB + deplacement) pour un registre ou une operande memoire. }
Procedure CoModRM(regf: LongInt; Var o: TOperand);
Var
  base, idx, t: TReg;
  md, rm: LongInt;
  sib: Boolean;
Begin
  If o.kind = OD_REG Then
    Begin
      CoB($C0 Or (regf Shl 3) Or CoRegNum(o.reg));
      Exit;
    End;
  base := o.base;
  idx := o.index;
  If (base = R_NONE) And (idx <> R_NONE) Then
    Begin
      base := idx;
      idx := R_NONE;
    End;
  If (idx = R_ESP) And (base <> R_NONE) Then
    Begin
      t := base;
      base := idx;
      idx := t;
    End;
  If base = R_NONE Then
    Begin
      CoB((regf Shl 3) Or 5);
      CoDisp32(o);
      Exit;
    End;
  sib := (idx <> R_NONE) Or (base = R_ESP);
  If (o.symkind <> 0) Or Not CoFits8(o.disp) Then
    md := 2
  Else If (o.disp = 0) And (base <> R_EBP) Then
    md := 0
  Else
    md := 1;
  If sib Then
    rm := 4
  Else
    rm := CoRegNum(base);
  CoB((md Shl 6) Or (regf Shl 3) Or rm);
  If sib Then
    Begin
      If idx = R_NONE Then
        CoB($20 Or CoRegNum(base))
      Else
        CoB((CoRegNum(idx) Shl 3) Or CoRegNum(base));
    End;
  If md = 1 Then
    CoB(o.disp)
  Else If md = 2 Then
    CoDisp32(o);
End;

{ Immediat de 32 bits : constante ou adresse de symbole (DIR32). }
Procedure CoImm32(Var o: TOperand);
Begin
  If o.kind = OD_ADDR Then
    Begin
      CoReloc(COFF_DIR32, o.symkind, o.sym);
      CoD(0);
    End
  Else
    CoD(o.disp);
End;

Function CoIs8(Var o: TOperand): Boolean;
Begin
  CoIs8 := ((o.kind = OD_REG) And CoIsReg8(o.reg)) Or
           ((o.kind = OD_MEM) And (o.size = 1));
End;

Procedure CoAlu(n: LongInt; Var a, b: TOperand);
Begin
  If (b.kind = OD_IMM) Or (b.kind = OD_ADDR) Then
    Begin
      If CoIs8(a) Then
        Begin
          If (a.kind = OD_REG) And (a.reg = R_AL) Then
            Begin
              CoB(n * 8 + 4);
              CoB(b.disp);
            End
          Else
            Begin
              CoB($80);
              CoModRM(n, a);
              CoB(b.disp);
            End;
        End
      Else If (b.kind = OD_IMM) And CoFits8(b.disp) Then
        Begin
          CoB($83);
          CoModRM(n, a);
          CoB(b.disp);
        End
      Else If (a.kind = OD_REG) And (a.reg = R_EAX) Then
        Begin
          CoB(n * 8 + 5);
          CoImm32(b);
        End
      Else
        Begin
          CoB($81);
          CoModRM(n, a);
          CoImm32(b);
        End;
    End
  Else If b.kind = OD_REG Then
    Begin
      If CoIs8(a) Then
        CoB(n * 8)
      Else
        CoB(n * 8 + 1);
      CoModRM(CoRegNum(b.reg), a);
    End
  Else
    Begin
      If CoIs8(a) Then
        CoB(n * 8 + 2)
      Else
        CoB(n * 8 + 3);
      CoModRM(CoRegNum(a.reg), b);
    End;
End;

Procedure CoMov(Var a, b: TOperand);
Begin
  If a.kind = OD_REG Then
    Begin
      If CoIsReg8(a.reg) Then
        Begin
          If b.kind = OD_IMM Then
            Begin
              CoB($B0 + CoRegNum(a.reg));
              CoB(b.disp);
            End
          Else If b.kind = OD_REG Then
            Begin
              CoB($88);
              CoModRM(CoRegNum(b.reg), a);
            End
          Else
            Begin
              CoB($8A);
              CoModRM(CoRegNum(a.reg), b);
            End;
        End
      Else If (b.kind = OD_IMM) Or (b.kind = OD_ADDR) Then
        Begin
          CoB($B8 + CoRegNum(a.reg));
          CoImm32(b);
        End
      Else If (b.kind = OD_MEM) And (a.reg = R_EAX) And (b.base = R_NONE) And
              (b.index = R_NONE) And (b.size <> 1) And (b.size <> 2) Then
        Begin
          CoB($A1);
          CoDisp32(b);
        End
      Else If b.kind = OD_REG Then
        Begin
          CoB($89);
          CoModRM(CoRegNum(b.reg), a);
        End
      Else
        Begin
          CoB($8B);
          CoModRM(CoRegNum(a.reg), b);
        End;
    End
  Else
    Begin
      If (b.kind = OD_REG) And (b.reg = R_EAX) And (a.base = R_NONE) And
         (a.index = R_NONE) And (a.size <> 1) And (a.size <> 2) Then
        Begin
          CoB($A3);
          CoDisp32(a);
        End
      Else If (b.kind = OD_IMM) Or (b.kind = OD_ADDR) Then
        Begin
          If a.size = 1 Then
            Begin
              CoB($C6);
              CoModRM(0, a);
              CoB(b.disp);
            End
          Else
            Begin
              CoB($C7);
              CoModRM(0, a);
              CoImm32(b);
            End;
        End
      Else If CoIsReg8(b.reg) Then
        Begin
          CoB($88);
          CoModRM(CoRegNum(b.reg), a);
        End
      Else
        Begin
          CoB($89);
          CoModRM(CoRegNum(b.reg), a);
        End;
    End;
End;

Function CoFpSize(Var o: TOperand): LongInt;
Begin
  If o.size = 4 Then
    CoFpSize := 4
  Else
    CoFpSize := 8;
End;

{ Operation x87 a un operande : memoire (m32 / m64) ou st(i). }
Procedure CoFpArith(ext: LongInt; Var a: TOperand);
Begin
  If a.kind = OD_IMM Then
    Begin
      If (a.disp = 0) And (ext < 2) Then
        CoB($DC)
      Else
        CoB($D8);
      CoB($C0 + ext * 8 + a.disp);
    End
  Else
    Begin
      If CoFpSize(a) = 4 Then
        CoB($D8)
      Else
        CoB($DC);
      CoModRM(ext, a);
    End;
End;

Procedure CoFp2(b1, b2: LongInt);
Begin
  CoB(b1);
  CoB(b2);
End;

Procedure CoFp(Var ins: TInstr);
Begin
  Case ins.op Of
    OP_FLD:
      If ins.a.kind = OD_IMM Then
        CoFp2($D9, $C0 + ins.a.disp)
      Else
        Begin
          If CoFpSize(ins.a) = 4 Then
            CoB($D9)
          Else
            CoB($DD);
          CoModRM(0, ins.a);
        End;
    OP_FILD:
      Begin
        If ins.a.size = 2 Then
          Begin
            CoB($DF);
            CoModRM(0, ins.a);
          End
        Else If ins.a.size = 8 Then
          Begin
            CoB($DF);
            CoModRM(5, ins.a);
          End
        Else
          Begin
            CoB($DB);
            CoModRM(0, ins.a);
          End;
      End;
    OP_FST, OP_FSTP:
      Begin
        If CoFpSize(ins.a) = 4 Then
          CoB($D9)
        Else
          CoB($DD);
        If ins.op = OP_FST Then
          CoModRM(2, ins.a)
        Else
          CoModRM(3, ins.a);
      End;
    OP_FISTP:
      Begin
        If ins.a.size = 2 Then
          Begin
            CoB($DF);
            CoModRM(3, ins.a);
          End
        Else If ins.a.size = 8 Then
          Begin
            CoB($DF);
            CoModRM(7, ins.a);
          End
        Else
          Begin
            CoB($DB);
            CoModRM(3, ins.a);
          End;
      End;
    OP_FADD:  CoFpArith(0, ins.a);
    OP_FMUL:  CoFpArith(1, ins.a);
    OP_FSUB:  CoFpArith(4, ins.a);
    OP_FSUBR: CoFpArith(5, ins.a);
    OP_FDIV:  CoFpArith(6, ins.a);
    OP_FDIVR: CoFpArith(7, ins.a);
    OP_FADDP:  CoFp2($DE, $C1);
    OP_FMULP:  CoFp2($DE, $C9);
    OP_FSUBRP: CoFp2($DE, $E1);
    OP_FSUBP:  CoFp2($DE, $E9);
    OP_FDIVRP: CoFp2($DE, $F1);
    OP_FDIVP:  CoFp2($DE, $F9);
    OP_FCHS:   CoFp2($D9, $E0);
    OP_FABS:   CoFp2($D9, $E1);
    OP_FSQRT:  CoFp2($D9, $FA);
    OP_FXCH:
      If ins.a.kind = OD_IMM Then
        CoFp2($D9, $C8 + ins.a.disp)
      Else
        CoFp2($D9, $C9);
    OP_FLD1:   CoFp2($D9, $E8);
    OP_FLDZ:   CoFp2($D9, $EE);
    OP_FLDPI:  CoFp2($D9, $EB);
    OP_FLDLN2: CoFp2($D9, $ED);
    OP_FLDL2E: CoFp2($D9, $EA);
    OP_FLDLG2: CoFp2($D9, $EC);
    OP_FYL2X:  CoFp2($D9, $F1);
    OP_F2XM1:  CoFp2($D9, $F0);
    OP_FSCALE: CoFp2($D9, $FD);
    OP_FPREM:  CoFp2($D9, $F8);
    OP_FRNDINT: CoFp2($D9, $FC);
    OP_FSIN:   CoFp2($D9, $FE);
    OP_FCOS:   CoFp2($D9, $FF);
    OP_FPATAN: CoFp2($D9, $F3);
    OP_FCOMPP: CoFp2($DE, $D9);
    OP_FTST:   CoFp2($D9, $E4);
    OP_FNSTSW: CoFp2($DF, $E0);
    OP_FNSTCW: Begin CoB($D9); CoModRM(7, ins.a); End;
    OP_FLDCW:  Begin CoB($D9); CoModRM(5, ins.a); End;
    OP_FPOP:   CoFp2($DD, $D8);
  End;
End;

Function CoCond(op: TOpc): LongInt;
Begin
  Case op Of
    OP_JO: CoCond := 0;
    OP_JNO: CoCond := 1;
    OP_JB: CoCond := 2;
    OP_JAE: CoCond := 3;
    OP_JE: CoCond := 4;
    OP_JNE: CoCond := 5;
    OP_JBE: CoCond := 6;
    OP_JA: CoCond := 7;
    OP_JS: CoCond := 8;
    OP_JNS: CoCond := 9;
    OP_JL: CoCond := 12;
    OP_JGE: CoCond := 13;
    OP_JLE: CoCond := 14;
    OP_JG: CoCond := 15;
  Else
    CoCond := -1;
  End;
End;

{ Saut vers une etiquette : forme courte tant qu'elle atteint sa cible. Une
  cible deja placee dans la passe courante est exacte ; pour une cible en avant,
  l'ecart de la passe precedente (sous-estimation) decide du passage a la
  forme longue, qui est definitif. }
Procedure CoJump(idx: LongInt; Var ins: TInstr);
Var
  cc, target, d, prev: LongInt;
Begin
  cc := CoCond(ins.op);
  target := co_lblP(co_lbl, ins.a.disp)^;
  prev := co_jofsP(co_jofs, idx)^;
  co_jofsP(co_jofs, idx)^ := co_len;
  If Not co_jlongP(co_jlong, idx)^ Then
    Begin
      If co_lblpassP(co_lblpass, ins.a.disp)^ = co_pass Then
        d := target - (co_len + 2)
      Else If prev < 0 Then
        d := 0
      Else
        d := target - (prev + 2);
      If Not CoFits8(d) Then
        Begin
          co_jlongP(co_jlong, idx)^ := True;
          co_changed := True;
        End;
    End;
  If target < 0 Then
    target := co_len + 2;
  If Not co_jlongP(co_jlong, idx)^ Then
    Begin
      If cc < 0 Then
        CoB($EB)
      Else
        CoB($70 + cc);
      CoB(target - (co_len + 1));
    End
  Else If cc < 0 Then
    Begin
      CoB($E9);
      CoD(target - (co_len + 4));
    End
  Else
    Begin
      CoB($0F);
      CoB($80 + cc);
      CoD(target - (co_len + 4));
    End;
End;

Procedure CoShift(n: LongInt; Var a, b: TOperand);
Begin
  If b.kind = OD_REG Then
    Begin
      CoB($D3);
      CoModRM(n, a);
    End
  Else If b.disp = 1 Then
    Begin
      CoB($D1);
      CoModRM(n, a);
    End
  Else
    Begin
      CoB($C1);
      CoModRM(n, a);
      CoB(b.disp);
    End;
End;

Procedure CoInstr(Var ctx: TCompilerContext; idx: LongInt);
Var
  ins: ^TInstr;
Begin
  ins := @InstrP(ctx.ir.instrs, idx)^;
  Case ins^.op Of
    OP_NONE, OP_COMMENT, OP_ENDP: ;
    OP_LABEL:
      Begin
        If co_lblP(co_lbl, ins^.a.disp)^ <> co_len Then
          co_poschg := True;
        co_lblP(co_lbl, ins^.a.disp)^ := co_len;
        co_lblpassP(co_lblpass, ins^.a.disp)^ := co_pass;
      End;
    OP_PROC:
      co_proc_ofsP(co_proc_ofs, ins^.a.sym)^ := co_len;
    OP_MOV: CoMov(ins^.a, ins^.b);
    OP_ADD: CoAlu(0, ins^.a, ins^.b);
    OP_OR:  CoAlu(1, ins^.a, ins^.b);
    OP_AND: CoAlu(4, ins^.a, ins^.b);
    OP_SUB: CoAlu(5, ins^.a, ins^.b);
    OP_XOR: CoAlu(6, ins^.a, ins^.b);
    OP_CMP: CoAlu(7, ins^.a, ins^.b);
    OP_LEA:
      Begin
        CoB($8D);
        CoModRM(CoRegNum(ins^.a.reg), ins^.b);
      End;
    OP_PUSH:
      Begin
        If ins^.a.kind = OD_REG Then
          CoB($50 + CoRegNum(ins^.a.reg))
        Else If ins^.a.kind = OD_ADDR Then
          Begin
            CoB($68);
            CoImm32(ins^.a);
          End
        Else If ins^.a.kind = OD_IMM Then
          Begin
            If CoFits8(ins^.a.disp) Then
              Begin
                CoB($6A);
                CoB(ins^.a.disp);
              End
            Else
              Begin
                CoB($68);
                CoD(ins^.a.disp);
              End;
          End
        Else
          Begin
            CoB($FF);
            CoModRM(6, ins^.a);
          End;
      End;
    OP_POP:
      CoB($58 + CoRegNum(ins^.a.reg));
    OP_TEST:
      Begin
        If ins^.b.kind = OD_REG Then
          Begin
            If CoIs8(ins^.a) Then
              CoB($84)
            Else
              CoB($85);
            CoModRM(CoRegNum(ins^.b.reg), ins^.a);
          End
        Else If CoIs8(ins^.a) Then
          Begin
            CoB($F6);
            CoModRM(0, ins^.a);
            CoB(ins^.b.disp);
          End
        Else If (ins^.a.kind = OD_REG) And (ins^.a.reg = R_EAX) Then
          Begin
            CoB($A9);
            CoD(ins^.b.disp);
          End
        Else
          Begin
            CoB($F7);
            CoModRM(0, ins^.a);
            CoD(ins^.b.disp);
          End;
      End;
    OP_INC, OP_DEC:
      Begin
        If ins^.a.kind = OD_REG Then
          Begin
            If ins^.op = OP_INC Then
              CoB($40 + CoRegNum(ins^.a.reg))
            Else
              CoB($48 + CoRegNum(ins^.a.reg));
          End
        Else
          Begin
            If CoIs8(ins^.a) Then
              CoB($FE)
            Else
              CoB($FF);
            If ins^.op = OP_INC Then
              CoModRM(0, ins^.a)
            Else
              CoModRM(1, ins^.a);
          End;
      End;
    OP_NOT: Begin CoB($F7); CoModRM(2, ins^.a); End;
    OP_NEG: Begin CoB($F7); CoModRM(3, ins^.a); End;
    OP_DIV: Begin CoB($F7); CoModRM(6, ins^.a); End;
    OP_IDIV: Begin CoB($F7); CoModRM(7, ins^.a); End;
    OP_IMUL:
      Begin
        If ins^.b.kind = OD_IMM Then
          Begin
            If CoFits8(ins^.b.disp) Then
              Begin
                CoB($6B);
                CoModRM(CoRegNum(ins^.a.reg), ins^.a);
                CoB(ins^.b.disp);
              End
            Else
              Begin
                CoB($69);
                CoModRM(CoRegNum(ins^.a.reg), ins^.a);
                CoD(ins^.b.disp);
              End;
          End
        Else
          Begin
            CoB($0F);
            CoB($AF);
            CoModRM(CoRegNum(ins^.a.reg), ins^.b);
          End;
      End;
    OP_SHL: CoShift(4, ins^.a, ins^.b);
    OP_SHR: CoShift(5, ins^.a, ins^.b);
    OP_SAR: CoShift(7, ins^.a, ins^.b);
    OP_MOVZX:
      Begin
        CoB($0F);
        If (ins^.b.kind = OD_MEM) And (ins^.b.size = 2) Then
          CoB($B7)
        Else
          CoB($B6);
        CoModRM(CoRegNum(ins^.a.reg), ins^.b);
      End;
    OP_CDQ: CoB($99);
    OP_LEAVE: CoB($C9);
    OP_RET: CoB($C3);
    OP_NOP: CoB($90);
    OP_REP_MOVSB: CoFp2($F3, $A4);
    OP_CALL:
      Begin
        If ins^.a.kind = OD_ADDR Then
          Begin
            CoB($E8);
            CoReloc(COFF_REL32, ins^.a.symkind, ins^.a.sym);
            CoD(0);
          End
        Else If ins^.a.kind = OD_LABEL Then
          Begin
            CoB($E8);
            If co_lblP(co_lbl, ins^.a.disp)^ < 0 Then
              CoD(0)
            Else
              CoD(co_lblP(co_lbl, ins^.a.disp)^ - (co_len + 4));
          End
        Else
          Begin
            CoB($FF);
            CoModRM(2, ins^.a);
          End;
      End;
    OP_JMP:
      Begin
        If ins^.a.kind = OD_LABEL Then
          CoJump(idx, ins^)
        Else If ins^.a.kind = OD_ADDR Then
          Begin
            CoB($E9);
            CoReloc(COFF_REL32, ins^.a.symkind, ins^.a.sym);
            CoD(0);
          End
        Else
          Begin
            CoB($FF);
            CoModRM(4, ins^.a);
          End;
      End;
    OP_JE, OP_JNE, OP_JB, OP_JAE, OP_JL, OP_JLE, OP_JG, OP_JGE, OP_JA, OP_JBE,
    OP_JO, OP_JNO, OP_JS, OP_JNS:
      CoJump(idx, ins^);
  Else
    Begin
      If ins^.op >= OP_FLD Then
        CoFp(ins^)
      Else
        Begin
          co_fail := True;
          PipelineError(ctx, 'instruction non encodable: ' + OpName(ins^.op));
        End;
    End;
  End;
End;

Procedure CoPass(Var ctx: TCompilerContext);
Var
  i: LongInt;
Begin
  co_len := 0;
  co_nrel := 0;
  co_changed := False;
  co_poschg := False;
  Inc(co_pass);
  For i := 1 To ctx.ir.count Do
    Begin
      CoInstr(ctx, i);
      If co_fail Then
        Exit;
    End;
End;

{ ---- Ecriture de l'objet ---- }

Var
  co_out: TDynList;
  co_olen: LongInt;

Type
  P_co_out = ^Byte;

Function co_outP(Var l: TDynList; i: LongInt): P_co_out;
Begin
  co_outP := P_co_out(DlPtr(l, i - 0, SizeOf(Byte)));
End;

Procedure OB(b: LongInt);
Begin
  co_outP(co_out, co_olen)^ := b And 255;
  Inc(co_olen);
End;

Procedure OW(v: LongInt);
Begin
  OB(v);
  OB(v Shr 8);
End;

Procedure OD(v: LongInt);
Begin
  OB(v);
  OB(v Shr 8);
  OB(v Shr 16);
  OB(v Shr 24);
End;

Procedure OBytes(Var src: TDynList; n: LongInt);
Begin
  DlCopyList(src, 0, co_out, co_olen, n);
  Inc(co_olen, n);
End;

Const
  CO_NSEC = 4;
  CO_S_TEXT = 1;
  CO_S_RDATA = 2;
  CO_S_DATA = 3;
  CO_S_BSS = 4;

Type
  TCoSym = Record
    name: String[100];
    value: LongInt;
    sec: LongInt;
    typ: LongInt;
  End;

Var
  co_str: TDynList;
  co_strlen: LongInt;
  co_dsym_idx: TDynList;
  co_xsym_idx: TDynList;
  co_nsyms: LongInt;
  co_symrec: TDynList;

Type
  P_co_symrec = ^TCoSym;

Function co_symrecP(Var l: TDynList; i: LongInt): P_co_symrec;
Begin
  co_symrecP := P_co_symrec(DlPtr(l, i - 1, SizeOf(TCoSym)));
End;

Type
  P_co_xsym_idx = ^LongInt;

Function co_xsym_idxP(Var l: TDynList; i: LongInt): P_co_xsym_idx;
Begin
  co_xsym_idxP := P_co_xsym_idx(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_co_dsym_idx = ^LongInt;

Function co_dsym_idxP(Var l: TDynList; i: LongInt): P_co_dsym_idx;
Begin
  co_dsym_idxP := P_co_dsym_idx(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  P_co_str = ^Byte;

Function co_strP(Var l: TDynList; i: LongInt): P_co_str;
Begin
  co_strP := P_co_str(DlPtr(l, i - 0, SizeOf(Byte)));
End;

Procedure CoAddSym(Const nm: String; value, sec, typ: LongInt; Var idx: LongInt);
Begin
  Inc(co_nsyms);
  co_symrecP(co_symrec, co_nsyms)^.name := nm;
  co_symrecP(co_symrec, co_nsyms)^.value := value;
  co_symrecP(co_symrec, co_nsyms)^.sec := sec;
  co_symrecP(co_symrec, co_nsyms)^.typ := typ;
  idx := co_nsyms - 1;
End;

Function CoSecChars(s: LongInt): LongInt;
Begin
  Case s Of
    CO_S_TEXT:  CoSecChars := $60500020;
    CO_S_RDATA: CoSecChars := $40300040;
    CO_S_DATA:  CoSecChars := LongInt($C0300040);
  Else
    CoSecChars := LongInt($C0300080);
  End;
End;

Procedure CoSecName(nm: String);
Var
  i: LongInt;
Begin
  For i := 1 To 8 Do
    If i <= Length(nm) Then
      OB(Ord(nm[i]))
    Else
      OB(0);
End;

Function CoRelSymIndex(Var r: TCoRel): LongInt;
Begin
  If r.symkind = SYMK_D Then
    CoRelSymIndex := co_dsym_idxP(co_dsym_idx, r.sym)^
  Else
    CoRelSymIndex := co_xsym_idxP(co_xsym_idx, r.sym)^;
End;

{ Construit l'objet complet dans co_out. }
Function BuildObj(Var ctx: TCompilerContext): Boolean;
Var
  i, j, k, raw_off, rel_off, sym_off, passes: LongInt;
  rsz, dsz: LongInt;
  nm: String;
  sec_raw, sec_rel, sec_nrel, sec_size: Array[1..CO_NSEC] Of LongInt;
  sec_ovf: Array[1..CO_NSEC] Of Boolean;
Begin
  BuildObj := False;
  co_fail := False;
  For i := 1 To ctx.ir.count Do
    co_jlongP(co_jlong, i)^ := False;
  DlFillInts(co_lbl, 0, ctx.ir.label_count + 2, -1);
  DlClear(co_lblpass);
  DlFillInts(co_jofs, 0, ctx.ir.count + 2, -1);
  co_pass := 0;
  { passes de dimensionnement des sauts, puis passe finale avec relocations }
  co_final := False;
  passes := 0;
  Repeat
    CoPass(ctx);
    Inc(passes);
    If ctx.options.verbose Then
      Begin
        k := 0;
        For i := 1 To ctx.ir.count Do
          If co_jlongP(co_jlong, i)^ Then
            Inc(k);
        Writeln('  passe ', passes, ' : ', co_len, ' octets, ', k, ' sauts longs');
      End;
  Until co_fail Or ((Not co_changed) And (Not co_poschg)) Or (passes > 60);
  If co_fail Then
    Begin
      If ctx.errors = 0 Then
        PipelineError(ctx, 'code machine trop volumineux');
      Exit;
    End;
  co_final := True;
  CoPass(ctx);
  If ctx.options.verbose Then
    Begin
      k := 0;
      For i := 1 To ctx.ir.count Do
        If co_jlongP(co_jlong, i)^ Then
          Inc(k);
      Writeln('  sauts longs: ', k, ' apres ', passes, ' passes');
    End;
  If co_fail Then
    Begin
      If ctx.errors = 0 Then
        PipelineError(ctx, 'trop de relocations ou code trop volumineux');
      Exit;
    End;
  rsz := ctx.data.rd_size;
  dsz := ctx.data.dt_size;
  { table des symboles : donnees, procedures, externes }
  co_nsyms := 0;
  For i := 1 To ctx.data.sym_count Do
    Begin
      If DsymP(ctx.data.syms, i)^.sec = SEC_RDATA Then
        k := CO_S_RDATA
      Else
        k := CO_S_DATA;
      CoAddSym(DsymP(ctx.data.syms, i)^.name, DsymP(ctx.data.syms, i)^.ofs, k, 0, co_dsym_idxP(co_dsym_idx, i)^);
    End;
  For i := 1 To ctx.ir.xsym_count Do
    Begin
      If XsymP(ctx.ir.xsyms, i)^.defined Then
        CoAddSym(XsymP(ctx.ir.xsyms, i)^.name, co_proc_ofsP(co_proc_ofs, i)^, CO_S_TEXT, $20, co_xsym_idxP(co_xsym_idx, i)^)
      Else If DsymFind(ctx, XsymP(ctx.ir.xsyms, i)^.name) <> 0 Then
        co_xsym_idxP(co_xsym_idx, i)^ := co_dsym_idxP(co_dsym_idx, DsymFind(ctx, XsymP(ctx.ir.xsyms, i)^.name))^
      Else
        CoAddSym(XsymP(ctx.ir.xsyms, i)^.name, 0, 0, 0, co_xsym_idxP(co_xsym_idx, i)^);
    End;
  { dimensions et relocations par section }
  sec_size[CO_S_TEXT] := co_len;
  sec_size[CO_S_RDATA] := rsz;
  sec_size[CO_S_DATA] := dsz;
  sec_size[CO_S_BSS] := 0;
  For i := 1 To CO_NSEC Do
    sec_nrel[i] := 0;
  sec_nrel[CO_S_TEXT] := co_nrel;
  For i := 1 To ctx.data.reloc_count Do
    If RelocP(ctx.data.relocs, i)^.sec = SEC_RDATA Then
      Inc(sec_nrel[CO_S_RDATA])
    Else
      Inc(sec_nrel[CO_S_DATA]);
  For i := 1 To CO_NSEC Do
    sec_ovf[i] := sec_nrel[i] > 65534;
  { disposition du fichier }
  raw_off := 20 + 40 * CO_NSEC;
  sec_raw[CO_S_TEXT] := raw_off;
  raw_off := raw_off + co_len;
  sec_raw[CO_S_RDATA] := raw_off;
  raw_off := raw_off + rsz;
  sec_raw[CO_S_DATA] := raw_off;
  raw_off := raw_off + dsz;
  sec_raw[CO_S_BSS] := 0;
  rel_off := raw_off;
  For i := 1 To CO_NSEC Do
    If sec_nrel[i] > 0 Then
      Begin
        sec_rel[i] := rel_off;
        rel_off := rel_off + 10 * sec_nrel[i];
        If sec_ovf[i] Then
          rel_off := rel_off + 10;
      End
    Else
      sec_rel[i] := 0;
  sym_off := rel_off;
  { ecriture : en-tete, sections }
  co_olen := 0;
  OW($14C);
  OW(CO_NSEC);
  OD(0);
  OD(sym_off);
  OD(co_nsyms);
  OW(0);
  OW(0);
  For i := 1 To CO_NSEC Do
    Begin
      Case i Of
        CO_S_TEXT: CoSecName('.text');
        CO_S_RDATA: CoSecName('.rdata');
        CO_S_DATA: CoSecName('.data');
      Else
        CoSecName('.bss');
      End;
      OD(0);
      OD(0);
      OD(sec_size[i]);
      OD(sec_raw[i]);
      OD(sec_rel[i]);
      OD(0);
      If sec_ovf[i] Then
        OW(65535)
      Else
        OW(sec_nrel[i]);
      OW(0);
      If sec_ovf[i] Then
        OD(CoSecChars(i) Or $01000000)
      Else
        OD(CoSecChars(i));
    End;
  OBytes(co_text, co_len);
  OBytes(ctx.data.rd, rsz);
  OBytes(ctx.data.dt, dsz);
  { relocations }
  If sec_nrel[CO_S_TEXT] > 0 Then
    Begin
      If sec_ovf[CO_S_TEXT] Then
        Begin
          OD(sec_nrel[CO_S_TEXT] + 1);
          OD(0);
          OW(0);
        End;
      For i := 1 To co_nrel Do
        Begin
          OD(co_relP(co_rel, i)^.ofs);
          OD(CoRelSymIndex(co_relP(co_rel, i)^));
          OW(co_relP(co_rel, i)^.typ);
        End;
    End;
  For k := CO_S_RDATA To CO_S_DATA Do
    If sec_nrel[k] > 0 Then
      Begin
        If sec_ovf[k] Then
          Begin
            OD(sec_nrel[k] + 1);
            OD(0);
            OW(0);
          End;
        For i := 1 To ctx.data.reloc_count Do
          If ((k = CO_S_RDATA) And (RelocP(ctx.data.relocs, i)^.sec = SEC_RDATA)) Or
             ((k = CO_S_DATA) And (RelocP(ctx.data.relocs, i)^.sec <> SEC_RDATA)) Then
            Begin
              OD(RelocP(ctx.data.relocs, i)^.ofs);
              If RelocP(ctx.data.relocs, i)^.tkind = SYMK_D Then
                OD(co_dsym_idxP(co_dsym_idx, RelocP(ctx.data.relocs, i)^.target)^)
              Else
                OD(co_xsym_idxP(co_xsym_idx, RelocP(ctx.data.relocs, i)^.target)^);
              OW(COFF_DIR32);
            End;
      End;
  { symboles et table des chaines }
  co_strlen := 0;
  For i := 1 To co_nsyms Do
    Begin
      nm := co_symrecP(co_symrec, i)^.name;
      If Length(nm) <= 8 Then
        Begin
          For j := 1 To 8 Do
            If j <= Length(nm) Then
              OB(Ord(nm[j]))
            Else
              OB(0);
        End
      Else
        Begin
          OD(0);
          OD(co_strlen + 4);
          For j := 1 To Length(nm) Do
            Begin
              co_strP(co_str, co_strlen)^ := Ord(nm[j]);
              Inc(co_strlen);
            End;
          co_strP(co_str, co_strlen)^ := 0;
          Inc(co_strlen);
        End;
      OD(co_symrecP(co_symrec, i)^.value);
      OW(co_symrecP(co_symrec, i)^.sec);
      OW(co_symrecP(co_symrec, i)^.typ);
      OB(2);
      OB(0);
    End;
  OD(co_strlen + 4);
  OBytes(co_str, co_strlen);
  co_size := co_olen;
  BuildObj := True;
End;

Function EmitObjCoff(Var ctx: TCompilerContext): Boolean;
Var
  f: File;
  io: Integer;
Begin
  EmitObjCoff := False;
  If Not BuildObj(ctx) Then
    Exit;
  If ctx.options.verbose Then
    Writeln('  OBJ: ', co_len, ' octets de code, ', co_nrel, ' relocations de code, ',
            co_nsyms, ' symboles, ', co_size, ' octets');
  If ArtifactIsPersisted(ctx, AK_OBJ_COFF) Then
    Begin
      Assign(f, NormalizePath(ctx.obj_name));
      Rewrite(f, 1);
      io := IOResult;
      If io <> 0 Then
        Begin
          PipelineError(ctx, 'impossible de creer le fichier ' + ctx.obj_name);
          Exit;
        End;
      DlWriteFile(f, co_out, co_size);
      Close(f);
      io := IOResult;
    End;
  EmitObjCoff := True;
End;

{ ---- Linker PE32 interne (TODO 24) ----

  Lie l'objet construit en memoire (code, .rdata, .data, relocations, symboles)
  avec les imports de kernel32 et ecrit l'executable Windows 32 bits : en-tetes
  MZ / PE, sections .text, .rdata, .data et .idata alignees (0x1000 en memoire,
  0x200 dans le fichier), base 0x400000 sans table de relocation, point
  d'entree _JSSTART, sous-systeme console. Les noms __imp__Nom@N non definis
  deviennent des entrees de l'IAT de KERNEL32.dll ; tout autre symbole non
  resolu est une erreur. }

Const
  PE_IMAGE_BASE = $00400000;
  PE_SEC_ALIGN = $1000;
  PE_FILE_ALIGN = $200;
  PE_HDR_SIZE = $400;

Var
  pe_out: TDynList;
  pe_size: LongInt;
  pe_text_rva, pe_rdata_rva, pe_data_rva, pe_idata_rva, pe_iat_rva, pe_iat_size,
  pe_image_size, pe_nimp: LongInt;
  pe_imp_name: TDynList;
  pe_xsym_imp: TDynList;

Type
  P_pe_xsym_imp = ^LongInt;

Function pe_xsym_impP(Var l: TDynList; i: LongInt): P_pe_xsym_imp;
Begin
  pe_xsym_impP := P_pe_xsym_imp(DlPtr(l, i - 1, SizeOf(LongInt)));
End;

Type
  T_pe_imp_name = String[60];
  P_pe_imp_name = ^T_pe_imp_name;

Function pe_imp_nameP(Var l: TDynList; i: LongInt): P_pe_imp_name;
Begin
  pe_imp_nameP := P_pe_imp_name(DlPtr(l, i - 1, SizeOf(T_pe_imp_name)));
End;

Type
  P_pe_out = ^Byte;

Function pe_outP(Var l: TDynList; i: LongInt): P_pe_out;
Begin
  pe_outP := P_pe_out(DlPtr(l, i - 0, SizeOf(Byte)));
End;

Function PeAlign(v, a: LongInt): LongInt;
Begin
  PeAlign := ((v + a - 1) Div a) * a;
End;

Procedure PeW16(pos, v: LongInt);
Begin
  pe_outP(pe_out, pos)^ := v And 255;
  pe_outP(pe_out, pos + 1)^ := (v Shr 8) And 255;
End;

Procedure PeW32(pos, v: LongInt);
Begin
  PeW16(pos, v And $FFFF);
  PeW16(pos + 2, (v Shr 16) And $FFFF);
End;

Procedure PeWStr(pos: LongInt; Const s: String);
Var
  i: LongInt;
Begin
  For i := 1 To Length(s) Do
    pe_outP(pe_out, pos + i - 1)^ := Ord(s[i]);
  pe_outP(pe_out, pos + Length(s))^ := 0;
End;

{ Nom de la fonction importee dans __imp__Nom@N, '' si ce n'est pas un import. }
Function PeImportName(Const sym: String): String;
Var
  r: String;
  p: Integer;
Begin
  PeImportName := '';
  If Copy(sym, 1, 7) <> '__imp__' Then
    Exit;
  r := Copy(sym, 8, Length(sym) - 7);
  p := Pos('@', r);
  If p > 0 Then
    r := Copy(r, 1, p - 1);
  PeImportName := r;
End;

{ Adresse virtuelle d'un symbole de donnees. }
Function PeDataVA(Var ctx: TCompilerContext; d: LongInt): Int64;
Begin
  If DsymP(ctx.data.syms, d)^.sec = SEC_RDATA Then
    PeDataVA := Int64(PE_IMAGE_BASE) + pe_rdata_rva + DsymP(ctx.data.syms, d)^.ofs
  Else
    PeDataVA := Int64(PE_IMAGE_BASE) + pe_data_rva + DsymP(ctx.data.syms, d)^.ofs;
End;

{ Adresse virtuelle d'un symbole de la table (donnee, procedure ou import IAT). }
Function PeSymVA(Var ctx: TCompilerContext; symkind, sym: LongInt): Int64;
Var
  d: LongInt;
Begin
  PeSymVA := -1;
  If symkind = SYMK_D Then
    PeSymVA := PeDataVA(ctx, sym)
  Else If XsymP(ctx.ir.xsyms, sym)^.defined Then
    PeSymVA := Int64(PE_IMAGE_BASE) + pe_text_rva + co_proc_ofsP(co_proc_ofs, sym)^
  Else
    Begin
      d := DsymFind(ctx, XsymP(ctx.ir.xsyms, sym)^.name);
      If d <> 0 Then
        PeSymVA := PeDataVA(ctx, d)
      Else If pe_xsym_impP(pe_xsym_imp, sym)^ <> 0 Then
        PeSymVA := Int64(PE_IMAGE_BASE) + pe_iat_rva + 4 * (pe_xsym_impP(pe_xsym_imp, sym)^ - 1);
    End;
End;

Function PeLink(Var ctx: TCompilerContext): Boolean;
Var
  i, j, k, n, tsz, rsz, dsz, isz, raw_t, raw_r, raw_d, raw_i, desc_off, ilt_off,
  iat_off, nam_off, dll_off, p, entry_x, sec_hdr, opt: LongInt;
  nm: String;
  v: Int64;
  ok: Boolean;
  lo, hi: LongInt;
  fld: LongInt;
Begin
  PeLink := False;
  ok := True;
  { imports : symboles __imp__ non definis }
  pe_nimp := 0;
  DlClear(pe_xsym_imp);
  For i := 1 To ctx.ir.xsym_count Do
    If Not XsymP(ctx.ir.xsyms, i)^.defined And (DsymFind(ctx, XsymP(ctx.ir.xsyms, i)^.name) = 0) Then
      Begin
        nm := PeImportName(XsymP(ctx.ir.xsyms, i)^.name);
        If nm = '' Then
          Begin
            PipelineError(ctx, 'symbole non resolu: ' + XsymP(ctx.ir.xsyms, i)^.name);
            ok := False;
          End
        Else
          Begin
            Inc(pe_nimp);
            pe_imp_nameP(pe_imp_name, pe_nimp)^ := nm;
            pe_xsym_impP(pe_xsym_imp, i)^ := pe_nimp;
          End;
      End;
  entry_x := 0;
  For i := 1 To ctx.ir.xsym_count Do
    If XsymP(ctx.ir.xsyms, i)^.defined And (XsymP(ctx.ir.xsyms, i)^.name = '_JSSTART') Then
      entry_x := i;
  If entry_x = 0 Then
    Begin
      PipelineError(ctx, 'point d''entree _JSSTART introuvable');
      ok := False;
    End;
  If Not ok Then
    Exit;
  { tailles et adresses des sections }
  tsz := co_len;
  rsz := ctx.data.rd_size;
  dsz := ctx.data.dt_size;
  n := pe_nimp;
  desc_off := 0;
  ilt_off := 40;
  iat_off := ilt_off + 4 * (n + 1);
  nam_off := iat_off + 4 * (n + 1);
  p := nam_off;
  For i := 1 To n Do
    p := p + PeAlign(2 + Length(pe_imp_nameP(pe_imp_name, i)^) + 1, 2);
  dll_off := p;
  isz := dll_off + 13;
  pe_text_rva := PE_SEC_ALIGN;
  pe_rdata_rva := PeAlign(pe_text_rva + tsz, PE_SEC_ALIGN);
  pe_data_rva := PeAlign(pe_rdata_rva + rsz, PE_SEC_ALIGN);
  pe_idata_rva := PeAlign(pe_data_rva + dsz, PE_SEC_ALIGN);
  pe_iat_rva := pe_idata_rva + iat_off;
  pe_iat_size := 4 * (n + 1);
  pe_image_size := PeAlign(pe_idata_rva + isz, PE_SEC_ALIGN);
  raw_t := PE_HDR_SIZE;
  raw_r := raw_t + PeAlign(tsz, PE_FILE_ALIGN);
  raw_d := raw_r + PeAlign(rsz, PE_FILE_ALIGN);
  raw_i := raw_d + PeAlign(dsz, PE_FILE_ALIGN);
  pe_size := raw_i + PeAlign(isz, PE_FILE_ALIGN);
  DlClear(pe_out);
  { en-tete DOS }
  pe_outP(pe_out, 0)^ := Ord('M');
  pe_outP(pe_out, 1)^ := Ord('Z');
  PeW16(2, $90);
  PeW16(4, 3);
  PeW16(8, 4);
  PeW16(12, $FFFF);
  PeW16(16, $B8);
  PeW16(24, $40);
  PeW32($3C, $80);
  { programme DOS : affiche un message puis termine }
  p := $40;
  pe_outP(pe_out, p)^ := $0E; pe_outP(pe_out, p + 1)^ := $1F; pe_outP(pe_out, p + 2)^ := $BA; pe_outP(pe_out, p + 3)^ := $0E;
  pe_outP(pe_out, p + 4)^ := $00; pe_outP(pe_out, p + 5)^ := $B4; pe_outP(pe_out, p + 6)^ := $09; pe_outP(pe_out, p + 7)^ := $CD;
  pe_outP(pe_out, p + 8)^ := $21; pe_outP(pe_out, p + 9)^ := $B8; pe_outP(pe_out, p + 10)^ := $01; pe_outP(pe_out, p + 11)^ := $4C;
  pe_outP(pe_out, p + 12)^ := $CD; pe_outP(pe_out, p + 13)^ := $21;
  PeWStr($4E, 'This program cannot be run in DOS mode.'#13#13#10'$');
  { signature PE et en-tete COFF }
  PeW32($80, $00004550);
  PeW16($84, $14C);
  PeW16($86, 4);
  PeW16($94, 224);
  PeW16($96, $0103);
  { en-tete optionnel PE32 }
  opt := $98;
  PeW16(opt, $10B);
  pe_outP(pe_out, opt + 2)^ := 1;
  pe_outP(pe_out, opt + 3)^ := 0;
  PeW32(opt + 4, PeAlign(tsz, PE_FILE_ALIGN));
  PeW32(opt + 8, PeAlign(rsz, PE_FILE_ALIGN) + PeAlign(dsz, PE_FILE_ALIGN) +
        PeAlign(isz, PE_FILE_ALIGN));
  PeW32(opt + 12, 0);
  PeW32(opt + 16, pe_text_rva + co_proc_ofsP(co_proc_ofs, entry_x)^);
  PeW32(opt + 20, pe_text_rva);
  PeW32(opt + 24, pe_rdata_rva);
  PeW32(opt + 28, PE_IMAGE_BASE);
  PeW32(opt + 32, PE_SEC_ALIGN);
  PeW32(opt + 36, PE_FILE_ALIGN);
  PeW16(opt + 40, 4);
  PeW16(opt + 42, 0);
  PeW16(opt + 48, 4);
  PeW32(opt + 56, pe_image_size);
  PeW32(opt + 60, PE_HDR_SIZE);
  PeW16(opt + 68, 3);
  PeW16(opt + 70, 0);
  PeW32(opt + 72, RT_STACK_RESERVE);
  PeW32(opt + 76, $10000);
  PeW32(opt + 80, $100000);
  PeW32(opt + 84, $1000);
  PeW32(opt + 92, 16);
  { repertoires : imports (1) et IAT (12) }
  PeW32(opt + 96 + 8 * 1, pe_idata_rva + desc_off);
  PeW32(opt + 96 + 8 * 1 + 4, 40);
  PeW32(opt + 96 + 8 * 12, pe_iat_rva);
  PeW32(opt + 96 + 8 * 12 + 4, pe_iat_size);
  { table des sections }
  sec_hdr := opt + 224;
  For k := 1 To 4 Do
    Begin
      p := sec_hdr + 40 * (k - 1);
      Case k Of
        1: Begin PeWStr(p, '.text'); PeW32(p + 8, tsz); PeW32(p + 12, pe_text_rva);
                 PeW32(p + 16, PeAlign(tsz, PE_FILE_ALIGN)); PeW32(p + 20, raw_t);
                 PeW32(p + 36, $60000020); End;
        2: Begin PeWStr(p, '.rdata'); PeW32(p + 8, rsz); PeW32(p + 12, pe_rdata_rva);
                 PeW32(p + 16, PeAlign(rsz, PE_FILE_ALIGN)); PeW32(p + 20, raw_r);
                 PeW32(p + 36, $40000040); End;
        3: Begin PeWStr(p, '.data'); PeW32(p + 8, dsz); PeW32(p + 12, pe_data_rva);
                 PeW32(p + 16, PeAlign(dsz, PE_FILE_ALIGN)); PeW32(p + 20, raw_d);
                 PeW32(p + 36, LongInt($C0000040)); End;
      Else
        Begin PeWStr(p, '.idata'); PeW32(p + 8, isz); PeW32(p + 12, pe_idata_rva);
              PeW32(p + 16, PeAlign(isz, PE_FILE_ALIGN)); PeW32(p + 20, raw_i);
              PeW32(p + 36, LongInt($C0000040)); End;
      End;
    End;
  { contenu des sections }
  DlCopyList(co_text, 0, pe_out, raw_t, tsz);
  DlCopyList(ctx.data.rd, 0, pe_out, raw_r, rsz);
  DlCopyList(ctx.data.dt, 0, pe_out, raw_d, dsz);
  { relocations du code }
  For i := 1 To co_nrel Do
    Begin
      v := PeSymVA(ctx, co_relP(co_rel, i)^.symkind, co_relP(co_rel, i)^.sym);
      If v < 0 Then
        Begin
          If co_relP(co_rel, i)^.symkind = SYMK_X Then
            PipelineError(ctx, 'symbole non resolu: ' + XsymP(ctx.ir.xsyms, co_relP(co_rel, i)^.sym)^.name);
          Exit;
        End;
      p := raw_t + co_relP(co_rel, i)^.ofs;
      fld := LongInt(Int64(pe_outP(pe_out, p)^) Or (Int64(pe_outP(pe_out, p + 1)^) Shl 8) Or
                     (Int64(pe_outP(pe_out, p + 2)^) Shl 16) Or (Int64(pe_outP(pe_out, p + 3)^) Shl 24));
      If co_relP(co_rel, i)^.typ = COFF_REL32 Then
        v := v + fld - (Int64(PE_IMAGE_BASE) + pe_text_rva + co_relP(co_rel, i)^.ofs + 4)
      Else
        v := v + fld;
      PeW32(p, LongInt(v And $FFFFFFFF));
    End;
  { relocations des donnees }
  For i := 1 To ctx.data.reloc_count Do
    Begin
      v := PeSymVA(ctx, RelocP(ctx.data.relocs, i)^.tkind, RelocP(ctx.data.relocs, i)^.target);
      If v < 0 Then
        Begin
          If RelocP(ctx.data.relocs, i)^.tkind = SYMK_X Then
            PipelineError(ctx, 'symbole non resolu: ' +
                          XsymP(ctx.ir.xsyms, RelocP(ctx.data.relocs, i)^.target)^.name);
          Exit;
        End;
      If RelocP(ctx.data.relocs, i)^.sec = SEC_RDATA Then
        p := raw_r + RelocP(ctx.data.relocs, i)^.ofs
      Else
        p := raw_d + RelocP(ctx.data.relocs, i)^.ofs;
      fld := LongInt(Int64(pe_outP(pe_out, p)^) Or (Int64(pe_outP(pe_out, p + 1)^) Shl 8) Or
                     (Int64(pe_outP(pe_out, p + 2)^) Shl 16) Or (Int64(pe_outP(pe_out, p + 3)^) Shl 24));
      PeW32(p, LongInt((v + fld) And $FFFFFFFF));
    End;
  { table des imports : descripteur, ILT, IAT, noms, nom de la DLL }
  p := raw_i;
  PeW32(p + desc_off, pe_idata_rva + ilt_off);
  PeW32(p + desc_off + 12, pe_idata_rva + dll_off);
  PeW32(p + desc_off + 16, pe_idata_rva + iat_off);
  k := nam_off;
  For i := 1 To n Do
    Begin
      PeW32(p + ilt_off + 4 * (i - 1), pe_idata_rva + k);
      PeW32(p + iat_off + 4 * (i - 1), pe_idata_rva + k);
      PeW16(p + k, 0);
      PeWStr(p + k + 2, pe_imp_nameP(pe_imp_name, i)^);
      k := k + PeAlign(2 + Length(pe_imp_nameP(pe_imp_name, i)^) + 1, 2);
    End;
  PeWStr(p + dll_off, 'KERNEL32.dll');
  lo := 0;
  hi := 0;
  PeLink := True;
End;

Function EmitExePe32(Var ctx: TCompilerContext): Boolean;
Var
  f: File;
  io: Integer;
Begin
  EmitExePe32 := False;
  If Not PeLink(ctx) Then
    Exit;
  If ctx.options.verbose Then
    Writeln('  EXE: ', pe_size, ' octets, ', pe_nimp, ' imports kernel32, image ',
            pe_image_size, ' octets');
  If ArtifactIsPersisted(ctx, AK_EXE_PE32) Then
    Begin
      Assign(f, NormalizePath(ctx.exe_name));
      Rewrite(f, 1);
      io := IOResult;
      If io <> 0 Then
        Begin
          PipelineError(ctx, 'impossible de creer le fichier ' + ctx.exe_name);
          Exit;
        End;
      DlWriteFile(f, pe_out, pe_size);
      Close(f);
      io := IOResult;
    End;
  EmitExePe32 := True;
End;

{ Supprime l'ancien executable (perime) avant une nouvelle production. }
Procedure RemoveStaleExe(Var ctx: TCompilerContext);
Var
  f: File;
  io: Integer;
Begin
  If ctx.options.run Or (ctx.options.output_mode <> OM_EXE) Then
    Exit;
  Assign(f, NormalizePath(ctx.exe_name));
  io := IOResult;
  Reset(f, 1);
  io := IOResult;
  If io = 0 Then
    Begin
      Close(f);
      Erase(f);
      io := IOResult;
      If ctx.options.verbose Then
        Writeln('  ancien ', ctx.exe_name, ' supprime');
    End;
End;

Function RunStage(Var ctx: TCompilerContext; stage: TCompileStage): Boolean;
Var
  ok: Boolean;
Begin
  Case stage Of
    CS_LOAD_SOURCE:
      RunStage := LoadSource(ctx);
    CS_LEX_TOKENS:
      Begin
        RunStage := LexSource(ctx);
        If ctx.options.dump_tokens Then
          DumpTokens(ctx);
      End;
    CS_PARSE_AST:
      Begin
        ok := ParseProgram(ctx);
        RunStage := ok;
        { si l'analyse suit, l'AST est affiche annote apres elle }
        If ctx.options.dump_ast And Not ok Then
          DumpAst(ctx);
      End;
    CS_BUILD_IR:
      Begin
        ok := BuildIR(ctx);
        RunStage := ok;
        If ctx.options.dump_ir Then
          DumpIR(ctx);
        If ctx.options.dump_scopes And ctx.ir.built Then
          DumpScopes(ctx);
      End;
    CS_EMIT_ASM386:
      RunStage := EmitAsm386(ctx);
    CS_BUILD_OBJ:
      RunStage := EmitObjCoff(ctx);
    CS_LINK_EXE:
      RunStage := EmitExePe32(ctx);
    CS_ANALYZE:
      Begin
        ok := AnalyzeProgram(ctx);
        If ok Then
          ok := BuildRuntimeModel(ctx);
        If ok Then
          ok := BuildDataPool(ctx);
        RunStage := ok;
        If ctx.options.dump_scopes Then
          DumpScopes(ctx);
        If ctx.options.dump_ast And ctx.ast.analyzed Then
          DumpAst(ctx);
        If ctx.options.dump_runtime Then
          DumpRuntimeModel(ctx);
        If ctx.options.dump_data Then
          DumpDataPool(ctx);
      End;
  Else
    Begin
      PipelineError(ctx, 'etape pipeline non implementee: ' + StageName(stage));
      RunStage := False;
    End;
  End;
End;

Function RunPipeline(Var ctx: TCompilerContext): Boolean;
Var
  s: TCompileStage;
  done: Boolean;
Begin
  RunPipeline := False;
  done := False;
  s := CS_LOAD_SOURCE;
  RemoveStaleExe(ctx);
  While Not done Do
    Begin
      ctx.stage := s;
      If ctx.options.verbose Then
        Writeln('Etape ', StageName(s), ' -> ',
                ArtifactName(StageOutputArtifact(s)));
      If Not RunStage(ctx, s) Then
        Exit;
      ctx.last_art := StageOutputArtifact(s);
      If ctx.options.verbose And ArtifactIsPersisted(ctx, ctx.last_art) Then
        Writeln('  ecriture sur disque: ', ArtifactName(ctx.last_art));
      If (ctx.last_art = PipelineTargetArtifact(ctx)) Or (s = CS_LINK_EXE) Then
        done := True
      Else
        s := Succ(s);
    End;
  RunPipeline := ctx.errors = 0;
End;

{ ---- Harnais de validation : option -test (TODO 25) ----

  jscw32 -test [dossier] [-obj] [-asm] [-keep]

  Pour chaque fichier .js du dossier (SAMPLES\JS par defaut), le harnais lance
  une compilation dans un sous-processus (le compilateur lui-meme), controle
  l'artefact selon le mode (EXE : en-tetes MZ/PE ; OBJ : en-tete COFF i386 ;
  ASM+OBJ : fichier .asm et .obj), execute le programme et compare sa sortie
  aux valeurs « attendu » des commentaires du source.

  Execution : sous Windows le .EXE produit est lance ; sur un autre systeme,
  la variable d'environnement JSCW32_RUNNER (par exemple « wine ») donne la
  commande qui lance le .EXE, sinon l'emulateur 80386 integre (-run) remplace
  le lancement. Les artefacts jt_*
  sont supprimes apres chaque fichier (sauf avec -keep).

  Valeurs attendues : commentaires « // attendu : valeur » dans l'ordre du
  source ; « a puis b » designe deux lignes, « a, b, c » trois lignes
  consecutives, une parenthese finale est un simple commentaire, et une
  ligne d'erreur « Error: valeur » correspond a « valeur ». }

Type
  THtLine = String[200];

Var
  ht_files: TDynList;
  ht_nfiles: LongInt;
  ht_out: TDynList;
  ht_nout: LongInt;
  ht_exp: TDynList;
  ht_nexp: LongInt;

Type
  P_ht_exp = ^THtLine;

Function ht_expP(Var l: TDynList; i: LongInt): P_ht_exp;
Begin
  ht_expP := P_ht_exp(DlPtr(l, i - 1, SizeOf(THtLine)));
End;

Type
  P_ht_out = ^THtLine;

Function ht_outP(Var l: TDynList; i: LongInt): P_ht_out;
Begin
  ht_outP := P_ht_out(DlPtr(l, i - 1, SizeOf(THtLine)));
End;

Type
  T_ht_files = String[80];
  P_ht_files = ^T_ht_files;

Function ht_filesP(Var l: TDynList; i: LongInt): P_ht_files;
Begin
  ht_filesP := P_ht_files(DlPtr(l, i - 1, SizeOf(T_ht_files)));
End;

Function HtTrim(s: String): String;
Begin
  While (Length(s) > 0) And ((s[1] = ' ') Or (s[1] = #9)) Do
    Delete(s, 1, 1);
  While (Length(s) > 0) And ((s[Length(s)] = ' ') Or (s[Length(s)] = #9) Or
        (s[Length(s)] = #13)) Do
    Delete(s, Length(s), 1);
  HtTrim := s;
End;

{ Lance une commande par l'interprete de commandes du systeme (la ligne est
  ecrite dans un petit script pour garder guillemets et redirections). }
Function HtShell(Const cmd: String): LongInt;
Var
  f: Text;
  io: Integer;
Begin
{$IFDEF UNIX}
  Assign(f, 'jt_cmd.sh');
{$ELSE}
  Assign(f, 'jt_cmd.bat');
{$ENDIF}
  {$I-}
  Rewrite(f);
  {$I-}
  io := IOResult;
  If io <> 0 Then
    Begin
      HtShell := -1;
      Exit;
    End;
  Writeln(f, cmd);
  Close(f);
  io := IOResult;
{$IFDEF UNIX}
  Exec('/bin/sh', 'jt_cmd.sh');
{$ELSE}
  Exec(GetEnv('COMSPEC'), '/C jt_cmd.bat');
{$ENDIF}
  If DosError <> 0 Then
    HtShell := -1
  Else
    HtShell := DosExitCode;
End;

Function HtFileExists(Const name: String): Boolean;
Var
  f: File;
  io: Integer;
Begin
  Assign(f, name);
  {$I-}
  Reset(f, 1);
  {$I-}
  io := IOResult;
  If io = 0 Then
    Begin
      Close(f);
      io := IOResult;
    End;
  HtFileExists := io = 0;
End;

Procedure HtErase(Const name: String);
Var
  f: File;
  io: Integer;
Begin
  If Not HtFileExists(name) Then
    Exit;
  Assign(f, name);
  {$I-}
  Erase(f);
  {$I-}
  io := IOResult;
End;

Function HtFileSize(Const name: String): LongInt;
Var
  f: File;
  io: Integer;
Begin
  HtFileSize := -1;
  Assign(f, name);
  {$I-}
  Reset(f, 1);
  {$I-}
  io := IOResult;
  If io = 0 Then
    Begin
      HtFileSize := FileSize(f);
      Close(f);
      io := IOResult;
    End;
End;

{ Lit les n premiers octets d'un fichier (0 si impossible). }
Function HtReadBytes(Const name: String; Var buf; n: LongInt): LongInt;
Var
  f: File;
  io: Integer;
  got: Word;
Begin
  HtReadBytes := 0;
  Assign(f, name);
  {$I-}
  Reset(f, 1);
  {$I-}
  io := IOResult;
  If io <> 0 Then
    Exit;
  BlockRead(f, buf, n, got);
  io := IOResult;
  Close(f);
  io := IOResult;
  HtReadBytes := got;
End;

{ Verifie l'en-tete MZ + PE32 i386 d'un executable. }
Function HtCheckExe(Const name: String; Var why: String): Boolean;
Type
  TBuf = Array[0..511] Of Byte;
Var
  b: TBuf;
  n, pe: LongInt;
Begin
  HtCheckExe := False;
  FillChar(b, SizeOf(b), 0);
  n := HtReadBytes(name, b, 512);
  If n < 200 Then
    Begin
      why := 'executable absent ou trop court';
      Exit;
    End;
  If (b[0] <> Ord('M')) Or (b[1] <> Ord('Z')) Then
    Begin
      why := 'signature MZ absente';
      Exit;
    End;
  pe := b[$3C] + b[$3D] * 256;
  If (pe + 24 > 500) Or (b[pe] <> Ord('P')) Or (b[pe + 1] <> Ord('E')) Or
     (b[pe + 2] <> 0) Or (b[pe + 3] <> 0) Then
    Begin
      why := 'signature PE absente';
      Exit;
    End;
  If (b[pe + 4] <> $4C) Or (b[pe + 5] <> 1) Then
    Begin
      why := 'machine differente de i386';
      Exit;
    End;
  If (b[pe + 24] <> $0B) Or (b[pe + 25] <> $01) Then
    Begin
      why := 'en-tete optionnel non PE32';
      Exit;
    End;
  HtCheckExe := True;
End;

Function HtCheckObj(Const name: String; Var why: String): Boolean;
Type
  TBuf = Array[0..39] Of Byte;
Var
  b: TBuf;
  n: LongInt;
Begin
  HtCheckObj := False;
  FillChar(b, SizeOf(b), 0);
  n := HtReadBytes(name, b, 40);
  If n < 40 Then
    Begin
      why := 'objet absent ou trop court';
      Exit;
    End;
  If (b[0] <> $4C) Or (b[1] <> $01) Then
    Begin
      why := 'machine COFF differente de i386';
      Exit;
    End;
  If b[2] < 3 Then
    Begin
      why := 'sections COFF manquantes';
      Exit;
    End;
  HtCheckObj := True;
End;

{ Charge les lignes d'un fichier texte de sortie. }
Procedure HtLoadOutput(Const name: String);
Var
  f: Text;
  s: String;
  io: Integer;
Begin
  ht_nout := 0;
  Assign(f, name);
  {$I-}
  Reset(f);
  {$I-}
  io := IOResult;
  If io <> 0 Then
    Exit;
  While Not Eof(f) Do
    Begin
      {$I-}
      Readln(f, s);
      {$I-}
      io := IOResult;
      Inc(ht_nout);
      ht_outP(ht_out, ht_nout)^ := HtTrim(s);
    End;
  Close(f);
  io := IOResult;
End;

Procedure HtAddExp(s: String);
Var
  p, k: Integer;
Begin
  s := HtTrim(s);
  { une parenthese finale est un commentaire }
  If (Length(s) > 0) And (s[Length(s)] = ')') Then
    Begin
      p := 0;
      For k := 1 To Length(s) - 1 Do
        If (s[k] = ' ') And (s[k + 1] = '(') Then
          p := k;
      If p > 0 Then
        s := HtTrim(Copy(s, 1, p - 1));
    End;
  If s <> '' Then
    Begin
      Inc(ht_nexp);
      ht_expP(ht_exp, ht_nexp)^ := s;
    End;
End;

{ Extrait les « // attendu : ... » du source. }
Procedure HtLoadExpected(Const name: String);
Var
  f: Text;
  s, rest: String;
  p, q, io: Integer;
Begin
  ht_nexp := 0;
  Assign(f, name);
  {$I-}
  Reset(f);
  {$I-}
  io := IOResult;
  If io <> 0 Then
    Exit;
  While Not Eof(f) Do
    Begin
      {$I-}
      Readln(f, s);
      {$I-}
      io := IOResult;
      p := Pos('// attendu', s);
      If p > 0 Then
        Begin
          q := Pos(':', Copy(s, p, Length(s)));
          If q > 0 Then
            Begin
              rest := Copy(s, p + q, Length(s));
              While Pos(' puis ', rest) > 0 Do
                Begin
                  HtAddExp(Copy(rest, 1, Pos(' puis ', rest) - 1));
                  Delete(rest, 1, Pos(' puis ', rest) + 5);
                End;
              HtAddExp(rest);
            End;
        End;
    End;
  Close(f);
  io := IOResult;
End;

Function HtEndsWith(Const s, suffix: String): Boolean;
Begin
  HtEndsWith := (Length(s) >= Length(suffix)) And
                (Copy(s, Length(s) - Length(suffix) + 1, Length(suffix)) = suffix);
End;

Type
  PHtLine = ^THtLine;

Function HtPartP(Var l: TDynList; i: LongInt): PHtLine;
Begin
  HtPartP := PHtLine(DlPtr(l, i - 1, SizeOf(THtLine)));
End;

{ Cherche la valeur attendue e a partir de la ligne pos ; renvoie la ligne
  suivante, ou 0 si elle est introuvable. }
Function HtFindExp(Const e: String; startl: LongInt): LongInt;
Var
  j, k, n, p: LongInt;
  parts: TDynList;
  rest: String;
  ok: Boolean;
Begin
  HtFindExp := 0;
  FillChar(parts, SizeOf(parts), 0);
  { liste « a, b, c » : lignes consecutives }
  n := 0;
  rest := e;
  While Pos(', ', rest) > 0 Do
    Begin
      Inc(n);
      p := Pos(', ', rest);
      HtPartP(parts, n)^ := Copy(rest, 1, p - 1);
      Delete(rest, 1, p + 1);
    End;
  Inc(n);
  HtPartP(parts, n)^ := rest;
  For j := startl To ht_nout Do
    Begin
      If (ht_outP(ht_out, j)^ = e) Or HtEndsWith(ht_outP(ht_out, j)^, ': ' + e) Then
        Begin
          HtFindExp := j + 1;
          DlFree(parts);
          Exit;
        End;
      If (n > 1) And (j + n - 1 <= ht_nout) Then
        Begin
          ok := True;
          For k := 1 To n Do
            If ht_outP(ht_out, j + k - 1)^ <> HtPartP(parts, k)^ Then
              ok := False;
          If ok Then
            Begin
              HtFindExp := j + n;
              DlFree(parts);
              Exit;
            End;
        End;
    End;
  DlFree(parts);
End;

{ Compare la sortie aux valeurs attendues ; renvoie '' si tout concorde. }
Function HtCompare: String;
Var
  i, cur, r: LongInt;
Begin
  cur := 1;
  HtCompare := '';
  For i := 1 To ht_nexp Do
    Begin
      r := HtFindExp(ht_expP(ht_exp, i)^, cur);
      If r = 0 Then
        Begin
          HtCompare := 'valeur attendue introuvable : ' + ht_expP(ht_exp, i)^;
          Exit;
        End;
      cur := r;
    End;
End;

{ Fichiers de test d'un programme qui se termine volontairement par une
  exception non rattrapee (erreur du programme d'exemple). }
Function HtKnownThrow(Const base: String): Boolean;
Begin
  HtKnownThrow := base = 'test11adv';
End;

Procedure HtListFiles(Const dir: String);
Var
  sr: SearchRec;
  i, j: LongInt;
  t: String[80];
Begin
  ht_nfiles := 0;
  FindFirst(dir + '/*.js', AnyFile, sr);
  While DosError = 0 Do
    Begin
      If sr.Attr And Directory = 0 Then
        Begin
          Inc(ht_nfiles);
          ht_filesP(ht_files, ht_nfiles)^ := sr.Name;
        End;
      FindNext(sr);
    End;
  FindClose(sr);
  { tri alphabetique }
  For i := 2 To ht_nfiles Do
    Begin
      t := ht_filesP(ht_files, i)^;
      j := i - 1;
      While (j >= 1) And (ht_filesP(ht_files, j)^ > t) Do
        Begin
          ht_filesP(ht_files, j + 1)^ := ht_filesP(ht_files, j)^;
          Dec(j);
        End;
      ht_filesP(ht_files, j + 1)^ := t;
    End;
End;

Function HtCmd(Const self, opts, outbase, src: String): String;
Begin
  HtCmd := '"' + self + '" ' + opts + ' -o ' + outbase + ' "' + src + '"';
End;

Function RunTests(Var ctx: TCompilerContext): LongInt;
Var
  dir, self, base, tag, why, opts, mode_name, run_name, log_name, out_name,
  exe_name, obj_name, asm_name, src, nul, line: String;
  i, rc, ok_count, fail_count, warn_count: LongInt;
  isexe, isobj, isasm, passed, windows: Boolean;
  runner: String;
Begin
  RunTests := EXIT_OK;
  self := ParamStr(0);
  dir := ctx.source_name;
  If dir = '' Then
    dir := 'SAMPLES/JS';
  dir := NormalizePath(dir);
  If (dir[Length(dir)] = '/') Or (dir[Length(dir)] = '\') Then
    Dec(dir[0]);
  isobj := ctx.options.output_mode = OM_OBJ;
  isasm := ctx.options.emit_asm;
  isexe := Not isobj;
  windows := False;
{$IFDEF WINDOWS}
  windows := True;
{$ENDIF}
{$IFDEF UNIX}
  nul := '/dev/null';
{$ELSE}
  nul := 'NUL';
{$ENDIF}
  opts := '';
  If isobj Then
    opts := opts + '-obj ';
  If isasm Then
    opts := opts + '-asm ';
  If isexe And Not isasm Then
    mode_name := 'EXE'
  Else If isexe Then
    mode_name := 'EXE+ASM'
  Else If isasm Then
    mode_name := 'ASM+OBJ'
  Else
    mode_name := 'OBJ';
  runner := GetEnv('JSCW32_RUNNER');
  If isexe And windows Then
    run_name := 'execution du .EXE'
  Else If isexe And (runner <> '') Then
    run_name := 'execution du .EXE par ' + runner
  Else
    run_name := 'emulateur 80386 integre';
  HtListFiles(dir);
  If ht_nfiles = 0 Then
    Begin
      Writeln('JSCW32 -test : aucun fichier .js dans ', dir);
      RunTests := EXIT_ERROR;
      Exit;
    End;
  Writeln('JSCW32 -test : ', ht_nfiles, ' fichier(s) dans ', dir, ', mode ', mode_name);
  If isexe Then
    Writeln('  execution : ', run_name);
  ok_count := 0;
  fail_count := 0;
  warn_count := 0;
  For i := 1 To ht_nfiles Do
    Begin
      base := ht_filesP(ht_files, i)^;
      Delete(base, Length(base) - 2, 3);
      src := dir + '/' + ht_filesP(ht_files, i)^;
      exe_name := 'jt_' + base + '.exe';
      obj_name := 'jt_' + base + '.obj';
      asm_name := 'jt_' + base + '.asm';
      log_name := 'jt_' + base + '.log';
      out_name := 'jt_' + base + '.out';
      passed := False;
      tag := '';
      why := '';
      HtErase(exe_name);
      HtErase(obj_name);
      HtErase(asm_name);
      rc := HtShell(HtCmd(self, opts, 'jt_' + base, src) + ' > ' + log_name + ' 2>&1');
      If rc <> 0 Then
        why := 'compilation en echec (code ' + IntToStr(rc) + ')'
      Else If isexe And Not HtCheckExe(exe_name, why) Then
        why := 'executable invalide : ' + why
      Else If isobj And Not HtCheckObj(obj_name, why) Then
        why := 'objet invalide : ' + why
      Else If isasm And (HtFileSize(asm_name) < 100) Then
        why := 'fichier .asm absent'
      Else
        Begin
          { comportement du programme }
          HtLoadExpected(src);
          If isexe Then
            Begin
              If windows Then
                rc := HtShell(exe_name + ' < ' + nul + ' > ' + out_name + ' 2>&1')
              Else If runner <> '' Then
                rc := HtShell(runner + ' ' + exe_name + ' < ' + nul + ' > ' + out_name +
                              ' 2>&1')
              Else
                rc := HtShell('"' + self + '" -run "' + src + '" < ' + nul + ' > ' +
                              out_name + ' 2>&1');
              HtLoadOutput(out_name);
              If HtKnownThrow(base) Then
                Begin
                  If rc = 0 Then
                    why := 'exception non rattrapee attendue'
                  Else
                    Begin
                      passed := True;
                      tag := 'exception non rattrapee (attendue)';
                    End;
                End
              Else If rc <> 0 Then
                why := 'execution en echec (code ' + IntToStr(rc) + ')'
              Else
                Begin
                  why := HtCompare;
                  If why = '' Then
                    Begin
                      passed := True;
                      If ht_nexp > 0 Then
                        tag := IntToStr(ht_nexp) + ' valeur(s) attendue(s)'
                      Else
                        tag := 'execution sans erreur';
                    End;
                End;
            End
          Else
            Begin
              passed := True;
              tag := 'artefacts valides';
            End;
        End;
      line := ht_filesP(ht_files, i)^;
      While Length(line) < 16 Do
        line := line + ' ';
      If passed Then
        Begin
          Inc(ok_count);
          Writeln('  ', line, 'OK     ', tag);
        End
      Else
        Begin
          Inc(fail_count);
          Writeln('  ', line, 'ECHEC  ', why);
          If HtFileExists(log_name) And (rc <> 0) Then
            Begin
              HtLoadOutput(log_name);
              If ht_nout > 0 Then
                Writeln('                  ', ht_outP(ht_out, 1)^);
            End;
        End;
      If Not ctx.options.keep Then
        Begin
          HtErase(exe_name);
          HtErase(obj_name);
          HtErase(asm_name);
          HtErase(log_name);
          HtErase(out_name);
        End;
    End;
  If Not ctx.options.keep Then
    Begin
{$IFDEF UNIX}
      HtErase('jt_cmd.sh');
{$ELSE}
      HtErase('jt_cmd.bat');
{$ENDIF}
    End;
  Writeln;
  Writeln('Resultat : ', ok_count, ' OK, ', fail_count, ' echec(s) sur ', ht_nfiles,
          ' fichier(s)');
  If fail_count > 0 Then
    RunTests := EXIT_ERROR;
End;

Procedure PrintFinalDiagnostics(Var ctx: TCompilerContext);
Begin
  Writeln('Resultat: ', ArtifactName(ctx.last_art));
  Writeln('Erreurs : ', ctx.errors);
  Writeln('Warnings: ', ctx.warnings);
End;

Var
  ctx: TCompilerContext;
  parse_result: Integer;

BEGIN
  InitPipelineDefaults(ctx);
  parse_result := ParseArgs(ctx);

  If ctx.options.show_help Then
    Begin
      PrintUsage;
      Halt(EXIT_OK);
    End;

  If ctx.options.show_version Then
    Begin
      Writeln('JSCW32 ', JSCW32_VERSION, ' (', JSCW32_DATE, ')');
      Halt(EXIT_OK);
    End;

  If parse_result <> EXIT_OK Then
    Begin
      Writeln('Essayez: jscw32 -h');
      Halt(parse_result);
    End;

{$IFDEF FPC}
  SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide, exOverflow,
                    exUnderflow, exPrecision]);
{$ENDIF}
  { -runtime sans fichier source : decrit seulement le modele }
  If ctx.options.dump_runtime And (ctx.source_name = '') Then
    Begin
      DumpRuntimeModel(ctx);
      Halt(EXIT_OK);
    End;

  If ctx.options.test Then
    Halt(RunTests(ctx));

  If ctx.options.verbose Then
    Begin
      PrintPipeline;
      PrintOptions(ctx);
    End;

  If Not RunPipeline(ctx) Then
    Halt(EXIT_ERROR);

  If ctx.options.run Then
    Halt(RunEmulator(ctx));

  If ctx.options.verbose Then
    PrintFinalDiagnostics(ctx);
  Halt(EXIT_OK);
END.
