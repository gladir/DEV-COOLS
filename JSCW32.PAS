  { _JSRT_str_match_at(botte, aiguille, pos) -> 1 si l'aiguille est a pos }
  A('proc _JSRT_str_match_at');
  A('push ebp');
  A('mov ebp, esp');
  A('push ebx');
  A('push esi');
  A('push edi');
  A('mov esi, dword ptr [ebp+8]');
  A('mov edi, dword ptr [ebp+12]');
  A('mov ebx, dword ptr [ebp+16]');
