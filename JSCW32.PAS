{ ---- Expressions regulieres : machine a retour sur trace ----

  Contexte d'execution R : instructions +0, texte +4, longueur +8,
  captures +12, marques +16, sommet de la pile +20, fin de la pile +24,
  drapeaux +28, nombre de cases de captures +32, nombre de marques +36,
  debut de la pile +40. Entree de la pile (12 octets) : genre, x, y ;
  genre 0 = alternative (pc, position), 1 = restauration d'une capture
  (indice, ancienne valeur), 2 = restauration d'une marque. }

{ Empile une entree sur la pile de retour arriere (sommet dans Lv(3)). }
Procedure RxPush(Const kind, x, y: TString);
Var
  ok: TString;
Begin
  ok := U('p');
  A('mov eax, ' + Lv(3));
  A('lea edx, [eax+12]');
  A('cmp edx, dword ptr [esi+24]');
  A('jbe ' + ok);
  A('push offset _JSRT_c_stack');
  A('call _JSRT_fatal');
  A(ok + ':');
  A('mov dword ptr [eax], ' + kind);
  A('mov edx, ' + x);
  A('mov dword ptr [eax+4], edx');
  A('mov edx, ' + y);
  A('mov dword ptr [eax+8], edx');
  A('add eax, 12');
  A('mov ' + Lv(3) + ', eax');
End;

{ Recharge ECX avec l'adresse de l'instruction courante. }
Procedure RxCur;
Begin
  A('mov ecx, ' + Lv(1));
  A('shl ecx, 4');
  A('add ecx, dword ptr [esi]');
End;

