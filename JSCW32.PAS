  A('push 10');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_sb_addb');
  A('add esp, 8');
  A('push ' + Lv(3));
  A('push dword ptr [ebp+8]');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('.a_val:');
  A('mov esi, ' + Lv(1));
  A('push edi');
  A('push esi');
  A('call _JSRT_arr_get');
  A('add esp, 8');
  A('mov ' + Lv(4) + ', eax');
  A('mov ' + Lv(5) + ', edx');
  A('push ' + Lv(5));
  A('push ' + Lv(4));
  A('call _JSRT_json_skip');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .a_do');
  A('push offset ' + RtStr('null'));
  A('push dword ptr [ebp+8]');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('jmp .a_next');
  A('.a_do:');
