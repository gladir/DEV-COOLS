Procedure RtGcTables;
Const
  GC_SMALL_N = 24;
  GC_SMALL: Array[0..23] Of LongInt = (16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128,
    160, 192, 224, 256, 320, 384, 512, 768, 1024, 1536, 2048, 3200, 4096);
  GC_JUMBO: Array[0..4] Of LongInt = (8000, 12288, 16288, 21728, 32608);
Var
  ofs, i, c, sz, n: LongInt;
Begin
  { classe d'une demande de i * 8 octets (jusqu'a 4096) }
  ofs := SecAlloc(asm_ctx^, SEC_RDATA, 520);
  For i := 0 To 512 Do
    Begin
      c := 0;
      While GC_SMALL[c] < i * 8 Do
        Inc(c);
      PutByte(asm_ctx^, SEC_RDATA, ofs + i, c);
    End;
  NewDataSym(asm_ctx^, '_JSRT_gc_cls8', SEC_RDATA, ofs, 520, DS_STRING);
  { enregistrement de classe : taille d'emplacement, nombre, masque de page, taille de page }
  ofs := SecAlloc(asm_ctx^, SEC_RDATA, 16 * 29);
  For c := 0 To 28 Do
    Begin
      If c < GC_SMALL_N Then
        Begin
          sz := GC_SMALL[c];
          n := (16384 - 320) Div sz;
          If n > 1024 Then
            n := 1024;
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c, sz);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 4, n);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 8, $FFFFC000);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 12, 16384);
        End
      Else
        Begin
          sz := GC_JUMBO[c - GC_SMALL_N];
          n := (65536 - 320) Div sz;
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c, sz);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 4, n);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 8, $FFFF0000);
          PutDword(asm_ctx^, SEC_RDATA, ofs + 16 * c + 12, 65536);
        End;
    End;
  NewDataSym(asm_ctx^, '_JSRT_gc_ctab', SEC_RDATA, ofs, 16 * 29, DS_STRING);
End;

