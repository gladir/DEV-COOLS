{ ---- Acces aux jetons ---- }

Function TkIsP(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsP := ((TokP(ctx.lex.tokens, i)^.kind = TK_PUNCT) Or
            (TokP(ctx.lex.tokens, i)^.kind = TK_OPERATOR)) And
           (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function TkIsKw(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsKw := (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) And
            (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function TkIsId(Var ctx: TCompilerContext; i: LongInt; Const s: TTokenText): Boolean;
Begin
  TkIsId := (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) And
            (TokP(ctx.lex.tokens, i)^.text = s);
End;

Function CurIsP(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  CurIsP := TkIsP(ctx, ctx.ast.pt, s);
End;

Function CurIsKw(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  CurIsKw := TkIsKw(ctx, ctx.ast.pt, s);
End;

Function CurIsEof(Var ctx: TCompilerContext): Boolean;
Begin
  CurIsEof := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_EOF;
End;

{ Indice du jeton situe n positions apres le courant (borne par EOF). }
Function PeekIdx(Var ctx: TCompilerContext; n: LongInt): LongInt;
Begin
  If ctx.ast.pt + n > ctx.lex.token_count Then
    PeekIdx := ctx.lex.token_count
  Else
    PeekIdx := ctx.ast.pt + n;
End;

Procedure PAdvance(Var ctx: TCompilerContext);
Begin
  If ctx.ast.pt < ctx.lex.token_count Then
    Inc(ctx.ast.pt);
End;

Function TokenDesc(Var ctx: TCompilerContext; i: LongInt): TString;
Begin
  If TokP(ctx.lex.tokens, i)^.kind = TK_EOF Then
    TokenDesc := 'fin de fichier'
  Else
    TokenDesc := '"' + TokP(ctx.lex.tokens, i)^.text + '"';
End;

{ Une seule erreur par jeton, pour eviter les cascades. }
Procedure ParseError(Var ctx: TCompilerContext; i: LongInt; msg: TString);
Begin
  If i = ctx.ast.last_err_tok Then
    Exit;
  ctx.ast.last_err_tok := i;
  SourceErrorAt(ctx, TokP(ctx.lex.tokens, i)^.line, TokP(ctx.lex.tokens, i)^.col, msg);
End;

Function Expect(Var ctx: TCompilerContext; Const s: TTokenText): Boolean;
Begin
  If CurIsP(ctx, s) Then
    Begin
      PAdvance(ctx);
      Expect := True;
    End
  Else
    Begin
      ParseError(ctx, ctx.ast.pt, '"' + s + '" attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Expect := False;
    End;
End;

{ Point-virgule explicite ou insertion automatique (ASI). }
Procedure ConsumeSemi(Var ctx: TCompilerContext);
Begin
  If CurIsP(ctx, ';') Then
    PAdvance(ctx)
  Else If CurIsP(ctx, '}') Or CurIsEof(ctx) Or
          TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    { ASI }
  Else
    ParseError(ctx, ctx.ast.pt, '";" attendu avant ' +
               TokenDesc(ctx, ctx.ast.pt));
End;

Function IsStmtStartKw(Var ctx: TCompilerContext; i: LongInt): Boolean;
Var
  s: TTokenText;
Begin
  s := TokP(ctx.lex.tokens, i)^.text;
  IsStmtStartKw := (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) And
    ((s = 'var') Or (s = 'let') Or (s = 'const') Or (s = 'function') Or
     (s = 'class') Or (s = 'if') Or (s = 'for') Or (s = 'while') Or
     (s = 'do') Or (s = 'return') Or (s = 'switch') Or (s = 'try') Or
     (s = 'throw') Or (s = 'break') Or (s = 'continue'));
End;

{ Reprise apres erreur : saute jusqu'a la fin de l'instruction. }
Procedure Synchronize(Var ctx: TCompilerContext);
Var
  first: Boolean;
Begin
  first := True;
  While Not CurIsEof(ctx) Do
    Begin
      If CurIsP(ctx, ';') Then
        Begin
          PAdvance(ctx);
          Exit;
        End;
      If CurIsP(ctx, '}') Then
        Exit;
      If Not first And TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before And
         IsStmtStartKw(ctx, ctx.ast.pt) Then
        Exit;
      first := False;
      PAdvance(ctx);
    End;
End;

{ ---- Noeuds et declarations ---- }

Function NewNode(Var ctx: TCompilerContext; kind: TNodeKind; tok: LongInt): LongInt;
Var
  n: LongInt;
Begin
  Inc(ctx.ast.node_count);
  n := ctx.ast.node_count;
  NodeP(ctx.ast.nodes, n)^.kind := kind;
  NodeP(ctx.ast.nodes, n)^.tok := tok;
  NodeP(ctx.ast.nodes, n)^.e1 := 0;
  NodeP(ctx.ast.nodes, n)^.e2 := 0;
  NodeP(ctx.ast.nodes, n)^.e3 := 0;
  NodeP(ctx.ast.nodes, n)^.e4 := 0;
  NodeP(ctx.ast.nodes, n)^.next := 0;
  NodeP(ctx.ast.nodes, n)^.flags := 0;
  NodeP(ctx.ast.nodes, n)^.paren := False;
  NodeP(ctx.ast.nodes, n)^.scope := 0;
  NodeP(ctx.ast.nodes, n)^.decl_head := 0;
  NodeP(ctx.ast.nodes, n)^.sym := 0;
  NodeP(ctx.ast.nodes, n)^.aux := 0;
  NodeP(ctx.ast.nodes, n)^.ds := 0;
  NewNode := n;
End;

{ Ajoute node a la liste (first, last). }
Procedure ListAdd(Var ctx: TCompilerContext; Var first, last: LongInt;
                  node: LongInt);
Begin
  If node = 0 Then
    Exit;
  If first = 0 Then
    first := node
  Else
    NodeP(ctx.ast.nodes, last)^.next := node;
  last := node;
End;

Procedure DeclareName(Var ctx: TCompilerContext; kind: TDeclKind;
                      name_tok, node: LongInt);
Var
  n: LongInt;
Begin
  Inc(ctx.ast.decl_count);
  n := ctx.ast.decl_count;
  DeclP(ctx.ast.decls, n)^.kind := kind;
  DeclP(ctx.ast.decls, n)^.name_tok := name_tok;
  DeclP(ctx.ast.decls, n)^.node := node;
  DeclP(ctx.ast.decls, n)^.origin := ctx.ast.cur_scope;
  If kind = DK_VAR Then
    DeclP(ctx.ast.decls, n)^.scope := ctx.ast.cur_func
  Else
    DeclP(ctx.ast.decls, n)^.scope := ctx.ast.cur_scope;
End;

{ ---- Declarations anticipees et contexte de fonction ---- }

Function ParseAssign(Var ctx: TCompilerContext; no_in: Boolean): LongInt; Forward;
Function ParseExpr(Var ctx: TCompilerContext; no_in: Boolean): LongInt; Forward;
Function ParseLHS(Var ctx: TCompilerContext): LongInt; Forward;
Function ParseClass(Var ctx: TCompilerContext; is_decl: Boolean): LongInt; Forward;
Procedure ParseParamList(Var ctx: TCompilerContext; node: LongInt); Forward;
Function ParseFuncBlock(Var ctx: TCompilerContext): LongInt; Forward;
Procedure ParseFuncRest(Var ctx: TCompilerContext; node: LongInt); Forward;

{ Entre dans la portee d'une fonction : memorise le contexte courant. }
Procedure EnterFunc(Var ctx: TCompilerContext; node: LongInt; Var sv: TFuncSave);
Begin
  sv.scope := ctx.ast.cur_scope;
  sv.func := ctx.ast.cur_func;
  sv.loop := ctx.ast.loop_depth;
  sv.switch := ctx.ast.switch_depth;
  sv.labels := ctx.ast.label_count;
  ctx.ast.cur_scope := node;
  ctx.ast.cur_func := node;
  ctx.ast.loop_depth := 0;
  ctx.ast.switch_depth := 0;
  Inc(ctx.ast.func_depth);
End;

Procedure LeaveFunc(Var ctx: TCompilerContext; Var sv: TFuncSave);
Begin
  Dec(ctx.ast.func_depth);
  ctx.ast.label_count := sv.labels;
  ctx.ast.switch_depth := sv.switch;
  ctx.ast.loop_depth := sv.loop;
  ctx.ast.cur_func := sv.func;
  ctx.ast.cur_scope := sv.scope;
End;

{ ---- Liaisons : identifiants et motifs de destructuration ---- }

Function ParseBindingTarget(Var ctx: TCompilerContext; dk: TDeclKind): LongInt; Forward;

Function ParseBindingDefault(Var ctx: TCompilerContext): LongInt;
Begin
  ParseBindingDefault := 0;
  If CurIsP(ctx, '=') Then
    Begin
      PAdvance(ctx);
      ParseBindingDefault := ParseAssign(ctx, False);
    End;
End;

Function IsPropertyNameTok(Var ctx: TCompilerContext; i: LongInt): Boolean;
Begin
  IsPropertyNameTok := (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_KEYWORD) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_STRING) Or
                       (TokP(ctx.lex.tokens, i)^.kind = TK_NUMBER);
End;

Function ParseArrayPattern(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node, el, first, last: LongInt;
  rest: Boolean;
Begin
  node := NewNode(ctx, N_ARRAY_PATTERN, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, ']') And Not CurIsEof(ctx) Do
    Begin
      el := NewNode(ctx, N_PATTERN_ELEM, ctx.ast.pt);
      If CurIsP(ctx, ',') Then
        { trou : element omis }
      Else
        Begin
          rest := CurIsP(ctx, '...');
          If rest Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, el)^.flags := PF_REST;
            End;
          NodeP(ctx.ast.nodes, el)^.e1 := ParseBindingTarget(ctx, dk);
          If Not rest Then
            NodeP(ctx.ast.nodes, el)^.e2 := ParseBindingDefault(ctx);
        End;
      ListAdd(ctx, first, last, el);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, ']');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseArrayPattern := node;
End;

Function ParseObjectPattern(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node, prop, first, last, key_tok, tgt: LongInt;
Begin
  node := NewNode(ctx, N_OBJECT_PATTERN, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) Do
    Begin
      prop := NewNode(ctx, N_PATTERN_PROP, ctx.ast.pt);
      If CurIsP(ctx, '...') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, prop)^.flags := PP_REST;
          NodeP(ctx.ast.nodes, prop)^.e1 := ParseBindingTarget(ctx, dk);
        End
      Else
        Begin
          If CurIsP(ctx, '[') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.flags := PP_COMPUTED;
              NodeP(ctx.ast.nodes, prop)^.e3 := ParseAssign(ctx, False);
              Expect(ctx, ']');
              key_tok := NodeP(ctx.ast.nodes, prop)^.tok;
            End
          Else If IsPropertyNameTok(ctx, ctx.ast.pt) Then
            Begin
              key_tok := ctx.ast.pt;
              NodeP(ctx.ast.nodes, prop)^.tok := key_tok;
              PAdvance(ctx);
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, 'nom de propriete attendu, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          If CurIsP(ctx, ':') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.e1 := ParseBindingTarget(ctx, dk);
            End
          Else If (TokP(ctx.lex.tokens, key_tok)^.kind = TK_IDENT) And
                  (NodeP(ctx.ast.nodes, prop)^.flags And PP_COMPUTED = 0) Then
            Begin
              { raccourci : a ou a = 1 dans les accolades }
              NodeP(ctx.ast.nodes, prop)^.flags := NodeP(ctx.ast.nodes, prop)^.flags Or
                                           PP_SHORTHAND;
              tgt := NewNode(ctx, N_BIND_IDENT, key_tok);
              DeclareName(ctx, dk, key_tok, tgt);
              NodeP(ctx.ast.nodes, prop)^.e1 := tgt;
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, '":" attendu dans le motif, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          NodeP(ctx.ast.nodes, prop)^.e2 := ParseBindingDefault(ctx);
        End;
      ListAdd(ctx, first, last, prop);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, '}');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseObjectPattern := node;
End;

Function ParseBindingTarget(Var ctx: TCompilerContext; dk: TDeclKind): LongInt;
Var
  node: LongInt;
Begin
  ParseBindingTarget := 0;
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      node := NewNode(ctx, N_BIND_IDENT, ctx.ast.pt);
      DeclareName(ctx, dk, ctx.ast.pt, node);
      PAdvance(ctx);
      ParseBindingTarget := node;
    End
  Else If CurIsP(ctx, '[') Then
    ParseBindingTarget := ParseArrayPattern(ctx, dk)
  Else If CurIsP(ctx, '{') Then
    ParseBindingTarget := ParseObjectPattern(ctx, dk)
  Else
    ParseError(ctx, ctx.ast.pt, 'identifiant attendu, trouve ' +
               TokenDesc(ctx, ctx.ast.pt));
End;

{ ---- Declarations var / let / const ---- }

{ Le mot-cle de declaration est le jeton courant. in_for : acces depuis
  un en-tete de for (initialiseur facultatif pour for-in et for-of). }
Function ParseVarDecl(Var ctx: TCompilerContext; in_for: Boolean): LongInt;
Var
  node, decl, target, init, first, last, kw_tok: LongInt;
  dk: TDeclKind;
  is_pattern: Boolean;
Begin
  kw_tok := ctx.ast.pt;
  node := NewNode(ctx, N_VAR_DECL, kw_tok);
  If CurIsKw(ctx, 'var') Then
    Begin
      dk := DK_VAR;
      NodeP(ctx.ast.nodes, node)^.flags := DF_VAR;
    End
  Else If CurIsKw(ctx, 'let') Then
    Begin
      dk := DK_LET;
      NodeP(ctx.ast.nodes, node)^.flags := DF_LET;
    End
  Else
    Begin
      dk := DK_CONST;
      NodeP(ctx.ast.nodes, node)^.flags := DF_CONST;
    End;
  PAdvance(ctx);
  first := 0;
  last := 0;
  Repeat
    decl := NewNode(ctx, N_DECLARATOR, ctx.ast.pt);
    is_pattern := CurIsP(ctx, '[') Or CurIsP(ctx, '{');
    target := ParseBindingTarget(ctx, dk);
    If target = 0 Then
      Begin
        Synchronize(ctx);
        Break;
      End;
    NodeP(ctx.ast.nodes, decl)^.e1 := target;
    init := 0;
    If CurIsP(ctx, '=') Then
      Begin
        PAdvance(ctx);
        init := ParseAssign(ctx, in_for);
      End
    Else If Not in_for Then
      Begin
        If dk = DK_CONST Then
          ParseError(ctx, NodeP(ctx.ast.nodes, decl)^.tok,
                     'une constante doit etre initialisee')
        Else If is_pattern Then
          ParseError(ctx, NodeP(ctx.ast.nodes, decl)^.tok,
                     'la destructuration doit etre initialisee');
      End;
    NodeP(ctx.ast.nodes, decl)^.e2 := init;
    ListAdd(ctx, first, last, decl);
    If CurIsP(ctx, ',') Then
      PAdvance(ctx)
    Else
      Break;
  Until False;
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseVarDecl := node;
End;

{ ---- Expressions (TODO 5) ---- }

{ Precedence d'un operateur binaire, 0 si ce n'en est pas un. }
Function BinPrec(Const s: TTokenText): LongInt;
Begin
  BinPrec := 0;
  If s = '??' Then
    BinPrec := 1
  Else If s = '||' Then
    BinPrec := 2
  Else If s = '&&' Then
    BinPrec := 3
  Else If s = '|' Then
    BinPrec := 4
  Else If s = '^' Then
    BinPrec := 5
  Else If s = '&' Then
    BinPrec := 6
  Else If (s = '==') Or (s = '!=') Or (s = '===') Or (s = '!==') Then
    BinPrec := 7
  Else If (s = '<') Or (s = '>') Or (s = '<=') Or (s = '>=') Then
    BinPrec := 8
  Else If (s = '<<') Or (s = '>>') Or (s = '>>>') Then
    BinPrec := 9
  Else If (s = '+') Or (s = '-') Then
    BinPrec := 10
  Else If (s = '*') Or (s = '/') Or (s = '%') Then
    BinPrec := 11
  Else If s = '**' Then
    BinPrec := 12;
End;

Function IsAssignOp(Const s: TTokenText): Boolean;
Begin
  IsAssignOp := (s = '=') Or (s = '+=') Or (s = '-=') Or (s = '*=') Or
                (s = '/=') Or (s = '%=') Or (s = '**=') Or (s = '<<=') Or
                (s = '>>=') Or (s = '>>>=') Or (s = '&=') Or (s = '|=') Or
                (s = '^=') Or (s = '&&=') Or (s = '||=') Or (s = '??=');
End;

{ Cible d'une affectation simple : identifiant ou membre. }
Function IsSimpleTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsSimpleTarget := (n <> 0) And
    ((NodeP(ctx.ast.nodes, n)^.kind = N_IDENT) Or (NodeP(ctx.ast.nodes, n)^.kind = N_MEMBER) Or
     (NodeP(ctx.ast.nodes, n)^.kind = N_INDEX));
End;

{ Avec = : un tableau ou un objet litteral est aussi une cible
  (destructuration). }
Function IsPatternTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsPatternTarget := IsSimpleTarget(ctx, n) Or
    ((n <> 0) And ((NodeP(ctx.ast.nodes, n)^.kind = N_ARRAY_LIT) Or
                   (NodeP(ctx.ast.nodes, n)^.kind = N_OBJECT_LIT)));
End;

{ Index de la parenthese fermante qui correspond a la parenthese
  ouvrante du jeton i, ou 0. }
Function MatchClose(Var ctx: TCompilerContext; i: LongInt): LongInt;
Var
  depth: LongInt;
  s: TTokenText;
Begin
  MatchClose := 0;
  depth := 0;
  While TokP(ctx.lex.tokens, i)^.kind <> TK_EOF Do
    Begin
      s := TokP(ctx.lex.tokens, i)^.text;
      Case TokP(ctx.lex.tokens, i)^.kind Of
        TK_PUNCT, TK_OPERATOR:
          Begin
            If (s = '(') Or (s = '[') Or (s = '{') Then
              Inc(depth)
            Else If (s = ')') Or (s = ']') Or (s = '}') Then
              Begin
                Dec(depth);
                If depth = 0 Then
                  Begin
                    MatchClose := i;
                    Exit;
                  End;
              End;
          End;
        TK_TEMPLATE:
          Begin
            If TokP(ctx.lex.tokens, i)^.tpl = TP_HEAD Then
              Inc(depth)
            Else If TokP(ctx.lex.tokens, i)^.tpl = TP_TAIL Then
              Dec(depth);
          End;
      End;
      Inc(i);
    End;
End;

{ Le jeton courant commence-t-il une fonction fleche ? }
Function IsArrowAhead(Var ctx: TCompilerContext; Var is_async: Boolean): Boolean;
Var
  i, nx, j: LongInt;
Begin
  IsArrowAhead := False;
  is_async := False;
  i := ctx.ast.pt;
  nx := PeekIdx(ctx, 1);
  If TkIsId(ctx, i, 'async') And Not TokP(ctx.lex.tokens, nx)^.nl_before And
     Not TkIsP(ctx, nx, '=>') Then
    Begin
      If (TokP(ctx.lex.tokens, nx)^.kind = TK_IDENT) And
         TkIsP(ctx, PeekIdx(ctx, 2), '=>') Then
        Begin
          is_async := True;
          IsArrowAhead := True;
          Exit;
        End;
      If TkIsP(ctx, nx, '(') Then
        Begin
          j := MatchClose(ctx, nx);
          If (j > 0) And TkIsP(ctx, j + 1, '=>') And
             Not TokP(ctx.lex.tokens, j + 1)^.nl_before Then
            Begin
              is_async := True;
              IsArrowAhead := True;
              Exit;
            End;
        End;
    End;
  If (TokP(ctx.lex.tokens, i)^.kind = TK_IDENT) And TkIsP(ctx, nx, '=>') And
     Not TokP(ctx.lex.tokens, nx)^.nl_before Then
    IsArrowAhead := True
  Else If TkIsP(ctx, i, '(') Then
    Begin
      j := MatchClose(ctx, i);
      If (j > 0) And TkIsP(ctx, j + 1, '=>') And
         Not TokP(ctx.lex.tokens, j + 1)^.nl_before Then
        IsArrowAhead := True;
    End;
End;

{ Nom de propriete (ou crochet de nom calcule) au jeton i ? }
Function IsPropNameStart(Var ctx: TCompilerContext; i: LongInt): Boolean;
Begin
  IsPropNameStart := IsPropertyNameTok(ctx, i) Or TkIsP(ctx, i, '[');
End;

{ Arguments d'appel : ( a, ...b ). Retourne la liste des arguments. }
Function ParseCallArgs(Var ctx: TCompilerContext): LongInt;
Var
  first, last, a, sp: LongInt;
Begin
  first := 0;
  last := 0;
  If Expect(ctx, '(') Then
    Begin
      While Not CurIsP(ctx, ')') And Not CurIsEof(ctx) Do
        Begin
          If CurIsP(ctx, '...') Then
            Begin
              sp := NewNode(ctx, N_SPREAD, ctx.ast.pt);
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, sp)^.e1 := ParseAssign(ctx, False);
              a := sp;
            End
          Else
            a := ParseAssign(ctx, False);
          If a = 0 Then
            Break;
          ListAdd(ctx, first, last, a);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
      Expect(ctx, ')');
    End;
  ParseCallArgs := first;
End;

Function ParseTemplate(Var ctx: TCompilerContext): LongInt;
Var
  node, part, e, first, last: LongInt;
  done: Boolean;
Begin
  node := NewNode(ctx, N_TEMPLATE, ctx.ast.pt);
  first := 0;
  last := 0;
  part := NewNode(ctx, N_TEMPLATE_STR, ctx.ast.pt);
  ListAdd(ctx, first, last, part);
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl <> TP_NOSUB Then
    Begin
      PAdvance(ctx);
      done := False;
      While Not done Do
        Begin
          e := ParseExpr(ctx, False);
          If e = 0 Then
            Break;
          ListAdd(ctx, first, last, e);
          If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_TEMPLATE) And
             ((TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_MIDDLE) Or
              (TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_TAIL)) Then
            Begin
              part := NewNode(ctx, N_TEMPLATE_STR, ctx.ast.pt);
              ListAdd(ctx, first, last, part);
              If TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_TAIL Then
                done := True;
              If Not done Then
                PAdvance(ctx);
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, 'fin de gabarit attendue, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
        End;
    End;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseTemplate := node;
End;

{ Gabarit etiquete : tag`a...b` devient tag(__tpl(cuits..., bruts...), valeurs...). }
Function BuildTagged(Var ctx: TCompilerContext; tag: LongInt): LongInt;
Var
  t, p, nx, c, idx, id, call_tpl, outer, tpl_tok: LongInt;
  s_first, s_last, r_first, r_last, a_first, a_last: LongInt;
Begin
  tpl_tok := ctx.ast.pt;
  t := ParseTemplate(ctx);
  s_first := 0;
  s_last := 0;
  r_first := 0;
  r_last := 0;
  a_first := 0;
  a_last := 0;
  p := NodeP(ctx.ast.nodes, t)^.e1;
  While p <> 0 Do
    Begin
      nx := NodeP(ctx.ast.nodes, p)^.next;
      If NodeP(ctx.ast.nodes, p)^.kind = N_TEMPLATE_STR Then
        Begin
          c := NewNode(ctx, N_TEMPLATE_STR, NodeP(ctx.ast.nodes, p)^.tok);
          ListAdd(ctx, s_first, s_last, c);
          c := NewNode(ctx, N_TEMPLATE_STR, NodeP(ctx.ast.nodes, p)^.tok);
          NodeP(ctx.ast.nodes, c)^.flags := 1;
          ListAdd(ctx, r_first, r_last, c);
        End
      Else
        Begin
          NodeP(ctx.ast.nodes, p)^.next := 0;
          ListAdd(ctx, a_first, a_last, p);
        End;
      p := nx;
    End;
  NodeP(ctx.ast.nodes, s_last)^.next := r_first;
  idx := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, tpl_tok)^.line,
                  TokP(ctx.lex.tokens, tpl_tok)^.col, ctx.lex.pos);
  TokP(ctx.lex.tokens, idx)^.text := '__tpl';
  id := NewNode(ctx, N_IDENT, idx);
  call_tpl := NewNode(ctx, N_CALL, tpl_tok);
  NodeP(ctx.ast.nodes, call_tpl)^.e1 := id;
  NodeP(ctx.ast.nodes, call_tpl)^.e2 := s_first;
  NodeP(ctx.ast.nodes, call_tpl)^.next := a_first;
  outer := NewNode(ctx, N_CALL, tpl_tok);
  NodeP(ctx.ast.nodes, outer)^.e1 := tag;
  NodeP(ctx.ast.nodes, outer)^.e2 := call_tpl;
  BuildTagged := outer;
End;

Function ParseArrayLiteral(Var ctx: TCompilerContext): LongInt;
Var
  node, el, first, last: LongInt;
Begin
  node := NewNode(ctx, N_ARRAY_LIT, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, ']') And Not CurIsEof(ctx) Do
    Begin
      If CurIsP(ctx, ',') Then
        Begin
          el := NewNode(ctx, N_ELISION, ctx.ast.pt);
          PAdvance(ctx);
          ListAdd(ctx, first, last, el);
        End
      Else
        Begin
          If CurIsP(ctx, '...') Then
            Begin
              el := NewNode(ctx, N_SPREAD, ctx.ast.pt);
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, el)^.e1 := ParseAssign(ctx, False);
            End
          Else
            el := ParseAssign(ctx, False);
          If el = 0 Then
            Break;
          ListAdd(ctx, first, last, el);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
    End;
  Expect(ctx, ']');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseArrayLiteral := node;
End;

Function ParseObjectLiteral(Var ctx: TCompilerContext): LongInt;
Var
  node, prop, first, last, key_tok, fn, nx: LongInt;
  flags, fflags: LongInt;

  { Le jeton courant est un modificateur (get, set, async) si un nom de
    propriete le suit. }
  Function IsModifier: Boolean;
  Begin
    nx := PeekIdx(ctx, 1);
    IsModifier := IsPropNameStart(ctx, nx) Or
                  (TkIsP(ctx, nx, '*') And TkIsId(ctx, ctx.ast.pt, 'async'));
  End;

Begin
  node := NewNode(ctx, N_OBJECT_LIT, ctx.ast.pt);
  PAdvance(ctx);
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) Do
    Begin
      prop := NewNode(ctx, N_PROP, ctx.ast.pt);
      flags := 0;
      fflags := FN_METHOD;
      If CurIsP(ctx, '...') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, prop)^.flags := PR_SPREAD;
          NodeP(ctx.ast.nodes, prop)^.e1 := ParseAssign(ctx, False);
        End
      Else
        Begin
          If TkIsId(ctx, ctx.ast.pt, 'async') And IsModifier And
             Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
            Begin
              PAdvance(ctx);
              fflags := fflags Or FN_ASYNC;
              flags := flags Or PR_METHOD;
            End;
          If CurIsP(ctx, '*') Then
            Begin
              PAdvance(ctx);
              fflags := fflags Or FN_GENERATOR;
              flags := flags Or PR_METHOD;
            End;
          If (TkIsId(ctx, ctx.ast.pt, 'get') Or TkIsId(ctx, ctx.ast.pt, 'set')) And
             IsModifier Then
            Begin
              If TkIsId(ctx, ctx.ast.pt, 'get') Then
                flags := flags Or PR_GETTER
              Else
                flags := flags Or PR_SETTER;
              PAdvance(ctx);
            End;
          key_tok := ctx.ast.pt;
          NodeP(ctx.ast.nodes, prop)^.tok := key_tok;
          If CurIsP(ctx, '[') Then
            Begin
              PAdvance(ctx);
              flags := flags Or PR_COMPUTED;
              NodeP(ctx.ast.nodes, prop)^.e2 := ParseAssign(ctx, False);
              Expect(ctx, ']');
            End
          Else If IsPropertyNameTok(ctx, key_tok) Then
            PAdvance(ctx)
          Else
            Begin
              ParseError(ctx, key_tok, 'nom de propriete attendu, trouve ' +
                         TokenDesc(ctx, key_tok));
              Break;
            End;
          If CurIsP(ctx, '(') Then
            Begin
              fn := NewNode(ctx, N_FUNC_EXPR, key_tok);
              NodeP(ctx.ast.nodes, fn)^.flags := fflags;
              flags := flags Or PR_METHOD;
              ParseFuncRest(ctx, fn);
              NodeP(ctx.ast.nodes, prop)^.e1 := fn;
            End
          Else If flags And (PR_METHOD Or PR_GETTER Or PR_SETTER) <> 0 Then
            Begin
              ParseError(ctx, ctx.ast.pt, '"(" attendu apres le nom de methode, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End
          Else If CurIsP(ctx, ':') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, prop)^.e1 := ParseAssign(ctx, False);
            End
          Else If (TokP(ctx.lex.tokens, key_tok)^.kind = TK_IDENT) And
                  (flags And PR_COMPUTED = 0) And
                  (CurIsP(ctx, ',') Or CurIsP(ctx, '}') Or CurIsP(ctx, '=')) Then
            Begin
              flags := flags Or PR_SHORTHAND;
              fn := NewNode(ctx, N_IDENT, key_tok);
              NodeP(ctx.ast.nodes, prop)^.e1 := fn;
              { a = 1 : valeur par defaut d'un motif d'affectation }
              If CurIsP(ctx, '=') Then
                Begin
                  PAdvance(ctx);
                  flags := flags Or PR_DEFAULT;
                  NodeP(ctx.ast.nodes, prop)^.e3 := ParseAssign(ctx, False);
                End;
            End
          Else
            Begin
              ParseError(ctx, ctx.ast.pt, '":" attendu apres le nom de propriete, trouve ' +
                         TokenDesc(ctx, ctx.ast.pt));
              Break;
            End;
          NodeP(ctx.ast.nodes, prop)^.flags := flags;
        End;
      ListAdd(ctx, first, last, prop);
      If CurIsP(ctx, ',') Then
        PAdvance(ctx)
      Else
        Break;
    End;
  Expect(ctx, '}');
  NodeP(ctx.ast.nodes, node)^.e1 := first;
  ParseObjectLiteral := node;
End;

Function ParseFunctionExpr(Var ctx: TCompilerContext; is_async: Boolean): LongInt;
Var
  node, name_tok, save_scope, flags: LongInt;
  has_name: Boolean;
Begin
  flags := 0;
  If is_async Then
    Begin
      flags := flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  name_tok := ctx.ast.pt;
  PAdvance(ctx);
  If CurIsP(ctx, '*') Then
    Begin
      flags := flags Or FN_GENERATOR;
      PAdvance(ctx);
    End;
  has_name := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT;
  If has_name Then
    name_tok := ctx.ast.pt;
  node := NewNode(ctx, N_FUNC_EXPR, name_tok);
  NodeP(ctx.ast.nodes, node)^.flags := flags;
  If has_name Then
    Begin
      PAdvance(ctx);
      { le nom d'une expression de fonction vit dans sa propre portee }
      save_scope := ctx.ast.cur_scope;
      ctx.ast.cur_scope := node;
      DeclareName(ctx, DK_FNAME, name_tok, node);
      ctx.ast.cur_scope := save_scope;
    End;
  ParseFuncRest(ctx, node);
  ParseFunctionExpr := node;
End;

{ Fonction fleche : x => ..., (a, b) => ..., async x => ... }
Function ParseArrowFn(Var ctx: TCompilerContext; is_async, no_in: Boolean): LongInt;
Var
  node, par, bnd: LongInt;
  sv: TFuncSave;
Begin
  node := NewNode(ctx, N_FUNC_EXPR, ctx.ast.pt);
  ParseArrowFn := node;
  NodeP(ctx.ast.nodes, node)^.flags := FN_ARROW;
  If is_async Then
    Begin
      NodeP(ctx.ast.nodes, node)^.flags := NodeP(ctx.ast.nodes, node)^.flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  EnterFunc(ctx, node, sv);
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      par := NewNode(ctx, N_PARAM, ctx.ast.pt);
      bnd := NewNode(ctx, N_BIND_IDENT, ctx.ast.pt);
      DeclareName(ctx, DK_PARAM, ctx.ast.pt, bnd);
      NodeP(ctx.ast.nodes, par)^.e1 := bnd;
      NodeP(ctx.ast.nodes, node)^.e1 := par;
      PAdvance(ctx);
    End
  Else
    ParseParamList(ctx, node);
  If Expect(ctx, '=>') Then
    Begin
      If CurIsP(ctx, '{') Then
        NodeP(ctx.ast.nodes, node)^.e2 := ParseFuncBlock(ctx)
      Else
        Begin
          NodeP(ctx.ast.nodes, node)^.flags := NodeP(ctx.ast.nodes, node)^.flags Or FN_EXPR_BODY;
          NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, no_in);
        End;
    End;
  LeaveFunc(ctx, sv);
End;

Function ParsePrimary(Var ctx: TCompilerContext): LongInt;
Var
  node, t, bg_tok, bg_str: LongInt;
  s: TTokenText;
Begin
  ParsePrimary := 0;
  t := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, t)^.text;
  Case TokP(ctx.lex.tokens, t)^.kind Of
    TK_IDENT:
      Begin
        If (s = 'async') And TkIsKw(ctx, PeekIdx(ctx, 1), 'function') And
           Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
          ParsePrimary := ParseFunctionExpr(ctx, True)
        Else
          Begin
            ParsePrimary := NewNode(ctx, N_IDENT, t);
            PAdvance(ctx);
          End;
      End;
    TK_NUMBER:
      Begin
        ParsePrimary := NewNode(ctx, N_NUMBER, t);
        PAdvance(ctx);
      End;
    TK_STRING:
      Begin
        node := NewNode(ctx, N_STRING, t);
        ParsePrimary := node;
        If TokP(ctx.lex.tokens, t)^.flag_len = 1 Then
          Begin
            { litteral BigInt : __BigInt("chiffres") }
            bg_tok := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, t)^.line,
                               TokP(ctx.lex.tokens, t)^.col, ctx.lex.pos);
            TokP(ctx.lex.tokens, bg_tok)^.text := '__BigInt';
            bg_str := node;
            node := NewNode(ctx, N_CALL, t);
            NodeP(ctx.ast.nodes, node)^.e1 := NewNode(ctx, N_IDENT, bg_tok);
            NodeP(ctx.ast.nodes, node)^.e2 := bg_str;
            ParsePrimary := node;
          End;
        PAdvance(ctx);
      End;
    TK_REGEX:
      Begin
        ParsePrimary := NewNode(ctx, N_REGEX, t);
        PAdvance(ctx);
      End;
    TK_TEMPLATE:
      Begin
        If (TokP(ctx.lex.tokens, t)^.tpl = TP_NOSUB) Or
           (TokP(ctx.lex.tokens, t)^.tpl = TP_HEAD) Then
          ParsePrimary := ParseTemplate(ctx)
        Else
          ParseError(ctx, t, 'gabarit inattendu');
      End;
    TK_KEYWORD:
      Begin
        If s = 'this' Then
          node := NewNode(ctx, N_THIS, t)
        Else If s = 'super' Then
          node := NewNode(ctx, N_SUPER, t)
        Else If s = 'null' Then
          node := NewNode(ctx, N_NULL, t)
        Else If (s = 'true') Or (s = 'false') Then
          node := NewNode(ctx, N_BOOL, t)
        Else If s = 'function' Then
          Begin
            ParsePrimary := ParseFunctionExpr(ctx, False);
            Exit;
          End
        Else If s = 'class' Then
          Begin
            ParsePrimary := ParseClass(ctx, False);
            Exit;
          End
        Else
          Begin
            ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
            Exit;
          End;
        PAdvance(ctx);
        ParsePrimary := node;
      End;
    TK_PUNCT:
      Begin
        If s = '(' Then
          Begin
            PAdvance(ctx);
            node := ParseExpr(ctx, False);
            Expect(ctx, ')');
            If node <> 0 Then
              NodeP(ctx.ast.nodes, node)^.paren := True;
            ParsePrimary := node;
          End
        Else If s = '[' Then
          ParsePrimary := ParseArrayLiteral(ctx)
        Else If s = '{' Then
          ParsePrimary := ParseObjectLiteral(ctx)
        Else
          ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
      End;
  Else
    ParseError(ctx, t, 'expression attendue, trouve ' + TokenDesc(ctx, t));
  End;
End;

{ new X(args) : le callee est un membre sans appel. }
Function ParseNew(Var ctx: TCompilerContext): LongInt;
Var
  node, callee, m, name_tok, nt_tok: LongInt;
Begin
  node := NewNode(ctx, N_NEW, ctx.ast.pt);
  ParseNew := node;
  PAdvance(ctx);
  If CurIsP(ctx, '.') Then
    Begin
      { new.target : appel de __newtarget() }
      PAdvance(ctx);
      If Not ((TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT) And
              (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = 'target')) Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"target" attendu apres "new."');
          Exit;
        End;
      nt_tok := AddToken(ctx, TK_IDENT, TokP(ctx.lex.tokens, ctx.ast.pt)^.line,
                         TokP(ctx.lex.tokens, ctx.ast.pt)^.col, ctx.lex.pos);
      TokP(ctx.lex.tokens, nt_tok)^.text := '__newtarget';
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.kind := N_CALL;
      NodeP(ctx.ast.nodes, node)^.e1 := NewNode(ctx, N_IDENT, nt_tok);
      Exit;
    End;
  If CurIsKw(ctx, 'new') Then
    callee := ParseNew(ctx)
  Else
    callee := ParsePrimary(ctx);
  While (callee <> 0) And (CurIsP(ctx, '.') Or CurIsP(ctx, '[')) Do
    Begin
      If CurIsP(ctx, '.') Then
        Begin
          PAdvance(ctx);
          name_tok := ctx.ast.pt;
          If Not IsPropertyNameTok(ctx, name_tok) Or
             (TokP(ctx.lex.tokens, name_tok)^.kind in [TK_STRING, TK_NUMBER]) Then
            Begin
              ParseError(ctx, name_tok, 'nom de propriete attendu apres ".", trouve ' +
                         TokenDesc(ctx, name_tok));
              Break;
            End;
          m := NewNode(ctx, N_MEMBER, name_tok);
          NodeP(ctx.ast.nodes, m)^.e1 := callee;
          PAdvance(ctx);
        End
      Else
        Begin
          m := NewNode(ctx, N_INDEX, ctx.ast.pt);
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, m)^.e1 := callee;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseExpr(ctx, False);
          Expect(ctx, ']');
        End;
      callee := m;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := callee;
  If CurIsP(ctx, '(') Then
    NodeP(ctx.ast.nodes, node)^.e2 := ParseCallArgs(ctx);
End;

{ Expression gauche : primaire suivi d'acces, d'appels, de ?. et de
  gabarits etiquetes. }
Function ParseLHS(Var ctx: TCompilerContext): LongInt;
Var
  e, m, name_tok: LongInt;
  optional: Boolean;
Begin
  If CurIsKw(ctx, 'new') Then
    e := ParseNew(ctx)
  Else
    e := ParsePrimary(ctx);
  ParseLHS := e;
  If e = 0 Then
    Exit;
  While True Do
    Begin
      optional := False;
      If CurIsP(ctx, '?.') Then
        Begin
          optional := True;
          PAdvance(ctx);
        End;
      If CurIsP(ctx, '(') Then
        Begin
          m := NewNode(ctx, N_CALL, ctx.ast.pt);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseCallArgs(ctx);
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
        End
      Else If CurIsP(ctx, '[') Then
        Begin
          m := NewNode(ctx, N_INDEX, ctx.ast.pt);
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          NodeP(ctx.ast.nodes, m)^.e2 := ParseExpr(ctx, False);
          Expect(ctx, ']');
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
        End
      Else If optional Or CurIsP(ctx, '.') Then
        Begin
          If Not optional Then
            PAdvance(ctx);
          name_tok := ctx.ast.pt;
          If Not IsPropertyNameTok(ctx, name_tok) Or
             (TokP(ctx.lex.tokens, name_tok)^.kind in [TK_STRING, TK_NUMBER]) Then
            Begin
              ParseError(ctx, name_tok, 'nom de propriete attendu apres ".", trouve ' +
                         TokenDesc(ctx, name_tok));
              Exit;
            End;
          m := NewNode(ctx, N_MEMBER, name_tok);
          NodeP(ctx.ast.nodes, m)^.e1 := e;
          If optional Then
            NodeP(ctx.ast.nodes, m)^.flags := EF_OPTIONAL;
          PAdvance(ctx);
        End
      Else If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_TEMPLATE) And
              ((TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_NOSUB) Or
               (TokP(ctx.lex.tokens, ctx.ast.pt)^.tpl = TP_HEAD)) Then
        Begin
          m := BuildTagged(ctx, e);
        End
      Else
        Break;
      e := m;
      ParseLHS := e;
    End;
End;

{ La fonction courante est-elle un generateur (gen) ou une fonction async ? }
Function CurFuncHas(Var ctx: TCompilerContext; gen: Boolean): Boolean;
Var
  f: LongInt;
Begin
  f := ctx.ast.cur_func;
  CurFuncHas := False;
  If (f = 0) Or (f = ctx.ast.root) Then
    Exit;
  If NodeP(ctx.ast.nodes, f)^.kind = N_METHOD Then
    Begin
      If gen Then
        CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And MF_GENERATOR <> 0
      Else
        CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And MF_ASYNC <> 0;
    End
  Else If gen Then
    CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And FN_GENERATOR <> 0
  Else
    CurFuncHas := NodeP(ctx.ast.nodes, f)^.flags And FN_ASYNC <> 0;
End;

{ Le jeton courant peut-il commencer une expression (apres yield) ? }
Function StartsExpr(Var ctx: TCompilerContext): Boolean;
Var
  t: LongInt;
  s: TTokenText;
Begin
  t := ctx.ast.pt;
  StartsExpr := True;
  If (TokP(ctx.lex.tokens, t)^.kind = TK_EOF) Or TokP(ctx.lex.tokens, t)^.nl_before Then
    StartsExpr := False
  Else If TokP(ctx.lex.tokens, t)^.kind = TK_PUNCT Then
    Begin
      s := TokP(ctx.lex.tokens, t)^.text;
      If (s = ')') Or (s = ']') Or (s = '}') Or (s = ',') Or (s = ';') Or (s = ':') Then
        StartsExpr := False;
    End;
End;

Function ParseUnary(Var ctx: TCompilerContext): LongInt;
Var
  node, t, operand: LongInt;
  s: TTokenText;
  is_op: Boolean;
Begin
  t := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, t)^.text;
  is_op := False;
  If TkIsId(ctx, t, 'await') And CurFuncHas(ctx, False) Then
    Begin
      node := NewNode(ctx, N_UNARY, t);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseUnary(ctx);
      ParseUnary := node;
      Exit;
    End;
  If TokP(ctx.lex.tokens, t)^.kind = TK_OPERATOR Then
    { & unaire : operateur de reference &fn, extension utilisee par test22.js }
    is_op := (s = '!') Or (s = '~') Or (s = '+') Or (s = '-') Or (s = '&')
  Else If TokP(ctx.lex.tokens, t)^.kind = TK_KEYWORD Then
    is_op := (s = 'typeof') Or (s = 'void') Or (s = 'delete');
  If is_op Then
    Begin
      node := NewNode(ctx, N_UNARY, t);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseUnary(ctx);
      ParseUnary := node;
    End
  Else If (TokP(ctx.lex.tokens, t)^.kind = TK_OPERATOR) And
          ((s = '++') Or (s = '--')) Then
    Begin
      node := NewNode(ctx, N_UPDATE, t);
      NodeP(ctx.ast.nodes, node)^.flags := UF_PREFIX;
      PAdvance(ctx);
      operand := ParseUnary(ctx);
      If (operand <> 0) And Not IsSimpleTarget(ctx, operand) Then
        ParseError(ctx, t, 'operande invalide pour ' + s);
      NodeP(ctx.ast.nodes, node)^.e1 := operand;
      ParseUnary := node;
    End
  Else
    Begin
      operand := ParseLHS(ctx);
      ParseUnary := operand;
      If (operand <> 0) And (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_OPERATOR) And
         ((TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '++') Or
          (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '--')) And
         Not TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
        Begin
          If Not IsSimpleTarget(ctx, operand) Then
            ParseError(ctx, ctx.ast.pt, 'operande invalide pour ' +
                       TokP(ctx.lex.tokens, ctx.ast.pt)^.text);
          node := NewNode(ctx, N_UPDATE, ctx.ast.pt);
          NodeP(ctx.ast.nodes, node)^.e1 := operand;
          PAdvance(ctx);
          ParseUnary := node;
        End;
    End;
End;

{ Operateurs binaires par escalade de precedence ; ** est associatif a
  droite. }
Function ParseBinary(Var ctx: TCompilerContext; min_prec: LongInt;
                     no_in: Boolean): LongInt;
Var
  left, right, node, op_tok, prec: LongInt;
  s: TTokenText;
  is_logical: Boolean;
Begin
  left := ParseUnary(ctx);
  ParseBinary := left;
  If left = 0 Then
    Exit;
  While True Do
    Begin
      op_tok := ctx.ast.pt;
      s := TokP(ctx.lex.tokens, op_tok)^.text;
      prec := 0;
      If TokP(ctx.lex.tokens, op_tok)^.kind = TK_OPERATOR Then
        prec := BinPrec(s)
      Else If TokP(ctx.lex.tokens, op_tok)^.kind = TK_KEYWORD Then
        Begin
          If (s = 'instanceof') Or ((s = 'in') And Not no_in) Then
            prec := 8;
        End;
      If (prec = 0) Or (prec < min_prec) Then
        Break;
      PAdvance(ctx);
      If s = '**' Then
        right := ParseBinary(ctx, prec, no_in)
      Else
        right := ParseBinary(ctx, prec + 1, no_in);
      is_logical := (s = '&&') Or (s = '||') Or (s = '??');
      If is_logical Then
        node := NewNode(ctx, N_LOGICAL, op_tok)
      Else
        node := NewNode(ctx, N_BINARY, op_tok);
      NodeP(ctx.ast.nodes, node)^.e1 := left;
      NodeP(ctx.ast.nodes, node)^.e2 := right;
      { -a ** b est ambigu et interdit }
      If (s = '**') And (NodeP(ctx.ast.nodes, left)^.kind = N_UNARY) And
         Not NodeP(ctx.ast.nodes, left)^.paren Then
        ParseError(ctx, op_tok, 'operande unaire interdit a gauche de **, ajouter des parentheses');
      { a ?? b || c est interdit sans parentheses }
      If is_logical Then
        Begin
          If (s = '??') Then
            Begin
              If ((NodeP(ctx.ast.nodes, left)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, left)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, left)^.tok)^.text <> '??')) Or
                 ((right <> 0) And (NodeP(ctx.ast.nodes, right)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, right)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, right)^.tok)^.text <> '??')) Then
                ParseError(ctx, op_tok, '?? ne peut pas etre melange avec || ou && sans parentheses');
            End
          Else
            Begin
              If ((NodeP(ctx.ast.nodes, left)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, left)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, left)^.tok)^.text = '??')) Or
                 ((right <> 0) And (NodeP(ctx.ast.nodes, right)^.kind = N_LOGICAL) And
                  Not NodeP(ctx.ast.nodes, right)^.paren And
                  (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, right)^.tok)^.text = '??')) Then
                ParseError(ctx, op_tok, '?? ne peut pas etre melange avec || ou && sans parentheses');
            End;
        End;
      left := node;
      ParseBinary := left;
    End;
End;

Function ParseConditional(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  test, node: LongInt;
Begin
  test := ParseBinary(ctx, 1, no_in);
  ParseConditional := test;
  If (test <> 0) And CurIsP(ctx, '?') Then
    Begin
      node := NewNode(ctx, N_COND, ctx.ast.pt);
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := test;
      NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, False);
      If Expect(ctx, ':') Then
        NodeP(ctx.ast.nodes, node)^.e3 := ParseAssign(ctx, no_in);
      ParseConditional := node;
    End;
End;

Function ParseAssign(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  left, right, node, op_tok: LongInt;
  s: TTokenText;
  is_async: Boolean;
Begin
  If TkIsId(ctx, ctx.ast.pt, 'yield') And CurFuncHas(ctx, True) Then
    Begin
      node := NewNode(ctx, N_UNARY, ctx.ast.pt);
      PAdvance(ctx);
      If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_OPERATOR) And
         (TokP(ctx.lex.tokens, ctx.ast.pt)^.text = '*') Then
        Begin
          NodeP(ctx.ast.nodes, node)^.flags := 1;
          PAdvance(ctx);
        End;
      If StartsExpr(ctx) Or (NodeP(ctx.ast.nodes, node)^.flags = 1) Then
        NodeP(ctx.ast.nodes, node)^.e1 := ParseAssign(ctx, no_in);
      ParseAssign := node;
      Exit;
    End;
  If IsArrowAhead(ctx, is_async) Then
    Begin
      ParseAssign := ParseArrowFn(ctx, is_async, no_in);
      Exit;
    End;
  left := ParseConditional(ctx, no_in);
  ParseAssign := left;
  If left = 0 Then
    Exit;
  op_tok := ctx.ast.pt;
  s := TokP(ctx.lex.tokens, op_tok)^.text;
  If (TokP(ctx.lex.tokens, op_tok)^.kind = TK_OPERATOR) And IsAssignOp(s) Then
    Begin
      If s = '=' Then
        Begin
          If Not IsPatternTarget(ctx, left) Then
            ParseError(ctx, op_tok, 'cible d''affectation invalide');
        End
      Else If Not IsSimpleTarget(ctx, left) Then
        ParseError(ctx, op_tok, 'cible d''affectation invalide pour ' + s);
      PAdvance(ctx);
      right := ParseAssign(ctx, no_in);
      node := NewNode(ctx, N_ASSIGN, op_tok);
      NodeP(ctx.ast.nodes, node)^.e1 := left;
      NodeP(ctx.ast.nodes, node)^.e2 := right;
      ParseAssign := node;
    End;
End;

{ Expression complete, avec virgules (sequence). }
Function ParseExpr(Var ctx: TCompilerContext; no_in: Boolean): LongInt;
Var
  first, last, e, seq: LongInt;
Begin
  e := ParseAssign(ctx, no_in);
  ParseExpr := e;
  If (e <> 0) And CurIsP(ctx, ',') Then
    Begin
      seq := NewNode(ctx, N_SEQUENCE, ctx.ast.pt);
      first := 0;
      last := 0;
      ListAdd(ctx, first, last, e);
      While CurIsP(ctx, ',') Do
        Begin
          PAdvance(ctx);
          e := ParseAssign(ctx, no_in);
          If e = 0 Then
            Break;
          ListAdd(ctx, first, last, e);
        End;
      NodeP(ctx.ast.nodes, seq)^.e1 := first;
      ParseExpr := seq;
    End;
End;

{ ---- Fonctions ---- }

Function ParseStatement(Var ctx: TCompilerContext): LongInt; Forward;
Function ParseBlock(Var ctx: TCompilerContext; new_scope: Boolean): LongInt; Forward;

Function ParseStmtList(Var ctx: TCompilerContext): LongInt;
Var
  first, last, st, before: LongInt;
Begin
  first := 0;
  last := 0;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      st := ParseStatement(ctx);
      ListAdd(ctx, first, last, st);
      If ctx.ast.pt = before Then
        PAdvance(ctx);
      If ctx.errors >= MAX_ERRORS Then
        Break;
    End;
  ParseStmtList := first;
End;

Function ParseParam(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_PARAM, ctx.ast.pt);
  If CurIsP(ctx, '...') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.flags := PF_REST;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := ParseBindingTarget(ctx, DK_PARAM);
  If NodeP(ctx.ast.nodes, node)^.flags <> PF_REST Then
    NodeP(ctx.ast.nodes, node)^.e2 := ParseBindingDefault(ctx);
  ParseParam := node;
End;

{ Liste de parametres : ( a, b = 1, ...c ). Le jeton courant est la
  parenthese ouvrante ; la liste est rangee dans node.e1. }
Procedure ParseParamList(Var ctx: TCompilerContext; node: LongInt);
Var
  first, last, p: LongInt;
Begin
  first := 0;
  last := 0;
  If Expect(ctx, '(') Then
    Begin
      While Not CurIsP(ctx, ')') And Not CurIsEof(ctx) Do
        Begin
          p := ParseParam(ctx);
          If p = 0 Then
            Break;
          ListAdd(ctx, first, last, p);
          If CurIsP(ctx, ',') Then
            PAdvance(ctx)
          Else
            Break;
        End;
      Expect(ctx, ')');
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := first;
End;

{ Corps de fonction entre accolades, dans la portee de la fonction. }
Function ParseFuncBlock(Var ctx: TCompilerContext): LongInt;
Var
  body: LongInt;
Begin
  body := NewNode(ctx, N_BLOCK, ctx.ast.pt);
  NodeP(ctx.ast.nodes, body)^.flags := 1;
  If Expect(ctx, '{') Then
    Begin
      NodeP(ctx.ast.nodes, body)^.e1 := ParseStmtList(ctx);
      Expect(ctx, '}');
    End;
  ParseFuncBlock := body;
End;

{ Parametres puis corps, dans la portee du noeud fonction/methode. Le
  jeton courant est la parenthese ouvrante. }
Procedure ParseFuncRest(Var ctx: TCompilerContext; node: LongInt);
Var
  sv: TFuncSave;
Begin
  EnterFunc(ctx, node, sv);
  ParseParamList(ctx, node);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseFuncBlock(ctx);
  LeaveFunc(ctx, sv);
End;

{ function [*] nom (...) corps. Le jeton courant est function (ou async
  si is_async). }
Function ParseFunctionDecl(Var ctx: TCompilerContext; is_async: Boolean): LongInt;
Var
  node, name_tok: LongInt;
  flags: LongInt;
Begin
  flags := 0;
  If is_async Then
    Begin
      flags := flags Or FN_ASYNC;
      PAdvance(ctx);
    End;
  PAdvance(ctx);
  If CurIsP(ctx, '*') Then
    Begin
      flags := flags Or FN_GENERATOR;
      PAdvance(ctx);
    End;
  If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind <> TK_IDENT Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de fonction attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseFunctionDecl := 0;
      Exit;
    End;
  name_tok := ctx.ast.pt;
  node := NewNode(ctx, N_FUNC_DECL, name_tok);
  NodeP(ctx.ast.nodes, node)^.flags := flags;
  DeclareName(ctx, DK_FUNC, name_tok, node);
  PAdvance(ctx);
  ParseFuncRest(ctx, node);
  ParseFunctionDecl := node;
End;

{ ---- Classes ---- }

Function ParseClassMember(Var ctx: TCompilerContext; has_ctor: Boolean): LongInt;
Var
  node, key_tok, nx, blk: LongInt;
  flags: LongInt;
  is_method: Boolean;

  { Vrai si le jeton suivant est un nom : le jeton courant est alors un
    modificateur (static, async, get, set) et non le nom du membre. }
  Function IsModifier: Boolean;
  Begin
    nx := PeekIdx(ctx, 1);
    IsModifier := Not (TkIsP(ctx, nx, '(') Or TkIsP(ctx, nx, '=') Or
                       TkIsP(ctx, nx, ';') Or TkIsP(ctx, nx, '}')) And
                  (TokP(ctx.lex.tokens, nx)^.kind <> TK_EOF);
  End;

Begin
  ParseClassMember := 0;
  flags := 0;
  If CurIsKw(ctx, 'static') And IsModifier Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_STATIC;
      If CurIsP(ctx, '{') Then
        Begin
          node := NewNode(ctx, N_STATIC_BLOCK, ctx.ast.pt);
          NodeP(ctx.ast.nodes, node)^.flags := MF_STATIC;
          blk := ParseBlock(ctx, True);
          NodeP(ctx.ast.nodes, node)^.e1 := blk;
          ParseClassMember := node;
          Exit;
        End;
    End;
  If TkIsId(ctx, ctx.ast.pt, 'async') And IsModifier And
     Not TokP(ctx.lex.tokens, PeekIdx(ctx, 1))^.nl_before Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_ASYNC;
    End;
  If CurIsP(ctx, '*') Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_GENERATOR;
    End;
  If (TkIsId(ctx, ctx.ast.pt, 'get') Or TkIsId(ctx, ctx.ast.pt, 'set')) And
     IsModifier Then
    Begin
      If TkIsId(ctx, ctx.ast.pt, 'get') Then
        flags := flags Or MF_GETTER
      Else
        flags := flags Or MF_SETTER;
      PAdvance(ctx);
    End;

  key_tok := ctx.ast.pt;
  node := NewNode(ctx, N_METHOD, key_tok);
  If CurIsP(ctx, '[') Then
    Begin
      PAdvance(ctx);
      flags := flags Or MF_COMPUTED;
      NodeP(ctx.ast.nodes, node)^.e3 := ParseAssign(ctx, False);
      Expect(ctx, ']');
    End
  Else If IsPropertyNameTok(ctx, ctx.ast.pt) Then
    PAdvance(ctx)
  Else
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de membre de classe attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseClassMember := 0;
      Exit;
    End;

  is_method := CurIsP(ctx, '(');
  If is_method Then
    Begin
      If (flags And (MF_STATIC Or MF_COMPUTED) = 0) And
         (TokP(ctx.lex.tokens, key_tok)^.text = 'constructor') And
         (TokP(ctx.lex.tokens, key_tok)^.kind <> TK_STRING) Then
        Begin
          flags := flags Or MF_CONSTRUCTOR;
          If has_ctor Then
            ParseError(ctx, key_tok, 'une classe ne peut avoir qu''un seul constructeur');
        End;
      NodeP(ctx.ast.nodes, node)^.flags := flags;
      ParseFuncRest(ctx, node);
    End
  Else
    Begin
      NodeP(ctx.ast.nodes, node)^.kind := N_FIELD;
      NodeP(ctx.ast.nodes, node)^.flags := flags;
      If CurIsP(ctx, '=') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, node)^.e1 := ParseAssign(ctx, False);
        End;
      ConsumeSemi(ctx);
    End;
  ParseClassMember := node;
End;

{ class [Nom] [extends expr] corps. Declaration (nom obligatoire) ou
  expression de classe. }
Function ParseClass(Var ctx: TCompilerContext; is_decl: Boolean): LongInt;
Var
  node, name_tok, first, last, m, before, save_scope: LongInt;
  has_ctor, has_name: Boolean;
Begin
  name_tok := ctx.ast.pt;
  PAdvance(ctx);
  has_name := TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT;
  If is_decl And Not has_name Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'nom de classe attendu, trouve ' +
                 TokenDesc(ctx, ctx.ast.pt));
      Synchronize(ctx);
      ParseClass := 0;
      Exit;
    End;
  If has_name Then
    name_tok := ctx.ast.pt;
  If is_decl Then
    node := NewNode(ctx, N_CLASS_DECL, name_tok)
  Else
    node := NewNode(ctx, N_CLASS_EXPR, name_tok);
  If is_decl Then
    DeclareName(ctx, DK_CLASS, name_tok, node);
  If has_name Then
    PAdvance(ctx);
  { la classe ouvre une portee : le nom d'une expression de classe y vit }
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;
  If has_name And Not is_decl Then
    DeclareName(ctx, DK_FNAME, name_tok, node);
  If CurIsKw(ctx, 'extends') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := ParseLHS(ctx);
    End;
  first := 0;
  last := 0;
  has_ctor := False;
  If Expect(ctx, '{') Then
    Begin
      While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And
            Not ctx.ast.stop Do
        Begin
          If CurIsP(ctx, ';') Then
            PAdvance(ctx)
          Else
            Begin
              before := ctx.ast.pt;
              m := ParseClassMember(ctx, has_ctor);
              If (m <> 0) And (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
                 (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR <> 0) Then
                has_ctor := True;
              ListAdd(ctx, first, last, m);
              If ctx.ast.pt = before Then
                PAdvance(ctx);
              If ctx.errors >= MAX_ERRORS Then
                Break;
            End;
        End;
      Expect(ctx, '}');
    End;
  NodeP(ctx.ast.nodes, node)^.e2 := first;
  ctx.ast.cur_scope := save_scope;
  ParseClass := node;
End;

{ ---- Instructions ---- }

Function ParseBlock(Var ctx: TCompilerContext; new_scope: Boolean): LongInt;
Var
  node, save_scope: LongInt;
Begin
  node := NewNode(ctx, N_BLOCK, ctx.ast.pt);
  ParseBlock := node;
  If Not Expect(ctx, '{') Then
    Exit;
  save_scope := ctx.ast.cur_scope;
  If new_scope Then
    ctx.ast.cur_scope := node;
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStmtList(ctx);
  ctx.ast.cur_scope := save_scope;
  Expect(ctx, '}');
End;

{ Condition entre parentheses : ( expression ) }
Function ParseParenExpr(Var ctx: TCompilerContext): LongInt;
Begin
  ParseParenExpr := 0;
  If Not Expect(ctx, '(') Then
    Exit;
  ParseParenExpr := ParseExpr(ctx, False);
  Expect(ctx, ')');
End;

Function ParseIf(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_IF, ctx.ast.pt);
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseStatement(ctx);
  If CurIsKw(ctx, 'else') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseStatement(ctx);
    End;
  ParseIf := node;
End;

Function ParseWhile(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_WHILE, ctx.ast.pt);
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  Inc(ctx.ast.loop_depth);
  NodeP(ctx.ast.nodes, node)^.e2 := ParseStatement(ctx);
  Dec(ctx.ast.loop_depth);
  ParseWhile := node;
End;

Function ParseDoWhile(Var ctx: TCompilerContext): LongInt;
Var
  node: LongInt;
Begin
  node := NewNode(ctx, N_DO_WHILE, ctx.ast.pt);
  PAdvance(ctx);
  Inc(ctx.ast.loop_depth);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStatement(ctx);
  Dec(ctx.ast.loop_depth);
  If CurIsKw(ctx, 'while') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e2 := ParseParenExpr(ctx);
    End
  Else
    ParseError(ctx, ctx.ast.pt, '"while" attendu, trouve ' +
               TokenDesc(ctx, ctx.ast.pt));
  { le point-virgule apres do-while est toujours facultatif }
  If CurIsP(ctx, ';') Then
    PAdvance(ctx);
  ParseDoWhile := node;
End;

Function ParseFor(Var ctx: TCompilerContext): LongInt;
Var
  node, save_scope, init, test, upd, body: LongInt;
  is_of, is_in: Boolean;
  kind: TNodeKind;
Begin
  node := NewNode(ctx, N_FOR, ctx.ast.pt);
  ParseFor := node;
  PAdvance(ctx);
  If TkIsId(ctx, ctx.ast.pt, 'await') Then
    Begin
      ParseError(ctx, ctx.ast.pt, 'for await n''est pas supporte');
      Synchronize(ctx);
      Exit;
    End;
  If Not Expect(ctx, '(') Then
    Begin
      Synchronize(ctx);
      Exit;
    End;
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;

  init := 0;
  If CurIsP(ctx, ';') Then
    { pas d'initialisation }
  Else If CurIsKw(ctx, 'var') Or CurIsKw(ctx, 'let') Or CurIsKw(ctx, 'const') Then
    init := ParseVarDecl(ctx, True)
  Else
    init := ParseExpr(ctx, True);

  is_in := CurIsKw(ctx, 'in');
  is_of := TkIsId(ctx, ctx.ast.pt, 'of');
  If (is_in Or is_of) And (init <> 0) Then
    Begin
      If NodeP(ctx.ast.nodes, init)^.kind = N_VAR_DECL Then
        Begin
          If (NodeP(ctx.ast.nodes, init)^.e1 = 0) Or
             (NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, init)^.e1)^.next <> 0) Then
            ParseError(ctx, ctx.ast.pt,
                       'une seule variable est permise dans for-in / for-of')
          Else If NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, init)^.e1)^.e2 <> 0 Then
            ParseError(ctx, ctx.ast.pt,
                       'initialiseur interdit dans for-in / for-of');
        End;
      If is_of Then
        kind := N_FOR_OF
      Else
        kind := N_FOR_IN;
      NodeP(ctx.ast.nodes, node)^.kind := kind;
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e1 := init;
      If is_in Then
        NodeP(ctx.ast.nodes, node)^.e2 := ParseExpr(ctx, False)
      Else
        NodeP(ctx.ast.nodes, node)^.e2 := ParseAssign(ctx, False);
      Expect(ctx, ')');
      Inc(ctx.ast.loop_depth);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseStatement(ctx);
      Dec(ctx.ast.loop_depth);
    End
  Else
    Begin
      NodeP(ctx.ast.nodes, node)^.e1 := init;
      If Expect(ctx, ';') Then
        Begin
          test := 0;
          If Not CurIsP(ctx, ';') Then
            test := ParseExpr(ctx, False);
          NodeP(ctx.ast.nodes, node)^.e2 := test;
          If Expect(ctx, ';') Then
            Begin
              upd := 0;
              If Not CurIsP(ctx, ')') Then
                upd := ParseExpr(ctx, False);
              NodeP(ctx.ast.nodes, node)^.e3 := upd;
              If Expect(ctx, ')') Then
                Begin
                  Inc(ctx.ast.loop_depth);
                  body := ParseStatement(ctx);
                  Dec(ctx.ast.loop_depth);
                  NodeP(ctx.ast.nodes, node)^.e4 := body;
                End;
            End;
        End;
    End;
  ctx.ast.cur_scope := save_scope;
End;

Function ParseSwitch(Var ctx: TCompilerContext): LongInt;
Var
  node, save_scope, cs, first, last, sfirst, slast, st, before: LongInt;
  has_default: Boolean;
Begin
  node := NewNode(ctx, N_SWITCH, ctx.ast.pt);
  ParseSwitch := node;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseParenExpr(ctx);
  If Not Expect(ctx, '{') Then
    Begin
      Synchronize(ctx);
      Exit;
    End;
  save_scope := ctx.ast.cur_scope;
  ctx.ast.cur_scope := node;
  Inc(ctx.ast.switch_depth);
  first := 0;
  last := 0;
  has_default := False;
  While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      If CurIsKw(ctx, 'case') Or CurIsKw(ctx, 'default') Then
        Begin
          cs := NewNode(ctx, N_CASE, ctx.ast.pt);
          If CurIsKw(ctx, 'case') Then
            Begin
              PAdvance(ctx);
              NodeP(ctx.ast.nodes, cs)^.e1 := ParseExpr(ctx, False);
            End
          Else
            Begin
              If has_default Then
                ParseError(ctx, ctx.ast.pt, '"default" en double dans le switch');
              has_default := True;
              PAdvance(ctx);
            End;
          Expect(ctx, ':');
          sfirst := 0;
          slast := 0;
          While Not CurIsP(ctx, '}') And Not CurIsEof(ctx) And
                Not CurIsKw(ctx, 'case') And Not CurIsKw(ctx, 'default') And
                Not ctx.ast.stop Do
            Begin
              before := ctx.ast.pt;
              st := ParseStatement(ctx);
              ListAdd(ctx, sfirst, slast, st);
              If ctx.ast.pt = before Then
                PAdvance(ctx);
              If ctx.errors >= MAX_ERRORS Then
                Break;
            End;
          NodeP(ctx.ast.nodes, cs)^.e2 := sfirst;
          ListAdd(ctx, first, last, cs);
        End
      Else
        Begin
          ParseError(ctx, ctx.ast.pt, '"case" ou "default" attendu, trouve ' +
                     TokenDesc(ctx, ctx.ast.pt));
          Synchronize(ctx);
          If ctx.ast.pt = before Then
            PAdvance(ctx);
        End;
      If ctx.errors >= MAX_ERRORS Then
        Break;
    End;
  NodeP(ctx.ast.nodes, node)^.e2 := first;
  Expect(ctx, '}');
  Dec(ctx.ast.switch_depth);
  ctx.ast.cur_scope := save_scope;
End;

Function ParseTry(Var ctx: TCompilerContext): LongInt;
Var
  node, cn, save_scope: LongInt;
Begin
  node := NewNode(ctx, N_TRY, ctx.ast.pt);
  ParseTry := node;
  PAdvance(ctx);
  NodeP(ctx.ast.nodes, node)^.e1 := ParseBlock(ctx, True);
  If CurIsKw(ctx, 'catch') Then
    Begin
      cn := NewNode(ctx, N_CATCH, ctx.ast.pt);
      PAdvance(ctx);
      save_scope := ctx.ast.cur_scope;
      ctx.ast.cur_scope := cn;
      If CurIsP(ctx, '(') Then
        Begin
          PAdvance(ctx);
          NodeP(ctx.ast.nodes, cn)^.e1 := ParseBindingTarget(ctx, DK_CATCH);
          Expect(ctx, ')');
        End;
      NodeP(ctx.ast.nodes, cn)^.e2 := ParseBlock(ctx, False);
      ctx.ast.cur_scope := save_scope;
      NodeP(ctx.ast.nodes, node)^.e2 := cn;
    End;
  If CurIsKw(ctx, 'finally') Then
    Begin
      PAdvance(ctx);
      NodeP(ctx.ast.nodes, node)^.e3 := ParseBlock(ctx, True);
    End;
  If (NodeP(ctx.ast.nodes, node)^.e2 = 0) And (NodeP(ctx.ast.nodes, node)^.e3 = 0) Then
    ParseError(ctx, NodeP(ctx.ast.nodes, node)^.tok,
               'try exige un bloc catch ou finally');
End;

Function FindLabel(Var ctx: TCompilerContext; tok: LongInt): LongInt;
Var
  i: LongInt;
Begin
  FindLabel := 0;
  For i := 1 To ctx.ast.label_count Do
    If TokP(ctx.lex.tokens, LabelRecP(ctx.ast.labels, i)^.tok)^.text = TokP(ctx.lex.tokens, tok)^.text Then
      FindLabel := i;
End;

Function ParseBreakContinue(Var ctx: TCompilerContext; is_break: Boolean): LongInt;
Var
  node, lbl, kw_tok: LongInt;
Begin
  kw_tok := ctx.ast.pt;
  If is_break Then
    node := NewNode(ctx, N_BREAK, kw_tok)
  Else
    node := NewNode(ctx, N_CONTINUE, kw_tok);
  PAdvance(ctx);
  If (TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT) And
     Not TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    Begin
      NodeP(ctx.ast.nodes, node)^.e1 := ctx.ast.pt;
      lbl := FindLabel(ctx, ctx.ast.pt);
      If lbl = 0 Then
        ParseError(ctx, ctx.ast.pt, 'etiquette inconnue: ' +
                   TokP(ctx.lex.tokens, ctx.ast.pt)^.text)
      Else If (Not is_break) And (Not LabelRecP(ctx.ast.labels, lbl)^.is_loop) Then
        ParseError(ctx, ctx.ast.pt, 'continue exige une etiquette de boucle: ' +
                   TokP(ctx.lex.tokens, ctx.ast.pt)^.text);
      PAdvance(ctx);
    End
  Else If is_break Then
    Begin
      If ctx.ast.loop_depth + ctx.ast.switch_depth = 0 Then
        ParseError(ctx, kw_tok, 'break en dehors d''une boucle ou d''un switch');
    End
  Else If ctx.ast.loop_depth = 0 Then
    ParseError(ctx, kw_tok, 'continue en dehors d''une boucle');
  ConsumeSemi(ctx);
  ParseBreakContinue := node;
End;

Function ParseReturnThrow(Var ctx: TCompilerContext; is_return: Boolean): LongInt;
Var
  node, kw_tok: LongInt;
Begin
  kw_tok := ctx.ast.pt;
  If is_return Then
    Begin
      node := NewNode(ctx, N_RETURN, kw_tok);
      If ctx.ast.func_depth = 0 Then
        ParseError(ctx, kw_tok, 'return en dehors d''une fonction');
    End
  Else
    node := NewNode(ctx, N_THROW, kw_tok);
  PAdvance(ctx);
  If CurIsP(ctx, ';') Or CurIsP(ctx, '}') Or CurIsEof(ctx) Or
     TokP(ctx.lex.tokens, ctx.ast.pt)^.nl_before Then
    Begin
      If Not is_return Then
        ParseError(ctx, ctx.ast.pt, 'expression attendue apres throw');
    End
  Else
    NodeP(ctx.ast.nodes, node)^.e1 := ParseExpr(ctx, False);
  ConsumeSemi(ctx);
  ParseReturnThrow := node;
End;

Function ParseLabeled(Var ctx: TCompilerContext): LongInt;
Var
  node, lbl_tok: LongInt;
Begin
  lbl_tok := ctx.ast.pt;
  node := NewNode(ctx, N_LABELED, lbl_tok);
  ParseLabeled := node;
  If FindLabel(ctx, lbl_tok) <> 0 Then
    ParseError(ctx, lbl_tok, 'etiquette en double: ' +
               TokP(ctx.lex.tokens, lbl_tok)^.text);
  PAdvance(ctx);
  PAdvance(ctx);
  Inc(ctx.ast.label_count);
  LabelRecP(ctx.ast.labels, ctx.ast.label_count)^.tok := lbl_tok;
  LabelRecP(ctx.ast.labels, ctx.ast.label_count)^.is_loop :=
    CurIsKw(ctx, 'for') Or CurIsKw(ctx, 'while') Or CurIsKw(ctx, 'do');
  NodeP(ctx.ast.nodes, node)^.e1 := ParseStatement(ctx);
  Dec(ctx.ast.label_count);
End;

Function ParseExprStatement(Var ctx: TCompilerContext): LongInt;
Var
  node, ex: LongInt;
Begin
  node := NewNode(ctx, N_EXPR_STMT, ctx.ast.pt);
  ex := ParseExpr(ctx, False);
  If ex = 0 Then
    Begin
      Synchronize(ctx);
      ParseExprStatement := 0;
      Exit;
    End;
  NodeP(ctx.ast.nodes, node)^.e1 := ex;
  ConsumeSemi(ctx);
  ParseExprStatement := node;
End;

Function ParseStatement(Var ctx: TCompilerContext): LongInt;
Var
  node, nx: LongInt;
  s: TTokenText;
Begin
  ParseStatement := 0;
  s := TokP(ctx.lex.tokens, ctx.ast.pt)^.text;
  If CurIsP(ctx, '{') Then
    ParseStatement := ParseBlock(ctx, True)
  Else If CurIsP(ctx, ';') Then
    Begin
      ParseStatement := NewNode(ctx, N_EMPTY, ctx.ast.pt);
      PAdvance(ctx);
    End
  Else If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_KEYWORD Then
    Begin
      If (s = 'var') Or (s = 'let') Or (s = 'const') Then
        Begin
          node := ParseVarDecl(ctx, False);
          ConsumeSemi(ctx);
          ParseStatement := node;
        End
      Else If s = 'if' Then
        ParseStatement := ParseIf(ctx)
      Else If s = 'for' Then
        ParseStatement := ParseFor(ctx)
      Else If s = 'while' Then
        ParseStatement := ParseWhile(ctx)
      Else If s = 'do' Then
        ParseStatement := ParseDoWhile(ctx)
      Else If s = 'switch' Then
        ParseStatement := ParseSwitch(ctx)
      Else If s = 'break' Then
        ParseStatement := ParseBreakContinue(ctx, True)
      Else If s = 'continue' Then
        ParseStatement := ParseBreakContinue(ctx, False)
      Else If s = 'return' Then
        ParseStatement := ParseReturnThrow(ctx, True)
      Else If s = 'throw' Then
        ParseStatement := ParseReturnThrow(ctx, False)
      Else If s = 'try' Then
        ParseStatement := ParseTry(ctx)
      Else If s = 'function' Then
        ParseStatement := ParseFunctionDecl(ctx, False)
      Else If s = 'class' Then
        ParseStatement := ParseClass(ctx, True)
      Else If s = 'debugger' Then
        Begin
          node := NewNode(ctx, N_DEBUGGER, ctx.ast.pt);
          PAdvance(ctx);
          ConsumeSemi(ctx);
          ParseStatement := node;
        End
      Else If (s = 'with') Or (s = 'import') Or (s = 'export') Or
              (s = 'enum') Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"' + s + '" n''est pas supporte');
          Synchronize(ctx);
        End
      Else If (s = 'else') Or (s = 'case') Or (s = 'default') Or
              (s = 'catch') Or (s = 'finally') Then
        Begin
          ParseError(ctx, ctx.ast.pt, '"' + s + '" inattendu');
          Synchronize(ctx);
        End
      Else
        ParseStatement := ParseExprStatement(ctx);
    End
  Else If TokP(ctx.lex.tokens, ctx.ast.pt)^.kind = TK_IDENT Then
    Begin
      nx := PeekIdx(ctx, 1);
      If TkIsP(ctx, nx, ':') Then
        ParseStatement := ParseLabeled(ctx)
      Else If (s = 'async') And TkIsKw(ctx, nx, 'function') And
              Not TokP(ctx.lex.tokens, nx)^.nl_before Then
        ParseStatement := ParseFunctionDecl(ctx, True)
      Else
        ParseStatement := ParseExprStatement(ctx);
    End
  Else If CurIsP(ctx, '}') Then
    Begin
      ParseError(ctx, ctx.ast.pt, '"}" inattendu');
      PAdvance(ctx);
    End
  Else
    ParseStatement := ParseExprStatement(ctx);
End;

Function ParseProgram(Var ctx: TCompilerContext): Boolean;
Var
  first, last, st, before: LongInt;
Begin
  ParseProgram := False;
  If ctx.lex.token_count = 0 Then
    Begin
      PipelineError(ctx, 'jetons absents avant l''analyse syntaxique');
      Exit;
    End;
  ctx.ast.node_count := 0;
  ctx.ast.decl_count := 0;
  ctx.ast.analyzed := False;
  ctx.ast.pt := 1;
  ctx.ast.stop := False;
  ctx.ast.last_err_tok := 0;
  ctx.ast.loop_depth := 0;
  ctx.ast.switch_depth := 0;
  ctx.ast.func_depth := 0;
  ctx.ast.label_count := 0;
  ctx.ast.root := NewNode(ctx, N_PROGRAM, 1);
  ctx.ast.cur_scope := ctx.ast.root;
  ctx.ast.cur_func := ctx.ast.root;
  first := 0;
  last := 0;
  While Not CurIsEof(ctx) And Not ctx.ast.stop Do
    Begin
      before := ctx.ast.pt;
      st := ParseStatement(ctx);
      ListAdd(ctx, first, last, st);
      If ctx.ast.pt = before Then
        PAdvance(ctx);
      If ctx.errors >= MAX_ERRORS Then
        Begin
          PipelineError(ctx, 'trop d''erreurs, arret du parseur');
          Break;
        End;
    End;
  NodeP(ctx.ast.nodes, ctx.ast.root)^.e1 := first;
  If ctx.options.verbose Then
    Writeln('AST    : ', ctx.ast.node_count, ' noeuds, ',
            ctx.ast.decl_count, ' declarations');
  ParseProgram := ctx.errors = 0;
End;

