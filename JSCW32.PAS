Procedure LoadTag(Var ctx: TCompilerContext; lo: LongInt; tag: LongInt);
Begin
  If lo = 0 Then
    Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX))
  Else
    Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(lo));
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(tag)));
End;

Procedure LoadDouble(Var ctx: TCompilerContext; id: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, DblP(ctx.data.dbls, id)^.sym, 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, DblP(ctx.data.dbls, id)^.sym, 4));
End;

Procedure LoadStringConst(Var ctx: TCompilerContext; id: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), AddrSym(SYMK_D, StrP(ctx.data.strs, id)^.sym));
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_STRING)));
End;

Procedure GenThis(Var ctx: TCompilerContext; n: LongInt);
Begin
  If NodeP(ctx.ast.nodes, n)^.aux = TB_GLOBAL Then
    CallRt(ctx, 'global_this', 0)
  Else If NodeP(ctx.ast.nodes, n)^.e1 = 1 Then
    Begin
      { fleche : this lexical memorise dans la closure }
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
    End
  Else
    Begin
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
    End;
End;

Procedure GenIdent(Var ctx: TCompilerContext; n: LongInt);
Var
  name: TTokenText;
  xs: LongInt;
Begin
  name := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  Case NodeP(ctx.ast.nodes, n)^.aux Of
    RK_LOCAL, RK_OUTER, RK_GLOBAL_IMPLICIT:
      LoadSym(ctx, NodeP(ctx.ast.nodes, n)^.sym);
    RK_BUILTIN:
      Begin
        If name = 'undefined' Then
          LoadUndefined(ctx)
        Else If name = 'NaN' Then
          LoadDouble(ctx, STD_DBL_NAN)
        Else If name = 'Infinity' Then
          LoadDouble(ctx, STD_DBL_INF)
        Else
          Begin
            { objet global fourni par le runtime }
            xs := XSym(ctx, SymRt('g_' + name));
            Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_X, xs, 0));
            Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_X, xs, 4));
          End;
      End;
    RK_UNDECLARED_OK:
      LoadUndefined(ctx);
    RK_ARGUMENTS:
      Begin
        If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot <> 0 Then
          Begin
            Emit(ctx, OP_MOV, RegOp(R_EAX),
                 MemReg(R_EBP, SlotDisp(ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot)));
            Emit(ctx, OP_MOV, RegOp(R_EDX),
                 MemReg(R_EBP, SlotDisp(ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.args_slot) + 4));
          End
        Else
          PendingExpr(ctx, n);
      End;
  Else
    PendingExpr(ctx, n);
  End;
End;

Procedure PushTemp(Var ctx: TCompilerContext; slot: LongInt); Forward;

{ ---- Expressions (TODO 10) ----

  Strategie : une operation arithmetique, bit a bit ou relationnelle
  dont les deux operandes sont des int32 s'execute en ligne (add, sub,
  imul avec test de depassement, idiv, decalages, cmp). Dans tous les
  autres cas (double, chaine, objet, depassement, -0) le code appelle
  la routine du runtime de meme nom : _JSRT_add, _JSRT_sub, _JSRT_div,
  _JSRT_pow, _JSRT_lt, _JSRT_eq... qui appliquent ToPrimitive,
  ToNumber et ToString. Le runtime calcule en double avec le FPU
  (division par zero = Infinity ou NaN).

  Operande gauche : rangee dans un temporaire de la trame pendant que
  l'operande droit est evalue (la droite arrive dans EDX:EAX). Les
  routines du runtime recoivent (gauche, droite) en cdecl.

  Les expressions entierement constantes sont repliees a la
  compilation quand le resultat est un int32, un booleen, null ou
  undefined ; sinon le code ordinaire est genere. }

Function TempAcquire(Var ctx: TCompilerContext): LongInt;
Begin
  If ctx.ir.tmp_free_count > 0 Then
    Begin
      TempAcquire := TmpFreeP(ctx.ir.tmp_free, ctx.ir.tmp_free_count)^;
      Dec(ctx.ir.tmp_free_count);
    End
  Else
    TempAcquire := AllocTemp(ctx);
End;

Procedure TempRelease(Var ctx: TCompilerContext; t: LongInt);
Begin
  Inc(ctx.ir.tmp_free_count);
  TmpFreeP(ctx.ir.tmp_free, ctx.ir.tmp_free_count)^ := t;
End;

Procedure SaveTemp(Var ctx: TCompilerContext; t: LongInt);
Begin
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t)), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t) + 4), RegOp(R_EDX));
End;

Procedure LoadTemp(Var ctx: TCompilerContext; t: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, SlotDisp(t)));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, SlotDisp(t) + 4));
End;

Function TempLo(t: LongInt): TOperand;
Begin
  TempLo := MemReg(R_EBP, SlotDisp(t));
End;

Function TempHi(t: LongInt): TOperand;
Begin
  TempHi := MemReg(R_EBP, SlotDisp(t) + 4);
End;

{ EAX := 0 ou 1 selon la verite de EDX:EAX (ToBoolean). }
Procedure GenTruthy(Var ctx: TCompilerContext);
Var
  num, fls, done: LongInt;
Begin
  num := NewLabel(ctx);
  fls := NewLabel(ctx);
  done := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JE, LabelOp(num));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_BOOLEAN)));
  Emit1(ctx, OP_JE, LabelOp(num));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'truthy', 8);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, num);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(fls));
  Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(1));
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, fls);
  Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX));
  PlaceLabel(ctx, done);
End;

{ EAX = 0/1 vers un booleen JavaScript dans EDX:EAX. }
Procedure BoolFromEax(Var ctx: TCompilerContext);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_BOOLEAN)));
End;

{ Appel d'une routine binaire (gauche = temporaire t, droite = EDX:EAX). }
Procedure CallBinary(Var ctx: TCompilerContext; Const name: TString; t: LongInt);
Begin
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  PushTemp(ctx, t);
  CallRt(ctx, name, 16);
End;

{ Saute vers slow si l'un des deux operandes (gauche en t, droite dans
  EDX) n'est pas un int32. }
Procedure CheckBothInt(Var ctx: TCompilerContext; t, slow: LongInt);
Begin
  Emit(ctx, OP_CMP, TempHi(t), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
End;

{ Operation binaire op : gauche dans le temporaire t, droite dans
  EDX:EAX. Resultat dans EDX:EAX. t n'est pas libere. }
Procedure GenBinaryCore(Var ctx: TCompilerContext; Const op: TTokenText; t: LongInt);
Var
  slow, done, okm, slowr, lb: LongInt;
  opc, jcc: TOpc;
  rt: TString;
  flip, is_shift, is_bit, is_cmp: Boolean;
Begin
  slow := NewLabel(ctx);
  done := NewLabel(ctx);
  rt := '';
  flip := False;
  is_shift := False;
  is_bit := False;
  is_cmp := False;
  opc := OP_NONE;
  jcc := OP_NONE;
  If op = '+' Then
    Begin
      rt := 'add';
      opc := OP_ADD;
    End
  Else If op = '-' Then
    Begin
      rt := 'sub';
      opc := OP_SUB;
    End
  Else If op = '*' Then
    rt := 'mul'
  Else If op = '/' Then
    rt := 'div'
  Else If op = '%' Then
    rt := 'mod'
  Else If op = '**' Then
    rt := 'pow'
  Else If op = '&' Then
    Begin
      rt := 'band';
      opc := OP_AND;
      is_bit := True;
    End
  Else If op = '|' Then
    Begin
      rt := 'bor';
      opc := OP_OR;
      is_bit := True;
    End
  Else If op = '^' Then
    Begin
      rt := 'bxor';
      opc := OP_XOR;
      is_bit := True;
    End
  Else If op = '<<' Then
    Begin
      rt := 'shl';
      opc := OP_SHL;
      is_shift := True;
    End
  Else If op = '>>' Then
    Begin
      rt := 'sar';
      opc := OP_SAR;
      is_shift := True;
    End
  Else If op = '>>>' Then
    Begin
      rt := 'shr';
      opc := OP_SHR;
      is_shift := True;
    End
  Else If op = '<' Then
    Begin
      rt := 'lt';
      jcc := OP_JL;
      is_cmp := True;
    End
  Else If op = '<=' Then
    Begin
      rt := 'le';
      jcc := OP_JLE;
      is_cmp := True;
    End
  Else If op = '>' Then
    Begin
      rt := 'gt';
      jcc := OP_JG;
      is_cmp := True;
    End
  Else If op = '>=' Then
    Begin
      rt := 'ge';
      jcc := OP_JGE;
      is_cmp := True;
    End
  Else If op = '==' Then
    Begin
      rt := 'eq';
      jcc := OP_JE;
      is_cmp := True;
    End
  Else If op = '!=' Then
    Begin
      rt := 'eq';
      jcc := OP_JNE;
      is_cmp := True;
      flip := True;
    End
  Else If op = '===' Then
    Begin
      rt := 'seq';
      jcc := OP_JE;
      is_cmp := True;
    End
  Else If op = '!==' Then
    Begin
      rt := 'seq';
      jcc := OP_JNE;
      is_cmp := True;
      flip := True;
    End
  Else If op = 'instanceof' Then
    rt := 'instanceof'
  Else If op = 'in' Then
    rt := 'in'
  Else
    Begin
      PipelineError(ctx, 'operateur binaire inconnu: ' + op);
      Exit;
    End;

  If (opc = OP_ADD) Or (opc = OP_SUB) Then
    Begin
      { int32 avec test de depassement }
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, opc, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JO, LabelOp(slow));
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If op = '*' Then
    Begin
      okm := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_IMUL, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JO, LabelOp(slow));
      Emit(ctx, OP_TEST, RegOp(R_ECX), RegOp(R_ECX));
      Emit1(ctx, OP_JNE, LabelOp(okm));
      { resultat 0 : -0 si un operande est negatif }
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_OR, RegOp(R_ECX), RegOp(R_EAX));
      Emit1(ctx, OP_JS, LabelOp(slow));
      Emit(ctx, OP_XOR, RegOp(R_ECX), RegOp(R_ECX));
      PlaceLabel(ctx, okm);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If op = '%' Then
    Begin
      okm := NewLabel(ctx);
      slowr := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_TEST, RegOp(R_ECX), RegOp(R_ECX));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit(ctx, OP_CMP, RegOp(R_ECX), ImmOp(-1));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(t));
      Emit0(ctx, OP_CDQ);
      Emit1(ctx, OP_IDIV, RegOp(R_ECX));
      Emit(ctx, OP_TEST, RegOp(R_EDX), RegOp(R_EDX));
      Emit1(ctx, OP_JNE, LabelOp(okm));
      { reste 0 : -0 si le dividende est negatif }
      Emit(ctx, OP_CMP, TempLo(t), ImmOp(0));
      Emit1(ctx, OP_JL, LabelOp(slowr));
      PlaceLabel(ctx, okm);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_EDX));
      Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, slowr);
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
    End
  Else If is_bit Then
    Begin
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, opc, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If is_shift Then
    Begin
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(t));
      Emit(ctx, opc, RegOp(R_EAX), RegOp(R_CL));
      If op = '>>>' Then
        Begin
          { hors int32 si le bit de signe est positionne : repli }
          slowr := NewLabel(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          Emit1(ctx, OP_JS, LabelOp(slowr));
          Emit1(ctx, OP_JMP, LabelOp(done));
          PlaceLabel(ctx, slowr);
          Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
          Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
        End
      Else
        Emit1(ctx, OP_JMP, LabelOp(done));
    End
  Else If is_cmp Then
    Begin
      lb := NewLabel(ctx);
      CheckBothInt(ctx, t, slow);
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
      Emit(ctx, OP_CMP, RegOp(R_ECX), RegOp(R_EAX));
      Emit(ctx, OP_MOV, RegOp(R_EAX), ImmOp(1));
      Emit1(ctx, jcc, LabelOp(lb));
      Emit(ctx, OP_XOR, RegOp(R_EAX), RegOp(R_EAX));
      PlaceLabel(ctx, lb);
      BoolFromEax(ctx);
      Emit1(ctx, OP_JMP, LabelOp(done));
    End
  ;

  PlaceLabel(ctx, slow);
  If (rt <> 'instanceof') And (rt <> 'in') Then
    CallBinary(ctx, 'bw_' + rt, t)
  Else
    CallBinary(ctx, rt, t);
  If flip Then
    Begin
      Emit(ctx, OP_XOR, RegOp(R_EAX), ImmOp(1));
      BoolFromEax(ctx);
    End;
  PlaceLabel(ctx, done);
End;

{ ---- Repli de constantes ---- }

Function ToInt32Of(v: Double): LongInt;
Var
  w: Int64;
Begin
  If (v <> v) Or (v > 1.9E25) Or (v < -1.9E25) Then
    ToInt32Of := 0
  Else
    Begin
      v := Int(v);
      v := v - 4294967296.0 * Int(v / 4294967296.0);
      w := Trunc(v);
      ToInt32Of := ToLong(w);
    End;
End;

Function IsNegZero(v: Double): Boolean;
Var
  w: Array[0..1] Of LongInt;
Begin
  Move(v, w, 8);
  IsNegZero := (v = 0) And (w[1] < 0);
End;

Function ConstTruthy(Var c: TConst): Boolean;
Begin
  Case c.k Of
    CK_NUM:  ConstTruthy := (c.n <> 0) And (c.n = c.n);
    CK_BOOL: ConstTruthy := c.b;
  Else
    ConstTruthy := False;
  End;
End;

Function EvalConst(Var ctx: TCompilerContext; n: LongInt; Var c: TConst): Boolean;
Var
  a, b: TConst;
  s: TTokenText;
  x, y: Double;
  ix, iy: Int64;
  r: Boolean;
Begin
  EvalConst := False;
  c.k := CK_NONE;
  If n = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_NUMBER:
      Begin
        c.k := CK_NUM;
        c.n := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.num_val;
        EvalConst := True;
      End;
    N_BOOL:
      Begin
        c.k := CK_BOOL;
        c.b := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'true';
        EvalConst := True;
      End;
    N_NULL:
      Begin
        c.k := CK_NULL;
        EvalConst := True;
      End;
    N_IDENT:
      If (NodeP(ctx.ast.nodes, n)^.aux = RK_BUILTIN) And
         (TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'undefined') Then
        Begin
          c.k := CK_UNDEF;
          EvalConst := True;
        End;
    N_UNARY:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If s = '!' Then
          Begin
            c.k := CK_BOOL;
            c.b := Not ConstTruthy(a);
            EvalConst := True;
          End
        Else If s = 'void' Then
          Begin
            c.k := CK_UNDEF;
            EvalConst := True;
          End
        Else If a.k = CK_NUM Then
          Begin
            If s = '-' Then
              Begin
                c.k := CK_NUM;
                c.n := -a.n;
                EvalConst := True;
              End
            Else If s = '+' Then
              Begin
                c := a;
                EvalConst := True;
              End
            Else If s = '~' Then
              Begin
                c.k := CK_NUM;
                c.n := Not ToInt32Of(a.n);
                EvalConst := True;
              End;
          End;
      End;
    N_BINARY:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not (EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) And
                EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, b)) Then
          Exit;
        If (a.k <> CK_NUM) Or (b.k <> CK_NUM) Then
          Exit;
        x := a.n;
        y := b.n;
        If (x <> x) Or (y <> y) Or (Abs(x) > 9.0E15) Or (Abs(y) > 9.0E15) Then
          Exit;
        c.k := CK_NUM;
        r := True;
        If s = '+' Then
          c.n := x + y
        Else If s = '-' Then
          c.n := x - y
        Else If s = '*' Then
          c.n := x * y
        Else If s = '/' Then
          Begin
            If y = 0 Then
              r := False
            Else
              c.n := x / y;
          End
        Else If s = '%' Then
          Begin
            ix := Trunc(x);
            iy := Trunc(y);
            If (ix <> x) Or (iy <> y) Or (iy = 0) Or (ix < 0) Then
              r := False
            Else
              c.n := ix Mod iy;
          End
        Else If s = '**' Then
          Begin
            If (y < 0) Or (y > 62) Or (Int(y) <> y) Or (Int(x) <> x) Or
               (Abs(x) > 65536) Then
              r := False
            Else
              Begin
                c.n := 1;
                ix := Trunc(y);
                While ix > 0 Do
                  Begin
                    c.n := c.n * x;
                    Dec(ix);
                  End;
              End;
          End
        Else If s = '&' Then
          c.n := ToInt32Of(x) And ToInt32Of(y)
        Else If s = '|' Then
          c.n := ToInt32Of(x) Or ToInt32Of(y)
        Else If s = '^' Then
          c.n := ToInt32Of(x) Xor ToInt32Of(y)
        Else If s = '<<' Then
          c.n := ToInt32Of(ToInt32Of(x) Shl (ToInt32Of(y) And 31))
        Else If s = '>>' Then
          Begin
            ix := ToInt32Of(x);
            If ix >= 0 Then
              c.n := ix Shr (ToInt32Of(y) And 31)
            Else
              c.n := Not ((Not ix) Shr (ToInt32Of(y) And 31));
          End
        Else If s = '>>>' Then
          c.n := (Int64(ToInt32Of(x)) And $FFFFFFFF) Shr (ToInt32Of(y) And 31)
        Else If s = '<' Then
          Begin
            c.k := CK_BOOL;
            c.b := x < y;
          End
        Else If s = '<=' Then
          Begin
            c.k := CK_BOOL;
            c.b := x <= y;
          End
        Else If s = '>' Then
          Begin
            c.k := CK_BOOL;
            c.b := x > y;
          End
        Else If s = '>=' Then
          Begin
            c.k := CK_BOOL;
            c.b := x >= y;
          End
        Else If (s = '==') Or (s = '===') Then
          Begin
            c.k := CK_BOOL;
            c.b := x = y;
          End
        Else If (s = '!=') Or (s = '!==') Then
          Begin
            c.k := CK_BOOL;
            c.b := x <> y;
          End
        Else
          r := False;
        EvalConst := r;
      End;
    N_LOGICAL:
      Begin
        s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If s = '&&' Then
          Begin
            If ConstTruthy(a) Then
              EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
            Else
              Begin
                c := a;
                EvalConst := True;
              End;
          End
        Else If s = '||' Then
          Begin
            If ConstTruthy(a) Then
              Begin
                c := a;
                EvalConst := True;
              End
            Else
              EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c);
          End
        Else If (a.k = CK_NULL) Or (a.k = CK_UNDEF) Then
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
        Else
          Begin
            c := a;
            EvalConst := True;
          End;
      End;
    N_COND:
      Begin
        If Not EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e1, a) Then
          Exit;
        If ConstTruthy(a) Then
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e2, c)
        Else
          EvalConst := EvalConst(ctx, NodeP(ctx.ast.nodes, n)^.e3, c);
      End;
  End;
End;

{ Emet la constante si le programme l'exprime sans nouvelle donnee
  statique : int32 (hors -0), booleen, null ou undefined. }
Function TryFold(Var ctx: TCompilerContext; n: LongInt): Boolean;
Var
  c: TConst;
Begin
  TryFold := False;
  If Not EvalConst(ctx, n, c) Then
    Exit;
  Case c.k Of
    CK_NUM:
      Begin
        If (c.n <> c.n) Or (Int(c.n) <> c.n) Or (c.n < -2147483648.0) Or
           (c.n > 2147483647.0) Or IsNegZero(c.n) Then
          Exit;
        LoadTag(ctx, Trunc(c.n), RT_T_INT32);
      End;
    CK_BOOL:
      Begin
        If c.b Then
          LoadTag(ctx, 1, RT_T_BOOLEAN)
        Else
          LoadTag(ctx, 0, RT_T_BOOLEAN);
      End;
    CK_NULL:
      LoadTag(ctx, 0, RT_T_NULL);
    CK_UNDEF:
      LoadUndefined(ctx);
  Else
    Exit;
  End;
  TryFold := True;
End;

{ ---- Operateurs ---- }

Procedure GenBinary(Var ctx: TCompilerContext; n: LongInt);
Var
  t: LongInt;
Begin
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  t := TempAcquire(ctx);
  SaveTemp(ctx, t);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  GenBinaryCore(ctx, TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text, t);
  TempRelease(ctx, t);
End;

{ && || ?? avec court-circuit : le resultat est l'un des operandes. }
Procedure GenLogical(Var ctx: TCompilerContext; n: LongInt);
Var
  t, short, done, evalr: LongInt;
  op: TTokenText;
Begin
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  t := TempAcquire(ctx);
  short := NewLabel(ctx);
  done := NewLabel(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  SaveTemp(ctx, t);
  If op = '??' Then
    Begin
      evalr := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
      Emit1(ctx, OP_JE, LabelOp(evalr));
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
      Emit1(ctx, OP_JNE, LabelOp(done));
      PlaceLabel(ctx, evalr);
    End
  Else
    Begin
      GenTruthy(ctx);
      Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
      If op = '&&' Then
        Emit1(ctx, OP_JE, LabelOp(short))
      Else
        Emit1(ctx, OP_JNE, LabelOp(short));
    End;
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, short);
  LoadTemp(ctx, t);
  PlaceLabel(ctx, done);
  { sur ?? sans evaluation de la droite, EDX:EAX contient deja la gauche }
  TempRelease(ctx, t);
End;

Procedure GenCond(Var ctx: TCompilerContext; n: LongInt);
Var
  els, done: LongInt;
Begin
  els := NewLabel(ctx);
  done := NewLabel(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(els));
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, els);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  PlaceLabel(ctx, done);
End;

Procedure GenUnary(Var ctx: TCompilerContext; n: LongInt);
Var
  s: TTokenText;
  e, slow, done, t: LongInt;
Begin
  s := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  e := NodeP(ctx.ast.nodes, n)^.e1;
  slow := NewLabel(ctx);
  done := NewLabel(ctx);
  If (s = 'yield') Or (s = 'await') Then
    Begin
      { suspension de la coroutine : la valeur envoyee (ou rendue par la promesse)
        revient dans EDX:EAX }
      If e <> 0 Then
        GenExpr(ctx, e)
      Else
        LoadUndefined(ctx);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      If (s = 'yield') And (NodeP(ctx.ast.nodes, n)^.flags = 1) Then
        CallRt(ctx, 'yield_star', 8)
      Else
        CallRt(ctx, 'yield', 8);
    End
  Else If s = '!' Then
    Begin
      GenExpr(ctx, e);
      GenTruthy(ctx);
      Emit(ctx, OP_XOR, RegOp(R_EAX), ImmOp(1));
      BoolFromEax(ctx);
    End
  Else If s = '-' Then
    Begin
      GenExpr(ctx, e);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JNE, LabelOp(slow));
      { 0 donne -0 et INT_MIN depasse : repli sur le runtime }
      Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
      Emit1(ctx, OP_JE, LabelOp(slow));
      Emit1(ctx, OP_NEG, RegOp(R_EAX));
      Emit1(ctx, OP_JNO, LabelOp(done));
      PlaceLabel(ctx, slow);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'bw_neg', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = '+' Then
    Begin
      GenExpr(ctx, e);
      { int32 et double sont deja des nombres }
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JBE, LabelOp(done));
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumber', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = '~' Then
    Begin
      GenExpr(ctx, e);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
      Emit1(ctx, OP_JNE, LabelOp(slow));
      Emit1(ctx, OP_NOT, RegOp(R_EAX));
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, slow);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'bw_bnot', 8);
      PlaceLabel(ctx, done);
    End
  Else If s = 'typeof' Then
    Begin
      GenExpr(ctx, e);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'typeof', 8);
    End
  Else If s = 'void' Then
    Begin
      GenExpr(ctx, e);
      LoadUndefined(ctx);
    End
  Else If s = '&' Then
    { operateur de reference &fn (extension) : la valeur de la fonction }
    GenExpr(ctx, e)
  Else If s = 'delete' Then
    Begin
      If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_MEMBER) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e1);
          Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
                StrP(ctx.data.strs, NodeP(ctx.ast.nodes, e)^.aux)^.sym));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'delete_prop', 12);
        End
      Else If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_INDEX) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e1);
          t := TempAcquire(ctx);
          SaveTemp(ctx, t);
          GenExpr(ctx, NodeP(ctx.ast.nodes, e)^.e2);
          CallBinary(ctx, 'delete_member', t);
          TempRelease(ctx, t);
        End
      Else If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.kind = N_IDENT) Then
        { une variable ne se supprime pas }
        LoadTag(ctx, 0, RT_T_BOOLEAN)
      Else
        Begin
          GenExpr(ctx, e);
          LoadTag(ctx, 1, RT_T_BOOLEAN);
        End;
    End
  Else
    PendingExpr(ctx, n);
End;

{ ++ et -- sur une variable : le resultat est la nouvelle valeur
  (prefixe) ou l'ancienne valeur convertie en nombre (postfixe). }
{ ---- Cibles membre : objet.nom et objet[cle] en ecriture (TODO 15) ----

  L'objet (et la cle d'un acces par crochets) sont evalues une seule
  fois dans des temporaires ; la valeur courante est lue par
  _JSRT_get_prop / _JSRT_get_member et ecrite par _JSRT_set_prop(objet,
  atome, valeur) ou _JSRT_set_member(objet, cle, valeur), qui rendent la
  valeur ecrite dans EDX:EAX. }

Procedure MemberPrep(Var ctx: TCompilerContext; m: LongInt; Var tobj, tkey: LongInt);
Begin
  tobj := TempAcquire(ctx);
  tkey := 0;
  GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e1);
  SaveTemp(ctx, tobj);
  If NodeP(ctx.ast.nodes, m)^.kind = N_INDEX Then
    Begin
      tkey := TempAcquire(ctx);
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
      SaveTemp(ctx, tkey);
    End;
End;

Procedure MemberDone(Var ctx: TCompilerContext; tobj, tkey: LongInt);
Begin
  If tkey <> 0 Then
    TempRelease(ctx, tkey);
  TempRelease(ctx, tobj);
End;

Procedure MemberFetch(Var ctx: TCompilerContext; m, tobj, tkey: LongInt);
Begin
  If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_prop', 12);
    End
  Else
    Begin
      PushTemp(ctx, tkey);
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_member', 16);
    End;
End;

{ Ecrit EDX:EAX dans la propriete ; la valeur reste dans EDX:EAX. }
Procedure MemberStore(Var ctx: TCompilerContext; m, tobj, tkey: LongInt);
Begin
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'set_prop', 20);
    End
  Else
    Begin
      PushTemp(ctx, tkey);
      PushTemp(ctx, tobj);
      CallRt(ctx, 'set_member', 24);
    End;
End;

Function IsMemberTarget(Var ctx: TCompilerContext; n: LongInt): Boolean;
Begin
  IsMemberTarget := (n <> 0) And ((NodeP(ctx.ast.nodes, n)^.kind = N_MEMBER) Or
                                  (NodeP(ctx.ast.nodes, n)^.kind = N_INDEX)) And
                    (NodeP(ctx.ast.nodes, n)^.flags And EF_OPTIONAL = 0);
End;

{ x.p++, --a[i]... }
Procedure GenUpdateMember(Var ctx: TCompilerContext; n, e: LongInt);
Var
  slow, store, t, tobj, tkey: LongInt;
  inc_op, prefix: Boolean;
Begin
  inc_op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = '++';
  prefix := NodeP(ctx.ast.nodes, n)^.flags And UF_PREFIX <> 0;
  slow := NewLabel(ctx);
  store := NewLabel(ctx);
  t := TempAcquire(ctx);
  MemberPrep(ctx, e, tobj, tkey);
  MemberFetch(ctx, e, tobj, tkey);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
  If inc_op Then
    Emit(ctx, OP_ADD, RegOp(R_ECX), ImmOp(1))
  Else
    Emit(ctx, OP_SUB, RegOp(R_ECX), ImmOp(1));
  Emit1(ctx, OP_JO, LabelOp(slow));
  If Not prefix Then
    SaveTemp(ctx, t);
  Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
  Emit1(ctx, OP_JMP, LabelOp(store));
  PlaceLabel(ctx, slow);
  If Not prefix Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumeric', 8);
      SaveTemp(ctx, t);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If inc_op Then
    CallRt(ctx, 'bw_inc', 8)
  Else
    CallRt(ctx, 'bw_dec', 8);
  PlaceLabel(ctx, store);
  MemberStore(ctx, e, tobj, tkey);
  If Not prefix Then
    LoadTemp(ctx, t);
  MemberDone(ctx, tobj, tkey);
  TempRelease(ctx, t);
End;

{ x.p op= v, a[i] op= v, a[i] &&= v... }
Procedure GenCompoundMember(Var ctx: TCompilerContext; n, lhs: LongInt);
Var
  t, tobj, tkey, keep, done, evalr: LongInt;
  op: TTokenText;
Begin
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  t := TempAcquire(ctx);
  MemberPrep(ctx, lhs, tobj, tkey);
  MemberFetch(ctx, lhs, tobj, tkey);
  SaveTemp(ctx, t);
  If (op = '&&=') Or (op = '||=') Or (op = '??=') Then
    Begin
      keep := NewLabel(ctx);
      done := NewLabel(ctx);
      If op = '??=' Then
        Begin
          evalr := NewLabel(ctx);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
          Emit1(ctx, OP_JE, LabelOp(evalr));
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
          Emit1(ctx, OP_JNE, LabelOp(keep));
          PlaceLabel(ctx, evalr);
        End
      Else
        Begin
          GenTruthy(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          If op = '&&=' Then
            Emit1(ctx, OP_JE, LabelOp(keep))
          Else
            Emit1(ctx, OP_JNE, LabelOp(keep));
        End;
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      MemberStore(ctx, lhs, tobj, tkey);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, keep);
      LoadTemp(ctx, t);
      PlaceLabel(ctx, done);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      GenBinaryCore(ctx, Copy(op, 1, Length(op) - 1), t);
      MemberStore(ctx, lhs, tobj, tkey);
    End;
  MemberDone(ctx, tobj, tkey);
  TempRelease(ctx, t);
End;

Procedure GenUpdate(Var ctx: TCompilerContext; n: LongInt);
Var
  e, sy, slow, store, t: LongInt;
  inc_op: Boolean;
  prefix: Boolean;
Begin
  e := NodeP(ctx.ast.nodes, n)^.e1;
  If IsMemberTarget(ctx, e) Then
    Begin
      GenUpdateMember(ctx, n, e);
      Exit;
    End;
  If (e = 0) Or (NodeP(ctx.ast.nodes, e)^.kind <> N_IDENT) Or
     Not ((NodeP(ctx.ast.nodes, e)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, e)^.aux = RK_OUTER) Or
          (NodeP(ctx.ast.nodes, e)^.aux = RK_GLOBAL_IMPLICIT)) Then
    Begin
      PendingExpr(ctx, n);
      Exit;
    End;
  sy := NodeP(ctx.ast.nodes, e)^.sym;
  inc_op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = '++';
  prefix := NodeP(ctx.ast.nodes, n)^.flags And UF_PREFIX <> 0;
  slow := NewLabel(ctx);
  store := NewLabel(ctx);
  t := TempAcquire(ctx);
  LoadSym(ctx, sy);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_INT32)));
  Emit1(ctx, OP_JNE, LabelOp(slow));
  Emit(ctx, OP_MOV, RegOp(R_ECX), RegOp(R_EAX));
  If inc_op Then
    Emit(ctx, OP_ADD, RegOp(R_ECX), ImmOp(1))
  Else
    Emit(ctx, OP_SUB, RegOp(R_ECX), ImmOp(1));
  Emit1(ctx, OP_JO, LabelOp(slow));
  If Not prefix Then
    SaveTemp(ctx, t);
  Emit(ctx, OP_MOV, RegOp(R_EAX), RegOp(R_ECX));
  Emit1(ctx, OP_JMP, LabelOp(store));
  PlaceLabel(ctx, slow);
  If Not prefix Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tonumeric', 8);
      SaveTemp(ctx, t);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If inc_op Then
    CallRt(ctx, 'bw_inc', 8)
  Else
    CallRt(ctx, 'bw_dec', 8);
  PlaceLabel(ctx, store);
  StoreSym(ctx, sy, False);
  If Not prefix Then
    LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Affectation composee sur une variable : x op= v, x &&= v, x ||= v, x ??= v. }
Procedure GenCompound(Var ctx: TCompilerContext; n: LongInt);
Var
  lhs, sy, t, keep, done, evalr: LongInt;
  op: TTokenText;
Begin
  lhs := NodeP(ctx.ast.nodes, n)^.e1;
  op := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text;
  If IsMemberTarget(ctx, lhs) Then
    Begin
      GenCompoundMember(ctx, n, lhs);
      Exit;
    End;
  If (lhs = 0) Or (NodeP(ctx.ast.nodes, lhs)^.kind <> N_IDENT) Or
     Not ((NodeP(ctx.ast.nodes, lhs)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, lhs)^.aux = RK_OUTER) Or
          (NodeP(ctx.ast.nodes, lhs)^.aux = RK_GLOBAL_IMPLICIT)) Then
    Begin
      PendingExpr(ctx, n);
      Exit;
    End;
  sy := NodeP(ctx.ast.nodes, lhs)^.sym;
  t := TempAcquire(ctx);
  GenExpr(ctx, lhs);
  SaveTemp(ctx, t);
  If (op = '&&=') Or (op = '||=') Or (op = '??=') Then
    Begin
      keep := NewLabel(ctx);
      done := NewLabel(ctx);
      If op = '??=' Then
        Begin
          evalr := NewLabel(ctx);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
          Emit1(ctx, OP_JE, LabelOp(evalr));
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
          Emit1(ctx, OP_JNE, LabelOp(keep));
          PlaceLabel(ctx, evalr);
        End
      Else
        Begin
          GenTruthy(ctx);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          If op = '&&=' Then
            Emit1(ctx, OP_JE, LabelOp(keep))
          Else
            Emit1(ctx, OP_JNE, LabelOp(keep));
        End;
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      StoreSym(ctx, sy, False);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, keep);
      LoadTemp(ctx, t);
      PlaceLabel(ctx, done);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      GenBinaryCore(ctx, Copy(op, 1, Length(op) - 1), t);
      StoreSym(ctx, sy, False);
    End;
  TempRelease(ctx, t);
End;

{ ---- Fonctions, appels et acces aux membres (TODO 12) ----

  Convention d'appel interne. L'appelant reserve sur la pile, de bas en
  haut : la closure (4 octets), argc (4), this (8) puis les arguments
  (8 octets chacun), appelle [closure+code] et retire le tout. Dans la
  fonction appelee, apres push ebp : [EBP+8] closure, [EBP+12] argc,
  [EBP+16] this, [EBP+24] argument 0. Resultat dans EDX:EAX. Les
  arguments sont evalues de gauche a droite directement dans l'espace
  reserve. Avec un argument ...spread, les arguments sont rassembles
  dans un tableau et _JSRT_call_array(fonction, this, tableau) fait
  l'appel.

  Objet fonction : _JSRT_new_function(descripteur, code, environnement,
  this) ; l'environnement (_JSRT_new_env(n)) recoit les pointeurs des
  cellules capturees, dans l'ordre de la table des captures de la
  fonction. Une fleche memorise le this de son createur.

  Acces aux membres en lecture : _JSRT_get_prop(objet, atome) et
  _JSRT_get_member(objet, cle). Un appel de methode passe l'objet comme
  this. Le chainage optionnel a?.b.c() saute a la fin de la chaine avec
  undefined des qu'un maillon ?. rencontre null ou undefined. }

{ this du contexte courant, pour le memoriser dans une fleche. }
Procedure LoadCurrentThis(Var ctx: TCompilerContext);
Begin
  If ctx.ir.cg_fs = 1 Then
    LoadUndefined(ctx)
  Else If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
    Begin
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
    End
  Else
    Begin
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
    End;
End;

{ Cree l'objet fonction du noeud n (declaration, expression, fleche) ;
  le resultat est dans EDX:EAX. }
Procedure GenMakeClosure(Var ctx: TCompilerContext; n: LongInt);
Var
  fd, sc, ncells, i, k, kk, sy, e: LongInt;
  is_arrow: Boolean;
Begin
  fd := NodeP(ctx.ast.nodes, n)^.ds;
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  ncells := ScopeP(ctx.sem.scopes, sc)^.cap_count;
  is_arrow := ScopeP(ctx.sem.scopes, sc)^.fkind = FK_ARROW;
  e := 0;
  If ncells > 0 Then
    Begin
      e := TempAcquire(ctx);
      Emit1(ctx, OP_PUSH, ImmOp(ncells));
      CallRt(ctx, 'new_env', 4);
      Emit(ctx, OP_MOV, TempLo(e), RegOp(R_EAX));
      k := 0;
      For i := 1 To ctx.sem.cap_count Do
        If CapP(ctx.sem.caps, i)^.fscope = sc Then
          Begin
            Inc(k);
            sy := CapP(ctx.sem.caps, i)^.sym;
            If ScopeP(ctx.sem.scopes, SymP(ctx.sem.syms, sy)^.scope)^.func = ctx.ir.cg_fs Then
              Emit(ctx, OP_MOV, RegOp(R_ECX),
                   MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)))
            Else
              Begin
                kk := CapIndex(ctx, ctx.ir.cg_fs, sy);
                If kk = 0 Then
                  Begin
                    PipelineError(ctx, 'capture introuvable pour ' +
                                  TokP(ctx.lex.tokens, SymP(ctx.sem.syms, sy)^.name_tok)^.text);
                    kk := 1;
                  End;
                Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
                Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_ECX, RT_FN_ENV));
                Emit(ctx, OP_MOV, RegOp(R_ECX),
                     MemReg(R_ECX, RT_ENV_CELLS + 4 * (kk - 1)));
              End;
            Emit(ctx, OP_MOV, RegOp(R_EDX), TempLo(e));
            Emit(ctx, OP_MOV, MemReg(R_EDX, RT_ENV_CELLS + 4 * (k - 1)), RegOp(R_ECX));
          End;
    End;
  { new_function(descripteur, code, environnement, this) }
  If is_arrow Then
    LoadCurrentThis(ctx)
  Else
    LoadUndefined(ctx);
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  If ncells > 0 Then
    Emit1(ctx, OP_PUSH, TempLo(e))
  Else
    Emit1(ctx, OP_PUSH, ImmOp(0));
  Emit1(ctx, OP_PUSH, AddrSym(SYMK_X, XSym(ctx, FdescP(ctx.data.fdescs, fd)^.code_sym)));
  Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, FdescP(ctx.data.fdescs, fd)^.sym));
  CallRt(ctx, 'new_function', 20);
  If is_arrow And (ctx.ir.cg_fs > 1) Then
    Begin
      { methode d'accueil de super : la fermeture courante, ou celle de la fleche englobante }
      Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
      If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
        Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_ECX, RT_FN_HOME));
      Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_HOME), RegOp(R_ECX));
    End;
  If e <> 0 Then
    TempRelease(ctx, e);
End;

{ ---- Chaines d'acces et d'appels ---- }

Function IsChainKind(k: TNodeKind): Boolean;
Begin
  IsChainKind := (k = N_MEMBER) Or (k = N_INDEX) Or (k = N_CALL);
End;

{ Si le maillon est optionnel et que la valeur EDX:EAX est null ou
  undefined, saute a la fin de la chaine avec undefined. }
Procedure ChainNullCheck(Var ctx: TCompilerContext);
Var
  isnull, ok: LongInt;
Begin
  isnull := NewLabel(ctx);
  ok := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JE, LabelOp(isnull));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_NULL)));
  Emit1(ctx, OP_JNE, LabelOp(ok));
  PlaceLabel(ctx, isnull);
  LoadUndefined(ctx);
  Emit1(ctx, OP_JMP, LabelOp(ctx.ir.chain_end));
  ctx.ir.chain_used := True;
  PlaceLabel(ctx, ok);
End;

{ Evalue l'objet d'un maillon membre ou indice et le range dans tobj. }
Procedure GenChainBase(Var ctx: TCompilerContext; m, tobj: LongInt);
Begin
  ctx.ir.in_chain := True;
  GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e1);
  ctx.ir.in_chain := False;
  If NodeP(ctx.ast.nodes, m)^.flags And EF_OPTIONAL <> 0 Then
    ChainNullCheck(ctx);
  SaveTemp(ctx, tobj);
End;

{ L'objet est dans tobj : lit la propriete dans EDX:EAX. }
Procedure GenPropFetch(Var ctx: TCompilerContext; m, tobj: LongInt);
Begin
  If (NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, m)^.e1)^.kind = N_SUPER) And
     (ctx.ir.cg_fs > 1) Then
    Begin
      { super.nom / super[cle] : recherche dans le prototype de l'objet d'accueil }
      If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
        Begin
          PushTemp(ctx, tobj);
          Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
                StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
        End
      Else
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'tokey', 8);
          PushTemp(ctx, tobj);
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
        End;
      If ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind = FK_ARROW Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit1(ctx, OP_PUSH, MemReg(R_ECX, RT_FN_HOME));
        End
      Else
        Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'super_get', 16);
    End
  Else If NodeP(ctx.ast.nodes, m)^.kind = N_MEMBER Then
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
            StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
      PushTemp(ctx, tobj);
      CallRt(ctx, 'get_prop', 12);
    End
  Else
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e2);
      CallBinary(ctx, 'get_member', tobj);
    End;
End;

Procedure GenMember(Var ctx: TCompilerContext; n: LongInt);
Var
  t, old_end: LongInt;
  top, old_used: Boolean;
Begin
  top := Not ctx.ir.in_chain;
  old_end := ctx.ir.chain_end;
  old_used := ctx.ir.chain_used;
  If top Then
    Begin
      ctx.ir.chain_end := NewLabel(ctx);
      ctx.ir.chain_used := False;
    End;
  t := TempAcquire(ctx);
  GenChainBase(ctx, n, t);
  GenPropFetch(ctx, n, t);
  TempRelease(ctx, t);
  If top Then
    Begin
      If ctx.ir.chain_used Then
        PlaceLabel(ctx, ctx.ir.chain_end);
      ctx.ir.chain_end := old_end;
      ctx.ir.chain_used := old_used;
    End;
  ctx.ir.in_chain := Not top;
End;

Procedure GenCall(Var ctx: TCompilerContext; n: LongInt);
Var
  callee, a, nargs, i, tf, tt, notfn, lbl, old_end, usethis, okl: LongInt;
  top, has_spread, old_used, is_new, is_super: Boolean;
  nt_old, nt_res: LongInt;

  { new.target : sauvegarde puis positionne la cible, restaure apres l'appel }
  Procedure NtEnter;
  Begin
    If Not is_new Then
      Exit;
    PushTemp(ctx, tf);
    CallRt(ctx, 'nt_enter', 8);
    SaveTemp(ctx, nt_old);
  End;

  Procedure NtLeave;
  Begin
    If Not is_new Then
      Exit;
    SaveTemp(ctx, nt_res);
    PushTemp(ctx, nt_old);
    CallRt(ctx, 'nt_leave', 8);
    LoadTemp(ctx, nt_res);
  End;

Begin
  callee := NodeP(ctx.ast.nodes, n)^.e1;
  is_new := NodeP(ctx.ast.nodes, n)^.kind = N_NEW;
  is_super := (callee <> 0) And (NodeP(ctx.ast.nodes, callee)^.kind = N_SUPER);
  If is_super And ((ctx.ir.cg_fs <= 1) Or
     (ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.fkind <> FK_DERIVED_CTOR)) Then
    Begin
      PendingNote(ctx, n, 'super(...) hors du constructeur d''une classe derivee');
      LoadUndefined(ctx);
      Exit;
    End;
  top := Not ctx.ir.in_chain;
  old_end := ctx.ir.chain_end;
  old_used := ctx.ir.chain_used;
  If top Then
    Begin
      ctx.ir.chain_end := NewLabel(ctx);
      ctx.ir.chain_used := False;
    End;
  nargs := 0;
  has_spread := False;
  a := NodeP(ctx.ast.nodes, n)^.e2;
  While a <> 0 Do
    Begin
      Inc(nargs);
      If NodeP(ctx.ast.nodes, a)^.kind = N_SPREAD Then
        has_spread := True;
      a := NodeP(ctx.ast.nodes, a)^.next;
    End;
  tf := TempAcquire(ctx);
  tt := TempAcquire(ctx);
  nt_old := 0;
  nt_res := 0;
  If is_new Then
    Begin
      nt_old := TempAcquire(ctx);
      nt_res := TempAcquire(ctx);
    End;

  { callee et this }
  If (Not is_new) And (callee <> 0) And ((NodeP(ctx.ast.nodes, callee)^.kind = N_MEMBER) Or
                        (NodeP(ctx.ast.nodes, callee)^.kind = N_INDEX)) Then
    Begin
      GenChainBase(ctx, callee, tt);
      GenPropFetch(ctx, callee, tt);
    End
  Else
    Begin
      If is_super Then
        Begin
          { constructeur parent : champ this de la classe courante }
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
        End
      Else
        Begin
          ctx.ir.in_chain := True;
          GenExpr(ctx, callee);
          ctx.ir.in_chain := False;
        End;
      SaveTemp(ctx, tf);
      If is_super Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
        End
      Else
        LoadUndefined(ctx);
      SaveTemp(ctx, tt);
      If is_new Then
        Begin
          { this d'un appel new : objet neuf, ou undefined pour un natif }
          usethis := NewLabel(ctx);
          LoadTemp(ctx, tf);
          Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
          Emit1(ctx, OP_JNE, LabelOp(usethis));
          PushTemp(ctx, tf);
          CallRt(ctx, 'new_this', 8);
          SaveTemp(ctx, tt);
          PlaceLabel(ctx, usethis);
        End;
      LoadTemp(ctx, tf);
    End;
  If NodeP(ctx.ast.nodes, n)^.flags And EF_OPTIONAL <> 0 Then
    ChainNullCheck(ctx);
  SaveTemp(ctx, tf);
  { la valeur appelee doit etre une fonction }
  notfn := NewLabel(ctx);
  lbl := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
  Emit1(ctx, OP_JNE, LabelOp(notfn));

  If has_spread Then
    Begin
      { arguments rassembles dans un tableau }
      CallRt(ctx, 'array_new', 0);
      i := TempAcquire(ctx);
      SaveTemp(ctx, i);
      a := NodeP(ctx.ast.nodes, n)^.e2;
      While a <> 0 Do
        Begin
          If NodeP(ctx.ast.nodes, a)^.kind = N_SPREAD Then
            Begin
              GenExpr(ctx, NodeP(ctx.ast.nodes, a)^.e1);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, i);
              CallRt(ctx, 'array_spread', 16);
            End
          Else
            Begin
              GenExpr(ctx, a);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, i);
              CallRt(ctx, 'array_push', 16);
            End;
          a := NodeP(ctx.ast.nodes, a)^.next;
        End;
      NtEnter;
      PushTemp(ctx, i);
      PushTemp(ctx, tt);
      PushTemp(ctx, tf);
      CallRt(ctx, 'call_array', 24);
      NtLeave;
      TempRelease(ctx, i);
    End
  Else
    Begin
      Emit(ctx, OP_SUB, RegOp(R_ESP), ImmOp(16 + RT_VALUE_SIZE * nargs));
      i := 0;
      a := NodeP(ctx.ast.nodes, n)^.e2;
      While a <> 0 Do
        Begin
          GenExpr(ctx, a);
          Emit(ctx, OP_MOV, MemReg(R_ESP, 16 + RT_VALUE_SIZE * i), RegOp(R_EAX));
          Emit(ctx, OP_MOV, MemReg(R_ESP, 16 + RT_VALUE_SIZE * i + 4), RegOp(R_EDX));
          Inc(i);
          a := NodeP(ctx.ast.nodes, a)^.next;
        End;
      NtEnter;
      Emit(ctx, OP_MOV, RegOp(R_EAX), TempLo(tf));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 0), RegOp(R_EAX));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 4), ImmOp(nargs));
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(tt));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 8), RegOp(R_ECX));
      Emit(ctx, OP_MOV, RegOp(R_ECX), TempHi(tt));
      Emit(ctx, OP_MOV, MemReg(R_ESP, 12), RegOp(R_ECX));
      Emit1(ctx, OP_CALL, MemReg(R_EAX, RT_FN_CODE));
      Emit(ctx, OP_ADD, RegOp(R_ESP), ImmOp(16 + RT_VALUE_SIZE * nargs));
      NtLeave;
    End;
  If is_new Then
    Begin
      { le resultat d'un constructeur n'est retenu que s'il est un objet }
      usethis := NewLabel(ctx);
      okl := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_OBJECT)));
      Emit1(ctx, OP_JB, LabelOp(usethis));
      Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_REGEXP)));
      Emit1(ctx, OP_JBE, LabelOp(okl));
      PlaceLabel(ctx, usethis);
      LoadTemp(ctx, tt);
      PlaceLabel(ctx, okl);
    End;
  If is_super Then
    Begin
      { champs d'instance de cette classe, puis la valeur de l'expression est this }
      PushTemp(ctx, tt);
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'init_fields', 12);
      LoadTemp(ctx, tt);
    End;
  Emit1(ctx, OP_JMP, LabelOp(lbl));
  PlaceLabel(ctx, notfn);
  CallRt(ctx, 'throw_notfunc', 0);
  PlaceLabel(ctx, lbl);
  If is_new Then
    Begin
      TempRelease(ctx, nt_res);
      TempRelease(ctx, nt_old);
    End;
  TempRelease(ctx, tt);
  TempRelease(ctx, tf);
  If top Then
    Begin
      If ctx.ir.chain_used Then
        PlaceLabel(ctx, ctx.ir.chain_end);
      ctx.ir.chain_end := old_end;
      ctx.ir.chain_used := old_used;
    End;
  ctx.ir.in_chain := Not top;
End;

{ Gabarit avec interpolation : les segments constants et les expressions converties
  par ToString sont concatenes de gauche a droite. }
Procedure GenTemplate(Var ctx: TCompilerContext; n: LongInt);
Var
  e, t: LongInt;
Begin
  e := NodeP(ctx.ast.nodes, n)^.e1;
  If (e <> 0) And (NodeP(ctx.ast.nodes, e)^.next = 0) Then
    Begin
      LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
      Exit;
    End;
  t := TempAcquire(ctx);
  LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
  SaveTemp(ctx, t);
  e := NodeP(ctx.ast.nodes, e)^.next;
  While e <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, e)^.kind = N_TEMPLATE_STR Then
        Begin
          If StrP(ctx.data.strs, NodeP(ctx.ast.nodes, e)^.ds)^.len > 0 Then
            Begin
              LoadStringConst(ctx, NodeP(ctx.ast.nodes, e)^.ds);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              PushTemp(ctx, t);
              CallRt(ctx, 'concat', 16);
              SaveTemp(ctx, t);
            End;
        End
      Else
        Begin
          GenExpr(ctx, e);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          CallRt(ctx, 'tostring', 8);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'concat', 16);
          SaveTemp(ctx, t);
        End;
      e := NodeP(ctx.ast.nodes, e)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Affectation simple ou destructurante ; la valeur reste dans EDX:EAX. }
Procedure GenAssign(Var ctx: TCompilerContext; n: LongInt);
Var
  lhs, t, tobj, tkey: LongInt;
Begin
  lhs := NodeP(ctx.ast.nodes, n)^.e1;
  If TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text <> '=' Then
    Begin
      GenCompound(ctx, n);
      Exit;
    End;
  If (lhs <> 0) And (NodeP(ctx.ast.nodes, lhs)^.kind = N_IDENT) Then
    Begin
      If (NodeP(ctx.ast.nodes, lhs)^.aux = RK_LOCAL) Or (NodeP(ctx.ast.nodes, lhs)^.aux = RK_OUTER) Or
         (NodeP(ctx.ast.nodes, lhs)^.aux = RK_GLOBAL_IMPLICIT) Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
          StoreSym(ctx, NodeP(ctx.ast.nodes, lhs)^.sym, False);
        End
      Else
        PendingExpr(ctx, n);
    End
  Else If IsMemberTarget(ctx, lhs) Then
    Begin
      MemberPrep(ctx, lhs, tobj, tkey);
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      MemberStore(ctx, lhs, tobj, tkey);
      MemberDone(ctx, tobj, tkey);
    End
  Else If (lhs <> 0) And ((NodeP(ctx.ast.nodes, lhs)^.kind = N_ARRAY_LIT) Or
                          (NodeP(ctx.ast.nodes, lhs)^.kind = N_OBJECT_LIT)) Then
    Begin
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
      t := AllocTemp(ctx);
      Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t)), RegOp(R_EAX));
      Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(t) + 4), RegOp(R_EDX));
      BindTo(ctx, lhs, t, False);
      Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, SlotDisp(t)));
      Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, SlotDisp(t) + 4));
    End
  Else
    PendingExpr(ctx, n);
End;

{ Litteral de tableau : array_new puis array_push / array_spread. }
Procedure GenArrayLit(Var ctx: TCompilerContext; n: LongInt);
Var
  t, el: LongInt;
Begin
  t := TempAcquire(ctx);
  CallRt(ctx, 'array_new', 0);
  SaveTemp(ctx, t);
  el := NodeP(ctx.ast.nodes, n)^.e1;
  While el <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
        GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e1)
      Else If NodeP(ctx.ast.nodes, el)^.kind = N_ELISION Then
        LoadUndefined(ctx)
      Else
        GenExpr(ctx, el);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      PushTemp(ctx, t);
      If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
        CallRt(ctx, 'array_spread', 16)
      Else
        CallRt(ctx, 'array_push', 16);
      el := NodeP(ctx.ast.nodes, el)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ Litteral d'objet : obj_new puis obj_define / obj_define_acc / obj_spread. }
Procedure GenObjectLit(Var ctx: TCompilerContext; n: LongInt);
Var
  t, tk, p, fl: LongInt;
Begin
  t := TempAcquire(ctx);
  CallRt(ctx, 'obj_new', 0);
  SaveTemp(ctx, t);
  p := NodeP(ctx.ast.nodes, n)^.e1;
  While p <> 0 Do
    Begin
      fl := NodeP(ctx.ast.nodes, p)^.flags;
      If fl And PR_SPREAD <> 0 Then
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'obj_spread', 16);
        End
      Else If (fl And (PR_COMPUTED Or PR_SHORTHAND Or PR_METHOD Or PR_GETTER Or PR_SETTER) = 0) And
              (StrText(ctx, NodeP(ctx.ast.nodes, p)^.aux) = '__proto__') Then
        Begin
          { litteral avec une cle __proto__ : fixe le prototype de l objet }
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, t);
          CallRt(ctx, 'obj_set_proto_lit', 12);
        End
      Else
        Begin
          tk := 0;
          If fl And PR_COMPUTED <> 0 Then
            Begin
              tk := TempAcquire(ctx);
              GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e2);
              Emit1(ctx, OP_PUSH, RegOp(R_EDX));
              Emit1(ctx, OP_PUSH, RegOp(R_EAX));
              CallRt(ctx, 'tokey', 8);
              SaveTemp(ctx, tk);
            End;
          GenExpr(ctx, NodeP(ctx.ast.nodes, p)^.e1);
          If fl And (PR_METHOD Or PR_GETTER Or PR_SETTER) <> 0 Then
            Begin
              { objet d'accueil de la methode : super.m() }
              Emit(ctx, OP_MOV, RegOp(R_ECX), TempLo(t));
              Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_THIS), RegOp(R_ECX));
              Emit(ctx, OP_MOV, MemReg(R_EAX, RT_FN_THIS + 4), ImmOp(TagImm(RT_T_OBJECT)));
            End;
          If fl And PR_SETTER <> 0 Then
            Emit1(ctx, OP_PUSH, ImmOp(1))
          Else If fl And PR_GETTER <> 0 Then
            Emit1(ctx, OP_PUSH, ImmOp(0));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          If tk <> 0 Then
            Emit1(ctx, OP_PUSH, TempLo(tk))
          Else
            Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, p)^.aux)^.sym));
          Emit1(ctx, OP_PUSH, TempLo(t));
          If fl And (PR_GETTER Or PR_SETTER) <> 0 Then
            CallRt(ctx, 'obj_define_acc', 24)
          Else
            CallRt(ctx, 'obj_define', 16);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End;
      p := NodeP(ctx.ast.nodes, p)^.next;
    End;
  LoadTemp(ctx, t);
  TempRelease(ctx, t);
End;

{ ---- Classes (TODO 17) ----

  Une classe est la fonction constructeur elle-meme (objet fonction), avec
  un objet de proprietes (membres statiques, prototype herite de la classe
  parente) et un objet prototype (methodes, accesseurs, constructor).
  _JSRT_class_setup(classe, parent) cree ces deux objets et memorise la
  classe parente dans le champ this de la fonction, que super(...) lit.
  Une methode memorise son objet d'accueil dans ce meme champ, ce qui
  permet super.m(...). Les champs d'instance sont enregistres dans la
  propriete cachee #fields du prototype ; _JSRT_init_fields(classe,
  this) les initialise (au debut du constructeur de base, ou juste apres
  super(...) dans une classe derivee). }

Function ClassCtor(Var ctx: TCompilerContext; n: LongInt): LongInt;
Var
  m: LongInt;
Begin
  ClassCtor := 0;
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR <> 0) Then
        ClassCtor := m;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
End;

{ Cle d'un membre de classe : EAX = chaine ; resultat dans le temporaire tk
  (calculee) ou 0 si la cle est un atome. }
Function ClassKeyTemp(Var ctx: TCompilerContext; m: LongInt): LongInt;
Var
  tk: LongInt;
Begin
  tk := 0;
  If NodeP(ctx.ast.nodes, m)^.flags And MF_COMPUTED <> 0 Then
    Begin
      tk := TempAcquire(ctx);
      GenExpr(ctx, NodeP(ctx.ast.nodes, m)^.e3);
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'tokey', 8);
      SaveTemp(ctx, tk);
    End;
  ClassKeyTemp := tk;
End;

Procedure PushClassKey(Var ctx: TCompilerContext; m, tk: LongInt);
Begin
  If tk <> 0 Then
    Emit1(ctx, OP_PUSH, TempLo(tk))
  Else
    Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, m)^.aux)^.sym));
End;

Procedure PushUndefinedValue(Var ctx: TCompilerContext);
Begin
  Emit1(ctx, OP_PUSH, ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_PUSH, ImmOp(0));
End;

Procedure GenClass(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, tcls, tpar, tproto, tk, m, ctor, sy, kind: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  If sc <> 0 Then
    GenScopeEnter(ctx, sc);
  tcls := TempAcquire(ctx);
  tpar := TempAcquire(ctx);
  tproto := TempAcquire(ctx);
  If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
    GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1)
  Else
    LoadUndefined(ctx);
  SaveTemp(ctx, tpar);
  ctor := ClassCtor(ctx, n);
  If ctor <> 0 Then
    GenMakeClosure(ctx, ctor)
  Else
    Begin
      Emit1(ctx, OP_PUSH, AddrSym(SYMK_D,
            StrP(ctx.data.strs, CdescP(ctx.data.cdescs, NodeP(ctx.ast.nodes, n)^.ds)^.name_str)^.sym));
      If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
        Emit1(ctx, OP_PUSH, ImmOp(1))
      Else
        Emit1(ctx, OP_PUSH, ImmOp(0));
      CallRt(ctx, 'make_default_ctor', 8);
    End;
  SaveTemp(ctx, tcls);
  PushTemp(ctx, tpar);
  PushTemp(ctx, tcls);
  CallRt(ctx, 'class_setup', 16);
  PushTemp(ctx, tcls);
  CallRt(ctx, 'class_proto', 8);
  SaveTemp(ctx, tproto);
  { liaison du nom : exterieure pour une declaration, interieure pour une expression }
  If NodeP(ctx.ast.nodes, n)^.kind = N_CLASS_DECL Then
    Begin
      If NodeP(ctx.ast.nodes, n)^.sym <> 0 Then
        Begin
          LoadTemp(ctx, tcls);
          StoreSym(ctx, NodeP(ctx.ast.nodes, n)^.sym, True);
        End;
    End
  Else If sc <> 0 Then
    Begin
      sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
      While sy <> 0 Do
        Begin
          If SymP(ctx.sem.syms, sy)^.kind = DK_FNAME Then
            Begin
              LoadTemp(ctx, tcls);
              StoreSym(ctx, sy, True);
            End;
          sy := SymP(ctx.sem.syms, sy)^.next;
        End;
    End;
  { premiere passe : methodes, accesseurs et champs d'instance }
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_METHOD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_CONSTRUCTOR = 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          GenMakeClosure(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.flags And MF_GETTER <> 0 Then
            kind := 1
          Else If NodeP(ctx.ast.nodes, m)^.flags And MF_SETTER <> 0 Then
            kind := 2
          Else
            kind := 0;
          Emit1(ctx, OP_PUSH, ImmOp(kind));
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          If NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0 Then
            PushTemp(ctx, tcls)
          Else
            PushTemp(ctx, tproto);
          CallRt(ctx, 'class_member', 24);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End
      Else If (NodeP(ctx.ast.nodes, m)^.kind = N_FIELD) And
              (NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC = 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.e1 <> 0 Then
            GenMakeClosure(ctx, m)
          Else
            LoadUndefined(ctx);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          PushTemp(ctx, tproto);
          CallRt(ctx, 'class_field', 20);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  { seconde passe : champs statiques et blocs statiques, dans l'ordre }
  m := NodeP(ctx.ast.nodes, n)^.e2;
  While m <> 0 Do
    Begin
      If (NodeP(ctx.ast.nodes, m)^.kind = N_FIELD) And
         (NodeP(ctx.ast.nodes, m)^.flags And MF_STATIC <> 0) Then
        Begin
          tk := ClassKeyTemp(ctx, m);
          If NodeP(ctx.ast.nodes, m)^.e1 <> 0 Then
            GenMakeClosure(ctx, m)
          Else
            LoadUndefined(ctx);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushClassKey(ctx, m, tk);
          PushTemp(ctx, tcls);
          CallRt(ctx, 'class_static', 20);
          If tk <> 0 Then
            TempRelease(ctx, tk);
        End
      Else If NodeP(ctx.ast.nodes, m)^.kind = N_STATIC_BLOCK Then
        Begin
          GenMakeClosure(ctx, m);
          Emit1(ctx, OP_PUSH, RegOp(R_EDX));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          PushTemp(ctx, tcls);
          CallRt(ctx, 'class_block', 16);
        End;
      m := NodeP(ctx.ast.nodes, m)^.next;
    End;
  LoadTemp(ctx, tcls);
  TempRelease(ctx, tproto);
  TempRelease(ctx, tpar);
  TempRelease(ctx, tcls);
End;

Procedure GenExpr(Var ctx: TCompilerContext; n: LongInt);
Var
  e: LongInt;
  save_chain: Boolean;
Begin
  If n = 0 Then
    Begin
      LoadUndefined(ctx);
      Exit;
    End;
  save_chain := ctx.ir.in_chain;
  If Not IsChainKind(NodeP(ctx.ast.nodes, n)^.kind) Then
    ctx.ir.in_chain := False;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_CALL, N_NEW:
      GenCall(ctx, n);
    N_REGEX:
      Begin
        { litteral /motif/drapeaux : objet RegExp cree a chaque evaluation }
        Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, n)^.aux)^.sym));
        Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, NodeP(ctx.ast.nodes, n)^.ds)^.sym));
        CallRt(ctx, 'regex_new', 8);
      End;
    N_ARRAY_LIT:
      GenArrayLit(ctx, n);
    N_OBJECT_LIT:
      GenObjectLit(ctx, n);
    N_CLASS_EXPR:
      GenClass(ctx, n);
    N_SUPER:
      If NodeP(ctx.ast.nodes, n)^.e1 = 1 Then
        Begin
          { fleche : this lexical memorise dans la fermeture }
          Emit(ctx, OP_MOV, RegOp(R_ECX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_ECX, RT_FN_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_ECX, RT_FN_THIS + 4));
        End
      Else
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_THIS));
          Emit(ctx, OP_MOV, RegOp(R_EDX), MemReg(R_EBP, RT_FRAME_THIS + 4));
        End;
    N_MEMBER, N_INDEX:
      GenMember(ctx, n);
    N_FUNC_EXPR:
      GenMakeClosure(ctx, n);
    N_NUMBER:
      Begin
        If NodeP(ctx.ast.nodes, n)^.ds <> 0 Then
          LoadDouble(ctx, NodeP(ctx.ast.nodes, n)^.ds)
        Else
          LoadTag(ctx, Trunc(TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.num_val),
                  RT_T_INT32);
      End;
    N_STRING, N_TEMPLATE_STR:
      LoadStringConst(ctx, NodeP(ctx.ast.nodes, n)^.ds);
    N_TEMPLATE:
      GenTemplate(ctx, n);
    N_BOOL:
      Begin
        If TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.text = 'true' Then
          LoadTag(ctx, 1, RT_T_BOOLEAN)
        Else
          LoadTag(ctx, 0, RT_T_BOOLEAN);
      End;
    N_NULL:
      LoadTag(ctx, 0, RT_T_NULL);
    N_IDENT:
      GenIdent(ctx, n);
    N_THIS:
      GenThis(ctx, n);
    N_ASSIGN:
      GenAssign(ctx, n);
    N_UNARY:
      Begin
        If Not TryFold(ctx, n) Then
          GenUnary(ctx, n);
      End;
    N_BINARY:
      Begin
        If Not TryFold(ctx, n) Then
          GenBinary(ctx, n);
      End;
    N_LOGICAL:
      Begin
        If Not TryFold(ctx, n) Then
          GenLogical(ctx, n);
      End;
    N_COND:
      Begin
        If Not TryFold(ctx, n) Then
          GenCond(ctx, n);
      End;
    N_UPDATE:
      GenUpdate(ctx, n);
    N_SEQUENCE:
      Begin
        e := NodeP(ctx.ast.nodes, n)^.e1;
        While e <> 0 Do
          Begin
            GenExpr(ctx, e);
            e := NodeP(ctx.ast.nodes, e)^.next;
          End;
      End;
  Else
    PendingExpr(ctx, n);
  End;
  ctx.ir.in_chain := save_chain;
End;

{ ---- Destructuration ---- }

Procedure StoreTemp(Var ctx: TCompilerContext; slot: LongInt);
Begin
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(slot)), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(slot) + 4), RegOp(R_EDX));
End;

Procedure PushTemp(Var ctx: TCompilerContext; slot: LongInt);
Begin
  Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(slot) + 4));
  Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(slot)));
End;

{ Si EDX:EAX vaut undefined, evalue la valeur par defaut. }
Procedure GenDefault(Var ctx: TCompilerContext; def: LongInt);
Var
  skip: LongInt;
Begin
  If def = 0 Then
    Exit;
  skip := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_UNDEFINED)));
  Emit1(ctx, OP_JNE, LabelOp(skip));
  GenExpr(ctx, def);
  PlaceLabel(ctx, skip);
End;

{ Lie EDX:EAX a la cible (identifiant ou sous-motif). }
Procedure BindValue(Var ctx: TCompilerContext; target: LongInt; init: Boolean);
Var
  t, tobj, tkey: LongInt;
Begin
  If target = 0 Then
    Exit;
  Case NodeP(ctx.ast.nodes, target)^.kind Of
    N_BIND_IDENT:
      StoreSym(ctx, NodeP(ctx.ast.nodes, target)^.sym, True);
    N_IDENT:
      Begin
        If (NodeP(ctx.ast.nodes, target)^.aux = RK_LOCAL) Or
           (NodeP(ctx.ast.nodes, target)^.aux = RK_OUTER) Or
           (NodeP(ctx.ast.nodes, target)^.aux = RK_GLOBAL_IMPLICIT) Then
          StoreSym(ctx, NodeP(ctx.ast.nodes, target)^.sym, init)
        Else
          PendingNote(ctx, target, 'cible d''affectation ' +
                      NodeKindName(NodeP(ctx.ast.nodes, target)^.kind));
      End;
    N_ARRAY_PATTERN, N_OBJECT_PATTERN, N_ARRAY_LIT, N_OBJECT_LIT:
      Begin
        t := AllocTemp(ctx);
        StoreTemp(ctx, t);
        BindTo(ctx, target, t, init);
      End;
    N_MEMBER, N_INDEX:
      Begin
        t := TempAcquire(ctx);
        SaveTemp(ctx, t);
        MemberPrep(ctx, target, tobj, tkey);
        LoadTemp(ctx, t);
        MemberStore(ctx, target, tobj, tkey);
        MemberDone(ctx, tobj, tkey);
        TempRelease(ctx, t);
      End;
  Else
    PendingNote(ctx, target, 'cible d''affectation ' +
                NodeKindName(NodeP(ctx.ast.nodes, target)^.kind));
  End;
End;

{ Destructure la valeur rangee dans le temporaire tslot. node est un
  motif de declaration ou un litteral utilise comme cible. }
Procedure BindTo(Var ctx: TCompilerContext; node, tslot: LongInt; init: Boolean);
Var
  el, idx, target, def, key_atom, nkeys, tex, tk: LongInt;
  rest, hole, pattern_kind, has_rest: Boolean;
  fl: LongInt;
  kn: TNodeKind;
Begin
  kn := NodeP(ctx.ast.nodes, node)^.kind;
  If (kn = N_ARRAY_PATTERN) Or (kn = N_ARRAY_LIT) Then
    Begin
      idx := 0;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          rest := False;
          hole := False;
          def := 0;
          target := 0;
          If NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_ELEM Then
            Begin
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
              rest := NodeP(ctx.ast.nodes, el)^.flags And PF_REST <> 0;
              hole := target = 0;
            End
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_ELISION Then
            hole := True
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_SPREAD Then
            Begin
              rest := True;
              target := NodeP(ctx.ast.nodes, el)^.e1;
            End
          Else If NodeP(ctx.ast.nodes, el)^.kind = N_ASSIGN Then
            Begin
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
            End
          Else
            target := el;
          If Not hole Then
            Begin
              If rest Then
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(idx));
                  PushTemp(ctx, tslot);
                  CallRt(ctx, 'array_rest', 12);
                End
              Else
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(idx));
                  PushTemp(ctx, tslot);
                  CallRt(ctx, 'get_index', 12);
                  GenDefault(ctx, def);
                End;
              BindValue(ctx, target, init);
            End;
          Inc(idx);
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
    End
  Else
    Begin
      nkeys := 0;
      tex := 0;
      has_rest := False;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          If ((NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_PROP) And
              (NodeP(ctx.ast.nodes, el)^.flags And PP_REST <> 0)) Or
             ((NodeP(ctx.ast.nodes, el)^.kind <> N_PATTERN_PROP) And
              (NodeP(ctx.ast.nodes, el)^.flags And PR_SPREAD <> 0)) Then
            has_rest := True;
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
      If has_rest Then
        Begin
          { liste des cles deja prises, pour le reste de l'objet }
          tex := TempAcquire(ctx);
          CallRt(ctx, 'array_new', 0);
          SaveTemp(ctx, tex);
        End;
      el := NodeP(ctx.ast.nodes, node)^.e1;
      While el <> 0 Do
        Begin
          If NodeP(ctx.ast.nodes, el)^.kind = N_PATTERN_PROP Then
            Begin
              fl := NodeP(ctx.ast.nodes, el)^.flags;
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e2;
              rest := fl And PP_REST <> 0;
              pattern_kind := fl And PP_COMPUTED <> 0;
              key_atom := NodeP(ctx.ast.nodes, el)^.aux;
              If pattern_kind Then
                Begin
                  GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e3);
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                  CallRt(ctx, 'tokey', 8);
                  If has_rest And Not rest Then
                    Begin
                      tk := TempAcquire(ctx);
                      SaveTemp(ctx, tk);
                      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                      PushTemp(ctx, tex);
                      CallRt(ctx, 'array_push', 16);
                      LoadTemp(ctx, tk);
                      TempRelease(ctx, tk);
                    End;
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                End;
            End
          Else
            Begin
              fl := NodeP(ctx.ast.nodes, el)^.flags;
              rest := fl And PR_SPREAD <> 0;
              pattern_kind := fl And PR_COMPUTED <> 0;
              target := NodeP(ctx.ast.nodes, el)^.e1;
              def := NodeP(ctx.ast.nodes, el)^.e3;
              key_atom := NodeP(ctx.ast.nodes, el)^.aux;
              If pattern_kind Then
                Begin
                  GenExpr(ctx, NodeP(ctx.ast.nodes, el)^.e2);
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                  CallRt(ctx, 'tokey', 8);
                  If has_rest And Not rest Then
                    Begin
                      tk := TempAcquire(ctx);
                      SaveTemp(ctx, tk);
                      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                      PushTemp(ctx, tex);
                      CallRt(ctx, 'array_push', 16);
                      LoadTemp(ctx, tk);
                      TempRelease(ctx, tk);
                    End;
                  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
                  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
                End;
              { dans a: b = 1, la valeur par defaut enveloppe la cible }
              If (target <> 0) And (NodeP(ctx.ast.nodes, target)^.kind = N_ASSIGN) And
                 (fl And PR_SHORTHAND = 0) Then
                Begin
                  def := NodeP(ctx.ast.nodes, target)^.e2;
                  target := NodeP(ctx.ast.nodes, target)^.e1;
                End;
            End;
          If rest Then
            Begin
              { le reste d'objet : copie sans les cles deja prises }
              PushTemp(ctx, tex);
              PushTemp(ctx, tslot);
              CallRt(ctx, 'obj_rest', 16);
            End
          Else If pattern_kind Then
            Begin
              { cle calculee deja poussee : valeur puis cle }
              PushTemp(ctx, tslot);
              CallRt(ctx, 'get_member', 16);
              GenDefault(ctx, def);
            End
          Else
            Begin
              If has_rest Then
                Begin
                  Emit1(ctx, OP_PUSH, ImmOp(TagImm(RT_T_STRING)));
                  Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, key_atom)^.sym));
                  PushTemp(ctx, tex);
                  CallRt(ctx, 'array_push', 16);
                End;
              Emit1(ctx, OP_PUSH, AddrSym(SYMK_D, StrP(ctx.data.strs, key_atom)^.sym));
              PushTemp(ctx, tslot);
              CallRt(ctx, 'get_prop', 12);
              GenDefault(ctx, def);
            End;
          BindValue(ctx, target, init);
          Inc(nkeys);
          el := NodeP(ctx.ast.nodes, el)^.next;
        End;
      If has_rest Then
        TempRelease(ctx, tex);
    End;
End;

{ ---- Entree de portee, declarations, instructions ---- }

Procedure GenScopeEnter(Var ctx: TCompilerContext; sc: LongInt);
Var
  sy, tag: LongInt;
Begin
  { premiere passe : cellules et valeurs initiales }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.flags And SF_STATIC = 0 Then
        Begin
          tag := RT_T_UNDEFINED;
          If IsLexicalKind(SymP(ctx.sem.syms, sy)^.kind) And
             (SymP(ctx.sem.syms, sy)^.flags And SF_TDZ_CHECK <> 0) Then
            tag := RT_T_TDZ;
          If SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0 Then
            Begin
              Emit1(ctx, OP_PUSH, ImmOp(TagImm(tag)));
              CallRt(ctx, 'new_cell', 4);
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
                   RegOp(R_EAX));
            End
          Else If (SymP(ctx.sem.syms, sy)^.kind = DK_VAR) Or
                  (SymP(ctx.sem.syms, sy)^.kind = DK_FUNC) Or (tag = RT_T_TDZ) Then
            Begin
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
                   ImmOp(0));
              Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot) + 4),
                   ImmOp(TagImm(tag)));
            End;
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  { seconde passe : les declarations de fonctions sont hissees avec leur valeur }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_FUNC Then
        Begin
          GenMakeClosure(ctx, SymP(ctx.sem.syms, sy)^.node);
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
End;

Procedure GenVarDecl(Var ctx: TCompilerContext; n: LongInt);
Var
  d, target, init, sy: LongInt;
  t: LongInt;
Begin
  d := NodeP(ctx.ast.nodes, n)^.e1;
  While d <> 0 Do
    Begin
      target := NodeP(ctx.ast.nodes, d)^.e1;
      init := NodeP(ctx.ast.nodes, d)^.e2;
      If (target <> 0) And (NodeP(ctx.ast.nodes, target)^.kind = N_BIND_IDENT) Then
        Begin
          sy := NodeP(ctx.ast.nodes, target)^.sym;
          If init <> 0 Then
            Begin
              GenExpr(ctx, init);
              StoreSym(ctx, sy, True);
            End
          Else If SymP(ctx.sem.syms, sy)^.kind = DK_LET Then
            Begin
              LoadUndefined(ctx);
              StoreSym(ctx, sy, True);
            End;
        End
      Else If target <> 0 Then
        Begin
          GenExpr(ctx, init);
          t := AllocTemp(ctx);
          StoreTemp(ctx, t);
          BindTo(ctx, target, t, True);
        End;
      d := NodeP(ctx.ast.nodes, d)^.next;
    End;
End;

Procedure GenStmtList(Var ctx: TCompilerContext; n: LongInt); Forward;

{ ---- Controle de flux (TODO 11) ----

  Chaque structure recoit ses etiquettes uniques (_JSL_nnnn). Une pile
  de cibles de saut memorise, pour chaque boucle, switch ou instruction
  etiquetee, l'etiquette de break, celle de continue et ses noms
  d'etiquettes. Une condition constante est resolue a la compilation
  (while (1), if (0)...).

  for-in et for-of passent par le runtime : _JSRT_iter_new(valeur)
  cree un iterateur (tableau ou chaine), _JSRT_iter_next(iterateur)
  rend la valeur suivante ou la marque DONE ; for-in parcourt
  _JSRT_forin_keys(objet), le tableau des noms de proprietes. Les
  variables let capturees de l'en-tete d'un for recoivent une nouvelle
  cellule a chaque iteration (_JSRT_cell_copy). }

Procedure GenStmt(Var ctx: TCompilerContext; n: LongInt); Forward;

Procedure PushTarget(Var ctx: TCompilerContext; kind, brk, cont: LongInt);
Var
  i: LongInt;
Begin
  Inc(ctx.ir.jt_count);
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.kind := kind;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.brk := brk;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.cont := cont;
  JtP(ctx.ir.jt, ctx.ir.jt_count)^.nlabels := ctx.ir.plabel_count;
  For i := 1 To ctx.ir.plabel_count Do
    JtLabelP(JtP(ctx.ir.jt, ctx.ir.jt_count)^.labels, i)^ := PlabelP(ctx.ir.plabels, i)^;
  ctx.ir.plabel_count := 0;
End;

Procedure PopTarget(Var ctx: TCompilerContext);
Begin
  If ctx.ir.jt_count > 0 Then
    Dec(ctx.ir.jt_count);
End;

{ Cible d'un break ou continue : sans etiquette, la plus proche boucle
  (ou switch pour break) ; avec etiquette, celle qui la porte. }
Function FindTarget(Var ctx: TCompilerContext; label_tok: LongInt;
                    is_break: Boolean): LongInt;
Var
  i, j: LongInt;
Begin
  FindTarget := 0;
  For i := ctx.ir.jt_count Downto 1 Do
    Begin
      If label_tok = 0 Then
        Begin
          If (JtP(ctx.ir.jt, i)^.kind = JT_LOOP) Or
             (is_break And (JtP(ctx.ir.jt, i)^.kind = JT_SWITCH)) Then
            Begin
              FindTarget := i;
              Exit;
            End;
        End
      Else
        For j := 1 To JtP(ctx.ir.jt, i)^.nlabels Do
          If TokP(ctx.lex.tokens, JtLabelP(JtP(ctx.ir.jt, i)^.labels, j)^)^.text =
             TokP(ctx.lex.tokens, label_tok)^.text Then
            Begin
              FindTarget := i;
              Exit;
            End;
    End;
End;

{ Saute vers lfalse si la condition est fausse. }
Procedure GenCondJumpFalse(Var ctx: TCompilerContext; e, lfalse: LongInt);
Var
  c: TConst;
Begin
  If e = 0 Then
    Exit;
  If EvalConst(ctx, e, c) Then
    Begin
      If Not ConstTruthy(c) Then
        Emit1(ctx, OP_JMP, LabelOp(lfalse));
      Exit;
    End;
  GenExpr(ctx, e);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JE, LabelOp(lfalse));
End;

{ Saute vers ltrue si la condition est vraie. }
Procedure GenCondJumpTrue(Var ctx: TCompilerContext; e, ltrue: LongInt);
Var
  c: TConst;
Begin
  If e = 0 Then
    Begin
      Emit1(ctx, OP_JMP, LabelOp(ltrue));
      Exit;
    End;
  If EvalConst(ctx, e, c) Then
    Begin
      If ConstTruthy(c) Then
        Emit1(ctx, OP_JMP, LabelOp(ltrue));
      Exit;
    End;
  GenExpr(ctx, e);
  GenTruthy(ctx);
  Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
  Emit1(ctx, OP_JNE, LabelOp(ltrue));
End;

Procedure GenIf(Var ctx: TCompilerContext; n: LongInt);
Var
  els, done: LongInt;
Begin
  els := NewLabel(ctx);
  GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e1, els);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  If NodeP(ctx.ast.nodes, n)^.e3 <> 0 Then
    Begin
      done := NewLabel(ctx);
      Emit1(ctx, OP_JMP, LabelOp(done));
      PlaceLabel(ctx, els);
      GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e3);
      PlaceLabel(ctx, done);
    End
  Else
    PlaceLabel(ctx, els);
End;

Procedure GenWhile(Var ctx: TCompilerContext; n: LongInt);
Var
  top, brk: LongInt;
Begin
  top := NewLabel(ctx);
  brk := NewLabel(ctx);
  PlaceLabel(ctx, top);
  GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e1, brk);
  PushTarget(ctx, JT_LOOP, brk, top);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  PopTarget(ctx);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
End;

Procedure GenDoWhile(Var ctx: TCompilerContext; n: LongInt);
Var
  top, cont, brk: LongInt;
Begin
  top := NewLabel(ctx);
  cont := NewLabel(ctx);
  brk := NewLabel(ctx);
  PlaceLabel(ctx, top);
  PushTarget(ctx, JT_LOOP, brk, cont);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  PopTarget(ctx);
  PlaceLabel(ctx, cont);
  GenCondJumpTrue(ctx, NodeP(ctx.ast.nodes, n)^.e2, top);
  PlaceLabel(ctx, brk);
End;

{ Nouvelle cellule (copie) pour chaque variable de l'en-tete capturee. }
Procedure GenPerIterationCopy(Var ctx: TCompilerContext; sc: LongInt);
Var
  sy: LongInt;
Begin
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If (SymP(ctx.sem.syms, sy)^.flags And SF_PER_ITER <> 0) And
         (SymP(ctx.sem.syms, sy)^.flags And SF_CELL <> 0) Then
        Begin
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)));
          CallRt(ctx, 'cell_copy', 4);
          Emit(ctx, OP_MOV, MemReg(R_EBP, SlotDisp(SymP(ctx.sem.syms, sy)^.slot)),
               RegOp(R_EAX));
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
End;

Procedure GenFor(Var ctx: TCompilerContext; n: LongInt);
Var
  sc, top, cont, brk, init: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  top := NewLabel(ctx);
  cont := NewLabel(ctx);
  brk := NewLabel(ctx);
  GenScopeEnter(ctx, sc);
  init := NodeP(ctx.ast.nodes, n)^.e1;
  If init <> 0 Then
    Begin
      If NodeP(ctx.ast.nodes, init)^.kind = N_VAR_DECL Then
        GenVarDecl(ctx, init)
      Else
        GenExpr(ctx, init);
    End;
  PlaceLabel(ctx, top);
  If NodeP(ctx.ast.nodes, n)^.e2 <> 0 Then
    GenCondJumpFalse(ctx, NodeP(ctx.ast.nodes, n)^.e2, brk);
  PushTarget(ctx, JT_LOOP, brk, cont);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e4);
  PopTarget(ctx);
  PlaceLabel(ctx, cont);
  GenPerIterationCopy(ctx, sc);
  If NodeP(ctx.ast.nodes, n)^.e3 <> 0 Then
    GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
End;

{ for (x of valeur) et for (x in objet). }
Procedure GenForInOf(Var ctx: TCompilerContext; n: LongInt; is_of: Boolean);
Var
  sc, top, brk, iter, v, left, target: LongInt;
Begin
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  top := NewLabel(ctx);
  brk := NewLabel(ctx);
  iter := TempAcquire(ctx);
  v := TempAcquire(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e2);
  If Not is_of Then
    Begin
      Emit1(ctx, OP_PUSH, RegOp(R_EDX));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      CallRt(ctx, 'forin_keys', 8);
    End;
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'iter_new', 8);
  SaveTemp(ctx, iter);
  PlaceLabel(ctx, top);
  PushTemp(ctx, iter);
  CallRt(ctx, 'iter_next', 8);
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_DONE)));
  Emit1(ctx, OP_JE, LabelOp(brk));
  SaveTemp(ctx, v);
  { nouvelle portee (nouvelles cellules) a chaque iteration }
  GenScopeEnter(ctx, sc);
  LoadTemp(ctx, v);
  left := NodeP(ctx.ast.nodes, n)^.e1;
  If (left <> 0) And (NodeP(ctx.ast.nodes, left)^.kind = N_VAR_DECL) Then
    Begin
      target := NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, left)^.e1)^.e1;
      BindValue(ctx, target, True);
    End
  Else
    BindValue(ctx, left, False);
  PushTarget(ctx, JT_LOOP, brk, top);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e3);
  PopTarget(ctx);
  Emit1(ctx, OP_JMP, LabelOp(top));
  PlaceLabel(ctx, brk);
  TempRelease(ctx, v);
  TempRelease(ctx, iter);
End;

Procedure GenSwitch(Var ctx: TCompilerContext; n: LongInt);
Var
  t, brk, base, cs, i, ncases, dflt: LongInt;
Begin
  brk := NewLabel(ctx);
  ncases := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      Inc(ncases);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  base := ctx.ir.label_count + 1;
  Inc(ctx.ir.label_count, ncases);
  t := TempAcquire(ctx);
  GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  SaveTemp(ctx, t);
  GenScopeEnter(ctx, NodeP(ctx.ast.nodes, n)^.scope);
  { tests dans l'ordre : discriminant === valeur du case }
  dflt := 0;
  i := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      If NodeP(ctx.ast.nodes, cs)^.e1 = 0 Then
        dflt := base + i
      Else
        Begin
          GenExpr(ctx, NodeP(ctx.ast.nodes, cs)^.e1);
          GenBinaryCore(ctx, '===', t);
          Emit(ctx, OP_TEST, RegOp(R_EAX), RegOp(R_EAX));
          Emit1(ctx, OP_JNE, LabelOp(base + i));
        End;
      Inc(i);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  If dflt <> 0 Then
    Emit1(ctx, OP_JMP, LabelOp(dflt))
  Else
    Emit1(ctx, OP_JMP, LabelOp(brk));
  PushTarget(ctx, JT_SWITCH, brk, 0);
  i := 0;
  cs := NodeP(ctx.ast.nodes, n)^.e2;
  While cs <> 0 Do
    Begin
      PlaceLabel(ctx, base + i);
      GenStmtList(ctx, NodeP(ctx.ast.nodes, cs)^.e2);
      Inc(i);
      cs := NodeP(ctx.ast.nodes, cs)^.next;
    End;
  PopTarget(ctx);
  PlaceLabel(ctx, brk);
  TempRelease(ctx, t);
End;

{ ---- Exceptions (TODO 18) ----

  Un try ouvre un enregistrement de gestionnaire de 32 octets dans la
  trame (4 emplacements) : precedent +0, esp +4, ebp +8, adresse du
  catch +12, ebx +16, esi +20, edi +24. Il est chaine dans la variable
  du runtime handler_top. _JSRT_throw(valeur) range la valeur dans la
  variable exc, depile le gestionnaire, restaure esp, ebp, ebx, esi, edi
  et saute a l'adresse du catch. L'adresse est obtenue par l'astuce
  call / pop : le point de reprise est l'instruction jmp qui suit le
  call. Un return, break ou continue qui sort d'un try depile son
  gestionnaire et recopie le bloc finally a cet endroit. }

Function AllocHandler(Var ctx: TCompilerContext): LongInt;
Var
  a, b, c, d: LongInt;
Begin
  a := AllocTemp(ctx);
  b := AllocTemp(ctx);
  c := AllocTemp(ctx);
  d := AllocTemp(ctx);
  AllocHandler := SlotDisp(d);
End;

Procedure HandlerSetup(Var ctx: TCompilerContext; base, lcatch: LongInt);
Var
  lset: LongInt;
Begin
  lset := NewLabel(ctx);
  Emit1(ctx, OP_CALL, LabelOp(lset));
  Emit1(ctx, OP_JMP, LabelOp(lcatch));
  PlaceLabel(ctx, lset);
  Emit1(ctx, OP_POP, RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_CATCH), RegOp(R_EAX));
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_PREV), RegOp(R_EAX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_ESP), RegOp(R_ESP));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + RT_EH_EBP), RegOp(R_EBP));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 16), RegOp(R_EBX));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 20), RegOp(R_ESI));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 24), RegOp(R_EDI));
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'newtarget'), 0));
  Emit(ctx, OP_MOV, MemReg(R_EBP, base + 28), RegOp(R_EAX));
  Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, base));
  Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0), RegOp(R_EAX));
End;

Procedure HandlerPop(Var ctx: TCompilerContext; base: LongInt);
Begin
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, base + RT_EH_PREV));
  Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'handler_top'), 0), RegOp(R_EAX));
End;

Procedure TryPush(Var ctx: TCompilerContext; base, fin: LongInt);
Begin
  Inc(ctx.ir.try_count);
  TryRecP(ctx.ir.try_rec, ctx.ir.try_count)^ := base;
  TryFinP(ctx.ir.try_fin, ctx.ir.try_count)^ := fin;
  TryJtP(ctx.ir.try_jt, ctx.ir.try_count)^ := ctx.ir.jt_count;
End;

{ Sort des try dont l'etiquette de saut est jt >= mint : depile leur
  gestionnaire et execute leur finally (return : mint = 0). }
Procedure GenExitTries(Var ctx: TCompilerContext; mint: LongInt);
Var
  saved, i, fin, base: LongInt;
Begin
  saved := ctx.ir.try_count;
  i := saved;
  While (i >= 1) And (TryJtP(ctx.ir.try_jt, i)^ >= mint) Do
    Begin
      base := TryRecP(ctx.ir.try_rec, i)^;
      fin := TryFinP(ctx.ir.try_fin, i)^;
      HandlerPop(ctx, base);
      ctx.ir.try_count := i - 1;
      If fin <> 0 Then
        GenStmt(ctx, fin);
      Dec(i);
    End;
  ctx.ir.try_count := saved;
End;

Procedure GenTryCatch(Var ctx: TCompilerContext; n: LongInt);
Var
  base, lcatch, lend, cn, par, cnt: LongInt;
Begin
  base := AllocHandler(ctx);
  lcatch := NewLabel(ctx);
  lend := NewLabel(ctx);
  HandlerSetup(ctx, base, lcatch);
  TryPush(ctx, base, 0);
  GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  Dec(ctx.ir.try_count);
  HandlerPop(ctx, base);
  Emit1(ctx, OP_JMP, LabelOp(lend));
  PlaceLabel(ctx, lcatch);
  cn := NodeP(ctx.ast.nodes, n)^.e2;
  GenScopeEnter(ctx, NodeP(ctx.ast.nodes, cn)^.scope);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 4));
  { return() d'un generateur : la valeur sentinelle traverse les catch }
  cnt := NewLabel(ctx);
  Emit(ctx, OP_CMP, RegOp(R_EAX), AddrSym(SYMK_X, XSym(ctx, '_JSNO_function_proto')));
  Emit1(ctx, OP_JNE, LabelOp(cnt));
  Emit(ctx, OP_CMP, RegOp(R_EDX), ImmOp(TagImm(RT_T_OBJECT)));
  Emit1(ctx, OP_JNE, LabelOp(cnt));
  Emit1(ctx, OP_PUSH, RegOp(R_EDX));
  Emit1(ctx, OP_PUSH, RegOp(R_EAX));
  CallRt(ctx, 'throw', 8);
  PlaceLabel(ctx, cnt);
  par := NodeP(ctx.ast.nodes, cn)^.e1;
  If par <> 0 Then
    BindValue(ctx, par, True);
  If NodeP(ctx.ast.nodes, cn)^.e2 <> 0 Then
    GenStmtList(ctx, NodeP(ctx.ast.nodes, NodeP(ctx.ast.nodes, cn)^.e2)^.e1);
  PlaceLabel(ctx, lend);
End;

Procedure GenTry(Var ctx: TCompilerContext; n: LongInt);
Var
  base, lcatch, lend, tx, fin: LongInt;
Begin
  fin := NodeP(ctx.ast.nodes, n)^.e3;
  If fin = 0 Then
    Begin
      GenTryCatch(ctx, n);
      Exit;
    End;
  base := AllocHandler(ctx);
  lcatch := NewLabel(ctx);
  lend := NewLabel(ctx);
  HandlerSetup(ctx, base, lcatch);
  TryPush(ctx, base, fin);
  If NodeP(ctx.ast.nodes, n)^.e2 <> 0 Then
    GenTryCatch(ctx, n)
  Else
    GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  Dec(ctx.ir.try_count);
  HandlerPop(ctx, base);
  GenStmt(ctx, fin);
  Emit1(ctx, OP_JMP, LabelOp(lend));
  PlaceLabel(ctx, lcatch);
  tx := TempAcquire(ctx);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 0));
  Emit(ctx, OP_MOV, RegOp(R_EDX), MemSym(SYMK_D, RtVarSym(ctx, 'exc'), 4));
  SaveTemp(ctx, tx);
  GenStmt(ctx, fin);
  PushTemp(ctx, tx);
  CallRt(ctx, 'throw', 8);
  TempRelease(ctx, tx);
  PlaceLabel(ctx, lend);
End;

Procedure GenBreakContinue(Var ctx: TCompilerContext; n: LongInt; is_break: Boolean);
Var
  i: LongInt;
Begin
  i := FindTarget(ctx, NodeP(ctx.ast.nodes, n)^.e1, is_break);
  If i = 0 Then
    Begin
      PendingNote(ctx, n, 'cible de break/continue introuvable');
      Exit;
    End;
  GenExitTries(ctx, i);
  If is_break Then
    Emit1(ctx, OP_JMP, LabelOp(JtP(ctx.ir.jt, i)^.brk))
  Else
    Emit1(ctx, OP_JMP, LabelOp(JtP(ctx.ir.jt, i)^.cont));
End;

Procedure GenLabeled(Var ctx: TCompilerContext; n: LongInt);
Var
  inner, brk: LongInt;
Begin
  inner := NodeP(ctx.ast.nodes, n)^.e1;
  Inc(ctx.ir.plabel_count);
  PlabelP(ctx.ir.plabels, ctx.ir.plabel_count)^ := NodeP(ctx.ast.nodes, n)^.tok;
  If (inner <> 0) And
     ((NodeP(ctx.ast.nodes, inner)^.kind = N_WHILE) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_DO_WHILE) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR_IN) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_FOR_OF) Or (NodeP(ctx.ast.nodes, inner)^.kind = N_SWITCH) Or
      (NodeP(ctx.ast.nodes, inner)^.kind = N_LABELED)) Then
    GenStmt(ctx, inner)
  Else
    Begin
      { instruction etiquetee quelconque : seul break etiquete est permis }
      brk := NewLabel(ctx);
      PushTarget(ctx, JT_BLOCK, brk, 0);
      GenStmt(ctx, inner);
      PopTarget(ctx);
      PlaceLabel(ctx, brk);
    End;
End;

Procedure GenStmt(Var ctx: TCompilerContext; n: LongInt);
Var
  tx: LongInt;
Begin
  If n = 0 Then
    Exit;
  ctx.ir.cur_line := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_VAR_DECL:
      GenVarDecl(ctx, n);
    N_EXPR_STMT:
      GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
    N_CLASS_DECL:
      GenClass(ctx, n);
    N_EMPTY, N_FUNC_DECL:
      ;
    N_DEBUGGER:
      Emit0(ctx, OP_NOP);
    N_BLOCK:
      Begin
        If NodeP(ctx.ast.nodes, n)^.flags <> 1 Then
          GenScopeEnter(ctx, NodeP(ctx.ast.nodes, n)^.scope);
        GenStmtList(ctx, NodeP(ctx.ast.nodes, n)^.e1);
      End;
    N_RETURN:
      Begin
        If NodeP(ctx.ast.nodes, n)^.e1 <> 0 Then
          GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1)
        Else
          LoadUndefined(ctx);
        If ctx.ir.try_count > 0 Then
          Begin
            tx := TempAcquire(ctx);
            SaveTemp(ctx, tx);
            GenExitTries(ctx, 0);
            LoadTemp(ctx, tx);
            TempRelease(ctx, tx);
          End;
        Emit0(ctx, OP_LEAVE);
        Emit0(ctx, OP_RET);
      End;
    N_THROW:
      Begin
        GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Emit1(ctx, OP_PUSH, RegOp(R_EDX));
        Emit1(ctx, OP_PUSH, RegOp(R_EAX));
        CallRt(ctx, 'throw', 8);
      End;
    N_TRY:
      GenTry(ctx, n);
    N_IF:
      GenIf(ctx, n);
    N_WHILE:
      GenWhile(ctx, n);
    N_DO_WHILE:
      GenDoWhile(ctx, n);
    N_FOR:
      GenFor(ctx, n);
    N_FOR_IN:
      GenForInOf(ctx, n, False);
    N_FOR_OF:
      GenForInOf(ctx, n, True);
    N_SWITCH:
      GenSwitch(ctx, n);
    N_BREAK:
      GenBreakContinue(ctx, n, True);
    N_CONTINUE:
      GenBreakContinue(ctx, n, False);
    N_LABELED:
      GenLabeled(ctx, n);
  Else
    PendingNote(ctx, n, NodeKindName(NodeP(ctx.ast.nodes, n)^.kind));
  End;
End;

Procedure GenStmtList(Var ctx: TCompilerContext; n: LongInt);
Begin
  While n <> 0 Do
    Begin
      GenStmt(ctx, n);
      n := NodeP(ctx.ast.nodes, n)^.next;
    End;
End;

{ ---- Procedures ---- }

{ Symbole de donnees d'une variable du runtime (_JSRT_v_nom). }
Function RtVarSym(Var ctx: TCompilerContext; Const name: TString): LongInt;
Var
  i: LongInt;
Begin
  i := DsymFind(ctx, SymRt('v_' + name));
  If (i <> 0) And (DsymP(ctx.data.syms, i)^.sec <> SEC_DATA) Then
    i := 0;
  RtVarSym := i;
End;

Procedure BeginProc(Var ctx: TCompilerContext; Const name: TString; fs: LongInt);
Var
  xs, ok: LongInt;
Begin
  xs := XSym(ctx, name);
  XsymP(ctx.ir.xsyms, xs)^.defined := True;
  Inc(ctx.ir.proc_count);
  ctx.ir.cg_fs := fs;
  ctx.ir.tmp_free_count := 0;
  ctx.ir.jt_count := 0;
  ctx.ir.try_count := 0;
  ctx.ir.plabel_count := 0;
  ctx.ir.in_chain := False;
  Emit1(ctx, OP_PROC, AddrSym(SYMK_X, xs));
  Emit1(ctx, OP_PUSH, RegOp(R_EBP));
  Emit(ctx, OP_MOV, RegOp(R_EBP), RegOp(R_ESP));
  Emit(ctx, OP_SUB, RegOp(R_ESP), ImmOp(0));
  ctx.ir.frame_patch := ctx.ir.count;
  If fs <> 1 Then
    Begin
      { depassement de pile : RangeError }
      ok := NewLabel(ctx);
      Emit(ctx, OP_CMP, RegOp(R_ESP),
           MemSym(SYMK_D, RtVarSym(ctx, 'stack_limit'), 0));
      Emit1(ctx, OP_JAE, LabelOp(ok));
      CallRt(ctx, 'stack_overflow', 0);
      PlaceLabel(ctx, ok);
    End;
End;

Procedure EndProc(Var ctx: TCompilerContext);
Begin
  LoadUndefined(ctx);
  Emit0(ctx, OP_LEAVE);
  Emit0(ctx, OP_RET);
  Emit1(ctx, OP_ENDP, NoOp);
  { taille definitive de la trame }
  InstrP(ctx.ir.instrs, ctx.ir.frame_patch)^.b.disp :=
    RT_VALUE_SIZE * ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots;
  ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.frame_size :=
    RT_VALUE_SIZE * ScopeP(ctx.sem.scopes, ctx.ir.cg_fs)^.nslots;
End;

{ Charge l'argument i (undefined s'il n'a pas ete fourni). }
Procedure LoadArg(Var ctx: TCompilerContext; i: LongInt);
Var
  have, done: LongInt;
Begin
  have := NewLabel(ctx);
  done := NewLabel(ctx);
  Emit(ctx, OP_CMP, MemReg(R_EBP, RT_FRAME_ARGC), ImmOp(i + 1));
  Emit1(ctx, OP_JAE, LabelOp(have));
  LoadUndefined(ctx);
  Emit1(ctx, OP_JMP, LabelOp(done));
  PlaceLabel(ctx, have);
  Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS + RT_VALUE_SIZE * i));
  Emit(ctx, OP_MOV, RegOp(R_EDX),
       MemReg(R_EBP, RT_FRAME_ARGS + RT_VALUE_SIZE * i + 4));
  PlaceLabel(ctx, done);
End;

Procedure GenParams(Var ctx: TCompilerContext; fn: LongInt);
Var
  p, i, target: LongInt;
Begin
  p := NodeP(ctx.ast.nodes, fn)^.e1;
  i := 0;
  While p <> 0 Do
    Begin
      target := NodeP(ctx.ast.nodes, p)^.e1;
      If NodeP(ctx.ast.nodes, p)^.flags And PF_REST <> 0 Then
        Begin
          Emit1(ctx, OP_PUSH, ImmOp(i));
          Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
          CallRt(ctx, 'args_rest', 12);
        End
      Else
        Begin
          LoadArg(ctx, i);
          GenDefault(ctx, NodeP(ctx.ast.nodes, p)^.e2);
        End;
      BindValue(ctx, target, True);
      Inc(i);
      p := NodeP(ctx.ast.nodes, p)^.next;
    End;
End;

{ Procedure d'une fonction, d'une methode, d'un initialiseur de champ ou
  d'un bloc statique decrit par le descripteur fd. }
Procedure GenFuncProc(Var ctx: TCompilerContext; fd: LongInt);
Var
  n, sc, sy, body: LongInt;
Begin
  n := FdescP(ctx.data.fdescs, fd)^.node;
  sc := NodeP(ctx.ast.nodes, n)^.scope;
  BeginProc(ctx, FdescP(ctx.data.fdescs, fd)^.code_sym, sc);
  ctx.ir.cur_line := TokP(ctx.lex.tokens, NodeP(ctx.ast.nodes, n)^.tok)^.line;
  If FdescP(ctx.data.fdescs, fd)^.flags And (FDF_GENERATOR Or FDF_ASYNC) <> 0 Then
    Begin
      { generateur / async : l'appel cree la coroutine ; le corps s'execute lors de la
        premiere reprise (drapeau genflag positionne par la coroutine) }
      body := NewLabel(ctx);
      Emit(ctx, OP_CMP, MemSym(SYMK_D, RtVarSym(ctx, 'genflag'), 0), ImmOp(0));
      Emit1(ctx, OP_JNE, LabelOp(body));
      Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
      Emit1(ctx, OP_PUSH, RegOp(R_EAX));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS + 4));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      If FdescP(ctx.data.fdescs, fd)^.flags And FDF_GENERATOR <> 0 Then
        Emit1(ctx, OP_PUSH, ImmOp(0))
      Else
        Emit1(ctx, OP_PUSH, ImmOp(1));
      CallRt(ctx, 'gen_new', 24);
      Emit0(ctx, OP_LEAVE);
      Emit0(ctx, OP_RET);
      PlaceLabel(ctx, body);
      Emit(ctx, OP_MOV, MemSym(SYMK_D, RtVarSym(ctx, 'genflag'), 0), ImmOp(0));
    End;
  EmitComment(ctx, 'fonction ' + StrText(ctx, FdescP(ctx.data.fdescs, fd)^.name_str) +
              ' (' + SymFdesc(fd) + ')');
  If (NodeP(ctx.ast.nodes, n)^.kind = N_METHOD) And
     ((ScopeP(ctx.sem.scopes, sc)^.fkind = FK_CTOR) Or
      (ScopeP(ctx.sem.scopes, sc)^.fkind = FK_DERIVED_CTOR)) Then
    Begin
      { un constructeur de classe exige new }
      Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
      CallRt(ctx, 'class_call_check', 4);
    End;
  GenScopeEnter(ctx, sc);
  { nom d'une expression de fonction : la closure elle-meme }
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_FNAME Then
        Begin
          Emit(ctx, OP_MOV, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_CLOSURE));
          Emit(ctx, OP_MOV, RegOp(R_EDX), ImmOp(TagImm(RT_T_FUNCTION)));
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  sy := ScopeP(ctx.sem.scopes, sc)^.first_sym;
  While sy <> 0 Do
    Begin
      If SymP(ctx.sem.syms, sy)^.kind = DK_ARGS Then
        Begin
          Emit(ctx, OP_LEA, RegOp(R_EAX), MemReg(R_EBP, RT_FRAME_ARGS));
          Emit1(ctx, OP_PUSH, RegOp(R_EAX));
          Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_ARGC));
          CallRt(ctx, 'make_arguments', 8);
          StoreSym(ctx, sy, True);
        End;
      sy := SymP(ctx.sem.syms, sy)^.next;
    End;
  Case NodeP(ctx.ast.nodes, n)^.kind Of
    N_FUNC_DECL, N_FUNC_EXPR, N_METHOD:
      Begin
        GenParams(ctx, n);
        If (NodeP(ctx.ast.nodes, n)^.kind = N_METHOD) And
           (ScopeP(ctx.sem.scopes, sc)^.fkind = FK_CTOR) Then
          Begin
            { constructeur de base : champs d'instance avant le corps }
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS + 4));
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_THIS));
            Emit1(ctx, OP_PUSH, MemReg(R_EBP, RT_FRAME_CLOSURE));
            CallRt(ctx, 'init_fields', 12);
          End;
        body := NodeP(ctx.ast.nodes, n)^.e2;
        If (NodeP(ctx.ast.nodes, n)^.kind = N_FUNC_EXPR) And
           (NodeP(ctx.ast.nodes, n)^.flags And FN_EXPR_BODY <> 0) Then
          Begin
            { corps expression d'une fleche : sa valeur est le resultat }
            GenExpr(ctx, body);
            Emit0(ctx, OP_LEAVE);
            Emit0(ctx, OP_RET);
          End
        Else
          GenStmtList(ctx, NodeP(ctx.ast.nodes, body)^.e1);
      End;
    N_FIELD:
      Begin
        GenExpr(ctx, NodeP(ctx.ast.nodes, n)^.e1);
        Emit0(ctx, OP_LEAVE);
        Emit0(ctx, OP_RET);
      End;
    N_STATIC_BLOCK:
      GenStmt(ctx, NodeP(ctx.ast.nodes, n)^.e1);
  End;
  EndProc(ctx);
End;

Procedure EmitRuntime(Var ctx: TCompilerContext); Forward;

Function BuildIR(Var ctx: TCompilerContext): Boolean;
Var
  i: LongInt;
Begin
  BuildIR := False;
  If Not ctx.data.built Then
    Begin
      PipelineError(ctx, 'pool de donnees absent avant la generation du code');
      Exit;
    End;
  ctx.ir.count := 0;
  ctx.ir.xsym_count := 0;
  DlClear(ctx.ir.xhash);
  ctx.ir.comment_count := 0;
  ctx.ir.label_count := 0;
  ctx.ir.proc_count := 0;
  ctx.ir.pending_count := 0;
  ctx.ir.failed := False;
  ctx.ir.cur_line := 1;
  LayoutFrames(ctx);

  { programme principal : portee globale }
  BeginProc(ctx, SymRt('main'), 1);
  EmitComment(ctx, 'programme principal');
  GenScopeEnter(ctx, 1);
  CallRt(ctx, 'prelude_init', 0);
  GenStmtList(ctx, NodeP(ctx.ast.nodes, ctx.ast.root)^.e1);
  CallRt(ctx, 'prelude_run', 0);
  EndProc(ctx);

  For i := 1 To ctx.data.fd_count Do
    If Not ctx.ir.failed Then
      GenFuncProc(ctx, i);

  If Not ctx.ir.failed Then
    EmitRuntime(ctx);
  ctx.ir.built := Not ctx.ir.failed;
  If ctx.options.verbose Then
    Writeln('Code   : ', ctx.ir.proc_count, ' procedures, ', ctx.ir.count,
            ' instructions, ', ctx.ir.pending_count,
            ' constructions en attente');
  BuildIR := ctx.ir.built And (ctx.errors = 0);
End;

{ ---- Affichage de l'IR (option -ir) ---- }

Function HexU(v: Int64): TString;
Const
  H = '0123456789ABCDEF';
Var
  s: TString;
  i: Integer;
Begin
  v := v And $FFFFFFFF;
  s := '';
  For i := 1 To 8 Do
    Begin
      s := H[(v And 15) + 1] + s;
      v := v Shr 4;
    End;
  HexU := s;
End;

Function ImmText(v: LongInt): TString;
Var
  s: String[12];
Begin
  If (v > -65536) And (v < 1048576) Then
    Begin
      Str(v, s);
      ImmText := s;
    End
  Else
    ImmText := '0' + HexU(v) + 'h';
End;

Function RegName(r: TReg): TString;
Begin
  Case r Of
    R_EAX: RegName := 'eax';
    R_ECX: RegName := 'ecx';
    R_EDX: RegName := 'edx';
    R_EBX: RegName := 'ebx';
    R_ESP: RegName := 'esp';
    R_EBP: RegName := 'ebp';
    R_ESI: RegName := 'esi';
    R_EDI: RegName := 'edi';
    R_CL:  RegName := 'cl';
    R_AL:  RegName := 'al';
    R_DL:  RegName := 'dl';
    R_BL:  RegName := 'bl';
  Else
    RegName := '?';
  End;
End;

Function SymNameOf(Var ctx: TCompilerContext; symkind, sym: LongInt): TString;
Begin
  If symkind = SYMK_D Then
    SymNameOf := DsymP(ctx.data.syms, sym)^.name
  Else
    SymNameOf := XsymP(ctx.ir.xsyms, sym)^.name;
End;

Function DispText(d: LongInt): TString;
Var
  s: String[12];
Begin
  If d = 0 Then
    DispText := ''
  Else If d > 0 Then
    Begin
      Str(d, s);
      DispText := '+' + s;
    End
  Else
    Begin
      Str(d, s);
      DispText := s;
    End;
End;

Function OperandText(Var ctx: TCompilerContext; Var o: TOperand): TString;
Var
  pfx, inner: TString;
Begin
  Case o.kind Of
    OD_REG:
      OperandText := RegName(o.reg);
    OD_IMM:
      OperandText := ImmText(o.disp);
    OD_MEM:
      Begin
        Begin
          If o.size = 1 Then
            pfx := 'byte ptr ['
          Else If o.size = 2 Then
            pfx := 'word ptr ['
          Else If o.size = 8 Then
            pfx := 'qword ptr ['
          Else
            pfx := 'dword ptr [';
          inner := '';
          If o.base <> R_NONE Then
            inner := RegName(o.base);
          If o.index <> R_NONE Then
            Begin
              If inner <> '' Then
                inner := inner + '+';
              inner := inner + RegName(o.index);
            End;
          If o.symkind <> 0 Then
            Begin
              If inner <> '' Then
                inner := inner + '+';
              inner := inner + SymNameOf(ctx, o.symkind, o.sym);
            End;
          OperandText := pfx + inner + DispText(o.disp) + ']';
        End;
      End;
    OD_ADDR:
      OperandText := 'offset ' + SymNameOf(ctx, o.symkind, o.sym);
    OD_LABEL:
      OperandText := SymLabel(o.disp);
  Else
    OperandText := '';
  End;
End;

