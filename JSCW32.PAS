  A('proc _JSRT_class_proto');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+8]');
  A('push offset ' + RtStr('prototype'));
  A('push dword ptr [eax+$FN_PROPS]');
  A('call _JSRT_prop_find');
  A('add esp, 8');
  A('mov edx, dword ptr [eax+12]');
  A('mov eax, dword ptr [eax+8]');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_class_member(accueil, cle, fonction, genre) : methode ou accesseur }
  FBegin('_JSRT_class_member', 0);
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jne .fnhome');
  A('mov esi, dword ptr [ebp+8]');
  A('jmp .have');
  A('.fnhome:');
  A('mov eax, dword ptr [ebp+8]');
  A('mov esi, dword ptr [eax+$FN_PROPS]');
  A('.have:');
  A('mov eax, dword ptr [ebp+20]');
  A('mov ecx, dword ptr [ebp+8]');
  A('mov dword ptr [eax+$FN_THIS], ecx');
  A('mov ecx, dword ptr [ebp+12]');
  A('mov dword ptr [eax+$FN_THIS+4], ecx');
  A('mov ecx, dword ptr [ebp+28]');
  A('test ecx, ecx');
  A('jnz .acc');
  A('push dword ptr [ebp+24]');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push esi');
  A('call _JSRT_obj_define');
  A('add esp, 16');
  A('jmp .hide');
  A('.acc:');
  A('dec ecx');
  A('push ecx');
  A('push dword ptr [ebp+24]');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push esi');
  A('call _JSRT_obj_define_acc');
  A('add esp, 20');
  A('.hide:');
  A('push dword ptr [ebp+16]');
  A('push esi');
  A('call _JSRT_obj_hide');
  A('add esp, 8');
  FEnd;

  { _JSRT_class_field(prototype, cle, initialiseur) : enregistre un champ d'instance }
  FBegin('_JSRT_class_field', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('push offset ' + RtStr('#fields'));
  A('push esi');
  A('call _JSRT_prop_find');
  A('add esp, 8');
  A('test eax, eax');
  A('jnz .have');
  A('call _JSRT_array_new');
  A('mov ebx, eax');
  A('push $ARR');
  A('push ebx');
  A('push 1');
  A('push offset ' + RtStr('#fields'));
  A('push esi');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  A('jmp .push');
  A('.have:');
  A('mov ebx, dword ptr [eax+8]');
  A('.push:');
  PushToArrLocal('$STR', 'dword ptr [ebp+16]', 'ebx');
  A('push dword ptr [ebp+24]');
  A('push dword ptr [ebp+20]');
  A('push $ARR');
  A('push ebx');
  A('call _JSRT_array_push');
  A('add esp, 16');
  FEnd;

  { _JSRT_class_static(classe, cle, initialiseur) : champ statique }
  FBegin('_JSRT_class_static', 0);
  A('mov eax, dword ptr [ebp+8]');
  A('mov esi, dword ptr [eax+$FN_PROPS]');
  A('cmp dword ptr [ebp+24], $FN');
  A('jne .undef');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [ebp+20]');
  A('call _JSRT_call0');
  A('add esp, 12');
  A('jmp .def');
  A('.undef:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('.def:');
  A('push edx');
  A('push eax');
  A('push dword ptr [ebp+16]');
  A('push esi');
  A('call _JSRT_obj_define');
  A('add esp, 16');
  FEnd;

  { _JSRT_class_block(classe, fonction) : bloc statique }
  FBegin('_JSRT_class_block', 0);
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_call0');
  A('add esp, 12');
  FEnd;

  { _JSRT_obj_set_proto_lit(objet, valeur) : cle __proto__ d un litteral objet }
  A('proc _JSRT_obj_set_proto_lit');
  A('push ebp');
  A('mov ebp, esp');
  A('mov edx, dword ptr [ebp+8]');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jne .nobj');
  A('mov eax, dword ptr [ebp+16]');
  A('mov dword ptr [edx+$OBJ_PROTO], eax');
  A('jmp .r');
  A('.nobj:');
  A('cmp dword ptr [ebp+20], $NULL');
  A('jne .r');
  A('mov dword ptr [edx+$OBJ_PROTO], 0');
  A('.r:');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_super_get(fermeture, cle, this) : super.cle }
  FBegin('_JSRT_super_get', 0);
  A('mov esi, dword ptr [ebp+8]');
  A('mov ecx, dword ptr [esi+$FN_DESC]');
  A('mov edx, dword ptr [ecx+8]');
  A('test edx, ' + IntToStr(FDF_CTOR));
  A('jnz .ctor');
  A('cmp dword ptr [esi+$FN_THIS+4], $OBJ');
  A('jne .fnhome');
  A('mov esi, dword ptr [esi+$FN_THIS]');
  A('jmp .parent');
  A('.fnhome:');
  A('cmp dword ptr [esi+$FN_THIS+4], $FN');
  A('jne .undef');
  A('mov esi, dword ptr [esi+$FN_THIS]');
  A('mov esi, dword ptr [esi+$FN_PROPS]');
  A('test esi, esi');
  A('jz .undef');
  A('jmp .parent');
  A('.ctor:');
  A('mov eax, dword ptr [esi+$FN_PROPS]');
  A('test eax, eax');
  A('jz .undef');
  A('push offset ' + RtStr('prototype'));
  A('push eax');
  A('call _JSRT_prop_find');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .undef');
  A('mov esi, dword ptr [eax+8]');
  A('.parent:');
  A('mov esi, dword ptr [esi+$OBJ_PROTO]');
  A('test esi, esi');
  A('jz .undef');
  A('push dword ptr [ebp+12]');
  A('push esi');
  A('call _JSRT_prop_lookup');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .undef');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push eax');
  A('call _JSRT_prop_get');
  A('add esp, 12');
  A('jmp .ret');
  A('.undef:');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  FEnd;
End;

{ ---- Exceptions : runtime (TODO 18) ---- }

Const
  ErrKinds: Array[1..7] Of String[16] = (
    'Error', 'TypeError', 'RangeError', 'SyntaxError', 'ReferenceError',
    'EvalError', 'URIError');

{ Constructeur natif d'une classe d'erreur : remplit this s'il est un objet
  (appel par super(...) d'une classe derivee) sinon cree l'objet. }
Procedure ErrCtor(Const code, kind: TString);
Begin
  FBegin(code, 0);
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jne .new');
  A('mov ebx, dword ptr [ebp+16]');
  A('jmp .have');
  A('.new:');
  A('push offset _JSNO_' + kind + '_proto');
  A('call _JSRT_obj_new_proto');
  A('add esp, 4');
  A('mov ebx, eax');
  A('.have:');
  A('cmp dword ptr [ebp+12], 1');
  A('jb .nomsg');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + '], $UNDEF');
  A('je .nomsg');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 4) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS) + ']');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push $STR');
  A('push eax');
  A('push 1');
  A('push offset ' + RtStr('message'));
  A('push ebx');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  A('.nomsg:');
  A('cmp dword ptr [ebp+12], 2');
  A('jb .st');
  A('cmp dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + '], $OBJ');
  A('jne .st');
  A('push offset ' + RtStr('cause'));
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('call _JSRT_has_own');
  A('add esp, 12');
  A('test eax, eax');
  A('jz .st');
  A('push offset ' + RtStr('cause'));
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 12) + ']');
  A('push dword ptr [ebp+' + IntToStr(RT_FRAME_ARGS + 8) + ']');
  A('call _JSRT_get_named');
  A('add esp, 12');
  A('push edx');
  A('push eax');
  A('push 1');
  A('push offset ' + RtStr('cause'));
  A('push ebx');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  A('.st:');
  A('push ebx');
  A('call _JSRT_err_stack');
  A('add esp, 4');
  A('mov eax, ebx');
  A('mov edx, $OBJ');
  FEnd;
End;

Procedure RtErrors;
Var
  k: LongInt;
Begin
  { _JSRT_err_stack(erreur) : propriete cachee stack = toString + une ligne par
    fonction JavaScript active (nom, fichier, ligne). Les trames sont suivies par la
    chaine EBP ; une trame est une fonction utilisateur si l'adresse de retour de son
    appelee est dans [_JSRT_main, _JSRT_utext_end) ; sa fermeture est en [EBP+8] et
    la ligne courante en [EBP-8]. }
  FBegin('_JSRT_err_stack', 1);
  A('call _JSRT_sb_new');
  A('mov ebx, eax');
  A('push $OBJ');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push eax');
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('mov ' + Lv(1) + ', 0');
  A('mov esi, ebp');
  A('.fr:');
  A('mov ecx, dword ptr [esi+4]');
  A('mov edi, dword ptr [esi]');
  A('cmp edi, esi');
  A('jbe .done');
  A('cmp ecx, offset _JSRT_main');
  A('jb .nx');
  A('cmp ecx, offset _JSRT_utext_end');
  A('jae .nx');
  A('mov eax, dword ptr [edi-8]');
  A('and eax, 0x3FFFFFFF');
  A('jz .nx');
  A('cmp ' + Lv(1) + ', 10');
  A('jae .done');
  A('inc ' + Lv(1));
  A('push offset ' + RtStr(#10 + '    at '));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  { nom }
  A('test dword ptr [edi-8], 0x40000000');
  A('jnz .main');
  A('mov eax, dword ptr [edi+8]');
  A('cmp byte ptr [eax], $OK_FUNCTION');
  A('jne .anon');
  A('mov ecx, dword ptr [eax+$FN_DESC]');
  A('mov edx, dword ptr [ecx+8]');
  A('mov ecx, dword ptr [ecx]');
  A('test ecx, ecx');
  A('jz .anon');
  A('cmp dword ptr [ecx+$STR_LEN], 0');
  A('je .anon');
  A('test edx, ' + IntToStr(FDF_CTOR));
  A('jz .nm');
  A('push ecx');
  A('push offset ' + RtStr('new '));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('pop ecx');
  A('.nm:');
  A('push ecx');
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('push offset ' + RtStr(' ('));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('jmp .loc');
  A('.main:');
  A('push offset ' + RtStr('Object.<anonymous> ('));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('jmp .loc');
  A('.anon:');
  A('push offset ' + RtStr('<anonymous> ('));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('.loc:');
  A('push offset ' + RtStr(asm_ctx^.source_name + ':'));
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('mov eax, dword ptr [edi-8]');
  A('and eax, 0x3FFFFFFF');
  A('push eax');
  A('call _JSRT_int_to_str');
  A('add esp, 4');
  A('push eax');
  A('push ebx');
  A('call _JSRT_sb_add');
  A('add esp, 8');
  A('push 41');
  A('push ebx');
  A('call _JSRT_sb_addb');
  A('add esp, 8');
  A('.nx:');
  A('mov esi, edi');
  A('jmp .fr');
  A('.done:');
  A('push ebx');
  A('call _JSRT_sb_str');
  A('add esp, 4');
  A('push $STR');
  A('push eax');
  A('push 1');
  A('push offset ' + RtStr('stack'));
  A('push dword ptr [ebp+8]');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  FEnd;

  { _JSRT_make_error(prototype, message) -> objet erreur }
  FBegin('_JSRT_make_error', 0);
  A('push dword ptr [ebp+8]');
  A('call _JSRT_obj_new_proto');
  A('add esp, 4');
  A('mov ebx, eax');
  A('push $STR');
  A('push dword ptr [ebp+12]');
  A('push 1');
  A('push offset ' + RtStr('message'));
  A('push ebx');
  A('call _JSRT_obj_add');
  A('add esp, 20');
  A('push ebx');
  A('call _JSRT_err_stack');
  A('add esp, 4');
  A('mov eax, ebx');
  FEnd;

  { _JSRT_throw_msg(prototype, message) : leve une erreur }
  A('proc _JSRT_throw_msg');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_make_error');
  A('add esp, 8');
  A('push $OBJ');
  A('push eax');
  A('call _JSRT_throw');
  A('endp');

  { _JSRT_throw_tdz(nom) : ReferenceError }
  A('proc _JSRT_throw_tdz');
  A('push ebp');
  A('mov ebp, esp');
  A('push $STR');
  A('push offset ' + RtStr(' ne peut pas etre utilise avant son initialisation'));
  A('push $STR');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push eax');
  A('push offset _JSNO_ReferenceError_proto');
  A('call _JSRT_throw_msg');
  A('endp');

  { _JSRT_fatal(message C) : leve TypeError, RangeError... selon le prefixe }
  FBegin('_JSRT_fatal', 1);
  A('mov esi, dword ptr [ebp+8]');
  A('cmp esi, offset _JSRT_c_oom');
  A('jne .go');
  A('push esi');
  A('call _JSRT_die');
  A('.go:');
  A('mov ' + Lv(1) + ', offset _JSNO_Error_proto');
  A('movzx eax, byte ptr [esi]');
  A('cmp eax, 84');
  A('jne .n1');
  A('mov ' + Lv(1) + ', offset _JSNO_TypeError_proto');
  A('jmp .msg');
  A('.n1:');
  A('cmp eax, 82');
  A('jne .n2');
  A('movzx eax, byte ptr [esi+1]');
  A('cmp eax, 97');
  A('jne .ref');
  A('mov ' + Lv(1) + ', offset _JSNO_RangeError_proto');
  A('jmp .msg');
  A('.ref:');
  A('mov ' + Lv(1) + ', offset _JSNO_ReferenceError_proto');
  A('jmp .msg');
  A('.n2:');
  A('cmp eax, 83');
  A('jne .msg');
  A('mov ' + Lv(1) + ', offset _JSNO_SyntaxError_proto');
  A('.msg:');
  A('mov ebx, esi');
  A('.f:');
  A('movzx eax, byte ptr [ebx]');
  A('test eax, eax');
  A('jz .nocolon');
  A('cmp eax, 58');
  A('je .col');
  A('inc ebx');
  A('jmp .f');
  A('.col:');
  A('inc ebx');
  A('cmp byte ptr [ebx], 32');
  A('jne .ms');
  A('inc ebx');
  A('jmp .ms');
  A('.nocolon:');
  A('mov ebx, esi');
  A('.ms:');
  A('mov ecx, ebx');
  A('.l:');
  A('cmp byte ptr [ecx], 0');
  A('je .e');
  A('inc ecx');
  A('jmp .l');
  A('.e:');
  A('sub ecx, ebx');
  A('jz .mk');
  A('cmp byte ptr [ebx+ecx-1], 10');
  A('jne .mk');
  A('dec ecx');
  A('.mk:');
  A('push ecx');
  A('push ecx');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('pop ecx');
  A('mov edi, eax');
  A('add edi, $STR_DATA');
  A('mov esi, ebx');
  A('push eax');
  A('rep movsb');
  A('pop eax');
  A('push eax');
  A('push ' + Lv(1));
  A('call _JSRT_throw_msg');
  FEnd;

  { _JSRT_throw(valeur) : saute au gestionnaire le plus recent }
  A('proc _JSRT_throw');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+8]');
  A('mov dword ptr [_JSRT_v_exc], eax');
  A('mov eax, dword ptr [ebp+12]');
  A('mov dword ptr [_JSRT_v_exc+4], eax');
  A('mov ecx, dword ptr [_JSRT_v_handler_top]');
  A('test ecx, ecx');
  A('jz .uncaught');
  A('mov eax, dword ptr [ecx]');
  A('mov dword ptr [_JSRT_v_handler_top], eax');
  A('mov ebx, dword ptr [ecx+16]');
  A('mov esi, dword ptr [ecx+20]');
  A('mov edi, dword ptr [ecx+24]');
  A('mov eax, dword ptr [ecx+28]');
  A('mov dword ptr [_JSRT_v_newtarget], eax');
  A('mov eax, dword ptr [ecx+12]');
  A('mov esp, dword ptr [ecx+4]');
  A('mov ebp, dword ptr [ecx+8]');
  A('jmp eax');
  A('.uncaught:');
  A('push offset _JSRT_c_uncaught');
  A('push dword ptr [_JSRT_v_stderr]');
  A('call _JSRT_write_cstr');
  A('add esp, 8');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('push dword ptr [eax+$STR_LEN]');
  A('add eax, $STR_DATA');
  A('push eax');
  A('push dword ptr [_JSRT_v_stderr]');
  A('call _JSRT_write');
  A('add esp, 12');
  A('push offset _JSRT_c_nl');
  A('push dword ptr [_JSRT_v_stderr]');
  A('call _JSRT_write_cstr');
  A('add esp, 8');
  A('push 1');
  A('call dword ptr [__imp__ExitProcess@4]');
  A('endp');

  { Error.prototype.toString }
  FBegin('_JSRT_err_toString', 0);
  A('push offset ' + RtStr('name'));
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_get_named');
  A('add esp, 12');
  A('cmp edx, $UNDEF');
  A('jne .nm');
  A('mov eax, offset ' + RtStr('Error'));
  A('mov edx, $STR');
  A('.nm:');
  A('push edx');
  A('push eax');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('mov ebx, eax');
  A('push offset ' + RtStr('message'));
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_get_named');
  A('add esp, 12');
  A('cmp edx, $UNDEF');
  A('jne .ms');
  A('mov eax, offset ' + RtStr(''));
  A('mov edx, $STR');
  A('.ms:');
  A('push edx');
  A('push eax');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('mov esi, eax');
  A('cmp dword ptr [esi+$STR_LEN], 0');
  A('jne .m1');
  A('mov eax, ebx');
  A('mov edx, $STR');
  A('jmp .ret');
  A('.m1:');
  A('cmp dword ptr [ebx+$STR_LEN], 0');
  A('jne .m2');
  A('mov eax, esi');
  A('mov edx, $STR');
  A('jmp .ret');
  A('.m2:');
  A('push $STR');
  A('push offset ' + RtStr(': '));
  A('push $STR');
  A('push ebx');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('push $STR');
  A('push esi');
  A('push $STR');
  A('push eax');
  A('call _JSRT_concat');
  A('add esp, 16');
  A('mov edx, $STR');
  FEnd;

  { Error.captureStackTrace : sans effet }
  A('proc _JSRT_Error_capture');
  A('xor eax, eax');
  A('mov edx, $UNDEF');
  A('ret');
  A('endp');

  For k := 1 To 7 Do
    ErrCtor('_JSRT_' + ErrKinds[k] + '_call', ErrKinds[k]);
End;

{ Donnees statiques : prototypes et fonctions des classes d'erreur. }
Procedure RtErrorData(oproto: LongInt);
Var
  k, errproto, proto, props, f: LongInt;
Begin
  errproto := 0;
  For k := 1 To 7 Do
    Begin
      BoReset;
      BoAdd('name', DsymFind(asm_ctx^, RtStr(ErrKinds[k])), RT_T_STRING);
      BoAdd('message', DsymFind(asm_ctx^, RtStr('')), RT_T_STRING);
      If k = 1 Then
        BoAdd('toString', RtFuncObj('toString', '_JSRT_err_toString', 0), RT_T_FUNCTION);
      If k = 1 Then
        Begin
          proto := BoFinish('_JSNO_Error_proto', oproto);
          errproto := proto;
        End
      Else
        proto := BoFinish('_JSNO_' + ErrKinds[k] + '_proto', errproto);
      BoReset;
      BoAdd('prototype', proto, RT_T_OBJECT);
      If k = 1 Then
        BoAdd('captureStackTrace', RtFuncObj('captureStackTrace', '_JSRT_Error_capture', 1),
              RT_T_FUNCTION);
      props := BoFinish('_JSNO_' + ErrKinds[k] + '_props', 0);
      f := RtFuncObjP(ErrKinds[k], '_JSRT_' + ErrKinds[k] + '_call', 1, props);
      RtGlobal(ErrKinds[k], f, RT_T_FUNCTION);
    End;
End;

{ ---- Nombres : FPU x87, conversions et operateurs (TODO 19) ----

  Un nombre est un int32 (etiquette 0) ou un double IEEE (mot haut
  inferieur a FFF90000h). Les calculs lents se font dans la pile x87 en
  double precision (mot de controle 027Fh) ; les fonctions
  transcendantes passent temporairement en precision etendue (037Fh).
  _JSRT_fld charge un nombre, _JSRT_fst_result depile ST0 et rend un int32
  quand la valeur est entiere, sinon le double. }

Procedure CallFld(Const lo, hi: TString);
Begin
  A('push ' + hi);
  A('push ' + lo);
  A('call _JSRT_fld');
  A('add esp, 8');
End;

Procedure CallToNumber(Const lo, hi, dlo, dhi: TString);
Begin
  A('push ' + hi);
  A('push ' + lo);
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('mov ' + dlo + ', eax');
  A('mov ' + dhi + ', edx');
End;

{ Convertit les deux operandes [ebp+8..] en nombres dans les locaux 1 a 4. }
Procedure NumPrep2;
Begin
  CallToNumber('dword ptr [ebp+8]', 'dword ptr [ebp+12]', Lv(1), Lv(2));
  CallToNumber('dword ptr [ebp+16]', 'dword ptr [ebp+20]', Lv(3), Lv(4));
End;

Procedure NumBin(Const name, fop: TString);
Begin
  FBegin(name, 4);
  NumPrep2;
  CallFld(Lv(1), Lv(2));
  CallFld(Lv(3), Lv(4));
  A(fop);
  A('call _JSRT_fst_result');
  FEnd;
End;

Procedure RtNumData;
Begin
  RtDword('_JSRT_cw_ext', $037F);
  RtDword('_JSRT_cw_dbl', $027F);
  RtDword('_JSRT_cw_trunc', $0F7F);
  RtDword('_JSRT_cw_down', $077F);
  RtDword('_JSRT_cw_up', $0B7F);
  RtQword('_JSRT_c10', 10.0);
  RtQword('_JSRT_chalf', 0.5);
  RtQword('_JSRT_c2p32', 4294967296.0);
  RtQword('_JSRT_c2p31', 2147483648.0);
  RtQword('_JSRT_c2p63', 9223372036854775808.0);
  RtQword('_JSRT_c2p84', 1.9342813113834067E25);
  RtQword('_JSRT_c1e16', 1.0E16);
  RtQword('_JSRT_c1e17', 1.0E17);
  RtQword('_JSRT_c1e21', 1.0E21);
  RtQword('_JSRT_c1e18', 1.0E18);
  RtQword('_JSRT_cmax', 1.7976931348623157E308);
  RtQword('_JSRT_c2p53', 9007199254740992.0);
  RtQword('_JSRT_c4096', 4096.0);
End;

Procedure RtNumCore;
Begin
  { _JSRT_fld(valeur numerique) : charge un int32 ou un double dans ST0 }
  A('proc _JSRT_fld');
  A('push ebp');
  A('mov ebp, esp');
  A('cmp dword ptr [ebp+12], $INT');
  A('je .i');
  A('fld qword ptr [ebp+8]');
  A('leave');
  A('ret');
  A('.i:');
  A('fild dword ptr [ebp+8]');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_fst_result() : depile ST0 -> nombre JavaScript dans EDX:EAX }
  A('proc _JSRT_fst_result');
  A('push ebp');
  A('mov ebp, esp');
  A('sub esp, 16');
  A('fstp qword ptr [ebp-8]');
  A('fld qword ptr [ebp-8]');
  A('frndint');
  A('fld qword ptr [ebp-8]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4000');
  A('jne .dbl');
  A('fld qword ptr [ebp-8]');
  A('fistp dword ptr [ebp-12]');
  A('mov eax, dword ptr [ebp-12]');
  A('cmp eax, 0x80000000');
  A('je .dbl');
  A('test eax, eax');
  A('jnz .int');
  A('mov ecx, dword ptr [ebp-4]');
  A('test ecx, ecx');
  A('js .dbl');
  A('.int:');
  A('mov edx, $INT');
  A('leave');
  A('ret');
  A('.dbl:');
  A('mov eax, dword ptr [ebp-8]');
  A('mov edx, dword ptr [ebp-4]');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_uint_num(entier non signe) -> nombre }
  A('proc _JSRT_uint_num');
  A('push ebp');
  A('mov ebp, esp');
  A('mov eax, dword ptr [ebp+8]');
  A('test eax, eax');
  A('js .big');
  A('mov edx, $INT');
  A('leave');
  A('ret');
  A('.big:');
  A('push 0');
  A('push eax');
  A('fild qword ptr [esp]');
  A('add esp, 8');
  A('call _JSRT_fst_result');
  A('leave');
  A('ret');
  A('endp');

  { _JSRT_toprim(valeur, indice) -> primitive ; indice 0 nombre, 1 defaut, 2 chaine }
  FBegin('_JSRT_toprim', 0);
  A('mov eax, dword ptr [ebp+8]');
  A('mov edx, dword ptr [ebp+12]');
  A('cmp edx, $OBJ');
  A('jb .ret');
  A('ja .other');
  A('mov ebx, dword ptr [ebp+16]');
  A('cmp ebx, 1');
  A('jne .h');
  A('push offset ' + RtStr(#1 + 't'));
  A('push dword ptr [ebp+8]');
  A('call _JSRT_prop_lookup');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .h');
  A('mov ebx, 2');
  A('.h:');
  A('xor esi, esi');
  A('.try:');
  A('mov ecx, esi');
  A('cmp ebx, 2');
  A('jne .n');
  A('xor ecx, 1');
  A('.n:');
  A('test ecx, ecx');
  A('jz .vo');
  A('push offset ' + RtStr('toString'));
  A('jmp .lk');
  A('.vo:');
  A('push offset ' + RtStr('valueOf'));
  A('.lk:');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_prop_lookup');
  A('add esp, 8');
  A('test eax, eax');
  A('jz .next');
  A('test dword ptr [eax+4], 2');
  A('jnz .next');
  A('cmp dword ptr [eax+12], $FN');
  A('jne .next');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('push dword ptr [eax+8]');
  A('call _JSRT_call0');
  A('add esp, 12');
  A('cmp edx, $OBJ');
  A('jb .ret');
  A('.next:');
  A('inc esi');
  A('cmp esi, 2');
  A('jb .try');
  A('mov eax, offset ' + RtStr('[object Object]'));
  A('mov edx, $STR');
  A('jmp .ret');
  A('.other:');
  A('push edx');
  A('push eax');
  A('call _JSRT_tostring');
  A('add esp, 8');
  FEnd;

  { _JSRT_tonumber(valeur) -> nombre }
  FBegin('_JSRT_tonumber', 0);
  A('mov eax, dword ptr [ebp+8]');
  A('mov edx, dword ptr [ebp+12]');
  A('cmp edx, $INT');
  A('jbe .ret');
  A('cmp edx, $BOOL');
  A('je .bool');
  A('cmp edx, $UNDEF');
  A('je .nan');
  A('cmp edx, $NULL');
  A('je .zero');
  A('cmp edx, $STR');
  A('je .str');
  A('cmp edx, $OBJ');
  A('je .objp');
  A('cmp edx, $ARR');
  A('je .obj');
  A('.nan:');
  A('xor eax, eax');
  A('mov edx, 0xFFF80000');
  A('jmp .ret');
  A('.zero:');
  A('xor eax, eax');
  A('.bool:');
  A('mov edx, $INT');
  A('jmp .ret');
  A('.objp:');
  A('push 0');
  A('push edx');
  A('push eax');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('push edx');
  A('push eax');
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('jmp .ret');
  A('.obj:');
  A('push edx');
  A('push eax');
  A('call _JSRT_tostring');
  A('add esp, 8');
  A('.str:');
  A('push eax');
  A('call _JSRT_str_to_num');
  A('add esp, 4');
  FEnd;

  { _JSRT_toint32_slow(valeur) -> entier 32 bits (ToInt32) }
  FBegin('_JSRT_toint32_slow', 2);
  CallToNumber('dword ptr [ebp+8]', 'dword ptr [ebp+12]', Lv(2), Lv(1));
  A('mov eax, ' + Lv(2));
  A('cmp ' + Lv(1) + ', $INT');
  A('je .ret');
  A('mov ecx, ' + Lv(1));
  A('and ecx, 0x7FF00000');
  A('cmp ecx, 0x7FF00000');
  A('je .zero');
  A('fldcw word ptr [_JSRT_cw_trunc]');
  A('fld qword ptr [ebp-20]');
  A('fld 0');
  A('fabs');
  A('fld qword ptr [_JSRT_c2p84]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x0100');
  A('je .huge');
  A('fld 0');
  A('fabs');
  A('fld qword ptr [_JSRT_c2p63]');
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('jz .small');
  A('fld qword ptr [_JSRT_c2p32]');
  A('fxch');
  A('.rem:');
  A('fprem');
  A('fnstsw ax');
  A('test eax, 0x400');
  A('jnz .rem');
  A('fxch');
  A('fpop');
  A('.small:');
  A('sub esp, 8');
  A('fistp qword ptr [esp]');
  A('mov eax, dword ptr [esp]');
  A('add esp, 8');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('jmp .ret');
  A('.huge:');
  A('fpop');
  A('fldcw word ptr [_JSRT_cw_dbl]');
  A('.zero:');
  A('xor eax, eax');
  FEnd;

  { operateurs binaires lents : (a, b) -> nombre }
  NumBin('_JSRT_num_add', 'faddp');
  NumBin('_JSRT_sub', 'fsubp');
  NumBin('_JSRT_mul', 'fmulp');
  NumBin('_JSRT_div', 'fdivp');

  { a % b : reste tronque (signe du dividende) }
  FBegin('_JSRT_mod', 4);
  NumPrep2;
  CallFld(Lv(3), Lv(4));
  CallFld(Lv(1), Lv(2));
  A('.rem:');
  A('fprem');
  A('fnstsw ax');
  A('test eax, 0x400');
  A('jnz .rem');
  A('fxch');
  A('fpop');
  A('call _JSRT_fst_result');
  FEnd;

  { inc, dec, neg : un operande }
  A('proc _JSRT_inc');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('call _JSRT_fld');
  A('add esp, 8');
  A('fld1');
  A('faddp');
  A('call _JSRT_fst_result');
  A('leave');
  A('ret');
  A('endp');
  A('proc _JSRT_dec');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('push edx');
  A('push eax');
  A('call _JSRT_fld');
  A('add esp, 8');
  A('fld1');
  A('fsubp');
  A('call _JSRT_fst_result');
  A('leave');
  A('ret');
  A('endp');
  A('proc _JSRT_neg');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_tonumber');
  A('add esp, 8');
  A('cmp edx, $INT');
  A('jne .d');
  A('test eax, eax');
  A('jnz .nz');
  A('xor eax, eax');
  A('mov edx, 0x80000000');
  A('leave');
  A('ret');
  A('.nz:');
  A('cmp eax, 0x80000000');
  A('je .d');
  A('neg eax');
  A('leave');
  A('ret');
  A('.d:');
  A('push edx');
  A('push eax');
  A('call _JSRT_fld');
  A('add esp, 8');
  A('fchs');
  A('call _JSRT_fst_result');
  A('leave');
  A('ret');
  A('endp');
  { le zero doit rester -0 (double) : fst_result le garde en double }

  { ~v }
  A('proc _JSRT_bnot');
  A('push ebp');
  A('mov ebp, esp');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('not eax');
  A('mov edx, $INT');
  A('leave');
  A('ret');
  A('endp');
End;

{ Operateurs bit a bit lents }
Procedure BitOp(Const name, opcode: TString; shift: Boolean; unsigned: Boolean);
Begin
  FBegin(name, 0);
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_toint32');
  A('add esp, 8');
  A('mov ebx, eax');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_toint32');
  A('add esp, 8');
  If shift Then
    Begin
      A('mov ecx, ebx');
      A('and ecx, 31');
      A(opcode + ' eax, cl');
    End
  Else
    A(opcode + ' eax, ebx');
  If unsigned Then
    Begin
      A('push eax');
      A('call _JSRT_uint_num');
      A('add esp, 4');
    End
  Else
    A('mov edx, $INT');
  FEnd;
End;

Procedure RtNumOps;
Begin
  BitOp('_JSRT_band', 'and', False, False);
  BitOp('_JSRT_bor', 'or', False, False);
  BitOp('_JSRT_bxor', 'xor', False, False);
  BitOp('_JSRT_shl', 'shl', True, False);
  BitOp('_JSRT_sar', 'sar', True, False);
  BitOp('_JSRT_shr', 'shr', True, True);

  { _JSRT_num_eq(a, b) : egalite numerique (EAX = 0 ou 1) }
  FBegin('_JSRT_num_eq', 4);
  NumPrep2;
  CallFld(Lv(3), Lv(4));
  CallFld(Lv(1), Lv(2));
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('cmp eax, 0x4000');
  A('jne .no');
  A('mov eax, 1');
  A('jmp .ret');
  A('.no:');
  A('xor eax, eax');
  FEnd;

  { _JSRT_cmp3(a, b) -> -1, 0, 1 ou 2 (non ordonnes) }
  FBegin('_JSRT_cmp3', 4);
  A('cmp dword ptr [ebp+12], $STR');
  A('jne .num');
  A('cmp dword ptr [ebp+20], $STR');
  A('jne .num');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_cmp');
  A('add esp, 8');
  A('jmp .ret');
  A('.num:');
  NumPrep2;
  CallFld(Lv(3), Lv(4));
  CallFld(Lv(1), Lv(2));
  A('fcompp');
  A('fnstsw ax');
  A('and eax, 0x4500');
  A('test eax, eax');
  A('jz .gt');
  A('cmp eax, 0x0100');
  A('je .lt');
  A('cmp eax, 0x4000');
  A('je .eq');
  A('mov eax, 2');
  A('jmp .ret');
  A('.gt:');
  A('mov eax, 1');
  A('jmp .ret');
  A('.lt:');
  A('mov eax, -1');
  A('jmp .ret');
  A('.eq:');
  A('xor eax, eax');
  FEnd;

  { _JSRT_eq_slow(a, b) : == entre types differents }
  FBegin('_JSRT_eq_slow', 0);
  A('cmp dword ptr [ebp+12], $BOOL');
  A('jne .b2');
  A('mov dword ptr [ebp+12], $INT');
  A('.b2:');
  A('cmp dword ptr [ebp+20], $BOOL');
  A('jne .b3');
  A('mov dword ptr [ebp+20], $INT');
  A('.b3:');
  A('cmp dword ptr [ebp+12], $OBJ');
  A('jb .aprim');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jae .no');
  A('cmp dword ptr [ebp+20], $UNDEF');
  A('je .no');
  A('cmp dword ptr [ebp+20], $NULL');
  A('je .no');
  A('push 1');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+8], eax');
  A('mov dword ptr [ebp+12], edx');
  A('jmp .prim2');
  A('.aprim:');
  A('cmp dword ptr [ebp+20], $OBJ');
  A('jb .prim2');
  A('cmp dword ptr [ebp+12], $UNDEF');
  A('je .no');
  A('cmp dword ptr [ebp+12], $NULL');
  A('je .no');
  A('push 1');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_toprim');
  A('add esp, 12');
  A('mov dword ptr [ebp+16], eax');
  A('mov dword ptr [ebp+20], edx');
  A('.prim2:');
  A('cmp dword ptr [ebp+12], $UNDEF');
  A('je .no');
  A('cmp dword ptr [ebp+12], $NULL');
  A('je .no');
  A('cmp dword ptr [ebp+20], $UNDEF');
  A('je .no');
  A('cmp dword ptr [ebp+20], $NULL');
  A('je .no');
  A('cmp dword ptr [ebp+12], $STR');
  A('jne .a2');
  A('cmp dword ptr [ebp+20], $STR');
  A('jne .a1');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_equal');
  A('add esp, 8');
  A('jmp .out');
  A('.a1:');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_str_to_num');
  A('add esp, 4');
  A('mov dword ptr [ebp+8], eax');
  A('mov dword ptr [ebp+12], edx');
  A('jmp .num');
  A('.a2:');
  A('cmp dword ptr [ebp+20], $STR');
  A('jne .num');
  A('push dword ptr [ebp+16]');
  A('call _JSRT_str_to_num');
  A('add esp, 4');
  A('mov dword ptr [ebp+16], eax');
  A('mov dword ptr [ebp+20], edx');
  A('.num:');
  A('push dword ptr [ebp+20]');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp+12]');
  A('push dword ptr [ebp+8]');
  A('call _JSRT_num_eq');
  A('add esp, 16');
  A('jmp .out');
  A('.no:');
  A('xor eax, eax');
