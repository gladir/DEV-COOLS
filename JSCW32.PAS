  A('push edi');
  A('sub esp, 8');
  A('mov esi, dword ptr [ebp+8]');
  A('mov ebx, dword ptr [ebp+12]');
  A('mov edi, dword ptr [ebp+16]');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('cmp ebx, ecx');
  A('jle .same');
  A('mov edx, dword ptr [edi+$STR_LEN]');
  A('test edx, edx');
  A('jz .same');
  A('sub ebx, ecx');
  A('mov dword ptr [ebp-16], ebx');
  A('lea eax, [ebx+ecx]');
  A('push eax');
  A('call _JSRT_str_new');
  A('add esp, 4');
  A('mov dword ptr [ebp-20], eax');
  A('mov edi, eax');
  A('add edi, $STR_DATA');
  A('cmp dword ptr [ebp+20], 0');
  A('je .tail');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp-16]');
  A('push edi');
  A('call _JSRT_str_fillpad');
  A('add esp, 12');
  A('mov edi, eax');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('lea esi, [esi+$STR_DATA]');
  A('rep movsb');
  A('jmp .fin');
  A('.tail:');
  A('mov ecx, dword ptr [esi+$STR_LEN]');
  A('lea esi, [esi+$STR_DATA]');
  A('rep movsb');
  A('push dword ptr [ebp+16]');
  A('push dword ptr [ebp-16]');
  A('push edi');
  A('call _JSRT_str_fillpad');
  A('add esp, 12');
  A('.fin:');
  A('mov eax, dword ptr [ebp-20]');
  A('mov edx, $STR');
  A('jmp .out');
  A('.same:');
  A('mov eax, esi');
  A('mov edx, $STR');
  A('.out:');
  A('add esp, 8');
  A('pop edi');
  A('pop esi');
  A('pop ebx');
  A('pop ebp');
  A('ret');
  A('endp');
End;

