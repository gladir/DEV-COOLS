    OP_FSUB: OpName := 'fsub';
    OP_FSUBR: OpName := 'fsubr';
    OP_FMUL: OpName := 'fmul';
    OP_FDIV: OpName := 'fdiv';
    OP_FDIVR: OpName := 'fdivr';
    OP_FADDP: OpName := 'faddp';
    OP_FSUBP: OpName := 'fsubp';
    OP_FSUBRP: OpName := 'fsubrp';
    OP_FMULP: OpName := 'fmulp';
    OP_FDIVP: OpName := 'fdivp';
    OP_FDIVRP: OpName := 'fdivrp';
    OP_FCHS: OpName := 'fchs';
    OP_FABS: OpName := 'fabs';
