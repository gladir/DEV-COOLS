Begin
 ListExtendM(a, n, kw);
 Result := a[0];
End;

Function ListEqM(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 If Not ((a[1].k = vkObj) And (a[1].o Is TPyList)) Then Begin
  Result := vNotImpl;
  Exit;
 End;
