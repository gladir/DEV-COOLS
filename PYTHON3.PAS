  bl := IntBitLength(a[0]);
  If bl > 1000 Then Begin
   sh := IntShr(a[0], bl - 60);
   Result := VFloat(c_log2(IntToDouble(sh)) + (bl - 60));
   Exit;
  End;
 End;
 x := NumToDouble(a[0]);
 If x <= 0 Then MathDomain;
 Result := VFloat(c_log2(x));
End;

