Function LanczosSum(x: Double): Double;
Var
 num, den: Double;
 i: Integer;
Begin
 num := 0;
 den := 0;
 If x < 5.0 Then Begin
  For i := 12 Downto 0 Do Begin
   num := num * x + LanczosNum[i];
   den := den * x + LanczosDen[i];
  End;
 End
 Else Begin
  For i := 0 To 12 Do Begin
   num := num / x + LanczosNum[i];
   den := den / x + LanczosDen[i];
  End;
 End;
 Result := num / den;
End;

Function MSinPi(x: Double): Double;
Var
 y, r: Double;
 n: Integer;
Begin
 y := c_fmod(Abs(x), 2.0);
 n := Round(2.0 * y);
 Case n Of
  0: r := c_sin(PiC * y);
  1: r := c_cos(PiC * (y - 0.5));
  2: r := c_sin(PiC * (1.0 - y));
  3: r := -c_cos(PiC * (y - 1.5));
 Else r := c_sin(PiC * (y - 2.0));
 End;
 If FloatSignBit(x) Then Result := -r Else Result := r;
End;

