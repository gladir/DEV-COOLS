{ getaddrinfo(host|None, port|None, family, type, proto, flags) -> liste ;
  leve (code, message) via une exception gaierror geree cote Python }
Function SkGetAddrInfo(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 hints: TAddrInfoRec;
 res, p: PAddrInfoRec;
 host, serv: AnsiString;
 ph, ps: PChar;
 e, i: LongInt;
 l: TPyList;
 t: TPyTuple;
 s: AnsiString;
Begin
 FillChar(hints, SizeOf(hints), 0);
 hints.ai_family := ToInt64(a[2]);
 hints.ai_socktype := ToInt64(a[3]);
 hints.ai_protocol := ToInt64(a[4]);
 hints.ai_flags := ToInt64(a[5]);
 ph := Nil;
 ps := Nil;
 If a[0].k <> vkNone Then Begin
  host := BytesOrStrArg(a[0]);
  ph := PChar(host);
 End;
 If a[1].k <> vkNone Then Begin
  If a[1].k = vkInt Then serv := IntToStr(a[1].i) Else serv :=
    BytesOrStrArg(a[1]);
  ps := PChar(serv);
 End;
 res := Nil;
 e := c_getaddrinfo(ph, ps, @hints, res);
 If e <> 0 Then Begin
  t := NewTuple(2);
  t.items[0] := VInt(e);
  t.items[1] := VStr(PChar(c_gai_strerror(e)));
  Result := VObj(t);
  Exit;
 End;
 l := NewList;
 p := res;
 While p <> Nil Do Begin
  t := NewTuple(5);
  t.items[0] := VInt(p^.ai_family);
  t.items[1] := VInt(p^.ai_socktype);
  t.items[2] := VInt(p^.ai_protocol);
  If p^.ai_canonname <> Nil Then t.items[3] := VStr(p^.ai_canonname)
  Else t.items[3] := VStr('');
  SetLength(s, p^.ai_addrlen);
  If p^.ai_addrlen > 0 Then Move(p^.ai_addr^, s[1], p^.ai_addrlen);
  t.items[4] := VBytes(s);
  l.Add(VObj(t));
  p := p^.ai_next;
 End;
 c_freeaddrinfo(res);
 i := 0;
 Result := VObj(l);
End;

Function SkGetNameInfo(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 buf: AnsiString;
 p: Pointer;
 h, sv: Array[0..1023] Of Char;
 e: LongInt;
 t: TPyTuple;
Begin
 p := SkAddr(a[0], buf);
 e := c_getnameinfo(p, Length(buf), @h[0], 1024, @sv[0], 1024, ToInt64(a[1]));
 If e <> 0 Then Begin
  t := NewTuple(2);
  t.items[0] := VInt(e);
  t.items[1] := VStr(PChar(c_gai_strerror(e)));
  Result := VObj(t);
  Exit;
 End;
 t := NewTuple(2);
 t.items[0] := VStr(PChar(@h[0]));
 t.items[1] := VStr(PChar(@sv[0]));
 Result := VObj(t);
End;

