Function StrCtor(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 enc: AnsiString;
Begin
 If n = 0 Then Begin
  Result := VStr('');
  Exit;
 End;
 If (n > 1) Or (kw <> Nil) Then Begin
  If (a[0].k = vkObj) And (a[0].o Is TPyBytes) Then Begin
   Result := CallValue(GetAttr(a[0], 'decode'), @a[1], n - 1, kw);
   Exit;
  End;
  If Not IsStrVal(a[1]) Then
   TypeErr('str() argument 2 must be str, not ' + TypeName(a[1]));
  If IsStrVal(a[0]) Then
   TypeErr('decoding str is not supported');
  TypeErr('decoding to str: need a bytes-like object, ' + TypeName(a[0]) +
   ' found');
 End;
 If IsStrVal(a[0]) And Not a[0].o.cls.userdef Then Result := a[0]
 Else Result := VStr(StrVal(a[0]));
End;

