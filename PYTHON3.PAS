 DefFunc(d, 'localtime', @TimeLocaltime);
 DefFunc(d, 'mktime', @TimeMktime);
 DefFunc(d, 'strftime', @TimeStrftime);
 DefFunc(d, 'ctime', @TimeCtime);
 d.SetS('timezone', VInt(0));
