 If Not ((a[1].k = vkObj) And (a[1].o Is TPyBytes)) Then
  TypeErr('can''t concat ' + TypeName(a[1]) + ' to bytes');
 Result := VBytes(TPyBytes(a[0].o).s + BytesFromStr(a[1]));
End;

