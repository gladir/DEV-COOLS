Begin
 FlushTracked;
 If (n > 0) And (a[0].k <> vkNone) Then p := FsPath(a[0]) Else p := '.';
 d := FpOpenDir(p);
 If d = Nil Then Begin
  If (n > 0) And (a[0].k <> vkNone) Then RaiseErrnoF(fpgeterrno, StrOf(a[0]))
  Else RaiseErrnoF(fpgeterrno, '.');
 End;
 l := NewList;
 Repeat
  e := FpReadDir(d^);
  If e <> Nil Then Begin
   nm := PChar(@e^.d_name[0]);
   If (nm <> '.') And (nm <> '..') Then l.Add(VStr(FsStr(nm)));
  End;
 Until e = Nil;
 FpCloseDir(d^);
 Result := VObj(l);
End;

