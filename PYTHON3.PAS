  arr := IterToArr(a[i]);
  For j := 0 To High(arr) Do SelfSet(a).Add(arr[j]);
 End;
 Result := vNone;
End;

Function SetInterUpdateM(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 SetReplaceWith(SelfSet(a), SetOpM(a, n, bopAnd));
