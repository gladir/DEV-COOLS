Function SetPopM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: TPySet;
 i: Integer;
Begin
 s := SelfSet(a);
 For i := 0 To High(s.tab) Do
  If (s.tab[i].key.k <> vkNull) And (s.tab[i].key.k <> vkDummy) Then Begin
   Result := s.tab[i].key;
   s.Discard(Result);
   Exit;
  End;
 RaiseExc(exKeyError, 'pop from an empty set');
 Result := vNone;
End;

