{$IFDEF UNIX}
Type
 TReTimeSpec = Record
  sec, nsec: Int64;
 End;

Function ClockGetTime(clk: LongInt; tp: Pointer): LongInt; CDecl;
 External 'c' Name 'clock_gettime';

Function ClockNs(clk: LongInt): Int64;
Var
 ts: TReTimeSpec;
Begin
 ClockGetTime(clk, @ts);
 Result := ts.sec * 1000000000 + ts.nsec;
End;
{$ELSE}
Function ClockNs(clk: LongInt): Int64;
Begin
 Result := Round((Now - EncodeDate(1970, 1, 1)) * 86400.0 * 1.0e9);
End;
{$ENDIF}

Function NsToSeconds(ns: Int64): Double;
Var
 d, billion: Double;
Begin
 d := ns;
 billion := 1000000000.0;
 Result := d / billion;
End;

Function NowSeconds: Double;
Begin
 Result := NsToSeconds(ClockNs(0));
End;

Function TimeTime(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := VFloat(NowSeconds);
End;

Function TimeTimeNs(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := VInt(ClockNs(0));
End;

Function TimeSleep(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 x: Double;
Begin
 x := MathArg(a, 0, n, 'sleep');
 If x < 0 Then ValueErr('sleep length must be non-negative');
 OutFlush;
 Sleep(Round(x * 1000));
 Result := vNone;
End;

Var
 StartTick: Double;

Function TimePerf(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := VFloat(NsToSeconds(ClockNs(1)));
End;

Function TimePerfNs(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := VInt(ClockNs(1));
End;

Function TimeProcess(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := VFloat(NsToSeconds(ClockNs(2)));
End;

Function TimeStructArr(t: Double; local: Boolean): TVal;
Var
 tp: TPyTuple;
 days, secs, z, era, doe, yoe, y, doy, mp, d, m, tt: Int64;
 wd, yd: Int64;
 isLeap: Boolean;
Begin
 tt := Trunc(t);
 If t < tt Then Dec(tt);
 If local Then Begin
  {$IFDEF UNIX}
  tt := tt + (-GetLocalTimeOffset) * 60;
  {$ENDIF}
 End;
 If tt >= 0 Then days := tt Div 86400 Else days := -((-tt + 86399) Div 86400);
 secs := tt - days * 86400;
 z := days + 719468;
 If z >= 0 Then era := z Div 146097 Else era := (z - 146096) Div 146097;
 doe := z - era * 146097;
 yoe := (doe - doe Div 1460 + doe Div 36524 - doe Div 146096) Div 365;
 y := yoe + era * 400;
 doy := doe - (365 * yoe + yoe Div 4 - yoe Div 100);
 mp := (5 * doy + 2) Div 153;
 d := doy - (153 * mp + 2) Div 5 + 1;
 If mp < 10 Then m := mp + 3 Else m := mp - 9;
 If m <= 2 Then y := y + 1;
 wd := (days + 3) Mod 7;
 If wd < 0 Then wd := wd + 7;
 isLeap := ((y Mod 4 = 0) And (y Mod 100 <> 0)) Or (y Mod 400 = 0);
 Case m Of
  1: yd := d;
  2: yd := 31 + d;
  3: yd := 59 + d;
  4: yd := 90 + d;
  5: yd := 120 + d;
  6: yd := 151 + d;
  7: yd := 181 + d;
  8: yd := 212 + d;
  9: yd := 243 + d;
  10: yd := 273 + d;
  11: yd := 304 + d;
 Else yd := 334 + d;
 End;
 If isLeap And (m > 2) Then Inc(yd);
 tp := NewTuple(9);
 tp.items[0] := VInt(y);
 tp.items[1] := VInt(m);
 tp.items[2] := VInt(d);
 tp.items[3] := VInt(secs Div 3600);
 tp.items[4] := VInt((secs Mod 3600) Div 60);
 tp.items[5] := VInt(secs Mod 60);
 tp.items[6] := VInt(wd);
 tp.items[7] := VInt(yd);
 tp.items[8] := VInt(0);
 Result := VObj(tp);
End;

Function TimeGmtime(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 t: Double;
Begin
 If (n > 0) And (a[0].k <> vkNone) Then t := NumToDouble(a[0])
 Else t := NowSeconds;
 Result := TimeStructArr(t, False);
End;

Function TimeLocaltime(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 t: Double;
Begin
 If (n > 0) And (a[0].k <> vkNone) Then t := NumToDouble(a[0])
 Else t := NowSeconds;
 Result := TimeStructArr(t, True);
End;

Function DaysFromCivil(y, m, d: Int64): Int64;
Var
 era, yoe, doy, doe: Int64;
Begin
 If m <= 2 Then y := y - 1;
 If y >= 0 Then era := y Div 400 Else era := (y - 399) Div 400;
 yoe := y - era * 400;
 If m > 2 Then doy := (153 * (m - 3) + 2) Div 5 + d - 1
 Else doy := (153 * (m + 9) + 2) Div 5 + d - 1;
 doe := yoe * 365 + yoe Div 4 - yoe Div 100 + doy;
 Result := era * 146097 + doe - 719468;
End;

Function TimeMktime(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 arr: TValArr;
 y, mo, secs: Int64;
Begin
 arr := IterToArr(a[0]);
 If Length(arr) < 9 Then TypeErr('mktime(): illegal time tuple argument');
 y := ToInt64(arr[0]);
 mo := ToInt64(arr[1]) - 1;
 y := y + mo Div 12;
 mo := mo Mod 12;
 If mo < 0 Then Begin
  mo := mo + 12;
  Dec(y);
 End;
 secs := DaysFromCivil(y, mo + 1, 1) * 86400 + (ToInt64(arr[2]) - 1) * 86400 +
  ToInt64(arr[3]) * 3600 + ToInt64(arr[4]) * 60 + ToInt64(arr[5]);
 {$IFDEF UNIX}
 secs := secs - (-GetLocalTimeOffset) * 60;
 {$ENDIF}
 Result := VFloat(secs);
End;

Function TimeStrftime(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 fmt, r: AnsiString;
 arr: TValArr;
 i: Integer;
 y, mo, d, h, mi, s, wd, yd: Integer;
 c: Char;
Const
 Days: Array[0..6] Of String = ('Monday', 'Tuesday', 'Wednesday', 'Thursday',
  'Friday', 'Saturday', 'Sunday');
 Months: Array[1..12] Of String = ('January', 'February', 'March', 'April',
  'May', 'June', 'July', 'August', 'September', 'October', 'November',
  'December');
Begin
 fmt := StrOf(a[0]);
 If n > 1 Then arr := IterToArr(a[1])
 Else arr := IterToArr(TimeStructArr(NowSeconds, True));
 y := arr[0].i;
 mo := arr[1].i;
 d := arr[2].i;
 h := arr[3].i;
 mi := arr[4].i;
 s := arr[5].i;
 wd := arr[6].i;
 yd := arr[7].i;
 r := '';
 i := 1;
 While i <= Length(fmt) Do Begin
  If (fmt[i] = '%') And (i < Length(fmt)) Then Begin
   Inc(i);
   c := fmt[i];
   Case c Of
    'Y': r := r + IntToStr(y);
    'y': r := r + Format('%.2d', [y Mod 100]);
    'm': r := r + Format('%.2d', [mo]);
    'd': r := r + Format('%.2d', [d]);
    'H': r := r + Format('%.2d', [h]);
    'I': r := r + Format('%.2d', [((h + 11) Mod 12) + 1]);
    'M': r := r + Format('%.2d', [mi]);
    'S': r := r + Format('%.2d', [s]);
    'p': If h < 12 Then r := r + 'AM' Else r := r + 'PM';
    'A': r := r + Days[wd];
    'a': r := r + Copy(Days[wd], 1, 3);
    'B': r := r + Months[mo];
    'b': r := r + Copy(Months[mo], 1, 3);
    'j': r := r + Format('%.3d', [yd]);
    'w': r := r + IntToStr((wd + 1) Mod 7);
    'Z': r := r + 'UTC';
    'z': r := r + '+0000';
    'F': r := r + Format('%.4d-%.2d-%.2d', [y, mo, d]);
    'T': r := r + Format('%.2d:%.2d:%.2d', [h, mi, s]);
    'D': r := r + Format('%.2d/%.2d/%.2d', [mo, d, y Mod 100]);
    'c': r := r + Copy(Days[wd], 1, 3) + ' ' + Copy(Months[mo], 1, 3) + ' ' +
      Format('%2d %.2d:%.2d:%.2d %d', [d, h, mi, s, y]);
    'x': r := r + Format('%.2d/%.2d/%.2d', [mo, d, y Mod 100]);
    'X': r := r + Format('%.2d:%.2d:%.2d', [h, mi, s]);
    '%': r := r + '%';
    'n': r := r + #10;
    't': r := r + #9;
   Else r := r + '%' + c;
   End;
  End
  Else r := r + fmt[i];
  Inc(i);
 End;
 Result := VStr(r);
End;

Function TimeCtime(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 args: Array[0..1] Of TVal;
Begin
 args[0] := VStr('%a %b %e %H:%M:%S %Y');
 If (n > 0) And (a[0].k <> vkNone) Then
  args[1] := TimeStructArr(Floor(NumToDouble(a[0])), True)
 Else args[1] := TimeStructArr(NowSeconds, True);
 Result := TimeStrftime(@args[0], 2, Nil);
End;

