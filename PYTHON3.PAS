Function StrZFillM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: AnsiString;
 w, ln: Integer;
 sg: AnsiString;
Begin
 NeedArgs(n, 2, 2, 'zfill');
 s := SelfStr(a);
 w := IndexVal(a[1]);
 ln := Utf8Len(s);
 If w <= ln Then Begin
  Result := a[0];
  Exit;
 End;
 sg := '';
 If (s <> '') And (s[1] In ['+', '-']) Then Begin
  sg := s[1];
  s := Copy(s, 2, Length(s));
 End;
 Result := VStr(sg + StringOfChar('0', w - ln) + s);
End;

