Begin
 arr := IterToArr(a[1]);
 r := '';
 For i := 0 To High(arr) Do Begin
  If i > 0 Then r := r + TPyBytes(a[0].o).s;
  If Not ((arr[i].k = vkObj) And (arr[i].o Is TPyBytes)) Then
   TypeErr('sequence item ' + IntToStr(i) + ': expected a bytes-like object, '
    + TypeName(arr[i]) + ' found');
  r := r + TPyBytes(arr[i].o).s;
 End;
 Result := VBytes(r);
End;

Function BytesFromStr(Const v: TVal): AnsiString;
Begin
 If (v.k = vkObj) And (v.o Is TPyBytes) Then Result := TPyBytes(v.o).s
 Else If (v.k = vkObj) And v.o.cls.userdef And HasAttr(v, 'tobytes') And
  HasAttr(v, 'nbytes') Then
  Result := TPyBytes(Call0(GetAttr(v, 'tobytes')).o).s
 Else Begin
  TypeErr('a bytes-like object is required, not ''' + TypeName(v) + '''');
  Result := '';
 End;
End;

Procedure BytesSliceArgs(a: PVal; n: Integer; Var s: AnsiString);
Var
 st, en: Int64;
 l: Integer;
Begin
 s := TPyBytes(a[0].o).s;
 l := Length(s);
 st := 0;
 en := l;
 If (n > 2) And (a[2].k <> vkNone) Then st := IndexVal(a[2]);
 If (n > 3) And (a[3].k <> vkNone) Then en := IndexVal(a[3]);
 If st < 0 Then Begin st := st + l; If st < 0 Then st := 0; End;
 If en < 0 Then Begin en := en + l; If en < 0 Then en := 0; End;
 If en > l Then en := l;
 If st > en Then s := '' Else s := Copy(s, st + 1, en - st);
End;

Function BytesStartsEnds(a: PVal; n: Integer; ends: Boolean): TVal;
Var
 s, p: AnsiString;
 i: Integer;
 ok: Boolean;
 arr: TValArr;
Begin
 BytesSliceArgs(a, n, s);
 ok := False;
 If (a[1].k = vkObj) And (a[1].o Is TPyTuple) Then arr := TPyTuple(a[1].o).items
 Else Begin
  SetLength(arr, 1);
  arr[0] := a[1];
 End;
 For i := 0 To High(arr) Do Begin
  p := BytesFromStr(arr[i]);
  If ends Then ok := (Length(s) >= Length(p)) And
   (Copy(s, Length(s) - Length(p) + 1, Length(p)) = p)
  Else ok := Copy(s, 1, Length(p)) = p;
  If ok Then Break;
 End;
 Result := VBool(ok);
End;

Function BytesStartsWithM(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := BytesStartsEnds(a, n, False);
End;

Function BytesEndsWithM(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := BytesStartsEnds(a, n, True);
End;

Function BytesFindM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s, sub: AnsiString;
 st, en, l, r: Integer;
Begin
 NeedArgs(n, 2, 4, 'find');
 s := TPyBytes(a[0].o).s;
 l := Length(s);
 If (a[1].k = vkInt) Or (a[1].k = vkBool) Then Begin
  If (a[1].i < 0) Or (a[1].i > 255) Then
   ValueErr('byte must be in range(0, 256)');
  sub := Chr(a[1].i);
 End Else sub := BytesFromStr(a[1]);
 st := 0;
 en := l;
 If (n > 2) And (a[2].k <> vkNone) Then st := IndexVal(a[2]);
 If (n > 3) And (a[3].k <> vkNone) Then en := IndexVal(a[3]);
 If st < 0 Then Begin st := st + l; If st < 0 Then st := 0; End;
 If en < 0 Then Begin en := en + l; If en < 0 Then en := 0; End;
 If en > l Then en := l;
 If (st > l) Or (st + Length(sub) > en) Then Begin
  Result := VInt(-1);
  Exit;
 End;
 If sub = '' Then Begin
  Result := VInt(st);
  Exit;
 End;
 r := Pos(sub, Copy(s, st + 1, en - st));
 If r = 0 Then Result := VInt(-1) Else Result := VInt(r - 1 + st);
End;

