Function SkAddr(Const v: TVal; Var buf: AnsiString): Pointer;
Begin
 buf := BytesFromStr(v);
 If buf = '' Then Result := Nil Else Result := @buf[1];
End;

Function SkSocket(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 r: LongInt;
Begin
 r := c_socket(ToInt64(a[0]), ToInt64(a[1]) Or 524288, ToInt64(a[2]));
 If r < 0 Then RaiseErrnoN(CErrno);
 Result := VInt(r);
End;

Function SkSocketPair(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 sv: Array[0..1] Of LongInt;
 t: TPyTuple;
Begin
 If c_socketpair(ToInt64(a[0]), ToInt64(a[1]) Or 524288, ToInt64(a[2]),
  @sv[0]) <> 0 Then RaiseErrnoN(CErrno);
 t := NewTuple(2);
 t.items[0] := VInt(sv[0]);
 t.items[1] := VInt(sv[1]);
 Result := VObj(t);
End;

Function SkBind(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 buf: AnsiString;
 p: Pointer;
Begin
 p := SkAddr(a[1], buf);
 If c_bind(ToInt64(a[0]), p, Length(buf)) <> 0 Then RaiseErrnoN(CErrno);
 Result := vNone;
End;

{ renvoie errno (0 = succes) }
Function SkConnect(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 buf: AnsiString;
 p: Pointer;
 r: LongInt;
Begin
 p := SkAddr(a[1], buf);
 OutFlush;
 r := c_connect(ToInt64(a[0]), p, Length(buf));
 If r = 0 Then Result := VInt(0) Else Result := VInt(CErrno);
End;

Function SkListen(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 If c_listen(ToInt64(a[0]), ToInt64(a[1])) <> 0 Then RaiseErrnoN(CErrno);
 Result := vNone;
End;

Function SkAccept(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 buf: Array[0..127] Of Byte;
 l: LongWord;
 r: LongInt;
 t: TPyTuple;
 s: AnsiString;
Begin
 l := 128;
 r := c_accept4(ToInt64(a[0]), @buf[0], @l, 524288);
 If r < 0 Then RaiseErrnoN(CErrno);
 SetLength(s, l);
 If l > 0 Then Move(buf[0], s[1], l);
 t := NewTuple(2);
 t.items[0] := VInt(r);
 t.items[1] := VBytes(s);
 Result := VObj(t);
End;

Function SkSend(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: AnsiString;
 r: PtrInt;
Begin
 s := BytesFromStr(a[1]);
 OutFlush;
 r := c_send(ToInt64(a[0]), PChar(s), Length(s), ToInt64(a[2]) Or $4000);
 If r < 0 Then RaiseErrnoN(CErrno);
 Result := VInt(r);
End;

Function SkRecv(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: AnsiString;
 cnt: Int64;
 r: PtrInt;
Begin
 cnt := ToInt64(a[1]);
 If cnt < 0 Then ValueErr('negative buffersize in recv');
 SetLength(s, cnt);
 If cnt = 0 Then Begin
  Result := VBytes('');
  Exit;
 End;
 OutFlush;
 r := c_recv(ToInt64(a[0]), @s[1], cnt, ToInt64(a[2]));
 If r < 0 Then RaiseErrnoN(CErrno);
 SetLength(s, r);
 Result := VBytes(s);
End;

Function SkSendTo(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s, ab: AnsiString;
 p: Pointer;
 r: PtrInt;
Begin
 s := BytesFromStr(a[1]);
 p := SkAddr(a[3], ab);
 r := c_sendto(ToInt64(a[0]), PChar(s), Length(s), ToInt64(a[2]) Or $4000, p,
  Length(ab));
 If r < 0 Then RaiseErrnoN(CErrno);
 Result := VInt(r);
End;

Function SkRecvFrom(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s, ab: AnsiString;
 cnt: Int64;
 r: PtrInt;
 abuf: Array[0..127] Of Byte;
 l: LongWord;
 t: TPyTuple;
Begin
 cnt := ToInt64(a[1]);
 SetLength(s, cnt);
 l := 128;
 OutFlush;
 r := c_recvfrom(ToInt64(a[0]), PChar(s), cnt, ToInt64(a[2]), @abuf[0], @l);
 If r < 0 Then RaiseErrnoN(CErrno);
 SetLength(s, r);
 SetLength(ab, l);
 If l > 0 Then Move(abuf[0], ab[1], l);
 t := NewTuple(2);
 t.items[0] := VBytes(s);
 t.items[1] := VBytes(ab);
 Result := VObj(t);
End;

Function SkShutdown(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 If c_shutdown(ToInt64(a[0]), ToInt64(a[1])) <> 0 Then RaiseErrnoN(CErrno);
 Result := vNone;
End;

Function SkSetSockOpt(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 iv: LongInt;
 s: AnsiString;
 r: LongInt;
Begin
 If (a[3].k = vkObj) And (a[3].o Is TPyBytes) Then Begin
  s := TPyBytes(a[3].o).s;
  r := c_setsockopt(ToInt64(a[0]), ToInt64(a[1]), ToInt64(a[2]), PChar(s),
   Length(s));
 End
 Else Begin
  iv := ToInt64(a[3]);
  r := c_setsockopt(ToInt64(a[0]), ToInt64(a[1]), ToInt64(a[2]), @iv, 4);
 End;
 If r <> 0 Then RaiseErrnoN(CErrno);
 Result := vNone;
End;

Function SkGetSockOpt(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 iv: LongInt;
 l: LongWord;
 buf: AnsiString;
Begin
 If (n > 3) And (ToInt64(a[3]) > 0) Then Begin
  SetLength(buf, ToInt64(a[3]));
  l := ToInt64(a[3]);
  If c_getsockopt(ToInt64(a[0]), ToInt64(a[1]), ToInt64(a[2]), @buf[1], @l) <> 0
   Then RaiseErrnoN(CErrno);
  SetLength(buf, l);
  Result := VBytes(buf);
  Exit;
 End;
 iv := 0;
 l := 4;
 If c_getsockopt(ToInt64(a[0]), ToInt64(a[1]), ToInt64(a[2]), @iv, @l) <> 0
  Then RaiseErrnoN(CErrno);
 Result := VInt(iv);
End;

Function SkName(a: PVal; peer: Boolean): TVal;
Var
 buf: Array[0..127] Of Byte;
 l: LongWord;
 r: LongInt;
 s: AnsiString;
Begin
 l := 128;
 If peer Then r := c_getpeername(ToInt64(a[0]), @buf[0], @l)
 Else r := c_getsockname(ToInt64(a[0]), @buf[0], @l);
 If r <> 0 Then RaiseErrnoN(CErrno);
 SetLength(s, l);
 If l > 0 Then Move(buf[0], s[1], l);
 Result := VBytes(s);
End;

Function SkGetSockName(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := SkName(a, False);
End;

Function SkGetPeerName(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 Result := SkName(a, True);
End;

Function SkGetHostName(a: PVal; n: Integer; kw: TPyDict): TVal;
