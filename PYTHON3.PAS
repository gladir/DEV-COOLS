End;

Function FloatAsRatioM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 m: QWord;
 e: Integer;
 num, den: TVal;
 g, t: TVal;
Begin
 If IsNan(a[0].d) Then ValueErr('cannot convert NaN to integer ratio');
 If IsInfinite(a[0].d) Then
  RaiseExc(exOverflow, 'cannot convert Infinity to integer ratio');
 DblDecompose(Abs(a[0].d), m, e);
 num := IntFromQ(m);
 den := VInt(1);
 If e > 0 Then num := IntShl(num, e) Else If e < 0 Then den := IntShl(den, -e);
 While (IntSign(num) <> 0) And (IntSign(IntBitOp(num, VInt(1), '&')) = 0) And
  (IntCmp(den, VInt(1)) > 0) Do Begin
  num := IntShr(num, 1);
  den := IntShr(den, 1);
 End;
 If IntSign(num) = 0 Then den := VInt(1);
 If FloatSignBit(a[0].d) Then num := IntNeg(num);
 g := num;
 t := den;
 Result := Tup2(num, den);
End;

Function FloatHexM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 bits, m: QWord;
 e, i: Integer;
 r, hx: AnsiString;
 d: Double;
Begin
 d := a[0].d;
 If IsNan(d) Then Begin Result := VStr('nan'); Exit; End;
 If IsInfinite(d) Then Begin
  If d < 0 Then Result := VStr('-inf') Else Result := VStr('inf');
  Exit;
 End;
 bits := PQWord(@d)^;
 e := Integer((bits Shr 52) And $7FF);
 m := bits And QWord($FFFFFFFFFFFFF);
 If (bits Shr 63) = 1 Then r := '-' Else r := '';
 If (e = 0) And (m = 0) Then Begin
  Result := VStr(r + '0x0.0p+0');
  Exit;
 End;
 hx := '';
 For i := 12 DownTo 0 Do
  hx := hx + LowerCase(IntToHex((m Shr (4 * i)) And 15, 1));
 If e = 0 Then Begin
  r := r + '0x0.' + hx + 'p-1022';
 End Else Begin
  e := e - 1023;
  r := r + '0x1.' + hx + 'p';
  If e >= 0 Then r := r + '+';
  r := r + IntToStr(e);
 End;
 Result := VStr(r);
End;

Function FloatFromHexM(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: AnsiString;
 i, ex, fr, dropped, es, dg: Integer;
 neg, any, sticky: Boolean;
 q: QWord;
 d: Double;
 c: Char;
 v: Integer;
 ee: Int64;
Begin
 s := Trim(StrOf(a[1]));
 s := LowerCase(s);
 i := 1;
 neg := False;
 If (i <= Length(s)) And (s[i] In ['+', '-']) Then Begin
  neg := s[i] = '-';
  Inc(i);
 End;
 If (Copy(s, i, 3) = 'inf') And ((Copy(s, i, 8) = 'infinity') Or
  (i + 2 = Length(s))) Then Begin
  If neg Then Result := VFloat(-Infinity) Else Result := VFloat(Infinity);
  Exit;
 End;
 If Copy(s, i, 3) = 'nan' Then Begin
  Result := VFloat(PyNaN);
  Exit;
 End;
 If Copy(s, i, 2) = '0x' Then Inc(i, 2);
 q := 0;
 fr := 0;
 dropped := 0;
 sticky := False;
 any := False;
 dg := 0;
 While (i <= Length(s)) And (s[i] In ['0'..'9', 'a'..'f']) Do Begin
  c := s[i];
  If c <= '9' Then v := Ord(c) - 48 Else v := Ord(c) - 87;
  any := True;
  If q < (QWord(1) Shl 58) Then q := (q Shl 4) Or v
  Else Begin
   Inc(dropped);
   If v <> 0 Then sticky := True;
  End;
  Inc(i);
 End;
 If (i <= Length(s)) And (s[i] = '.') Then Begin
  Inc(i);
  While (i <= Length(s)) And (s[i] In ['0'..'9', 'a'..'f']) Do Begin
   c := s[i];
   If c <= '9' Then v := Ord(c) - 48 Else v := Ord(c) - 87;
   any := True;
   If q < (QWord(1) Shl 58) Then Begin
    q := (q Shl 4) Or v;
    Inc(fr);
   End Else If v <> 0 Then sticky := True;
   Inc(i);
  End;
 End;
 If Not any Then ValueErr('invalid hexadecimal floating-point string');
 ee := 0;
 If (i <= Length(s)) And (s[i] = 'p') Then Begin
  Inc(i);
  es := 1;
  If (i <= Length(s)) And (s[i] In ['+', '-']) Then Begin
   If s[i] = '-' Then es := -1;
   Inc(i);
  End;
  If (i > Length(s)) Or Not (s[i] In ['0'..'9']) Then
   ValueErr('invalid hexadecimal floating-point string');
  While (i <= Length(s)) And (s[i] In ['0'..'9']) Do Begin
   If ee < 100000 Then ee := ee * 10 + Ord(s[i]) - 48;
   Inc(i);
  End;
  ee := ee * es;
 End;
 If i <= Length(s) Then ValueErr('invalid hexadecimal floating-point string');
 ex := Integer(ee) - 4 * fr + 4 * dropped;
 If sticky Then q := q Or 1;
 If q = 0 Then d := 0
 Else Begin
  d := PackDouble(q, ex);
  If IsInfinite(d) Then
   RaiseExc(exOverflow, 'hexadecimal value too large to represent as a float');
 End;
 dg := dg + 1;
 If neg Then d := -d;
 Result := VFloat(d);
End;

