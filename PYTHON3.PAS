Function PxWrite(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 s: AnsiString;
 r: PtrInt;
 fd: Int64;
Begin
 fd := ToInt64(a[0]);
 s := BytesFromStr(a[1]);
 If (fd = 1) Or (fd = 2) Then OutFlush;
 If Length(s) = 0 Then Begin
  Result := VInt(0);
  Exit;
 End;
 Repeat
  r := FpWrite(fd, @s[1], Length(s));
 Until (r >= 0) Or (fpgeterrno <> 4);
 If r < 0 Then RaiseErrnoN(fpgeterrno);
 Result := VInt(r);
End;

