Begin
 Result := FileOut(TPyFile(a[0].o), TPyFile(a[0].o).data);
End;

Function IoTrack(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 i: Integer;
Begin
 If (a[0].k = vkObj) Then Begin
  For i := 0 To NFlushReg - 1 Do
   If FlushReg[i] = a[0].o Then Begin
    Result := vNone;
    Exit;
   End;
  If NFlushReg >= Length(FlushReg) Then SetLength(FlushReg, NFlushReg * 2 + 16);
  FlushReg[NFlushReg] := a[0].o;
  Inc(NFlushReg);
 End;
 Result := vNone;
End;

Function IoUntrack(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 i: Integer;
Begin
 If a[0].k = vkObj Then
  For i := NFlushReg - 1 DownTo 0 Do
   If FlushReg[i] = a[0].o Then Begin
    FlushReg[i] := FlushReg[NFlushReg - 1];
    Dec(NFlushReg);
    Break;
   End;
 Result := vNone;
End;

Procedure FlushTracked;
Var
 i: Integer;
 snap: Array Of TPyObj;
Begin
 If NFlushReg = 0 Then Exit;
 SetLength(snap, NFlushReg);
 For i := 0 To NFlushReg - 1 Do snap[i] := FlushReg[i];
 For i := 0 To High(snap) Do
  Try
   Call0(GetAttr(VObj(snap[i]), 'flush'));
  Except
   On E: EPyError Do ;
  End;
End;

Function IoFlushTracked(a: PVal; n: Integer; kw: TPyDict): TVal;
Begin
 FlushTracked;
 Result := vNone;
End;

Procedure InitIoModule(m: TPyModule);
Begin
 DefFunc(m.idict, 'track', @IoTrack);
 DefFunc(m.idict, 'untrack', @IoUntrack);
 DefFunc(m.idict, 'flush_tracked', @IoFlushTracked);
 DefFunc(m.idict, '_stringio', @SioNew);
 DefFunc(m.idict, '_bytesio', @BioNew);
 DefFunc(m.idict, '_getvalue', @SioGetValue);
 DefMethod(tyFile, 'getvalue', @SioGetValue);
 m.idict.SetS('TextIOWrapper', VObj(tyFile));
 m.idict.SetS('open', BuiltinsDict.ent[BuiltinsDict.FindS('open', HashBytes(
  'open'))].val);
End;

{ ------------------------------------------------------------
  Module _re : moteur d'expressions regulieres (retour arriere)
  ------------------------------------------------------------ }
Const
 REF_I = 2;
 REF_L = 4;
 REF_M = 8;
 REF_S = 16;
 REF_U = 32;
 REF_X = 64;
 REF_A = 256;
 { categories de classes }
 RC_DIGIT = 1;
 RC_NDIGIT = 2;
 RC_WORD = 4;
 RC_NWORD = 8;
 RC_SPACE = 16;
 RC_NSPACE = 32;
 { codes d'instruction }
 opChar = 0;      { x = point de code }
 opCharI = 1;     { x = point de code en minuscule }
 opAny = 2;       { tout sauf \n }
 opAnyAll = 3;    { tout }
 opSet = 4;       { x = index d'ensemble, y = flags }
 opBol = 5;       { ^ sans MULTILINE }
 opBolM = 6;      { ^ MULTILINE }
 opEol = 7;       { $ sans MULTILINE }
 opEolM = 8;      { $ MULTILINE }
 opBos = 9;       { \A }
 opEos = 10;      { \Z }
 opWordB = 11;    { \b, y = flags ASCII }
 opNWordB = 12;   { \B }
 opSave = 13;     { x = index de capture }
 opSplit = 14;    { x = prioritaire, y = alternative }
 opJmp = 15;
 opMatch = 16;
 opBackref = 17;  { x = groupe, y = icase }
 opLook = 18;     { x = 0 avant/1 arriere, y = largeur, z = suite, neg dans w }
 opLookEnd = 19;
 opRep = 20;      { repetition simple : x = min, y = max, z = lazy }
 opEmptyChk = 21; { x = slot, y = cible }
 opCond = 22;     { x = groupe, y = cible si absent }
 opFail = 23;

Type
 TReRange = Record
  lo, hi: Cardinal;
 End;

 TReSet = Class
  neg: Boolean;
  ranges: Array Of TReRange;
  cats: Integer;
  Procedure AddRange(lo, hi: Cardinal);
  Function Has(c: Cardinal; ascii: Boolean): Boolean;
  Function Test(c: Cardinal; icase, ascii: Boolean): Boolean;
 End;

 TReInstr = Record
  op, x, y, z, w: Integer;
 End;

 TReProg = Class
  code: Array Of TReInstr;
  n: Integer;
  sets: Array Of TReSet;
  nsets: Integer;
  ngroups: Integer;
  nslots: Integer;
  gnames: Array Of AnsiString;
  gidx: Array Of Integer;
  ngn: Integer;
  flags: Integer;
  isBytes: Boolean;
  firstCh: Integer;
  Destructor Destroy; Override;
 End;

 TReNode = Class
  kind: Integer;
  c: Cardinal;
  idx, mn, mx: Integer;
  lazy, neg: Boolean;
  flags: Integer;
  kids: Array Of TReNode;
  Procedure Add(k: TReNode);
 End;

 EReSyntax = Class(Exception)
  pos: Integer;
 End;

Const
 nkEmpty = 0;
 nkChr = 1;
 nkAnyN = 2;
 nkSetN = 3;
 nkCat = 4;
 nkAlt = 5;
 nkRepeat = 6;
 nkGroup = 7;
 nkBackref = 8;
 nkAssert = 9;
 nkLookN = 10;
 nkCondN = 11;
 nkAnchor = 12;

Procedure TReNode.Add(k: TReNode);
Begin
 SetLength(kids, Length(kids) + 1);
 kids[High(kids)] := k;
End;

Destructor TReProg.Destroy;
Var
 i: Integer;
Begin
 For i := 0 To nsets - 1 Do sets[i].Free;
 Inherited Destroy;
End;

Procedure TReSet.AddRange(lo, hi: Cardinal);
Begin
 SetLength(ranges, Length(ranges) + 1);
 ranges[High(ranges)].lo := lo;
 ranges[High(ranges)].hi := hi;
End;

Function ReIsWord(c: Cardinal; ascii: Boolean): Boolean;
Begin
 If ascii Or (c < 128) Then
  Result := ((c >= 48) And (c <= 57)) Or ((c >= 65) And (c <= 90)) Or
   ((c >= 97) And (c <= 122)) Or (c = 95)
 Else Result := CpIsAlpha(c) Or CpIsDigit(c) Or (c = 95) Or
  ((c >= $660) And (c <= $669)) Or ((c >= $FF10) And (c <= $FF19));
End;

Function ReIsDigit(c: Cardinal; ascii: Boolean): Boolean;
Begin
 If ascii Or (c < 128) Then Result := (c >= 48) And (c <= 57)
 Else Result := ((c >= $660) And (c <= $669)) Or
  ((c >= $6F0) And (c <= $6F9)) Or ((c >= $966) And (c <= $96F)) Or
  ((c >= $FF10) And (c <= $FF19));
End;

Function ReIsSpace(c: Cardinal; ascii: Boolean): Boolean;
Begin
 If ascii Then Result := (c = 32) Or ((c >= 9) And (c <= 13))
 Else Result := CpIsSpace(c);
End;

Function TReSet.Has(c: Cardinal; ascii: Boolean): Boolean;
Var
 i: Integer;
Begin
 Result := True;
 For i := 0 To High(ranges) Do
  If (c >= ranges[i].lo) And (c <= ranges[i].hi) Then Exit;
 If (cats And RC_DIGIT) <> 0 Then If ReIsDigit(c, ascii) Then Exit;
 If (cats And RC_NDIGIT) <> 0 Then If Not ReIsDigit(c, ascii) Then Exit;
 If (cats And RC_WORD) <> 0 Then If ReIsWord(c, ascii) Then Exit;
 If (cats And RC_NWORD) <> 0 Then If Not ReIsWord(c, ascii) Then Exit;
 If (cats And RC_SPACE) <> 0 Then If ReIsSpace(c, ascii) Then Exit;
 If (cats And RC_NSPACE) <> 0 Then If Not ReIsSpace(c, ascii) Then Exit;
 Result := False;
End;

Function TReSet.Test(c: Cardinal; icase, ascii: Boolean): Boolean;
Var
 r: Boolean;
 l, u: Cardinal;
Begin
 r := Has(c, ascii);
 If (Not r) And icase Then Begin
  l := CpLower(c);
  u := CpUpper(c);
  If l <> c Then r := Has(l, ascii);
  If (Not r) And (u <> c) Then r := Has(u, ascii);
 End;
 Result := r <> neg;
End;

