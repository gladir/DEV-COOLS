Function BiBytearrayCtor(a: PVal; n: Integer; kw: TPyDict): TVal;
Var
 r: TVal;
Begin
 r := BiBytesCtor(a, n, kw);
 Result := VByteArray(TPyBytes(r.o).s);
End;

