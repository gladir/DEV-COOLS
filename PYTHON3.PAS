Function VectorNorm(Const v: Array Of Double; mx: Double; foundNan: Boolean):
  Double;
Var
 x, csum, oldcsum, frac: Double;
 i: Integer;
Begin
 If IsInfinite(mx) Then Begin
  Result := mx;
  Exit;
 End;
 If foundNan Then Begin
  Result := PyNaN;
  Exit;
 End;
 If (mx = 0) Or (Length(v) <= 1) Then Begin
  Result := mx;
  Exit;
 End;
 csum := 1.0;
 frac := 0.0;
 For i := 0 To High(v) Do Begin
  x := v[i] / mx;
  x := x * x;
  oldcsum := csum;
  csum := csum + x;
  frac := frac + ((oldcsum - csum) + x);
 End;
 Result := mx * Sqrt(csum - 1.0 + frac);
End;

