 For i := 0 To n - 1 Do Begin
  v[i] := Abs(MathArg(a, i, n, 'hypot'));
  If IsNan(v[i]) Then nan := True
  Else If v[i] > mx Then mx := v[i];
 End;
 If n = 0 Then Begin
  Result := VFloat(0);
  Exit;
 End;
 Result := VFloat(VectorNorm(v, mx, nan));
End;

