  Result := VObj(a[0].o.idict)
 Else If (a[0].k = vkObj) And (a[0].o Is TPyType) Then
  Result := VObj(a[0].o.idict.Copy)
 Else TypeErr('vars() argument must have __dict__ attribute');
End;

