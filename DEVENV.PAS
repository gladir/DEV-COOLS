{ --- Demander une pause depuis l interieur d une boucle d emulateur --- }

Procedure EmuDbg_RequestBreak(ACPU: TEmuDbgCPU);
Begin
 EmuDbg.Active := True;
 EmuDbg.CPU := ACPU;
 EmuDbg.BreakReq := True;
End;

{ --- Rechercher un point d arret machine --- }

Function EmuDbg_FindBP(Addr: LongInt; ACPU: TEmuDbgCPU): Integer;
Var
 I: Integer;
Begin
 EmuDbg_FindBP := -1;
 For I := 0 To EmuDbg.BPCount - 1 Do
  If (EmuDbg.BPs[I].Addr = Addr) And
     (EmuDbg.BPs[I].CPU = ACPU) Then Begin
   EmuDbg_FindBP := I;
   Exit;
  End;
End;

{ --- Tester si une adresse correspond a un BP actif --- }

Function EmuDbg_HasBP(Addr: LongInt; ACPU: TEmuDbgCPU): Boolean;
Var
 Idx: Integer;
Begin
 Idx := EmuDbg_FindBP(Addr, ACPU);
 EmuDbg_HasBP := (Idx >= 0) And EmuDbg.BPs[Idx].Enabled;
End;

{ --- Ajouter un point d arret machine --- }

Procedure EmuDbg_AddBP(Addr: LongInt; ACPU: TEmuDbgCPU);
Begin
 If EmuDbg_FindBP(Addr, ACPU) >= 0 Then Exit;
 If EmuDbg.BPCount >= MAX_EMU_BP Then Exit;
 EmuDbg.BPs[EmuDbg.BPCount].Addr := Addr;
 EmuDbg.BPs[EmuDbg.BPCount].CPU := ACPU;
 EmuDbg.BPs[EmuDbg.BPCount].Enabled := True;
 EmuDbg.BPs[EmuDbg.BPCount].HitCount := 0;
 EmuDbg.BPs[EmuDbg.BPCount].HitCountTarget := 0;
 EmuDbg.BPs[EmuDbg.BPCount].DumpLen := 0;
 Inc(EmuDbg.BPCount);
End;

{ --- Tester si un point d arret machine doit REELEMENT declencher une   }
{ pause maintenant, en tenant compte de HitCountTarget (voir DEBUG       }
{ .../BP:SEG:OFS:N) - incremente HitCount a CHAQUE passage sur l adresse }
{ (utile pour observer combien de fois une routine partagee est appelee }
{ avant l occurrence recherchee), mais ne renvoie True qu au bon moment :}
{ immediatement si HitCountTarget=0 (comportement classique, pause a    }
{ chaque passage), sinon seulement quand HitCount atteint HitCountTarget.}
Procedure EmuDbg_DumpMemoryAt(Addr: LongInt; Len: LongInt); Forward;
Function EmuDbg_CheckBPHit(Addr: LongInt; ACPU: TEmuDbgCPU): Boolean;
Var
 Idx: Integer;
 Res: Boolean;
Begin
 Res := False;
 Idx := EmuDbg_FindBP(Addr, ACPU);
 If (Idx >= 0) And EmuDbg.BPs[Idx].Enabled Then Begin
  Inc(EmuDbg.BPs[Idx].HitCount);
  If EmuDbg.BPs[Idx].HitCountTarget <= 0 Then
   Res := True
  Else
   Res := (EmuDbg.BPs[Idx].HitCount = EmuDbg.BPs[Idx].HitCountTarget);
  If Res And (EmuDbg.BPs[Idx].DumpLen > 0) Then
   EmuDbg_DumpMemoryAt(EmuDbg.BPs[Idx].Addr, EmuDbg.BPs[Idx].DumpLen);
 End;
 EmuDbg_CheckBPHit := Res;
End;

{ --- Vider un bloc de memoire EMULEE REELLE (pas le fichier au repos) -   }
{ EMUDUMP.BIN (binaire brut, utilisable tel quel) + EMUDUMP.LOG (hexa +    }
{ ASCII, lisible directement) - declenche par un point d arret muni d un   }
{ 4e champ .../BP:SEG:OFS:N:LEN. Capture le contenu REEL a l instant du    }
{ declenchement, y compris pour du code recouvert ("overlay") en cours    }
{ d execution, que le desassemblage statique du fichier .EXE ne peut pas   }
{ refleter (voir [[project-devenv]], mystere NC3 : recouvrement $2999). }
Procedure EmuDbg_DumpMemoryAt(Addr: LongInt; Len: LongInt);
Const MAX_DUMP = 4096;
Var
 Buf: Array[0..MAX_DUMP - 1] Of Byte;
 ActualLen: Word;
 FBin: File;
 FLog: Text;
 I, J: Integer;
 HexLine, AscLine: String;
 B: Byte;
Begin
 If Len > MAX_DUMP Then Len := MAX_DUMP;
 ActualLen := Word(Len);
 Emu_ReadAbsBlock(EmuPanel.CPU, Addr, Buf, ActualLen);
 {$I-}
 Assign(FBin, 'EMUDUMP.BIN'); Rewrite(FBin, 1);
 If IOResult = 0 Then Begin
  BlockWrite(FBin, Buf, ActualLen);
  Close(FBin);
 End;
 {$I+} If IOResult <> 0 Then ;
 {$I-}
 Assign(FLog, 'EMUDUMP.LOG'); Rewrite(FLog);
 If IOResult = 0 Then Begin
  WriteLn(FLog, 'Vidage memoire emulee reelle : phys=', HexLong(Addr),
   ' longueur=', ActualLen, ' octets (EMUDUMP.BIN = memes donnees brutes)');
  WriteLn(FLog);
  I := 0;
  While I < ActualLen Do Begin
   HexLine := HexLong(Addr + I) + ' : ';
   AscLine := '';
   For J := 0 To 15 Do Begin
    If I + J < ActualLen Then Begin
     B := Buf[I + J];
     HexLine := HexLine + HexByte(B) + ' ';
     If (B >= 32) And (B <= 126) Then AscLine := AscLine + Chr(B)
     Else AscLine := AscLine + '.';
    End Else
     HexLine := HexLine + '   ';
   End;
   WriteLn(FLog, HexLine, ' ', AscLine);
   Inc(I, 16);
  End;
  Close(FLog);
 End;
 {$I+} If IOResult <> 0 Then ;
End;

{ --- Helpers pour la Console de commandes du debogueur (SoftICE/Visual   }
{ Studio/GDB, menu Deboguer > Commandes...) : aucune table nom-de-registre }
{ -> valeur ni fonction de formatage memoire en chaine n existait avant ce }
{ chantier - extraites/creees ici pour etre partagees par les 3 dialectes. }

{ Table de correspondance nom-de-registre -> valeur, insensible a la casse.
  Retourne -1 si le nom est inconnu (l appelant teste ce cas). }
Function EmuDbg_RegByName(Const Name: String; Var C: TEmuCPU): LongInt;
Var N: String;
Begin
 N := UpCaseStr(Name);
 If N = 'AX' Then EmuDbg_RegByName := Emu_GetReg16(C, 0)
 Else If N = 'CX' Then EmuDbg_RegByName := Emu_GetReg16(C, 1)
 Else If N = 'DX' Then EmuDbg_RegByName := Emu_GetReg16(C, 2)
 Else If N = 'BX' Then EmuDbg_RegByName := Emu_GetReg16(C, 3)
 Else If N = 'SP' Then EmuDbg_RegByName := Emu_GetReg16(C, 4)
 Else If N = 'BP' Then EmuDbg_RegByName := Emu_GetReg16(C, 5)
 Else If N = 'SI' Then EmuDbg_RegByName := Emu_GetReg16(C, 6)
 Else If N = 'DI' Then EmuDbg_RegByName := Emu_GetReg16(C, 7)
 Else If N = 'AL' Then EmuDbg_RegByName := Emu_GetReg8(C, 0)
 Else If N = 'CL' Then EmuDbg_RegByName := Emu_GetReg8(C, 1)
 Else If N = 'DL' Then EmuDbg_RegByName := Emu_GetReg8(C, 2)
 Else If N = 'BL' Then EmuDbg_RegByName := Emu_GetReg8(C, 3)
 Else If N = 'AH' Then EmuDbg_RegByName := Emu_GetReg8(C, 4)
 Else If N = 'CH' Then EmuDbg_RegByName := Emu_GetReg8(C, 5)
 Else If N = 'DH' Then EmuDbg_RegByName := Emu_GetReg8(C, 6)
 Else If N = 'BH' Then EmuDbg_RegByName := Emu_GetReg8(C, 7)
 Else If N = 'ES' Then EmuDbg_RegByName := Emu_GetSReg(C, 0)
 Else If N = 'CS' Then EmuDbg_RegByName := Emu_GetSReg(C, 1)
 Else If N = 'SS' Then EmuDbg_RegByName := Emu_GetSReg(C, 2)
 Else If N = 'DS' Then EmuDbg_RegByName := Emu_GetSReg(C, 3)
 Else If N = 'IP' Then EmuDbg_RegByName := C.IP
 Else If (N = 'FLAGS') Or (N = 'FL') Then EmuDbg_RegByName := C.Flags.Base
 Else EmuDbg_RegByName := -1;
End;

{ Meme table, en ecriture. Ne fait rien si le nom est inconnu (l appelant
  doit avoir deja verifie via EmuDbg_RegByName <> -1 s il veut detecter
  l erreur avant d ecrire). }
Procedure EmuDbg_SetRegByName(Const Name: String; Var C: TEmuCPU; Value: Word);
Var N: String;
Begin
 N := UpCaseStr(Name);
 If N = 'AX' Then Emu_SetReg16(C, 0, Value)
 Else If N = 'CX' Then Emu_SetReg16(C, 1, Value)
 Else If N = 'DX' Then Emu_SetReg16(C, 2, Value)
 Else If N = 'BX' Then Emu_SetReg16(C, 3, Value)
 Else If N = 'SP' Then Emu_SetReg16(C, 4, Value)
 Else If N = 'BP' Then Emu_SetReg16(C, 5, Value)
 Else If N = 'SI' Then Emu_SetReg16(C, 6, Value)
 Else If N = 'DI' Then Emu_SetReg16(C, 7, Value)
 Else If N = 'AL' Then Emu_SetReg8(C, 0, Byte(Value))
 Else If N = 'CL' Then Emu_SetReg8(C, 1, Byte(Value))
 Else If N = 'DL' Then Emu_SetReg8(C, 2, Byte(Value))
 Else If N = 'BL' Then Emu_SetReg8(C, 3, Byte(Value))
 Else If N = 'AH' Then Emu_SetReg8(C, 4, Byte(Value))
 Else If N = 'CH' Then Emu_SetReg8(C, 5, Byte(Value))
 Else If N = 'DH' Then Emu_SetReg8(C, 6, Byte(Value))
 Else If N = 'BH' Then Emu_SetReg8(C, 7, Byte(Value))
 Else If N = 'ES' Then Emu_SetSReg(C, 0, Value)
 Else If N = 'CS' Then Emu_SetSReg(C, 1, Value)
 Else If N = 'SS' Then Emu_SetSReg(C, 2, Value)
 Else If N = 'DS' Then Emu_SetSReg(C, 3, Value)
 Else If N = 'IP' Then C.IP := Value
 Else If (N = 'FLAGS') Or (N = 'FL') Then C.Flags.Base := Value;
End;

{ Formate une ligne "SEG:OFS  XX XX XX ...  ascii" (Len octets, motif deja
  utilise en ligne dans EmuDbg_DrawWindow - dump ds:/ss:) - extrait ici en
  fonction reutilisable pour la commande D de la console. }
Function EmuDbg_FormatMemLine(Var CPU: TEmuCPU; Seg, Ofs: Word; Len: Integer): String;
Var I: Integer; B: Byte; HexPart, AscPart: String;
Begin
 If Len > 16 Then Len := 16;
 HexPart := ''; AscPart := '';
 For I := 0 To Len - 1 Do Begin
  B := Emu_ReadByte(CPU, Seg, Word(Ofs + I));
  HexPart := HexPart + HexByte(B) + ' ';
  If (B >= 32) And (B <= 126) Then AscPart := AscPart + Chr(B)
  Else AscPart := AscPart + '.';
 End;
 EmuDbg_FormatMemLine := HexWord(Seg) + ':' + HexWord(Ofs) + '  ' +
  HexPart + ' ' + AscPart;
End;

{ Variante offset 32 bits (LongInt) d EmuDbg_FormatMemLine ci-dessus - utilise }
{ Emu_ReadByteL (deja capable de resoudre une base "unreal mode" via          }
{ Emu_AddrL/Emu_UnrealBase) au lieu d Emu_ReadByte, pour que D/E dans la      }
{ console interactive puissent enfin viser une adresse lineaire au-dela de    }
{ 64 Ko sans tronquer silencieusement (BOGUE REEL corrige 2026-08-25). }
Function EmuDbg_FormatMemLineL(Var CPU: TEmuCPU; Seg: Word; Ofs: LongInt;
 Len: Integer): String;
Var I: Integer; B: Byte; HexPart, AscPart: String;
Begin
 If Len > 16 Then Len := 16;
 HexPart := ''; AscPart := '';
 For I := 0 To Len - 1 Do Begin
  B := Emu_ReadByteL(CPU, Seg, Ofs + I);
  HexPart := HexPart + HexByte(B) + ' ';
  If (B >= 32) And (B <= 126) Then AscPart := AscPart + Chr(B)
  Else AscPart := AscPart + '.';
 End;
 EmuDbg_FormatMemLineL := HexWord(Seg) + ':' + HexLong(Ofs) + '  ' +
  HexPart + ' ' + AscPart;
End;

{ --- Menu contextuel (clic droit) sur la fenetre du Debogueur : outils    }
{ d investigation PERMANENTS, demandes explicitement par l utilisateur     }
{ pour continuer l enquete NC3 (et toute future investigation similaire)   }
{ sans repasser par la commande Terminal DEBUG a chaque fois. Reutilise    }
{ TContextMenu/CtxMenu (systeme deja existant pour l Explorateur de        }
{ solutions) - un seul menu contextuel actif a la fois de toute facon. }

{ --- 950 : vider 4096 octets de RAM emulee REELLE depuis CS:IP courant --- }
Procedure EmuDbg_CtxDumpRam;
Var Addr: LongInt;
Begin
 If EmuDbg.CPU <> EDC_8086 Then Exit;
 Addr := (LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + EmuPanel.CPU.IP;
 EmuDbg_DumpMemoryAt(Addr, 4096);
 AppendOutput(OutputPanel,
  'RAM videe (4096 octets depuis CS:IP=' + HexWord(EmuPanel.CPU.Segs.CS) +
  ':' + HexWord(EmuPanel.CPU.IP) + ') : EMUDUMP.BIN / EMUDUMP.LOG', 0);
End;

{ --- 951 : desassembler 300 instructions depuis CS:IP courant (memoire    }
{ EMULEE REELLE, PAS le fichier .EXE au repos - voir DISEXE pour ce cas)   }
{ dans un nouvel onglet editeur. }
Procedure EmuDbg_CtxDisasmFromIP;
Var
 Seg, Ofs: Word;
 Sz, I, WIdx: Integer;
 S, OutPath: String;
 F: Text;
Begin
 If EmuDbg.CPU <> EDC_8086 Then Exit;
 Seg := EmuPanel.CPU.Segs.CS;
 Ofs := EmuPanel.CPU.IP;
 OutPath := ExtractFilePath(ParamStr(0)) + 'EMUDISASM.ASM';
 {$I-} Assign(F, OutPath); Rewrite(F);
 If IOResult <> 0 Then Begin {$I+} Exit; End;
 WriteLn(F, '; Desassemblage EN DIRECT de la memoire emulee REELLE (pas le');
 WriteLn(F, '; fichier .EXE au repos) - utile pour du code recouvert/overlay');
 WriteLn(F, '; ou auto-modifie, que le desassemblage statique ne peut pas');
 WriteLn(F, '; refleter. Debut : ', HexWord(Seg), ':', HexWord(Ofs));
 WriteLn(F, '');
 For I := 1 To 300 Do Begin
  S := EmuDbg_Disasm8086(Seg, Ofs, Sz);
  WriteLn(F, S);
  If Sz < 1 Then Sz := 1;
  Ofs := Word(Ofs + Sz);
 End;
 Close(F);
 {$I+} If IOResult <> 0 Then ;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 WIdx := FindEditorByFileName(OutPath);
 If WIdx >= 0 Then
  ActivateWindow(WIdx)
 Else Begin
  CreateEditorWindow(OutPath);
  WIdx := WinMgr.ActiveIdx;
  LoadFile(Editors[WIdx]^.Buffer, OutPath);
  ActiveEditor := Editors[WIdx]^;
 End;
 EditorReady := True;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel,
  'Desassemblage RAM direct depuis ' + HexWord(Seg) + ':' + HexWord(Ofs) +
  ' : ' + OutPath, 0);
End;

{ --- 952 : sauvegarder l etat + le desassemblage actuellement VISIBLE     }
{ dans la fenetre du Debogueur (registres + lignes affichees) dans un      }
{ fichier texte simple. }
Procedure EmuDbg_CtxSaveText;
Var
 F: Text;
 I, Sz: Integer;
 Seg, Ofs: Word;
 S, OutPath: String;
Begin
 If EmuDbg.CPU <> EDC_8086 Then Exit;
 OutPath := 'EMUDBGTEXT.LOG';
 {$I-} Assign(F, OutPath); Rewrite(F);
 If IOResult <> 0 Then Begin {$I+} Exit; End;
 WriteLn(F, 'Debogueur 8086 - etat au moment de la sauvegarde');
 WriteLn(F, 'Cible : ', EmuPanel.BinaryPath);
 WriteLn(F, '');
 WriteLn(F, 'AX=', HexWord(EmuPanel.CPU.Regs.AX),
  '  BX=', HexWord(EmuPanel.CPU.Regs.BX),
  '  CX=', HexWord(EmuPanel.CPU.Regs.CX),
  '  DX=', HexWord(EmuPanel.CPU.Regs.DX));
 WriteLn(F, 'SI=', HexWord(EmuPanel.CPU.Regs.SI),
  '  DI=', HexWord(EmuPanel.CPU.Regs.DI),
  '  BP=', HexWord(EmuPanel.CPU.Regs.BP),
  '  SP=', HexWord(EmuPanel.CPU.Regs.SP));
 WriteLn(F, 'CS=', HexWord(EmuPanel.CPU.Segs.CS),
  '  DS=', HexWord(EmuPanel.CPU.Segs.DS),
  '  ES=', HexWord(EmuPanel.CPU.Segs.ES),
  '  SS=', HexWord(EmuPanel.CPU.Segs.SS));
 WriteLn(F, 'IP=', HexWord(EmuPanel.CPU.IP),
  '  FL=', HexWord(EmuPanel.CPU.Flags.Base));
 WriteLn(F, '');
 WriteLn(F, 'Desassemblage (fenetre visible) :');
 Seg := EmuPanel.CPU.Segs.CS;
 Ofs := EmuPanel.CPU.IP;
 For I := 0 To EmuDbg.DisasmTopOfs - 1 Do Begin
  EmuDbg_Disasm8086(Seg, Ofs, Sz);
  If Sz < 1 Then Sz := 1;
  Ofs := Word(Ofs + Sz);
 End;
 For I := 0 To EmuDbg.DisasmLines - 1 Do Begin
  S := EmuDbg_Disasm8086(Seg, Ofs, Sz);
  WriteLn(F, S);
  If Sz < 1 Then Sz := 1;
  Ofs := Word(Ofs + Sz);
 End;
 Close(F);
 {$I+} If IOResult <> 0 Then ;
 AppendOutput(OutputPanel, 'Texte du debogueur sauvegarde : ' + OutPath, 0);
End;

{ --- 953 : calculer l entropie de Shannon (bits/octet) de 4096 octets de  }
{ RAM emulee REELLE depuis CS:IP courant - signature statistique permet-   }
{ tant de distinguer du code x86 authentique (typiquement 5.5-6.5 bits/    }
{ octet) de donnees compressees/chiffrees (proche de 8.0, le maximum       }
{ theorique) - voir [[project-devenv]], mystere NC3, ou cette technique a  }
{ prouve qu une zone "executee" par erreur etait en fait un module de      }
{ recouvrement pas encore decompresse. }
Procedure EmuDbg_CtxEntropy;
Const SZ = 4096;
Var
 Buf: Array[0..SZ - 1] Of Byte;
 Freq: Array[0..255] Of LongInt;
 I: Integer;
 Addr: LongInt;
 Pr, Ent: Double;
 F: Text;
 EntStr: String;
Begin
 If EmuDbg.CPU <> EDC_8086 Then Exit;
 Addr := (LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + EmuPanel.CPU.IP;
 Emu_ReadAbsBlock(EmuPanel.CPU, Addr, Buf, SZ);
 FillChar(Freq, SizeOf(Freq), 0);
 For I := 0 To SZ - 1 Do Inc(Freq[Buf[I]]);
 Ent := 0.0;
 For I := 0 To 255 Do
  If Freq[I] > 0 Then Begin
   Pr := Freq[I] / SZ;
   Ent := Ent - Pr * (Ln(Pr) / Ln(2));
  End;
 Str(Ent:0:3, EntStr);
 {$I-} Assign(F, 'EMUENTROPY.LOG'); Rewrite(F);
 If IOResult = 0 Then Begin
  WriteLn(F, 'Entropie de ', SZ, ' octets depuis CS:IP=',
   HexWord(EmuPanel.CPU.Segs.CS), ':', HexWord(EmuPanel.CPU.IP),
   ' (phys=', HexLong(Addr), ') : ', EntStr, ' bits/octet (max 8.0)');
  WriteLn(F, 'Reference : ~5.5-6.5 = code x86 authentique typique ;');
  WriteLn(F, '            proche de 8.0 = donnees compressees/chiffrees.');
  Close(F);
 End;
 {$I+} If IOResult <> 0 Then ;
 ShowMessageBox('Entropie',
  'Entropie de ' + IntToStr(SZ) + ' octets depuis CS:IP : ' + EntStr +
  ' bits/octet (max 8.0)' + #13#10 +
  '~5.5-6.5 = code x86 authentique  /  ~8.0 = donnees compressees' + #13#10 +
  #13#10 + '(detail dans EMUENTROPY.LOG)', MB_OK, MI_INFO);
End;

{ --- Ouvrir le menu contextuel du Debogueur a la position souris --- }
Procedure EmuDbg_ShowContextMenu(MX, MY: Integer);
Begin
 If EmuDbg.CPU <> EDC_8086 Then Exit; { outils 8086 uniquement pour l instant }
