 I: Integer;
 LW: String;
Begin
 IsPascalKeyword := False;
 LW := LowerCaseStr(Word);
 For I := 0 To HL.KeywordCount - 1 Do
 Begin
  If LW = HL.Keywords[I] Then
  Begin
   IsPascalKeyword := True;
   Exit;
  End;
 End;
End;

