 SetFillStyle(SolidFill, 1);
 Bar(BX1 + 2, BY1 + 2, BX2 - 2, BY1 + TERM_LINE_HEIGHT);
 SetColor(15);
 OutTextXY(BX1 + 6, BY1 + 4, Title);
End;

