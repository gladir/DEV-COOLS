{ --- ADD-TYPE (2026-08-30, demande explicite de l'utilisateur) : la VRAIE }
{ cmdlet compile du code C#/VB et charge le type resultant dans le          }
{ processus PowerShell courant. Ce terminal n'a pas de runtime .NET ni de   }
{ systeme de types/objets (voir Add-Member ci-dessus) - MAIS possede deja   }
{ un VRAI compilateur C# autonome dans cet ecosysteme (CSCW32.EXE, voir     }
{ CSC_COMPILER_WIN32/FindCompiler/ExecuteCompiler, deja utilises par le      }
{ systeme de build de projet C# de l'IDE lui-meme) - reutilise ici tel      }
{ quel pour une action REELLE (compilation authentique, pas un stub) :     }
{ compile genuinement le code fourni et rapporte les VRAIS succes/erreurs   }
{ du compilateur, au lieu d'un silence ou d'un succes invente. Supporte les}
{ 2 formes reelles les plus courantes :                                    }
{   Add-Type -Path fichier.cs                                              }
{   Add-Type -TypeDefinition "code C# sur une seule ligne"                 }
{ Limitation honnete documentee : -TypeDefinition est ecrit dans un fichier}
{ .cs temporaire PUIS compile - ce terminal etant ligne-par-ligne (aucune   }
{ commande n'a jamais supporte de here-string "@"..."@" multiligne), seul   }
{ du code C# tenant sur UNE seule ligne est reellement utilisable ; les     }
{ guillemets englobants (quasi-systematiques dans un usage reel a une seule}
{ ligne) sont retires SPECIFIQUEMENT ici (contrairement a Add-Content       }
{ -Value, qui les garde tels quels puisqu'il s'agit de texte libre, pas de  }
{ code) car les laisser produirait une erreur de syntaxe C# garantie des le}
{ premier caractere. Et, comme Add-Member, il n'existe aucun moyen          }
{ d'INVOQUER ensuite le type compile (pas de pipeline d'objets) - seule la  }
{ compilation elle-meme (validation reelle du code + .exe reellement          }
{ genere sur disque) est effectuee, honnetement documentee comme telle. }
Procedure TermCmd_AddType(Var TP: TTerminalPanel; ParamStr: String);
Var
 UpParams, SourceFile, InlineSrc, CompilerPath, TempDir, TempSrc, TempOut: String;
 PathFlagPos, TypeDefFlagPos, ExitCode: Integer;
 Handle: Text;
 Line: String;
 Err: Word;
Begin
 UpParams := TermStrToUpper(ParamStr);
 PathFlagPos := System.Pos('-PATH', UpParams);
 TypeDefFlagPos := System.Pos('-TYPEDEFINITION', UpParams);
 SourceFile := '';
 TempDir := GetEnv('TEMP');
 If TempDir = '' Then TempDir := GetEnv('TMP');
 If TempDir = '' Then TempDir := '.';
 If PathFlagPos > 0 Then
  SourceFile := TrimStr(TermExtractParam(Copy(ParamStr, PathFlagPos + 5,
   Length(ParamStr)), 1))
 Else If TypeDefFlagPos > 0 Then Begin
  InlineSrc := TrimStr(Copy(ParamStr, TypeDefFlagPos + 15, Length(ParamStr)));
  If (Length(InlineSrc) >= 2) And (InlineSrc[1] = '"') And
     (InlineSrc[Length(InlineSrc)] = '"') Then
   InlineSrc := Copy(InlineSrc, 2, Length(InlineSrc) - 2);
  If InlineSrc = '' Then Begin
   TermAddLine(TP, 'Syntaxe : Add-Type -TypeDefinition "code C#"');
   Exit;
  End;
  TempSrc := TempDir + '\ADDTYPE_TMP.CS';
  Assign(Handle, TempSrc);
  {$I-} Rewrite(Handle); {$I+}
  If IOResult <> 0 Then Begin
   TermAddLine(TP, 'Add-Type : impossible de creer un fichier .cs temporaire.');
   Exit;
  End;
  WriteLn(Handle, InlineSrc);
  Close(Handle);
  SourceFile := TempSrc;
 End Else
  SourceFile := TermExtractParam(ParamStr, 1);
 If SourceFile = '' Then Begin
  TermAddLine(TP, 'Syntaxe : Add-Type -Path fichier.cs');
  TermAddLine(TP, '     ou : Add-Type -TypeDefinition "code C#"');
  Exit;
 End;
 If (PathFlagPos > 0) Or (TypeDefFlagPos <= 0) Then
  If Not FileExists(SourceFile) Then Begin
   TermAddLine(TP, 'Add-Type : le systeme ne trouve pas le fichier specifie : ' +
    SourceFile);
   Exit;
  End;
 CompilerPath := FindCompiler(CSC_COMPILER_WIN32);
 If CompilerPath = '' Then Begin
  TermAddLine(TP, 'Add-Type : compilateur C# (CSCW32.EXE) introuvable.');
  Exit;
 End;
 TempOut := TempDir + '\ADDTYPE_OUT.TXT';
 { BOGUE REEL trouve+corrige (2026-08-30) : les guillemets autour de        }
 { CompilerPath/SourceFile faisaient echouer Exec(COMSPEC,...) avec         }
 { "syntaxe du nom de fichier...incorrecte", alors que la MEME ligne        }
 { fonctionne parfaitement tapee a la main dans un vrai cmd.exe - confirme  }
 { en comparant avec TOUS les autres appels existants a ExecuteCompiler     }
 { dans ce fichier (VAXPCW32/DELPHI/TPC/FPC/CSC/VBC/VBNCW32/...) : AUCUN    }
 { d'entre eux ne met de guillemets, tous concatenent juste                 }
 { "CompilerPath + ' ' + SourceFile" tel quel - meme limitation assumee     }
 { partout (chemins avec espaces non supportes), pas une regression         }
 { introduite ici. }
 ExitCode := ExecuteCompiler(CompilerPath + ' ' + SourceFile, TempOut);
 Assign(Handle, TempOut);
 {$I-} Reset(Handle); {$I+}
 Err := IOResult;
 If Err = 0 Then Begin
  While Not EOF(Handle) Do Begin
   ReadLn(Handle, Line);
   If Line <> '' Then TermAddLine(TP, Line);
  End;
  Close(Handle);
 End;
 If ExitCode = 0 Then
  TermAddLine(TP, 'Add-Type : compilation reussie (' + SourceFile + ').')
 Else
  TermAddLine(TP, 'Add-Type : echec de compilation (code ' +
   IntToStr(ExitCode) + ').');
End;

{ --- ADD-VMDVDDRIVE / ADD-VMHARDDISKDRIVE / ADD-VMFIBRECHANNELHBA /       }
{ ADD-VMGROUPMEMBER (2026-08-30, demande explicite de l'utilisateur,       }
{ REVISEE suite a un DESACCORD JUSTIFIE de l'utilisateur sur la 1ere        }
{ implantation : "si BOOT/DEBUG ont lance un emulateur, il devrait etre    }
{ possible d'utiliser Add-VMDvdDrive/Add-VMHardDiskDrive" - l'utilisateur   }
{ avait raison, la 1ere version (arret honnete uniforme pour les 4)         }
{ ignorait a tort une VRAIE ressource DEJA montable a chaud dans ce         }
{ terminal : les 4 emplacements INT13h materiels (0=A:/1=B: disquettes,     }
{ 2=C:/3=D: disques durs, voir EmuFloppyOpen[]/Emu_MountDiskSlot, deja      }
{ exploites par IMGMOUNT ci-dessus) et les 2 lecteurs CD-ROM ISO9660        }
{ (EmuCdrom[0..1]/Emu_CdromOpenOne, jusqu'ici seulement montables via les   }
{ drapeaux CLI /CDROM0:/CDROM1: AU DEMARRAGE - jamais a chaud depuis le      }
{ terminal). Ces 2 commandes appellent donc REELLEMENT ces memes            }
{ mecanismes (aucune nouvelle logique de montage, juste un 2e point         }
{ d'entree avec la syntaxe/les noms Hyper-V au lieu de MOUNT/IMGMOUNT),      }
{ des qu'AU MOINS UN onglet emulateur (WK_EMU) est ouvert - condition        }
{ explicitement posee par l'utilisateur ("au moins un ou plusieurs          }
{ emulateurs actifs"), verifiee via TermAnyEmulatorOpen ci-dessous.         }
{ -VMName est accepte SYNTAXIQUEMENT (une vraie ligne de commande Hyper-V   }
{ n'est donc jamais rejetee) mais reste PUREMENT DECORATIF dans le message  }
{ de confirmation : ce terminal ne modelise qu'UN SEUL controleur de        }
{ disque/CD-ROM partage par toute la session (comme MOUNT/IMGMOUNT/BOOT     }
{ deja), jamais plusieurs machines nommees independantes - limitation        }
{ honnete DOCUMENTEE, pas une simplification silencieuse.                   }
{ Add-VMFibreChannelHba et Add-VMGroupMember RESTENT un arret honnete        }
{ (voir TermCmd_HyperVUnsupported) : aucun equivalent possible (materiel     }
{ SAN d'entreprise jamais modelisable dans un emulateur 8/16 bits) ou        }
{ aucun sens structurel (pas de VM nommee a regrouper) - la revision de      }
{ l'utilisateur portait specifiquement sur les 2 commandes de STOCKAGE,      }
{ pas sur ces 2-la. }
Function TermAnyEmulatorOpen: Boolean;
Var
 I: Integer;
Begin
 TermAnyEmulatorOpen := False;
 For I := 0 To WinMgr.WinCount - 1 Do
  If WinMgr.Windows[I].Kind = WK_EMU Then Begin
   TermAnyEmulatorOpen := True;
   Exit;
  End;
End;

{ Extrait -Path/-VMName d'une ligne de commande Add-VM* (meme technique de  }
{ recherche par SOUS-CHAINE que Add-Content/Add-Type ci-dessus - toujours   }
{ aucun vrai analyseur PowerShell dans ce terminal). }
Procedure TermParseAddVMArgs(ParamStr: String; Var PathArg, VMNameArg: String);
Var
 UpParams: String;
 PathFlagPos, VMNameFlagPos: Integer;
Begin
 UpParams := TermStrToUpper(ParamStr);
 PathFlagPos := System.Pos('-PATH', UpParams);
 VMNameFlagPos := System.Pos('-VMNAME', UpParams);
 If PathFlagPos > 0 Then
  PathArg := TrimStr(TermExtractParam(Copy(ParamStr, PathFlagPos + 5,
   Length(ParamStr)), 1))
 Else
  PathArg := '';
 If VMNameFlagPos > 0 Then
  VMNameArg := TrimStr(TermExtractParam(Copy(ParamStr, VMNameFlagPos + 7,
   Length(ParamStr)), 1))
 Else
  VMNameArg := '';
End;

Procedure TermCmd_HyperVUnsupported(Var TP: TTerminalPanel; CmdletName,
 Detail: String);
Begin
 TermAddLine(TP, CmdletName + ' : commande reconnue, mais ce terminal ' +
  'n''emule pas un hyperviseur Hyper-V.');
 TermAddLine(TP, 'Aucune machine virtuelle NOMMEE et PERSISTANTE ' +
  '(-VMName) n''existe ici : chaque emulateur (DOS/Win16/OS2/ELF64/NES/' +
  'C64/...) est un onglet ephemere lance directement depuis un fichier.');
 If Detail <> '' Then TermAddLine(TP, Detail);
End;

Procedure TermCmd_AddVMDvdDrive(Var TP: TTerminalPanel; ParamStr: String);
Var
 PathArg, VMNameArg, VMLabel: String;
 Idx: Integer;
Begin
 If Not TermAnyEmulatorOpen Then Begin
  TermAddLine(TP, 'Add-VMDvdDrive : aucun emulateur actif (voir BOOT/DEBUG) ' +
   '- rien a quoi attacher un lecteur DVD.');
  Exit;
 End;
 TermParseAddVMArgs(ParamStr, PathArg, VMNameArg);
 If VMNameArg <> '' Then VMLabel := ' (VM "' + VMNameArg + '")' Else VMLabel := '';
 If PathArg = '' Then Begin
  TermAddLine(TP, 'Add-VMDvdDrive : -Path est requis dans ce terminal - ' +
   'un lecteur DVD "vide" (media attache plus tard via Set-VMDvdDrive, non ' +
   'supportee) n''est pas modelise separement.');
  Exit;
 End;
 If Not FileExists(PathArg) Then Begin
  TermAddLine(TP, 'Add-VMDvdDrive : le systeme ne trouve pas le fichier ' +
   'specifie : ' + PathArg);
  Exit;
 End;
 Idx := -1;
 If Not EmuCdrom[0].Open Then Idx := 0
 Else If Not EmuCdrom[1].Open Then Idx := 1;
 If Idx < 0 Then Begin
  TermAddLine(TP, 'Add-VMDvdDrive : les 2 lecteurs CD-ROM emules sont deja ' +
   'monter (limite materielle reelle de ce terminal, comme IMGMOUNT).');
  Exit;
 End;
 Emu_CdromOpenOne(Idx, PathArg);
 If Not EmuCdrom[Idx].Open Then Begin
  TermAddLine(TP, 'Add-VMDvdDrive : echec du montage de ' + PathArg +
   ' (pas un volume ISO9660 valide ?).');
  Exit;
 End;
 Emu_CdromAssignDriveLetters;
 TermAddLine(TP, 'Add-VMDvdDrive' + VMLabel + ' : ' +
  Chr(65 + EmuCdrom[Idx].DriveLetter) + ': monte sur ' + PathArg + ' ("' +
  EmuCdrom[Idx].VolLabel + '").');
 If Not EmuMscdexActive Then
  TermAddLine(TP, 'Attention : la case "MSCDEX" (Options > Emulateur > ' +
   'DOS: OS) est decochee - le lecteur est monte mais restera invisible ' +
   'pour DOS tant qu''elle ne sera pas activee.');
End;

Procedure TermCmd_AddVMHardDiskDrive(Var TP: TTerminalPanel; ParamStr: String);
Var
 PathArg, VMNameArg, VMLabel: String;
 Idx: Byte;
 Found: Boolean;
Begin
 If Not TermAnyEmulatorOpen Then Begin
  TermAddLine(TP, 'Add-VMHardDiskDrive : aucun emulateur actif (voir ' +
   'BOOT/DEBUG) - rien a quoi attacher un disque dur.');
  Exit;
 End;
 TermParseAddVMArgs(ParamStr, PathArg, VMNameArg);
 If VMNameArg <> '' Then VMLabel := ' (VM "' + VMNameArg + '")' Else VMLabel := '';
 If PathArg = '' Then Begin
  TermAddLine(TP, 'Syntaxe : Add-VMHardDiskDrive -Path fichier-image ' +
   '[-VMName nom]');
  Exit;
 End;
 If Not FileExists(PathArg) Then Begin
  TermAddLine(TP, 'Add-VMHardDiskDrive : le systeme ne trouve pas le ' +
   'fichier specifie : ' + PathArg);
  Exit;
 End;
 { Emplacements 2=C:/3=D: reserves aux disques durs (INT13h), comme         }
 { IMGMOUNT - 0=A:/1=B: restent les disquettes, jamais utilisees ici. }
 Found := False;
 For Idx := 2 To 3 Do
  If Not EmuFloppyOpen[Idx] Then Begin
   Found := True;
   Break;
  End;
 If Not Found Then Begin
  TermAddLine(TP, 'Add-VMHardDiskDrive : les 2 disques durs emules (C:/D:) ' +
   'sont deja monter (limite materielle reelle de ce terminal, comme ' +
   'IMGMOUNT).');
  Exit;
 End;
 If Not Emu_MountDiskSlot(Idx, PathArg) Then Begin
  TermAddLine(TP, 'Add-VMHardDiskDrive : echec du montage de ' + PathArg +
   ' sur ' + Term_DriveLetterFromIdx(Idx) + ': .');
  Exit;
 End;
 TermAddLine(TP, 'Add-VMHardDiskDrive' + VMLabel + ' : ' +
  Term_DriveLetterFromIdx(Idx) + ': monte sur ' + PathArg + '.');
End;

Procedure TermCmd_AddVMFibreChannelHba(Var TP: TTerminalPanel; ParamStr: String);
Begin
 TermCmd_HyperVUnsupported(TP, 'Add-VMFibreChannelHba',
  'Un adaptateur Fibre Channel (reseau de stockage SAN d''entreprise) ' +
  'n''a de toute facon aucun equivalent possible dans un emulateur ' +
  '8086/16 bits/8 bits : materiel jamais modelise ici, meme en principe.');
End;

{ --- COMPLETE-VMFAILOVER (2026-08-31, demande explicite de l'utilisateur, }
{ "support complet") : RECHERCHE FAITE avant de conclure (meme discipline  }
{ que Checkpoint-VM/Clear-ItemProperty/Clear-Variable qui ont chacun       }
{ REVELE un mecanisme reel apres une recherche plus poussee - voir          }
{ [[feedback_scope_batch]]) : grep de "Replica"/"Failover"/"replication"   }
{ dans tout ce fichier -> AUCUN resultat. La VRAIE cmdlet n'a de sens que    }
{ pour Hyper-V Replica : reprise/reconciliation d'une VM apres un           }
{ basculement (planifie ou non) DEPUIS un serveur primaire VERS un serveur  }
{ replica DISTANT, avec une synchronisation CONTINUE prealable de l'etat    }
{ disque entre 2 VRAIS hotes physiques separes par un reseau, et un         }
{ historique de points de recuperation - ceci reste different, dans sa      }
{ NATURE MEME, de Checkpoint-VM/Restore-VMCheckpoint (un instantane          }
{ PONCTUEL, sur DEMANDE, d'un seul processus local, sans aucune             }
{ synchronisation continue ni notion de 2e hote). Contrairement a           }
{ Compare-VM (reinterpretation EXPLICITEMENT suggeree par l'utilisateur     }
{ lui-meme, "comparer des onglets"), aucune reinterpretation locale         }
{ raisonnable n'a ete trouvee ici qui ne serait pas une pure invention -    }
{ ce terminal est un seul processus sur une seule machine, sans aucun       }
{ concept de replication/2e hote/points de recuperation multiples a         }
{ "achever". Arret honnete, pas un manque de recherche. }
Procedure TermCmd_CompleteVMFailover(Var TP: TTerminalPanel; ParamStr: String);
Begin
 TermCmd_HyperVUnsupported(TP, 'Complete-VMFailover',
  'N''a de sens que pour Hyper-V Replica (synchronisation CONTINUE de ' +
  'l''etat disque entre 2 VRAIS hotes physiques distants, avec un ' +
