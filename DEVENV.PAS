Program DEVENV;

{$IFDEF FPC}
 {$MODE TP}
 {$H-}
 {$R-}
 { BOGUE REEL (2026-08-22, signale par l utilisateur - "EIntOverflow:       }
 { Arithmetic overflow" en executant un binaire compile depuis l IDE FP,   }
 { alors que le meme fichier compile en ligne de commande fonctionnait     }
 { sans probleme) : $R- (verification de plage) etait deja desactive ici   }
 { globalement, mais PAS $Q (verification de debordement arithmetique) -   }
 { celui-ci restait donc au gre du reglage EXTERNE du compilateur/projet   }
 { (defaut desactive pour `fpc` en ligne de commande, mais visiblement     }
 { active par defaut dans les reglages de PROJET de l IDE FP utilisee).    }
 { Ce fichier (~92 000 lignes de style Turbo Pascal historique, arithmetique}
 { sur octets/mots avec troncatures/enveloppements deliberes un peu        }
 { partout) n a jamais ete concu ni teste avec la verification de          }
 { debordement active - le rendre explicite ici, au meme endroit que $R-,  }
 { garantit un comportement coherent QUEL QUE SOIT le reglage externe du    }
 { projet/IDE, au lieu de deborder inopinement au premier calcul qui        }
 { s enveloppe deliberement (deja le cas dans de nombreuses routines        }
 { bas niveau : CRC, hachage, arithmetique CPU emule, etc.). }
 {$Q-}
{$ENDIF}

Uses DOS,
     {$IFDEF FPC}
      PtcGraph,PtcCrt,PtcMouse
     {$ELSE}
      Crt,Graph
     {$ENDIF};

{ DATA_BLOB (Win32 WinCrypt.h) - utilise par CryptProtectData ci-dessous    }
{ pour ConvertFrom-SecureString (2026-08-31). }
Type
 TDpapiBlob = Record
  cbData: LongWord;
  pbData: Pointer;
 End;

{$IFDEF WINDOWS}
Function GetAsyncKeyState(vKey: LongInt): SmallInt;
         StdCall; External 'user32.dll' Name 'GetAsyncKeyState';
Procedure WinSleep(MilliSec: LongInt);
         StdCall; External 'kernel32.dll' Name 'Sleep';
{ Fibres Win32 (2026-08-30, integration de l interprete REXX.PAS dans le    }
{ terminal "OS/2 & REXX" - demande explicite de l utilisateur) - meme       }
{ motif External 'kernel32.dll' que GetAsyncKeyState/WinSleep ci-dessus.    }
{ Permettent de vraiment suspendre l execution recursive du moteur REXX     }
{ (pile d appel complete preservee, y compris DO/SELECT imbriques) en       }
{ attente d une ligne ou d une touche tapee dans le terminal, puis de la    }
{ reprendre exactement au meme point - voir le grand bloc Rexx_* pres de    }
{ TermCmd_IMGMOUNT (Rexx_ReadLine/Rexx_ReadKey/Rexx_SwitchAndCheck). }
Function ConvertThreadToFiber(Param: Pointer): Pointer;
         StdCall; External 'kernel32.dll' Name 'ConvertThreadToFiber';
Function CreateFiber(StackSize: LongWord; StartAddr, Param: Pointer): Pointer;
         StdCall; External 'kernel32.dll' Name 'CreateFiber';
Procedure SwitchToFiber(Fiber: Pointer);
         StdCall; External 'kernel32.dll' Name 'SwitchToFiber';
Procedure DeleteFiber(Fiber: Pointer);
         StdCall; External 'kernel32.dll' Name 'DeleteFiber';
{ Pont presse-papiers WINOLDAP (Windows 95, Stage 6, INT 2Fh/AX=17xxh) -   }
{ premier acces de ce fichier a une ressource Win32 PARTAGEE avec le reste }
{ du systeme hote (pas seulement lue, comme GetAsyncKeyState, mais aussi   }
{ ECRITE) - voir Emu_DoInt2F pour la discipline "toujours refermer, meme   }
{ apres une erreur intermediaire" exigee par le document. }
Function Win_OpenClipboard(hWndOwner: LongInt): LongBool;
         StdCall; External 'user32.dll' Name 'OpenClipboard';
