   { Ne pas intercepter les clics dans l explorateur }
   If (Ev.Kind = EV_MOUSE_DOWN) And
      (Ev.MouseX >= SolExplorer.X) And
      (Ev.MouseX < SolExplorer.X + SolExplorer.Width) And
      (Ev.MouseY >= SolExplorer.Y) And
      (Ev.MouseY < SolExplorer.Y + SolExplorer.Height) Then Begin
    { Laisser passer vers HandleExplorerEvent }
   End Else If OutputPanel.Visible And
      (Ev.MouseX >= OutputPanel.X) And
      (Ev.MouseX < OutputPanel.X + OutputPanel.Width) And
      (Ev.MouseY >= OutputPanel.Y) And
      (Ev.MouseY < OutputPanel.Y + OutputPanel.Height) Then Begin
    { Laisser passer vers HandleOutputEvent }
   End Else Begin
    If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX Then Begin
     HandleHexEditorMouse(ActiveHexEditor, Ev);
     If HexEditors[WinMgr.ActiveIdx] <> Nil Then
      HexEditors[WinMgr.ActiveIdx]^ := ActiveHexEditor;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorY :=
      ActiveHexEditor.CursorOfs Div HEX_BYTES_PER_ROW;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorX :=
      ActiveHexEditor.CursorOfs Mod HEX_BYTES_PER_ROW;
    End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_FORM Then Begin
     HandleFormEditorMouse(ActiveFormEditor, Ev);
     If FormEditors[WinMgr.ActiveIdx] <> Nil Then
      FormEditors[WinMgr.ActiveIdx]^ := ActiveFormEditor;
     If ActiveFormEditor.Modified Then
      MarkWindowModified(WinMgr.ActiveIdx);
    End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_EXTMGR Then Begin
     HandleExtManagerMouse(ExtMgr, Ev);
    End Else If (Ev.Kind = EV_MOUSE_DOWN) And (Ev.MouseBtn = MB_RIGHT) Then Begin
     { Menu contextuel de l editeur de texte source (2026-08-31) - voir     }
     { ShowEditorContextMenu / Case CtxTag Of (tags 800-808). }
     PositionCursorForContextMenu(ActiveEditor, Ev.MouseX, Ev.MouseY);
     If Editors[WinMgr.ActiveIdx] <> Nil Then
      Editors[WinMgr.ActiveIdx]^ := ActiveEditor;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorY := ActiveEditor.CursorLine;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorX := ActiveEditor.CursorCol - 1;
     ShowEditorContextMenu(CtxMenu, Ev.MouseX, Ev.MouseY);
    End Else Begin
     HandleEditorMouse(ActiveEditor, Ev);
     If Editors[WinMgr.ActiveIdx] <> Nil Then
      Editors[WinMgr.ActiveIdx]^ := ActiveEditor;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorY := ActiveEditor.CursorLine;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorX := ActiveEditor.CursorCol - 1;
    End;
    Exit;
   End;
  End;
 End;
 { Evenements pour l explorateur }
 HandleExplorerEvent(SolExplorer, Ev);
 { Evenements pour le panneau de proprietes }
 HandlePropertiesEvent(PropsPanel, Ev);
 { Evenements pour le panneau de sortie }
 HandleOutputEvent(OutputPanel, Ev);
 { Evenements pour le terminal integre }
 If TermVisible Then
  HandleTerminalEvent(TermPanels[ActiveShell], Ev);
 { Evenements pour la liste d erreurs }
 HandleErrorListEvent(ErrorList, Ev);
End;

{ --- Boucle principale de l IDE --- }

Procedure MainLoop;
Var
 Ev: TEvent;
 LastBlinkState: Boolean;
 CurBlinkState: Boolean;
 ActNow: LongInt;
Begin
 QuitRequested := False;
 LastBlinkState := ProjPropCursorVisible;
 While Not QuitRequested Do Begin
  PollEvents(Ev);
  If Ev.Kind <> EV_NONE Then Begin
   DispatchEvent(Ev);
   UpdateStatusBar(StatusBar, WinMgr);
   { Ne pas redessiner tous les widgets si un menu est ouvert :
     DrawAllWidgets appelle DrawToolBar qui ecrase le menu deroulant }
   If Not MenuActive And Not CtxMenu.Visible Then
    DrawAllWidgets
   Else If CtxMenu.Visible Then Begin
    DrawAllWidgets;
    DrawContextMenu(CtxMenu);
   End;
   { BOGUE REEL corrige 2026-08-16 (signale par l utilisateur : les info-    }
   { bulles de la barre d outils ne s affichaient jamais) : au-dela du         }
   { bogue de variable de boucle deja corrige dans HandleToolBarEvent          }
   { (voir TooltipBtnIdx plus haut), DrawAllWidgets EFFACE l infobulle          }
   { juste dessinee par HandleToolBarEvent (appele plus haut dans             }
   { DispatchEvent, DONC avant ce DrawAllWidgets) - DrawWindowTabs (appelee   }
   { par DrawAllWidgets) redessine la barre d onglets exactement a l endroit  }
   { ou l infobulle vient d etre affichee (juste sous la barre d outils),      }
   { l ecrasant AVANT que quiconque n ait la moindre chance de la voir.        }
   { La redessiner ICI, juste apres, la fait apparaitre par-dessus - meme      }
   { principe que DrawContextMenu ci-dessus (deja redessine apres              }
   { DrawAllWidgets pour la meme raison). }
   If TooltipVisible Then DrawTooltip(TooltipBtnIdx);
   LastBlinkState := ProjPropCursorVisible;
  End Else Begin
   { Stage 1 (2026-08-15) : pas d execution asynchrone pour les backends   }
   { emulateur "convertis" (P.Loaded=True) - remplace l ancienne boucle     }
   { bloquante interne a ShowEmulatorPanel. Voir StepEmulator. }
   If EmuPanel.Base.Visible And EmuPanel.Loaded And EmuPanel.Running Then
    StepEmulator(EmuPanel);
   { Meme sans evenement utilisateur, redessiner si le terminal a change }
   If TermVisible And TermPanels[ActiveShell].NeedRepaint Then
    DrawTerminalPanel(TermPanels[ActiveShell]);
   { Rafraichir les compteurs "Activites observees" en direct pendant que  }
   { l emulateur DOS avance (voir StepEmulator ci-dessus) - au plus une    }
   { fois toutes les 200 ms (meme motif que DOSAsync_LastDraw/80 ms pour   }
   { DrawEmulatorPanel) : un redessin COMPLET a CHAQUE tick d inactivite   }
   { (potentiellement des centaines de fois par seconde) etait bien trop   }
   { frequent - constate empiriquement lors des tests : le contenu du      }
   { dialogue restait partiellement blanc/tronque (redessins tellement     }
   { rapproches qu ils se marchaient dessus les uns les autres avant que   }
   { l ecran ait pu presenter une image complete). }
   If EmuActivityDlg.Base.Visible Then Begin
    ActNow := GetTimestamp;
    If (ActNow - EmuActLastDraw) >= 200 Then Begin
     DrawEmuActivityDialog(EmuActivityDlg);
     EmuActLastDraw := ActNow;
    End;
   End;
   { Faire clignoter le curseur du dialogue Proprietes du projet :
     ne redessiner que lorsque l etat de clignotement change }
   If ProjPropDlg.Base.Visible Then Begin
    CurBlinkState := ProjPropCursorVisible;
    If CurBlinkState <> LastBlinkState Then Begin
     UpdateProjPropCursor(ProjPropDlg);
     LastBlinkState := CurBlinkState;
    End;
   End;
   { EXTENSION (2026-08-08) : meme mecanisme de clignotement pour le      }
   { curseur du champ de recherche live de l explorateur de solutions -       }
   { ExplorerSearchCursorVisible suit EXACTEMENT le meme cycle de 500ms        }
   { (base uniquement sur l horloge) que ProjPropCursorVisible, donc               }
   { CurBlinkState/LastBlinkState ci-dessus restent valables tels quels. }
   If SolExplorer.SearchFocused Then Begin
    CurBlinkState := ExplorerSearchCursorVisible;
    If CurBlinkState <> LastBlinkState Then Begin
     DrawExplorer(SolExplorer);
     LastBlinkState := CurBlinkState;
    End;
   End;
  End;
 End;
End;

{ --- Demarrage de l IDE (procedure Run) --- }

Procedure Run;
Var
