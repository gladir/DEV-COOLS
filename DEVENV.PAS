{ --- VOL --- }

Procedure TermCmd_VOL(Var TP: TTerminalPanel; ParamStr: String);
Var
 Idx: Byte;
 DL: Char;
 Lbl: String;
 P: String;
 Explicit: Boolean;
Begin
 P := TermExtractParam(ParamStr, 1);
 { Determiner le lecteur cible : argument explicite, ou lecteur courant }
 Explicit := (Length(P) >= 2) And (P[2] = ':');
 If Explicit Then
  DL := UpCase(P[1])
 Else If TP.VirtDrive >= 0 Then
  DL := Term_DriveLetterFromIdx(TP.VirtDrive)
 Else
  DL := 'C';
 { Lecteur virtuel (A:/B:/C:/D:) : seulement si explicitement demande,
   ou si c est le lecteur courant (sinon "VOL" sans argument sur
   l hote garde son comportement d origine, place de tenue 'C:').
   C:/D: ne comptent comme virtuels que si une image disque dur est
   effectivement montee (sinon C: designe le disque hote reel). }
 If Term_DriveIdxFromLetter(DL, Idx) And
    (Explicit Or (TP.VirtDrive >= 0)) And
    ((Idx < 2) Or EmuFloppyOpen[Idx]) Then Begin
  Term_VirtEnsureMounted(Idx);
  If Not EmuFloppyOpen[Idx] Then Begin
   TermAddLine(TP,
    'Le systeme ne peut pas trouver le lecteur specifie.');
   Exit;
  End;
  If Not FatVol[Idx].Mounted Then Begin
   TermAddLine(TP, ' Volume in drive ' + DL +
    ' has no recognized file system.');
   Exit;
  End;
  Lbl := FatVol[Idx].VolLabel;
  If Lbl = '' Then
   TermAddLine(TP, ' Volume in drive ' + DL + ' has no label.')
  Else
   TermAddLine(TP, ' Volume in drive ' + DL + ' is ' + Lbl);
  TermAddLine(TP, ' Volume Serial Number is 0000-0000');
  Exit;
 End;
 TermAddLine(TP, ' Volume in drive ' + DL + ' has no label.');
 TermAddLine(TP, ' Volume Serial Number is 1234-5678');
End;

{ --- BOOT (commande Terminal, Invite de commandes/PowerShell/OS2&REXX) --- }
{ Amorce reellement un lecteur virtuel (disquette ou disque dur monte) via  }
{ Emu_LoadBootSector/CreateEmulatorBootTab - lit son secteur 0 (MBR pour un }
{ disque dur, secteur de demarrage direct pour une disquette) et laisse le  }
{ CPU 8086 emule l executer, exactement comme un vrai BIOS le ferait.       }
{ PERIMETRE ASSUME (demande explicite de l utilisateur, clarifie via         }
{ AskUserQuestion avant implementation) : /DOS (defaut) fonctionne          }
{ REELLEMENT (reutilise le backend x86 -CD deja verifie ailleurs dans ce    }
{ fichier). /OS2 n a AUCUN noyau OS/2 emule dans cet IDE (seule la LECTURE  }
{ du systeme de fichiers HPFS existe, voir HPFS_* - pas d API/kernel OS/2)  }
{ - message explicite plutot qu un faux succes. /LINUX ne fait PAS un vrai  }
{ amorcage noyau (BIOS reel -> MBR -> GRUB/LILO -> decompression + init du  }
{ noyau Linux serait un chantier separe et bien plus consequent) : reutilise}
{ a la place le backend ELF64 x86-64 DEJA EXISTANT en cherchant un          }
{ executable nomme LINUX.ELF a la racine du lecteur (convention propre a    }
{ cet IDE, documentee ici - aucune convention Linux reelle equivalente     }
{ n existe pour un disque "brut" sans vrai chargeur de demarrage).          }
{ /LINUXARM necessiterait un emulateur de processeur ARM complet, absent    }
{ de ce fichier - message explicite, aucune tentative de simulation.        }
{ Extrait la valeur d un drapeau /DISKn:chemin depuis la chaine BRUTE (pas  }
{ decoupee par espaces comme TermExtractParam - necessaire pour accepter un }
{ chemin d image contenant des espaces, ex. "MS-DOS 6.22.vhd") - s arrete   }
{ au prochain " /" (drapeau suivant) ou a la fin de la chaine si aucun.     }
{ Recherche insensible a la casse (FlagUp doit deja etre en MAJUSCULES),    }
{ la valeur renvoyee garde la casse ORIGINALE de ParamStr. }
Function TermBoot_ExtractDiskFlag(Const ParamStr, FlagUp: String): String;
Var
 UpP, Val: String; P, Q: Integer;
Begin
 TermBoot_ExtractDiskFlag := '';
 UpP := UpCaseStr(ParamStr);
 P := Pos(FlagUp, UpP);
 If P = 0 Then Exit;
 P := P + Length(FlagUp);
 Val := Copy(ParamStr, P, Length(ParamStr) - P + 1);
 Q := Pos(' /', Val);
 If Q > 0 Then Val := Copy(Val, 1, Q - 1);
 TermBoot_ExtractDiskFlag := TrimStr(Val);
End;

{ Definies bien plus bas (pres d Emu_LoadARM64Raw) - Forward necessaire ici }
{ car TermCmd_BOOT (Etape 5, /LINUXARM64) les appelle. Emu_IsoReadLBA (deja }
{ existant, pour le montage CD-ROM du backend DOS) n avait lui-meme jamais  }
{ eu besoin d un Forward avant ce chantier - Emu_LoadARM64Kernel (bien plus }
{ haut dans le fichier que sa vraie definition, ~90800) en a desormais      }
{ besoin lui aussi. }
Function Emu_IsoReadLBA(Idx: Byte; LBA: LongInt; Var Buf: TEmuIsoSector): Boolean; Forward;
Function Arm64_FindOpenCdromSlot: Integer; Forward;
Function Emu_LoadARM64Kernel(CdIdx: Byte): Boolean; Forward;

Procedure TermCmd_BOOT(Var TP: TTerminalPanel; ParamStr: String);
Var
 P, Up, DispName: String;
 DL: Char;
 Idx: Byte;
 TempPath: String;
 Attr: Byte;
 Cluster, Sz: LongInt;
 DiskFlagFile: String;
 SlotIdx: Byte;
 CdSlot: Integer;
Begin
 P := TermExtractParam(ParamStr, 1);
 If (Length(P) < 2) Or (P[2] <> ':') Then Begin
  TermAddLine(TP, 'Syntaxe : BOOT d: [/DISK0:img] [/DISK1:img] [/DISK80:img] ' +
   '[/DISK81:img] [/CDROM:img] [/CDROM0:img] [/CDROM1:img] [/DOS] [/OS2] ' +
   '[/LINUX] [/LINUXARM] [/LINUXARM64] [/GUI] [/CMD]');
  Exit;
 End;
 DL := UpCase(P[1]);
 If Not Term_DriveIdxFromLetter(DL, Idx) Then Begin
  TermAddLine(TP, 'Lettre de lecteur invalide : ' + P);
  Exit;
 End;
 { BOGUE REEL / demande explicite de l utilisateur (2026-08-25) : BOOT ne     }
 { pouvait monter une image que si /DISK0../DISK81 avait deja ete passe EN   }
 { LIGNE DE COMMANDE au lancement de DEVENV.exe - Term_VirtEnsureMounted ne  }
 { fait que relancer Fat_TryMount sur un fichier DEJA ouvert, jamais en      }
 { ouvrir un nouveau. Sur un lancement "propre" (sans ces flags), "BOOT C:"  }
 { echouait donc toujours avec "le systeme ne peut pas trouver le lecteur    }
 { specifie", sans aucun moyen de monter une image .vhd/.img depuis le       }
 { terminal lui-meme (il fallait relancer tout l IDE avec le bon /DISK80:).  }
 { On accepte donc desormais ces 4 memes drapeaux directement sur BOOT,      }
 { reutilisant Emu_MountDiskSlot tel quel (deja le code du dialogue Outils > }
 { Disque virtuel - aucun nouveau chemin de montage, juste une 2e facon d y  }
 { acceder). }
 For SlotIdx := 0 To 3 Do Begin
  Case SlotIdx Of
   0: DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/DISK0:');
   1: DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/DISK1:');
   2: DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/DISK80:');
  Else
   DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/DISK81:');
  End;
  If DiskFlagFile <> '' Then Begin
   If Not FileExists(DiskFlagFile) Then Begin
    TermAddLine(TP, 'Image disque introuvable: ' + DiskFlagFile);
    Exit;
   End;
   If Not Emu_MountDiskSlot(SlotIdx, DiskFlagFile) Then Begin
    TermAddLine(TP, 'Echec du montage de ' + DiskFlagFile + ' sur ' +
     Term_DriveLetterFromIdx(SlotIdx) + ':');
    Exit;
   End;
  End;
 End;
 { Support direct des images CD-ROM ISO9660 depuis BOOT, avec les formes     }
 { generique /CDROM: et explicites /CDROM0:/CDROM1: - l image est montee      }
 { dans le lecteur virtuel CD-ROM associe et les lettres D:/E: recalculent    }
 { automatiquement (voir Emu_CdromAssignDriveLetters). }
 For SlotIdx := 0 To 1 Do Begin
  Case SlotIdx Of
   0: Begin
      DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/CDROM:');
      If DiskFlagFile = '' Then
       DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/CDROM0:');
     End;
   Else
      DiskFlagFile := TermBoot_ExtractDiskFlag(ParamStr, '/CDROM1:');
  End;
  If DiskFlagFile <> '' Then Begin
   If Not FileExists(DiskFlagFile) Then Begin
    TermAddLine(TP, 'Image CD-ROM introuvable: ' + DiskFlagFile);
    Exit;
   End;
   Emu_CdromOpenOne(SlotIdx, DiskFlagFile);
   Emu_CdromAssignDriveLetters;
   If Not EmuCdrom[SlotIdx].Open Then Begin
    TermAddLine(TP, 'Echec du montage de ' + DiskFlagFile + ' sur le lecteur CD-ROM ' +
     IntToStr(SlotIdx) + '.');
    Exit;
   End;
  End;
 End;
 Term_VirtEnsureMounted(Idx);
 If Not EmuFloppyOpen[Idx] Then Begin
  TermAddLine(TP, 'Le systeme ne peut pas trouver le lecteur specifie.');
  Exit;
 End;
 Up := UpCaseStr(ParamStr);
 DispName := DL + ':';
 { /GUI et /CMD (memes drapeaux globaux que la commande DEBUG, voir         }
 { EmuDbgArmPauseOnLoad/EmuCmdConsoleArmOnLoad ci-dessous, consommes dans   }
 { ShowEmulatorPanel - CreateEmulatorBootTab l appelle directement donc en  }
 { beneficie sans modification) : charge le secteur de boot SANS le        }
 { lancer, fenetre Debogueur 8086 (et Console de commandes si /CMD) deja    }
 { positionnee - utile pour inspecter/pas-a-pas un amorcage reel des la     }
 { toute premiere instruction plutot que d interrompre a la volee.          }
 { S applique uniquement a /DOS (seul style d amorcage avec un vrai CPU     }
 { 8086 continu) - sans effet pour /LINUX (ELF64, backend distinct sans     }
 { EmuDbg) ni /OS2/LINUXARM/LINUXARM64 (stubs, jamais d onglet emulateur cree). }
 If Pos('/CMD', Up) > 0 Then EmuCmdConsoleArmOnLoad := True;
 If (Pos('/GUI', Up) > 0) Or (Pos('/CMD', Up) > 0) Then EmuDbgArmPauseOnLoad := True;
 { Chantier ARM64, Etape 5 (2026-09-01) : demarrage reel d un noyau Linux   }
 { ARM64 extrait d une image ISO9660 montee (/CDROM:/CDROM0:/CDROM1: sur    }
 { CETTE commande BOOT, ou deja montee via le drapeau de demarrage /CDROM:  }
 { de DEVENV lui-meme - Arm64_FindOpenCdromSlot cherche les deux). Voir     }
 { Emu_LoadARM64Kernel pour le detail du chargement (vmlinuz+initrd.gz+DTB).}
 If Pos('/LINUXARM64', Up) > 0 Then Begin
  CdSlot := Arm64_FindOpenCdromSlot;
  If CdSlot < 0 Then Begin
   TermAddLine(TP, 'BOOT /LINUXARM64 : aucune image CD-ROM montee ' +
    '(utiliser /CDROM:fichier.iso ou l''option de demarrage /CDROM: de DEVENV).');
   Exit;
  End;
  If Not Emu_LoadARM64Kernel(Byte(CdSlot)) Then Begin
   TermAddLine(TP, 'BOOT /LINUXARM64 : install.a64\vmlinuz ou install.a64\initrd.gz ' +
    'introuvable(s), ou en-tete de noyau ARM64 invalide, sur l''image montee.');
   Exit;
  End;
  CreateEmulatorTab('Debian ARM64 (install.a64)', '-CARM64', '');
  Exit;
 End;
 If Pos('/LINUXARM', Up) > 0 Then Begin
  TermAddLine(TP,
   'BOOT /LINUXARM : aucun emulateur de processeur ARM dans cet IDE - non supporte.');
  Exit;
 End;
 If Pos('/LINUX', Up) > 0 Then Begin
  If Not FatVol[Idx].Mounted Then Begin
   TermAddLine(TP, 'BOOT /LINUX : aucun systeme de fichiers reconnu sur ' + DispName);
   Exit;
  End;
  If Fat_FindPath(Idx, '\LINUX.ELF', Attr, Cluster, Sz) And ((Attr And $10) = 0) Then Begin
   If Fat_ExtractToTempFile(Idx, Cluster, Sz, 'LINUX.ELF', TempPath) Then Begin
    CreateEmulatorTab(TempPath, '-CELF64', '');
    Exit;
   End;
  End;
  TermAddLine(TP, 'BOOT /LINUX : LINUX.ELF introuvable a la racine de ' + DispName);
  Exit;
 End;
 If Pos('/OS2', Up) > 0 Then Begin
  TermAddLine(TP,
   'BOOT /OS2 : aucun noyau OS/2 emule dans cet IDE - non supporte.');
  Exit;
 End;
 { /DOS (defaut) : amorcage reel INT19h-style, reutilise le CPU 8086 deja  }
 { verifie (Emu_LoadBootSector). }
 CreateEmulatorBootTab(Idx, DispName);
End;

{ --- NES : lance directement l emulateur Nintendo NES integre sur une     }
{ ROM tapee par son nom, depuis le Terminal (2026-08-29, demande           }
{ explicite de l utilisateur : "taper NES fichier dans Invite de           }
{ commandes/Norton Commander devrait lancer l emulateur NES") - meme        }
{ principe que le double-clic/Entree sur un .NES dans le panneau NC         }
{ (voir ~43902, CreateEmulatorTab(FullPath, '-CNES', '')), mais accessible  }
{ directement en tapant une commande, dans les 2 shells demandes. Le        }
{ chemin se resout relativement au repertoire COURANT DE CE PANNEAU -        }
{ CurDir reel du processus pour "Invite de commandes", ou TP.VirtCwd (la    }
{ navigation virtuelle propre au panneau NC actif, PAS le repertoire reel   }
{ du processus - meme distinction deja etablie pour le repli "commande     }
{ inconnue -> executable", voir TermExecuteCommand) pour Norton Commander. }
Procedure TermCmd_NES(Var TP: TTerminalPanel; ParamStr: String);
Var
 CurrParam, Dir, RomPath: String;
Begin
 { Guillemets retires (voir TermCmd_StartNesProgram) : un chemin entre      }
 { guillemets fonctionne desormais aussi tape directement dans ce shell. }
 CurrParam := YamlUnquote(TermExtractParam(ParamStr, 1));
 If CurrParam = '' Then Begin
  TermAddLine(TP, 'Syntaxe : NES fichier.nes');
  Exit;
 End;
 If TP.VirtDrive >= 0 Then Begin
  { Aucune ROM NES jamais rencontree DANS un disque FAT/D64/HPFS monte     }
  { dans ce projet - portee initiale volontairement limitee au systeme     }
  { hote, message honnete plutot que pretendre chercher. }
  TermAddLine(TP, 'NES : disque virtuel non supporte, utiliser un ' +
   'chemin du systeme hote.');
  Exit;
 End;
 If TP.Shell = SK_NCOMMANDER Then Dir := TP.VirtCwd Else GetDir(0, Dir);
 RomPath := TermFindNesRom(Dir, CurrParam);
 If RomPath = '' Then Begin
  TermAddLine(TP, 'Le systeme ne trouve pas le fichier specifie.');
  Exit;
 End;
 CreateEmulatorTab(RomPath, '-CNES', '');
End;

{ --- ATARI2600 / ATARI2600VCS, C64 / COMMODORE64, COCO3, WIN / WIN16 --- }
