{ --- ConvertFrom-SecureString --- (2026-08-31, demande explicite) : VRAI  }
{ chiffrement DPAPI (CryptProtectData, voir la declaration External pres   }
{ de SHEmptyRecycleBinA) - exactement le mecanisme reel utilise par la     }
{ vraie cmdlet sans -Key (lie a l'utilisateur+machine courants : seul le    }
{ meme compte Windows sur cette meme machine peut le rechiffrer en sens     }
{ inverse via CryptUnprotectData). Limitation honnete DISCLOSEE : ce         }
{ terminal n'a aucun type SecureString reel (pas de saisie masquee a        }
{ l'ecran) - le texte EN CLAIR d'une variable/d'un litteral est directement }
{ chiffre, contrairement a la vraie cmdlet qui chiffre un objet deja        }
{ protege en memoire. Le format de sortie est le blob DPAPI brut encode en  }
{ hexadecimal (PAS l'encapsulation .NET SecureString interne complete de la}
{ vraie cmdlet) - donc non decryptable par un VRAI ConvertTo-SecureString   }
{ PowerShell tel quel, mais le VRAI mecanisme de protection (meme frontiere }
{ de securite DPAPI) est authentique, verifiable independamment via         }
{ CryptUnprotectData. }

Type
 TDpapiByteArr = Array[0..65535] Of Byte;
 PDpapiByteArr = ^TDpapiByteArr;

Function PsDpapiProtectToHex(PlainText: AnsiString): AnsiString;
Var
 InBlob, OutBlob: TDpapiBlob;
 Res: AnsiString;
 I: LongWord;
Begin
 PsDpapiProtectToHex := '';
 If PlainText = '' Then Exit;
 {$IFDEF WINDOWS}
 InBlob.cbData := Length(PlainText);
 InBlob.pbData := @PlainText[1];
 OutBlob.cbData := 0;
 OutBlob.pbData := Nil;
 { CRYPTPROTECT_UI_FORBIDDEN = 1 : jamais d'invite Windows native, coherent }
 { avec un terminal non interactif (meme discipline que Clear-RecycleBin). }
 If CryptProtectData(InBlob, Nil, Nil, Nil, Nil, 1, OutBlob) Then Begin
  Res := '';
  For I := 0 To OutBlob.cbData - 1 Do
   Res := Res + HexByte(PDpapiByteArr(OutBlob.pbData)^[I]);
  Win_LocalFree(OutBlob.pbData);
  PsDpapiProtectToHex := Res;
 End;
 {$ENDIF}
End;

Procedure TermCmd_ConvertFromSecureString(Var TP: TTerminalPanel; ParamStr: String);
Var
 LocalArgCount, I: Integer;
 LocalArgs: Array[1..80] Of String;
 PlainArg: String;
 Encrypted: AnsiString;
Begin
 LocalArgCount := 0;
 While (TermExtractParam(ParamStr, LocalArgCount+1) <> '') And
       (LocalArgCount < 80) Do Inc(LocalArgCount);
 For I := 1 To LocalArgCount Do LocalArgs[I] := TermExtractParam(ParamStr, I);

 PlainArg := '';
 For I := 1 To LocalArgCount Do
  If TermStrToUpper(LocalArgs[I]) <> '-STRING' Then Begin
   If PlainArg <> '' Then PlainArg := PlainArg + ' ';
   PlainArg := PlainArg + LocalArgs[I];
  End;
 { Meme raison que ConvertFrom-SddlString ci-dessous : TermExtractParam ne }
 { retire jamais les guillemets d'un argument tape entre guillemets. }
 PlainArg := YamlUnquote(PlainArg);

 If PlainArg = '' Then Begin
  TermAddLine(TP, 'Syntaxe : ConvertFrom-SecureString texte  (ou -String texte)');
  TermAddLine(TP, '          $enc = ConvertFrom-SecureString $texteClair');
  Exit;
 End;
 Encrypted := PsDpapiProtectToHex(PlainArg);
 If Encrypted = '' Then
  TermAddLine(TP, 'ConvertFrom-SecureString : echec du chiffrement DPAPI.')
 Else
  TermAddLineWrapped(TP, Encrypted);
End;

{ --- ConvertFrom-SddlString --- (2026-08-31, demande explicite) : VRAIES  }
{ API Windows de securite (advapi32.dll, voir les declarations External    }
{ pres de SHEmptyRecycleBinA) - analyse REELLEMENT la chaine SDDL en        }
{ descripteur de securite binaire puis en extrait Owner/Group/DACL, aucun   }
{ analyseur SDDL ecrit a la main ici (contrairement a YAML/JSON/CSV/         }
{ Markdown : la syntaxe SDDL correspond EXACTEMENT a un appel systeme       }
{ deja existant qui fait tout le travail). Lecture des en-tetes ACL/ACE     }
{ par octets bruts (SddlByteAt/WordAt/DWordAt) plutot que par overlay de    }
{ Record Pascal, pour eviter toute divergence d'alignement/bourrage avec    }
{ la disposition memoire C reelle de ACL/ACE_HEADER. }

Function SddlByteAt(P: Pointer; Offset: LongWord): Byte;
Begin
 SddlByteAt := PDpapiByteArr(P)^[Offset];
End;

Function SddlWordAt(P: Pointer; Offset: LongWord): Word;
Begin
 SddlWordAt := PDpapiByteArr(P)^[Offset] Or
  (Word(PDpapiByteArr(P)^[Offset+1]) Shl 8);
End;

Function SddlPCharToStr(P: PChar): String;
Var
 S: String;
 I: Integer;
Begin
 S := '';
 I := 0;
 While (P[I] <> #0) And (I < 250) Do Begin
  S := S + P[I];
  Inc(I);
 End;
 SddlPCharToStr := S;
End;

Function SddlAceTypeName(T: Byte): String;
Begin
 Case T Of
  0: SddlAceTypeName := 'ACCESS_ALLOWED';
  1: SddlAceTypeName := 'ACCESS_DENIED';
  2: SddlAceTypeName := 'SYSTEM_AUDIT';
  5: SddlAceTypeName := 'ACCESS_ALLOWED_OBJECT';
  6: SddlAceTypeName := 'ACCESS_DENIED_OBJECT';
  7: SddlAceTypeName := 'SYSTEM_AUDIT_OBJECT';
 Else
  SddlAceTypeName := 'TYPE_' + IntToStr(T);
 End;
End;

Function SddlHex(V: LongWord): String;
Begin
 SddlHex := '0x' + HexByte((V Shr 24) And $FF) + HexByte((V Shr 16) And $FF) +
  HexByte((V Shr 8) And $FF) + HexByte(V And $FF);
End;

Function SddlParseToProps(Sddl: AnsiString): PPsProp;
Var
 SD, Owner, Group, Dacl, Ace, SidPtr: Pointer;
 OwnerDefaulted, GroupDefaulted, DaclPresent, DaclDefaulted: LongBool;
 OwnerStr, GroupStr, SidStr: PChar;
 AceCount, AceIdx: LongWord;
 AceType: Byte;
 AceMaskLo, AceMaskHi: Word;
 Head, Tail: PPsProp;
 ElemLbl: String;
Begin
 SddlParseToProps := Nil;
 {$IFDEF WINDOWS}
 Head := Nil; Tail := Nil;
 SD := Nil;
 If Not ConvertStringSecurityDescriptorToSecurityDescriptorA(PChar(Sddl), 1,
    SD, Nil) Then Exit;
 If GetSecurityDescriptorOwner(SD, Owner, OwnerDefaulted) And (Owner <> Nil) Then Begin
  If ConvertSidToStringSidA(Owner, OwnerStr) Then Begin
   PsAddProp(Head, Tail, 'Owner', SddlPCharToStr(OwnerStr));
   Win_LocalFree(OwnerStr);
  End;
 End;
 If GetSecurityDescriptorGroup(SD, Group, GroupDefaulted) And (Group <> Nil) Then Begin
  If ConvertSidToStringSidA(Group, GroupStr) Then Begin
   PsAddProp(Head, Tail, 'Group', SddlPCharToStr(GroupStr));
   Win_LocalFree(GroupStr);
  End;
 End;
 If GetSecurityDescriptorDacl(SD, DaclPresent, Dacl, DaclDefaulted) And
    DaclPresent And (Dacl <> Nil) Then Begin
  AceCount := SddlWordAt(Dacl, 4);
  PsAddProp(Head, Tail, 'Dacl.Count', IntToStr(AceCount));
  For AceIdx := 0 To AceCount - 1 Do
   If Win_GetAce(Dacl, AceIdx, Ace) Then Begin
    ElemLbl := YamlIndexLabel('Dacl', AceIdx);
    AceType := SddlByteAt(Ace, 0);
    AceMaskLo := SddlWordAt(Ace, 4);
    AceMaskHi := SddlWordAt(Ace, 6);
    PsAddProp(Head, Tail, ElemLbl + '.AceType', SddlAceTypeName(AceType));
    PsAddProp(Head, Tail, ElemLbl + '.AccessMask',
     SddlHex((LongWord(AceMaskHi) Shl 16) Or AceMaskLo));
    SidPtr := @(PDpapiByteArr(Ace)^[8]);
    If ConvertSidToStringSidA(SidPtr, SidStr) Then Begin
     PsAddProp(Head, Tail, ElemLbl + '.SecurityIdentifier', SddlPCharToStr(SidStr));
     Win_LocalFree(SidStr);
    End;
   End;
 End Else
  PsAddProp(Head, Tail, 'Dacl.Count', '0');
 Win_LocalFree(SD);
 SddlParseToProps := Head;
 {$ENDIF}
End;

Procedure TermCmd_ConvertFromSddlString(Var TP: TTerminalPanel; ParamStr: String);
Var
 LocalArgCount, I: Integer;
 LocalArgs: Array[1..80] Of String;
 SddlArg: String;
 Props, P: PPsProp;
Begin
 LocalArgCount := 0;
 While (TermExtractParam(ParamStr, LocalArgCount+1) <> '') And
       (LocalArgCount < 80) Do Inc(LocalArgCount);
 For I := 1 To LocalArgCount Do LocalArgs[I] := TermExtractParam(ParamStr, I);

 SddlArg := '';
 For I := 1 To LocalArgCount Do
  If TermStrToUpper(LocalArgs[I]) <> '-SDDL' Then Begin
   If SddlArg <> '' Then SddlArg := SddlArg + ' ';
   SddlArg := SddlArg + LocalArgs[I];
  End;
 { TermExtractParam ne retire jamais les guillemets (il ne coupe que sur   }
 { espace/tabulation, voir son propre commentaire) - une chaine SDDL       }
 { tapee entre guillemets sur la ligne de commande (l'usage normal, la     }
 { syntaxe SDDL contient des parentheses/point-virgules) arriverait donc   }
 { ici avec ses guillemets litteralement inclus, invalidant l'analyse.     }
 { YamlUnquote (deja ecrite) retire une seule paire de guillemets          }
 { englobants - reutilisee telle quelle plutot que de dupliquer la logique.}
 SddlArg := YamlUnquote(SddlArg);

 If SddlArg = '' Then Begin
  TermAddLine(TP, 'Syntaxe : ConvertFrom-SddlString "O:BAG:BAD:(A;;FA;;;SY)..."');
  Exit;
 End;
 Props := SddlParseToProps(SddlArg);
 If Props = Nil Then
  TermAddLine(TP, 'ConvertFrom-SddlString : chaine SDDL invalide.')
 Else Begin
  P := Props;
  While P <> Nil Do Begin
   TermAddLine(TP, P^.Name + ' : ' + P^.Value);
   P := P^.Next;
  End;
  PsDisposeProps(Props);
 End;
End;

{ --- Traitement des lignes tapees dans "PowerShell dev" (Entree) : here-  }
{ strings/assignations/lecture de propriete/substitution generique -       }
{ appelee depuis HandleTerminalEvent (touche Entree, SK_POWERSHELL         }
{ uniquement) a la place de l'echo+TermExecuteCommand generique. --- }

Function TermPSSubstituteVars(Line: String): String;
Var
 Res, Name: String;
 I, Start: Integer;
 V: PPsVar;
Begin
 Res := '';
 I := 1;
 While I <= Length(Line) Do Begin
  If Line[I] = '$' Then Begin
   Start := I + 1;
   I := Start;
   While (I <= Length(Line)) And
     (Line[I] In ['A'..'Z', 'a'..'z', '0'..'9', '_']) Do Inc(I);
   Name := Copy(Line, Start, I - Start);
   If Name = '' Then
    Res := Res + '$'
   Else Begin
    V := PsFindVar(Name);
    If (V <> Nil) And (Not V^.IsObject) And
       (Pos(#10, V^.ScalarValue) = 0) Then
     Res := Res + V^.ScalarValue
    Else
     Res := Res + '$' + Name;
   End;
  End Else Begin
   Res := Res + Line[I];
   Inc(I);
  End;
 End;
 TermPSSubstituteVars := Res;
End;

Procedure TermPSEvaluateAssignment(VarName, RHS: String);
Var
 CmdName, ArgPart, SrcVarName: String;
 SpacePos: Integer;
 SrcVar: PPsVar;
Begin
 If RHS = '' Then Begin
  PsSetScalar(VarName, '');
  Exit;
 End;
 If (Length(RHS) >= 2) And (RHS[1] = '"') And (RHS[Length(RHS)] = '"') Then Begin
  PsSetScalar(VarName, Copy(RHS, 2, Length(RHS) - 2));
  Exit;
 End;
 If (Length(RHS) >= 2) And (RHS[1] = '''') And (RHS[Length(RHS)] = '''') Then Begin
  PsSetScalar(VarName, Copy(RHS, 2, Length(RHS) - 2));
  Exit;
 End;
 If (RHS[1] = '$') And (Pos(' ', RHS) = 0) Then Begin
  SrcVar := PsFindVar(Copy(RHS, 2, Length(RHS) - 1));
  If SrcVar = Nil Then PsSetScalar(VarName, '')
  Else If SrcVar^.IsObject Then PsSetObject(VarName, PsCloneProps(SrcVar^.Props))
  Else PsSetScalar(VarName, SrcVar^.ScalarValue);
  Exit;
 End;
 SpacePos := Pos(' ', RHS);
 If SpacePos > 0 Then Begin
  CmdName := TermStrToUpper(TermTrim(Copy(RHS, 1, SpacePos - 1)));
  ArgPart := TermTrim(Copy(RHS, SpacePos + 1, Length(RHS)));
  If (CmdName = 'CONVERTFROM-YAML') And (Length(ArgPart) > 1) And
     (ArgPart[1] = '$') Then Begin
   SrcVarName := Copy(ArgPart, 2, Length(ArgPart) - 1);
   SrcVar := PsFindVar(SrcVarName);
   If (SrcVar <> Nil) And (Not SrcVar^.IsObject) Then
    PsSetObject(VarName, YamlParseToProps(SrcVar^.ScalarValue))
   Else
    PsSetScalar(VarName, '');
   Exit;
  End;
  { Meme motif reconnu que ConvertFrom-Yaml ci-dessus - reutilise le meme  }
  { squelette pour ConvertFrom-StringData/SddlString (objets) et            }
  { ConvertFrom-SecureString (scalaire, resultat = texte chiffre). }
  If (CmdName = 'CONVERTFROM-STRINGDATA') And (Length(ArgPart) > 1) And
     (ArgPart[1] = '$') Then Begin
   SrcVarName := Copy(ArgPart, 2, Length(ArgPart) - 1);
   SrcVar := PsFindVar(SrcVarName);
   If (SrcVar <> Nil) And (Not SrcVar^.IsObject) Then
    PsSetObject(VarName, StringDataParseToProps(SrcVar^.ScalarValue))
   Else
    PsSetScalar(VarName, '');
   Exit;
  End;
  If (CmdName = 'CONVERTFROM-SDDLSTRING') And (Length(ArgPart) > 1) And
     (ArgPart[1] = '$') Then Begin
   SrcVarName := Copy(ArgPart, 2, Length(ArgPart) - 1);
   SrcVar := PsFindVar(SrcVarName);
   If (SrcVar <> Nil) And (Not SrcVar^.IsObject) Then
    PsSetObject(VarName, SddlParseToProps(SrcVar^.ScalarValue))
   Else
    PsSetScalar(VarName, '');
   Exit;
  End;
  If (CmdName = 'CONVERTFROM-SECURESTRING') And (Length(ArgPart) > 1) And
     (ArgPart[1] = '$') Then Begin
   SrcVarName := Copy(ArgPart, 2, Length(ArgPart) - 1);
   SrcVar := PsFindVar(SrcVarName);
   If (SrcVar <> Nil) And (Not SrcVar^.IsObject) Then
    PsSetScalar(VarName, PsDpapiProtectToHex(SrcVar^.ScalarValue))
   Else
    PsSetScalar(VarName, '');
   Exit;
  End;
 End;
 PsSetScalar(VarName, RHS);
End;

Procedure TermPSHandleInputLine(Var TP: TTerminalPanel);
Var
 Dir, Line, Trimmed, VarName, RHS, PropPath: String;
 EqPos, DotPos: Integer;
 SrcVar: PPsVar;
Begin
 GetDir(0, Dir);
 Line := TP.InputLine;
 Trimmed := TermTrim(Line);

 If PsHereStringActive Then Begin
  TermAddLine(TP, '>> ' + Line);
  If Trimmed = '"@' Then Begin
   PsSetScalar(PsHereStringVarName, PsHereStringBuf);
   PsHereStringActive := False;
   PsHereStringBuf := '';
   PsHereStringVarName := '';
  End Else Begin
   If PsHereStringBuf <> '' Then PsHereStringBuf := PsHereStringBuf + #10;
   PsHereStringBuf := PsHereStringBuf + Line;
  End;
  Exit;
 End;

 TermAddLine(TP, 'PS ' + Dir + '> ' + Line);

 If (Length(Trimmed) > 1) And (Trimmed[1] = '$') Then Begin
  EqPos := Pos('=', Trimmed);
  If EqPos > 0 Then Begin
   VarName := TermTrim(Copy(Trimmed, 2, EqPos - 2));
   RHS := TermTrim(Copy(Trimmed, EqPos + 1, Length(Trimmed)));
   If (VarName <> '') And PsIsValidVarName(VarName) Then Begin
    If RHS = '@"' Then Begin
     PsHereStringActive := True;
     PsHereStringVarName := VarName;
     PsHereStringBuf := '';
    End Else
     TermPSEvaluateAssignment(VarName, RHS);
    Exit;
   End;
  End;
 End;

 If (Length(Trimmed) > 1) And (Trimmed[1] = '$') Then Begin
  VarName := Copy(Trimmed, 2, Length(Trimmed) - 1);
  DotPos := Pos('.', VarName);
  If DotPos > 0 Then Begin
   PropPath := Copy(VarName, DotPos + 1, Length(VarName));
   VarName := Copy(VarName, 1, DotPos - 1);
   SrcVar := PsFindVar(VarName);
   If SrcVar = Nil Then TermAddLine(TP, '')
   Else If Not SrcVar^.IsObject Then TermAddLineWrapped(TP, SrcVar^.ScalarValue)
   Else TermAddLineWrapped(TP, PsGetPropValue(SrcVar, PropPath));
  End Else Begin
   SrcVar := PsFindVar(VarName);
   If SrcVar = Nil Then TermAddLine(TP, '')
   Else If Not SrcVar^.IsObject Then TermAddLineWrapped(TP, SrcVar^.ScalarValue)
   Else TermAddLine(TP, '@{...} (objet - utilisez $' + VarName + '.propriete)');
  End;
  Exit;
 End;

 TermExecuteCommand(TP, TermPSSubstituteVars(Line));
End;

{ Chantier ARM64 (AArch64), Etape 1 (2026-09-01) : coeur du processeur seul  }
{ (registres generaux + PSTATE.NZCV + memoire physique plate), sans MMU,    }
{ sans peripherique, sans gestion d exception - voir                        }
{ project_devenv_arm64_emulator.md pour la feuille de route complete en     }
{ etapes. Prefixe ARM64_ pour l etat global (meme convention que ELF64_/    }
{ LX_), Arm64_ pour les fonctions/procedures.                               }
{ Decodage verifie de facon INDEPENDANTE avant le portage : chaque forme    }
{ d instruction ci-dessous a d abord ete simulee en Python et comparee a la }
{ vraie desassemblee produite par capstone/keystone (assembleur/            }
{ desassembleur ARM64 reels bases sur LLVM) sur un programme de test        }
{ couvrant chaque classe d instruction geree ici - aucune constante         }
{ d encodage devinee a la main.                                             }
{ Etape 2 (2026-09-01) : ARM64_Mem represente desormais la RAM physique a   }
{ partir de ARM64_RAM_BASE (et non plus l adresse 0) - meme plan memoire    }
{ que la machine "virt" de QEMU (RAM a partir de $40000000, peripheriques   }
{ MMIO en dessous), choisi des maintenant pour eviter une refonte a         }
{ l Etape 5 quand un vrai Device Tree/noyau Linux devra correspondre a ce   }
{ plan memoire. ARM64_UART_BASE/ARM64_GICD_BASE/ARM64_GICC_BASE suivent la  }
{ meme convention (GICD/GICC reserves ici, cables seulement a l Etape 3).   }
Const
 ARM64_RAM_BASE  = QWord($40000000);
 ARM64_UART_BASE = QWord($09000000);
 ARM64_UART_SIZE = QWord($1000);
 ARM64_GICD_BASE = QWord($08000000);
 ARM64_GICC_BASE = QWord($08010000);
 { Etape 3 : dechet d exception IRQ - meme niveau (EL1), pile SP_ELx (jamais }
 { SP_EL0 dans ce modele) - offset $280 dans la table de vecteurs pointee   }
 { par VBAR_EL1 (convention AArch64 fixe, independante de l implementation).}
 ARM64_VEC_IRQ_OFFSET = QWord($280);
 { Cles composees (op1,CRn,CRm,op2) des registres systeme geres par MRS/MSR }
 { - verifiees par assemblage keystone + inspection bit-a-bit reelle (voir  }
 { project_devenv_arm64_emulator.md), aucune constante devinee a la main.   }
 ARM64_SYSREG_NZCV          = 6672;
 ARM64_SYSREG_DAIF          = 6673;
 ARM64_SYSREG_CNTPCT_EL0    = 7937;
 ARM64_SYSREG_CNTFRQ_EL0    = 7936;
 ARM64_SYSREG_CNTP_CVAL_EL0 = 7954;
 ARM64_SYSREG_CNTP_TVAL_EL0 = 7952;
 ARM64_SYSREG_CNTP_CTL_EL0  = 7953;
 ARM64_SYSREG_VBAR_EL1      = 1536;
 ARM64_SYSREG_ELR_EL1       = 513;
 ARM64_SYSREG_SPSR_EL1      = 512;
 ARM64_SYSREG_SCTLR_EL1     = 128;
 ARM64_SYSREG_TTBR0_EL1     = 256;
 ARM64_SYSREG_TTBR1_EL1     = 257;
 ARM64_SYSREG_TCR_EL1       = 258;
 ARM64_SYSREG_MAIR_EL1      = 1296;
 ARM64_SYSREG_CURRENTEL     = 530;
 { Registres d identification/EL0 lus tres tot par un vrai noyau Linux      }
 { ARM64 (detection de fonctionnalites CPU, avant meme que la console ne    }
 { soit prete) - cles verifiees par assemblage keystone comme les autres.   }
 ARM64_SYSREG_MIDR_EL1        = 0;
 ARM64_SYSREG_MPIDR_EL1       = 5;
 ARM64_SYSREG_REVIDR_EL1      = 6;
 ARM64_SYSREG_ID_AA64PFR0_EL1 = 32;
 ARM64_SYSREG_ID_AA64DFR0_EL1 = 40;
 ARM64_SYSREG_ID_AA64ISAR0_EL1= 48;
 ARM64_SYSREG_ID_AA64MMFR0_EL1= 56;
 ARM64_SYSREG_CTR_EL0         = 6145;
 ARM64_SYSREG_TPIDR_EL0       = 7810;
 ARM64_SYSREG_CPACR_EL1       = 130;
 ARM64_SYSREG_TPIDR_EL1       = 1668;
 ARM64_SYSREG_MDSCR_EL1       = 18;
 ARM64_SYSREG_ID_AA64MMFR1_EL1= 57;
 ARM64_SYSREG_ID_AA64ISAR1_EL1= 49;
 ARM64_SYSREG_ID_AA64PFR1_EL1 = 33;
 ARM64_SYSREG_ID_AA64AFR0_EL1 = 44;
 ARM64_SYSREG_ID_AA64AFR1_EL1 = 45;
 ARM64_SYSREG_ID_AA64MMFR2_EL1= 58;
 ARM64_SYSREG_ID_AA64MMFR3_EL1= 59;
 ARM64_SYSREG_ID_AA64ZFR0_EL1 = 36;
 ARM64_SYSREG_ID_AA64ISAR2_EL1= 50;
 ARM64_SYSREG_DCZID_EL0       = 6151;
 ARM64_SYSREG_SP_EL0          = 520;
 ARM64_SYSREG_CLIDR_EL1       = 2049;
 ARM64_SYSREG_ID_AA64DFR1_EL1 = 41;
 { Etape 5 : plafond d instructions PAR ONGLET nettement plus eleve que les }
 { 5 000 000 partages par ELF64/OS2LX (un seul programme utilisateur) - un  }
 { vrai demarrage de noyau Linux complet execute legitimement bien plus     }
 { d instructions avant le premier message console, meme sans boucle        }
 { infinie (mise en place de TOUTES les tables de pages du noyau, etc).     }
 ARM64_MAX_STEPS = 500000000;
 { Chantier ARM64, Etape 5 : plan memoire du chargeur de noyau reel. Le     }
 { noyau se charge a RAM_BASE+text_offset (lu dans son propre en-tete, voir }
 { Emu_LoadARM64Kernel) - DTB et initrd fixes bien plus haut pour ne jamais }
 { chevaucher un noyau realiste (~38 Mo pour le vmlinuz Debian reel testé). }
 ARM64_DTB_BASE    = ARM64_RAM_BASE + QWord($04000000); { RAM_BASE+64 Mo }
 ARM64_INITRD_BASE = ARM64_RAM_BASE + QWord($08000000); { RAM_BASE+128 Mo }
 { Offsets (verifies par construction du gabarit avec la bibliotheque      }
 { Python "fdt" puis inspection binaire directe - PAS devines) des valeurs }
 { u32 grand-boutistes linux,initrd-start/-end dans ARM64_DtbTemplate,     }
 { seules proprietes du DTB qui dependent de la taille reelle de l initrd  }
 { charge (tout le reste du "materiel" decrit est fixe, voir le plan).     }
 ARM64_DTB_INITRD_START_OFS = 260;
 ARM64_DTB_INITRD_END_OFS   = 276;

Function Arm64_RegZR(Idx: Byte): QWord;
Begin
 If Idx = 31 Then Arm64_RegZR := 0
 Else Arm64_RegZR := ARM64_Reg[Idx];
End;

Procedure Arm64_SetRegZR(Idx: Byte; V: QWord);
Begin
 If Idx <> 31 Then ARM64_Reg[Idx] := V;
End;

Function Arm64_RegSP(Idx: Byte): QWord;
Begin
 If Idx = 31 Then Arm64_RegSP := ARM64_SP
 Else Arm64_RegSP := ARM64_Reg[Idx];
End;

Procedure Arm64_SetRegSP(Idx: Byte; V: QWord);
Begin
 If Idx = 31 Then ARM64_SP := V
 Else ARM64_Reg[Idx] := V;
End;

Function Arm64_BoolChar(B: Boolean): Char;
Begin
 If B Then Arm64_BoolChar := '1' Else Arm64_BoolChar := '0';
End;

Function Arm64_Bit(B: Boolean): LongWord;
Begin
 If B Then Arm64_Bit := 1 Else Arm64_Bit := 0;
End;

{ PL011 (UART0 du plan "virt") - Etape 2 : seule la transmission brute est  }
{ geree (ecrire dans DR affiche le caractere via la console texte deja      }
{ existante EmuVScr_PutChar, reutilisee telle quelle - meme motif que       }
{ Elf64_ConsoleWrite). FR (offset $18) repond toujours "TX vide/non plein,  }
{ RX vide" pour qu un noyau qui l interroge en boucle ne bloque jamais.     }
{ Les autres registres (IBRD/FBRD/LCR_H/CR/IMSC/ICR...) sont ignores tant   }
{ qu aucune interruption UART n est necessaire (voir Etape 3).              }
Function Arm64_UartRead(Offset: QWord): Byte;
Begin
 If Offset = $18 Then Arm64_UartRead := $90
 Else Arm64_UartRead := 0;
End;

Procedure Arm64_UartWrite(Offset: QWord; V: Byte);
Begin
 If Offset = 0 Then Begin
  If ARM64_Panel <> Nil Then EmuVScr_PutChar(ARM64_Panel^, Chr(V));
 End;
End;

Function Arm64_GetByte(Addr: QWord): Byte;
Begin
 If (Addr >= ARM64_UART_BASE) And (Addr < ARM64_UART_BASE + ARM64_UART_SIZE) Then
  Arm64_GetByte := Arm64_UartRead(Addr - ARM64_UART_BASE)
 Else If (Addr >= ARM64_RAM_BASE) And ((Addr - ARM64_RAM_BASE) <= QWord(High(ARM64_Mem))) Then
  Arm64_GetByte := ARM64_Mem[LongInt(Addr - ARM64_RAM_BASE)]
 Else
  Arm64_GetByte := 0;
End;

Procedure Arm64_PutByte(Addr: QWord; V: Byte);
Begin
 If (Addr >= ARM64_UART_BASE) And (Addr < ARM64_UART_BASE + ARM64_UART_SIZE) Then
  Arm64_UartWrite(Addr - ARM64_UART_BASE, V)
 Else If (Addr >= ARM64_RAM_BASE) And ((Addr - ARM64_RAM_BASE) <= QWord(High(ARM64_Mem))) Then
  ARM64_Mem[LongInt(Addr - ARM64_RAM_BASE)] := V;
End;

{ GICv2 minimal (Etape 3) - une seule source geree : IRQ 30 (PPI, minuteur  }
{ EL1 non securise). Registres accedes en un seul mot de 32 bits par le     }
{ noyau reel (jamais octet par octet) - traites ici comme des acces 32     }
{ bits ATOMIQUES plutot que 4 appels Arm64_GetByte/PutByte separes,         }
{ deliberement : GICC_IAR a un effet de bord a la lecture (accuse de        }
{ reception) qui serait applique 4 fois - une par octet - si on le          }
{ decomposait naivement, avec un risque reel d incoherence entre les        }
{ octets lus (voir Arm64_GetMem/PutMem ci-dessous pour le branchement).     }
Function Arm64_GicdRead32(Offset: QWord): LongWord;
Begin
 Case Offset Of
  $000: Arm64_GicdRead32 := Arm64_Bit(ARM64_GicDistEnable);
  $100, $180: Arm64_GicdRead32 := ARM64_GicEnableMask; { ISENABLER0/ICENABLER0 }
  Else Arm64_GicdRead32 := 0;
 End;
End;

Procedure Arm64_GicdWrite32(Offset: QWord; V: LongWord);
Begin
 Case Offset Of
  $000: ARM64_GicDistEnable := (V And 1) <> 0;
  $100: ARM64_GicEnableMask := ARM64_GicEnableMask Or V;        { ISENABLER0 : 1=activer }
  $180: ARM64_GicEnableMask := ARM64_GicEnableMask And (Not V); { ICENABLER0 : 1=desactiver }
 End;
End;

Function Arm64_GiccRead32(Offset: QWord): LongWord;
Begin
 Case Offset Of
  $000: Arm64_GiccRead32 := Arm64_Bit(ARM64_GicCpuEnable);
  $004: Arm64_GiccRead32 := ARM64_GicPmr;
  $00C: Begin { IAR : lecture = accuse de reception (pending -> active) }
         If ARM64_GicPending Then Begin
          ARM64_GicActive := True;
          Arm64_GiccRead32 := 30;
         End Else
          Arm64_GiccRead32 := 1023; { $3FF = spurious, aucune IRQ reelle }
        End;
  Else Arm64_GiccRead32 := 0;
 End;
End;

Procedure Arm64_GiccWrite32(Offset: QWord; V: LongWord);
Begin
 Case Offset Of
  $000: ARM64_GicCpuEnable := (V And 1) <> 0;
  $004: ARM64_GicPmr := Byte(V And $FF);
  $010: If V = 30 Then ARM64_GicActive := False; { EOIR }
 End;
End;

Function Arm64_GetMem(Addr: QWord; ByteWidth: Byte): QWord;
Var
 I: Byte;
 R: QWord;
Begin
 If (ByteWidth = 4) And (Addr >= ARM64_GICD_BASE) And (Addr < ARM64_GICD_BASE + $10000) Then Begin
  Arm64_GetMem := Arm64_GicdRead32(Addr - ARM64_GICD_BASE);
  Exit;
 End;
 If (ByteWidth = 4) And (Addr >= ARM64_GICC_BASE) And (Addr < ARM64_GICC_BASE + $10000) Then Begin
  Arm64_GetMem := Arm64_GiccRead32(Addr - ARM64_GICC_BASE);
  Exit;
 End;
 R := 0;
 For I := 0 To ByteWidth - 1 Do
  R := R Or (QWord(Arm64_GetByte(Addr + I)) Shl (I * 8));
 Arm64_GetMem := R;
End;

Procedure Arm64_PutMem(Addr: QWord; V: QWord; ByteWidth: Byte);
Var
 I: Byte;
Begin
 If (ByteWidth = 4) And (Addr >= ARM64_GICD_BASE) And (Addr < ARM64_GICD_BASE + $10000) Then Begin
  Arm64_GicdWrite32(Addr - ARM64_GICD_BASE, LongWord(V));
  Exit;
 End;
 If (ByteWidth = 4) And (Addr >= ARM64_GICC_BASE) And (Addr < ARM64_GICC_BASE + $10000) Then Begin
  Arm64_GiccWrite32(Addr - ARM64_GICC_BASE, LongWord(V));
  Exit;
 End;
 For I := 0 To ByteWidth - 1 Do
  Arm64_PutByte(Addr + I, Byte((V Shr (I * 8)) And $FF));
End;

{ Chantier ARM64, Etape 4 (2026-09-01) : traduction stage-1 uniquement       }
{ (granule 4 Ko, 2 a 4 niveaux selon TCR_EL1.T0SZ/T1SZ - pas de stage-2/    }
{ EL2, inutile sans virtualisation). TRADUCTION SEULE : aucune faute n est  }
{ injectee dans l invite (pas de VBAR+$0/$400 synchrone) - toute traduction }
{ impossible arrete proprement l emulateur (ARM64_Halted), meme discipline  }
{ que le reste du decodeur, plutot que de deviner un comportement de repli. }
{ Descripteurs de bloc/table verifies contre le format VMSAv8-64 reel (bit0 }
{ =valide, bit1=type table/bloc, bits[47:12]=adresse de sortie/table        }
{ suivante) - AP/SH/AttrIndx/AF ignores (traduction pure, pas de modele de  }
{ permission ni de fault d acces).                                          }
{ Etape 5 (2026-09-02) : double table TTBR0/TTBR1 - un vrai noyau Linux     }
{ bascule vers TTBR1_EL1 (espace noyau "haut") une fois ses propres tables  }
{ pretes, rencontre reellement en poursuivant le demarrage du vrai vmlinuz  }
{ de debian-13.6.0-arm64-netinst.iso au-dela du point ou l Etape 4          }
{ s arretait. Selection simplifiee mais correcte en pratique (utilisee par  }
{ la quasi-totalite des implementations reelles pour une configuration      }
{ T0SZ/T1SZ symetrique, systematiquement le cas sous Linux) : VA[63]=0 ->   }
{ TTBR0, VA[63]=1 -> TTBR1, plutot que la verification formelle complete    }
{ "bits[63:T0SZ] tous nuls / bits[63:T1SZ] tous uns, sinon fault" - une     }
{ configuration symetrique rend les deux verifications equivalentes.       }
Function Arm64_Translate(VA: QWord; Var PA: QWord): Boolean;
Var
 TxSZ, VABits: Byte;
 StartLevel, Level: Integer;
 TableBase, DescAddr, Desc, BlockMask: QWord;
 Idx: QWord;
 Shift: Byte;
 UseTTBR1: Boolean;
Begin
 Arm64_Translate := False;
 If (ARM64_Sctlr And 1) = 0 Then Begin { MMU desactivee : adressage direct }
  PA := VA;
  Arm64_Translate := True;
  Exit;
 End;
 UseTTBR1 := (VA And QWord($8000000000000000)) <> 0;
 If UseTTBR1 Then
  TxSZ := Byte((ARM64_Tcr Shr 16) And $3F) { T1SZ }
 Else
  TxSZ := Byte(ARM64_Tcr And $3F); { T0SZ }
 If TxSZ > 51 Then Exit; { hors bornes possibles (VABits deviendrait < 13) }
 VABits := 64 - TxSZ;
 If (VABits <= 12) Or (((VABits - 12) Mod 9) <> 0) Then Exit; { TxSZ non standard }
 StartLevel := 4 - ((VABits - 12) Div 9);
 If (StartLevel < 0) Or (StartLevel > 3) Then Exit;
 If UseTTBR1 Then
  TableBase := ARM64_Ttbr1 And QWord($0000FFFFFFFFF000)
 Else
  TableBase := ARM64_Ttbr0 And QWord($0000FFFFFFFFF000);
 For Level := StartLevel To 3 Do Begin
  Shift := Byte(12 + (3 - Level) * 9);
  Idx := (VA Shr Shift) And $1FF;
  DescAddr := TableBase + (Idx * 8);
  Desc := Arm64_GetMem(DescAddr, 8);
  If (Desc And 1) = 0 Then Exit; { descripteur non valide }
  If Level = 3 Then Begin
   If (Desc And 2) = 0 Then Exit; { doit etre une page au dernier niveau }
   PA := (Desc And QWord($0000FFFFFFFFF000)) Or (VA And $FFF);
   Arm64_Translate := True;
   Exit;
  End;
  If (Desc And 2) = 0 Then Begin { descripteur de bloc a ce niveau }
   BlockMask := (QWord(1) Shl Shift) - 1;
   PA := (Desc And QWord($0000FFFFFFFFF000) And (Not BlockMask)) Or (VA And BlockMask);
   Arm64_Translate := True;
   Exit;
  End;
  TableBase := Desc And QWord($0000FFFFFFFFF000); { descripteur de table }
 End;
End;

Function Arm64_FetchInstr(PC: QWord): LongWord;
Var
 PA: QWord;
Begin
 If Not Arm64_Translate(PC, PA) Then Begin
  ARM64_Halted := True;
  ARM64_LastBadPC := PC;
  ARM64_HaltReason := 'faute de traduction MMU (recherche d instruction) a VA=$' + HexQWord(PC);
  Arm64_FetchInstr := 0;
  Exit;
 End;
 Arm64_FetchInstr := LongWord(Arm64_GetMem(PA, 4));
End;

{ Acces memoire "virtuels" - point d entree utilise par LDR/STR/LDP/STP :   }
{ traduit d abord (Arm64_Translate se replie sur l identite si la MMU est   }
{ desactivee, donc ces wrappers sont surs a utiliser inconditionnellement)  }
{ puis delegue aux accesseurs physiques Arm64_GetMem/PutMem ci-dessus.      }
Function Arm64_GetMemV(VA: QWord; ByteWidth: Byte): QWord;
Var
 PA: QWord;
Begin
 If Not Arm64_Translate(VA, PA) Then Begin
  ARM64_Halted := True;
  ARM64_LastBadPC := ARM64_PC;
  ARM64_HaltReason := 'faute de traduction MMU (lecture) a VA=$' + HexQWord(VA);
  Arm64_GetMemV := 0;
  Exit;
 End;
 Arm64_GetMemV := Arm64_GetMem(PA, ByteWidth);
End;

Procedure Arm64_PutMemV(VA: QWord; V: QWord; ByteWidth: Byte);
Var
 PA: QWord;
Begin
 If Not Arm64_Translate(VA, PA) Then Begin
  ARM64_Halted := True;
  ARM64_LastBadPC := ARM64_PC;
  ARM64_HaltReason := 'faute de traduction MMU (ecriture) a VA=$' + HexQWord(VA);
  Exit;
 End;
 Arm64_PutMem(PA, V, ByteWidth);
End;

{ Extension de signe d un champ de Bits bits (complement a 2) vers 64 bits. }
Function Arm64_SignExtend(Val: QWord; Bits: Byte): QWord;
Var
 SignBit, FieldMask: QWord;
Begin
 FieldMask := (QWord(1) Shl Bits) - 1;
 Val := Val And FieldMask;
 SignBit := QWord(1) Shl (Bits - 1);
 If (Val And SignBit) <> 0 Then
  Arm64_SignExtend := Val Or (Not FieldMask)
 Else
  Arm64_SignExtend := Val;
End;

{ Decalage arithmetique a droite manuel - le Shr de FPC est TOUJOURS        }
{ logique, meme applique a un type signe, donc implante ici a la main       }
{ plutot que de supposer un comportement de langage non garanti.           }
Function Arm64_AsrManual(Val: QWord; Amount, Width: Byte): QWord;
Var
 SignBit, R: QWord;
Begin
 If Width = 32 Then SignBit := $80000000 Else SignBit := QWord($8000000000000000);
 R := Val Shr Amount;
 If (Val And SignBit) <> 0 Then Begin
  If Width = 32 Then
   R := (R Or (QWord($FFFFFFFF) Shl (32 - Amount))) And $FFFFFFFF
  Else
   R := R Or (QWord($FFFFFFFFFFFFFFFF) Shl (64 - Amount));
 End;
 Arm64_AsrManual := R;
End;

Function Arm64_ApplyShift(Val: QWord; ShiftType, Amount: Byte; Is32: Boolean): QWord;
Var
 Width: Byte;
 V32: LongWord;
 R: QWord;
Begin
 If Is32 Then Width := 32 Else Width := 64;
 If Amount = 0 Then Begin
  Arm64_ApplyShift := Val;
  Exit;
 End;
 Case ShiftType Of
  0: R := Val Shl Amount;                          { LSL }
  1: R := Val Shr Amount;                          { LSR }
  2: R := Arm64_AsrManual(Val, Amount, Width);      { ASR }
  Else Begin                                        { ROR }
   If Is32 Then Begin
    V32 := LongWord(Val);
    R := QWord((V32 Shr Amount) Or (V32 Shl (32 - Amount)));
   End Else
    R := (Val Shr Amount) Or (Val Shl (64 - Amount));
  End;
 End;
 If Is32 Then R := R And $FFFFFFFF;
 Arm64_ApplyShift := R;
End;

{ NZCV apres une addition (ADD/ADDS/CMN) - A et B doivent deja etre         }
{ masques a la largeur voulue par l appelant, Res = A+B tronque a la meme   }
{ largeur.                                                                  }
Procedure Arm64_FlagsAfterAdd(A, B, Res: QWord; Is32: Boolean);
Var
 SignMask: QWord;
Begin
 If Is32 Then SignMask := $80000000 Else SignMask := QWord($8000000000000000);
 ARM64_FlagN := (Res And SignMask) <> 0;
 ARM64_FlagZ := Res = 0;
 If Is32 Then
  ARM64_FlagC := ((A And $FFFFFFFF) + (B And $FFFFFFFF)) > $FFFFFFFF
 Else
  ARM64_FlagC := Res < A;
 ARM64_FlagV := (((Not (A Xor B)) And (A Xor Res)) And SignMask) <> 0;
End;

{ NZCV apres une soustraction (SUB/SUBS/CMP) - convention ARM : C=1         }
{ signifie "pas d emprunt" (A>=B non signe), l INVERSE de la convention x86 }
{ ou CF=1 signifie qu un emprunt a eu lieu - detail facile a inverser par   }
{ erreur, ce qui casserait silencieusement chaque branchement conditionnel. }
Procedure Arm64_FlagsAfterSub(A, B, Res: QWord; Is32: Boolean);
Var
 SignMask: QWord;
Begin
 If Is32 Then SignMask := $80000000 Else SignMask := QWord($8000000000000000);
 ARM64_FlagN := (Res And SignMask) <> 0;
 ARM64_FlagZ := Res = 0;
 ARM64_FlagC := A >= B;
 ARM64_FlagV := (((A Xor B) And (A Xor Res)) And SignMask) <> 0;
End;

Procedure Arm64_FlagsAfterLogical(Res: QWord; Is32: Boolean);
Var
 SignMask: QWord;
Begin
 If Is32 Then SignMask := $80000000 Else SignMask := QWord($8000000000000000);
 ARM64_FlagN := (Res And SignMask) <> 0;
 ARM64_FlagZ := Res = 0;
 ARM64_FlagC := False;
 ARM64_FlagV := False;
End;

Function Arm64_CondHolds(Cond: Byte): Boolean;
Begin
 Case Cond Of
  0:  Arm64_CondHolds := ARM64_FlagZ;                                        { EQ }
  1:  Arm64_CondHolds := Not ARM64_FlagZ;                                    { NE }
  2:  Arm64_CondHolds := ARM64_FlagC;                                        { CS/HS }
  3:  Arm64_CondHolds := Not ARM64_FlagC;                                    { CC/LO }
  4:  Arm64_CondHolds := ARM64_FlagN;                                        { MI }
  5:  Arm64_CondHolds := Not ARM64_FlagN;                                    { PL }
  6:  Arm64_CondHolds := ARM64_FlagV;                                        { VS }
  7:  Arm64_CondHolds := Not ARM64_FlagV;                                    { VC }
  8:  Arm64_CondHolds := ARM64_FlagC And (Not ARM64_FlagZ);                  { HI }
  9:  Arm64_CondHolds := Not (ARM64_FlagC And (Not ARM64_FlagZ));            { LS }
  10: Arm64_CondHolds := ARM64_FlagN = ARM64_FlagV;                          { GE }
  11: Arm64_CondHolds := ARM64_FlagN <> ARM64_FlagV;                         { LT }
  12: Arm64_CondHolds := (Not ARM64_FlagZ) And (ARM64_FlagN = ARM64_FlagV);  { GT }
  13: Arm64_CondHolds := Not ((Not ARM64_FlagZ) And (ARM64_FlagN = ARM64_FlagV)); { LE }
  Else Arm64_CondHolds := True;                                              { AL, NV }
 End;
End;

{ Lecture MRS d un registre systeme identifie par sa cle composee (voir les }
{ constantes ARM64_SYSREG_*) - renvoie False si la cle est inconnue (l      }
{ appelant traite alors l instruction comme non geree, meme discipline que  }
{ le reste du decodeur).                                                    }
Function Arm64_MrsRead(SysKey: LongWord; Var Val: QWord): Boolean;
Begin
 Arm64_MrsRead := True;
 Case SysKey Of
  ARM64_SYSREG_NZCV: Val := (QWord(Arm64_Bit(ARM64_FlagN)) Shl 31) Or
   (QWord(Arm64_Bit(ARM64_FlagZ)) Shl 30) Or (QWord(Arm64_Bit(ARM64_FlagC)) Shl 29) Or
   (QWord(Arm64_Bit(ARM64_FlagV)) Shl 28);
  ARM64_SYSREG_DAIF: Val := QWord(Arm64_Bit(ARM64_DaifI)) Shl 7;
  ARM64_SYSREG_CNTPCT_EL0: Val := ARM64_CntPct;
  ARM64_SYSREG_CNTFRQ_EL0: Val := ARM64_CntFreq;
  ARM64_SYSREG_CNTP_CVAL_EL0: Val := ARM64_CntpCval;
  ARM64_SYSREG_CNTP_TVAL_EL0: Val := (ARM64_CntpCval - ARM64_CntPct) And $FFFFFFFF;
  ARM64_SYSREG_CNTP_CTL_EL0: Val := QWord(Arm64_Bit(ARM64_CntpEnable)) Or
   (QWord(Arm64_Bit(ARM64_CntpImask)) Shl 1) Or (QWord(Arm64_Bit(ARM64_GicPending)) Shl 2);
  ARM64_SYSREG_VBAR_EL1: Val := ARM64_VBAR_EL1;
  ARM64_SYSREG_ELR_EL1: Val := ARM64_ELR_EL1;
  ARM64_SYSREG_SPSR_EL1: Val := ARM64_SPSR_EL1;
  ARM64_SYSREG_SCTLR_EL1: Val := ARM64_Sctlr;
  ARM64_SYSREG_TTBR0_EL1: Val := ARM64_Ttbr0;
  ARM64_SYSREG_TTBR1_EL1: Val := ARM64_Ttbr1;
  ARM64_SYSREG_TCR_EL1: Val := ARM64_Tcr;
  ARM64_SYSREG_MAIR_EL1: Val := ARM64_Mair;
  ARM64_SYSREG_CURRENTEL: Val := 4; { EL[3:2]=01 (EL1) }
  { Etape 5 : registres d identification lus tres tot par un vrai noyau.   }
  ARM64_SYSREG_MIDR_EL1: Val := 0; { implementeur inconnu - evite tout       }
                                    { contournement d erratum materiel bases }
                                    { sur une signature MIDR precise.        }
  ARM64_SYSREG_MPIDR_EL1: Val := $80000000; { bit31 RAO, Aff0=0 (CPU0 seul) }
  ARM64_SYSREG_REVIDR_EL1: Val := 0;
  ARM64_SYSREG_ID_AA64PFR0_EL1: Val := $FF000011; { EL0/EL1 AArch64 seul,    }
                                    { EL2/EL3 absents, FP/AdvSIMD "non       }
                                    { implante" (evite que le noyau utilise  }
                                    { des instructions FP/NEON non gerees).  }
  ARM64_SYSREG_ID_AA64DFR0_EL1: Val := 0; { pas de PMU/debogueur materiel }
  ARM64_SYSREG_ID_AA64ISAR0_EL1: Val := 0; { aucune extension optionnelle -  }
                                    { force le repli sur LDXR/STXR (geres)   }
                                    { plutot que sur des atomiques LSE       }
                                    { (CAS/etc, non geres).                  }
  ARM64_SYSREG_ID_AA64MMFR0_EL1: Val := 5; { PARange=0101 (48 bits), coherent}
                                    { avec Arm64_Translate (granule 4 Ko).   }
  ARM64_SYSREG_CTR_EL0: Val := $80038003; { lignes de cache 32 octets -      }
                                    { purement indicatif, DC/IC sont deja    }
                                    { des no-op.                             }
  ARM64_SYSREG_TPIDR_EL0: Val := ARM64_Tpidr0;
  ARM64_SYSREG_TPIDR_EL1: Val := ARM64_Tpidr1;
  ARM64_SYSREG_CPACR_EL1: Val := ARM64_Cpacr;
  ARM64_SYSREG_MDSCR_EL1: Val := ARM64_Mdscr;
  ARM64_SYSREG_SP_EL0: Val := ARM64_SpEl0;
  ARM64_SYSREG_ID_AA64MMFR1_EL1, ARM64_SYSREG_ID_AA64ISAR1_EL1,
  ARM64_SYSREG_ID_AA64PFR1_EL1, ARM64_SYSREG_ID_AA64AFR0_EL1,
  ARM64_SYSREG_ID_AA64AFR1_EL1, ARM64_SYSREG_ID_AA64MMFR2_EL1,
  ARM64_SYSREG_ID_AA64MMFR3_EL1, ARM64_SYSREG_ID_AA64ZFR0_EL1,
  ARM64_SYSREG_ID_AA64ISAR2_EL1,
  ARM64_SYSREG_ID_AA64DFR1_EL1: Val := 0; { aucune fonctionnalite optionnelle }
  ARM64_SYSREG_DCZID_EL0: Val := $10; { DZP=1 (DC ZVA interdite) - evite que  }
   { le noyau compte sur DC ZVA pour mettre a zero de la memoire : DC/IC     }
   { restent des no-op purs dans cet emulateur (voir la famille "$D50"), un  }
   { DZP=0 aurait ete une fausse promesse silencieuse (memoire jamais        }
   { reellement mise a zero) plutot qu un arret propre.                      }
  ARM64_SYSREG_CLIDR_EL1: Val := 0; { tous les champs Ctype(n)=000 : aucun    }
   { niveau de cache decrit - le noyau (cacheinfo/__flush_dcache_all) saute   }
   { alors proprement toute la boucle d enumeration CCSIDR_EL1/CSSELR_EL1     }
   { (non geres), comportement architecturalement valide pour un coeur sans   }
   { hierarchie de cache annoncee.                                           }
  Else Arm64_MrsRead := False;
 End;
End;

{ Ecriture MSR d un registre systeme - meme convention (False = cle         }
{ inconnue).                                                                }
Function Arm64_MsrWrite(SysKey: LongWord; Val: QWord): Boolean;
Begin
 Arm64_MsrWrite := True;
 Case SysKey Of
  ARM64_SYSREG_NZCV: Begin
   ARM64_FlagN := (Val And $80000000) <> 0;
   ARM64_FlagZ := (Val And $40000000) <> 0;
   ARM64_FlagC := (Val And $20000000) <> 0;
   ARM64_FlagV := (Val And $10000000) <> 0;
  End;
  ARM64_SYSREG_DAIF: ARM64_DaifI := (Val And $80) <> 0;
  ARM64_SYSREG_CNTP_CVAL_EL0: ARM64_CntpCval := Val;
  ARM64_SYSREG_CNTP_TVAL_EL0: ARM64_CntpCval := ARM64_CntPct + Arm64_SignExtend(Val And $FFFFFFFF, 32);
  ARM64_SYSREG_CNTP_CTL_EL0: Begin
   ARM64_CntpEnable := (Val And 1) <> 0;
   ARM64_CntpImask := (Val And 2) <> 0;
  End;
  ARM64_SYSREG_VBAR_EL1: ARM64_VBAR_EL1 := Val;
  ARM64_SYSREG_ELR_EL1: ARM64_ELR_EL1 := Val;
  ARM64_SYSREG_SPSR_EL1: ARM64_SPSR_EL1 := Val;
  ARM64_SYSREG_SCTLR_EL1: ARM64_Sctlr := Val;
  ARM64_SYSREG_TTBR0_EL1: ARM64_Ttbr0 := Val;
  ARM64_SYSREG_TTBR1_EL1: ARM64_Ttbr1 := Val;
  ARM64_SYSREG_TCR_EL1: ARM64_Tcr := Val;
  ARM64_SYSREG_MAIR_EL1: ARM64_Mair := Val;
  ARM64_SYSREG_TPIDR_EL0: ARM64_Tpidr0 := Val;
  ARM64_SYSREG_TPIDR_EL1: ARM64_Tpidr1 := Val;
  ARM64_SYSREG_CPACR_EL1: ARM64_Cpacr := Val;
  ARM64_SYSREG_MDSCR_EL1: ARM64_Mdscr := Val;
  ARM64_SYSREG_SP_EL0: ARM64_SpEl0 := Val;
  Else Arm64_MsrWrite := False;
 End;
End;

{ Avance le minuteur generique ARM (CNTPCT_EL0) et met a jour l etat "en    }
{ attente" du GIC pour l IRQ 30 - signal a NIVEAU (recalcule entierement a  }
{ chaque pas, jamais juste latch/OR) : reflete fidelement le fait qu un     }
{ noyau qui reprogramme CNTP_CVAL_EL0 dans le futur desasserte le signal,   }
{ exactement comme le ferait le vrai minuteur materiel. Appelee une fois    }
{ par instruction executee, depuis Arm64_RunOneChunk.                       }
Procedure Arm64_TickTimer;
Begin
 Inc(ARM64_CntPct);
 ARM64_GicPending := ARM64_CntpEnable And (Not ARM64_CntpImask) And
  (ARM64_CntPct >= ARM64_CntpCval);
End;

{ Distribution d IRQ minimale (GICv2, source unique). Meme motif que        }
{ Emu_ServiceIrqs (backend DOS) : verifie d abord le masque PSTATE.I - qui  }
{ a lui seul empeche toute reentrance pendant le gestionnaire, exactement   }
{ comme sur un vrai coeur ARM64 - avant de consulter l etat du GIC. Appelee }
{ une fois par instruction executee, depuis Arm64_RunOneChunk.              }
Procedure Arm64_ServiceIrq;
Begin
 If ARM64_Halted Then Exit;
 If ARM64_DaifI Then Exit;
 If Not ARM64_GicDistEnable Then Exit;
 If Not ARM64_GicCpuEnable Then Exit;
 If (ARM64_GicEnableMask And (LongWord(1) Shl 30)) = 0 Then Exit;
 If ARM64_GicPmr = 0 Then Exit;
 If Not ARM64_GicPending Then Exit;
 { Entree d exception IRQ, meme niveau (EL1), pile SP_ELx - offset $280.    }
 ARM64_ELR_EL1 := ARM64_PC;
 ARM64_SPSR_EL1 := (QWord(Arm64_Bit(ARM64_FlagN)) Shl 31) Or
  (QWord(Arm64_Bit(ARM64_FlagZ)) Shl 30) Or (QWord(Arm64_Bit(ARM64_FlagC)) Shl 29) Or
  (QWord(Arm64_Bit(ARM64_FlagV)) Shl 28) Or (QWord(Arm64_Bit(ARM64_DaifI)) Shl 7) Or
  QWord(5); { M[3:0] = EL1h (EL1 avec SP_EL1) }
 ARM64_DaifI := True;
 ARM64_ExValid := False; { Etape 4 : une exception efface le moniteur exclusif }
 ARM64_PC := ARM64_VBAR_EL1 + ARM64_VEC_IRQ_OFFSET;
End;

{ UBFM/SBFM/BFM (Etape 5) - couvre LSL/LSR/ASR/UBFX/SBFX/UBFIZ/SBFIZ/BFI/    }
{ BFXIL/UXTB/UXTH/SXTB/SXTH/SXTW comme cas particuliers du MEME calcul, au  }
{ lieu de reconnaitre chaque alias separement. Formules verifiees par       }
{ EXECUTION REELLE (Unicorn, moteur d emulation CPU de la meme famille que  }
{ keystone/capstone) sur chaque alias plutot que reconstruites de memoire   }
{ depuis le pseudocode ARM (le cas "immr>imms", utilise par LSL/UBFIZ/      }
{ SBFIZ/BFI, est notoirement facile a mal implanter - une premiere tentative}
{ a la main s est revelee fausse a l execution avant que Unicorn ne         }
{ permette de la corriger). Deux cas seulement, sans algorithme de masque   }
{ generalise (DecodeBitMasks) : }
{  - immr<=imms ("extraction", couvre LSR/ASR/UBFX/SBFX/UXT*/SXT*/BFXIL) :  }
{    Lsb=immr, Width=imms-immr+1, Extracted=(Src Shr Lsb) And WidthMask.    }
{  - immr>imms ("insertion", couvre LSL/UBFIZ/SBFIZ/BFI) : Lsb=Datasize-    }
{    immr, Width=imms+1, Field=Src And WidthMask, resultat=Field Shl Lsb.   }
Procedure Arm64_DoBfm(Opc: Byte; Immr, Imms: Byte; Is32: Boolean; Rn, Rd: Byte);
Var
 Datasize, Width, Lsb: Byte;
 Src, RdOld, Field, Res, WidthMask: QWord;
Begin
 If Is32 Then Datasize := 32 Else Datasize := 64;
 Src := Arm64_RegZR(Rn);
 If Is32 Then Src := Src And $FFFFFFFF;
 RdOld := Arm64_RegZR(Rd);
 If Immr <= Imms Then Begin
  Lsb := Immr;
  Width := Imms - Immr + 1;
  If Width >= 64 Then WidthMask := QWord($FFFFFFFFFFFFFFFF)
  Else WidthMask := (QWord(1) Shl Width) - 1;
  Field := (Src Shr Lsb) And WidthMask;
  Case Opc Of
   0: Res := Arm64_SignExtend(Field, Width);               { SBFM }
   1: Res := (RdOld And (Not WidthMask)) Or Field;          { BFM (BFXIL) }
   Else Res := Field;                                       { UBFM }
  End;
 End Else Begin
  Lsb := Byte((Datasize - Immr) Mod Datasize);
  Width := Imms + 1;
  If Width >= 64 Then WidthMask := QWord($FFFFFFFFFFFFFFFF)
  Else WidthMask := (QWord(1) Shl Width) - 1;
  Field := Src And WidthMask;
  Case Opc Of
   0: Res := Arm64_SignExtend(Field, Width) Shl Lsb;                     { SBFM }
   1: Res := (RdOld And (Not (WidthMask Shl Lsb))) Or (Field Shl Lsb);   { BFM (BFI) }
   Else Res := Field Shl Lsb;                                            { UBFM }
  End;
 End;
 If Is32 Then Res := Res And $FFFFFFFF;
 Arm64_SetRegZR(Rd, Res);
End;

{ Bits hauts d une multiplication 64x64 NON SIGNEE (128 bits, moitie haute) }
{ - decomposition scolaire 32x32 standard, verifiee par execution reelle    }
{ (Unicorn) sur plusieurs cas incluant les bornes avant ce portage.         }
Function Arm64_UMulH(A, B: QWord): QWord;
Var
 ALo, AHi, BLo, BHi: QWord;
 LoLo, LoHi, HiLo, HiHi, Mid, ResHi: QWord;
Begin
 ALo := A And $FFFFFFFF; AHi := A Shr 32;
 BLo := B And $FFFFFFFF; BHi := B Shr 32;
 LoLo := ALo * BLo;
 LoHi := ALo * BHi;
 HiLo := AHi * BLo;
 HiHi := AHi * BHi;
 Mid := (LoLo Shr 32) + (LoHi And $FFFFFFFF) + (HiLo And $FFFFFFFF);
 ResHi := HiHi + (LoHi Shr 32) + (HiLo Shr 32) + (Mid Shr 32);
 Arm64_UMulH := ResHi;
End;

Function Arm64_UDiv(A, B: QWord; Is32: Boolean): QWord;
Begin
 If Is32 Then Begin A := A And $FFFFFFFF; B := B And $FFFFFFFF; End;
 If B = 0 Then Arm64_UDiv := 0 Else Arm64_UDiv := A Div B;
End;

Function Arm64_SDiv(A, B: QWord; Is32: Boolean): QWord;
Var
 Ai, Bi, Ri: Int64;
Begin
 If Is32 Then Begin
  Ai := Int64(LongInt(A And $FFFFFFFF));
  Bi := Int64(LongInt(B And $FFFFFFFF));
 End Else Begin
  Ai := Int64(A);
  Bi := Int64(B);
 End;
 If Bi = 0 Then Ri := 0
 Else If (Bi = -1) And (Ai = Int64($8000000000000000)) Then Ri := Ai
 Else Ri := Ai Div Bi;
 Arm64_SDiv := QWord(Ri);
End;

Function Arm64_FullMask(Bits: Byte): QWord;
Begin
 If Bits >= 64 Then Arm64_FullMask := QWord($FFFFFFFFFFFFFFFF)
 Else Arm64_FullMask := (QWord(1) Shl Bits) - 1;
End;

{ Decodage des masques immediat "logiques" (AND/ORR/EOR/ANDS #imm, TST =    }
{ alias ANDS Rd=XZR) - Etape 5, halte reelle rencontree tres tot dans un    }
{ vrai noyau Linux ARM64 (TST teste des bits de PSTATE/drapeaux tres        }
{ frequemment). Algorithme DecodeBitMasks standard - verifie sur 5 cas      }
{ reels couvrant des tailles d element 64/32/8 bits (assembles avec         }
{ keystone, calcul manuel confirme AVANT ce portage, voir                   }
{ project_devenv_arm64_emulator.md) plutot que reconstruit de memoire sans  }
{ verification (risque connu et documente pour cette famille precise       }
{ d instructions).                                                          }
Function Arm64_DecodeBitMaskImm(N, Immr, Imms: Byte; Is32: Boolean): QWord;
Var
 Tmp: Byte;
 Len, ESize, S, R: Byte;
 Welem, Elem, FullE, Res: QWord;
 I: Byte;
Begin
 Tmp := Byte((N Shl 6) Or ((Not Imms) And $3F));
 Len := 0;
 For I := 6 Downto 0 Do
  If (Tmp And (1 Shl I)) <> 0 Then Begin Len := I; Break; End;
 ESize := Byte(1 Shl Len);
 FullE := Arm64_FullMask(ESize);
 S := Imms And (ESize - 1);
 R := Immr And (ESize - 1);
 Welem := Arm64_FullMask(S + 1);
 If R = 0 Then Elem := Welem
 Else Elem := ((Welem Shr R) Or (Welem Shl (ESize - R))) And FullE;
 Res := 0;
 I := 0;
 If Is32 Then Begin
  While I < 32 Do Begin Res := Res Or (Elem Shl I); Inc(I, ESize); End;
  Res := Res And $FFFFFFFF;
 End Else Begin
  While I < 64 Do Begin Res := Res Or (Elem Shl I); Inc(I, ESize); End;
 End;
 Arm64_DecodeBitMaskImm := Res;
End;

{ REV/REV16/REV32/RBIT/CLZ/CLS ("Data-processing a une source") - Etape 5, }
{ rencontres en traitant le Device Tree (conversion gros-boutiste - REV     }
{ est l operation naturelle pour lire un champ big-endian). Formules        }
{ verifiees par execution reelle (Unicorn) avant ce portage.                }
Function Arm64_RevBytes(V: QWord; NBytes: Byte): QWord;
Var
 I: Byte;
 Res: QWord;
Begin
 Res := 0;
 For I := 0 To NBytes - 1 Do
  Res := Res Or (((V Shr (I * 8)) And $FF) Shl ((NBytes - 1 - I) * 8));
 Arm64_RevBytes := Res;
End;

Function Arm64_RevChunks(V: QWord; TotalBytes, ChunkBytes: Byte): QWord;
Var
 I: Byte;
 Res, Chunk: QWord;
Begin
 Res := 0;
 I := 0;
 While I < TotalBytes Do Begin
  Chunk := (V Shr (I * 8)) And Arm64_FullMask(ChunkBytes * 8);
  Chunk := Arm64_RevBytes(Chunk, ChunkBytes);
  Res := Res Or (Chunk Shl (I * 8));
  Inc(I, ChunkBytes);
 End;
 Arm64_RevChunks := Res;
End;

Function Arm64_RevBits(V: QWord; NBits: Byte): QWord;
Var
 I: Byte;
 Res: QWord;
Begin
 Res := 0;
 For I := 0 To NBits - 1 Do
  If (V And (QWord(1) Shl I)) <> 0 Then
   Res := Res Or (QWord(1) Shl (NBits - 1 - I));
 Arm64_RevBits := Res;
End;

Function Arm64_Clz(V: QWord; NBits: Byte): QWord;
Var
 I: Integer;
 Count: QWord;
Begin
 Count := 0;
 For I := NBits - 1 Downto 0 Do Begin
  If (V And (QWord(1) Shl I)) <> 0 Then Break;
  Inc(Count);
 End;
 Arm64_Clz := Count;
End;

Function Arm64_Cls(V: QWord; NBits: Byte): QWord;
Var
 SignSet: Boolean;
 I: Integer;
 Count: QWord;
Begin
 SignSet := (V And (QWord(1) Shl (NBits - 1))) <> 0;
 Count := 0;
 For I := NBits - 2 Downto 0 Do Begin
  If (((V Shr I) And 1) <> 0) <> SignSet Then Break;
  Inc(Count);
 End;
 Arm64_Cls := Count;
End;

{ Charge/stocke Rt a l adresse virtuelle Addr - partage entre la forme      }
{ "decalage non signe" et la forme "immediat signe (non ecrit/post-index/   }
{ pre-index)" de LDR/STR (Etape 4 : Opc=2/3, chargements signes LDRSB/      }
{ LDRSH/LDRSW, geres ici en plus de STR/LDR de base).                       }
Procedure Arm64_DoLdrStr(Addr: QWord; Size, Opc, Rt: Byte);
Var
 ByteWidth: Byte;
 Val: QWord;
Begin
 ByteWidth := Byte(1 Shl Size);
 Case Opc Of
  0: Arm64_PutMemV(Addr, Arm64_RegZR(Rt), ByteWidth);                      { STR }
  1: Begin Val := Arm64_GetMemV(Addr, ByteWidth); Arm64_SetRegZR(Rt, Val); End; { LDR, zero-extension }
  2: Begin { LDRS* -> registre X (extension de signe sur 64 bits) }
      Val := Arm64_GetMemV(Addr, ByteWidth);
      Arm64_SetRegZR(Rt, Arm64_SignExtend(Val, ByteWidth * 8));
     End;
  3: Begin { LDRS* -> registre W (extension de signe sur 32 bits, LDRSW exclu} { en pratique reelle mais non garde explicitement) }
      Val := Arm64_GetMemV(Addr, ByteWidth);
      Arm64_SetRegZR(Rt, Arm64_SignExtend(Val, ByteWidth * 8) And $FFFFFFFF);
     End;
 End;
End;

{ Un pas fetch-decode-execute. Arrete proprement (ARM64_Halted) sur toute   }
{ forme d instruction non encore reconnue - diagnostic PC/mot brut          }
{ conserve, meme discipline que ELF64_Halted/LX_Halted.                     }
{ Chantier ARM64, Etape 5 : gestionnaire d appels PSCI (Power State            }
{ Coordination Interface) minimal - le DTB genere annonce "arm,psci-0.2" avec  }
{ method="hvc", et Linux reel interroge systematiquement PSCI_VERSION puis     }
{ PSCI_FEATURES au demarrage meme sans SMP. Portee du plan : pas de CPU_ON/    }
{ SMP (un seul vCPU) - toutes les fonctions d activation d autres coeurs       }
{ repondent NOT_SUPPORTED, ce qui est une reponse PSCI parfaitement valide.    }
Function Arm64_DoPsci(FuncId: LongWord; Arg1: QWord): Int64;
Const
 PSCI_SUCCESS       = 0;
 PSCI_NOT_SUPPORTED = -1;
Begin
 Case FuncId Of
  $84000000: Arm64_DoPsci := 2;   { PSCI_VERSION -> 0.2 (majeur=0, mineur=2) }
  $84000006: Arm64_DoPsci := 2;   { MIGRATE_INFO_TYPE -> 2 = pas de Trusted OS migrable }
  $84000008: Begin                { SYSTEM_OFF }
              ARM64_Halted := True;
              ARM64_HaltReason := '[ARM64] SYSTEM_OFF (PSCI) - arret demande par le noyau invite';
              Arm64_DoPsci := PSCI_SUCCESS;
             End;
  $84000009: Begin                { SYSTEM_RESET }
              ARM64_Halted := True;
              ARM64_HaltReason := '[ARM64] SYSTEM_RESET (PSCI) - redemarrage demande par le noyau invite';
              Arm64_DoPsci := PSCI_SUCCESS;
             End;
  $8400000A: Begin                { PSCI_FEATURES }
              Case Arg1 Of
               $84000000, $84000006, $84000008, $84000009, $8400000A:
                Arm64_DoPsci := 0;   { fonctionnalite geree, aucun drapeau supplementaire }
               Else Arm64_DoPsci := PSCI_NOT_SUPPORTED;
              End;
             End;
  Else Arm64_DoPsci := PSCI_NOT_SUPPORTED; { CPU_ON/OFF/SUSPEND/MIGRATE/etc - pas de SMP (portee) }
 End;
End;

Procedure Arm64_Step;
Var
 CurPC, NewPC: QWord;
 W: LongWord;
 Handled: Boolean;
 sf, op, Sflag, ShiftT, Nflag, Opc, Hw, LFlag, Size: Byte;
 Rd, Rn, Rm, Rt, Rt2, CondN: Byte;
 Imm6, Imm7, Imm12, Imm14, Imm16, Imm19, Imm26, B40: LongWord;
 BitPos, ByteWidth, TB, Imm4: Byte;
 Is32: Boolean;
 NVal, RnVal, RmVal, Res, ImmVal, Addr, Offset, TargetV, Val1, Val2: QWord;
 SysOp1, SysCRn, SysCRm, SysOp2, SysKey: LongWord;
 Idx2, Bit23V, Rs: Byte;
 Imm9: LongWord;
 WritebackVal: QWord;
Begin
 If ARM64_Halted Then Exit;
 CurPC := ARM64_PC;
 W := Arm64_FetchInstr(CurPC);
 If ARM64_Halted Then Exit; { Etape 4 : faute de traduction MMU a la recherche }
 NewPC := CurPC + 4;
 Handled := False;

 { NOP (HINT #0) et WFI (Etape 3) - WFI se comporte ici EXACTEMENT comme un }
 { NOP (avance normalement a l instruction suivante) plutot que de "rester  }
 { bloque" dessus : architecturalement, quand une IRQ reveille le coeur     }
 { pendant un WFI, ELR pointe l instruction QUI SUIT le WFI (il est         }
 { considere termine) - modeliser WFI comme un NOP produit exactement ce    }
 { resultat sans code special, et Arm64_ServiceIrq (appelee apres chaque    }
 { pas par Arm64_RunOneChunk) reste libre de detourner PC des qu une IRQ    }
 { devient prete, quelle que soit l instruction qui vient de s executer.    }
 If (W = $D503201F) Or (W = $D503207F) Then Handled := True;

 { ERET (retour d exception) }
 If (Not Handled) And (W = $D69F03E0) Then Begin
  NewPC := ARM64_ELR_EL1;
  ARM64_FlagN := (ARM64_SPSR_EL1 And $80000000) <> 0;
  ARM64_FlagZ := (ARM64_SPSR_EL1 And $40000000) <> 0;
  ARM64_FlagC := (ARM64_SPSR_EL1 And $20000000) <> 0;
  ARM64_FlagV := (ARM64_SPSR_EL1 And $10000000) <> 0;
  ARM64_DaifI := (ARM64_SPSR_EL1 And $80) <> 0;
  Handled := True;
 End;

 { Famille "$D50" complete (op1=011, CRn variable) : DAIFSet/DAIFClr (CRn=4)}
 { recoivent un vrai effet, CLREX (CRn=3,op2=2, Etape 4) efface le moniteur }
 { d acces exclusif - tout le reste de cette famille (SPSel, WFE/SEV/YIELD  }
 { via CRn=2, DSB/DMB/ISB via CRn=3 op2=4/5/6, et les operations DC/IC/TLBI }
 { qui partagent ce meme prefixe avec un CRn different) est delibbrement    }
 { un NO-OP : aucun modele de reordonnancement memoire, de cache, ni de     }
 { veille basse consommation a cette etape (traduction MMU seule, voir      }
 { l en-tete d Arm64_Translate).                                            }
 If (Not Handled) And (((W Shr 20) And $FFF) = $D50) Then Begin
  SysCRn := (W Shr 12) And $F;
  Opc := (W Shr 5) And 7;   { op2 }
  Imm4 := Byte((W Shr 8) And $F); { CRm sert d immediat 4 bits pour DAIFSet/Clr }
  If SysCRn = 4 Then Begin
   If Opc = 6 Then Begin { DAIFSet }
    If (Imm4 And 2) <> 0 Then ARM64_DaifI := True;
   End Else If Opc = 7 Then Begin { DAIFClr }
    If (Imm4 And 2) <> 0 Then ARM64_DaifI := False;
   End;
  End Else If (SysCRn = 3) And (Opc = 2) Then
   ARM64_ExValid := False; { CLREX }
  Handled := True;
 End;

 { MRS/MSR (registre) - table (op1,CRn,CRm,op2) verifiee par assemblage     }
 { keystone reel, voir Arm64_MrsRead/Arm64_MsrWrite. }
 If (Not Handled) And ((((W Shr 20) And $FFF) = $D53) Or (((W Shr 20) And $FFF) = $D51)) Then Begin
  LFlag := Byte((W Shr 21) And 1);
  Rt := W And $1F;
  SysOp1 := (W Shr 16) And 7;
  SysCRn := (W Shr 12) And $F;
  SysCRm := (W Shr 8) And $F;
  SysOp2 := (W Shr 5) And 7;
  SysKey := (SysOp1 Shl 11) Or (SysCRn Shl 7) Or (SysCRm Shl 3) Or SysOp2;
  If LFlag = 1 Then Begin
   If Arm64_MrsRead(SysKey, Val1) Then Begin
    Arm64_SetRegZR(Rt, Val1);
    Handled := True;
   End;
  End Else Begin
   If Arm64_MsrWrite(SysKey, Arm64_RegZR(Rt)) Then Handled := True;
  End;
 End;

 { MOVZ/MOVN/MOVK - deplacement large immediat (Opc=1 non alloue -> arret)  }
 If (Not Handled) And (((W Shr 23) And $3F) = $25) Then Begin
  sf := (W Shr 31) And 1;
  Opc := (W Shr 29) And 3;
  Hw := (W Shr 21) And 3;
  Imm16 := (W Shr 5) And $FFFF;
  Rd := W And $1F;
  ImmVal := QWord(Imm16) Shl (Hw * 16);
  Case Opc Of
   0: Begin Res := Not ImmVal; Handled := True; End;                        { MOVN }
   2: Begin Res := ImmVal; Handled := True; End;                            { MOVZ }
   3: Begin
       Res := (Arm64_RegZR(Rd) And (Not (QWord($FFFF) Shl (Hw*16)))) Or ImmVal;
       Handled := True;
      End;                                                                   { MOVK }
  End;
  If Handled Then Begin
   If sf = 0 Then Res := Res And $FFFFFFFF;
   Arm64_SetRegZR(Rd, Res);
  End;
 End;

 { ADD/SUB (immediat) }
 If (Not Handled) And (((W Shr 24) And $1F) = $11) Then Begin
  sf := (W Shr 31) And 1;
  op := (W Shr 30) And 1;
  Sflag := (W Shr 29) And 1;
  ShiftT := (W Shr 22) And 3;
  Imm12 := (W Shr 10) And $FFF;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If ShiftT = 1 Then ImmVal := QWord(Imm12) Shl 12 Else ImmVal := QWord(Imm12);
  NVal := Arm64_RegSP(Rn);
  If Is32 Then NVal := NVal And $FFFFFFFF;
  If op = 0 Then Res := NVal + ImmVal Else Res := (NVal - ImmVal) And QWord($FFFFFFFFFFFFFFFF);
  If Is32 Then Res := Res And $FFFFFFFF;
  If Sflag = 1 Then Begin
   If op = 0 Then Arm64_FlagsAfterAdd(NVal, ImmVal, Res, Is32)
   Else Arm64_FlagsAfterSub(NVal, ImmVal, Res, Is32);
   Arm64_SetRegZR(Rd, Res);
  End Else
   Arm64_SetRegSP(Rd, Res);
  Handled := True;
 End;

 { Logique (registre decale) : AND/ORR/EOR/ANDS - MOV/MVN/TST sont des      }
 { alias reconnus automatiquement (Rn=XZR, N=1 ou Rd=XZR respectivement).   }
 If (Not Handled) And (((W Shr 24) And $1F) = $0A) Then Begin
  sf := (W Shr 31) And 1;
  Opc := (W Shr 29) And 3;
  ShiftT := (W Shr 22) And 3;
  Nflag := (W Shr 21) And 1;
  Rm := (W Shr 16) And $1F;
  Imm6 := (W Shr 10) And $3F;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Is32 Then RmVal := Arm64_RegZR(Rm) And $FFFFFFFF Else RmVal := Arm64_RegZR(Rm);
  If Is32 Then RmVal := Arm64_ApplyShift(RmVal, ShiftT, Byte(Imm6 And $1F), Is32)
  Else RmVal := Arm64_ApplyShift(RmVal, ShiftT, Byte(Imm6 And $3F), Is32);
  If Nflag = 1 Then Begin
   If Is32 Then RmVal := (Not RmVal) And $FFFFFFFF Else RmVal := Not RmVal;
  End;
  If Is32 Then RnVal := Arm64_RegZR(Rn) And $FFFFFFFF Else RnVal := Arm64_RegZR(Rn);
  Case Opc Of
   0: Res := RnVal And RmVal;
   1: Res := RnVal Or RmVal;
   2: Res := RnVal Xor RmVal;
   Else Res := RnVal And RmVal; { ANDS }
  End;
  If Is32 Then Res := Res And $FFFFFFFF;
  If Opc = 3 Then Arm64_FlagsAfterLogical(Res, Is32);
  Arm64_SetRegZR(Rd, Res);
  Handled := True;
 End;

 { ADD/SUB (registre decale) - bit21=0 distingue de la forme "registre      }
 { etendu" (UXTW/SXTW etc), non geree a cette etape.                        }
 If (Not Handled) And (((W Shr 24) And $1F) = $0B) And (((W Shr 21) And 1) = 0) Then Begin
  sf := (W Shr 31) And 1;
  op := (W Shr 30) And 1;
  Sflag := (W Shr 29) And 1;
  ShiftT := (W Shr 22) And 3;
  Rm := (W Shr 16) And $1F;
  Imm6 := (W Shr 10) And $3F;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Is32 Then RmVal := Arm64_RegZR(Rm) And $FFFFFFFF Else RmVal := Arm64_RegZR(Rm);
  If Is32 Then RmVal := Arm64_ApplyShift(RmVal, ShiftT, Byte(Imm6 And $1F), Is32)
  Else RmVal := Arm64_ApplyShift(RmVal, ShiftT, Byte(Imm6 And $3F), Is32);
  If Is32 Then RnVal := Arm64_RegZR(Rn) And $FFFFFFFF Else RnVal := Arm64_RegZR(Rn);
  If op = 0 Then Res := RnVal + RmVal Else Res := (RnVal - RmVal) And QWord($FFFFFFFFFFFFFFFF);
  If Is32 Then Res := Res And $FFFFFFFF;
  If Sflag = 1 Then Begin
   If op = 0 Then Arm64_FlagsAfterAdd(RnVal, RmVal, Res, Is32)
   Else Arm64_FlagsAfterSub(RnVal, RmVal, Res, Is32);
  End;
  Arm64_SetRegZR(Rd, Res);
  Handled := True;
 End;

 { B / BL (branchement immediat inconditionnel) }
 If (Not Handled) And (((W Shr 26) And $1F) = $05) Then Begin
  op := (W Shr 31) And 1;
  Imm26 := W And $3FFFFFF;
  Offset := Arm64_SignExtend(Imm26, 26) * 4;
  If op = 1 Then ARM64_Reg[30] := CurPC + 4;
  NewPC := CurPC + Offset;
  Handled := True;
 End;

 { BR/BLR/RET (branchement inconditionnel par registre) - tout Opc autre    }
 { que BR/BLR/RET (ex. ERET/DRPS) reste non gere -> arret plus bas.         }
 If (Not Handled) And (((W Shr 25) And $7F) = $6B) Then Begin
  Opc := (W Shr 21) And $F;
  Rn := (W Shr 5) And $1F;
  TargetV := Arm64_RegZR(Rn);
  Case Opc Of
   0: Begin NewPC := TargetV; Handled := True; End;                          { BR }
   1: Begin ARM64_Reg[30] := CurPC + 4; NewPC := TargetV; Handled := True; End; { BLR }
   2: Begin NewPC := TargetV; Handled := True; End;                          { RET }
  End;
 End;

 { CBZ/CBNZ }
 If (Not Handled) And (((W Shr 25) And $3F) = $1A) Then Begin
  sf := (W Shr 31) And 1;
  op := (W Shr 24) And 1;
  Imm19 := (W Shr 5) And $7FFFF;
  Rt := W And $1F;
  Offset := Arm64_SignExtend(Imm19, 19) * 4;
  Val1 := Arm64_RegZR(Rt);
  If sf = 0 Then Val1 := Val1 And $FFFFFFFF;
  If ((op = 0) And (Val1 = 0)) Or ((op = 1) And (Val1 <> 0)) Then
   NewPC := CurPC + Offset;
  Handled := True;
 End;

 { TBZ/TBNZ }
 If (Not Handled) And (((W Shr 25) And $3F) = $1B) Then Begin
  op := (W Shr 24) And 1;
  B40 := (W Shr 19) And $1F;
  BitPos := Byte((((W Shr 31) And 1) Shl 5) Or B40);
  Imm14 := (W Shr 5) And $3FFF;
  Rt := W And $1F;
  Offset := Arm64_SignExtend(Imm14, 14) * 4;
  Val1 := Arm64_RegZR(Rt);
  TB := Byte((Val1 Shr BitPos) And 1);
  If ((op = 0) And (TB = 0)) Or ((op = 1) And (TB = 1)) Then
   NewPC := CurPC + Offset;
  Handled := True;
 End;

 { B.cond }
 If (Not Handled) And (((W Shr 24) And $FF) = $54) And (((W Shr 4) And 1) = 0) Then Begin
  Imm19 := (W Shr 5) And $7FFFF;
  CondN := W And $F;
  Offset := Arm64_SignExtend(Imm19, 19) * 4;
  If Arm64_CondHolds(CondN) Then NewPC := CurPC + Offset;
  Handled := True;
 End;

 { LDR/STR (immediat, decalage non signe, tailles 8/16/32/64 bits) - Etape  }
 { 4 : Opc=2/3 (LDRSB/LDRSH/LDRSW, extension de signe) geres via le meme    }
 { helper partage Arm64_DoLdrStr que la forme immediat signe ci-dessous.    }
 If (Not Handled) And (((W Shr 27) And 7) = 7) And (((W Shr 24) And 3) = 1)
    And (((W Shr 26) And 1) = 0) Then Begin
  Size := (W Shr 30) And 3;
  Opc := (W Shr 22) And 3;
  Imm12 := (W Shr 10) And $FFF;
  Rn := (W Shr 5) And $1F;
  Rt := W And $1F;
  ByteWidth := Byte(1 Shl Size);
  Addr := Arm64_RegSP(Rn) + (QWord(Imm12) * ByteWidth);
  Arm64_DoLdrStr(Addr, Size, Byte(Opc), Rt);
  Handled := True;
 End;

 { LDR/STR (immediat signe, non ecrit/post-index/pre-index) - Etape 4.      }
 { bit21=0 distingue de la forme "registre" (non geree, rare en pratique). }
 { bits[11:10] : 00=non ecrit (LDUR/STUR), 01=post-index, 11=pre-index.     }
 If (Not Handled) And (((W Shr 27) And 7) = 7) And (((W Shr 24) And 3) = 0)
    And (((W Shr 26) And 1) = 0) And (((W Shr 21) And 1) = 0) Then Begin
  Size := (W Shr 30) And 3;
  Opc := (W Shr 22) And 3;
  Imm9 := (W Shr 12) And $1FF;
  Idx2 := Byte((W Shr 10) And 3);
  Rn := (W Shr 5) And $1F;
  Rt := W And $1F;
  If Idx2 In [0, 1, 3] Then Begin
   Offset := Arm64_SignExtend(Imm9, 9);
   NVal := Arm64_RegSP(Rn);
   Case Idx2 Of
    0: Addr := NVal + Offset;                              { non ecrit }
    1: Begin Addr := NVal; WritebackVal := NVal + Offset; End; { post-index }
    3: Begin Addr := NVal + Offset; WritebackVal := Addr; End; { pre-index }
   End;
   Arm64_DoLdrStr(Addr, Byte(Size), Byte(Opc), Rt);
   If Idx2 <> 0 Then Arm64_SetRegSP(Rn, WritebackVal);
   Handled := True;
  End;
 End;

 { LDP/STP (decalage signe - Etape 1 ; post-index/pre-index - Etape 5,      }
 { bits[24:23] : 0=STNP/LDNP (non-allouant, jamais d ecriture arriere),     }
 { 1=post,2=decalage simple,3=pre - bit25 toujours 0 distingue cette classe,}
 { verifie separement de idxtype ; STNP/LDNP traite comme un decalage      }
 { signe ordinaire (aucun modele de cache dans cet emulateur)               }
 If (Not Handled) And (((W Shr 27) And 7) = 5) And (((W Shr 26) And 1) = 0)
    And (((W Shr 25) And 1) = 0) And (((W Shr 23) And 3) <= 3) Then Begin
  Opc := (W Shr 30) And 3;
  Idx2 := Byte((W Shr 23) And 3);
  LFlag := (W Shr 22) And 1;
  Imm7 := (W Shr 15) And $7F;
  Rt2 := (W Shr 10) And $1F;
  Rn := (W Shr 5) And $1F;
  Rt := W And $1F;
  If Opc = 2 Then ByteWidth := 8 Else ByteWidth := 4;
  Offset := Arm64_SignExtend(Imm7, 7) * ByteWidth;
  NVal := Arm64_RegSP(Rn);
  WritebackVal := 0;
  Case Idx2 Of
   1: Begin Addr := NVal; WritebackVal := NVal + Offset; End;   { post-index }
   3: Begin Addr := NVal + Offset; WritebackVal := Addr; End;   { pre-index }
   Else Addr := NVal + Offset;                { decalage simple / STNP-LDNP (0) }
  End;
  If LFlag = 1 Then Begin
   Val1 := Arm64_GetMemV(Addr, ByteWidth);
   Val2 := Arm64_GetMemV(Addr + ByteWidth, ByteWidth);
   Arm64_SetRegZR(Rt, Val1);
   Arm64_SetRegZR(Rt2, Val2);
  End Else Begin
   Arm64_PutMemV(Addr, Arm64_RegZR(Rt), ByteWidth);
   Arm64_PutMemV(Addr + ByteWidth, Arm64_RegZR(Rt2), ByteWidth);
  End;
  If Idx2 In [1, 3] Then Arm64_SetRegSP(Rn, WritebackVal);
  Handled := True;
 End;

 { Load/store exclusif ET ordonne (LDXR/STXR/LDAXR/STLXR/LDAR/STLR, Etape   }
 { 4) - une seule classe d instructions (bits[29:24]=$08). Modele mono-     }
 { coeur : la reservation exclusive est TOUJOURS valide tant qu aucune      }
 { exception ni CLREX ne l a effacee (aucune veritable concurrence a        }
 { arbitrer). bit23=0 -> forme exclusive (Rs=registre de statut, o0 ignore  }
 { -acquire/release non modelise) ; bit23=1 -> LDAR/STLR ordonnes, jamais   }
 { exclusifs (toujours "reussis"). Forme paire LDXP/STXP (bit23=0,Rt2<>31)  }
 { non geree distinctement - tres rare en pratique reelle, ecart documente. }
 If (Not Handled) And (((W Shr 24) And $3F) = $08) Then Begin
  Size := (W Shr 30) And 3;
  Bit23V := Byte((W Shr 23) And 1);
  LFlag := (W Shr 22) And 1;
  Rs := Byte((W Shr 16) And $1F);
  Rn := (W Shr 5) And $1F;
  Rt := W And $1F;
  ByteWidth := Byte(1 Shl Size);
  Addr := Arm64_RegSP(Rn);
  If LFlag = 1 Then Begin { LDXR/LDAXR/LDAR : chargement normal }
   Val1 := Arm64_GetMemV(Addr, ByteWidth);
   Arm64_SetRegZR(Rt, Val1);
   If Bit23V = 0 Then Begin { forme exclusive : pose la reservation }
    ARM64_ExValid := True;
    ARM64_ExAddr := Addr;
   End;
  End Else Begin { STXR/STLXR/STLR }
   If Bit23V = 0 Then Begin { forme exclusive : verifie la reservation }
    If ARM64_ExValid And (ARM64_ExAddr = Addr) Then Begin
     Arm64_PutMemV(Addr, Arm64_RegZR(Rt), ByteWidth);
     Arm64_SetRegZR(Rs, 0); { succes }
    End Else
     Arm64_SetRegZR(Rs, 1); { echec }
    ARM64_ExValid := False;
   End Else
    Arm64_PutMemV(Addr, Arm64_RegZR(Rt), ByteWidth); { STLR : pas de reservation }
  End;
  Handled := True;
 End;

 { ADR/ADRP (adressage relatif au PC) - Etape 5. Champs verifies par        }
 { assemblage keystone + execution reelle (Unicorn) : op(bit31)=0/1,        }
 { immlo=bits[30:29], immhi=bits[23:5] (19 bits), Rd=bits[4:0].             }
 If (Not Handled) And (((W Shr 24) And $1F) = $10) Then Begin
  Op := (W Shr 31) And 1;
  Imm19 := (W Shr 5) And $7FFFF;  { immhi }
  Imm6 := (W Shr 29) And 3;       { immlo }
  Rd := W And $1F;
  Offset := Arm64_SignExtend((Imm19 Shl 2) Or Imm6, 21);
  If Op = 1 Then
   Arm64_SetRegZR(Rd, (CurPC And (Not QWord($FFF))) + (Offset Shl 12))
  Else
   Arm64_SetRegZR(Rd, CurPC + Offset);
  Handled := True;
 End;

 { UBFM/SBFM/BFM - Etape 5, voir Arm64_DoBfm. }
 If (Not Handled) And (((W Shr 23) And $3F) = $26) Then Begin
  sf := (W Shr 31) And 1;
  Opc := (W Shr 29) And 3;
  Imm12 := (W Shr 16) And $3F; { immr }
  Imm14 := (W Shr 10) And $3F; { imms }
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  If Opc In [0, 1, 2] Then Begin
   Arm64_DoBfm(Byte(Opc), Byte(Imm12), Byte(Imm14), (sf = 0), Rn, Rd);
   Handled := True;
  End;
 End;

 { MADD/MSUB (MUL/MNEG = alias avec Ra=XZR) - Etape 5. }
 If (Not Handled) And (((W Shr 21) And $3FF) = $0D8) Then Begin
  sf := (W Shr 31) And 1;
  Rm := (W Shr 16) And $1F;
  LFlag := (W Shr 15) And 1; { o0 : 0=MADD, 1=MSUB }
  Rt2 := (W Shr 10) And $1F; { Ra }
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Is32 Then Begin
   RnVal := Arm64_RegZR(Rn) And $FFFFFFFF;
   RmVal := Arm64_RegZR(Rm) And $FFFFFFFF;
   NVal := Arm64_RegZR(Rt2) And $FFFFFFFF;
  End Else Begin
   RnVal := Arm64_RegZR(Rn);
   RmVal := Arm64_RegZR(Rm);
   NVal := Arm64_RegZR(Rt2);
  End;
  Res := RnVal * RmVal;
  If LFlag = 1 Then Res := NVal - Res Else Res := NVal + Res;
  If Is32 Then Res := Res And $FFFFFFFF;
  Arm64_SetRegZR(Rd, Res);
  Handled := True;
 End;

 { SMADDL/SMSUBL/SMULL/SMNEGL et UMADDL/UMSUBL/UMULL/UMNEGL (multiplication }
 { 32x32 elargie sur 64 bits, signee ou non) - Etape 5, meme "prefixe fixe" }
 { bits[28:24]=$1B que MADD/MSUB (op31=bits[23:21] selectionne la famille : }
 { 0=MADD/MSUB deja gere, 1=SMADDL/SMSUBL, 5=UMADDL/UMSUBL - verifie par    }
 { assemblage keystone, pas suppose).                                       }
 If (Not Handled) And ((((W Shr 21) And $3FF) = $0D9) Or (((W Shr 21) And $3FF) = $0DD)) Then Begin
  Rm := (W Shr 16) And $1F;
  LFlag := (W Shr 15) And 1; { o0 : 0=ADD, 1=SUB }
  Rt2 := (W Shr 10) And $1F; { Ra }
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  If (((W Shr 21) And $3FF) = $0D9) Then Begin { signe }
   RnVal := Arm64_SignExtend(Arm64_RegZR(Rn) And $FFFFFFFF, 32);
   RmVal := Arm64_SignExtend(Arm64_RegZR(Rm) And $FFFFFFFF, 32);
  End Else Begin { non signe }
   RnVal := Arm64_RegZR(Rn) And $FFFFFFFF;
   RmVal := Arm64_RegZR(Rm) And $FFFFFFFF;
  End;
  NVal := Arm64_RegZR(Rt2);
  Res := RnVal * RmVal;
  If LFlag = 1 Then Res := NVal - Res Else Res := NVal + Res;
  Arm64_SetRegZR(Rd, Res);
  Handled := True;
 End;

 { SMULH/UMULH (bits hauts d une multiplication 64x64 signee/non signee -   }
 { pas de type 128 bits natif en Pascal, decomposition scolaire 32x32       }
 { standard) - Etape 5, meme prefixe (op31=2 pour SMULH, 6 pour UMULH).     }
 { Formule verifiee par execution reelle (Unicorn, 3 cas dont les bornes    }
 { MIN_INT64*MIN_INT64 et tous-bits-a-1) avant ce portage.                  }
 If (Not Handled) And ((((W Shr 21) And $3FF) = $0DA) Or (((W Shr 21) And $3FF) = $0DE)) Then Begin
  Rm := (W Shr 16) And $1F;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  RnVal := Arm64_RegZR(Rn);
  RmVal := Arm64_RegZR(Rm);
  Res := Arm64_UMulH(RnVal, RmVal);
  If (((W Shr 21) And $3FF) = $0DA) Then Begin { SMULH : correction de signe }
   If (RnVal And QWord($8000000000000000)) <> 0 Then Res := Res - RmVal;
   If (RmVal And QWord($8000000000000000)) <> 0 Then Res := Res - RnVal;
  End;
  Arm64_SetRegZR(Rd, Res);
  Handled := True;
 End;

 { UDIV/SDIV/LSLV/LSRV/ASRV/RORV (LSL/LSR/ASR/ROR par registre - alias) -   }
 { Etape 5. }
 If (Not Handled) And (((W Shr 21) And $3FF) = $0D6) Then Begin
  sf := (W Shr 31) And 1;
  Rm := (W Shr 16) And $1F;
  Opc := (W Shr 10) And $3F;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Opc In [2, 3, 8, 9, 10, 11] Then Begin
   If Is32 Then Begin
    RnVal := Arm64_RegZR(Rn) And $FFFFFFFF;
    RmVal := Arm64_RegZR(Rm) And $FFFFFFFF;
   End Else Begin
    RnVal := Arm64_RegZR(Rn);
    RmVal := Arm64_RegZR(Rm);
   End;
   Case Opc Of
    2: Res := Arm64_UDiv(RnVal, RmVal, Is32);
    3: Res := Arm64_SDiv(RnVal, RmVal, Is32);
    8: Begin
        If Is32 Then TB := Byte(RmVal And $1F) Else TB := Byte(RmVal And $3F);
        Res := Arm64_ApplyShift(RnVal, 0, TB, Is32);
       End;
    9: Begin
        If Is32 Then TB := Byte(RmVal And $1F) Else TB := Byte(RmVal And $3F);
        Res := Arm64_ApplyShift(RnVal, 1, TB, Is32);
       End;
    10: Begin
         If Is32 Then TB := Byte(RmVal And $1F) Else TB := Byte(RmVal And $3F);
         Res := Arm64_ApplyShift(RnVal, 2, TB, Is32);
        End;
    Else Begin { RORV }
         If Is32 Then TB := Byte(RmVal And $1F) Else TB := Byte(RmVal And $3F);
         Res := Arm64_ApplyShift(RnVal, 3, TB, Is32);
        End;
   End;
   If Is32 Then Res := Res And $FFFFFFFF;
   Arm64_SetRegZR(Rd, Res);
   Handled := True;
  End;
 End;

 { CSEL/CSINC/CSINV/CSNEG - Etape 5. op(bit30)+op2(bits11:10) : 0,00=CSEL ; }
 { 0,01=CSINC ; 1,00=CSINV ; 1,01=CSNEG (CSET/CSETM/CINC/CINV/CNEG = alias).}
 If (Not Handled) And (((W Shr 21) And $1FF) = $0D4) Then Begin
  sf := (W Shr 31) And 1;
  Op := (W Shr 30) And 1;
  Rm := (W Shr 16) And $1F;
  CondN := Byte((W Shr 12) And $F);
  Opc := (W Shr 10) And 3;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Opc In [0, 1] Then Begin
   If Arm64_CondHolds(CondN) Then
    Res := Arm64_RegZR(Rn)
   Else Begin
    RmVal := Arm64_RegZR(Rm);
    If Op = 0 Then Res := RmVal Else Res := Not RmVal;
    If Opc = 1 Then Res := Res + 1;
   End;
   If Is32 Then Res := Res And $FFFFFFFF;
   Arm64_SetRegZR(Rd, Res);
   Handled := True;
  End;
 End;

 { CCMP/CCMN (comparaison conditionnelle) - Etape 5. Halte reelle           }
 { rencontree des la toute premiere instruction d un vrai noyau Linux       }
 { ARM64 : l en-tete "Image" commence par une astuce "EFI stub" ou les      }
 { octets magiques "MZ" d un en-tete PE forment aussi une instruction       }
 { CCMP inoffensive si executee comme code ARM64 brut - confirme via        }
 { capstone sur le vrai vmlinuz de debian-13.6.0-arm64-netinst.iso, pas     }
 { une supposition.                                                         }
 If (Not Handled) And (((W Shr 21) And $FF) = $D2) Then Begin
  sf := (W Shr 31) And 1;
  Op := (W Shr 30) And 1; { 0=CCMN, 1=CCMP }
  Rm := (W Shr 16) And $1F;
  CondN := Byte((W Shr 12) And $F);
  Bit23V := Byte((W Shr 11) And 1); { immed : 1=Rm sert d immediat 5 bits }
  Rn := (W Shr 5) And $1F;
  Imm4 := Byte(W And $F); { NZCV de repli si la condition est fausse }
  Is32 := (sf = 0);
  If Bit23V = 1 Then RmVal := Rm Else RmVal := Arm64_RegZR(Rm);
  If Is32 Then RmVal := RmVal And $FFFFFFFF;
  NVal := Arm64_RegZR(Rn);
  If Is32 Then NVal := NVal And $FFFFFFFF;
  If Arm64_CondHolds(CondN) Then Begin
   If Op = 1 Then Res := (NVal - RmVal) And QWord($FFFFFFFFFFFFFFFF) Else Res := NVal + RmVal;
   If Is32 Then Res := Res And $FFFFFFFF;
   If Op = 1 Then Arm64_FlagsAfterSub(NVal, RmVal, Res, Is32)
   Else Arm64_FlagsAfterAdd(NVal, RmVal, Res, Is32);
  End Else Begin
   ARM64_FlagN := (Imm4 And 8) <> 0;
   ARM64_FlagZ := (Imm4 And 4) <> 0;
   ARM64_FlagC := (Imm4 And 2) <> 0;
   ARM64_FlagV := (Imm4 And 1) <> 0;
  End;
  Handled := True;
 End;

 { AND/ORR/EOR/ANDS (immediat, TST=alias ANDS Rd=XZR) - Etape 5, voir       }
 { Arm64_DecodeBitMaskImm. Rd=31 -> SP pour AND/ORR/EOR (S=0), XZR pour     }
 { ANDS (S=1) - meme convention que ADD/SUB immediat.                       }
 If (Not Handled) And (((W Shr 23) And $3F) = $24) Then Begin
  sf := (W Shr 31) And 1;
  Opc := (W Shr 29) And 3;
  LFlag := (W Shr 22) And 1; { N }
  Imm12 := (W Shr 16) And $3F; { immr }
  Imm14 := (W Shr 10) And $3F; { imms }
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  ImmVal := Arm64_DecodeBitMaskImm(Byte(LFlag), Byte(Imm12), Byte(Imm14), Is32);
  RnVal := Arm64_RegZR(Rn);
  If Is32 Then RnVal := RnVal And $FFFFFFFF;
  Case Opc Of
   0: Res := RnVal And ImmVal;
   1: Res := RnVal Or ImmVal;
   2: Res := RnVal Xor ImmVal;
   Else Res := RnVal And ImmVal; { ANDS }
  End;
  If Is32 Then Res := Res And $FFFFFFFF;
  If Opc = 3 Then Begin
   Arm64_FlagsAfterLogical(Res, Is32);
   Arm64_SetRegZR(Rd, Res);
  End Else
   Arm64_SetRegSP(Rd, Res);
  Handled := True;
 End;

 { REV/REV16/REV32/RBIT/CLZ/CLS ("1 source") - Etape 5. bit30=1 distingue   }
 { precisement cette classe de UDIV/SDIV/LSLV ("2 sources", bit30=0) malgre }
 { des bits partages par ailleurs - verifie, pas suppose.                   }
 If (Not Handled) And (((W Shr 21) And $3FF) = $2D6) Then Begin
  sf := (W Shr 31) And 1;
  Opc := (W Shr 10) And $3F;
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  If Is32 Then RnVal := Arm64_RegZR(Rn) And $FFFFFFFF Else RnVal := Arm64_RegZR(Rn);
  If Is32 Then ByteWidth := 4 Else ByteWidth := 8;
  If Opc In [0, 1, 2, 3, 4, 5] Then Begin
   Case Opc Of
    0: Res := Arm64_RevBits(RnVal, ByteWidth * 8);
    1: Res := Arm64_RevChunks(RnVal, ByteWidth, 2);
    2: Begin
        If Is32 Then Res := Arm64_RevChunks(RnVal, 4, 4)  { REV, 32 bits }
        Else Res := Arm64_RevChunks(RnVal, 8, 4);         { REV32, 64 bits }
       End;
    3: Res := Arm64_RevChunks(RnVal, 8, 8);                { REV, 64 bits seul }
    4: Res := Arm64_Clz(RnVal, ByteWidth * 8);
    Else Res := Arm64_Cls(RnVal, ByteWidth * 8);           { opc=5 }
   End;
   If Is32 Then Res := Res And $FFFFFFFF;
   Arm64_SetRegZR(Rd, Res);
   Handled := True;
  End;
 End;

 { ADD/SUB (registre etendu) - Etape 5, ecart documente depuis l Etape 1    }
 { desormais comble (rencontre reellement en poursuivant le vrai vmlinuz,   }
 { motif frequent d indexation de tableau pointeur+index32 signe/non signe).}
 { bit21=1 distingue cette forme de "registre decale" (bit21=0, deja geree) }
 { au sein du meme prefixe bits[28:24]=$0B. Formule verifiee par execution  }
 { reelle (Unicorn, 4 cas : SXTW/UXTW/SXTW+decalage/UXTX) avant ce portage.  }
 If (Not Handled) And (((W Shr 24) And $1F) = $0B) And (((W Shr 21) And 1) = 1)
    And (((W Shr 22) And 3) = 0) Then Begin
  sf := (W Shr 31) And 1;
  Op := (W Shr 30) And 1;
  Sflag := (W Shr 29) And 1;
  Rm := (W Shr 16) And $1F;
  Opc := (W Shr 13) And 7; { "option" : type d extension UXT*/SXT* }
  Imm6 := (W Shr 10) And 7; { "imm3" : decalage 0-4 apres extension }
  Rn := (W Shr 5) And $1F;
  Rd := W And $1F;
  Is32 := (sf = 0);
  RmVal := Arm64_RegZR(Rm);
  Case Opc And 3 Of
   0: RmVal := RmVal And $FF;
   1: RmVal := RmVal And $FFFF;
   2: RmVal := RmVal And $FFFFFFFF;
   Else ; { 3 = X, largeur complete deja }
  End;
  If Opc >= 4 Then
   Case Opc And 3 Of
    0: RmVal := Arm64_SignExtend(RmVal, 8);
    1: RmVal := Arm64_SignExtend(RmVal, 16);
    2: RmVal := Arm64_SignExtend(RmVal, 32);
    Else ; { SXTX : rien a etendre }
   End;
  RmVal := RmVal Shl Imm6;
  NVal := Arm64_RegSP(Rn);
  If Is32 Then Begin NVal := NVal And $FFFFFFFF; RmVal := RmVal And $FFFFFFFF; End;
  If Op = 0 Then Res := NVal + RmVal Else Res := (NVal - RmVal) And QWord($FFFFFFFFFFFFFFFF);
  If Is32 Then Res := Res And $FFFFFFFF;
  If Sflag = 1 Then Begin
   If Op = 0 Then Arm64_FlagsAfterAdd(NVal, RmVal, Res, Is32)
   Else Arm64_FlagsAfterSub(NVal, RmVal, Res, Is32);
   Arm64_SetRegZR(Rd, Res);
  End Else
   Arm64_SetRegSP(Rd, Res);
  Handled := True;
 End;

 { LDR/STR (registre, decalage/extension optionnel) - Etape 5. bit21=1 et   }
 { bits[11:10]=10 distinguent cette forme de "immediat signe" (bit21=0) au  }
 { sein du meme prefixe ; meme table Opc (0=STR,1=LDR,2/3=LDRS*) que les    }
 { formes immediat, via Arm64_DoLdrStr. Formule (UXTW/SXTW/LSL-ou-X, mise   }
 { a l echelle optionnelle par S) verifiee par execution reelle (Unicorn)   }
 { avant ce portage.                                                        }
 If (Not Handled) And (((W Shr 27) And 7) = 7) And (((W Shr 24) And 3) = 0)
    And (((W Shr 26) And 1) = 0) And (((W Shr 21) And 1) = 1)
    And (((W Shr 10) And 3) = 2) Then Begin
  Size := (W Shr 30) And 3;
  Opc := (W Shr 22) And 3;
  Rm := (W Shr 16) And $1F;
  LFlag := (W Shr 13) And 7; { "option" : type d extension de l index }
  Bit23V := Byte((W Shr 12) And 1); { "S" : mise a l echelle par la taille }
  Rn := (W Shr 5) And $1F;
  Rt := W And $1F;
  RmVal := Arm64_RegZR(Rm);
  Case LFlag Of
   2: RmVal := RmVal And $FFFFFFFF; { UXTW }
   6: RmVal := Arm64_SignExtend(RmVal And $FFFFFFFF, 32); { SXTW }
   Else ; { 3=LSL (registre X, pas d extension), 7=SXTX }
  End;
  If Bit23V = 1 Then RmVal := RmVal Shl Size;
  Addr := Arm64_RegSP(Rn) + RmVal;
  Arm64_DoLdrStr(Addr, Byte(Size), Byte(Opc), Rt);
  Handled := True;
 End;

 { LDR (litteral, relatif au PC) - Etape 5, tres frequent dans du code       }
 { compile reel (chargement de constantes/adresses "pool"). opc : 0=W (32   }
 { bits), 1=X (64 bits), 2=LDRSW (32->64 signe), 3=PRFM (prefetch, no-op).  }
 If (Not Handled) And (((W Shr 24) And $3F) = $18) Then Begin
  Opc := (W Shr 30) And 3;
  Imm19 := (W Shr 5) And $7FFFF;
  Rt := W And $1F;
  Offset := Arm64_SignExtend(Imm19, 19) * 4;
  Addr := CurPC + Offset;
  Case Opc Of
   0: Begin Val1 := Arm64_GetMemV(Addr, 4); Arm64_SetRegZR(Rt, Val1); End;
   1: Begin Val1 := Arm64_GetMemV(Addr, 8); Arm64_SetRegZR(Rt, Val1); End;
   2: Begin
       Val1 := Arm64_GetMemV(Addr, 4);
       Arm64_SetRegZR(Rt, Arm64_SignExtend(Val1, 32));
      End;
   Else ; { PRFM : prefetch pur, no-op }
  End;
  Handled := True;
 End;

 { HVC/SMC (appel PSCI) - Etape 5. Le DTB genere annonce method="hvc" pour le }
 { noeud "psci" ; SMC traite de facon identique par simplicite (ni EL2 ni EL3 }
 { reels modelises - l appel est resolu directement, sans vecteur d           }
 { exception, exactement comme Elf64_DoSyscall resout un appel systeme). Classe}
 { verifiee via keystone : SVC=$D4000001 (LL=1, exclu ici), HVC=$D4000002     }
 { (LL=2), SMC=$D4000003 (LL=3) - opc=bits[23:21]=0 commun aux trois.         }
 If (Not Handled) And (((W Shr 24) And $FF) = $D4) And (((W Shr 21) And 7) = 0)
    And (((W And 3) = 2) Or ((W And 3) = 3)) Then Begin
  ARM64_Reg[0] := QWord(Arm64_DoPsci(LongWord(ARM64_Reg[0]), ARM64_Reg[1]));
  Handled := True;
 End;

 If ARM64_Halted Then Exit; { une faute de traduction MMU a deja arrete proprement }

 If Not Handled Then Begin
  ARM64_Halted := True;
  ARM64_LastBadPC := CurPC;
  ARM64_HaltReason := 'instruction non implementee $' + HexLong(LongInt(W)) +
   ' a PC=$' + HexQWord(CurPC);
  Exit;
 End;

 ARM64_PC := NewPC;
 Inc(ARM64_InstrCount);
 ARM64_TracePC[ARM64_TraceCount And 255] := CurPC;
 ARM64_TraceSP[ARM64_TraceCount And 255] := ARM64_SP;
 Inc(ARM64_TraceCount);
End;

{ Reinitialise l etat CPU et charge un bloc de code brut a ARM64_RAM_BASE - }
{ utilise pour l instant par la commande de diagnostic ARM64TEST. Les       }
{ etapes suivantes remplaceront ce chargeur trivial par un vrai chargeur    }
{ de noyau Linux (voir Etape 5 du plan).                                    }
{ Reinitialise l etat introduit a l Etape 3 (registres systeme, minuteur,   }
{ GIC) - facteur commun entre Arm64_Reset (ARM64TEST) et Emu_LoadARM64Raw   }
{ (commande ARM64), pour ne jamais laisser un etat "en attente"/masque      }
{ residuel d une precedente execution contaminer la suivante.               }
Procedure Arm64_ResetSysState;
Begin
 ARM64_VBAR_EL1 := 0;
 ARM64_ELR_EL1 := 0;
 ARM64_SPSR_EL1 := 0;
 ARM64_DaifI := False;
 ARM64_Sctlr := 0;
 ARM64_Ttbr0 := 0;
 ARM64_Ttbr1 := 0;
 ARM64_Tcr := 0;
 ARM64_Mair := 0;
 ARM64_Tpidr0 := 0;
 ARM64_Tpidr1 := 0;
 ARM64_Cpacr := 0;
 ARM64_Mdscr := 0;
 ARM64_SpEl0 := 0;
 ARM64_CntFreq := 62500000; { 62,5 MHz - meme valeur typique que QEMU virt }
 ARM64_CntPct := 0;
 ARM64_CntpCval := 0;
 ARM64_CntpEnable := False;
 ARM64_CntpImask := False;
 ARM64_GicDistEnable := False;
 ARM64_GicCpuEnable := False;
 ARM64_GicPmr := 0;
 ARM64_GicEnableMask := 0;
 ARM64_GicPending := False;
 ARM64_GicActive := False;
 ARM64_ExValid := False;
 ARM64_ExAddr := 0;
 ARM64_BootPending := False;
End;

Procedure Arm64_Reset(Const Code: Array Of Byte);
Var
 I: LongInt;
Begin
 FillChar(ARM64_Mem, SizeOf(ARM64_Mem), 0);
 FillChar(ARM64_Reg, SizeOf(ARM64_Reg), 0);
 For I := 0 To High(Code) Do
  If I <= High(ARM64_Mem) Then ARM64_Mem[I] := Code[I];
 ARM64_SP := ARM64_RAM_BASE + $8000;
 ARM64_PC := ARM64_RAM_BASE;
 ARM64_FlagN := False; ARM64_FlagZ := False; ARM64_FlagC := False; ARM64_FlagV := False;
 ARM64_Halted := False;
 ARM64_HaltReason := '';
 ARM64_LastBadPC := 0;
 ARM64_InstrCount := 0;
 ARM64_TraceCount := 0;
 Arm64_ResetSysState;
End;

