{ --- Dispatch principal de dessin de l onglet Team Explorer --- }

Procedure DrawTeamExplorerContent(Var Exp: TSolutionExplorer);
Begin
 DrawTeamSubTabs(Exp);
 Case TeamView Of
  TVIEW_BRANCHES: DrawTeamBranchesView(Exp);
  TVIEW_SYNC:     DrawTeamSyncView(Exp);
  TVIEW_HISTORY:  DrawTeamHistoryView(Exp);
 End;
End;

{ --- Hit-tests pour la vue Branches (liste + champ + bouton) --- }

Function TeamBranchRowHitTest(Var Exp: TSolutionExplorer; MY: Integer): Integer;
Var CTop, InputTop, RowY, I: Integer;
Begin
 TeamBranchRowHitTest := -1;
 CTop := TeamViewContentTop(Exp);
 InputTop := ExplorerContentBottom(Exp) - 24;
 RowY := CTop + 2 - TeamScrollTop * EXPLORER_NODE_HEIGHT;
 For I := 0 To TeamBranchCount - 1 Do Begin
  If (MY >= RowY) And (MY < RowY + EXPLORER_NODE_HEIGHT) And
     (RowY >= CTop) And (RowY + EXPLORER_NODE_HEIGHT <= InputTop) Then Begin
   TeamBranchRowHitTest := I;
   Exit;
  End;
  RowY := RowY + EXPLORER_NODE_HEIGHT;
 End;
End;

Function TeamNewBranchBoxHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Boolean;
Var InputTop: Integer;
Begin
 InputTop := ExplorerContentBottom(Exp) - 24;
 TeamNewBranchBoxHitTest := (MX >= Exp.X + 2) And
  (MX <= Exp.X + Exp.Width - 48) And
  (MY >= InputTop + 2) And (MY <= InputTop + 20);
End;

Function TeamCreateBtnHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Boolean;
Var InputTop: Integer;
Begin
 InputTop := ExplorerContentBottom(Exp) - 24;
 TeamCreateBtnHitTest := (MX >= Exp.X + Exp.Width - 45) And
  (MX <= Exp.X + Exp.Width - 3) And
  (MY >= InputTop + 2) And (MY <= InputTop + 20);
End;

Function TeamSyncBtnHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Integer;
Var CTop, BtnY, I, BtnX: Integer;
Begin
 TeamSyncBtnHitTest := -1;
 CTop := TeamViewContentTop(Exp);
 BtnY := CTop + 64;
 If (MY < BtnY) Or (MY > BtnY + 22) Then Exit;
 For I := 0 To 2 Do Begin
  BtnX := Exp.X + 4 + I * 70;
  If (MX >= BtnX) And (MX <= BtnX + 64) Then Begin
   TeamSyncBtnHitTest := I;
   Exit;
  End;
 End;
End;

Function TeamHistoryRowHitTest(Var Exp: TSolutionExplorer; MY: Integer): Integer;
Var CTop, CBot, RowY, I: Integer;
Begin
 TeamHistoryRowHitTest := -1;
 CTop := TeamViewContentTop(Exp);
 CBot := ExplorerContentBottom(Exp);
 RowY := CTop + 2 - TeamScrollTop * EXPLORER_NODE_HEIGHT;
 For I := 0 To TeamLogCount - 1 Do Begin
  If (MY >= RowY) And (MY < RowY + EXPLORER_NODE_HEIGHT) And
     (RowY >= CTop) And (RowY + EXPLORER_NODE_HEIGHT <= CBot) Then Begin
   TeamHistoryRowHitTest := I;
   Exit;
  End;
  RowY := RowY + EXPLORER_NODE_HEIGHT;
 End;
End;

{ --- Gerer les evenements de l onglet "Team Explorer" --- }

Procedure HandleTeamExplorerEvent(Var Exp: TSolutionExplorer; Ev: TEvent);
Var
 HitIdx: Integer;
Begin
 If TeamNewBranchFocused Then Begin
  If Ev.Kind = EV_KEY_CHAR Then Begin
   If Ev.KeyChar = #13 Then Begin
    TeamCreateBranch(TeamNewBranchBuf);
    TeamNewBranchBuf := '';
    TeamNewBranchCPos := 0;
    TeamNewBranchFocused := False;
   End
   Else If Ev.KeyChar = #27 Then
    TeamNewBranchFocused := False
   Else If Ev.KeyChar = #8 Then Begin
    If TeamNewBranchCPos > 0 Then Begin
     Delete(TeamNewBranchBuf, TeamNewBranchCPos, 1);
     Dec(TeamNewBranchCPos);
    End;
   End
   Else If (Ev.KeyChar >= #32) And (Ev.KeyChar <= #126) Then Begin
    If Length(TeamNewBranchBuf) < 127 Then Begin
     Insert(Ev.KeyChar, TeamNewBranchBuf, TeamNewBranchCPos + 1);
     Inc(TeamNewBranchCPos);
    End;
   End;
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
   Exit;
  End;
 End;
 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  HitIdx := TeamSubTabHitTest(Exp, Ev.MouseX, Ev.MouseY);
  If HitIdx >= 0 Then Begin
   TeamView := TTeamViewKind(HitIdx);
   TeamSelectedIdx := -1;
   TeamScrollTop := 0;
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
   Exit;
  End;
  Case TeamView Of
   TVIEW_BRANCHES: Begin
    If TeamNewBranchBoxHitTest(Exp, Ev.MouseX, Ev.MouseY) Then Begin
     TeamNewBranchFocused := True;
     TeamNewBranchCPos := Length(TeamNewBranchBuf);
     Exp.NeedRepaint := True;
     DrawExplorer(Exp);
     Exit;
    End Else
     TeamNewBranchFocused := False;
    If TeamCreateBtnHitTest(Exp, Ev.MouseX, Ev.MouseY) Then Begin
     TeamCreateBranch(TeamNewBranchBuf);
     TeamNewBranchBuf := '';
     TeamNewBranchCPos := 0;
     Exp.NeedRepaint := True;
     DrawExplorer(Exp);
     Exit;
    End;
    HitIdx := TeamBranchRowHitTest(Exp, Ev.MouseY);
    If HitIdx >= 0 Then Begin
     TeamSelectedIdx := HitIdx;
     If Not TeamBranches[HitIdx].Current Then
      TeamCheckoutBranch(TeamBranches[HitIdx].Name);
     Exp.NeedRepaint := True;
     DrawExplorer(Exp);
     Exit;
    End;
   End;
   TVIEW_SYNC: Begin
    HitIdx := TeamSyncBtnHitTest(Exp, Ev.MouseX, Ev.MouseY);
    If HitIdx >= 0 Then Begin
     Case HitIdx Of
      0: TeamDoFetch;
      1: GitDoPush;
      2: GitDoPull;
     End;
     Exp.NeedRepaint := True;
     DrawExplorer(Exp);
     Exit;
    End;
   End;
   TVIEW_HISTORY: Begin
    HitIdx := TeamHistoryRowHitTest(Exp, Ev.MouseY);
    If HitIdx >= 0 Then Begin
     TeamSelectedIdx := HitIdx;
     Exp.NeedRepaint := True;
     DrawExplorer(Exp);
     Exit;
    End;
   End;
  End;
 End
 Else If Ev.Kind = EV_KEY_DOWN Then Begin
  If Ev.KeyCode = 72 Then Begin { Fleche haut }
   If TeamScrollTop > 0 Then Dec(TeamScrollTop);
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
  End
  Else If Ev.KeyCode = 80 Then Begin { Fleche bas }
   Inc(TeamScrollTop);
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
  End;
 End;
End;

{ ============================================================
  EXTENSION (2026-08-09) - ONGLET "PASCHAT"
  ============================================================
  Interface de clavardage (bulles utilisateur/agent) qui appelle
  PASCHAT.exe comme un programme externe independant, exactement comme
  les compilateurs et Git ailleurs dans cet IDE (Exec + fichiers
  temporaires) - PAS de code partage, PAS d unite, PAS de duplication
  du moteur PasChat dans ce fichier. PASCHAT.PAS expose pour cela deux
  nouveaux parametres, /INFILE:<fichier> et /OUTFILE:<fichier> : la
  question est ecrite dans le premier, PASCHAT.exe repond dans le
  second puis se termine immediatement (voir RunBatchMode dans
  PASCHAT.PAS). }

{ --- Decouper un texte (avec eventuels retours a la ligne explicites    }
{ #10, comme le code Pascal genere) pour qu il tienne dans MaxChars              }
{ caracteres par ligne - coupe au dernier espace si possible, sinon             }
{ coupure "dure" pour un mot plus long que MaxChars. --- }

Procedure WrapText(Const S: AnsiString; MaxChars: Integer;
 Var Lines: TWrapLines; Var LineCount: Integer);
Var
 I, LastSpace, RawCount, R: Integer;
 RawLine: String;
 AllRaw: Array[0..MAX_WRAP_LINES - 1] Of String[255];
Begin
 LineCount := 0;
 If MaxChars < 4 Then MaxChars := 4;
 RawCount := 0;
 RawLine := '';
 For I := 1 To Length(S) Do Begin
  If S[I] = #10 Then Begin
   If RawCount < MAX_WRAP_LINES Then Begin
    AllRaw[RawCount] := RawLine;
    Inc(RawCount);
   End;
   RawLine := '';
  End Else If S[I] <> #13 Then Begin
   If Length(RawLine) < 255 Then RawLine := RawLine + S[I];
  End;
 End;
 If RawCount < MAX_WRAP_LINES Then Begin
  AllRaw[RawCount] := RawLine;
  Inc(RawCount);
 End;
 For R := 0 To RawCount - 1 Do Begin
  RawLine := AllRaw[R];
  If RawLine = '' Then Begin
   If LineCount < MAX_WRAP_LINES Then Begin
    Lines[LineCount] := '';
    Inc(LineCount);
   End;
   Continue;
  End;
  While Length(RawLine) > MaxChars Do Begin
   LastSpace := MaxChars;
   While (LastSpace > 1) And (RawLine[LastSpace] <> ' ') Do Dec(LastSpace);
   If LastSpace <= 1 Then LastSpace := MaxChars;
   If LineCount < MAX_WRAP_LINES Then Begin
    Lines[LineCount] := Copy(RawLine, 1, LastSpace);
    Inc(LineCount);
   End;
   RawLine := Copy(RawLine, LastSpace + 1, Length(RawLine) - LastSpace);
  End;
  If LineCount < MAX_WRAP_LINES Then Begin
   Lines[LineCount] := RawLine;
   Inc(LineCount);
  End;
 End;
End;

{ --- Largeur d une bulle de conversation (jusqu a 75% du panneau). --- }

Function ChatBubbleWidth(Var Exp: TSolutionExplorer): Integer;
Begin
 ChatBubbleWidth := (Exp.Width * 3) Div 4;
End;

{ --- Initialiser l onglet (message d accueil), une seule fois            }
{ (paresseux, au premier affichage de l onglet) - ne lance PAS               }
{ PASCHAT.exe (uniquement au premier envoi de message, voir                    }
{ PasChatSendMessage). --- }

Procedure PasChatEnsureInit;
Begin
 If ChatInitialized Then Exit;
 ChatMsgCount := 0;
 ChatMessages[ChatMsgCount].Sender := CHS_BOT;
 ChatMessages[ChatMsgCount].Text := 'Bonjour! Je suis PasChat, votre ' +
  'assistant Pascal. Posez-moi une question ou demandez-moi de ' +
  'generer du code (ex. "Ecris-moi un programme bonjour en Pascal").';
 Inc(ChatMsgCount);
 ChatInputBuf := '';
 ChatInputCPos := 0;
 ChatScrollTop := 0;
 PasChatLastFile := '';
 ChatInitialized := True;
End;

{ --- Chemin de PASCHAT.exe : meme repertoire que DEVENV.exe (meme          }
{ convention que RunTranspilerOnFile pour les transpilateurs PAS2XXX),         }
{ sinon simple nom (recherche via PATH par le shell). --- }

Function PasChatExePath: String;
Var
 P: String;
Begin
 P := ExtractFilePath(ParamStr(0)) + 'PASCHAT.exe';
 If Not FileExists(P) Then
  P := 'PASCHAT.exe';
 PasChatExePath := P;
End;

{ --- Poser une question a PASCHAT.exe (processus externe independant)   }
{ et renvoyer sa reponse - ecrit la question dans un fichier temporaire,     }
{ lance "PASCHAT.exe /INFILE:... /OUTFILE:...", puis relit la reponse            }
{ depuis le fichier de sortie. Memes fichiers temporaires que                       }
{ RunCommandCaptureOutput (Exec + fichier), aucun code ni etat partage             }
{ avec PASCHAT.exe. --- }

Function PasChatAskExternal(Const Question: AnsiString): AnsiString;
Const
 PASCHAT_Q_FILE = '_paschat_q.tmp';
 PASCHAT_A_FILE = '_paschat_a.tmp';
Var
 F: Text;
 Line: String;
 R: AnsiString;
 Buf: TCmdOutputLines;
 Cnt: Integer;
Begin
 {$I-}
 Assign(F, PASCHAT_Q_FILE);
 Rewrite(F);
 {$I+}
 If IOResult <> 0 Then Begin
  PasChatAskExternal := 'Erreur : impossible d ecrire la question ' +
   'dans un fichier temporaire.';
  Exit;
 End;
 WriteLn(F, Question);
 Close(F);

 RunCommandCaptureOutput('"' + PasChatExePath + '" /INFILE:' +
  PASCHAT_Q_FILE + ' /OUTFILE:' + PASCHAT_A_FILE, Buf, Cnt);

 R := '';
 {$I-}
 Assign(F, PASCHAT_A_FILE);
 Reset(F);
 {$I+}
 If IOResult = 0 Then Begin
  While Not Eof(F) Do Begin
   ReadLn(F, Line);
   If R <> '' Then R := R + #10;
   R := R + Line;
  End;
  Close(F);
 End Else
  R := 'PasChat n a pas repondu (PASCHAT.exe introuvable, verifiez ' +
   'qu il est bien a cote de DEVENV.exe).';

 CleanupTempFile(PASCHAT_Q_FILE);
 CleanupTempFile(PASCHAT_A_FILE);
 PasChatAskExternal := R;
End;

{ --- Envoyer le contenu du champ de saisie et ajouter la reponse de     }
{ PasChat comme nouvelle bulle. --- }

{ --- Ouvrir dans un nouvel onglet d editeur un fichier que PASCHAT.exe    }
{ vient de creer sur disque (reponse a "... dans le fichier X.pas") -           }
{ reprend exactement l idiome utilise par OpenExplorerFileNode pour les          }
{ fichiers hors solution (FullPath := FN), y compris la sauvegarde de            }
{ l editeur actif avant de basculer. --- }
Procedure PasChatOpenGeneratedFile(FullPath: String);
Var
 WIdx, I: Integer;
Begin
 For I := 1 To Length(FullPath) Do
  If FullPath[I] = '/' Then FullPath[I] := '\';
 If EditorReady Then SyncActiveWindowOut;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 WIdx := FindEditorByFileName(FullPath);
 If WIdx >= 0 Then Begin
  { Le fichier a pu etre modifie sur disque depuis (ex: "rajoute X dans   }
  { le fichier ...") - ActivateWindow appelle SyncActiveWindowOut, qui           }
  { ecrase Editors[WIdx]^ avec le contenu (encore ancien) d ActiveEditor;      }
  { il faut donc activer D ABORD, puis recharger le fichier APRES, sinon           }
  { ce recharger serait aussitot efface par cette synchronisation. }
  ActivateWindow(WIdx);
  LoadFile(Editors[WIdx]^.Buffer, FullPath);
  ActiveEditor := Editors[WIdx]^;
  FullRepaintNeeded := True;
  Exit;
 End;
 CreateEditorWindow(FullPath);
 WIdx := WinMgr.ActiveIdx;
 LoadFile(Editors[WIdx]^.Buffer, FullPath);
 ActiveEditor := Editors[WIdx]^;
 Opts.SourceFile := FullPath;
 EditorReady := True;
 FullRepaintNeeded := True;
End;

Procedure PasChatSendMessage(Var Exp: TSolutionExplorer);
Var
 Response: AnsiString;
 Question: AnsiString;
 OpenFileName: String;
 NLPos: Integer;
 UIQ: String;
Begin
 If TrimStr(ChatInputBuf) = '' Then Exit;
 Question := ChatInputBuf;
 If ChatMsgCount < MAX_CHAT_MESSAGES Then Begin
  ChatMessages[ChatMsgCount].Sender := CHS_USER;
  ChatMessages[ChatMsgCount].Text := Question;
  Inc(ChatMsgCount);
 End;
 ChatInputBuf := '';
 ChatInputCPos := 0;
 { PASCHAT.exe demarre un processus neuf a chaque question (aucune         }
 { memoire entre les appels) : il ne peut donc pas savoir ce qu est "le          }
 { fichier que tu viens de modifier". Quand la question y fait reference        }
 { sans le nommer, on substitue ici son vrai nom (connu de DEVENV.PAS,           }
 { qui lui persiste entre les questions) pour que PASCHAT.exe le retrouve            }
 { via son analyse habituelle de "... dans le fichier X". }
 If PasChatLastFile <> '' Then Begin
  UIQ := UpCaseStr(Question);
  If (Pos('QUE TU VIENS DE', UIQ) > 0) or (Pos('CE FICHIER', UIQ) > 0) or
     (Pos('LE FICHIER PRECEDENT', UIQ) > 0) or (Pos('MEME FICHIER', UIQ) > 0) Then
   Question := Question + ' dans le fichier ' + PasChatLastFile;
 End;
 { BOGUE REEL (2026-08-09) : un appel direct a DrawExplorer ICI, suivi        }
 { IMMEDIATEMENT par l appel bloquant a PASCHAT.exe (Exec) ci-dessous,           }
 { provoquait un EStackOverflow des l envoi d une question - aucun               }
 { autre appel Exec de cet IDE (compilateurs, Git) n est jamais precede           }
 { d un dessin direct comme celui-ci. Retire : le rafraichissement de la           }
 { bulle utilisateur attend desormais le retour de PasChatAskExternal,             }
 { comme partout ailleurs (seul Exp.NeedRepaint est positionne ici, le            }
 { dessin reel se fait normalement au retour de HandlePasChatEvent). }
 Response := PasChatAskExternal(Question);
 { PASCHAT.exe prefixe sa reponse par "@OPENFILE:chemin" (une ligne)      }
 { quand la question demandait explicitement d ecrire le code dans un            }
 { fichier ("... dans le fichier X.pas") - le fichier est deja cree sur          }
 { disque a ce stade, il ne reste qu a l ouvrir dans un onglet d editeur. }
 If Copy(Response, 1, 10) = '@OPENFILE:' Then Begin
  NLPos := Pos(#10, Response);
  If NLPos = 0 Then NLPos := Length(Response) + 1;
  OpenFileName := Copy(Response, 11, NLPos - 11);
  Response := Copy(Response, NLPos + 1, Length(Response) - NLPos);
  If OpenFileName <> '' Then Begin
   PasChatOpenGeneratedFile(OpenFileName);
   PasChatLastFile := OpenFileName;
  End;
 End;
 If (Response <> '') And (ChatMsgCount < MAX_CHAT_MESSAGES) Then Begin
  ChatMessages[ChatMsgCount].Sender := CHS_BOT;
  ChatMessages[ChatMsgCount].Text := Response;
  Inc(ChatMsgCount);
 End;
 { Faire defiler vers le bas pour montrer la nouvelle reponse - une        }
 { valeur volontairement excessive, DrawPasChatContent la ramene a la          }
 { limite reelle au prochain dessin (meme principe que le clic sur la           }
 { fleche bas de l explorateur). }
 ChatScrollTop := 30000;
 Exp.NeedRepaint := True;
End;

{ --- Dessiner le contenu de l onglet "PasChat" --- }

Procedure DrawPasChatContent(Var Exp: TSolutionExplorer);
Var
 CTop, CBot, InputTop, MsgBot, Y, TotalH, I, J, BubW, BubX, LC: Integer;
 Lines: TWrapLines;
 BgColor, FgColor: Byte;
 CurX: Integer;
 BarTop, BarBot: Integer;
 VisStart, VisEnd, InputBoxTextW: Integer;
 VisText: String;
Begin
 PasChatEnsureInit;
 CTop := ExplorerTabContentTop(Exp);
 CBot := ExplorerContentBottom(Exp);
 InputTop := CBot - 24;
 MsgBot := InputTop;
 BubW := ChatBubbleWidth(Exp);
 { Hauteur totale de la conversation (pour plafonner le defilement). }
 TotalH := 4;
 For I := 0 To ChatMsgCount - 1 Do Begin
  WrapText(ChatMessages[I].Text, BubW Div 8, Lines, LC);
  TotalH := TotalH + LC * 14 + 12;
 End;
 If ChatScrollTop > TotalH - (MsgBot - CTop) Then
  ChatScrollTop := TotalH - (MsgBot - CTop);
 If ChatScrollTop < 0 Then ChatScrollTop := 0;
 SetFillStyle(SolidFill, CLR_EXPLORER_BG);
 Bar(Exp.X, CTop, Exp.X + Exp.Width - 1, MsgBot - 1);
 Y := CTop + 4 - ChatScrollTop;
 For I := 0 To ChatMsgCount - 1 Do Begin
  WrapText(ChatMessages[I].Text, BubW Div 8, Lines, LC);
  If ChatMessages[I].Sender = CHS_USER Then Begin
   BgColor := CLR_TITLEBAR_ACTIVE;
   FgColor := CLR_EDITOR_BG;
   BubX := Exp.X + Exp.Width - BubW - 6;
  End Else Begin
   BgColor := CLR_BTNFACE;
   FgColor := CLR_WINDOWTEXT;
   BubX := Exp.X + 6;
  End;
  If (Y + LC * 14 + 6 >= CTop) And (Y <= MsgBot) Then Begin
   BarTop := Y;
   If BarTop < CTop Then BarTop := CTop;
   BarBot := Y + LC * 14 + 6;
   If BarBot > MsgBot Then BarBot := MsgBot;
   If BarBot > BarTop Then Begin
    SetFillStyle(SolidFill, BgColor);
    Bar(BubX, BarTop, BubX + BubW, BarBot);
   End;
   SetColor(FgColor);
   For J := 0 To LC - 1 Do
    If (Y + 3 + J * 14 >= CTop - 14) And (Y + 3 + J * 14 <= MsgBot) Then
     OutTextXY(BubX + 4, Y + 3 + J * 14, Lines[J]);
  End;
  Y := Y + LC * 14 + 12;
 End;
 { Zone de saisie }
 SetFillStyle(SolidFill, CLR_TOOLBAR);
 Bar(Exp.X, InputTop, Exp.X + Exp.Width - 1, CBot - 1);
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(Exp.X + 2, InputTop + 2, Exp.X + Exp.Width - 3, InputTop + 20);
 If ChatInputFocused Then SetColor(CLR_TITLEBAR_ACTIVE)
 Else SetColor(CLR_BORDER);
 Rectangle(Exp.X + 2, InputTop + 2, Exp.X + Exp.Width - 3, InputTop + 20);
 If (ChatInputBuf = '') And (Not ChatInputFocused) Then Begin
  SetColor(CLR_GRAYTEXT);
  OutTextXY(Exp.X + 5, InputTop + 5, 'Posez une question...');
 End Else Begin
  { Faire defiler horizontalement le texte affiche pour que le curseur    }
  { reste toujours visible, meme quand la question depasse la largeur           }
  { du champ (BOGUE REEL 2026-08-09 : le texte etait toujours dessine            }
  { depuis son debut sans jamais tenir compte de sa longueur, donc la             }
  { fin d une question longue restait invisible, hors du champ). }
  InputBoxTextW := Exp.Width - 11;
  If InputBoxTextW < 10 Then InputBoxTextW := 10;
  VisStart := 1;
  While (VisStart <= ChatInputCPos) And
        (TextWidth(Copy(ChatInputBuf, VisStart, ChatInputCPos - VisStart + 1)) >
         InputBoxTextW) Do
   Inc(VisStart);
  VisEnd := VisStart - 1;
  While (VisEnd < Length(ChatInputBuf)) And
        (TextWidth(Copy(ChatInputBuf, VisStart, VisEnd - VisStart + 2)) <=
         InputBoxTextW) Do
   Inc(VisEnd);
  VisText := Copy(ChatInputBuf, VisStart, VisEnd - VisStart + 1);
  SetColor(CLR_WINDOWTEXT);
  OutTextXY(Exp.X + 5, InputTop + 5, VisText);
 End;
 If ChatInputFocused And ExplorerSearchCursorVisible Then Begin
  CurX := Exp.X + 5 + TextWidth(Copy(ChatInputBuf, VisStart, ChatInputCPos - VisStart + 1));
  Line(CurX, InputTop + 4, CurX, InputTop + 18);
 End;
End;

{ --- Zone de saisie : hit-test --- }

Function ChatInputBoxHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Boolean;
Var InputTop: Integer;
Begin
 InputTop := ExplorerContentBottom(Exp) - 24;
 ChatInputBoxHitTest := (MX >= Exp.X + 2) And (MX <= Exp.X + Exp.Width - 3)
  And (MY >= InputTop + 2) And (MY <= InputTop + 20);
End;

{ --- Gerer les evenements de l onglet "PasChat" --- }

Procedure HandlePasChatEvent(Var Exp: TSolutionExplorer; Ev: TEvent);
Begin
 If ChatInputFocused Then Begin
  If Ev.Kind = EV_KEY_CHAR Then Begin
   If Ev.KeyChar = #13 Then { Entree : envoyer le message }
    PasChatSendMessage(Exp)
   Else If Ev.KeyChar = #27 Then { Escape : quitter le champ }
    ChatInputFocused := False
   Else If Ev.KeyChar = #8 Then Begin { Backspace }
    If ChatInputCPos > 0 Then Begin
     Delete(ChatInputBuf, ChatInputCPos, 1);
     Dec(ChatInputCPos);
    End;
   End
   Else If (Ev.KeyChar >= #32) And (Ev.KeyChar <= #126) Then Begin
    If Length(ChatInputBuf) < 255 Then Begin
     Insert(Ev.KeyChar, ChatInputBuf, ChatInputCPos + 1);
     Inc(ChatInputCPos);
    End;
   End;
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
   Exit;
  End;
 End;
 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  If ChatInputBoxHitTest(Exp, Ev.MouseX, Ev.MouseY) Then Begin
   ChatInputFocused := True;
   ChatInputCPos := Length(ChatInputBuf);
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
   Exit;
  End Else
   ChatInputFocused := False;
 End
 Else If Ev.Kind = EV_KEY_DOWN Then Begin
  If Ev.KeyCode = 72 Then Begin { Fleche haut }
   If ChatScrollTop > 0 Then Dec(ChatScrollTop, 14);
   If ChatScrollTop < 0 Then ChatScrollTop := 0;
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
  End
  Else If Ev.KeyCode = 80 Then Begin { Fleche bas }
   Inc(ChatScrollTop, 14);
   Exp.NeedRepaint := True;
   DrawExplorer(Exp);
  End;
 End;
End;

{ --- Trouver le noeud sous la souris --- }

Function ExplorerNodeHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Integer;
Var
 I, DrawY, VisCount: Integer;
Begin
 ExplorerNodeHitTest := -1;
 If (MX < Exp.X) Or (MX >= Exp.X + Exp.Width) Then Exit;
 { Exclure la zone de la barre de defilement (14 px a droite). }
 If MX >= Exp.X + Exp.Width - 14 Then Exit;
 { EXTENSION (2026-08-08) : l arbre commence maintenant sous la barre     }
 { d outils ET le champ de recherche (voir ExplorerContentTop), pas          }
 { directement sous le titre. }
 If (MY < ExplorerContentTop(Exp)) Or
    (MY >= ExplorerContentBottom(Exp)) Then Exit;
 DrawY := ExplorerContentTop(Exp) + 2;
 VisCount := 0;
 For I := 0 To Exp.NodeCount - 1 Do Begin
  If Not Exp.Nodes[I].Visible Then Continue;
  If VisCount < Exp.ScrollTop Then Begin
   Inc(VisCount);
   Continue;
  End;
  If DrawY + EXPLORER_NODE_HEIGHT > ExplorerContentBottom(Exp) Then
   Break;
  If (MY >= DrawY) And (MY < DrawY + EXPLORER_NODE_HEIGHT) Then Begin
   ExplorerNodeHitTest := I;
   Exit;
  End;
  DrawY := DrawY + EXPLORER_NODE_HEIGHT;
  Inc(VisCount);
 End;
End;

{ --- Trouver le bouton de la mini barre d outils de l explorateur sous  }
{ la souris (-1 si aucun) - EXTENSION (2026-08-08). --- }

Function ExplorerToolbarHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Integer;
Var
 I, BtnX, BtnY: Integer;
Begin
 ExplorerToolbarHitTest := -1;
 BtnY := Exp.Y + EXPLORER_NODE_HEIGHT + 2;
 If (MY < BtnY) Or (MY > BtnY + 19) Then Exit;
 For I := 0 To EXPLORER_TOOLBAR_BTNCOUNT - 1 Do Begin
  BtnX := Exp.X + 2 + I * 22;
  If (MX >= BtnX) And (MX <= BtnX + 19) Then Begin
   ExplorerToolbarHitTest := I;
   Exit;
  End;
 End;
End;

{ --- Verifier si un point tombe dans le champ de recherche live -       }
{ EXTENSION (2026-08-08). --- }

Function ExplorerSearchBoxHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Boolean;
Var
 SearchY: Integer;
Begin
 SearchY := Exp.Y + EXPLORER_NODE_HEIGHT + EXPLORER_TOOLBAR_HEIGHT;
 ExplorerSearchBoxHitTest :=
  (MX >= Exp.X + 2) And (MX <= Exp.X + Exp.Width - 3) And
  (MY >= SearchY + 2) And (MY <= SearchY + EXPLORER_SEARCH_HEIGHT - 3);
End;

{ --- Dessiner l infobulle d un bouton de la mini barre d outils de       }
{ l explorateur - EXTENSION (2026-08-08), meme presentation que                }
{ DrawTooltip (barre d outils principale). --- }

Procedure DrawExplorerTooltip(Var Exp: TSolutionExplorer; BtnIdx: Integer);
Var
 TX, TY, TW: Integer;
 Tip: String;
Begin
 If (BtnIdx < 0) Or (BtnIdx >= EXPLORER_TOOLBAR_BTNCOUNT) Then Exit;
 Tip := ExplorerToolbarTooltips[BtnIdx];
 If Length(Tip) = 0 Then Exit;
 TX := Exp.X + 2 + BtnIdx * 22;
 TY := Exp.Y + EXPLORER_NODE_HEIGHT + EXPLORER_TOOLBAR_HEIGHT + 2;
 TW := Length(Tip) * 8 + 8;
 SetColor(14);  { jaune clair }
 Bar(TX, TY, TX + TW, TY + 16);
 SetColor(CLR_BORDER);
 Rectangle(TX, TY, TX + TW, TY + 16);
 OutTextXY(TX + 4, TY + 3, Tip);
End;

{ --- Executer l action d un bouton de la mini barre d outils de          }
{ l explorateur (0=Actualiser, 1=Tout replier, 2=Proprietes) - EXTENSION    }
{ (2026-08-08), comme la barre d outils reelle de Visual Studio. --- }

Procedure ExecuteExplorerToolbarButton(Var Exp: TSolutionExplorer;
 BtnIdx: Integer);
Var
 I: Integer;
Begin
 Case BtnIdx Of
  0: Begin
   { Actualiser : re-analyser entierement la solution depuis le disque      }
   { (fichiers ajoutes/retires/modifies) - vrai rafraichissement, pas       }
   { juste un repaint. Sans solution chargee, se contente de reappliquer    }
   { le filtre courant (Expanded/recherche). }
   If SolutionLoaded And (CurrentSolutionFilePath <> '') Then
    OpenSolutionFile(CurrentSolutionFilePath)
   Else
    RefreshExplorer(Exp);
  End;
  1: Begin
   { Tout replier : comme Visual Studio, le noeud solution racine reste    }
   { deplie (sinon la vue redevient vide), tout le reste se replie. }
   For I := 0 To Exp.NodeCount - 1 Do
    If Exp.Nodes[I].Kind <> ENK_SOLUTION Then
     Exp.Nodes[I].Expanded := False;
   RefreshExplorer(Exp);
  End;
  2: Begin
   { Proprietes : pour un projet, ouvre la boite de dialogue complete       }
   { (meme comportement que cliquer sur le noeud "Properties" de l          }
   { arbre) ; sinon, re-synchronise simplement le panneau Proprietes         }
   { avec la selection courante. }
   If (Exp.SelectedIdx >= 0) And (Exp.SelectedIdx < Exp.NodeCount) Then Begin
    If Exp.Nodes[Exp.SelectedIdx].Kind In
     [ENK_PROJECT, ENK_PROPERTIES] Then Begin
     InitProjectPropertiesDialog(ProjPropDlg);
     LoadProjectProperties(ProjPropDlg, CurrentProject);
     ShowProjectPropertiesDialog(ProjPropDlg);
    End Else
     UpdatePropsPanelForExplorerNode(Exp, Exp.SelectedIdx);
   End;
  End;
 End;
 Exp.NeedRepaint := True;
End;

{ --- Gerer les evenements de l explorateur --- }

Procedure StartExplorerRename(Var Exp: TSolutionExplorer;
 NodeIdx: Integer);
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 Exp.Renaming := True;
 Exp.SearchFocused := False;
 Exp.RenameIdx := NodeIdx;
 Exp.RenameBuf := Exp.Nodes[NodeIdx].Caption;
 Exp.RenameCPos := Length(Exp.RenameBuf);
 Exp.NeedRepaint := True;
End;

Procedure ConfirmExplorerRename(Var Exp: TSolutionExplorer);
Begin
 If Not Exp.Renaming Then Exit;
 If Length(Exp.RenameBuf) > 0 Then
  Exp.Nodes[Exp.RenameIdx].Caption := Exp.RenameBuf;
 Exp.Renaming := False;
 Exp.RenameIdx := -1;
 Exp.NeedRepaint := True;
End;

Procedure CancelExplorerRename(Var Exp: TSolutionExplorer);
Begin
 Exp.Renaming := False;
 Exp.RenameIdx := -1;
 Exp.NeedRepaint := True;
End;

{ --- Trouver l index (dans CurrentSolution.Projects[]) du PROJET auquel   }
{ appartient un noeud de l explorateur - BOGUE REEL (2026-08-08) corrige :  }
{ OpenExplorerFileNode/OpenExplorerFileNodeHex/OpenExplorerFileNodeForm      }
{ utilisaient TOUJOURS CurrentSolution.Projects[0] (le PREMIER projet)          }
{ pour construire le chemin complet d un fichier, quel que soit le PROJET       }
{ REEL auquel ce fichier appartient - une solution a PLUSIEURS projets           }
{ (le cas normal en pratique, cf. la note d en-tete de OpenSolutionFile)            }
{ ouvrait donc TOUJOURS les fichiers du deuxieme projet et suivants depuis           }
{ le REPERTOIRE du PREMIER, produisant un chemin INEXISTANT et un tampon              }
{ VIDE au lieu du contenu reel (symptome signale par l utilisateur : "il                }
{ ne trouve pas... bien qu il est present dans le projet"). Remonte l arbre              }
{ depuis le noeud fichier jusqu au noeud ENK_PROJECT englobant, puis                        }
{ retrouve son index par correspondance de nom - repli sur le premier                        }
{ projet (comportement historique, solution a un seul projet) si la                            }
{ remontee echoue pour une raison quelconque. }
Function FindProjectIndexForExplorerNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer): Integer;
Var
 Idx, I: Integer;
Begin
 FindProjectIndexForExplorerNode := 0;
 Idx := NodeIdx;
 While (Idx >= 0) And (Exp.Nodes[Idx].Kind <> ENK_PROJECT) Do
  Idx := Exp.Nodes[Idx].ParentIdx;
 If Idx >= 0 Then Begin
  For I := 0 To CurrentSolution.ProjectCount - 1 Do
   If CurrentSolution.Projects[I].ProjectName = Exp.Nodes[Idx].Caption Then Begin
    FindProjectIndexForExplorerNode := I;
    Exit;
   End;
 End;
End;

{ --- Ouvrir un fichier source depuis l explorateur --- }

Procedure OpenExplorerFileNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer);
Var
 FN: String;
 SolDir: String;
 ProjDir: String;
 FullPath: String;
 WIdx: Integer;
 I: Integer;
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 FN := Exp.Nodes[NodeIdx].RelPath;
 If FN = '' Then Exit;
 { Construire le chemin complet du fichier }
 If SolutionLoaded And (CurrentSolution.ProjectCount > 0) Then
 Begin
  SolDir := CurrentSolution.Info.SolutionPath;
  If Length(SolDir) > 0 Then Begin
   If (SolDir[Length(SolDir)] <> '\') And
      (SolDir[Length(SolDir)] <> '/') Then
    SolDir := SolDir + '\';
  End;
  { BOGUE REEL (2026-08-08) : voir la note d en-tete complete de              }
  { FindProjectIndexForExplorerNode - utilisait TOUJOURS Projects[0]. }
  ProjDir := ExtractFilePath(
   CurrentSolution.Projects[
    FindProjectIndexForExplorerNode(Exp, NodeIdx)].ProjectPath);
  FullPath := SolDir + ProjDir + FN;
  { Normaliser les separateurs }
  For I := 1 To Length(FullPath) Do
   If FullPath[I] = '/' Then FullPath[I] := '\';
 End
 Else
  FullPath := FN;
 { Sauvegarder la fenetre active }
 If EditorReady Then SyncActiveWindowOut;
 { Masquer la page de demarrage }
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 { Verifier si le fichier est deja ouvert }
 WIdx := FindEditorByFileName(FullPath);
 If WIdx >= 0 Then Begin
  { Activer l editeur existant }
  ActivateWindow(WIdx);
  FullRepaintNeeded := True;
  Exit;
 End;
 { Ouvrir dans un nouvel editeur }
 CreateEditorWindow(FullPath);
 WIdx := WinMgr.ActiveIdx;
 LoadFile(Editors[WIdx]^.Buffer, FullPath);
 ActiveEditor := Editors[WIdx]^;
 Opts.SourceFile := FullPath;
 EditorReady := True;
 FullRepaintNeeded := True;
End;

