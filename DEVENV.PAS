{ --- Initialiser le contexte du compilateur VB.NET --- }

Procedure InitVBCContext(Var Ctx: TVBCCompilerContext);
Begin
 Ctx.CompilerPath := '';
 Ctx.CompilerName := '';
 Ctx.CompilerFound := False;
