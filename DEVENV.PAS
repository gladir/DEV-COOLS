   Else If (TP.VirtDrive >= 0) And FatVol[TP.VirtDrive].IsHPFS Then Begin
    If HPFS_FindDosExecutable(Byte(TP.VirtDrive), TP.VirtCwd, CurrCmd, FatDosPath) Then
