  $44:
   Begin
    Case P.CPU.Regs.AL Of
     $00:
      Begin
       H := P.CPU.Regs.BX;
       If H <= 4 Then P.CPU.Regs.DX := $80D3
       Else P.CPU.Regs.DX := $0000;
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     $01:
      Exclude(P.CPU.Flags.s, EFG_CF);
     $06:
      Begin
       H := P.CPU.Regs.BX;
       If H = 0 Then Begin
        If Emu_BiosHasKey(P) Or EmuVScr_HasKey(P) Then P.CPU.Regs.AL := $FF
