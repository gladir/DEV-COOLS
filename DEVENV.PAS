{ --- Extraire le premier mot d une ligne (avant le premier espace),
  et renvoyer le reste dans Rest --- }

Function FRMVisFirstWord(S: String; Var Rest: String): String;
Var
 I: Integer;
Begin
 S := TrimStr(S);
 I := 1;
 While (I <= Length(S)) And (S[I] <> ' ') Do Inc(I);
 FRMVisFirstWord := Copy(S, 1, I - 1);
 Rest := TrimStr(Copy(S, I, Length(S) - I + 1));
End;

{ --- Retirer les guillemets entourant une valeur de propriete chaine --- }

Function FRMVisUnquote(S: String): String;
Begin
 S := TrimStr(S);
 If (Length(S) >= 2) And (S[1] = '"') And (S[Length(S)] = '"') Then
  FRMVisUnquote := Copy(S, 2, Length(S) - 2)
 Else
  FRMVisUnquote := S;
End;

{ --- Lire l entier en tete d une valeur de propriete (ignore tout
  commentaire "'..." place apres, comme dans "0   'False") --- }

Function FRMVisValInt(S: String): LongInt;
Var
 I: Integer;
 Neg: Boolean;
 V: LongInt;
Begin
 S := TrimStr(S);
 I := 1;
 Neg := False;
 If (I <= Length(S)) And (S[I] = '-') Then Begin
  Neg := True;
  Inc(I);
 End;
 V := 0;
 While (I <= Length(S)) And (S[I] >= '0') And (S[I] <= '9') Do Begin
  V := V * 10 + (Ord(S[I]) - Ord('0'));
  Inc(I);
 End;
 If Neg Then V := -V;
 FRMVisValInt := V;
End;

{ --- Charger et analyser le bloc concepteur d un fichier .FRM pour en }
{ construire un apercu visuel en lecture seule (VERSION/Begin VB.Form/}
{ proprietes Left/Top/Width/Height/Caption/End). Les blocs VB.Menu ne }
{ sont pas des controles visuels et sont ignores.                     }

Procedure LoadFileForm(Var FE: TFormEditor; AFileName: String);
Const
 MAX_FRM_STACK = 32;
Var
 F: Text;
 Line, First, Rest, TypeTok, NameTok, ShortType: String;
 PName, PVal: String;
 EqPos, I: Integer;
 StackIsMenu: Array[0..MAX_FRM_STACK - 1] Of Boolean;
 StackCtl   : Array[0..MAX_FRM_STACK - 1] Of Integer; { -1 = Form }
 StackTop   : Integer;
 CIdx       : Integer;
 Done, FirstLine: Boolean;
Begin
 InitFormEditor(FE);
 FE.FileName := AFileName;
 {$I-}
 Assign(F, AFileName);
 Reset(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 StackTop := 0;
 Done := False;
 FirstLine := True;
 While (Not Eof(F)) And (Not Done) Do Begin
  ReadLn(F, Line);
  Line := TrimStr(Line);
  { Ignorer la premiere ligne "VERSION 5.00" }
  If FirstLine Then Begin
   FirstLine := False;
   First := UpCaseStr(FRMVisFirstWord(Line, Rest));
   If First = 'VERSION' Then Continue;
  End;
  If Line = '' Then Continue;
  First := FRMVisFirstWord(Line, Rest);
  If UpCaseStr(First) = 'BEGIN' Then Begin
   TypeTok := UpCaseStr(FRMVisFirstWord(Rest, NameTok));
   ShortType := TypeTok;
   I := 1;
   While (I <= Length(ShortType)) And (ShortType[I] <> '.') Do Inc(I);
   If I <= Length(ShortType) Then
    ShortType := Copy(ShortType, I + 1, Length(ShortType) - I);
   If StackTop >= MAX_FRM_STACK Then Continue;
   If ShortType = 'MENU' Then Begin
    StackIsMenu[StackTop] := True;
    StackCtl[StackTop] := -1;
    Inc(StackTop);
   End Else If ShortType = 'FORM' Then Begin
    StackIsMenu[StackTop] := False;
    StackCtl[StackTop] := -1;
    Inc(StackTop);
   End Else Begin
    StackIsMenu[StackTop] := False;
    If FE.ControlCount < MAX_FRM_VIS_CONTROLS Then Begin
     CIdx := FE.ControlCount;
     FE.Controls[CIdx].Name := NameTok;
     FE.Controls[CIdx].TypeStr := ShortType;
     FE.Controls[CIdx].Caption := '';
     FE.Controls[CIdx].CtlLeft := 0;
     FE.Controls[CIdx].CtlTop := 0;
     FE.Controls[CIdx].CtlWidth := 1215;
     FE.Controls[CIdx].CtlHeight := 375;
     Inc(FE.ControlCount);
     StackCtl[StackTop] := CIdx;
    End Else
     StackCtl[StackTop] := -1;
    Inc(StackTop);
   End;
  End Else If UpCaseStr(Line) = 'END' Then Begin
   If StackTop > 0 Then Dec(StackTop);
   If StackTop = 0 Then Done := True;
  End Else If (StackTop > 0) And (Not StackIsMenu[StackTop - 1]) Then Begin
   EqPos := 0;
   For I := 1 To Length(Line) Do
    If (Line[I] = '=') And (EqPos = 0) Then EqPos := I;
   If EqPos > 0 Then Begin
    PName := UpCaseStr(TrimStr(Copy(Line, 1, EqPos - 1)));
    PVal := TrimStr(Copy(Line, EqPos + 1, Length(Line) - EqPos));
    CIdx := StackCtl[StackTop - 1];
    If CIdx = -1 Then Begin
     { Proprietes du formulaire lui-meme }
     If PName = 'CAPTION' Then
      FE.FormCaption := FRMVisUnquote(PVal)
     Else If PName = 'CLIENTWIDTH' Then
      FE.FormWidth := FRMVisValInt(PVal)
     Else If PName = 'CLIENTHEIGHT' Then
      FE.FormHeight := FRMVisValInt(PVal);
    End Else Begin
     If PName = 'CAPTION' Then
      FE.Controls[CIdx].Caption := FRMVisUnquote(PVal)
     Else If PName = 'TEXT' Then
      FE.Controls[CIdx].Caption := FRMVisUnquote(PVal)
     Else If PName = 'LEFT' Then
      FE.Controls[CIdx].CtlLeft := FRMVisValInt(PVal)
     Else If PName = 'TOP' Then
      FE.Controls[CIdx].CtlTop := FRMVisValInt(PVal)
     Else If PName = 'WIDTH' Then
      FE.Controls[CIdx].CtlWidth := FRMVisValInt(PVal)
     Else If PName = 'HEIGHT' Then
      FE.Controls[CIdx].CtlHeight := FRMVisValInt(PVal);
    End;
   End;
  End;
 End;
 Close(F);
End;

{ --- Prefixe de nommage automatique VB6 selon le type de controle --- }

Function FRMControlNamePrefix(TypeStr: String): String;
Var
 TS: String;
Begin
 TS := UpCaseStr(TypeStr);
 If TS = 'LABEL' Then FRMControlNamePrefix := 'Label'
 Else If TS = 'TEXTBOX' Then FRMControlNamePrefix := 'Text'
 Else If TS = 'COMMANDBUTTON' Then FRMControlNamePrefix := 'Command'
 Else If TS = 'CHECKBOX' Then FRMControlNamePrefix := 'Check'
 Else If TS = 'OPTIONBUTTON' Then FRMControlNamePrefix := 'Option'
 Else If TS = 'FRAME' Then FRMControlNamePrefix := 'Frame'
 Else If TS = 'LISTBOX' Then FRMControlNamePrefix := 'List'
 Else If TS = 'COMBOBOX' Then FRMControlNamePrefix := 'Combo'
 Else FRMControlNamePrefix := 'Control';
End;

{ --- Indique si le type de controle possede une propriete Caption --- }

Function FRMControlHasCaption(TypeStr: String): Boolean;
Var
 TS: String;
Begin
 TS := UpCaseStr(TypeStr);
 FRMControlHasCaption := (TS = 'LABEL') Or (TS = 'COMMANDBUTTON') Or
  (TS = 'CHECKBOX') Or (TS = 'OPTIONBUTTON') Or (TS = 'FRAME');
End;

{ --- Largeur/hauteur par defaut (en twips) d un nouveau controle --- }

Function FRMDefaultWidth(TypeStr: String): LongInt;
Var
 TS: String;
Begin
 TS := UpCaseStr(TypeStr);
 If TS = 'FRAME' Then FRMDefaultWidth := 1935
 Else FRMDefaultWidth := 1215;
End;

Function FRMDefaultHeight(TypeStr: String): LongInt;
Var
 TS: String;
Begin
 TS := UpCaseStr(TypeStr);
 If TS = 'LABEL' Then FRMDefaultHeight := 195
 Else If TS = 'TEXTBOX' Then FRMDefaultHeight := 285
 Else If TS = 'COMMANDBUTTON' Then FRMDefaultHeight := 375
 Else If TS = 'CHECKBOX' Then FRMDefaultHeight := 195
 Else If TS = 'OPTIONBUTTON' Then FRMDefaultHeight := 195
 Else If TS = 'FRAME' Then FRMDefaultHeight := 1215
 Else If TS = 'LISTBOX' Then FRMDefaultHeight := 645
 Else If TS = 'COMBOBOX' Then FRMDefaultHeight := 315
 Else FRMDefaultHeight := 375;
End;

{ --- Generer un nom de controle inedit (PrefixeN) pour le type donne --- }

Function NextControlName(Var FE: TFormEditor; TypeStr: String): String;
Var
 Prefix, NumStr: String;
 I, J, Num, MaxNum: Integer;
Begin
 Prefix := FRMControlNamePrefix(TypeStr);
 MaxNum := 0;
 For I := 0 To FE.ControlCount - 1 Do Begin
  If Length(FE.Controls[I].Name) > Length(Prefix) Then Begin
   If Copy(FE.Controls[I].Name, 1, Length(Prefix)) = Prefix Then Begin
    NumStr := Copy(FE.Controls[I].Name, Length(Prefix) + 1,
     Length(FE.Controls[I].Name) - Length(Prefix));
    Num := 0;
    For J := 1 To Length(NumStr) Do
     If (NumStr[J] >= '0') And (NumStr[J] <= '9') Then
      Num := Num * 10 + (Ord(NumStr[J]) - Ord('0'))
     Else Begin
      Num := 0;
      Break;
     End;
    If (Num > 0) And (Num > MaxNum) Then MaxNum := Num;
   End;
  End;
 End;
 NextControlName := Prefix + IntToStr(MaxNum + 1);
End;

{ --- Obtenir une ligne du tampon --- }

Function GetLine(Var Buf: TTextBuffer; N: LongInt): String;
Begin
 If (N >= 0) And (N < Buf.LineCount) Then
  GetLine := Buf.Lines[N]
 Else
  GetLine := '';
End;

{ --- Definir une ligne du tampon --- }

Procedure SetLine(Var Buf: TTextBuffer; N: LongInt; S: String);
Begin
 If (N >= 0) And (N < Buf.LineCount) Then Begin
  Buf.Lines[N] := S;
  Buf.Modified := True;
 End;
End;

{ --- Inserer une ligne dans le tampon --- }

Procedure InsertLine(Var Buf: TTextBuffer; N: LongInt; S: String);
Var
 I: LongInt;
Begin
 If Buf.LineCount >= MAX_LINES Then Exit;
 If N < 0 Then N := 0;
 If N > Buf.LineCount Then N := Buf.LineCount;
 { Decaler vers le bas }
 For I := Buf.LineCount - 1 DownTo N Do
  Buf.Lines[I + 1] := Buf.Lines[I];
 Buf.Lines[N] := S;
 Inc(Buf.LineCount);
 Buf.Modified := True;
End;

{ --- Supprimer une ligne du tampon --- }

Procedure DeleteLine(Var Buf: TTextBuffer; N: LongInt);
Var
 I: LongInt;
Begin
 If (N < 0) Or (N >= Buf.LineCount) Then Exit;
 If Buf.LineCount <= 1 Then Begin
  Buf.Lines[0] := '';
  Buf.Modified := True;
  Exit;
 End;
 For I := N To Buf.LineCount - 2 Do
  Buf.Lines[I] := Buf.Lines[I + 1];
 Buf.Lines[Buf.LineCount - 1] := '';
 Dec(Buf.LineCount);
 Buf.Modified := True;
End;

{ --- Inserer un nouveau bloc "Begin VB.<Type> <Name> ... End" juste  }
{ avant le "End" fermant du formulaire, puis sauvegarder le fichier   }
{ .FRM. Reutilise le meme suivi de pile Begin/End que LoadFileForm    }
{ pour localiser sans ambiguite la ligne du End du formulaire.        }

Procedure AppendControlToFrmFile(AFileName, TypeStr, CName: String;
 CLeft, CTop, CWidth, CHeight: LongInt);
Const
 MAX_STACK = 32;
Var
 Buf: ^TTextBuffer;
 Line, First, Rest: String;
 StackTop, I, EndLineIdx: Integer;
 FirstLine: Boolean;
Begin
 New(Buf);
 LoadFile(Buf^, AFileName);
 StackTop := 0;
 EndLineIdx := -1;
 FirstLine := True;
 I := 0;
 While I < Buf^.LineCount Do Begin
  Line := TrimStr(Buf^.Lines[I]);
  If FirstLine Then Begin
   FirstLine := False;
   First := UpCaseStr(FRMVisFirstWord(Line, Rest));
   If First = 'VERSION' Then Begin Inc(I); Continue; End;
  End;
  If Line = '' Then Begin
   Inc(I);
   Continue;
  End;
  First := UpCaseStr(FRMVisFirstWord(Line, Rest));
  If First = 'BEGIN' Then Begin
   If StackTop < MAX_STACK Then
    Inc(StackTop);
  End Else If First = 'END' Then Begin
   If StackTop = 1 Then EndLineIdx := I;
   If StackTop > 0 Then Dec(StackTop);
  End;
  Inc(I);
 End;
 If EndLineIdx < 0 Then Begin
  Dispose(Buf);
  Exit;  { fichier .FRM malforme }
 End;
 InsertLine(Buf^, EndLineIdx, '   End');
 InsertLine(Buf^, EndLineIdx, '      Width           =   ' + IntToStr(CWidth));
 InsertLine(Buf^, EndLineIdx, '      Top             =   ' + IntToStr(CTop));
 InsertLine(Buf^, EndLineIdx, '      Left            =   ' + IntToStr(CLeft));
 InsertLine(Buf^, EndLineIdx, '      Height          =   ' + IntToStr(CHeight));
 If FRMControlHasCaption(TypeStr) Then
  InsertLine(Buf^, EndLineIdx, '      Caption         =   "' + CName + '"');
 InsertLine(Buf^, EndLineIdx, '   Begin VB.' + TypeStr + ' ' + CName);
 SaveFile(Buf^, AFileName);
 Dispose(Buf);
End;

{ --- Nom de la propriete VB6 portant le texte affiche, selon le type }
{ de controle (Text pour les zones de texte, Caption pour le reste). }

Function FrmCaptionPropName(TypeStr: String): String;
Begin
 If UpCaseStr(TypeStr) = 'TEXTBOX' Then
  FrmCaptionPropName := 'Text'
 Else
  FrmCaptionPropName := 'Caption';
End;

{ --- Formater une ligne de propriete .FRM avec l alignement habituel --- }

Function FrmPropLine(PropName, ValueStr: String): String;
Var
 S: String;
Begin
 S := '      ' + PropName;
 While Length(S) < 22 Do
  S := S + ' ';
 FrmPropLine := S + '=   ' + ValueStr;
End;

{ --- Renommer un controle dans le fichier .FRM : remplace uniquement }
{ le nom en fin de la ligne "Begin VB.<Type> <OldName>".              }

Procedure RenameFrmControl(AFileName, OldName, NewName: String);
Var
 Buf: ^TTextBuffer;
 Line, First, Rest, NameTok, Prefix: String;
 I: Integer;
Begin
 New(Buf);
 LoadFile(Buf^, AFileName);
 For I := 0 To Buf^.LineCount - 1 Do Begin
  Line := TrimStr(Buf^.Lines[I]);
  First := FRMVisFirstWord(Line, Rest);
  If UpCaseStr(First) = 'BEGIN' Then Begin
   FRMVisFirstWord(Rest, NameTok);
   If UpCaseStr(NameTok) = UpCaseStr(OldName) Then Begin
    Prefix := Copy(Buf^.Lines[I], 1,
     Length(Buf^.Lines[I]) - Length(NameTok));
    Buf^.Lines[I] := Prefix + NewName;
    Buf^.Modified := True;
    Break;
   End;
  End;
 End;
 SaveFile(Buf^, AFileName);
 Dispose(Buf);
End;

{ --- Mettre a jour (ou inserer si absente) une propriete d un        }
{ controle existant, identifie par son nom, dans le bloc concepteur   }
{ d un fichier .FRM. Reutilise le suivi de pile Begin/End, mais en    }
{ retenant en plus le nom du controle associe a chaque niveau pour    }
{ localiser exactement le bloc cible (et non un sous-controle du meme }
{ nom par coincidence).                                                }

Procedure UpdateFrmControlProperty(AFileName, CtlName, PropName,
 NewPropVal: String; IsQuoted: Boolean);
Var
 Buf: ^TTextBuffer;
 Line, First, Rest, NameTok: String;
 StackTop, I, J, EqPos: Integer;
 BlockStart, TargetDepth, PropLineIdx: Integer;
 InTargetBlock: Boolean;
 PName, ValStr: String;
Begin
 New(Buf);
 LoadFile(Buf^, AFileName);
 StackTop := 0;
 BlockStart := -1;
 TargetDepth := -1;
 PropLineIdx := -1;
 InTargetBlock := False;
 If IsQuoted Then
  ValStr := '"' + NewPropVal + '"'
 Else
  ValStr := NewPropVal;
 I := 0;
 While I < Buf^.LineCount Do Begin
  Line := TrimStr(Buf^.Lines[I]);
  First := UpCaseStr(FRMVisFirstWord(Line, Rest));
  If First = 'BEGIN' Then Begin
   FRMVisFirstWord(Rest, NameTok);
   Inc(StackTop);
   If (Not InTargetBlock) And
      (UpCaseStr(NameTok) = UpCaseStr(CtlName)) Then Begin
    InTargetBlock := True;
    TargetDepth := StackTop;
    BlockStart := I;
   End;
  End Else If First = 'END' Then Begin
   If InTargetBlock And (StackTop = TargetDepth) Then
    InTargetBlock := False;
   If StackTop > 0 Then Dec(StackTop);
  End Else If InTargetBlock And (StackTop = TargetDepth) Then Begin
   EqPos := 0;
   For J := 1 To Length(Line) Do
    If (Line[J] = '=') And (EqPos = 0) Then EqPos := J;
   If EqPos > 0 Then Begin
    PName := UpCaseStr(TrimStr(Copy(Line, 1, EqPos - 1)));
    If PName = UpCaseStr(PropName) Then
     PropLineIdx := I;
   End;
  End;
  Inc(I);
 End;
 If BlockStart < 0 Then Begin
  Dispose(Buf);
  Exit;  { controle introuvable }
 End;
 If PropLineIdx >= 0 Then
  Buf^.Lines[PropLineIdx] := FrmPropLine(PropName, ValStr)
 Else
  InsertLine(Buf^, BlockStart + 1, FrmPropLine(PropName, ValStr));
 SaveFile(Buf^, AFileName);
 Dispose(Buf);
End;

{ --- Inserer un caractere dans le tampon --- }

Procedure InsertChar(Var Buf: TTextBuffer; ALine, ACol: LongInt;
                     Ch: Char);
Var
 S: String;
Begin
 If (ALine < 0) Or (ALine >= Buf.LineCount) Then Exit;
 S := Buf.Lines[ALine];
 If ACol < 1 Then ACol := 1;
 If ACol > Length(S) + 1 Then Begin
  { Etendre avec des espaces }
  While Length(S) < ACol - 1 Do
   S := S + ' ';
 End;
 Insert(Ch, S, ACol);
 Buf.Lines[ALine] := S;
 Buf.Modified := True;
End;

{ --- Supprimer un caractere du tampon --- }

Procedure DeleteChar(Var Buf: TTextBuffer; ALine, ACol: LongInt);
Var
 S: String;
Begin
 If (ALine < 0) Or (ALine >= Buf.LineCount) Then Exit;
 S := Buf.Lines[ALine];
 If (ACol >= 1) And (ACol <= Length(S)) Then Begin
  Delete(S, ACol, 1);
  Buf.Lines[ALine] := S;
  Buf.Modified := True;
 End Else If (ACol > Length(S)) And (ALine < Buf.LineCount - 1) Then Begin
  { Joindre avec la ligne suivante }
  Buf.Lines[ALine] := S + Buf.Lines[ALine + 1];
  DeleteLine(Buf, ALine + 1);
 End;
End;

{ --- Inserer du texte (sans retour a la ligne) --- }

Procedure InsertText(Var Buf: TTextBuffer; ALine, ACol: LongInt;
                     AText: String);
Var
 S: String;
Begin
 If (ALine < 0) Or (ALine >= Buf.LineCount) Then Exit;
 S := Buf.Lines[ALine];
 If ACol < 1 Then ACol := 1;
 While Length(S) < ACol - 1 Do
  S := S + ' ';
 Insert(AText, S, ACol);
 Buf.Lines[ALine] := S;
 Buf.Modified := True;
End;

{ --- Supprimer une plage de texte --- }

Procedure DeleteRange(Var Buf: TTextBuffer;
                      L1, C1, L2, C2: LongInt);
Var
 Before, After: String;
 I: LongInt;
Begin
 If L1 > L2 Then Exit;
 If (L1 = L2) And (C1 > C2) Then Exit;
 If (L1 < 0) Or (L2 >= Buf.LineCount) Then Exit;
 { Partie a garder avant la selection }
 Before := Copy(Buf.Lines[L1], 1, C1 - 1);
 { Partie a garder apres la selection }
 If C2 <= Length(Buf.Lines[L2]) Then
  After := Copy(Buf.Lines[L2], C2 + 1,
                Length(Buf.Lines[L2]) - C2)
 Else
  After := '';
 { Remplacer la premiere ligne }
 Buf.Lines[L1] := Before + After;
 { Supprimer les lignes intermediaires }
 If L2 > L1 Then Begin
  For I := 1 To L2 - L1 Do
   DeleteLine(Buf, L1 + 1);
 End;
 Buf.Modified := True;
End;

{ --- Obtenir le texte d une plage --- }

Function GetTextRange(Var Buf: TTextBuffer;
                      L1, C1, L2, C2: LongInt): String;
Var
 R: String;
 I: LongInt;
Begin
 R := '';
 If (L1 < 0) Or (L2 >= Buf.LineCount) Then Begin
  GetTextRange := '';
  Exit;
 End;
 If L1 = L2 Then Begin
  { Selection sur une seule ligne }
  R := Copy(Buf.Lines[L1], C1, C2 - C1 + 1);
 End Else Begin
  { Premiere ligne partielle }
  R := Copy(Buf.Lines[L1], C1,
            Length(Buf.Lines[L1]) - C1 + 1);
  R := R + #13#10;
  { Lignes intermediaires completes }
  For I := L1 + 1 To L2 - 1 Do Begin
   R := R + Buf.Lines[I] + #13#10;
  End;
  { Derniere ligne partielle }
  R := R + Copy(Buf.Lines[L2], 1, C2);
 End;
 GetTextRange := R;
End;

{ --- Obtenir le nombre de lignes --- }

Function GetLineCount(Var Buf: TTextBuffer): LongInt;
Begin
 GetLineCount := Buf.LineCount;
End;

{ --- Obtenir le nombre total de caracteres --- }

Function GetTotalChars(Var Buf: TTextBuffer): LongInt;
Var
 I: LongInt;
 Total: LongInt;
Begin
 Total := 0;
 For I := 0 To Buf.LineCount - 1 Do
  Total := Total + Length(Buf.Lines[I]);
 GetTotalChars := Total;
End;

{ --- Tampon modifie ? --- }

Function IsBufferModified(Var Buf: TTextBuffer): Boolean;
Begin
 IsBufferModified := Buf.Modified;
End;

{ --- Marquer le tampon comme sauvegarde --- }

Procedure MarkBufferSaved(Var Buf: TTextBuffer);
Begin
 Buf.Modified := False;
End;

{ --- Compter les lignes non vides --- }

Function CountNonEmptyLines(Var Buf: TTextBuffer): LongInt;
Var
 I: LongInt;
 Total: LongInt;
Begin
 Total := 0;
 For I := 0 To Buf.LineCount - 1 Do
  If Length(Buf.Lines[I]) > 0 Then
   Inc(Total);
 CountNonEmptyLines := Total;
End;

{ --- Chercher du texte dans le tampon (premiere occurrence) --- }

Function FindInBuffer(Var Buf: TTextBuffer; AText: String;
                      StartLine, StartCol: LongInt;
                      Var FoundLine, FoundCol: LongInt): Boolean;
Var
 I: LongInt;
 P: Integer;
 S: String;
Begin
 FindInBuffer := False;
 For I := StartLine To Buf.LineCount - 1 Do Begin
  S := Buf.Lines[I];
  If I = StartLine Then
   P := Pos(AText, Copy(S, StartCol, Length(S) - StartCol + 1))
  Else
   P := Pos(AText, S);
  If P > 0 Then Begin
   FoundLine := I;
   If I = StartLine Then
    FoundCol := StartCol + P - 1
   Else
    FoundCol := P;
   FindInBuffer := True;
   Exit;
  End;
 End;
End;

