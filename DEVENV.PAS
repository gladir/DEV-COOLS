Var
 { --- Etat NES complet (variant=3) ----------------------------------- }
 { PPU : pattern tables (CHR-ROM 8K), 2 nametables physiques (2K),      }
 { palette (32 octets), OAM (256 octets) et framebuffer 256x240 indexe  }
 { sur la palette NES de 64 couleurs.                                   }
 NesActive       : Boolean;     { True = mode NES (variant=3 + ROM iNES)    }
 NesChr          : Array[0..$1FFF] Of Byte;  { CHR-ROM (pattern tables)     }
 NesNT           : Array[0..$7FF] Of Byte;   { 2 nametables phys (2x1K)     }
 NesPal          : Array[0..$1F] Of Byte;    { palette PPU 32 octets        }
 NesOam          : Array[0..$FF] Of Byte;    { OAM sprite table 64x4        }
 NesFB           : Array[0..239, 0..255] Of Byte; { framebuffer pal idx     }
 NesFBPrev       : Array[0..239, 0..255] Of Byte; { trame precedente (diff) }
 NesFBFirst      : Boolean;     { force premier rendu complet               }
 NesPpuCtrl      : Byte;        { $2000 }
 NesPpuMask      : Byte;        { $2001 }
 NesPpuStatus    : Byte;        { $2002 (bit7 vblank, bit6 sp0hit, bit5 ovf)}
 NesOamAddr      : Byte;        { $2003 }
 NesScrollX      : Byte;        { $2005 (1ere ecriture)                     }
 NesScrollY      : Byte;        { $2005 (2e ecriture)                       }
 NesPpuLatch     : Boolean;     { False = prochaine ecriture est high       }
 NesPpuAddr      : Word;        { adresse VRAM courante (15 bits)           }
 NesPpuBuf       : Byte;        { tampon de lecture PPUDATA                 }
 NesMirror       : Byte;        { 0=horizontal 1=vertical 2=4-screen 3=1scr }
 NesPad1, NesPad2 : Byte;       { etat instantane des manettes              }
 NesPad1Sh, NesPad2Sh : Byte;   { registres a decalage de lecture           }
 NesPadStrobe    : Byte;        { dernier bit ecrit en $4016                }
 NesNmiPending   : Boolean;     { NMI a declencher avant prochain step      }
 NesFrameDone    : Boolean;     { trame complete -> rendre framebuffer      }
 NesFrameNo      : LongInt;     { compteur de trames                        }
 { --- Etat mapper NES (mapper 0/1/2/4 supportes) --- }
 NesPrgRom       : Array[0..$7FFFF] Of Byte;  { PRG-ROM totale (512 KiB max) }
 NesChrRom       : Array[0..$3FFFF] Of Byte;  { CHR-ROM totale (256 KiB max) }
 NesPrgBlocksTotal : Integer;    { nb blocs 16K dans NesPrgRom              }
 NesChrBlocksTotal : Integer;    { nb blocs 8K dans NesChrRom               }
 NesMapper         : Integer;    { numero de mapper iNES                    }
 NesUseChrRam      : Boolean;    { CHR=0 -> 8K CHR-RAM dans NesChr          }
 { MMC1 (mapper 1) }
 NesM1Shift     : Byte;
 NesM1ShiftCount: Byte;
 NesM1Ctrl      : Byte;
 NesM1Chr0      : Byte;
 NesM1Chr1      : Byte;
 NesM1Prg       : Byte;
 { MMC3 (mapper 4) }
 NesM3BankSelect: Byte;
 NesM3Banks     : Array[0..7] Of Byte;
 { Compatibilite ancienne (non utilises desormais) }
 NesPpu_Addr     : Word;
 NesPpu_Latch    : Boolean;
 NesPpu_NameTable: Array[0..$3FF] Of Byte;
 NesPpu_Rendered : Boolean;
 { --- Etat C64 complet (variant=1) ------------------------------------ }
 { Commutation banque materielle reelle via le port CPU $00/$01 (LORAM/  }
 { HIRAM/CHAREN), VIC-II en mode texte seulement (pas de bitmap/          }
 { multicolore/ecran etendu), SID reduit a un tampon de registres         }
 { (aucun son), CIA1 avec matrice clavier + Timer A/B + IRQ reels (la     }
 { seule partie du chipset dont le comportement doit etre correct pour    }
 { qu un vrai demarrage KERNAL/BASIC aboutisse a READY.), CIA2 reduit a   }
 { un tampon de registres (seul PRA bits 0-1, banque VIC, est consulte). }
 C64_HiRam       : TC64HiRamArr; { RAM "sous" BASIC/E-S/KERNAL }
 C64_Port01      : Byte;        { valeur ecrite au port CPU $01 (LORAM/   }
                                 { HIRAM/CHAREN, bits 3-5 cassette ignores) }
 C64_Port00      : Byte;        { DDR du port CPU $00 (direction, ignore  }
                                 { pour la commutation banque elle-meme)  }
 C64_VicReg      : TC64VicRegArr; { $D000-$D03E (registres reels  }
                                 { $00-$2E, reste en miroir/inutilise)    }
 C64_SidReg      : TC64SidRegArr; { $D400-$D41C, pas de son     }
 C64_ColorRam    : TC64ColorRamArr; { $D800-$DBFF, nibble bas seul }
 C64_Cia1Reg     : TC64CiaRegArr; { $DC00-$DC0F }
 C64_Cia2Reg     : TC64CiaRegArr; { $DD00-$DD0F }
 C64_Cia1TimerA  : Word;        { compteur vivant Timer A (decompte a     }
                                 { chaque cycle CPU ecoule)               }
 C64_Cia1TimerALatch: Word;
 C64_Cia1TimerB  : Word;
 C64_Cia1TimerBLatch: Word;
 C64_Cia1IcrMask : Byte;        { sources d interruption activees ($0D,   }
                                 { bit7=1 en ecriture -> positionne)      }
 C64_Cia1IcrPending: Byte;      { sources en attente (efface a la lecture) }
 C64_IrqPending  : Boolean;     { ligne IRQ maintenue basse (CIA1 ICR)    }
 { Matrice clavier standard 8x8 (colonne = bit dans KeyCol[ligne]) -     }
 { True = touche enfoncee. Remplie une fois par trame via GetAsyncKeyState}
 { (meme motif que NesPollInput/A2600), consultee au moment ou le KERNAL }
 { lit PRB apres avoir selectionne une ligne via PRA. }
 C64_KeyMatrix   : TC64KeyMatrixArr;
 C64_FrameNo     : LongInt;
 C64_RasterLine  : Word;    { 0..311 (PAL) - compteur de ligne video reel }
 C64_RasterAcc   : Integer; { accumulateur de cycles pour l avance de ligne }
 { "Auto-frappe" de "RUN"/"SYS n"+Entree apres le demarrage : simule de     }
 { VRAIES touches enfoncees/relachees (via C64_KeyMatrix, la meme matrice  }
 { que la frappe reelle - voir C64_ApplyAutoType) plutot que d ecrire        }
 { directement le tampon clavier bas niveau ($0277/$C6). BOGUE REEL           }
 { rencontre et corrige (2026-08-14) : l ecriture directe du tampon ne         }
 { suffit PAS a faire "taper" une commande a l invite BASIC - CHRIN (la       }
 { routine KERNAL qui lit une ligne de commande) lit en realite le texte      }
 { directement sur l ECRAN a partir du debut de la ligne courante (le          }
 { celebre "editeur ecran" du C64, qui permet par exemple de re-executer      }
 { une commande deja affichee en deplacant le curseur dessus et en             }
 { appuyant sur Entree) - le tampon bas niveau $0277 n alimente que              }
 { GETIN, pas l entree de ligne complete de BASIC. Emuler de vraies             }
 { frappes via la matrice laisse le KERNAL lui-meme faire l echo a              }
 { l ecran et gerer le curseur, exactement comme une vraie frappe.               }
 C64_PendingInject: String; { texte restant a "taper" (vide = rien/termine) }
 C64_TypeIdx      : Integer; { index 1-based du caractere en cours (0=pas    }
                             { encore demarre) }
 C64_TypeCounter  : Integer; { trames restantes dans la phase courante        }
 C64_TypePressed  : Boolean; { True = touche actuellement "enfoncee"          }
 C64_PendingVartab: Word;   { 0 = rien a faire, sinon VARTAB/ARYTAB/STREND    }
                             { a appliquer au tout debut de l auto-frappe        }
                             { (ces pointeurs zero-page peuvent eux aussi        }
                             { etre ecrases par le test memoire du KERNAL). }
 C64_PendingJumpPC: Word;   { 0 = rien a faire, sinon adresse a laquelle       }
                             { sauter directement des que READY est atteint     }
                             { (voie fiable, prioritaire sur C64_PendingInject  }
                             { - voir C64_Boot). }
 { Etat de la version "asynchrone" (Stage 1, 2026-08-15) de la boucle    }
 { C64 - voir C64_RunOneFrame/EmuPanel_ContinueStep. Remplace les        }
 { anciennes variables LOCALES C64KeyEsc/EntryAddr de ShowEmulatorPanel,  }
 { qui ne pouvaient pas survivre entre deux appels separes. }
 C64Async_KeyEsc     : Boolean;
 C64Async_LastFrameTS: LongInt;
 { Meme motif pour NES/Atari 2600 (conversion Stage 1, meme session) :   }
 { remplacent les anciennes variables LOCALES NesKeyEsc/A2600_KeyEsc     }
 { d origine + EntryAddr, qui ne survivaient pas entre deux appels.      }
 NesAsync_KeyEsc      : Boolean;
 NesAsync_LastFrameTS : LongInt;
 A2600Async_LastFrameTS: LongInt;
 Coco3Async_KeyEsc      : Boolean;
 Coco3Async_LastFrameTS : LongInt;
Const
 { Palette C64 (16 couleurs standard, indices $00-$0F du VIC-II) mise en }
 { correspondance avec la palette EGA 16 couleurs du panneau emulateur - }
 { rapprochement visuel raisonnable, pas une conversion colorimetrique   }
 { exacte (le C64 n a pas de palette EGA equivalente native). }
 C64_PalToEga: Array[0..15] Of Byte = (
  0,  15, 4,  11, 5,  2,  1,  14,  { noir,blanc,rouge,cyan,violet,vert,bleu,jaune }
  6,  6,  12, 8,  8,  10, 9,  7);  { orange,brun,rouge clair,gris fonce,gris,     }
                                   { vert clair,bleu clair,gris clair              }
Var
 { --- Etat emulateur Atari 2600 / VCS (variant=4) --------------------- }
 { TIA + RIOT minimaux : playfield (PF0/PF1/PF2), joueurs P0/P1,         }
 { missiles M0/M1, balle BL, couleurs COLUPx/COLUPF/COLUBK, controle    }
 { CTRLPF, miroirs REFPx, VSYNC/VBLANK, WSYNC, HMOVE, NUSIZ.            }
 A2600_Active   : Boolean;
 A2600_FB       : Array[0..191, 0..159] Of Byte; { palette idx (128 col) }
 A2600_FBPrev   : Array[0..191, 0..159] Of Byte;
 A2600_FBFirst  : Boolean;
 A2600_TIA      : Array[0..$7F] Of Byte;          { etat registres TIA   }
 A2600_RIOTRam  : Array[0..$7F] Of Byte;          { 128 octets RAM 6532  }
 A2600_VSYNCAct : Boolean;
 A2600_VBLANKAct: Boolean;
 A2600_ScanLine : Integer;     { 0..261 (NTSC), reset par VSYNC          }
 A2600_VisLine  : Integer;     { ligne visible (VBLANK off), 0..191      }
 A2600_FrameNo  : LongInt;
 A2600_WSYNCWait: Boolean;     { CPU bloque jusqu a la fin du scanline   }
 A2600_LineCyc  : Integer;     { cycles CPU dans le scanline courant     }
 A2600_LineInstr: Integer;     { instructions dans le scanline courant   }
 A2600_P0X      : Integer;     { position pixel joueur 0 (0..159)        }
 A2600_P1X      : Integer;
 A2600_M0X, A2600_M1X, A2600_BLX : Integer;
 A2600_HMP0, A2600_HMP1, A2600_HMM0, A2600_HMM1, A2600_HMBL : ShortInt;
 { HMOVE differe : strobe en partie visible -> declenche motion au }
 { scanline suivant (Stella-accurate "late HMOVE").                }
 A2600_HMOVEPending  : Boolean;
 { Pipeline TIA HMOVE per-object cycle-accurate :                  }
 {  - HMOVE_Counter : compteur 4-bit (0..15) qui s'incremente a    }
 {    chaque tick (1 par cycle CPU).                               }
 {  - HMxx_Active   : flag par objet (P0,P1,M0,M1,BL). Tant qu il  }
 {    est True ET que Counter < |HMx|, l objet recoit un "extra    }
 {    clock" (motion -1 dans le sens du signe). Une fois clear, le }
 {    flag est LATCH False (ne reactive plus dans la meme passe).  }
 A2600_HMOVE_Counter : Integer;
 A2600_HMOVE_Running : Boolean;
 A2600_HMxx_Active   : Array[0..4] Of Boolean;
 { Double-buffer GRP0/GRP1/ENABL pour VDELP0/VDELP1/VDELBL (2-line kernels) }
