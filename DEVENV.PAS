            If P.CPU.AddrSize32 Then
             Emu_WriteByteL(P.CPU, P.CPU.Segs.ES, DIL,
              Emu_ReadByteL(P.CPU, Emu_DataSeg(P.CPU), SIL))
            Else
             Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(DIL),
              Emu_ReadByte(P.CPU, Emu_DataSeg(P.CPU), Word(SIL)));
