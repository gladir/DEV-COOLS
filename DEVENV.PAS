     HPath := Emu_HostPath(FName);
     H := Emu_AllocHandle;
     If (H = 0) Or (Length(HPath) = 0) Then Emu_SetDosErr(P, 4)
     Else Begin
      Assign(EmuFileH[H], HPath);
