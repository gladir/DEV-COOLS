Procedure TermExecuteCommand(Var TP: TTerminalPanel;
 CmdStr: String);
Var
 CurrCmd, ParamStr, PipeS: String;
 Err: Word;
 CurDir, DosExe, ElfExe: String;
 PrgTarget, PrgPath: String;
 FatDosPath: String;
 ArgFile, ArgSwitch, DbgTarget, DbgPath, ResolveDir: String;
 ArgBP, BPSegStr, BPOfsStr, RestBP, BPNStr, BPLenStr: String;
 BPSeg, BPOfs, BPColonPos, BPColonPos2, BPColonPos3: Word;
 BPErr1, BPErr2, BPErr3, BPErr4: Word;
 BPN, BPLen: LongInt;
 BPIdx: Integer;
 ArgCmd3, ArgCmd4: String;
 PSCmdID: Byte;
Begin
 CmdStr := TermTrim(CmdStr);
 If CmdStr = '' Then Exit;
 TermAddHistory(TP, CmdStr);
 { Changement de lecteur : A:, B:, C:, D:, ... }
 If (Length(CmdStr) = 2) And (CmdStr[2] = ':') And
  (CmdStr[1] In ['A'..'Z', 'a'..'z']) Then Begin
  { MOUNT (2026-08-29) : une lettre montee via MOUNT est PRIORITAIRE sur    }
  { le comportement A:/B:/C:/D: ci-dessous (meme convention que DOSBox, ou  }
  { MOUNT est toujours autoritaire) - simple `ChDir` absolu vers le          }
  { repertoire monte, TP.VirtDrive reste a -1 (mode hote standard) donc     }
  { TOUT le reste (DIR/TYPE/COPY/NES/etc) continue de fonctionner sans le    }
  { moindre changement ailleurs. }
  If TermMountActive[UpCase(CmdStr[1])] Then Begin
   {$I-} ChDir(TermMountDir[UpCase(CmdStr[1])]); {$I+}
   Err := IOResult;
   If Err <> 0 Then
    TermAddLine(TP, TermGetErrorMessage(Err))
   Else
    TermAddLine(TP, TermMountDir[UpCase(CmdStr[1])]);
   Exit;
  End;
  { Lecteurs virtuels A:/B: (disquettes) et C:/D: (disques durs) :
    sur image montee, on bascule le terminal en mode disque virtuel. }
  If UpCase(CmdStr[1]) = 'A' Then Begin
   Term_TryEnterVirtDrive(TP, 0, '/DISK0:fichier.img');
   Exit;
  End;
  If UpCase(CmdStr[1]) = 'B' Then Begin
   Term_TryEnterVirtDrive(TP, 1, '/DISK1:fichier.img');
   Exit;
  End;
  { C:/D: ne sont consideres comme lecteurs virtuels que si une image
    disque dur a effectivement ete montee (/DISK80//DISK81) : sinon
    on garde le comportement d origine (changement de lecteur hote,
    C: etant le plus souvent le disque principal de la machine reelle). }
  If (UpCase(CmdStr[1]) = 'C') And EmuFloppyOpen[2] Then Begin
   Term_TryEnterVirtDrive(TP, 2, '/DISK80:fichier.img');
   Exit;
  End;
  If (UpCase(CmdStr[1]) = 'D') And EmuFloppyOpen[3] Then Begin
   Term_TryEnterVirtDrive(TP, 3, '/DISK81:fichier.img');
   Exit;
  End;
  { Autres lecteurs : on revient au mode hote standard }
  TP.VirtDrive := -1;
  {$I-}
  GetDir(Ord(UpCase(CmdStr[1])) - 64, PipeS);
  If PipeS <> '' Then ChDir(PipeS)
   Else ChDir(CmdStr + '\');
  {$I+}
  Err := IOResult;
  If Err <> 0 Then
   TermAddLine(TP, TermGetErrorMessage(Err));
  Exit;
 End;
 { Extraire la commande et les parametres }
 TermExtractCommand(CmdStr, CurrCmd, ParamStr);
 { "DEBUG <fichier.exe|.com|.prg|.xex> /GUI [/BP:SEG:OFS]" (inspire de la    }
 { vraie commande MS-DOS DEBUG.COM) : charge le programme dans l emulateur  }
 { SANS le lancer et affiche le debogueur pas-a-pas deja existant (Point    }
 { d arret/Pas a pas, menu Deboguer) a droite du panneau - voir             }
 { EmuDbgArmPauseOnLoad/ShowEmulatorPanel. /BP:SEG:OFS (optionnel) pose en  }
 { plus un point d arret machine des le chargement, sur une adresse         }
 { LINEAIRE (Seg Shl 4)+Ofs qui reste actif meme pour du code atteint       }
 { uniquement via EXEC (AH=4Bh) plus tard - voir EmuDbg_AddBP ci-dessous.   }
 { DEBUG /? affiche l aide. Commun aux 5 shells, intercepte ICI (avant le   }
 { Case ci-dessous) plutot que duplique dans chacun. Meme restriction       }
 { "disque hote uniquement" que le repli generique "commande inconnue ->   }
 { executable" plus bas (lecteurs virtuels non geres ici). }
 If CurrCmd = 'DEBUG' Then Begin
  ArgFile := TermExtractParam(ParamStr, 1);
  ArgSwitch := TermExtractParam(ParamStr, 2);
  If (UpCaseStr(ArgFile) = '/?') Or (UpCaseStr(ArgSwitch) = '/?') Then Begin
   TermAddLine(TP, 'Syntaxe : DEBUG <fichier.exe|.com|.prg|.xex> /GUI [/BP:SEG:OFS[:N][:LEN]]');
   TermAddLine(TP, '  /GUI          Charge le programme sans le lancer et affiche');
   TermAddLine(TP, '                le Debogueur 8086/6502/6809 (fenetre a droite).');
   TermAddLine(TP, '  /BP:SEG:OFS   Pose un point d''arret machine (hexa) des le');
   TermAddLine(TP, '                chargement, ex. /BP:201F:265B - reste actif');
   TermAddLine(TP, '                meme pour du code atteint via EXEC (AH=4Bh),');
   TermAddLine(TP, '                donc utile pour retrouver l''appelant d''une');
   TermAddLine(TP, '                routine sans faire defiler le desassemblage.');
   TermAddLine(TP, '  /BP:SEG:OFS:N Meme chose, mais ne pause qu au Nieme passage');
   TermAddLine(TP, '                (N en decimal) - utile pour une routine partagee');
   TermAddLine(TP, '                appelee de nombreuses fois avant l occurrence');
   TermAddLine(TP, '                qui interesse (ex. juste avant un plantage).');
   TermAddLine(TP, '  /BP:SEG:OFS:N:LEN Idem, et au declenchement, vide LEN octets');
   TermAddLine(TP, '                (decimal) de memoire EMULEE REELLE depuis SEG:OFS');
   TermAddLine(TP, '                vers EMUDUMP.BIN (brut) et EMUDUMP.LOG (hexa+ASCII)');
   TermAddLine(TP, '                - capture le contenu VRAI a cet instant, utile pour');
   TermAddLine(TP, '                un module recouvert (overlay) dont le contenu differe');
   TermAddLine(TP, '                du desassemblage statique du .EXE au repos. N peut');
   TermAddLine(TP, '                etre omis (deux-points doubles, colon vide) pour vider');
   TermAddLine(TP, '                des le 1er passage.');
   TermAddLine(TP, '  /CMD          Ouvre en plus la Console de commandes du');
   TermAddLine(TP, '                debogueur (SoftICE/Visual Studio/GDB),');
   TermAddLine(TP, '                entre le panneau emulateur et le debogueur.');
   TermAddLine(TP, '                Implique /GUI (inutile de le repeter).');
   TermAddLine(TP, '  Exemples : DEBUG C:\SYMANTEC\NC3\NC.EXE /GUI /BP:201F:265B');
   TermAddLine(TP, '             DEBUG C:\SYMANTEC\NC3\NC.EXE /GUI /BP:201F:B6A2:50');
   TermAddLine(TP, '             DEBUG C:\SYMANTEC\NC3\NC.EXE /GUI /BP:201F:30BD::256');
   TermAddLine(TP, '             DEBUG C:\SYMANTEC\NC3\NC.EXE /GUI /CMD');
   Exit;
  End;
  If (ArgFile = '') Or (UpCaseStr(ArgSwitch) <> '/GUI') Then
   TermAddLine(TP, 'Syntaxe : DEBUG <fichier.exe|.com|.prg|.xex> /GUI [/BP:SEG:OFS[:N]]')
  Else If TP.VirtDrive >= 0 Then
   TermAddLine(TP,
    'DEBUG /GUI n''est pas pris en charge sur un lecteur virtuel.')
  Else Begin
   If TP.Shell = SK_NCOMMANDER Then CurDir := TP.VirtCwd
   Else GetDir(0, CurDir);
   { ArgFile peut etre un chemin absolu (ex. C:\SYMANTEC\NC3\NC.EXE) plutot }
   { qu un simple nom de fichier a chercher dans CurDir - dans ce cas les  }
   { fonctions ci-dessous doivent recevoir Dir='' pour ne pas concatener   }
   { CurDir devant un chemin deja complet.                                 }
   If (Length(ArgFile) >= 2) And (ArgFile[2] = ':') Then ResolveDir := ''
   Else If (Length(ArgFile) >= 1) And ((ArgFile[1] = '\') Or (ArgFile[1] = '/')) Then ResolveDir := ''
   Else ResolveDir := CurDir;
   DbgTarget := ''; DbgPath := '';
   DbgPath := TermFindDosExecutable(ResolveDir, ArgFile);
   If DbgPath <> '' Then DbgTarget := '-CD'
   Else If TermFindPrgExecutable(TP, ResolveDir, ArgFile, PrgTarget, PrgPath) Then Begin
    DbgTarget := PrgTarget;
    DbgPath := PrgPath;
   End Else If (Length(ArgFile) > 4) And
    (UpCaseStr(Copy(ArgFile, Length(ArgFile) - 3, 4)) = '.XEX') Then Begin
    DbgPath := ResolveDir;
    If (Length(DbgPath) > 0) And (DbgPath[Length(DbgPath)] <> '\') Then
     DbgPath := DbgPath + '\';
    DbgPath := DbgPath + ArgFile;
    If FileExists(DbgPath) Then DbgTarget := '-CATARI800'
    Else DbgPath := '';
   End;
   If DbgTarget = '' Then
    TermAddLine(TP, '''' + ArgFile + ''' introuvable.')
   Else Begin
    { /CMD (optionnel, n importe quelle position parmi les parametres 3/4 -
      un utilisateur peut le taper sans /BP: du tout) : ouvre en plus la
      Console de commandes du debogueur (SoftICE/Visual Studio/GDB) une
      fois la fenetre EmuDbg positionnee - voir EmuCmdConsoleArmOnLoad
      ci-dessous, consomme dans CreateEmulatorTab. }
    ArgCmd3 := TermExtractParam(ParamStr, 3);
    ArgCmd4 := TermExtractParam(ParamStr, 4);
    If (UpCaseStr(ArgCmd3) = '/CMD') Or (UpCaseStr(ArgCmd4) = '/CMD') Then
     EmuCmdConsoleArmOnLoad := True;
    EmuDbgArmPauseOnLoad := True;
    CreateEmulatorTab(DbgPath, DbgTarget, '');
    { Parametre optionnel /BP:SEG:OFS (hexa, ex. /BP:201F:265B) : pose un   }
    { point d arret machine des le chargement, sur une adresse LINEAIRE    }
    { (Seg Shl 4)+Ofs - fonctionne meme pour du code atteint uniquement    }
    { via EXEC (AH=4Bh, cible dans un segment different de celui charge    }
    { ici), puisque EmuDbg_ShouldBreak compare a CS:IP courant a CHAQUE    }
    { instruction, quel que soit le programme en cours d execution. Utile  }
    { pour retrouver l appelant d une routine sans devoir faire defiler    }
    { manuellement le desassemblage jusqu a une adresse arbitraire. }
    ArgBP := TermExtractParam(ParamStr, 3);
    If (Length(ArgBP) > 4) And (UpCaseStr(Copy(ArgBP, 1, 4)) = '/BP:') Then Begin
     RestBP := Copy(ArgBP, 5, Length(ArgBP) - 4);
     BPColonPos := Pos(':', RestBP);
     If BPColonPos > 0 Then Begin
      BPSegStr := Copy(RestBP, 1, BPColonPos - 1);
      RestBP := Copy(RestBP, BPColonPos + 1, Length(RestBP) - BPColonPos);
      { RestBP est maintenant OFS seul, OFS:N (Nieme passage recherche - voir }
      { EmuDbg_CheckBPHit/HitCountTarget, evite de s arreter a un appel       }
      { normal d une routine partagee avant l occurrence recherchee), ou      }
      { OFS:N:LEN (vide en plus, a ce declenchement precis, LEN octets de la  }
      { memoire EMULEE REELLE vers EMUDUMP.BIN/.LOG - voir                   }
      { EmuDbg_DumpMemoryAt - utile pour capturer le contenu REEL d un module }
      { recouvert/overlay, que le desassemblage statique du .EXE ne peut pas  }
      { refleter). }
      BPColonPos2 := Pos(':', RestBP);
      If BPColonPos2 > 0 Then Begin
       BPOfsStr := Copy(RestBP, 1, BPColonPos2 - 1);
       RestBP := Copy(RestBP, BPColonPos2 + 1, Length(RestBP) - BPColonPos2);
       BPColonPos3 := Pos(':', RestBP);
       If BPColonPos3 > 0 Then Begin
        BPNStr := Copy(RestBP, 1, BPColonPos3 - 1);
        BPLenStr := Copy(RestBP, BPColonPos3 + 1, Length(RestBP) - BPColonPos3);
       End Else Begin
        BPNStr := RestBP;
        BPLenStr := '';
       End;
      End Else Begin
       BPOfsStr := RestBP;
       BPNStr := '';
       BPLenStr := '';
      End;
      Val('$' + BPSegStr, BPSeg, BPErr1);
      Val('$' + BPOfsStr, BPOfs, BPErr2);
      BPN := 0; BPErr3 := 0;
      If BPNStr <> '' Then Val(BPNStr, BPN, BPErr3);
      BPLen := 0; BPErr4 := 0;
      If BPLenStr <> '' Then Val(BPLenStr, BPLen, BPErr4);
      If (BPErr1 = 0) And (BPErr2 = 0) And (BPErr3 = 0) And (BPErr4 = 0) Then Begin
       EmuDbg_AddBP((LongInt(BPSeg) Shl 4) + BPOfs, EDC_8086);
       BPIdx := EmuDbg_FindBP((LongInt(BPSeg) Shl 4) + BPOfs, EDC_8086);
       If (BPN > 0) And (BPIdx >= 0) Then
        EmuDbg.BPs[BPIdx].HitCountTarget := BPN;
       If (BPLen > 0) And (BPIdx >= 0) Then
        EmuDbg.BPs[BPIdx].DumpLen := BPLen;
       If BPN > 0 Then Begin
        TermAddLine(TP, 'Point d''arret pose : ' + BPSegStr + ':' + BPOfsStr +
         ' (au passage numero ' + IntToStr(BPN) + ')');
       End Else
        TermAddLine(TP, 'Point d''arret pose : ' + BPSegStr + ':' + BPOfsStr);
       If BPLen > 0 Then
        TermAddLine(TP, '  -> vidage memoire de ' + IntToStr(BPLen) +
         ' octets prevu vers EMUDUMP.BIN/.LOG au declenchement.');
      End Else
       TermAddLine(TP, 'Adresse /BP invalide : ' + ArgBP);
     End;
    End;
   End;
  End;
  Exit;
 End;
