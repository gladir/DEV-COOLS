 { Chantier Windows 16 bits (2026-08-25), Stage 1 : en-tete "NE" (New       }
 { Executable, format de TOUS les .EXE Windows 1.x/2.x/3.x et OS/2 1.x).    }
 { Layout verifie EMPIRIQUEMENT (pas seulement d apres une reference        }
 { ecrite) en relisant un vrai CLOCK.EXE Windows 2.03 (C:\BACKUP\WIN203,    }
 { date reelle Nov 1987) via un script Perl autonome (ne_probe.pl,          }
 { scratchpad) : les 3 modules importes decodes ("KERNEL","GDI","USER")     }
 { sont EXACTEMENT les 3 modules systeme Windows attendus, et les flags de  }
 { segment sont auto-coherents avec ne_autodata (le segment #2, marque      }
 { DONNEES par son bit 0, est bien celui designe par ne_autodata=2) - deux  }
 { signaux independants qui confirment ce layout, meme discipline que le    }
 { chantier OS/2 LX. 64 octets exactement (0x40), aucune reserve non        }
 { reprise ici contrairement a LX - tous les champs sont utiles. }
 TNEHeader = Record
  ne_magic0, ne_magic1: Byte;  { 'N','E'                                  }
  ne_ver, ne_rev: Byte;        { version/revision du linker                }
  ne_enttab   : Word;          { offset table des entrees (relatif ici)    }
  ne_cbenttab : Word;          { longueur en octets de la table des entrees}
  ne_crc      : LongInt;
  ne_flags    : Word;
  ne_autodata : Word;          { index 1-based du segment de donnees       }
                                { automatique (DGROUP)                     }
  ne_heap     : Word;
  ne_stack    : Word;
  ne_ip       : Word;          { point d'entree : IP...                   }
  ne_cs       : Word;          { ...et CS - un INDEX 1-based dans la table }
                                { des segments, PAS un vrai segment reel   }
  ne_sp       : Word;          { pile initiale : SP...                    }
  ne_ss       : Word;          { ...et SS, meme convention d'index         }
  ne_cseg     : Word;          { nombre de segments                        }
  ne_cmod     : Word;          { nombre de modules importes                }
  ne_cbnrestab: Word;
  ne_segtab   : Word;          { offset table des segments (relatif ici)   }
  ne_rsrctab  : Word;
  ne_restab   : Word;          { offset table des noms residents (relatif) }
  ne_modtab   : Word;          { offset table des references de modules    }
                                { (relatif ici, N entrees de 1 Word =       }
                                { offset dans ne_imptab)                    }
  ne_imptab   : Word;          { offset table des noms importes (relatif   }
                                { ici, chaines Pascal longueur-prefixee)    }
  ne_nrestab  : LongInt;       { offset ABSOLU (depuis le debut du fichier)}
                                { de la table des noms NON residents        }
  ne_cmovent  : Word;
  ne_align    : Word;          { decalage log2 de la taille de secteur     }
                                { logique (ex. 4 -> secteurs de 16 octets)  }
  ne_cres     : Word;
  ne_exetyp   : Byte;          { 2=Windows (souvent 0 sur du tres ancien   }
                                { code 1987, non fiable a lui seul)         }
  ne_flagsothers: Byte;
  ne_reserved1, ne_reserved2, ne_reserved3, ne_expver: Word;
 End;

 { Entree table des segments NE (8 octets, verifiee empiriquement sur       }
 { CLOCK.EXE : 2 segments, #1 flags=$0D10 (bit0=0 -> CODE), #2 flags=$0D11  }
 { (bit0=1 -> DONNEES) - #2 est bien celui designe par ne_autodata=2.       }
 TNESegment = Record
  DataOffsetSectors: Word;   { position fichier, en unites de 2^ne_align   }
                              { octets ; 0 = segment vide (BSS pur)         }
  DataLength       : Word;   { longueur reelle en octets (0 = 64 Ko)       }
  SegFlags         : Word;   { bit0=DONNEES(1)/CODE(0), bit2=ITERE,        }
                              { bit4=DEPLACABLE, bit5=PARTAGEABLE,          }
                              { bit6=PRECHARGE, bit7=LECTURE-SEULE/         }
                              { EXECUTEONLY, bit8=A_DES_RELOGEMENTS,        }
                              { bit12=DISCARDABLE                          }
  MinAlloc         : Word;   { taille minimale d'allocation (0 = 64 Ko)    }
 End;

Const
 { Chantier Windows 16 bits, Stage 2 : limites du chargeur NE - segments   }
 { et emplacements de trappe d'import, mêmes constantes utilisees par      }
 { Win16_LoadNE/Win16_ResolveImportSlot (voir plus loin dans ce fichier). }
 WIN16_MAX_SEGS       = 64;
 WIN16_MAX_TRAP_SLOTS = 128;
 WIN16_TRAP_SLOT_SIZE = 5;  { CD F8 (INT prive) + index de slot (2 octets) + CB (RETF) }
 { Chantier Windows 16 bits, Stage 6 : fenetre reellement visible -        }
 { classes/fenetres/file de messages, un seul programme charge a la fois  }
 { (meme limitation deja assumee que Win16_ImportModIdx[] etc.). }
 WIN16_MAX_WNDCLASSES = 8;
 WIN16_MAX_WINDOWS    = 8;
 WIN16_MAX_MSGQUEUE   = 32;
 { Stage 6b (2026-08-30) : minuteurs SetTimer/KillTimer, meme limitation      }
 { mono-programme. }
 WIN16_MAX_TIMERS     = 8;
 { Constantes ABI Windows publiques et fixes (winuser.h) - meme categorie de }
 { certitude que les constantes SM_* deja utilisees sans verification         }
 { supplementaire dans ce chantier. }
 WIN16_WM_CREATE  = $0001;
 WIN16_WM_DESTROY = $0002;
 WIN16_WM_SIZE    = $0005;
 WIN16_WM_PAINT   = $000F;
 WIN16_WM_TIMER   = $0113;
 WIN16_WM_QUIT    = $0012;

Const
 LXOBJ_READABLE   = $0001;
 LXOBJ_WRITABLE   = $0002;
 LXOBJ_EXECUTABLE = $0004;
 LXOBJ_RESOURCE   = $0008;
 LXOBJ_DISCARD    = $0010;
 LXOBJ_SHARED     = $0020;
 LXOBJ_PRELOAD    = $0040;
 LXOBJ_INVALID    = $0080;
 LXOBJ_BIG32      = $2000;  { adressage 32 bits ("Big"/"Default" bit)    }

 { Chantier OS/2 LX, Stage 3 : zone reservee (jamais couverte par aucun    }
 { objet reel - tres au-dela de LX_MEM_SIZE, verifie a l implementation    }
 { par les bornes deja imposees a Emu_LoadLX) pour les thunks de trappe    }
 { DOSCALLS. Choisie sous LX_MEM_SIZE lui-meme (contrairement au plan       }
 { initial qui la placait a $01F00000, hors de la plage 32 Mo actuelle -    }
 { corrige ici pour rester a l interieur du tampon LX_Mem reellement       }
 { alloue) : les 2 derniers Mo de LX_Mem, largement au-dela de tout objet   }
 { reel observe (le plus grand objet de ddnsicon.exe culmine a $36C90).    }
 LX_TRAP_BASE      = $1E00000;   { $1E00000..$1FFFFFF = 2 Mo reserves     }
 LX_TRAP_SLOT_SIZE = 16;
 LX_MAX_TRAP_SLOTS = 512;        { 512*16 = 8 Ko, tres en-dessous des 2 Mo}
 { Chantier OS/2 LX, Stage 5 (suite) : zone reservee pour un prefixe de     }
 { segment FS (0x64) - trouve reellement necessaire en verifiant           }
 { LOGDAEM.EXE (bytes reels "64 FF 35 00000000" = PUSH FS:[0], suivi de    }
 { "64 89 25 00000000" = MOV FS:[0],ESP - prologue classique de chainage   }
 { de gestionnaire d exception, meme idee que le TIB Win32 via FS). Le      }
 { modele plat LX_Mem n a AUCUN registre de segment reel (contrairement a  }
 { Dpmi_Step) - FS:[x] est donc simule comme adresse LINEAIRE PLATE        }
 { LX_FS_BASE+x dans une petite zone dediee, zero-initialisee (valeur de   }
 { depart correcte pour un chainage de gestionnaires : "aucun gestionnaire"}
 { = 0). AUCUNE pretention de representer un vrai TIB/PIB OS/2 - juste un  }
 { emplacement stable en lecture/ecriture pour laisser le programme avancer}
 { au-dela de ce prologue. Placee juste sous LX_TRAP_BASE pour ne jamais   }
 { chevaucher le tas (voir le nouveau plafond de Emu_LoadLX/DosAllocMem).  }
 LX_FS_BASE = LX_TRAP_BASE - $1000; { 4 Ko reserves, sous la zone de trappe}

Type
 { Entree table des pages objet LX (e32_objmap), 8 octets - format        }
 { verifie EMPIRIQUEMENT (pas d apres une reference ecrite, genuinement    }
 { ambigue selon les sources) sur ddnsicon.exe : les 7 premieres pages de  }
 { l objet #1 (code) ont un SectorOffset croissant PAR PAS DE EXACTEMENT   }
 { 8 secteurs (=4096 octets=1 page) et SizeBytes=4096, la 8e (derniere,    }
 { partielle) tombe a SizeBytes=2048 (arrondi secteur de la taille reelle  }
 { restante 1684 octets) - preuve arithmetique propre, pas une simple      }
 { supposition. SectorOffset est exprime en unites de 2^e32_pageshift      }
 { octets (secteurs de 512 octets dans ce fichier), PAS en unites de       }
 { e32_pagesize. Cas particulier note mais PAS ENCORE PLEINEMENT compris : }
 { les pages de l objet #3 (donnees+pile) portent des SectorOffset (0, 8)  }
 { qui retombent DANS la zone d en-tete/tables (avant e32_datapage), donc  }
 { manifestement pas de vraies donnees de page - traite prudemment comme   }
 { zero-fill (BSS) par Emu_LoadLX plutot que copie aveuglement, coherent   }
 { avec e32_esp = taille exacte de cet objet (toute la zone se comporte    }
 { comme une pile/donnees non-initialisee). }
 TLXObjPageEntry = Record
  SectorOffset: LongInt;
  SizeBytes   : Word;
  PageFlags   : Word;
 End;

