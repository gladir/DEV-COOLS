  P.CurFg := 7;
  EmuVScr_WriteStr(P, 'Appuyez sur Echap pour fermer.');
  P.CurFg := OldFg;
  P.CurBg := OldBg;
  P.Running := False;
  P.Fault := sfEndProgram;
  P.StatusMsg :=
   'Emulateur ' + CPUName + ' non encore implemente';
