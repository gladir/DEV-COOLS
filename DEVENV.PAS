 Case C Of
  #13: EmuKey_AsciiToScan := $1C;       { Enter }
  #8 : EmuKey_AsciiToScan := $0E;       { Backspace }
  #9 : EmuKey_AsciiToScan := $0F;       { Tab }
  #27: EmuKey_AsciiToScan := $01;       { ESC }
  ' ': EmuKey_AsciiToScan := $39;
  'a','A': EmuKey_AsciiToScan := $1E;
  'b','B': EmuKey_AsciiToScan := $30;
  'c','C': EmuKey_AsciiToScan := $2E;
  'd','D': EmuKey_AsciiToScan := $20;
  'e','E': EmuKey_AsciiToScan := $12;
  'f','F': EmuKey_AsciiToScan := $21;
  'g','G': EmuKey_AsciiToScan := $22;
  'h','H': EmuKey_AsciiToScan := $23;
  'i','I': EmuKey_AsciiToScan := $17;
  'j','J': EmuKey_AsciiToScan := $24;
  'k','K': EmuKey_AsciiToScan := $25;
  'l','L': EmuKey_AsciiToScan := $26;
  'm','M': EmuKey_AsciiToScan := $32;
  'n','N': EmuKey_AsciiToScan := $31;
  'o','O': EmuKey_AsciiToScan := $18;
  'p','P': EmuKey_AsciiToScan := $19;
  'q','Q': EmuKey_AsciiToScan := $10;
  'r','R': EmuKey_AsciiToScan := $13;
  's','S': EmuKey_AsciiToScan := $1F;
  't','T': EmuKey_AsciiToScan := $14;
  'u','U': EmuKey_AsciiToScan := $16;
  'v','V': EmuKey_AsciiToScan := $2F;
  'w','W': EmuKey_AsciiToScan := $11;
  'x','X': EmuKey_AsciiToScan := $2D;
  'y','Y': EmuKey_AsciiToScan := $15;
  'z','Z': EmuKey_AsciiToScan := $2C;
  '0',')': EmuKey_AsciiToScan := $0B;
  '1','!': EmuKey_AsciiToScan := $02;
  '2','@': EmuKey_AsciiToScan := $03;
  '3','#': EmuKey_AsciiToScan := $04;
  '4','$': EmuKey_AsciiToScan := $05;
  '5','%': EmuKey_AsciiToScan := $06;
  '6','^': EmuKey_AsciiToScan := $07;
  '7','&': EmuKey_AsciiToScan := $08;
  '8','*': EmuKey_AsciiToScan := $09;
  '9','(': EmuKey_AsciiToScan := $0A;
 Else
  EmuKey_AsciiToScan := 0;
 End;
End;

{ --- Couleur BGI a partir d un code attribut DOS (0..15) --- }

Function EmuColor(C: Byte): LongInt;
Begin
 { Mapping vers la palette VGA 16 couleurs.
   ATTENTION : l index 0 est globalement remappe (par SetBkColor ET,
   verifie experimentalement le 2026-08-24, par ce backend graphique en
   general - un essai de reserver un "vrai noir" via SetFillStyle+Bar
   pour DrawFilledRect seul a produit un gris a peine distinct du texte,
   pire que le gris fonce (8) actuel - donc PAS uniquement un probleme
   de SetBkColor comme le laissait penser ce commentaire a l origine).
   On redirige 0 vers 8 (gris fonce) partout, sans exception, pour
   conserver un veritable contraste lisible dans la console emulee. }
 If (C And $F) = 0 Then
  EmuColor := 8
 Else
  EmuColor := C And $F;
End;

{ --- Mapper RGB 6 bits (0..63) vers la palette BGI 16 couleurs.
      Approximation par seuil. C est utilise par le rendu graphique
      mode 13h / EGA / VGA en panneau emulateur.                     --- }
Function Emu_VidApprox16(R, G, B: Byte): Byte;
Var Bright, Rb, Gb, Bb: Byte;
    MaxC: Byte;
    Result: Byte;
Begin
 MaxC := R; If G > MaxC Then MaxC := G; If B > MaxC Then MaxC := B;
 If MaxC >= 42 Then Bright := 8 Else Bright := 0;
 If R >= 22 Then Rb := 4 Else Rb := 0;
 If G >= 22 Then Gb := 2 Else Gb := 0;
 If B >= 22 Then Bb := 1 Else Bb := 0;
 Result := Bright Or Rb Or Gb Or Bb;
 { Cas particulier : couleur EGA 6 = brun (R fort, G mid, B faible). }
 If (Result = 6) And (G < 32) And (B < 8) Then Result := 6;
 { Cas brillant pur : eviter de retourner 0 si rien n etait force. }
 If (Result = 0) And ((R Or G Or B) > 0) Then Result := 8;
 Emu_VidApprox16 := Result;
End;

{ --- Couleur BGI a partir d un pixel logique (0..255) selon le mode. --- }
Function Emu_VidPixelToBGI(C: Byte): Byte;
Var Idx: Word;
    R, G, Bv: Byte;
Begin
 If EmuVideo.Mode = $13 Then
  Idx := C
 Else If EmuVideo.IsPlanar Then Begin
  { Mode planar : C = 0..15 -> ACReg[C] -> entree DAC }
  If (C < 16) And (EmuVideo.ACReg[C] < 64) Then
   Idx := EmuVideo.ACReg[C]
  Else
   Idx := C And $0F;
 End
 Else If (EmuVideo.Mode = $04) Or (EmuVideo.Mode = $05) Then Begin
  { CGA 4 couleurs : palette selon CGAColor bit 5 + bit 4. }
  Case C And 3 Of
   0: Idx := EmuVideo.CGAColor And $0F;
   1: If (EmuVideo.CGAColor And $20) <> 0 Then Idx := 11 Else Idx := 10;
   2: If (EmuVideo.CGAColor And $20) <> 0 Then Idx := 13 Else Idx := 12;
   3: If (EmuVideo.CGAColor And $20) <> 0 Then Idx := 15 Else Idx := 14;
  End;
 End
 Else
  Idx := C And $0F;
 If Idx >= 256 Then Idx := 15;
 R := EmuVideo.DAC[Idx*3 + 0];
 G := EmuVideo.DAC[Idx*3 + 1];
 Bv := EmuVideo.DAC[Idx*3 + 2];
 Emu_VidPixelToBGI := Emu_VidApprox16(R, G, Bv);
End;

