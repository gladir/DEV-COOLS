{ --- VOL --- }

Procedure TermCmd_VOL(Var TP: TTerminalPanel; ParamStr: String);
Var
 Idx: Byte;
 DL: Char;
 Lbl: String;
 P: String;
 Explicit: Boolean;
Begin
 P := TermExtractParam(ParamStr, 1);
 { Determiner le lecteur cible : argument explicite, ou lecteur courant }
 Explicit := (Length(P) >= 2) And (P[2] = ':');
 If Explicit Then
  DL := UpCase(P[1])
 Else If TP.VirtDrive >= 0 Then
  DL := Term_DriveLetterFromIdx(TP.VirtDrive)
 Else
  DL := 'C';
 { Lecteur virtuel (A:/B:/C:/D:) : seulement si explicitement demande,
   ou si c est le lecteur courant (sinon "VOL" sans argument sur
   l hote garde son comportement d origine, place de tenue 'C:').
   C:/D: ne comptent comme virtuels que si une image disque dur est
   effectivement montee (sinon C: designe le disque hote reel). }
 If Term_DriveIdxFromLetter(DL, Idx) And
    (Explicit Or (TP.VirtDrive >= 0)) And
    ((Idx < 2) Or EmuFloppyOpen[Idx]) Then Begin
  Term_VirtEnsureMounted(Idx);
  If Not EmuFloppyOpen[Idx] Then Begin
   TermAddLine(TP,
    'Le systeme ne peut pas trouver le lecteur specifie.');
   Exit;
  End;
  If Not FatVol[Idx].Mounted Then Begin
   TermAddLine(TP, ' Volume in drive ' + DL +
    ' has no recognized file system.');
   Exit;
  End;
  Lbl := FatVol[Idx].VolLabel;
  If Lbl = '' Then
   TermAddLine(TP, ' Volume in drive ' + DL + ' has no label.')
  Else
   TermAddLine(TP, ' Volume in drive ' + DL + ' is ' + Lbl);
  TermAddLine(TP, ' Volume Serial Number is 0000-0000');
  Exit;
 End;
 TermAddLine(TP, ' Volume in drive ' + DL + ' has no label.');
 TermAddLine(TP, ' Volume Serial Number is 1234-5678');
End;

{ --- ELFBP (etape 8 : debogueur minimal pour l emulateur Linux ELF64) --- }
{ Regle (ou desactive) un point d arret par adresse : la prochaine fois   }
{ qu un binaire ELF64 est lance dans ce terminal, son execution s arrete  }
{ proprement des que RIP atteint cette adresse, avec un vidage de         }
{ l historique RIP/RSP menant jusque-la - utile pour retracer un          }
{ desequilibre de pile sans avoir a rejouer 2 millions d instructions.    }
Function Elf64_ParseHexQWord(Const S: String): QWord;
Var
 I: Integer;
 Ch: Char;
 V: QWord;
 Digits: String;
Begin
 Digits := S;
 If (Length(Digits) > 1) And (Digits[1] = '0') And (UpCase(Digits[2]) = 'X') Then
  Digits := Copy(Digits, 3, Length(Digits) - 2);
 V := 0;
 For I := 1 To Length(Digits) Do Begin
  Ch := UpCase(Digits[I]);
  V := V Shl 4;
  If (Ch >= '0') And (Ch <= '9') Then V := V + QWord(Ord(Ch) - Ord('0'))
  Else If (Ch >= 'A') And (Ch <= 'F') Then V := V + QWord(Ord(Ch) - Ord('A') + 10);
 End;
 Elf64_ParseHexQWord := V;
End;

Procedure TermCmd_ELFBP(Var TP: TTerminalPanel; ParamStr: String);
Var
 AddrPart, CountPart: String;
Begin
 ParamStr := TermTrim(ParamStr);
 If (ParamStr = '') Or (UpCaseStr(ParamStr) = 'OFF') Then Begin
  ELF64_BreakAddr := 0;
  ELF64_BreakHitTarget := 1;
  TermAddLine(TP, 'Point d''arret ELF64 desactive.');
 End Else Begin
  { Syntaxe : ELFBP <adresse> [n] - n (optionnel, defaut 1) : ne s arrete }
  { qu au n-ieme passage par cette adresse, pas le premier - utile pour   }
  { inspecter l etat des registres a une iteration donnee d une boucle    }
  { profonde plutot que seulement la toute premiere fois.                 }
  AddrPart := TermExtractParam(ParamStr, 1);
  CountPart := TermExtractParam(ParamStr, 2);
  ELF64_BreakAddr := Elf64_ParseHexQWord(AddrPart);
  If CountPart = '' Then ELF64_BreakHitTarget := 1
                    Else ELF64_BreakHitTarget := Elf64_ParseHexQWord(CountPart);
  If ELF64_BreakHitTarget = 0 Then ELF64_BreakHitTarget := 1;
  TermAddLine(TP, 'Point d''arret ELF64 regle a 0x' + HexQWord(ELF64_BreakAddr) +
   ' (passage numero ' + IntToStr(LongInt(ELF64_BreakHitTarget)) +
   ') - prendra effet au prochain programme Linux lance dans ce terminal.');
 End;
End;

{ --- DF (Bash) : afficher les disquettes montees via /DISK0 et /DISK1 --- }

Procedure TermCmd_DF(Var TP: TTerminalPanel);
Var
 Idx: Byte;
 Total, Used, Free: LongInt;
 TotalK, UsedK, FreeK: LongInt;
 UsePct: Integer;
 MountP, Fs, Src: String;
 SizeS, UsedS, FreeS, PctS: String;

 Function PadLeft(S: String; W: Integer): String;
 Begin
  While Length(S) < W Do S := ' ' + S;
  PadLeft := S;
 End;

 Function PadRight(S: String; W: Integer): String;
 Begin
  While Length(S) < W Do S := S + ' ';
  PadRight := S;
 End;

 Function FmtFs(Idx: Byte): String;
 Begin
  If Not FatVol[Idx].Mounted Then FmtFs := 'raw'
  Else If FatVol[Idx].FATType = 12 Then FmtFs := 'vfat12'
  Else If FatVol[Idx].FATType = 16 Then FmtFs := 'vfat16'
  Else FmtFs := 'vfat';
 End;

Begin
 TermAddLine(TP,
  'Filesystem     1K-blocks      Used Available Use% Mounted on');
 If (Not EmuFloppyOpen[0]) And (Not EmuFloppyOpen[1]) And
    (Not EmuFloppyOpen[2]) And (Not EmuFloppyOpen[3]) Then Begin
  TermAddLine(TP,
   '(aucune image montee ; utilisez /DISK0, /DISK1, /DISK80 ou /DISK81)');
  Exit;
 End;
 For Idx := 0 To 3 Do Begin
  If Not EmuFloppyOpen[Idx] Then Continue;
  Term_VirtEnsureMounted(Idx);
  Total := EmuFloppySize[Idx];
  If FatVol[Idx].Mounted Then Begin
   Free := Fat_FreeBytes(Idx);
   { L espace "utile" exclut zones reservees/FAT/root, mais pour rester
     simple on rapporte Total et Free tels que vus par DF. }
   If Free > Total Then Free := Total;
   Used := Total - Free;
  End Else Begin
   Free := 0;
   Used := Total;
  End;
  TotalK := Total Div 1024;
  UsedK  := Used  Div 1024;
  FreeK  := Free  Div 1024;
  If Total > 0 Then
   UsePct := Integer((LongInt(Used) * 100 + Total Div 2) Div Total)
  Else
   UsePct := 0;
  If UsePct < 0 Then UsePct := 0;
  If UsePct > 100 Then UsePct := 100;
  Fs := FmtFs(Idx);
  Src := EmuFloppyName[Idx];
  If Src = '' Then Src := '(image)';
  MountP := '/mnt/' + Chr(Ord('a') + Idx);
  Str(TotalK, SizeS); SizeS := PadLeft(SizeS, 9);
  Str(UsedK, UsedS);  UsedS := PadLeft(UsedS, 9);
  Str(FreeK, FreeS);  FreeS := PadLeft(FreeS, 9);
  Str(UsePct, PctS);  PctS := PadLeft(PctS + '%', 4);
  TermAddLine(TP, PadRight(Fs, 14) + ' ' + SizeS + ' ' +
   UsedS + ' ' + FreeS + ' ' + PctS + ' ' + MountP);
  TermAddLine(TP, '  source: ' + Src);
 End;
End;

{ --- Sauvegarder l historique d affichage dans un fichier --- }

Procedure TermSaveHistory(Var TP: TTerminalPanel);
Var
 F: Text;
 N: PTermLine;
 FName: String;
 IOErr: Word;
Begin
 Case TP.Shell Of
  SK_CMD:        FName := 'terminal-cmd.log';
  SK_POWERSHELL: FName := 'terminal-ps.log';
  SK_BASH:       FName := 'terminal-bash.log';
  SK_AMIGADOS:   FName := 'terminal-amiga.log';
 Else
  FName := 'terminal.log';
 End;
 Assign(F, FName);
 {$I-} Rewrite(F); {$I+}
 IOErr := IOResult;
 If IOErr <> 0 Then Begin
  TermAddLine(TP, 'Erreur : impossible d''ouvrir ' + FName);
  Exit;
 End;
 N := TP.HistHead;
 While N <> Nil Do Begin
  WriteLn(F, N^.S);
  N := N^.Next;
 End;
 Close(F);
 TermAddLine(TP, 'Historique sauve dans ' + FName +
  ' (' + IntToStr(TP.HistCount) + ' lignes)');
End;

{ --- Zoom : agrandir/reduire la hauteur du panneau terminal --- }

Procedure TermZoomCycle;
Var
 ScrH, BottomY, NewH: Integer;
Begin
 ScrH := GetScreenHeight;
 Inc(TermZoomLvl);
 If TermZoomLvl > 2 Then TermZoomLvl := 0;
 Case TermZoomLvl Of
  0: NewH := OUTPUT_HEIGHT;
  1: NewH := OUTPUT_HEIGHT + 80;
  2: NewH := OUTPUT_HEIGHT + 160;
 End;
 BottomY := ScrH - NewH - STATUSBAR_HEIGHT;
 TermY := BottomY;
 TermHeight := NewH;
 FullRepaintNeeded := True;
End;

{ --- Restaurer la hauteur normale du terminal (niveau de zoom 0) --- }

Procedure TermZoomReset;
Var
 ScrH, BottomY: Integer;
Begin
 If TermZoomLvl = 0 Then Exit;
 ScrH := GetScreenHeight;
 TermZoomLvl := 0;
 BottomY := ScrH - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 TermY := BottomY;
 TermHeight := OUTPUT_HEIGHT;
 FullRepaintNeeded := True;
End;

