{ --- Nom du fichier d historique des commandes par shell --- }

Function TermCmdHistFile(Kind: TShellKind): String;
Begin
 Case Kind Of
  SK_CMD:        TermCmdHistFile := 'devenv-cmd.hist';
  SK_POWERSHELL: TermCmdHistFile := 'devenv-ps.hist';
  SK_BASH:       TermCmdHistFile := 'devenv-bash.hist';
  SK_AMIGADOS:   TermCmdHistFile := 'devenv-amiga.hist';
  SK_OS2REXX:    TermCmdHistFile := 'devenv-os2.hist';
 Else
  TermCmdHistFile := 'devenv-term.hist';
 End;
End;

{ --- Charger l historique des commandes depuis le fichier --- }

Procedure TermLoadCmdHistory(Var TP: TTerminalPanel);
Var
 F: Text;
 FName, L: String;
Begin
 FName := TermCmdHistFile(TP.Shell);
 Assign(F, FName);
 {$I-} Reset(F); {$I+}
 If IOResult <> 0 Then Exit;
 While Not Eof(F) Do Begin
  ReadLn(F, L);
  If L = '' Then Continue;
  If TP.NumberHistory >= MAX_TERM_HISTORY Then Begin
   Move(TP.TermHistory[2], TP.TermHistory[1],
    (MAX_TERM_HISTORY - 1) * SizeOf(TP.TermHistory[1]));
   TP.TermHistory[MAX_TERM_HISTORY] := L;
  End Else Begin
   Inc(TP.NumberHistory);
   TP.TermHistory[TP.NumberHistory] := L;
  End;
 End;
 Close(F);
 TP.HistoryPos := TP.NumberHistory + 1;
End;

{ --- Sauvegarder l historique des commandes dans le fichier --- }

Procedure TermSaveCmdHistory(Var TP: TTerminalPanel);
Var
 F: Text;
 FName: String;
 I: Integer;
Begin
 FName := TermCmdHistFile(TP.Shell);
 Assign(F, FName);
 {$I-} Rewrite(F); {$I+}
 If IOResult <> 0 Then Exit;
 For I := 1 To TP.NumberHistory Do
  WriteLn(F, TP.TermHistory[I]);
 Close(F);
End;

{ --- Initialiser un terminal (buffer seulement, pas le layout) --- }

Procedure InitTerminalPanel(Var TP: TTerminalPanel;
 Kind: TShellKind);
Var
 I: Integer;
Begin
 For I := 0 To MAX_TERM_LINES - 1 Do
  TP.Lines[I] := '';
 TP.LineCount := 0;
 TP.ScrollTop := 0;
 TP.HistHead := Nil;
 TP.HistTail := Nil;
 TP.HistCount := 0;
 TP.ScrollOffset := 0;
 TP.HScrollOffset := 0;
 TP.InputLine := '';
 TP.InputCol := 1;
 TP.PartialLine := '';
 TP.X := 0;
 TP.Y := 0;
 TP.Width := 0;
 TP.Height := 0;
 TP.Visible := False;
 TP.NeedRepaint := True;
 TP.Shell := Kind;
 TP.Echo := True;
 TP.NumberHistory := 0;
 TP.HistoryPos := 0;
 TP.NumberDirStack := 0;
 { Si un disque dur est monte et reconnu (FAT12/16/32), le terminal
   demarre directement sur ce lecteur (C:), comme un DOS reel
   demarrant sur son disque dur. Sinon, mode hote standard. }
 If EmuFloppyOpen[2] And FatVol[2].Mounted Then
  TP.VirtDrive := 2
 Else
  TP.VirtDrive := -1;
 TP.VirtCwd   := '\';
 TermLoadCmdHistory(TP);
End;

{ --- Initialiser le conteneur des deux terminaux --- }

Procedure InitTerminals;
Var
 ScrW, ScrH, BottomY: Integer;
 NCCwd: String;
Begin
 ScrW := GetScreenWidth;
 ScrH := GetScreenHeight;
 BottomY := ScrH - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 TermX := 0;
 TermY := BottomY;
 TermWidth := ScrW - EXPLORER_WIDTH;
 TermHeight := OUTPUT_HEIGHT;
 TermZoomLvl := 0;
 TermVisible := False;
 TermSelectOpen := False;
 TermSelectIdx := 1;
 TerminalOnTop := True;
 TerminalHasFocus := False;
 ExplorerHasFocus := False;
 ActiveShell := SK_POWERSHELL;
 { -1 = pas d amorcage BOOT en attente. CRITIQUE : 0 est un index de       }
 { lecteur virtuel VALIDE (A:), donc laisser ce global a sa valeur par     }
 { defaut Pascal (0) armerait a tort un amorcage sur A: au tout premier    }
 { lancement d un emulateur -CD, avant meme qu aucune commande BOOT n ait  }
 { jamais ete tapee - voir Emu_LoadBootSector/CreateEmulatorBootTab. }
 EmuBootFromDrive := -1;
 InitTerminalPanel(TermPanels[SK_CMD], SK_CMD);
 InitTerminalPanel(TermPanels[SK_POWERSHELL], SK_POWERSHELL);
 InitTerminalPanel(TermPanels[SK_BASH], SK_BASH);
 InitTerminalPanel(TermPanels[SK_AMIGADOS], SK_AMIGADOS);
 InitTerminalPanel(TermPanels[SK_NCOMMANDER], SK_NCOMMANDER);
 InitTerminalPanel(TermPanels[SK_OS2REXX], SK_OS2REXX);
 { Comme l original sur DOS reel (et comme les 4 autres shells de ce      }
 { panneau) : demarrer sur le repertoire courant de la machine hote,           }
 { lettre de lecteur incluse (ex: C:\SOURCE\GITHUB\DEV-COOLS), pas sur           }
 { une disquette virtuelle isolee - bien plus utile au quotidien. }
 GetDir(0, NCCwd);
 NCState.Active := 0;
 NCState.Slot := -1;
 NCState.PaneSlot[0] := -1;
 NCState.PaneSlot[1] := -1;
 NCState.TreeForCopy := False;
 NCState.Mode := ncBrowse;
 NCState.Initialized := False;
 NCState.PromptBuf := '';
 NCState.Panes[0].Path := NCCwd;
 NCState.Panes[0].Count := 0;
 NCState.Panes[0].Cursor := 0;
 NCState.Panes[0].ScrollTop := 0;
 NCState.Panes[0].MarkCount := 0;
 NCState.Panes[1].Path := NCCwd;
 NCState.Panes[1].Count := 0;
 NCState.Panes[1].Cursor := 0;
 NCState.Panes[1].ScrollTop := 0;
 NCState.Panes[1].MarkCount := 0;
End;

