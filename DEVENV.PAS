    ModRM := Emu_FetchByte(P.CPU, 1);
    Emu_DecodeModRM(P.CPU, ModRM, Op);
    Emu_SetReg16(P.CPU, (ModRM Shr 3) And 7,
     Emu_ReadWord(P.CPU, Op.Seg, Word(Op.Ofs)));
