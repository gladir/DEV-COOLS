  E3_LowerROM    : Integer;
  E3_LowerRAM    : Integer;
  E3P_SlotIsRAM  : Array[0..3] Of Boolean;
  E3P_SlotBank   : Array[0..3] Of Integer;
  SC_RAM         : Array[0..6143] Of Byte;
  SC_BIOS        : Array[0..2047] Of Byte;
  SC_Cfg         : Byte;
  SC_WrEn        : Boolean;
  SWACNT, SWBCNT : Byte;
  SWACHA_Out, SWCHB_Out : Byte;
  TimerVal       : Integer;
