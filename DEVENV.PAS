{ --- Verifier si la barre d etat est vide (defaut) --- }

Function IsStatusBarEmpty(Var SB: TStatusBar): Boolean;
Begin
 IsStatusBarEmpty := (SB.FileName = '') And
  (SB.Language = '') And (SB.CursorLine = 1) And
  (SB.CursorCol = 1);
End;


