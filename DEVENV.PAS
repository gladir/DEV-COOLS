   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur Java non trouve (JAVACW32/JAVAC86).',
    Ord(OTK_BUILD));
   Exit;
  End;
 End
 Else If (Ext = '.jpp') Then Begin
  { EXTENSION (2026-08-02) : Compilation MS J++ -> JPPCW32.exe, demande     }
  { explicite de l utilisateur ("quand F5 est utilise sur un .jpp, il         }
  { devrait lancer JPPCW32"). Un SEUL compilateur existe pour J++ (Win32       }
  { PE, aucun equivalent DOS 8086) - MEME pattern simple que .bas/.vb           }
  { (FindCompiler direct) plutot que le pattern Contexte a deux variantes         }
  { de .java/.c/.ada/.abap/.awk/.psp/.python. L execution du .exe produit        }
  { est geree par le bloc COMMUN en fin de fonction (ExitCode=0 ->                }
  { "Execution de ExeName..."), MEME discipline que .java/.psp/.c - PAS          }
  { de duplication de cette logique ICI. }
  CmdLine := FindCompiler('JPPCW32');
  If CmdLine = '' Then Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur J++ non trouve (JPPCW32.exe).',
    Ord(OTK_BUILD));
   Exit;
  End;
  CmdLine := CmdLine + ' ' + SourceFile;
  AppendOutput(OutputPanel,
   '------ Build started: ' + SourceFile + ' ------',
   Ord(OTK_BUILD));
  AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
  ExitCode := ExecuteCompiler(CmdLine, TempFile);
  ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
  CleanupTempFile(TempFile);
 End
 Else If (Ext = '.jsp') Then Begin
  { EXTENSION (2026-08-02) : Compilation JSP -> JSPCW32.exe, demande        }
  { explicite de l utilisateur ("quand F5 est utilise sur un .jsp, il          }
  { devrait lancer JSPCW32"). Un SEUL compilateur existe pour JSP (Win32       }
  { PE, aucun equivalent DOS 8086) - MEME pattern simple que .jpp/.bas/.vb        }
  { (FindCompiler direct). L execution du .exe produit est geree par le          }
  { bloc COMMUN en fin de fonction (ExitCode=0 -> "Execution de                     }
  { ExeName..."), MEME discipline que .jpp/.java/.psp/.c - PAS de                    }
  { duplication de cette logique ICI. }
  CmdLine := FindCompiler('JSPCW32');
  If CmdLine = '' Then Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur JSP non trouve (JSPCW32.exe).',
    Ord(OTK_BUILD));
   Exit;
  End;
  CmdLine := CmdLine + ' ' + SourceFile;
  AppendOutput(OutputPanel,
   '------ Build started: ' + SourceFile + ' ------',
   Ord(OTK_BUILD));
  AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
  ExitCode := ExecuteCompiler(CmdLine, TempFile);
  ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
  CleanupTempFile(TempFile);
 End
 Else If (Ext = '.py') Then Begin
  { Compilation Python }
  DetectPythonCompiler(PythonContext);
  If PythonContext.CompilerFound Then Begin
   CmdLine := PythonContext.CompilerPath + ' ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine,
    Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur Python non trouve (PYTHCW32/PYTHON86).',
    Ord(OTK_BUILD));
   Exit;
  End;
 End
 Else Begin
  AppendOutput(OutputPanel,
   'Erreur : type de fichier non supporte (' + Ext + ').',
   Ord(OTK_BUILD));
  Exit;
 End;
 { Afficher le resultat }
 If ExitCode = 0 Then Begin
  AppendOutput(OutputPanel,
   '========== Build: 1 succeeded, 0 failed ==========',
   Ord(OTK_BUILD));
  { Pour les cibles non-Windows, l emulateur integre s en charge :
    on n essaie PAS d executer le binaire DOS/68k/6502/... avec
    Exec() sous Windows, ce qui afficherait un popup d erreur. }
  If SolutionLoaded And (CurrentProject.Info.TargetCPU <> '')
     And (CurrentProject.Info.TargetCPU <> '-CW32')
     And (CurrentProject.Info.TargetCPU <> '-CW') Then Begin
   AppendOutput(OutputPanel,
    'Cible ' + CurrentProject.Info.TargetCPU +
    ' : execution via emulateur integre (pas d exec systeme).',
    Ord(OTK_BUILD));
  End Else Begin
   { Lancer l executable }
   AppendOutput(OutputPanel, 'Execution de ' + ExeName + '...',
    Ord(OTK_BUILD));
   ClearOutput(OutputPanel, Ord(OTK_DEBUG));
   ExitCode := ExecuteCompiler(ExeName, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_DEBUG));
   CleanupTempFile(TempFile);
   SetActiveOutputTab(OutputPanel, OTK_DEBUG);
  End;
 End Else Begin
  AppendOutput(OutputPanel,
   '========== Build: 0 succeeded, 1 failed ==========',
   Ord(OTK_BUILD));
 End;
End;

