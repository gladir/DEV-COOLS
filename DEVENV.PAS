 End;
 If TP.VirtDrive >= 0 Then Begin
  TermAddLine(TP, 'OS2 : disque virtuel non supporte, utiliser un ' +
   'chemin du systeme hote.');
  Exit;
 End;
 If TP.Shell = SK_NCOMMANDER Then Dir := TP.VirtCwd Else GetDir(0, Dir);
 ExePath := TermFindRomByExt(Dir, CurrParam, 'EXE');
 If ExePath = '' Then Begin
  TermAddLine(TP, 'Le systeme ne trouve pas le fichier specifie.');
  Exit;
 End;
 CreateEmulatorTab(ExePath, '-COS2LX', '');
End;

{ --- ELFBP (etape 8 : debogueur minimal pour l emulateur Linux ELF64) --- }
{ Regle (ou desactive) un point d arret par adresse : la prochaine fois   }
{ qu un binaire ELF64 est lance dans ce terminal, son execution s arrete  }
{ proprement des que RIP atteint cette adresse, avec un vidage de         }
{ l historique RIP/RSP menant jusque-la - utile pour retracer un          }
{ desequilibre de pile sans avoir a rejouer 2 millions d instructions.    }
Function Elf64_ParseHexQWord(Const S: String): QWord;
Var
 I: Integer;
 Ch: Char;
 V: QWord;
 Digits: String;
Begin
 Digits := S;
 If (Length(Digits) > 1) And (Digits[1] = '0') And (UpCase(Digits[2]) = 'X') Then
  Digits := Copy(Digits, 3, Length(Digits) - 2);
 V := 0;
 For I := 1 To Length(Digits) Do Begin
  Ch := UpCase(Digits[I]);
  V := V Shl 4;
  If (Ch >= '0') And (Ch <= '9') Then V := V + QWord(Ord(Ch) - Ord('0'))
  Else If (Ch >= 'A') And (Ch <= 'F') Then V := V + QWord(Ord(Ch) - Ord('A') + 10);
 End;
 Elf64_ParseHexQWord := V;
End;

Procedure TermCmd_ELFBP(Var TP: TTerminalPanel; ParamStr: String);
Var
 AddrPart, CountPart: String;
Begin
 ParamStr := TermTrim(ParamStr);
 If (ParamStr = '') Or (UpCaseStr(ParamStr) = 'OFF') Then Begin
  ELF64_BreakAddr := 0;
  ELF64_BreakHitTarget := 1;
  TermAddLine(TP, 'Point d''arret ELF64 desactive.');
 End Else Begin
  { Syntaxe : ELFBP <adresse> [n] - n (optionnel, defaut 1) : ne s arrete }
  { qu au n-ieme passage par cette adresse, pas le premier - utile pour   }
  { inspecter l etat des registres a une iteration donnee d une boucle    }
  { profonde plutot que seulement la toute premiere fois.                 }
  AddrPart := TermExtractParam(ParamStr, 1);
  CountPart := TermExtractParam(ParamStr, 2);
  ELF64_BreakAddr := Elf64_ParseHexQWord(AddrPart);
  If CountPart = '' Then ELF64_BreakHitTarget := 1
                    Else ELF64_BreakHitTarget := Elf64_ParseHexQWord(CountPart);
  If ELF64_BreakHitTarget = 0 Then ELF64_BreakHitTarget := 1;
  TermAddLine(TP, 'Point d''arret ELF64 regle a 0x' + HexQWord(ELF64_BreakAddr) +
   ' (passage numero ' + IntToStr(LongInt(ELF64_BreakHitTarget)) +
   ') - prendra effet au prochain programme Linux lance dans ce terminal.');
 End;
End;

{ --- LXINFO (chantier OS/2 LX, Stage 1) : outil de diagnostic pur - lit et }
{ affiche l en-tete/table des objets/modules importes d un executable OS/2 }
{ LX, SANS le charger en memoire ni tenter de l executer. Sert a verifier   }
{ le format sur de vrais fichiers avant d ecrire le chargeur complet        }
{ (Emu_LoadLX, etapes suivantes) - accepte un CHEMIN HOTE direct (typiquement}
{ un fichier deja extrait via HPFS_ExtractToTempFile/Fat_ExtractToTempFile).}
Function Lx_ReadHeader(Const Path: String; Var Hdr: TLXHeader;
 Var HdrOfs, FSize: LongInt): Boolean;
Var
 F: File;
 Sig: Array[0..1] Of Char;
 LfanewBuf: Array[0..3] Of Byte;
 HdrSig: Array[0..1] Of Char;
 BytesRead: Word;
Begin
 Lx_ReadHeader := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FSize := FileSize(F);
 If FSize < 64 Then Begin Close(F); Exit; End;
 BlockRead(F, Sig, 2, BytesRead);
 If (BytesRead <> 2) Or (Sig[0] <> 'M') Or (Sig[1] <> 'Z') Then Begin
  Close(F); Exit;
 End;
 Seek(F, $3C);
 BlockRead(F, LfanewBuf, 4, BytesRead);
 If BytesRead <> 4 Then Begin Close(F); Exit; End;
 HdrOfs := LongInt(LfanewBuf[0]) Or (LongInt(LfanewBuf[1]) Shl 8) Or
  (LongInt(LfanewBuf[2]) Shl 16) Or (LongInt(LfanewBuf[3]) Shl 24);
 If (HdrOfs <= 0) Or (HdrOfs + 2 > FSize) Then Begin Close(F); Exit; End;
 Seek(F, HdrOfs);
 BlockRead(F, HdrSig, 2, BytesRead);
 If (BytesRead <> 2) Or (HdrSig[0] <> 'L') Or
    ((HdrSig[1] <> 'X') And (HdrSig[1] <> 'E')) Then Begin
  Close(F); Exit;
 End;
 Seek(F, HdrOfs);
 FillChar(Hdr, SizeOf(Hdr), 0);
 BlockRead(F, Hdr, SizeOf(Hdr), BytesRead);
 Close(F);
 Lx_ReadHeader := BytesRead = SizeOf(Hdr);
End;

{ Chantier Windows 16 bits (2026-08-25), Stage 1 : meme discipline exacte  }
{ que Lx_ReadHeader ci-dessus (MZ -> e_lfanew -> signature secondaire),    }
{ juste une signature differente ('N','E' au lieu de 'L','X'/'L','E'). }
Function Win16_ReadHeader(Const Path: String; Var Hdr: TNEHeader;
 Var HdrOfs, FSize: LongInt): Boolean;
Var
 F: File;
 Sig: Array[0..1] Of Char;
 LfanewBuf: Array[0..3] Of Byte;
 HdrSig: Array[0..1] Of Char;
 BytesRead: Word;
Begin
 Win16_ReadHeader := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FSize := FileSize(F);
 If FSize < 64 Then Begin Close(F); Exit; End;
 BlockRead(F, Sig, 2, BytesRead);
 If (BytesRead <> 2) Or (Sig[0] <> 'M') Or (Sig[1] <> 'Z') Then Begin
  Close(F); Exit;
 End;
 Seek(F, $3C);
 BlockRead(F, LfanewBuf, 4, BytesRead);
 If BytesRead <> 4 Then Begin Close(F); Exit; End;
 HdrOfs := LongInt(LfanewBuf[0]) Or (LongInt(LfanewBuf[1]) Shl 8) Or
  (LongInt(LfanewBuf[2]) Shl 16) Or (LongInt(LfanewBuf[3]) Shl 24);
 If (HdrOfs <= 0) Or (HdrOfs + 2 > FSize) Then Begin Close(F); Exit; End;
 Seek(F, HdrOfs);
 BlockRead(F, HdrSig, 2, BytesRead);
 If (BytesRead <> 2) Or (HdrSig[0] <> 'N') Or (HdrSig[1] <> 'E') Then Begin
  Close(F); Exit;
 End;
 Seek(F, HdrOfs);
 FillChar(Hdr, SizeOf(Hdr), 0);
 BlockRead(F, Hdr, SizeOf(Hdr), BytesRead);
 Close(F);
 Win16_ReadHeader := BytesRead = SizeOf(Hdr);
End;

Function Win16_SegFlagsStr(F: Word): String;
Var S: String;
Begin
 If (F And 1) <> 0 Then S := 'DONNEES' Else S := 'CODE';
 If (F And 4) <> 0 Then S := S + ' ITERE';
 If (F And $10) <> 0 Then S := S + ' DEPLACABLE';
 If (F And $20) <> 0 Then S := S + ' PARTAGEABLE';
 If (F And $40) <> 0 Then S := S + ' PRECHARGE';
 If (F And $80) <> 0 Then S := S + ' LECTURE-SEULE';
 If (F And $100) <> 0 Then S := S + ' RELOGEMENTS';
 If (F And $1000) <> 0 Then S := S + ' DISCARDABLE';
 Win16_SegFlagsStr := S;
End;

{ Chantier Windows 16 bits, Stage 2 : Win16_LoadNE ecrit directement dans   }
{ TEmuCPU.Memory (le MEME coeur 8086 que le backend DOS -CD, voir le        }
{ contexte du plan) via les aides Emu_* deja existantes - mais celles-ci    }
{ ne sont definies que beaucoup plus loin dans ce fichier (~ligne 50600+,   }
{ section emulateur 8086). Forward necessaire, meme motif deja etabli pour  }
{ Dpmi_GetReg8/16/32 reutilise par le chantier OS/2 LX. }
Procedure Emu_InitComputer(Var C: TEmuCPU); Forward;
Procedure Emu_Done(Var C: TEmuCPU); Forward;
Function Emu_ReadByte(Var C: TEmuCPU; Seg, Ofs: Word): Byte; Forward;
Procedure Emu_WriteByte(Var C: TEmuCPU; Seg, Ofs: Word; X: Byte); Forward;
Procedure Emu_WriteWord(Var C: TEmuCPU; Seg, Ofs, X: Word); Forward;
Procedure Emu_PushWord(Var C: TEmuCPU; Value: Word); Forward;
Function Emu_PopWord(Var C: TEmuCPU): Word; Forward;
{ Emu_ReadWord et Emu_StepOne ont deja un Forward plus haut (~ligne 10539/ }
{ 10557) - pas la peine de le repeter ici (FPC refuse un Forward en double)}

{ Resout (ou reutilise) un emplacement de trappe pour la paire             }
{ (ModIdx, IsOrdinal, Value=ordinal-ou-offset-de-nom) - memes principes    }
{ exacts que Lx_ResolveImportSlot pour OS/2 LX, transpose en mode reel :   }
{ thunk de 5 octets CD F8 (INT F8h, prive/synthetique - AUCUN rapport avec }
{ une convention DOS/Windows reelle) + index de slot (2 octets, lu par le  }
{ futur Win16_DispatchCall du Stage 3) + CB (RETF, filet de securite si    }
{ jamais atteint sans passer par l interception - pas encore cablee a ce   }
{ stade du chargeur, voir Stage 3). }
Function Win16_ResolveImportSlot(Var C: TEmuCPU; ModIdx: Word;
 IsOrdinal: Boolean; Value: Word): Integer;
Var
 I, Slot: Integer;
 ThunkOfs: Word;
Begin
 For I := 0 To Win16_ImportSlotCount - 1 Do
  If (Win16_ImportModIdx[I] = ModIdx) And (Win16_ImportIsOrd[I] = IsOrdinal) And
     (Win16_ImportValue[I] = Value) Then Begin
   Win16_ResolveImportSlot := I;
   Exit;
  End;
 If Win16_ImportSlotCount >= WIN16_MAX_TRAP_SLOTS Then Begin
  Win16_ResolveImportSlot := -1; { plein - l appelant doit ignorer ce relogement }
  Exit;
 End;
 Slot := Win16_ImportSlotCount;
 Win16_ImportModIdx[Slot] := ModIdx;
 Win16_ImportIsOrd[Slot] := IsOrdinal;
 Win16_ImportValue[Slot] := Value;
 Inc(Win16_ImportSlotCount);
 ThunkOfs := Word(Slot * WIN16_TRAP_SLOT_SIZE);
 Emu_WriteByte(C, Win16_TrapSeg, ThunkOfs,          $CD);
 Emu_WriteByte(C, Win16_TrapSeg, Word(ThunkOfs + 1), $F8);
 Emu_WriteByte(C, Win16_TrapSeg, Word(ThunkOfs + 2), Byte(Slot And $FF));
 Emu_WriteByte(C, Win16_TrapSeg, Word(ThunkOfs + 3), Byte((Slot Shr 8) And $FF));
 Emu_WriteByte(C, Win16_TrapSeg, Word(ThunkOfs + 4), $CB);
 Win16_ResolveImportSlot := Slot;
End;

{ Resout l'ordinal N de la table d'entree NE (ne_enttab) vers un couple    }
{ (numero de segment NE 1-based, offset) - format "bundles" verifie        }
{ EMPIRIQUEMENT sur le vrai CLOCK.EXE (script Perl autonome,               }
{ ne_enttab_probe.pl, scratchpad) : ordinal=1 ("ABOUT" d'apres la table    }
{ des noms residents) -> segnum=1 offset=$0010, ordinal=2                  }
{ ("CLOCKWNDPROC") -> segnum=1 offset=$0046 - tous deux dans le segment    }
{ de CODE (#1), coherent avec des procedures. Format bundle : [Count:Byte] }
{ [Type:Byte] puis Count entrees de 6 octets (Type=$FF, MOVEABLE :         }
{ [Flags][$CD][$3F][SegNum][Offset:Word] - le "$CD $3F" est un vrai INT 3Fh}
{ documente, jamais execute ici, juste un marqueur reconnu tel quel) ou 3  }
{ octets (Type=1..$FE=FIXED, SegNum=Type : [Flags][Offset:Word]) ;         }
{ Count=0 termine la table ; Type=0 = bundle "inutilise", saute Count      }
{ ordinaux SANS aucune entree (verifie : 1 octet consomme pour tout un     }
{ bundle Type=0, quel que soit Count). }
Function Win16_ResolveEntryOrdinal(Const Hdr: TNEHeader; HdrOfs: LongInt;
 Const Path: String; Ordinal: Word; Var SegNum: Word; Var Ofs: Word): Boolean;
Var
 F: File;
 BytesRead: Word;
 Pos, EndPos: LongInt;
 Count, EType: Byte;
 Cur: Word;
 Flags, IntOp, IntArg, SN: Byte;
 OF16: Word;
 I: Integer;
Begin
 Win16_ResolveEntryOrdinal := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 Pos := HdrOfs + Hdr.ne_enttab;
 EndPos := Pos + Hdr.ne_cbenttab;
 Cur := 1;
 While Pos < EndPos Do Begin
  Seek(F, Pos);
  BlockRead(F, Count, 1, BytesRead); Inc(Pos);
  BlockRead(F, EType, 1, BytesRead); Inc(Pos);
  If (BytesRead <> 1) Or (Count = 0) Then Break;
  Seek(F, Pos);
  If EType = 0 Then Begin
   Cur := Word(Cur + Count);
  End Else If EType = $FF Then Begin
   For I := 1 To Count Do Begin
    BlockRead(F, Flags, 1, BytesRead);
    BlockRead(F, IntOp, 1, BytesRead);
    BlockRead(F, IntArg, 1, BytesRead);
    BlockRead(F, SN, 1, BytesRead);
    BlockRead(F, OF16, 2, BytesRead);
    Pos := Pos + 6;
    If Cur = Ordinal Then Begin
     SegNum := SN; Ofs := OF16;
     Close(F);
     Win16_ResolveEntryOrdinal := True;
     Exit;
    End;
    Cur := Word(Cur + 1);
   End;
  End Else Begin
   For I := 1 To Count Do Begin
    BlockRead(F, Flags, 1, BytesRead);
    BlockRead(F, OF16, 2, BytesRead);
    Pos := Pos + 3;
    If Cur = Ordinal Then Begin
     SegNum := EType; Ofs := OF16;
     Close(F);
     Win16_ResolveEntryOrdinal := True;
     Exit;
    End;
    Cur := Word(Cur + 1);
   End;
  End;
 End;
 Close(F);
End;

{ Chargeur reel Stage 2 : ecrit chaque segment NE dans C.Memory^ (le meme  }
{ buffer 8086 EXISTANT, PAS un nouveau tampon global type LX_Mem/ELF64 -   }
{ voir le contexte du plan pour pourquoi Windows 16 bits, contrairement a  }
{ OS/2 LX/ELF64, peut reutiliser tel quel le coeur reel-mode existant),    }
{ applique les relogements intra-segment (INTERNALREF, y compris via      }
{ ordinal de table d'entree pour les segments "moveable") et inter-module  }
{ (IMPORTORDINAL/IMPORTNAME, vers un thunk Win16_ResolveImportSlot - la    }
{ VRAIE interception CD F8 est cablee au Stage 3, absente ici). Portee     }
{ assumee et documentee (voir le plan) : segments TOUS charges en FIXE     }
{ (jamais deplaces), relogements ADDITIVE ou en LISTE DE SOURCES ignores   }
{ proprement (meme discipline que Lx_ApplyPageFixups pour OS/2 LX - un     }
{ format non gere saute CE relogement precis, jamais toute la routine).    }
{ Format des enregistrements de relogement (non-additif, non-liste)        }
{ VERIFIE EMPIRIQUEMENT sur CLOCK.EXE/CALENDAR.EXE reels (script Perl      }
{ autonome, ne_reloc_probe.pl, scratchpad) : [SrcType:Byte][Flags:Byte]    }
{ [OffsetCible:Word] puis selon (Flags and 3) : 0=INTERNALREF              }
{ ([SegNum:Byte][Reserve:Byte][Offset-ou-OrdinalEntree:Word], SegNum=$FF   }
{ -> ordinal de table d'entree) ; 1=IMPORTORDINAL ([ModIdx:Word]           }
{ [Ordinal:Word]) ; 2=IMPORTNAME ([ModIdx:Word][OffsetNom:Word]) ;         }
{ 3=OSFIXUP (hors de portee, ignore). SrcType determine la LARGEUR/nature  }
{ de la valeur a ecrire a OffsetCible : 0=LOBYTE(1o) 2=SEGMENT(2o)         }
{ 3=FARPTR(4o: offset puis segment) 5=OFFSET(2o) - 7/11 (32/48 bits, hors  }
{ de portee pour du Windows 2.x reel-mode standard) ignores proprement. }
Function Win16_LoadNE(Var C: TEmuCPU; Const Path: String): Boolean;
Var
 Hdr: TNEHeader;
 HdrOfs, FSize: LongInt;
 F: File;
 Seg: TNESegment;
 I, J: Integer;
 BytesRead: Word;
 RealSegBase: Word;
 FileOfs: LongInt;
 RealLen: Word;
 RelocPos: LongInt;
 RelocCount: Word;
 BssI: Word;
 Rec: Array[0..7] Of Byte;
 SrcType, FlagByte, TargetType, SegNum: Byte;
 Additive, IsList, Ok: Boolean;
 TargetOfs, ModIdx, Ordinal, NameOfs: Word;
 EntrySeg, EntryOfs: Word;
 Slot: Integer;
 ResolvedSeg, ResolvedOfs: Word;
 SegBuf: Array[0..65535] Of Byte;
 SegBufLen: Word;
 AutoDataMinAlloc, AutoDataLimit: Word;
 LongTmp: LongInt;
 ChainOfs, ChainNext: Word;
 ChainGuard: Integer;
Begin
 AutoDataMinAlloc := 0;
 AutoDataLimit := 0;
 Win16_LoadNE := False;
 Win16_LastError := '';
 If Not Win16_ReadHeader(Path, Hdr, HdrOfs, FSize) Then Begin
  Win16_LastError := 'en-tete NE illisible';
  Exit;
 End;
 If (Hdr.ne_cseg <= 0) Or (Hdr.ne_cseg > WIN16_MAX_SEGS) Then Begin
  Win16_LastError := 'nombre de segments hors limites';
  Exit;
 End;
 { Un seul programme Win16 charge a la fois (etat global Win16_*) - meme   }
 { limitation assumee et documentee que LX_Mem/ELF64 pour les chantiers    }
 { precedents. }
 Win16_SegCount := Hdr.ne_cseg;
 Win16_ImportSlotCount := 0;
 { Chantier Stage 6 : classes/fenetres/file de messages remises a zero a   }
 { chaque chargement (meme discipline que Win16_ImportSlotCount ci-dessus)}
 Win16_WndClassCount := 0;
 Win16_WindowCount := 0;
 Win16_NextHWnd := 1;
 Win16_MsgQueueHead := 0;
 Win16_MsgQueueTail := 0;
 Win16_MsgQueueCount := 0;
 Win16_TimerCount := 0;
 Win16_ActiveDCWindow := -1;
 Win16_PenX := 0;
 Win16_PenY := 0;
 Win16_DefWindowProcPaintCount := 0;
 Win16_BeginPaintCount := 0;
 Win16_WndProcTraceOn := False;
 Win16_WndProcTraceDone := False;
 Win16_GdiTraceOn := False;
 Win16_GdiTraceCount := 0;
 Win16_GdiTraceMax := 80;
 Win16_CurrentROP2 := 13; { R2_COPYPEN, defaut reel d'un DC neuf }
 Win16_NextFreeSeg := $1000;
 { Reserve un bloc pour les thunks d'import AVANT tout segment programme,  }
 { pour qu'aucun segment reel ne puisse jamais y empieter. }
 Win16_TrapSeg := Win16_NextFreeSeg;
 Win16_NextFreeSeg := Win16_NextFreeSeg +
  Word(((WIN16_MAX_TRAP_SLOTS * WIN16_TRAP_SLOT_SIZE) + 15) Shr 4);

 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Begin
  Win16_LastError := 'fichier illisible pour le chargement des segments';
  Exit;
 End;

 { Passe 1 : allouer un segment reel pour chaque segment NE et copier ses  }
 { octets bruts. BOGUE REEL trouve au Stage 5 (2026-08-29, via WIN16RUN    }
 { sur un vrai CLOCK.EXE - voir project_devenv_win16.md) : la queue d'un   }
 { segment au-dela de Seg.DataLength (BSS - variables statiques SANS       }
 { valeur initiale dans le fichier, ex. DataOffsetSectors=0 = BSS pur) doit}
 { TOUJOURS etre mise a zero par un vrai chargeur NE - laisser cette zone  }
 { au filler $F6 d'Emu_InitComputer (comme le faisait ce code avant ce     }
 { correctif) fait lire au programme une valeur ARBITRAIRE la ou il        }
 { s'attend a un pointeur/compteur nul, ce qui a concretement fait sauter  }
 { CLOCK.EXE dans de la memoire non initialisee ($F6F6:$F6F6, division par }
 { zero) apres seulement 35 instructions - pas une limite du CPU emule,    }
 { un vrai oubli de chargeur. }
 For I := 1 To Hdr.ne_cseg Do Begin
  Seek(F, HdrOfs + Hdr.ne_segtab + (I - 1) * 8);
  BlockRead(F, Seg, SizeOf(Seg), BytesRead);
  If BytesRead <> SizeOf(Seg) Then Begin
   Win16_LastError := 'table des segments tronquee';
   Close(F);
   Exit;
  End;
  RealSegBase := Win16_NextFreeSeg;
  Win16_SegBase[I] := RealSegBase;
  RealLen := Seg.MinAlloc;
  If RealLen = 0 Then RealLen := $FFFF;
  { BOGUE REEL trouve au Stage 5 (2026-08-29) : InitHeapSize (Hdr.ne_heap)  }
  { est un tas AJOUTE PAR-DESSUS le segment de donnees automatique par un   }
  { vrai chargeur NE (confirme - le champ documente "size in bytes of      }
  { dynamic heap added to the data segment"), PAS deja inclus dans         }
  { Seg.MinAlloc. Sans cette reserve, le segment suivant (alloue juste     }
  { apres par ce meme allocateur bump) commencerait a l'INTERIEUR de       }
  { l'espace theorique du tas local - un futur LocalAlloc (ou meme SP=0,   }
  { voir plus bas) ecrirait alors dans la memoire d'un AUTRE segment. }
  If I = Hdr.ne_autodata Then Begin
   AutoDataMinAlloc := RealLen;
   LongTmp := LongInt(RealLen) + Hdr.ne_heap;
   If LongTmp > $FFFF Then LongTmp := $FFFF;
   RealLen := Word(LongTmp);
   AutoDataLimit := RealLen;
  End;
  Win16_NextFreeSeg := Win16_NextFreeSeg + Word((LongInt(RealLen) + 15) Shr 4);
  If Seg.DataOffsetSectors <> 0 Then Begin
   FileOfs := LongInt(Seg.DataOffsetSectors) Shl Hdr.ne_align;
   SegBufLen := Seg.DataLength;
   If SegBufLen = 0 Then SegBufLen := $FFFF;
   Seek(F, FileOfs);
   BlockRead(F, SegBuf, SegBufLen, BytesRead);
   If BytesRead <> SegBufLen Then Begin
    Win16_LastError := 'donnees de segment #' + IntToStr(I) + ' tronquees';
    Close(F);
    Exit;
   End;
   For J := 0 To SegBufLen - 1 Do
    Emu_WriteByte(C, RealSegBase, Word(J), SegBuf[J]);
   For BssI := SegBufLen To RealLen - 1 Do
    Emu_WriteByte(C, RealSegBase, BssI, 0);
  End Else Begin
   { Segment BSS pur (aucune donnee en fichier) - zero-fill integral. }
   For BssI := 0 To RealLen - 1 Do
    Emu_WriteByte(C, RealSegBase, BssI, 0);
  End;
 End;

 { Passe 2 : appliquer les relogements de chaque segment qui en a         }
 { (bit $0100), maintenant que TOUS les segments ont une adresse reelle.  }
 For I := 1 To Hdr.ne_cseg Do Begin
  Seek(F, HdrOfs + Hdr.ne_segtab + (I - 1) * 8);
  BlockRead(F, Seg, SizeOf(Seg), BytesRead);
  If (Seg.SegFlags And $0100) = 0 Then Continue;
  If Seg.DataOffsetSectors = 0 Then Continue;
  FileOfs := LongInt(Seg.DataOffsetSectors) Shl Hdr.ne_align;
  RealLen := Seg.DataLength;
  If RealLen = 0 Then RealLen := $FFFF;
  RelocPos := FileOfs + RealLen;
  Seek(F, RelocPos);
  BlockRead(F, RelocCount, 2, BytesRead);
  If BytesRead <> 2 Then Continue;
  RealSegBase := Win16_SegBase[I];
  For J := 1 To RelocCount Do Begin
   Seek(F, RelocPos + 2 + (J - 1) * 8);
   BlockRead(F, Rec, 8, BytesRead);
   If BytesRead <> 8 Then Break;
   SrcType := Rec[0];
   FlagByte := Rec[1];
   TargetType := FlagByte And 3;
   Additive := (FlagByte And 4) <> 0;
   IsList := (FlagByte And $20) <> 0;
   TargetOfs := Word(Rec[2] Or (Rec[3] Shl 8));
   If IsList Then Continue; { hors de portee, voir commentaire de tete }
   Ok := False;
   ResolvedSeg := 0; ResolvedOfs := 0;
   Case TargetType Of
    0: Begin { INTERNALREF }
     SegNum := Rec[4];
     If SegNum = $FF Then Begin
      Ordinal := Word(Rec[6] Or (Rec[7] Shl 8));
      If Win16_ResolveEntryOrdinal(Hdr, HdrOfs, Path, Ordinal, EntrySeg, EntryOfs) And
         (EntrySeg >= 1) And (EntrySeg <= LongInt(Win16_SegCount)) Then Begin
       ResolvedSeg := Win16_SegBase[EntrySeg];
       ResolvedOfs := EntryOfs;
       Ok := True;
      End;
     End Else If (SegNum >= 1) And (SegNum <= Win16_SegCount) Then Begin
      ResolvedSeg := Win16_SegBase[SegNum];
      ResolvedOfs := Word(Rec[6] Or (Rec[7] Shl 8));
      Ok := True;
     End;
    End;
    1: Begin { IMPORTORDINAL }
     ModIdx := Word(Rec[4] Or (Rec[5] Shl 8));
     Ordinal := Word(Rec[6] Or (Rec[7] Shl 8));
     Slot := Win16_ResolveImportSlot(C, ModIdx, True, Ordinal);
     If Slot >= 0 Then Begin
      ResolvedSeg := Win16_TrapSeg;
      ResolvedOfs := Word(Slot * WIN16_TRAP_SLOT_SIZE);
      Ok := True;
     End;
    End;
    2: Begin { IMPORTNAME }
     ModIdx := Word(Rec[4] Or (Rec[5] Shl 8));
     NameOfs := Word(Rec[6] Or (Rec[7] Shl 8));
     Slot := Win16_ResolveImportSlot(C, ModIdx, False, NameOfs);
     If Slot >= 0 Then Begin
      ResolvedSeg := Win16_TrapSeg;
      ResolvedOfs := Word(Slot * WIN16_TRAP_SLOT_SIZE);
      Ok := True;
     End;
    End;
   End;
   If Not Ok Then Continue;
   { BOGUE REEL trouve au Stage 5 (2026-08-29, via WIN16RUN sur CLOCK.EXE  }
   { ET CALENDAR.EXE - voir project_devenv_win16.md) : la PLUPART des     }
   { relogements NE non-additifs ne visent PAS une seule adresse mais une }
   { CHAINE - TargetOfs est l'adresse du PREMIER maillon seulement ; le    }
   { contenu BRUT (avant patch) de CHAQUE maillon encode l'offset du       }
   { maillon SUIVANT (terminateur $FFFF), dans la MEME zone qui sera       }
   { ensuite reellement patchee. Format CONFIRME via le code source reel  }
   { de Win3mu (Topten Software, fonction ApplyRelocations dans            }
   { Module16.cs, recupere via recherche web - jamais devine) : tant que   }
   { l'offset n'est pas $FFFF, lire le mot present (= offset du maillon    }
   { suivant), ecrire la valeur resolue a cet emplacement, puis avancer    }
   { vers ce maillon suivant. Symptome exact observe AVANT ce correctif :  }
   { un relogement KERNEL.LocalAlloc bien present et correctement resolu  }
   { (verifie via WIN16CALL/WIN16RUN sur un AUTRE site d'appel du MEME     }
   { import) ne patchait QUE le 1er site d'une chaine de 5 sites reels     }
   { dans CLOCK.EXE                                                       }
   { (0x0F6B->0x0F97->0x1047->0x0CB7->0x0D99), laissant les 4 autres avec  }
   { leurs octets de chainage originaux intacts - dont un terminateur      }
   { $FFFF:$0000 litteral qui ressemblait a un "CALL FAR" vers une adresse }
   { invalide (saut a CS=0) une fois atteint par l'execution reelle. }
   If Additive Then Begin
    { Additive : UNE SEULE adresse, la valeur resolue s'AJOUTE au contenu  }
    { existant au lieu de l'ecraser - AUCUN chainage dans ce cas (confirme}
    { par Win3mu : la boucle de chainage est dans la branche non-additive }
    { uniquement). Rare (2 cas sur 62 releves empiriquement sur CLOCK.EXE)}
    { mais desormais gere plutot qu'ignore, le mecanisme etant clarifie. }
    Case SrcType Of
     2: Emu_WriteWord(C, RealSegBase, TargetOfs,
         Word(Emu_ReadWord(C, RealSegBase, TargetOfs) + ResolvedSeg));
     5: Emu_WriteWord(C, RealSegBase, TargetOfs,
         Word(Emu_ReadWord(C, RealSegBase, TargetOfs) + ResolvedOfs));
     3: Emu_WriteWord(C, RealSegBase, TargetOfs,
         Word(Emu_ReadWord(C, RealSegBase, TargetOfs) + ResolvedOfs));
     0: Emu_WriteByte(C, RealSegBase, TargetOfs,
         Byte(Emu_ReadByte(C, RealSegBase, TargetOfs) + Byte(ResolvedOfs And $FF)));
    End;
   End Else Begin
    ChainOfs := TargetOfs;
    ChainGuard := 0;
    While (ChainOfs <> $FFFF) And (ChainGuard < 64) Do Begin
     ChainNext := Emu_ReadWord(C, RealSegBase, ChainOfs);
     Case SrcType Of
      2: Emu_WriteWord(C, RealSegBase, ChainOfs, ResolvedSeg);
      5: Emu_WriteWord(C, RealSegBase, ChainOfs, ResolvedOfs);
      3: Begin
       Emu_WriteWord(C, RealSegBase, ChainOfs, ResolvedOfs);
       Emu_WriteWord(C, RealSegBase, Word(ChainOfs + 2), ResolvedSeg);
      End;
      0: Emu_WriteByte(C, RealSegBase, ChainOfs, Byte(ResolvedOfs And $FF));
     End;
     ChainOfs := ChainNext;
     Inc(ChainGuard);
    End;
   End;
  End;
 End;
 Close(F);

 If (Hdr.ne_cs < 1) Or (Hdr.ne_cs > Win16_SegCount) Then Begin
  Win16_LastError := 'segment de point d''entree invalide';
  Exit;
 End;
 Win16_EntryPointSeg := Win16_SegBase[Hdr.ne_cs];
 Win16_EntryPointOfs := Hdr.ne_ip;
 If (Hdr.ne_ss < 1) Or (Hdr.ne_ss > Win16_SegCount) Then Begin
  Win16_LastError := 'segment de pile invalide';
  Exit;
 End;
 Win16_StackSeg := Win16_SegBase[Hdr.ne_ss];
 { Convention documentee (Stage 5) : SP=0 dans l'en-tete, quand SS pointe  }
 { sur le segment de donnees automatique, ne veut PAS dire "offset 0" -   }
 { c'est un cas special signifiant "sommet du segment automatique complet }
 { (donnees+BSS+tas)" - un vrai chargeur NE le detecte et pose SP au      }
 { sommet REEL (AutoDataLimit ci-dessus), jamais a 0 litteral. }
 If (Hdr.ne_sp = 0) And (Hdr.ne_ss = Hdr.ne_autodata) And (Hdr.ne_autodata >= 1) Then
  Win16_StackOfs := AutoDataLimit
 Else
  Win16_StackOfs := Hdr.ne_sp;
 Win16_StackSize := Hdr.ne_stack;
 Win16_HeapSize := Hdr.ne_heap;
 { Amorce du tas local (LocalAlloc, Stage 5) : demarre juste apres les     }
 { donnees+BSS statiques du segment autodata, grandit vers le haut         }
 { jusqu'a AutoDataLimit (deja reserve dans l'allocateur bump ci-dessus). }
 If Hdr.ne_autodata >= 1 Then Begin
  Win16_HeapNext := AutoDataMinAlloc;
  Win16_HeapLimit := AutoDataLimit;
 End Else Begin
  Win16_HeapNext := 0;
  Win16_HeapLimit := 0;
 End;
 { Chantier Stage 5 : chemin + offset absolu de la table de ressources     }
 { retenus pour une relecture A LA DEMANDE (LoadString etc.) - meme        }
 { discipline que Win16_ResolveEntryOrdinal (fichier rouvert au besoin,    }
 { jamais toute la table pre-chargee en memoire). }
 Win16_LoadedPath := Path;
 If Hdr.ne_rsrctab <> 0 Then
  Win16_RsrcTabAbsOfs := HdrOfs + Hdr.ne_rsrctab
 Else
  Win16_RsrcTabAbsOfs := 0;

 Win16_LoadNE := True;
End;

{ Chantier Windows 16 bits, Stage 5 (2026-08-29) : recherche une ressource  }
{ NE par (TypeID, ResID) - format VERIFIE via l'OSDev wiki NE ("Resource    }
{ Table" - AlignmentShiftCount puis une suite de blocs [TypeID:Word]        }
{ [ResourceCount:Word][Reserved:LongInt] suivis de ResourceCount entrees    }
{ [FileOffset:Word][Length:Word][Flags:Word][ID:Word][Reserved:LongInt],    }
{ TypeID=0 termine la table). TypeID/ResID doivent deja porter le bit       }
{ $8000 (identifiant entier, ex. $8006 = RT_STRING) - cette fonction ne     }
{ gere PAS les identifiants sous forme de chaine (bit $8000 absent), hors   }
{ de portee tant qu'aucun appel reel ne le demande. Relit le FICHIER a la   }
{ demande (meme discipline que Win16_ResolveEntryOrdinal) plutot que de     }
{ pre-charger toute la table. }
Function Win16_FindResource(TypeID, ResID: Word; Var ResFileOfs: LongInt;
 Var ResLen: LongInt): Boolean;
Type
 TNEResTypeHdr = Record
  TypeID: Word;
  ResourceCount: Word;
  Reserved: LongInt;
 End;
 TNEResEntry = Record
  FileOfsField: Word;
  LenField: Word;
  FlagsField: Word;
  IDField: Word;
  Reserved: LongInt;
 End;
Var
 F: File;
 BytesRead: Word;
 AlignShift: Word;
 TH: TNEResTypeHdr;
 RE: TNEResEntry;
 Pos: LongInt;
 I: Integer;
Begin
 Win16_FindResource := False;
 If Win16_RsrcTabAbsOfs = 0 Then Exit;
 {$I-}
 Assign(F, Win16_LoadedPath);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 Pos := Win16_RsrcTabAbsOfs;
 Seek(F, Pos);
 BlockRead(F, AlignShift, 2, BytesRead);
 If BytesRead <> 2 Then Begin Close(F); Exit; End;
 Pos := Pos + 2;
 While True Do Begin
  Seek(F, Pos);
  BlockRead(F, TH, SizeOf(TH), BytesRead);
  If BytesRead <> SizeOf(TH) Then Break;
  Pos := Pos + SizeOf(TH);
  If TH.TypeID = 0 Then Break; { fin de la table }
  For I := 1 To TH.ResourceCount Do Begin
   Seek(F, Pos);
   BlockRead(F, RE, SizeOf(RE), BytesRead);
   If BytesRead <> SizeOf(RE) Then Begin Close(F); Exit; End;
   Pos := Pos + SizeOf(RE);
   If (TH.TypeID = TypeID) And (RE.IDField = ResID) Then Begin
    ResFileOfs := LongInt(RE.FileOfsField) Shl AlignShift;
    ResLen := LongInt(RE.LenField) Shl AlignShift;
    Close(F);
    Win16_FindResource := True;
    Exit;
   End;
  End;
 End;
 Close(F);
End;

{ Chantier Stage 5 (suite, 2026-08-29) : un champ Type/ID de la table de   }
{ ressources dont le bit $8000 est ABSENT n'est pas un entier - c'est un   }
{ OFFSET, relatif au DEBUT de la table de ressources, vers une chaine      }
{ Pascal-style nommant le type/la ressource (format confirme via l'OSDev   }
{ wiki, section "Resource Type IDs and Resource IDs"). Necessaire pour     }
{ KERNEL.FindResource (ordinal 60) quand le programme appelant passe un    }
{ vrai pointeur chaine plutot qu'un MAKEINTRESOURCE entier - observe       }
{ REELLEMENT dans CLOCK.EXE (ressource personnalisee nommee, ni RT_STRING  }
{ ni aucun type systeme standard). }
Function Win16_ResourceIdMatches(Var F: File; RawField: Word;
 QueryIsInt: Boolean; QueryInt: Word; Const QueryStr: String): Boolean;
Var
 Len: Byte;
 Buf: Array[0..255] Of Char;
 BytesRead: Word;
 S: String;
 I: Integer;
Begin
 Win16_ResourceIdMatches := False;
 If (RawField And $8000) <> 0 Then Begin
  If QueryIsInt Then Win16_ResourceIdMatches := (RawField = QueryInt);
  Exit;
 End;
 If QueryIsInt Then Exit; { un ID entier ne correspond jamais a une ressource nommee }
 Seek(F, Win16_RsrcTabAbsOfs + LongInt(RawField));
 BlockRead(F, Len, 1, BytesRead);
 If BytesRead <> 1 Then Exit;
 S := '';
 If Len > 0 Then Begin
  BlockRead(F, Buf, Len, BytesRead);
  If BytesRead <> Len Then Exit;
  For I := 0 To Len - 1 Do S := S + Buf[I];
 End;
 Win16_ResourceIdMatches := (UpCaseStr(S) = UpCaseStr(QueryStr));
End;

{ Variante GENERIQUE de Win16_FindResource : Type ET Nom peuvent CHACUN     }
{ etre soit un entier MAKEINTRESOURCE, soit une chaine reelle (voir        }
{ Win16_ResourceIdMatches ci-dessus). Utilisee par KERNEL.FindResource     }
{ (ordinal 60) - Win16_FindResource (entiers uniquement) reste utilisee    }
{ telle quelle par LoadString (USER.176), plus simple/rapide pour son cas. }
Function Win16_FindResourceGeneric(TypeIsInt: Boolean; TypeInt: Word;
 Const TypeStr: String; NameIsInt: Boolean; NameInt: Word;
 Const NameStr: String; Var ResFileOfs, ResLen: LongInt): Boolean;
Type
 TNEResTypeHdr = Record
  TypeID: Word;
  ResourceCount: Word;
  Reserved: LongInt;
 End;
 TNEResEntry = Record
  FileOfsField: Word;
  LenField: Word;
  FlagsField: Word;
  IDField: Word;
  Reserved: LongInt;
 End;
Var
 F: File;
 BytesRead: Word;
 AlignShift: Word;
 TH: TNEResTypeHdr;
 RE: TNEResEntry;
 Pos: LongInt;
 I: Integer;
Begin
 Win16_FindResourceGeneric := False;
 If Win16_RsrcTabAbsOfs = 0 Then Exit;
 {$I-}
 Assign(F, Win16_LoadedPath);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 Pos := Win16_RsrcTabAbsOfs;
 Seek(F, Pos);
 BlockRead(F, AlignShift, 2, BytesRead);
 If BytesRead <> 2 Then Begin Close(F); Exit; End;
 Pos := Pos + 2;
 While True Do Begin
  Seek(F, Pos);
  BlockRead(F, TH, SizeOf(TH), BytesRead);
  If BytesRead <> SizeOf(TH) Then Break;
  Pos := Pos + SizeOf(TH);
  If TH.TypeID = 0 Then Break;
  If Win16_ResourceIdMatches(F, TH.TypeID, TypeIsInt, TypeInt, TypeStr) Then Begin
   For I := 1 To TH.ResourceCount Do Begin
    Seek(F, Pos + (I - 1) * SizeOf(RE));
    BlockRead(F, RE, SizeOf(RE), BytesRead);
    If BytesRead <> SizeOf(RE) Then Begin Close(F); Exit; End;
    If Win16_ResourceIdMatches(F, RE.IDField, NameIsInt, NameInt, NameStr) Then Begin
     ResFileOfs := LongInt(RE.FileOfsField) Shl AlignShift;
     ResLen := LongInt(RE.LenField) Shl AlignShift;
     Close(F);
     Win16_FindResourceGeneric := True;
     Exit;
    End;
   End;
  End;
  Pos := Pos + LongInt(TH.ResourceCount) * SizeOf(RE);
 End;
 Close(F);
End;

{ Chantier Windows 16 bits, Stage 4/5 : positionne les registres de         }
{ demarrage REELS d'un programme Win16 (convention documentee - voir        }
{ Raymond Chen, "How do 16-bit programs start up?" - deja utilisee/         }
{ verifiee au Stage 3 via WIN16CALL) et saute au VRAI point d'entree du     }
{ module (contrairement a WIN16CALL qui sautait directement au thunk        }
{ InitTask). Factorisee ici pour que ShowEmulatorPanel (Stage 4) et le      }
{ harnais de diagnostic WIN16RUN (Stage 5) partagent EXACTEMENT le meme     }
{ code, plutot que 2 copies qui pourraient diverger silencieusement. }
Procedure Win16_SetupEntryRegs(Var C: TEmuCPU);
Begin
 C.Regs.AX := 0;
 C.Regs.BX := Win16_StackSize;
 C.Regs.CX := Win16_HeapSize;
 C.Regs.DX := 0;
 C.Regs.SI := 0;             { hPrevInstance : aucune instance precedente }
 { BOGUE REEL trouve au Stage 5 (2026-08-29) : DI (hInstance, "cette       }
 { instance") avait ete laisse a 0 - or hInstance EST litteralement le     }
 { selecteur du segment de donnees automatique en Win16 (confirme de       }
 { facon AUTHORITATIVE via l'article de Raymond Chen "What is the          }
 { difference between HINSTANCE and HMODULE?" - "the 'instance' handles    }
 { ... are the data segments"), JAMAIS 0 pour une instance reellement       }
 { chargee. CLOCK.EXE ET CALENDAR.EXE (2 binaires independants) plantaient }
 { tous deux au MEME point exact (code d'amorcage partage du compilateur)  }
 { en testant [BP+xx]=0 - tres probablement une verification "est-ce la    }
 { premiere instance / hInstance valide" qui ne peut jamais reussir avec   }
 { hInstance=0, faisant croire a une condition qui n'arrive jamais en      }
 { pratique et menant vers du code jamais reellement teste par un vrai     }
 { Windows (relogement absent - PAS un oubli de chargeur, juste du code    }
 { que Windows n'atteint jamais). }
 C.Regs.DI := Win16_StackSeg;
 C.Regs.BP := 0;
 C.Segs.DS := Win16_StackSeg;
 C.Segs.SS := Win16_StackSeg;
 C.Regs.SP := Win16_StackOfs;
 C.Segs.ES := 0;
 C.Segs.CS := Win16_EntryPointSeg;
 C.IP := Win16_EntryPointOfs;
End;

{ Chantier Windows 16 bits, Stage 6 (2026-08-29) : la globale EmuVideo     }
{ (mode/plan memoire graphique VGA) est PARTAGEE avec le backend DOS       }
{ (-CD/-CP) - sans ce couple sauvegarde/restauration, quitter un onglet    }
{ Win16 en mode graphique puis revenir sur un onglet DOS (ou l'inverse)    }
{ corromprait/perdrait l'etat video de l'un ou l'autre (confirme par       }
{ exploration du code : DOS_SaveState/LoadState font exactement ce         }
{ même echange de pointeur pour leurs propres onglets - Win16 n'avait      }
{ jusqu'ici aucune branche equivalente car il ne touchait jamais           }
{ EmuVideo). Un SEUL emplacement de sauvegarde (pas un tableau par onglet) }
{ car Win16_LoadNE ne gere de toute facon qu'un seul programme a la fois   }
{ (etat global Win16_*, deja documente ailleurs). }
Procedure Win16_SaveVideoState;
Begin
 Win16_SavedVideo := EmuVideo;
 Win16_SavedVideo.Mem := EmuVideo.Mem;
 EmuVideo.Mem := Nil;
 EmuVideo.MemReady := False;
End;

Procedure Win16_LoadVideoState;
Begin
 EmuVideo := Win16_SavedVideo;
End;

{ Chantier Windows 16 bits, Stage 3 : arret propre et honnete sur un       }
{ appel KERNEL/USER/GDI pas encore implante - meme discipline exacte que   }
{ Lx_Halt pour OS/2 LX ("DOSCALLS non supporte : ..."). Ne devine JAMAIS   }
{ un comportement pour un ordinal non verifie - un programme reel qui      }
{ atteint ce point s arrete la, proprement, plutot que de corrompre sa     }
{ pile avec un nombre d octets a depiler invente. }
Procedure Win16_Halt(Var P: TEmulatorPanel; Const ModName: String; Ordinal: Word);
Begin
 P.CPU.Fault := sfEndProgram;
 Win16_LastError := 'Appel non supporte : ' + ModName + '.' + IntToStr(Ordinal);
End;

{ Chantier Windows 16 bits, Stage 6 (2026-08-29) : lit une chaine ANSI     }
{ terminee par NUL depuis la memoire EMULEE (donnees RUNTIME du           }
{ programme - a ne pas confondre avec Win16_FindResourceGeneric qui lit   }
{ depuis le FICHIER). Utilisee par RegisterClass/CreateWindow pour lire   }
{ les vrais noms de classe/titres passes par le programme. }
Function Win16_ReadGuestString(Var C: TEmuCPU; Seg, Ofs: Word): String;
Var
 S: String;
 I: Integer;
 B: Byte;
Begin
 S := '';
 For I := 0 To 254 Do Begin
  B := Emu_ReadByte(C, Seg, Word(Ofs + I));
  If B = 0 Then Break;
  S := S + Chr(B);
 End;
 Win16_ReadGuestString := S;
End;

{ Chantier Stage 6 (2026-08-29, REECRIT sur demande explicite de           }
{ l'utilisateur - "mode graphique par defaut, pas mode texte") : dessine   }
{ un cadre de fenetre en VRAIS PIXELS via Emu_VidSetPixel (framebuffer     }
{ EmuVideo reel, mode $13 320x200x256 - voir ShowEmulatorPanel), plus      }
{ aucun rapport avec la grille de texte P.VRAM (l'ancienne version ASCII   }
{ de cette fonction, et son helper Win16_PutCharAt, sont retires - plus    }
{ utilises par personne). Coordonnees deja en pixels REELS 1:1 (le         }
{ programme les calcule lui-meme via GetDeviceCaps/GetSystemMetrics, deja  }
{ ajustes a 320x200 - aucune mise a l'echelle necessaire ici). Couleur 15  }
{ = blanc (palette EGA standard des 16 premieres entrees de la DAC par     }
{ defaut - voir Emu_VidInitDefaultDAC). Le TITRE n'est PAS dessine en      }
{ pixels ici (aucune police bitmap disponible pour le moment - voir Stage  }
{ 6c) - le bandeau de titre du PANNEAU lui-meme (dessine par              }
{ DrawEmulatorPanel, hors framebuffer) affiche deja le chemin du fichier,  }
{ suffisant pour identifier l'onglet. }
Procedure Win16_DrawWindowFrame(Var P: TEmulatorPanel; WIndex: Integer);
Var
 X1, Y1, X2, Y2: Integer;
 X, Y: Integer;
Begin
 If (WIndex < 0) Or (WIndex >= Win16_WindowCount) Then Exit;
 X1 := Win16_WindowX[WIndex];
 Y1 := Win16_WindowY[WIndex];
 X2 := X1 + Win16_WindowW[WIndex] - 1;
 Y2 := Y1 + Win16_WindowH[WIndex] - 1;
 { Fond de la zone client (2026-08-30, signale par l'utilisateur : "le    }
 { fond devrait etre blanc par defaut" - un vrai Windows 2.x/3.x remplit   }
 { l'interieur de la fenetre en blanc (COLOR_WINDOW/WHITE_BRUSH, le pinceau}
 { de fond par defaut de la quasi-totalite des WNDCLASS reelles) AVANT que }
 { l'appli ne dessine quoi que ce soit dessus - jusqu'ici seul le cadre    }
 { 1px etait trace, laissant l'interieur au contenu precedent (souvent     }
 { noir) du framebuffer EmuVideo. Win16_WndClassBg (hbrBackground) est     }
 { deja capture par RegisterClass mais reste un handle GDI synthetique     }
 { (aucune resolution reelle de couleur de pinceau, Stage 6c) - blanc      }
 { simple assume ici, plausible pour la quasi-totalite des vraies apps     }
 { Win16 de cette epoque. }
 For Y := Y1 + 1 To Y2 - 1 Do
  For X := X1 + 1 To X2 - 1 Do
   Emu_VidSetPixel(X, Y, 15);
 For X := X1 To X2 Do Begin
  Emu_VidSetPixel(X, Y1, 15);
  Emu_VidSetPixel(X, Y2, 15);
 End;
 For Y := Y1 To Y2 Do Begin
  Emu_VidSetPixel(X1, Y, 15);
  Emu_VidSetPixel(X2, Y, 15);
 End;
End;

{ Poste un message dans la file circulaire Win16_MsgQueue (Stage 6b/6d/6e  }
{ - deja cablee ici puisque WM_CREATE, poste au Stage 6b, en a besoin).    }
{ Simplification documentee : file PLEINE = message silencieusement       }
{ perdu (jamais observe en pratique, taille 32, un seul programme). }
Procedure Win16_PostMessage(HWnd, Msg, WParam, LParamLo, LParamHi: Word);
Begin
 If Win16_MsgQueueCount >= WIN16_MAX_MSGQUEUE Then Exit;
 Win16_MsgQueueHWnd[Win16_MsgQueueTail] := HWnd;
 Win16_MsgQueueMsg[Win16_MsgQueueTail] := Msg;
 Win16_MsgQueueWParam[Win16_MsgQueueTail] := WParam;
 Win16_MsgQueueLParamLo[Win16_MsgQueueTail] := LParamLo;
 Win16_MsgQueueLParamHi[Win16_MsgQueueTail] := LParamHi;
 Win16_MsgQueueTail := (Win16_MsgQueueTail + 1) Mod WIN16_MAX_MSGQUEUE;
 Inc(Win16_MsgQueueCount);
End;

{ Stage 6b (2026-08-30) : Dpmi_RunRealProc (~75511) est le mecanisme deja   }
{ identifie/reutilise pour Win16_CallWndProc ci-dessous (execute Emu_StepOne}
{ en boucle bornee jusqu'a un sentinel de retour synthetique) mais n'est    }
{ defini que bien plus loin dans ce fichier - Forward requis, meme motif    }
{ que les 5 deja ajoutes pour Win16_LoadNE au Stage 2. }
Procedure Dpmi_RunRealProc(Var P: TEmulatorPanel; TargetCS, TargetIP: Word;
 ViaIret: Boolean); Forward;

{ Journal DEDIE (2026-08-30, diagnostic "aiguilles toujours invisibles" -   }
{ voir Win16_GdiTraceOn/Count/Max) des VRAIS appels GDI de dessin, avec     }
{ leurs coordonnees CLIENT brutes ET converties en pixels ABSOLUS - le seul}
{ moyen de savoir si le programme dessine reellement des coordonnees non   }
{ degenerees (ex. toujours le meme point = aiguille de longueur nulle,     }
{ invisible) sans se limiter au tout premier WM_PAINT comme le tracer      }
{ pas-a-pas Win16_WndProcTraceOn ci-dessus. }
Procedure Win16_GdiTraceLog(Const S: String);
Begin
 If Win16_GdiTraceCount >= Win16_GdiTraceMax Then Exit;
 If Not Win16_GdiTraceOn Then Begin
  {$I-} Assign(Win16_GdiTraceFile, 'GDI_DRAW_TRACE.LOG');
  Rewrite(Win16_GdiTraceFile); {$I+}
  If IOResult <> 0 Then Exit;
  Win16_GdiTraceOn := True;
 End;
 WriteLn(Win16_GdiTraceFile, S);
 Inc(Win16_GdiTraceCount);
End;

{ Applique REELLEMENT Win16_CurrentROP2 (SetROP2, voir sa declaration) au   }
{ lieu d'ecraser inconditionnellement le pixel - R2_NOT(6) inverse le       }
{ pixel EXISTANT (ignore Color, "NOT(NOT(x))=x" : retracer EXACTEMENT le    }
{ meme trait l'efface, peu importe la couleur de fond - le mecanisme reel   }
{ utilise par les aiguilles d'horloge sans scintillement), R2_XORPEN(7)     }
{ fait un OU-EXCLUSIF avec Color, tout le reste (dont le defaut R2_COPYPEN) }
{ ecrase simplement avec Color comme avant. Utilise par Win16_DrawLine/     }
{ Win16_DrawEllipseBox ci-dessous - jamais appele directement ailleurs. }
Procedure Win16_PlotPixel(X, Y: Integer; Color: Byte);
Begin
 Case Win16_CurrentROP2 Of
  6:  Emu_VidSetPixel(X, Y, Emu_VidGetPixel(X, Y) Xor $FF);
  7:  Emu_VidSetPixel(X, Y, Emu_VidGetPixel(X, Y) Xor Color);
  Else Emu_VidSetPixel(X, Y, Color);
 End;
End;

{ Trace un segment de droite en VRAIS pixels (Bresenham standard, entiers   }
{ uniquement) - utilise par LineTo (GDI ordinal 19). Coordonnees deja en    }
{ pixels ABSOLUS du framebuffer (voir Win16_LineTo ci-apres pour la          }
{ conversion depuis les coordonnees CLIENT que le programme fournit). }
Procedure Win16_DrawLine(X1, Y1, X2, Y2: Integer; Color: Byte);
Var
 DX, DY, SX, SY, Err, E2: Integer;
Begin
 DX := Abs(X2 - X1); If X1 < X2 Then SX := 1 Else SX := -1;
 DY := -Abs(Y2 - Y1); If Y1 < Y2 Then SY := 1 Else SY := -1;
 Err := DX + DY;
 While True Do Begin
  Win16_PlotPixel(X1, Y1, Color);
  If (X1 = X2) And (Y1 = Y2) Then Break;
  E2 := 2 * Err;
  If E2 >= DY Then Begin Err := Err + DY; X1 := X1 + SX; End;
  If E2 <= DX Then Begin Err := Err + DX; Y1 := Y1 + SY; End;
 End;
End;

{ Trace le contour d'une ellipse inscrite dans le rectangle (X1,Y1)-(X2,Y2) }
{ - algorithme du point milieu standard (4 symetries), coordonnees deja en  }
{ pixels ABSOLUS. Utilise par Ellipse (GDI ordinal 24) - suffisant pour un  }
{ cadran d'horloge circulaire, aucun remplissage (l'interieur reste le      }
{ fond blanc deja pose par Win16_DrawWindowFrame). }
Procedure Win16_DrawEllipseBox(X1, Y1, X2, Y2: Integer; Color: Byte);
Var
 CX, CY, RX, RY: Integer;
 X, Y: Integer;
 RX2, RY2, TwoRX2, TwoRY2: LongInt;
 Ex, Ey: LongInt;
 P1, P2: LongInt;
Begin
 CX := (X1 + X2) Div 2;
 CY := (Y1 + Y2) Div 2;
 RX := Abs(X2 - X1) Div 2;
 RY := Abs(Y2 - Y1) Div 2;
 If (RX <= 0) Or (RY <= 0) Then Exit;
 RX2 := LongInt(RX) * RX;
 RY2 := LongInt(RY) * RY;
 TwoRX2 := 2 * RX2;
 TwoRY2 := 2 * RY2;
 X := 0; Y := RY;
 Ex := 0; Ey := TwoRX2 * Y;
 Win16_PlotPixel(CX, CY + Y, Color); Win16_PlotPixel(CX, CY - Y, Color);
 Win16_PlotPixel(CX + X, CY + Y, Color); { degenere si X=0, harmless }
 P1 := RY2 - (RX2 * RY) + (RX2 Div 4);
 While Ex < Ey Do Begin
  Inc(X);
  Ex := Ex + TwoRY2;
  If P1 < 0 Then
   P1 := P1 + RY2 + Ex
  Else Begin
   Dec(Y);
   Ey := Ey - TwoRX2;
   P1 := P1 + RY2 + Ex - Ey;
  End;
  Win16_PlotPixel(CX + X, CY + Y, Color); Win16_PlotPixel(CX - X, CY + Y, Color);
  Win16_PlotPixel(CX + X, CY - Y, Color); Win16_PlotPixel(CX - X, CY - Y, Color);
 End;
 P2 := (RY2 * (X + 1) * (X + 1)) + (RX2 * (Y - 1) * (Y - 1)) - RX2 * RY2;
 While Y > 0 Do Begin
  Dec(Y);
  Ey := Ey - TwoRX2;
  If P2 > 0 Then
   P2 := P2 + RX2 - Ey
  Else Begin
   Inc(X);
   Ex := Ex + TwoRY2;
   P2 := P2 + RX2 - Ey + Ex;
  End;
  Win16_PlotPixel(CX + X, CY + Y, Color); Win16_PlotPixel(CX - X, CY + Y, Color);
  Win16_PlotPixel(CX + X, CY - Y, Color); Win16_PlotPixel(CX - X, CY - Y, Color);
 End;
End;

{ Appelle SYNCHRONE la VRAIE WNDPROC 16 bits du programme (dispatchee par   }
{ DispatchMessage) - reutilise Dpmi_RunRealProc TEL QUEL (meme motif exact  }
{ que les rappels DPMI mode reel : empiler les arguments convention Pascal, }
{ sauter au point d'entree, executer Emu_StepOne en boucle bornee jusqu'au  }
{ sentinel EMU_DPMI_RMCALL_SEG:OFS). WNDPROC(hWnd, msg, wParam, lParam) est  }
{ une signature FIXE et UNIVERSELLE Windows (4 arguments, 2+2+2+4=10        }
{ octets, RETF 000Ah) - jamais variable d'un programme a l'autre, donc      }
{ jamais besoin de la (re)vérifier au cas par cas comme pour les ordinaux    }
{ KERNEL/USER/GDI eux-memes. }
Function Win16_CallWndProc(Var P: TEmulatorPanel; ProcSeg, ProcOfs,
 HWnd, Msg, WParam, LParamLo, LParamHi: Word): LongInt;
Var
 WPDumpI: Integer;
Begin
 { Bogue reel trouve+corrige (2026-08-30) : convention Pascal/WINAPI reelle  }
 { confirmee via desassemblage direct de CLOCK.EXE (WNDPROC_TRACE.LOG) -    }
 { le parametre le plus a GAUCHE (HWnd) est empile en PREMIER (le plus      }
 { profond), celui le plus a DROITE (LParam, poids fort en dernier) en      }
 { DERNIER (le plus proche du sommet) - PAS l'inverse comme suppose         }
 { initialement. Toutes les autres branches d'ordinaux (BeginPaint,         }
 { DefWindowProc, etc.) utilisaient deja la bonne convention ; seule cette  }
 { fonction avait l'ordre inverse, ce qui faisait que ClockWndProc lisait    }
 { son propre message (WM_PAINT) a la mauvaise position (LParamLo au lieu   }
 { de Msg) et retombait toujours sur DefWindowProc(0,0,0,0) au lieu de       }
 { dessiner. }
 Emu_PushWord(P.CPU, HWnd);
 Emu_PushWord(P.CPU, Msg);
 Emu_PushWord(P.CPU, WParam);
 Emu_PushWord(P.CPU, LParamLo);
 Emu_PushWord(P.CPU, LParamHi);
 { Diagnostic temporaire (2026-08-30) : trace le tout PREMIER appel de     }
 { WNDPROC pour ce message precis (WM_PAINT=$000F) instruction par         }
 { instruction dans WNDPROC_TRACE.LOG - repond directement a la question    }
 { "que fait reellement ClockWndProc en seulement 33 pas pour WM_PAINT ?"   }
 { (invisible a WIN16RUN.LOG, voir Dpmi_LastRunRealProcIter). }
 If (Msg = WIN16_WM_PAINT) And (Not Win16_WndProcTraceDone) Then Begin
  Win16_WndProcTraceDone := True;
  {$I-} Assign(Win16_WndProcTraceFile, 'WNDPROC_TRACE.LOG');
  Rewrite(Win16_WndProcTraceFile); {$I+}
  If IOResult = 0 Then Begin
   Win16_WndProcTraceOn := True;
   WriteLn(Win16_WndProcTraceFile, 'CallWndProc args: HWnd=', HexWord(HWnd),
    ' Msg=', HexWord(Msg), ' WParam=', HexWord(WParam), ' LParamHi=',
    HexWord(LParamHi), ' LParamLo=', HexWord(LParamLo));
   WriteLn(Win16_WndProcTraceFile, 'Raw bytes @ ', HexWord(ProcSeg), ':',
    HexWord(ProcOfs), ' (400 octets, pour desassemblage manuel complet) :');
   For WPDumpI := 0 To 399 Do Begin
    Write(Win16_WndProcTraceFile, HexByte(Emu_ReadByte(P.CPU, ProcSeg,
     Word(ProcOfs + WPDumpI))), ' ');
    If (WPDumpI Mod 16) = 15 Then WriteLn(Win16_WndProcTraceFile);
   End;
   WriteLn(Win16_WndProcTraceFile);
   WriteLn(Win16_WndProcTraceFile);
  End;
 End;
 Dpmi_RunRealProc(P, ProcSeg, ProcOfs, False);
 If Win16_WndProcTraceOn Then Begin
  Win16_WndProcTraceOn := False;
  Close(Win16_WndProcTraceFile);
 End;
 Win16_CallWndProc := (LongInt(P.CPU.Regs.DX) Shl 16) Or P.CPU.Regs.AX;
End;

{ Coeur de GetMessage/PeekMessage (ordinaux USER 108/109) - priorite REELLE }
{ Windows (entree file > repaint > minuteur), meme ordre de priorite que    }
{ documente pour les messages "generes"/bas niveau. Retourne False           }
{ uniquement pour WM_QUIT (contrat reel de GetMessage : fin de boucle). }
Function Win16_GetMessage(Var P: TEmulatorPanel; Var OutHWnd, OutMsg,
 OutWParam, OutLParamLo, OutLParamHi: Word): Boolean;
Var
 WIdx, TIdx, DueIdx: Integer;
 Guard: LongInt;
Begin
 If Win16_MsgQueueCount > 0 Then Begin
  OutHWnd := Win16_MsgQueueHWnd[Win16_MsgQueueHead];
  OutMsg := Win16_MsgQueueMsg[Win16_MsgQueueHead];
  OutWParam := Win16_MsgQueueWParam[Win16_MsgQueueHead];
  OutLParamLo := Win16_MsgQueueLParamLo[Win16_MsgQueueHead];
  OutLParamHi := Win16_MsgQueueLParamHi[Win16_MsgQueueHead];
  Win16_MsgQueueHead := (Win16_MsgQueueHead + 1) Mod WIN16_MAX_MSGQUEUE;
  Dec(Win16_MsgQueueCount);
  Win16_GetMessage := (OutMsg <> WIN16_WM_QUIT);
  Exit;
 End;
 For WIdx := 0 To Win16_WindowCount - 1 Do
  If Win16_WindowNeedsPaint[WIdx] Then Begin
   OutHWnd := Win16_WindowHWnd[WIdx];
   OutMsg := WIN16_WM_PAINT;
   OutWParam := 0; OutLParamLo := 0; OutLParamHi := 0;
   Win16_GetMessage := True;
   Exit;
  End;
 { Rien d'immediatement disponible : un vrai GetMessage BLOQUE ici jusqu'a  }
 { la prochaine entree/minuteur/repaint. Aucune autre tache ne peut         }
 { s'executer pendant ce temps dans ce modele mono-programme, et le         }
 { clavier/souris ne sont pas routes (Stage 6e) - la SEULE chose qui peut   }
 { arriver a echeance est donc un minuteur deja enregistre. On avance       }
 { reellement l'horloge simulee (meme compteur EmuTickCounter/Emu_TimerTick }
 { que le tic BIOS reel, AUCUNE execution CPU pendant cette attente         }
 { puisqu'il n'y a litteralement rien d'autre a executer) jusqu'a ce qu'un  }
 { minuteur arrive a echeance. Boucle bornee (meme discipline que            }
 { Dpmi_RunRealProc) : si aucun minuteur n'est meme enregistre, ce blocage  }
 { ne pourrait jamais se terminer - arret honnete plutot qu'une boucle       }
 { infinie simulee. }
 If Win16_TimerCount = 0 Then Begin
  Win16_LastError := 'GetMessage : file vide et aucun minuteur actif ' +
   '- blocage reel non simule (clavier/souris non routes, Stage 6e).';
  Win16_Halt(P, 'USER', 108);
  Win16_GetMessage := False;
  Exit;
 End;
 DueIdx := -1;
 Guard := 0;
 Repeat
  For TIdx := 0 To Win16_TimerCount - 1 Do
   If EmuTickCounter >= Win16_TimerNextDueTick[TIdx] Then Begin
    DueIdx := TIdx;
    Break;
   End;
  If DueIdx < 0 Then Begin
   Emu_TimerTick(P);
   Inc(Guard);
  End;
 Until (DueIdx >= 0) Or (Guard >= 5000000);
 If DueIdx < 0 Then Begin
  Win16_LastError := 'GetMessage : aucun minuteur jamais arrive a ' +
   'echeance (garde-fou de ' + IntToStr(Guard) + ' tics atteint).';
  Win16_Halt(P, 'USER', 108);
  Win16_GetMessage := False;
  Exit;
 End;
 Win16_TimerNextDueTick[DueIdx] := Win16_TimerNextDueTick[DueIdx] +
  Win16_TimerElapseTicks[DueIdx];
 OutHWnd := Win16_TimerHWnd[DueIdx];
 OutMsg := WIN16_WM_TIMER;
 OutWParam := Win16_TimerID[DueIdx];
 OutLParamLo := 0; OutLParamHi := 0;
 Win16_GetMessage := True;
End;

{ Dispatcher reel des appels KERNEL/USER/GDI, atteint via le Case $F8 de   }
{ Emu_DoInt (voir plus loin dans ce fichier) - Slot identifie la paire     }
{ (Module, Ordinal) resolue au chargement (Win16_ImportModIdx/Ordinal/    }
{ IsOrd, deja remplis par Win16_ResolveImportSlot au Stage 2). Portee      }
{ VOLONTAIREMENT minimale (voir le plan) : seul le sous-ensemble KERNEL    }
{ necessaire au tout debut de l initialisation d une tache Windows est     }
{ implante avec un VRAI comportement verifie ; tout le reste (y compris    }
{ USER/GDI en entier) s arrete proprement via Win16_Halt en identifiant    }
{ exactement quel appel manque - a completer iterativement (Stage 5),      }
{ meme methode "executer -> arret honnete -> corriger -> re-executer" que  }
{ LOGDAEM.EXE pour OS/2 LX. Indices de MODULE bases sur l ordre           }
{ EMPIRIQUEMENT verifie (Stage 1) sur CLOCK.EXE ET CALENDAR.EXE, tous deux }
{ KERNEL=1/GDI=2/USER=3 - simplification documentee, PAS une garantie      }
{ universelle du format NE (a revoir si un 3e fichier reel rompt cet ordre)}
Procedure Win16_DispatchCall(Var P: TEmulatorPanel; Slot: Integer);
Var
 ModIdx, Ordinal: Word;
 IsOrd: Boolean;
 RetIP, RetCS: Word;
 ArgWords: Word;
 LocalWBytes: Word;
 LSResId, LSBufOfs, LSBufSeg, LSBufLen: Word;
 LSRetVal, LSCopyLen, LSStringNum, LSPos, LSI: Integer;
 LSResFileOfs, LSResLen: LongInt;
 LSFile: File;
 LSBytesRead: Word;
 LSBuf: Array[0..4095] Of Byte;
 LSStrLen: Byte;
 FRNameSeg, FRNameOfs, FRTypeSeg, FRTypeOfs: Word;
 FRNameIsInt, FRTypeIsInt: Boolean;
 FRNameStr, FRTypeStr: String;
 FRI: Integer;
 FRByte: Byte;
 LRLen: LongInt;
 LRFile: File;
 LRBytesRead: Word;
 LRBuf: Array[0..4095] Of Byte;
 LRI: Integer;
 GDIIdx: Word;
 RCWndClassSeg, RCWndClassOfs: Word;
 RCNameSeg, RCNameOfs: Word;
 RCIdx: Integer;
 CWClassSeg, CWClassOfs, CWTitleSeg, CWTitleOfs: Word;
 CWX, CWY, CWW, CWH: Word;
 CWClassStr, CWTitleStr: String;
 CWClassIdx, CWI, CWIdx: Integer;
 { Stage 6b (2026-08-30) : minuteurs, boucle de messages, WNDPROC, GDI. }
 TmrHWndArg, TmrIDArg, TmrElapseArg: Word;
 TmrIdx, TmrFoundIdx: Integer;
 GMHWnd, GMMsg, GMWParam, GMLParamLo, GMLParamHi: Word;
 GMLpSeg, GMLpOfs: Word;
 DMLpSeg, DMLpOfs: Word;
 DMHWnd, DMMsg, DMWParam, DMLParamLo, DMLParamHi: Word;
 DMWIdx, DMClassIdx: Integer;
 DMResult: LongInt;
 BPWIdx: Integer;
 BPHWndArg, BPLpSeg, BPLpOfs: Word;
 GCRLpSeg, GCRLpOfs: Word;
 IRHWndArg: Word;
 IRWIdx: Integer;
 GdiX1, GdiY1, GdiX2, GdiY2: SmallInt;
 FRLpSeg, FRLpOfs: Word;
 FRLeft, FRTop, FRRight, FRBottom: SmallInt;
 FRX, FRY: Integer;
 IFDx, IFDy: SmallInt;
 SWHWndArg: Word;
 SWWIdx: Integer;
Begin
 If (Slot < 0) Or (Slot >= Win16_ImportSlotCount) Then Begin
  P.CPU.Fault := sfEndProgram;
  Win16_LastError := 'Slot de trappe invalide : ' + IntToStr(Slot);
  Exit;
 End;
 ModIdx := Win16_ImportModIdx[Slot];
 IsOrd := Win16_ImportIsOrd[Slot];
 Ordinal := Win16_ImportValue[Slot];
 ArgWords := 0;
 If (Not IsOrd) Then Begin
  Win16_Halt(P, 'import par nom (module #' + IntToStr(ModIdx) + ')', 0);
  Exit;
 End;
 If ModIdx = 1 Then Begin { KERNEL }
  Case Ordinal Of
   91: Begin
    { InitTask - convention REGISTRES verifiee (Raymond Chen, "How do      }
    { 16-bit programs start up?", devblogs.microsoft.com/oldnewthing) :    }
    { AUCUN argument sur la pile, tout passe par les registres. En ENTREE, }
    { les registres sont deja ceux que "le chargeur" (nous, au Stage 4)    }
    { a poses avant de sauter au point d'entree - AX=0 BX=taille-pile      }
    { CX=taille-tas DX=inutilise SI=instance precedente DI=cette instance  }
    { BP=0 DS=SS=segment de donnees automatique ES=selecteur PSP SP=haut   }
    { de pile. En SORTIE (ce que cette branche doit poser) : AX=selecteur  }
    { PSP (0=echec) BX=offset ligne de commande CX=limite de pile          }
    { DX=nCmdShow BP=haut de pile (pour deroulement) ES=selecteur ligne de }
    { commande - SI/DI/DS/SS INCHANGES (passes tels quels dans les deux    }
    { sens d'apres la meme source). }
    P.CPU.Regs.AX := 1;                  { PSP/selecteur non nul = succes }
    { Ligne de commande vide : chaine DOS classique longueur-prefixee,     }
    { ecrite a l offset 0 du segment de donnees (jamais lu par un          }
    { programme normal a cet endroit precis, avant toute autre init). }
    Emu_WriteByte(P.CPU, P.CPU.Segs.DS, 0, 0);
    P.CPU.Regs.BX := 0;
    P.CPU.Regs.CX := 0;
    P.CPU.Regs.DX := 1;                  { nCmdShow = SW_SHOWNORMAL        }
    P.CPU.Regs.BP := P.CPU.Regs.SP;
    P.CPU.Segs.ES := P.CPU.Segs.DS;
    ArgWords := 0;
   End;
   3: Begin
    { GetVersion - AL=version majeure, AH=version mineure (convention      }
    { confirmee par de tres nombreux exemples de code source Windows 2.x/  }
    { 3.x publics qui decodent AX de cette facon des le retour). }
    P.CPU.Regs.AX := $0002; { "Windows 2.0" : AL=2 AH=0 }
    ArgWords := 0;
   End;
   5: Begin
    { LocalAlloc(wFlags, wBytes):word - ordinal verifie via le fichier      }
    { .spec public de Wine (krnl386.exe16.spec : "5 pascal -ret16           }
    { LocalAlloc(word word) LocalAlloc16"). Convention pascal - arguments   }
    { pousses gauche-a-droite, donc wBytes (2e param) est au sommet de la   }
    { pile (SP+4, juste au-dessus de l'adresse de retour CS:IP) et wFlags   }
    { (1er param) juste en-dessous (SP+6). Simplification DOCUMENTEE (meme  }
    { esprit que les segments MOVEABLE/DISCARDABLE deja hors de portee) :   }
    { le "handle" retourne est TOUJOURS directement l'offset reel du bloc   }
    { (semantique LMEM_FIXED) - wFlags (MOVEABLE/ZEROINIT/...) est ignore.  }
    { Bump allocator dans le tas local reserve par Win16_LoadNE - jamais    }
    { libere (LocalFree non implante) : suffisant pour une premiere         }
    { iteration reelle (Stage 5), a etendre si un vrai programme le exige.  }
    LocalWBytes := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    If (LongInt(Win16_HeapNext) + LongInt(LocalWBytes)) > LongInt(Win16_HeapLimit) Then
     P.CPU.Regs.AX := 0   { echec honnete : tas local epuise }
    Else Begin
     P.CPU.Regs.AX := Win16_HeapNext;
     Win16_HeapNext := Win16_HeapNext + LocalWBytes;
    End;
    ArgWords := 2;
   End;
   7: Begin
    { LocalFree(hMem):word - ordinal verifie via krnl386.exe16.spec.        }
    { Retourne NULL(0) en cas de succes, le handle lui-meme en cas          }
    { d'echec (convention reelle). Simplification DOCUMENTEE, coherente     }
    { avec LocalAlloc (ordinal 5) ci-dessus : le tas local est un bump      }
    { allocator qui ne recupere JAMAIS la memoire liberee - LocalFree       }
    { rapporte donc toujours un succes SANS rien liberer reellement (aucun }
    { programme normal ne peut distinguer ce cas d'un vrai free tant qu'il }
    { ne re-epuise pas completement le tas, deja documente comme limite). }
    P.CPU.Regs.AX := 0;
    ArgWords := 1;
   End;
   60: Begin
    { FindResource(hInstance, lpName, lpType):HRSRC - ordinal VERIFIE via   }
    { krnl386.exe16.spec. hInstance ignore (une seule instance). lpName et  }
    { lpType sont CHACUN soit un entier MAKEINTRESOURCE (segment=0, mot bas}
    { = l'identifiant), soit un VRAI pointeur far vers une chaine ANSI      }
    { terminee par NUL DANS LA MEMOIRE DU PROGRAMME (segment<>0) - lu ICI   }
    { depuis la memoire emulee (donnees runtime, PAS le fichier). La table }
    { de ressources elle-meme peut AUSSI nommer ses types/ID par chaine     }
    { (voir Win16_ResourceIdMatches) - observe REELLEMENT dans CLOCK.EXE    }
    { (ressource personnalisee nommee, ni RT_STRING ni aucun type          }
    { systeme). Simplification DOCUMENTEE : un seul "emplacement de        }
    { stockage" pour la derniere ressource trouvee (pas de vraie table de  }
    { handles) - suffisant tant qu'un programme n'entrelace pas plusieurs  }
    { FindResource avant leur LoadResource respectif. }
    FRNameOfs := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 8));
    FRNameSeg := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 10));
    FRTypeOfs := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    FRTypeSeg := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 6));
    FRNameIsInt := (FRNameSeg = 0);
    FRTypeIsInt := (FRTypeSeg = 0);
    FRNameStr := '';
    If Not FRNameIsInt Then Begin
     FRI := 0;
     While FRI < 255 Do Begin
      FRByte := Emu_ReadByte(P.CPU, FRNameSeg, Word(FRNameOfs + FRI));
      If FRByte = 0 Then Break;
      FRNameStr := FRNameStr + Chr(FRByte);
      Inc(FRI);
     End;
    End;
    FRTypeStr := '';
    If Not FRTypeIsInt Then Begin
     FRI := 0;
     While FRI < 255 Do Begin
      FRByte := Emu_ReadByte(P.CPU, FRTypeSeg, Word(FRTypeOfs + FRI));
      If FRByte = 0 Then Break;
      FRTypeStr := FRTypeStr + Chr(FRByte);
      Inc(FRI);
     End;
    End;
    Win16_LastRsrcFound := Win16_FindResourceGeneric(
     FRTypeIsInt, Word($8000 Or FRTypeOfs), FRTypeStr,
     FRNameIsInt, Word($8000 Or FRNameOfs), FRNameStr,
     Win16_LastRsrcFileOfs, Win16_LastRsrcLen);
    If Win16_LastRsrcFound Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
    ArgWords := 5;
   End;
   61: Begin
    { LoadResource(hInstance, hResInfo):HGLOBAL - ignore les 2 arguments    }
    { (simplification a un seul "emplacement de stockage", voir ordinal    }
    { 60) - alloue Win16_LastRsrcLen octets dans le tas local (MEME bump    }
    { allocator que LocalAlloc) et y copie les VRAIS octets du fichier a    }
    { l'emplacement trouve par le FindResource precedent. Handle retourne  }
    { = offset reel direct (meme simplification LMEM_FIXED que LocalAlloc).}
    If Not Win16_LastRsrcFound Then
     P.CPU.Regs.AX := 0
    Else Begin
     LRLen := Win16_LastRsrcLen;
     If LRLen > SizeOf(LRBuf) Then LRLen := SizeOf(LRBuf);
     If (LongInt(Win16_HeapNext) + LRLen) > LongInt(Win16_HeapLimit) Then
      P.CPU.Regs.AX := 0
     Else Begin
      {$I-} Assign(LRFile, Win16_LoadedPath); Reset(LRFile, 1); {$I+}
      If IOResult <> 0 Then
       P.CPU.Regs.AX := 0
      Else Begin
       Seek(LRFile, Win16_LastRsrcFileOfs);
       BlockRead(LRFile, LRBuf, Word(LRLen), LRBytesRead);
       Close(LRFile);
       For LRI := 0 To LRLen - 1 Do
        Emu_WriteByte(P.CPU, Win16_StackSeg, Word(Win16_HeapNext + LRI), LRBuf[LRI]);
       P.CPU.Regs.AX := Win16_HeapNext;
       Win16_HeapNext := Win16_HeapNext + Word(LRLen);
      End;
     End;
    End;
    ArgWords := 2;
   End;
   62: Begin
    { LockResource(hResData):far ptr - PAS de "-ret16" dans le .spec =      }
    { retour COMPLET en DX:AX (segment:offset), pas juste AX. Handle deja   }
    { simplifie en offset direct (LMEM_FIXED, voir ordinal 61) : identite - }
    { retourne ce meme offset avec le segment du tas local (Win16_StackSeg).}
    P.CPU.Regs.AX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    P.CPU.Regs.DX := Win16_StackSeg;
    ArgWords := 1;
   End;
   63: Begin
    { FreeResource(hResData):bool - meme simplification que LocalFree       }
    { (ordinal 7) : le tas local est un bump allocator qui ne recupere      }
    { JAMAIS la memoire - rapporte toujours un succes (NULL) sans rien      }
    { liberer reellement. }
    P.CPU.Regs.AX := 0;
    ArgWords := 1;
   End;
   65: Begin
    { SizeofResource(hInstance, hResInfo):DWORD - PAS de "-ret16" = retour  }
    { COMPLET DX:AX (taille en octets). Ignore les 2 arguments             }
    { (simplification a un seul emplacement de stockage, voir ordinal 60). }
    If Win16_LastRsrcFound Then Begin
     P.CPU.Regs.AX := Word(Win16_LastRsrcLen And $FFFF);
     P.CPU.Regs.DX := Word((Win16_LastRsrcLen Shr 16) And $FFFF);
    End Else Begin
     P.CPU.Regs.AX := 0;
     P.CPU.Regs.DX := 0;
    End;
    ArgWords := 2;
   End;
   15: Begin
    { GlobalAlloc(wFlags, dwBytes):word - ordinal VERIFIE via                }
    { krnl386.exe16.spec (dwBytes est un LONG = 2 mots, mot bas lu ici -    }
    { notre tas local etant minuscule, une VRAIE allocation >64Ko            }
    { echouerait honnetement de toute facon). Le tas "global" et le tas     }
    { "local" sont TRAITES DE FACON IDENTIQUE dans cette simplification     }
    { (meme bump allocator Win16_HeapNext/Win16_HeapLimit que LocalAlloc,   }
    { ordinal 5 ci-dessus) - simplification DOCUMENTEE, coherente avec le   }
    { modele "handle = offset direct" deja utilise partout dans ce          }
    { chantier. }
    LocalWBytes := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    If (LongInt(Win16_HeapNext) + LongInt(LocalWBytes)) > LongInt(Win16_HeapLimit) Then
     P.CPU.Regs.AX := 0
    Else Begin
     P.CPU.Regs.AX := Win16_HeapNext;
     Win16_HeapNext := Win16_HeapNext + LocalWBytes;
    End;
    ArgWords := 3;
   End;
   17: Begin
    { GlobalFree(hMem):word - ordinal VERIFIE. Meme simplification que      }
    { LocalFree (ordinal 7) : le tas est un bump allocator qui ne recupere  }
    { JAMAIS la memoire - rapporte toujours un succes. }
    P.CPU.Regs.AX := 0;
    ArgWords := 1;
   End;
   18: Begin
    { GlobalLock(hMem):far ptr - ordinal VERIFIE. PAS de "-ret16" = retour  }
    { COMPLET DX:AX. Handle deja simplifie en offset direct (LMEM_FIXED,    }
    { voir LocalAlloc/ordinal 5) : identite - retourne ce meme offset avec  }
    { le segment du tas (Win16_StackSeg). }
    P.CPU.Regs.AX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    P.CPU.Regs.DX := Win16_StackSeg;
    ArgWords := 1;
   End;
   19: Begin
    { GlobalUnlock(hMem):bool - ordinal VERIFIE. Rapporte toujours un       }
    { succes (aucun VRAI verrou a lever, handle=offset direct). }
    P.CPU.Regs.AX := 1;
    ArgWords := 1;
   End;
   21: Begin
    { GlobalHandle(wMem):DWORD (HIWORD=hInstance module, LOWORD=hMem) -     }
    { ordinal VERIFIE. PAS de "-ret16" = retour COMPLET DX:AX. Simplifie :  }
    { hInstance synthetique = Win16_StackSeg (notre seul "module" charge),  }
    { hMem inchange (identite, meme modele que GlobalLock). }
    P.CPU.Regs.AX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    P.CPU.Regs.DX := Win16_StackSeg;
    ArgWords := 1;
   End;
   30: Begin
    { WaitEvent(hTask):bool - ordinal verifie via Wine (krnl386.exe16.spec  }
    { + task.c, source publique) : bloque la tache appelante jusqu'a ce     }
    { qu'une AUTRE tache appelle PostEvent pour elle (ordonnancement        }
    { cooperatif Windows 2.x/3.x), sauf si un evenement est deja en         }
    { attente (pTask->nEvents>0), auquel cas elle retourne FALSE            }
    { IMMEDIATEMENT sans bloquer. VRAIE LIMITE DE CONCEPTION documentee :   }
    { cet emulateur n'execute jamais qu'UNE seule tache Win16 a la fois     }
    { (voir l'etat global Win16_* - meme limitation que LX_Mem/ELF64) -     }
    { aucune autre tache ne peut donc JAMAIS appeler PostEvent, et un        }
    { blocage reel bloquerait le programme pour toujours. Simplification    }
    { choisie : toujours emprunter le chemin "evenement deja present"       }
    { (retour FALSE immediat, sans jamais attendre) - n'affecte que le      }
    { TIMING (equivalent a un vrai scheduler qui aurait poste l'evenement   }
    { au tick suivant), jamais l'etat/les donnees du programme. }
    P.CPU.Regs.AX := 0; { FALSE - evenement deja "present", pas d'attente }
    ArgWords := 1;      { WaitEvent(hTask) : un seul parametre. }
   End;
   51: Begin
    { MakeProcInstance(lpProc,hInstance):FARPROC - ordinal VERIFIE via       }
    { krnl386.exe16.spec (segptr + 1 mot = 3 mots). Stage 6b (2026-08-30) :  }
    { un VRAI MakeProcInstance fabrique un thunk qui fixe DS a hInstance     }
    { avant de sauter au vrai code - necessaire seulement quand PLUSIEURS    }
    { instances du meme programme (donc plusieurs DS possibles) coexistent. }
    { Ce chantier reste mono-programme/mono-instance (meme limitation deja  }
    { assumee partout ailleurs - Win16_ImportModIdx[] etc.), donc il ne peut }
    { jamais y avoir qu'un seul DS possible : retourne lpProc INCHANGE,      }
    { aucun VRAI thunk d'instance necessaire. }
    P.CPU.Regs.AX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 6));
    P.CPU.Regs.DX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 8));
    ArgWords := 3;
   End;
   Else Begin
    Win16_Halt(P, 'KERNEL', Ordinal);
    Exit;
   End;
  End;
 End Else If ModIdx = 3 Then Begin { USER }
  Case Ordinal Of
   5: Begin
    { InitApp(hInstance):bool - ordinal verifie via le fichier .spec public }
    { de Wine (user.exe16.spec : "5 pascal -ret16 InitApp(word) InitApp16")}
    { - deuxieme etape d'initialisation classique d'un programme Windows,  }
    { explicitement anticipee dans le plan de ce chantier. D'apres la      }
    { documentation SDK Windows historique (Petzold, "Programming          }
    { Windows") : simple bookkeeping interne cote USER (traceurs de tache/ }
    { d'instance), appelee UNE fois avant toute creation de fenetre -      }
    { reussit TOUJOURS en pratique (echec seulement en cas de memoire      }
    { epuisee, non modelise ici). Retourne juste TRUE. }
    P.CPU.Regs.AX := 1;
    ArgWords := 1;
   End;
   173, 174, 175: Begin
    { LoadCursor(173)/LoadIcon(174)/LoadBitmap(175)(hInstance, lpName):     }
    { handle - 3 ordinaux VERIFIES via user.exe16.spec, MEME signature      }
    { exacte tous les trois ("word str"). Rendu GDI reel HORS DE PORTEE     }
    { (stretch goal Stage 6, jamais commence) - simplification DOCUMENTEE :}
    { retourne un handle SYNTHETIQUE non-nul (le mot bas du pointeur/       }
    { MAKEINTRESOURCE passe, quasi-toujours non-nul en pratique - un        }
    { ressource systeme comme IDC_ARROW=$7F00 ou un vrai nom de ressource   }
    { ont tous deux un offset non-nul) plutot que d'echouer honnetement -   }
    { echouer (retourner 0) casserait immediatement RegisterClass qui       }
    { accepte normalement ces handles sans jamais les deferencer avant un   }
    { vrai rendu (hors de portee ici de toute facon). AUCUNE donnee         }
    { d'image/curseur reelle n'est chargee. }
    P.CPU.Regs.AX := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(P.CPU.Regs.SP + 4));
    If P.CPU.Regs.AX = 0 Then P.CPU.Regs.AX := 1;
    ArgWords := 3;
   End;
   176: Begin
    { LoadString(hInstance, resource_id, lpBuffer, buflen):int - ordinal    }
    { verifie via user.exe16.spec ; comportement REPRODUIT depuis le vrai   }
    { code source de Wine (dlls/user.exe16/user.c, LoadString16 - recupere  }
    { via recherche web, PAS devine) : le bloc de ressource RT_STRING       }
    { (=6, confirme via winuser.h) porte l'ID (resource_id shr 4)+1 et      }
    { contient 16 chaines Pascal-style consecutives (1 octet de longueur +  }
    { N octets ANSI, PAS Unicode - convention Win16 propre, differente du   }
    { format Win32/PE plus recent) ; resource_id and $F choisit laquelle    }
    { des 16. Convention pascal - hInstance pousse en 1er (le plus loin de  }
