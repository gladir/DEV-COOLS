   Exit;
  End;
  If OptionsDlg.Data.EmuShowDebugMessages Then Begin
   P.CurFg := 10;
   EmuVScr_WriteStr(P, 'Binaire NE charge : ' +
    IntToStr(Win16_SegCount) + ' segment(s), ' +
    IntToStr(Win16_ImportSlotCount) + ' import(s) resolu(s).');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   P.CurFg := 7;
   EmuVScr_WriteStr(P, 'Point d''entree   : ' +
    HexWord(Win16_EntryPointSeg) + ':' + HexWord(Win16_EntryPointOfs));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'Pile initiale    : ' +
    HexWord(Win16_StackSeg) + ':' + HexWord(Win16_StackOfs));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  End;
  { Convention reelle de demarrage d un programme Win16 (voir Raymond Chen, }
  { "How do 16-bit programs start up?" - deja utilise/verifie au Stage 3),  }
  { factorisee dans Win16_SetupEntryRegs (partagee avec WIN16RUN, Stage 5). }
  Win16_SetupEntryRegs(P.CPU);
  P.CPU.Fault := sfNone;
  { Meme init peripherique 8086 que le backend DOS -CD juste plus bas       }
  { (DOS_RunOneChunk, partage sans changement par les deux backends,        }
  { s attend a un BDA/IVT/etc. valides - voir le commentaire de tete de     }
  { DOS_RunOneChunk pour le detail de chaque sous-systeme). }
  Emu_InitBDA(P);
  Emu_IpxInit(P);
  Emu_PktInit(P);
  Emu_XmsInit(P);
  Emu_EmsInit(P);
  Emu_MouseInit(P);
  Emu_MscdexInit(P);
  Emu_DpmiInit(P);
  Emu_DefaultVectorsInit(P);
  { Chantier Stage 6 (2026-08-29, sur demande explicite de l'utilisateur   }
  { - "par defaut... mode graphique, pas mode texte") : bascule REELLEMENT}
  { en mode video graphique VGA des le demarrage, via LE MEME mecanisme    }
  { qu'un vrai programme DOS (Emu_VidSetMode, normalement atteint via INT  }
  { 10h AH=00h - voir Emu_DoInt10) - un vrai Windows 2.x/3.x bascule       }
  { aussi en graphique des son demarrage sur une carte VGA. Mode $13       }
  { (320x200x256 couleurs) choisi : format le PLUS simple (8 bits/pixel    }
  { lineaire "chain-four", PAS de plans comme les modes EGA/VGA 16         }
  { couleurs) et deja le mieux exerce dans ce fichier                      }
  { (Emu_VidSetPixel/Emu_VidPixelToBGI ont un cas dedie pour ce mode       }
  { precis). GetDeviceCaps/GetSystemMetrics (Stage 5/6a) rapportent deja   }
  { des dimensions assorties (a ajuster a 320x200 - voir plus loin dans ce }
  { fichier) pour que les coordonnees GDI du programme correspondent       }
  { DIRECTEMENT aux pixels reels, sans mise a l'echelle. }
  Emu_VidSetMode($13, P);
  DrawEmulatorPanel(P);
  EmuDbg.Active := True;
  EmuDbg.CPU    := EDC_8086;
  EmuHasFocus := True;
  EmuLastActiveState := True;
