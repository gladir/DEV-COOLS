          {$I-}
          FindFirst(HPath, AnyFile, SR);
          IORes := DosError;
          FindClose(SR);
          {$I+}
          If IOResult <> 0 Then ;
          If IORes = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
