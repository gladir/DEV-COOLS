{ --- Mettre a jour le panneau de proprietes docke en fonction du     }
{ noeud selectionne dans l explorateur de solution (projet, fichier,  }
{ solution, reference). Appelee a chaque changement de selection,     }
{ souris ou clavier.                                                   }

Procedure UpdatePropsPanelForExplorerNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer);
Var
 Kind: TExplorerNodeKind;
 Idx: Integer;
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Begin
  ClearPropertiesPanel(PropsPanel);
  Exit;
 End;
 Kind := Exp.Nodes[NodeIdx].Kind;
 Case Kind Of
  ENK_SOLUTION:
   If SolutionLoaded Then
    SetPropertySourceSolution(PropsPanel, CurrentSolution)
   Else
    ClearPropertiesPanel(PropsPanel);
  ENK_PROJECT:
   If SolutionLoaded Then
    SetPropertySourceProject(PropsPanel, CurrentProject)
   Else
    ClearPropertiesPanel(PropsPanel);
  ENK_FILE_CS, ENK_FILE_VB, ENK_FILE_PAS, ENK_FILE_FRM, ENK_FILE_OTHER: Begin
   If SolutionLoaded Then Begin
    Idx := FindFileInProject(CurrentProject, Exp.Nodes[NodeIdx].RelPath);
    If Idx >= 0 Then
     SetPropertySourceFile(PropsPanel, CurrentProject.Files[Idx])
    Else
     ClearPropertiesPanel(PropsPanel);
   End Else
    ClearPropertiesPanel(PropsPanel);
  End;
  ENK_REFERENCE: Begin
   If SolutionLoaded Then Begin
    Idx := FindReferenceInProject(CurrentProject,
     Exp.Nodes[NodeIdx].Caption);
    If Idx >= 0 Then
     SetPropertySourceReference(PropsPanel, CurrentProject.Refs[Idx])
    Else
     ClearPropertiesPanel(PropsPanel);
   End Else
    ClearPropertiesPanel(PropsPanel);
  End;
 Else
  ClearPropertiesPanel(PropsPanel);
 End;
End;

{ --- Valeur suivante dans le cycle d une propriete enumeree --- }

Function CycleEnumValue(Key, CurValue: String): String;
Begin
 If Key = 'OUTPUTTYPE' Then Begin
  If CurValue = 'Exe' Then CycleEnumValue := 'Library'
  Else If CurValue = 'Library' Then CycleEnumValue := 'WinExe'
  Else CycleEnumValue := 'Exe';
 End Else If Key = 'BUILDACTION' Then Begin
  If CurValue = 'Compile' Then CycleEnumValue := 'Content'
  Else If CurValue = 'Content' Then CycleEnumValue := 'None'
  Else If CurValue = 'None' Then CycleEnumValue := 'EmbeddedResource'
  Else CycleEnumValue := 'Compile';
 End Else
  CycleEnumValue := CurValue;
End;

{ --- Appliquer la modification d une propriete de controle de        }
{ formulaire : met a jour ActiveFormEditor et reecrit le .FRM sur      }
{ disque immediatement (comme le depot d un nouveau controle).        }

Procedure ApplyFrmControlPropertyCommit(Key, NewVal: String);
Var
 Idx: Integer;
 OldName, PropName: String;
 NewNum: LongInt;
Begin
 If (ActiveFormEditor.SelectedCtl < 0) Or
    (ActiveFormEditor.SelectedCtl >= ActiveFormEditor.ControlCount) Then
  Exit;
 Idx := ActiveFormEditor.SelectedCtl;
 If Key = 'CTLNAME' Then Begin
  If (Length(NewVal) = 0) Or
     (NewVal = ActiveFormEditor.Controls[Idx].Name) Then Exit;
  OldName := ActiveFormEditor.Controls[Idx].Name;
  RenameFrmControl(ActiveFormEditor.FileName, OldName, NewVal);
  ActiveFormEditor.Controls[Idx].Name := NewVal;
 End Else If Key = 'CTLCAPTION' Then Begin
  PropName := FrmCaptionPropName(ActiveFormEditor.Controls[Idx].TypeStr);
  UpdateFrmControlProperty(ActiveFormEditor.FileName,
   ActiveFormEditor.Controls[Idx].Name, PropName, NewVal, True);
  ActiveFormEditor.Controls[Idx].Caption := NewVal;
 End Else If Key = 'CTLLEFT' Then Begin
  NewNum := FRMVisValInt(NewVal);
  UpdateFrmControlProperty(ActiveFormEditor.FileName,
   ActiveFormEditor.Controls[Idx].Name, 'Left', IntToStr(NewNum), False);
  ActiveFormEditor.Controls[Idx].CtlLeft := NewNum;
 End Else If Key = 'CTLTOP' Then Begin
  NewNum := FRMVisValInt(NewVal);
  UpdateFrmControlProperty(ActiveFormEditor.FileName,
   ActiveFormEditor.Controls[Idx].Name, 'Top', IntToStr(NewNum), False);
  ActiveFormEditor.Controls[Idx].CtlTop := NewNum;
 End Else If Key = 'CTLWIDTH' Then Begin
  NewNum := FRMVisValInt(NewVal);
  UpdateFrmControlProperty(ActiveFormEditor.FileName,
   ActiveFormEditor.Controls[Idx].Name, 'Width', IntToStr(NewNum), False);
  ActiveFormEditor.Controls[Idx].CtlWidth := NewNum;
 End Else If Key = 'CTLHEIGHT' Then Begin
  NewNum := FRMVisValInt(NewVal);
  UpdateFrmControlProperty(ActiveFormEditor.FileName,
   ActiveFormEditor.Controls[Idx].Name, 'Height', IntToStr(NewNum), False);
  ActiveFormEditor.Controls[Idx].CtlHeight := NewNum;
 End;
 If (WinMgr.ActiveIdx >= 0) And
    (FormEditors[WinMgr.ActiveIdx] <> Nil) Then
  FormEditors[WinMgr.ActiveIdx]^ := ActiveFormEditor;
End;

{ --- Appliquer la modification d une propriete au donnee reelle       }
{ correspondante (projet/fichier/controle de formulaire) et persister  }
{ immediatement sur disque. Les proprietes en lecture seule ou sans    }
{ cle stable n ont aucun effet ici. --- }

Procedure ApplyPropertyCommit(Var PP: TPropertiesPanel; Idx: Integer;
 NewVal: String);
Var
 Key: String;
 FileIdx: Integer;
Begin
 If (Idx < 0) Or (Idx >= PP.ItemCount) Then Exit;
 Key := PP.Items[Idx].Key;
 If Key = '' Then Exit;
 Case PP.SourceKind Of
  PK_PROJECT: Begin
   If Key = 'ASSEMBLYNAME' Then
    CurrentProject.Info.AssemblyName := NewVal
   Else If Key = 'ROOTNAMESPACE' Then
    CurrentProject.Info.RootNamespace := NewVal
   Else If Key = 'OUTPUTPATH' Then
    CurrentProject.Info.OutputPath := NewVal
   Else If Key = 'DEFINECONST' Then
    CurrentProject.Info.DefineConstants := NewVal
   Else If Key = 'OUTPUTTYPE' Then Begin
    If NewVal = 'Exe' Then
     CurrentProject.Info.OutputType := OT_EXE
    Else If NewVal = 'Library' Then
     CurrentProject.Info.OutputType := OT_LIBRARY
    Else If NewVal = 'WinExe' Then
     CurrentProject.Info.OutputType := OT_WINEXE;
   End Else
    Exit;
   If SolutionLoaded Then Begin
    SolutionModified := True;
    SaveCurrentSolution;
   End;
  End;
  PK_FILE: Begin
   FileIdx := FindFileInProject(CurrentProject, PP.SourceTitle);
   If FileIdx < 0 Then Exit;
   If Key = 'BUILDACTION' Then Begin
    If NewVal = 'Compile' Then
     CurrentProject.Files[FileIdx].BuildAction := BA_COMPILE
    Else If NewVal = 'Content' Then
     CurrentProject.Files[FileIdx].BuildAction := BA_CONTENT
    Else If NewVal = 'None' Then
     CurrentProject.Files[FileIdx].BuildAction := BA_NONE
    Else If NewVal = 'EmbeddedResource' Then
     CurrentProject.Files[FileIdx].BuildAction := BA_EMBEDDED_RESOURCE;
   End Else
    Exit;
   If SolutionLoaded Then Begin
    SolutionModified := True;
    SaveCurrentSolution;
   End;
  End;
  PK_FRM_CONTROL: ApplyFrmControlPropertyCommit(Key, NewVal);
 End;
End;

{ --- Faire cycler une propriete enumeree (clic simple sur la valeur) --- }

Procedure CyclePropertyEnum(Var PP: TPropertiesPanel; Idx: Integer);
Var
 NewVal: String;
Begin
 If (Idx < 0) Or (Idx >= PP.ItemCount) Then Exit;
 If PP.Items[Idx].ReadOnly Or (Not PP.Items[Idx].IsEnum) Then Exit;
 NewVal := CycleEnumValue(PP.Items[Idx].Key, PP.Items[Idx].Value);
 ApplyPropertyCommit(PP, Idx, NewVal);
 PP.Items[Idx].Value := NewVal;
 PP.NeedRepaint := True;
End;

{ --- Definir la source generique --- }

Procedure SetPropertySource(Var PP: TPropertiesPanel;
 Kind: TPropertyKind; Title: String);
Begin
 ClearPropertiesPanel(PP);
 PP.SourceKind := Kind;
 PP.SourceTitle := Title;
 PP.NeedRepaint := True;
End;

{ --- Trier les proprietes par ordre alphabetique --- }

Procedure SortPropertiesAlpha(Var PP: TPropertiesPanel);
Var
 I, J: Integer;
 Temp: TPropertyItem;
Begin
 For I := 0 To PP.ItemCount - 2 Do
  For J := I + 1 To PP.ItemCount - 1 Do
   If PP.Items[I].Name > PP.Items[J].Name Then Begin
    Temp := PP.Items[I];
    PP.Items[I] := PP.Items[J];
    PP.Items[J] := Temp;
   End;
 PP.NeedRepaint := True;
End;

{ --- Trier les proprietes par categorie --- }

Procedure SortPropertiesByCategory(Var PP: TPropertiesPanel);
Var
 I, J: Integer;
 Temp: TPropertyItem;
Begin
 For I := 0 To PP.ItemCount - 2 Do
  For J := I + 1 To PP.ItemCount - 1 Do
   If (PP.Items[I].Category > PP.Items[J].Category) Or
      ((PP.Items[I].Category = PP.Items[J].Category) And
       (PP.Items[I].Name > PP.Items[J].Name)) Then Begin
    Temp := PP.Items[I];
    PP.Items[I] := PP.Items[J];
    PP.Items[J] := Temp;
   End;
 PP.NeedRepaint := True;
End;

{ --- Changer le mode de tri --- }

Procedure TogglePropertySort(Var PP: TPropertiesPanel);
Begin
 If PP.SortMode = PS_ALPHABETICAL Then Begin
  PP.SortMode := PS_CATEGORIZED;
  SortPropertiesByCategory(PP);
 End Else Begin
  PP.SortMode := PS_ALPHABETICAL;
  SortPropertiesAlpha(PP);
 End;
End;

{ --- Calculer le nombre de lignes visibles --- }

Function GetVisiblePropertyCount(Var PP: TPropertiesPanel): Integer;
Var
 Available: Integer;
Begin
 Available := PP.Height - PROPS_HEADER_HEIGHT;
 If Available < 0 Then
  Available := 0;
 GetVisiblePropertyCount := Available Div PROPS_ROW_HEIGHT;
End;

{ --- Dessiner l en-tete du panneau --- }

Procedure DrawPropertiesHeader(Var PP: TPropertiesPanel);
Begin
 SetColor(CLR_BORDER);
 Rectangle(PP.X, PP.Y, PP.X + PP.Width - 1,
  PP.Y + PROPS_HEADER_HEIGHT - 1);
 SetFillStyle(SolidFill, CLR_TOOLBAR);
 Bar(PP.X + 1, PP.Y + 1, PP.X + PP.Width - 2,
  PP.Y + PROPS_HEADER_HEIGHT - 2);
 SetColor(CLR_MENU_TEXT);
 If PP.SourceTitle <> '' Then
  OutTextXY(PP.X + 4, PP.Y + 4, PP.SourceTitle)
 Else
  OutTextXY(PP.X + 4, PP.Y + 4, 'Proprietes');
End;

{ --- Dessiner une ligne de propriete --- }

Procedure DrawPropertyRow(Var PP: TPropertiesPanel;
 Idx, RowY: Integer);
Var
 NameX, ValX: Integer;
Begin
 NameX := PP.X + 2;
 ValX := PP.X + PP.NameColWidth;
 { Fond de la ligne }
 If Idx = PP.SelectedIdx Then Begin
  SetFillStyle(SolidFill, CLR_SELECTION);
  Bar(PP.X + 1, RowY, PP.X + PP.Width - 2,
   RowY + PROPS_ROW_HEIGHT - 1);
  SetColor(15);
 End Else Begin
  SetFillStyle(SolidFill, CLR_EDITOR_BG);
  Bar(PP.X + 1, RowY, PP.X + PP.Width - 2,
   RowY + PROPS_ROW_HEIGHT - 1);
  SetColor(CLR_MENU_TEXT);
 End;
 { Nom }
 OutTextXY(NameX, RowY + 3, PP.Items[Idx].Name);
 { Separateur vertical }
 SetColor(CLR_BORDER);
 Line(ValX, RowY, ValX, RowY + PROPS_ROW_HEIGHT - 1);
 { Valeur }
 If Idx = PP.SelectedIdx Then
  SetColor(15)
 Else If PP.Items[Idx].ReadOnly Then
  SetColor(8)
 Else
  SetColor(CLR_EDITOR_TEXT);
 If PP.Items[Idx].Editing Then
  OutTextXY(ValX + 3, RowY + 3, PP.EditBuffer)
 Else If PP.Items[Idx].IsEnum And (Not PP.Items[Idx].ReadOnly) Then
  OutTextXY(ValX + 3, RowY + 3, PP.Items[Idx].Value + ' [v]')
 Else
  OutTextXY(ValX + 3, RowY + 3, PP.Items[Idx].Value);
 { Ligne horizontale }
 SetColor(CLR_BORDER);
 Line(PP.X, RowY + PROPS_ROW_HEIGHT - 1,
  PP.X + PP.Width - 1, RowY + PROPS_ROW_HEIGHT - 1);
End;

{ --- Dessiner le panneau de proprietes --- }

Procedure DrawPropertiesPanel(Var PP: TPropertiesPanel);
Var
 I, RowY, Visible: Integer;
Begin
 { Bordure du panneau }
 SetColor(CLR_BORDER);
 Rectangle(PP.X, PP.Y, PP.X + PP.Width - 1,
  PP.Y + PP.Height - 1);
 { Fond }
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(PP.X + 1, PP.Y + 1, PP.X + PP.Width - 2,
  PP.Y + PP.Height - 2);
 { En-tete }
 DrawPropertiesHeader(PP);
 { Lignes de proprietes }
 Visible := GetVisiblePropertyCount(PP);
 RowY := PP.Y + PROPS_HEADER_HEIGHT;
 For I := PP.ScrollTop To PP.ItemCount - 1 Do Begin
  If I - PP.ScrollTop >= Visible Then
   Break;
  DrawPropertyRow(PP, I, RowY);
  Inc(RowY, PROPS_ROW_HEIGHT);
 End;
 { Vider l espace restant }
 If RowY < PP.Y + PP.Height - 1 Then Begin
  SetFillStyle(SolidFill, CLR_EDITOR_BG);
  Bar(PP.X + 1, RowY, PP.X + PP.Width - 2,
   PP.Y + PP.Height - 2);
 End;
 PP.NeedRepaint := False;
End;

{ --- Tester si un clic est dans le panneau --- }

Function PropertiesPanelHitTest(Var PP: TPropertiesPanel;
 MX, MY: Integer): Boolean;
Begin
 PropertiesPanelHitTest :=
  (MX >= PP.X) And (MX < PP.X + PP.Width) And
  (MY >= PP.Y) And (MY < PP.Y + PP.Height);
End;

{ --- Tester si un clic est sur le splitter horizontal --- }

Function PropertiesSplitterHitTest(Var PP: TPropertiesPanel;
 MX, MY: Integer): Boolean;
Begin
 PropertiesSplitterHitTest :=
  (MX >= PP.X) And (MX < PP.X + PP.Width) And
  (MY >= PP.SplitterY) And
  (MY < PP.SplitterY + PROPS_SPLITTER_HEIGHT);
End;

{ --- Determiner quelle propriete a ete cliquee --- }

Function PropertyRowHitTest(Var PP: TPropertiesPanel;
 MY: Integer): Integer;
Var
 RelY, Row: Integer;
Begin
 RelY := MY - PP.Y - PROPS_HEADER_HEIGHT;
 If RelY < 0 Then Begin
  PropertyRowHitTest := -1;
  Exit;
 End;
 Row := RelY Div PROPS_ROW_HEIGHT + PP.ScrollTop;
 If Row >= PP.ItemCount Then
  PropertyRowHitTest := -1
 Else
  PropertyRowHitTest := Row;
End;

{ --- Commencer l edition d une propriete --- }

Procedure BeginPropertyEdit(Var PP: TPropertiesPanel;
 Idx: Integer);
Begin
 If (Idx < 0) Or (Idx >= PP.ItemCount) Then Exit;
 If PP.Items[Idx].ReadOnly Or PP.Items[Idx].IsEnum Then Exit;
 If PP.EditActive And (PP.SelectedIdx >= 0) And
    (PP.SelectedIdx < PP.ItemCount) Then
  PP.Items[PP.SelectedIdx].Editing := False;
 PP.SelectedIdx := Idx;
 PP.Items[Idx].Editing := True;
 PP.EditBuffer := PP.Items[Idx].Value;
 PP.EditActive := True;
 PP.NeedRepaint := True;
End;

{ --- Annuler l edition en cours --- }

Procedure CancelPropertyEdit(Var PP: TPropertiesPanel);
Begin
 If PP.EditActive And (PP.SelectedIdx >= 0) And
    (PP.SelectedIdx < PP.ItemCount) Then
  PP.Items[PP.SelectedIdx].Editing := False;
 PP.EditActive := False;
 PP.EditBuffer := '';
 PP.NeedRepaint := True;
End;

{ --- Confirmer l edition en cours --- }

Procedure CommitPropertyEdit(Var PP: TPropertiesPanel);
Begin
 If PP.EditActive And (PP.SelectedIdx >= 0) And
    (PP.SelectedIdx < PP.ItemCount) Then Begin
  If PP.EditBuffer <> PP.Items[PP.SelectedIdx].Value Then
   ApplyPropertyCommit(PP, PP.SelectedIdx, PP.EditBuffer);
  PP.Items[PP.SelectedIdx].Value := PP.EditBuffer;
  PP.Items[PP.SelectedIdx].Editing := False;
 End;
 PP.EditActive := False;
 PP.EditBuffer := '';
 PP.NeedRepaint := True;
End;

{ --- Gerer les evenements du panneau de proprietes --- }

Procedure HandlePropertiesEvent(Var PP: TPropertiesPanel;
 Ev: TEvent);
Var
 Row, NewY, Visible, OldBottom: Integer;
Begin
 Case Ev.Kind Of
  EV_MOUSE_DOWN: Begin
   { Splitter horizontal }
   If PropertiesSplitterHitTest(PP, Ev.MouseX, Ev.MouseY) Then Begin
    PP.Dragging := True;
    Exit;
   End;
   { Clic dans le panneau }
   If PropertiesPanelHitTest(PP, Ev.MouseX, Ev.MouseY) Then Begin
    Row := PropertyRowHitTest(PP, Ev.MouseY);
    If Row >= 0 Then Begin
     If PP.EditActive Then
      CommitPropertyEdit(PP);
     PP.SelectedIdx := Row;
     If PP.Items[Row].IsEnum And (Not PP.Items[Row].ReadOnly) And
        (Ev.MouseX >= PP.X + PP.NameColWidth) Then
      CyclePropertyEnum(PP, Row);
     PP.NeedRepaint := True;
    End;
   End;
  End;
  EV_MOUSE_DBLCLICK: Begin
   If PropertiesPanelHitTest(PP, Ev.MouseX, Ev.MouseY) Then Begin
    Row := PropertyRowHitTest(PP, Ev.MouseY);
    If Row >= 0 Then
     BeginPropertyEdit(PP, Row);
   End;
  End;
  EV_MOUSE_UP: Begin
   PP.Dragging := False;
  End;
  EV_MOUSE_MOVE: Begin
   If PP.Dragging Then Begin
    OldBottom := PP.Y + PP.Height;
    NewY := Ev.MouseY;
    PP.Height := OldBottom - NewY;
    If PP.Height < PROPS_MIN_HEIGHT Then
     PP.Height := PROPS_MIN_HEIGHT;
    If PP.Height > PROPS_MAX_HEIGHT Then
     PP.Height := PROPS_MAX_HEIGHT;
    PP.Y := OldBottom - PP.Height;
    PP.SplitterY := PP.Y - PROPS_SPLITTER_HEIGHT;
    { Garder l explorateur de solution adjacent, sans le chevaucher }
    SolExplorer.Height := PP.SplitterY - SolExplorer.Y;
    If SolExplorer.Height < EXPLORER_NODE_HEIGHT Then
     SolExplorer.Height := EXPLORER_NODE_HEIGHT;
    SolExplorer.NeedRepaint := True;
    PP.NeedRepaint := True;
   End;
  End;
  EV_KEY_CHAR: Begin
   If PP.EditActive Then Begin
    Case Ev.KeyChar Of
     #13: CommitPropertyEdit(PP);
     #27: CancelPropertyEdit(PP);
     #8:  Begin
           If Length(PP.EditBuffer) > 0 Then
            Delete(PP.EditBuffer, Length(PP.EditBuffer), 1);
           PP.NeedRepaint := True;
          End;
    Else
     If (Ev.KeyChar >= ' ') And
        (Length(PP.EditBuffer) < 255) Then Begin
      PP.EditBuffer := PP.EditBuffer + Ev.KeyChar;
      PP.NeedRepaint := True;
     End;
    End;
   End;
  End;
  EV_KEY_DOWN: Begin
   If Not PP.EditActive Then Begin
    Visible := GetVisiblePropertyCount(PP);
    Case Ev.KeyCode Of
     $50: Begin { Fleche bas }
      If PP.SelectedIdx < PP.ItemCount - 1 Then Begin
       Inc(PP.SelectedIdx);
       If PP.SelectedIdx >= PP.ScrollTop + Visible Then
        Inc(PP.ScrollTop);
       PP.NeedRepaint := True;
      End;
     End;
     $48: Begin { Fleche haut }
      If PP.SelectedIdx > 0 Then Begin
       Dec(PP.SelectedIdx);
       If PP.SelectedIdx < PP.ScrollTop Then
        PP.ScrollTop := PP.SelectedIdx;
       PP.NeedRepaint := True;
      End;
     End;
     $47: Begin { Home }
      PP.SelectedIdx := 0;
      PP.ScrollTop := 0;
      PP.NeedRepaint := True;
     End;
     $4F: Begin { End }
      PP.SelectedIdx := PP.ItemCount - 1;
      If PP.SelectedIdx >= Visible Then
       PP.ScrollTop := PP.SelectedIdx - Visible + 1
      Else
       PP.ScrollTop := 0;
      PP.NeedRepaint := True;
     End;
     $1C: Begin { Enter }
      If (PP.SelectedIdx >= 0) And
         (PP.SelectedIdx < PP.ItemCount) Then
       BeginPropertyEdit(PP, PP.SelectedIdx);
     End;
    End;
   End;
  End;
 End;
End;

{ --- Trouver une propriete par nom --- }

Function FindProperty(Var PP: TPropertiesPanel;
 AName: String): Integer;
Var
 I: Integer;
Begin
 FindProperty := -1;
 For I := 0 To PP.ItemCount - 1 Do
  If PP.Items[I].Name = AName Then Begin
   FindProperty := I;
   Exit;
  End;
End;

{ --- Modifier la valeur d une propriete --- }

Function SetPropertyValue(Var PP: TPropertiesPanel;
 AName, AValue: String): Boolean;
Var
 Idx: Integer;
Begin
 Idx := FindProperty(PP, AName);
 If Idx < 0 Then Begin
  SetPropertyValue := False;
  Exit;
 End;
 PP.Items[Idx].Value := AValue;
 PP.NeedRepaint := True;
 SetPropertyValue := True;
End;

{ --- Obtenir la valeur d une propriete --- }

Function GetPropertyValue(Var PP: TPropertiesPanel;
 AName: String): String;
Var
 Idx: Integer;
Begin
 Idx := FindProperty(PP, AName);
 If Idx >= 0 Then
  GetPropertyValue := PP.Items[Idx].Value
 Else
  GetPropertyValue := '';
End;

