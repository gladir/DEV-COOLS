 { En-tete de fichier ELF64 (executable Linux x86-64) - seuls les champs  }
 { necessaires au chargement d un executable statique sont exploites.    }
 TELF64Header = Record
  Ident0, Ident1, Ident2, Ident3: Byte;  { 7F 45 4C 46                 }
  EIClass   : Byte;    { 1=32 bits, 2=64 bits                          }
  EIData    : Byte;    { 1=little endian, 2=big endian                 }
  EIVersion : Byte;
  EIOSABI   : Byte;
  EIABIVer  : Byte;
  EIPad     : Array[0..6] Of Byte;
  EType     : Word;    { 2=ET_EXEC, 3=ET_DYN                           }
  EMachine  : Word;    { $3E=EM_X86_64                                 }
  EVersion  : LongInt;
  EEntry    : QWord;   { point d entree virtuel                        }
  EPhOff    : QWord;   { offset fichier de la table des program headers}
  EShOff    : QWord;
  EFlags    : LongInt;
  EEhSize   : Word;
  EPhEntSize: Word;
  EPhNum    : Word;
  EShEntSize: Word;
  EShNum    : Word;
  EShStrNdx : Word;
 End;

 { Index des registres generaux dans ELF64_Reg (encodage x86-64 standard,
   utilise tel quel par les champs ModRM.reg/rm et REX.B/X/R). }
Const
 REG_RAX = 0;  REG_RCX = 1;  REG_RDX = 2;  REG_RBX = 3;
 REG_RSP = 4;  REG_RBP = 5;  REG_RSI = 6;  REG_RDI = 7;
 REG_R8  = 8;  REG_R9  = 9;  REG_R10 = 10; REG_R11 = 11;
 REG_R12 = 12; REG_R13 = 13; REG_R14 = 14; REG_R15 = 15;
 { Nombre max de fichiers hote ouverts simultanement par le programme    }
 { emule (descripteurs 0/1/2 restent reserves a stdin/stdout/stderr).   }
 ELF64_MAX_FD = 32;

Type
 { Entree de la table des program headers ELF64 (56 octets) }
 TELF64ProgHeader = Record
  PType  : LongInt;   { 1=PT_LOAD, 2=PT_DYNAMIC, 3=PT_INTERP...        }
  PFlags : LongInt;   { 1=X, 2=W, 4=R                                  }
  POffset: QWord;
  PVAddr : QWord;
  PPAddr : QWord;
  PFileSz: QWord;
  PMemSz : QWord;
  PAlign : QWord;
 End;

 { Chantier OS/2 LX (2026-08-22), Stage 1 : en-tete "e32_exe" d un          }
 { executable OS/2 32 bits natif (format Linear Executable). Layout         }
 { verifie EMPIRIQUEMENT (pas seulement d apres une reference ecrite) en    }
 { relisant un vrai ddnsicon.exe extrait du VHD eComStation de l utilisateur}
 { via un petit programme Pascal autonome (lxprobe.pas) : e32_esp retombe   }
 { exactement sur la taille de l objet e32_stackobj (coherence interne      }
 { attendue pour un sommet de pile), et les modules importes decodes        }
 { ("DOSCALLS","PMWP","NLS","MSG") sont des noms OS/2 reels et plausibles - }
 { deux signaux independants qui confirment ce layout. 176 octets utiles,   }
 { header reel total = 196 octets (20 de reserve, non repris ici, sans      }
 { consequence puisque tous les offsets de table sont relatifs au DEBUT     }
 { de cet en-tete, pas a sa fin). Ordre BFtable/pageshift a NE PAS re-      }
 { derive sans nouvelle verification si jamais modifie. }
 TLXHeader = Record
  e32_magic0, e32_magic1: Byte;  { 'L','X'                              }
  e32_border   : Byte;
  e32_worder   : Byte;
  e32_level    : LongInt;
  e32_cpu      : Word;      { 1=286 2=386 3=486                         }
  e32_os       : Word;      { 1=OS/2                                    }
  e32_ver      : LongInt;
  e32_mflags   : LongInt;   { bits 8-9 = compat. Presentation Manager   }
  e32_mpages   : LongInt;
  e32_startobj : LongInt;   { objet contenant EIP                       }
  e32_eip      : LongInt;
  e32_stackobj : LongInt;   { objet contenant ESP                       }
  e32_esp      : LongInt;
  e32_pagesize : LongInt;   { taille VM d une page (verifie = 4096)     }
  e32_pageshift: LongInt;   { granularite de stockage fichier (verifie  }
                             { = 9, donc unites de 512 octets)          }
  e32_fixupsize: LongInt;
  e32_fixupsum : LongInt;
  e32_ldrsize  : LongInt;
  e32_ldrsum   : LongInt;
  e32_objtab   : LongInt;   { offset (relatif a cet en-tete) table objets}
  e32_objcnt   : LongInt;
