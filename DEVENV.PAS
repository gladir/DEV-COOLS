{ --- Test de clic sur l arbre de categories --- }

Function OptionsCategoryHitTest(Var Dlg: TOptionsDialog;
 MX, MY: Integer): Integer;
Var
 Row, X, Y, TY, TextRight, TreeBottom, NodesFit: Integer;
 VisList: TOptVisList;
 VisCount: Integer;
Begin
 OptionsCategoryHitTest := -1;
 X := Dlg.Base.X + 1;
 Y := Dlg.Base.Y + DLG_TITLE_HEIGHT + 1;
 TreeBottom := Dlg.Base.Y + Dlg.Base.Height - DLG_PADDING -
  DLG_BUTTON_HEIGHT - DLG_PADDING;
 TextRight := X + OPT_TREE_WIDTH - OPT_SBAR_WIDTH - 1;
 If (MX < X) Or (MX > TextRight) Then Exit; { hors zone de texte (scrollbar) }
 VisCount := BuildOptionsVisibleList(Dlg, VisList);
 NodesFit := (TreeBottom - Y) Div OPT_TREE_NODE_HEIGHT;
 If NodesFit < 1 Then NodesFit := 1;
 TY := Y + 2;
 For Row := 0 To NodesFit - 1 Do
 Begin
  If Dlg.ScrollTop + Row >= VisCount Then Break;
  If (MY >= TY) And (MY < TY + OPT_TREE_NODE_HEIGHT) Then
  Begin
   OptionsCategoryHitTest := VisList[Dlg.ScrollTop + Row];
   Exit;
  End;
  TY := TY + OPT_TREE_NODE_HEIGHT;
 End;
End;

{ --- Test de clic sur un champ de la page --- }

Function OptionsPageFieldHitTest(Var Dlg: TOptionsDialog;
 MX, MY: Integer): Integer;
Var
 PX, BaseY, Row, ContentBottom: Integer;
Begin
 OptionsPageFieldHitTest := -1;
 PX := Dlg.Base.X + OPT_TREE_WIDTH + OPT_PANEL_PADDING;
 BaseY := Dlg.Base.Y + DLG_TITLE_HEIGHT + OPT_PANEL_PADDING +
  OPT_ROW_SPACING;
 { La derniere bande testee ne doit jamais empieter sur la zone des      }
 { boutons OK/Annuler (meme marge que SbTreeBottom dans                  }
 { HandleOptionsEvent) - sinon un clic sur OK tombe dans une "bande      }
 { fantome" qui ne correspond a aucun FieldIdx reel, mais qui avale      }
 { quand meme le clic (Exit) avant qu il atteigne le test des boutons    }
 { plus bas. C etait la cause du bouton OK "qui ne repond pas". }
 ContentBottom := Dlg.Base.Y + Dlg.Base.Height - DLG_PADDING -
  DLG_BUTTON_HEIGHT - DLG_PADDING;
 Row := 0;
 While BaseY + OPT_ROW_SPACING * Row + OPT_FIELD_HEIGHT <=
  ContentBottom Do
 Begin
  If (MY >= BaseY + OPT_ROW_SPACING * Row - 2) And
   (MY < BaseY + OPT_ROW_SPACING * Row +
   OPT_FIELD_HEIGHT) And
   (MX >= PX) Then
  Begin
   OptionsPageFieldHitTest := Row;
   Exit;
  End;
  Inc(Row);
 End;
End;

{ Valide (ou abandonne si vide/invalide) le champ "Taille" XMS/EMS en      }
{ cours d edition (voir Dlg.SizeEditField/SizeEditBuf) et referme          }
{ l edition - appelee a la fois par Entree (HandleOptionsKey) et par tout  }
{ clic ailleurs dans le dialogue (HandleOptionsEvent), comme un champ de   }
{ saisie Windows normal qui valide en perdant le focus. }
Procedure CommitSizeEdit(Var Dlg: TOptionsDialog);
Var V, Code: Integer;
Begin
 If Dlg.SizeEditField = 0 Then Exit;
 If Length(Dlg.SizeEditBuf) > 0 Then Begin
  Val(Dlg.SizeEditBuf, V, Code);
  If (Code = 0) And (V > 0) Then Begin
   Case Dlg.SizeEditField Of
    1: Dlg.Data.DosXMSSize := V;
    2: Dlg.Data.DosEMSSize := V;
    3: Dlg.Data.DosDPMISize := V;
   End;
   Dlg.Modified := True;
  End;
 End;
 Dlg.SizeEditField := 0;
 Dlg.SizeEditBuf := '';
End;

{ --- Gestion des touches dans le dialogue options --- }

Procedure HandleOptionsKey(Var Dlg: TOptionsDialog;
 Key: Integer);
Var
 DDCount, DDCur: Integer;
Begin
 { Champ "Taille" XMS/EMS en cours d edition (voir CommitSizeEdit) : les   }
 { caracteres tapes arrivent ici avec Key=Ord(caractere) - EV_KEY_CHAR     }
 { pose TOUJOURS Ev.KeyCode:=Ord(Ev.KeyChar) (voir PollEvents), donc les   }
 { chiffres, Retour arriere (8), Entree (13) et Echap (27) sont tous       }
 { directement testables sur Key comme pour n importe quel autre champ de }
 { texte de cet IDE. }
 If Dlg.SizeEditField <> 0 Then
 Begin
  If (Key >= Ord('0')) And (Key <= Ord('9')) Then Begin
   If Length(Dlg.SizeEditBuf) < 6 Then
    Dlg.SizeEditBuf := Dlg.SizeEditBuf + Chr(Key);
  End Else If Key = 8 Then Begin { Retour arriere }
   If Length(Dlg.SizeEditBuf) > 0 Then
    Delete(Dlg.SizeEditBuf, Length(Dlg.SizeEditBuf), 1);
  End Else If Key = 13 Then { Entree : valider }
   CommitSizeEdit(Dlg)
  Else If Key = 27 Then Begin { Echap : abandonner sans changer la valeur }
   Dlg.SizeEditField := 0;
   Dlg.SizeEditBuf := '';
  End;
  Exit;
 End;
 { Menu deroulant ouvert (page Emulateur > DOS) : les fleches haut/bas    }
 { deplacent la selection DANS la liste (comme un vrai combobox Windows) }
 { au lieu de deplacer la selection dans l arbre de categories ; Entree   }
 { ou Echap referment juste la liste, sans fermer tout le dialogue. }
 If Dlg.DosDropdownOpen <> 0 Then
 Begin
  Case Dlg.DosDropdownOpen Of
   1: Begin DDCount := DOS_TYPE_COUNT; DDCur := Dlg.Data.DosType; End;
   2: Begin DDCount := DOS_CPU_VENDOR_COUNT; DDCur := Dlg.Data.DosCPUVendor; End;
   3: Begin DDCount := DOS_HARDWARE_COUNT; DDCur := Dlg.Data.DosHardware; End;
   4: Begin DDCount := DOS_VIDEO_COUNT; DDCur := Dlg.Data.DosVideo1; End;
   5: Begin DDCount := DOS_VIDEO_COUNT; DDCur := Dlg.Data.DosVideo2; End;
   6: Begin DDCount := DOS_LAN_VENDOR_COUNT; DDCur := Dlg.Data.DosLANVendor; End;
   7: Begin DDCount := DOS_EMS_VERSION_COUNT; DDCur := Dlg.Data.DosEMSVersion; End;
   8: Begin DDCount := DOS_MOUSE_VENDOR_COUNT; DDCur := Dlg.Data.DosMouseVendor; End;
   9: Begin DDCount := DOS_MOUSE_VERSION_COUNT; DDCur := Dlg.Data.DosMouseVersion; End;
  Else Begin Dlg.DosDropdownOpen := 0; Exit; End;
  End;
  If Key = $48 Then Begin { Fleche haut }
   If DDCur > 0 Then Dec(DDCur);
  End Else If Key = $50 Then Begin { Fleche bas }
   If DDCur < DDCount - 1 Then Inc(DDCur);
  End Else If (Key = $1B) Or (Key = $0D) Then Begin { Echap / Entree }
   Dlg.DosDropdownOpen := 0;
   Exit;
  End Else
   Exit;
  Case Dlg.DosDropdownOpen Of
   1: Dlg.Data.DosType := DDCur;
   2: Dlg.Data.DosCPUVendor := DDCur;
   3: Dlg.Data.DosHardware := DDCur;
   4: Dlg.Data.DosVideo1 := DDCur;
   5: Dlg.Data.DosVideo2 := DDCur;
   6: Dlg.Data.DosLANVendor := DDCur;
   7: Dlg.Data.DosEMSVersion := DDCur;
   8: Dlg.Data.DosMouseVendor := DDCur;
   9: Dlg.Data.DosMouseVersion := DDCur;
  End;
  Dlg.Modified := True;
  Exit;
 End;
 If Key = $1B Then { Echap }
 Begin
  Dlg.Confirmed := False;
  Dlg.Data := Dlg.OriginalData;
  CloseDialog(Dlg.Base);
  Exit;
 End;
 If Key = $0D Then { Entree }
 Begin
  Dlg.Confirmed := True;
  Dlg.Base.Result := DR_OK;
  CloseDialog(Dlg.Base);
  Exit;
 End;
 If Key = $48 Then { Fleche haut }
 Begin
  If Dlg.SelectedCategory > 0 Then
  Begin
   Dlg.Categories[Dlg.SelectedCategory].Selected := False;
   Dec(Dlg.SelectedCategory);
   { Sauter les parents de niveau 0 non depliables }
   While (Dlg.SelectedCategory > 0) And
    Not Dlg.Categories[Dlg.SelectedCategory].Visible Do
    Dec(Dlg.SelectedCategory);
   Dlg.Categories[Dlg.SelectedCategory].Selected := True;
  End;
 End;
 If Key = $50 Then { Fleche bas }
 Begin
  If Dlg.SelectedCategory < Dlg.CategoryCount - 1 Then
  Begin
   Dlg.Categories[Dlg.SelectedCategory].Selected := False;
   Inc(Dlg.SelectedCategory);
   While (Dlg.SelectedCategory < Dlg.CategoryCount - 1) And
    Not Dlg.Categories[Dlg.SelectedCategory].Visible Do
    Inc(Dlg.SelectedCategory);
   Dlg.Categories[Dlg.SelectedCategory].Selected := True;
  End;
 End;
 EnsureOptionsCategoryVisible(Dlg);
End;

{ Gere un clic pendant qu un menu deroulant de la page Emulateur > DOS   }
{ est ouvert (Dlg.DosDropdownOpen <> 0) - le clic est intercepte avant   }
{ toute autre zone de la page puisque la liste ouverte recouvre          }
{ visuellement les lignes suivantes. Un clic sur un item le selectionne  }
{ et referme la liste ; un clic sur la barre de defilement (si presente) }
{ deplace la selection sans refermer, comme un vrai combobox Windows ;   }
{ un clic ailleurs referme simplement le menu sans rien changer. }
Procedure HandleDosDropdownClick(Var Dlg: TOptionsDialog; MX, MY: Integer);
Var
 FX, FW, ListTop, ListBottom, ListRight, SbUpY, SbDnY: Integer;
 Count, RowIdx, CurIdx, MaxVisible, ScrollStart, Idx, LabelW: Integer;
 HasScroll: Boolean;

 Procedure Apply(NewIdx: Integer);
 Begin
  Case Dlg.DosDropdownOpen Of
   1: Dlg.Data.DosType := NewIdx;
   2: Dlg.Data.DosCPUVendor := NewIdx;
   3: Dlg.Data.DosHardware := NewIdx;
   4: Dlg.Data.DosVideo1 := NewIdx;
   5: Dlg.Data.DosVideo2 := NewIdx;
   6: Dlg.Data.DosLANVendor := NewIdx;
   7: Dlg.Data.DosEMSVersion := NewIdx;
   8: Dlg.Data.DosMouseVendor := NewIdx;
   9: Dlg.Data.DosMouseVersion := NewIdx;
  End;
  Dlg.Modified := True;
 End;

Begin
 FX := Dlg.Base.X + OPT_TREE_WIDTH + OPT_PANEL_PADDING;
 FW := Dlg.Base.Width - OPT_TREE_WIDTH - OPT_PANEL_PADDING * 2;
 { RowIdx = position LOCALE du champ sur SA page (DOS: OS pour 1, DOS:     }
 { Materiel pour 2-5, DOS: Logiciel pour 6) - doit rester synchronise     }
 { avec DrawOptionsEmuDOSHardware/OS/Software. }
 Case Dlg.DosDropdownOpen Of
  1: Begin RowIdx := 0; Count := DOS_TYPE_COUNT;
      CurIdx := Dlg.Data.DosType; End;
  2: Begin RowIdx := 1; Count := DOS_CPU_VENDOR_COUNT;
      CurIdx := Dlg.Data.DosCPUVendor; End;
  3: Begin RowIdx := 2; Count := DOS_HARDWARE_COUNT;
      CurIdx := Dlg.Data.DosHardware; End;
  4: Begin RowIdx := 3; Count := DOS_VIDEO_COUNT;
      CurIdx := Dlg.Data.DosVideo1; End;
  5: Begin RowIdx := 4; Count := DOS_VIDEO_COUNT;
      CurIdx := Dlg.Data.DosVideo2; End;
  6: Begin RowIdx := 3; Count := DOS_LAN_VENDOR_COUNT;
      CurIdx := Dlg.Data.DosLANVendor; End;
  7: Begin RowIdx := 3; Count := DOS_EMS_VERSION_COUNT;
      CurIdx := Dlg.Data.DosEMSVersion; End;
  8: Begin RowIdx := 4; Count := DOS_MOUSE_VENDOR_COUNT;
      CurIdx := Dlg.Data.DosMouseVendor; End;
  9: Begin RowIdx := 5; Count := DOS_MOUSE_VERSION_COUNT;
      CurIdx := Dlg.Data.DosMouseVersion; End;
  Else Begin Dlg.DosDropdownOpen := 0; Exit; End;
 End;
 { LabelW doit rester synchronise avec DrawOptionsEmuDOSOS (Dropdown/       }
 { OpenList) - voir OPT_EMS_VER_LABEL_WIDTH. }
 If Dlg.DosDropdownOpen = 7 Then LabelW := OPT_EMS_VER_LABEL_WIDTH
 Else LabelW := OPT_LABEL_WIDTH;
 { Meme geometrie que celle dessinee par OpenList (voir                  }
 { DosDropdownVisibleCount/DosDropdownScrollStart) - indispensable pour  }
 { que le clic tombe sur l item/le bouton reellement affiche. }
 ListTop := OptRowY(Dlg, RowIdx) + OPT_FIELD_HEIGHT + 2;
 MaxVisible := DosDropdownVisibleCount(Dlg, RowIdx, Count);
 ScrollStart := DosDropdownScrollStart(CurIdx, Count, MaxVisible);
 ListBottom := ListTop + MaxVisible * OPT_DROPDOWN_ITEM_H;
 HasScroll := Count > MaxVisible;
 ListRight := FX + FW;
 If HasScroll Then ListRight := ListRight - OPT_SBAR_WIDTH;
 { Clic sur un item de la liste : le selectionne et referme. }
 If (MX >= FX + LabelW) And (MX < ListRight) And
    (MY >= ListTop) And (MY < ListBottom - 1) Then
 Begin
  Apply(ScrollStart + (MY - ListTop) Div OPT_DROPDOWN_ITEM_H);
  Dlg.DosDropdownOpen := 0;
  Exit;
 End;
 { Clic sur la barre de defilement : boutons haut/bas = -1/+1, piste =   }
 { page de MaxVisible items ; la liste reste ouverte. }
 If HasScroll And (MX >= ListRight) And (MX < FX + FW) And
    (MY >= ListTop) And (MY < ListBottom - 1) Then
 Begin
  SbUpY := ListTop;
  SbDnY := ListBottom - 1 - OPT_SBAR_WIDTH;
  If MY < SbUpY + OPT_SBAR_WIDTH Then Idx := CurIdx - 1
  Else If MY >= SbDnY Then Idx := CurIdx + 1
  Else If MY < (SbUpY + SbDnY) Div 2 Then Idx := CurIdx - MaxVisible
  Else Idx := CurIdx + MaxVisible;
  If Idx < 0 Then Idx := 0;
  If Idx > Count - 1 Then Idx := Count - 1;
  Apply(Idx);
  Exit;
 End;
 { Clic ailleurs que sur la liste ou sa barre : referme sans rien changer. }
 Dlg.DosDropdownOpen := 0;
End;

{ --- Gestion des evenements du dialogue options --- }

Procedure HandleOptionsEvent(Var Dlg: TOptionsDialog;
 Var Ev: TEvent);
Var
 CatIdx, BtnR, FieldIdx: Integer;
 Cat: TOptionCategory;
 SbX, SbTreeY, SbTreeBottom, SbUpY, SbDnY, SbNodesFit,
  SbVisCount, SbMaxTop: Integer;
 SbVisList: TOptVisList;
Begin
 If Not Dlg.Base.Visible Then Exit;
 Case Ev.Kind Of
  EV_KEY_DOWN, EV_KEY_CHAR:
  Begin
   HandleOptionsKey(Dlg, Ev.KeyCode);
   DrawOptionsDialog(Dlg);
  End;
  EV_MOUSE_DOWN:
  Begin
   { Un champ "Taille" XMS/EMS en cours d edition valide (ou abandonne si  }
   { vide) des qu on clique ailleurs, comme un champ de texte Windows      }
   { normal qui perd le focus - avant tout autre traitement du clic, pour }
   { qu un clic qui ouvre par ailleurs un autre champ/menu voie un etat    }
   { deja propre. }
   CommitSizeEdit(Dlg);
   { Un menu deroulant ouvert (page Emulateur > DOS) intercepte le clic  }
   { AVANT toute autre zone - il recouvre visuellement les lignes qui    }
   { suivent son champ, donc les tester normalement donnerait de faux    }
   { resultats tant qu il reste ouvert. }
   If (Dlg.SelectedCategory >= 0) And
      (Dlg.SelectedCategory < Dlg.CategoryCount) And
      (Dlg.Categories[Dlg.SelectedCategory].Category In
       [OC_EMU_DOS_HW, OC_EMU_DOS_OS, OC_EMU_DOS_SW]) And
      (Dlg.DosDropdownOpen <> 0) Then
   Begin
    HandleDosDropdownClick(Dlg, Ev.MouseX, Ev.MouseY);
    DrawOptionsDialog(Dlg);
    Exit;
   End;
   { Clic dans la barre de defilement de l arbre de categories - teste   }
   { avant les noeuds eux-memes, sur le meme modele que le menu deroulant}
   { "Target CPU" des Proprietes du projet (fleches haut/bas + case). }
   SbX := Dlg.Base.X + 1 + OPT_TREE_WIDTH - OPT_SBAR_WIDTH;
   SbTreeY := Dlg.Base.Y + DLG_TITLE_HEIGHT + 1;
   SbTreeBottom := Dlg.Base.Y + Dlg.Base.Height - DLG_PADDING -
    DLG_BUTTON_HEIGHT - DLG_PADDING;
   If (Ev.MouseX >= SbX) And
      (Ev.MouseX <= Dlg.Base.X + 1 + OPT_TREE_WIDTH) And
      (Ev.MouseY >= SbTreeY) And (Ev.MouseY <= SbTreeBottom) Then
   Begin
    SbVisCount := BuildOptionsVisibleList(Dlg, SbVisList);
    SbNodesFit := (SbTreeBottom - SbTreeY) Div OPT_TREE_NODE_HEIGHT;
    If SbNodesFit < 1 Then SbNodesFit := 1;
    SbMaxTop := SbVisCount - SbNodesFit;
    If SbMaxTop < 0 Then SbMaxTop := 0;
    SbUpY := SbTreeY;
    SbDnY := SbTreeBottom - OPT_SBAR_WIDTH;
    If Ev.MouseY < SbUpY + OPT_SBAR_WIDTH Then
    Begin
     If Dlg.ScrollTop > 0 Then Dec(Dlg.ScrollTop);
    End
    Else If Ev.MouseY >= SbDnY Then
    Begin
     If Dlg.ScrollTop < SbMaxTop Then Inc(Dlg.ScrollTop);
    End
    Else Begin
     { Piste : page haut/bas }
     If Ev.MouseY < (SbTreeY + SbTreeBottom) Div 2 Then
     Begin
      Dlg.ScrollTop := Dlg.ScrollTop - SbNodesFit;
      If Dlg.ScrollTop < 0 Then Dlg.ScrollTop := 0;
     End Else Begin
      Dlg.ScrollTop := Dlg.ScrollTop + SbNodesFit;
      If Dlg.ScrollTop > SbMaxTop Then Dlg.ScrollTop := SbMaxTop;
     End;
    End;
    DrawOptionsDialog(Dlg);
    Exit;
   End;
   { Clic sur l arbre de categories }
   CatIdx := OptionsCategoryHitTest(Dlg, Ev.MouseX,
    Ev.MouseY);
   If CatIdx >= 0 Then
   Begin
    { Si c est un parent, basculer depliage }
    If Dlg.Categories[CatIdx].Level = 0 Then
    Begin
     Dlg.Categories[CatIdx].Expanded :=
      Not Dlg.Categories[CatIdx].Expanded;
     UpdateOptionsTreeVisibility(Dlg);
    End;
    Dlg.Categories[Dlg.SelectedCategory].Selected := False;
    Dlg.SelectedCategory := CatIdx;
    Dlg.Categories[CatIdx].Selected := True;
    Dlg.DosDropdownOpen := 0;
    DrawOptionsDialog(Dlg);
    Exit;
   End;
   { Clic sur un champ de la page active }
   FieldIdx := OptionsPageFieldHitTest(Dlg, Ev.MouseX,
    Ev.MouseY);
   If FieldIdx >= 0 Then
   Begin
    Cat := Dlg.Categories[
     Dlg.SelectedCategory].Category;
    { Basculer les cases a cocher selon la page }
    Case Cat Of
     OC_ENV_AUTOSAVE:
      If FieldIdx = 0 Then
      Begin
       Dlg.Data.AutoSaveEnabled :=
        Not Dlg.Data.AutoSaveEnabled;
       Dlg.Modified := True;
      End;
     OC_EDITOR_GENERAL:
      Case FieldIdx Of
       0: Begin
        Dlg.Data.ShowLineNumbers :=
         Not Dlg.Data.ShowLineNumbers;
        Dlg.Modified := True;
       End;
       1: Begin
        Dlg.Data.WordWrap :=
         Not Dlg.Data.WordWrap;
        Dlg.Modified := True;
       End;
       2: Begin
        Dlg.Data.ShowWhitespace :=
         Not Dlg.Data.ShowWhitespace;
        Dlg.Modified := True;
       End;
       3: Begin
        Dlg.Data.ShowIndentGuides :=
         Not Dlg.Data.ShowIndentGuides;
        Dlg.Modified := True;
       End;
      End;
     OC_EDITOR_TABS:
      If FieldIdx = 1 Then
      Begin
       Dlg.Data.InsertSpaces :=
        Not Dlg.Data.InsertSpaces;
       Dlg.Modified := True;
      End;
     OC_EDITOR_SCROLL:
      If FieldIdx = 0 Then
      Begin
       Dlg.Data.SmoothScroll :=
        Not Dlg.Data.SmoothScroll;
       Dlg.Modified := True;
      End;
     OC_EDITOR_FORMAT:
      Case FieldIdx Of
       0: Begin
        Dlg.Data.AutoIndent :=
         Not Dlg.Data.AutoIndent;
        Dlg.Modified := True;
       End;
       1: Begin
        Dlg.Data.AutoBraces :=
         Not Dlg.Data.AutoBraces;
        Dlg.Modified := True;
       End;
      End;
     OC_PROJ_GENERAL:
      If FieldIdx = 1 Then
      Begin
       Dlg.Data.ShowOutputOnBuild :=
        Not Dlg.Data.ShowOutputOnBuild;
       Dlg.Modified := True;
      End;
     OC_PROJ_BUILD:
      If FieldIdx = 0 Then
      Begin
       Dlg.Data.BuildVerbose :=
        Not Dlg.Data.BuildVerbose;
       Dlg.Modified := True;
      End;
     OC_DEBUG_GENERAL:
      Case FieldIdx Of
       0: Begin
        Dlg.Data.BreakOnFirstError :=
         Not Dlg.Data.BreakOnFirstError;
        Dlg.Modified := True;
       End;
       1: Begin
        Dlg.Data.StepIntoProperties :=
         Not Dlg.Data.StepIntoProperties;
        Dlg.Modified := True;
       End;
      End;
     OC_DEBUG_OUTPUT:
      If FieldIdx = 0 Then
      Begin
       Dlg.Data.ShowDebugMessages :=
        Not Dlg.Data.ShowDebugMessages;
       Dlg.Modified := True;
      End;
     OC_EMU_GENERAL:
      If FieldIdx = 0 Then
      Begin
       Dlg.Data.EmuShowDebugMessages :=
        Not Dlg.Data.EmuShowDebugMessages;
       Dlg.Modified := True;
      End;
     OC_EMU_NES:
      Case FieldIdx Of
       1: Begin
        Dlg.Data.NesStandard := 0;
        Dlg.Modified := True;
       End;
       2: Begin
        Dlg.Data.NesStandard := 1;
        Dlg.Modified := True;
       End;
       3: Begin
        Dlg.Data.NesStandard := 2;
        Dlg.Modified := True;
       End;
      End;
     { Emulateur > DOS a ete scindee en 3 sous-pages (voir              }
     { OC_EMU_DOS_HW/OS/SW) - FieldIdx est desormais LOCAL a chaque      }
     { sous-page, synchronise avec DrawOptionsEmuDOSHardware/OS/Software.}
     OC_EMU_DOS_HW:
      Case FieldIdx Of
       0: Begin
        Dlg.Data.DosCPUIDDetect := Not Dlg.Data.DosCPUIDDetect;
        Dlg.Modified := True;
       End;
       1: Dlg.DosDropdownOpen := 2;  { Identifiant CPU }
       2: Dlg.DosDropdownOpen := 3;  { Materiel }
       3: Dlg.DosDropdownOpen := 4;  { Video 1 }
       4: Dlg.DosDropdownOpen := 5;  { Video 2 }
       5: Begin
        Dlg.Data.DosEmu8087 := Not Dlg.Data.DosEmu8087;
        Dlg.Modified := True;
       End;
       6: Begin
        Dlg.Data.DosEmu80286 := Not Dlg.Data.DosEmu80286;
        Dlg.Modified := True;
       End;
       7: Begin
        Dlg.Data.DosEmu80386 := Not Dlg.Data.DosEmu80386;
        Dlg.Modified := True;
       End;
      End;
     OC_EMU_DOS_OS:
      Case FieldIdx Of
       0: Dlg.DosDropdownOpen := 1;  { Type de DOS }
       1: Begin
        { Clic sur le champ "Taille" (a partir de X=200 sur la ligne,      }
        { voir CheckWithSize dans DrawOptionsEmuDOSOS) : entrer en         }
        { edition plutot que basculer la case a cocher XMS. }
        If Ev.MouseX >= Dlg.Base.X + OPT_TREE_WIDTH + OPT_PANEL_PADDING + 200
        Then Begin
         Dlg.SizeEditField := 1;
         Str(Dlg.Data.DosXMSSize, Dlg.SizeEditBuf);
        End Else Begin
         Dlg.Data.DosXMS := Not Dlg.Data.DosXMS;
         Dlg.Modified := True;
        End;
       End;
       2: Begin
        If Ev.MouseX >= Dlg.Base.X + OPT_TREE_WIDTH + OPT_PANEL_PADDING + 200
        Then Begin
         Dlg.SizeEditField := 2;
         Str(Dlg.Data.DosEMSSize, Dlg.SizeEditBuf);
        End Else Begin
         Dlg.Data.DosEMS := Not Dlg.Data.DosEMS;
         Dlg.Modified := True;
        End;
       End;
       3: Dlg.DosDropdownOpen := 7;  { Version EMS }
       4: Begin
        If Ev.MouseX >= Dlg.Base.X + OPT_TREE_WIDTH + OPT_PANEL_PADDING + 200
        Then Begin
         Dlg.SizeEditField := 3;
         Str(Dlg.Data.DosDPMISize, Dlg.SizeEditBuf);
        End Else Begin
         Dlg.Data.DosDPMI := Not Dlg.Data.DosDPMI;
         Dlg.Modified := True;
        End;
       End;
      End;
     OC_EMU_DOS_SW:
      Case FieldIdx Of
       0: Begin
        { Deux cases sur une ligne (voir Check2 dans                     }
        { DrawOptionsEmuDOSSoftware) - le seuil 150 doit rester identique }
        { a celui passe a Check2. }
        If Ev.MouseX < Dlg.Base.X + OPT_TREE_WIDTH +
         OPT_PANEL_PADDING + 150 Then
         Dlg.Data.DosMSCDEX := Not Dlg.Data.DosMSCDEX
        Else
         Dlg.Data.DosSouris := Not Dlg.Data.DosSouris;
        Dlg.Modified := True;
       End;
       1: Begin
        Dlg.Data.DosMousePS2BIOS := Not Dlg.Data.DosMousePS2BIOS;
        Dlg.Modified := True;
       End;
       2: Begin
        { Idem, seuil 230 - voir Check2 dans DrawOptionsEmuDOSSoftware. }
        If Ev.MouseX < Dlg.Base.X + OPT_TREE_WIDTH +
         OPT_PANEL_PADDING + 230 Then
         Dlg.Data.DosNovell := Not Dlg.Data.DosNovell
        Else
         Dlg.Data.DosLAN := Not Dlg.Data.DosLAN;
        Dlg.Modified := True;
       End;
       3: Dlg.DosDropdownOpen := 6;  { Fabricant reseau LAN }
       4: Dlg.DosDropdownOpen := 8;  { Fabricant pilote souris }
       5: Dlg.DosDropdownOpen := 9;  { Version pilote souris (INT 33h) }
      End;
    End;
    DrawOptionsDialog(Dlg);
    Exit;
   End;
   { Clic sur les boutons OK / Annuler }
   BtnR := DialogButtonHitTest(Dlg.Base, Ev.MouseX,
    Ev.MouseY);
   If BtnR >= 0 Then
   Begin
    If BtnR = 0 Then
    Begin
     Dlg.Confirmed := True;
     Dlg.Base.Result := DR_OK;
    End
    Else
    Begin
     Dlg.Confirmed := False;
     Dlg.Data := Dlg.OriginalData;
     Dlg.Base.Result := DR_CANCEL;
    End;
    CloseDialog(Dlg.Base);
   End;
  End;
 End;
End;

{ --- Afficher le dialogue des options --- }

Procedure ShowOptionsDialog(Var Dlg: TOptionsDialog);
Begin
 InitOptionsDialog(Dlg);
 Dlg.Base.Visible := True;
 DrawOptionsDialog(Dlg);
End;

{ --- Ecrire une ligne cle=valeur dans le fichier INI --- }

Procedure WriteCfgLine(Var F: Text; Key, Value: String);
Begin
 WriteLn(F, Key, '=', Value);
End;

{ --- Lire une ligne cle=valeur depuis une chaine --- }

Function ReadCfgLine(Line: String;
 Var Key, Value: String): Boolean;
Var
 P: Integer;
Begin
 ReadCfgLine := False;
 Key := '';
 Value := '';
 If Length(Line) = 0 Then Exit;
 If Line[1] = '[' Then Exit;
 If Line[1] = ';' Then Exit;
 P := Pos('=', Line);
 If P = 0 Then Exit;
 Key := Copy(Line, 1, P - 1);
 Value := Copy(Line, P + 1, Length(Line) - P);
 ReadCfgLine := True;
End;

{ --- Convertir un booleen en chaine --- }

Function BoolToStr(B: Boolean): String;
Begin
 If B Then
  BoolToStr := '1'
 Else
  BoolToStr := '0';
End;

{ --- Convertir une chaine en booleen --- }

Function StrToBool(S: String): Boolean;
Begin
 StrToBool := (S = '1') Or (S = 'True') Or (S = 'true');
End;

{ --- Sauvegarder les options dans un fichier INI --- }

Procedure SaveOptions(Var Data: TOptionsDialogData;
 FileName: String);
Var
 F: Text;
 S: String;
Begin
 Assign(F, FileName);
 {$I-}
 Rewrite(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 WriteLn(F, '[Environnement]');
 WriteCfgLine(F, 'ThemeName', Data.ThemeName);
 WriteCfgLine(F, 'FontName', Data.FontName);
 Str(Data.FontSize, S);
 WriteCfgLine(F, 'FontSize', S);
 Str(Ord(Data.StartupAction), S);
 WriteCfgLine(F, 'StartupAction', S);
 WriteCfgLine(F, 'AutoSaveEnabled',
  BoolToStr(Data.AutoSaveEnabled));
 Str(Data.AutoSaveInterval, S);
 WriteCfgLine(F, 'AutoSaveInterval', S);
 WriteLn(F, '');
 WriteLn(F, '[Editeur]');
 WriteCfgLine(F, 'ShowLineNumbers',
  BoolToStr(Data.ShowLineNumbers));
 WriteCfgLine(F, 'WordWrap', BoolToStr(Data.WordWrap));
 WriteCfgLine(F, 'ShowWhitespace',
  BoolToStr(Data.ShowWhitespace));
 WriteCfgLine(F, 'ShowIndentGuides',
  BoolToStr(Data.ShowIndentGuides));
 Str(Data.TabSize, S);
 WriteCfgLine(F, 'TabSize', S);
 WriteCfgLine(F, 'InsertSpaces',
  BoolToStr(Data.InsertSpaces));
 Str(Data.IndentSize, S);
 WriteCfgLine(F, 'IndentSize', S);
 WriteCfgLine(F, 'SmoothScroll',
  BoolToStr(Data.SmoothScroll));
 Str(Data.ScrollMargin, S);
 WriteCfgLine(F, 'ScrollMargin', S);
 WriteCfgLine(F, 'AutoIndent',
  BoolToStr(Data.AutoIndent));
 WriteCfgLine(F, 'AutoBraces',
  BoolToStr(Data.AutoBraces));
 WriteLn(F, '');
 WriteLn(F, '[Projets]');
 WriteCfgLine(F, 'DefaultProjectPath',
  Data.DefaultProjectPath);
 WriteCfgLine(F, 'ShowOutputOnBuild',
  BoolToStr(Data.ShowOutputOnBuild));
 WriteCfgLine(F, 'BuildVerbose',
  BoolToStr(Data.BuildVerbose));
 Str(Data.ParallelBuild, S);
 WriteCfgLine(F, 'ParallelBuild', S);
 WriteLn(F, '');
 WriteLn(F, '[Debogage]');
 WriteCfgLine(F, 'BreakOnFirstError',
  BoolToStr(Data.BreakOnFirstError));
 WriteCfgLine(F, 'StepIntoProperties',
  BoolToStr(Data.StepIntoProperties));
 WriteCfgLine(F, 'ShowDebugMessages',
  BoolToStr(Data.ShowDebugMessages));
 WriteLn(F, '');
 WriteLn(F, '[Emulateur.General]');
 WriteCfgLine(F, 'EmuShowDebugMessages',
  BoolToStr(Data.EmuShowDebugMessages));
 WriteLn(F, '');
