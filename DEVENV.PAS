{ --- TYPE / GET-CONTENT --- }

Procedure TermCmd_TYPE(Var TP: TTerminalPanel;
 ParamStr: String);
Var
 Err: Word;
 Handle: Text;
 CurrParam, CurrLine: String;
 Idx: Byte;
 AbsP: String;
 Attr: Byte;
 Cluster: LongInt;
 Size: LongInt;
Begin
 CurrParam := TermExtractParam(ParamStr, 1);
 If CurrParam = '' Then Begin
  TermAddLine(TP, 'Syntaxe : TYPE fichier');
  Exit;
 End;
 If Term_ResolveVirtTarget(TP, CurrParam, Idx, AbsP) Then Begin
  If Not Fat_FindPath(Idx, AbsP, Attr, Cluster, Size) Then Begin
   TermAddLine(TP,
    'Le systeme ne trouve pas le fichier specifie.');
   Exit;
  End;
  If (Attr And $10) <> 0 Then Begin
   TermAddLine(TP, 'Acces refuse : ' + AbsP + ' est un repertoire.');
   Exit;
  End;
  Fat_TypeFile(Idx, Cluster, Size, TP);
  Exit;
 End;
 Assign(Handle, CurrParam);
 {$I-} Reset(Handle); {$I+}
 Err := IOResult;
 If Err <> 0 Then Begin
  TermAddLine(TP, TermGetErrorMessage(Err));
  Exit;
 End;
 While Not EOF(Handle) Do Begin
  ReadLn(Handle, CurrLine);
  TermAddLine(TP, CurrLine);
 End;
 Close(Handle);
End;

{ --- ADD-CONTENT (2026-08-30, demande explicite de l'utilisateur, "support}
{ complet" dans PowerShell dev) : contrepartie en ECRITURE de TYPE/        }
{ GET-CONTENT ci-dessus - AJOUTE une ligne de texte a la fin d'un fichier   }
{ (le cree s'il n'existe pas encore), sans jamais toucher au contenu deja  }
{ present (contrairement a un > qui tronquerait). Supporte les 2 syntaxes  }
{ REELLES les plus courantes de la vraie cmdlet PowerShell : }
{   Add-Content -Path fichier -Value texte...                             }
{   Add-Content fichier texte...                        (forme positionnelle)}
{ Recherche des drapeaux -Path/-Value par SOUS-CHAINE (insensible a la     }
{ casse) plutot qu'un vrai analyseur PowerShell (aucun n'existe dans ce     }
{ terminal, meme limitation honnete que TOUTES les autres commandes         }
{ "verbe-nom" deja implantees) - ordre attendu -Path PUIS -Value (le seul   }
{ reellement utilise en pratique) ; le texte de -Value ou de la forme       }
{ positionnelle va jusqu'a la fin de la ligne SANS analyse de guillemets    }
{ (encore une fois la meme limitation qu'ECHO/TermCmd_ECHO, jamais de       }
{ retrait de guillemets nulle part dans ce terminal). Hors de portee        }
{ documente (jamais invente) : -Value multiple (tableau de lignes),         }
{ -NoNewline, -Encoding, -Force, entree par pipeline - aucun n'existe dans  }
{ la vraie cmdlet sans un vrai pipeline PowerShell, absent de ce terminal.  }
Procedure TermCmd_AddContent(Var TP: TTerminalPanel; ParamStr: String);
Var
 UpParams, TrimmedParams, FilePath, ValueStr: String;
 PathFlagPos, ValueFlagPos, SpacePos: Integer;
 Handle: Text;
 Err: Word;
Begin
 UpParams := TermStrToUpper(ParamStr);
 PathFlagPos := System.Pos('-PATH', UpParams);
 ValueFlagPos := System.Pos('-VALUE', UpParams);
 If PathFlagPos > 0 Then Begin
  FilePath := TrimStr(TermExtractParam(Copy(ParamStr, PathFlagPos + 5,
   Length(ParamStr)), 1));
  If ValueFlagPos > 0 Then
   ValueStr := TrimStr(Copy(ParamStr, ValueFlagPos + 6, Length(ParamStr)))
  Else
   ValueStr := '';
 End Else Begin
  FilePath := TermExtractParam(ParamStr, 1);
  TrimmedParams := TrimStr(ParamStr);
  SpacePos := System.Pos(' ', TrimmedParams);
  If SpacePos > 0 Then
   ValueStr := TrimStr(Copy(TrimmedParams, SpacePos + 1, Length(TrimmedParams)))
  Else
   ValueStr := '';
 End;
 If FilePath = '' Then Begin
  TermAddLine(TP, 'Syntaxe : Add-Content fichier texte');
  TermAddLine(TP, '     ou : Add-Content -Path fichier -Value texte');
  Exit;
 End;
 If FileExists(FilePath) Then Begin
  Assign(Handle, FilePath);
  {$I-} Append(Handle); {$I+}
 End Else Begin
  Assign(Handle, FilePath);
  {$I-} Rewrite(Handle); {$I+}
 End;
 Err := IOResult;
 If Err <> 0 Then Begin
  TermAddLine(TP, TermGetErrorMessage(Err));
  Exit;
 End;
 WriteLn(Handle, ValueStr);
 Close(Handle);
End;

{ --- CLEAR-CONTENT / CLEAR-ITEM (2026-08-31, demande explicite de         }
{ l'utilisateur, "support complet") : contrepartie REELLE d'Add-Content    }
{ ci-dessus - la VRAIE cmdlet VIDE un fichier (le tronque a 0 octet) SANS  }
{ le supprimer, contrairement a DEL/Remove-Item. Implantation directe :    }
{ `Rewrite` sur un fichier EXISTANT le tronque immediatement, exactement   }
{ le contrat reel de Clear-Content. Clear-Item est IDENTIQUE ici :         }
{ la vraie cmdlet est generique par fournisseur PowerShell (efface une     }
{ valeur de registre, une variable, etc. selon le "provider" cible) - ce   }
{ terminal n'a QUE le systeme de fichiers comme "provider" (pas de         }
{ registre, pas de $variable, voir Add-Member), donc Clear-Item sur un     }
{ fichier a EXACTEMENT le meme contrat reel que Clear-Content sur ce meme  }
{ fournisseur - pas un alias arbitraire, le comportement authentique de la }
{ vraie cmdlet dans ce cas precis. }
Procedure TermCmd_ClearContent(Var TP: TTerminalPanel; ParamStr: String);
Var
 UpParams, FilePath: String;
 PathFlagPos: Integer;
 Handle: File;
 Err: Word;
Begin
 UpParams := TermStrToUpper(ParamStr);
 PathFlagPos := System.Pos('-PATH', UpParams);
 If PathFlagPos > 0 Then
  FilePath := TrimStr(TermExtractParam(Copy(ParamStr, PathFlagPos + 5,
   Length(ParamStr)), 1))
 Else
  FilePath := TermExtractParam(ParamStr, 1);
 If FilePath = '' Then Begin
  TermAddLine(TP, 'Syntaxe : Clear-Content fichier');
  TermAddLine(TP, '     ou : Clear-Content -Path fichier');
  Exit;
 End;
 If Not FileExists(FilePath) Then Begin
  TermAddLine(TP, 'Clear-Content : le systeme ne trouve pas le fichier ' +
   'specifie : ' + FilePath);
  Exit;
 End;
 Assign(Handle, FilePath);
 {$I-} Rewrite(Handle, 1); {$I+}
 Err := IOResult;
 If Err <> 0 Then Begin
  TermAddLine(TP, TermGetErrorMessage(Err));
  Exit;
 End;
 Close(Handle);
End;

Procedure TermCmd_ClearItem(Var TP: TTerminalPanel; ParamStr: String);
Begin
 TermCmd_ClearContent(TP, ParamStr);
End;

