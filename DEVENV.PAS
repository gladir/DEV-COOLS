 If P.Loaded And ((P.TargetCPU = '-CTRS80') Or (P.TargetCPU = '-CMSX') Or
                   (P.TargetCPU = '-CADAM')) Then Begin
  If Not P.Running Then Exit;
  Active := EmuHasFocus And Not MenuActive And Not CtxMenu.Visible;
  If Not Active Then Begin
   If EmuLastActiveState Then Begin
    P.StatusMsg := 'En pause (cliquez sur l''ecran pour reprendre)';
    DrawEmulatorPanel(P);
    EmuLastActiveState := False;
   End;
   Exit;
  End;
  If Not EmuLastActiveState Then Begin
   P.StatusMsg := '';
   EmuLastActiveState := True;
  End;
  Z80_RunOneChunk(P);
  Finished := Z80_Halted Or (P.TotalSteps >= 1000000) Or Z80Async_KeyEsc;
  DrawEmulatorPanel(P);
  If Finished Then Begin
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   P.CurFg := 11;
   If Z80_Halted Then
    EmuVScr_WriteStr(P, '[Fin Z80 : ' + IntToStr(P.TotalSteps) +
     ' instructions, code=' + IntToStr(Z80_ExitCode) + ']')
   Else
    EmuVScr_WriteStr(P, '[Limite 1000000 instructions atteinte]');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'Appuyez sur Echap pour fermer.');
   P.Running := False;
   P.Fault := sfEndProgram;
   P.StatusMsg := 'Emulateur Z80 : ' + IntToStr(P.TotalSteps) + ' instr.';
   DrawEmulatorPanel(P);
  End;
  Exit;
 End;
 If P.Loaded And (P.TargetCPU = '-CELF64') Then Begin
  If Not P.Running Then Exit;
  Active := EmuHasFocus And Not MenuActive And Not CtxMenu.Visible;
  If Not Active Then Begin
   If EmuLastActiveState Then Begin
    P.StatusMsg := 'En pause (cliquez sur l''ecran pour reprendre)';
    DrawEmulatorPanel(P);
    EmuLastActiveState := False;
   End;
   Exit;
  End;
  If Not EmuLastActiveState Then Begin
   P.StatusMsg := '';
   EmuLastActiveState := True;
  End;
  ELF64_RunOneChunk(P);
  Finished := ELF64_Halted Or (P.TotalSteps >= 5000000) Or ELF64Async_KeyEsc;
  DrawEmulatorPanel(P);
  If Finished Then Begin
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   ELF64_PrintEndMessage(P);
   DrawEmulatorPanel(P);
  End;
  Exit;
 End;
 If P.Loaded And (P.TargetCPU = '-COS2LX') Then Begin
  { Chantier OS/2 LX, Stage 4 - meme motif exact que le bloc -CELF64        }
  { juste au-dessus. }
  If Not P.Running Then Exit;
  Active := EmuHasFocus And Not MenuActive And Not CtxMenu.Visible;
  If Not Active Then Begin
   If EmuLastActiveState Then Begin
    P.StatusMsg := 'En pause (cliquez sur l''ecran pour reprendre)';
    DrawEmulatorPanel(P);
    EmuLastActiveState := False;
   End;
   Exit;
  End;
  If Not EmuLastActiveState Then Begin
   P.StatusMsg := '';
   EmuLastActiveState := True;
  End;
  Lx_RunOneChunk(P);
  Finished := LX_Halted Or (P.TotalSteps >= 5000000) Or LX_AsyncKeyEsc;
  DrawEmulatorPanel(P);
  If Finished Then Begin
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   Lx_PrintEndMessage(P);
   DrawEmulatorPanel(P);
  End;
  Exit;
 End;
 If P.Loaded And (P.TargetCPU = '-CARM64') Then Begin
  { Chantier ARM64, Etape 2 - meme motif exact que les blocs -CELF64/       }
  { -COS2LX juste au-dessus. }
  If Not P.Running Then Exit;
  Active := EmuHasFocus And Not MenuActive And Not CtxMenu.Visible;
  If Not Active Then Begin
   If EmuLastActiveState Then Begin
    P.StatusMsg := 'En pause (cliquez sur l''ecran pour reprendre)';
    DrawEmulatorPanel(P);
    EmuLastActiveState := False;
   End;
   Exit;
  End;
  If Not EmuLastActiveState Then Begin
   P.StatusMsg := '';
   EmuLastActiveState := True;
  End;
  Arm64_RunOneChunk(P);
  Finished := ARM64_Halted Or (P.TotalSteps >= ARM64_MAX_STEPS) Or ARM64Async_KeyEsc;
  DrawEmulatorPanel(P);
  If Finished Then Begin
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   Arm64_PrintEndMessage(P);
   DrawEmulatorPanel(P);
  End;
  Exit;
 End;
 If P.Loaded And ((P.TargetCPU = '-CD') Or (P.TargetCPU = '-CP') Or
    (P.TargetCPU = '-CWIN16')) Then Begin
  If Not P.Running Then Exit;
  { Meme motif que les autres backends Stage 1. Contrairement a eux, ce   }
  { backend a DEJA son propre pompage d evenements interne (voir           }
  { DOS_RunOneChunk) - la pause ici se limite donc a NE PAS appeler ce      }
  { pompage (EmuHasFocus le verifie lui-meme), pas a sauter la trame        }
  { entiere, pour ne jamais desynchroniser les minuteries/IRQ du 8086       }
  { emule pendant que l onglet est visible mais pas focus. }
  { BOGUE REEL (2026-08-19, enquete NC3 via la console) : cliquer DANS la  }
  { Console de commandes du debogueur (necessaire pour lui donner le       }
  { focus clavier) est un clic HORS du panneau emulateur, ce qui remet     }
  { EmuHasFocus a False (voir DispatchEvent, "clic hors du panneau") -     }
  { G/T/P tapes dans la console semblaient alors ne RIEN faire (le         }
  { programme ne recevait plus jamais un seul pas). La console EXISTE     }
  { justement pour piloter l emulateur SANS avoir a cliquer dessus entre   }
  { chaque commande (usage SoftICE/GDB normal) - la considerer comme une   }
  { justification ALTERNATIVE a EmuHasFocus (et non modifier EmuHasFocus   }
  { lui-meme depuis la console, ce qui perturberait plutot le routage      }
  { clavier ailleurs dans DispatchEvent - premiere tentative essayee et    }
  { rejetee, voir EmuCmdConsole_CmdG). }
  Active := (EmuHasFocus Or EmuCmdConsole.Base.Visible) And
   Not MenuActive And Not CtxMenu.Visible;
  If Not Active Then Begin
   If EmuLastActiveState Then Begin
    P.StatusMsg := 'En pause (cliquez sur l''ecran pour reprendre)';
    DrawEmulatorPanel(P);
    EmuLastActiveState := False;
   End;
   Exit;
  End;
  If Not EmuLastActiveState Then Begin
   P.StatusMsg := '';
   EmuLastActiveState := True;
  End;
  DOS_RunOneChunk(P);
  DrawEmulatorPanel(P);
  { BOGUE REEL signale par l utilisateur (2026-08-19) : la fenetre du
    Debogueur devrait rester ouverte et se mettre a jour EN DIRECT
    (registres + desassemblage) pendant qu on tourne librement (G/F5),
    pas disparaitre - voir EmuDbg_Continue, qui ne la ferme plus. La
    redessiner ici, au meme rythme que l ecran emulateur lui-meme (une
    fois par bloc de 5000 instructions), donne une vue live sans le cout
    d un redessin a CHAQUE instruction - EmuDbg_DrawWindow lit deja les
    registres/CS:IP LIVE depuis EmuPanel.CPU a chaque appel (aucune
    valeur mise en cache), donc aucun autre changement n est necessaire
    pour que le contenu affiche suive reellement l execution. Meme garde
    que le site d origine dans DrawAllWidgets (ne pas effacer un menu
    deroulant ouvert). }
  If EmuDbg.WinVisible And (Not MenuActive) Then EmuDbg_DrawWindow;
  If P.CPU.Fault <> sfNone Then Begin
   DOS_PrintEndMessage(P);
   DrawEmulatorPanel(P);
  End;
  Exit;
 End;
 If P.Running And (P.CPU.Fault = sfNone) Then Begin
  If DpmiCPU.Active Then Dpmi_Step(P) Else Emu_StepOne(P);
 End;
 If P.CPU.Fault <> sfNone Then
  P.Running := False;
End;

{ Stage 2 "multi-onglets emulateur" (2026-08-15) : cree un NOUVEL onglet     }
{ WK_EMU (meme motif que CreateHexWindow/CreateFormWindow) et y CHARGE le    }
{ binaire via ShowEmulatorPanel - remplace tous les appels directs a         }
{ CreateEmulatorTab(...) faits depuis NC/le build-run/-emu:, qui   }
{ auparavant ecrasaient le panneau global unique sans creer d onglet.        }
{ SyncActiveWindowOut AVANT de charger le nouveau binaire est essentiel :    }
{ c est ce qui met en securite l etat C64 de l onglet PRECEDENT (globales    }
{ CPU6502_*/C64_*) dans EmuTabs[]/C64Snaps[] avant que ShowEmulatorPanel ne   }
{ les reinitialise pour le nouveau binaire. }
Procedure CreateEmulatorTab(BinaryPath, TargetCPU: String; Args: String);
Var
 Idx: Integer;
Begin
 If WinMgr.WinCount >= MAX_WINDOWS Then Exit;
 SyncActiveWindowOut;
 Idx := WinMgr.WinCount;
 InitEditorWindow(WinMgr.Windows[Idx]);
 WinMgr.Windows[Idx].Kind := WK_EMU;
 WinMgr.Windows[Idx].FileName := BinaryPath;
 WinMgr.Windows[Idx].Title := EmuPanelTitleFor(TargetCPU) +
  ' - ' + GetTabLabel(BinaryPath);
 WinMgr.Windows[Idx].TabIndex := Idx;
 WinMgr.Windows[Idx].Visible := True;
 WinMgr.Windows[Idx].Maximized := True;
 WinMgr.Windows[Idx].X := 0;
 WinMgr.Windows[Idx].Y := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
 WinMgr.Windows[Idx].Width := GetScreenWidth - EXPLORER_WIDTH;
 WinMgr.Windows[Idx].Height := GetScreenHeight - MENUBAR_HEIGHT
   - TOOLBAR_HEIGHT - TAB_HEIGHT - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 ShowEmulatorPanel(EmuPanel, BinaryPath, TargetCPU, Args);
 EmuTabs[Idx] := EmuPanel;
 If TargetCPU = '-CC64' Then C64_SaveState(C64Snaps[Idx])
 Else If TargetCPU = '-CNES' Then Nes_SaveState(NesSnaps[Idx])
 Else If TargetCPU = '-CATARI2600' Then A2600_SaveState(A2600Snaps[Idx])
 Else If (TargetCPU = '-CCOCO3') Or (TargetCPU = '-CDRAGON32') Or
         (TargetCPU = '-CDRAGON64') Or (TargetCPU = '-CTO7') Or
         (TargetCPU = '-CTO8') Or (TargetCPU = '-CMO5') Then
  Coco3_SaveState(Coco3Snaps[Idx])
 Else If (TargetCPU = '-CAPPLEII') Or (TargetCPU = '-CATARI400') Or
         (TargetCPU = '-CATARI800') Then
  AppleAtari_SaveState(AppleAtariSnaps[Idx])
 Else If (TargetCPU = '-C68000') Or (TargetCPU = '-CATARIST') Or
         (TargetCPU = '-CAMIGA') Then
  M68K_SaveState(M68KSnaps[Idx])
 Else If TargetCPU = '-CCRAY1' Then
  Cray_SaveState(CraySnaps[Idx])
 Else If TargetCPU = '-CPCODE' Then
  PCode2_SaveState(PCode2Snaps[Idx])
 Else If (TargetCPU = '-CTRS80') Or (TargetCPU = '-CMSX') Or
         (TargetCPU = '-CADAM') Then
  Z80_SaveState(Z80Snaps[Idx]);
 { PAS de DOS_SaveState ici (contrairement aux autres backends) : au        }
 { contraire de leurs SaveState (qui font une simple COPIE via `:=`/Move(), }
 { sans toucher la source), DOS_SaveState VOLE les 4 pointeurs globaux      }
 { (video/XMS/EMS/DPMI-etendu) vers le snapshot et les met a Nil - correct   }
 { quand on QUITTE un onglet, mais catastrophique ici puisque cet onglet     }
 { tout juste cree devient l onglet ACTIF (WinMgr.ActiveIdx:=Idx juste       }
 { apres) : appeler DOS_SaveState maintenant viderait sa propre memoire      }
 { video/XMS/EMS a peine allouee. DOSSnaps[Idx] reste a son etat par        }
 { defaut (vide) jusqu a ce que l utilisateur quitte REELLEMENT cet onglet   }
 { pour la premiere fois (SyncActiveWindowOut le peuplera alors             }
 { correctement, au bon moment). }
 Inc(WinMgr.WinCount);
 WinMgr.ActiveIdx := Idx;
End;

{ Variante de CreateEmulatorTab pour la commande Terminal BOOT : pas de     }
{ fichier NOMME a charger, juste un amorcage reel depuis le lecteur         }
{ virtuel DriveIdx (0..3) - voir Emu_LoadBootSector/EmuBootFromDrive. Seul   }
{ le backend x86 (-CD) sait amorcer reellement aujourd hui (voir le          }
{ commentaire de perimetre pres de TermCmd_BOOT pour /OS2/LINUX/LINUXARM). }
Procedure CreateEmulatorBootTab(DriveIdx: Byte; Const DispName: String);
Var
 Idx: Integer;
Begin
 If WinMgr.WinCount >= MAX_WINDOWS Then Exit;
 SyncActiveWindowOut;
 Idx := WinMgr.WinCount;
 InitEditorWindow(WinMgr.Windows[Idx]);
 WinMgr.Windows[Idx].Kind := WK_EMU;
 WinMgr.Windows[Idx].FileName := DispName;
 WinMgr.Windows[Idx].Title := EmuPanelTitleFor('-CD') + ' - Amorcage ' + DispName;
 WinMgr.Windows[Idx].TabIndex := Idx;
 WinMgr.Windows[Idx].Visible := True;
 WinMgr.Windows[Idx].Maximized := True;
 WinMgr.Windows[Idx].X := 0;
 WinMgr.Windows[Idx].Y := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
 WinMgr.Windows[Idx].Width := GetScreenWidth - EXPLORER_WIDTH;
 WinMgr.Windows[Idx].Height := GetScreenHeight - MENUBAR_HEIGHT
   - TOOLBAR_HEIGHT - TAB_HEIGHT - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 EmuBootFromDrive := DriveIdx;
 ShowEmulatorPanel(EmuPanel, DispName, '-CD', '');
 EmuTabs[Idx] := EmuPanel;
 { Pas de SaveState (-CD n en a jamais, voir le commentaire au-dessus de   }
 { CreateEmulatorTab) - meme raisonnement, s applique identiquement ici. }
 Inc(WinMgr.WinCount);
 WinMgr.ActiveIdx := Idx;
End;

{ --- Traiter un evenement du panneau emulateur --- }

Procedure HandleEmulatorPanelEvent(Var P: TEmulatorPanel;
 Var Ev: TEvent);
Var
 K: Byte;
 IsDOSTarget: Boolean;
Begin
 { Correctif Stage 1 (2026-08-15) : la souris emulee DOS (EmuMouse_Update-  }
 { FromHost) etait mise a jour depuis le pompage d evenements INTERNE de    }
 { DOS_RunOneChunk (PollEvents direct, hors DispatchEvent) - or ce pompage  }
 { et celui de MainLoop lisent la MEME file d evenements DEVENV : un clic   }
 { destine au menu/a l Explorateur/au Terminal pouvait etre "vole" par le   }
 { pompage interne DOS avant meme d atteindre DispatchEvent, selon lequel   }
 { des deux sondages arrivait en premier (course). Deplacer la mise a jour  }
 { souris ICI (appelee UNIQUEMENT par le gestionnaire normal de MainLoop,   }
 { deja garanti hit-test + focus corrects) elimine la course - DOS_Run-     }
 { OneChunk ne fait plus AUCUN PollEvents pour la souris. }
 IsDOSTarget := (P.TargetCPU = '-CD') Or (P.TargetCPU = '-CP');
 Case Ev.Kind Of
  EV_KEY_CHAR:
   Begin
    If Ev.KeyChar = #27 Then Begin
     P.Base.Visible := False;
     P.Visible := False;
     { Stage 2 : Echap ferme reellement l onglet emulateur (comme fermer un }
     { document), pas juste masquer le panneau - sinon l onglet resterait   }
     { dans la barre d onglets, vide, sans plus rien a afficher. }
     If (WinMgr.ActiveIdx >= 0) And
        (WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_EMU) Then
      CloseEditorWindow(WinMgr.ActiveIdx);
     Exit;
    End;
    { Toute autre frappe est empilee dans la file clavier }
    EmuVScr_PushKey(P, Byte(Ev.KeyChar));
   End;
  EV_KEY_DOWN:
   Begin
    K := Ev.KeyCode And $FF;
    If K = $1B Then Begin
     P.Base.Visible := False;
     P.Visible := False;
     If (WinMgr.ActiveIdx >= 0) And
        (WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_EMU) Then
      CloseEditorWindow(WinMgr.ActiveIdx);
     Exit;
    End;
    { BOGUE REEL (2026-08-29) signale par l utilisateur : les fleches       }
    { s affichaient comme des lettres litterales (ex. Bas -> "P") dans      }
    { l emulateur DOS - EV_KEY_DOWN transmet un CODE DE BALAYAGE BIOS       }
    { (K, ex. $50 = Bas), jamais un caractere ASCII, mais etait pousse tel  }
    { quel dans le mot de la file clavier. Le drainage vers le vrai buffer  }
    { BIOS (~85069, Emu_PushBiosKey) documente et attend l encodage         }
    { (scancode Shl 8) Or ascii - K etait donc lu comme ASCII=$50='P' au    }
    { lieu de scancode=$50/ASCII=0, d ou l echo litteral de la lettre P     }
    { (ou toute autre lettre correspondant par coincidence au code de       }
    { balayage de la touche speciale pressee) par NC au lieu d un           }
    { deplacement de curseur. }
    EmuVScr_PushKey(P, Word(K) Shl 8);
   End;
  EV_MOUSE_MOVE:
   If IsDOSTarget Then
    EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns);
  EV_MOUSE_DOWN:
   If IsDOSTarget Then Begin
    Case Ev.MouseBtn Of
     MB_LEFT  : EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns Or 1);
     MB_RIGHT : EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns Or 2);
     MB_MIDDLE: EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns Or 4);
    End;
   End;
  EV_MOUSE_UP:
   If IsDOSTarget Then Begin
    Case Ev.MouseBtn Of
     MB_LEFT  : EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns And $FE);
     MB_RIGHT : EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns And $FD);
     MB_MIDDLE: EmuMouse_UpdateFromHost(P, Ev.MouseX, Ev.MouseY, EmuMouseBtns And $FB);
    End;
   End;
 End;
End;

