 { ========================================================
   PHASE 0 : Etat unifie de la carte video CGA / EGA / VGA.
   --------------------------------------------------------
   La memoire video est 256 Ko ($00000-$3FFFF) car les modes
   EGA/VGA planar ont 4 plans de 64 Ko chacun a $A000.
   En mode texte, on duplique aussi le contenu vers la VRAM
   80x25 du panneau pour le rendu rapide.
   ======================================================== }
 TEmuVideoMem = Array[0..262143] Of Byte;  { 4 plans x 64K }
 PEmuVideoMem = ^TEmuVideoMem;

 TEmuVideoState = Record
  Mode       : Byte;    { 0..13h, 7Fh inconnu               }
  Width      : Word;    { largeur en pixels                  }
  Height     : Word;    { hauteur en pixels                  }
  TextCols   : Byte;    { 40 ou 80                          }
  TextRows   : Byte;    { 25 typique                         }
  BitsPerPix : Byte;    { 0=texte, 1, 2, 4, 8                }
  IsGraphic  : Boolean; { mode graphique vs texte            }
  IsPlanar   : Boolean; { EGA/VGA planar vs lineaire         }
  ChainFour  : Boolean; { mode 13h = chain-4 lineaire        }
  PageBase   : LongInt; { offset dans VideoMem               }
  Mem        : PEmuVideoMem;{ buffer 256 Ko alloue            }
  MemReady   : Boolean;
  { --- DAC (registres VGA $3C7-$3C9) --- }
  DAC        : Array[0..767] Of Byte; { 256 RGB, 6 bits     }
  DACWriteIdx: Word;    { index octet courant ecriture       }
  DACReadIdx : Word;    { index octet courant lecture        }
  DACMask    : Byte;    { masque pixel ($3C6)                }
  DACState   : Byte;    { etat $3C7 : 0=write, 3=read        }
  { --- Sequencer ($3C4 / $3C5) --- }
  SeqIdx     : Byte;
  SeqReg     : Array[0..7] Of Byte;
  { --- Graphics Controller ($3CE / $3CF) --- }
  GCIdx      : Byte;
  GCReg      : Array[0..15] Of Byte;
  { --- Attribute Controller ($3C0 / $3C1) --- }
  ACFlipFlop : Boolean; { 0=index, 1=data                    }
  ACIdx      : Byte;
  ACReg      : Array[0..31] Of Byte;
  { --- CRT Controller ($3D4 / $3D5) --- }
  CRTCIdx    : Byte;
  CRTCReg    : Array[0..31] Of Byte;
  { --- 4 latches plan (lus par MOV reg,[mem] en mode planar) --- }
  Latch      : Array[0..3] Of Byte;
  { --- CGA registers ($3D8 / $3D9) --- }
  CGAMode    : Byte;    { Mode Control Register $3D8         }
  CGAColor   : Byte;    { Color Select Register $3D9         }
  { --- Status (lecture de $3DA) --- }
  StatusRetrace : Byte; { bit 0 = HRetrace (bascule a la lecture), bit 3 = }
                         { VRetrace (libre, cadencee par VRetraceAcc)     }
  VRetraceAcc   : LongInt; { accumulateur de pas CPU pour la bascule VRetrace }
  { --- Dirty flag pour le rendu graphique --- }
  GfxDirty   : Boolean;
  { --- Registres etendus ATI Graphics Solution ($3DD/$3DF) - carte sans   }
  { BIOS, programmee uniquement par sequences de ports directes. Voir      }
  { Emu_ATIDetectMode. --- }
  GSExt      : Byte;    { dernier octet ecrit sur $3DD                     }
  GSFeature  : Byte;    { dernier octet ecrit sur $3DF                     }
  GSLastSig  : Byte;    { dernier mode ATI detecte (0=aucun), evite les    }
                         { reinitialisations redondantes                   }
  GSTxt132Emul: Boolean;{ Vrai = GSEmulTextModeC132x25 (132 col, moniteur  }
                         { monochrome), Faux = GSTextModeC132x25 (couleur) }
 End;

 { --- Pile reseau Novell IPX/SPX (Options > Emulateur > DOS > "Reseau     }
 { Novell NetWare") - voir Emu_DoInt7A/Emu_DoInt2F. Modele "boucle         }
 { locale" : aucune autre machine sur le fil, donc tout paquet envoye est  }
 { livre a une ecoute active du MEME programme emule sur le meme socket,  }
 { instantanement ou des qu une ecoute correspondante est postee. Base sur }
 { la disposition verifiee du ECB (Event Control Block) et de l en-tete   }
 { IPX du pilote reseau de DOOM (id-Software/DOOM, ipx/IPXNET.H) et sur    }
 { les numeros de fonction INT 7Ah du Ralph Brown Interrupt List.         }
 TIpxBuf = Array[0..1023] Of Byte;

 TEmuIpxSocket = Record
  InUse     : Boolean;
  SocketNum : Word;
 End;

 { ECB en attente d une livraison (LISTEN FOR PACKET poste, aucun paquet   }
 { correspondant encore en file). }
 TEmuIpxPending = Record
  InUse     : Boolean;
  SocketNum : Word;
  ECBSeg, ECBOfs : Word;
 End;

 { Paquet IPX complet (en-tete 30 octets + charge utile) en attente d une  }
 { ecoute correspondante (SEND PACKET arrive avant tout LISTEN). }
 TEmuIpxQPacket = Record
  InUse      : Boolean;
  DestSocket : Word;
  Len        : Word;
  Data       : TIpxBuf;
 End;

 { Connexion SPX (au-dessus de la meme file de livraison IPX ci-dessus -   }
 { un paquet SPX EST un paquet IPX de PacketType=5h avec un en-tete SPX de }
 { 12 octets ajoute apres les 30 octets d en-tete IPX). }
 TEmuSpxConn = Record
  InUse        : Boolean;
  LocalSocket  : Word;
  RemoteSocket : Word;
  Established  : Boolean;
 End;

 TEmuIpxState = Record
  Active   : Boolean;              { vrai si case "Reseau Novell NetWare" }
                                    { cochee ET pile initialisee          }
  LocalNet  : Array[0..3] Of Byte; { numero de reseau synthetique         }
  LocalNode : Array[0..5] Of Byte; { adresse "materielle" synthetique     }
  Sockets   : Array[0..31] Of TEmuIpxSocket;
  Pending   : Array[0..15] Of TEmuIpxPending;
  Queue     : Array[0..15] Of TEmuIpxQPacket;
  NextDynSocket : Word;            { prochain socket dynamique (DX=0)     }
  Conns     : Array[0..15] Of TEmuSpxConn;
  NextConnId    : Word;
  StubSeg, StubOfs : Word;         { adresse du stub resident CD 7A CB    }
 End;

 { --- Pilote de paquets generique (Options > Emulateur > DOS > "Reseau    }
 { LAN") - PC/TCP Packet Driver Specification (FTP Software/Crynwr,       }
 { 1983), INT 60h. Voir Emu_DoInt60/Emu_PktInit. Modele "boucle locale"    }
 { identique a la pile IPX : un seul noeud virtuel, tout SEND_PKT est      }
 { compare aux filtres de TOUTES les poignees ouvertes et livre a celles   }
 { qui correspondent - la difference fondamentale avec IPX est que la     }
 { livraison d un paquet recu se fait EXCLUSIVEMENT par "upcall" (appel    }
 { far synchrone en 2 temps dans la fonction receiver enregistree par     }
 { l application, jamais par sondage d une structure comme le ECB IPX) :  }
 { il n y a donc pas de raccourci possible, contrairement a l ESR IPX -    }
 { voir Emu_PktCont/Emu_PktStartDelivery pour l injection reelle de code   }
 { invite (meme principe que Emu_FireHwInt pour les IRQ materielles, mais  }
 { enchainee sur 2 appels via un point de retour interne prive, INT FDh,   }
 { plutot qu un simple IRET). }
 TEmuPktHandle = Record
  InUse    : Boolean;
  IfClass  : Byte;                 { classe demandee (access_type AL)     }
  TypeSpec : Array[0..15] Of Byte; { motif de correspondance du type      }
  TypeLen  : Byte;                 { 0 = tout accepter (mode promiscuous) }
  RecvSeg, RecvOfs : Word;         { ES:DI du recepteur enregistre        }
  RcvMode  : Byte;                 { set_rcv_mode/get_rcv_mode, defaut 3  }
 End;

 { Machine a etats pour l injection de code invite en cours (livraison    }
 { reception 2 temps OU upcall as_send_pkt 1 temps - Stage disambigue) :  }
 {   Stage 0 = 1er appel recepteur (AX=0, demande de tampon) en vol       }
 {   Stage 1 = 2e appel recepteur (AX=1, livraison) en vol                }
 {   Stage 2 = upcall as_send_pkt (AX=resultat) en vol                    }
 TEmuPktCont = Record
  Pending  : Boolean;
  Stage    : Byte;
  HandleIdx: Integer;              { Stage 0/1 uniquement                }
  PktLen   : Word;
  Data     : TIpxBuf;
  BufSeg, BufOfs   : Word;         { tampon fourni par l appli (Stage 0->1)}
  SavedCS, SavedIP : Word;         { point de reprise apres toute la cascade}
  UpcallSeg, UpcallOfs : Word;     { Stage 2 uniquement                  }
 End;

 TEmuPktBacklogItem = Record
  InUse    : Boolean;
  HandleIdx: Integer;
  Len      : Word;
  Data     : TIpxBuf;
 End;

 TEmuPktStats = Record
  PacketsIn, PacketsOut : LongInt;
  BytesIn, BytesOut     : LongInt;
  ErrorsIn, ErrorsOut   : LongInt;
  PacketsLost           : LongInt;
 End;

 TEmuPktState = Record
  Active   : Boolean;
  Vector   : Byte;                 { = $60, seul vecteur emule            }
  LocalMAC : Array[0..5] Of Byte;  { adresse "materielle" synthetique     }
  Handles  : Array[0..7] Of TEmuPktHandle;
  NextHandleNum : Word;
  Cont     : TEmuPktCont;
  Backlog  : Array[0..7] Of TEmuPktBacklogItem; { autres poignees en      }
                                    { attente pour le MEME paquet envoye  }
  Stats    : TEmuPktStats;
  StubSeg, StubOfs : Word;         { signature de decouverte (jmp+PKT DRVR)}
  ContSeg, ContOfs : Word;         { trampoline de continuation (INT FDh) }
  NameSeg, NameOfs : Word;         { chaine ASCIIZ du nom (driver_info)   }
  { Upcall as_send_pkt (AH=11) en attente - voir Emu_PktFireAsSendUpcall  }
  { et la limite documentee (un seul upcall en vol a la fois). }
  AsSendPending    : Boolean;
  AsSendUpcallSeg, AsSendUpcallOfs : Word;
  AsSendBufSeg, AsSendBufOfs       : Word;
  AsSendResult     : Word;
 End;

 { --- Pilote XMS (Options > Emulateur > DOS: OS > "XMS") - eXtended       }
 { Memory Specification version 3.0 (Microsoft/Lotus/Intel/AST, 1991),     }
 { source verifiee : texte integral de la specification (xms30.txt).       }
 { Contrairement a IPX/Packet Driver, XMS n a PAS de numero d interruption }
 { dedie : l installation se verifie via INT 2Fh AX=4300h, et l adresse    }
 { d un point d entree "appel far direct" est obtenue via AX=4310h -       }
 { toutes les fonctions XMM (numero dans AH) passent ensuite par ce SEUL   }
 { appel far, jamais par interruption - voir Emu_DoIntFE/Emu_XmsInit.      }
 { Aucune des fonctions XMM de base ne necessite de rappeler du code       }
 { invite (pas d "upcall" comme Packet Driver) : chaque appel est          }
 { entierement synchrone, ce qui rend cette pile plus simple que les deux  }
 { precedentes malgre son nombre de fonctions. }
 TEmuXmsBuf = Array[0..EMU_XMS_CAP_KB * 1024 - 1] Of Byte;

 TEmuXmsHandle = Record
  InUse      : Boolean;
  SizeKB     : LongInt; { taille en Ko (32 bits pour AH=89h/8Fh) }
  LockCount  : Byte;
  StoreOffset: LongInt; { decalage en octets dans EmuXmsMem^ }
 End;

 TEmuXmsState = Record
  Active    : Boolean;
  StubSeg, StubOfs : Word;    { trampoline "appel far direct" (INT FEh)   }
  TotalKB   : LongInt;        { taille totale annoncee (DosXMSSize plafonne)}
  UsedBytes : LongInt;        { allocateur "bump" - voir Emu_XmsAlloc     }
  { Handle 0 = "memoire conventionnelle" par convention XMS (voir MOVE) - }
  { la table commence donc a l indice 1, comme les vrais handles XMS.     }
  Handles   : Array[1..64] Of TEmuXmsHandle;
  HmaOwned  : Boolean;         { HMA attribuee (fonctions 01h/02h)        }
  A20LocalCount : Integer;     { compteur local (fonctions 05h/06h)       }
  A20Global : Boolean;         { drapeau global (fonctions 03h/04h)       }
 End;

 { --- Pilote EMS (Options > Emulateur > DOS: OS > "EMS") - LIM/Microsoft  }
 { Expanded Memory Specification, versions 3.0/3.2/4.0 (source verifiee : }
 { limems40.txt, RBIL). INT 67h, numero de fonction dans AH (et parfois    }
 { un sous-numero dans AL, ex. 4Eh/50h/52h/53h/54h/57h/58h/59h). A         }
 { la difference de XMS, EMS est un VRAI numero d interruption (comme      }
 { Packet Driver) et non un point d entree obtenu par appel indirect.      }
 {                                                                        }
 { La case a cocher "Version EMS" (DosEMSVersion, 0=3.0/1=3.2/2=4.0)       }
 { determine QUELLES fonctions repondent - voir Emu_EmsVerAtLeast. C est   }
 { la demande explicite qui justifie ce champ : un developpeur qui teste   }
 { un programme cense fonctionner sous EMS 3.2 doit voir les fonctions     }
 { 4.0 echouer avec le code 84h ("fonction non definie"), exactement       }
 { comme sur un vrai gestionnaire EMS 3.2 qui ne les connait pas -         }
 { sans cette restriction, un programme mal ecrit qui suppose a tort la    }
 { presence de fonctions 4.0 pourrait sembler fonctionner alors qu il       }
 { echouerait sur du materiel/logiciel reel plus ancien.                   }
 {                                                                        }
 { Modele memoire : un tampon "memoire expansee" separe (EmuEmsMem, comme  }
 { EmuXmsMem) decoupe en pages fixes de 16 Ko, et une fenetre "page frame" }
 { de 4 emplacements de 16 Ko (EMU_EMS_FRAME_SEG) dans les 1 Mo            }
 { conventionnels (C.Memory) - Map/Unmap (44h) fait un VRAI va-et-vient de }
 { donnees entre les deux (bascule de banc), pas une simple redirection    }
 { d adresse, pour que la persistance des donnees d une page demappee      }
 { soit correcte quand elle est remappee plus tard - voir                  }
 { Emu_EmsSetSlot/Emu_EmsFlushSlot/Emu_EmsLoadSlot.                        }
 {                                                                        }
 { Limite assumee : le mode "adresse segment" de la fonction 50h (4.0,     }
 { AL=01h, qui permet en theorie de mapper une page EMS dans N IMPORTE     }
 { QUEL segment, pas seulement les 4 emplacements fixes de la page frame)  }
 { fait une copie ponctuelle sans suivi de banc persistant - les ecritures }
 { du programme dans ce segment ne seront pas reportees vers la memoire    }
 { expansee lors d un remappage ulterieur. Le mode "numero de page         }
 { physique" standard (AL=00h) et la fonction 44h, eux, ont une bascule    }
 { de banc complete et correcte. }
 TEmuEmsBuf = Array[0..EMU_EMS_CAP_KB * 1024 - 1] Of Byte;

 { Tampon "memoire etendue" DPMI separe (voir TEmuDpmiState/Dpmi_ReadByte) -}
 { meme principe que TEmuEmsBuf/TEmuXmsBuf : adresses lineaires DPMI       }
 { >= EMU_DPMI_EXT_BASE (1 Mo) redirigees ici plutot que vers P.CPU.Memory.}
 TDpmiExtBuf = Array[0..EMU_DPMI_EXT_CAP_KB * 1024 - 1] Of Byte;

 TEmuEmsHandle = Record
  InUse        : Boolean;
  PageCount    : Word;          { nombre de pages logiques de 16 Ko       }
  StorePageBase: LongInt;       { index de la 1ere page dans le pool EMS  }
  Attribute    : Byte;          { 0=volatile (EMS 4.0, fn 52h)            }
  Name         : Array[0..7] Of Byte; { nom 8 caracteres (EMS 4.0, fn 53h)}
 End;

 TEmuEmsSlot = Record          { un des 4 emplacements de la page frame   }
  MappedHandle : Word;          { 0 = aucune poignee mappee ici           }
  MappedPage   : Word;          { page logique actuellement chargee       }
 End;

 TEmuEmsState = Record
  Active     : Boolean;
  Version    : Byte;            { 0=3.0, 1=3.2, 2=4.0 (voir DosEMSVersion)}
  TotalPages : LongInt;         { capacite totale, en pages de 16 Ko      }
  UsedPages  : LongInt;         { allocateur "bump" en pages              }
  { Handle 0 n existe pas en EMS reel (contrairement a XMS) - la table     }
  { commence donc a l indice 1 comme les vrais handles EMM. }
  Handles    : Array[1..EMU_EMS_MAX_HANDLES] Of TEmuEmsHandle;
  Slots      : Array[0..3] Of TEmuEmsSlot;
  { Contexte de sauvegarde par poignee (fonctions 47h/48h, EMS 3.2+). }
  SavedSlots      : Array[1..EMU_EMS_MAX_HANDLES] Of Array[0..3] Of TEmuEmsSlot;
  SavedSlotsValid : Array[1..EMU_EMS_MAX_HANDLES] Of Boolean;
 End;

 { ========================================================================
   DPMI (DOS Protected Mode Interface, voir DOC/DPMI.txt) - coeur CPU 32   }
 { bits protege PARALLELE au coeur 8086 reel (P.CPU/TEmuCPU), et non une   }
 { extension de celui-ci : contrairement a l emulateur Linux ELF64 (memoire}
 { et registres entierement independants du reste de l IDE), ce coeur DOIT }
 { partager la memoire du programme DOS hote (P.CPU.Memory, voir           }
 { Dpmi_ReadByte/WriteByte) puisque le "client DPMI" est le MEME programme }
 { DOS qui vient de commuter en mode protege via INT 2Fh AX=1687h et       }
 { continue d appeler INT 21h/BIOS via les services DPMI "simuler          }
 { interruption mode reel" (AX=0300h, etape ulterieure) qui retombent sur  }
 { Emu_DoInt21 deja existant. Etat conserve en singleton global (DpmiCPU/  }
 { EmuDpmi), comme EmuEms/EmuXms/EmuMouse - un seul programme DOS          }
 { s execute a la fois dans cet IDE, donc pas besoin d un champ par panel. }
 { ======================================================================== }

 { Descripteur de segment logiciel (8 octets reels du x86, voir DOC/       }
 { DPMI.txt section 2.2) - stocke ici sous forme deja decodee plutot que   }
 { comme 8 octets bruts, sauf pour AX=000Bh/000Ch (descripteur brut) qui   }
 { re-assemblent AccessByte/FlagsByte a la volee. }
 TDpmiDescriptor = Record
  Present    : Boolean;
  Base       : LongInt;   { adresse lineaire de base }
  Limit      : LongInt;   { taille du segment moins 1, en octets (deja     }
                           { multiplie par 4096 si le bit G etait pose)    }
  AccessByte : Byte;      { octet de droits d acces brut (P/DPL/S/Type)    }
  FlagsByte  : Byte;      { octet de flags brut (G/D-B/L/AVL)              }
  Big        : Boolean;   { D/B=1 : segment "32 bits" (limite/adressage)   }
  IsCode     : Boolean;
 End;

 { LDT logicielle du client DPMI courant (voir DOC/DPMI.txt section 2.3 -  }
 { "le client peut allouer/modifier des descripteurs LDT" - la GDT elle-   }
 { meme n est pas exposee separement : un seul client actif a la fois dans}
 { cet emulateur, donc LDT et GDT seraient equivalentes en pratique). }
 TDpmiLDT = Array[0..EMU_DPMI_MAX_SEL] Of TDpmiDescriptor;

 { Poignee de bloc de memoire etendue DPMI (AX=0501h/0502h/0503h) - meme   }
 { principe d allocateur "bump" que EmuXms/EmuEms (voir leur commentaire   }
 { d en-tete respectif) : seulement recupere quand TOUTES les poignees     }
 { sont liberees simultanement. }
 TDpmiMemHandle = Record
  InUse   : Boolean;
  LinAddr : LongInt;
  Size    : LongInt;
 End;

 { Etat de configuration DPMI (case a cocher "DPMI"/"Taille", voir          }
 { Emu_DpmiInit) - separe de TDpmiCPU (etat d execution) comme              }
 { EmuEms/EmuXms separent deja configuration et etat d execution. }
 TEmuDpmiState = Record
  Active       : Boolean;   { case "DPMI" (DosDPMI) - voir Emu_DpmiInit }
  ExtCapBytes  : LongInt;   { plafond configure (DosDPMISize, en Ko*1024) }
  UsedBytes    : LongInt;   { allocateur "bump" de memoire etendue }
  Handles      : Array[0..EMU_DPMI_MAX_HANDLE - 1] Of TDpmiMemHandle;
  DosMemUsedOfs: Word;      { allocateur "bump" memoire DOS basse (AX=0100h),}
                             { offset courant dans EMU_DPMI_DOSMEM_SEG }
 End;

 { Etat d execution du coeur CPU 32 bits protege - actif seulement entre    }
 { l entree en mode protege (INT 2Fh AX=1687h) et la sortie finale (fin du }
 { programme). Reutilise TEmuFlags (drapeaux CF/ZF/SF/OF/... identiques en }
 { 32 bits) plutot que d en redefinir un jeu distinct. }
 TDpmiCPU = Record
  Active  : Boolean;    { le programme est actuellement en mode protege }
  Is32Bit : Boolean;    { AX=0/1 demande a l entree (16 ou 32 bits) }
  Reg     : TEmuRegs;   { reutilise le meme record variant EAX/AX/AL... que }
                         { le coeur 8086 (TEmuCPU.Regs) - memes alias }
  EIP     : LongInt;
  Flags   : TEmuFlags;
  SegSel  : Array[0..5] Of Word; { 0=ES 1=CS 2=SS 3=DS 4=FS 5=GS,           }
                                  { selecteurs (pas des segments reels)     }
  LDT      : TDpmiLDT;
  LDTCount : Integer;   { nombre d entrees allouees, pour AX=0000h }
  { Point de reprise en mode reel (CS:IP/SS:SP captures au moment de la    }
  { commutation initiale AX=1687h) - restaure a la sortie DPMI finale.     }
  RealCS, RealIP, RealSS, RealSP : Word;
  { Vecteurs d exception/interruption mode protege installes par le        }
  { client (AX=0203h/0205h, etape ulterieure) - Sel/Ofs par numero 0..FFh. }
  IntSel : Array[0..255] Of Word;
  IntOfs : Array[0..255] Of LongInt;
  { Rappels mode reel installes par AX=0303h (etape ulterieure). }
  CbUsed    : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Boolean;
  CbPmSel   : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
  CbPmOfs   : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of LongInt;
  CbRealSeg : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
  CbRealOfs : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
 End;

 { Operande decode a partir d un octet ModR/M (+ eventuel SIB) par          }
 { Dpmi_DecodeModRM - equivalent 32 bits proteges de TEmuOperand (coeur     }
 { 8086), mais LinAddr est deja l adresse LINEAIRE finale (base du          }
 { selecteur + deplacement), pas un couple segment:offset. }
 TDpmiOperand = Record
  IsReg  : Boolean;
  RegNum : Byte;
  LinAddr: LongInt;
  Len    : Integer;      { octets consommes (ModRM + SIB + deplacement) }
 End;

 { RealModeCallStructure (50 octets, voir DOC/DPMI.txt 7.1) utilisee par    }
 { AX=0300h/0301h/0302h - voir Dpmi_ReadRMCall/Dpmi_WriteRMCall. }
 TDpmiRMCall = Record
  EDI, ESI, EBP, EBX, EDX, ECX, EAX : LongInt;
  Flags, ESeg, DSeg, FSeg, GSeg, IPw, CSw, SPw, SSw : Word;
 End;

 { Etat de l emulateur 8086 + ecran virtuel + clavier }
 TEmulatorPanel = Record
  Base       : TDialog;          { dialogue de base                }
  Visible    : Boolean;          { panneau visible                 }
  Running    : Boolean;          { execution en cours              }
  Fault      : Integer;          { code de fin (sf*)               }
  BinaryPath : String[127];      { chemin du binaire DOS charge    }
  TargetCPU  : String[16];       { drapeau cible (-CD ou -CP)      }
  CPU        : TEmuCPU;          { etat complet du processeur 8086 }
  { Ecran virtuel 80 colonnes x 25 lignes }
  { Borne a 131 (132 colonnes) pour supporter le mode texte couleur       }
  { 132x25 de la carte ATI Graphics Solution (Options > Emulateur > DOS). }
  VRAM       : Array[0..24, 0..131] Of TEmuCell;
  CursorX    : Byte;             { colonne curseur (0..79)         }
  CursorY    : Byte;             { ligne curseur (0..24)           }
  CurFg      : Byte;             { couleur courante FG             }
  CurBg      : Byte;             { couleur courante BG             }
  CursorOn   : Boolean;          { curseur visible (clignotant)    }
  { File d attente clavier (ring buffer 64 entrees Word :
    octet bas = ASCII, octet haut = scancode BIOS) }
  KeyBuf     : Array[0..63] Of Word;
  KeyHead    : Byte;
  KeyTail    : Byte;
  { Geometrie du panneau }
  PanelX     : Integer;
  PanelY     : Integer;
  CharW      : Integer;          { largeur d un caractere (px)     }
  CharH      : Integer;          { hauteur d un caractere (px)     }
  Cols       : Integer;          { colonnes effectives (40 ou 80)  }
  Rows       : Integer;          { lignes effectives (typ. 25)     }
  NeedRepaint: Boolean;          { redessin complet requis         }
  StatusMsg  : String[127];      { message d etat affiche en bas   }
  { Stage 1 "multi-fenetre" (2026-08-15) : Loaded distingue "binaire      }
  { charge, execution pilotee par petits pas via l idle-tick de MainLoop" }
  { de l ancien modele "ShowEmulatorPanel bloque jusqu a la fin". Seuls    }
  { les backends convertis (voir EmuPanel_ContinueStep) positionnent      }
  { Loaded a True ; les autres restent sur l ancien chemin bloquant        }
  { inchange (Loaded jamais mis a True pour eux). TotalSteps remplace la   }
  { variable locale "Steps" qui ne peut plus survivre entre les appels.    }
  Loaded     : Boolean;
  TotalSteps : LongInt;
 End;

 { Stage 2 "multi-onglets emulateur" (2026-08-15) : instantane complet de }
 { tout l etat C64 qui vit dans des GLOBALES partagees (CPU6502_*/C64_*)  }
 { plutot que dans TEmulatorPanel - necessaire pour qu un onglet C64 non    }
 { actif garde son etat intact pendant qu un AUTRE onglet (texte, ou un     }
 { second C64) est actif. Un seul de ces instantanes est "en vigueur" a la }
 { fois (celui de l onglet actif est charge dans les globales, voir          }
 { C64_LoadState/C64_SaveState + SyncActiveWindowOut/In) - PAS d execution }
 { concurrente reelle, seulement une pause/reprise par bascule d onglet,    }
 { exactement comme demande ("l emulateur non actif se met en pause"). }
 { Types NOMMES (pas anonymes) pour les tableaux partages entre les          }
 { globales CPU6502_*/C64_* et TC64Snapshot - FPC traite deux tableaux         }
 { anonymes de meme forme comme des types DIFFERENTS, incompatibles pour        }
 { l affectation (`:=`) meme s ils sont structurellement identiques ; un        }
 { type nomme partage est necessaire pour que C64_SaveState/C64_LoadState        }
 { puissent faire de simples affectations de tableau entier. }
 T6502MemArr      = Array[0..$FFFF] Of Byte;
 TC64HiRamArr     = Array[$A000..$FFFF] Of Byte;
 TC64VicRegArr    = Array[0..$3F] Of Byte;
 TC64SidRegArr    = Array[0..$1F] Of Byte;
 TC64ColorRamArr  = Array[0..$3FF] Of Byte;
 TC64CiaRegArr    = Array[0..$0F] Of Byte;
 TC64KeyMatrixArr = Array[0..7, 0..7] Of Boolean;

 TC64Snapshot = Record
  Mem            : T6502MemArr;
  HiRam          : TC64HiRamArr;
  A, X, Y, P, S  : Byte;
  PC             : Word;
  Halted         : Boolean;
  ExitCode       : Integer;
  Variant        : Integer;
  Port01, Port00 : Byte;
  VicReg         : TC64VicRegArr;
  SidReg         : TC64SidRegArr;
  ColorRam       : TC64ColorRamArr;
  Cia1Reg        : TC64CiaRegArr;
  Cia2Reg        : TC64CiaRegArr;
  Cia1TimerA, Cia1TimerALatch: Word;
  Cia1TimerB, Cia1TimerBLatch: Word;
  Cia1IcrMask, Cia1IcrPending: Byte;
  IrqPending     : Boolean;
  KeyMatrix      : TC64KeyMatrixArr;
  FrameNo        : LongInt;
  RasterLine     : Word;
  RasterAcc      : Integer;
  PendingInject  : String;
  TypeIdx        : Integer;
  TypeCounter    : Integer;
  TypePressed    : Boolean;
  PendingVartab  : Word;
  PendingJumpPC  : Word;
  AsyncKeyEsc    : Boolean;
  AsyncLastFrameTS: LongInt;
 End;

 { Meme motif que TC64Snapshot (Stage 1+2, meme session 2026-08-15),      }
 { backends NES/Atari 2600. Contrairement a TC64Snapshot, les champs      }
 { tableaux ne reutilisent PAS de type nomme partage : Nes_SaveState/     }
 { Nes_LoadState (et A2600 plus bas) utilisent Move() plutot que `:=`     }
 { pour ces champs, ce qui contourne l incompatibilite FPC entre deux     }
 { tableaux anonymes de meme forme SANS avoir a retyper les globales      }
 { NesXxx/A2600_Xxx elles-memes (Move() ne verifie que la taille, pas le  }
 { type). CPU/Mem reutilise T6502MemArr (deja partage avec C64/A2600 -    }
 { meme coeur 6502 generique) car ce champ-la utilise bien `:=`. }
 TNesSnapshot = Record
  Mem            : T6502MemArr;
  A, X, Y, P, S  : Byte;
  PC             : Word;
  Halted         : Boolean;
  ExitCode       : Integer;
  Variant        : Integer;
  Chr            : Array[0..$1FFF] Of Byte;
  NT             : Array[0..$7FF] Of Byte;
  Pal            : Array[0..$1F] Of Byte;
  Oam            : Array[0..$FF] Of Byte;
  FB             : Array[0..239, 0..255] Of Byte;
  FBPrev         : Array[0..239, 0..255] Of Byte;
  FBFirst        : Boolean;
  PpuCtrl, PpuMask, PpuStatus, OamAddr : Byte;
  ScrollX, ScrollY : Byte;
  PpuLatch       : Boolean;
  PpuAddr        : Word;
  PpuBuf         : Byte;
  Mirror         : Byte;
  PadStrobe      : Byte;
  NmiPending     : Boolean;
  FrameDone      : Boolean;
  FrameNo        : LongInt;
  Pad1, Pad2, Pad1Sh, Pad2Sh : Byte;
  PrgRom         : Array[0..$7FFFF] Of Byte;
  ChrRom         : Array[0..$3FFFF] Of Byte;
  PrgBlocksTotal, ChrBlocksTotal : Integer;
  Mapper         : Integer;
  UseChrRam      : Boolean;
  M1Shift, M1ShiftCount, M1Ctrl, M1Chr0, M1Chr1, M1Prg : Byte;
  M3BankSelect   : Byte;
  M3Banks        : Array[0..7] Of Byte;
  AsyncKeyEsc    : Boolean;
  AsyncLastFrameTS: LongInt;
 End;

 { Meme motif que TNesSnapshot (Move() pour les tableaux), backend Atari  }
 { 2600 - le plus gros des trois par NOMBRE de champs (nombreux schemas   }
 { de bank-switching de cartouche : F8/F6/F4/F8SC/F6SC/F4SC/FA/FE/E0/3F/  }
 { E7/3E/3E+/AR, chacun avec son propre etat), mais PAS par taille (les   }
 { tableaux restent petits, quelques dizaines de Ko au total). Les champs }
 { dont le nom d origine commence par un chiffre (A2600_3E_xxx, A2600_3EP_}
 { xxx) sont renommes E3_xxx/E3P_xxx ici - Pascal interdit un identifiant }
