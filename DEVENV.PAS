  Else If TargetCPU = '-CADAM' Then Begin
   Z80_Variant := 2;
   Loaded := Z80_LoadCom(BinaryPath, EntryAddr16);
  End;
  If Not Loaded Then Begin
   P.CurFg := 12;
   EmuVScr_WriteStr(P,
    'Erreur : impossible de charger ' + BinaryPath);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
