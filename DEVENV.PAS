{ --- Taille d une instruction 6502 (1, 2 ou 3 octets) --- }

Function EmuDbg_Size6502(Op: Byte): Integer;
Begin
 { Implicit / accumulateur : 1 octet }
 Case Op Of
  $00,$08,$0A,$18,$28,$2A,$38,$40,$48,$4A,$58,$60,$68,$6A,
  $78,$88,$8A,$98,$9A,$A8,$AA,$B8,$BA,$C8,$CA,$D8,$E8,$EA,$F8:
   EmuDbg_Size6502 := 1;
  { Absolu / absolu indirect / absolu indexe : 3 octets }
  $0D,$0E,$19,$1D,$1E,$20,$2C,$2D,$2E,$39,$3D,$3E,$4C,$4D,$4E,
  $59,$5D,$5E,$6C,$6D,$6E,$79,$7D,$7E,$8C,$8D,$8E,$99,$9D,
  $AC,$AD,$AE,$B9,$BC,$BD,$BE,$CC,$CD,$CE,$D9,$DD,$DE,
  $EC,$ED,$EE,$F9,$FD,$FE:
   EmuDbg_Size6502 := 3;
  Else
   { Tous les autres (immediat, zero-page, branches relatives) : 2 octets }
   EmuDbg_Size6502 := 2;
 End;
End;

{ --- Detecter si l opcode 6502 est un appel de sous-programme (JSR) --- }

Function EmuDbg_IsCall6502(Op: Byte): Boolean;
Begin
 EmuDbg_IsCall6502 := (Op = $20);
End;

{ --- Detecter si l opcode 6502 est un retour (RTS, RTI) --- }

Function EmuDbg_IsRet6502(Op: Byte): Boolean;
Begin
 EmuDbg_IsRet6502 := (Op = $60) Or (Op = $40);
End;

{ --- Lecture securisee de memoire 6502 --- }

Function EmuDbg_Mem6502(Addr: LongInt): Byte;
Begin
 EmuDbg_Mem6502 := CPU6502_Mem[Addr And $FFFF];
End;

{ --- Desassembler une instruction 6502 a Addr --- }

Function EmuDbg_Disasm6502(Addr: Word; Var Size: Integer): String;
Var
 Op, B1, B2: Byte;
 S, Mn, Operand: String;
Begin
 Op := EmuDbg_Mem6502(Addr);
 Size := EmuDbg_Size6502(Op);
 Mn := EmuDbg_Mnem6502(Op);
 Operand := '';
 If Size = 1 Then Operand := ''
 Else If Size = 2 Then Begin
  B1 := EmuDbg_Mem6502((Addr + 1) And $FFFF);
  { Branche relative : afficher l adresse cible }
  Case Op Of
   $10,$30,$50,$70,$90,$B0,$D0,$F0:
    Operand := '$' + HexWord(Word(LongInt(Addr) + 2 + ShortInt(B1)));
   Else
    Operand := '#$' + HexByte(B1);
  End;
 End Else Begin
  B1 := EmuDbg_Mem6502((Addr + 1) And $FFFF);
  B2 := EmuDbg_Mem6502((Addr + 2) And $FFFF);
  Operand := '$' + HexWord(B1 Or (LongInt(B2) Shl 8));
 End;
 S := HexWord(Addr) + '  ' + HexByte(Op);
 If Size >= 2 Then
  S := S + ' ' + HexByte(EmuDbg_Mem6502((Addr + 1) And $FFFF))
 Else
  S := S + '   ';
 If Size >= 3 Then
  S := S + ' ' + HexByte(EmuDbg_Mem6502((Addr + 2) And $FFFF))
 Else
  S := S + '   ';
 S := S + '  ' + Mn;
 If Operand <> '' Then S := S + ' ' + Operand;
 EmuDbg_Disasm6502 := S;
End;

{ --- Lecture securisee de memoire 6809 (via la map physique CPU) --- }

Function EmuDbg_Mem6809(Addr: LongInt): Byte;
Begin
 EmuDbg_Mem6809 := M6809_Mem[Addr And $FFFF];
End;

{ --- Detecter si l opcode 6809 est un appel (BSR, LBSR, JSR ext/ind) --- }

Function EmuDbg_IsCall6809(PC: Word): Boolean;
Var
 Op: Byte;
Begin
 Op := EmuDbg_Mem6809(PC);
 EmuDbg_IsCall6809 :=
  (Op = $8D) Or   { BSR rel8 }
  (Op = $17) Or   { LBSR rel16 }
  (Op = $9D) Or   { JSR direct }
  (Op = $AD) Or   { JSR indexed }
  (Op = $BD);     { JSR extended }
End;

{ --- Detecter si l opcode 6809 est un retour (RTS, RTI) --- }

Function EmuDbg_IsRet6809(Op: Byte): Boolean;
Begin
 EmuDbg_IsRet6809 := (Op = $39) Or (Op = $3B);
End;

{ --- Mnemonique 6809 (table simplifiee couvrant les opcodes courants).
      Retourne '???' pour les opcodes non reconnus. --- }

Function EmuDbg_Mnem6809(Op: Byte): String;
Var
 Hi, Lo: Byte;
 M: String;
Const
 InhTab: Array[0..15] Of String[5] = (
  'NEG',  '?',    '?',    'COM',  'LSR',  '?',    'ROR',  'ASR',
  'ASL',  'ROL',  'DEC',  '?',    'INC',  'TST',  'JMP',  'CLR'
 );
 ATab: Array[0..15] Of String[5] = (
  'SUBA', 'CMPA', 'SBCA', 'SUBD', 'ANDA', 'BITA', 'LDA',  'STA',
  'EORA', 'ADCA', 'ORA',  'ADDA', 'CMPX', 'JSR',  'LDX',  'STX'
 );
 BTab: Array[0..15] Of String[5] = (
  'SUBB', 'CMPB', 'SBCB', 'ADDD', 'ANDB', 'BITB', 'LDB',  'STB',
  'EORB', 'ADCB', 'ORB',  'ADDB', 'LDD',  'STD',  'LDU',  'STU'
 );
Begin
 Hi := Op Shr 4;
 Lo := Op And $F;
 M := '???';
 Case Hi Of
  0: M := InhTab[Lo];                     { direct }
  4: Begin M := InhTab[Lo];
           If M <> '?' Then M := M + 'A'; { inherent A }
     End;
  5: Begin M := InhTab[Lo];
           If M <> '?' Then M := M + 'B'; { inherent B }
     End;
  6,7: M := InhTab[Lo];                   { indexed / extended }
  1: Case Op Of
      $12: M := 'NOP';   $13: M := 'SYNC';  $16: M := 'LBRA';
      $17: M := 'LBSR';  $19: M := 'DAA';   $1A: M := 'ORCC';
      $1C: M := 'ANDCC'; $1D: M := 'SEX';   $1E: M := 'EXG';
      $1F: M := 'TFR';   $10: M := 'PG2';   $11: M := 'PG3';
     End;
  2: Case Op Of
      $20: M := 'BRA';   $21: M := 'BRN';   $22: M := 'BHI';
      $23: M := 'BLS';   $24: M := 'BCC';   $25: M := 'BCS';
      $26: M := 'BNE';   $27: M := 'BEQ';   $28: M := 'BVC';
      $29: M := 'BVS';   $2A: M := 'BPL';   $2B: M := 'BMI';
      $2C: M := 'BGE';   $2D: M := 'BLT';   $2E: M := 'BGT';
      $2F: M := 'BLE';
     End;
  3: Case Op Of
      $30: M := 'LEAX';  $31: M := 'LEAY';  $32: M := 'LEAS';
      $33: M := 'LEAU';  $34: M := 'PSHS';  $35: M := 'PULS';
      $36: M := 'PSHU';  $37: M := 'PULU';  $39: M := 'RTS';
      $3A: M := 'ABX';   $3B: M := 'RTI';   $3C: M := 'CWAI';
      $3D: M := 'MUL';   $3F: M := 'SWI';
     End;
  8,9,$A,$B: Begin                           { accumulateur A }
   M := ATab[Lo];
   If (Op = $8D) Then M := 'BSR';           { BSR rel8 }
  End;
  $C,$D,$E,$F: M := BTab[Lo];                { accumulateur B }
 End;
 EmuDbg_Mnem6809 := M;
End;

{ --- Taille en octets d une instruction 6809 (approximation : on
      ignore l expansion postbyte indexee pour rester simple). --- }

Function EmuDbg_Size6809(Op: Byte): Integer;
Var
 Hi, Lo: Byte;
Begin
 Hi := Op Shr 4;
 Lo := Op And $F;
 Case Op Of
  $12,$13,$19,$1D,$39,$3A,$3B,$3D,$3F: EmuDbg_Size6809 := 1;
  $10,$11: EmuDbg_Size6809 := 2; { page prefixes, approx }
  $16,$17: EmuDbg_Size6809 := 3; { LBRA/LBSR rel16 }
  $1A,$1C,$1E,$1F,$3C: EmuDbg_Size6809 := 2;
  $34,$35,$36,$37: EmuDbg_Size6809 := 2; { push/pull }
  Else Case Hi Of
   0,9,$D: EmuDbg_Size6809 := 2;          { direct }
   2: EmuDbg_Size6809 := 2;               { branches courtes }
   3,$6,$A,$E: EmuDbg_Size6809 := 2;      { indexed (postbyte simple) }
   4,5: EmuDbg_Size6809 := 1;             { inherent A/B }
   7,$B,$F: EmuDbg_Size6809 := 3;         { extended }
   8,$C: Begin
    { Immediate : 8 ou 16 bits suivant l opcode }
    Case Lo Of
     3,$C,$E: EmuDbg_Size6809 := 3;       { 16-bit immediate }
     Else     EmuDbg_Size6809 := 2;       { 8-bit immediate }
    End;
   End;
   Else EmuDbg_Size6809 := 1;
  End;
 End;
End;

{ --- Desassembler une instruction 6809 a Addr. Affichage minimal :
      adresse + jusqu a 3 octets + mnemonique + operande brut. --- }

Function EmuDbg_Disasm6809(Addr: Word; Var Size: Integer): String;
Var
 Op, B1, B2: Byte;
 S, Mn, Operand: String;
Begin
 Op := EmuDbg_Mem6809(Addr);
 Size := EmuDbg_Size6809(Op);
 If Size < 1 Then Size := 1;
 Mn := EmuDbg_Mnem6809(Op);
 Operand := '';
 If Size = 2 Then Begin
  B1 := EmuDbg_Mem6809((Addr + 1) And $FFFF);
  { Branches courtes : afficher cible absolue }
  If ((Op And $F0) = $20) Or (Op = $8D) Then
   Operand := '$' + HexWord(Word(LongInt(Addr) + 2 + ShortInt(B1)))
  Else
   Operand := '$' + HexByte(B1);
 End Else If Size = 3 Then Begin
  B1 := EmuDbg_Mem6809((Addr + 1) And $FFFF);
  B2 := EmuDbg_Mem6809((Addr + 2) And $FFFF);
  { LBRA / LBSR : offset signe 16 bits relatif }
  If (Op = $16) Or (Op = $17) Then
   Operand := '$' + HexWord(Word(LongInt(Addr) + 3 +
    SmallInt((LongInt(B1) Shl 8) Or B2)))
  Else
   Operand := '$' + HexWord((LongInt(B1) Shl 8) Or B2);
 End;
 S := HexWord(Addr) + '  ' + HexByte(Op);
 If Size >= 2 Then
  S := S + ' ' + HexByte(EmuDbg_Mem6809((Addr + 1) And $FFFF))
 Else
  S := S + '   ';
 If Size >= 3 Then
  S := S + ' ' + HexByte(EmuDbg_Mem6809((Addr + 2) And $FFFF))
 Else
  S := S + '   ';
 S := S + '  ' + Mn;
 If Operand <> '' Then S := S + ' ' + Operand;
 EmuDbg_Disasm6809 := S;
End;

{ --- Desassembler ligne 8086 a CS:IP (minimal : hex + mnemonique brut) --- }

{$PUSH}{$Q-}{$R-}

{ --- ModRM 16 bits : retourne l operande memoire/registre et fait
      avancer Sz (octets consommes apres l opcode incluant ModRM). --- }

Function EmuDbg_DecodeModRM16(Seg, Ofs: Word; IsWord: Boolean;
 Var Sz: Integer): String;
Const
 R8N : Array[0..7] Of String[3] = ('AL','CL','DL','BL','AH','CH','DH','BH');
 R16N: Array[0..7] Of String[3] = ('AX','CX','DX','BX','SP','BP','SI','DI');
 EAM : Array[0..7] Of String[8] =
  ('[BX+SI]','[BX+DI]','[BP+SI]','[BP+DI]','[SI]','[DI]','[BP]','[BX]');
Var
 B, MdR, RegM, RM: Byte;
 Disp: Word;
 D8: ShortInt;
 ExtraOfs: Integer;
 R: String;
Begin
 B := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Sz));
 MdR := B Shr 6;
 RegM := (B Shr 3) And 7;
 RM := B And 7;
 Inc(Sz);
 ExtraOfs := Sz;
 Case MdR Of
  0: Begin
   If RM = 6 Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + ExtraOfs)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + ExtraOfs + 1))) Shl 8);
    Inc(Sz, 2);
    R := '[$' + HexWord(Disp) + ']';
   End Else
    R := EAM[RM];
  End;
  1: Begin
   D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + ExtraOfs)));
   Inc(Sz);
   If D8 >= 0 Then
    R := Copy(EAM[RM], 1, Length(EAM[RM]) - 1) +
     '+$' + HexByte(Byte(D8)) + ']'
   Else
    R := Copy(EAM[RM], 1, Length(EAM[RM]) - 1) +
     '-$' + HexByte(Byte(-D8)) + ']';
  End;
  2: Begin
   Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + ExtraOfs)) Or
          (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + ExtraOfs + 1))) Shl 8);
   Inc(Sz, 2);
   R := Copy(EAM[RM], 1, Length(EAM[RM]) - 1) +
    '+$' + HexWord(Disp) + ']';
  End;
  Else { 3 } Begin
   If IsWord Then R := R16N[RM]
   Else R := R8N[RM];
  End;
 End;
 { Pour la commodite : exposer aussi RegM dans la string (suffixe special) }
 EmuDbg_DecodeModRM16 := R + '|' + Char(48 + RegM);
End;

{ --- Desassembleur 8086 : decode taille + mnemonique. La taille est
      toujours correcte (indispensable pour la navigation du listing).
      Les operandes sont decodes pour les opcodes courants. --- }

Function EmuDbg_Disasm8086(Seg, Ofs: Word; Var Size: Integer): String;
Const
 R8N : Array[0..7] Of String[3] = ('AL','CL','DL','BL','AH','CH','DH','BH');
 R16N: Array[0..7] Of String[3] = ('AX','CX','DX','BX','SP','BP','SI','DI');
 SRN : Array[0..3] Of String[3] = ('ES','CS','SS','DS');
 ALU : Array[0..7] Of String[4] =
  ('ADD','OR','ADC','SBB','AND','SUB','XOR','CMP');
 JCC : Array[0..15] Of String[4] =
  ('JO','JNO','JB','JNB','JZ','JNZ','JBE','JA',
   'JS','JNS','JP','JNP','JL','JGE','JLE','JG');
 SHIFTN: Array[0..7] Of String[4] =
  ('ROL','ROR','RCL','RCR','SHL','SHR','???','SAR');
 GRP1: Array[0..7] Of String[4] =
  ('TEST','???','NOT','NEG','MUL','IMUL','DIV','IDIV');
Var
 B0, B1: Byte;
 OpStart: Integer;     { offset relatif a Ofs ou commence l opcode      }
 Prefix: String;
 Mn, Op: String;
 W, D, S, RegBit: Boolean;
 RegM: Byte;
 Disp: Word;
 D8: ShortInt;
 D16: SmallInt;
 SubOp: Byte;
 BytesS: String;
 Tmp: String;
 P: Integer;
 BPos: Integer;
 BAlu: Byte;
 BB: Byte;
 I: Integer;
Begin
 Size := 0;
 OpStart := 0;
 Prefix := '';
 { --- Avaler les prefixes (segment / REP / LOCK) --- }
 Repeat
  B0 := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size));
  Case B0 Of
   $26: Prefix := Prefix + 'ES:';
   $2E: Prefix := Prefix + 'CS:';
   $36: Prefix := Prefix + 'SS:';
   $3E: Prefix := Prefix + 'DS:';
   $F0: Prefix := Prefix + 'LOCK ';
   $F2: Prefix := Prefix + 'REPNE ';
   $F3: Prefix := Prefix + 'REP ';
   Else Break;
  End;
  Inc(Size);
  Inc(OpStart);
  If Size > 4 Then Break;
 Until False;
 B0 := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size));
 Inc(Size);
 Mn := '???'; Op := '';
 { --- Decodage principal --- }
 If B0 <= $3F Then Begin
  { ALU r/m, r ; r, r/m ; AL/AX, imm }
  BAlu := B0 Shr 3;
  Case BAlu Of
   0,1,2,3,4,5,6,7: Begin
    Mn := ALU[BAlu];
    Case B0 And 7 Of
     0,1,2,3: Begin
      W := (B0 And 1) <> 0;
      D := (B0 And 2) <> 0;
      Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
      P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
      If W Then Tmp := R16N[RegM] Else Tmp := R8N[RegM];
      If D Then Op := Tmp + ',' + Op Else Op := Op + ',' + Tmp;
     End;
     4: Begin Op := 'AL,$' +
       HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size); End;
     5: Begin
      Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
             (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
      Op := 'AX,$' + HexWord(Disp); Inc(Size, 2);
     End;
     6: Begin Mn := 'PUSH'; Op := SRN[BAlu]; End;
     7: Begin Mn := 'POP'; Op := SRN[BAlu];
      If BAlu = 1 Then Begin Mn := '???'; Op := ''; End; { POP CS invalide }
     End;
    End;
   End;
  End;
 End Else If (B0 >= $40) And (B0 <= $47) Then Begin
  Mn := 'INC'; Op := R16N[B0 - $40];
 End Else If (B0 >= $48) And (B0 <= $4F) Then Begin
  Mn := 'DEC'; Op := R16N[B0 - $48];
 End Else If (B0 >= $50) And (B0 <= $57) Then Begin
  Mn := 'PUSH'; Op := R16N[B0 - $50];
 End Else If (B0 >= $58) And (B0 <= $5F) Then Begin
  Mn := 'POP'; Op := R16N[B0 - $58];
 End Else If B0 = $60 Then Mn := 'PUSHA'
   Else If B0 = $61 Then Mn := 'POPA'
   Else If B0 = $68 Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'PUSH'; Op := '$' + HexWord(Disp); Inc(Size, 2);
   End Else If B0 = $6A Then Begin
    Mn := 'PUSH'; Op := '$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If (B0 >= $70) And (B0 <= $7F) Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := JCC[B0 - $70];
    Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If (B0 >= $80) And (B0 <= $83) Then Begin
    W := (B0 And 1) <> 0;
    S := (B0 And 2) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := ALU[SubOp];
    If W And (Not S) Then Begin
     Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
            (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
     Op := Op + ',$' + HexWord(Disp); Inc(Size, 2);
    End Else Begin
     Op := Op + ',$' +
      HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
     Inc(Size);
    End;
   End Else If (B0 = $84) Or (B0 = $85) Then Begin
    W := (B0 And 1) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'TEST';
    If W Then Op := Op + ',' + R16N[RegM] Else Op := Op + ',' + R8N[RegM];
   End Else If (B0 = $86) Or (B0 = $87) Then Begin
    W := (B0 And 1) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'XCHG';
    If W Then Op := Op + ',' + R16N[RegM] Else Op := Op + ',' + R8N[RegM];
   End Else If (B0 >= $88) And (B0 <= $8B) Then Begin
    W := (B0 And 1) <> 0;
    D := (B0 And 2) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'MOV';
    If W Then Tmp := R16N[RegM] Else Tmp := R8N[RegM];
    If D Then Op := Tmp + ',' + Op Else Op := Op + ',' + Tmp;
   End Else If B0 = $8C Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'MOV'; Op := Op + ',' + SRN[RegM And 3];
   End Else If B0 = $8D Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'LEA'; Op := R16N[RegM] + ',' + Op;
   End Else If B0 = $8E Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'MOV'; Op := SRN[RegM And 3] + ',' + Op;
   End Else If B0 = $8F Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); Op := Copy(Op, 1, P - 1);
    Mn := 'POP';
   End Else If B0 = $90 Then Mn := 'NOP'
   Else If (B0 >= $91) And (B0 <= $97) Then Begin
    Mn := 'XCHG'; Op := 'AX,' + R16N[B0 - $90];
   End Else If B0 = $98 Then Mn := 'CBW'
   Else If B0 = $99 Then Mn := 'CWD'
   Else If B0 = $9A Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Inc(Size, 2);
    Op := '$' + HexWord(
     Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
     (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8)) +
     ':$' + HexWord(Disp);
    Inc(Size, 2);
    Mn := 'CALL FAR';
   End Else If B0 = $9B Then Mn := 'WAIT'
   Else If B0 = $9C Then Mn := 'PUSHF'
   Else If B0 = $9D Then Mn := 'POPF'
   Else If B0 = $9E Then Mn := 'SAHF'
   Else If B0 = $9F Then Mn := 'LAHF'
   Else If (B0 >= $A0) And (B0 <= $A3) Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Inc(Size, 2);
    Mn := 'MOV';
    W := (B0 And 1) <> 0;
    If B0 < $A2 Then Begin
     If W Then Op := 'AX,[$' + HexWord(Disp) + ']'
     Else Op := 'AL,[$' + HexWord(Disp) + ']';
    End Else Begin
     If W Then Op := '[$' + HexWord(Disp) + '],AX'
     Else Op := '[$' + HexWord(Disp) + '],AL';
    End;
   End Else If B0 = $A4 Then Mn := 'MOVSB'
   Else If B0 = $A5 Then Mn := 'MOVSW'
   Else If B0 = $A6 Then Mn := 'CMPSB'
   Else If B0 = $A7 Then Mn := 'CMPSW'
   Else If B0 = $A8 Then Begin
    Mn := 'TEST'; Op := 'AL,$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $A9 Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'TEST'; Op := 'AX,$' + HexWord(Disp); Inc(Size, 2);
   End Else If B0 = $AA Then Mn := 'STOSB'
   Else If B0 = $AB Then Mn := 'STOSW'
   Else If B0 = $AC Then Mn := 'LODSB'
   Else If B0 = $AD Then Mn := 'LODSW'
   Else If B0 = $AE Then Mn := 'SCASB'
   Else If B0 = $AF Then Mn := 'SCASW'
   Else If (B0 >= $B0) And (B0 <= $B7) Then Begin
    Mn := 'MOV'; Op := R8N[B0 - $B0] + ',$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If (B0 >= $B8) And (B0 <= $BF) Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'MOV'; Op := R16N[B0 - $B8] + ',$' + HexWord(Disp); Inc(Size, 2);
   End Else If (B0 = $C0) Or (B0 = $C1) Then Begin
    W := (B0 And 1) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := SHIFTN[SubOp];
    Op := Op + ',$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $C2 Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'RET'; Op := '$' + HexWord(Disp); Inc(Size, 2);
   End Else If B0 = $C3 Then Mn := 'RET'
   Else If B0 = $C4 Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'LES'; Op := R16N[RegM] + ',' + Op;
   End Else If B0 = $C5 Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); RegM := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := 'LDS'; Op := R16N[RegM] + ',' + Op;
   End Else If B0 = $C6 Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, False, Size);
    P := Pos('|', Op); Op := Copy(Op, 1, P - 1);
    Mn := 'MOV'; Op := Op + ',$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $C7 Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); Op := Copy(Op, 1, P - 1);
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'MOV'; Op := Op + ',$' + HexWord(Disp); Inc(Size, 2);
   End Else If B0 = $C8 Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Inc(Size, 2);
    Mn := 'ENTER'; Op := '$' + HexWord(Disp) + ',$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $C9 Then Mn := 'LEAVE'
   Else If B0 = $CA Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Mn := 'RETF'; Op := '$' + HexWord(Disp); Inc(Size, 2);
   End Else If B0 = $CB Then Mn := 'RETF'
   Else If B0 = $CC Then Mn := 'INT3'
   Else If B0 = $CD Then Begin
    Mn := 'INT'; Op := '$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $CE Then Mn := 'INTO'
   Else If B0 = $CF Then Mn := 'IRET'
   Else If (B0 >= $D0) And (B0 <= $D3) Then Begin
    W := (B0 And 1) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := SHIFTN[SubOp];
    If (B0 And 2) = 0 Then Op := Op + ',1' Else Op := Op + ',CL';
   End Else If B0 = $D4 Then Begin
    Mn := 'AAM'; Op := '$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $D5 Then Begin
    Mn := 'AAD'; Op := '$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
   End Else If B0 = $D6 Then Mn := 'SALC'
   Else If B0 = $D7 Then Mn := 'XLAT'
   Else If (B0 >= $D8) And (B0 <= $DF) Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); Op := Copy(Op, 1, P - 1);
    Mn := 'ESC'; Op := HexByte(B0) + ',' + Op;
   End Else If B0 = $E0 Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := 'LOOPNZ'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If B0 = $E1 Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := 'LOOPZ'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If B0 = $E2 Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := 'LOOP'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If B0 = $E3 Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := 'JCXZ'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If (B0 = $E4) Or (B0 = $E5) Then Begin
    Mn := 'IN';
    If B0 = $E4 Then Op := 'AL,$' Else Op := 'AX,$';
    Op := Op + HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
   End Else If (B0 = $E6) Or (B0 = $E7) Then Begin
    Mn := 'OUT'; Op := '$' +
     HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    If B0 = $E6 Then Op := Op + ',AL' Else Op := Op + ',AX';
   End Else If B0 = $E8 Then Begin
    D16 := SmallInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
     (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8));
    Inc(Size, 2);
    Mn := 'CALL'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D16) And $FFFF));
   End Else If B0 = $E9 Then Begin
    D16 := SmallInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
     (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8));
    Inc(Size, 2);
    Mn := 'JMP'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D16) And $FFFF));
   End Else If B0 = $EA Then Begin
    Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
           (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
    Inc(Size, 2);
    Op := '$' + HexWord(
     Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
     (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8)) +
     ':$' + HexWord(Disp);
    Inc(Size, 2);
    Mn := 'JMP FAR';
   End Else If B0 = $EB Then Begin
    D8 := ShortInt(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)));
    Inc(Size);
    Mn := 'JMP'; Op := '$' + HexWord(Word((LongInt(Ofs) + Size + D8) And $FFFF));
   End Else If B0 = $EC Then Begin Mn := 'IN'; Op := 'AL,DX'; End
   Else If B0 = $ED Then Begin Mn := 'IN'; Op := 'AX,DX'; End
   Else If B0 = $EE Then Begin Mn := 'OUT'; Op := 'DX,AL'; End
   Else If B0 = $EF Then Begin Mn := 'OUT'; Op := 'DX,AX'; End
   Else If B0 = $F4 Then Mn := 'HLT'
   Else If B0 = $F5 Then Mn := 'CMC'
   Else If (B0 = $F6) Or (B0 = $F7) Then Begin
    W := (B0 And 1) <> 0;
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, W, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Mn := GRP1[SubOp];
    If SubOp In [0, 1] Then Begin
     If W Then Begin
      Disp := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size)) Or
             (Word(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size + 1))) Shl 8);
      Op := Op + ',$' + HexWord(Disp); Inc(Size, 2);
     End Else Begin
      Op := Op + ',$' +
       HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + Size))); Inc(Size);
     End;
    End;
   End Else If B0 = $F8 Then Mn := 'CLC'
   Else If B0 = $F9 Then Mn := 'STC'
   Else If B0 = $FA Then Mn := 'CLI'
   Else If B0 = $FB Then Mn := 'STI'
   Else If B0 = $FC Then Mn := 'CLD'
   Else If B0 = $FD Then Mn := 'STD'
   Else If B0 = $FE Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, False, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Case SubOp Of
     0: Mn := 'INC';
     1: Mn := 'DEC';
     Else Mn := 'DB';
    End;
   End Else If B0 = $FF Then Begin
    Op := EmuDbg_DecodeModRM16(Seg, Ofs, True, Size);
    P := Pos('|', Op); SubOp := Byte(Op[P+1]) - 48; Op := Copy(Op, 1, P - 1);
    Case SubOp Of
     0: Mn := 'INC';
     1: Mn := 'DEC';
     2: Mn := 'CALL';
     3: Mn := 'CALL FAR';
     4: Mn := 'JMP';
     5: Mn := 'JMP FAR';
     6: Mn := 'PUSH';
     Else Mn := 'DB';
    End;
   End Else Begin
    Mn := 'DB'; Op := '$' + HexByte(B0);
   End;
 { --- Construire la chaine de sortie : ADDR  bytes  PREFIX MN OP --- }
 BytesS := '';
 For I := 0 To Size - 1 Do Begin
  If I = 4 Then Begin BytesS := BytesS + '..'; Break; End;
  BytesS := BytesS + HexByte(Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + I)));
 End;
 While Length(BytesS) < 10 Do BytesS := BytesS + ' ';
 EmuDbg_Disasm8086 := HexWord(Seg) + ':' + HexWord(Ofs) + ' ' + BytesS +
  ' ' + Prefix + Mn + ' ' + Op;
End;

{$POP}

{ --- Tester si l instruction 8086 a CS:IP est un appel (CALL) --- }

Function EmuDbg_IsCall8086(Seg, Ofs: Word): Boolean;
Var
 B0, B1: Byte;
 R: Boolean;
Begin
 B0 := Emu_ReadByte(EmuPanel.CPU, Seg, Ofs);
 R := (B0 = $E8) Or (B0 = $9A);
 If (Not R) And (B0 = $FF) Then Begin
  B1 := Emu_ReadByte(EmuPanel.CPU, Seg, Word(Ofs + 1));
  { Sous-opcode 010/011 = CALL r/m / CALL m16:16 }
  R := ((B1 Shr 3) And 7) In [2, 3];
 End;
 EmuDbg_IsCall8086 := R;
End;

{ --- Decision de pause avant l instruction suivante --- }

Function EmuDbg_ShouldBreak(ACPU: TEmuDbgCPU; Addr: LongInt): Boolean;
Begin
 EmuDbg_ShouldBreak := False;
 If EmuDbg.BreakReq Then Begin
  EmuDbg_ShouldBreak := True;
  Exit;
 End;
 If EmuDbg_HasBP(Addr, ACPU) Then Begin
  EmuDbg_ShouldBreak := True;
  Exit;
 End;
 Case EmuDbg.StepMode Of
  ESM_INTO: EmuDbg_ShouldBreak := True;
  ESM_OVER:
   { Pause uniquement quand on est revenu au niveau de SP de reference
     ou au-dessus (apres un eventuel RTS/RET du sous-appel) }
   Begin
    If ACPU = EDC_6502 Then Begin
     If LongInt(CPU6502_S) >= EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End
    Else If ACPU = EDC_8086 Then Begin
     If LongInt(EmuPanel.CPU.Regs.SP) >= EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End
    Else If ACPU = EDC_6809 Then Begin
     If LongInt(M6809_S) >= EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End;
   End;
  ESM_OUT:
   Begin
    If ACPU = EDC_6502 Then Begin
     If LongInt(CPU6502_S) > EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End
    Else If ACPU = EDC_8086 Then Begin
     If LongInt(EmuPanel.CPU.Regs.SP) > EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End
    Else If ACPU = EDC_6809 Then Begin
     If LongInt(M6809_S) > EmuDbg.StepSPRef Then
      EmuDbg_ShouldBreak := True;
    End;
   End;
 End;
End;

{ --- Dessiner la fenetre de deboguage --- }

Procedure EmuDbg_DrawWindow;
Var
 X, Y, W, H, LineY: Integer;
 I, J, Sz: Integer;
 PC, Addr: Word;
 Lines: Integer;
 S, Hex, Ascii: String;
 DumpRows, DumpH, DumpY: Integer;
 DumpSeg, DumpStart: Word;
 B: Byte;
Begin
 If Not EmuDbg.WinVisible Then Exit;
 X := EmuDbg.WinX;
 Y := EmuDbg.WinY;
 W := EmuDbg.WinW;
 H := EmuDbg.WinH;
 { Fond }
 SetColor(0);
 Bar(X, Y, X + W - 1, Y + H - 1);
 { Bordure }
 SetColor(15);
 Rectangle(X, Y, X + W - 1, Y + H - 1);
 { Barre de titre }
 SetColor(1);
 Bar(X + 1, Y + 1, X + W - 2, Y + 14);
 SetColor(15);
 Case EmuDbg.CPU Of
  EDC_6502: OutTextXY(X + 4, Y + 3, 'Debogueur 6502 - PAUSE');
  EDC_8086: OutTextXY(X + 4, Y + 3, 'Debogueur 8086 - PAUSE');
  EDC_6809: OutTextXY(X + 4, Y + 3, 'Debogueur 6809 - PAUSE');
  Else      OutTextXY(X + 4, Y + 3, 'Debogueur emulateur');
 End;
 OutTextXY(X + W - 56, Y + 3, '[X]');
 { Etat des registres }
 LineY := Y + 18;
 SetColor(14);
 If EmuDbg.CPU = EDC_6502 Then Begin
  S := 'PC=' + HexWord(CPU6502_PC) +
       '  A=' + HexByte(CPU6502_A) +
       '  X=' + HexByte(CPU6502_X) +
       '  Y=' + HexByte(CPU6502_Y);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'SP=' + HexByte(CPU6502_S) +
       '  P=' + HexByte(CPU6502_P) +
       '  [N V - B D I Z C]';
  OutTextXY(X + 6, LineY, S); Inc(LineY, 14);
 End Else If EmuDbg.CPU = EDC_8086 Then Begin
  S := 'AX=' + HexWord(EmuPanel.CPU.Regs.AX) +
       '  BX=' + HexWord(EmuPanel.CPU.Regs.BX) +
       '  CX=' + HexWord(EmuPanel.CPU.Regs.CX) +
       '  DX=' + HexWord(EmuPanel.CPU.Regs.DX);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'SI=' + HexWord(EmuPanel.CPU.Regs.SI) +
       '  DI=' + HexWord(EmuPanel.CPU.Regs.DI) +
       '  BP=' + HexWord(EmuPanel.CPU.Regs.BP) +
       '  SP=' + HexWord(EmuPanel.CPU.Regs.SP);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'CS=' + HexWord(EmuPanel.CPU.Segs.CS) +
       '  DS=' + HexWord(EmuPanel.CPU.Segs.DS) +
       '  ES=' + HexWord(EmuPanel.CPU.Segs.ES) +
       '  SS=' + HexWord(EmuPanel.CPU.Segs.SS);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'IP=' + HexWord(EmuPanel.CPU.IP) +
       '  FL=' + HexWord(EmuPanel.CPU.Flags.Base);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 14);
 End Else If EmuDbg.CPU = EDC_6809 Then Begin
  S := 'PC=' + HexWord(M6809_PC) +
       '  A='  + HexByte(M6809_A) +
       '  B='  + HexByte(M6809_B) +
       '  DP=' + HexByte(M6809_DP);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'X=' + HexWord(M6809_X) +
       '  Y=' + HexWord(M6809_Y) +
       '  U=' + HexWord(M6809_U) +
       '  S=' + HexWord(M6809_S);
  OutTextXY(X + 6, LineY, S); Inc(LineY, 12);
  S := 'CC=' + HexByte(M6809_CC) +
       '  [E F H I N Z V C]';
  OutTextXY(X + 6, LineY, S); Inc(LineY, 14);
 End;
 { Separateur }
 SetColor(8);
 Line(X + 4, LineY, X + W - 4, LineY);
 Inc(LineY, 4);
 { Desassemblage (jusqu a 16 lignes a partir du PC + DisasmTopOfs) }
 SetColor(7);
 { Reserver de l espace en bas pour un dump hexa DS/SS (8086 uniquement) }
 If EmuDbg.CPU = EDC_8086 Then Begin
  DumpRows := 6;       { 3 lignes DS + 3 lignes SS }
  DumpH := DumpRows * 10 + 6;
 End Else Begin
  DumpRows := 0;
  DumpH := 0;
 End;
 Lines := (Y + H - LineY - 24 - DumpH) Div 10;
 If Lines > 16 Then Lines := 16;
 If Lines < 1 Then Lines := 1;
 EmuDbg.DisasmLines := Lines;
 { Ajuster SelOfs / DisasmTopOfs pour rester coherents }
 If EmuDbg.SelOfs < 0 Then EmuDbg.SelOfs := 0;
 If EmuDbg.DisasmTopOfs < 0 Then EmuDbg.DisasmTopOfs := 0;
 If EmuDbg.SelOfs < EmuDbg.DisasmTopOfs Then
  EmuDbg.DisasmTopOfs := EmuDbg.SelOfs;
 If EmuDbg.SelOfs >= EmuDbg.DisasmTopOfs + Lines Then
  EmuDbg.DisasmTopOfs := EmuDbg.SelOfs - Lines + 1;
 If EmuDbg.CPU = EDC_6502 Then Begin
  Addr := CPU6502_PC;
  { Avancer jusqu a la 1ere ligne visible (DisasmTopOfs instructions) }
  For I := 0 To EmuDbg.DisasmTopOfs - 1 Do Begin
   EmuDbg_Disasm6502(Addr, Sz);
   Addr := Word(Addr + Sz);
  End;
  For I := 0 To Lines - 1 Do Begin
   If I < 64 Then EmuDbg.DisasmAddrs[I] := Addr;
   If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then Begin
    { Surligner la ligne selectionnee }
    SetColor(1);
    Bar(X + 2, LineY - 1, X + W - 3, LineY + 8);
   End;
   If EmuDbg.DisasmTopOfs + I = 0 Then SetColor(11)            { PC }
   Else If EmuDbg_HasBP(Addr, EDC_6502) Then SetColor(12)      { BP }
   Else If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then SetColor(15)
   Else SetColor(7);
   S := EmuDbg_Disasm6502(Addr, Sz);
   If EmuDbg_HasBP(Addr, EDC_6502) Then S := '*' + S Else S := ' ' + S;
   OutTextXY(X + 4, LineY, S);
   Addr := Word(Addr + Sz);
   Inc(LineY, 10);
   If LineY > Y + H - 24 Then Break;
  End;
 End Else If EmuDbg.CPU = EDC_8086 Then Begin
  Addr := EmuPanel.CPU.IP;
  For I := 0 To EmuDbg.DisasmTopOfs - 1 Do Begin
   EmuDbg_Disasm8086(EmuPanel.CPU.Segs.CS, Addr, Sz);
   Addr := Word(Addr + Sz);
  End;
  For I := 0 To Lines - 1 Do Begin
   If I < 64 Then EmuDbg.DisasmAddrs[I] :=
    (LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + Addr;
   If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then Begin
    SetColor(1);
    Bar(X + 2, LineY - 1, X + W - 3, LineY + 8);
   End;
   If EmuDbg.DisasmTopOfs + I = 0 Then SetColor(11)
   Else If EmuDbg_HasBP((LongInt(EmuPanel.CPU.Segs.CS) Shl 4) +
                        Addr, EDC_8086) Then SetColor(12)
   Else If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then SetColor(15)
   Else SetColor(7);
   S := EmuDbg_Disasm8086(EmuPanel.CPU.Segs.CS, Addr, Sz);
   OutTextXY(X + 4, LineY, S);
   Addr := Word(Addr + Sz);
   Inc(LineY, 10);
   If LineY > Y + H - 24 - DumpH Then Break;
  End;
 End Else If EmuDbg.CPU = EDC_6809 Then Begin
  Addr := M6809_PC;
  For I := 0 To EmuDbg.DisasmTopOfs - 1 Do Begin
   EmuDbg_Disasm6809(Addr, Sz);
   Addr := Word(Addr + Sz);
  End;
  For I := 0 To Lines - 1 Do Begin
   If I < 64 Then EmuDbg.DisasmAddrs[I] := Addr;
   If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then Begin
    SetColor(1);
    Bar(X + 2, LineY - 1, X + W - 3, LineY + 8);
   End;
   If EmuDbg.DisasmTopOfs + I = 0 Then SetColor(11)
   Else If EmuDbg_HasBP(Addr, EDC_6809) Then SetColor(12)
   Else If EmuDbg.DisasmTopOfs + I = EmuDbg.SelOfs Then SetColor(15)
   Else SetColor(7);
   S := EmuDbg_Disasm6809(Addr, Sz);
   If EmuDbg_HasBP(Addr, EDC_6809) Then S := '*' + S Else S := ' ' + S;
   OutTextXY(X + 4, LineY, S);
   Addr := Word(Addr + Sz);
   Inc(LineY, 10);
   If LineY > Y + H - 24 Then Break;
  End;
 End;
 { Dump hexa DS/SS (8086 uniquement) - style debogueur DOS classique }
 If (EmuDbg.CPU = EDC_8086) And (DumpRows > 0) Then Begin
  DumpY := Y + H - 24 - DumpH + 2;
  SetColor(8);
  Line(X + 4, DumpY - 2, X + W - 4, DumpY - 2);
  For I := 0 To DumpRows - 1 Do Begin
   If I < (DumpRows Div 2) Then Begin
    DumpSeg := EmuPanel.CPU.Segs.DS;
    DumpStart := Word(EmuDbg.DataOfs + I * 8);
    SetColor(7);
    S := 'ds:' + HexWord(DumpStart);
   End Else Begin
    DumpSeg := EmuPanel.CPU.Segs.SS;
    DumpStart := Word(EmuPanel.CPU.Regs.SP +
                      (I - (DumpRows Div 2)) * 8);
    SetColor(10);
    S := 'ss:' + HexWord(DumpStart);
   End;
   Hex := '';
   Ascii := '';
   For J := 0 To 7 Do Begin
    B := Emu_ReadByte(EmuPanel.CPU, DumpSeg,
                      Word(DumpStart + J));
    Hex := Hex + HexByte(B) + ' ';
    If (B >= 32) And (B < 127) Then
     Ascii := Ascii + Chr(B)
    Else
     Ascii := Ascii + '.';
   End;
   OutTextXY(X + 4, DumpY + I * 10, S + ' ' + Hex + ' ' + Ascii);
  End;
 End;
 { Aide raccourcis en bas }
 SetColor(11);
 OutTextXY(X + 4, Y + H - 18,
  'F5=Cont F9=BP F10=Over F11=Into +/-=Scroll Sh+F5=Stop');
 { Poignee de redimensionnement (coin bas-droite) }
 SetColor(8);
 Line(X + W - 10, Y + H - 2, X + W - 2, Y + H - 10);
 Line(X + W -  7, Y + H - 2, X + W - 2, Y + H -  7);
 Line(X + W -  4, Y + H - 2, X + W - 2, Y + H -  4);
 EmuDbg.NeedRepaint := False;
End;

{ --- Tester si une coordonnee est sur la barre de titre (hors X) --- }

Function EmuDbg_HitTitleBar(MX, MY: Integer): Boolean;
Begin
 EmuDbg_HitTitleBar := EmuDbg.WinVisible And
  (MX >= EmuDbg.WinX + 1) And
  (MX < EmuDbg.WinX + EmuDbg.WinW - 60) And
  (MY >= EmuDbg.WinY + 1) And (MY < EmuDbg.WinY + 14);
End;

{ --- Tester si une coordonnee est sur la poignee de resize BD --- }

Function EmuDbg_HitResize(MX, MY: Integer): Boolean;
Begin
 EmuDbg_HitResize := EmuDbg.WinVisible And
  (MX >= EmuDbg.WinX + EmuDbg.WinW - 12) And
  (MX < EmuDbg.WinX + EmuDbg.WinW) And
  (MY >= EmuDbg.WinY + EmuDbg.WinH - 12) And
  (MY < EmuDbg.WinY + EmuDbg.WinH);
End;

{ --- Tester si une coordonnee est dans la fenetre debug --- }

Function EmuDbg_HitWindow(MX, MY: Integer): Boolean;
Begin
 EmuDbg_HitWindow := EmuDbg.WinVisible And
  (MX >= EmuDbg.WinX) And (MX < EmuDbg.WinX + EmuDbg.WinW) And
  (MY >= EmuDbg.WinY) And (MY < EmuDbg.WinY + EmuDbg.WinH);
End;

{ --- Tester clic sur le bouton de fermeture [X] de la fenetre debug --- }

Function EmuDbg_HitCloseBox(MX, MY: Integer): Boolean;
Begin
 EmuDbg_HitCloseBox := EmuDbg.WinVisible And
  (MX >= EmuDbg.WinX + EmuDbg.WinW - 58) And
  (MX < EmuDbg.WinX + EmuDbg.WinW - 4) And
  (MY >= EmuDbg.WinY + 1) And (MY < EmuDbg.WinY + 14);
End;

{ --- Commandes utilisateur (Continuer / Stop / Step) --- }

Procedure EmuDbg_Continue;
Begin
 EmuDbg.StepMode := ESM_NONE;
 EmuDbg.Paused := False;
 EmuDbg.ContinueReq := True;
 EmuDbg.BreakReq := False;
 EmuDbg.Dragging := False;
 EmuDbg.Resizing := False;
 EmuDbg.WinVisible := False;
End;

Procedure EmuDbg_Stop;
Begin
 EmuDbg.StopReq := True;
 EmuDbg.Paused := False;
 EmuDbg.StepMode := ESM_NONE;
 EmuDbg.BreakReq := False;
 EmuDbg.Dragging := False;
 EmuDbg.Resizing := False;
 EmuDbg.WinVisible := False;
End;

Procedure EmuDbg_StepInto;
Begin
 EmuDbg.StepMode := ESM_INTO;
 EmuDbg.Paused := False;
 EmuDbg.ContinueReq := True;
 EmuDbg.BreakReq := False;
End;

Procedure EmuDbg_StepOver;
Var
 Op0: Byte;
Begin
 { Si l instruction courante est un CALL/JSR, attendre le retour
   au meme niveau de pile ; sinon equivalent step-into. }
 If EmuDbg.CPU = EDC_6502 Then Begin
  Op0 := EmuDbg_Mem6502(CPU6502_PC);
  If EmuDbg_IsCall6502(Op0) Then Begin
   EmuDbg.StepMode := ESM_OVER;
   EmuDbg.StepSPRef := CPU6502_S;
  End Else
   EmuDbg.StepMode := ESM_INTO;
 End Else If EmuDbg.CPU = EDC_8086 Then Begin
  If EmuDbg_IsCall8086(EmuPanel.CPU.Segs.CS, EmuPanel.CPU.IP) Then Begin
   EmuDbg.StepMode := ESM_OVER;
   EmuDbg.StepSPRef := EmuPanel.CPU.Regs.SP;
  End Else
   EmuDbg.StepMode := ESM_INTO;
 End Else If EmuDbg.CPU = EDC_6809 Then Begin
  If EmuDbg_IsCall6809(M6809_PC) Then Begin
   EmuDbg.StepMode := ESM_OVER;
   EmuDbg.StepSPRef := M6809_S;
  End Else
   EmuDbg.StepMode := ESM_INTO;
 End Else
  EmuDbg.StepMode := ESM_INTO;
 EmuDbg.Paused := False;
 EmuDbg.ContinueReq := True;
 EmuDbg.BreakReq := False;
End;

Procedure EmuDbg_StepOut;
Begin
 EmuDbg.StepMode := ESM_OUT;
 If EmuDbg.CPU = EDC_6502 Then
  EmuDbg.StepSPRef := CPU6502_S
 Else If EmuDbg.CPU = EDC_8086 Then
  EmuDbg.StepSPRef := EmuPanel.CPU.Regs.SP
 Else If EmuDbg.CPU = EDC_6809 Then
  EmuDbg.StepSPRef := M6809_S;
 EmuDbg.Paused := False;
 EmuDbg.ContinueReq := True;
 EmuDbg.BreakReq := False;
End;

Procedure EmuDbg_ToggleBPAtPC;
Var
 VisIdx: LongInt;
 Addr: LongInt;
Begin
 { Si SelOfs == 0, on cible le PC courant (comportement classique).
   Sinon, on cible la ligne actuellement selectionnee dans le listing. }
 VisIdx := EmuDbg.SelOfs - EmuDbg.DisasmTopOfs;
 If (VisIdx < 0) Or (VisIdx > 63) Then Begin
  { Fallback : PC courant }
  If EmuDbg.CPU = EDC_6502 Then
   EmuDbg_ToggleBP(CPU6502_PC, EDC_6502)
  Else If EmuDbg.CPU = EDC_8086 Then
   EmuDbg_ToggleBP((LongInt(EmuPanel.CPU.Segs.CS) Shl 4) +
    EmuPanel.CPU.IP, EDC_8086)
  Else If EmuDbg.CPU = EDC_6809 Then
   EmuDbg_ToggleBP(M6809_PC, EDC_6809);
 End Else Begin
  Addr := EmuDbg.DisasmAddrs[VisIdx];
  If EmuDbg.CPU = EDC_6502 Then
   EmuDbg_ToggleBP(Addr, EDC_6502)
  Else If EmuDbg.CPU = EDC_8086 Then
   EmuDbg_ToggleBP(Addr, EDC_8086)
  Else If EmuDbg.CPU = EDC_6809 Then
   EmuDbg_ToggleBP(Addr, EDC_6809);
 End;
 EmuDbg.NeedRepaint := True;
End;

{ --- Gerer une touche pendant la pause. Retourne True si consomme. --- }

Function EmuDbg_HandleKey(Var Ev: TEvent): Boolean;
Var
 L: Integer;
Begin
 EmuDbg_HandleKey := False;
 If Not EmuDbg.Paused Then Exit;
 { Si un menu deroulant est ouvert, le laisser traiter les touches
   (Esc/fleches/Entree pour la navigation menu) et ne rien absorber. }
 If MenuActive Then Exit;
 L := EmuDbg.DisasmLines;
 If L < 1 Then L := 1;
 If Ev.Kind = EV_KEY_DOWN Then Begin
  Case Ev.KeyCode Of
   $3F: Begin EmuDbg_Continue;  EmuDbg_HandleKey := True; End; { F5 }
   $43: Begin EmuDbg_ToggleBPAtPC; EmuDbg_HandleKey := True; End; { F9 }
   $44: Begin EmuDbg_StepOver;  EmuDbg_HandleKey := True; End; { F10 }
   $85: Begin EmuDbg_StepInto;  EmuDbg_HandleKey := True; End; { F11 }
   $87: Begin EmuDbg_StepOut;   EmuDbg_HandleKey := True; End; { Shift+F11 }
   $58: Begin EmuDbg_Stop;      EmuDbg_HandleKey := True; End; { Shift+F5 }
   $62: Begin EmuDbg_Continue;  EmuDbg_HandleKey := True; End; { Ctrl+F5 }
   $48: Begin { Fleche haut : selection precedente }
    If EmuDbg.SelOfs > 0 Then Dec(EmuDbg.SelOfs);
    EmuDbg_HandleKey := True;
   End;
   $50: Begin { Fleche bas : selection suivante }
    Inc(EmuDbg.SelOfs);
    EmuDbg_HandleKey := True;
   End;
   $49: Begin { Page Up : reculer d une page }
    EmuDbg.SelOfs := EmuDbg.SelOfs - L;
    If EmuDbg.SelOfs < 0 Then EmuDbg.SelOfs := 0;
    EmuDbg_HandleKey := True;
   End;
   $51: Begin { Page Down : avancer d une page }
    EmuDbg.SelOfs := EmuDbg.SelOfs + L;
    EmuDbg_HandleKey := True;
   End;
   $47: Begin { Home : retour au PC }
    EmuDbg.SelOfs := 0;
    EmuDbg.DisasmTopOfs := 0;
    EmuDbg_HandleKey := True;
   End;
  End;
  { Defilement du dump DS via '+' / '-' (huit octets par cran) }
  If Ev.KeyChar = '+' Then Begin
   EmuDbg.DataOfs := Word(EmuDbg.DataOfs + 8);
   EmuDbg_HandleKey := True;
  End Else If Ev.KeyChar = '-' Then Begin
   EmuDbg.DataOfs := Word(EmuDbg.DataOfs - 8);
   EmuDbg_HandleKey := True;
  End;
 End;
 { Note : Echap (#27) n est PLUS traitee comme Continue car c est aussi
   la touche standard pour fermer les menus deroulants ou les dialogues.
   L utilisateur doit explicitement appuyer sur F5 pour reprendre. }
End;

{ --- Gerer un evenement souris dans la fenetre debug. Renvoie True
      si l evenement a ete absorbe par la fenetre debug --- }

Function EmuDbg_HandleMouse(Var Ev: TEvent): Boolean;
Var
 NewW, NewH: Integer;
Begin
 EmuDbg_HandleMouse := False;
 If Not EmuDbg.WinVisible Then Begin
  EmuDbg.Dragging := False;
  EmuDbg.Resizing := False;
  Exit;
 End;
 { Drag ou resize en cours : suivre la souris quelle que soit sa position }
 If EmuDbg.Dragging Then Begin
  If Ev.Kind = EV_MOUSE_MOVE Then Begin
   EmuDbg.WinX := Ev.MouseX - EmuDbg.DragOfsX;
   EmuDbg.WinY := Ev.MouseY - EmuDbg.DragOfsY;
   If EmuDbg.WinX < 0 Then EmuDbg.WinX := 0;
   If EmuDbg.WinY < 0 Then EmuDbg.WinY := 0;
   FullRepaintNeeded := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else If Ev.Kind = EV_MOUSE_UP Then Begin
   EmuDbg.Dragging := False;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
 End;
 If EmuDbg.Resizing Then Begin
  If Ev.Kind = EV_MOUSE_MOVE Then Begin
   NewW := Ev.MouseX - EmuDbg.WinX + 1;
   NewH := Ev.MouseY - EmuDbg.WinY + 1;
   If NewW < 200 Then NewW := 200;
   If NewH < 120 Then NewH := 120;
   EmuDbg.WinW := NewW;
   EmuDbg.WinH := NewH;
   FullRepaintNeeded := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else If Ev.Kind = EV_MOUSE_UP Then Begin
   EmuDbg.Resizing := False;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
 End;
 If Ev.Kind In [EV_MOUSE_DOWN, EV_MOUSE_UP, EV_MOUSE_DBLCLICK] Then Begin
  { Close box : juste cacher (l emulateur reste en pause) }
  If EmuDbg_HitCloseBox(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.WinVisible := False;
    FullRepaintNeeded := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Coin BD : commencer un resize }
  If EmuDbg_HitResize(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.Resizing := True;
    EmuDbg.WinFocused := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Barre de titre : commencer un drag }
  If EmuDbg_HitTitleBar(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.Dragging := True;
    EmuDbg.DragOfsX := Ev.MouseX - EmuDbg.WinX;
    EmuDbg.DragOfsY := Ev.MouseY - EmuDbg.WinY;
    EmuDbg.WinFocused := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Corps de la fenetre : absorber pour ne pas activer autre chose }
  If EmuDbg_HitWindow(Ev.MouseX, Ev.MouseY) Then Begin
   EmuDbg.WinFocused := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else Begin
   EmuDbg.WinFocused := False;
   { Laisser passer aux autres fenetres }
  End;
 End;
End;

{ --- Boucle de pump pendant la pause : preserve l interactivite de
      l IDE (menus, autres fenetres) tant que l utilisateur n a pas
      relance via F5/F10/F11/Shift+F11/Shift+F5. --- }

Procedure EmuDbg_PumpPause;
Var
 Ev: TEvent;
Begin
 EmuDbg.WinVisible := True;
 EmuDbg.WinFocused := True;
 EmuDbg.NeedRepaint := True;
 FullRepaintNeeded := True;
 DrawAllWidgets;
 EmuDbg_DrawWindow;
 While EmuDbg.Paused And (Not EmuDbg.ContinueReq) And
       (Not EmuDbg.StopReq) And (Not QuitRequested) Do Begin
  PollEvents(Ev);
  If Ev.Kind = EV_NONE Then Begin
   { Pas d evenement : on reste idle. Pas de Sleep car le pump host
     gere deja le pacing. }
   Continue;
  End;
  { Priorite : la fenetre debug consomme F5/F9/F10/F11/Shift+F5/F11 }
  If EmuDbg_HandleKey(Ev) Then Begin
   EmuDbg_DrawWindow;
   Continue;
  End;
  { Souris dans la fenetre debug : absorber }
  If EmuDbg_HandleMouse(Ev) Then Begin
   EmuDbg_DrawWindow;
   Continue;
  End;
  { Sinon laisser le dispatcher normal traiter l evenement (menus,
    autres fenetres, etc.) pour preserver l interactivite. }
  DispatchEvent(Ev);
  If FullRepaintNeeded Then Begin
   DrawAllWidgets;
   FullRepaintNeeded := False;
  End;
  { Ne pas redessiner la fenetre debug si un menu deroulant est ouvert :
    cela ecraserait le menu. Le menu reste en avant-plan tant qu il est
    ouvert ; il restaurera l arriere-plan a sa fermeture. }
  If Not MenuActive Then EmuDbg_DrawWindow;
 End;
 { Si l utilisateur a demande de quitter pendant la pause (Alt+X /
   Alt+F4), forcer l arret de l emulateur pour sortir proprement. }
 If QuitRequested Then Begin
  EmuDbg.StopReq := True;
  EmuDbg.Paused := False;
 End;
End;

{ --- Entrer en pause : appele par les hooks pre-step des emulateurs --- }

Procedure EmuDbg_EnterPause(ACPU: TEmuDbgCPU);
Begin
 EmuDbg.Active := True;
 EmuDbg.CPU := ACPU;
 EmuDbg.Paused := True;
 EmuDbg.BreakReq := False;
 EmuDbg.ContinueReq := False;
 EmuDbg.StepMode := ESM_NONE;
 { Reinitialiser le curseur du listing sur l instruction courante }
 EmuDbg.SelOfs := 0;
 EmuDbg.DisasmTopOfs := 0;
 If ACPU = EDC_6502 Then
  EmuDbg.LastAddr := CPU6502_PC
 Else If ACPU = EDC_8086 Then Begin
  EmuDbg.LastCS := EmuPanel.CPU.Segs.CS;
  EmuDbg.LastIP := EmuPanel.CPU.IP;
  EmuDbg.LastAddr := (LongInt(EmuDbg.LastCS) Shl 4) + EmuDbg.LastIP;
 End
 Else If ACPU = EDC_6809 Then
  EmuDbg.LastAddr := M6809_PC;
 EmuDbg_PumpPause;
 { Sortie de pause : redessiner toute l interface puis le panneau
   emulateur afin que la zone qui etait sous la fenetre debug soit
   restauree avant de relancer la boucle CPU. Les emulateurs avec
   framebuffer differentiel (NES, Atari 2600) doivent forcer un
   repaint complet, sinon DrawEmulatorPanel ne redessine que les
   pixels qui changent et la zone effacee reste vide. }
 NesFBFirst    := True;
 A2600_FBFirst := True;
 Coco3_FBFirst := True;
 FillChar(Coco3_FBPrev, SizeOf(Coco3_FBPrev), $FF);
 FullRepaintNeeded := True;
 DrawAllWidgets;
 If EmuPanel.Base.Visible Then DrawEmulatorPanel(EmuPanel);
End;

{ --- Hook a appeler AVANT chaque instruction CPU. Retourne True si
      l execution doit etre suspendue (gestion deja faite). --- }

Procedure EmuDbg_OnBeforeStep6502;
Begin
 If Not EmuDbg.Active Then Exit;
 If EmuDbg_ShouldBreak(EDC_6502, CPU6502_PC) Then
  EmuDbg_EnterPause(EDC_6502);
End;

Procedure EmuDbg_OnBeforeStep8086;
Var
 LinAddr: LongInt;
Begin
 If Not EmuDbg.Active Then Exit;
 LinAddr := (LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + EmuPanel.CPU.IP;
 If EmuDbg_ShouldBreak(EDC_8086, LinAddr) Then
  EmuDbg_EnterPause(EDC_8086);
End;

Procedure EmuDbg_OnBeforeStep6809;
Begin
 If Not EmuDbg.Active Then Exit;
 If EmuDbg_ShouldBreak(EDC_6809, M6809_PC) Then
  EmuDbg_EnterPause(EDC_6809);
End;

{ --- Verifier dans le pump d emulateur si Ctrl+C/Ctrl+Break a ete pressee --- }

Function EmuDbg_IsBreakKey(Var Ev: TEvent): Boolean;
Begin
 EmuDbg_IsBreakKey := False;
 If Ev.Kind = EV_KEY_CHAR Then Begin
  { #3 = Ctrl+C ; certains hotes envoient aussi #0 pour Ctrl+Break. }
  If Ev.KeyChar = #3 Then EmuDbg_IsBreakKey := True;
 End Else If Ev.Kind = EV_KEY_DOWN Then Begin
  { Ctrl+Break en mode etendu : scan code = $00 et KeyChar = #0.
    Certains terminaux mappent aussi $46 (ScrLk+Ctrl). }
  If (Ev.KeyCode = 0) Or (Ev.KeyCode = $46) Then
   EmuDbg_IsBreakKey := True;
 End;
End;

{ --- Drainer le buffer Crt (KeyPressed/ReadKey) pour detecter Ctrl+C
      ou Ctrl+Break depuis les boucles emulateur qui n utilisent pas
      le pump d evenements DEVENV. Retourne True si une demande de
      pause a ete enregistree. --- }

Function EmuDbg_PollCrtBreak: Boolean;
Var
 C: Char;
Begin
 EmuDbg_PollCrtBreak := False;
 If KeyPressed Then Begin
  C := ReadKey;
  If C = #3 Then Begin
   EmuDbg_PollCrtBreak := True;
  End Else If C = #0 Then Begin
   If KeyPressed Then Begin
    C := ReadKey;
    { Scan code 0 = Ctrl+Break sur PC BIOS }
    If C = #0 Then EmuDbg_PollCrtBreak := True;
   End Else
    EmuDbg_PollCrtBreak := True;
  End;
 End;
End;

{ --- Traiter un evenement global --- }

Procedure RunTranspilerOnFile(ExeName, OutExt: String);
Var
 NodeIdx : Integer;
 NodeCap : String;
 SolDir  : String;
 ProjDir : String;
 SrcPath : String;
 OutPath : String;
 ExePath : String;
 WIdx    : Integer;
 I       : Integer;
Begin
 NodeIdx := CtxMenu.NodeIdx;
 If (NodeIdx < 0) Or (NodeIdx >= SolExplorer.NodeCount) Then Exit;
 NodeCap := SolExplorer.Nodes[NodeIdx].RelPath;
 If NodeCap = '' Then Exit;
 { Construire le chemin source (meme logique que OpenExplorerFileNode) }
 If SolutionLoaded And (CurrentSolution.ProjectCount > 0) Then Begin
  SolDir := CurrentSolution.Info.SolutionPath;
  If Length(SolDir) > 0 Then Begin
   If (SolDir[Length(SolDir)] <> '\') And
      (SolDir[Length(SolDir)] <> '/') Then
    SolDir := SolDir + '\';
  End;
  { BOGUE REEL (2026-08-08) : voir la note d en-tete complete de           }
  { FindProjectIndexForExplorerNode - utilisait TOUJOURS Projects[0]. }
  ProjDir := ExtractFilePath(CurrentSolution.Projects[
   FindProjectIndexForExplorerNode(SolExplorer, NodeIdx)].ProjectPath);
  SrcPath := SolDir + ProjDir + NodeCap;
  For I := 1 To Length(SrcPath) Do
   If SrcPath[I] = '/' Then SrcPath[I] := '\';
 End Else
  SrcPath := NodeCap;
 { Chemin du fichier de sortie : meme dossier, extension remplacee }
 OutPath := ChangeFileExt(SrcPath, OutExt);
 { Chercher le transpilateur : meme dossier que DEVENV.EXE, WIN32\, puis CWD }
 ExePath := ExtractFilePath(ParamStr(0)) + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExtractFilePath(ParamStr(0)) + 'WIN32\' + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExeName;
 If Not FileExists(ExePath) Then Begin
  ShowMessageBox('Transpilateur',
   'Transpilateur introuvable :' + #13#10 + ExeName,
   MB_OK, MI_ERROR);
  AppendOutput(OutputPanel, 'Transpilateur introuvable : ' + ExeName, 2);
  Exit;
 End;
 { Lancer directement (le transpilateur cree son propre fichier de sortie) }
 AppendOutput(OutputPanel,
  'Transpilation : ' + ExeName + ' ' + SrcPath, 0);
 Exec(ExePath, '"' + SrcPath + '"');
 { Verifier le fichier produit }
 If Not FileExists(OutPath) Then Begin
  ShowMessageBox('Transpilateur',
   'Aucun fichier produit :' + #13#10 + OutPath,
   MB_OK, MI_ERROR);
  AppendOutput(OutputPanel, 'Aucun fichier produit : ' + OutPath, 2);
  Exit;
 End;
 If EditorReady Then SyncActiveWindowOut;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 WIdx := FindEditorByFileName(OutPath);
 If WIdx >= 0 Then
  ActivateWindow(WIdx)
 Else Begin
  CreateEditorWindow(OutPath);
  WIdx := WinMgr.ActiveIdx;
  LoadFile(Editors[WIdx]^.Buffer, OutPath);
  ActiveEditor := Editors[WIdx]^;
 End;
 EditorReady := True;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel, 'Transpilation terminee : ' + OutPath, 0);
End;

{ --- Appliquer le resultat du dialogue Ajouter une reference : ajoute  }
{ chaque reference cochee (non deja presente) au projet courant et au  }
{ noeud "References" de l explorateur, puis persiste sur disque.       }

Procedure ApplyAddReferenceDialogResult(Var Dlg: TAddReferenceDialog);
Var
 I, RefsIdx, Added: Integer;
Begin
 RefsIdx := -1;
 For I := 0 To SolExplorer.NodeCount - 1 Do
  If SolExplorer.Nodes[I].Kind = ENK_REFERENCES Then Begin
   RefsIdx := I;
   Break;
  End;
 Added := 0;
 For I := 0 To Dlg.ItemCount - 1 Do Begin
  If Dlg.Items[I].Checked Then Begin
   If FindReferenceInProject(CurrentProject, Dlg.Items[I].Name) < 0 Then Begin
    AddReferenceToProject(CurrentProject, Dlg.Items[I].Name);
    If RefsIdx >= 0 Then Begin
     AddExplorerNode(SolExplorer, Dlg.Items[I].Name, ENK_REFERENCE, RefsIdx);
     SolExplorer.Nodes[RefsIdx].HasChildren := True;
    End;
    Inc(Added);
   End;
  End;
 End;
 If Added > 0 Then Begin
  RefreshExplorer(SolExplorer);
  SolExplorer.NeedRepaint := True;
  If SolutionLoaded Then Begin
   SolutionModified := True;
   SaveCurrentSolution;
  End;
 End;
End;

Procedure DispatchEvent(Var Ev: TEvent);
Var
 CtxTag: LongInt;
 I: Integer;
 SubX, SubY: Integer;
Begin
 If Ev.Kind = EV_NONE Then Exit;
 { Menu contextuel en priorite si visible }
 If CtxMenu.Visible Then Begin
  CtxTag := HandleContextMenuEvent(CtxMenu, Ev);
  If Not CtxMenu.Visible Then Begin
   FullRepaintNeeded := True;
   { Traiter la commande selectionnee }
   If CtxTag > 0 Then Begin
    { Plage MRU : 5000-5099 = fichier recent, 5100-5199 = projet recent }
    If (CtxTag >= 5000) And
       (CtxTag < 5200) Then Begin
     I := CtxTag Mod 100;
     If (I >= 0) And (I < MRUPopupCount) Then Begin
      FileDlg.SelectedFile := MRUPopupPaths[I];
      HandleOpenFileConfirmed;
      FullRepaintNeeded := True;
     End;
     Exit;
    End;
    Case CtxTag Of
     900: Begin { Aide du terminal }
      TermCmd_HELP(TermPanels[ActiveShell]);
      TermPanels[ActiveShell].NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     901: Begin { Sauvegarder l historique du terminal }
      TermSaveHistory(TermPanels[ActiveShell]);
      TermPanels[ActiveShell].NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     902: Begin { Cycler le zoom du terminal }
      TermZoomCycle;
     End;
     311, 411: Begin { Ajouter un fichier }
      InitFileDialog(FileDlg, False);
      LoadDirectoryFiles(FileDlg);
      FileDlg.Base.Visible := True;
      DrawFileDialog(FileDlg);
     End;
     412: Begin { Ajouter une reference... }
      ShowAddReferenceDialog(AddRefDlg);
     End;
     320, 420, 520: Begin { Renommer }
      StartExplorerRename(SolExplorer, CtxMenu.NodeIdx);
      DrawExplorer(SolExplorer);
     End;
     500: Begin { Ouvrir }
      If (CtxMenu.NodeIdx >= 0) And
         (CtxMenu.NodeIdx < SolExplorer.NodeCount) Then Begin
       If SolExplorer.Nodes[CtxMenu.NodeIdx].Kind = ENK_FILE_FRM Then
        OpenExplorerFileNodeForm(SolExplorer, CtxMenu.NodeIdx)
       Else If SolExplorer.Nodes[CtxMenu.NodeIdx].Kind =
        ENK_PROPERTIES Then Begin
        InitProjectPropertiesDialog(ProjPropDlg);
        LoadProjectProperties(ProjPropDlg, CurrentProject);
        ShowProjectPropertiesDialog(ProjPropDlg);
       End Else
        OpenExplorerFileNode(SolExplorer, CtxMenu.NodeIdx);
      End;
     End;
     501: Begin { Edition hexadecimal }
      If (CtxMenu.NodeIdx >= 0) And
         (CtxMenu.NodeIdx < SolExplorer.NodeCount) Then
       OpenExplorerFileNodeHex(SolExplorer, CtxMenu.NodeIdx);
     End;
     502: Begin { Ouvrir dans l editeur texte (force le texte brut) }
      If (CtxMenu.NodeIdx >= 0) And
         (CtxMenu.NodeIdx < SolExplorer.NodeCount) Then
       OpenExplorerFileNode(SolExplorer, CtxMenu.NodeIdx);
     End;
     600: Begin { Transpilateur : afficher le sous-menu }
      I := CtxMenu.NodeIdx;
      SubX := CtxMenu.X;
      SubY := CtxMenu.Y;
      InitContextMenu(CtxMenu);
      CtxMenu.NodeIdx := I;
      CtxMenu.Width := 200;
      { Positionner a droite si l ecran le permet, sinon a gauche }
      If SubX + 160 + 200 <= GetScreenWidth Then
       CtxMenu.X := SubX + 160
      Else
       CtxMenu.X := SubX - 200;
      If CtxMenu.X < 0 Then CtxMenu.X := 0;
      { Clamper Y pour eviter de sortir en bas : 28 items * 16 + 4 = 452 px }
      If SubY + 452 > GetScreenHeight Then
       CtxMenu.Y := GetScreenHeight - 452
      Else
       CtxMenu.Y := SubY;
      If CtxMenu.Y < 30 Then CtxMenu.Y := 30;
      AddContextItem(CtxMenu, 'Vers ABAP/4',          700);
      AddContextItem(CtxMenu, 'Vers Ada',              701);
      AddContextItem(CtxMenu, 'Vers Algol 58',         702);
      AddContextItem(CtxMenu, 'Vers Algol 60',         703);
      AddContextItem(CtxMenu, 'Vers Algol 68',         704);
      AddContextItem(CtxMenu, 'Vers AWK',              705);
      AddContextItem(CtxMenu, 'Vers BCPL',             706);
      AddContextItem(CtxMenu, 'Vers C',                707);
      AddContextItem(CtxMenu, 'Vers Cobol',            708);
      AddContextItem(CtxMenu, 'Vers C#',               709);
      AddContextItem(CtxMenu, 'Vers Fortran 77',       710);
      AddContextItem(CtxMenu, 'Vers Java',             711);
      AddContextItem(CtxMenu, 'Vers Jovial',           712);
      AddContextItem(CtxMenu, 'Vers LISP',             713);
      AddContextItem(CtxMenu, 'Vers Lua',              714);
      AddContextItem(CtxMenu, 'Vers Modula-2',         715);
      AddContextItem(CtxMenu, 'Vers Modula-3',         716);
      AddContextItem(CtxMenu, 'Vers Oberon',           717);
      AddContextItem(CtxMenu, 'Vers Perl',             718);
      AddContextItem(CtxMenu, 'Vers PHP',              719);
      AddContextItem(CtxMenu, 'Vers PL/1',             720);
      AddContextItem(CtxMenu, 'Vers Python',           721);
      AddContextItem(CtxMenu, 'Vers QuickBasic',       722);
      AddContextItem(CtxMenu, 'Vers Raku',             723);
      AddContextItem(CtxMenu, 'Vers Rust',             724);
      AddContextItem(CtxMenu, 'Vers SAS',              725);
      AddContextItem(CtxMenu, 'Vers Visual Basic',     726);
      AddContextItem(CtxMenu, 'Vers Visual Basic .NET',727);
      CtxMenu.Visible := True;
      DrawContextMenu(CtxMenu);
      FullRepaintNeeded := True;
     End;
     { Transpilateurs : tags 700-727 }
     700: RunTranspilerOnFile('PAS2ABP.EXE',  '.abap');
     701: RunTranspilerOnFile('PAS2ADA.EXE',  '.adb');
     702: RunTranspilerOnFile('PAS2AL58.EXE', '.a58');
     703: RunTranspilerOnFile('PAS2AL60.EXE', '.a60');
     704: RunTranspilerOnFile('PAS2AL68.EXE', '.a68');
     705: RunTranspilerOnFile('PAS2AWK.EXE',  '.awk');
     706: RunTranspilerOnFile('PAS2BCPL.EXE', '.b');
     707: RunTranspilerOnFile('PAS2C.EXE',    '.c');
     708: RunTranspilerOnFile('PAS2CBL.EXE',  '.cbl');
     709: RunTranspilerOnFile('PAS2CS.EXE',   '.cs');
     710: RunTranspilerOnFile('PAS2F77.EXE',  '.f77');
     711: RunTranspilerOnFile('PAS2JAVA.EXE', '.java');
     712: RunTranspilerOnFile('PAS2JOV.EXE',  '.jov');
     713: RunTranspilerOnFile('PAS2LISP.EXE', '.lisp');
     714: RunTranspilerOnFile('PAS2LUA.EXE',  '.lua');
     715: RunTranspilerOnFile('PAS2MOD2.EXE', '.mod');
     716: RunTranspilerOnFile('PAS2MOD3.EXE', '.m3');
     717: RunTranspilerOnFile('PAS2OBER.EXE', '.obn');
     718: RunTranspilerOnFile('PAS2PERL.EXE', '.pl');
     719: RunTranspilerOnFile('PAS2PHP.EXE',  '.php');
     720: RunTranspilerOnFile('PAS2PLI.EXE',  '.pli');
     721: RunTranspilerOnFile('PAS2PY.EXE',   '.py');
     722: RunTranspilerOnFile('PAS2QB.EXE',   '.bas');
     723: RunTranspilerOnFile('PAS2RAKU.EXE', '.raku');
     724: RunTranspilerOnFile('PAS2RUST.EXE', '.rs');
     725: RunTranspilerOnFile('PAS2SAS.EXE',  '.sas');
     726: RunTranspilerOnFile('PAS2VB.EXE',   '.bas');
     727: RunTranspilerOnFile('PAS2VBN.EXE',  '.vb');
     399: Begin { Proprietes du projet }
      InitProjectPropertiesDialog(ProjPropDlg);
      LoadProjectProperties(ProjPropDlg, CurrentProject);
      ShowProjectPropertiesDialog(ProjPropDlg);
     End;
     521: Begin { Supprimer fichier/reference }
      If (CtxMenu.NodeIdx >= 0) And
         (CtxMenu.NodeIdx < SolExplorer.NodeCount) Then
      Begin
       If SolExplorer.Nodes[CtxMenu.NodeIdx].Kind In
        [ENK_FILE_CS, ENK_FILE_VB, ENK_FILE_PAS,
         ENK_FILE_FRM, ENK_FILE_OTHER] Then
       Begin
        { Retirer du projet }
        If SolutionLoaded Then Begin
         I := FindFileInProject(CurrentProject,
          SolExplorer.Nodes[CtxMenu.NodeIdx].RelPath);
         If I >= 0 Then
          RemoveFileFromProject(CurrentProject, I);
         SolutionModified := True;
         SaveCurrentSolution;
        End;
        { Retirer de l explorateur }
        RemoveExplorerNode(SolExplorer, CtxMenu.NodeIdx);
        RefreshExplorer(SolExplorer);
        SolExplorer.NeedRepaint := True;
       End
       Else If SolExplorer.Nodes[CtxMenu.NodeIdx].Kind
        = ENK_REFERENCE Then
       Begin
        If SolutionLoaded Then Begin
         I := FindReferenceInProject(CurrentProject,
          SolExplorer.Nodes[CtxMenu.NodeIdx].Caption);
         If I >= 0 Then
          RemoveReferenceFromProject(CurrentProject, I);
         SolutionModified := True;
         SaveCurrentSolution;
        End;
        RemoveExplorerNode(SolExplorer, CtxMenu.NodeIdx);
        RefreshExplorer(SolExplorer);
        SolExplorer.NeedRepaint := True;
       End;
      End;
     End;
    End;
   End;
  End;
  Exit;
 End;
 { Page de demarrage en priorite si visible }
 If StartPage.Visible Then Begin
  HandleStartPageEvent(StartPage, MRUList, Ev);
  Exit;
 End;
 { Raccourcis clavier globaux (touches speciales uniquement) - sauf       }
 { quand Norton Commander a le focus : il reutilise lui-meme F1..F10          }
 { (menu deroulant F9, Copier F5, etc., NC.PAS) et doit les recevoir en          }
 { priorite plutot que de les voir absorbes ici par les raccourcis du          }
 { debogueur (BOGUE REEL 2026-08-09 : F9 n atteignait jamais                     }
 { HandleNCommanderEvent a cause de ce court-circuit). }
 If (Ev.Kind = EV_KEY_DOWN) And
    Not (TermVisible And TerminalHasFocus And (ActiveShell = SK_NCOMMANDER))
    Then Begin
  Case Ev.KeyCode Of
   $6B: Begin { Alt+F4 : quitter }
    TryQuit;
    Exit;
   End;
   $2D: Begin { Alt+X : quitter }
    TryQuit;
    Exit;
   End;
   $3B: Begin { F1 : Documentation en ligne }
    OpenHelpFile('DEVENV.HLP', '');
    Exit;
   End;
   $3F: Begin { F5 : continuer (debogueur en pause) ou demarrer }
    If EmuDbg.Paused Then EmuDbg_Continue
    Else HandleStartDebugging;
    Exit;
   End;
   $40: Begin { F6 : generer la solution }
    HandleStartDebugging;
    Exit;
   End;
   $43: Begin { F9 : basculer point d arret machine si emulateur actif }
    If EmuDbg.Active Or EmuDbg.Paused Then Begin
     EmuDbg_ToggleBPAtPC;
     FullRepaintNeeded := True;
    End;
    Exit;
   End;
   $44: Begin { F10 : pas a pas principal (Step Over) }
    If EmuDbg.Paused Then EmuDbg_StepOver;
    Exit;
   End;
   $85: Begin { F11 : pas a pas detaille (Step Into) }
    If EmuDbg.Paused Then EmuDbg_StepInto;
    Exit;
   End;
   $87: Begin { Shift+F11 : pas a pas sortant (Step Out) }
    If EmuDbg.Paused Then EmuDbg_StepOut;
    Exit;
   End;
   $58: Begin { Shift+F5 : arreter le debogage }
    If EmuDbg.Active Or EmuDbg.Paused Then EmuDbg_Stop
    Else StopDebugging(BPMgr, OutputPanel);
    Exit;
   End;
   $62: Begin { Ctrl+F5 : demarrer sans debogage }
    If EmuDbg.Paused Then EmuDbg_Continue
    Else StartWithoutDebugging(BPMgr, OutputPanel);
    Exit;
   End;
  End;
 End;
 If (Ev.Kind = EV_KEY_CHAR) Then Begin
  { Raccourcis Ctrl+lettre via KeyChar }
  If Ev.KeyChar = #19 Then Begin { Ctrl+S : enregistrer }
   HandleSaveCurrentFile;
   Exit;
  End;
  If Ev.KeyChar = #14 Then Begin { Ctrl+N : nouveau fichier }
   ShowNewFileDialog(NewFileDlg);
   Exit;
  End;
  If Ev.KeyChar = #15 Then Begin { Ctrl+O : ouvrir fichier }
   InitFileDialog(FileDlg, False);
   LoadDirectoryFiles(FileDlg);
   FileDlg.Base.Visible := True;
   DrawFileDialog(FileDlg);
   Exit;
  End;
  If Ev.KeyChar = #6 Then Begin { Ctrl+F : rechercher }
   ShowFindDialog(FindReplaceDlg);
   Exit;
  End;
  If (Ev.KeyChar = #8) And ((Ev.ShiftState And 2) <> 0) Then Begin
   { Ctrl+H : remplacer (distinguer de Backspace via ShiftState) }
   ShowReplaceDialog(FindReplaceDlg);
   Exit;
  End;
  If Ev.KeyChar = #7 Then Begin { Ctrl+G : aller a la ligne }
   If EditorReady Then
    ShowGoToLineDialog(ActiveEditor);
   Exit;
  End;
 End;
 { Distribuer aux panneaux dans l ordre de priorite }
 If MenuActive Then Begin
  HandleMenuEvent(Ev);
  Exit;
 End;
 If FindReplaceDlg.Base.Visible Then Begin
  HandleFindDialogEvent(FindReplaceDlg,
   Ord(Ev.Kind), Ev.KeyChar, Ev.MouseX, Ev.MouseY);
  If Not FindReplaceDlg.Base.Visible Then Begin
   If (FindReplaceDlg.Base.Result = DR_OK) And EditorReady Then Begin
    If FindReplaceDlg.IsReplaceMode Then Begin
     I := ReplaceAll(ActiveEditor, FindReplaceDlg.SearchText,
      FindReplaceDlg.ReplaceText, FindReplaceDlg.Options);
     AppendOutput(OutputPanel,
      'Remplacement : ' + IntToStr(I) +
      ' occurrence(s) remplacee(s).', 0);
    End Else
     FindNext(ActiveEditor, FindReplaceDlg.SearchText,
      FindReplaceDlg.Options);
    EnsureCursorVisible(ActiveEditor);
   End;
   FullRepaintNeeded := True;
  End;
  Exit;
 End;
 If FileDlg.Base.Visible Then Begin
  HandleFileDialogEvent(FileDlg, Ev);
  If Not FileDlg.Base.Visible Then Begin
   If FileDlg.Base.Result = DR_OK Then Begin
    If FileDlg.FolderMode Then
     HandleOpenFolderConfirmed
    Else
     HandleOpenFileConfirmed;
   End;
   FileDlg.FolderMode := False;
   FullRepaintNeeded := True;
  End;
  DrawFileDialog(FileDlg);
  Exit;
 End;
 If NewFileDlg.Base.Visible Then Begin
  HandleNewFileDialogEvent(NewFileDlg, Ev);
  If Not NewFileDlg.Base.Visible Then Begin
   If NewFileDlg.Confirmed Then
    HandleNewFileConfirmed;
   FullRepaintNeeded := True;
  End;
  DrawNewFileDialog(NewFileDlg);
  Exit;
 End;
 If NewProjDlg.Base.Visible Then Begin
  HandleNewProjectDialogEvent(NewProjDlg, Ev);
  If Not NewProjDlg.Base.Visible Then Begin
   If NewProjDlg.Confirmed Then
    HandleNewSolutionConfirmed;
   FullRepaintNeeded := True;
  End;
  DrawNewProjectDialog(NewProjDlg);
  Exit;
 End;
 If ProjPropDlg.Base.Visible Then Begin
  HandleProjectPropertiesDialogEvent(ProjPropDlg, Ev);
  If Not ProjPropDlg.Base.Visible Then Begin
   If ProjPropDlg.Confirmed Then Begin
    SaveProjectProperties(ProjPropDlg, CurrentProject);
    SolutionModified := True;
   End;
   FullRepaintNeeded := True;
  End Else
   DrawProjectPropertiesDialog(ProjPropDlg);
  Exit;
 End;
 If AddRefDlg.Base.Visible Then Begin
  HandleAddReferenceDialogEvent(AddRefDlg, Ev);
  If Not AddRefDlg.Base.Visible Then Begin
   If AddRefDlg.Confirmed Then
    ApplyAddReferenceDialogResult(AddRefDlg);
   FullRepaintNeeded := True;
  End Else
   DrawAddReferenceDialog(AddRefDlg);
  Exit;
 End;
 { Sous-boite Ajouter/Modifier en premier : elle doit recevoir les
   evenements en priorite quand elle est ouverte par-dessus le
   gestionnaire de disques virtuels. }
 If VirtAddDiskDlg.Base.Visible Then Begin
  HandleVirtAddDiskDialogEvent(VirtAddDiskDlg, Ev);
  If Not VirtAddDiskDlg.Base.Visible Then Begin
   FullRepaintNeeded := True;
   DrawVirtualDiskDialog(VirtualDiskDlg);
  End;
  Exit;
 End;
 If VirtualDiskDlg.Base.Visible Then Begin
  HandleVirtualDiskDialogEvent(VirtualDiskDlg, Ev);
  If Not VirtualDiskDlg.Base.Visible Then
   FullRepaintNeeded := True;
  Exit;
 End;
 If EmuPanel.Base.Visible Then Begin
  { Quand l emulateur est visible, il ne doit pas absorber les clics
    sur la barre de menus, la toolbar, ni la fenetre du debogueur
    emulateur. On laisse aussi passer Alt+lettre (raccourcis menu)
    et les raccourcis globaux du debogueur.
    Stage 1 "multi-fenetre non bloquant" (2026-08-15) : pour un backend
    CONVERTI (EmuPanel.Loaded=True, execution asynchrone via l idle-tick
    de MainLoop - voir StepEmulator), EmuHasFocus determine en plus si la
    souris/le clavier va a l emulateur ou retombe sur le reste de l IDE
    (Explorateur, Terminal, menus...) - un clic DANS le rectangle du
    panneau (EmuPanel_HitTest) reprend le focus, un clic EN DEHORS le
    relache. Pour un backend NON converti (Loaded=False, encore bloquant
    comme avant), le comportement historique (tout capturer) reste la
    regle PAR DEFAUT.
    Correctif 2026-08-15 : cette regle par defaut supposait que cette
    branche n est de toute facon atteinte que pour l ecran final "Appuyez
    sur Echap pour fermer" (l execution elle-meme bloquant MainLoop
    entierement pour ces backends) - FAUX des que le debogueur emulateur
    (EmuDbg, Ctrl+C/point d arret) met l execution en pause : sa boucle
    `EmuDbg_PumpPause` appelle DispatchEvent EN PLEINE EXECUTION pour
    preserver l interactivite de l IDE (Explorateur, Terminal, menus),
    exactement comme le fait deja EmuHasFocus pour un backend converti -
    mais EmuDbg.Paused n etait jamais verifie ici, donc TOUT clic/touche
    hors barre de menus/toolbar/fenetre debogueur tombait quand meme dans
    HandleEmulatorPanelEvent puis Exit, rendant Explorateur et Terminal
    totalement inertes (souris ET clavier) tant que le debogueur restait
    en pause. EmuDbg.Paused est donc desormais traite comme "pas le focus
    emulateur", au meme titre que EmuHasFocus=False. }
  If Ev.Kind In [EV_MOUSE_DOWN, EV_MOUSE_UP, EV_MOUSE_MOVE,
                  EV_MOUSE_DBLCLICK] Then Begin
   If Ev.MouseY < MENUBAR_HEIGHT + TOOLBAR_HEIGHT Then Begin
    { Clic sur barre de menus ou toolbar : laisser passer aux
      gestionnaires standards plus bas. }
   End Else If EmuDbg.WinVisible And
              EmuDbg_HitWindow(Ev.MouseX, Ev.MouseY) Then Begin
    { Clic sur la fenetre du debogueur : la PumpPause s en charge }
   End Else If EmuPanel.Loaded And (Ev.Kind = EV_MOUSE_DOWN) And
              Not EmuPanel_HitTest(EmuPanel, Ev.MouseX, Ev.MouseY) Then Begin
    { Stage 1 : clic HORS du panneau -> relache le focus, l evenement
      retombe sur le reste de l IDE (voir plus bas dans DispatchEvent). }
    EmuHasFocus := False;
   End Else If EmuDbg.Paused Or (EmuPanel.Loaded And Not EmuHasFocus) Then Begin
    { Debogueur en pause, ou pas (plus) le focus emulateur : laisser passer. }
   End Else Begin
    If EmuPanel.Loaded And (Ev.Kind = EV_MOUSE_DOWN) Then EmuHasFocus := True;
    HandleEmulatorPanelEvent(EmuPanel, Ev);
    If Not EmuPanel.Base.Visible Then
     FullRepaintNeeded := True
    Else
     DrawEmulatorPanel(EmuPanel);
    Exit;
   End;
  End Else If Ev.Kind = EV_KEY_DOWN Then Begin
   { Alt+lettre : laisser HandleMenuEvent ouvrir le menu correspondant.
     Les scan codes Alt+lettre commencent par $11..$32 plage typique. }
   { Aussi les F-keys de debogage (F5/F9/F10/F11/Shift+F11/Shift+F5/Ctrl+F5)
     et la touche F1 (aide) doivent atteindre les handlers globaux. }
   Case Ev.KeyCode Of
    $3B, $3F, $40, $43, $44, $58, $62, $6B, $85, $87:
     ; { Laisser passer aux raccourcis globaux }
    $21, $12, $1E, $19, $22, $20, $18, $31, $17:
     { Si Alt est tenu, c est un Alt+lettre ; sinon clavier emulateur.
       Comme on ne sait pas l etat d Alt, on laisse passer en priorite
       pour permettre l ouverture des menus. }
     ;
    Else Begin
     If EmuDbg.Paused Or (EmuPanel.Loaded And Not EmuHasFocus) Then Begin
      { Debogueur en pause, ou pas le focus emulateur : laisser passer
        (ex. touches du Terminal). }
     End Else Begin
      HandleEmulatorPanelEvent(EmuPanel, Ev);
      If Not EmuPanel.Base.Visible Then
       FullRepaintNeeded := True
      Else
       DrawEmulatorPanel(EmuPanel);
      Exit;
     End;
    End;
   End;
  End Else Begin
   If EmuDbg.Paused Or (EmuPanel.Loaded And Not EmuHasFocus) Then Begin
    { Debogueur en pause, ou pas le focus emulateur : laisser passer. }
   End Else Begin
    HandleEmulatorPanelEvent(EmuPanel, Ev);
    If Not EmuPanel.Base.Visible Then
     FullRepaintNeeded := True
    Else
     DrawEmulatorPanel(EmuPanel);
    Exit;
   End;
  End;
 End;
 If GoToLineDlg.Base.Visible Then Begin
  HandleGoToLineEvent(GoToLineDlg,
   Ord(Ev.Kind), Ev.KeyChar, Ev.MouseX, Ev.MouseY);
  If Not GoToLineDlg.Base.Visible Then Begin
   If GoToLineDlg.Confirmed And EditorReady Then Begin
    ActiveEditor.CursorLine := GoToLineDlg.LineNumber - 1;
    ActiveEditor.CursorCol := 1;
    EnsureCursorVisible(ActiveEditor);
   End;
   FullRepaintNeeded := True;
  End;
  Exit;
 End;
 If OptionsDlg.Base.Visible Then Begin
  HandleOptionsEvent(OptionsDlg, Ev);
  If Not OptionsDlg.Base.Visible Then Begin
   If OptionsDlg.Confirmed Then Begin
    { Persister sur disque - sans cet appel, les changements ne          }
    { survivaient qu en memoire le temps de la session (et meme pas,     }
    { avant la correction de InitOptionsDialog qui les effacait des la   }
    { reouverture du dialogue). }
    SaveOptions(OptionsDlg.Data, OPT_CFG_FILENAME);
    If EditorReady Then Begin
     ActiveEditor.TabSize         := OptionsDlg.Data.TabSize;
     ActiveEditor.AutoIndent      := OptionsDlg.Data.AutoIndent;
     ActiveEditor.ShowLineNumbers := OptionsDlg.Data.ShowLineNumbers;
     ActiveEditor.ShowWhitespace  := OptionsDlg.Data.ShowWhitespace;
     AppendOutput(OutputPanel,
      'Options appliquees a l editeur courant.', 0);
    End;
   End;
   FullRepaintNeeded := True;
  End;
  Exit;
 End;
 If DbgPanel.Visible Then Begin
  HandleDebugPanelEvent(DbgPanel, BPMgr);
  Exit;
 End;
 { Evenements pour la barre de menus }
 HandleMenuEvent(Ev);
 { Si un menu vient d etre ouvert, ne pas redessiner la toolbar par dessus }
 If MenuActive Then Exit;
 { Evenements pour la barre d outils }
 HandleToolBarEvent(Ev);
 { Evenements pour les onglets d editeurs }
 HandleTabEvent(Ev);
 { BOGUE REEL (2026-08-08) : ExplorerHasFocus n etait mis a jour (True     }
 { dans l explorateur, False sinon) que par le bloc plus bas, APRES la          }
 { gestion du Terminal/panneau de sortie ci-dessous - qui fait TOUJOURS          }
 { Exit avant d y arriver des qu on clique sur le Terminal ou la Sortie.            }
 { Resultat : ExplorerHasFocus restait bloque a True des qu on avait                }
 { clique une fois dans l explorateur (ex. le champ de recherche live),            }
 { et TOUTE frappe clavier ulterieure - meme destinee au Terminal -                    }
 { etait alors detournee vers HandleExplorerEvent (voir plus bas, "Si               }
 { l explorateur a le focus") au lieu d atteindre le Terminal (symptome              }
 { signale par l utilisateur : "plus moyen d ecrire de commandes dans le            }
 { Terminal"). Deplace ICI, AVANT les Exit du bloc Terminal/Sortie, pour              }
 { que le focus de l explorateur soit correctement retire DES qu on                    }
 { clique ailleurs, quel que soit le panneau qui traite finalement le              }
 { clic. Nettoie aussi le renommage/la recherche live en cours des que le           }
 { focus quitte l explorateur, pour la meme raison (Renaming et                          }
 { SearchFocused ne pouvaient eux non plus se terminer que par un clic                }
 { DANS l explorateur - meme bogue latent, juste jamais remarque avant                }
 { l ajout de la recherche live, un champ que l on quitte typiquement                     }
 { sans appuyer sur Entree/Echap). }
 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  If (Ev.MouseX >= SolExplorer.X) And
     (Ev.MouseX < SolExplorer.X + SolExplorer.Width) And
     (Ev.MouseY >= SolExplorer.Y) And
     (Ev.MouseY < SolExplorer.Y + SolExplorer.Height) Then
   ExplorerHasFocus := True
  Else Begin
   If ExplorerHasFocus Then Begin
    If SolExplorer.Renaming Then ConfirmExplorerRename(SolExplorer);
    SolExplorer.SearchFocused := False;
   End;
   ExplorerHasFocus := False;
  End;
 End;
 { Evenements pour l editeur de texte actif }
 { Gestion du focus : clic souris determine qui recoit le clavier }
 If (Ev.Kind = EV_MOUSE_DOWN) Then Begin
  { Verifier d abord le panneau au-dessus selon le z-order }
  If TermVisible And TerminalOnTop And
     (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   { Le clic est dans la zone du terminal (au-dessus) }
   { Verifier si c est aussi dans l OutputPanel (zone de chevauchement) }
   If OutputPanel.Visible And
      (Ev.MouseX >= OutputPanel.X) And
      (Ev.MouseX < OutputPanel.X + OutputPanel.Width) And
      (Ev.MouseY >= OutputPanel.Y) And
      (Ev.MouseY < OutputPanel.Y + OutputPanel.Height) Then Begin
    { Zone de chevauchement : le terminal est au-dessus, le prend }
   End;
   TerminalHasFocus := True;
   HandleTerminalEvent(TermPanels[ActiveShell], Ev);
   Exit;
  End
  Else If TermVisible And (Not TerminalOnTop) And
     OutputPanel.Visible And
     (Ev.MouseX >= OutputPanel.X) And
     (Ev.MouseX < OutputPanel.X + OutputPanel.Width) And
     (Ev.MouseY >= OutputPanel.Y) And
     (Ev.MouseY < OutputPanel.Y + OutputPanel.Height) Then Begin
   { Output est au-dessus et on clique dessus : passer a HandleOutputEvent }
   TerminalHasFocus := False;
   If TermSelectOpen Then Begin
    TermSelectOpen := False;
    FullRepaintNeeded := True;
   End;
   HandleOutputEvent(OutputPanel, Ev);
   Exit;
  End
  Else If TermVisible And
     (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   { Terminal est en dessous mais on clique dessus (hors OutputPanel) }
   TerminalOnTop := True;
   TerminalHasFocus := True;
   FullRepaintNeeded := True;
   HandleTerminalEvent(TermPanels[ActiveShell], Ev);
   Exit;
  End
  Else If TermVisible And OutputPanel.Visible And
     (Ev.MouseX >= OutputPanel.X) And
     (Ev.MouseX < OutputPanel.X + OutputPanel.Width) And
     (Ev.MouseY >= OutputPanel.Y) And
     (Ev.MouseY < OutputPanel.Y + OutputPanel.Height) Then Begin
   { Output est en dessous mais on clique dessus (hors terminal) }
   TerminalOnTop := False;
   TerminalHasFocus := False;
   FullRepaintNeeded := True;
   If TermSelectOpen Then Begin
    TermSelectOpen := False;
   End;
   HandleOutputEvent(OutputPanel, Ev);
   Exit;
  End
  Else Begin
   TerminalHasFocus := False;
   If TermSelectOpen Then Begin
    TermSelectOpen := False;
    FullRepaintNeeded := True;
   End;
   { Clic hors du terminal (typiquement sur l editeur) : si le
     terminal etait agrandi par zoom, le ramener a la hauteur
     normale pour reveler l editeur. }
   If TermVisible And (TermZoomLvl > 0) Then TermZoomReset;
  End;
 End;
 { Si l explorateur a le focus, lui envoyer les touches de navigation. }
 If ExplorerHasFocus And
    ((Ev.Kind = EV_KEY_DOWN) Or (Ev.Kind = EV_KEY_CHAR)) Then Begin
  HandleExplorerEvent(SolExplorer, Ev);
  If SolExplorer.NeedRepaint Then
   DrawExplorer(SolExplorer);
  Exit;
 End;
 { Si le terminal a le focus, lui envoyer les evenements clavier }
 If TermVisible And TerminalHasFocus Then Begin
  If (Ev.Kind = EV_KEY_CHAR) Or (Ev.Kind = EV_KEY_DOWN) Then Begin
   HandleTerminalEvent(TermPanels[ActiveShell], Ev);
   Exit;
  End;
 End;
 If EditorReady And (WinMgr.ActiveIdx >= 0) Then Begin
  { Si renommage en cours dans l explorateur, lui envoyer les touches }
  If SolExplorer.Renaming And
     ((Ev.Kind = EV_KEY_CHAR) Or (Ev.Kind = EV_KEY_DOWN)) Then Begin
   HandleExplorerEvent(SolExplorer, Ev);
   Exit;
  End;
  If (Ev.Kind = EV_KEY_CHAR) Or (Ev.Kind = EV_KEY_DOWN) Then Begin
   If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX Then Begin
    HandleHexEditorKey(ActiveHexEditor, Ev);
    If HexEditors[WinMgr.ActiveIdx] <> Nil Then
     HexEditors[WinMgr.ActiveIdx]^ := ActiveHexEditor;
    If ActiveHexEditor.Modified Then
     MarkWindowModified(WinMgr.ActiveIdx);
    WinMgr.Windows[WinMgr.ActiveIdx].CursorY :=
     ActiveHexEditor.CursorOfs Div HEX_BYTES_PER_ROW;
    WinMgr.Windows[WinMgr.ActiveIdx].CursorX :=
     ActiveHexEditor.CursorOfs Mod HEX_BYTES_PER_ROW;
   End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_FORM Then Begin
    { Apercu de formulaire : lecture seule, aucune frappe traitee }
   End Else Begin
    HandleSelectionKey(ActiveEditor, EditorSel, EditorClip,
     EditorUndo, EditorRedo, Ev);
    { Sauvegarder l etat de l editeur dans le tableau }
    If Editors[WinMgr.ActiveIdx] <> Nil Then
     Editors[WinMgr.ActiveIdx]^ := ActiveEditor;
    { Synchroniser curseur vers TEditorWindow pour la barre d etat }
    WinMgr.Windows[WinMgr.ActiveIdx].CursorY := ActiveEditor.CursorLine;
    WinMgr.Windows[WinMgr.ActiveIdx].CursorX := ActiveEditor.CursorCol - 1;
   End;
   Exit;
  End;
  If (Ev.Kind = EV_MOUSE_DOWN) Or (Ev.Kind = EV_MOUSE_MOVE) Or
     (Ev.Kind = EV_MOUSE_UP) Then Begin
   { Ne pas intercepter les clics dans l explorateur }
   If (Ev.Kind = EV_MOUSE_DOWN) And
      (Ev.MouseX >= SolExplorer.X) And
      (Ev.MouseX < SolExplorer.X + SolExplorer.Width) And
      (Ev.MouseY >= SolExplorer.Y) And
      (Ev.MouseY < SolExplorer.Y + SolExplorer.Height) Then Begin
    { Laisser passer vers HandleExplorerEvent }
   End Else If OutputPanel.Visible And
      (Ev.MouseX >= OutputPanel.X) And
      (Ev.MouseX < OutputPanel.X + OutputPanel.Width) And
      (Ev.MouseY >= OutputPanel.Y) And
      (Ev.MouseY < OutputPanel.Y + OutputPanel.Height) Then Begin
    { Laisser passer vers HandleOutputEvent }
   End Else Begin
    If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX Then Begin
     HandleHexEditorMouse(ActiveHexEditor, Ev);
     If HexEditors[WinMgr.ActiveIdx] <> Nil Then
      HexEditors[WinMgr.ActiveIdx]^ := ActiveHexEditor;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorY :=
      ActiveHexEditor.CursorOfs Div HEX_BYTES_PER_ROW;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorX :=
      ActiveHexEditor.CursorOfs Mod HEX_BYTES_PER_ROW;
    End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_FORM Then Begin
     HandleFormEditorMouse(ActiveFormEditor, Ev);
     If FormEditors[WinMgr.ActiveIdx] <> Nil Then
      FormEditors[WinMgr.ActiveIdx]^ := ActiveFormEditor;
     If ActiveFormEditor.Modified Then
      MarkWindowModified(WinMgr.ActiveIdx);
    End Else Begin
     HandleEditorMouse(ActiveEditor, Ev);
     If Editors[WinMgr.ActiveIdx] <> Nil Then
      Editors[WinMgr.ActiveIdx]^ := ActiveEditor;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorY := ActiveEditor.CursorLine;
     WinMgr.Windows[WinMgr.ActiveIdx].CursorX := ActiveEditor.CursorCol - 1;
    End;
    Exit;
   End;
  End;
 End;
 { Evenements pour l explorateur }
 HandleExplorerEvent(SolExplorer, Ev);
 { Evenements pour le panneau de proprietes }
 HandlePropertiesEvent(PropsPanel, Ev);
 { Evenements pour le panneau de sortie }
 HandleOutputEvent(OutputPanel, Ev);
 { Evenements pour le terminal integre }
 If TermVisible Then
  HandleTerminalEvent(TermPanels[ActiveShell], Ev);
 { Evenements pour la liste d erreurs }
 HandleErrorListEvent(ErrorList, Ev);
End;

{ --- Boucle principale de l IDE --- }

Procedure MainLoop;
Var
 Ev: TEvent;
 LastBlinkState: Boolean;
 CurBlinkState: Boolean;
Begin
 QuitRequested := False;
 LastBlinkState := ProjPropCursorVisible;
 While Not QuitRequested Do Begin
  PollEvents(Ev);
  If Ev.Kind <> EV_NONE Then Begin
   DispatchEvent(Ev);
   UpdateStatusBar(StatusBar, WinMgr);
   { Ne pas redessiner tous les widgets si un menu est ouvert :
     DrawAllWidgets appelle DrawToolBar qui ecrase le menu deroulant }
   If Not MenuActive And Not CtxMenu.Visible Then
    DrawAllWidgets
   Else If CtxMenu.Visible Then Begin
    DrawAllWidgets;
    DrawContextMenu(CtxMenu);
   End;
   LastBlinkState := ProjPropCursorVisible;
  End Else Begin
   { Stage 1 (2026-08-15) : pas d execution asynchrone pour les backends   }
   { emulateur "convertis" (P.Loaded=True) - remplace l ancienne boucle     }
   { bloquante interne a ShowEmulatorPanel. Voir StepEmulator. }
   If EmuPanel.Base.Visible And EmuPanel.Loaded And EmuPanel.Running Then
    StepEmulator(EmuPanel);
   { Meme sans evenement utilisateur, redessiner si le terminal a change }
   If TermVisible And TermPanels[ActiveShell].NeedRepaint Then
    DrawTerminalPanel(TermPanels[ActiveShell]);
   { Faire clignoter le curseur du dialogue Proprietes du projet :
     ne redessiner que lorsque l etat de clignotement change }
   If ProjPropDlg.Base.Visible Then Begin
    CurBlinkState := ProjPropCursorVisible;
    If CurBlinkState <> LastBlinkState Then Begin
     UpdateProjPropCursor(ProjPropDlg);
     LastBlinkState := CurBlinkState;
    End;
   End;
   { EXTENSION (2026-08-08) : meme mecanisme de clignotement pour le      }
   { curseur du champ de recherche live de l explorateur de solutions -       }
   { ExplorerSearchCursorVisible suit EXACTEMENT le meme cycle de 500ms        }
   { (base uniquement sur l horloge) que ProjPropCursorVisible, donc               }
   { CurBlinkState/LastBlinkState ci-dessus restent valables tels quels. }
   If SolExplorer.SearchFocused Then Begin
    CurBlinkState := ExplorerSearchCursorVisible;
    If CurBlinkState <> LastBlinkState Then Begin
     DrawExplorer(SolExplorer);
     LastBlinkState := CurBlinkState;
    End;
   End;
  End;
 End;
End;

{ --- Demarrage de l IDE (procedure Run) --- }

Procedure Run;
Begin
 InitStatusBar(StatusBar);
 InitMRUList(MRUList);
 LoadMRUList(MRUList);
 InitStartPage(StartPage);
 InitTerminals;
 EmuDbg_Init;
 TerminalHasFocus := False;
 QuitRequested := False;
 FullRepaintNeeded := False;
 EditorReady := False;
 { Si un fichier solution .sln a ete passe en argument }
 If Opts.SolutionFile <> '' Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
  OpenSolutionFile(Opts.SolutionFile);
 End
 { Mode -emu:XXX,fichier : lancer immediatement l emulateur }
 Else If Opts.EmuMode Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
  EmuStartCmdLine := Opts.EmuArgs;
  CreateEmulatorTab(Opts.EmuFile, Opts.EmuTarget, Opts.EmuArgs);
 End
 { Si un fichier source a ete passe en argument, ouvrir directement l editeur }
 Else If Opts.SourceFile <> '' Then Begin
  StartPage.Visible := False;
  CreateEditorWindow(Opts.SourceFile);
  { Charger le fichier dans l editeur alloue }
  LoadFile(Editors[WinMgr.ActiveIdx]^.Buffer, Opts.SourceFile);
  ActiveEditor := Editors[WinMgr.ActiveIdx]^;
  EditorReady := True;
  { Peupler l explorateur de solutions avec le fichier ouvert }
  ClearExplorer(SolExplorer);
  AddExplorerNode(SolExplorer, 'Solution sans nom',
   ENK_SOLUTION, -1);
  SolExplorer.Nodes[0].Expanded := True;
  SolExplorer.Nodes[0].HasChildren := True;
  AddExplorerNode(SolExplorer,
   ExtractFileName(Opts.SourceFile),
   NodeKindFromExtension(Opts.SourceFile), 0);
  SolExplorer.SelectedIdx := 1;
  SolExplorer.Nodes[1].Selected := True;
  SolExplorer.NeedRepaint := True;
 End;
 DrawAllWidgets;
 MainLoop;
 SaveMRUList(MRUList);
End;

