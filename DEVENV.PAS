 LW := LowerCaseStr(Word);
 IsAdaType :=
  (LW = 'integer') Or (LW = 'natural') Or (LW = 'positive') Or
  (LW = 'float') Or (LW = 'character') Or (LW = 'string') Or
  (LW = 'boolean') Or (LW = 'duration') Or (LW = 'wide_character') Or
  (LW = 'wide_string') Or (LW = 'wide_wide_character') Or
