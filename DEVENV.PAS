Program DEVENV;

{$IFDEF FPC}
 {$MODE TP}
 {$H-}
 {$R-}
{$ENDIF}

Uses DOS,
     {$IFDEF FPC}
      PtcGraph,PtcCrt,PtcMouse
     {$ELSE}
      Crt,Graph
     {$ENDIF};

{$IFDEF WINDOWS}
Function GetAsyncKeyState(vKey: LongInt): SmallInt;
         StdCall; External 'user32.dll' Name 'GetAsyncKeyState';
Procedure WinSleep(MilliSec: LongInt);
         StdCall; External 'kernel32.dll' Name 'Sleep';
{$ENDIF}

{ ============================================================
  CONSTANTES GLOBALES
  ============================================================ }
Const
 DEVENV_VERSION = '1.0';
