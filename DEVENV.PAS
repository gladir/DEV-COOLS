{ Tenter de basculer le terminal sur le lecteur virtuel Idx (image
  montee via /DISK0, /DISK1, /DISK80 ou /DISK81). Affiche un message
  d erreur si l unite n est pas montee ou pas reconnue comme FAT. }
Procedure Term_TryEnterVirtDrive(Var TP: TTerminalPanel; Idx: Byte;
 MountHint: String);
Var
 DL: Char;
Begin
 DL := Term_DriveLetterFromIdx(Idx);
 Term_VirtEnsureMounted(Idx);
 If EmuFloppyOpen[Idx] And FatVol[Idx].Mounted Then Begin
  TP.VirtDrive := Idx;
  If TP.VirtCwd = '' Then TP.VirtCwd := '\';
 End Else If EmuFloppyOpen[Idx] Then
  TermAddLine(TP, 'Volume ' + DL + ': monte mais format FAT non reconnu.')
 Else Begin
  TermAddLine(TP, 'Le systeme ne peut pas trouver le lecteur specifie.');
  TermAddLine(TP, '(Monter une image avec ' + MountHint + ' au demarrage.)');
 End;
End;

{ Cherche un executable DOS 16 bits (CmdName.COM puis CmdName.EXE, ou      }
{ CmdName tel quel s il a deja une extension .COM/.EXE) dans Dir - pour   }
{ le "fallback" du shell CMD : une commande non reconnue qui correspond   }
{ a un vrai binaire DOS present dans le repertoire courant est lancee           }
{ dans l emulateur 8086 integre plutot que de simplement s afficher            }
{ "non reconnue", comme le ferait authentiquement un vrai DOS. Renvoie   }
{ le chemin complet, ou '' si rien de correspondant n a ete trouve. --- }
Function TermFindDosExecutable(Const Dir, CmdName: String): String;
Var
 Base, UpName, Candidate: String;
Begin
 TermFindDosExecutable := '';
 Base := Dir;
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 UpName := UpCaseStr(CmdName);
 If (Length(UpName) > 4) And
    ((Copy(UpName, Length(UpName) - 3, 4) = '.COM') Or
     (Copy(UpName, Length(UpName) - 3, 4) = '.EXE')) Then Begin
  Candidate := Base + CmdName;
  If FileExists(Candidate) Then TermFindDosExecutable := Candidate;
  Exit;
 End;
 Candidate := Base + CmdName + '.COM';
 If FileExists(Candidate) Then Begin TermFindDosExecutable := Candidate; Exit; End;
 Candidate := Base + CmdName + '.EXE';
 If FileExists(Candidate) Then TermFindDosExecutable := Candidate;
End;

{ Cherche un executable Linux (ELF64 x86-64, sans extension - c est ainsi }
{ que les compilateurs *CW32 de ce projet nomment leur sortie Linux, voir }
{ BINLINUX\*) dans Dir - meme principe que TermFindDosExecutable ci-      }
{ dessus, mais la reconnaissance se fait sur la signature magique du      }
{ fichier (7F 45 4C 46) plutot que sur son extension, puisqu un binaire   }
{ Linux n en porte generalement pas. Renvoie le chemin complet, ou ''.   }
Function TermFindElfExecutable(Const Dir, CmdName: String): String;
Var
 Base, Candidate: String;
 F: File;
 Magic: Array[0..3] Of Byte;
 BytesReaded: Word;
Begin
 TermFindElfExecutable := '';
 Base := Dir;
 { BOGUE REEL trouve en implantant Start-LinuxProgram (2026-08-31,          }
 { demande explicite de l'utilisateur, exemple donne avec un chemin         }
 { ABSOLU) : contrairement a TOUTES les fonctions TermFind*Rom/Executable   }
 { soeurs (Nes/Atari2600/Coco3/Dos), il manquait ici la garde "chemin deja  }
 { absolu (lettre de lecteur) : ne pas le prefixer par Dir" - un chemin     }
 { comme "C:\Programs\Linux\hello.elf" se retrouvait donc concatene EN      }
 { PLUS du repertoire courant ("C:\Dossier\Actuel\C:\Programs\..."), un     }
 { chemin invalide qui echouait TOUJOURS silencieusement - deja un bogue    }
 { pour la commande LINUX existante, pas seulement le nouvel alias. }
 If (Length(CmdName) >= 2) And (CmdName[2] = ':') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 Candidate := Base + CmdName;
 If Not FileExists(Candidate) Then Exit;
 {$I-}
 Assign(F, Candidate);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FillChar(Magic, SizeOf(Magic), 0);
 BlockRead(F, Magic, SizeOf(Magic), BytesReaded);
 Close(F);
 If (BytesReaded = 4) And (Magic[0] = $7F) And (Magic[1] = Ord('E')) And
    (Magic[2] = Ord('L')) And (Magic[3] = Ord('F')) Then
  TermFindElfExecutable := Candidate;
End;

{ Cherche une ROM NES (.nes) pour CmdName tape dans un shell terminal -   }
{ meme principe exact que TermFindDosExecutable ci-dessus (essaie tel      }
{ quel si l extension .NES est deja fournie, sinon l ajoute) - utilise    }
{ par la nouvelle commande NES (2026-08-29, demande explicite de           }
{ l utilisateur : "taper NES fichier devrait lancer l emulateur NES"). }
Function TermFindNesRom(Const Dir, CmdName: String): String;
Var
 Base, UpName, Candidate: String;
Begin
 TermFindNesRom := '';
 Base := Dir;
 { Chemin deja absolu (lettre de lecteur) : ne pas le prefixer par Dir. }
 If (Length(CmdName) >= 2) And (CmdName[2] = ':') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 UpName := UpCaseStr(CmdName);
 If (Length(UpName) > 4) And (Copy(UpName, Length(UpName) - 3, 4) = '.NES') Then Begin
  Candidate := Base + CmdName;
  If FileExists(Candidate) Then TermFindNesRom := Candidate;
  Exit;
 End;
 Candidate := Base + CmdName + '.NES';
 If FileExists(Candidate) Then TermFindNesRom := Candidate;
End;

{ Version GENERIQUE de TermFindNesRom ci-dessus (meme principe exact,     }
{ parametree par l extension) - reutilisee par les commandes ATARI2600     }
{ (.A26), C64 (.PRG) et WIN16 (.EXE), 2026-08-29. }
Function TermFindRomByExt(Const Dir, CmdName, Ext: String): String;
Var
 Base, UpName, UpExt, Candidate: String;
Begin
 TermFindRomByExt := '';
 Base := Dir;
 If (Length(CmdName) >= 2) And (CmdName[2] = ':') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 UpName := UpCaseStr(CmdName);
 UpExt := UpCaseStr(Ext);
 If (Length(UpName) > Length(UpExt)) And
    (Copy(UpName, Length(UpName) - Length(UpExt), Length(UpExt) + 1)
     = '.' + UpExt) Then Begin
  Candidate := Base + CmdName;
  If FileExists(Candidate) Then TermFindRomByExt := Candidate;
  Exit;
 End;
 Candidate := Base + CmdName + '.' + Ext;
 If FileExists(Candidate) Then TermFindRomByExt := Candidate;
End;

{ Combine Dir et FileName en un chemin complet - meme detection de chemin }
{ deja absolu (lettre de lecteur, ou racine "\") que TermFindNesRom/        }
{ TermFindRomByExt ci-dessus, mais SANS jamais exiger que le fichier       }
{ existe deja : utilisee par la commande EDIT, qui doit pouvoir ouvrir un  }
{ nom de fichier qui n existe pas encore (comme un editeur reel, voir       }
{ LoadFile - un fichier absent y devient simplement un tampon vide). }
Function TermCombinePath(Const Dir, FileName: String): String;
Var
 Base: String;
Begin
 Base := Dir;
 If (Length(FileName) >= 2) And (FileName[2] = ':') Then Base := ''
 Else If (Length(FileName) >= 1) And (FileName[1] = '\') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 TermCombinePath := Base + FileName;
End;

{ CoCo3 n a pas UNE seule extension canonique (cartouches .PAK/.ROM,       }
{ binaires DECB souvent .BIN ou sans convention stricte) - essaie les 3    }
{ plus courantes dans l ordre, sinon le nom tel quel s il a deja une        }
{ extension explicite (meme esprit que les autres TermFind*, mais avec     }
{ plusieurs candidats plutot qu un seul). }
Function TermFindCoco3Rom(Const Dir, CmdName: String): String;
Var
 Base: String;
Begin
 Base := Dir;
 If (Length(CmdName) >= 2) And (CmdName[2] = ':') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 If Pos('.', CmdName) > 0 Then Begin
  TermFindCoco3Rom := '';
  If FileExists(Base + CmdName) Then TermFindCoco3Rom := Base + CmdName;
  Exit;
 End;
 If FileExists(Base + CmdName + '.ROM') Then Begin
  TermFindCoco3Rom := Base + CmdName + '.ROM'; Exit;
 End;
 If FileExists(Base + CmdName + '.PAK') Then Begin
  TermFindCoco3Rom := Base + CmdName + '.PAK'; Exit;
 End;
 If FileExists(Base + CmdName + '.BIN') Then Begin
  TermFindCoco3Rom := Base + CmdName + '.BIN'; Exit;
 End;
 TermFindCoco3Rom := '';
End;

{ BOGUE REEL trouve en implantant Start-Atari2600Program (2026-08-31,      }
{ demande explicite de l'utilisateur, exemples donnes avec .a26 ET .bin) : }
{ TermCmd_Atari2600 (commande ATARI2600 existante) appelait                }
{ `TermFindRomByExt(Dir,CmdName,'A26')`, qui n'accepte QUE l'extension      }
{ .A26 explicitement - un nom se terminant par .bin (extension la PLUS      }
{ courante en pratique pour les VRAIES ROM Atari 2600 trouvees en ligne,    }
{ souvent plus repandue que .a26 lui-meme) tombait dans la branche          }
{ "ajouter .A26" de TermFindRomByExt et cherchait "xxx.bin.A26" - un        }
{ fichier qui n'existe jamais, echouant donc TOUJOURS silencieusement pour  }
{ ce format pourtant tres repandu. Meme motif que TermFindCoco3Rom          }
{ ci-dessus (essaie plusieurs extensions candidates quand aucune n'est      }
{ deja presente) - reutilise ici pour Atari 2600 ET applique aussi a la     }
{ commande ATARI2600 existante ci-dessous (meme gain, pas seulement le      }
{ nouvel alias PowerShell). }
Function TermFindAtari2600Rom(Const Dir, CmdName: String): String;
Var
 Base: String;
Begin
 Base := Dir;
 If (Length(CmdName) >= 2) And (CmdName[2] = ':') Then Base := '';
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 If Pos('.', CmdName) > 0 Then Begin
  TermFindAtari2600Rom := '';
  If FileExists(Base + CmdName) Then TermFindAtari2600Rom := Base + CmdName;
  Exit;
 End;
 If FileExists(Base + CmdName + '.A26') Then Begin
  TermFindAtari2600Rom := Base + CmdName + '.A26'; Exit;
 End;
 If FileExists(Base + CmdName + '.BIN') Then Begin
  TermFindAtari2600Rom := Base + CmdName + '.BIN'; Exit;
 End;
 TermFindAtari2600Rom := '';
End;

{ Cherche un .PRG executable pour CmdName tape dans un shell terminal -   }
{ soit sur le disque HOTE (TP.VirtDrive<0, dans Dir, tranche entre               }
{ Commodore 64 et Atari ST par signature GEMDOS, voir NCIsAtariSTPrg),      }
{ soit sur une disquette virtuelle Commodore 64 montee (TP.VirtDrive>=0     }
{ et FatVol[TP.VirtDrive].IsD64 - toujours C64, aucune ambiguite possible   }
{ sur ce format), auquel cas le fichier trouve est extrait vers un           }
{ fichier hote temporaire (voir D64_ExtractToTempFile) puisque              }
{ ShowEmulatorPanel/CPU6502_LoadC64Prg n acceptent qu un chemin hote reel.  }
{ Renvoie True si un .PRG a ete trouve et resolu, avec TargetCPU/                }
{ ResolvedPath prets pour ShowEmulatorPanel. --- }
Function TermFindPrgExecutable(Var TP: TTerminalPanel; Const Dir, CmdName: String;
 Var TargetCPU, ResolvedPath: String): Boolean;
Var
 Base, UpName, Candidate, BaseNoExt: String;
 Track, Sector: Byte;
Begin
 TermFindPrgExecutable := False;
 If TP.VirtDrive < 0 Then Begin
  Base := Dir;
  If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
  UpName := UpCaseStr(CmdName);
  If (Length(UpName) > 4) And (Copy(UpName, Length(UpName) - 3, 4) = '.PRG') Then
   Candidate := Base + CmdName
  Else
   Candidate := Base + CmdName + '.PRG';
  If Not FileExists(Candidate) Then Exit;
  ResolvedPath := Candidate;
  If NCIsAtariSTPrg(Candidate) Then TargetCPU := '-CATARIST'
  Else TargetCPU := '-CC64';
  TermFindPrgExecutable := True;
 End Else If FatVol[TP.VirtDrive].IsD64 Then Begin
  BaseNoExt := CmdName;
  If (Length(BaseNoExt) > 4) And
     (UpCaseStr(Copy(BaseNoExt, Length(BaseNoExt) - 3, 4)) = '.PRG') Then
   BaseNoExt := Copy(BaseNoExt, 1, Length(BaseNoExt) - 4);
  If D64_FindPrgEntry(Byte(TP.VirtDrive), BaseNoExt, Track, Sector) Then
   If D64_ExtractToTempFile(Byte(TP.VirtDrive), Track, Sector, ResolvedPath) Then Begin
    TargetCPU := '-CC64';
    TermFindPrgExecutable := True;
   End;
 End;
End;

