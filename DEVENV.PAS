 End;
 { Charger le programme }
 Loaded := Emu_LoadProgram(P.CPU, BinaryPath);
 If Not Loaded Then Begin
  P.CurFg := 12;
  EmuVScr_WriteStr(P,
   'Erreur : impossible de charger le binaire DOS.');
  P.CurFg := OldFg;
