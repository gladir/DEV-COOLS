{ --- Charger les options depuis un fichier INI --- }

Procedure LoadOptions(Var Data: TOptionsDialogData;
 FileName: String);
Var
 F: Text;
 Line, Key, Value: String;
 Code: Integer;
Begin
 InitOptionsDialogData(Data);
 Assign(F, FileName);
 {$I-}
 Reset(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 While Not Eof(F) Do
 Begin
  ReadLn(F, Line);
  If Not ReadCfgLine(Line, Key, Value) Then Continue;
  If Key = 'ThemeName' Then
   Data.ThemeName := Value
  Else If Key = 'FontName' Then
   Data.FontName := Value
  Else If Key = 'FontSize' Then
  Begin
   Val(Value, Data.FontSize, Code);
   If Code <> 0 Then Data.FontSize := 10;
  End
  Else If Key = 'StartupAction' Then
  Begin
   Val(Value, Code, Code);
   Case Code Of
    0: Data.StartupAction := OSA_NOTHING;
    1: Data.StartupAction := OSA_LAST_PROJECT;
    2: Data.StartupAction := OSA_START_PAGE;
   End;
  End
  Else If Key = 'AutoSaveEnabled' Then
   Data.AutoSaveEnabled := StrToBool(Value)
  Else If Key = 'AutoSaveInterval' Then
  Begin
   Val(Value, Data.AutoSaveInterval, Code);
   If Code <> 0 Then Data.AutoSaveInterval := 300;
  End
  Else If Key = 'ShowLineNumbers' Then
   Data.ShowLineNumbers := StrToBool(Value)
  Else If Key = 'WordWrap' Then
   Data.WordWrap := StrToBool(Value)
  Else If Key = 'ShowWhitespace' Then
   Data.ShowWhitespace := StrToBool(Value)
  Else If Key = 'ShowIndentGuides' Then
   Data.ShowIndentGuides := StrToBool(Value)
  Else If Key = 'TabSize' Then
  Begin
   Val(Value, Data.TabSize, Code);
   If Code <> 0 Then Data.TabSize := 4;
  End
  Else If Key = 'InsertSpaces' Then
   Data.InsertSpaces := StrToBool(Value)
  Else If Key = 'IndentSize' Then
  Begin
   Val(Value, Data.IndentSize, Code);
   If Code <> 0 Then Data.IndentSize := 4;
  End
  Else If Key = 'SmoothScroll' Then
   Data.SmoothScroll := StrToBool(Value)
  Else If Key = 'ScrollMargin' Then
  Begin
   Val(Value, Data.ScrollMargin, Code);
   If Code <> 0 Then Data.ScrollMargin := 3;
  End
  Else If Key = 'AutoIndent' Then
   Data.AutoIndent := StrToBool(Value)
  Else If Key = 'AutoBraces' Then
   Data.AutoBraces := StrToBool(Value)
  Else If Key = 'DefaultProjectPath' Then
   Data.DefaultProjectPath := Value
  Else If Key = 'ShowOutputOnBuild' Then
   Data.ShowOutputOnBuild := StrToBool(Value)
  Else If Key = 'BuildVerbose' Then
   Data.BuildVerbose := StrToBool(Value)
  Else If Key = 'ParallelBuild' Then
  Begin
   Val(Value, Data.ParallelBuild, Code);
   If Code <> 0 Then Data.ParallelBuild := 1;
  End
  Else If Key = 'BreakOnFirstError' Then
   Data.BreakOnFirstError := StrToBool(Value)
  Else If Key = 'StepIntoProperties' Then
   Data.StepIntoProperties := StrToBool(Value)
  Else If Key = 'ShowDebugMessages' Then
   Data.ShowDebugMessages := StrToBool(Value)
  Else If Key = 'EmuShowDebugMessages' Then
   Data.EmuShowDebugMessages := StrToBool(Value)
  Else If Key = 'NesStandard' Then
  Begin
   Val(Value, Data.NesStandard, Code);
   If (Code <> 0) Or (Data.NesStandard < 0) Or
      (Data.NesStandard > 2) Then Data.NesStandard := 0;
  End
  Else If Key = 'C64RomOriginal' Then
   Data.C64RomOriginal := StrToBool(Value)
  Else If Key = 'C64RomBasicPath' Then
   Data.C64RomBasicPath := Value
  Else If Key = 'C64RomKernalPath' Then
   Data.C64RomKernalPath := Value
  Else If Key = 'C64RomChargenPath' Then
   Data.C64RomChargenPath := Value
  Else If Key = 'DosType' Then
  Begin
   Val(Value, Data.DosType, Code);
   If (Code <> 0) Or (Data.DosType < 0) Or
      (Data.DosType >= DOS_TYPE_COUNT) Then Data.DosType := 1;
  End
  Else If Key = 'DosCPUIDDetect' Then
   Data.DosCPUIDDetect := StrToBool(Value)
  Else If Key = 'DosCPUVendor' Then
  Begin
   Val(Value, Data.DosCPUVendor, Code);
   If (Code <> 0) Or (Data.DosCPUVendor < 0) Or
      (Data.DosCPUVendor >= DOS_CPU_VENDOR_COUNT) Then
    Data.DosCPUVendor := 0;
  End
  Else If Key = 'DosHardware' Then
  Begin
   Val(Value, Data.DosHardware, Code);
   If (Code <> 0) Or (Data.DosHardware < 0) Or
      (Data.DosHardware >= DOS_HARDWARE_COUNT) Then
    Data.DosHardware := 2;
  End
  Else If Key = 'DosVideo1' Then
  Begin
   Val(Value, Data.DosVideo1, Code);
   If (Code <> 0) Or (Data.DosVideo1 < 0) Or
      (Data.DosVideo1 >= DOS_VIDEO_COUNT) Then
    Data.DosVideo1 := 8;
  End
  Else If Key = 'DosVideo2' Then
  Begin
   Val(Value, Data.DosVideo2, Code);
   If (Code <> 0) Or (Data.DosVideo2 < 0) Or
      (Data.DosVideo2 >= DOS_VIDEO_COUNT) Then
    Data.DosVideo2 := 8;
  End
  Else If Key = 'DosDiskInterface' Then
  Begin
   Val(Value, Data.DosDiskInterface, Code);
   If (Code <> 0) Or (Data.DosDiskInterface < 0) Or
      (Data.DosDiskInterface >= DOS_DISK_IF_COUNT) Then
    Data.DosDiskInterface := 5; { IDE/ATA }
  End
  Else If Key = 'DosEmu8087' Then
   Data.DosEmu8087 := StrToBool(Value)
  Else If Key = 'DosEmu80286' Then
   Data.DosEmu80286 := StrToBool(Value)
  Else If Key = 'DosEmu80386' Then
   Data.DosEmu80386 := StrToBool(Value)
  Else If Key = 'DosXMS' Then
   Data.DosXMS := StrToBool(Value)
  Else If Key = 'DosXMSSize' Then
  Begin
   Val(Value, Data.DosXMSSize, Code);
   If Code <> 0 Then Data.DosXMSSize := 16384;
  End
  Else If Key = 'DosEMS' Then
   Data.DosEMS := StrToBool(Value)
  Else If Key = 'DosEMSSize' Then
  Begin
   Val(Value, Data.DosEMSSize, Code);
   If Code <> 0 Then Data.DosEMSSize := 4096;
  End
  Else If Key = 'DosEMSVersion' Then
  Begin
   Val(Value, Data.DosEMSVersion, Code);
   If (Code <> 0) Or (Data.DosEMSVersion < 0) Or
      (Data.DosEMSVersion >= DOS_EMS_VERSION_COUNT) Then
    Data.DosEMSVersion := 2;
  End
  Else If Key = 'DosTopView' Then
   Data.DosTopView := StrToBool(Value)
  Else If Key = 'DosDPMI' Then
   Data.DosDPMI := StrToBool(Value)
  Else If Key = 'DosDPMISize' Then
  Begin
   Val(Value, Data.DosDPMISize, Code);
   If Code <> 0 Then Data.DosDPMISize := 8192;
  End
  Else If Key = 'DosAnsiSys' Then
   Data.DosAnsiSys := StrToBool(Value)
  Else If Key = 'DosUMB' Then
   Data.DosUMB := StrToBool(Value)
  Else If Key = 'DosMSCDEX' Then
   Data.DosMSCDEX := StrToBool(Value)
  Else If Key = 'DosSouris' Then
   Data.DosSouris := StrToBool(Value)
  Else If Key = 'DosLogInt13' Then
   Data.DosLogInt13 := StrToBool(Value)
  Else If Key = 'DosMousePS2BIOS' Then
   Data.DosMousePS2BIOS := StrToBool(Value)
  Else If Key = 'DosMouseVendor' Then
  Begin
   Val(Value, Data.DosMouseVendor, Code);
   If (Code <> 0) Or (Data.DosMouseVendor < 0) Or
      (Data.DosMouseVendor >= DOS_MOUSE_VENDOR_COUNT) Then
    Data.DosMouseVendor := 0;
  End
  Else If Key = 'DosMouseVersion' Then
  Begin
   Val(Value, Data.DosMouseVersion, Code);
   If (Code <> 0) Or (Data.DosMouseVersion < 0) Or
      (Data.DosMouseVersion >= DOS_MOUSE_VERSION_COUNT) Then
    Data.DosMouseVersion := 2;
  End
  Else If Key = 'DosNovell' Then
   Data.DosNovell := StrToBool(Value)
  Else If Key = 'DosLAN' Then
   Data.DosLAN := StrToBool(Value)
  Else If Key = 'DosLANVendor' Then
  Begin
   Val(Value, Data.DosLANVendor, Code);
   If (Code <> 0) Or (Data.DosLANVendor < 0) Or
      (Data.DosLANVendor >= DOS_LAN_VENDOR_COUNT) Then
    Data.DosLANVendor := 0;
  End
  Else If Key = 'DosLogInt21' Then
   Data.DosLogInt21 := StrToBool(Value)
  Else If Key = 'DosLogDiag' Then
   Data.DosLogDiag := StrToBool(Value);
 End;
 Close(F);
End;

