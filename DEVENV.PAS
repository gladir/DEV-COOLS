{ --- Calculer la hauteur par defaut du panneau de proprietes, comme  }
{ environ le tiers de l espace vertical partage avec l explorateur de }
{ solution. Utilisee par InitExplorer et InitPropertiesPanel pour que }
{ les deux panneaux restent coherents sans dependre de l ordre        }
{ d appel des deux procedures. Le panneau de sortie (OutputPanel)     }
{ s etend sur toute la largeur de l ecran, y compris sous la colonne  }
{ explorateur/proprietes : il faut donc soustraire sa hauteur (et son }
{ propre splitter) de l espace disponible, sans quoi le panneau de    }
{ proprietes se retrouve dessine sous le panneau de sortie et devient }
{ totalement invisible (celui-ci est redessine par-dessus ensuite).   }

Function ComputePropsPanelHeight: Integer;
Var
 ExpY, TotalAvail, H: Integer;
Begin
 ExpY := TOOLBTN_HEIGHT + TAB_HEIGHT + 2;
 TotalAvail := GetScreenHeight - ExpY - STATUSBAR_HEIGHT
  - OUTPUT_HEIGHT - OUTPUT_SPLITTER_HEIGHT;
 H := TotalAvail Div 3;
 If H < PROPS_MIN_HEIGHT Then H := PROPS_MIN_HEIGHT;
 If H > PROPS_MAX_HEIGHT Then H := PROPS_MAX_HEIGHT;
 ComputePropsPanelHeight := H;
End;

{ --- Initialiser un noeud de l explorateur --- }

Procedure InitExplorerNode(Var Node: TExplorerNode);
Begin
 Node.Caption := '';
 Node.RelPath := '';
 Node.Kind := ENK_FILE_OTHER;
 Node.ParentIdx := -1;
 Node.Level := 0;
 Node.Expanded := False;
 Node.Visible := True;
 Node.Selected := False;
 Node.HasChildren := False;
 Node.Tag := 0;
End;

{ --- Initialiser l explorateur de solution --- }

Procedure InitExplorer(Var Exp: TSolutionExplorer);
Var
 I: Integer;
Begin
 Exp.NodeCount := 0;
 Exp.SelectedIdx := -1;
 Exp.ScrollTop := 0;
 Exp.X := GetScreenWidth - EXPLORER_WIDTH;
 Exp.Y := TOOLBTN_HEIGHT + TAB_HEIGHT + 2;
 Exp.Width := EXPLORER_WIDTH;
 Exp.Height := GetScreenHeight - Exp.Y - STATUSBAR_HEIGHT
  - OUTPUT_HEIGHT - OUTPUT_SPLITTER_HEIGHT
  - ComputePropsPanelHeight - PROPS_SPLITTER_HEIGHT;
 Exp.SplitterX := Exp.X - SPLITTER_WIDTH;
 Exp.Dragging := False;
 Exp.NeedRepaint := True;
 ActiveExplorerTab := ETAB_SOLUTION;
 Exp.Renaming := False;
 Exp.RenameIdx := -1;
 Exp.RenameBuf := '';
 Exp.RenameCPos := 0;
 Exp.SearchBuf := '';
 Exp.SearchCPos := 0;
 Exp.SearchFocused := False;
 For I := 0 To MAX_EXPLORER_NODES - 1 Do
  InitExplorerNode(Exp.Nodes[I]);
End;

{ --- Vider l explorateur --- }

Procedure ClearExplorer(Var Exp: TSolutionExplorer);
Var
 I: Integer;
Begin
 For I := 0 To Exp.NodeCount - 1 Do
  InitExplorerNode(Exp.Nodes[I]);
 Exp.NodeCount := 0;
 Exp.SelectedIdx := -1;
 Exp.ScrollTop := 0;
 Exp.NeedRepaint := True;
End;

{ --- Trouver l index situe juste apres le dernier descendant d un     }
{ noeud (ou juste apres le noeud lui-meme s il n en a aucun). Repose   }
{ sur l invariant que les sous-arbres sont toujours contigus dans le   }
{ tableau : tout noeud dont le niveau est strictement superieur a     }
{ celui de NodeIdx, tant que cette condition reste vraie en avancant,  }
{ fait partie de son sous-arbre.                                       }

Function FindExplorerSubtreeEnd(Var Exp: TSolutionExplorer;
 NodeIdx: Integer): Integer;
Var
 BaseLevel, I: Integer;
Begin
 BaseLevel := Exp.Nodes[NodeIdx].Level;
 I := NodeIdx + 1;
 While (I < Exp.NodeCount) And (Exp.Nodes[I].Level > BaseLevel) Do
  Inc(I);
 FindExplorerSubtreeEnd := I;
End;

{ --- Determiner ou inserer un nouveau noeud enfant de ParentIdx, pour }
{ qu il apparaisse visuellement juste apres les enfants existants de   }
{ ce parent plutot qu a la toute fin du tableau. Les noeuds racine     }
{ (ParentIdx = -1) continuent d etre ajoutes a la fin, comme avant.    }

Function FindExplorerInsertPos(Var Exp: TSolutionExplorer;
 ParentIdx: Integer): Integer;
Begin
 If ParentIdx < 0 Then
  FindExplorerInsertPos := Exp.NodeCount
 Else
  FindExplorerInsertPos := FindExplorerSubtreeEnd(Exp, ParentIdx);
End;

{ --- Reserver un emplacement libre a la position Pos, en decalant les }
{ noeuds suivants d un rang et en ajustant toutes les references       }
{ d index existantes (ParentIdx de chaque noeud, SelectedIdx,          }
{ RenameIdx) pour qu elles continuent de designer les memes noeuds     }
{ logiques apres le decalage.                                          }

Procedure InsertExplorerNodeSlot(Var Exp: TSolutionExplorer; Pos: Integer);
Var
 I: Integer;
Begin
 If Pos < 0 Then Pos := 0;
 If Pos > Exp.NodeCount Then Pos := Exp.NodeCount;
 For I := Exp.NodeCount DownTo Pos + 1 Do
  Exp.Nodes[I] := Exp.Nodes[I - 1];
 For I := 0 To Exp.NodeCount Do
  If (I <> Pos) And (Exp.Nodes[I].ParentIdx >= Pos) Then
   Inc(Exp.Nodes[I].ParentIdx);
 If Exp.SelectedIdx >= Pos Then Inc(Exp.SelectedIdx);
 If Exp.RenameIdx >= Pos Then Inc(Exp.RenameIdx);
 Inc(Exp.NodeCount);
End;

{ --- Ajouter un noeud a l explorateur --- }

Function AddExplorerNode(Var Exp: TSolutionExplorer;
 ACaption: String; Kind: TExplorerNodeKind;
 ParentIdx: Integer): Integer;
Var
 Pos: Integer;
Begin
 If Exp.NodeCount >= MAX_EXPLORER_NODES Then Begin
  AddExplorerNode := -1;
  Exit;
 End;
 Pos := FindExplorerInsertPos(Exp, ParentIdx);
 InsertExplorerNodeSlot(Exp, Pos);
 InitExplorerNode(Exp.Nodes[Pos]);
 Exp.Nodes[Pos].Caption := ACaption;
 Exp.Nodes[Pos].RelPath := ACaption;
 Exp.Nodes[Pos].Kind := Kind;
 Exp.Nodes[Pos].ParentIdx := ParentIdx;
 If ParentIdx >= 0 Then
  Exp.Nodes[Pos].Level := Exp.Nodes[ParentIdx].Level + 1
 Else
  Exp.Nodes[Pos].Level := 0;
 Exp.Nodes[Pos].Visible := True;
 If ParentIdx >= 0 Then
  Exp.Nodes[ParentIdx].HasChildren := True;
 AddExplorerNode := Pos;
 Exp.NeedRepaint := True;
End;

{ --- Supprimer un noeud de l explorateur --- }

Procedure RemoveExplorerNode(Var Exp: TSolutionExplorer;
 Index: Integer);
Var
 I: Integer;
Begin
 If (Index < 0) Or (Index >= Exp.NodeCount) Then Exit;
 For I := Index To Exp.NodeCount - 2 Do
  Exp.Nodes[I] := Exp.Nodes[I + 1];
 Dec(Exp.NodeCount);
 For I := 0 To Exp.NodeCount - 1 Do Begin
  If Exp.Nodes[I].ParentIdx = Index Then
   Exp.Nodes[I].ParentIdx := -1
  Else If Exp.Nodes[I].ParentIdx > Index Then
   Dec(Exp.Nodes[I].ParentIdx);
 End;
 If Exp.SelectedIdx = Index Then
  Exp.SelectedIdx := -1
 Else If Exp.SelectedIdx > Index Then
  Dec(Exp.SelectedIdx);
 If Exp.RenameIdx = Index Then
  Exp.RenameIdx := -1
 Else If Exp.RenameIdx > Index Then
  Dec(Exp.RenameIdx);
 Exp.NeedRepaint := True;
End;

{ --- Determiner le type de noeud selon l extension --- }

Function NodeKindFromExtension(FileName: String): TExplorerNodeKind;
Var
 Ext: String;
 I: Integer;
Begin
 Ext := '';
 For I := Length(FileName) DownTo 1 Do Begin
  If FileName[I] = '.' Then Begin
   Ext := LowerCaseStr(Copy(FileName, I, Length(FileName) - I + 1));
   Break;
  End;
 End;
 If Ext = '.cs' Then
  NodeKindFromExtension := ENK_FILE_CS
 Else If Ext = '.vb' Then
  NodeKindFromExtension := ENK_FILE_VB
 Else If (Ext = '.pas') Or (Ext = '.pp') Then
  NodeKindFromExtension := ENK_FILE_PAS
 Else If Ext = '.frm' Then
  NodeKindFromExtension := ENK_FILE_FRM
 Else
  NodeKindFromExtension := ENK_FILE_OTHER;
End;

{ --- Un noeud correspond-il au texte de recherche courant ? (comparaison }
{ insensible a la casse sur le libelle affiche) - EXTENSION (2026-08-08),   }
{ recherche live comme Visual Studio. --- }

Function NodeMatchesSearch(Var Node: TExplorerNode;
 Const Query: String): Boolean;
Begin
 NodeMatchesSearch := Pos(UpCaseStr(Query), UpCaseStr(Node.Caption)) > 0;
End;

{ --- Le noeud doit-il etre dessine "deplie" (triangle vers le bas) ?     }
{ Pendant une recherche live, tous les noeuds visibles ayant des enfants   }
{ sont affiches deplies (puisque Visible ne conserve alors que les             }
{ chemins menant a un resultat) - le champ Expanded reel n est PAS               }
{ modifie, pour retrouver l etat d origine une fois la recherche effacee. }

Function NodeShownExpanded(Var Exp: TSolutionExplorer;
 NodeIdx: Integer): Boolean;
Begin
 If Exp.SearchBuf <> '' Then
  NodeShownExpanded := True
 Else
  NodeShownExpanded := Exp.Nodes[NodeIdx].Expanded;
End;

{ --- Curseur clignotant du champ de recherche live - EXTENSION           }
{ (2026-08-08), meme principe (et meme cycle de 500ms) que                   }
{ ProjPropCursorVisible pour le dialogue Proprietes du projet, afin de           }
{ que l utilisateur comprenne qu il peut saisir du texte des qu il clique. --- }

Function ExplorerSearchCursorVisible: Boolean;
Begin
 ExplorerSearchCursorVisible := (GetTimestamp Div 500) Mod 2 = 0;
End;

{ --- Rafraichir la visibilite des noeuds --- }

Procedure RefreshExplorer(Var Exp: TSolutionExplorer);
Var
 I, Parent: Integer;
 Keep: Array[0..MAX_EXPLORER_NODES - 1] Of Boolean;
Begin
 If Exp.SearchBuf = '' Then Begin
  { Comportement d origine : visibilite pilotee par Expanded des ancetres. }
  For I := 0 To Exp.NodeCount - 1 Do Begin
   Exp.Nodes[I].Visible := True;
   Parent := Exp.Nodes[I].ParentIdx;
   While Parent >= 0 Do Begin
    If Not Exp.Nodes[Parent].Expanded Then Begin
     Exp.Nodes[I].Visible := False;
     Break;
    End;
    Parent := Exp.Nodes[Parent].ParentIdx;
   End;
  End;
 End Else Begin
  { EXTENSION (2026-08-08) : filtrage live - un noeud reste visible s il   }
  { correspond LUI-MEME a la recherche, ou s il est un ANCETRE d un            }
  { noeud qui y correspond (les chemins menant a un resultat restent            }
  { visibles et "deplies", exactement comme la recherche live de                  }
  { Visual Studio dans l explorateur de solutions) - independant de           }
  { Expanded, qui reste intact pour l etat post-recherche. }
  For I := 0 To Exp.NodeCount - 1 Do Keep[I] := False;
  For I := 0 To Exp.NodeCount - 1 Do
   If NodeMatchesSearch(Exp.Nodes[I], Exp.SearchBuf) Then Begin
    Keep[I] := True;
    Parent := Exp.Nodes[I].ParentIdx;
    While Parent >= 0 Do Begin
     Keep[Parent] := True;
     Parent := Exp.Nodes[Parent].ParentIdx;
    End;
   End;
  For I := 0 To Exp.NodeCount - 1 Do
   Exp.Nodes[I].Visible := Keep[I];
 End;
 Exp.NeedRepaint := True;
End;

{ --- Construire l arbre depuis la solution --- }

Procedure BuildSolutionTree(Var Exp: TSolutionExplorer;
 Var Sol: TSolution);
Var
 SolIdx, ProjIdx, RefIdx: Integer;
 I: Integer;
 ProjEntry: TProjectEntry;
Begin
 ClearExplorer(Exp);
 SolIdx := AddExplorerNode(Exp, Sol.Info.SolutionName,
  ENK_SOLUTION, -1);
 If SolIdx < 0 Then Exit;
 Exp.Nodes[SolIdx].Expanded := True;
 For I := 0 To Sol.ProjectCount - 1 Do Begin
  ProjEntry := Sol.Projects[I];
  ProjIdx := AddExplorerNode(Exp, ProjEntry.ProjectName,
   ENK_PROJECT, SolIdx);
  If ProjIdx < 0 Then Exit;
  Exp.Nodes[ProjIdx].Expanded := True;
  AddExplorerNode(Exp, 'Properties', ENK_PROPERTIES, ProjIdx);
  RefIdx := AddExplorerNode(Exp, 'References', ENK_REFERENCES,
   ProjIdx);
  If RefIdx >= 0 Then Begin
   Exp.Nodes[RefIdx].HasChildren := True;
   AddExplorerNode(Exp, 'System', ENK_REFERENCE, RefIdx);
   AddExplorerNode(Exp, 'System.Core', ENK_REFERENCE, RefIdx);
   AddExplorerNode(Exp, 'System.Data', ENK_REFERENCE, RefIdx);
  End;
 End;
 If Exp.NodeCount > 0 Then Begin
  Exp.SelectedIdx := 0;
  Exp.Nodes[0].Selected := True;
 End;
 Exp.NeedRepaint := True;
End;

{ --- Deplier un noeud --- }

Procedure ExpandNode(Var Exp: TSolutionExplorer; NodeIdx: Integer);
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 If Not Exp.Nodes[NodeIdx].HasChildren Then Exit;
 Exp.Nodes[NodeIdx].Expanded := True;
 RefreshExplorer(Exp);
End;

{ --- Replier un noeud --- }

Procedure CollapseNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer);
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 Exp.Nodes[NodeIdx].Expanded := False;
 RefreshExplorer(Exp);
End;

{ --- Basculer l etat deplie/replie --- }

Procedure ToggleNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer);
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 If Not Exp.Nodes[NodeIdx].HasChildren Then Exit;
 If Exp.Nodes[NodeIdx].Expanded Then
  CollapseNode(Exp, NodeIdx)
 Else
  ExpandNode(Exp, NodeIdx);
End;

{ --- Nombre total de noeuds --- }

Function GetExplorerNodeCount(Var Exp: TSolutionExplorer): Integer;
Begin
 GetExplorerNodeCount := Exp.NodeCount;
End;

{ --- Nombre de noeuds visibles --- }

Function GetVisibleNodeCount(Var Exp: TSolutionExplorer): Integer;
Var
 I, Cnt: Integer;
Begin
 Cnt := 0;
 For I := 0 To Exp.NodeCount - 1 Do
  If Exp.Nodes[I].Visible Then Inc(Cnt);
 GetVisibleNodeCount := Cnt;
End;

{ --- Nombre de rangees REELLEMENT affichables dans l explorateur ---     }
{ BOGUE REEL (2026-08-08) : la formule PRECEDEMMENT dupliquee a SIX          }
{ endroits differents - (Exp.Height - EXPLORER_NODE_HEIGHT) Div                }
{ EXPLORER_NODE_HEIGHT - ne tenait PAS compte des 2 pixels d espacement        }
{ APRES le titre (DrawExplorer : "DrawY := Exp.Y + EXPLORER_NODE_HEIGHT +      }
{ 2"), SURESTIMANT donc de 1 le nombre reel de rangees dessinees. Le clic         }
{ sur la fleche BAS de la barre de defilement calcule le defilement               }
{ maximal autorise comme "GetVisibleNodeCount - MaxScroll" : un MaxScroll             }
{ surestime de 1 rend ce plafond SOUS-estime de 1, empechant de JAMAIS               }
{ atteindre le vrai bas de l arbre a la souris des que celui-ci depasse                 }
{ l espace visible de peu (symptome signale par l utilisateur : "jamais                  }
{ capable de descendre en bas... avec la souris"). La navigation clavier                   }
{ (fleches) n etait JAMAIS affectee car elle positionne le defilement                        }
{ directement depuis l index du noeud SELECTIONNE (voir la note d en-tete                      }
{ de HandleExplorerEvent, section "Ajuster le defilement") plutot que de                         }
{ s appuyer sur ce plafond generique. MAINTENANT UNE SEULE fonction,                               }
{ reutilisee PARTOUT ou ce calcul intervenait (DrawExplorer, la barre de                             }
{ defilement ET son curseur, le clic sur les fleches, PgUp/PgDn, la                                    }
{ verification finale de securite) - plus aucune divergence possible. }
{ --- Coordonnee Y ou commence le CONTENU (l arbre) du panneau, sous le  }
{ titre + la barre d outils + le champ de recherche (EXTENSION            }
{ 2026-08-08, comme Visual Studio) - fonction unique reutilisee PARTOUT     }
{ ou "juste sous le titre" etait auparavant suppose etre "juste sous          }
{ l arbre commence" (DrawExplorer, ExplorerNodeHitTest, la barre de              }
{ defilement) - evite de repeter le calcul (et de le desynchroniser)             }
{ a plusieurs endroits, meme esprit que ExplorerVisibleRowCount ci-dessous. }
Function ExplorerContentTop(Var Exp: TSolutionExplorer): Integer;
Begin
 ExplorerContentTop := Exp.Y + EXPLORER_NODE_HEIGHT +
  EXPLORER_TOOLBAR_HEIGHT + EXPLORER_SEARCH_HEIGHT;
End;

{ --- Coordonnee Y ou se termine le CONTENU de n importe quel onglet du  }
{ panneau (juste au-dessus de la bande d onglets) - EXTENSION                    }
{ (2026-08-08). Contrepartie de ExplorerContentTop pour la limite               }
{ inferieure ; utilisee par TOUS les onglets (Explorateur/Git/Team/               }
{ PasChat), pas seulement l arbre. }
Function ExplorerContentBottom(Var Exp: TSolutionExplorer): Integer;
Begin
 ExplorerContentBottom := Exp.Y + Exp.Height - EXPLORER_TABSTRIP_HEIGHT;
End;

Function ExplorerVisibleRowCount(Var Exp: TSolutionExplorer): Integer;
Var N: Integer;
Begin
 N := (ExplorerContentBottom(Exp) - ExplorerContentTop(Exp) - 2)
  Div EXPLORER_NODE_HEIGHT;
 If N < 1 Then N := 1;
 ExplorerVisibleRowCount := N;
End;

{ --- Dessiner un noeud de l explorateur --- }

Procedure DrawExplorerNode(Var Exp: TSolutionExplorer;
 NodeIdx: Integer; DrawY: Integer);
Var
 DrawX: Integer;
 TriX, TriY: Integer;
Begin
 If (NodeIdx < 0) Or (NodeIdx >= Exp.NodeCount) Then Exit;
 DrawX := Exp.X + 4 + Exp.Nodes[NodeIdx].Level * EXPLORER_INDENT;
 { Fond de selection }
 If Exp.Nodes[NodeIdx].Selected Then Begin
  SetFillStyle(SolidFill, CLR_SELECTION);
  Bar(Exp.X, DrawY, Exp.X + Exp.Width - 1,
   DrawY + EXPLORER_NODE_HEIGHT - 1);
 End;
 { Triangle de depliage si le noeud a des enfants }
 If Exp.Nodes[NodeIdx].HasChildren Then Begin
  TriX := DrawX;
  TriY := DrawY + EXPLORER_NODE_HEIGHT Div 2;
  If NodeShownExpanded(Exp, NodeIdx) Then Begin
   SetColor(CLR_MENU_TEXT);
   Line(TriX, TriY - 3, TriX + 6, TriY - 3);
   Line(TriX, TriY - 3, TriX + 3, TriY + 3);
   Line(TriX + 6, TriY - 3, TriX + 3, TriY + 3);
  End Else Begin
   SetColor(CLR_MENU_TEXT);
   Line(TriX, TriY - 4, TriX, TriY + 4);
   Line(TriX, TriY - 4, TriX + 6, TriY);
   Line(TriX, TriY + 4, TriX + 6, TriY);
  End;
  DrawX := DrawX + 10;
 End Else
  DrawX := DrawX + 10;
 { Icone 16x16 selon le type/langage du noeud (2026-08-08) }
 DrawIcon16x16(DrawX, DrawY + 1,
  ExplorerIcons[ExplorerIconKindForNode(Exp.Nodes[NodeIdx])]);
 DrawX := DrawX + EXPLORER_ICON_SIZE;
 { Texte du noeud ou champ de renommage }
 If Exp.Renaming And (NodeIdx = Exp.RenameIdx) Then Begin
  { Fond blanc pour le champ de saisie }
  SetFillStyle(SolidFill, CLR_EDITOR_BG);
  Bar(DrawX - 2, DrawY + 1,
   Exp.X + Exp.Width - 14, DrawY + EXPLORER_NODE_HEIGHT - 2);
  SetColor(CLR_TITLEBAR_ACTIVE);
  Rectangle(DrawX - 2, DrawY + 1,
   Exp.X + Exp.Width - 14, DrawY + EXPLORER_NODE_HEIGHT - 2);
  SetColor(CLR_MENU_TEXT);
  OutTextXY(DrawX, DrawY + 3, Exp.RenameBuf);
  { Curseur clignotant }
  SetColor(CLR_MENU_TEXT);
  Line(DrawX + TextWidth(Copy(Exp.RenameBuf, 1, Exp.RenameCPos)),
   DrawY + 3,
   DrawX + TextWidth(Copy(Exp.RenameBuf, 1, Exp.RenameCPos)),
   DrawY + EXPLORER_NODE_HEIGHT - 4);
 End Else Begin
  If Exp.Nodes[NodeIdx].Selected Then
   SetColor(CLR_EDITOR_BG)
  Else
   SetColor(CLR_MENU_TEXT);
  OutTextXY(DrawX, DrawY + 3, Exp.Nodes[NodeIdx].Caption);
 End;
End;

{ --- Dessiner l explorateur de solution --- }

Procedure DrawExplorer(Var Exp: TSolutionExplorer);
Var
 I, DrawY, VisCount, VisTot, MaxVis: Integer;
 BtnX, BtnY, SearchY, CTop, CurX: Integer;
Begin
 { Fond du panneau }
 SetFillStyle(SolidFill, CLR_EXPLORER_BG);
 Bar(Exp.X, Exp.Y, Exp.X + Exp.Width - 1,
  Exp.Y + Exp.Height - 1);
 { Titre }
 If ExplorerHasFocus Then
  SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
 Else
  SetFillStyle(SolidFill, CLR_TITLEBAR);
 Bar(Exp.X, Exp.Y, Exp.X + Exp.Width - 1,
  Exp.Y + EXPLORER_NODE_HEIGHT - 1);
 SetColor(CLR_EDITOR_BG);
 Case ActiveExplorerTab Of
  ETAB_SOLUTION:     OutTextXY(Exp.X + 4, Exp.Y + 3, 'Explorateur de solutions');
  ETAB_GITCHANGES:   OutTextXY(Exp.X + 4, Exp.Y + 3, 'Modification Git');
  ETAB_TEAMEXPLORER: OutTextXY(Exp.X + 4, Exp.Y + 3, 'Team Explorer');
  ETAB_PASCHAT:      OutTextXY(Exp.X + 4, Exp.Y + 3, 'PasChat');
 End;
 { Splitter - commun a tous les onglets }
 SetFillStyle(SolidFill, CLR_BORDER);
 Bar(Exp.SplitterX, Exp.Y,
  Exp.SplitterX + SPLITTER_WIDTH - 1,
  Exp.Y + Exp.Height - 1);
 If ActiveExplorerTab = ETAB_SOLUTION Then Begin
 { EXTENSION (2026-08-08) : mini barre d outils (Actualiser/Tout             }
 { replier/Proprietes) sous le titre, comme Visual Studio. }
 SetFillStyle(SolidFill, CLR_TOOLBAR);
 Bar(Exp.X, Exp.Y + EXPLORER_NODE_HEIGHT, Exp.X + Exp.Width - 1,
  Exp.Y + EXPLORER_NODE_HEIGHT + EXPLORER_TOOLBAR_HEIGHT - 1);
 For I := 0 To EXPLORER_TOOLBAR_BTNCOUNT - 1 Do Begin
  BtnX := Exp.X + 2 + I * 22;
  BtnY := Exp.Y + EXPLORER_NODE_HEIGHT + 2;
  SetColor(CLR_BORDER);
  Rectangle(BtnX, BtnY, BtnX + 19, BtnY + 19);
  DrawIcon16x16(BtnX + 2, BtnY + 2, ExplorerToolbarIcons[I]);
 End;
 { EXTENSION (2026-08-08) : champ de recherche live sous la barre           }
 { d outils - filtre l arbre pendant la frappe (voir RefreshExplorer/           }
 { NodeMatchesSearch), exactement comme la recherche live de Visual                 }
 { Studio dans l explorateur de solutions. }
 SearchY := Exp.Y + EXPLORER_NODE_HEIGHT + EXPLORER_TOOLBAR_HEIGHT;
 SetFillStyle(SolidFill, CLR_TOOLBAR);
 Bar(Exp.X, SearchY, Exp.X + Exp.Width - 1,
  SearchY + EXPLORER_SEARCH_HEIGHT - 1);
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(Exp.X + 2, SearchY + 2, Exp.X + Exp.Width - 3,
  SearchY + EXPLORER_SEARCH_HEIGHT - 3);
 If Exp.SearchFocused Then
  SetColor(CLR_TITLEBAR_ACTIVE)
 Else
  SetColor(CLR_BORDER);
 Rectangle(Exp.X + 2, SearchY + 2, Exp.X + Exp.Width - 3,
  SearchY + EXPLORER_SEARCH_HEIGHT - 3);
 { Icone loupe simplifiee (cercle + manche) }
 SetColor(CLR_GRAYTEXT);
 Rectangle(Exp.X + 6, SearchY + 5, Exp.X + 11, SearchY + 10);
 Line(Exp.X + 11, SearchY + 10, Exp.X + 13, SearchY + 12);
 If Exp.SearchBuf = '' Then Begin
  If Not Exp.SearchFocused Then Begin
   SetColor(CLR_GRAYTEXT);
   OutTextXY(Exp.X + 18, SearchY + 4, 'Rechercher');
  End;
 End Else Begin
  SetColor(CLR_WINDOWTEXT);
  OutTextXY(Exp.X + 18, SearchY + 4, Exp.SearchBuf);
  { Bouton effacer ("x") a droite du champ }
  SetColor(CLR_GRAYTEXT);
  Line(Exp.X + Exp.Width - 16, SearchY + 5,
   Exp.X + Exp.Width - 11, SearchY + 10);
  Line(Exp.X + Exp.Width - 16, SearchY + 10,
   Exp.X + Exp.Width - 11, SearchY + 5);
 End;
 { EXTENSION (2026-08-08) : curseur clignotant tant que le champ a le    }
 { focus, meme si aucun texte n a encore ete saisi (comme un vrai champ      }
 { de texte) - demande explicite de l utilisateur. Dessine APRES le              }
 { texte/placeholder, que SearchBuf soit vide ou non. }
 If Exp.SearchFocused And ExplorerSearchCursorVisible Then Begin
  SetColor(CLR_WINDOWTEXT);
  CurX := Exp.X + 18 +
   TextWidth(Copy(Exp.SearchBuf, 1, Exp.SearchCPos));
  Line(CurX, SearchY + 3, CurX, SearchY + EXPLORER_SEARCH_HEIGHT - 5);
 End;
 { Dessiner les noeuds visibles }
 CTop := ExplorerContentTop(Exp);
 DrawY := CTop + 2;
 VisCount := 0;
 For I := 0 To Exp.NodeCount - 1 Do Begin
  If Not Exp.Nodes[I].Visible Then Continue;
  If VisCount < Exp.ScrollTop Then Begin
   Inc(VisCount);
   Continue;
  End;
  If DrawY + EXPLORER_NODE_HEIGHT > ExplorerContentBottom(Exp) Then
   Break;
  DrawExplorerNode(Exp, I, DrawY);
  DrawY := DrawY + EXPLORER_NODE_HEIGHT;
  Inc(VisCount);
 End;
 { Barre de defilement (toujours visible). Inclut deux boutons fleches
   en haut et en bas, et un curseur (thumb) proportionnel au centre.
   Si l'arbre tient en entier dans la zone visible, le thumb prend
   toute la hauteur du couloir. }
 VisTot := GetVisibleNodeCount(Exp);
 MaxVis := ExplorerVisibleRowCount(Exp);
 Begin
   { Couloir de la scrollbar (14 px de large). }
   SetFillStyle(SolidFill, CLR_SCROLLBAR);
   Bar(Exp.X + Exp.Width - 14, CTop,
    Exp.X + Exp.Width - 1, ExplorerContentBottom(Exp) - 1);
   { Bouton fleche haut (14x14 sous la recherche). }
   SetFillStyle(SolidFill, CLR_BORDER);
   Bar(Exp.X + Exp.Width - 14, CTop,
    Exp.X + Exp.Width - 1,
    CTop + 13);
   SetColor(CLR_EDITOR_BG);
   Rectangle(Exp.X + Exp.Width - 14, CTop,
    Exp.X + Exp.Width - 1,
    CTop + 13);
   { Triangle haut. }
   SetFillStyle(SolidFill, CLR_EDITOR_BG);
   Bar(Exp.X + Exp.Width - 8, CTop + 4,
    Exp.X + Exp.Width - 7, CTop + 4);
   Bar(Exp.X + Exp.Width - 9, CTop + 5,
    Exp.X + Exp.Width - 6, CTop + 5);
   Bar(Exp.X + Exp.Width - 10, CTop + 6,
    Exp.X + Exp.Width - 5, CTop + 6);
   Bar(Exp.X + Exp.Width - 11, CTop + 7,
    Exp.X + Exp.Width - 4, CTop + 7);
   { Bouton fleche bas (14x14 en bas). }
   SetFillStyle(SolidFill, CLR_BORDER);
   Bar(Exp.X + Exp.Width - 14, ExplorerContentBottom(Exp) - 14,
    Exp.X + Exp.Width - 1, ExplorerContentBottom(Exp) - 1);
   SetColor(CLR_EDITOR_BG);
   Rectangle(Exp.X + Exp.Width - 14, ExplorerContentBottom(Exp) - 14,
    Exp.X + Exp.Width - 1, ExplorerContentBottom(Exp) - 1);
   { Triangle bas. }
   SetFillStyle(SolidFill, CLR_EDITOR_BG);
   Bar(Exp.X + Exp.Width - 11, ExplorerContentBottom(Exp) - 11,
    Exp.X + Exp.Width - 4, ExplorerContentBottom(Exp) - 11);
   Bar(Exp.X + Exp.Width - 10, ExplorerContentBottom(Exp) - 10,
    Exp.X + Exp.Width - 5, ExplorerContentBottom(Exp) - 10);
   Bar(Exp.X + Exp.Width - 9, ExplorerContentBottom(Exp) - 9,
    Exp.X + Exp.Width - 6, ExplorerContentBottom(Exp) - 9);
   Bar(Exp.X + Exp.Width - 8, ExplorerContentBottom(Exp) - 8,
    Exp.X + Exp.Width - 7, ExplorerContentBottom(Exp) - 8);
   { Curseur (thumb) proportionnel a la taille visible. }
   Begin
    VisCount := CTop + 14;                          { y debut couloir }
    DrawY := ExplorerContentBottom(Exp) - 14;       { y fin couloir   }
    I := DrawY - VisCount;                          { hauteur couloir }
    If I < 12 Then I := 12;
    { Hauteur du thumb proportionnelle. }
    If VisTot <= MaxVis Then
     MaxVis := I            { l'arbre tient en entier : thumb plein }
    Else
     MaxVis := (I * MaxVis) Div VisTot;
    If MaxVis < 12 Then MaxVis := 12;
    If MaxVis > I Then MaxVis := I;
    { Position du thumb. }
    If VisTot - ExplorerVisibleRowCount(Exp) > 0 Then
     DrawY := VisCount +
      (Exp.ScrollTop * (I - MaxVis)) Div
      (VisTot - ExplorerVisibleRowCount(Exp))
    Else
     DrawY := VisCount;
    SetFillStyle(SolidFill, CLR_BORDER);
    Bar(Exp.X + Exp.Width - 13, DrawY,
     Exp.X + Exp.Width - 2, DrawY + MaxVis);
    SetColor(CLR_EDITOR_BG);
    Rectangle(Exp.X + Exp.Width - 13, DrawY,
     Exp.X + Exp.Width - 2, DrawY + MaxVis);
   End;
  End;
 End Else Begin
  { EXTENSION (2026-08-08) : contenu des 3 nouveaux onglets. }
  Case ActiveExplorerTab Of
   ETAB_GITCHANGES:   DrawGitChangesContent(Exp);
   ETAB_TEAMEXPLORER: DrawTeamExplorerContent(Exp);
   ETAB_PASCHAT:      DrawPasChatContent(Exp);
  End;
 End;
 { EXTENSION (2026-08-08) : bande d onglets, en bas du panneau, commune   }
 { a tous les onglets - Explorateur de solutions/Modification Git/Team       }
 { Explorer/PasChat, comme Visual Studio. }
 DrawExplorerTabStrip(Exp);
 { Bordure }
 SetColor(CLR_BORDER);
 Rectangle(Exp.X, Exp.Y, Exp.X + Exp.Width - 1,
  Exp.Y + Exp.Height - 1);
 Exp.NeedRepaint := False;
End;

{ ============================================================
  EXTENSION (2026-08-08) - BANDE D ONGLETS DU PANNEAU EXPLORATEUR
  ============================================================
  4 onglets partageant le meme panneau (titre + splitter communs,
  voir DrawExplorer) : Explorateur de solutions (arbre existant),
  Modification Git, Team Explorer, PasChat - comme Visual Studio, ou
  ces memes vues cohabitent dans un seul panneau dockable. }

{ --- Dessiner la bande d onglets (bas du panneau) --- }

Procedure DrawExplorerTabStrip(Var Exp: TSolutionExplorer);
Var
 TabW, TabX, I, TSY: Integer;
 Lbl: String;
Begin
 TSY := ExplorerContentBottom(Exp);
 SetFillStyle(SolidFill, CLR_TOOLBAR);
 Bar(Exp.X, TSY, Exp.X + Exp.Width - 1, Exp.Y + Exp.Height - 1);
 SetColor(CLR_BORDER);
 Line(Exp.X, TSY, Exp.X + Exp.Width - 1, TSY);
 TabW := Exp.Width Div EXPLORER_TAB_COUNT;
 For I := 0 To EXPLORER_TAB_COUNT - 1 Do Begin
  TabX := Exp.X + I * TabW;
  If TExplorerTabKind(I) = ActiveExplorerTab Then Begin
   SetFillStyle(SolidFill, CLR_EDITOR_BG);
   Bar(TabX, TSY + 1, TabX + TabW - 1, Exp.Y + Exp.Height - 1);
   SetColor(CLR_TITLEBAR_ACTIVE);
   Line(TabX, TSY + 1, TabX + TabW - 1, TSY + 1);
   Line(TabX, TSY + 1, TabX, Exp.Y + Exp.Height - 1);
   Line(TabX + TabW - 1, TSY + 1, TabX + TabW - 1, Exp.Y + Exp.Height - 1);
   SetColor(CLR_WINDOWTEXT);
  End Else Begin
   SetColor(CLR_GRAYTEXT);
  End;
  Case TExplorerTabKind(I) Of
   ETAB_SOLUTION:     Lbl := 'Explorateur';
   ETAB_GITCHANGES:   Lbl := 'Git';
   ETAB_TEAMEXPLORER: Lbl := 'Team';
   ETAB_PASCHAT:      Lbl := 'PasChat';
  End;
  OutTextXY(TabX + (TabW - TextWidth(Lbl)) Div 2, TSY + 5, Lbl);
  If I > 0 Then Begin
   SetColor(CLR_BORDER);
   Line(TabX, TSY + 1, TabX, Exp.Y + Exp.Height - 1);
  End;
 End;
End;

{ --- Trouver l onglet sous la souris (-1 si aucun) --- }

Function ExplorerTabStripHitTest(Var Exp: TSolutionExplorer;
 MX, MY: Integer): Integer;
Var
 TabW, TSY, Idx: Integer;
Begin
 ExplorerTabStripHitTest := -1;
 TSY := ExplorerContentBottom(Exp);
 If (MX < Exp.X) Or (MX >= Exp.X + Exp.Width) Then Exit;
 If (MY < TSY) Or (MY >= Exp.Y + Exp.Height) Then Exit;
 TabW := Exp.Width Div EXPLORER_TAB_COUNT;
 Idx := (MX - Exp.X) Div TabW;
 If Idx >= EXPLORER_TAB_COUNT Then
  Idx := EXPLORER_TAB_COUNT - 1;
 ExplorerTabStripHitTest := Idx;
End;

{ --- Coordonnee Y ou commence le contenu des onglets Git/Team/PasChat -   }
{ ces 3 onglets n ont pas de mini barre d outils+recherche comme l onglet     }
{ Explorateur (voir ExplorerContentTop, specifique a celui-ci) - juste            }
{ sous le titre partage. --- }

Function ExplorerTabContentTop(Var Exp: TSolutionExplorer): Integer;
Begin
 ExplorerTabContentTop := Exp.Y + EXPLORER_NODE_HEIGHT;
End;

