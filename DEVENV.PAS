Function C64_CiaRead(EA: Word): Byte; Forward;
Function C64_IoActive: Boolean; Forward;

Function CPU6502_Read(Addr: Word): Byte;
Var V: Byte; H: Boolean;
Begin
  If CPU6502_Variant = 4 Then Begin
    V := A2600_BusRead(Addr, H);
    If H Then Begin
      CPU6502_DataBus := V;
      CPU6502_Read := V;
      Exit;
    End;
  End;
  CPU6502_DataBus := CPU6502_Mem[Addr];
  CPU6502_Read := CPU6502_DataBus;
End;

Procedure CPU6502_Write(Addr: Word; V: Byte);
Begin
  CPU6502_DataBus := V;
  If CPU6502_Variant = 4 Then Begin
    A2600_BusWrite(Addr, V);
    Exit;
  End;
  If CPU6502_Variant = 3 Then
    If (((Addr >= $2000) And (Addr <= $4017)) Or (Addr >= $8000)) Then
      If NesBus_Write(Addr, V) Then Exit;
  If CPU6502_Variant = 1 Then
    If C64_BusWrite(Addr, V) Then Exit;
  CPU6502_Mem[Addr] := V;
End;

Function CPU6502_Read16(Addr: Word): Word;
Begin
  CPU6502_Read16 := CPU6502_Mem[Addr] Or
                    (Word(CPU6502_Mem[Word(Addr + 1)]) Shl 8);
End;

{ Lecture 16 bits avec bug 6502 page-boundary (utilise par JMP indirect) }
Function CPU6502_Read16Bug(Addr: Word): Word;
Var
  Hi: Word;
Begin
  Hi := (Addr And $FF00) Or ((Addr + 1) And $FF);
  CPU6502_Read16Bug := CPU6502_Mem[Addr] Or
                       (Word(CPU6502_Mem[Hi]) Shl 8);
End;

Procedure CPU6502_Push(V: Byte);
Begin
  CPU6502_Mem[$0100 Or CPU6502_S] := V;
{$PUSH}{$R-}{$Q-}
  CPU6502_S := (CPU6502_S - 1) And $FF;
{$POP}
End;

Function CPU6502_Pop: Byte;
Begin
{$PUSH}{$R-}{$Q-}
  CPU6502_S := (CPU6502_S + 1) And $FF;
{$POP}
  CPU6502_Pop := CPU6502_Mem[$0100 Or CPU6502_S];
End;

Procedure CPU6502_Push16(V: Word);
Begin
  CPU6502_Push((V Shr 8) And $FF);
  CPU6502_Push(V And $FF);
End;

Function CPU6502_Pop16: Word;
Var
  Lo, Hi: Byte;
Begin
  Lo := CPU6502_Pop;
  Hi := CPU6502_Pop;
  CPU6502_Pop16 := Lo Or (Word(Hi) Shl 8);
End;

{ Drapeaux : N=$80 V=$40 -=$20 B=$10 D=$08 I=$04 Z=$02 C=$01 }
Procedure CPU6502_SetNZ(V: Byte);
Begin
  CPU6502_P := CPU6502_P And Not $82;
  If V = 0 Then CPU6502_P := CPU6502_P Or $02;
  If (V And $80) <> 0 Then CPU6502_P := CPU6502_P Or $80;
End;

Function CPU6502_GetC: Byte;
Begin
  If (CPU6502_P And $01) <> 0 Then CPU6502_GetC := 1 Else CPU6502_GetC := 0;
End;

Procedure CPU6502_SetC(B: Boolean);
Begin
  If B Then CPU6502_P := CPU6502_P Or $01
       Else CPU6502_P := CPU6502_P And Not $01;
End;

Procedure CPU6502_SetZ(B: Boolean);
Begin
  If B Then CPU6502_P := CPU6502_P Or $02
       Else CPU6502_P := CPU6502_P And Not $02;
End;

Procedure CPU6502_SetV(B: Boolean);
Begin
  If B Then CPU6502_P := CPU6502_P Or $40
       Else CPU6502_P := CPU6502_P And Not $40;
End;

Procedure CPU6502_SetN(B: Boolean);
Begin
  If B Then CPU6502_P := CPU6502_P Or $80
       Else CPU6502_P := CPU6502_P And Not $80;
End;

{ Modes d adressage - retournent l adresse effective et avancent PC }
Function CPU6502_AmIMM: Word;
Begin
  CPU6502_AmIMM := CPU6502_PC; Inc(CPU6502_PC);
End;

Function CPU6502_AmZP: Word;
Begin
  CPU6502_AmZP := CPU6502_Mem[CPU6502_PC]; Inc(CPU6502_PC);
End;

Function CPU6502_AmZPX: Word;
Begin
  CPU6502_AmZPX := (CPU6502_Mem[CPU6502_PC] + CPU6502_X) And $FF;
  Inc(CPU6502_PC);
End;

Function CPU6502_AmZPY: Word;
Begin
  CPU6502_AmZPY := (CPU6502_Mem[CPU6502_PC] + CPU6502_Y) And $FF;
  Inc(CPU6502_PC);
End;

Function CPU6502_AmABS: Word;
Var W: Word;
Begin
  W := CPU6502_Read16(CPU6502_PC);
  CPU6502_AmABS := W;
  CPU6502_PC := CPU6502_PC + 2;
  If (CPU6502_Variant = 4) And ((W And $1000) <> 0) Then
    A2600_CheckHotspot(W);
End;

Function CPU6502_AmABX: Word;
Var W, Base: Word;
Begin
  Base := CPU6502_Read16(CPU6502_PC);
  W := Base + CPU6502_X;
  CPU6502_AmABX := W;
  CPU6502_PC := CPU6502_PC + 2;
  If (W And $FF00) <> (Base And $FF00) Then CPU6502_PageCrossed := True;
  If (CPU6502_Variant = 4) And ((W And $1000) <> 0) Then
    A2600_CheckHotspot(W);
End;

Function CPU6502_AmABY: Word;
Var W, Base: Word;
Begin
  Base := CPU6502_Read16(CPU6502_PC);
  W := Base + CPU6502_Y;
  CPU6502_AmABY := W;
  CPU6502_PC := CPU6502_PC + 2;
  If (W And $FF00) <> (Base And $FF00) Then CPU6502_PageCrossed := True;
  If (CPU6502_Variant = 4) And ((W And $1000) <> 0) Then
    A2600_CheckHotspot(W);
End;

Function CPU6502_AmIZX: Word; { (zp,X) }
Var Z: Byte;
Begin
  Z := (CPU6502_Mem[CPU6502_PC] + CPU6502_X) And $FF;
  Inc(CPU6502_PC);
  CPU6502_AmIZX := CPU6502_Mem[Z] Or
                   (Word(CPU6502_Mem[(Z + 1) And $FF]) Shl 8);
End;

Function CPU6502_AmIZY: Word; { (zp),Y }
Var Z: Byte; Base: Word;
Begin
  Z := CPU6502_Mem[CPU6502_PC];
  Inc(CPU6502_PC);
  Base := CPU6502_Mem[Z] Or
          (Word(CPU6502_Mem[(Z + 1) And $FF]) Shl 8);
  CPU6502_AmIZY := Word(Base + CPU6502_Y);
  If ((Base + CPU6502_Y) And $FF00) <> (Base And $FF00) Then
    CPU6502_PageCrossed := True;
End;

{ Branchement relatif signe }
Procedure CPU6502_Branch(Cond: Boolean);
Var
  Off: ShortInt;
  Target: Word;
Begin
  Off := ShortInt(CPU6502_Mem[CPU6502_PC]);
  Inc(CPU6502_PC);
  If Cond Then Begin
    Target := CPU6502_PC + Off;
    { +1 cycle si la branche est prise, +1 supplementaire si page crossing.}
    Inc(CPU6502_LastCyc);
    If (Target And $FF00) <> (CPU6502_PC And $FF00) Then
      Inc(CPU6502_LastCyc);
    CPU6502_PC := Target;
  End;
End;

{ Operations arithmetiques/logiques }
Procedure CPU6502_DoADC(M: Byte);
Var
  R: Word;
  A: Byte;
  C, Lo, Hi, Bin: Integer;
Begin
  A := CPU6502_A;
  C := CPU6502_GetC;
  { Mode decimal (BCD) : honore par 6502/6507 NMOS. Pas par 2A03 (NES). }
  If ((CPU6502_P And $08) <> 0) And (CPU6502_Variant <> 3) Then Begin
    Lo := (A And $0F) + (M And $0F) + C;
    If Lo > 9 Then Lo := Lo + 6;
    Hi := (A Shr 4) + (M Shr 4) + (Lo Shr 4);
    Bin := A + M + C;            { binaire pour Z }
    CPU6502_SetZ((Bin And $FF) = 0);
    { N et V calcules a partir de l add BCD intermediaire (NMOS quirk).}
    CPU6502_SetN((Hi And $08) <> 0);
    CPU6502_SetV((((Hi Shl 4) Xor A) And $80 <> 0) And
                 ((A Xor M) And $80 = 0));
    If Hi > 9 Then Hi := Hi + 6;
    CPU6502_SetC(Hi > $0F);
    CPU6502_A := ((Hi Shl 4) Or (Lo And $0F)) And $FF;
    Exit;
  End;
  R := A + M + C;
  CPU6502_SetC(R > $FF);
  CPU6502_SetV(((A Xor M) And $80 = 0) And
               ((A Xor (R And $FF)) And $80 <> 0));
  CPU6502_A := R And $FF;
  CPU6502_SetNZ(CPU6502_A);
End;

Procedure CPU6502_DoSBC(M: Byte);
Var
  A: Byte;
  C, Lo, Hi, Bin: Integer;
Begin
  { En mode BCD : calcul soustraction decimal, drapeaux N/V/Z/C bases  }
  { sur le resultat binaire (NMOS).                                     }
  If ((CPU6502_P And $08) <> 0) And (CPU6502_Variant <> 3) Then Begin
    A := CPU6502_A;
    C := CPU6502_GetC;             { 1 = no borrow }
    Lo := (A And $0F) - (M And $0F) - (1 - C);
    If Lo < 0 Then Lo := Lo - 6;
    Hi := (A Shr 4) - (M Shr 4) - Ord(Lo < 0);
    If Hi < 0 Then Hi := Hi - 6;
    Bin := A - M - (1 - C);
    CPU6502_SetC(Bin >= 0);
    CPU6502_SetZ((Bin And $FF) = 0);
    CPU6502_SetN((Bin And $80) <> 0);
    CPU6502_SetV((((A Xor Bin) And $80) <> 0) And
                 (((A Xor M) And $80) <> 0));
    CPU6502_A := ((Hi And $0F) Shl 4) Or (Lo And $0F);
    Exit;
  End;
  CPU6502_DoADC(M Xor $FF);
End;

Procedure CPU6502_DoCMP(R, M: Byte);
Var
  D: Integer;
Begin
  D := Integer(R) - Integer(M);
  CPU6502_SetC(R >= M);
  CPU6502_SetNZ(Byte(D));
End;

Function CPU6502_DoASL(M: Byte): Byte;
Begin
  CPU6502_SetC((M And $80) <> 0);
  M := (M Shl 1) And $FF;
  CPU6502_SetNZ(M);
  CPU6502_DoASL := M;
End;

Function CPU6502_DoLSR(M: Byte): Byte;
Begin
  CPU6502_SetC((M And $01) <> 0);
  M := M Shr 1;
  CPU6502_SetNZ(M);
  CPU6502_DoLSR := M;
End;

Function CPU6502_DoROL(M: Byte): Byte;
Var Cin: Byte;
Begin
  Cin := CPU6502_GetC;
  CPU6502_SetC((M And $80) <> 0);
  M := ((M Shl 1) Or Cin) And $FF;
  CPU6502_SetNZ(M);
  CPU6502_DoROL := M;
End;

Function CPU6502_DoROR(M: Byte): Byte;
Var Cin: Byte;
Begin
  Cin := CPU6502_GetC;
  CPU6502_SetC((M And $01) <> 0);
  M := (M Shr 1) Or (Cin Shl 7);
  CPU6502_SetNZ(M);
  CPU6502_DoROR := M;
End;

{ Trap OS : si PC pointe vers une adresse magique connue, emit char en A     }
{ et execute un RTS implicite. Retourne True si trap traite.                 }
Function CPU6502_TryTrap: Boolean;
Var
  Ch: Byte;
Begin
  CPU6502_TryTrap := False;
  Ch := CPU6502_A;
  Case CPU6502_Variant Of
    0: { Apple II : COUT $FDED }
       If CPU6502_PC = $FDED Then
       Begin
         { ASCII Apple II : caracteres avec bit 7 mis }
         Ch := Ch And $7F;
         If Ch = $0D Then Begin
           EmuVScr_PutChar(CPU6502_Panel^, #13);
           EmuVScr_PutChar(CPU6502_Panel^, #10);
         End Else If Ch >= 32 Then
           EmuVScr_PutChar(CPU6502_Panel^, Chr(Ch));
         CPU6502_PC := CPU6502_Pop16 + 1;
         CPU6502_TryTrap := True;
       End;
    { 1 (C64) : plus de piege CHROUT $FFD2 depuis le demarrage materiel   }
    { reel (voir C64_Boot) - le vrai KERNAL execute maintenant sa propre  }
    { routine d ecriture ecran (met a jour la RAM ecran ET le suivi de   }
    { position du curseur que la visualisation directe de la RAM ecran    }
    { par C64_RenderFrame doit refleter fidelement) ; un piege court-      }
    { circuiterait ce suivi d etat interne et desynchroniserait l affichage.}
    2: { Atari 8-bit : CIO Put $E456 (mappable, voir aussi $E459) }
       If (CPU6502_PC = $E456) Or (CPU6502_PC = $E459) Then
       Begin
         If Ch = $9B Then Begin { ATASCII EOL }
           EmuVScr_PutChar(CPU6502_Panel^, #13);
           EmuVScr_PutChar(CPU6502_Panel^, #10);
         End Else If (Ch >= 32) And (Ch < 128) Then
           EmuVScr_PutChar(CPU6502_Panel^, Chr(Ch));
         CPU6502_PC := CPU6502_Pop16 + 1;
         CPU6502_TryTrap := True;
       End;
  End;
End;

{ --- Emulation NES complete ----------------------------------------- }
{ Couvre PPU (BG+sprites), OAM DMA $4014, manettes $4016/$4017,        }
{ APU silencieuse, NMI vblank. Rendu pixel framebuffer 256x240.        }

{ Palette NES -> EGA : voir constante globale NesPalToEga (debut fichier). }

{ Mappage adresse VRAM -> index nametable physique (2K) avec mirroring. }
Function NesPpu_NtAddr(A: Word): Word;
Var Page: Word;
Begin
  A := A And $0FFF;
  Page := A Shr 10;     { 0..3 }
  Case NesMirror Of
    0: { horizontal : NT0=NT1, NT2=NT3 -> bits 11 -> bit 10 }
       NesPpu_NtAddr := ((Page Shr 1) And 1) Shl 10 Or (A And $3FF);
    1: { vertical : NT0=NT2, NT1=NT3 -> bit 10 conserve, bit 11 ignore }
       NesPpu_NtAddr := (Page And 1) Shl 10 Or (A And $3FF);
    2: { 4-screen (rare, traite comme V) }
       NesPpu_NtAddr := (Page And 1) Shl 10 Or (A And $3FF);
  Else
    NesPpu_NtAddr := A And $3FF;
  End;
End;

{ Lecture VRAM PPU ($0000-$3FFF) avec gestion CHR/NT/Palette }
Function NesPpu_VRamRead(A: Word): Byte;
Var Idx: Byte;
Begin
  A := A And $3FFF;
  If A < $2000 Then
    NesPpu_VRamRead := NesChr[A]
  Else If A < $3F00 Then
    NesPpu_VRamRead := NesNT[NesPpu_NtAddr(A)]
  Else Begin
    Idx := A And $1F;
    { miroirs $3F10/$14/$18/$1C -> $3F00/$04/$08/$0C }
    If (Idx And $13) = $10 Then Idx := Idx And $0F;
    NesPpu_VRamRead := NesPal[Idx];
  End;
End;

Procedure NesPpu_VRamWrite(A: Word; V: Byte);
Var Idx: Byte;
Begin
  A := A And $3FFF;
  If A < $2000 Then
    NesChr[A] := V
  Else If A < $3F00 Then
    NesNT[NesPpu_NtAddr(A)] := V
  Else Begin
    Idx := A And $1F;
    If (Idx And $13) = $10 Then Idx := Idx And $0F;
    NesPal[Idx] := V And $3F;
  End;
End;

Procedure NesPpu_Reset;
Var I: Integer;
Begin
  NesPpuCtrl   := 0;
  NesPpuMask   := 0;
  NesPpuStatus := 0;
  NesOamAddr   := 0;
  NesScrollX   := 0;
  NesScrollY   := 0;
  NesPpuLatch  := False;
  NesPpuAddr   := 0;
  NesPpuBuf    := 0;
  NesNmiPending := False;
  NesFrameDone := False;
  NesFrameNo   := 0;
  NesPad1 := 0; NesPad2 := 0;
  NesPad1Sh := 0; NesPad2Sh := 0;
  NesPadStrobe := 0;
  For I := 0 To $7FF Do NesNT[I] := 0;
  For I := 0 To $1F  Do NesPal[I] := 0;
  For I := 0 To $FF  Do NesOam[I] := 0;
End;

Procedure NesPpu_RegWrite(Reg: Byte; V: Byte);
Begin
  Case Reg Of
    $00: NesPpuCtrl := V;
    $01: NesPpuMask := V;
    $03: NesOamAddr := V;
    $04: Begin
           NesOam[NesOamAddr] := V;
           NesOamAddr := (NesOamAddr + 1) And $FF;
         End;
    $05: { PPUSCROLL : 1ere = X, 2e = Y }
      Begin
        If Not NesPpuLatch Then NesScrollX := V
                           Else NesScrollY := V;
        NesPpuLatch := Not NesPpuLatch;
      End;
    $06: { PPUADDR : 1ere = high 6 bits, 2e = low }
      Begin
        If Not NesPpuLatch Then
          NesPpuAddr := (NesPpuAddr And $00FF) Or
                        ((Word(V) And $3F) Shl 8)
        Else
          NesPpuAddr := (NesPpuAddr And $FF00) Or V;
        NesPpuLatch := Not NesPpuLatch;
      End;
    $07: { PPUDATA }
      Begin
        NesPpu_VRamWrite(NesPpuAddr, V);
        If (NesPpuCtrl And $04) <> 0 Then
          NesPpuAddr := (NesPpuAddr + 32) And $3FFF
        Else
          NesPpuAddr := (NesPpuAddr + 1) And $3FFF;
      End;
  End;
End;

Function NesPpu_RegRead(Reg: Byte): Byte;
Var V: Byte;
Begin
  NesPpu_RegRead := 0;
  Case Reg Of
    $02: { PPUSTATUS }
      Begin
        NesPpu_RegRead := NesPpuStatus;
        NesPpuStatus := NesPpuStatus And $7F; { clear vblank }
        NesPpuLatch := False;
      End;
    $04: NesPpu_RegRead := NesOam[NesOamAddr];
    $07: { PPUDATA : lecture differee sauf palette }
      Begin
        If NesPpuAddr >= $3F00 Then Begin
          NesPpu_RegRead := NesPpu_VRamRead(NesPpuAddr);
          { tampon recoit la nametable mirroree dessous }
          NesPpuBuf := NesPpu_VRamRead(NesPpuAddr - $1000);
        End Else Begin
          V := NesPpuBuf;
          NesPpuBuf := NesPpu_VRamRead(NesPpuAddr);
          NesPpu_RegRead := V;
        End;
        If (NesPpuCtrl And $04) <> 0 Then
          NesPpuAddr := (NesPpuAddr + 32) And $3FFF
        Else
          NesPpuAddr := (NesPpuAddr + 1) And $3FFF;
      End;
  End;
End;

{ OAM DMA : copie 256 octets de la page CPU $XX00..$XXFF vers OAM. }
Procedure NesPpu_DmaOam(Page: Byte);
Var I: Integer; Base: Word;
Begin
  Base := Word(Page) Shl 8;
  For I := 0 To $FF Do
    NesOam[(NesOamAddr + I) And $FF] := CPU6502_Mem[Base + I];
End;

{ Sondage clavier -> matrice clavier C64 8x8 (Windows uniquement, meme  }
{ motif que NesPollInput ci-dessous : GetAsyncKeyState directement,      }
{ aucun evenement TEvent/Ev.KeyCode n atteint les emulateurs 6502 dans   }
{ ce fichier). Correspondance ligne/colonne = matrice materielle          }
{ standard C64 (largement republiee dans la communaute retro, jamais     }
{ recoupee ici avec une source Commodore primaire - a corriger si un      }
{ programme de test revele une touche mal placee). Couverture volontai-  }
{ rement partielle : lettres/chiffres/Entree/Espace/Retour arriere/Maj/  }
{ fleches seulement - RUN/STOP, les touches de fonction, CTRL, C=, la    }
{ livre sterling et la ponctuation exotique ne sont pas mappees. --- }
Procedure C64_PollKeyboard;
Begin
  FillChar(C64_KeyMatrix, SizeOf(C64_KeyMatrix), False);
  {$IFDEF WINDOWS}
  If GetAsyncKeyState(Ord('A')) < 0 Then C64_KeyMatrix[1,2] := True;
  If GetAsyncKeyState(Ord('B')) < 0 Then C64_KeyMatrix[3,4] := True;
  If GetAsyncKeyState(Ord('C')) < 0 Then C64_KeyMatrix[2,4] := True;
  If GetAsyncKeyState(Ord('D')) < 0 Then C64_KeyMatrix[2,2] := True;
  If GetAsyncKeyState(Ord('E')) < 0 Then C64_KeyMatrix[1,6] := True;
  If GetAsyncKeyState(Ord('F')) < 0 Then C64_KeyMatrix[2,5] := True;
  If GetAsyncKeyState(Ord('G')) < 0 Then C64_KeyMatrix[3,2] := True;
  If GetAsyncKeyState(Ord('H')) < 0 Then C64_KeyMatrix[3,5] := True;
  If GetAsyncKeyState(Ord('I')) < 0 Then C64_KeyMatrix[4,1] := True;
  If GetAsyncKeyState(Ord('J')) < 0 Then C64_KeyMatrix[4,2] := True;
  If GetAsyncKeyState(Ord('K')) < 0 Then C64_KeyMatrix[4,5] := True;
  If GetAsyncKeyState(Ord('L')) < 0 Then C64_KeyMatrix[5,2] := True;
  If GetAsyncKeyState(Ord('M')) < 0 Then C64_KeyMatrix[4,4] := True;
  If GetAsyncKeyState(Ord('N')) < 0 Then C64_KeyMatrix[4,7] := True;
  If GetAsyncKeyState(Ord('O')) < 0 Then C64_KeyMatrix[4,6] := True;
  If GetAsyncKeyState(Ord('P')) < 0 Then C64_KeyMatrix[5,1] := True;
  If GetAsyncKeyState(Ord('Q')) < 0 Then C64_KeyMatrix[7,6] := True;
  If GetAsyncKeyState(Ord('R')) < 0 Then C64_KeyMatrix[2,1] := True;
  If GetAsyncKeyState(Ord('S')) < 0 Then C64_KeyMatrix[1,5] := True;
  If GetAsyncKeyState(Ord('T')) < 0 Then C64_KeyMatrix[2,6] := True;
  If GetAsyncKeyState(Ord('U')) < 0 Then C64_KeyMatrix[3,6] := True;
  If GetAsyncKeyState(Ord('V')) < 0 Then C64_KeyMatrix[3,7] := True;
  If GetAsyncKeyState(Ord('W')) < 0 Then C64_KeyMatrix[1,1] := True;
  If GetAsyncKeyState(Ord('X')) < 0 Then C64_KeyMatrix[2,7] := True;
  If GetAsyncKeyState(Ord('Y')) < 0 Then C64_KeyMatrix[3,1] := True;
  If GetAsyncKeyState(Ord('Z')) < 0 Then C64_KeyMatrix[1,4] := True;
  If GetAsyncKeyState(Ord('0')) < 0 Then C64_KeyMatrix[4,3] := True;
  If GetAsyncKeyState(Ord('1')) < 0 Then C64_KeyMatrix[7,0] := True;
  If GetAsyncKeyState(Ord('2')) < 0 Then C64_KeyMatrix[7,3] := True;
  If GetAsyncKeyState(Ord('3')) < 0 Then C64_KeyMatrix[1,0] := True;
  If GetAsyncKeyState(Ord('4')) < 0 Then C64_KeyMatrix[1,3] := True;
  If GetAsyncKeyState(Ord('5')) < 0 Then C64_KeyMatrix[2,0] := True;
  If GetAsyncKeyState(Ord('6')) < 0 Then C64_KeyMatrix[2,3] := True;
  If GetAsyncKeyState(Ord('7')) < 0 Then C64_KeyMatrix[3,0] := True;
  If GetAsyncKeyState(Ord('8')) < 0 Then C64_KeyMatrix[3,3] := True;
  If GetAsyncKeyState(Ord('9')) < 0 Then C64_KeyMatrix[4,0] := True;
  If GetAsyncKeyState($0D) < 0 Then C64_KeyMatrix[0,1] := True; { Entree }
  If GetAsyncKeyState($20) < 0 Then C64_KeyMatrix[7,4] := True; { Espace }
  If GetAsyncKeyState($08) < 0 Then C64_KeyMatrix[0,0] := True; { Retour->DEL }
  If GetAsyncKeyState($10) < 0 Then C64_KeyMatrix[1,7] := True; { Maj->LSHIFT }
  If GetAsyncKeyState($27) < 0 Then C64_KeyMatrix[0,2] := True; { Droite }
  If GetAsyncKeyState($25) < 0 Then Begin { Gauche = Maj+CRSR droite }
    C64_KeyMatrix[0,2] := True;
    C64_KeyMatrix[1,7] := True;
  End;
  If GetAsyncKeyState($28) < 0 Then C64_KeyMatrix[0,7] := True; { Bas }
  If GetAsyncKeyState($26) < 0 Then Begin { Haut = Maj+CRSR bas }
    C64_KeyMatrix[0,7] := True;
    C64_KeyMatrix[1,7] := True;
  End;
  {$ENDIF}
End;

{ Meme table ligne/colonne que C64_PollKeyboard ci-dessus, mais pour un   }
{ caractere ASCII isole (utilise par C64_ApplyAutoType pour "taper"          }
{ RUN/SYS automatiquement) - seul le sous-ensemble necessaire a ces          }
{ deux commandes est couvert (lettres, chiffres, espace, Entree). --- }
Function C64_CharToMatrix(Ch: Char; Var Row, Col: Byte): Boolean;
Begin
 C64_CharToMatrix := True;
 Case UpCase(Ch) Of
  'A': Begin Row := 1; Col := 2; End;
  'B': Begin Row := 3; Col := 4; End;
  'C': Begin Row := 2; Col := 4; End;
  'D': Begin Row := 2; Col := 2; End;
  'E': Begin Row := 1; Col := 6; End;
  'F': Begin Row := 2; Col := 5; End;
  'G': Begin Row := 3; Col := 2; End;
  'H': Begin Row := 3; Col := 5; End;
  'I': Begin Row := 4; Col := 1; End;
  'J': Begin Row := 4; Col := 2; End;
  'K': Begin Row := 4; Col := 5; End;
  'L': Begin Row := 5; Col := 2; End;
  'M': Begin Row := 4; Col := 4; End;
  'N': Begin Row := 4; Col := 7; End;
  'O': Begin Row := 4; Col := 6; End;
  'P': Begin Row := 5; Col := 1; End;
  'Q': Begin Row := 7; Col := 6; End;
  'R': Begin Row := 2; Col := 1; End;
  'S': Begin Row := 1; Col := 5; End;
  'T': Begin Row := 2; Col := 6; End;
  'U': Begin Row := 3; Col := 6; End;
  'V': Begin Row := 3; Col := 7; End;
  'W': Begin Row := 1; Col := 1; End;
  'X': Begin Row := 2; Col := 7; End;
  'Y': Begin Row := 3; Col := 1; End;
  'Z': Begin Row := 1; Col := 4; End;
  '0': Begin Row := 4; Col := 3; End;
  '1': Begin Row := 7; Col := 0; End;
  '2': Begin Row := 7; Col := 3; End;
  '3': Begin Row := 1; Col := 0; End;
  '4': Begin Row := 1; Col := 3; End;
  '5': Begin Row := 2; Col := 0; End;
  '6': Begin Row := 2; Col := 3; End;
  '7': Begin Row := 3; Col := 0; End;
  '8': Begin Row := 3; Col := 3; End;
  '9': Begin Row := 4; Col := 0; End;
  #13: Begin Row := 0; Col := 1; End; { Entree }
  ' ': Begin Row := 7; Col := 4; End; { Espace }
 Else
  C64_CharToMatrix := False;
 End;
End;

{ Simule la frappe reelle, caractere par caractere, de C64_PendingInject  }
{ ("RUN"+Entree ou "SYS <adresse>"+Entree, prepare par C64_Boot) en          }
{ enfoncant/relachant la touche correspondante dans C64_KeyMatrix quelques }
{ trames chacune - laisse le KERNAL lui-meme (scrutation clavier de son     }
{ gestionnaire d IRQ par defaut, deja actif via C64_TickCia1/CPU6502_IRQ)  }
{ faire l echo a l ecran et gerer le curseur, exactement comme une vraie    }
{ frappe humaine. Appelee une fois par trame, apres C64_PollKeyboard        }
{ (dont elle complete la matrice sans l ecraser). --- }
Procedure C64_ApplyAutoType;
Const
 HoldFrames = 4;
 GapFrames = 3;
Var
 Row, Col: Byte;
Begin
 If C64_PendingInject = '' Then Exit;
 If C64_TypeIdx = 0 Then Begin
  If C64_PendingVartab <> 0 Then Begin
   CPU6502_Mem[$2D] := Byte(C64_PendingVartab And $FF);
   CPU6502_Mem[$2E] := Byte(C64_PendingVartab Shr 8);
   CPU6502_Mem[$2F] := Byte(C64_PendingVartab And $FF);
   CPU6502_Mem[$30] := Byte(C64_PendingVartab Shr 8);
   CPU6502_Mem[$31] := Byte(C64_PendingVartab And $FF);
   CPU6502_Mem[$32] := Byte(C64_PendingVartab Shr 8);
  End;
  C64_TypeIdx := 1;
  C64_TypePressed := True;
  C64_TypeCounter := HoldFrames;
 End;
 If C64_TypeIdx > Length(C64_PendingInject) Then Begin
  C64_PendingInject := '';
  Exit;
 End;
 If C64_TypePressed And
    C64_CharToMatrix(C64_PendingInject[C64_TypeIdx], Row, Col) Then
  C64_KeyMatrix[Row, Col] := True;
 Dec(C64_TypeCounter);
 If C64_TypeCounter <= 0 Then Begin
  If C64_TypePressed Then Begin
   C64_TypePressed := False;
   C64_TypeCounter := GapFrames;
  End Else Begin
   Inc(C64_TypeIdx);
   C64_TypePressed := True;
   C64_TypeCounter := HoldFrames;
  End;
 End;
End;

{ Sondage clavier -> etat manette 1 (Windows uniquement). }
{ Bits : 0=A 1=B 2=Sel 3=Start 4=Up 5=Down 6=Left 7=Right }
Procedure NesPollInput;
Var V: Byte;
Begin
  V := 0;
  {$IFDEF WINDOWS}
  If GetAsyncKeyState($5A) < 0 Then V := V Or $01; { Z = A          }
  If GetAsyncKeyState($58) < 0 Then V := V Or $02; { X = B          }
  If GetAsyncKeyState($41) < 0 Then V := V Or $01; { A = A (alt)    }
  If GetAsyncKeyState($53) < 0 Then V := V Or $02; { S = B (alt)    }
  If GetAsyncKeyState($A1) < 0 Then V := V Or $04; { RShift = Select}
  If GetAsyncKeyState($09) < 0 Then V := V Or $04; { Tab    = Select}
  If GetAsyncKeyState($0D) < 0 Then V := V Or $08; { Enter  = Start }
  If GetAsyncKeyState($20) < 0 Then V := V Or $08; { Espace = Start }
  If GetAsyncKeyState($26) < 0 Then V := V Or $10; { Up             }
  If GetAsyncKeyState($28) < 0 Then V := V Or $20; { Down           }
  If GetAsyncKeyState($25) < 0 Then V := V Or $40; { Left           }
  If GetAsyncKeyState($27) < 0 Then V := V Or $80; { Right          }
  {$ENDIF}
  NesPad1 := V;
End;

{ Strobe manettes ($4016 ecriture). Latch l etat actuel quand strobe=1. }
Procedure NesPad_Write(V: Byte);
Begin
  NesPadStrobe := V And 1;
  If NesPadStrobe = 1 Then Begin
    NesPad1Sh := NesPad1;
    NesPad2Sh := NesPad2;
  End;
End;

{ Lecture manettes ($4016/$4017). Renvoie le bit courant puis decale. }
Function NesPad_Read(Port: Byte): Byte;
Var Bit: Byte;
Begin
  If NesPadStrobe = 1 Then Begin
    NesPad1Sh := NesPad1;
    NesPad2Sh := NesPad2;
  End;
  If Port = 0 Then Begin
    Bit := NesPad1Sh And 1;
    NesPad1Sh := (NesPad1Sh Shr 1) Or $80;
  End Else Begin
    Bit := NesPad2Sh And 1;
    NesPad2Sh := (NesPad2Sh Shr 1) Or $80;
  End;
  NesPad_Read := Bit Or $40; { bits 6-7 open bus typiques }
End;

{ Rend une trame complete (BG + sprites) dans le framebuffer NesFB. }
{ Approche : par tile pour le BG, par sprite OAM pour les sprites,    }
{ priorite simplifiee (sprites devant BG sauf si bit 5 attribut).     }
Procedure NesPpu_RenderFrame;
Var
  Sx, Sy, Tx, Ty, Px, Py, FineX, FineY: Integer;
  NtBase, AtBase, BgPatBase, SpPatBase, NtIdx, AtByte: Word;
  TileNo, AtBits, PalIdx, ColorIdx, P0, P1: Byte;
  Bit, ScrX, ScrY, NtSel: Integer;
  AtX, AtY, Quad: Integer;
  S, SpriteY, SpriteTile, SpriteAttr, SpriteX: Integer;
  SpRow, SpCol, FlipH, FlipV, Behind, SpY: Integer;
  SpPat, BgPat: Word;
  ShowBg, ShowSp: Boolean;
  PixBg, PixSp: Byte;
  SpHeight: Integer;
Begin
  ShowBg := (NesPpuMask And $08) <> 0;
  ShowSp := (NesPpuMask And $10) <> 0;
  { Couleur de fond universelle }
  ColorIdx := NesPal[0] And $3F;
  For Py := 0 To 239 Do
    For Px := 0 To 255 Do NesFB[Py, Px] := ColorIdx;
  If Not (ShowBg Or ShowSp) Then Exit;
  { --- Background ---------------------------------------------------- }
  If ShowBg Then Begin
    BgPatBase := 0;
    If (NesPpuCtrl And $10) <> 0 Then BgPatBase := $1000;
    NtSel := NesPpuCtrl And $03;
    For Py := 0 To 239 Do Begin
      Sy := Py + NesScrollY;
      Ty := Sy Shr 3;     FineY := Sy And 7;
      For Px := 0 To 255 Do Begin
        Sx := Px + NesScrollX;
        Tx := Sx Shr 3;   FineX := Sx And 7;
        ScrY := Ty;       ScrX := Tx;
        { Determine quel nametable a partir du selecteur + scroll wrap }
        NtIdx := NtSel;
        If ScrX >= 32 Then Begin ScrX := ScrX - 32; NtIdx := NtIdx Xor 1; End;
        If ScrY >= 30 Then Begin ScrY := ScrY - 30; NtIdx := NtIdx Xor 2; End;
        NtBase := $2000 + (NtIdx * $400);
        AtBase := NtBase + $3C0;
        TileNo := NesPpu_VRamRead(NtBase + ScrY * 32 + ScrX);
        BgPat := BgPatBase + (Word(TileNo) Shl 4) + Word(FineY);
        P0 := NesPpu_VRamRead(BgPat);
        P1 := NesPpu_VRamRead(BgPat + 8);
        Bit := 7 - FineX;
        PixBg := ((P0 Shr Bit) And 1) Or (((P1 Shr Bit) And 1) Shl 1);
        If PixBg = 0 Then Begin
          NesFB[Py, Px] := NesPal[0] And $3F;
        End Else Begin
          AtX := ScrX Shr 2; AtY := ScrY Shr 2;
          AtByte := NesPpu_VRamRead(AtBase + AtY * 8 + AtX);
          Quad := ((ScrY And 2) Shl 1) Or (ScrX And 2);
          AtBits := (AtByte Shr Quad) And 3;
          PalIdx := (AtBits Shl 2) Or PixBg;
          NesFB[Py, Px] := NesPal[PalIdx And $1F] And $3F;
        End;
      End;
    End;
  End;
  { --- Sprites ------------------------------------------------------- }
  If ShowSp Then Begin
    SpPatBase := 0;
    If (NesPpuCtrl And $08) <> 0 Then SpPatBase := $1000;
    SpHeight := 8;
    If (NesPpuCtrl And $20) <> 0 Then SpHeight := 16;
    { Parcourt en sens inverse pour priorite OAM (sprite 0 dessine en dernier) }
    For S := 63 Downto 0 Do Begin
      SpriteY    := NesOam[S * 4    ];
      SpriteTile := NesOam[S * 4 + 1];
      SpriteAttr := NesOam[S * 4 + 2];
      SpriteX    := NesOam[S * 4 + 3];
      SpY := SpriteY + 1; { sprite affiche 1 ligne sous Y }
      If SpY >= 240 Then Continue;
      FlipH := SpriteAttr And $40;
      FlipV := SpriteAttr And $80;
      Behind := SpriteAttr And $20;
      For SpRow := 0 To SpHeight - 1 Do Begin
        Py := SpY + SpRow;
        If (Py < 0) Or (Py >= 240) Then Continue;
        FineY := SpRow;
        If FlipV <> 0 Then FineY := SpHeight - 1 - SpRow;
        If SpHeight = 8 Then
          SpPat := SpPatBase + (Word(SpriteTile) Shl 4) + Word(FineY)
        Else Begin
          { 8x16 : bit 0 du tile choisit la pattern table }
          If (SpriteTile And 1) <> 0 Then SpPat := $1000
                                     Else SpPat := 0;
          SpPat := SpPat + (Word(SpriteTile And $FE) Shl 4);
          If FineY >= 8 Then SpPat := SpPat + 16 + Word(FineY - 8)
                        Else SpPat := SpPat + Word(FineY);
        End;
        P0 := NesPpu_VRamRead(SpPat);
        P1 := NesPpu_VRamRead(SpPat + 8);
        For SpCol := 0 To 7 Do Begin
          Px := SpriteX + SpCol;
          If (Px < 0) Or (Px >= 256) Then Continue;
          If FlipH <> 0 Then Bit := SpCol Else Bit := 7 - SpCol;
          PixSp := ((P0 Shr Bit) And 1) Or
                   (((P1 Shr Bit) And 1) Shl 1);
          If PixSp = 0 Then Continue;
          { Sprite 0 hit : pixel sp non-trans + pixel BG non-trans }
          If (S = 0) And ShowBg And ((NesPpuStatus And $40) = 0) Then Begin
            { test BG opaque : recompare framebuffer != couleur fond }
            If NesFB[Py, Px] <> (NesPal[0] And $3F) Then
              NesPpuStatus := NesPpuStatus Or $40;
          End;
          { priorite }
          If (Behind <> 0) And ShowBg And
             (NesFB[Py, Px] <> (NesPal[0] And $3F)) Then Continue;
          PalIdx := $10 Or ((SpriteAttr And 3) Shl 2) Or PixSp;
          NesFB[Py, Px] := NesPal[PalIdx And $1F] And $3F;
        End;
      End;
    End;
  End;
  NesFrameDone := True;
End;

{ Compatibilite : ancien rendu texte (utilise par TPCW32 -CNES sortie texte) }
Procedure NesPpu_DoRender;
Begin
  NesPpu_RenderFrame;
End;

{ NMI 6502 : pousse PC et P, set I, charge vecteur $FFFA/$FFFB. }
Procedure CPU6502_NMI;
{$PUSH}{$R-}{$Q-}
Begin
  CPU6502_Push((CPU6502_PC Shr 8) And $FF);
  CPU6502_Push(CPU6502_PC And $FF);
  CPU6502_Push((CPU6502_P And $EF) Or $20); { B=0, U=1 }
  CPU6502_P := CPU6502_P Or $04;            { I=1 }
  CPU6502_PC := CPU6502_Mem[$FFFA] Or
                (Word(CPU6502_Mem[$FFFB]) Shl 8);
End;
{$POP}

{ IRQ 6502 (masquable, contrairement au NMI) : meme sequence de pile que }
{ CPU6502_NMI, mais chargee via le vecteur $FFFE/$FFFF et SEULEMENT si   }
{ le drapeau I (interruptions masquees) est actuellement a 0 - c est     }
{ l appelant qui doit garder la ligne IRQ "maintenue basse" tant que la  }
{ source materielle (CIA1 Timer A pour le C64) n a pas ete acquittee par }
{ une lecture de son registre ICR, exactement comme le vrai 6526. --- }
Procedure CPU6502_IRQ;
{$PUSH}{$R-}{$Q-}
Begin
  If (CPU6502_P And $04) <> 0 Then Exit; { I=1 : interruption masquee }
  CPU6502_Push((CPU6502_PC Shr 8) And $FF);
  CPU6502_Push(CPU6502_PC And $FF);
  CPU6502_Push((CPU6502_P And $EF) Or $20); { B=0, U=1 }
  CPU6502_P := CPU6502_P Or $04;            { I=1 }
  CPU6502_PC := CPU6502_Mem[$FFFE] Or
                (Word(CPU6502_Mem[$FFFF]) Shl 8);
End;
{$POP}

{ --- Mappers NES ---------------------------------------------------- }
{ Approche : copie 16K (ou 8K/4K/1K) depuis NesPrgRom vers CPU6502_Mem  }
{ ($8000..$FFFF) et depuis NesChrRom vers NesChr ($0000..$1FFF). Les   }
{ banks sont normalises modulo le nombre total disponible.             }

Procedure Nes_PrgMap16(SlotAddr: Word; Bank: Integer);
Var I: Integer; BaseRom: LongInt;
Begin
  If NesPrgBlocksTotal <= 0 Then Exit;
  Bank := Bank Mod NesPrgBlocksTotal;
  If Bank < 0 Then Bank := Bank + NesPrgBlocksTotal;
  BaseRom := LongInt(Bank) * 16384;
  For I := 0 To 16383 Do
    CPU6502_Mem[SlotAddr + I] := NesPrgRom[BaseRom + I];
End;

Procedure Nes_PrgMap8(SlotAddr: Word; Bank: Integer);
Var I: Integer; BaseRom: LongInt; BanksTotal: Integer;
Begin
  BanksTotal := NesPrgBlocksTotal * 2;
  If BanksTotal <= 0 Then Exit;
  Bank := Bank Mod BanksTotal;
  If Bank < 0 Then Bank := Bank + BanksTotal;
  BaseRom := LongInt(Bank) * 8192;
  For I := 0 To 8191 Do
    CPU6502_Mem[SlotAddr + I] := NesPrgRom[BaseRom + I];
End;

Procedure Nes_ChrMap4(SlotAddr: Word; Bank: Integer);
Var I: Integer; BaseRom: LongInt; BanksTotal: Integer;
Begin
  If NesUseChrRam Then Exit;
  BanksTotal := NesChrBlocksTotal * 2;
  If BanksTotal <= 0 Then Exit;
  Bank := Bank Mod BanksTotal;
  If Bank < 0 Then Bank := Bank + BanksTotal;
  BaseRom := LongInt(Bank) * 4096;
  For I := 0 To 4095 Do
    NesChr[SlotAddr + I] := NesChrRom[BaseRom + I];
End;

Procedure Nes_ChrMap1k(SlotAddr: Word; Bank: Integer);
Var I: Integer; BaseRom: LongInt; BanksTotal: Integer;
Begin
  If NesUseChrRam Then Exit;
  BanksTotal := NesChrBlocksTotal * 8;
  If BanksTotal <= 0 Then Exit;
  Bank := Bank Mod BanksTotal;
  If Bank < 0 Then Bank := Bank + BanksTotal;
  BaseRom := LongInt(Bank) * 1024;
  For I := 0 To 1023 Do
    NesChr[SlotAddr + I] := NesChrRom[BaseRom + I];
End;

{ --- MMC1 (mapper 1) -------------------------------------------------- }
Procedure Nes_M1ApplyBanks;
Var Mode: Byte; PrgLast: Integer;
Begin
  { Mirroring }
  Case NesM1Ctrl And 3 Of
    0, 1: NesMirror := 3; { 1-screen (traite comme V simplifie) }
    2: NesMirror := 1;
    3: NesMirror := 0;
  End;
  { CHR }
  If (NesM1Ctrl And $10) <> 0 Then Begin
    Nes_ChrMap4($0000, NesM1Chr0 And $1F);
    Nes_ChrMap4($1000, NesM1Chr1 And $1F);
  End Else Begin
    Nes_ChrMap4($0000, NesM1Chr0 And $1E);
    Nes_ChrMap4($1000, (NesM1Chr0 And $1E) Or 1);
  End;
  { PRG }
  Mode := (NesM1Ctrl Shr 2) And 3;
  PrgLast := NesPrgBlocksTotal - 1;
  Case Mode Of
    0, 1: Begin
      Nes_PrgMap16($8000, NesM1Prg And $0E);
      Nes_PrgMap16($C000, (NesM1Prg And $0E) Or 1);
    End;
    2: Begin
      Nes_PrgMap16($8000, 0);
      Nes_PrgMap16($C000, NesM1Prg And $0F);
    End;
    3: Begin
      Nes_PrgMap16($8000, NesM1Prg And $0F);
      Nes_PrgMap16($C000, PrgLast);
    End;
  End;
End;

Procedure Nes_M1Write(EA: Word; V: Byte);
Var Reg: Byte;
Begin
  If (V And $80) <> 0 Then Begin
    NesM1Shift := 0;
    NesM1ShiftCount := 0;
    NesM1Ctrl := NesM1Ctrl Or $0C;
    Nes_M1ApplyBanks;
    Exit;
  End;
  NesM1Shift := (NesM1Shift Shr 1) Or ((V And 1) Shl 4);
  Inc(NesM1ShiftCount);
  If NesM1ShiftCount >= 5 Then Begin
    Reg := (EA Shr 13) And 3;
    Case Reg Of
      0: NesM1Ctrl := NesM1Shift And $1F;
      1: NesM1Chr0 := NesM1Shift And $1F;
      2: NesM1Chr1 := NesM1Shift And $1F;
      3: NesM1Prg  := NesM1Shift And $1F;
    End;
    NesM1Shift := 0;
    NesM1ShiftCount := 0;
    Nes_M1ApplyBanks;
  End;
End;

{ --- UxROM (mapper 2) ------------------------------------------------- }
Procedure Nes_M2Write(EA: Word; V: Byte);
Begin
  Nes_PrgMap16($8000, V And $0F);
End;

{ --- MMC3 (mapper 4, IRQ scanline non emulee) ------------------------ }
Procedure Nes_M3ApplyBanks;
Var ChrInv, PrgMode: Byte; LastBank: Integer;
Begin
  ChrInv  := NesM3BankSelect And $80;
  PrgMode := NesM3BankSelect And $40;
  LastBank := NesPrgBlocksTotal * 2 - 1;
  If PrgMode = 0 Then Begin
    Nes_PrgMap8($8000, NesM3Banks[6]);
    Nes_PrgMap8($A000, NesM3Banks[7]);
    Nes_PrgMap8($C000, LastBank - 1);
    Nes_PrgMap8($E000, LastBank);
  End Else Begin
    Nes_PrgMap8($8000, LastBank - 1);
    Nes_PrgMap8($A000, NesM3Banks[7]);
    Nes_PrgMap8($C000, NesM3Banks[6]);
    Nes_PrgMap8($E000, LastBank);
  End;
  If ChrInv = 0 Then Begin
    Nes_ChrMap1k($0000, NesM3Banks[0] And $FE);
    Nes_ChrMap1k($0400, NesM3Banks[0] Or 1);
    Nes_ChrMap1k($0800, NesM3Banks[1] And $FE);
    Nes_ChrMap1k($0C00, NesM3Banks[1] Or 1);
    Nes_ChrMap1k($1000, NesM3Banks[2]);
    Nes_ChrMap1k($1400, NesM3Banks[3]);
    Nes_ChrMap1k($1800, NesM3Banks[4]);
    Nes_ChrMap1k($1C00, NesM3Banks[5]);
  End Else Begin
    Nes_ChrMap1k($0000, NesM3Banks[2]);
    Nes_ChrMap1k($0400, NesM3Banks[3]);
    Nes_ChrMap1k($0800, NesM3Banks[4]);
    Nes_ChrMap1k($0C00, NesM3Banks[5]);
    Nes_ChrMap1k($1000, NesM3Banks[0] And $FE);
    Nes_ChrMap1k($1400, NesM3Banks[0] Or 1);
    Nes_ChrMap1k($1800, NesM3Banks[1] And $FE);
    Nes_ChrMap1k($1C00, NesM3Banks[1] Or 1);
  End;
End;

Procedure Nes_M3Write(EA: Word; V: Byte);
Var Even: Boolean; Region: Byte;
Begin
  Even := (EA And 1) = 0;
  Region := (EA Shr 13) And 3;
  Case Region Of
    0: Begin
         If Even Then NesM3BankSelect := V
         Else Begin
           NesM3Banks[NesM3BankSelect And 7] := V;
         End;
         Nes_M3ApplyBanks;
       End;
    1: If Even Then Begin
         If (V And 1) <> 0 Then NesMirror := 0 { horizontal }
                           Else NesMirror := 1; { vertical }
       End;
    2, 3: ; { IRQ scanline non emulee }
  End;
End;

{ Dispatch ecriture mapper. EA est dans $8000-$FFFF. }
Procedure Nes_MapperWrite(EA: Word; V: Byte);
Begin
  Case NesMapper Of
    0: ; { NROM : ignorer }
    1: Nes_M1Write(EA, V);
    2: Nes_M2Write(EA, V);
    4: Nes_M3Write(EA, V);
  End;
End;

{ Initialisation banks selon mapper apres chargement PRG/CHR. }
Procedure Nes_MapperInit;
Var I: Integer;
Begin
  Case NesMapper Of
    0: { NROM : copie deja faite, rien a faire (loader le fait) }
       ;
    1: Begin
         NesM1Shift := 0;
         NesM1ShiftCount := 0;
         NesM1Ctrl := $0C;  { mode PRG=3 par defaut }
         NesM1Chr0 := 0;
         NesM1Chr1 := 0;
         NesM1Prg  := 0;
         Nes_M1ApplyBanks;
       End;
    2: Begin
         Nes_PrgMap16($8000, 0);
         Nes_PrgMap16($C000, NesPrgBlocksTotal - 1);
         { CHR-RAM }
       End;
    4: Begin
         For I := 0 To 7 Do NesM3Banks[I] := 0;
         NesM3BankSelect := 0;
         Nes_M3ApplyBanks;
       End;
  End;
End;

{ Bus NES : lecture MMIO $2000-$401F. Renvoie True si l adresse est }
{ geree par le bus NES (le caller doit alors utiliser ResultByte).   }
Function NesBus_Read(EA: Word; Var ResultByte: Byte): Boolean;
Begin
  NesBus_Read := False;
  If CPU6502_Variant <> 3 Then Exit;
  If (EA >= $2000) And (EA < $4000) Then Begin
    ResultByte := NesPpu_RegRead(Byte(EA And $07));
    NesBus_Read := True;
  End Else If EA = $4014 Then Begin
    ResultByte := 0; NesBus_Read := True;
  End Else If EA = $4015 Then Begin
    ResultByte := 0; NesBus_Read := True; { APU status }
  End Else If EA = $4016 Then Begin
    ResultByte := NesPad_Read(0); NesBus_Read := True;
  End Else If EA = $4017 Then Begin
    ResultByte := NesPad_Read(1); NesBus_Read := True;
  End Else If (EA >= $4000) And (EA <= $4013) Then Begin
    ResultByte := 0; NesBus_Read := True;
  End;
End;

{ Bus NES : ecriture MMIO. Renvoie True si l adresse est geree par le bus. }
Function NesBus_Write(EA: Word; V: Byte): Boolean;
Begin
  NesBus_Write := False;
  If CPU6502_Variant <> 3 Then Exit;
  If EA >= $8000 Then Begin
    Nes_MapperWrite(EA, V);
    NesBus_Write := True;
    Exit;
  End;
  If (EA >= $2000) And (EA < $4000) Then Begin
    NesPpu_RegWrite(Byte(EA And $07), V);
    NesBus_Write := True;
  End Else If EA = $4014 Then Begin
    NesPpu_DmaOam(V);
    NesBus_Write := True;
  End Else If EA = $4016 Then Begin
    NesPad_Write(V);
    NesBus_Write := True;
  End Else If (EA >= $4000) And (EA <= $4017) Then Begin
    { APU silencieuse : on ignore }
    NesBus_Write := True;
  End;
End;

{ Helpers d acces memoire CPU6502 qui passent automatiquement par le }
{ bus NES quand l adresse est dans la plage MMIO. Pour les autres    }
{ adresses, acces direct au tableau CPU6502_Mem.                     }
Function NesMemRead(EA: Word): Byte;
Var Tmp: Byte;
Begin
  If (CPU6502_Variant = 3) And
     (((EA >= $2000) And (EA <= $4017)) Or (EA >= $8000)) Then Begin
    If NesBus_Read(EA, Tmp) Then Begin
      NesMemRead := Tmp;
      Exit;
    End;
  End;
  { C64 : registres CIA1/CIA2 "vivants" (minuteries qui decomptent,       }
  { ICR qui s acquitte a la lecture, clavier lu au travers de PRB) -      }
  { seulement quand l E/S est effectivement visible dans la banque         }
  { courante (voir C64_IoActive) ; sinon CPU6502_Mem reflete deja RAM ou   }
  { le generateur de caracteres via C64_SyncBanks. Les opcodes qui lisent  }
  { $D000-$DFFF sans passer par NesMemRead (CMP/ADC/AND/OR/EOR/BIT en      }
  { adressage indirect - meme lacune deja acceptee pour NES) recoivent un  }
  { instantane fige de CPU6502_Mem plutot que la valeur vivante - limite   }
  { assumee, sans impact sur un demarrage KERNAL/BASIC standard. }
  If (CPU6502_Variant = 1) And (EA >= $DC00) And (EA < $DE00) And
     C64_IoActive Then Begin
    NesMemRead := C64_CiaRead(EA);
    Exit;
  End;
  NesMemRead := CPU6502_Mem[EA];
End;

Procedure NesMemWrite(EA: Word; V: Byte);
Begin
  If (CPU6502_Variant = 3) And
     (((EA >= $2000) And (EA <= $4017)) Or (EA >= $8000)) Then Begin
    If NesBus_Write(EA, V) Then Exit;
  End;
  CPU6502_Mem[EA] := V;
End;

{ ===== C64 : commutation banque $01 + VIC-II/SID/CIA1/CIA2/couleur ==== }

{ E/S visible a $D000-$DFFF ssi (LORAM ou HIRAM) et CHAREN - table       }
{ standard du port CPU 6510, voir le commentaire d en-tete de la          }
{ section Var C64 plus haut pour la table complete des 3 zones. --- }
Function C64_IoActive: Boolean;
Var LoRam, HiRam, Charen: Boolean;
Begin
 LoRam := (C64_Port01 And 1) <> 0;
 HiRam := (C64_Port01 And 2) <> 0;
 Charen := (C64_Port01 And 4) <> 0;
 C64_IoActive := (LoRam Or HiRam) And Charen;
End;

{ Recopie l etat courant des registres CIA1/CIA2/VIC/SID/couleur dans   }
{ CPU6502_Mem[$D000..$DFFF] - necessaire car certains opcodes lisent     }
{ cette plage directement via CPU6502_Mem[EA] sans passer par             }
{ NesMemRead (voir le commentaire dans NesMemRead) - leur donnent au       }
{ moins un instantane coherent plutot que des octets perimes d une       }
{ ancienne banque (RAM ou generateur de caracteres). --- }
Procedure C64_MirrorIoIntoMem;
Var I: Word;
Begin
 For I := 0 To $3FF Do
  CPU6502_Mem[$D000 + I] := C64_VicReg[I And $3F];
 For I := 0 To $3FF Do
  CPU6502_Mem[$D400 + I] := C64_SidReg[I And $1F];
 For I := 0 To $3FF Do
  CPU6502_Mem[$D800 + I] := C64_ColorRam[I] Or $F0;
 For I := 0 To $3FF Do
  CPU6502_Mem[$DC00 + I] := C64_Cia1Reg[I And $0F];
 For I := 0 To $3FF Do
  CPU6502_Mem[$DD00 + I] := C64_Cia2Reg[I And $0F];
 For I := 0 To $1FF Do
  CPU6502_Mem[$DE00 + I] := $FF; { E/S cartouche, aucune cartouche }
End;

{ Charge un fichier ROM Commodore ORIGINAL de taille EXACTE ExpectedSize    }
{ octets dans Buf (typiquement C64_BASIC_ROM/C64_KERNAL_ROM 8192 octets ou  }
{ C64_CHARSET_ROM 4096 octets, voir C64_ApplyRomOption plus bas) - renvoie  }
{ False (et laisse Buf inchange) si le chemin est vide, le fichier n existe }
{ pas/ne peut pas etre ouvert, ou n a pas EXACTEMENT la taille attendue -   }
{ evite de charger silencieusement un fichier tronque/incorrect a une       }
{ adresse memoire ou un dump ROM complet est attendu. }
Function C64_LoadRomFile(Const Path: String; Var Buf; ExpectedSize: LongInt): Boolean;
Var
 F: File;
 NRead: LongInt;
Begin
 C64_LoadRomFile := False;
 If Path = '' Then Exit;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 If FileSize(F) <> ExpectedSize Then Begin
  Close(F);
  Exit;
 End;
 NRead := 0;
 {$I-}
 BlockRead(F, Buf, ExpectedSize, NRead);
 Close(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 C64_LoadRomFile := (NRead = ExpectedSize);
End;

{ Applique le choix de ROM C64 (Options > Emulateur > Commodore 64) aux     }
{ tampons REELLEMENT utilises par l emulation (C64_BASIC_ROM/CHARSET/       }
{ KERNAL, Var - voir plus haut juste apres les constantes _PASCUAL) -       }
{ appelee une fois au demarrage (juste apres LoadOptions, dans le bloc      }
{ principal du programme) et a chaque fois que le dialogue Options est      }
{ confirme (meme si l utilisateur n a pas touche cette page precise :       }
{ operation bon marche, une copie de 20 Ko ou 3 petites lectures fichier).  }
{ Retombe TOUJOURS sur le clone libre Pascual pour toute ROM dont le        }
{ fichier original est absent/invalide - jamais de tampon partiellement     }
{ rempli ou a moitie zero. Note FPC : Move() est utilise plutot que `:=`    }
{ entre C64_BASIC_ROM et C64_BASIC_ROM_PASCUAL car ce sont deux tableaux    }
{ anonymes de MEME forme mais declares separement (Const vs Var) - FPC les  }
{ considere comme des types incompatibles pour une affectation directe      }
{ (meme piege que documente pour tous les autres Snapshot de ce fichier). }
Procedure C64_ApplyRomOption;
Begin
 Move(C64_BASIC_ROM_PASCUAL, C64_BASIC_ROM, SizeOf(C64_BASIC_ROM));
 Move(C64_CHARSET_ROM_PASCUAL, C64_CHARSET_ROM, SizeOf(C64_CHARSET_ROM));
 Move(C64_KERNAL_ROM_PASCUAL, C64_KERNAL_ROM, SizeOf(C64_KERNAL_ROM));
 If OptionsDlg.Data.C64RomOriginal Then Begin
  If Not C64_LoadRomFile(OptionsDlg.Data.C64RomBasicPath, C64_BASIC_ROM,
   SizeOf(C64_BASIC_ROM)) Then
   Move(C64_BASIC_ROM_PASCUAL, C64_BASIC_ROM, SizeOf(C64_BASIC_ROM));
  If Not C64_LoadRomFile(OptionsDlg.Data.C64RomChargenPath, C64_CHARSET_ROM,
   SizeOf(C64_CHARSET_ROM)) Then
   Move(C64_CHARSET_ROM_PASCUAL, C64_CHARSET_ROM, SizeOf(C64_CHARSET_ROM));
  If Not C64_LoadRomFile(OptionsDlg.Data.C64RomKernalPath, C64_KERNAL_ROM,
   SizeOf(C64_KERNAL_ROM)) Then
   Move(C64_KERNAL_ROM_PASCUAL, C64_KERNAL_ROM, SizeOf(C64_KERNAL_ROM));
 End;
End;

{ Reflete la banque materielle courante ($01) dans CPU6502_Mem pour les  }
{ 3 fenetres commutables - a appeler apres tout changement de C64_Port01 }
{ et une fois au demarrage. --- }
Procedure C64_SyncBanks;
Var LoRam, HiRam, Charen: Boolean;
Begin
 LoRam := (C64_Port01 And 1) <> 0;
 HiRam := (C64_Port01 And 2) <> 0;
 Charen := (C64_Port01 And 4) <> 0;
 If LoRam And HiRam Then
  Move(C64_BASIC_ROM, CPU6502_Mem[$A000], SizeOf(C64_BASIC_ROM))
 Else
  Move(C64_HiRam[$A000], CPU6502_Mem[$A000], $2000);
 If (Not LoRam) And (Not HiRam) Then
  Move(C64_HiRam[$D000], CPU6502_Mem[$D000], $1000)
 Else If Not Charen Then
  Move(C64_CHARSET_ROM, CPU6502_Mem[$D000], SizeOf(C64_CHARSET_ROM))
 Else
  C64_MirrorIoIntoMem;
 If HiRam Then
  Move(C64_KERNAL_ROM, CPU6502_Mem[$E000], SizeOf(C64_KERNAL_ROM))
 Else
  Move(C64_HiRam[$E000], CPU6502_Mem[$E000], $2000);
End;

{ Ecriture $DC00-$DCFF (CIA1) - seul registre du chipset avec de vrais   }
{ effets de bord necessaires a un demarrage KERNAL correct : minuteries  }
{ A/B (rechargees si a l arret, ou si le bit de forcage $10 est ecrit    }
{ dans CRA/CRB) et masque d interruption ICR (semantique standard 6526 : }
{ bit7=1 -> positionne les bits indiques du masque, bit7=0 -> les efface).}
Procedure C64_Cia1Write(Reg: Byte; V: Byte);
Begin
 Case Reg Of
  $04: Begin
   C64_Cia1TimerALatch := (C64_Cia1TimerALatch And $FF00) Or V;
   C64_Cia1Reg[Reg] := V;
  End;
  $05: Begin
   C64_Cia1TimerALatch := (C64_Cia1TimerALatch And $00FF) Or (Word(V) Shl 8);
   If (C64_Cia1Reg[$0E] And 1) = 0 Then C64_Cia1TimerA := C64_Cia1TimerALatch;
   C64_Cia1Reg[Reg] := V;
  End;
  $06: Begin
   C64_Cia1TimerBLatch := (C64_Cia1TimerBLatch And $FF00) Or V;
   C64_Cia1Reg[Reg] := V;
  End;
  $07: Begin
   C64_Cia1TimerBLatch := (C64_Cia1TimerBLatch And $00FF) Or (Word(V) Shl 8);
   If (C64_Cia1Reg[$0F] And 1) = 0 Then C64_Cia1TimerB := C64_Cia1TimerBLatch;
   C64_Cia1Reg[Reg] := V;
  End;
  $0D: { ICR : positionne/efface les bits du masque indiques par V And $7F }
   If (V And $80) <> 0 Then
    C64_Cia1IcrMask := C64_Cia1IcrMask Or (V And $7F)
   Else
    C64_Cia1IcrMask := C64_Cia1IcrMask And (Not (V And $7F));
  $0E: Begin
   C64_Cia1Reg[Reg] := V;
   If (V And $10) <> 0 Then C64_Cia1TimerA := C64_Cia1TimerALatch; { forcage }
  End;
  $0F: Begin
   C64_Cia1Reg[Reg] := V;
   If (V And $10) <> 0 Then C64_Cia1TimerB := C64_Cia1TimerBLatch;
  End;
 Else
  C64_Cia1Reg[Reg] := V;
 End;
End;

{ Ecriture $D000-$DFFF quand l E/S est banquee (voir C64_IoActive) - }
{ aiguille vers le sous-systeme concerne, avec mise a jour de           }
{ CPU6502_Mem pour les lectures directes (voir C64_MirrorIoIntoMem). --- }
Procedure C64_IoWrite(Addr: Word; V: Byte);
Var Reg: Byte;
Begin
 If Addr < $D400 Then Begin { VIC-II, miroir tous les $40 octets }
  Reg := Byte(Addr And $3F);
  If Reg = $19 Then Begin { IRQST : ecrire 1 dans un bit L ACQUITTE (efface) }
   C64_VicReg[$19] := C64_VicReg[$19] And (Not V);
   CPU6502_Mem[Addr] := C64_VicReg[$19];
  End Else If Reg <= $2E Then Begin
   C64_VicReg[Reg] := V;
   CPU6502_Mem[Addr] := V;
  End;
 End Else If Addr < $D800 Then Begin { SID, miroir tous les $20 octets }
  Reg := Byte(Addr And $1F);
  If Reg <= $1C Then Begin
   C64_SidReg[Reg] := V;
   CPU6502_Mem[Addr] := V;
  End;
 End Else If Addr < $DC00 Then Begin { RAM couleur, nibble bas seul }
  C64_ColorRam[Addr And $3FF] := V And $0F;
  CPU6502_Mem[Addr] := (V And $0F) Or $F0;
 End Else If Addr < $DD00 Then Begin { CIA1, miroir tous les $10 octets }
  C64_Cia1Write(Byte(Addr And $0F), V);
  CPU6502_Mem[Addr] := C64_Cia1Reg[Byte(Addr And $0F)];
 End Else If Addr < $DE00 Then Begin { CIA2, miroir tous les $10 octets }
  Reg := Byte(Addr And $0F);
  C64_Cia2Reg[Reg] := V;
  CPU6502_Mem[Addr] := V;
 End;
 { $DE00-$DFFF : E/S cartouche, aucune cartouche montee - ignore. }
End;

{ Point d entree unique pour toute ecriture C64 (variant=1), appele    }
{ depuis CPU6502_Write. Gere le port CPU $00/$01 (commutation banque)   }
{ et les 3 fenetres commutables $A000-$BFFF/$D000-$DFFF/$E000-$FFFF -   }
{ voir le commentaire de tete de la section Var C64 pour la table.       }
{ Renvoie True si l ecriture a ete prise en charge ici (l appelant ne    }
{ doit alors PAS faire CPU6502_Mem[Addr]:=V lui-meme). --- }
Function C64_BusWrite(Addr: Word; V: Byte): Boolean;
Var LoRam, HiRam, Charen: Boolean;
Begin
 C64_BusWrite := True;
 If Addr = 0 Then Begin C64_Port00 := V; CPU6502_Mem[0] := V; Exit; End;
 If Addr = 1 Then Begin
  C64_Port01 := V;
  CPU6502_Mem[1] := V;
  C64_SyncBanks;
  Exit;
 End;
 If Addr < $A000 Then Begin
  C64_BusWrite := False; { RAM ordinaire, pas de commutation }
  Exit;
 End;
 LoRam := (C64_Port01 And 1) <> 0;
 HiRam := (C64_Port01 And 2) <> 0;
 Charen := (C64_Port01 And 4) <> 0;
 If Addr < $C000 Then Begin { $A000-$BFFF : BASIC ROM ou RAM banquee }
  C64_HiRam[Addr] := V;
  If Not (LoRam And HiRam) Then CPU6502_Mem[Addr] := V;
  Exit;
 End;
 { BOGUE REEL corrige 2026-08-15 : $C000-$CFFF (le "bloc RAM libre" entre   }
 { la ROM BASIC et l E/S) est TOUJOURS de la RAM ordinaire sur un vrai C64, }
 { QUELLE QUE SOIT la configuration LORAM/HIRAM/CHAREN ($01) - contrairement}
 { a $A000-$BFFF juste au-dessus, jamais banque par une ROM. L ancien code   }
 { traitait a tort cette plage comme faisant partie de $A000-$BFFF (meme    }
 { test `Addr < $D000`), donc une ecriture ici pendant que la ROM BASIC      }
 { etait visible (LoRam Et HiRam, la configuration par defaut au demarrage) }
 { n atteignait JAMAIS `CPU6502_Mem` (seulement le miroir `C64_HiRam`,       }
 { jamais lu par le CPU tant que la banque reste active) - un programme      }
 { charge dans cette plage AVANT la fin du demarrage (voir C64_Boot) restait }
 { donc invisible du CPU, qui y lisait des zeros (BRK immediat des le saut   }
 { d auto-lancement). Trouve en isolant ce bogue via un .PRG de test charge  }
 { volontairement a $C000. }
 If Addr < $D000 Then Begin { $C000-$CFFF }
  C64_HiRam[Addr] := V;
  CPU6502_Mem[Addr] := V;
  Exit;
 End;
 If Addr < $E000 Then Begin { $D000-$DFFF }
  If (Not LoRam) And (Not HiRam) Then Begin { RAM banquee }
   C64_HiRam[Addr] := V;
   CPU6502_Mem[Addr] := V;
  End Else If Not Charen Then Begin { generateur de caracteres visible en  }
   C64_HiRam[Addr] := V;             { lecture, mais la RAM dessous recoit }
  End Else                           { quand meme l ecriture (vrai         }
   C64_IoWrite(Addr, V);             { materiel) ; E/S : aucune RAM dessous}
  Exit;
 End;
 { $E000-$FFFF }
 C64_HiRam[Addr] := V;
 If Not HiRam Then CPU6502_Mem[Addr] := V;
End;

{ Lecture "vivante" $DC00-$DDFF (CIA1/CIA2) - minuteries qui refletent   }
{ leur valeur reelle a l instant present, ICR qui s acquitte a la        }
{ lecture (semantique standard 6526 : bit7 du resultat = OR des sources  }
{ en attente ET activees dans le masque, puis toutes les sources en      }
{ attente sont effacees), PRB qui reflete la matrice clavier selon la    }
{ ligne selectionnee par PRA (voir C64_KeyboardReadPRB). --- }
Function C64_KeyboardReadPRB: Byte;
Var Row, Col: Byte;
 Result8: Byte;
Begin
 Result8 := $FF;
 For Row := 0 To 7 Do
  If (C64_Cia1Reg[$00] And (1 Shl Row)) = 0 Then { ligne selectionnee (active bas) }
   For Col := 0 To 7 Do
    If C64_KeyMatrix[Row, Col] Then
     Result8 := Result8 And (Not (1 Shl Col));
 C64_KeyboardReadPRB := Result8;
End;

Function C64_CiaRead(EA: Word): Byte;
Var Reg: Byte;
 Pend: Byte;
Begin
 If EA < $DD00 Then Begin { CIA1 }
  Reg := Byte(EA And $0F);
  Case Reg Of
   $01: C64_CiaRead := C64_KeyboardReadPRB;
   $04: C64_CiaRead := Byte(C64_Cia1TimerA And $FF);
   $05: C64_CiaRead := Byte(C64_Cia1TimerA Shr 8);
   $06: C64_CiaRead := Byte(C64_Cia1TimerB And $FF);
   $07: C64_CiaRead := Byte(C64_Cia1TimerB Shr 8);
   $0D: Begin
    Pend := C64_Cia1IcrPending And $7F;
    If (Pend And C64_Cia1IcrMask) <> 0 Then Pend := Pend Or $80;
    C64_Cia1IcrPending := 0;
    C64_IrqPending := False;
    C64_CiaRead := Pend;
   End;
  Else
   C64_CiaRead := C64_Cia1Reg[Reg];
  End;
 End Else
  C64_CiaRead := C64_Cia2Reg[Byte(EA And $0F)];
End;

{ Decompte des minuteries CIA1 (appele une fois par instruction executee }
{ avec le nombre de cycles reellement ecoules, CPU6502_LastCyc) - seule   }
{ partie du chipset avec une contrainte de temps reelle : le KERNAL       }
{ initialise le Timer A pour produire l IRQ ~60 Hz (NTSC) / ~50 Hz (PAL)  }
{ qui fait avancer l horloge jiffy et scrute le clavier ; ces valeurs de  }
{ latence viennent du KERNAL lui-meme (poke reel dans $DC04/$DC05/$DC0D  }
{ pendant IOINIT), rien n est code en dur ici. --- }
Procedure C64_TickCia1(Cycles: Integer);
Begin
 If Cycles <= 0 Then Exit;
 If (C64_Cia1Reg[$0E] And 1) <> 0 Then Begin { Timer A demarre }
  If Cycles >= C64_Cia1TimerA Then Begin
   C64_Cia1TimerA := C64_Cia1TimerALatch;
   C64_Cia1IcrPending := C64_Cia1IcrPending Or 1;
   If (C64_Cia1IcrMask And 1) <> 0 Then C64_IrqPending := True;
  End Else
   Dec(C64_Cia1TimerA, Cycles);
 End;
 If (C64_Cia1Reg[$0F] And 1) <> 0 Then Begin { Timer B demarre }
  If Cycles >= C64_Cia1TimerB Then Begin
   C64_Cia1TimerB := C64_Cia1TimerBLatch;
   C64_Cia1IcrPending := C64_Cia1IcrPending Or 2;
   If (C64_Cia1IcrMask And 2) <> 0 Then C64_IrqPending := True;
  End Else
   Dec(C64_Cia1TimerB, Cycles);
 End;
End;

{ Avance le compteur de ligne video reel (~63 cycles/ligne PAL, 312       }
{ lignes/trame) - necessaire car le KERNAL (CINT, initialisation ecran    }
{ au demarrage) attend une VRAIE synchronisation video en scrutant le      }
{ bit 0 de $D019 (IRQST, positionne par le materiel des que la ligne         }
{ courante atteint la ligne de comparaison $D012/bit7 de $D011 - meme      }
{ sans IRQ active, le drapeau materiel se positionne quand meme) : sans     }
{ cette avance, ce bit ne change jamais et le boot reste bloque              }
{ indefiniment dans cette boucle d attente (BOGUE REEL 2026-08-14 signale  }
{ par l utilisateur : "aucun programme ne fonctionne", diagnostique via    }
{ tracage PC - boucle figee a $FF61 attendant $D019). Ecrire 1 dans un       }
{ bit de $D019 l acquitte (l efface), comme le vrai materiel - voir          }
{ C64_IoWrite. --- }
Procedure C64_TickVic(Cycles: Integer);
Var CmpLine: Word;
Begin
 If Cycles <= 0 Then Exit;
 Inc(C64_RasterAcc, Cycles);
 While C64_RasterAcc >= 63 Do Begin
  Dec(C64_RasterAcc, 63);
  Inc(C64_RasterLine);
  If C64_RasterLine >= 312 Then C64_RasterLine := 0;
  { $D012 (bits 0-7) et le bit 7 de $D011 (bit 8) refletent TOUJOURS la   }
  { ligne video REELLE en cours pour la LECTURE - meme registre que la    }
  { valeur de comparaison ECRITE par le programme (utilisee plus bas pour }
  { savoir quand positionner l IRQ raster), role different en lecture/     }
  { ecriture sur le vrai VIC-II. BOGUE REEL 2026-08-14 (signale par          }
  { l utilisateur "aucun programme ne fonctionne") : cette distinction       }
  { manquait completement - $D012 en lecture montrait la valeur de              }
  { comparaison figee au lieu de la position reelle, bloquant             }
  { indefiniment toute boucle "LDA $D012 / BNE" d attente de trame (dont     }
  { celle du KERNAL lui-meme pendant CINT, l initialisation ecran au           }
  { demarrage). }
  If C64_IoActive Then Begin
   CPU6502_Mem[$D012] := Byte(C64_RasterLine And $FF);
   CPU6502_Mem[$D011] := (C64_VicReg[$11] And $7F) Or
    Byte((C64_RasterLine Shr 1) And $80);
  End;
  CmpLine := C64_VicReg[$12];
  If (C64_VicReg[$11] And $80) <> 0 Then CmpLine := CmpLine Or $100;
  If C64_RasterLine = CmpLine Then Begin
   C64_VicReg[$19] := C64_VicReg[$19] Or 1;
   { $D019 est lu par certains opcodes (LDA/CMP/etc. absolu) directement    }
   { via CPU6502_Mem sans passer par un bus - le tenir a jour ici aussi,    }
   { mais seulement si l E/S est bien la fenetre actuellement visible a     }
   { cette adresse (sinon CPU6502_Mem y montre a juste titre la RAM ou le   }
   { generateur de caracteres banque, pas le registre VIC). }
   If C64_IoActive Then CPU6502_Mem[$D019] := C64_VicReg[$19];
   If (C64_VicReg[$1A] And 1) <> 0 Then C64_IrqPending := True;
  End;
 End;
End;

{ Lecture memoire du point de vue du VIC-II : contrairement au CPU, le  }
{ VIC lit toujours la RAM physique reelle, jamais une ROM commutee par   }
{ le port $01 (le VIC n a pas connaissance de la commutation banque du   }
{ CPU - c est une puce separee sur le meme bus memoire). Pour $A000+,    }
{ on lit donc C64_HiRam (la RAM "sous" les ROM) plutot que CPU6502_Mem   }
{ (qui peut actuellement montrer BASIC/E-S/KERNAL pour le CPU). --- }
Function C64_VicRead(Addr: Word): Byte;
Begin
 If Addr >= $A000 Then C64_VicRead := C64_HiRam[Addr]
 Else C64_VicRead := CPU6502_Mem[Addr];
End;

{ Code ecran (POKE dans la RAM ecran) -> caractere affichable ASCII -    }
{ numerotation DIFFERENTE du PETSCII utilise en memoire pour le texte    }
{ (CHROUT etc.) : 0=@, 1-26=A-Z, 27-31=symboles, 32-63=identique a       }
{ ASCII (espace, ponctuation, chiffres), 64-127=caracteres graphiques    }
{ PETSCII sans equivalent ASCII (rendus par un espace, limite assumee -  }
{ ce codebase ne fait pas de rendu pixel du generateur de caracteres,    }
{ voir C64_RenderFrame). Bit 7 = video inverse, traite a part par        }
{ l appelant. --- }
Function C64_ScreenCodeToChar(SC: Byte): Char;
Var Base: Byte;
Begin
 Base := SC And $7F;
 If Base = 0 Then C64_ScreenCodeToChar := '@'
 Else If (Base >= 1) And (Base <= 26) Then
  C64_ScreenCodeToChar := Chr(Ord('A') + Base - 1)
 Else If Base = 27 Then C64_ScreenCodeToChar := '['
 Else If Base = 28 Then C64_ScreenCodeToChar := '$'  { livre sterling approximee }
 Else If Base = 29 Then C64_ScreenCodeToChar := ']'
 Else If Base = 30 Then C64_ScreenCodeToChar := '^'
 Else If Base = 31 Then C64_ScreenCodeToChar := '<'  { fleche gauche approximee }
 Else If (Base >= 32) And (Base <= 63) Then C64_ScreenCodeToChar := Chr(Base)
 Else C64_ScreenCodeToChar := ' '; { caracteres graphiques PETSCII }
End;

{ Rendu VIC-II mode texte (40x25 uniquement - pas de bitmap/multicolore/ }
{ ecran etendu) : lit la RAM ecran (bloc de 1000 octets a l interieur de }
{ la banque VIC courante, choisie par CIA2 PRA bits 0-1 inverses, et      }
{ decalee par VIC $D018 bits 4-7) et la RAM couleur (toujours fixe a     }
{ $D800-$DBFF, independante de la banque) directement dans P.VRAM -      }
{ meme cellules texte que EmuVScr_PutChar, pas de rendu pixel du            }
{ generateur de caracteres (voir C64_ScreenCodeToChar). Appele une fois  }
{ par trame emulee depuis la boucle C64 (voir ShowEmulatorPanel). --- }
Procedure C64_RenderFrame(Var P: TEmulatorPanel);
Var
 VicBankBase, ScreenBase: Word;
 Row, Col: Byte;
 SC, ColNib, Bg: Byte;
Begin
 VicBankBase := (3 - (C64_Cia2Reg[0] And 3)) * $4000;
 ScreenBase := VicBankBase + (((C64_VicReg[$18] Shr 4) And $0F) * $400);
 Bg := C64_PalToEga[C64_VicReg[$21] And $0F];
 For Row := 0 To 24 Do
  For Col := 0 To 39 Do Begin
   SC := C64_VicRead(Word(ScreenBase + Word(Row) * 40 + Col));
   ColNib := C64_ColorRam[Word(Row) * 40 + Col] And $0F;
   P.VRAM[Row, Col].Ch := C64_ScreenCodeToChar(SC);
   If (SC And $80) <> 0 Then Begin { video inverse }
    P.VRAM[Row, Col].Fg := Bg;
    P.VRAM[Row, Col].Bg := C64_PalToEga[ColNib];
   End Else Begin
    P.VRAM[Row, Col].Fg := C64_PalToEga[ColNib];
    P.VRAM[Row, Col].Bg := Bg;
   End;
  End;
 P.NeedRepaint := True;
End;

{ Demarrage materiel reel du C64 : place la banque par defaut ($37 =    }
{ LORAM=HIRAM=CHAREN=1, BASIC+E-S+KERNAL visibles, comme a la mise sous  }
{ tension), charge le fichier .PRG demande a son adresse de chargement    }
{ (octet par octet via CPU6502_Write pour respecter la commutation           }
{ banque courante, au cas ou l adresse tomberait dans une fenetre         }
{ commutee), ajuste les pointeurs BASIC (VARTAB/ARYTAB/STREND, $2D-$32)   }
{ si le fichier se charge a $0801 (convention standard), puis PRE-        }
{ REMPLIT le tampon clavier avec "RUN"+Entree (fichier BASIC ou stub SYS  }
{ classique charge a $0801) ou "SYS <adresse>"+Entree (code machine pur   }
{ a une autre adresse, convention historique C64 authentique) - le        }
{ KERNAL trouvera ces caracteres deja en attente des qu il en demandera  }
{ au clavier, exactement comme si l utilisateur les avait tapes juste     }
{ apres la mise sous tension, sans qu aucune scrutation de matrice ne     }
{ soit necessaire pour cette injection precise. Renvoie dans EntryAddr    }
{ le vrai vecteur RESET du KERNAL ($FFFC/$FFFD) - le demarrage passe       }
{ TOUJOURS par le vrai code KERNAL/BASIC desormais, plus par le             }
{ raccourci "sauter directement au .PRG" d avant cette fonction. --- }
Function C64_Boot(Const BinaryPath: String; Var EntryAddr: Word): Boolean;
Var
 F: File;
 Hdr: Array[0..1] Of Byte;
 LoadAddr, Addr: Word;
 B: Byte;
 BR: Word;
 InjectStr: String;
Begin
 C64_Boot := False;
 FillChar(C64_HiRam, SizeOf(C64_HiRam), 0);
 FillChar(C64_VicReg, SizeOf(C64_VicReg), 0);
 FillChar(C64_SidReg, SizeOf(C64_SidReg), 0);
 FillChar(C64_ColorRam, SizeOf(C64_ColorRam), 0);
 FillChar(C64_Cia1Reg, SizeOf(C64_Cia1Reg), 0);
 FillChar(C64_Cia2Reg, SizeOf(C64_Cia2Reg), $FF); { PRA/PRB au repos = 1, comme le vrai materiel }
 FillChar(C64_KeyMatrix, SizeOf(C64_KeyMatrix), False);
 C64_Cia1TimerA := $FFFF; C64_Cia1TimerALatch := $FFFF;
 C64_Cia1TimerB := $FFFF; C64_Cia1TimerBLatch := $FFFF;
 C64_Cia1IcrMask := 0; C64_Cia1IcrPending := 0;
 C64_IrqPending := False;
 C64_FrameNo := 0;
 C64_RasterLine := 0;
 C64_RasterAcc := 0;
 C64_PendingInject := '';
 C64_PendingVartab := 0;
 C64_PendingJumpPC := 0;
 C64_PendingJumpTimeout := 0;
 C64_PendingInjectFallback := '';
 C64_PendingPrgLen := 0;
 C64_TypeIdx := 0;
 C64_TypeCounter := 0;
 C64_TypePressed := False;
 C64_Port00 := $2F;
 C64_Port01 := $37;
 C64_SyncBanks;
 { BOGUE REEL (2026-08-29) signale par l utilisateur : la commande        }
 { Terminal "C64" SANS nom de fichier ("tombe dans le BASIC en ROM")      }
 { echouait completement - `Assign(F,'')` + `Reset` sur un chemin vide     }
 { retourne toujours IOResult<>0, ce qui faisait `Exit` ICI, AVANT la      }
 { lecture du VRAI vecteur RESET du KERNAL ($FFFC/$FFFD, tout en bas de   }
 { cette fonction) - la machine ne demarrait donc jamais du tout (PC      }
 { reste a 0, jamais mis a jour) au lieu d afficher la banniere BASIC       }
 { authentique et REALDY. comme le ferait un vrai C64 sans disquette       }
 { inseree. Isole desormais tout le chargement de fichier (et l injection }
 { RUN/SYS qui n a de sens que s il y a reellement un programme) dans ce   }
 { `If BinaryPath <> '' Then Begin...End` - la lecture du vecteur RESET     }
 { reste, elle, INCONDITIONNELLE (toujours executee, fichier ou non). }
 If BinaryPath <> '' Then Begin
  Assign(F, BinaryPath);
  {$I-} Reset(F, 1); {$I+}
  If IOResult <> 0 Then Exit;
  BlockRead(F, Hdr, 2, BR);
  If BR <> 2 Then Begin Close(F); Exit; End;
  LoadAddr := Hdr[0] Or (Word(Hdr[1]) Shl 8);
  Addr := LoadAddr;
  C64_PendingPrgLoadAddr := LoadAddr;
  While Not Eof(F) Do Begin
   BlockRead(F, B, 1, BR);
   If BR = 1 Then Begin
    CPU6502_Write(Addr, B);
    { Garder aussi une copie brute pour C64_ReplayPendingPrg (voir plus bas  }
    { et le commentaire pres de C64_PendingPrgData) - le rejeu se fait juste }
    { avant l execution reelle, pour survivre a un eventuel nettoyage de     }
    { cette meme zone memoire par le demarrage KERNAL lui-meme. }
    If C64_PendingPrgLen <= High(C64_PendingPrgData) Then Begin
     C64_PendingPrgData[C64_PendingPrgLen] := B;
     Inc(C64_PendingPrgLen);
    End;
    If Addr < $FFFF Then Inc(Addr) Else Break;
   End;
  End;
  Close(F);
  { Point d entree apres le demarrage : PRIORITE au saut direct (fiable,   }
  { deterministe) quand le fichier suit la convention standard "10 SYS     }
  { xxxx" (stub BASIC de 12 octets a $0801, ligne+numero+token SYS $9E,    }
  { toujours suivi du code machine a $080D - vrai pour la quasi-totalite   }
  { des .PRG langage machine reels) ou charge directement en langage        }
  { machine pur (adresse <> $0801). Reserve a "taper RUN au clavier"        }
  { (moins fiable - voir C64_ApplyAutoType, BOGUE REEL 2026-08-14 :          }
  { CHRIN/l editeur ecran du KERNAL ne lit PAS simplement le tampon           }
  { clavier bas niveau, la simulation de frappe ne s est pas averee            }
  { fiable a 100% pendant la mise au point) le seul cas ou aucune adresse    }
  { d entree fiable n existe : un vrai programme BASIC tokenise SANS           }
  { stub SYS, ou un fichier $0801 avec un stub non standard. }
  { Repli "frappe simulee" (2026-08-15) : voir C64_RunOneFrame et le           }
  { commentaire pres de C64_PendingJumpTimeout - arme un texte de repli        }
  { PRET A DEMARRER si le saut direct n a jamais atteint $E5CD apres 600       }
  { trames (~12s a 50 Hz, largement superieur au demarrage KERNAL le plus       }
  { lent observe - marge volontairement genereuse). Sans effet pour le          }
  { KERNAL Commodore ORIGINAL (le saut se declenche bien avant), necessaire     }
  { pour toute ROM tierce dont la mise en page interne ne passe jamais par      }
  { $E5CD (ex. Pascual's BASIC). }
  If LoadAddr <> $0801 Then Begin
   C64_PendingJumpPC := LoadAddr;
   C64_PendingVartab := 0;
   C64_PendingJumpTimeout := 600;
   C64_PendingInjectFallback := 'SYS' + IntToStr(LoadAddr) + Chr(13);
  End Else If CPU6502_Mem[$0805] = $9E Then Begin
   C64_PendingJumpPC := $080D; { convention standard "10 SYS 2061" }
   C64_PendingVartab := Addr;
   C64_PendingJumpTimeout := 600;
   C64_PendingInjectFallback := 'RUN' + Chr(13);
  End Else Begin
   C64_PendingJumpPC := 0;
   C64_PendingJumpTimeout := 0;
   C64_PendingVartab := Addr;
   InjectStr := 'RUN' + Chr(13);
   If Length(InjectStr) > 10 Then InjectStr := Copy(InjectStr, 1, 10);
   C64_PendingInject := InjectStr;
  End;
 End;
 { Vecteur RESET du KERNAL - INCONDITIONNEL (voir commentaire ci-dessus) : }
 { avec ou sans programme, c est ce qui fait reellement demarrer la        }
 { machine (banniere BASIC authentique + READY. si BinaryPath est vide). }
 EntryAddr := CPU6502_Mem[$FFFC] Or (Word(CPU6502_Mem[$FFFD]) Shl 8);
 C64_Boot := True;
End;

{ Rejoue en memoire les octets bruts du .PRG charge par C64_Boot (voir le   }
{ commentaire pres de C64_PendingPrgData) - a appeler juste AVANT le saut    }
{ direct ($E5CD) ou juste avant le debut de la frappe de repli              }
{ ("SYS <adresse>"/"RUN"), jamais avant, pour survivre a un eventuel          }
{ nettoyage de cette meme zone memoire par le demarrage KERNAL lui-meme      }
{ (BOGUE REEL trouve en testant Pascual's BASIC : le programme charge        }
{ pouvait se retrouver partiellement efface au moment de l executer,         }
{ que ce soit en haute memoire - $C000-$CFFF, deja corrige separement dans   }
{ C64_BusWrite - ou en zone BASIC basse - $0801+, "NEW" implicite au         }
{ demarrage). Idempotent (peut etre appelee plusieurs fois sans effet de     }
{ bord) et se desarme elle-meme (C64_PendingPrgLen:=0) apres le premier       }
{ rejeu, puisqu il n y a plus besoin de rejouer une fois l execution reelle   }
{ commencee (le programme lui-meme peut legitimement modifier sa propre       }
{ zone memoire ensuite - un second rejeu ecraserait ces changements). }
Procedure C64_ReplayPendingPrg;
Var
 I: LongInt;
Begin
 If C64_PendingPrgLen <= 0 Then Exit;
 For I := 0 To C64_PendingPrgLen - 1 Do
  CPU6502_Write(Word(C64_PendingPrgLoadAddr + I), C64_PendingPrgData[I]);
 C64_PendingPrgLen := 0;
End;

{ ===== Atari 2600 : TIA + RIOT minimaux ============================ }

{ Palette NTSC 2600 -> EGA 16 couleurs. La couleur 2600 est encodee  }
{ par octet : bits 4-7 = teinte (16), bits 1-3 = luminance (8).      }
Function A2600_ColorToEga(C: Byte): Byte;
Const
  Tbl: Array[0..15] Of Array[0..7] Of Byte = (
   (0,  8,  8,  7,  7,  7, 15, 15),  { 0 gris            }
   (0,  6,  6, 14, 14, 14, 14, 15),  { 1 or              }
   (0,  6,  6, 14, 14, 14, 11, 15),  { 2 orange clair    }
   (0,  4,  4, 12, 12, 12, 14, 15),  { 3 rouge orange    }
   (0,  4,  4, 12, 12, 12, 13, 15),  { 4 rose-rouge      }
   (0,  5,  5, 13, 13, 13, 13, 15),  { 5 violet          }
   (0,  5,  1, 13, 13,  9,  9, 15),  { 6 bleu violet     }
   (0,  1,  1,  9,  9,  9,  9, 15),  { 7 bleu            }
   (0,  1,  1,  9,  9,  9, 11, 15),  { 8 bleu            }
   (0,  3,  3, 11, 11, 11, 11, 15),  { 9 cyan            }
   (0,  2,  3, 10, 11, 11, 11, 15),  { A turquoise       }
   (0,  2,  2, 10, 10, 10, 10, 15),  { B vert            }
   (0,  2,  2, 10, 10, 14, 14, 15),  { C vert jaune      }
   (0,  6,  6, 14, 14, 14, 14, 15),  { D jaune           }
   (0,  6,  6, 14, 14, 14, 11, 15),  { E orange          }
   (0,  5,  5, 13, 13, 13, 13, 15)   { F rose            }
  );
Begin
  A2600_ColorToEga := Tbl[(C Shr 4) And $0F, (C Shr 1) And $07];
End;

{ Hook d ecriture pour cible 2600 (variant=4). Renvoie True si       }
{ l adresse est consommee par TIA/RIOT et doit court-circuiter le    }
{ stockage standard. Sinon stocke normalement.                        }

{ Bankswitching F8/F6/F4 : copie la banque demandee dans $F000-$FFFF. }
Procedure A2600_BankSwitch(NewBank: Integer);
Var I: LongInt; Src: LongInt; Alias: LongInt; B: Byte;
Begin
  If (NewBank < 0) Or (NewBank >= A2600_BankCnt) Then Exit;
  If NewBank = A2600_CurBank Then Exit;
  A2600_CurBank := NewBank;
  Src := LongInt(NewBank) * 4096;
  { Bus 13 bits du 6507 : ROM mirroree dans $1000,$3000,$5000,...$F000. }
  { On copie la banque dans les 8 alias pour que les lectures directes  }
  { (PC, EA absolu) fonctionnent quel que soit le miroir utilise.       }
  For I := 0 To 4095 Do Begin
    B := A2600_ROM[Src + I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
  End;
End;

{ E0 Parker Bros (8K) : 4 slots de 1K dans $1000/$1400/$1800/$1C00.    }
{ Hotspots $1FE0..$1FE7 = slot 0, $1FE8..$1FEF = slot 1, etc.          }
{ Slot 3 ($1C00-$1FFF) fixe a la derniere banque (7).                  }
Procedure A2600_E0RebuildSlot(SlotIdx, BankIdx: Integer);
Var I, Alias: LongInt; Off: LongInt; B: Byte;
Begin
  If (SlotIdx < 0) Or (SlotIdx > 3) Then Exit;
  If (BankIdx < 0) Or (BankIdx > 7) Then Exit;
  Off := LongInt(BankIdx) * 1024;
  For I := 0 To 1023 Do Begin
    B := A2600_ROM[Off + I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1000 + (SlotIdx * 1024) + I] := B;
  End;
End;

{ E7 M-Network (16K + RAM) : 8 banques ROM 2K dans $1000-$17FF,        }
{ 1K RAM optionnelle ($1000-$13FF write / $1400-$17FF read) selectee   }
{ par $FE7. Upper 2K ($1800-$1FFF) fixe a la derniere banque, sauf     }
{ $1800-$19FF qui shadow 4x256 octets RAM (write $1800-$18FF, read     }
{ $1900-$19FF) avec banque selectee par $FE8-$FEB.                     }
Procedure A2600_E7_RebuildLower;
Var I, Alias: LongInt; Off: LongInt; B: Byte;
Begin
  If A2600_E7_LowerRAM Then Begin
    For I := 0 To 2047 Do Begin
      B := A2600_E7_RAM1K[I And $3FF];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
    End;
  End Else Begin
    Off := LongInt(A2600_E7_LowerROM) * 2048;
    For I := 0 To 2047 Do Begin
      B := A2600_ROM[Off + I];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
    End;
  End;
End;

Procedure A2600_E7_RebuildUpper;
Var I, Alias: LongInt; B: Byte;
Begin
  For I := 0 To 2047 Do Begin
    B := A2600_ROM[7 * 2048 + I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1800 + I] := B;
  End;
End;

{ 3E (Andrew Davie) : slot bas $1000-$17FF = 2K ROM ou 1K RAM.            }
{ En mode RAM, $1000-$13FF est la fenetre de lecture, $1400-$17FF est la }
{ fenetre d ecriture (meme bloc 1K). Hotspots $003E (RAM) et $003F (ROM).}
Procedure A2600_3E_RebuildLower;
Var I, Alias: LongInt; Off: LongInt; B: Byte;
Begin
  If A2600_3E_RAMMode Then Begin
    Off := LongInt(A2600_3E_LowerRAM) * 1024;
    { Read window $1000-$13FF : 1K RAM. }
    For I := 0 To 1023 Do Begin
      B := A2600_3E_RAM[(Off + I) And $7FFF];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
    End;
    { Write window $1400-$17FF : intercepte par BusWrite, mais on mappe   }
    { la meme RAM pour les lectures eventuelles (Stella renvoie souvent  }
    { la valeur RAM, pas du garbage).                                     }
    For I := 0 To 1023 Do Begin
      B := A2600_3E_RAM[(Off + I) And $7FFF];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + $1400 + I] := B;
    End;
  End Else Begin
    Off := LongInt(A2600_3E_LowerROM) * 2048;
    For I := 0 To 2047 Do Begin
      If (Off + I) < A2600_ROMSize Then B := A2600_ROM[Off + I]
      Else B := $FF;
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
    End;
  End;
End;

Procedure A2600_3E_RebuildUpper;
Var I, Alias: LongInt; Off: LongInt; B: Byte;
Begin
  { Slot haut $1800-$1FFF : derniere banque 2K ROM fixe. }
  If A2600_BankCnt < 1 Then Exit;
  Off := LongInt(A2600_BankCnt - 1) * 2048;
  For I := 0 To 2047 Do Begin
    If (Off + I) < A2600_ROMSize Then B := A2600_ROM[Off + I]
    Else B := $FF;
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1800 + I] := B;
  End;
End;

{ 3E+ : reconstruit le slot SlotIdx (0..3) selon son etat ROM/RAM.       }
{ Slot s couvre $1000 + s*$400 .. $1000 + s*$400 + $3FF (1024 octets).   }
{ Banques ROM : 1024 octets. Banques RAM : 512 octets (read = moitie     }
{ basse $400 du slot, write = moitie haute $200..$3FF).                  }
Procedure A2600_3EP_RebuildSlot(SlotIdx: Integer);
Var I, Alias: LongInt; Off: LongInt; B: Byte; Base: LongInt;
Begin
  If (SlotIdx < 0) Or (SlotIdx > 3) Then Exit;
  Base := $1000 + LongInt(SlotIdx) * $0400;
  If A2600_3EP_SlotIsRAM[SlotIdx] Then Begin
    Off := LongInt(A2600_3EP_SlotBank[SlotIdx]) * 512;
    { Read window : moitie basse du slot (512 octets). }
    For I := 0 To 511 Do Begin
      B := A2600_3E_RAM[(Off + I) And $7FFF];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + Base + I] := B;
    End;
    { Write window : moitie haute, miroir RAM cote shadow. }
    For I := 0 To 511 Do Begin
      B := A2600_3E_RAM[(Off + I) And $7FFF];
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + Base + 512 + I] := B;
    End;
  End Else Begin
    Off := LongInt(A2600_3EP_SlotBank[SlotIdx]) * 1024;
    For I := 0 To 1023 Do Begin
      If (Off + I) < A2600_ROMSize Then B := A2600_ROM[Off + I]
      Else B := $FF;
      For Alias := 0 To 7 Do
        CPU6502_Mem[(Alias * $2000) + Base + I] := B;
    End;
  End;
End;

{ AR/SuperCharger : reconstruit les 2 slices ($1000-$17FF et $1800-$1FFF) }
{ depuis A2600_SC_RAM (banques 0..2) ou A2600_SC_BIOS selon la config.    }
{ Table de configuration : indice = (A2600_SC_Cfg Shr 2) And 7.            }
{ Valeurs 0..2 = banque RAM 2K, 3 = BIOS 2K (stub).                       }
Procedure A2600_SC_Rebuild;
Const
  { (slice 0 source, slice 1 source). 0..2 = banque RAM, 3 = BIOS. }
  SCCfgTab: Array[0..7, 0..1] Of Byte = (
    (2, 3), (0, 3), (2, 0), (0, 2),
    (2, 3), (1, 3), (2, 1), (1, 2));
Var I, Alias: LongInt; B: Byte; CfgIdx: Integer; Src: Byte;
    Off0, Off1: LongInt;
Begin
  CfgIdx := (A2600_SC_Cfg Shr 2) And 7;
  Src := SCCfgTab[CfgIdx, 0];
  If Src < 3 Then Off0 := LongInt(Src) * 2048 Else Off0 := -1;
  Src := SCCfgTab[CfgIdx, 1];
  If Src < 3 Then Off1 := LongInt(Src) * 2048 Else Off1 := -1;
  { Slice 0 : $1000-$17FF. }
  For I := 0 To 2047 Do Begin
    If Off0 >= 0 Then B := A2600_SC_RAM[Off0 + I]
    Else B := A2600_SC_BIOS[I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
  End;
  { Slice 1 : $1800-$1FFF. }
  For I := 0 To 2047 Do Begin
    If Off1 >= 0 Then B := A2600_SC_RAM[Off1 + I]
    Else B := A2600_SC_BIOS[I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1800 + I] := B;
  End;
End;

{ Latche une nouvelle configuration SuperCharger (acces $1FF8/$1FF9). }
Procedure A2600_SC_SetConfig(NewCfg: Byte);
Begin
  A2600_SC_Cfg := NewCfg;
  A2600_SC_WrEn := (NewCfg And $02) <> 0;
  A2600_SC_Rebuild;
End;

{ 3F Tigervision (8K) : banque 0..2 dans $1000-$17FF, derniere banque  }
{ ($1800-$1FFF) fixe. Commute sur ecriture a $0000-$003F.              }
Procedure A2600_TigerSwitch(NewBank: Integer);
Var I, Alias: LongInt; Off: LongInt; B: Byte;
Begin
  If A2600_BankCnt < 2 Then Exit;
  NewBank := NewBank And (A2600_BankCnt - 1);
  A2600_TigerBank := NewBank;
  Off := LongInt(NewBank) * 2048;
  For I := 0 To 2047 Do Begin
    B := A2600_ROM[Off + I];
    For Alias := 0 To 7 Do
      CPU6502_Mem[(Alias * $2000) + $1000 + I] := B;
  End;
End;

{ Verifie un acces (R/W) sur un hotspot et commute la banque. }
Procedure A2600_CheckHotspot(EA: Word);
Var Lo: Word;
Begin
  Lo := EA And $0FFF;
  Case A2600_Scheme Of
    1, 4: Begin { F8 / F8SC : 2 banques, $FFF8/$FFF9 }
      If Lo = $FF8 Then A2600_BankSwitch(0)
      Else If Lo = $FF9 Then A2600_BankSwitch(1);
    End;
    2, 5: Begin { F6 / F6SC : 4 banques }
      If (Lo >= $FF6) And (Lo <= $FF9) Then
        A2600_BankSwitch(Lo - $FF6);
    End;
    3, 6: Begin { F4 / F4SC }
      If (Lo >= $FF4) And (Lo <= $FFB) Then
        A2600_BankSwitch(Lo - $FF4);
    End;
    7: Begin { FA CBS RAM Plus : 12K, 3 banques, $FFF8..$FFFA }
      If (Lo >= $FF8) And (Lo <= $FFA) Then
        A2600_BankSwitch(Lo - $FF8);
    End;
    8: Begin { FE Decathlon : 2 banques, declenche par valeur sur la pile }
      { Approximation : on commute sur lecture $01FE/$01FF du flux JSR }
      If (EA = $01FE) Or (EA = $01FF) Then
        A2600_BankSwitch(CPU6502_Mem[$01FE] Shr 5);
    End;
    9: Begin { E0 Parker : hotspots $FE0..$FF7 }
      If (Lo >= $FE0) And (Lo <= $FE7) Then Begin
        A2600_E0Slot[0] := Lo - $FE0;
        A2600_E0RebuildSlot(0, A2600_E0Slot[0]);
      End Else If (Lo >= $FE8) And (Lo <= $FEF) Then Begin
        A2600_E0Slot[1] := Lo - $FE8;
        A2600_E0RebuildSlot(1, A2600_E0Slot[1]);
      End Else If (Lo >= $FF0) And (Lo <= $FF7) Then Begin
        A2600_E0Slot[2] := Lo - $FF0;
        A2600_E0RebuildSlot(2, A2600_E0Slot[2]);
      End;
    End;
    11: Begin { E7 M-Network }
      If (Lo >= $FE0) And (Lo <= $FE6) Then Begin
        A2600_E7_LowerRAM := False;
        A2600_E7_LowerROM := Lo - $FE0;
        A2600_E7_RebuildLower;
      End Else If Lo = $FE7 Then Begin
        A2600_E7_LowerRAM := True;
        A2600_E7_RebuildLower;
      End Else If (Lo >= $FE8) And (Lo <= $FEB) Then Begin
        A2600_E7_R256Bank := Lo - $FE8;
      End;
    End;
    14: Begin { AR/SuperCharger : $1FF8 = bank config, $1FF9 = ROM enable }
      If Lo = $FF8 Then
        A2600_SC_SetConfig(CPU6502_DataBus)
      Else If Lo = $FF9 Then Begin
        { $1FF9 force BIOS visible (utilise par le loader hardware). On  }
        { applique en mettant bits D4-D2 a 0 + bit D1 inchange.           }
        A2600_SC_SetConfig(A2600_SC_Cfg And $03);
      End;
    End;
  End;
  If (A2600_Scheme = 0) And (A2600_BankCnt > 1) Then Begin
    { Repli sur taille (legacy auto-detection) }
    Case A2600_BankCnt Of
      2: If Lo = $FF8 Then A2600_BankSwitch(0)
         Else If Lo = $FF9 Then A2600_BankSwitch(1);
      4: If (Lo >= $FF6) And (Lo <= $FF9) Then
           A2600_BankSwitch(Lo - $FF6);
      8: If (Lo >= $FF4) And (Lo <= $FFB) Then
           A2600_BankSwitch(Lo - $FF4);
    End;
  End;
End;

Procedure A2600_BusWrite(EA: Word; V: Byte);
Var
  R: Byte;
  CurX, BeamX: Integer;
  Lo: Word;
  I: Integer;
Begin
  { Le 6507 a un bus 13 bits. ROM = bit12 set ($1000-$1FFF, miroir   }
  { en haut). TIA = bit12=0 et bit7=0 ($0000-$007F + miroirs).       }
  { RIOT RAM = bit12=0 et bit7=1, bit9=0 ($0080-$00FF).              }
  { RIOT I/O/timer = bit12=0 et bit9=1 ($0280-$029F).                }
  If (EA And $1000) <> 0 Then Begin
    Lo := EA And $0FFF;
    { RAM cartouche F8SC/F6SC/F4SC : $1000-$107F write, $1080-$10FF read }
    If ((A2600_Scheme = 4) Or (A2600_Scheme = 5) Or (A2600_Scheme = 6))
       And (Lo <= $7F) Then Begin
      A2600_CartRAM[Lo] := V;
      Exit;
    End;
    { SuperCharger : ecriture mappee dans la banque RAM courante du slice. }
    { Slice 0 = $1000-$17FF (Lo<=$7FF), slice 1 = $1800-$1FFF (Lo>=$800).  }
    { Write enable doit etre actif (Cfg bit 1).                            }
    If (A2600_Scheme = 14) And A2600_SC_WrEn Then Begin
      I := (A2600_SC_Cfg Shr 2) And 7;
      If Lo < $800 Then Begin
        { Slice 0 banque : selon SCCfgTab[I, 0]. Repli sur RAM si BIOS.    }
        Case I Of
          0, 4: I := 2;     { (2,3) (2,3)  }
          1:    I := 0;     { (0,3)        }
          2:    I := 2;     { (2,0)        }
          3:    I := 0;     { (0,2)        }
          5:    I := 1;     { (1,3)        }
          6:    I := 2;     { (2,1)        }
          7:    I := 1;     { (1,2)        }
        End;
        If I < 3 Then Begin
          A2600_SC_RAM[(I * 2048) + Lo] := V;
          For BeamX := 0 To 7 Do
            CPU6502_Mem[(BeamX * $2000) + $1000 + Lo] := V;
        End;
      End Else Begin
        Case I Of
          2:    I := 0;     { (2,0)        }
          3:    I := 2;     { (0,2)        }
          5:    I := 1;     { (1,3)        }
          6:    I := 1;     { (2,1)        }
          7:    I := 2;     { (1,2)        }
        Else I := 99;       { destination BIOS -> ignore }
        End;
        If I < 3 Then Begin
          A2600_SC_RAM[(I * 2048) + (Lo - $800)] := V;
          For BeamX := 0 To 7 Do
            CPU6502_Mem[(BeamX * $2000) + $1800 + (Lo - $800)] := V;
        End;
      End;
      A2600_CheckHotspot(EA);
      Exit;
    End;
    { FA CBS RAM Plus : $1000-$10FF write, $1100-$11FF read (256 octets) }
    If (A2600_Scheme = 7) And (Lo <= $FF) Then Begin
      A2600_CartRAM[Lo] := V;
      Exit;
    End;
    { E7 M-Network : RAM 1K en lower si LowerRAM ($1000-$13FF write) }
    If (A2600_Scheme = 11) And A2600_E7_LowerRAM And (Lo <= $3FF) Then Begin
      A2600_E7_RAM1K[Lo] := V;
      Exit;
    End;
    { E7 M-Network : RAM 256B en $1800-$18FF write }
    If (A2600_Scheme = 11) And (Lo >= $800) And (Lo <= $8FF) Then Begin
      A2600_E7_RAM256[A2600_E7_R256Bank, Lo And $FF] := V;
      Exit;
    End;
    { 3E : ecriture sur fenetre RAM $1400-$17FF si mode RAM actif.   }
    { Stocke dans la banque RAM courante et met a jour la fenetre de }
    { lecture $1000-$13FF dans le shadow CPU6502_Mem.                }
    If (A2600_Scheme = 12) And A2600_3E_RAMMode
       And (Lo >= $400) And (Lo <= $7FF) Then Begin
      I := (LongInt(A2600_3E_LowerRAM) * 1024) + (Lo And $3FF);
      A2600_3E_RAM[I And $7FFF] := V;
      { Mettre a jour les 8 aliases en lecture pour reflechir l ecriture.}
      For BeamX := 0 To 7 Do Begin
        CPU6502_Mem[(BeamX * $2000) + $1000 + (Lo And $3FF)] := V;
        CPU6502_Mem[(BeamX * $2000) + $1400 + (Lo And $3FF)] := V;
      End;
      Exit;
    End;
    { 3E+ : ecriture sur moitie haute d un slot RAM ($X200-$X3FF).      }
    { Slot s = Lo Shr 10 (taille 1K). Offset dans slot = Lo And $3FF.   }
    { Si offset >= $200 et slot est RAM, ecrire dans banque RAM 512B.   }
    If A2600_Scheme = 13 Then Begin
      CurX := (Lo Shr 10) And 3;          { index slot 0..3 }
      If A2600_3EP_SlotIsRAM[CurX] And ((Lo And $3FF) >= $200) Then Begin
        I := (LongInt(A2600_3EP_SlotBank[CurX]) * 512)
             + ((Lo And $3FF) - $200);
        A2600_3E_RAM[I And $7FFF] := V;
        { Mettre a jour les 8 aliases : moitie basse (read) + haute. }
        For BeamX := 0 To 7 Do Begin
          CPU6502_Mem[(BeamX * $2000) + $1000 + (CurX * $400)
            + ((Lo And $3FF) - $200)] := V;
          CPU6502_Mem[(BeamX * $2000) + $1000 + (CurX * $400)
            + (Lo And $3FF)] := V;
        End;
        Exit;
      End;
    End;
    A2600_CheckHotspot(EA);
    Exit;
  End;
  { 3F Tigervision : ecriture a $00-$3F commute la banque basse }
  If (A2600_Scheme = 10) And (EA <= $3F) Then Begin
    A2600_TigerSwitch(V);
    { Continue : ces adresses sont aussi TIA, on laisse tomber dans TIA }
  End;
  { 3E (Andrew Davie) : hotspots specifiques $003E (RAM bank) / $003F (ROM).}
  If A2600_Scheme = 12 Then Begin
    If EA = $003E Then Begin
      A2600_3E_LowerRAM := V And $1F;     { 32 banques RAM max (5 bits) }
      A2600_3E_RAMMode := True;
      A2600_3E_RebuildLower;
    End Else If EA = $003F Then Begin
      A2600_3E_LowerROM := V And $0F;     { 16 banques ROM max (4 bits) }
      A2600_3E_RAMMode := False;
      A2600_3E_RebuildLower;
    End;
    { Continue : on laisse tomber dans TIA pour les autres adresses.   }
  End;
  { 3E+ (TJentzsch) : hotspots $003E (RAM) / $003F (ROM).                }
  { Encodage val : slot = val And 3, banque = val Shr 2.                 }
  If A2600_Scheme = 13 Then Begin
    If EA = $003E Then Begin
      I := V And 3;
      A2600_3EP_SlotIsRAM[I] := True;
      A2600_3EP_SlotBank[I] := (V Shr 2) And $3F;
      A2600_3EP_RebuildSlot(I);
    End Else If EA = $003F Then Begin
      I := V And 3;
      A2600_3EP_SlotIsRAM[I] := False;
      A2600_3EP_SlotBank[I] := (V Shr 2) And $3F;
      A2600_3EP_RebuildSlot(I);
    End;
  End;
  If (EA And $0080) = 0 Then Begin
    { TIA write : decodage 6 bits sur le bus reel (A0-A5). Les adresses }
    { $2D-$3F sont des miroirs sans effet (no-op cote TIA).             }
    R := EA And $3F;
    { Rendu cycle-accurate : avancer le faisceau avant cette ecriture. }
    { Le beam X = (LineCyc*3) - 68 (HBLANK = 68 color clocks).         }
    BeamX := (A2600_LineCyc * 3) - 68;
    A2600_AdvanceTo(BeamX);
    { Ne stocker dans le shadow que pour les registres ecrivables       }
    { ($00-$2C). Les autres sont en lecture seule (collisions/INPT).   }
    If R <= $2C Then A2600_TIA[R] := V;
    Case R Of
      $00: { VSYNC : bit 1 declenche la synchronisation verticale.        }
           {  - Front montant (0->1) : fin de trame courante. Mesurer le  }
           {    nombre de scanlines pour detecter PAL/NTSC. La frame est  }
           {    prete a etre affichee (FrameReady).                        }
           {  - Front descendant (1->0) : DEBUT REEL de la nouvelle trame.}
           {    On reset ScanLine/VisLine/CurY/LastX ici, conformement au }
           {    TIA reel (le faisceau redescend en haut a la chute VSYNC).}
       Begin
        If (V And $02) <> 0 Then Begin
          If Not A2600_VSYNCAct Then Begin
            { Front montant. }
            If A2600_LastVsyncLine >= 0 Then Begin
              A2600_FrameLineHist[A2600_FrameLineIdx] := A2600_ScanLine;
              A2600_FrameLineIdx := (A2600_FrameLineIdx + 1) And $03;
              I := 0;
              If A2600_FrameLineHist[0] > 285 Then Inc(I);
              If A2600_FrameLineHist[1] > 285 Then Inc(I);
              If A2600_FrameLineHist[2] > 285 Then Inc(I);
              If A2600_FrameLineHist[3] > 285 Then Inc(I);
              If I >= 2 Then Begin
                A2600_PAL := True;
                A2600_LinesPerFrame := 312;
              End Else Begin
                A2600_PAL := False;
                A2600_LinesPerFrame := 262;
              End;
            End;
            A2600_LastVsyncLine := A2600_ScanLine;
            A2600_FrameReady := True;       { signal a la boucle de frame }
          End;
          A2600_VSYNCAct := True;
        End Else Begin
          If A2600_VSYNCAct Then Begin
            { Front descendant : DEBUT de la nouvelle trame, reset beam.  }
            A2600_ScanLine := 0;
            A2600_VisLine := 0;
            A2600_CurY := 0;
            A2600_LastX := -1;
          End;
          A2600_VSYNCAct := False;
        End;
       End;
      $01: Begin
        A2600_VBLANKAct := (V And $02) <> 0;        { VBLANK }
        { bit 6 = latch enable INPT4/5 ; bit 6 -> 0 efface les latches }
        If (V And $40) = 0 Then Begin
          A2600_INPTLatchEn := False;
          A2600_INPT4Latch := False;
          A2600_INPT5Latch := False;
        End Else
          A2600_INPTLatchEn := True;
        { bit 7 = dump cap des paddles INPT0-INPT3. Quand actif, le }
        { condensateur est court-circuite : INPTx bit 7 = 0 et le   }
        { compteur de charge reste a 0. A la fin (bit 7 -> 0), le   }
        { compteur reprend a chaque scanline jusqu au seuil.        }
        If (V And $80) <> 0 Then Begin
          A2600_PadDumped := True;
          A2600_PadCharge[0] := 0; A2600_PadCharge[1] := 0;
          A2600_PadCharge[2] := 0; A2600_PadCharge[3] := 0;
        End Else
          A2600_PadDumped := False;
      End;
      $02: A2600_WSYNCWait := True;                 { WSYNC }
      $03: Begin                                    { RSYNC }
        { Reset Horizontal Sync : remet le compteur horizontal TIA a 3 }
        { color-clocks de la fin de ligne. La ligne courante est       }
        { tronquee immediatement. Utilise par Cosmic Ark (starfield)   }
        { et quelques demos. On termine le rendu visible jusqu au beam }
        { courant puis on force la fin de scanline sur le prochain     }
        { AfterInstr (LineCyc >= 76).                                  }
        { Le pipeline HMOVE eventuellement en cours n est PAS reset.   }
        A2600_LineCyc := 76;
       End;
      { RESPx/RESMx/RESBL : le faisceau au moment du verrouillage est }
      { a (LineCyc+3)*3 color-clocks (3 cycles CPU pendant STA zp),    }
      { puis le TIA ajoute un delai de 5 color-clocks. HBLANK = 68.    }
      { Position = (LineCyc+3)*3 + 5 - 68 = LineCyc*3 - 54.            }
      $10: Begin                                    { RESP0 }
        If A2600_LineCyc * 3 < 68 Then CurX := 3   { HBLANK -> X=3 }
        Else CurX := (A2600_LineCyc * 3) - 54;
        If CurX < 0 Then CurX := 0;
        If CurX > 159 Then CurX := 159;
        A2600_P0X := CurX;
       End;
      $11: Begin                                    { RESP1 }
        If A2600_LineCyc * 3 < 68 Then CurX := 3
        Else CurX := (A2600_LineCyc * 3) - 54;
        If CurX < 0 Then CurX := 0;
        If CurX > 159 Then CurX := 159;
        A2600_P1X := CurX;
       End;
      $12: Begin                                    { RESM0 }
        If A2600_LineCyc * 3 < 68 Then CurX := 2
        Else CurX := (A2600_LineCyc * 3) - 54;
        If CurX < 0 Then CurX := 0;
        If CurX > 159 Then CurX := 159;
        A2600_M0X := CurX;
       End;
      $13: Begin                                    { RESM1 }
        If A2600_LineCyc * 3 < 68 Then CurX := 2
        Else CurX := (A2600_LineCyc * 3) - 54;
        If CurX < 0 Then CurX := 0;
        If CurX > 159 Then CurX := 159;
        A2600_M1X := CurX;
       End;
      $14: Begin                                    { RESBL }
        If A2600_LineCyc * 3 < 68 Then CurX := 2
        Else CurX := (A2600_LineCyc * 3) - 54;
        If CurX < 0 Then CurX := 0;
        If CurX > 159 Then CurX := 159;
        A2600_BLX := CurX;
       End;
      $20: A2600_HMP0 := ShortInt(V) Div 16;        { HMP0 nibble haut }
      $21: A2600_HMP1 := ShortInt(V) Div 16;
      $22: A2600_HMM0 := ShortInt(V) Div 16;
      $23: A2600_HMM1 := ShortInt(V) Div 16;
      $24: A2600_HMBL := ShortInt(V) Div 16;
      { GRP0 ecrit verrouille le buffer "old" de GRP1 (VDELP1 utilise old). }
      $1B: Begin
        A2600_GRP0_New := V;
        A2600_GRP1_Old := A2600_GRP1_New;
       End;
      { GRP1 ecrit verrouille les buffers "old" de GRP0 et ENABL. }
      $1C: Begin
        A2600_GRP1_New := V;
        A2600_GRP0_Old := A2600_GRP0_New;
        A2600_ENABL_Old := A2600_ENABL_New;
       End;
      $1F: A2600_ENABL_New := V;                    { ENABL }
      $25: A2600_VDELP0 := (V And $01) <> 0;        { VDELP0 }
      $26: A2600_VDELP1 := (V And $01) <> 0;        { VDELP1 }
      $27: A2600_VDELBL := (V And $01) <> 0;        { VDELBL }
      $28: A2600_RESMP0 := (V And $02) <> 0;        { RESMP0 }
      $29: A2600_RESMP1 := (V And $02) <> 0;        { RESMP1 }
      $2A: Begin                                    { HMOVE }
        { Pipeline cycle-accurate : arme le motion counter. Les ticks }
        { sont appliques progressivement par AfterInstr pendant les   }
        { ~22 cycles de HBLANK. HMx mid-HBLANK et HMCLR mid-HBLANK    }
        { sont correctement geres par le tick loop (lecture LIVE).    }
        If A2600_LineCyc < 24 Then Begin
          A2600_HMOVEComb := True;                  { comb pixels 0..7 }
          A2600_HMOVE_Start;
        End Else Begin
          { Late/phantom HMOVE (Pesco, He-Man) : strobe en partie     }
          { visible. Le motion counter demarre IMMEDIATEMENT (pas     }
          { defere) et un "comb" noir de 8 pixels apparait a la       }
          { position courante du faisceau (decale selon le timing du  }
          { strobe). HBLANK n est PAS prolonge sur la ligne suivante. }
          A2600_PhantomCombX := (A2600_LineCyc * 3) - 68;
          If A2600_PhantomCombX < 0 Then A2600_PhantomCombX := 0;
          A2600_HMOVE_Start;
        End;
       End;
      $2B: Begin                                    { HMCLR }
        A2600_HMP0 := 0; A2600_HMP1 := 0;
        A2600_HMM0 := 0; A2600_HMM1 := 0;
        A2600_HMBL := 0;
        { HMCLR mid-HBLANK : avec HMx=0, le prochain tick voit HM=0,  }
        { le comparateur "Counter <= |HM|" est faux, et chaque flag   }
        { Active passe a False -> motion stoppee proprement.          }
       End;
      $2C: Begin                                    { CXCLR }
        A2600_TIA[$30] := 0; A2600_TIA[$31] := 0;
        A2600_TIA[$32] := 0; A2600_TIA[$33] := 0;
        A2600_TIA[$34] := 0; A2600_TIA[$35] := 0;
        A2600_TIA[$36] := 0; A2600_TIA[$37] := 0;
       End;
    End;
    Exit;
  End;
  If (EA And $0200) = 0 Then Begin
    { RIOT RAM ($0080-$00FF). Mirroree par bus 13 bits aux 4 aliases }
    { ou bit12=0, bit7=1, bit9=0 : $0080, $0180, $0480, $0580.       }
    A2600_RIOTRam[EA And $7F] := V;
    CPU6502_Mem[$0080 Or (EA And $7F)] := V;
    CPU6502_Mem[$0180 Or (EA And $7F)] := V;
    CPU6502_Mem[$0480 Or (EA And $7F)] := V;
    CPU6502_Mem[$0580 Or (EA And $7F)] := V;
    Exit;
  End;
  { RIOT I/O / timer : ecritures TIM1T/TIM8T/TIM64T/T1024T.            }
  { Adresses bit12=0, bit7=1, bit9=1 (mirroir). Bits 0-4 selectionnent }
  { le registre. Apres ecriture la valeur est decrementee de 1 toutes  }
  { les N cycles ; quand elle passe sous 0, decrement par 1 par cycle  }
  { et bit 7 d'INSTAT a 1.                                              }
  Case EA And $1F Of
    $00: A2600_SWACHA_Out := V;          { SWCHA output latch }
    $01: A2600_SWACNT := V;              { SWACNT - direction port A }
    $02: A2600_SWCHB_Out := V;           { SWCHB output latch }
    $03: A2600_SWBCNT := V;              { SWBCNT - direction port B }
    $14: Begin A2600_TimerVal := V; A2600_TimerInterval := 1;
               A2600_TimerCyc := 1; A2600_TimerExpired := False; End;
    $15: Begin A2600_TimerVal := V; A2600_TimerInterval := 8;
               A2600_TimerCyc := 8; A2600_TimerExpired := False; End;
    $16: Begin A2600_TimerVal := V; A2600_TimerInterval := 64;
               A2600_TimerCyc := 64; A2600_TimerExpired := False; End;
    $17: Begin A2600_TimerVal := V; A2600_TimerInterval := 1024;
               A2600_TimerCyc := 1024; A2600_TimerExpired := False; End;
  End;
End;

{ Lecture cote 2600 : pour les TIA reads ($30-$3D), on retourne 0    }
{ (collisions non implementees). Pour RIOT, on retourne joystick.    }
Function A2600_BusRead(EA: Word; Var Handled: Boolean): Byte;
Var Joy: Byte; Lo: Word; I: Integer;
Begin
  Handled := False;
  A2600_BusRead := 0;
  If (EA And $1000) <> 0 Then Begin
    Lo := EA And $0FFF;
    { RAM cartouche F8SC/F6SC/F4SC : $1080-$10FF read (256 octets - 128) }
    If ((A2600_Scheme = 4) Or (A2600_Scheme = 5) Or (A2600_Scheme = 6))
       And (Lo >= $80) And (Lo <= $FF) Then Begin
      Handled := True;
      A2600_BusRead := A2600_CartRAM[Lo And $7F];
      Exit;
    End;
    { FA CBS RAM Plus : $1100-$11FF read }
    If (A2600_Scheme = 7) And (Lo >= $100) And (Lo <= $1FF) Then Begin
      Handled := True;
      A2600_BusRead := A2600_CartRAM[Lo - $100];
      Exit;
    End;
    { E7 M-Network : RAM 1K read en $1400-$17FF si LowerRAM }
    If (A2600_Scheme = 11) And A2600_E7_LowerRAM And (Lo >= $400) And (Lo <= $7FF) Then Begin
      Handled := True;
      A2600_BusRead := A2600_E7_RAM1K[Lo - $400];
      Exit;
    End;
    { E7 M-Network : RAM 256B read en $1900-$19FF }
    If (A2600_Scheme = 11) And (Lo >= $900) And (Lo <= $9FF) Then Begin
      Handled := True;
      A2600_BusRead := A2600_E7_RAM256[A2600_E7_R256Bank, Lo And $FF];
      Exit;
    End;
    { FE Decathlon : lecture $01FE/$01FF (pile JSR) declenche commutation }
    A2600_CheckHotspot(EA);
    Exit;
  End;
  { FE peut declencher sur acces pile $01FE/$01FF }
  If (A2600_Scheme = 8) And ((EA = $01FE) Or (EA = $01FF)) Then
    A2600_CheckHotspot(EA);
  If (EA And $0080) = 0 Then Begin             { TIA read }
    Handled := True;
    Case EA And $0F Of
      $00..$07: { CXxx : TIA drive D7 et D6 seulement. D5..D0 = open bus }
        A2600_BusRead := (A2600_TIA[$30 + (EA And $07)] And $C0)
                      Or (CPU6502_DataBus And $3F);
      $08, $09, $0A, $0B: Begin                 { INPT0..3 - paddles }
        I := (EA And $0F) - $08;
        { Booster Grip : INPT1 (P0) et INPT3 (P1) sont reaffectes en   }
        { boutons digitaux "booster". D7=0 quand presse (et non dump). }
        If A2600_BoosterP0 And (I = 1) Then Begin
          If A2600_KeyBooster And (Not A2600_PadDumped) Then
            A2600_BusRead := (CPU6502_DataBus And $7F)
          Else A2600_BusRead := $80 Or (CPU6502_DataBus And $7F);
        End Else
        If A2600_PadDumped Then A2600_BusRead := (CPU6502_DataBus And $7F)
        Else If A2600_PadCharge[I] >= A2600_Paddle[I] Then
          A2600_BusRead := $80 Or (CPU6502_DataBus And $7F)
        Else A2600_BusRead := (CPU6502_DataBus And $7F);
      End;
      $0C: Begin                                { INPT4 - fire P0 }
        If A2600_INPTLatchEn And A2600_KeyFire Then A2600_INPT4Latch := True;
        If (A2600_INPTLatchEn And A2600_INPT4Latch) Or A2600_KeyFire Then
          A2600_BusRead := (CPU6502_DataBus And $7F)
        Else A2600_BusRead := $80 Or (CPU6502_DataBus And $7F);
      End;
      $0D: Begin                                { INPT5 - fire P1 }
        If (A2600_INPTLatchEn And A2600_INPT5Latch) Then
          A2600_BusRead := (CPU6502_DataBus And $7F)
        Else A2600_BusRead := $80 Or (CPU6502_DataBus And $7F);
      End;
    Else
      { $0E, $0F : non connecte -> pure open bus. }
      A2600_BusRead := CPU6502_DataBus;
    End;
    Exit;
  End;
  If (EA And $0200) = 0 Then Begin             { RIOT RAM }
    Handled := True;
    A2600_BusRead := A2600_RIOTRam[EA And $7F];
    Exit;
  End;
  { RIOT I/O / timer : $0280..$029F }
  Case EA And $1F Of
    $00: Begin                                  { SWCHA - joysticks }
      Handled := True;
      Joy := $FF;
      If A2600_DrivingP0 Then Begin
        { Controleur Driving Indy 500 : bits 4-5 = Gray code, bits 6-7 }
        { (Left/Right joystick) restent relaches a 1 (controleur sans  }
        { directions L/R). Bouton de tir reste sur INPT4.               }
        Joy := Joy And Not $30;
        Case A2600_DriveP0_Pos And 3 Of
          1: Joy := Joy Or $10;
          2: Joy := Joy Or $30;
          3: Joy := Joy Or $20;
        End;
      End Else Begin
        If (A2600_KeyJoy And 1) <> 0 Then Joy := Joy And Not $10;
        If (A2600_KeyJoy And 2) <> 0 Then Joy := Joy And Not $20;
        If (A2600_KeyJoy And 4) <> 0 Then Joy := Joy And Not $40;
        If (A2600_KeyJoy And 8) <> 0 Then Joy := Joy And Not $80;
      End;
      { Combiner avec output bits selon DDR : bits output = SWACHA_Out }
      Joy := (Joy And Not A2600_SWACNT) Or (A2600_SWACHA_Out And A2600_SWACNT);
      A2600_BusRead := Joy;
    End;
    $01: Begin Handled := True; A2600_BusRead := A2600_SWACNT; End; { SWACNT }
    $02: Begin                                  { SWCHB - console switches }
      Handled := True;
      A2600_BusRead := ($3F And Not A2600_SWBCNT) Or (A2600_SWCHB_Out And A2600_SWBCNT);
    End;
    $03: Begin Handled := True; A2600_BusRead := A2600_SWBCNT; End; { SWBCNT }
    $04, $06: Begin                             { INTIM }
      Handled := True;
      A2600_BusRead := Byte(A2600_TimerVal And $FF);
      { RIOT 6532 : la lecture INTIM N EFFACE PAS le flag d underflow.   }
      { Le flag bit 7 INSTAT reste set jusqu a la prochaine ecriture     }
      { TIM1T/TIM8T/TIM64T/T1024T. Apres underflow, le timer continue a  }
      { decrementer a 1 cycle/tick (deja gere par AfterInstr).           }
    End;
    $05, $07: Begin                             { INSTAT }
      Handled := True;
      { INSTAT bit 7 = timer underflow flag. La lecture N EFFACE PAS le  }
      { flag (contrairement a une croyance commune). Seule une ecriture  }
      { TIMxT le clear (cf. case $14-$17 en ecriture RIOT).               }
      If A2600_TimerExpired Then A2600_BusRead := $80 Else A2600_BusRead := 0;
    End;
    $0C: Begin                                  { INPT4 - fire P0 }
      Handled := True;
      If A2600_INPTLatchEn And A2600_KeyFire Then A2600_INPT4Latch := True;
      If (A2600_INPTLatchEn And A2600_INPT4Latch) Or A2600_KeyFire Then
        A2600_BusRead := 0
      Else A2600_BusRead := $80;
    End;
    $0D: Begin                                  { INPT5 - fire P1 }
      Handled := True;
      { Pas de bouton P1 emule : reste relache, mais latch quand meme }
      { gere pour conformite Stella si une touche est ajoutee.        }
      If (A2600_INPTLatchEn And A2600_INPT5Latch) Then
        A2600_BusRead := 0
      Else A2600_BusRead := $80;
    End;
  End;
End;

{ Rendu d un scanline visible (0..191) dans A2600_FB. Le scanline 0 }
{ correspond a la premiere ligne apres VBLANK off (approxime).      }
Procedure A2600_RenderRange(Y: Integer; X0, X1: Integer);
Var
  X, PfBit, HalfX: Integer;
  PF0, PF1, PF2, CTRLPF: Byte;
  COLUBK, COLUPF, COLUP0, COLUP1: Byte;
  GRP0, GRP1: Byte;
  ENABL: Byte;
  ENAM0, ENAM1: Byte;
  Pix, PfPix, P0Pix, P1Pix, M0Pix, M1Pix, BLPix: Byte;
  PfIdx, PfBits: Integer;
  Reflect, Score, Priority: Boolean;
  Tmp, K, Dx: Integer;

  Function PlayerPixel(GR, REF: Byte; Stretch: Integer; Dx: Integer): Boolean;
  Var Bit, D: Integer;
  Begin
    PlayerPixel := False;
    If GR = 0 Then Exit;
    D := Dx;
    If D < 0 Then D := D + 160;
    If D >= 160 Then D := D - 160;
    If (D < 0) Or (D >= 8 * Stretch) Then Exit;
    Bit := D Div Stretch;
    If (REF And $08) <> 0 Then Bit := Bit
    Else Bit := 7 - Bit;
    PlayerPixel := ((GR Shr Bit) And 1) <> 0;
  End;

  Function MissilePixel(Size, Dx: Integer): Boolean;
  Var D: Integer;
  Begin
    D := Dx;
    If D < 0 Then D := D + 160;
    If D >= 160 Then D := D - 160;
    MissilePixel := (D >= 0) And (D < Size);
  End;

Begin
  If (Y < 0) Or (Y > 191) Then Exit;
  If X0 < 0 Then X0 := 0;
  If X1 > 159 Then X1 := 159;
  If X0 > X1 Then Exit;
  COLUBK := A2600_TIA[$09];
  COLUPF := A2600_TIA[$08];
  COLUP0 := A2600_TIA[$06];
  COLUP1 := A2600_TIA[$07];
  PF0    := A2600_TIA[$0D];
  PF1    := A2600_TIA[$0E];
  PF2    := A2600_TIA[$0F];
  CTRLPF := A2600_TIA[$0A];
  If A2600_VDELP0 Then GRP0 := A2600_GRP0_Old Else GRP0 := A2600_GRP0_New;
  If A2600_VDELP1 Then GRP1 := A2600_GRP1_Old Else GRP1 := A2600_GRP1_New;
  If A2600_VDELBL Then ENABL := A2600_ENABL_Old Else ENABL := A2600_ENABL_New;
  ENAM0  := A2600_TIA[$1D];
  ENAM1  := A2600_TIA[$1E];
  Reflect  := (CTRLPF And $01) <> 0;
  Score    := (CTRLPF And $02) <> 0;
  Priority := (CTRLPF And $04) <> 0;

  { Latcher tout objet dont le start signal tombe dans [X0..X1] }
  { avec les valeurs TIA actuelles (pipeline cycle-accurate).   }
  A2600_LatchAll(X1);

  For X := X0 To X1 Do Begin
    { HBLANK etendu par HMOVE : pixels 0..7 totalement supprimes.    }
    { Pas de calcul de sprite, pas de collisions latchees, pixel a 0.}
    { Conforme au TIA : pendant l extension de 8 cycles CPU, le      }
    { pixel-enable est inhibe -> aucun objet visible et aucun        }
    { comparateur de collision ne se latche.                          }
    If A2600_HMOVEComb And (X < 8) Then Begin
      A2600_FB[Y, X] := 0;
    End Else If (A2600_PhantomCombX >= 0)
       And (X >= A2600_PhantomCombX)
       And (X < A2600_PhantomCombX + 8) Then Begin
      { Phantom HMOVE comb : barre noire decalee a la position du   }
      { strobe HMOVE tardif. Aucun sprite, aucune collision latchee.}
      A2600_FB[Y, X] := 0;
    End Else Begin
    Pix := COLUBK;
    HalfX := X Div 4;
    If HalfX >= 20 Then Begin
      If Reflect Then PfIdx := 39 - HalfX
      Else PfIdx := HalfX - 20;
    End Else PfIdx := HalfX;
    PfBit := 0;
    If PfIdx < 4 Then PfBit := (PF0 Shr (4 + PfIdx)) And 1
    Else If PfIdx < 12 Then PfBit := (PF1 Shr (7 - (PfIdx - 4))) And 1
    Else PfBit := (PF2 Shr (PfIdx - 12)) And 1;
    PfPix := 0;
    If PfBit <> 0 Then Begin
      If Score Then Begin
        If X < 80 Then PfPix := COLUP0 Else PfPix := COLUP1;
      End Else PfPix := COLUPF;
    End;
    { Joueurs : utiliser les valeurs LATCHEES au start signal. }
    P0Pix := 0;
    For K := 0 To A2600_P0LCnt - 1 Do
      If A2600_P0Fired[K] Then Begin
        Dx := X - A2600_P0LStart[K];
        If PlayerPixel(GRP0, A2600_P0LRefp[K], A2600_P0LStretch[K], Dx)
          Then P0Pix := COLUP0;
      End;
    P1Pix := 0;
    For K := 0 To A2600_P1LCnt - 1 Do
      If A2600_P1Fired[K] Then Begin
        Dx := X - A2600_P1LStart[K];
        If PlayerPixel(GRP1, A2600_P1LRefp[K], A2600_P1LStretch[K], Dx)
          Then P1Pix := COLUP1;
      End;
    { Missiles : taille latchee, copies aux memes positions que P0/P1. }
    M0Pix := 0;
    If (ENAM0 And $02) <> 0 Then
      For K := 0 To A2600_P0LCnt - 1 Do
        If A2600_M0Fired[K] Then Begin
          Dx := X - A2600_M0LStart[K];
          If MissilePixel(A2600_M0LSize[K], Dx) Then M0Pix := COLUP0;
        End;
    M1Pix := 0;
    If (ENAM1 And $02) <> 0 Then
      For K := 0 To A2600_P1LCnt - 1 Do
        If A2600_M1Fired[K] Then Begin
          Dx := X - A2600_M1LStart[K];
          If MissilePixel(A2600_M1LSize[K], Dx) Then M1Pix := COLUP1;
        End;
    { Balle : taille latchee. }
    BLPix := 0;
    If A2600_BLFired And ((ENABL And $02) <> 0) Then Begin
      Tmp := X - A2600_BLLStart;
      If MissilePixel(A2600_BLLSize, Tmp) Then BLPix := COLUPF;
    End;
    { Priorite TIA (du plus faible au plus eleve, dernier ecrit gagne). }
    { Defaut    : BK < PF/BL < P1/M1 < P0/M0                            }
    { Priorite  : BK < P1/M1 < P0/M0 < PF/BL                            }
    If Priority Then Begin
      If P1Pix <> 0 Then Pix := P1Pix;
      If M1Pix <> 0 Then Pix := M1Pix;
      If P0Pix <> 0 Then Pix := P0Pix;
      If M0Pix <> 0 Then Pix := M0Pix;
      If PfPix <> 0 Then Pix := PfPix;
      If BLPix <> 0 Then Pix := BLPix;
    End Else Begin
      If PfPix <> 0 Then Pix := PfPix;
      If BLPix <> 0 Then Pix := BLPix;
      If P1Pix <> 0 Then Pix := P1Pix;
      If M1Pix <> 0 Then Pix := M1Pix;
      If P0Pix <> 0 Then Pix := P0Pix;
      If M0Pix <> 0 Then Pix := M0Pix;
    End;
    { Collisions : MAJ des registres TIA $30-$3D si overlap. Bits   }
    { CXMP/CXBLPF/CXPPMM stockent collisions (bit 7=premier objet). }
    If (P0Pix <> 0) And (M1Pix <> 0) Then
      A2600_TIA[$30] := A2600_TIA[$30] Or $80;            { CXM0P : M0/P1 }
    If (M0Pix <> 0) And (P1Pix <> 0) Then
      A2600_TIA[$30] := A2600_TIA[$30] Or $40;            { CXM0P : M0/P0 }
    If (M1Pix <> 0) And (P0Pix <> 0) Then
      A2600_TIA[$31] := A2600_TIA[$31] Or $80;            { CXM1P : M1/P0 }
    If (M1Pix <> 0) And (P1Pix <> 0) Then
      A2600_TIA[$31] := A2600_TIA[$31] Or $40;
    If (P0Pix <> 0) And (PfPix <> 0) Then
      A2600_TIA[$32] := A2600_TIA[$32] Or $80;            { CXP0FB : P0/PF }
    If (P0Pix <> 0) And (BLPix <> 0) Then
      A2600_TIA[$32] := A2600_TIA[$32] Or $40;
    If (P1Pix <> 0) And (PfPix <> 0) Then
      A2600_TIA[$33] := A2600_TIA[$33] Or $80;            { CXP1FB : P1/PF }
    If (P1Pix <> 0) And (BLPix <> 0) Then
      A2600_TIA[$33] := A2600_TIA[$33] Or $40;
    If (M0Pix <> 0) And (PfPix <> 0) Then
      A2600_TIA[$34] := A2600_TIA[$34] Or $80;            { CXM0FB }
    If (M0Pix <> 0) And (BLPix <> 0) Then
      A2600_TIA[$34] := A2600_TIA[$34] Or $40;
    If (M1Pix <> 0) And (PfPix <> 0) Then
      A2600_TIA[$35] := A2600_TIA[$35] Or $80;
    If (M1Pix <> 0) And (BLPix <> 0) Then
      A2600_TIA[$35] := A2600_TIA[$35] Or $40;
    If (BLPix <> 0) And (PfPix <> 0) Then
      A2600_TIA[$36] := A2600_TIA[$36] Or $80;            { CXBLPF }
    If (P0Pix <> 0) And (P1Pix <> 0) Then
      A2600_TIA[$37] := A2600_TIA[$37] Or $80;            { CXPPMM : P0/P1 }
    If (M0Pix <> 0) And (M1Pix <> 0) Then
      A2600_TIA[$37] := A2600_TIA[$37] Or $40;            { CXPPMM : M0/M1 }
    If A2600_VBLANKAct Then Pix := 0;
    A2600_FB[Y, X] := Pix;
    End;
  End;
End;

{ Wrapper de compatibilite : rendre toute la scanline d un coup. }
Procedure A2600_RenderScanline(Y: Integer);
Begin
  A2600_RenderRange(Y, 0, 159);
End;

{ Reset des latches au debut d un scanline (ou apres VSYNC). }
Procedure A2600_ResetScanlineLatches;
Var K: Integer;
Begin
  For K := 0 To 2 Do Begin
    A2600_P0Fired[K] := False;
    A2600_P1Fired[K] := False;
    A2600_M0Fired[K] := False;
    A2600_M1Fired[K] := False;
  End;
  A2600_BLFired := False;
  A2600_P0LCnt := 0;
  A2600_P1LCnt := 0;
End;

{ Latcher P0 : a chaque appel, on inspecte les copies (selon NUSIZ courant) }
{ qui n ont pas encore "fire". Si leur start position <= BeamX et qu elles  }
{ ne sont pas encore latchees, on latche les valeurs TIA actuelles.         }
Procedure A2600_LatchPlayer(Which: Integer; BeamX: Integer);
Var
  K, Cnt, Stretch: Integer;
  Off: Array[0..2] Of Integer;
  NU, RF: Byte;
  PxX: Integer;
  Sx: Integer;
Begin
  If Which = 0 Then Begin
    NU := A2600_TIA[$04]; RF := A2600_TIA[$0B]; PxX := A2600_P0X;
  End Else Begin
    NU := A2600_TIA[$05]; RF := A2600_TIA[$0C]; PxX := A2600_P1X;
  End;
  Cnt := 1; Stretch := 1;
  Off[0] := 0; Off[1] := 0; Off[2] := 0;
  Case NU And $07 Of
    1: Begin Cnt := 2; Off[1] := 16; End;
    2: Begin Cnt := 2; Off[1] := 32; End;
    3: Begin Cnt := 3; Off[1] := 16; Off[2] := 32; End;
    4: Begin Cnt := 2; Off[1] := 64; End;
    5: Stretch := 2;
    6: Begin Cnt := 3; Off[1] := 32; Off[2] := 64; End;
    7: Stretch := 4;
  End;
  If Which = 0 Then Begin
    If Cnt > A2600_P0LCnt Then A2600_P0LCnt := Cnt;
  End Else Begin
    If Cnt > A2600_P1LCnt Then A2600_P1LCnt := Cnt;
  End;
  For K := 0 To Cnt - 1 Do Begin
    Sx := PxX + Off[K];
    If Sx >= 160 Then Sx := Sx - 160;
    If Sx < 0 Then Sx := Sx + 160;
    { Une copie se latche au moment ou le faisceau franchit Sx. }
    If Sx <= BeamX Then Begin
      If Which = 0 Then Begin
        If Not A2600_P0Fired[K] Then Begin
          A2600_P0LStart[K] := Sx;
          A2600_P0LStretch[K] := Stretch;
          A2600_P0LRefp[K] := RF;
          A2600_P0Fired[K] := True;
        End;
      End Else Begin
        If Not A2600_P1Fired[K] Then Begin
          A2600_P1LStart[K] := Sx;
          A2600_P1LStretch[K] := Stretch;
          A2600_P1LRefp[K] := RF;
          A2600_P1Fired[K] := True;
        End;
      End;
    End;
  End;
End;

{ Latcher missiles : meme schema NUSIZ que joueurs, taille = 1/2/4/8. }
Procedure A2600_LatchMissile(Which: Integer; BeamX: Integer);
Var
  K, Cnt, Stretch, Size: Integer;
  Off: Array[0..2] Of Integer;
  NU: Byte; PxX, MxX, Sx: Integer;
  RESMP: Boolean;
Begin
  If Which = 0 Then Begin
    NU := A2600_TIA[$04]; PxX := A2600_P0X; MxX := A2600_M0X;
    RESMP := A2600_RESMP0;
  End Else Begin
    NU := A2600_TIA[$05]; PxX := A2600_P1X; MxX := A2600_M1X;
    RESMP := A2600_RESMP1;
  End;
  Cnt := 1; Stretch := 1;
  Off[0] := 0; Off[1] := 0; Off[2] := 0;
  Case NU And $07 Of
    1: Begin Cnt := 2; Off[1] := 16; End;
    2: Begin Cnt := 2; Off[1] := 32; End;
    3: Begin Cnt := 3; Off[1] := 16; Off[2] := 32; End;
    4: Begin Cnt := 2; Off[1] := 64; End;
    5: Stretch := 2;
    6: Begin Cnt := 3; Off[1] := 32; Off[2] := 64; End;
    7: Stretch := 4;
  End;
  Size := 1 Shl ((NU Shr 4) And $03);
  If RESMP Then MxX := PxX + (Stretch * 4) - (Size Div 2);
  For K := 0 To Cnt - 1 Do Begin
    Sx := MxX + Off[K];
    If Sx >= 160 Then Sx := Sx - 160;
    If Sx < 0 Then Sx := Sx + 160;
    If Sx <= BeamX Then Begin
      If Which = 0 Then Begin
        If Not A2600_M0Fired[K] Then Begin
          A2600_M0LStart[K] := Sx;
          A2600_M0LSize[K] := Size;
          A2600_M0Fired[K] := True;
        End;
      End Else Begin
        If Not A2600_M1Fired[K] Then Begin
          A2600_M1LStart[K] := Sx;
          A2600_M1LSize[K] := Size;
          A2600_M1Fired[K] := True;
        End;
      End;
    End;
  End;
End;

Procedure A2600_LatchBall(BeamX: Integer);
Begin
  If (Not A2600_BLFired) And (A2600_BLX <= BeamX) Then Begin
    A2600_BLLStart := A2600_BLX;
    A2600_BLLSize := 1 Shl ((A2600_TIA[$0A] Shr 4) And $03);
    A2600_BLFired := True;
  End;
End;

{ Latche tous les objets pour le scanline courant. Appele au debut de    }
{ scanline et avant chaque RenderRange si necessaire.                    }
Procedure A2600_LatchAll(BeamX: Integer);
Begin
  A2600_LatchPlayer(0, BeamX);
  A2600_LatchPlayer(1, BeamX);
  A2600_LatchMissile(0, BeamX);
  A2600_LatchMissile(1, BeamX);
  A2600_LatchBall(BeamX);
End;

{ Avancer le faisceau jusqu a NewX en rendant les pixels deja "passes". }
{ Appelee avant chaque ecriture TIA pour rendu cycle-accurate.         }
Procedure A2600_AdvanceTo(NewX: Integer);
Begin
  If NewX < 0 Then NewX := 0;
  If NewX > 160 Then NewX := 160;
  If (A2600_CurY >= 0) And (A2600_CurY <= 191)
     And (Not A2600_VBLANKAct) And (Not A2600_VSYNCAct) Then
    If NewX - 1 >= A2600_LastX + 1 Then
      A2600_RenderRange(A2600_CurY, A2600_LastX + 1, NewX - 1);
  If NewX - 1 > A2600_LastX Then A2600_LastX := NewX - 1;
End;

{ HMOVE pipeline per-object cycle-accurate.                               }
{ Le strobe HMOVE arme HMOVE_Running. Chaque tick (1 par cycle CPU)       }
{ incremente HMOVE_Counter et, pour chaque objet encore Active, applique  }
{ un "extra clock" si Counter <= |HMx_live| (lecture LIVE chaque tick :   }
{ une ecriture HMx mid-HBLANK affecte le comparateur). Quand Counter      }
{ depasse, le flag Active passe a False et reste latche False jusqu au    }
{ prochain HMOVE_Start.                                                   }
Procedure A2600_HMOVE_Start;
Var K: Integer;
Begin
  A2600_HMOVE_Running := True;
  A2600_HMOVE_Counter := 0;
  For K := 0 To 4 Do A2600_HMxx_Active[K] := True;
End;

Procedure A2600_HMOVE_TickN(N: Integer);
Var T, K: Integer; HM: ShortInt; NewX: Integer;
Begin
  If Not A2600_HMOVE_Running Then Exit;
  For T := 1 To N Do Begin
    Inc(A2600_HMOVE_Counter);
    If A2600_HMOVE_Counter > 15 Then Begin
      A2600_HMOVE_Running := False;
      Exit;
    End;
    For K := 0 To 4 Do Begin
      If A2600_HMxx_Active[K] Then Begin
        HM := 0; NewX := 0;
        Case K Of
          0: Begin HM := A2600_HMP0; NewX := A2600_P0X; End;
          1: Begin HM := A2600_HMP1; NewX := A2600_P1X; End;
          2: Begin HM := A2600_HMM0; NewX := A2600_M0X; End;
          3: Begin HM := A2600_HMM1; NewX := A2600_M1X; End;
          4: Begin HM := A2600_HMBL; NewX := A2600_BLX; End;
        End;
        If (HM > 0) And (A2600_HMOVE_Counter <= HM) Then Begin
          Dec(NewX);
          If NewX < 0 Then NewX := NewX + 160;
        End Else If (HM < 0) And (A2600_HMOVE_Counter <= -HM) Then Begin
          Inc(NewX);
          If NewX > 159 Then NewX := NewX - 160;
        End Else
          A2600_HMxx_Active[K] := False;
        Case K Of
          0: A2600_P0X := NewX;
          1: A2600_P1X := NewX;
          2: A2600_M0X := NewX;
          3: A2600_M1X := NewX;
          4: A2600_BLX := NewX;
        End;
      End;
    End;
  End;
End;

{ Comptage de cycles precis par opcode via CPU6502_LastCyc (table          }
{ CPU6502_CycTab + penalite branche prise). 76 cycles par scanline. WSYNC }
{ termine immediatement le scanline courant.                              }
Procedure A2600_AfterInstr;
Var I, Cyc: Integer; TimRd, StatRd: Byte;
Begin
  Cyc := CPU6502_LastCyc;
  If Cyc <= 0 Then Cyc := 3;   { fallback safety }
  Inc(A2600_LineInstr);
  Inc(A2600_LineCyc, Cyc);
  { Tick du pipeline HMOVE : 1 tick par cycle CPU. }
  If A2600_HMOVE_Running Then A2600_HMOVE_TickN(Cyc);
  { Latch INPT4/5 : capture appui transitoire entre 2 lectures. }
  If A2600_INPTLatchEn Then Begin
    If A2600_KeyFire Then A2600_INPT4Latch := True;
  End;
  { Tick du timer RIOT (Cyc cycles par instruction). }
  If A2600_TimerInterval > 0 Then Begin
    Dec(A2600_TimerCyc, Cyc);
    While A2600_TimerCyc <= 0 Do Begin
      Dec(A2600_TimerVal);
      If A2600_TimerVal < 0 Then Begin
        A2600_TimerExpired := True;
        A2600_TimerVal := A2600_TimerVal And $FF;
        A2600_TimerInterval := 1;   { passe en mode 1-cycle apres underflow }
        Inc(A2600_TimerCyc, 1);
      End Else
        Inc(A2600_TimerCyc, A2600_TimerInterval);
    End;
    TimRd := Byte(A2600_TimerVal And $FF);
    If A2600_TimerExpired Then StatRd := $80 Else StatRd := $00;
    For I := 0 To 3 Do Begin
      CPU6502_Mem[$0284 + I * $0400] := TimRd;     { INTIM }
      CPU6502_Mem[$0285 + I * $0400] := StatRd;    { INSTAT }
    End;
  End;
  If A2600_WSYNCWait Or (A2600_LineCyc >= 76) Then Begin
    { Fin de scanline : rendre la ligne visible si VBLANK off et si  }
    { on n a pas encore depasse les 192 lignes affichables.          }
    A2600_WSYNCWait := False;
    If (Not A2600_VBLANKAct) And (Not A2600_VSYNCAct) Then Begin
      If (A2600_VisLine >= 0) And (A2600_VisLine <= 191) Then
        A2600_AdvanceTo(160);                        { rendre fin de ligne }
      Inc(A2600_VisLine);
    End;
    Inc(A2600_ScanLine);
    A2600_LineCyc := 0;
    A2600_LineInstr := 0;
    { Charge des paddles : 1 scanline = 1 increment tant que VBLANK.7=0. }
    If Not A2600_PadDumped Then Begin
      Inc(A2600_PadCharge[0]);
      Inc(A2600_PadCharge[1]);
      Inc(A2600_PadCharge[2]);
      Inc(A2600_PadCharge[3]);
    End;
    { Nouvelle scanline : reset etat de rendu intra-ligne. }
    A2600_LastX := -1;
    A2600_HMOVEComb := False;
    A2600_PhantomCombX := -1;
    A2600_CurY := A2600_VisLine;
    A2600_ResetScanlineLatches;
    { Appliquer un HMOVE differe (strobe en partie visible de la ligne }
    { precedente). Arme le motion counter ; ticks pendant les ~7       }
    { instructions de HBLANK du nouveau scanline.                      }
    If A2600_HMOVEPending Then Begin
      A2600_HMOVEPending := False;
      A2600_HMOVEComb := True;
      A2600_HMOVE_Start;
    End;
  End;
End;

Procedure A2600_Reset;
Var I: Integer;
Begin
  For I := 0 To $7F Do A2600_TIA[I] := 0;
  For I := 0 To $7F Do A2600_RIOTRam[I] := 0;
  A2600_VSYNCAct := False;
  A2600_VBLANKAct := False;
  A2600_ScanLine := 0;
  A2600_FrameNo := 0;
  A2600_WSYNCWait := False;
  A2600_VisLine := 0;
  A2600_LineCyc := 0;
  A2600_LineInstr := 0;
  A2600_P0X := 0; A2600_P1X := 0;
  A2600_M0X := 0; A2600_M1X := 0; A2600_BLX := 0;
  A2600_HMP0 := 0; A2600_HMP1 := 0;
  A2600_HMM0 := 0; A2600_HMM1 := 0; A2600_HMBL := 0;
  A2600_HMOVEPending := False;
  A2600_HMOVE_Running := False;
  A2600_HMOVE_Counter := 0;
  For I := 0 To 4 Do A2600_HMxx_Active[I] := False;
  A2600_PhantomCombX := -1;
  A2600_GRP0_New := 0; A2600_GRP0_Old := 0;
  A2600_GRP1_New := 0; A2600_GRP1_Old := 0;
  A2600_ENABL_New := 0; A2600_ENABL_Old := 0;
  A2600_VDELP0 := False; A2600_VDELP1 := False; A2600_VDELBL := False;
  A2600_RESMP0 := False; A2600_RESMP1 := False;
  A2600_HMOVEComb := False;
  A2600_LastX := -1;
  A2600_CurY := 0;
  A2600_ResetScanlineLatches;
  A2600_P0LCnt := 1; A2600_P1LCnt := 1;
  A2600_SWACNT := 0;
  A2600_SWBCNT := 0;
  A2600_SWACHA_Out := $FF;
  A2600_SWCHB_Out := $3F;
  A2600_DrivingP0 := False;
  A2600_DriveP0_Pos := 0;
  A2600_DriveF4_Prev := False;
  A2600_BoosterP0 := False;
  A2600_KeyBooster := False;
  A2600_BoostF5_Prev := False;
  A2600_SC_Cfg := 0;
  A2600_SC_WrEn := False;
  FillChar(A2600_CartRAM, SizeOf(A2600_CartRAM), 0);
  FillChar(A2600_E7_RAM1K, SizeOf(A2600_E7_RAM1K), 0);
  FillChar(A2600_E7_RAM256, SizeOf(A2600_E7_RAM256), 0);
  A2600_E7_LowerRAM := False;
  A2600_E7_LowerROM := 0;
  A2600_E7_R256Bank := 0;
  A2600_KeyEsc := False;
  A2600_KeyJoy := 0;
  A2600_KeyFire := False;
  A2600_INPTLatchEn := False;
  A2600_INPT4Latch := False;
  A2600_INPT5Latch := False;
  { Paddles : positions par defaut au centre, dump actif a froid. }
  A2600_Paddle[0] := 128; A2600_Paddle[1] := 128;
  A2600_Paddle[2] := 128; A2600_Paddle[3] := 128;
  A2600_PadCharge[0] := 0; A2600_PadCharge[1] := 0;
  A2600_PadCharge[2] := 0; A2600_PadCharge[3] := 0;
  A2600_PadDumped := True;
  A2600_LinesPerFrame := 262;
  A2600_PAL := False;
  A2600_LastVsyncLine := -1;
  A2600_FrameLineHist[0] := 0; A2600_FrameLineHist[1] := 0;
  A2600_FrameLineHist[2] := 0; A2600_FrameLineHist[3] := 0;
  A2600_FrameLineIdx := 0;
  A2600_FrameReady := False;
  A2600_TimerVal := 0;
  A2600_TimerInterval := 0;     { 0 = pas de timer arme }
  A2600_TimerCyc := 0;
  A2600_TimerExpired := False;
  FillChar(A2600_FB, SizeOf(A2600_FB), 0);
  FillChar(A2600_FBPrev, SizeOf(A2600_FBPrev), $FF);
  A2600_FBFirst := True;
  { Ports RIOT I/O dans CPU6502_Mem pour que LDA fonctionne sans   }
  { passer par le dispatcher.                                       }
  CPU6502_Mem[$0280] := $FF;   { SWCHA - aucun joystick deplace }
  CPU6502_Mem[$0282] := $3F;   { SWCHB - aucun switch console }
  CPU6502_Mem[$0284] := 0;     { INTIM - timer toujours 0 }
  CPU6502_Mem[$028C] := $80;   { INPT4 - bouton P0 relache }
  CPU6502_Mem[$028D] := $80;   { INPT5 - bouton P1 relache }
End;

