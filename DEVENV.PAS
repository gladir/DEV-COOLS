 End;

 { Etat d un disque virtuel FAT12/16/32 monte via /DISK0, /DISK1,
   /DISK80 ou /DISK81 }
 TFatVol = Record
  Mounted        : Boolean;
  IsD64          : Boolean;        { image Commodore 64 .D64        }
  D64Tracks      : Byte;           { nombre de pistes (35 ou 40)    }
  IsH8D          : Boolean;        { image Heath/Zenith .H8D (HDOS/CP-M-80/UCSD p-System) }
  H8DFsType      : Byte;           { 1=HDOS 2=CP/M-80 3=UCSD p-System (voir H8D_FS_*) }
  FATType        : Byte;           { 12, 16 ou 32                   }
  BytesPerSector : Word;
  SectorsPerCluster: Byte;
  ReservedSectors: Word;
  NumFATs        : Byte;
  RootEntries    : Word;           { 0 pour FAT32 (racine = cluster) }
  RootCluster    : LongInt;        { FAT32 seulement : 1er cluster racine }
  TotalSectors   : LongInt;
  SectorsPerFAT  : LongInt;
  PartitionStart : LongInt;        { LBA de la partition FAT (MBR disque
                                      dur) ; 0 pour une image disquette
                                      ou un disque dur sans MBR        }
  FATStart       : LongInt;
  RootStart      : LongInt;
  DataStart      : LongInt;
  RootDirSectors : LongInt;        { 0 pour FAT32 }
  ClusterCount   : LongInt;
  VolLabel       : String[11];
  CachedFatLBA   : LongInt;
  CachedFatBuf   : Array[0..511] Of Byte;
 End;

 { Volume CD-ROM ISO9660 monte en lecture seule depuis une image .iso     }
 { (/CDROM0:/CDROM1:) - voir Emu_CdromOpenOne/Emu_IsoResolve. Contrairement}
 { a TFatVol (FAT12/16, mutable, avec cache), c est une simple "racine"   }
 { de depart (LBA+taille de l extent racine ISO9660) : la resolution de   }
 { chemin parcourt directement les enregistrements de repertoire (pas de  }
 { table des chemins ni d arbre pre-charge), suffisant pour un lecteur    }
 { en lecture seule sans ecriture. }
 TEmuCdromVol = Record
  Open          : Boolean;
  FileName      : String;
  F             : File;
  IsoSize       : LongInt;
  RootLBA       : LongInt;
  RootSize      : LongInt;
  VolLabel      : String[32];
  CopyrightFile : String[38];
  AbstractFile  : String[37];
  BiblioFile    : String[37];
  DriveLetter   : Byte;          { 0=A: .. 25=Z: ; 255 si Open=False }
 End;

 { Un enregistrement de repertoire ISO9660 decode (voir                  }
 { Emu_IsoEntryFromRecord) - Name est deja en majuscules, sans le         }
 { suffixe ";n" de version, tronque a 12 caracteres (8.3) si l identifiant}
 { d origine (Niveau 2, jusqu a 30 caracteres) est plus long - voir le    }
 { commentaire pres de Emu_IsoEntryFromRecord pour cette simplification. }
 TEmuIsoEntry = Record
  IsDir  : Boolean;
  Name   : String[12];
  LBA    : LongInt;
  Size   : LongInt;
  Year, Month, Day, Hour, Minute, Second : Byte;
 End;

 { Un secteur logique ISO9660 brut (2048 octets, voir EMU_ISO_SECTOR). }
 TEmuIsoSector = Array[0..EMU_ISO_SECTOR - 1] Of Byte;

 { Norton Commander (5e shell du panneau Terminal, DEVENV.PAS) - navigation
   double-panneau sur la disquette virtuelle FAT deja utilisee par les 4
   autres shells (jamais le systeme de fichiers reel de la machine). }
 TNCEntry = Record
  Name    : String[80];            { nom (8.3 sur disque virtuel, long }
                                    { possible sur le systeme hote)  }
  Size    : LongInt;                { taille en octets (0 si repert.)}
  IsDir   : Boolean;                { True = sous-repertoire         }
  FTime   : Word;                   { heure DOS empaquetee (FAT)     }
  FDate   : Word;                   { date DOS empaquetee (FAT)      }
  PackedDT: LongInt;                { date/heure empaquetee (hote,   }
                                    { format SearchRec.Time/UnpackTime) }
  Cluster : LongInt;                { 1er cluster (disque virtuel)   }
 End;

 TNCPane = Record
  Path      : String;              { chemin courant (chemin hote absolu }
                                    { avec lettre de lecteur, ou '\..'       }
                                    { sur disque virtuel)            }
  Entries   : Array[0..MAX_NC_ENTRIES - 1] Of TNCEntry;
  Count     : Integer;
  Cursor    : Integer;             { entree selectionnee (0-based)  }
  ScrollTop : Integer;             { 1ere entree visible             }
  Marked    : Array[0..MAX_NC_ENTRIES - 1] Of Boolean; { selection multiple }
  MarkCount : Integer;
  SortMode  : Integer;             { 0=Nom 1=Extension 2=Heure(date) }
                                    { 3=Taille 4=Desordre (menu Gauche/Droite) }
  InfoMode  : Boolean;             { menu Gauche/Droite, item "Info" -    }
                                    { affiche l espace disque/l etiquette  }
                                    { de volume/les stats du repertoire       }
                                    { a la place de la liste de fichiers }
 End;

 { TODO NC 2/3 : navigation, dialogues modaux pour les operations sur    }
 { fichiers (F5 Copier, F6 RenDep, F7 CreRep, F8 Supprimer), apercu             }
 { (F3) et menu deroulant complet (F9). }
 TNCMode = (
  ncBrowse,          { navigation normale                            }
  ncPromptMkDir,     { F7 : saisie du nom du nouveau repertoire       }
  ncPromptCopy,      { F5 : saisie du chemin destination              }
  ncPromptRenMov,    { F6 : saisie du nouveau nom/chemin              }
  ncConfirmDelete,   { F8 : confirmation Oui/Non                      }
  ncViewFile,        { F3 : apercu texte en lecture seule             }
  ncMenuBar,         { F9 : menu deroulant Gauche/Fichiers/Disque/    }
                     { Commandes/Droite                               }
  ncMessage,         { message simple (ex: "non implemente"), toute   }
                     { touche le ferme                                }
  ncHistory,         { Commandes/Historique : liste des commandes           }
                     { tapees dans ce panneau (NC.PAS: DialogHistory)  }
  ncTree,            { Commandes/Arbre NCD : arborescence des                 }
                     { sous-repertoires du lecteur du panneau actif    }
  ncViewSearch,      { F7 dans la visionneuse F3 : saisie du texte     }
                     { recherche                                      }
  ncViewSelectViewer,{ F8 dans la visionneuse F3 : choix du format          }
                     { d affichage (WPVIEW: "Select Viewer")          }
  ncChangeDrive      { Alt+F1 (panneau gauche) / Alt+F2 (panneau droite) :  }
                     { choix de la lettre de lecteur (NC.PAS: ChangeDrive), }
                     { voir NCBuildChangeDriveList/NCState.Cd*             }
 );

 TNCTreeNode = Record
  Path  : String;                  { chemin absolu complet          }
  Depth : Integer;                 { niveau d indentation (0=racine) }
 End;

 TNCState = Record
  Panes       : Array[0..1] Of TNCPane;
  Active      : Integer;           { 0 = gauche, 1 = droite          }
  Slot        : ShortInt;          { -1 = systeme hote, >=0 = FatVol }
  Mode        : TNCMode;
  Initialized : Boolean;
  CharW       : Integer;           { largeur de caractere mesuree    }
  CharH       : Integer;           { hauteur de ligne mesuree        }
  PromptBuf   : String;            { texte saisi dans le dialogue actif }
  MessageReturnMode : TNCMode;     { mode a restaurer apres fermeture de   }
                                    { ncMessage (pas toujours ncBrowse -    }
                                    { ex: message depuis la visionneuse F3) }
  ViewLines   : Array[0..MAX_NC_VIEW_LINES - 1] Of String; { lignes texte  }
  ViewCount   : Integer;
  ViewTop     : Integer;           { defilement (ligne ou rangee hex)  }
  ViewHex     : Boolean;           { F4 : False=Texte True=Hexadecimal }
  ViewWrap    : Boolean;           { F2 : renvoi a la ligne (mode Texte) }
  ViewCol     : Integer;           { defilement horizontal (mode Texte      }
                                    { non renvoye a la ligne)          }
  ViewCharsPerRow : Integer;       { cache : largeur d affichage en           }
                                    { caracteres, mesuree au dernier tracer }
  ViewFileName: String;            { chemin complet du fichier visualise }
  ViewFileSize: LongInt;           { taille reelle du fichier (peut          }
                                    { depasser MAX_NC_VIEW_RAW)        }
  ViewRaw     : Array[0..MAX_NC_VIEW_RAW - 1] Of Byte; { octets bruts     }
  ViewRawSize : LongInt;           { nombre d octets reellement charges }
  ViewSearchBuf : String;          { F7 : texte recherche              }
  ViewSelIdx  : Integer;           { F8 : curseur dans Select Viewer  }
  MenuTop     : Integer;           { 0..4 : menu superieur selectionne }
  MenuItem    : Integer;           { item selectionne dans le menu deroulant }
  HistCursor  : Integer;           { index (1-based) dans TP.TermHistory }
  TreeNodes   : Array[0..MAX_NC_TREE_NODES - 1] Of TNCTreeNode;
  TreeCount   : Integer;
  TreeCursor  : Integer;           { 0-based }
  TreeTop     : Integer;           { defilement de l arbre          }
  CdSide      : Integer;           { 0=gauche 1=droite - panneau ayant  }
                                    { declenche Alt+F1/Alt+F2            }
  CdCount     : Integer;
  CdLetter    : Array[0..MAX_NC_CD_ENTRIES - 1] Of Char;
  CdIsVirt    : Array[0..MAX_NC_CD_ENTRIES - 1] Of Boolean;
  CdSlotIdx   : Array[0..MAX_NC_CD_ENTRIES - 1] Of Integer;
  CdCursor    : Integer;
 End;

