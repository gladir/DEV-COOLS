 End;
 { Initialiser le CPU et la memoire emulee 1Mo }
 Emu_InitComputer(P.CPU);
 If Not P.CPU.MemReady Then Begin
  P.CurFg := 12;
  EmuVScr_WriteStr(P, 'Erreur : impossible de creer le swap memoire.');
  P.CurFg := OldFg;
