{ --- Dessiner l editeur complet --- }

Procedure DrawEditor(Var Ed: TEditor);
Var
 I, J: Integer;
 LineNo: LongInt;
 S: String;
 XPos, YPos: Integer;
 Len: Integer;
 FullLine: String;
 Colors: Array[0..255] Of Byte;
 Ch: String[1];
 IsPascal: Boolean;
 IsC: Boolean;
 IsCSharp: Boolean;
 IsVBNet: Boolean;
 IsVB6: Boolean;
 IsLua: Boolean;
 IsXpp: Boolean;
 IsPowerFX: Boolean;
 IsOberon: Boolean;
 IsPerl: Boolean;
 IsPL1: Boolean;
 IsPHP: Boolean;
 IsRust: Boolean;
 IsSAS: Boolean;
 IsRuby: Boolean;
 IsSnobol: Boolean;
 IsMod3: Boolean;
 IsCobol: Boolean;
 IsAda: Boolean;
 IsAbap: Boolean;
 IsAWK: Boolean;
 IsPSP: Boolean;
 IsJSP: Boolean;
 IsJava: Boolean;
 IsPython: Boolean;
 IsXML: Boolean;
 IsJSON: Boolean;
 IsYAML: Boolean;
 IsSQL: Boolean;
 IsAsm: Boolean;
 Ext: String;
Begin
 { Detecter si le fichier est du Pascal }
 Ext := UpCaseStr(ExtractFileExt(Ed.Buffer.FileName));
 IsPascal := (Ext = '.PAS') Or (Ext = '.PP') Or (Ext = '.INC') Or
             (Ext = '.DPR') Or (Ext = '.LPR');
 IsC := (Ext = '.C') Or (Ext = '.H');
 IsCSharp := (Ext = '.CS');
 IsVBNet := (Ext = '.VB');
 IsVB6   := (Ext = '.BAS') Or (Ext = '.FRM');
 IsLua      := (Ext = '.LUA');
 IsXpp      := (Ext = '.XPP');
 IsPowerFX  := (Ext = '.PFX');
 IsOberon   := (Ext = '.OBN') Or (Ext = '.OB2') Or (Ext = '.MOD');
 IsPerl     := (Ext = '.PL') Or (Ext = '.PM') Or (Ext = '.PLS');
 IsPL1      := (Ext = '.PLI') Or (Ext = '.PL1');
 IsPHP      := (Ext = '.PHP') Or (Ext = '.PHP5') Or (Ext = '.PHTML');
 IsRust     := (Ext = '.RS');
 IsSAS      := (Ext = '.SAS');
 IsRuby     := (Ext = '.RB') Or (Ext = '.RBW');
 IsSnobol   := (Ext = '.SBL') Or (Ext = '.SNO');
 IsMod3     := (Ext = '.M3') Or (Ext = '.I3') Or (Ext = '.MG') Or (Ext = '.IG');
 IsCobol    := (Ext = '.CBL') Or (Ext = '.COB') Or (Ext = '.COBOL');
 IsAda := (Ext = '.ADB') Or (Ext = '.ADS') Or (Ext = '.ADA');
 IsAbap := (Ext = '.ABAP') Or (Ext = '.ABP');
 IsAWK := (Ext = '.AWK');
 IsXML := (Ext = '.XML')     Or (Ext = '.XAML')   Or
          (Ext = '.HTM')     Or (Ext = '.HTML')   Or
          (Ext = '.CSPROJ')  Or (Ext = '.VBPROJ') Or
          (Ext = '.DPPROJ')  Or (Ext = '.ADAPROJ')Or
          (Ext = '.FSPROJ')  Or (Ext = '.PROJ')   Or
          (Ext = '.CONFIG')  Or (Ext = '.RESX')   Or
          (Ext = '.SVG')     Or (Ext = '.PLIST');
 IsJSON := (Ext = '.JSON') Or (Ext = '.JSONC') Or
           (Ext = '.JSON5');
 IsYAML := (Ext = '.YML') Or (Ext = '.YAML');
 IsSQL := (Ext = '.SQL') Or (Ext = '.DDL') Or (Ext = '.DML');
 IsPSP := (Ext = '.PSP');
 IsJSP := (Ext = '.JSP');
 { EXTENSION (2026-08-02) : .JPP (MS J++, tres proche syntaxiquement de     }
 { Java - memes mots-cles/chaines/commentaires, voir JPPCW32.PAS) reutilise  }
 { le highlighter Java plutot que de dupliquer une table de mots-cles       }
 { quasi identique - demande utilisateur, "les fichiers .jpp ne             }
 { supportent pas la coloration syntaxique". }
 IsJava := (Ext = '.JAVA') Or (Ext = '.JPP');
 IsPython := (Ext = '.PY');
 IsAsm := (Ext = '.ASM') Or (Ext = '.S');
 { Mettre a jour la gouttiere }
 Ed.GutterWidth := CalcGutterWidth(Ed.Buffer.LineCount, Ed.CharWidth);
 Ed.VisibleCols := (Ed.Width - Ed.GutterWidth) Div Ed.CharWidth;
 { Effacer la zone de l editeur }
 SetColor(CLR_EDITOR_BG);
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(Ed.X + Ed.GutterWidth, Ed.Y,
     Ed.X + Ed.Width - 1, Ed.Y + Ed.Height - 1);
 { Dessiner la surbrillance de la ligne courante }
 DrawLineHighlight(Ed);
 { Dessiner la selection }
 DrawSelection(Ed, EditorSel);
 { Dessiner le texte }
 For I := 0 To Ed.VisibleLines - 1 Do Begin
  LineNo := Ed.ScrollLine + I;
  If LineNo < Ed.Buffer.LineCount Then Begin
   FullLine := Ed.Buffer.Lines[LineNo];
   YPos := Ed.Y + I * Ed.CharHeight;
   XPos := Ed.X + Ed.GutterWidth;
   { Coloration syntaxique }
   FillChar(Colors, SizeOf(Colors), 0); { noir par defaut }
   If IsPascal And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPascalLine(PascalHL, FullLine, Colors)
   Else If IsC And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightCLine(CHL, FullLine, Colors)
   Else If IsCSharp And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightCSharpLine(CSharpHL, FullLine, Colors)
   Else If IsVBNet And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightVBNetLine(VBNetHL, FullLine, Colors)
   Else If IsVB6 And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightVBNetLine(VB6HL, FullLine, Colors)
   Else If IsLua And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightLuaLine(LuaHL, FullLine, Colors)
   Else If IsXpp And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightXppLine(XppHL, FullLine, Colors)
   Else If IsPowerFX And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPowerFXLine(PowerFXHL, FullLine, Colors)
   Else If IsOberon And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightOberonLine(OberonHL, FullLine, Colors)
   Else If IsPerl And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPerlLine(PerlHL, FullLine, Colors)
   Else If IsPL1 And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPL1Line(PL1HL, FullLine, Colors)
   Else If IsPHP And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPHPLine(PHPHL, FullLine, Colors)
   Else If IsRust And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightRustLine(RustHL, FullLine, Colors)
   Else If IsSAS And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightSASLine(SASHL, FullLine, Colors)
   Else If IsRuby And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightRubyLine(RubyHL, FullLine, Colors)
   Else If IsSnobol And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightSnobolLine(SnobolHL, FullLine, Colors)
   Else If IsMod3 And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightMod3Line(Mod3HL, FullLine, Colors)
   Else If IsCobol And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightCobolLine(CobolHL, FullLine, Colors)
   Else If IsAda And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightAdaLine(AdaHL, FullLine, Colors)
   Else If IsAbap And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightAbapLine(AbapHL, FullLine, Colors)
   Else If IsAWK And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightAWKLine(AWKHL, FullLine, Colors)
   Else If IsPSP And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPSPLine(PSPHL, FullLine, Colors)
   Else If IsJSP And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightJSPLine(JSPHL, FullLine, Colors)
   Else If IsJava And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightJavaLine(JavaHL, FullLine, Colors)
   Else If IsPython And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightPythonLine(PythonHL, FullLine, Colors)
   Else If IsXML And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightXMLLine(XMLHL, FullLine, Colors)
   Else If IsJSON And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightJSONLine(FullLine, Colors)
   Else If IsYAML And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightYAMLLine(FullLine, Colors)
   Else If IsSQL And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightSQLLine(FullLine, Colors)
   Else If IsAsm And (Length(FullLine) > 0) And
      (Length(FullLine) <= 255) Then
    HighlightAsmLine(AsmHL, FullLine, Colors);
   { Extraire la partie visible }
   If Ed.ScrollCol <= Length(FullLine) Then Begin
    Len := Length(FullLine) - Ed.ScrollCol + 1;
    If Len > Ed.VisibleCols Then Len := Ed.VisibleCols;
    { Dessiner caractere par caractere avec la bonne couleur }
    For J := 0 To Len - 1 Do Begin
     SetColor(Colors[Ed.ScrollCol - 1 + J]);
     Ch := FullLine[Ed.ScrollCol + J];
     OutTextXY(XPos + J * Ed.CharWidth, YPos + 1, Ch);
    End;
   End;
  End;
 End;
 { Dessiner la gouttiere }
 DrawGutter(Ed);
 { Dessiner le curseur }
 DrawCursor(Ed);
End;

{ --- Assurer que le curseur est visible (defilement automatique) --- }

Procedure EnsureCursorVisible(Var Ed: TEditor);
Begin
 { Defilement vertical }
 If Ed.CursorLine < Ed.ScrollLine Then
  Ed.ScrollLine := Ed.CursorLine;
 If Ed.CursorLine >= Ed.ScrollLine + Ed.VisibleLines Then
  Ed.ScrollLine := Ed.CursorLine - Ed.VisibleLines + 1;
 If Ed.ScrollLine < 0 Then
  Ed.ScrollLine := 0;
 { Defilement horizontal }
 If Ed.CursorCol < Ed.ScrollCol Then
  Ed.ScrollCol := Ed.CursorCol;
 If Ed.CursorCol >= Ed.ScrollCol + Ed.VisibleCols Then
  Ed.ScrollCol := Ed.CursorCol - Ed.VisibleCols + 1;
 If Ed.ScrollCol < 1 Then
  Ed.ScrollCol := 1;
End;

{ --- Aller a une ligne donnee --- }

Procedure GotoLine(Var Ed: TEditor; ALine: LongInt);
Begin
 If ALine < 0 Then ALine := 0;
 If ALine >= Ed.Buffer.LineCount Then
  ALine := Ed.Buffer.LineCount - 1;
 Ed.CursorLine := ALine;
 EnsureCursorVisible(Ed);
End;

{ --- Aller a une colonne donnee --- }

Procedure GotoColumn(Var Ed: TEditor; ACol: LongInt);
Begin
 If ACol < 1 Then ACol := 1;
 Ed.CursorCol := ACol;
 EnsureCursorVisible(Ed);
End;

{ --- Obtenir l indentation de la ligne courante --- }

Function GetIndentation(S: String): String;
Var
 I: Integer;
Begin
 I := 1;
 While (I <= Length(S)) And (S[I] In [' ', #9]) Do
  Inc(I);
 GetIndentation := Copy(S, 1, I - 1);
End;

{ --- Gerer les clics souris dans l editeur --- }

Procedure HandleEditorMouse(Var Ed: TEditor; Ev: TEvent);
Var
 NewLine : LongInt;
 NewCol  : LongInt;
 LineLen : Integer;
Begin
 { Verifier que le clic est dans la zone texte de l editeur }
 If (Ev.MouseX < Ed.X + Ed.GutterWidth) Or
    (Ev.MouseX >= Ed.X + Ed.Width) Or
    (Ev.MouseY < Ed.Y) Or
    (Ev.MouseY >= Ed.Y + Ed.Height) Then Exit;
 { Convertir les coordonnees pixel en ligne/colonne }
 NewLine := Ed.ScrollLine +
            (Ev.MouseY - Ed.Y) Div Ed.CharHeight;
 NewCol := Ed.ScrollCol +
           (Ev.MouseX - Ed.X - Ed.GutterWidth) Div Ed.CharWidth;
 { Borner la ligne }
 If NewLine < 0 Then NewLine := 0;
 If NewLine >= Ed.Buffer.LineCount Then
  NewLine := Ed.Buffer.LineCount - 1;
 If NewLine < 0 Then NewLine := 0;
 { Borner la colonne }
 If NewCol < 1 Then NewCol := 1;
 LineLen := Length(Ed.Buffer.Lines[NewLine]);
 If NewCol > LineLen + 1 Then
  NewCol := LineLen + 1;

 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  { Clic : deplacer le curseur et demarrer une possible selection }
  ClearSelection(EditorSel);
  Ed.CursorLine := NewLine;
  Ed.CursorCol := NewCol;
  StartSelection(EditorSel, NewLine, NewCol);
  EnsureCursorVisible(Ed);
  DrawEditor(Ed);
  DrawCursor(Ed);
 End
 Else If Ev.Kind = EV_MOUSE_MOVE Then Begin
  { Glissement : etendre la selection si un bouton est enfonce }
  If Ev.MouseBtn <> MB_NONE Then Begin
   Ed.CursorLine := NewLine;
   Ed.CursorCol := NewCol;
   ExtendSelection(EditorSel, NewLine, NewCol);
   EnsureCursorVisible(Ed);
   DrawEditor(Ed);
   DrawCursor(Ed);
  End;
 End
 Else If Ev.Kind = EV_MOUSE_UP Then Begin
  { Relachement : finaliser la selection }
  Ed.CursorLine := NewLine;
  Ed.CursorCol := NewCol;
  ExtendSelection(EditorSel, NewLine, NewCol);
  { Si debut = fin, pas de selection reelle }
  If (EditorSel.StartLine = EditorSel.EndLine) And
     (EditorSel.StartCol = EditorSel.EndCol) Then
   ClearSelection(EditorSel);
  EnsureCursorVisible(Ed);
  DrawEditor(Ed);
  DrawCursor(Ed);
 End;
End;

{ --- Gerer les touches de l editeur --- }

Procedure HandleEditorKey(Var Ed: TEditor; Ev: TEvent);
Var
 S, Indent: String;
 LineLen: Integer;
 TabStr: String;
 I: Integer;
 OldCh: Char;
Begin
 { Traiter les caracteres (EV_KEY_CHAR) }
 If Ev.Kind = EV_KEY_CHAR Then Begin
  Case Ev.KeyChar Of
   { Backspace }
   #8: Begin
    If Ed.CursorCol > 1 Then Begin
     Dec(Ed.CursorCol);
     S := Ed.Buffer.Lines[Ed.CursorLine];
     If Ed.CursorCol <= Length(S) Then
      PushUndo(EditorUndo, UA_DELETE, Ed.CursorLine,
       Ed.CursorCol, '', S[Ed.CursorCol], 0);
     DeleteChar(Ed.Buffer, Ed.CursorLine, Ed.CursorCol);
    End Else If Ed.CursorLine > 0 Then Begin
     LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine - 1]);
     PushUndo(EditorUndo, UA_JOIN_LINE, Ed.CursorLine - 1,
      LineLen + 1, '', '', 0);
     Ed.Buffer.Lines[Ed.CursorLine - 1] :=
      Ed.Buffer.Lines[Ed.CursorLine - 1] +
      Ed.Buffer.Lines[Ed.CursorLine];
     DeleteLine(Ed.Buffer, Ed.CursorLine);
     Dec(Ed.CursorLine);
     Ed.CursorCol := LineLen + 1;
     Ed.Buffer.Modified := True;
    End;
    EnsureCursorVisible(Ed);
   End;
   { Tab }
   #9: Begin
    TabStr := '';
    For I := 1 To Ed.TabSize Do
     TabStr := TabStr + ' ';
    PushUndo(EditorUndo, UA_INSERT, Ed.CursorLine,
     Ed.CursorCol, TabStr, '', 0);
    InsertText(Ed.Buffer, Ed.CursorLine, Ed.CursorCol, TabStr);
    Inc(Ed.CursorCol, Ed.TabSize);
    EnsureCursorVisible(Ed);
   End;
   { Enter }
   #13: Begin
    PushUndo(EditorUndo, UA_SPLIT_LINE, Ed.CursorLine,
     Ed.CursorCol, '', '', 0);
    S := Ed.Buffer.Lines[Ed.CursorLine];
    InsertLine(Ed.Buffer, Ed.CursorLine + 1,
               Copy(S, Ed.CursorCol, Length(S) - Ed.CursorCol + 1));
    Ed.Buffer.Lines[Ed.CursorLine] :=
     Copy(S, 1, Ed.CursorCol - 1);
    Ed.Buffer.Modified := True;
    Inc(Ed.CursorLine);
    If Ed.AutoIndent Then Begin
     Indent := GetIndentation(
      Ed.Buffer.Lines[Ed.CursorLine - 1]);
     If Length(Indent) > 0 Then Begin
      Ed.Buffer.Lines[Ed.CursorLine] :=
       Indent + Ed.Buffer.Lines[Ed.CursorLine];
      Ed.CursorCol := Length(Indent) + 1;
     End Else
      Ed.CursorCol := 1;
    End Else
     Ed.CursorCol := 1;
    EnsureCursorVisible(Ed);
   End;
  Else
   { Caracteres imprimables }
   If (Ord(Ev.KeyChar) >= 32) And (Ord(Ev.KeyChar) <= 126) Then Begin
    If Ed.InsertMode Then Begin
     PushUndo(EditorUndo, UA_INSERT, Ed.CursorLine,
      Ed.CursorCol, Ev.KeyChar, '', 0);
     InsertChar(Ed.Buffer, Ed.CursorLine, Ed.CursorCol,
                Ev.KeyChar);
    End Else Begin
     S := Ed.Buffer.Lines[Ed.CursorLine];
     If Ed.CursorCol <= Length(S) Then Begin
      OldCh := S[Ed.CursorCol];
      PushUndo(EditorUndo, UA_REPLACE, Ed.CursorLine,
       Ed.CursorCol, Ev.KeyChar, OldCh, 0);
      S[Ed.CursorCol] := Ev.KeyChar;
     End Else Begin
      PushUndo(EditorUndo, UA_INSERT, Ed.CursorLine,
       Ed.CursorCol, Ev.KeyChar, '', 0);
      S := S + Ev.KeyChar;
     End;
     Ed.Buffer.Lines[Ed.CursorLine] := S;
     Ed.Buffer.Modified := True;
    End;
    Inc(Ed.CursorCol);
    EnsureCursorVisible(Ed);
   End;
  End;
  Exit;
 End;

 { Traiter les touches speciales (EV_KEY_DOWN) }
 If Ev.Kind <> EV_KEY_DOWN Then Exit;

 Case Ev.KeyCode Of
  { Fleche haut }
  72: Begin
   If Ed.CursorLine > 0 Then Begin
    Dec(Ed.CursorLine);
    LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine]);
    If Ed.CursorCol > LineLen + 1 Then
     Ed.CursorCol := LineLen + 1;
   End;
   EnsureCursorVisible(Ed);
  End;
  { Fleche bas }
  80: Begin
   If Ed.CursorLine < Ed.Buffer.LineCount - 1 Then Begin
    Inc(Ed.CursorLine);
    LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine]);
    If Ed.CursorCol > LineLen + 1 Then
     Ed.CursorCol := LineLen + 1;
   End;
   EnsureCursorVisible(Ed);
  End;
  { Fleche gauche }
  75: Begin
   If Ed.CursorCol > 1 Then
    Dec(Ed.CursorCol)
   Else If Ed.CursorLine > 0 Then Begin
    Dec(Ed.CursorLine);
    Ed.CursorCol := Length(Ed.Buffer.Lines[Ed.CursorLine]) + 1;
   End;
   EnsureCursorVisible(Ed);
  End;
  { Fleche droite }
  77: Begin
   LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine]);
   If Ed.CursorCol <= LineLen Then
    Inc(Ed.CursorCol)
   Else If Ed.CursorLine < Ed.Buffer.LineCount - 1 Then Begin
    Inc(Ed.CursorLine);
    Ed.CursorCol := 1;
   End;
   EnsureCursorVisible(Ed);
  End;
  { Home }
  71: Begin
   Ed.CursorCol := 1;
   EnsureCursorVisible(Ed);
  End;
  { End }
  79: Begin
   Ed.CursorCol := Length(Ed.Buffer.Lines[Ed.CursorLine]) + 1;
   EnsureCursorVisible(Ed);
  End;
  { PgUp }
  73: Begin
   Dec(Ed.CursorLine, Ed.VisibleLines);
   If Ed.CursorLine < 0 Then Ed.CursorLine := 0;
   Dec(Ed.ScrollLine, Ed.VisibleLines);
   If Ed.ScrollLine < 0 Then Ed.ScrollLine := 0;
   LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine]);
   If Ed.CursorCol > LineLen + 1 Then
    Ed.CursorCol := LineLen + 1;
   EnsureCursorVisible(Ed);
  End;
  { PgDn }
  81: Begin
   Inc(Ed.CursorLine, Ed.VisibleLines);
   If Ed.CursorLine >= Ed.Buffer.LineCount Then
    Ed.CursorLine := Ed.Buffer.LineCount - 1;
   Inc(Ed.ScrollLine, Ed.VisibleLines);
   If Ed.ScrollLine > Ed.Buffer.LineCount - Ed.VisibleLines Then Begin
    Ed.ScrollLine := Ed.Buffer.LineCount - Ed.VisibleLines;
    If Ed.ScrollLine < 0 Then Ed.ScrollLine := 0;
   End;
   LineLen := Length(Ed.Buffer.Lines[Ed.CursorLine]);
   If Ed.CursorCol > LineLen + 1 Then
    Ed.CursorCol := LineLen + 1;
   EnsureCursorVisible(Ed);
  End;
  { Insert }
  82: Begin
   Ed.InsertMode := Not Ed.InsertMode;
  End;
  { Delete }
  83: Begin
   S := Ed.Buffer.Lines[Ed.CursorLine];
   If (Ed.CursorCol >= 1) And (Ed.CursorCol <= Length(S)) Then
    PushUndo(EditorUndo, UA_DELETE, Ed.CursorLine,
     Ed.CursorCol, '', S[Ed.CursorCol], 0)
   Else If (Ed.CursorCol > Length(S)) And
           (Ed.CursorLine < Ed.Buffer.LineCount - 1) Then
    PushUndo(EditorUndo, UA_JOIN_LINE, Ed.CursorLine,
     Length(S) + 1, '', '', 0);
   DeleteChar(Ed.Buffer, Ed.CursorLine, Ed.CursorCol);
  End;
 End;
End;

{ --- Ctrl+Home : debut du fichier --- }

Procedure EditorCtrlHome(Var Ed: TEditor);
Begin
 Ed.CursorLine := 0;
 Ed.CursorCol := 1;
 Ed.ScrollLine := 0;
 Ed.ScrollCol := 1;
End;

{ --- Ctrl+End : fin du fichier --- }

Procedure EditorCtrlEnd(Var Ed: TEditor);
Begin
 If Ed.Buffer.LineCount > 0 Then Begin
  Ed.CursorLine := Ed.Buffer.LineCount - 1;
  Ed.CursorCol := Length(Ed.Buffer.Lines[Ed.CursorLine]) + 1;
 End Else Begin
  Ed.CursorLine := 0;
  Ed.CursorCol := 1;
 End;
 EnsureCursorVisible(Ed);
End;

{ --- Verifier si le curseur est a une position valide --- }

Function IsCursorValid(Var Ed: TEditor): Boolean;
Begin
 IsCursorValid := (Ed.CursorLine >= 0) And
                  (Ed.CursorLine < Ed.Buffer.LineCount) And
                  (Ed.CursorCol >= 1);
End;

{ --- Obtenir le numero de la ligne courante (1-based) --- }

Function GetCursorLineNumber(Var Ed: TEditor): LongInt;
Begin
 GetCursorLineNumber := Ed.CursorLine + 1;
End;

{ --- Obtenir le numero de la colonne courante --- }

Function GetCursorColumnNumber(Var Ed: TEditor): LongInt;
Begin
 GetCursorColumnNumber := Ed.CursorCol;
End;

{ --- Obtenir le contenu de la ligne courante --- }

Function GetCurrentLine(Var Ed: TEditor): String;
Begin
 If (Ed.CursorLine >= 0) And
    (Ed.CursorLine < Ed.Buffer.LineCount) Then
  GetCurrentLine := Ed.Buffer.Lines[Ed.CursorLine]
 Else
  GetCurrentLine := '';
End;

{ --- Obtenir le caractere sous le curseur --- }

Function GetCharAtCursor(Var Ed: TEditor): Char;
Var
 S: String;
Begin
 S := GetCurrentLine(Ed);
 If (Ed.CursorCol >= 1) And (Ed.CursorCol <= Length(S)) Then
  GetCharAtCursor := S[Ed.CursorCol]
 Else
  GetCharAtCursor := ' ';
End;

{ --- Compter les lignes visibles non vides --- }

Function CountVisibleNonEmpty(Var Ed: TEditor): Integer;
Var
 I: Integer;
 Count: Integer;
 LineNo: LongInt;
Begin
 Count := 0;
 For I := 0 To Ed.VisibleLines - 1 Do Begin
  LineNo := Ed.ScrollLine + I;
  If (LineNo >= 0) And (LineNo < Ed.Buffer.LineCount) Then
   If Length(Ed.Buffer.Lines[LineNo]) > 0 Then
    Inc(Count);
 End;
 CountVisibleNonEmpty := Count;
End;

{ --- Verifier si l editeur est en mode insertion --- }

Function IsInsertMode(Var Ed: TEditor): Boolean;
Begin
 IsInsertMode := Ed.InsertMode;
End;

{ ============================================================
  EDITEUR HEXADECIMAL (onglet "Edition hexadecimal")
  ============================================================ }

{ --- Dessiner l editeur hexadecimal --- }

Procedure DrawHexEditor(Var HE: THexEditor);
Var
 R, C: Integer;
 RowOfs, Ofs: LongInt;
 XPos, YPos, AsciiX: Integer;
 B: Byte;
 Ch: String[1];
Begin
 SetColor(CLR_EDITOR_BG);
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(HE.X, HE.Y, HE.X + HE.Width - 1, HE.Y + HE.Height - 1);
 HE.VisibleRows := HE.Height Div HEX_ROW_HEIGHT;
 If (HE.Data = Nil) Or (HE.Size = 0) Then Begin
  SetColor(CLR_EDITOR_TEXT);
  OutTextXY(HE.X + 8, HE.Y + 8, '(fichier vide)');
  Exit;
 End;
 AsciiX := HE.X + HEX_ADDR_WIDTH + HEX_BYTES_PER_ROW * HEX_BYTE_WIDTH + 8;
 For R := 0 To HE.VisibleRows - 1 Do Begin
  RowOfs := HE.ScrollOfs + LongInt(R) * HEX_BYTES_PER_ROW;
  If RowOfs >= HE.Size Then Break;
  YPos := HE.Y + R * HEX_ROW_HEIGHT;
  { Adresse de la rangee }
  SetColor(CLR_MENU_TEXT);
  OutTextXY(HE.X + 4, YPos, HexLong(RowOfs));
  For C := 0 To HEX_BYTES_PER_ROW - 1 Do Begin
   Ofs := RowOfs + C;
   If Ofs >= HE.Size Then Break;
   B := HE.Data^[Ofs];
   XPos := HE.X + HEX_ADDR_WIDTH + C * HEX_BYTE_WIDTH;
   If (B >= 32) And (B <= 126) Then Ch := Chr(B) Else Ch := '.';
   If Ofs = HE.CursorOfs Then Begin
    { Octet sous le curseur : mis en surbrillance dans les deux
      colonnes (hexa et ASCII) pour montrer leur correspondance. }
    SetColor(CLR_HIGHLIGHT);
    SetFillStyle(SolidFill, CLR_HIGHLIGHT);
    Bar(XPos - 1, YPos - 1, XPos + 15, YPos + HEX_ROW_HEIGHT - 3);
    SetColor(CLR_HIGHLIGHTTEXT);
    OutTextXY(XPos, YPos, HexByte(B));
    SetColor(CLR_HIGHLIGHT);
    SetFillStyle(SolidFill, CLR_HIGHLIGHT);
    Bar(AsciiX + C * 8 - 1, YPos - 1,
        AsciiX + C * 8 + 7, YPos + HEX_ROW_HEIGHT - 3);
    SetColor(CLR_HIGHLIGHTTEXT);
    OutTextXY(AsciiX + C * 8, YPos, Ch);
   End Else Begin
    SetColor(CLR_EDITOR_TEXT);
    OutTextXY(XPos, YPos, HexByte(B));
    OutTextXY(AsciiX + C * 8, YPos, Ch);
   End;
  End;
 End;
End;

{ --- Dessiner un controle du formulaire (apercu, lecture seule) --- }

{ --- Calculer le rectangle du canevas (zone du formulaire), en       }
{ excluant la boite a outils (gauche) et les deux barres de           }
{ defilement (droite/bas). Utilise a la fois par le dessin et par     }
{ le test de clic pour rester coherent.                                }

Procedure ComputeFormEditorLayout(Var FE: TFormEditor;
 Var CvX1, CvY1, CvX2, CvY2: Integer);
Begin
 CvX1 := FE.X + FRM_TOOLBOX_WIDTH;
 CvY1 := FE.Y;
 CvX2 := FE.X + FE.Width - 1 - FRM_SB_SIZE;
 CvY2 := FE.Y + FE.Height - 1 - FRM_SB_SIZE;
End;

{ --- Origine (coin haut-gauche de la zone client) du formulaire a    }
{ l ecran, en tenant compte du defilement --- }

Procedure GetFormOrigin(Var FE: TFormEditor; CvX1, CvY1: Integer;
 Var OrgX, OrgY: Integer);
Begin
 OrgX := CvX1 + 20 - FE.ScrollX;
 OrgY := CvY1 + 40 - FE.ScrollY;
End;

{ --- Bornes de defilement (contenu total moins zone visible) --- }

Procedure GetFormScrollLimits(Var FE: TFormEditor;
 CvX1, CvY1, CvX2, CvY2: Integer; Var MaxSX, MaxSY: Integer);
Var
 ContentW, ContentH, ViewW, ViewH: Integer;
Begin
 ContentW := FE.FormWidth Div 15 + 40;
 ContentH := FE.FormHeight Div 15 + 60;
 ViewW := CvX2 - CvX1 + 1;
 ViewH := CvY2 - CvY1 + 1;
 MaxSX := ContentW - ViewW;
 MaxSY := ContentH - ViewH;
 If MaxSX < 0 Then MaxSX := 0;
 If MaxSY < 0 Then MaxSY := 0;
End;

{ --- Icone (16x16 environ) representant un outil de la boite --- }

Procedure DrawFormToolboxIcon(ToolIdx, IX, IY: Integer);
Var
 TS: String;
Begin
 If ToolIdx = 0 Then Begin
  SetColor(0);
  Line(IX, IY, IX, IY + 12);
  Line(IX, IY, IX + 9, IY + 9);
  Line(IX, IY + 12, IX + 3, IY + 9);
  Line(IX + 3, IY + 9, IX + 9, IY + 9);
  Exit;
 End;
 TS := FRMToolType[ToolIdx];
 SetColor(0);
 If TS = 'LABEL' Then
  OutTextXY(IX, IY + 2, 'A')
 Else If TS = 'TEXTBOX' Then Begin
  Rectangle(IX, IY + 2, IX + 13, IY + 12);
  Line(IX + 2, IY + 7, IX + 11, IY + 7);
 End Else If TS = 'COMMANDBUTTON' Then Begin
  SetFillStyle(SolidFill, CLR_BACKGROUND);
  Bar(IX, IY + 2, IX + 13, IY + 12);
  Rectangle(IX, IY + 2, IX + 13, IY + 12);
 End Else If TS = 'CHECKBOX' Then Begin
  Rectangle(IX, IY + 2, IX + 9, IY + 11);
  Line(IX + 1, IY + 6, IX + 3, IY + 9);
  Line(IX + 3, IY + 9, IX + 8, IY + 3);
 End Else If TS = 'OPTIONBUTTON' Then
  Circle(IX + 6, IY + 7, 5)
 Else If TS = 'FRAME' Then Begin
  Rectangle(IX, IY, IX + 13, IY + 13);
  Bar(IX + 2, IY - 1, IX + 6, IY + 1);
 End Else If TS = 'LISTBOX' Then Begin
  Rectangle(IX, IY, IX + 13, IY + 13);
  Line(IX + 2, IY + 4, IX + 11, IY + 4);
  Line(IX + 2, IY + 8, IX + 11, IY + 8);
 End Else If TS = 'COMBOBOX' Then Begin
  Rectangle(IX, IY + 2, IX + 13, IY + 12);
  Line(IX + 9, IY + 5, IX + 11, IY + 9);
  Line(IX + 11, IY + 9, IX + 13, IY + 5);
 End;
End;

{ --- Dessiner la boite a outils (gauche) de l editeur de formulaire --- }

Procedure DrawFormToolbox(Var FE: TFormEditor);
Var
 I, TY: Integer;
Begin
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(FE.X, FE.Y, FE.X + FRM_TOOLBOX_WIDTH - 1, FE.Y + FE.Height - 1);
 SetColor(CLR_BORDER);
 Rectangle(FE.X, FE.Y, FE.X + FRM_TOOLBOX_WIDTH - 1, FE.Y + FE.Height - 1);
 For I := 0 To FRM_TOOL_COUNT - 1 Do Begin
  TY := FE.Y + 2 + I * FRM_TOOL_HEIGHT;
  If TY + FRM_TOOL_HEIGHT > FE.Y + FE.Height Then Break;
  If FE.ToolSel = I Then Begin
   SetFillStyle(SolidFill, CLR_SELECTION);
   Bar(FE.X + 1, TY, FE.X + FRM_TOOLBOX_WIDTH - 2, TY + FRM_TOOL_HEIGHT - 1);
  End;
  DrawFormToolboxIcon(I, FE.X + 4, TY + 4);
  SetColor(CLR_EDITOR_TEXT);
  OutTextXY(FE.X + 22, TY + 8, FRMToolAbbrev[I]);
 End;
End;

{ --- Dessiner les points de la grille de conception dans la zone     }
{ client du formulaire, limites a la partie visible du canevas --- }

Procedure DrawFormGrid(OrgX, OrgY, FormPxW, FormPxH,
 CvX1, CvY1, CvX2, CvY2: Integer);
Var
 GX, GY, X0, Y0, X1, Y1: Integer;
Begin
 X0 := OrgX; If X0 < CvX1 Then X0 := CvX1;
 Y0 := OrgY; If Y0 < CvY1 Then Y0 := CvY1;
 X1 := OrgX + FormPxW - 1; If X1 > CvX2 Then X1 := CvX2;
 Y1 := OrgY + FormPxH - 1; If Y1 > CvY2 Then Y1 := CvY2;
 If (X0 > X1) Or (Y0 > Y1) Then Exit;
 { Aligner les points sur la grille du formulaire (pas sur l ecran) }
 GY := OrgY;
 While GY < Y0 Do Inc(GY, FRM_GRID_SPACING);
 While GY <= Y1 Do Begin
  GX := OrgX;
  While GX < X0 Do Inc(GX, FRM_GRID_SPACING);
  While GX <= X1 Do Begin
   PutPixel(GX, GY, CLR_BORDER);
   Inc(GX, FRM_GRID_SPACING);
  End;
  Inc(GY, FRM_GRID_SPACING);
 End;
End;

{ --- Poignees de selection (style VB6) autour d un controle --- }

Procedure DrawFormSelectionHandles(CX, CY, CW, CH: Integer);
Begin
 SetFillStyle(SolidFill, 0);
 Bar(CX - 2, CY - 2, CX + 1, CY + 1);
 Bar(CX + CW - 3, CY - 2, CX + CW, CY + 1);
 Bar(CX - 2, CY + CH - 3, CX + 1, CY + CH);
 Bar(CX + CW - 3, CY + CH - 3, CX + CW, CY + CH);
 Bar(CX + (CW Div 2) - 2, CY - 2, CX + (CW Div 2) + 1, CY + 1);
 Bar(CX + (CW Div 2) - 2, CY + CH - 3, CX + (CW Div 2) + 1, CY + CH);
End;

Procedure DrawFormVisControl(Var FE: TFormEditor; Var C: TFRMVisControl;
 OrgX, OrgY: Integer; Selected: Boolean);
Var
 CX, CY, CW, CH: Integer;
 TS: String;
Begin
 TS := UpCaseStr(C.TypeStr);
 If TS = 'TIMER' Then Exit;  { invisible a l execution }
 CX := OrgX + C.CtlLeft Div 15;
 CY := OrgY + C.CtlTop Div 15;
 CW := C.CtlWidth Div 15;
 CH := C.CtlHeight Div 15;
 If CW < 4 Then CW := 4;
 If CH < 4 Then CH := 4;
 If (CX > FE.X + FE.Width) Or (CY > FE.Y + FE.Height) Then Exit;
 If TS = 'LABEL' Then Begin
  SetColor(CLR_EDITOR_TEXT);
  OutTextXY(CX, CY, C.Caption);
 End Else If TS = 'FRAME' Then Begin
  SetColor(CLR_BORDER);
  Rectangle(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_EDITOR_TEXT);
  OutTextXY(CX + 6, CY - 2, C.Caption);
 End Else If (TS = 'CHECKBOX') Or (TS = 'OPTIONBUTTON') Then Begin
  SetColor(CLR_EDITOR_BG);
  Bar(CX, CY + 2, CX + 9, CY + 11);
  SetColor(CLR_BORDER);
  Rectangle(CX, CY + 2, CX + 9, CY + 11);
  SetColor(CLR_EDITOR_TEXT);
  OutTextXY(CX + 14, CY, C.Caption);
 End Else If (TS = 'TEXTBOX') Or (TS = 'LISTBOX') Or
             (TS = 'COMBOBOX') Then Begin
  SetFillStyle(SolidFill, CLR_EDITOR_BG);
  Bar(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_BORDER);
  Rectangle(CX, CY, CX + CW - 1, CY + CH - 1);
  If Length(C.Caption) > 0 Then Begin
   SetColor(CLR_EDITOR_TEXT);
   OutTextXY(CX + 2, CY + 2, C.Caption);
  End;
 End Else If TS = 'COMMANDBUTTON' Then Begin
  SetFillStyle(SolidFill, CLR_BACKGROUND);
  Bar(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_BORDER);
  Rectangle(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_MENU_TEXT);
  OutTextXY(CX + (CW - Length(C.Caption) * 8) Div 2,
   CY + (CH - 8) Div 2, C.Caption);
 End Else Begin
  { Type non specialise (PictureBox, Image, etc.) : boite generique }
  SetFillStyle(SolidFill, CLR_BACKGROUND);
  Bar(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_BORDER);
  Rectangle(CX, CY, CX + CW - 1, CY + CH - 1);
  SetColor(CLR_MENU_TEXT);
  OutTextXY(CX + 2, CY + 2, C.Name);
 End;
 If Selected Then
  DrawFormSelectionHandles(CX, CY, CW, CH);
End;

{ --- Dessiner la barre de defilement verticale (haut/bas) --- }

Procedure DrawFormVScrollbar(Var FE: TFormEditor;
 CvY1, CvY2, SBX1, SBX2: Integer);
Var
 MidX, TrackTop, TrackBot, TrackH, ThumbH, ThumbTop, MaxSY: Integer;
 Dummy: Integer;
Begin
 MidX := (SBX1 + SBX2) Div 2;
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(SBX1, CvY1, SBX2, CvY1 + FRM_SB_SIZE - 1);
 SetColor(CLR_BORDER);
 Rectangle(SBX1, CvY1, SBX2, CvY1 + FRM_SB_SIZE - 1);
 SetColor(CLR_EDITOR_TEXT);
 Line(SBX1 + 3, CvY1 + 9, MidX, CvY1 + 4);
 Line(MidX, CvY1 + 4, SBX2 - 3, CvY1 + 9);
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(SBX1, CvY2 - FRM_SB_SIZE + 1, SBX2, CvY2);
 SetColor(CLR_BORDER);
 Rectangle(SBX1, CvY2 - FRM_SB_SIZE + 1, SBX2, CvY2);
 SetColor(CLR_EDITOR_TEXT);
 Line(SBX1 + 3, CvY2 - 8, MidX, CvY2 - 3);
 Line(MidX, CvY2 - 3, SBX2 - 3, CvY2 - 8);
 TrackTop := CvY1 + FRM_SB_SIZE;
 TrackBot := CvY2 - FRM_SB_SIZE;
 SetFillStyle(SolidFill, CLR_SCROLLBAR);
 Bar(SBX1, TrackTop, SBX2, TrackBot);
 TrackH := TrackBot - TrackTop;
 ThumbH := TrackH Div 4;
 If ThumbH < 12 Then ThumbH := 12;
 GetFormScrollLimits(FE, FE.X, CvY1, FE.X, CvY2, Dummy, MaxSY);
 If MaxSY > 0 Then Begin
  SetFillStyle(SolidFill, CLR_BORDER);
  ThumbTop := TrackTop + 1;
  If TrackH - 2 - ThumbH > 0 Then
   ThumbTop := ThumbTop + (FE.ScrollY * (TrackH - 2 - ThumbH)) Div MaxSY;
  Bar(SBX1 + 1, ThumbTop, SBX2 - 1, ThumbTop + ThumbH);
 End;
End;

{ --- Dessiner la barre de defilement horizontale (gauche/droite) --- }

Procedure DrawFormHScrollbar(Var FE: TFormEditor;
 CvX1, CvX2, SBY1, SBY2: Integer);
Var
 MidY, TrackLeft, TrackRight, TrackW, ThumbW, ThumbLeft, MaxSX: Integer;
 Dummy: Integer;
Begin
 MidY := (SBY1 + SBY2) Div 2;
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(CvX1, SBY1, CvX1 + FRM_SB_SIZE - 1, SBY2);
 SetColor(CLR_BORDER);
 Rectangle(CvX1, SBY1, CvX1 + FRM_SB_SIZE - 1, SBY2);
 SetColor(CLR_EDITOR_TEXT);
 Line(CvX1 + 9, SBY1 + 3, CvX1 + 4, MidY);
 Line(CvX1 + 4, MidY, CvX1 + 9, SBY2 - 3);
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(CvX2 - FRM_SB_SIZE + 1, SBY1, CvX2, SBY2);
 SetColor(CLR_BORDER);
 Rectangle(CvX2 - FRM_SB_SIZE + 1, SBY1, CvX2, SBY2);
 SetColor(CLR_EDITOR_TEXT);
 Line(CvX2 - 8, SBY1 + 3, CvX2 - 3, MidY);
 Line(CvX2 - 3, MidY, CvX2 - 8, SBY2 - 3);
 TrackLeft := CvX1 + FRM_SB_SIZE;
 TrackRight := CvX2 - FRM_SB_SIZE;
 SetFillStyle(SolidFill, CLR_SCROLLBAR);
 Bar(TrackLeft, SBY1, TrackRight, SBY2);
 TrackW := TrackRight - TrackLeft;
 ThumbW := TrackW Div 4;
 If ThumbW < 12 Then ThumbW := 12;
 GetFormScrollLimits(FE, CvX1, FE.Y, CvX2, FE.Y, MaxSX, Dummy);
 If MaxSX > 0 Then Begin
  SetFillStyle(SolidFill, CLR_BORDER);
  ThumbLeft := TrackLeft + 1;
  If TrackW - 2 - ThumbW > 0 Then
   ThumbLeft := ThumbLeft + (FE.ScrollX * (TrackW - 2 - ThumbW)) Div MaxSX;
  Bar(ThumbLeft, SBY1 + 1, ThumbLeft + ThumbW, SBY2 - 1);
 End;
End;

{ --- Dessiner l editeur de formulaire (grille, boite a outils,      }
{ barres de defilement, formulaire et ses controles) --- }

Procedure DrawFormEditor(Var FE: TFormEditor);
Var
 OrgX, OrgY, FormPxW, FormPxH, I: Integer;
 CvX1, CvY1, CvX2, CvY2: Integer;
 Caption: String;
Begin
 ComputeFormEditorLayout(FE, CvX1, CvY1, CvX2, CvY2);
 DrawFormToolbox(FE);
 { Fond du canevas }
 SetFillStyle(SolidFill, CLR_SCROLLBAR);
 Bar(CvX1, CvY1, CvX2, CvY2);
 GetFormOrigin(FE, CvX1, CvY1, OrgX, OrgY);
 FormPxW := FE.FormWidth Div 15;
 FormPxH := FE.FormHeight Div 15;
 If FormPxW < 40 Then FormPxW := 40;
 If FormPxH < 40 Then FormPxH := 40;
 { Barre de titre du formulaire }
 SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
 Bar(OrgX, OrgY - 20, OrgX + FormPxW - 1, OrgY - 1);
 SetColor(15);
 If Length(FE.FormCaption) > 0 Then
  Caption := FE.FormCaption
 Else
  Caption := '(Formulaire)';
 OutTextXY(OrgX + 4, OrgY - 16, Caption);
 { Zone client du formulaire }
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(OrgX, OrgY, OrgX + FormPxW - 1, OrgY + FormPxH - 1);
 SetColor(CLR_BORDER);
 Rectangle(OrgX - 1, OrgY - 21, OrgX + FormPxW, OrgY + FormPxH);
 { Points de la grille de conception }
 DrawFormGrid(OrgX, OrgY, FormPxW, FormPxH, CvX1, CvY1, CvX2, CvY2);
 { Controles }
 For I := 0 To FE.ControlCount - 1 Do
  DrawFormVisControl(FE, FE.Controls[I], OrgX, OrgY, I = FE.SelectedCtl);
 { Barres de defilement }
 DrawFormVScrollbar(FE, CvY1, CvY2, CvX2 + 1, FE.X + FE.Width - 1);
 DrawFormHScrollbar(FE, CvX1, CvX2, CvY2 + 1, FE.Y + FE.Height - 1);
 { Coin (intersection des deux barres) }
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(CvX2 + 1, CvY2 + 1, FE.X + FE.Width - 1, FE.Y + FE.Height - 1);
End;

{ --- Traiter un clic de souris dans l editeur de formulaire :         }
{ selection d outil dans la boite a outils, defilement H/V, selection }
{ d un controle existant ou depot d un nouveau controle sur le canevas}

Procedure HandleFormEditorMouse(Var FE: TFormEditor; Ev: TEvent);
Var
 CvX1, CvY1, CvX2, CvY2, OrgX, OrgY: Integer;
 MaxSX, MaxSY, I, TY, HitCtl, CX, CY, CW, CH: Integer;
 SavedSX, SavedSY: Integer;
 FormX, FormY: LongInt;
 TypeStr, CName: String;
Begin
 If Ev.Kind <> EV_MOUSE_DOWN Then Exit;
 ComputeFormEditorLayout(FE, CvX1, CvY1, CvX2, CvY2);
 { Boite a outils }
 If (Ev.MouseX >= FE.X) And (Ev.MouseX < FE.X + FRM_TOOLBOX_WIDTH) And
    (Ev.MouseY >= FE.Y) And (Ev.MouseY < FE.Y + FE.Height) Then Begin
  For I := 0 To FRM_TOOL_COUNT - 1 Do Begin
   TY := FE.Y + 2 + I * FRM_TOOL_HEIGHT;
   If (Ev.MouseY >= TY) And (Ev.MouseY < TY + FRM_TOOL_HEIGHT) Then Begin
    FE.ToolSel := I;
    Exit;
   End;
  End;
  Exit;
 End;
 { Barre de defilement verticale (fleches haut/bas) }
 If (Ev.MouseX > CvX2) And (Ev.MouseX <= FE.X + FE.Width - 1) And
    (Ev.MouseY >= CvY1) And (Ev.MouseY <= CvY2) Then Begin
  GetFormScrollLimits(FE, CvX1, CvY1, CvX2, CvY2, MaxSX, MaxSY);
  If Ev.MouseY < CvY1 + FRM_SB_SIZE Then Begin
   Dec(FE.ScrollY, FRM_GRID_SPACING);
   If FE.ScrollY < 0 Then FE.ScrollY := 0;
  End Else If Ev.MouseY > CvY2 - FRM_SB_SIZE Then Begin
   Inc(FE.ScrollY, FRM_GRID_SPACING);
   If FE.ScrollY > MaxSY Then FE.ScrollY := MaxSY;
  End;
  Exit;
 End;
 { Barre de defilement horizontale (fleches gauche/droite) }
 If (Ev.MouseY > CvY2) And (Ev.MouseY <= FE.Y + FE.Height - 1) And
    (Ev.MouseX >= CvX1) And (Ev.MouseX <= CvX2) Then Begin
  GetFormScrollLimits(FE, CvX1, CvY1, CvX2, CvY2, MaxSX, MaxSY);
  If Ev.MouseX < CvX1 + FRM_SB_SIZE Then Begin
   Dec(FE.ScrollX, FRM_GRID_SPACING);
   If FE.ScrollX < 0 Then FE.ScrollX := 0;
  End Else If Ev.MouseX > CvX2 - FRM_SB_SIZE Then Begin
   Inc(FE.ScrollX, FRM_GRID_SPACING);
   If FE.ScrollX > MaxSX Then FE.ScrollX := MaxSX;
  End;
  Exit;
 End;
 { Clic dans le canevas du formulaire }
 If (Ev.MouseX < CvX1) Or (Ev.MouseX > CvX2) Or
    (Ev.MouseY < CvY1) Or (Ev.MouseY > CvY2) Then Exit;
 GetFormOrigin(FE, CvX1, CvY1, OrgX, OrgY);
 If FE.ToolSel = 0 Then Begin
  { Outil Pointeur : selectionner le controle sous le curseur }
  HitCtl := -1;
  For I := FE.ControlCount - 1 DownTo 0 Do Begin
   CX := OrgX + FE.Controls[I].CtlLeft Div 15;
   CY := OrgY + FE.Controls[I].CtlTop Div 15;
   CW := FE.Controls[I].CtlWidth Div 15;
   CH := FE.Controls[I].CtlHeight Div 15;
   If CW < 4 Then CW := 4;
   If CH < 4 Then CH := 4;
   If (Ev.MouseX >= CX) And (Ev.MouseX <= CX + CW - 1) And
      (Ev.MouseY >= CY) And (Ev.MouseY <= CY + CH - 1) Then Begin
    HitCtl := I;
    Break;
   End;
  End;
  FE.SelectedCtl := HitCtl;
  SetPropertySourceFrmControl(PropsPanel, FE, FE.SelectedCtl);
 End Else Begin
  { Outil de controle : deposer un nouveau controle a la position   }
  { cliquee et le persister immediatement dans le fichier .FRM       }
  TypeStr := FRMToolType[FE.ToolSel];
  FormX := (Ev.MouseX - OrgX) * 15;
  FormY := (Ev.MouseY - OrgY) * 15;
  If FormX < 0 Then FormX := 0;
  If FormY < 0 Then FormY := 0;
  CName := NextControlName(FE, TypeStr);
  AppendControlToFrmFile(FE.FileName, TypeStr, CName, FormX, FormY,
   FRMDefaultWidth(TypeStr), FRMDefaultHeight(TypeStr));
  SavedSX := FE.ScrollX;
  SavedSY := FE.ScrollY;
  LoadFileForm(FE, FE.FileName);
  FE.ScrollX := SavedSX;
  FE.ScrollY := SavedSY;
  FE.SelectedCtl := FE.ControlCount - 1;
  FE.ToolSel := 0;
  SetPropertySourceFrmControl(PropsPanel, FE, FE.SelectedCtl);
 End;
End;

{ --- Assurer que l octet sous le curseur reste visible --- }

Procedure EnsureHexCursorVisible(Var HE: THexEditor);
Var
 CursorRow, FirstRow, LastRow: LongInt;
Begin
 If HE.VisibleRows <= 0 Then Exit;
 CursorRow := HE.CursorOfs Div HEX_BYTES_PER_ROW;
 FirstRow := HE.ScrollOfs Div HEX_BYTES_PER_ROW;
 LastRow := FirstRow + HE.VisibleRows - 1;
 If CursorRow < FirstRow Then
  HE.ScrollOfs := CursorRow * HEX_BYTES_PER_ROW
 Else If CursorRow > LastRow Then
  HE.ScrollOfs := (CursorRow - HE.VisibleRows + 1) * HEX_BYTES_PER_ROW;
 If HE.ScrollOfs < 0 Then HE.ScrollOfs := 0;
End;

{ --- Gerer un clic souris dans l editeur hexadecimal --- }

Procedure HandleHexEditorMouse(Var HE: THexEditor; Ev: TEvent);
Var
 Row, Col: LongInt;
 Ofs: LongInt;
 AsciiX: Integer;
Begin
 If Ev.Kind <> EV_MOUSE_DOWN Then Exit;
 If (Ev.MouseX < HE.X) Or (Ev.MouseX >= HE.X + HE.Width) Or
    (Ev.MouseY < HE.Y) Or (Ev.MouseY >= HE.Y + HE.Height) Then Exit;
 If (HE.Data = Nil) Or (HE.Size = 0) Then Exit;
 Row := (Ev.MouseY - HE.Y) Div HEX_ROW_HEIGHT;
 AsciiX := HE.X + HEX_ADDR_WIDTH + HEX_BYTES_PER_ROW * HEX_BYTE_WIDTH + 8;
 If Ev.MouseX >= AsciiX Then Begin
  Col := (Ev.MouseX - AsciiX) Div 8;
  HE.InAsciiPane := True;
 End Else Begin
  Col := (Ev.MouseX - (HE.X + HEX_ADDR_WIDTH)) Div HEX_BYTE_WIDTH;
  HE.InAsciiPane := False;
 End;
 If (Col < 0) Or (Col >= HEX_BYTES_PER_ROW) Then Exit;
 Ofs := HE.ScrollOfs + Row * HEX_BYTES_PER_ROW + Col;
 If Ofs < 0 Then Ofs := 0;
 If Ofs >= HE.Size Then Ofs := HE.Size - 1;
 If Ofs >= 0 Then HE.CursorOfs := Ofs;
 HE.HighNibble := True;
End;

{ --- Gerer une touche dans l editeur hexadecimal --- }

Procedure HandleHexEditorKey(Var HE: THexEditor; Ev: TEvent);
Var
 Digit: Integer;
 B: Byte;
Begin
 If (HE.Data = Nil) Or (HE.Size = 0) Then Exit;
 If Ev.Kind = EV_KEY_DOWN Then Begin
  Case Ev.KeyCode Of
   $48: If HE.CursorOfs >= HEX_BYTES_PER_ROW Then { Haut }
         Dec(HE.CursorOfs, HEX_BYTES_PER_ROW);
   $50: If HE.CursorOfs + HEX_BYTES_PER_ROW < HE.Size Then { Bas }
         Inc(HE.CursorOfs, HEX_BYTES_PER_ROW);
   $4B: If HE.CursorOfs > 0 Then Dec(HE.CursorOfs); { Gauche }
   $4D: If HE.CursorOfs + 1 < HE.Size Then Inc(HE.CursorOfs); { Droite }
   $49: Begin { Page haut }
         Dec(HE.CursorOfs, HEX_BYTES_PER_ROW * (HE.VisibleRows - 1));
         If HE.CursorOfs < 0 Then HE.CursorOfs := 0;
        End;
   $51: Begin { Page bas }
         Inc(HE.CursorOfs, HEX_BYTES_PER_ROW * (HE.VisibleRows - 1));
         If HE.CursorOfs >= HE.Size Then HE.CursorOfs := HE.Size - 1;
        End;
   $47: HE.CursorOfs := 0; { Debut }
   $4F: HE.CursorOfs := HE.Size - 1; { Fin }
  End;
  HE.HighNibble := True;
  EnsureHexCursorVisible(HE);
  Exit;
 End;
 If Ev.Kind <> EV_KEY_CHAR Then Exit;
 If Ev.KeyChar = #9 Then Begin { Tab : basculer hexa/ASCII }
  HE.InAsciiPane := Not HE.InAsciiPane;
  HE.HighNibble := True;
  Exit;
 End;
 If HE.InAsciiPane Then Begin
  { Colonne ASCII : la frappe remplace l octet entier }
  If (Ev.KeyChar >= ' ') And (Ord(Ev.KeyChar) <= 126) Then Begin
   HE.Data^[HE.CursorOfs] := Ord(Ev.KeyChar);
   HE.Modified := True;
   If HE.CursorOfs + 1 < HE.Size Then Inc(HE.CursorOfs);
   EnsureHexCursorVisible(HE);
  End;
 End Else Begin
  { Colonne hexadecimale : deux frappes (nibble haut puis bas) par octet }
  Digit := -1;
  If (Ev.KeyChar >= '0') And (Ev.KeyChar <= '9') Then
   Digit := Ord(Ev.KeyChar) - Ord('0')
  Else If (Ev.KeyChar >= 'a') And (Ev.KeyChar <= 'f') Then
   Digit := Ord(Ev.KeyChar) - Ord('a') + 10
  Else If (Ev.KeyChar >= 'A') And (Ev.KeyChar <= 'F') Then
   Digit := Ord(Ev.KeyChar) - Ord('A') + 10;
  If Digit >= 0 Then Begin
   B := HE.Data^[HE.CursorOfs];
   If HE.HighNibble Then Begin
    B := (B And $0F) Or (Digit Shl 4);
    HE.HighNibble := False;
   End Else Begin
    B := (B And $F0) Or Digit;
    HE.HighNibble := True;
   End;
   HE.Data^[HE.CursorOfs] := B;
   HE.Modified := True;
   If HE.HighNibble And (HE.CursorOfs + 1 < HE.Size) Then
    Inc(HE.CursorOfs);
   EnsureHexCursorVisible(HE);
  End;
 End;
End;

