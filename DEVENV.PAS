{ Effectue la copie d UNE SEULE entree (EntryIdx dans Panes[SrcSide]) vers  }
{ DestBase - aiguille vers TermCopyFile (source hote) ou                   }
{ NCCopyVirtEntryToHost (source virtuelle), meme test que partout ailleurs }
{ dans ce sous-systeme (NCState.PaneSlot[SrcSide] < 0). --- }
Function NCCopyOneEntry(Var TP: TTerminalPanel; SrcSide, EntryIdx: Integer;
 Const DestBase: String): Boolean;
Var
 Ok: Boolean;
Begin
 If NCState.PaneSlot[SrcSide] < 0 Then
  Ok := TermCopyFile(TP,
   NCFullPath(NCState.Panes[SrcSide].Path,
    NCState.Panes[SrcSide].Entries[EntryIdx].Name), DestBase, True)
 Else
  Ok := NCCopyVirtEntryToHost(TP, Byte(NCState.PaneSlot[SrcSide]),
   NCState.Panes[SrcSide].Entries[EntryIdx], DestBase);
 { BOGUE REEL corrige (2026-08-25) : TermCopyFile/NCCopyVirtEntryToHost      }
 { expliquent deja leur echec via TermAddLine(TP, ...) - mais ce texte        }
 { atterrissait dans TP.Lines[], invisible en mode Norton Commander (qui      }
 { dessine son propre affichage double-panneau PAR-DESSUS le defilement de   }
 { texte normal du terminal). Le message d echec du lot promettait "voir le  }
 { journal Terminal (F10)" pour le detail, mais F10 en mode ncMessage ferme   }
 { simplement la boite (comme n importe quelle touche) - ce "journal" n a     }
 { jamais existe. Capture directement la derniere ligne ecrite ici, la ou     }
 { l appelant (NCCopyStepNext) a le contexte pour la reutiliser dans la       }
 { boite d erreur elle-meme. }
 If (Not Ok) And (TP.LineCount > 0) Then
  NCState.CopyLastErr := TP.Lines[TP.LineCount - 1];
 NCCopyOneEntry := Ok;
End;

{ Fin du lot de copie F5 (tous les fichiers traites, ou lot annule via      }
{ Echap sur la confirmation Ecraser/Tous/Sauter) : rafraichit les 2         }
{ panneaux (BOGUE REEL corrige 2026-08-23 : NCState.Slot etait un drapeau   }
{ global unique partage par les deux panneaux, voir le commentaire de       }
{ tete de TNCState.PaneSlot - les deux cotes peuvent desormais etre         }
{ rafraichis en toute securite via leur propre PaneSlot), met en            }
{ evidence le fichier copie (copie simple non marquee uniquement - voir    }
{ CopyJumpName), signale les echecs REELS via une boite rouge (jamais les   }
{ "Sauter" de l utilisateur, qui sont un choix, pas un echec), puis         }
{ revient a la navigation normale. --- }
Procedure NCCopyBatchFinish(Var TP: TTerminalPanel);
Var
 FoundIdx: Integer;
Begin
 NCListDir(NCState.PaneSlot[0], NCState.Panes[0]);
 NCListDir(NCState.PaneSlot[1], NCState.Panes[1]);
 If NCState.CopyJumpName <> '' Then Begin
  FoundIdx := NCFindEntryByName(NCState.Panes[NCState.CopyDstSide], NCState.CopyJumpName);
  If FoundIdx >= 0 Then NCState.Panes[NCState.CopyDstSide].Cursor := FoundIdx;
 End;
 NCState.PromptBuf := '';
 If NCState.CopyFailCount > 0 Then Begin
  If NCState.CopyLastErr <> '' Then
   NCShowError('Echec de la copie (' + IntToStr(NCState.CopyFailCount) +
    ' element(s)) : ' + NCState.CopyLastErr, ncBrowse)
  Else
   NCShowError('Echec de la copie (' + IntToStr(NCState.CopyFailCount) +
    ' element(s)).', ncBrowse);
 End Else
  NCState.Mode := ncBrowse;
End;

{ Traite les entrees du lot de copie en cours (voir NCCopyBatchStart) a    }
{ partir de NCState.CopyIdx, jusqu a : (a) une collision de nom necessitant }
{ une confirmation Ecraser/Tous/Sauter (bascule Mode vers                  }
{ ncConfirmOverwrite et s arrete la - impossible de faire mieux avec une    }
{ boucle For classique dans ce sous-systeme evenementiel, UN evenement      }
{ clavier a la fois, jamais de ReadKey bloquant comme le DOS original -     }
{ voir le commentaire de tete de TNCState pour le detail), ou (b) la fin    }
{ du lot (delegue a NCCopyBatchFinish). --- }
{ Existence de DestPath, sur disque virtuel OU hote selon DstSide -        }
{ BOGUE REEL (2026-08-25, signale par l utilisateur : copie F5 vers un     }
{ disque virtuel monte echouait toujours en silence sur un nom deja        }
{ existant, JAMAIS le prompt Ecraser/Tous/Sauter attendu). Cause : l appel  }
{ NCCopyStepNext ci-dessous testait l existence via FileExists() seul, qui }
{ n interroge QUE le systeme de fichiers HOTE (Assign/Reset Pascal reel) - }
{ pour un disque virtuel monte (/DISK0../DISK81, ex. un vrai .vhd DOS),    }
{ "C:\CONFIG.SYS" ne correspond a rien sur le C: REEL de la machine hote,   }
{ donc FileExists renvoyait toujours False : la collision n etait jamais   }
{ detectee, le lot sautait directement a l ecriture, qui echouait ensuite   }
{ profondement dans Fat_PrepareLFNWrite/Fat_LongNameExists (verification   }
{ elle bien virtuelle-aware) avec un message generique "Echec de la        }
{ copie", au lieu du choix Ecraser/Tous/Sauter normalement attendu. }
Function NCDestFileExists(DstSide: Integer; Const DestPath: String): Boolean;
Var
 Idx: Byte;
 AbsP: String;
 Attr: Byte;
 Cluster, Sz: LongInt;
Begin
 If NCState.PaneSlot[DstSide] >= 0 Then Begin
  Idx := Byte(NCState.PaneSlot[DstSide]);
  AbsP := DestPath;
  If (Length(AbsP) >= 2) And (AbsP[2] = ':') Then
   AbsP := Copy(AbsP, 3, Length(AbsP) - 2);
  If AbsP = '' Then AbsP := '\';
  NCDestFileExists := Fat_FindPath(Idx, AbsP, Attr, Cluster, Sz);
 End Else
  NCDestFileExists := FileExists(DestPath);
End;

Procedure NCCopyStepNext(Var TP: TTerminalPanel);
Var
 DestPath: String;
Begin
 While NCState.CopyIdx < NCState.Panes[NCState.CopySrcSide].Count Do Begin
  If (NCState.Panes[NCState.CopySrcSide].MarkCount > 0) And
     (Not NCState.Panes[NCState.CopySrcSide].Marked[NCState.CopyIdx]) Then Begin
   Inc(NCState.CopyIdx);
   Continue;
  End;
  If (NCState.Panes[NCState.CopySrcSide].MarkCount = 0) And
     (NCState.CopyIdx <> NCState.Panes[NCState.CopySrcSide].Cursor) Then Begin
   Inc(NCState.CopyIdx);
   Continue;
  End;
  DestPath := NCCopyComputeDest(NCState.CopyDestBase,
   NCState.Panes[NCState.CopySrcSide].Entries[NCState.CopyIdx].Name);
  If (Not NCState.CopyOverwriteAll) And
     NCDestFileExists(NCState.CopyDstSide, DestPath) Then Begin
   NCState.CopyPendingName := NCState.Panes[NCState.CopySrcSide].Entries[NCState.CopyIdx].Name;
   NCState.Mode := ncConfirmOverwrite;
   Exit;
  End;
  If Not NCCopyOneEntry(TP, NCState.CopySrcSide, NCState.CopyIdx, NCState.CopyDestBase) Then
   Inc(NCState.CopyFailCount);
  Inc(NCState.CopyIdx);
 End;
 NCCopyBatchFinish(TP);
End;

{ Lance un nouveau lot de copie F5 (apres validation du prompt "Vers") -   }
{ fige SrcSide/DstSide/DestBase/le nom a mettre en evidence (copie simple  }
{ non marquee uniquement), reinitialise Idx/OverwriteAll/FailCount, puis   }
{ delegue immediatement a NCCopyStepNext (qui peut se mettre en pause des  }
{ le premier fichier si une confirmation Ecraser/Tous/Sauter s impose).    }
{ --- }
Procedure NCCopyBatchStart(Var TP: TTerminalPanel; SrcSide, DstSide: Integer;
 Const DestBase: String);
Begin
 NCState.CopySrcSide := SrcSide;
 NCState.CopyDstSide := DstSide;
 NCState.CopyDestBase := DestBase;
 NCState.CopyIdx := 0;
 NCState.CopyOverwriteAll := False;
 NCState.CopyFailCount := 0;
 NCState.CopyLastErr := '';
 If (NCState.Panes[SrcSide].MarkCount = 0) And (NCState.Panes[SrcSide].Count > 0) Then
  NCState.CopyJumpName := NCState.Panes[SrcSide].Entries[NCState.Panes[SrcSide].Cursor].Name
 Else
  NCState.CopyJumpName := '';
 NCCopyStepNext(TP);
End;

{ "Compare les repertoires" (Commandes, item 6) : marque dans chaque      }
{ panneau les fichiers absents de l autre cote ou dont la taille differe. }
Procedure NCActionCompareDirs;
Var
 I, J: Integer;
Begin
 FillChar(NCState.Panes[0].Marked, SizeOf(NCState.Panes[0].Marked), False);
 FillChar(NCState.Panes[1].Marked, SizeOf(NCState.Panes[1].Marked), False);
 NCState.Panes[0].MarkCount := 0;
 NCState.Panes[1].MarkCount := 0;
 For I := 0 To NCState.Panes[0].Count - 1 Do
  If Not NCState.Panes[0].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[1], NCState.Panes[0].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[1].Entries[J].Size <> NCState.Panes[0].Entries[I].Size) Then Begin
    NCState.Panes[0].Marked[I] := True;
    Inc(NCState.Panes[0].MarkCount);
   End;
  End;
 For I := 0 To NCState.Panes[1].Count - 1 Do
  If Not NCState.Panes[1].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[0], NCState.Panes[1].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[0].Entries[J].Size <> NCState.Panes[1].Entries[I].Size) Then Begin
    NCState.Panes[1].Marked[I] := True;
    Inc(NCState.Panes[1].MarkCount);
   End;
  End;
End;

{ "Synchroniser les repertoires" (Commandes, item 7) : copie de Side vers }
{ l autre cote chaque fichier absent ou de taille differente, pour que          }
{ l autre panneau finisse par correspondre a celui-ci - systeme hote           }
{ uniquement, meme limitation que Copier/RenDep/Supprimer (etape 2). --- }
Procedure NCActionSyncDirs(Var TP: TTerminalPanel; Side: Integer);
Var
 OtherSide, I, J: Integer;
Begin
 If (NCState.PaneSlot[0] >= 0) Or (NCState.PaneSlot[1] >= 0) Then Begin
  NCShowMessage('La synchronisation n''est pas encore implementee pour la disquette virtuelle.', ncBrowse);
  Exit;
 End;
 OtherSide := Side Xor 1;
 For I := 0 To NCState.Panes[Side].Count - 1 Do
  If Not NCState.Panes[Side].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[OtherSide], NCState.Panes[Side].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[OtherSide].Entries[J].Size <> NCState.Panes[Side].Entries[I].Size) Then
    TermCopyFile(TP, NCFullPath(NCState.Panes[Side].Path,
     NCState.Panes[Side].Entries[I].Name), NCState.Panes[OtherSide].Path, True);
  End;
 NCListDir(NCState.PaneSlot[0], NCState.Panes[0]);
 NCListDir(NCState.PaneSlot[1], NCState.Panes[1]);
End;

{ "Historique" (Commandes, item 2) : ouvre la liste des commandes deja   }
{ tapees dans ce panneau (NC.PAS: DialogHistory, TP.TermHistory partage  }
{ avec les 4 autres shells). --- }
Procedure NCActionHistoryStart(Var TP: TTerminalPanel);
Begin
 If TP.NumberHistory <= 0 Then Begin
  NCShowMessage('Aucune commande dans l''historique.', ncBrowse);
  Exit;
 End;
 NCState.HistCursor := TP.NumberHistory;
 NCState.Mode := ncHistory;
End;

{ Parcours recursif des sous-repertoires de Path (systeme hote), borne  }
{ par MAX_NC_TREE_NODES et NC_TREE_MAX_DEPTH pour rester rapide sur une   }
{ arborescence reelle potentiellement tres grande (NC.PAS: NCD Arbre). --- }
Procedure NCTreeScan(Const Path: String; Depth: Integer);
Var
 SR: SearchRec;
Begin
 If (NCState.TreeCount >= MAX_NC_TREE_NODES) Or (Depth > NC_TREE_MAX_DEPTH) Then
  Exit;
 FindFirst(Path + '\*.*', Directory, SR);
 While (DosError = 0) And (NCState.TreeCount < MAX_NC_TREE_NODES) Do Begin
  If (SR.Name <> '.') And (SR.Name <> '..') And
     ((SR.Attr And Directory) <> 0) Then Begin
   NCState.TreeNodes[NCState.TreeCount].Path := NCFullPath(Path, SR.Name);
   NCState.TreeNodes[NCState.TreeCount].Depth := Depth;
   Inc(NCState.TreeCount);
   NCTreeScan(NCFullPath(Path, SR.Name), Depth + 1);
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC} FindClose(SR); {$ENDIF}
End;

{ "Arbre NCD" (Commandes, item 0) : construit l arbre des sous-           }
{ repertoires du lecteur du panneau Side puis ouvre le mode ncTree. --- }
Procedure NCActionTreeStart(Side: Integer);
Var
 Root: String;
Begin
 If NCState.PaneSlot[Side] >= 0 Then Begin
  NCShowMessage('L''arbre NCD n''est pas encore implemente pour la disquette virtuelle.', ncBrowse);
  Exit;
 End;
 NCState.TreeCount := 0;
 If Length(NCState.Panes[Side].Path) >= 2 Then
  Root := Copy(NCState.Panes[Side].Path, 1, 2) + '\'
 Else
  Root := NCState.Panes[Side].Path;
 NCTreeScan(Root, 0);
 NCState.TreeCursor := 0;
 NCState.TreeTop := 0;
 NCState.Mode := ncTree;
End;

{ F10 depuis le prompt Copier (F5) - reproduit le bouton "F10-Tree" du    }
{ vrai NC 5.0 (boite de dialogue Copier a 3 boutons [Copie][F10-Arbre]    }
{ [Annuler]) : ouvre le meme Arbre NCD que Commandes/Arbre, mais enracine  }
{ sur le lecteur du panneau OtherSide (la destination) et, a la place de  }
{ naviguer un panneau, renvoie le chemin choisi dans PromptBuf et revient }
{ au prompt Copier (voir NCState.TreeForCopy). --- }
Procedure NCActionCopyTreeStart(OtherSide: Integer);
Var
 Root: String;
Begin
 If NCState.PaneSlot[OtherSide] >= 0 Then Begin
  NCShowMessage('L''arbre NCD n''est pas encore implemente pour la disquette virtuelle.',
   ncPromptCopy);
  Exit;
 End;
 NCState.TreeCount := 0;
 If Length(NCState.Panes[OtherSide].Path) >= 2 Then
  Root := Copy(NCState.Panes[OtherSide].Path, 1, 2) + '\'
 Else
  Root := NCState.Panes[OtherSide].Path;
 NCTreeScan(Root, 0);
 NCState.TreeCursor := 0;
 NCState.TreeTop := 0;
 NCState.TreeForCopy := True;
 NCState.Mode := ncTree;
End;

{ Dispatcher central du menu deroulant F9 - reproduit fidelement le          }
{ Case PosMenu/PosItem de PullDnMenu (NC.PAS:2824-2946), y compris les          }
{ items reellement non implementes dans l ORIGINAL lui-meme : tout le          }
{ menu Disque, la plupart de Commandes, et les modes d affichage 0..7 de       }
{ Gauche/Droite (Arbre/Bref/Info/Link/Plein/Regard/Ouvert/Fermer). --- }
Procedure NCMenuExecute(Var TP: TTerminalPanel; Side, Top, Item: Integer);
Var
 TargetSide: Integer;
Begin
 Case Top Of
  0, 4: Begin
   { Gauche (Top=0) et Droite (Top=4) agissent toujours sur leur propre  }
   { cote, quel que soit le panneau actif - comme dans l original. }
   If Top = 0 Then TargetSide := 0 Else TargetSide := 1;
   Case Item Of
    2: NCState.Panes[TargetSide].InfoMode :=
     Not NCState.Panes[TargetSide].InfoMode; { Info }
    0, 1, 3..7:
     NCShowMessage('Ce mode d''affichage n''est pas encore implemente.', ncBrowse);
    8:  NCActionSort(TargetSide, 0);  { Nom }
    9:  NCActionSort(TargetSide, 1);  { Extension }
    10: NCActionSort(TargetSide, 2);  { Heure }
    11: NCActionSort(TargetSide, 3);  { Taille }
    12: NCActionSort(TargetSide, 4);  { Desordre }
    13: NCListDir(NCState.PaneSlot[TargetSide], NCState.Panes[TargetSide]); { Relire }
    14: NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse); { Filtre }
    15: NCShowMessage('Le changement de lecteur n''est pas encore implemente.', ncBrowse);
   End;
  End;
  1: { Fichiers }
   Case Item Of
    2: NCActionView(Side);
    3: NCActionEdit(Side);
    4: NCActionCopyStart(Side, Side Xor 1);
    5: NCActionRenMovStart(Side);
    6: NCActionMkDirStart;
    7: NCActionDeleteStart(Side);
    13: NCActionQuit;
   Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
   End;
  2: { Disque : le reste du menu (Copier/Formater une disquette, Nommer  }
     { un disque, Nettoyage disque) reste non implemente, comme dans     }
     { l ORIGINAL. "Utilitaire reseau..." (item 3) est une extension     }
     { DEV-COOLS sans equivalent dans l ORIGINAL - voir                  }
     { NCCmd_ViewNetworkStatus. }
   If Item = 3 Then Begin
    NCCmd_ViewNetworkStatus;
    NCState.Mode := ncViewFile;
   End Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
  3: { Commandes : Arbre NCD, Historique, Permuter, Comparer et                 }
     { Synchroniser sont reellement cables (etape 4) ; le reste           }
     { (Recherche, Ligne EGA, Emulation terminal, editeurs/configuration)  }
     { reste hors-cadre, comme dans l ORIGINAL au-dela de ce sous-ensemble. }
   Case Item Of
    0: NCActionTreeStart(Side);      { Arbre NCD }
    2: NCActionHistoryStart(TP);     { Historique }
    4: NCActionSwapPanels;           { Permuter les panneaux }
    6: NCActionCompareDirs;          { Compare les repertoires }
    7: NCActionSyncDirs(TP, Side);   { Synchroniser les repertoires }
   Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
   End;
 End;
End;

{ Support souris du menu deroulant F9 (Gauche/Fichiers/Disque/Commandes/  }
{ Droite) - ces deux fonctions recalculent EXACTEMENT la meme geometrie  }
{ que le tracer de ncMenuBar (DrawNCommanderPanel) pour que les zones           }
{ cliquables correspondent pixel pour pixel a ce qui est affiche. --- }

{ Index (0..4) du menu superieur sous MouseX, ou -1 si aucun. --- }
Function NCMenuHitTopItem(MouseX: Integer): Integer;
Var
 X0, W, I, CW: Integer;
 S: String;
Begin
 NCMenuHitTopItem := -1;
 CW := NCState.CharW;
 If CW < 1 Then CW := 8;
 X0 := TermX + CW;
 For I := 0 To NC_MENU_TOP_COUNT - 1 Do Begin
  S := ' ' + NC_MENU_TOP[I] + ' ';
  W := TextWidth(S);
  If (MouseX >= X0 - 2) And (MouseX <= X0 + W + 1) Then Begin
   NCMenuHitTopItem := I;
   Exit;
  End;
  X0 := X0 + W + 3 * CW;
 End;
End;

{ Rectangle du sous-menu deroulant actuellement ouvert (NCState.MenuTop). --- }
Procedure NCMenuDropdownBounds(Var DDLeft, DDRight, DDTop, DDBottom: Integer);
Var
 I, NameCols, CurCount, CW, RH: Integer;
Begin
 CW := NCState.CharW;
 If CW < 1 Then CW := 8;
 RH := TERM_LINE_HEIGHT;
 DDLeft := TermX + CW;
 For I := 0 To NCState.MenuTop - 1 Do
  DDLeft := DDLeft + TextWidth(' ' + NC_MENU_TOP[I] + ' ') + 3 * CW;
 CurCount := NCMenuItemCount(NCState.MenuTop);
 NameCols := 0;
 For I := 0 To CurCount - 1 Do
  If Length(NCMenuItemLabel(NCState.MenuTop, I)) > NameCols Then
   NameCols := Length(NCMenuItemLabel(NCState.MenuTop, I));
 DDRight := DDLeft + (NameCols + 4) * CW;
 If DDRight > TermX + TermWidth - 2 Then Begin
  DDLeft := TermX + TermWidth - 2 - (NameCols + 4) * CW;
  DDRight := TermX + TermWidth - 2;
 End;
 DDTop := TermY + TERM_TAB_HEIGHT + RH;
 DDBottom := DDTop + CurCount * RH;
End;

{ Gerer un evenement clavier/souris pour Norton Commander : navigation,   }
{ dialogues modaux (F5/F6/F7 saisie, F8 confirmation, F3 visionneuse),          }
{ et les touches de fonction elles-memes (TODO NC 2). --- }
Procedure HandleNCommanderEvent(Var TP: TTerminalPanel; Var Ev: TEvent);
Var
 Side, OtherSide, I: Integer;
 E: TNCEntry;
 CmdUp, CmdArg, FullSrc, FullDst: String;
Begin
 Side := NCState.Active;
 OtherSide := Side Xor 1;

 { --- Dialogues modaux : capturent le clavier avant la navigation. --- }
 If NCState.Mode <> ncBrowse Then Begin
  If Ev.Kind = EV_KEY_DOWN Then Begin
   If NCState.Mode = ncViewFile Then Case Ev.KeyCode Of
    72: If NCState.ViewTop > 0 Then Dec(NCState.ViewTop);
    80: If NCState.ViewTop < NCViewTotalRows - 1 Then Inc(NCState.ViewTop);
    73: Begin { PgUp }
     Dec(NCState.ViewTop, 10);
     If NCState.ViewTop < 0 Then NCState.ViewTop := 0;
    End;
    81: Begin { PgDn }
     Inc(NCState.ViewTop, 10);
     If NCState.ViewTop > NCViewTotalRows - 1 Then
      NCState.ViewTop := NCViewTotalRows - 1;
     If NCState.ViewTop < 0 Then NCState.ViewTop := 0;
    End;
    71: NCState.ViewTop := 0; { Home }
    79: NCState.ViewTop := NCViewTotalRows - 1; { Fin }
    75: { Gauche : defilement horizontal (Texte non renvoye a la ligne) }
     If (Not NCState.ViewHex) And (Not NCState.ViewWrap) And
        (NCState.ViewCol > 0) Then Dec(NCState.ViewCol);
    77: { Droite : idem }
     If (Not NCState.ViewHex) And (Not NCState.ViewWrap) Then
      Inc(NCState.ViewCol);
    $3B: NCShowMessage('Aide non disponible pour l''instant.', ncViewFile); { F1 }
    $3C: Begin { F2 : Unwrap - bascule le renvoi a la ligne }
     NCState.ViewWrap := Not NCState.ViewWrap;
     NCState.ViewTop := 0;
     NCState.ViewCol := 0;
    End;
    $3E: Begin { F4 : Hex - bascule Texte/Hexadecimal }
     NCState.ViewHex := Not NCState.ViewHex;
     NCState.ViewTop := 0;
     NCState.ViewCol := 0;
    End;
    $41: NCState.Mode := ncViewSearch; { F7 : Search }
    $42: Begin { F8 : Viewer - liste "Select Viewer" }
     If NCState.ViewHex Then NCState.ViewSelIdx := 6 Else NCState.ViewSelIdx := 5;
     NCState.Mode := ncViewSelectViewer;
    End;
    $44: NCState.Mode := ncBrowse; { F10 : Quit - retour aux 2 panneaux }
   End;
   If NCState.Mode = ncPromptCopy Then Case Ev.KeyCode Of
    $44: NCActionCopyTreeStart(OtherSide); { F10 : bouton "F10-Tree" du vrai NC }
   End;
   If NCState.Mode = ncViewSelectViewer Then Case Ev.KeyCode Of
    72: If NCState.ViewSelIdx = 0 Then NCState.ViewSelIdx := NC_VIEWER_COUNT - 1
     Else Dec(NCState.ViewSelIdx);
    80: NCState.ViewSelIdx := (NCState.ViewSelIdx + 1) Mod NC_VIEWER_COUNT;
   End;
   If NCState.Mode = ncMenuBar Then Case Ev.KeyCode Of
    75: Begin { Gauche : menu superieur precedent, avec bouclage }
     If NCState.MenuTop = 0 Then NCState.MenuTop := NC_MENU_TOP_COUNT - 1
     Else Dec(NCState.MenuTop);
     NCState.MenuItem := 0;
    End;
    77: Begin { Droite : menu superieur suivant, avec bouclage }
     NCState.MenuTop := (NCState.MenuTop + 1) Mod NC_MENU_TOP_COUNT;
     NCState.MenuItem := 0;
    End;
    72: { Haut : item precedent dans le menu deroulant, avec bouclage }
     If NCState.MenuItem = 0 Then
      NCState.MenuItem := NCMenuItemCount(NCState.MenuTop) - 1
     Else
      Dec(NCState.MenuItem);
    80: { Bas : item suivant dans le menu deroulant, avec bouclage }
     NCState.MenuItem := (NCState.MenuItem + 1) Mod NCMenuItemCount(NCState.MenuTop);
   End;
   If NCState.Mode = ncHistory Then Case Ev.KeyCode Of
    72: If NCState.HistCursor > 1 Then Dec(NCState.HistCursor);
    80: If NCState.HistCursor < TP.NumberHistory Then Inc(NCState.HistCursor);
   End;
   If NCState.Mode = ncTree Then Begin
    Case Ev.KeyCode Of
     72: If NCState.TreeCursor > 0 Then Dec(NCState.TreeCursor);
     80: If NCState.TreeCursor < NCState.TreeCount - 1 Then Inc(NCState.TreeCursor);
     73: Begin { PgUp }
      Dec(NCState.TreeCursor, 10);
      If NCState.TreeCursor < 0 Then NCState.TreeCursor := 0;
     End;
     81: Begin { PgDn }
      Inc(NCState.TreeCursor, 10);
      If NCState.TreeCursor > NCState.TreeCount - 1 Then
       NCState.TreeCursor := NCState.TreeCount - 1;
      If NCState.TreeCursor < 0 Then NCState.TreeCursor := 0;
     End;
    End;
    If NCState.TreeCursor < NCState.TreeTop Then
     NCState.TreeTop := NCState.TreeCursor;
   End;
   If NCState.Mode = ncChangeDrive Then Case Ev.KeyCode Of
    75: { Gauche : lettre precedente, avec bouclage (NC.PAS: ChangeDrive) }
     If NCState.CdCount > 0 Then Begin
      If NCState.CdCursor = 0 Then NCState.CdCursor := NCState.CdCount - 1
      Else Dec(NCState.CdCursor);
     End;
    77: { Droite : lettre suivante, avec bouclage }
     If NCState.CdCount > 0 Then
      NCState.CdCursor := (NCState.CdCursor + 1) Mod NCState.CdCount;
   End;
   If NCState.Mode = ncMessage Then
    NCState.Mode := NCState.MessageReturnMode; { toute touche ferme }
  End;
  If Ev.Kind = EV_KEY_CHAR Then Begin
   Case NCState.Mode Of
    ncPromptMkDir, ncPromptCopy, ncPromptRenMov: Case Ev.KeyChar Of
     #27: Begin NCState.Mode := ncBrowse; NCState.PromptBuf := ''; End;
     #13: Begin
      Case NCState.Mode Of
       ncPromptMkDir:
        If NCState.PromptBuf <> '' Then Begin
         If NCState.PaneSlot[Side] < 0 Then
          NCCmd_MkDirHost(NCState.Panes[Side].Path, NCState.PromptBuf)
         Else
          NCCmd_MkDir(NCState.PaneSlot[Side], NCState.Panes[Side].Path, NCState.PromptBuf);
         NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
        End;
       ncPromptCopy:
        { BOGUE REEL corrige (2026-08-23, 5e/6e rapports) : la boucle       }
        { synchrone inline d origine (a) rafraichissait les panneaux ET     }
        { lisait Panes[Side].Cursor APRES coup - or NCListDir remet Cursor  }
        { a 0 pour les DEUX panneaux (source incluse), (b) ne verifiait     }
        { jamais si le fichier cible existait deja (l utilisateur signale : }
        { "il faut copier... si le fichier existe, il pose la question      }
        { Ecraser/Tous/Sauter", capture DOSBox/NC5 fournie a l appui) - ce   }
        { qui exige de mettre le lot "en pause" au milieu du traitement,    }
        { impossible avec une boucle For classique dans ce sous-systeme     }
        { evenementiel (un seul evenement clavier par appel, jamais de       }
        { ReadKey bloquant). Delegue desormais entierement a                }
        { NCCopyBatchStart/NCCopyStepNext - voir leurs commentaires de      }
        { tete et celui de TNCState.PaneSlot pour le detail des 2 bogues.  }
        If NCState.PromptBuf <> '' Then
         NCCopyBatchStart(TP, Side, OtherSide, NCState.PromptBuf);
       ncPromptRenMov:
        If (NCState.PromptBuf <> '') And (NCState.PaneSlot[Side] < 0) And
           (NCState.Panes[Side].Count > 0) Then Begin
         FullSrc := NCFullPath(NCState.Panes[Side].Path,
          NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name);
         If Pos('\', NCState.PromptBuf) > 0 Then
          FullDst := NCState.PromptBuf
         Else
          FullDst := NCFullPath(NCState.Panes[Side].Path, NCState.PromptBuf);
         NCCmd_RenameHost(FullSrc, FullDst);
         NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
        End;
      End;
      { NCShowMessage/NCShowError (echec de copie) et NCCopyStepNext        }
      { (collision Ecraser/Tous/Sauter) ont deja bascule Mode respectivement}
      { vers ncMessage et ncConfirmOverwrite - ne PAS l ecraser ici, sinon   }
      { la boite/le prompt clignote une fraction de seconde puis disparait  }
      { avant que l utilisateur ne puisse reagir. }
      If (NCState.Mode <> ncMessage) And (NCState.Mode <> ncConfirmOverwrite) Then Begin
       NCState.Mode := ncBrowse;
       NCState.PromptBuf := '';
      End;
     End;
     #8:
      If Length(NCState.PromptBuf) > 0 Then
       NCState.PromptBuf := Copy(NCState.PromptBuf, 1, Length(NCState.PromptBuf) - 1);
    Else
     If (Ord(Ev.KeyChar) >= 32) And (Length(NCState.PromptBuf) < 200) Then
      NCState.PromptBuf := NCState.PromptBuf + Ev.KeyChar;
    End;
    ncConfirmDelete: Case UpCase(Ev.KeyChar) Of
     'O': Begin
      If NCState.PaneSlot[Side] < 0 Then Begin
       If NCState.Panes[Side].MarkCount > 0 Then Begin
        For I := 0 To NCState.Panes[Side].Count - 1 Do
         If NCState.Panes[Side].Marked[I] Then
          NCCmd_DeleteHost(NCFullPath(NCState.Panes[Side].Path,
           NCState.Panes[Side].Entries[I].Name),
           NCState.Panes[Side].Entries[I].IsDir);
       End Else If NCState.Panes[Side].Count > 0 Then Begin
        E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
        NCCmd_DeleteHost(NCFullPath(NCState.Panes[Side].Path, E.Name), E.IsDir);
       End;
       NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
      End;
      NCState.Mode := ncBrowse;
     End;
     #27, 'N': NCState.Mode := ncBrowse;
    End;
    { "Le fichier X existe deja" (F5, capture DOSBox/NC5 fournie par        }
    { l utilisateur a l appui) - Ecraser copie CE fichier puis reprend le    }
    { lot au suivant (NCCopyStepNext) ; Tous fait pareil ET desarme la       }
    { verification d existence pour tout le reste du lot (CopyOverwriteAll);}
    { Sauter passe ce fichier SANS le copier (pas un echec, un choix -       }
    { n incremente jamais CopyFailCount) ; Echap annule tout le reste du     }
    { lot d un coup (saute CopyIdx a la fin, comme si tout avait ete         }
    { saute). --- }
    ncConfirmOverwrite: Case UpCase(Ev.KeyChar) Of
     'O', #13: Begin
      If Not NCCopyOneEntry(TP, NCState.CopySrcSide, NCState.CopyIdx,
       NCState.CopyDestBase) Then Inc(NCState.CopyFailCount);
      Inc(NCState.CopyIdx);
      NCCopyStepNext(TP);
     End;
     'A': Begin
      NCState.CopyOverwriteAll := True;
      If Not NCCopyOneEntry(TP, NCState.CopySrcSide, NCState.CopyIdx,
       NCState.CopyDestBase) Then Inc(NCState.CopyFailCount);
      Inc(NCState.CopyIdx);
      NCCopyStepNext(TP);
     End;
     'S': Begin
      Inc(NCState.CopyIdx);
      NCCopyStepNext(TP);
     End;
     #27: Begin
      NCState.CopyIdx := NCState.Panes[NCState.CopySrcSide].Count;
      NCCopyBatchFinish(TP);
     End;
    End;
    ncViewFile: If Ev.KeyChar = #27 Then NCState.Mode := ncBrowse;
    ncViewSearch: Case Ev.KeyChar Of
     #27: NCState.Mode := ncViewFile;
     #13: Begin
      NCViewPerformSearch;
      NCState.Mode := ncViewFile;
     End;
     #8:
      If Length(NCState.ViewSearchBuf) > 0 Then
       NCState.ViewSearchBuf :=
        Copy(NCState.ViewSearchBuf, 1, Length(NCState.ViewSearchBuf) - 1);
    Else
     If (Ord(Ev.KeyChar) >= 32) And (Length(NCState.ViewSearchBuf) < 120) Then
      NCState.ViewSearchBuf := NCState.ViewSearchBuf + Ev.KeyChar;
    End;
    ncViewSelectViewer: Case Ev.KeyChar Of
     #27: NCState.Mode := ncViewFile;
     #13: Begin
      Case NCState.ViewSelIdx Of
       5: NCState.ViewHex := False; { Text View }
       6: NCState.ViewHex := True;  { Hex }
      Else
       NCShowMessage('Ce format de visualisation n''est pas encore implemente.',
        ncViewFile);
      End;
      If NCState.Mode = ncViewSelectViewer Then Begin
       NCState.ViewTop := 0;
       NCState.ViewCol := 0;
       NCState.Mode := ncViewFile;
      End;
     End;
    End;
    ncMenuBar: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      NCMenuExecute(TP, Side, NCState.MenuTop, NCState.MenuItem);
      { NCMenuExecute peut deja avoir bascule vers un autre mode (saisie,   }
      { message...) - ne revenir a la navigation normale que s il ne l a   }
      { pas fait. }
      If NCState.Mode = ncMenuBar Then NCState.Mode := ncBrowse;
     End;
    End;
    ncMessage: NCState.Mode := NCState.MessageReturnMode; { toute touche ferme }
    ncHistory: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      TP.InputLine := TP.TermHistory[NCState.HistCursor];
      TP.InputCol := Length(TP.InputLine) + 1;
      NCState.Mode := ncBrowse;
     End;
    End;
    ncTree: Case Ev.KeyChar Of
     #27: Begin
      { Ouvert via F10 depuis le prompt Copier (voir NCActionCopyTreeStart) :  }
      { Echap revient au prompt SANS toucher a la destination, comme le        }
      { bouton "Annuler" du vrai NC 5.0 le ferait pour l Arbre lui-meme. }
      If NCState.TreeForCopy Then Begin
       NCState.TreeForCopy := False;
       NCState.Mode := ncPromptCopy;
      End Else
       NCState.Mode := ncBrowse;
     End;
     #13: Begin
      If NCState.TreeForCopy Then Begin
       If NCState.TreeCount > 0 Then
        NCState.PromptBuf := NCState.TreeNodes[NCState.TreeCursor].Path;
       NCState.TreeForCopy := False;
       NCState.Mode := ncPromptCopy;
      End Else Begin
       If NCState.TreeCount > 0 Then Begin
        NCState.Panes[Side].Path := NCState.TreeNodes[NCState.TreeCursor].Path;
        NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
       End;
       NCState.Mode := ncBrowse;
      End;
     End;
    End;
    ncChangeDrive: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      If NCState.CdCount > 0 Then Begin
       { BOGUE REEL corrige (2026-08-23) : n affecte plus que le slot du    }
       { panneau CdSide (PaneSlot), plus le drapeau global Slot - voir le   }
       { commentaire de tete de TNCState. NCState.Slot reste mis a jour ici }
       { comme ALIAS du panneau actif (pour le code pas encore migre), mais }
       { l AUTRE panneau garde desormais son propre contexte intact. }
       If NCState.CdIsVirt[NCState.CdCursor] Then Begin
        NCState.PaneSlot[NCState.CdSide] := NCState.CdSlotIdx[NCState.CdCursor];
        NCState.Panes[NCState.CdSide].Path := '\';
       End Else Begin
        NCState.PaneSlot[NCState.CdSide] := -1;
        NCState.Panes[NCState.CdSide].Path :=
         NCState.CdLetter[NCState.CdCursor] + ':\';
       End;
       NCState.Slot := NCState.PaneSlot[NCState.CdSide];
       NCListDir(NCState.PaneSlot[NCState.CdSide], NCState.Panes[NCState.CdSide]);
      End;
      NCState.Mode := ncBrowse;
     End;
    End;
   End;
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;

 { --- Navigation et touches de fonction (mode normal). --- }
 If Ev.Kind = EV_KEY_DOWN Then Begin
  Case Ev.KeyCode Of
   72: { Haut }
    If NCState.Panes[Side].Cursor > 0 Then
     Dec(NCState.Panes[Side].Cursor);
   80: { Bas }
    If NCState.Panes[Side].Cursor < NCState.Panes[Side].Count - 1 Then
     Inc(NCState.Panes[Side].Cursor);
   73: { PgUp }
    Begin
     Dec(NCState.Panes[Side].Cursor, 10);
     If NCState.Panes[Side].Cursor < 0 Then NCState.Panes[Side].Cursor := 0;
    End;
   81: { PgDn }
    Begin
     Inc(NCState.Panes[Side].Cursor, 10);
     If NCState.Panes[Side].Cursor > NCState.Panes[Side].Count - 1 Then
      NCState.Panes[Side].Cursor := NCState.Panes[Side].Count - 1;
     If NCState.Panes[Side].Cursor < 0 Then NCState.Panes[Side].Cursor := 0;
    End;
   71: { Home }
    NCState.Panes[Side].Cursor := 0;
   79: { End }
    If NCState.Panes[Side].Count > 0 Then
     NCState.Panes[Side].Cursor := NCState.Panes[Side].Count - 1;
   82: { Insert : marquer/demarquer l entree courante (jamais ".." - comme  }
       { dans l original, elle ne se marque pas, on avance juste dessus). }
    If NCState.Panes[Side].Count > 0 Then Begin
     If Not NCCursorOnDotDot(Side) Then Begin
      NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor] :=
       Not NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor];
      If NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor] Then
       Inc(NCState.Panes[Side].MarkCount)
      Else
       Dec(NCState.Panes[Side].MarkCount);
     End;
     If NCState.Panes[Side].Cursor < NCState.Panes[Side].Count - 1 Then
      Inc(NCState.Panes[Side].Cursor);
    End;
   $3D: NCActionView(Side);           { F3 : Voir }
   $3E: NCActionEdit(Side);            { F4 : Editer }
   $3F: NCActionCopyStart(Side, OtherSide); { F5 : Copier }
   $40: NCActionRenMovStart(Side);     { F6 : RenDep }
   $41: NCActionMkDirStart;            { F7 : CreRep }
   $42: NCActionDeleteStart(Side);     { F8 : Supprimer }
   $43: Begin { F9 : ouvrir le menu deroulant Gauche/Fichiers/Disque/       }
             { Commandes/Droite (NC.PAS: PullDnMenu). }
    NCState.MenuTop := 0;
    NCState.MenuItem := 0;
    NCState.Mode := ncMenuBar;
   End;
   $44: NCActionQuit;                  { F10 : Sortie - revenir a PowerShell dev }
   $3B, $3C:
    ; { F1 (Aide) / F2 (Menu utilisateur) : deja des stubs dans l ORIGINAL }
       { pour ce sous-ensemble - restent hors-cadre pour l instant. }
   $68: NCBuildChangeDriveList(0);  { Alt+F1 : lettre de disque, panneau gauche }
   $69: NCBuildChangeDriveList(1);  { Alt+F2 : lettre de disque, panneau droite }
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;
 If Ev.Kind = EV_KEY_CHAR Then Begin
  Case Ev.KeyChar Of
   #9: { Tab : changer de panneau actif }
    NCState.Active := NCState.Active Xor 1;
   #12: { Ctrl+L : basculer Fichiers/Info sur l AUTRE panneau (pas          }
        { celui actif) - menu Gauche/Droite, item "Info", NC.PAS. }
    NCState.Panes[OtherSide].InfoMode := Not NCState.Panes[OtherSide].InfoMode;
   #15: { Ctrl+O (2026-08-29, BOGUE REEL) : vrai raccourci NC.PAS pour       }
        { masquer/afficher les deux panneaux (reveler la sortie en           }
        { dessous) - n atteignait jamais ce Case avant la correction du      }
        { court-circuit global "Ctrl+O : ouvrir fichier", voir plus bas      }
        { dans HandleGlobalEvent/le bloc EV_KEY_CHAR. }
    NCState.PanelsHidden := Not NCState.PanelsHidden;
   #13: { Entree : executer la ligne de commande si non vide, sinon    }
         { ouvrir le repertoire sous le curseur. }
    If TrimStr(TP.InputLine) <> '' Then Begin
     CmdUp := UpCaseStr(TrimStr(TP.InputLine));
     If Copy(CmdUp, 1, 6) = 'MKDIR ' Then
      CmdArg := TrimStr(Copy(TP.InputLine, 7, Length(TP.InputLine) - 6))
     Else If Copy(CmdUp, 1, 3) = 'MD ' Then
      CmdArg := TrimStr(Copy(TP.InputLine, 4, Length(TP.InputLine) - 3))
     Else
      CmdArg := '';
     If CmdArg <> '' Then Begin
      { MKDIR/MD : chemin absolu explicite (hote ou disquette virtuelle) }
      { plutot que de dependre du repertoire courant reel du processus,      }
      { que TermExecuteCommand seul ne synchronise pas de facon fiable. }
      If NCState.PaneSlot[Side] < 0 Then
       NCCmd_MkDirHost(NCState.Panes[Side].Path, CmdArg)
      Else
       NCCmd_MkDir(NCState.PaneSlot[Side], NCState.Panes[Side].Path, CmdArg);
      NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
     End Else Begin
      { Toute autre commande : moteur partage des 4 autres shells      }
      { (limitation connue pour le mode disque virtuel uniquement). }
      TP.VirtDrive := NCState.PaneSlot[Side];
      TP.VirtCwd := NCState.Panes[Side].Path;
      TermExecuteCommand(TP, TP.InputLine);
      NCState.Panes[Side].Path := TP.VirtCwd;
      NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
     End;
     TP.InputLine := '';
     TP.InputCol := 1;
    End Else If NCState.Panes[Side].Count > 0 Then Begin
     E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
     If E.IsDir Then NCEnterDir(Side, E.Name)
     Else NCActionOpenAssociated(Side);
    End;
   #8: { Retour arriere : effacer la ligne de commande, sinon remonter }
    If Length(TP.InputLine) > 0 Then
     TP.InputLine := Copy(TP.InputLine, 1, Length(TP.InputLine) - 1)
    Else
     NCEnterDir(Side, '..');
  Else
   If (Ord(Ev.KeyChar) >= 32) And (Length(TP.InputLine) < 200) Then
    TP.InputLine := TP.InputLine + Ev.KeyChar;
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;
End;

{ --- Dessiner le panneau terminal avec selecteur deroulant --- }

Procedure DrawTerminalPanel(Var TP: TTerminalPanel);
Var
 I, YPos, VisLines: Integer;
 S, PromptStr, SelLabel: String;
 MaxCols: Integer;
 PX, PY, PW, PH: Integer;
 SBX, SBY: Integer;
 SBarX, TextRight: Integer;
 TrackTop, TrackBottom, TrackH: Integer;
 ThumbY, ThumbH: Integer;
 Node, MeasureNode: PTermLine;
 SkipBack: LongInt;
 TextLines: LongInt;
 MaxScrollOffset: LongInt;
 NeedHScroll: Boolean;
 MaxLineLen: Integer;
 MaxHScrollOffset: Integer;
 HTrackLeft, HTrackRight, HTrackW: Integer;
 ThumbX, ThumbW: Integer;
 HBarY, SBarBottom: Integer;
Begin
 If Not TermVisible Then Exit;
 PX := TermX;
 PY := TermY;
 PW := TermWidth;
 PH := TermHeight;
 { Fond sombre (8=gris fonce, pas 0 car SetBkColor remappe 0) }
 SetFillStyle(SolidFill, 8);
 Bar(PX, PY, PX + PW - 1, PY + PH - 1);
 { Barre du haut avec titre TERMINAL et SelectBox }
 SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
 Bar(PX, PY, PX + PW - 1, PY + TERM_TAB_HEIGHT - 1);
 SetColor(15);
 OutTextXY(PX + 4, PY + 4, 'TERMINAL');
 { SelectBox deroulant a droite du titre }
 SBX := PX + 80;
 SBY := PY + 2;
 { Fond du selectbox : gris fonce }
 SetFillStyle(SolidFill, 8);
 Bar(SBX, SBY, SBX + TERM_SELECT_WIDTH - 1,
  SBY + TERM_SELECT_HEIGHT - 1);
 { Bordure du selectbox }
 SetColor(CLR_BORDER);
 Rectangle(SBX, SBY, SBX + TERM_SELECT_WIDTH - 1,
  SBY + TERM_SELECT_HEIGHT - 1);
 { Texte du SelectBox : nom du shell actif }
 Case ActiveShell Of
  SK_CMD:        SelLabel := 'Invite de commandes';
  SK_POWERSHELL: SelLabel := 'PowerShell dev';
  SK_BASH:       SelLabel := 'Bash';
  SK_AMIGADOS:   SelLabel := 'AmigaDOS';
  SK_NCOMMANDER: SelLabel := 'Norton Commander';
  SK_OS2REXX:    SelLabel := 'OS/2 & REXX';
 End;
 SetColor(15);
 OutTextXY(SBX + 4, SBY + 3, SelLabel);
 { Fleche vers le bas }
 OutTextXY(SBX + TERM_SELECT_WIDTH - 14, SBY + 3, #31);
 { Bordure du panneau }
 SetColor(CLR_BORDER);
 Rectangle(PX, PY, PX + PW - 1, PY + PH - 1);
 SBarX := PX + PW - TERM_SCROLLBAR_WIDTH - 1;
 If TP.Shell = SK_NCOMMANDER Then Begin
  { Norton Commander remplace entierement le corps du panneau (grille
    double-panneau) - seule la liste deroulante du selecteur (dessinee
    plus bas, commune aux 5 shells) reste partagee. }
  DrawNCommanderPanel(TP, PX, PY, PW, PH);
 End Else Begin
  { DrawNCommanderPanel redefinit la palette 0 en noir reel pour toute  }
  { la duree ou Norton Commander est affiche (necessaire pour un fond   }
  { vraiment noir - voir la note dans DrawNCommanderPanel) et ne la          }
  { restaure pas elle-meme (un SetBkColor de restauration en fin de           }
  { fonction s est revele sans effet, probablement resolu au moment de   }
  { l affichage de l image plutot qu au moment du tracer). On la               }
  { restaure donc ici, cote "on quitte Norton Commander". }
  SetBkColor(CLR_BACKGROUND);
  { Zone de texte (reserver TERM_SCROLLBAR_WIDTH a droite) }
  TextRight := SBarX - 1;
  MaxCols := (TextRight - (PX + 4)) Div TERM_CHAR_WIDTH;
  If MaxCols < 10 Then MaxCols := 10;
  { Barre de defilement HORIZONTALE (2026-08-30, demande explicite de       }
  { l utilisateur) : reservee des que le panneau est plus etroit que 80      }
  { colonnes - un ecran hote de moins de 640 pixels de large en pratique -   }
  { AVANT de calculer VisLines (une ligne de hauteur en moins est reservee   }
  { pour cette barre, exactement comme la ligne de saisie l est deja). }
  NeedHScroll := MaxCols < 80;
  If NeedHScroll Then
   VisLines := (PH - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4 - TERM_HSCROLL_HEIGHT)
    Div TERM_LINE_HEIGHT
  Else
   VisLines := (PH - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
    Div TERM_LINE_HEIGHT;
  If VisLines < 1 Then VisLines := 1;
  { Borner le decalage de defilement. BOGUE REEL trouve (2026-08-30,          }
  { signale par l utilisateur : "la barre defonce" en cliquant sur la        }
  { fleche du haut) : la borne max utilisait HistCount-1 (index du plus      }
  { ancien noeud), mais la formule de position du curseur juste plus bas     }
  { (ThumbY) divise par (HistCount-VisLines) - le VRAI maximum utile une      }
  { fois que les VisLines lignes les plus anciennes sont deja affichees.     }
  { Laisser ScrollOffset depasser HistCount-VisLines rendait le terme         }
  { soustrait de ThumbY plus grand que (TrackH-ThumbH), faisant sortir le     }
  { curseur du haut de la piste (voire par-dessus le bouton fleche) - d ou    }
  { l aspect "casse". Corrige en bornant ici a la MEME valeur que le          }
  { denominateur du calcul de ThumbY. }
  If TP.HistCount = 0 Then TP.ScrollOffset := 0
  Else Begin
   MaxScrollOffset := TP.HistCount - VisLines;
   If MaxScrollOffset < 0 Then MaxScrollOffset := 0;
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   If TP.ScrollOffset > MaxScrollOffset Then
    TP.ScrollOffset := MaxScrollOffset;
  End;
  { Trouver le noeud le plus en haut de la fenetre visible.
    Depuis le tail, reculer de (ScrollOffset + VisLines - 1) noeuds. }
  Node := TP.HistTail;
  SkipBack := TP.ScrollOffset + VisLines - 1;
  While (SkipBack > 0) And (Node <> Nil) And (Node^.Prev <> Nil) Do Begin
   Node := Node^.Prev;
   Dec(SkipBack);
  End;
  { Defilement horizontal : mesurer la ligne la plus longue PARMI CELLES    }
  { REELLEMENT VISIBLES cette image (pas tout l historique - inutile et     }
  { couteux) pour borner TP.HScrollOffset a une valeur qui a un sens reel   }
  { (meme discipline "un seul clamp autoritaire au moment du dessin" que le }
  { correctif du defilement vertical juste au-dessus - jamais recalculer un }
  { maximum different ailleurs). }
  MaxLineLen := 0;
  MeasureNode := Node;
  For I := 0 To VisLines - 1 Do Begin
   If MeasureNode <> Nil Then Begin
    If Length(MeasureNode^.S) > MaxLineLen Then
     MaxLineLen := Length(MeasureNode^.S);
    MeasureNode := MeasureNode^.Next;
   End;
  End;
  MaxHScrollOffset := MaxLineLen - MaxCols;
  If MaxHScrollOffset < 0 Then MaxHScrollOffset := 0;
  If TP.HScrollOffset < 0 Then TP.HScrollOffset := 0;
  If TP.HScrollOffset > MaxHScrollOffset Then
   TP.HScrollOffset := MaxHScrollOffset;
  { Afficher VisLines lignes en avant }
  SetColor(15);
  YPos := PY + TERM_TAB_HEIGHT + 2;
  TextLines := 0;
  For I := 0 To VisLines - 1 Do Begin
   If Node <> Nil Then Begin
    S := Node^.S;
    If TP.HScrollOffset > 0 Then
     If TP.HScrollOffset < Length(S) Then
      S := Copy(S, TP.HScrollOffset + 1, Length(S))
     Else
      S := '';
    If Length(S) > MaxCols Then
     S := Copy(S, 1, MaxCols);
    OutTextXY(PX + 4, YPos, S);
    Node := Node^.Next;
    Inc(TextLines);
   End;
   YPos := YPos + TERM_LINE_HEIGHT;
  End;
  { Ligne de saisie : visible uniquement si on n est pas remonte
    dans l historique (ScrollOffset = 0). Sinon on conserve la
    ligne pour le prochain affichage. }
  SetColor(10);
  If TextLines < VisLines Then
   YPos := PY + TERM_TAB_HEIGHT + 2
    + TextLines * TERM_LINE_HEIGHT
  Else
   YPos := PY + TERM_TAB_HEIGHT + 2
    + VisLines * TERM_LINE_HEIGHT;
  GetDir(0, PromptStr);
  If TP.VirtDrive >= 0 Then
   PromptStr := Term_VirtFullPath(TP);
  Case TP.Shell Of
   SK_POWERSHELL:
    PromptStr := 'PS ' + PromptStr + '> ' + TP.InputLine + '_';
   SK_BASH:
    PromptStr := 'user$ ' + TP.InputLine + '_';
   SK_AMIGADOS:
    PromptStr := '1.SYS:> ' + TP.InputLine + '_';
  Else
   PromptStr := PromptStr + '> ' + TP.InputLine + '_';
  End;
  If TP.ScrollOffset > 0 Then
   PromptStr := '-- defilement (PgUp/PgDn pour naviguer) --';
  If Length(PromptStr) > MaxCols Then
   PromptStr := Copy(PromptStr, 1, MaxCols);
  OutTextXY(PX + 4, YPos, PromptStr);
  { ===== Barre de defilement a droite ===== }
  { Bas reel de la barre VERTICALE : raccourci d une ligne quand la barre    }
  { HORIZONTALE est presente, pour lui laisser sa place sans chevauchement   }
  { (meme "coin" vide classique qu entre 2 barres de defilement Windows). }
  SBarBottom := PY + PH - 2;
  If NeedHScroll Then SBarBottom := SBarBottom - TERM_HSCROLL_HEIGHT;
  { Fond de la barre }
  SetFillStyle(SolidFill, 7);
  Bar(SBarX, PY + TERM_TAB_HEIGHT,
   SBarX + TERM_SCROLLBAR_WIDTH - 1, SBarBottom);
  { Bordure }
  SetColor(CLR_BORDER);
  Rectangle(SBarX, PY + TERM_TAB_HEIGHT,
   SBarX + TERM_SCROLLBAR_WIDTH - 1, SBarBottom);
  { Bouton fleche haut }
  SetFillStyle(SolidFill, 8);
  Bar(SBarX + 1, PY + TERM_TAB_HEIGHT + 1,
   SBarX + TERM_SCROLLBAR_WIDTH - 2,
   PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H - 1);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 1, PY + TERM_TAB_HEIGHT + 1,
   SBarX + TERM_SCROLLBAR_WIDTH - 2,
   PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H - 1);
  SetColor(15);
  OutTextXY(SBarX + 3, PY + TERM_TAB_HEIGHT + 3, #30);
  { Bouton fleche bas }
  SetFillStyle(SolidFill, 8);
  Bar(SBarX + 1, SBarBottom - TERM_SCROLL_BTN_H,
   SBarX + TERM_SCROLLBAR_WIDTH - 2, SBarBottom - 1);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 1, SBarBottom - TERM_SCROLL_BTN_H,
   SBarX + TERM_SCROLLBAR_WIDTH - 2, SBarBottom - 1);
  SetColor(15);
  OutTextXY(SBarX + 3, SBarBottom - TERM_SCROLL_BTN_H + 3, #31);
  { Zone du curseur (entre les deux fleches) }
  TrackTop := PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H + 1;
  TrackBottom := SBarBottom - 1 - TERM_SCROLL_BTN_H;
  TrackH := TrackBottom - TrackTop + 1;
  If TrackH < 4 Then TrackH := 4;
  { Curseur proportionnel : taille = VisLines / HistCount }
  If TP.HistCount > VisLines Then Begin
   ThumbH := (LongInt(VisLines) * TrackH) Div TP.HistCount;
   If ThumbH < 8 Then ThumbH := 8;
   If ThumbH > TrackH Then ThumbH := TrackH;
   { Position : 0 (bas) -> bas du track, max -> haut du track }
   { Position depuis le bas : ScrollOffset / (HistCount - VisLines) }
   If TP.HistCount > VisLines Then
    ThumbY := TrackBottom - ThumbH + 1
     - (LongInt(TP.ScrollOffset) * (TrackH - ThumbH))
       Div (TP.HistCount - VisLines)
   Else
    ThumbY := TrackTop;
  End Else Begin
   ThumbH := TrackH;
   ThumbY := TrackTop;
  End;
  SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
  Bar(SBarX + 2, ThumbY,
   SBarX + TERM_SCROLLBAR_WIDTH - 3, ThumbY + ThumbH - 1);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 2, ThumbY,
   SBarX + TERM_SCROLLBAR_WIDTH - 3, ThumbY + ThumbH - 1);
  { ===== Barre de defilement HORIZONTALE (2026-08-30) ===== }
  If NeedHScroll Then Begin
   HBarY := SBarBottom + 1;
   HTrackLeft := PX + 1 + TERM_HSCROLL_BTN_W;
   HTrackRight := TextRight - TERM_HSCROLL_BTN_W;
   { Fond de la barre }
   SetFillStyle(SolidFill, 7);
   Bar(PX + 1, HBarY, TextRight, PY + PH - 2);
   SetColor(CLR_BORDER);
   Rectangle(PX + 1, HBarY, TextRight, PY + PH - 2);
   { Bouton fleche gauche }
   SetFillStyle(SolidFill, 8);
   Bar(PX + 1, HBarY + 1,
    PX + TERM_HSCROLL_BTN_W - 1, PY + PH - 3);
   SetColor(CLR_BORDER);
   Rectangle(PX + 1, HBarY + 1,
    PX + TERM_HSCROLL_BTN_W - 1, PY + PH - 3);
   SetColor(15);
   OutTextXY(PX + 4, HBarY + 3, #17);
   { Bouton fleche droite }
   SetFillStyle(SolidFill, 8);
   Bar(TextRight - TERM_HSCROLL_BTN_W + 1, HBarY + 1,
    TextRight - 1, PY + PH - 3);
   SetColor(CLR_BORDER);
   Rectangle(TextRight - TERM_HSCROLL_BTN_W + 1, HBarY + 1,
    TextRight - 1, PY + PH - 3);
   SetColor(15);
   OutTextXY(TextRight - TERM_HSCROLL_BTN_W + 4, HBarY + 3, #16);
   { Curseur proportionnel : taille = MaxCols / MaxLineLen }
   HTrackW := HTrackRight - HTrackLeft;
   If HTrackW < 4 Then HTrackW := 4;
   If MaxLineLen > MaxCols Then Begin
    ThumbW := (LongInt(MaxCols) * HTrackW) Div MaxLineLen;
    If ThumbW < 8 Then ThumbW := 8;
    If ThumbW > HTrackW Then ThumbW := HTrackW;
    ThumbX := HTrackLeft
     + (LongInt(TP.HScrollOffset) * (HTrackW - ThumbW)) Div MaxHScrollOffset;
   End Else Begin
    ThumbW := HTrackW;
    ThumbX := HTrackLeft;
   End;
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
   Bar(ThumbX, HBarY + 1, ThumbX + ThumbW - 1, PY + PH - 3);
   SetColor(CLR_BORDER);
   Rectangle(ThumbX, HBarY + 1, ThumbX + ThumbW - 1, PY + PH - 3);
  End;
 End;
 { Dessiner la liste deroulante PAR-DESSUS le texte }
 If TermSelectOpen Then Begin
  { Item 1 : Invite de commandes }
  If TermSelectIdx = 0 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4, SBY + TERM_SELECT_HEIGHT + 3,
   'Invite de commandes');
  { Item 2 : PowerShell dev }
  If TermSelectIdx = 1 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H + 3,
   'PowerShell dev');
  { Item 3 : Bash }
  If TermSelectIdx = 2 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H + 3,
   'Bash');
  { Item 4 : AmigaDOS }
  If TermSelectIdx = 3 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H + 3,
   'AmigaDOS');
  { Item 5 : Norton Commander }
  If TermSelectIdx = 4 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 5 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H + 3,
   'Norton Commander');
  { Item 6 : OS/2 & REXX }
  If TermSelectIdx = 5 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 5 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 6 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 5 * TERM_SELECT_ITEM_H + 3,
   'OS/2 & REXX');
  { Bordure de la liste }
  SetColor(CLR_BORDER);
  Rectangle(SBX, SBY + TERM_SELECT_HEIGHT,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 6 * TERM_SELECT_ITEM_H - 1);
 End;
 TP.NeedRepaint := False;
End;

{ Completion de nom de fichier par <TAB> (2026-08-29, demande explicite    }
{ de l utilisateur : "comme le fait CMD.EXE") - portee au systeme HOTE     }
{ uniquement (TP.VirtDrive < 0) ; sur un lecteur virtuel monte, <TAB> ne   }
{ fait rien pour l instant (limitation assumee, pas de FindFirst/Next      }
{ generique pour FAT/HPFS dans ce fichier - la navigation NC couvre deja   }
{ ce cas via ses propres panneaux et n appelle pas cette fonction, voir     }
{ HandleTerminalEvent qui delegue Norton Commander a HandleNCommanderEvent }
{ AVANT d atteindre ce code). Isole le DERNIER "mot" de la ligne de         }
{ commande (separe par des espaces - meme convention que TermExtractParam  }
{ ailleurs dans ce fichier), le scinde en repertoire+prefixe partiel,       }
{ recherche via FindFirst/FindNext (meme motif que TermCmd_DIR_CMD) toutes }
{ les entrees dont le nom commence par ce prefixe (insensible a la casse), }
{ et remplace ce dernier mot par la premiere correspondance triee - un        }
{ ajoute un '\' final si l entree est un repertoire (permet d enchainer une }
{ 2e completion immediatement, comme CMD.EXE). Appels <TAB> CONSECUTIFS     }
{ (sans autre frappe entre-temps - TP.TabActive) font cycler parmi TOUTES   }
{ les correspondances trouvees au premier appel, plutot que de refaire une  }
{ recherche a chaque fois. }
Procedure TermTab_Complete(Var TP: TTerminalPanel);
Var
 TokStart, DirEnd, Cnt: Integer;
 Tok, DirPart, NamePart, UpNamePart, Base, FullDir, NewName: String;
 Info: SearchRec;
Begin
 If TP.VirtDrive >= 0 Then Exit;
 If Not TP.TabActive Then Begin
  TokStart := Length(TP.InputLine);
  While (TokStart > 0) And (TP.InputLine[TokStart] <> ' ') Do Dec(TokStart);
  Inc(TokStart);
  Tok := Copy(TP.InputLine, TokStart, Length(TP.InputLine) - TokStart + 1);
  If Tok = '' Then Exit;
  DirEnd := Length(Tok);
  While (DirEnd > 0) And (Tok[DirEnd] <> '\') And (Tok[DirEnd] <> '/') Do
   Dec(DirEnd);
  DirPart := Copy(Tok, 1, DirEnd);
  NamePart := Copy(Tok, DirEnd + 1, Length(Tok) - DirEnd);
  UpNamePart := UpCaseStr(NamePart);
  If (Length(DirPart) >= 1) And ((DirPart[1] = '\') Or (DirPart[1] = '/') Or
     ((Length(DirPart) >= 2) And (DirPart[2] = ':'))) Then
   FullDir := DirPart
  Else Begin
   GetDir(0, Base);
   If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
   FullDir := Base + DirPart;
  End;
  TP.TabMatchCount := 0;
  FindFirst(FullDir + '*.*', AnyFile, Info);
  While DosError = 0 Do Begin
   If (Info.Name <> '.') And (Info.Name <> '..') And
      (Copy(UpCaseStr(Info.Name), 1, Length(UpNamePart)) = UpNamePart) And
      (TP.TabMatchCount < 32) Then Begin
    NewName := Info.Name;
    If (Info.Attr And Directory) = Directory Then NewName := NewName + '\';
    { Insertion triee (ordre stable et previsible au fil du cycle). }
    Cnt := TP.TabMatchCount;
    While (Cnt > 0) And
     (UpCaseStr(TP.TabMatches[Cnt - 1]) > UpCaseStr(NewName)) Do Begin
     TP.TabMatches[Cnt] := TP.TabMatches[Cnt - 1];
     Dec(Cnt);
    End;
    TP.TabMatches[Cnt] := NewName;
    Inc(TP.TabMatchCount);
   End;
   FindNext(Info);
  End;
  FindClose(Info);
  If TP.TabMatchCount = 0 Then Exit;
  TP.TabTokenStart := TokStart;
  TP.TabDirPart := DirPart;
  TP.TabMatchIdx := 0;
  TP.TabActive := True;
 End Else
  TP.TabMatchIdx := (TP.TabMatchIdx + 1) Mod TP.TabMatchCount;
 TP.InputLine := Copy(TP.InputLine, 1, TP.TabTokenStart - 1) +
  TP.TabDirPart + TP.TabMatches[TP.TabMatchIdx];
 TP.InputCol := Length(TP.InputLine) + 1;
 TP.NeedRepaint := True;
End;

Procedure HandleTerminalEvent(Var TP: TTerminalPanel;
 Var Ev: TEvent);
Var
 Ch: Char;
 Dir: String;
 SBX, SBY: Integer;
 NewShell: TShellKind;
 FKBarCW, FKBarY, FKBarColW, FKBarSlot: Integer;
 FakeEv: TEvent;
 DDLeft, DDRight, DDTop, DDBottom, TopHit, ItemHit: Integer;
 EvVisLines, EvMaxScroll: Integer;
Begin
 If Not TermVisible Then Exit;
 { Position du SelectBox }
 SBX := TermX + 80;
 SBY := TermY + 2;
 { Clic souris }
 If (Ev.Kind = EV_MOUSE_DOWN) Then Begin
  { Clic droit dans la zone du terminal : menu contextuel }
  If (Ev.MouseBtn = MB_RIGHT) And
     (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   InitContextMenu(CtxMenu);
   CtxMenu.X := Ev.MouseX;
   CtxMenu.Y := Ev.MouseY;
   CtxMenu.Width := 200;
   AddContextItem(CtxMenu, 'Aide', 900);
   AddContextItem(CtxMenu, 'Sauvegarder historiques', 901);
   AddContextItem(CtxMenu, 'Zoom', 902);
   CtxMenu.Visible := True;
   DrawContextMenu(CtxMenu);
   Exit;
  End;
  { Si la liste deroulante est ouverte, verifier clic sur un item }
  If TermSelectOpen Then Begin
   { Item 1 : Invite de commandes }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_CMD;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_CMD].LineCount = 0 Then
      TermAddLine(TermPanels[SK_CMD],
       'Invite de commandes developpeur. Tapez HELP.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 2 : PowerShell dev }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 2 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_POWERSHELL;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_POWERSHELL].LineCount = 0 Then
      TermAddLine(TermPanels[SK_POWERSHELL],
       'PowerShell developpeur. Tapez HELP.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 3 : Bash }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 2 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 3 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_BASH;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_BASH].LineCount = 0 Then
      TermAddLine(TermPanels[SK_BASH],
       'Bash terminal. Tapez help.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 4 : AmigaDOS }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 3 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 4 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_AMIGADOS;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_AMIGADOS].LineCount = 0 Then
      TermAddLine(TermPanels[SK_AMIGADOS],
       'AmigaDOS 3.1. Tapez ? pour la liste des commandes.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 5 : Norton Commander }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 4 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 5 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_NCOMMANDER;
    TermSelectOpen := False;
    ActiveShell := NewShell;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 6 : OS/2 & REXX }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 5 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 6 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_OS2REXX;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_OS2REXX].LineCount = 0 Then
      TermAddLine(TermPanels[SK_OS2REXX],
       'OS/2 (TM) Command Interpreter. Tapez ? pour la liste des commandes.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Clic ailleurs : fermer la liste }
   TermSelectOpen := False;
   FullRepaintNeeded := True;
  End;
  { Clic sur le SelectBox ferme : ouvrir/fermer la liste }
  If (Ev.MouseX >= SBX) And
     (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
     (Ev.MouseY >= SBY) And
     (Ev.MouseY < SBY + TERM_SELECT_HEIGHT) Then Begin
   TermSelectOpen := Not TermSelectOpen;
   If TermSelectOpen Then
    Case ActiveShell Of
     SK_CMD:        TermSelectIdx := 0;
     SK_POWERSHELL: TermSelectIdx := 1;
     SK_BASH:       TermSelectIdx := 2;
     SK_AMIGADOS:   TermSelectIdx := 3;
     SK_NCOMMANDER: TermSelectIdx := 4;
     SK_OS2REXX:    TermSelectIdx := 5;
    End;
   FullRepaintNeeded := True;
   Exit;
  End;
  { Clic dans la zone du terminal }
  If (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   If TermSelectOpen Then Begin
    TermSelectOpen := False;
    FullRepaintNeeded := True;
   End;
   { Clic sur la barre de touches de fonction de Norton Commander : agit }
   { comme la touche F correspondante (le "message du bouton" clique),   }
   { pour les utilisateurs qui preferent la souris au clavier. Fonctionne  }
   { quel que soit le mode courant (parcours, dialogue, visionneuse F3)   }
   { puisqu on simule simplement l appui de touche - HandleNCommanderEvent  }
   { route deja correctement chaque code de touche selon le mode actif. }
   If ActiveShell = SK_NCOMMANDER Then Begin
    FKBarCW := NCState.CharW;
    If FKBarCW < 1 Then FKBarCW := 8;
    FKBarY := TermY + TermHeight - TERM_LINE_HEIGHT;
    If (Ev.MouseY >= FKBarY) And (Ev.MouseY < TermY + TermHeight) Then Begin
     FKBarColW := (TermWidth - 2 * FKBarCW) Div 10;
     If FKBarColW < 8 * FKBarCW Then FKBarColW := 8 * FKBarCW;
     FKBarSlot := (Ev.MouseX - TermX) Div FKBarColW + 1;
     If (FKBarSlot >= 1) And (FKBarSlot <= 10) Then Begin
      FillChar(FakeEv, SizeOf(FakeEv), 0);
      FakeEv.Kind := EV_KEY_DOWN;
      FakeEv.KeyCode := $3A + FKBarSlot; { F1=$3B .. F10=$44 }
      HandleNCommanderEvent(TP, FakeEv);
     End;
     Exit;
    End;
    { Clic dans le menu deroulant F9 (Gauche/Fichiers/Disque/Commandes/    }
    { Droite), quand il est ouvert - meme geometrie que ncMenuBar dans           }
    { DrawNCommanderPanel (NCMenuHitTopItem/NCMenuDropdownBounds). }
    If NCState.Mode = ncMenuBar Then Begin
     TopHit := NCMenuHitTopItem(Ev.MouseX);
     If (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) And
        (Ev.MouseY < TermY + TERM_TAB_HEIGHT + TERM_LINE_HEIGHT) And
        (TopHit >= 0) Then Begin
      { Clic sur un des 5 menus superieurs : y basculer (comme            }
      { Gauche/Droite au clavier), sans executer d item. }
      NCState.MenuTop := TopHit;
      NCState.MenuItem := 0;
      FullRepaintNeeded := True;
      Exit;
     End;
     NCMenuDropdownBounds(DDLeft, DDRight, DDTop, DDBottom);
     If (Ev.MouseX >= DDLeft) And (Ev.MouseX <= DDRight) And
        (Ev.MouseY >= DDTop) And (Ev.MouseY < DDBottom + 1) Then Begin
      { Clic sur un item du sous-menu : le selectionner ET l executer,       }
      { comme Entree au clavier. }
      ItemHit := (Ev.MouseY - DDTop) Div TERM_LINE_HEIGHT;
      If ItemHit < 0 Then ItemHit := 0;
      If ItemHit > NCMenuItemCount(NCState.MenuTop) - 1 Then
       ItemHit := NCMenuItemCount(NCState.MenuTop) - 1;
      NCState.MenuItem := ItemHit;
      NCMenuExecute(TP, NCState.Active, NCState.MenuTop, NCState.MenuItem);
      If NCState.Mode = ncMenuBar Then NCState.Mode := ncBrowse;
      FullRepaintNeeded := True;
      Exit;
     End;
     { Clic en dehors de la barre et du sous-menu : fermer le menu,             }
     { comme Echap (convention habituelle des menus deroulants). }
     NCState.Mode := ncBrowse;
     FullRepaintNeeded := True;
     Exit;
    End;
   End;
   { Defilement via la barre a droite }
   If (Ev.MouseX >= TermX + TermWidth - TERM_SCROLLBAR_WIDTH - 1)
    And (Ev.MouseX < TermX + TermWidth - 1)
    And (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) Then Begin
    { Maximum REEL de defilement : meme formule que le clamp de           }
    { DrawTerminalPanel (HistCount-VisLines, pas HistCount-1 - voir le     }
    { commentaire "BOGUE REEL" la-bas pour le detail du bogue de curseur   }
    { de barre de defilement que cet ecart de bornes causait). }
    EvVisLines := (TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
     Div TERM_LINE_HEIGHT;
    If EvVisLines < 1 Then EvVisLines := 1;
    EvMaxScroll := TP.HistCount - EvVisLines;
    If EvMaxScroll < 0 Then EvMaxScroll := 0;
    { Bouton fleche haut : remonter d une ligne }
    If Ev.MouseY < TermY + TERM_TAB_HEIGHT
     + TERM_SCROLL_BTN_H Then Begin
     If TP.ScrollOffset < EvMaxScroll Then Begin
      Inc(TP.ScrollOffset);
      TP.NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     Exit;
    End;
    { Bouton fleche bas : descendre d une ligne }
    If Ev.MouseY >= TermY + TermHeight - 2
     - TERM_SCROLL_BTN_H Then Begin
     If TP.ScrollOffset > 0 Then Begin
      Dec(TP.ScrollOffset);
      TP.NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     Exit;
    End;
    { Clic dans le track : page up/down selon position relative
      au curseur (heuristique simple : moitie haute = remonter,
      moitie basse = descendre, page = hauteur visible). }
    If Ev.MouseY < (TermY + TERM_TAB_HEIGHT
     + (TermHeight - TERM_TAB_HEIGHT) Div 2) Then Begin
     TP.ScrollOffset := TP.ScrollOffset +
      ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
       Div TERM_LINE_HEIGHT);
     If TP.ScrollOffset > EvMaxScroll Then
      TP.ScrollOffset := EvMaxScroll;
    End Else Begin
     TP.ScrollOffset := TP.ScrollOffset -
      ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
       Div TERM_LINE_HEIGHT);
     If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
    End;
    TP.NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Defilement HORIZONTAL (2026-08-30, demande explicite de l utilisateur }
   { - panneau plus etroit que 80 colonnes) : meme rangee que dessinee par  }
   { DrawTerminalPanel quand NeedHScroll (TP.Shell<>SK_NCOMMANDER, qui a sa }
   { propre grille sans cette notion de colonnes tronquees). Design         }
   { DELIBEREMENT plus simple que le defilement vertical ci-dessus : on     }
   { ajuste HScrollOffset librement ici (borne seulement a 0 en bas), SANS  }
   { tenter de recalculer ici le maximum reel (qui exigerait de re-parcourir}
   { les noeuds d historique visibles) - le clamp AUTORITAIRE unique de     }
   { DrawTerminalPanel (base sur MaxLineLen reellement mesure) corrige tout }
   { depassement des la prochaine image. Repartir ce meme calcul ici        }
   { reproduirait exactement la classe de bogue "2 maximums qui divergent"  }
   { qui vient d etre corrigee pour la barre verticale. }
   If (TP.Shell <> SK_NCOMMANDER) And
      (Ev.MouseX >= TermX + 1) And (Ev.MouseX < TermX + TermWidth - TERM_SCROLLBAR_WIDTH - 1) And
      (Ev.MouseY >= TermY + TermHeight - 2 - TERM_HSCROLL_HEIGHT) And
      (Ev.MouseY < TermY + TermHeight - 1) Then Begin
    { Bouton fleche gauche }
    If Ev.MouseX < TermX + 1 + TERM_HSCROLL_BTN_W Then Begin
     If TP.HScrollOffset > 0 Then Dec(TP.HScrollOffset);
     TP.NeedRepaint := True;
     FullRepaintNeeded := True;
     Exit;
    End;
    { Bouton fleche droite }
    If Ev.MouseX >= TermX + TermWidth - TERM_SCROLLBAR_WIDTH - 1 - TERM_HSCROLL_BTN_W Then Begin
     Inc(TP.HScrollOffset);
     TP.NeedRepaint := True;
     FullRepaintNeeded := True;
     Exit;
    End;
    { Clic dans le track : page gauche/droite selon la position relative
      au milieu de la barre (meme heuristique que le track vertical). }
    If Ev.MouseX < TermX + (TermWidth - TERM_SCROLLBAR_WIDTH) Div 2 Then Begin
     TP.HScrollOffset := TP.HScrollOffset - 20;
     If TP.HScrollOffset < 0 Then TP.HScrollOffset := 0;
    End Else
     TP.HScrollOffset := TP.HScrollOffset + 20;
    TP.NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   Exit;
  End;
 End;
 { Navigation clavier dans la liste deroulante }
 If TermSelectOpen Then Begin
  If Ev.Kind = EV_KEY_DOWN Then Begin
   If Ev.KeyCode = $48 Then Begin { Fleche haut }
    If TermSelectIdx > 0 Then
     Dec(TermSelectIdx);
    FullRepaintNeeded := True;
    Exit;
   End;
   If Ev.KeyCode = $50 Then Begin { Fleche bas }
    If TermSelectIdx < 5 Then
     Inc(TermSelectIdx);
    FullRepaintNeeded := True;
    Exit;
   End;
  End;
  If Ev.Kind = EV_KEY_CHAR Then Begin
   If Ev.KeyChar = #13 Then Begin { Enter : confirmer }
    Case TermSelectIdx Of
     0: NewShell := SK_CMD;
     1: NewShell := SK_POWERSHELL;
     2: NewShell := SK_BASH;
     3: NewShell := SK_AMIGADOS;
     4: NewShell := SK_NCOMMANDER;
     5: NewShell := SK_OS2REXX;
    End;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[ActiveShell].LineCount = 0 Then
      Case ActiveShell Of
       SK_CMD:
        TermAddLine(TermPanels[SK_CMD],
         'Invite de commandes developpeur. Tapez HELP.');
       SK_POWERSHELL:
        TermAddLine(TermPanels[SK_POWERSHELL],
         'PowerShell developpeur. Tapez HELP.');
       SK_BASH:
        TermAddLine(TermPanels[SK_BASH],
         'Bash terminal. Tapez help.');
       SK_AMIGADOS:
        TermAddLine(TermPanels[SK_AMIGADOS],
         'AmigaDOS 3.1. Tapez ? pour la liste des commandes.');
       SK_OS2REXX:
        TermAddLine(TermPanels[SK_OS2REXX],
         'OS/2 (TM) Command Interpreter. Tapez ? pour la liste des commandes.');
      End;
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   If Ev.KeyChar = #27 Then Begin { Echap : fermer }
    TermSelectOpen := False;
    FullRepaintNeeded := True;
    Exit;
   End;
  End;
  Exit;
 End;
 { Norton Commander : modele d interaction completement different       }
 { (grille double-panneau + touches de fonction), pas de ligne de           }
 { commande partagee - delegue entierement a son propre gestionnaire. }
 If TP.Shell = SK_NCOMMANDER Then Begin
  HandleNCommanderEvent(TP, Ev);
  Exit;
 End;
 { Clavier }
 If Ev.Kind = EV_KEY_CHAR Then Begin
  Ch := Ev.KeyChar;
  { Script REXX suspendu en attente d'une touche UNIQUE (SYSGETKEY/CHARIN  }
  { interactif - voir Rexx_ReadKey pres de TermCmd_IMGMOUNT) : toute       }
  { touche le relance IMMEDIATEMENT, sans attendre Entree (contrairement   }
  { au cas rwLine gere plus bas, dans la branche #13 normale). }
  If TP.RexxActive And (TP.RexxWaiting = rwKey) Then Begin
   TP.RexxPendingKey := Ch;
   Rexx_SwitchAndCheck(TP);
   TP.NeedRepaint := True;
  End Else
  Case Ch Of
   #8: Begin { Backspace }
    TP.TabActive := False;
    If Length(TP.InputLine) > 0 Then Begin
     TP.InputLine := Copy(TP.InputLine, 1,
      Length(TP.InputLine) - 1);
     TP.NeedRepaint := True;
    End;
   End;
   #9: TermTab_Complete(TP); { Tab : completion de nom de fichier, comme CMD.EXE }
   #13: Begin { Enter }
    TP.TabActive := False;
    { Script REXX suspendu en attente d'une LIGNE complete (PULL/PARSE     }
    { PULL/PARSE LINEIN sans donnee en file d'attente - voir               }
    { Rexx_ReadLine) : la ligne tapee normalement jusqu'ici (Backspace/    }
    { caracteres imprimables geres comme d'habitude ci-dessous) devient la }
    { valeur lue par le script au lieu d'etre soumise a                    }
    { TermExecuteCommand. }
    If TP.RexxActive And (TP.RexxWaiting = rwLine) Then Begin
     TP.RexxPendingLine := TP.InputLine;
     TP.InputLine := '';
     TP.InputCol := 1;
     Rexx_SwitchAndCheck(TP);
    End Else Begin
     GetDir(0, Dir);
     { Toute saisie ramene la fenetre au bas de l historique et a gauche  }
     { (HScrollOffset, 2026-08-30) - une nouvelle commande ne devrait pas  }
     { rester decalee horizontalement a cause d une ligne precedente plus  }
     { longue que l ecran. }
     TP.ScrollOffset := 0;
     TP.HScrollOffset := 0;
     { PowerShell dev : variables ($nom = ...), here-strings (@"..."@) et  }
     { lecture de propriete ($obj.cle) - 2026-08-31, demande explicite de  }
     { l'utilisateur. Gere entierement par TermPSHandleInputLine (echo,    }
     { assignation/lecture, ou execution normale apres substitution des    }
     { $variables scalaires) - voir ce bloc juste avant TermCmd_HELP. }
     If TP.Shell = SK_POWERSHELL Then
      TermPSHandleInputLine(TP)
     Else Begin
      Case TP.Shell Of
       SK_BASH:
        TermAddLine(TP, 'user$ ' + TP.InputLine);
       SK_AMIGADOS:
        TermAddLine(TP, '1.SYS:> ' + TP.InputLine);
      Else
       TermAddLine(TP, Dir + '> ' + TP.InputLine);
      End;
      TermExecuteCommand(TP, TP.InputLine);
     End;
     TP.InputLine := '';
     TP.InputCol := 1;
     TP.ScrollOffset := 0;
     TP.HScrollOffset := 0;
    End;
    TP.NeedRepaint := True;
   End;
   #27: ; { Echap : ne rien faire }
  Else
   If (Ord(Ch) >= 32) And
    (Length(TP.InputLine) < 240) Then Begin
    TP.TabActive := False;
    TP.InputLine := TP.InputLine + Ch;
    Inc(TP.InputCol);
    TP.NeedRepaint := True;
   End;
  End;
 End;
 { Fleche haut/bas pour naviguer dans l historique }
 If Ev.Kind = EV_KEY_DOWN Then Begin
  If (Ev.KeyCode = $48) And { Fleche haut }
   (TP.NumberHistory > 0) Then Begin
   If TP.HistoryPos > 1 Then
    Dec(TP.HistoryPos);
   TP.InputLine := TP.TermHistory[TP.HistoryPos];
   TP.InputCol := Length(TP.InputLine) + 1;
   TP.NeedRepaint := True;
  End
  Else If (Ev.KeyCode = $50) And { Fleche bas }
   (TP.NumberHistory > 0) Then Begin
   If TP.HistoryPos < TP.NumberHistory Then Begin
    Inc(TP.HistoryPos);
    TP.InputLine := TP.TermHistory[TP.HistoryPos];
   End Else Begin
    TP.HistoryPos := TP.NumberHistory + 1;
    TP.InputLine := '';
   End;
   TP.InputCol := Length(TP.InputLine) + 1;
   TP.NeedRepaint := True;
  End;
  { PageUp / PageDown : defilement de la fenetre d historique }
  If Ev.KeyCode = $49 Then Begin { PgUp }
   EvVisLines := (TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
    Div TERM_LINE_HEIGHT;
   If EvVisLines < 1 Then EvVisLines := 1;
   EvMaxScroll := TP.HistCount - EvVisLines;
   If EvMaxScroll < 0 Then EvMaxScroll := 0;
   TP.ScrollOffset := TP.ScrollOffset +
    ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
     Div TERM_LINE_HEIGHT);
   If TP.ScrollOffset > EvMaxScroll Then
    TP.ScrollOffset := EvMaxScroll;
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   TP.NeedRepaint := True;
   FullRepaintNeeded := True;
  End
  Else If Ev.KeyCode = $51 Then Begin { PgDn }
   TP.ScrollOffset := TP.ScrollOffset -
    ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
     Div TERM_LINE_HEIGHT);
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   TP.NeedRepaint := True;
   FullRepaintNeeded := True;
  End;
 End;
End;

