{ --- Initialisation du mode graphique --- }

Procedure SelectScreenDriverMode(WantMaxScreen: Boolean;
 Var Driver, Mode: Integer);
Var
 LoMode, HiMode: SmallInt;
Begin
 {$IFDEF FPC}
  If(WantMaxScreen)Then Begin
   { Detect choisirait le pilote couleur le plus profond (15/16 bits),
     ou les indices de palette EGA/VGA 1..15 sont alors interpretes
     comme des valeurs RGB brutes (ex: 8 -> bleu presque noir) au lieu
     de couleurs Noir/Bleu/Vert/.../Jaune/Blanc. On force donc le
     pilote 256 couleurs (palette VGA standard) a sa plus haute
     resolution, ce qui conserve la palette correcte. }
   Driver := D8bit;
   GetModeRange(Driver, LoMode, HiMode);
   If HiMode >= LoMode Then
    Mode := HiMode
   Else Begin
    Driver := Detect;
    Mode := 0;
   End;
  End
   Else
  Begin
   Driver := VGA;
   Mode := VGAHi;
  End;
 {$ELSE}
  Driver := Detect;
  Mode := 0;
 {$ENDIF}
End;

Procedure InitializeGraphics;
Var
 Driver, Mode: Integer;
 ErrCode: Integer;
Begin
 SelectScreenDriverMode(Opts.MaxScreen, Driver, Mode);
 InitGraph(Driver, Mode, '');
 ErrCode := GraphResult;
 If ErrCode <> grOk Then Begin
  WriteLn('DEVENV: Erreur graphique: ', GraphErrorMsg(ErrCode));
  Halt(EXIT_ERROR);
 End;
 SetColor(CLR_EDITOR_TEXT);
 SetBkColor(CLR_BACKGROUND);
 SetLineStyle(SolidLn, 0, NormWidth);
 ScreenMaxMode := Opts.MaxScreen;
End;

{ --- Fermeture du mode graphique --- }

Procedure ShutdownGraphics;
Begin
 CloseGraph;
End;

{ --- Changement de resolution --- }

Procedure SetResolution(W, H: Integer);
Var
 Driver, Mode: Integer;
 ErrCode: Integer;
Begin
 CloseGraph;
 {$IFDEF FPC}
  Driver := VGA;
  If (W >= 1024) And (H >= 768) Then
   Mode := VGAHi    { 640x480, plus haute resolution VGA standard }
  Else If (W >= 640) And (H >= 350) Then
   Mode := VGAMed   { 640x350 }
  Else
   Mode := VGALo;   { 640x200 }
 {$ELSE}
  Driver := Detect;
  Mode := 0;
 {$ENDIF}
 InitGraph(Driver, Mode, '');
 ErrCode := GraphResult;
 If ErrCode <> grOk Then Begin
  WriteLn('DEVENV: Erreur graphique: ', GraphErrorMsg(ErrCode));
  Halt(EXIT_ERROR);
 End;
 SetColor(CLR_EDITOR_TEXT);
 SetBkColor(CLR_BACKGROUND);
 SetLineStyle(SolidLn, 0, NormWidth);
End;

