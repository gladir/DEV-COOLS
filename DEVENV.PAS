 { Correctif 2026-08-15 : le panneau doit apparaitre au meme endroit que  }
 { le ferait un editeur de texte (colle a gauche, sous la barre d         }
 { onglets), pas centre sur toute la largeur de l ecran - l ancien         }
 { centrage empietait visuellement sur la zone de l Explorateur de         }
 { solutions a droite et ne correspondait a aucun autre panneau de l IDE. }
 GridW := P.Cols * P.CharW;
 GridH := P.Rows * P.CharH;
 P.PanelX := 0;
 P.PanelY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
 GridX := P.PanelX;
 GridY := P.PanelY + 24;          { 24 px de barre de titre }
 { ============================================================
   Rendu graphique CGA / EGA / VGA pour modes 04/05/06/0D/0E/10/12/13.
   On rend pixel par pixel via PutPixel BGI. Le scale est calcule
   pour fitter dans la zone editeur disponible.
   ============================================================ }
 If ((P.TargetCPU = '-CD') Or (P.TargetCPU = '-CP') Or (P.TargetCPU = '-CWIN16')) And
    EmuVideo.IsGraphic Then Begin
  Inc(EmuDiag_DrawCnt);
  GfxW := EmuVideo.Width;
  GfxH := EmuVideo.Height;
  Scale := 1;
  If GfxW <= 320 Then Scale := 2;
  If GfxW <= 160 Then Scale := 4;
  If MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT + GfxH * Scale + 60 > ScrH Then Begin
   Scale := (ScrH - MENUBAR_HEIGHT - TOOLBAR_HEIGHT - TAB_HEIGHT - 60) Div GfxH;
   If Scale < 1 Then Scale := 1;
  End;
  GridW := GfxW * Scale;
  GridH := GfxH * Scale;
  { Meme convention que le panneau texte ci-dessus : colle a gauche, sous }
  { la barre d onglets, comme un editeur de texte. }
  P.PanelX := 0;
  P.PanelY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
  GridX := P.PanelX;
  GridY := P.PanelY + 24;
  { Bordure et barre de titre }
  DrawFilledRect(P.PanelX - 2, P.PanelY - 2,
   P.PanelX + GridW + 2, P.PanelY + GridH + 48,
   CLR_BACKGROUND);
  DrawFilledRect(P.PanelX, P.PanelY,
   P.PanelX + GridW, P.PanelY + 22,
   CLR_TITLEBAR_ACTIVE);
  { Compter les pixels non-noirs pour diagnostic. }
  RunStart := 0;
  For Sy := 0 To GfxH - 1 Do
   For Sx := 0 To GfxW - 1 Do
    If Emu_VidGetPixel(Sx, Sy) <> 0 Then Inc(RunStart);
  Title := EmuPanelTitleFor(P.TargetCPU) + ' - ' + P.BinaryPath +
           ' [mode $' + HexByte(EmuVideo.Mode) + ' ' +
           IntToStr(GfxW) + 'x' + IntToStr(GfxH) +
           ' px<>0=' + IntToStr(RunStart) + ']';
  If Length(Title) > 90 Then Title := Copy(Title, 1, 87) + '...';
  DrawText(P.PanelX + 6, P.PanelY + 6, Title, CLR_HIGHLIGHTTEXT);
  DrawText(P.PanelX + GridW - 100, P.PanelY + 6,
   '[Esc] Fermer', CLR_HIGHLIGHTTEXT);
  { Fond noir }
  DrawFilledRect(GridX, GridY, GridX + GridW, GridY + GridH, 0);
  { Rendu pixel : RLE par ligne pour limiter le nombre de
    primitives de dessin. }
  For Sy := 0 To GfxH - 1 Do Begin
   PrevC := -1; RunStart := 0;
   ScY := GridY + Sy * Scale;
   For Sx := 0 To GfxW - 1 Do Begin
    ColorByte := Emu_VidGetPixel(Sx, Sy);
    BgiC := Emu_VidPixelToBGI(ColorByte);
    If BgiC <> PrevC Then Begin
     If (PrevC > 0) Then
      DrawFilledRect(GridX + RunStart * Scale, ScY,
       GridX + Sx * Scale - 1, ScY + Scale - 1, PrevC);
     PrevC := BgiC; RunStart := Sx;
    End;
   End;
   If PrevC > 0 Then
    DrawFilledRect(GridX + RunStart * Scale, ScY,
     GridX + GfxW * Scale - 1, ScY + Scale - 1, PrevC);
  End;
  { Barre d etat }
  DrawFilledRect(GridX, GridY + GridH + 2,
   GridX + GridW, GridY + GridH + 22, CLR_TITLEBAR);
  If P.StatusMsg <> '' Then
   DrawText(GridX + 6, GridY + GridH + 6, P.StatusMsg, CLR_HIGHLIGHTTEXT)
  Else If P.Running Then
   DrawText(GridX + 6, GridY + GridH + 6,
    'En cours d execution (mode graphique)...', CLR_HIGHLIGHTTEXT)
  Else
   DrawText(GridX + 6, GridY + GridH + 6,
    'Arrete (code de fin: ' + IntToStr(P.Fault) + ')', CLR_HIGHLIGHTTEXT);
  P.NeedRepaint := False;
  EmuVideo.GfxDirty := False;
  Exit;
 End;
 { Double buffering reel (2026-08-16) : tout le rendu ci-dessous (bordure,   }
 { titre, fond, ~1000 cellules, curseur, barre d etat) est desormais           }
 { compose sur la page INACTIVE (invisible) plutot que directement sur la    }
 { page a l ecran - PtcGraph supporte le page-flip BGI classique             }
 { (SetActivePage/SetVisualPage), verifie par test dedie avant ce chantier.   }
 { L utilisateur ne voit donc plus jamais un etat partiellement redessine     }
 { (source du scintillement signale : "il faut systematiquement tout          }
 { effacer l ecran et la redessiner") - le flip final (voir la fin de cette   }
 { procedure) est atomique. Volontairement PAS combine avec un rendu           }
 { differentiel (cellule par cellule) : une tentative anterieure a cause      }
 { une regression pire que le scintillement d origine (contenu qui              }
 { disparaissait durablement, voir [[project-devenv]]) - la redondance de     }
 { tout redessiner integralement CHAQUE trame reste volontaire ici, seul le   }
 { flip change. }
 EmuBackPage := 1 - EmuDblBufPage;
 { Recopier l ecran ACTUELLEMENT visible (page EmuDblBufPage) sur la page     }
 { arriere AVANT d y dessiner - seul ce code fait alterner la page             }
 { active/visible dans tout le fichier, donc sans cette recopie toute mise    }
 { a jour d un AUTRE panneau (Explorateur, Terminal, barre d etat...)           }
 { survenue pendant que l emulateur tourne ne serait visible qu une trame      }
 { sur deux. Tampon alloue UNE SEULE fois (taille ecran stable pour la         }
 { duree du processus - un changement de resolution redemarre tout             }
 { DEVENV, voir ToggleScreenZoom) et reutilise a chaque trame. }
 If EmuPageBuf = Nil Then Begin
  EmuPageBufSz := ImageSize(0, 0, GetScreenWidth - 1, GetScreenHeight - 1);
  GetMem(EmuPageBuf, EmuPageBufSz);
 End;
 SetActivePage(EmuDblBufPage);
 GetImage(0, 0, GetScreenWidth - 1, GetScreenHeight - 1, EmuPageBuf^);
 SetActivePage(EmuBackPage);
 PutImage(0, 0, EmuPageBuf^, NormalPut);
 { Bordure et barre de titre }
 DrawFilledRect(P.PanelX - 2, P.PanelY - 2,
  P.PanelX + GridW + 2, P.PanelY + GridH + 48,
  CLR_BACKGROUND);
 DrawFilledRect(P.PanelX, P.PanelY,
  P.PanelX + GridW, P.PanelY + 22,
  CLR_TITLEBAR_ACTIVE);
 Title := EmuPanelTitleFor(P.TargetCPU) + ' - ' + P.BinaryPath;
 If Length(Title) > 76 Then
  Title := Copy(Title, 1, 73) + '...';
 DrawText(P.PanelX + 6, P.PanelY + 6, Title, CLR_HIGHLIGHTTEXT);
 DrawText(P.PanelX + GridW - 100, P.PanelY + 6,
  '[Esc] Fermer', CLR_HIGHLIGHTTEXT);
 { Fond de l ecran emule }
 DrawFilledRect(GridX, GridY, GridX + GridW, GridY + GridH, EmuColor(P.CurBg));
 { Cellules : dessiner chaque caractere avec son attribut.
   On peint TOUJOURS le fond (meme noir) afin que les glyphes
   d OutTextXY (qui utilisent SetBkColor) n affichent pas le
   gris du bureau a la place du fond demande. }
 For Y := 0 To P.Rows - 1 Do Begin
  PixY := GridY + Y * P.CharH;
  For X := 0 To P.Cols - 1 Do Begin
   Cell := P.VRAM[Y, X];
   PixX := GridX + X * P.CharW;
   { Toujours dessiner le fond de la cellule }
   DrawFilledRect(PixX, PixY, PixX + P.CharW - 1,
    PixY + P.CharH - 1, EmuColor(Cell.Bg));
   { Caractere }
   If Cell.Ch <> ' ' Then Begin
    SetBkColor(EmuColor(Cell.Bg));
    If Emu_IsBoxChar(Cell.Ch) Then
     Emu_DrawBoxChar(PixX, PixY, P.CharW, P.CharH, Cell.Ch, EmuColor(Cell.Fg))
    Else Begin
     S := Cell.Ch;
     DrawText(PixX, PixY + 2, S, EmuColor(Cell.Fg));
    End;
   End;
  End;
 End;
 { Restaurer la couleur de fond du desktop }
 SetBkColor(CLR_BACKGROUND);
 { Curseur clignotant : trait souligne }
 If P.CursorOn And (((GetTimestamp Div 500) Mod 2) = 0) Then Begin
  PixX := GridX + P.CursorX * P.CharW;
  PixY := GridY + P.CursorY * P.CharH;
  DrawFilledRect(PixX, PixY + P.CharH - 2,
   PixX + P.CharW - 1, PixY + P.CharH - 1, 15);
 End;
 { Barre d etat sous l ecran emule }
 DrawFilledRect(GridX, GridY + GridH + 2,
  GridX + GridW, GridY + GridH + 22, CLR_TITLEBAR);
 If P.StatusMsg <> '' Then
  DrawText(GridX + 6, GridY + GridH + 6, P.StatusMsg,
   CLR_HIGHLIGHTTEXT)
 Else If P.Running Then
  DrawText(GridX + 6, GridY + GridH + 6,
   'En cours d execution...', CLR_HIGHLIGHTTEXT)
 Else
  DrawText(GridX + 6, GridY + GridH + 6,
   'Arrete (code de fin: ' + IntToStr(P.Fault) + ')',
   CLR_HIGHLIGHTTEXT);
 P.NeedRepaint := False;
 { Flip atomique : la page qu on vient de composer entierement ci-dessus     }
 { devient visible d un coup, aucun etat intermediaire n est jamais visible. }
 { SetActivePage restaure ensuite l invariant "page active = page visible"   }
 { pour le reste de la boucle principale (menus/editeur/etc, qui ignorent     }
 { totalement l existence de plusieurs pages et dessinent toujours sur la    }
 { page active courante). }
 SetVisualPage(EmuBackPage);
 SetActivePage(EmuBackPage);
 EmuDblBufPage := EmuBackPage;
End;

{ ============================================================
  EMULATEUR 8086 - PHASE 2 (1) : etat CPU, memoire et chargeurs
  ----------------------------------------------------------
  Constantes :
    sfNone=0, sfInvalidCode=1, sfHLT=2, sfHotBoot=3, sfColdBoot=4,
    sfInvalidIntr=5, sfEndProgram=6, sfBreakPoint=7, sfDivision0=8
  ============================================================ }

{ --- Convertir un seg:ofs en adresse physique reelle, gate A20 comprise --- }

{ BOGUE REEL (2026-08-24, HMA totalement absent - trouve en poursuivant      }
{ l enquete BOOT/getclus une fois le bogue ES:DI d Emu_DoInt13/AH=08h        }
{ corrige : DOSBox, sur le meme VHD, enchaine "Demarrage de MS-DOS..." puis  }
{ "Verification de la memoire etendue par HIMEM..." - IO.SYS de MS-DOS 5+   }
{ tente TOUJOURS de se reloger dans la HMA via son propre mini-XMS interne,  }
{ meme sans DOS=HIGH explicite dans CONFIG.SYS pas encore lu a ce stade).    }
{ Emu_Addr calculait l adresse lineaire SANS jamais tenir compte de la gate  }
{ A20 (Emu8042.A20Enabled, deja fidelement lue/ecrite via le port 92h mais   }
{ SANS AUCUN EFFET sur l adressage reel avant ce correctif) : un acces a     }
{ FFFF:0010 et plus (HMA, adresses physiques $100000-$10FFEF) etait donc     }
{ soit rejete en silence (Emu_ReadAbsBlock/WriteAbsBlock refusaient tout      }
{ >=$100000), soit non-enveloppe comme sur un vrai PC/XT ou AT gate          }
{ desarmee (qui doivent s enrouler a $100000 plutot que d acceder a une      }
{ zone fantome). Corrige en enveloppant reellement l adresse a 20 bits SAUF   }
{ sur materiel AT+ (Emu_IsATClassHw, verifie inline ici pour eviter une      }
{ reference avant declaration - meme table que celle-ci : 2=AT/3=PS2/        }
{ 6=Compaq Deskpro 386) avec la gate A20 armee - fidele a la fois a un vrai  }
{ 8086/PC-XT (jamais plus de 20 bits d adressage, quelle que soit la gate,   }
{ puisqu il n en a physiquement pas) et a un vrai AT+ gate desarmee (doit     }
{ RE-ENVELOPPER a 1 Mo, pas juste refuser l acces - comportement materiel     }
{ authentique exploite par certains vieux programmes reels). }
{ --- Chercher une base "unreal mode" cachee pour cette VALEUR de registre   }
{ de segment (2026-08-24, BOGUE REEL CORRIGE - voir TEmuUnrealSeg). Le vrai  }
{ mecanisme materiel attache la base cachee au REGISTRE (ES/DS/...), pas a   }
{ sa valeur - cette table associative par VALEUR est une approximation       }
{ deliberee : le code DOS reel de cette epoque charge une poignee fixe de    }
{ selecteurs "plats" et les reutilise tels quels, donc une correspondance    }
{ par valeur suffit en pratique et evite de refaire passer un contexte de    }
{ "quel registre" a travers les ~15 sites d appel d Emu_Addr/Emu_AddrL. }
Function Emu_UnrealBase(Var C: TEmuCPU; Seg: Word; Var Found: Boolean): LongInt;
Var I: Integer;
Begin
 Found := False;
 Emu_UnrealBase := 0;
 For I := 0 To 3 Do
  If C.UnrealSegs[I].Active And (C.UnrealSegs[I].SegVal = Seg) Then Begin
   Found := True;
   Emu_UnrealBase := C.UnrealSegs[I].Base;
   Exit;
  End;
End;

Function Emu_Addr(Var C: TEmuCPU; Seg, Ofs: Word): LongInt;
Var Raw: LongInt; IsATPlusHw: Boolean; UBase: LongInt; UFound: Boolean;
Begin
 { BOGUE REEL CORRIGE (2026-08-24) : une adresse "unreal mode" (base 32     }
 { bits issue d un descripteur GDT, voir TEmuUnrealSeg) est une adresse     }
 { LINEAIRE PLATE reelle - elle ne suit NI la formule Seg*16 NI            }
 { l enveloppement 20 bits/gate A20 (qui ne concernent que l adressage     }
 { segmente reel classique). Verifiee AVANT toute autre logique. }
 UBase := Emu_UnrealBase(C, Seg, UFound);
 If UFound Then Begin
  Emu_Addr := UBase + Ofs;
  Exit;
 End;
 Raw := (LongInt(Seg) Shl 4) + Ofs;
 Case OptionsDlg.Data.DosHardware Of
  2, 3, 6: IsATPlusHw := True;
 Else
  IsATPlusHw := False;
 End;
 If IsATPlusHw And Emu8042.A20Enabled Then Emu_Addr := Raw
 Else Emu_Addr := Raw And $FFFFF;
End;

{ --- Variante 32 bits d Emu_Addr (Ofs jusqu a 32 bits) - BOGUE REEL         }
{ CORRIGE (2026-08-24) : necessaire pour le prefixe $67 (AddrSize32), voir  }
{ TEmuCPU.AddrSize32 - le vrai HIMEM.SYS calcule ses adresses "unreal mode" }
{ avec des registres ESI/EDI/EAX pleins 32 bits, largement au-dela de ce    }
{ qu un Ofs 16 bits peut representer. Meme logique d enveloppement A20 que  }
{ Emu_Addr. }
Function Emu_AddrL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt): LongInt;
Var Raw: LongInt; IsATPlusHw: Boolean; UBase: LongInt; UFound: Boolean;
Begin
 { Meme correctif "unreal mode" que Emu_Addr ci-dessus - voir ce commentaire  }
 { jumeau pour le contexte complet. C est le chemin REELLEMENT emprunte par   }
 { le REP MOVSD $67/$66 de HIMEM.SYS (Emu_Read/WriteDWordL). }
 UBase := Emu_UnrealBase(C, Seg, UFound);
 If UFound Then Begin
  Emu_AddrL := UBase + Ofs;
  Exit;
 End;
 Raw := (LongInt(Seg) Shl 4) + Ofs;
 Case OptionsDlg.Data.DosHardware Of
  2, 3, 6: IsATPlusHw := True;
 Else
  IsATPlusHw := False;
 End;
 If IsATPlusHw And Emu8042.A20Enabled Then Emu_AddrL := Raw
 Else Emu_AddrL := Raw And $FFFFF;
End;

{ --- Lire un bloc absolu depuis la memoire emulee --- }

Procedure Emu_ReadAbsBlock(Var C: TEmuCPU; Addr: LongInt;
 Var Buffer; SizeBytes: Word);
Begin
 If Not C.MemReady Then Exit;
 { Borne alignee sur SizeOf(TEmuMemBuf) plutot que $100000 en dur : couvre    }
 { desormais la HMA (voir Emu_Addr) - un acces au-dela (gate A20 desarmee     }
 { ou materiel PC/XT/AT deja enveloppe par Emu_Addr) n atteint jamais cette   }
 { fonction avec une adresse hors bornes en temps normal, mais la garde       }
 { reste utile pour tout appelant direct (Emu_ReadAbsBlock est aussi         }
 { invoquee avec des adresses deja calculees ailleurs dans ce fichier). }
 If (Addr < 0) Or (Addr >= SizeOf(TEmuMemBuf)) Then Exit;
 If Addr + LongInt(SizeBytes) > SizeOf(TEmuMemBuf) Then
  SizeBytes := Word(LongInt(SizeOf(TEmuMemBuf)) - Addr);
 Move(C.Memory^[Addr], Buffer, SizeBytes);
End;

{ --- Lire un bloc seg:ofs --- }

Procedure Emu_ReadBlock(Var C: TEmuCPU; Seg, Ofs: Word;
 Var Buffer; SizeBytes: Word);
Var
 BPtr: ^Byte;
 I: Word;
 Row, Col: Integer;
 B: Byte;
Begin
 { Activites observees : detection de la lecture de l octet ID BIOS reel   }
 { a F000:FFFEh (dernier octet de la ROM BIOS 64 Ko, voir                  }
 { DosHardwareBiosId/Emu_InitBDA) - un vrai utilitaire DOS/BIOS d epoque le }
 { lit pour distinguer PC/XT/AT/PCjr avant d adapter son comportement. }
 If (Seg = $F000) And (SizeBytes > 0) And
    (LongInt(Ofs) <= $FFFE) And (LongInt(Ofs) + SizeBytes > $FFFE) Then
  EmuActBiosId := True;
 { Mode ATI Graphics Solution 640x200x16 couleurs : lire depuis les plans  }
 { graphiques ($20000+/$30000+, voir Emu_ATIDetectMode/Emu_WriteByte), PAS }
 { depuis la grille de texte generique ci-dessous. Indispensable : les     }
 { logiciels qui font un read-modify-write octet par octet sur B000h/B800h }
 { (ex. GSDEMO1.COM/Get_bb) doivent relire l octet plan reellement ecrit,  }
 { sinon les bits preserves viennent de la grille texte (donnees sans      }
 { rapport) et corrompent chaque octet ecrit ensuite.                      }
 If (EmuVideo.Mode = EMU_MODE_GS640x16) And
    (((Seg And $F800) = $B800) Or ((Seg And $F800) = $B000)) And
    (SizeBytes > 0) Then Begin
  BPtr := @Buffer;
  For I := 0 To SizeBytes - 1 Do Begin
   If (Seg And $F800) = $B800 Then
    BPtr^ := Emu_VidReadByte($20000 +
     ((LongInt(Seg) Shl 4) + Ofs + I - $B8000) And $7FFF)
   Else
    BPtr^ := Emu_VidReadByte($30000 +
     ((LongInt(Seg) Shl 4) + Ofs + I - $B0000) And $7FFF);
   Inc(BPtr);
  End;
  Exit;
 End;
 { Redirection depuis la VRAM virtuelle pour la memoire video texte
   $B800/$B000 : la lecture doit retourner ce qui a ete vu/ecrit
   precedemment (BIOS scroll, sauvegarde d ecran, etc.). }
 If (((Seg And $F800) = $B800) Or ((Seg And $F800) = $B000)) And
    (SizeBytes > 0) Then Begin
  BPtr := @Buffer;
  For I := 0 To SizeBytes - 1 Do Begin
   Row := ((Ofs + I) Shr 1) Div EmuPanel.Cols;
   Col := ((Ofs + I) Shr 1) Mod EmuPanel.Cols;
   B := 0;
   If (Row >= 0) And (Row <= 24) And (Col >= 0) And (Col <= 131) Then Begin
    If ((Ofs + I) And 1) = 0 Then
     B := Byte(Ord(EmuPanel.VRAM[Row, Col].Ch))
    Else
     B := (EmuPanel.VRAM[Row, Col].Fg And $0F) Or
          ((EmuPanel.VRAM[Row, Col].Bg And $07) Shl 4);
   End;
   BPtr^ := B;
   Inc(BPtr);
  End;
  Exit;
 End;
 Emu_ReadAbsBlock(C, Emu_Addr(C, Seg, Ofs), Buffer, SizeBytes);
End;

{ --- Lire un octet seg:ofs --- }

Function Emu_ReadByte(Var C: TEmuCPU; Seg, Ofs: Word): Byte;
Var
 B: Byte;
Begin
 Emu_ReadBlock(C, Seg, Ofs, B, 1);
 Emu_ReadByte := B;
End;

{ --- Lire un mot seg:ofs --- }

Function Emu_ReadWord(Var C: TEmuCPU; Seg, Ofs: Word): Word;
Var
 W: Word;
Begin
 Emu_ReadBlock(C, Seg, Ofs, W, 2);
 Emu_ReadWord := W;
End;

{ --- Lire/ecrire un double mot (32 bits) seg:ofs - operandes 32 bits en     }
{ mode reel (prefixe $66, 386+) - voir OperandSize32/Emu_GetOpDWord. }
Function Emu_ReadDWord(Var C: TEmuCPU; Seg, Ofs: Word): LongInt;
Var
 D: LongInt;
Begin
 Emu_ReadBlock(C, Seg, Ofs, D, 4);
 Emu_ReadDWord := D;
End;

{ --- Variantes offset 32 bits (Emu_*L, prefixe $67/AddrSize32) - BOGUE REEL }
{ CORRIGE (2026-08-24). Contournent volontairement Emu_ReadBlock/           }
{ WriteBlock (et leur traitement special memoire video B000-BFFF/F000) :    }
{ un adressage 32 bits n est exerce en pratique que par du code "unreal     }
{ mode" ciblant de la memoire etendue (>1 Mo), jamais la memoire video ou   }
{ le BIOS - simplification deliberee, symetrique au reste du perimetre $67. }
Function Emu_ReadByteL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt): Byte;
Var B: Byte;
Begin
 B := 0;
 Emu_ReadAbsBlock(C, Emu_AddrL(C, Seg, Ofs), B, 1);
 Emu_ReadByteL := B;
End;

Function Emu_ReadWordL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt): Word;
Var W: Word;
Begin
 W := 0;
 Emu_ReadAbsBlock(C, Emu_AddrL(C, Seg, Ofs), W, 2);
 Emu_ReadWordL := W;
End;

Function Emu_ReadDWordL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt): LongInt;
Var D: LongInt;
Begin
 D := 0;
 Emu_ReadAbsBlock(C, Emu_AddrL(C, Seg, Ofs), D, 4);
 Emu_ReadDWordL := D;
End;

{ --- Ecrire un bloc absolu --- }

Procedure Emu_WriteAbsBlock(Var C: TEmuCPU; Addr: LongInt;
 Var Buffer; SizeBytes: Word);
Var
 WLog: Text; WIO: Integer;
 DBPtr: ^Byte; DumpJ: Word; DumpB: Byte; DumpS: String;
Begin
 If Not C.MemReady Then Exit;
 { Voir le commentaire jumeau dans Emu_ReadAbsBlock (borne HMA). }
 If (Addr < 0) Or (Addr >= SizeOf(TEmuMemBuf)) Then Exit;
 If Addr + LongInt(SizeBytes) > SizeOf(TEmuMemBuf) Then
  SizeBytes := Word(LongInt(SizeOf(TEmuMemBuf)) - Addr);
 { Watch : point de passage UNIQUE pour toute ecriture physique (seg:ofs   }
 { 16 bits via Emu_WriteBlock/Emu_WriteByte, OU adressage 32 bits via      }
 { Emu_WriteByteL/Emu_WriteWordL/Emu_WriteDWordL/Emu_AddrL - ce dernier    }
 { chemin, utilise par l adressage "unreal mode" 32 bits reel (prefixes    }
 { 67h/66h), contournait  }
 { totalement les verifications WATCH dupliquees dans Emu_WriteBlock et    }
 { Emu_WriteByte : un WATCH arme ne detectait alors JAMAIS les ecritures   }
 { d un mouvement memoire 32 bits, bogue reel trouve le 2026-08-25 en      }
 { tracant HIMEM.SYS (qui utilise justement ce mode d adressage). Centre   }
 { ici (sur l adresse physique deja resolue), ce test couvre desormais     }
 { TOUS les chemins d ecriture sans duplication. }
 If EmuWatchEnabled And (SizeBytes > 0) And
    (Addr <= EmuWatchPhysHi) And (Addr + LongInt(SizeBytes) - 1 >= EmuWatchPhysLo) And
    (EmuWatchHits < 200) Then Begin
  Inc(EmuWatchHits);
  {$I-} Assign(WLog, 'EMUWATCH.LOG'); Append(WLog);
  WIO := IOResult;
  If WIO <> 0 Then Begin Assign(WLog,'EMUWATCH.LOG'); Rewrite(WLog); End;
  WriteLn(WLog, '#', EmuWatchHits, ' WABS phys=', HexLong(Addr),
    ' size=', SizeBytes,
    ' steps=', EmuPanel.TotalSteps,
    '   from CS:IP=', HexWord(EmuPanel.CPU.Segs.CS), ':',
    HexWord(EmuPanel.CPU.IP),
    ' AX=', HexWord(EmuPanel.CPU.Regs.AX),
    ' DS=', HexWord(EmuPanel.CPU.Segs.DS),
    ' ES=', HexWord(EmuPanel.CPU.Segs.ES),
    ' DI=', HexWord(EmuPanel.CPU.Regs.DI),
    ' SI=', HexWord(EmuPanel.CPU.Regs.SI));
  DBPtr := @Buffer;
  Write(WLog, '   data=');
  For DumpJ := 0 To SizeBytes - 1 Do Begin
   DumpB := DBPtr^;
   DumpS := Chr(DumpB);
   If (DumpB < 32) Or (DumpB > 126) Then DumpS := '.';
   Write(WLog, HexByte(DumpB), '(', DumpS, ') ');
   Inc(DBPtr);
  End;
  WriteLn(WLog);
  Close(WLog);
  {$I+} If IOResult <> 0 Then ;
 End;
 Move(Buffer, C.Memory^[Addr], SizeBytes);
End;

{ --- Ecrire un bloc seg:ofs --- }

Procedure Emu_WriteBlock(Var C: TEmuCPU; Seg, Ofs: Word;
 Var Buffer; SizeBytes: Word);
Var
 BPtr: ^Byte;
 I: Word;
 Row, Col: Integer;
 B: Byte;
Begin
 { Activites observees (Deboguer > Activites observees) : comptage        }
 { INDEPENDANT du mode video actif (texte/ATI/CGA graphique) - au point    }
 { d entree commun, plutot que duplique dans chaque branche ci-dessous. }
 If (Seg And $F800) = $B800 Then Inc(EmuActVramB800)
 Else If (Seg And $F800) = $B000 Then Inc(EmuActVramB000)
 Else If (Seg And $F000) = $A000 Then Inc(EmuActVramA000);
 { Watch : voir Emu_WriteAbsBlock, point de passage unique (centralise le   }
 { 2026-08-25 - cette fonction delegue toujours a lui, seg:ofs resolu en    }
 { adresse physique en amont, donc y dupliquer le test ici ne ferait que    }
 { compter/logger chaque ecriture deux fois). }
 { Mode ATI Graphics Solution 640x200x16 couleurs : ecrire dans les plans  }
 { graphiques, pas dans la grille de texte generique - voir la meme        }
 { redirection dans Emu_ReadBlock ci-dessus et dans Emu_WriteByte. Sans    }
 { ceci, un REP STOSW (ex. Fill_ram de GSDEMO1.COM) n efface jamais la     }
 { VRAM graphique reelle. }
 If (EmuVideo.Mode = EMU_MODE_GS640x16) And
    (((Seg And $F800) = $B800) Or ((Seg And $F800) = $B000)) And
    (SizeBytes > 0) Then Begin
  BPtr := @Buffer;
  For I := 0 To SizeBytes - 1 Do Begin
   If (Seg And $F800) = $B800 Then
    Emu_VidWriteByte($20000 +
     ((LongInt(Seg) Shl 4) + Ofs + I - $B8000) And $7FFF, BPtr^)
   Else
    Emu_VidWriteByte($30000 +
     ((LongInt(Seg) Shl 4) + Ofs + I - $B0000) And $7FFF, BPtr^);
   Inc(BPtr);
  End;
  Emu_WriteAbsBlock(C, Emu_Addr(C, Seg, Ofs), Buffer, SizeBytes);
  Exit;
 End;
 { Redirection vers VRAM virtuelle pour memoire video texte $B800/$B000 }
 If (((Seg And $F800) = $B800) Or ((Seg And $F800) = $B000)) And
    (SizeBytes > 0) Then Begin
  BPtr := @Buffer;
  For I := 0 To SizeBytes - 1 Do Begin
   B := BPtr^;
   Row := ((Ofs + I) Shr 1) Div EmuPanel.Cols;
   Col := ((Ofs + I) Shr 1) Mod EmuPanel.Cols;
   If (Row >= 0) And (Row <= 24) And (Col >= 0) And (Col <= 131) Then Begin
    If ((Ofs + I) And 1) = 0 Then
     EmuPanel.VRAM[Row, Col].Ch := Chr(B)
    Else Begin
     EmuPanel.VRAM[Row, Col].Fg := B And $0F;
     EmuPanel.VRAM[Row, Col].Bg := (B Shr 4) And $07;
    End;
   End;
   Inc(BPtr);
  End;
  EmuPanel.NeedRepaint := True;
  Exit;
 End;
 Emu_WriteAbsBlock(C, Emu_Addr(C, Seg, Ofs), Buffer, SizeBytes);
End;

{ --- Ecrire un octet seg:ofs --- }

Procedure Emu_WriteByte(Var C: TEmuCPU; Seg, Ofs: Word; X: Byte);
Var Row, Col: Integer;
Begin
 { Activites observees : voir le meme comptage en tete de Emu_WriteBlock - }
 { necessaire ICI AUSSI car les branches B800h/B000h/A000h ci-dessous       }
 { retournent (Exit) AVANT d atteindre la delegation finale a               }
 { Emu_WriteBlock, donc ce dernier ne les voit jamais passer. }
 If (Seg And $F800) = $B800 Then Inc(EmuActVramB800)
 Else If (Seg And $F800) = $B000 Then Inc(EmuActVramB000)
 Else If (Seg And $F000) = $A000 Then Inc(EmuActVramA000);
 { Watch : voir Emu_WriteAbsBlock (point de passage unique, centralise le }
 { 2026-08-25). }
 { Redirection vers VRAM virtuelle si ecriture en memoire video texte $B800/$B000 }
 If ((Seg And $F800) = $B800) Or ((Seg And $F800) = $B000) Then Begin
  { Mode ATI Graphics Solution 640x200x16 couleurs : 2 plans separes,     }
  { B800h ("Hi", 2 bits de poids fort de la couleur) et B000h ("Lo", 2    }
  { bits de poids faible) - voir Emu_ATIDetectMode/Emu_VidSetPixel. Doit  }
  { etre teste AVANT le cas CGA generique ci-dessous, qui ne redirige que }
  { B800h (B000h y tomberait a tort dans le chemin texte VRAM). }
  If EmuVideo.Mode = EMU_MODE_GS640x16 Then Begin
   If (Seg And $F800) = $B800 Then
    Emu_VidWriteByte($20000 +
     ((LongInt(Seg) Shl 4) + Ofs - $B8000) And $7FFF, X)
   Else
    Emu_VidWriteByte($30000 +
     ((LongInt(Seg) Shl 4) + Ofs - $B0000) And $7FFF, X);
   Emu_WriteAbsBlock(C, Emu_Addr(C, Seg, Ofs), X, 1);
   Exit;
  End;
  { En mode graphique CGA (4/5/6), rediriger vers la VRAM unifiee. }
  If EmuVideo.IsGraphic And ((Seg And $F800) = $B800) Then Begin
   Emu_VidWriteByte($20000 + ((LongInt(Seg) Shl 4) + Ofs - $B8000) And $7FFF, X);
   Emu_WriteAbsBlock(C, Emu_Addr(C, Seg, Ofs), X, 1);  { copie aussi en RAM }
   Exit;
  End;
  { EmuPanel.Cols vaut normalement 80, mais 132 en mode texte ATI         }
  { Graphics Solution (EMU_MODE_GSTXT132, voir Emu_ATIDetectMode) -       }
  { calculer dynamiquement plutot que de coder 80 en dur, sinon le texte  }
  { au-dela de la colonne 80 serait perdu. }
  Row := (Ofs Shr 1) Div EmuPanel.Cols;
  Col := (Ofs Shr 1) Mod EmuPanel.Cols;
  If (Row >= 0) And (Row <= 24) And (Col >= 0) And (Col <= 131) Then Begin
   If (Ofs And 1) = 0 Then Begin
    EmuPanel.VRAM[Row, Col].Ch := Chr(X);
   End Else Begin
    EmuPanel.VRAM[Row, Col].Fg := X And $0F;
    EmuPanel.VRAM[Row, Col].Bg := (X Shr 4) And $07;
   End;
   EmuPanel.NeedRepaint := True;
  End;
  Exit;
 End;
 { Redirection planar EGA/VGA pour ecritures dans $A0000..$AFFFF. }
 If EmuVideo.IsGraphic And ((Seg And $F000) = $A000) Then Begin
  { Pre-charger latches via lecture du mot a la meme adresse. }
  EmuVideo.Latch[0] := EmuVideo.Mem^[(LongInt(Seg) Shl 4) + Ofs - $A0000];
  EmuVideo.Latch[1] := EmuVideo.Mem^[$10000 + ((LongInt(Seg) Shl 4) + Ofs - $A0000)];
  EmuVideo.Latch[2] := EmuVideo.Mem^[$20000 + ((LongInt(Seg) Shl 4) + Ofs - $A0000)];
  EmuVideo.Latch[3] := EmuVideo.Mem^[$30000 + ((LongInt(Seg) Shl 4) + Ofs - $A0000)];
  Emu_VidWriteByte((LongInt(Seg) Shl 4) + Ofs - $A0000, X);
  Exit;
 End;
 Emu_WriteBlock(C, Seg, Ofs, X, 1);
End;

{ --- Ecrire un mot seg:ofs --- }

Procedure Emu_WriteWord(Var C: TEmuCPU; Seg, Ofs, X: Word);
Begin
 Emu_WriteBlock(C, Seg, Ofs, X, 2);
End;

Procedure Emu_WriteDWord(Var C: TEmuCPU; Seg, Ofs: Word; X: LongInt);
Begin
 Emu_WriteBlock(C, Seg, Ofs, X, 4);
End;

{ --- Variantes offset 32 bits en ecriture (Emu_*L) - voir le commentaire   }
{ jumeau pres d Emu_ReadByteL. }
Procedure Emu_WriteByteL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt; X: Byte);
Begin
 Emu_WriteAbsBlock(C, Emu_AddrL(C, Seg, Ofs), X, 1);
End;

Procedure Emu_WriteWordL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt; X: Word);
Begin
 Emu_WriteAbsBlock(C, Emu_AddrL(C, Seg, Ofs), X, 2);
End;

Procedure Emu_WriteDWordL(Var C: TEmuCPU; Seg: Word; Ofs: LongInt; X: LongInt);
Begin
 Emu_WriteAbsBlock(C, Emu_AddrL(C, Seg, Ofs), X, 4);
End;

{ --- Construire les adresses statiques d interruptions --- }

Procedure Emu_MakeIntrAddr(Var C: TEmuCPU);
Var
 I: Integer;
 Tbl: Array[0..255] Of LongInt;
Begin
 If Not C.MemReady Then Exit;
 For I := 0 To 255 Do
  Tbl[I] := I + 1;
 Move(Tbl, C.Memory^[0], SizeOf(Tbl));
End;

{ --- Drapeaux : ZF/SF/PF a partir d un octet/mot --- }

Procedure Emu_SetZFB(Var C: TEmuCPU; X: Byte);
Begin
 If X = 0 Then Include(C.Flags.s, EFG_ZF)
          Else Exclude(C.Flags.s, EFG_ZF);
End;

Procedure Emu_SetZFW(Var C: TEmuCPU; X: Word);
Begin
 If X = 0 Then Include(C.Flags.s, EFG_ZF)
          Else Exclude(C.Flags.s, EFG_ZF);
End;

Procedure Emu_SetSFB(Var C: TEmuCPU; X: Byte);
Begin
 If (X And $80) <> 0 Then Include(C.Flags.s, EFG_SF)
                     Else Exclude(C.Flags.s, EFG_SF);
End;

Procedure Emu_SetSFW(Var C: TEmuCPU; X: Word);
Begin
 If (X And $8000) <> 0 Then Include(C.Flags.s, EFG_SF)
                       Else Exclude(C.Flags.s, EFG_SF);
End;

Procedure Emu_SetPF(Var C: TEmuCPU; X: Byte);
Begin
 If C.ParityTable[X] Then Include(C.Flags.s, EFG_PF)
                     Else Exclude(C.Flags.s, EFG_PF);
End;

{ --- Acces aux registres 8 bits par numero --- }

Procedure Emu_SetReg8(Var C: TEmuCPU; Num, Value: Byte);
Begin
 Case Num And 7 Of
  0: C.Regs.AL := Value;
  1: C.Regs.CL := Value;
  2: C.Regs.DL := Value;
  3: C.Regs.BL := Value;
  4: C.Regs.AH := Value;
  5: C.Regs.CH := Value;
  6: C.Regs.DH := Value;
  7: C.Regs.BH := Value;
 End;
End;

Function Emu_GetReg8(Var C: TEmuCPU; Num: Byte): Byte;
Begin
 Case Num And 7 Of
  0: Emu_GetReg8 := C.Regs.AL;
  1: Emu_GetReg8 := C.Regs.CL;
  2: Emu_GetReg8 := C.Regs.DL;
  3: Emu_GetReg8 := C.Regs.BL;
  4: Emu_GetReg8 := C.Regs.AH;
  5: Emu_GetReg8 := C.Regs.CH;
  6: Emu_GetReg8 := C.Regs.DH;
  7: Emu_GetReg8 := C.Regs.BH;
 End;
End;

{ --- Pile : push/pop word --- }

Procedure Emu_PushWord(Var C: TEmuCPU; Value: Word);
Begin
 C.Regs.SP := C.Regs.SP - 2;
 Emu_WriteWord(C, C.Segs.SS, C.Regs.SP, Value);
End;

Function Emu_PopWord(Var C: TEmuCPU): Word;
Begin
 Emu_PopWord := Emu_ReadWord(C, C.Segs.SS, C.Regs.SP);
 C.Regs.SP := C.Regs.SP + 2;
End;

{ --- Pousser/depiler un double mot (32 bits, prefixe $66) --- }
Procedure Emu_PushDWord(Var C: TEmuCPU; Value: LongInt);
Begin
 C.Regs.SP := C.Regs.SP - 4;
 Emu_WriteDWord(C, C.Segs.SS, C.Regs.SP, Value);
End;

Function Emu_PopDWord(Var C: TEmuCPU): LongInt;
Begin
 Emu_PopDWord := Emu_ReadDWord(C, C.Segs.SS, C.Regs.SP);
 C.Regs.SP := C.Regs.SP + 4;
End;

{ --- Initialiser l ordinateur emule (memoire + table d interruption) --- }

Procedure Emu_InitComputer(Var C: TEmuCPU);
Var
 J: LongInt;
 I: Integer;
Begin
 C.CodeBrk := -1;
 { Support "unreal mode" (2026-08-24) - voir TEmuUnrealSeg. CR0.PE=0 (mode  }
 { reel), aucun GDT charge, aucun cache de base "unreal" actif au demarrage. }
 C.CR0 := 0;
 C.GdtBase := 0;
 C.GdtLimit := 0;
 For I := 0 To 3 Do Begin
  C.UnrealSegs[I].Active := False;
  C.UnrealSegs[I].SegVal := 0;
  C.UnrealSegs[I].Base := 0;
 End;
 FillChar(C.ParityTable, SizeOf(C.ParityTable), 0);
 { Pre-calcul de la table de parite : un octet a parite paire si
   son nombre de bits a 1 est pair. Implementation simple. }
 For I := 0 To 255 Do Begin
  J := 0;
  J := I;
  While J <> 0 Do Begin
   C.ParityTable[I] := Not C.ParityTable[I];
   J := J And (J - 1);
  End;
  C.ParityTable[I] := Not C.ParityTable[I];
 End;
 { Allouer 1 Mo en RAM pour la memoire emulee }
 New(C.Memory);
 If C.Memory = Nil Then Begin
  C.MemReady := False;
  Exit;
 End;
 C.MemReady := True;
 { DECISION PERMANENTE (2026-08-19, demande explicite de l utilisateur
   "DOSBox a demontre son efficacite") : remplir la RAM emulee avec un
   octet NON NUL ($F6) plutot que la mettre a zero, pour matcher le
   comportement d un vrai DOS/DOSBox - confirme via le code source
   DOSBox-X (dos_execute.cpp, enquete NC3) que DOS_Execute (la fonction
   EXEC) NE MET JAMAIS LA MEMOIRE A ZERO pour un processus enfant ; une
   vraie machine DOS recycle des blocs potentiellement DEJA UTILISES
   (jamais garantis a zero). L allocateur "bump" de cet emulateur
   (EmuNextFreeSeg, jamais recycle) rendait AUPARAVANT tout segment
   charge (parent ET tout enfant EXEC, AH=4Bh) TOUJOURS vierge/zero -
   contrairement a une vraie machine. $F6 (pas zero, pas aleatoire pour
   rester deterministe/reproductible) est le meme octet deja utilise en
   experience temporaire lors de l enquete NC3 (voir [[project-devenv]]) :
   a lui seul, changeait mesurablement le comportement de NC3.EXE (barre
   de menu rendue propre, barre de touches commence a apparaitre) - mais
   revelait aussi un vrai bogue SEPARE (vecteur IVT $08 manquant, deja
   corrige ailleurs dans ce fichier) qui plantait plus tot avec la
   memoire non nulle seule ; les DEUX correctifs combines n avaient pas
   encore ete pleinement explores avant cette decision. Large changement
   PAR CONCEPTION (affecte TOUS les emulateurs DOS de l IDE, pas
   seulement NC3) - c est la porte etroite de ce fichier ou la memoire
   emulee est allouee, dont le choix se fait UNE SEULE FOIS ici pour
   TOUTE la RAM d une session emulateur (parent + tout futur enfant EXEC
   dans le meme onglet). }
 FillChar(C.Memory^, SizeOf(TEmuMemBuf), $F6);
 { Taille memoire conventionnelle : 640 Ko a l offset 0040:0013 }
 Emu_WriteWord(C, 0, $0413, 640);
 Emu_MakeIntrAddr(C);
 { Reinitialisation des registres }
 FillChar(C.Regs, SizeOf(C.Regs), 0);
 FillChar(C.Segs, SizeOf(C.Segs), 0);
 FillChar(C.Flags, SizeOf(C.Flags), 0);
 C.IP := 0;
 C.Fault := 0;
End;

{ --- Liberer la memoire emulee --- }

Procedure Emu_Done(Var C: TEmuCPU);
Begin
 If C.MemReady Then Begin
  Dispose(C.Memory);
  C.Memory := Nil;
  C.MemReady := False;
 End;
End;

{ Clear-Variable/Set-Variable (2026-08-31, PowerShell dev, demande         }
{ explicite de l'utilisateur - PORTEE CONFIRMEE via AskUserQuestion :       }
{ "DOS seulement, avec limitation honnete documentee" apres avoir           }
{ explique que Linux/ELF64 copie envp[] dans la memoire privee du          }
{ processus des __libc_start_main - modifier les octets de PILE            }
{ d'origine APRES le demarrage n'a alors plus AUCUN effet observable sur    }
{ les getenv() suivants, une limitation d'architecture reelle, pas un       }
{ manque d'effort). Cote DOS, ni Emu_LoadComAt ni Emu_LoadExeAt ne           }
{ construisaient jusqu'ici de VRAI bloc d'environnement (PSP.EnvSeg         }
{ pointait sur $51/AtSeg, jamais peuple) - EmuDosEnvSeg est desormais un    }
{ VRAI segment DEDIE, carve depuis EmuNextFreeSeg (16 paragraphes/256       }
{ octets, memes principes de bump-allocation deja etablis pour l'image      }
{ chargee elle-meme) au chargement, contenant un environnement DOS          }
{ synthetique PLAUSIBLE par defaut (PATH/COMSPEC/PROMPT - pas une copie     }
{ de l'environnement HOTE Windows, qui n'aurait aucun sens pour un          }
{ programme DOS). Format = suite de chaines "NOM=VALEUR" terminees par un   }
{ NUL, la suite entiere terminee par un NUL supplementaire (convention DOS  }
{ standard). Limitation honnete a RAPPELER a chaque appel de Clear/Set-     }
{ Variable (jamais cachee) : la memoire EST reellement modifiee, mais SEUL }
{ un programme qui RELIT son environnement APRES son demarrage (rare en    }
{ pratique - la plupart des .COM/.EXE simples ne le font qu'une fois, au    }
{ lancement) verra le changement. }
Function Emu_DosEnvRead(Var C: TEmuCPU; EnvSeg: Word;
 Var Vars: Array Of String; Var Count: Integer): Boolean;
Const
 ENV_WINDOW_SIZE = 256;
Var
 Buf: Array[0..255] Of Byte;
 Pos, MaxN: Integer;
 S: String;
Begin
 Emu_DosEnvRead := False;
 Count := 0;
 If EnvSeg = 0 Then Exit;
 Emu_ReadBlock(C, EnvSeg, 0, Buf, ENV_WINDOW_SIZE);
 Pos := 0;
 MaxN := High(Vars) + 1;
 While (Pos < ENV_WINDOW_SIZE) And (Buf[Pos] <> 0) And (Count < MaxN) Do Begin
  S := '';
  While (Pos < ENV_WINDOW_SIZE) And (Buf[Pos] <> 0) Do Begin
   S := S + Chr(Buf[Pos]);
   Inc(Pos);
  End;
  Vars[Count] := S;
  Inc(Count);
  Inc(Pos); { saute le NUL de fin de cette chaine }
 End;
 Emu_DosEnvRead := True;
End;

Function Emu_DosEnvWrite(Var C: TEmuCPU; EnvSeg: Word;
 Var Vars: Array Of String; Count: Integer): Boolean;
Const
 ENV_WINDOW_SIZE = 256;
Var
 Buf: Array[0..255] Of Byte;
 Pos, I, J: Integer;
Begin
 Emu_DosEnvWrite := False;
 If EnvSeg = 0 Then Exit;
 FillChar(Buf, SizeOf(Buf), 0);
 Pos := 0;
 For I := 0 To Count - 1 Do Begin
  If Pos + Length(Vars[I]) + 2 > ENV_WINDOW_SIZE Then Exit; { plein, honnete }
  For J := 1 To Length(Vars[I]) Do Begin
   Buf[Pos] := Byte(Vars[I][J]);
   Inc(Pos);
  End;
  Buf[Pos] := 0;
  Inc(Pos);
 End;
 { l'octet suivant (deja 0 via FillChar) sert de NUL final du bloc entier }
 Emu_WriteBlock(C, EnvSeg, 0, Buf, ENV_WINDOW_SIZE);
 Emu_DosEnvWrite := True;
End;

{ Environnement DOS synthetique par defaut - appele UNE FOIS au              }
{ chargement (Emu_LoadComAt/Emu_LoadExeAt ci-dessous), avant tout            }
{ Clear/Set-Variable eventuel. }
Procedure Emu_DosEnvBuildDefault(Var C: TEmuCPU; EnvSeg: Word);
Var
 Vars: Array[0..7] Of String;
Begin
 Vars[0] := 'COMSPEC=C:\COMMAND.COM';
 Vars[1] := 'PATH=C:\';
 Vars[2] := 'PROMPT=$P$G';
 Emu_DosEnvWrite(C, EnvSeg, Vars, 3);
End;

{ --- Charger un fichier .COM dans la memoire emulee --- }

Function Emu_LoadComAt(Var C: TEmuCPU; Const FileName: String; AtSeg: Word;
 Const CmdTail: String): Boolean;
Var
 PSP: TEmuPSPRecord;
 Buffer: Array[0..511] Of Byte;
 Handle: File;
 Size: LongInt;
 ByteReaded: Word;
 ToRead: Word;
 Addr: LongInt;
 N: LongInt;
 I: LongInt;
Begin
 Emu_LoadComAt := False;
 {$I-}
 Assign(Handle, FileName);
 Reset(Handle, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 { Configurer les segments pour un .COM (tous au meme PSP) }
 C.Segs.CS := AtSeg;
 C.Segs.DS := C.Segs.CS;
 C.Segs.ES := C.Segs.CS;
 C.Segs.SS := C.Segs.CS;
 C.Regs.SP := $FFFE;
 C.Regs.BP := $091C;
 C.IP := $100;
 EmuPspSeg := C.Segs.CS;
 EmuExeDir := '';
 For I := Length(FileName) DownTo 1 Do
  If (FileName[I] = '\') Or (FileName[I] = '/') Then Begin
   EmuExeDir := Copy(FileName, 1, I - 1);
   Break;
  End;
 { Construire un PSP minimal }
 FillChar(PSP, SizeOf(PSP), 0);
 PSP.Int20h := $20CD;
 PSP.EndSegPrg := $9FFF;
 PSP.ParentSeg := $52;
 PSP.EnvSeg := $51;
 PSP.LenHandle := 20;
 PSP.HandlePtrOfs := $18;
 PSP.HandlePtrSeg := C.Segs.CS;
 PSP.Int21h := $21CD;
 PSP.RETF := $CB;
 { Injecter la ligne de commande (meme convention que Emu_LoadExeAt : offset
   $80 = longueur, $81..$FE = cmdline, terminee par $0D). Absent de la
   version .COM d origine -jamais reclame par le seul appelant historique-
   mais necessaire pour un enfant .COM lance via EXEC (AH=4Bh). }
 If Length(CmdTail) > 0 Then Begin
  N := Length(CmdTail);
  If N > 126 Then N := 126;
  PSP.Buffer[$80] := Byte(N);
  For I := 1 To N Do
   PSP.Buffer[$80 + I] := Byte(CmdTail[I]);
  PSP.Buffer[$81 + N] := $0D;
 End Else Begin
  PSP.Buffer[$80] := 0;
  PSP.Buffer[$81] := $0D;
 End;
 Emu_WriteBlock(C, C.Segs.CS, 0, PSP.Buffer, $100);
 { Charger le code apres le PSP, par blocs de 512 octets }
 Size := FileSize(Handle);
 Addr := Emu_Addr(C, C.Segs.CS, $100);
 Seek(Handle, 0);
 While Size > 0 Do Begin
  If Size > SizeOf(Buffer) Then ToRead := SizeOf(Buffer)
                           Else ToRead := Word(Size);
  BlockRead(Handle, Buffer, ToRead, ByteReaded);
  Emu_WriteAbsBlock(C, Addr, Buffer, ByteReaded);
  Addr := Addr + ByteReaded;
  Size := Size - ByteReaded;
  If ByteReaded < ToRead Then Break;
 End;
 Close(Handle);
 { Avancer EmuNextFreeSeg au-dela de l image .COM chargee, meme logique et
   memes bornes que Emu_LoadExeAt (necessaire pour qu un enfant .COM lance
   via EXEC (AH=4Bh) qui ferait lui-meme un EXEC imbrique n ecrase pas sa
   propre image ; absent de la version .COM d origine, dont l unique
   appelant historique -premier niveau- n en avait pas besoin car AH=48
   applique deja son propre plancher $2000 quand EmuNextFreeSeg vaut 0). }
 If ((Addr + 15) Shr 4) > 36864 Then
  EmuNextFreeSeg := $9000
 Else
  EmuNextFreeSeg := Word((Addr + 15) Shr 4);
 If EmuNextFreeSeg < $2000 Then EmuNextFreeSeg := $2000;
 { Environnement DOS reel (2026-08-31, Clear/Set-Variable) : contrairement }
 { a Emu_LoadExeAt, aucune zone n'etait deja reservee pour un .COM (PSP.    }
 { EnvSeg=$51 ci-dessus n'etait qu'un placeholder jamais peuple, sans       }
 { rapport avec la memoire reellement libre a ce point) - carve 16          }
 { paragraphes (256 octets) depuis EmuNextFreeSeg, maintenant connu, puis   }
 { corrige le PSP DEJA ECRIT en memoire (le WriteBlock ci-dessus a eu lieu  }
 { avant que EmuNextFreeSeg ne soit calculable) via un patch cible de son   }
 { seul champ EnvSeg (offset $2C, convention PSP standard). }
 EmuDosEnvSeg := EmuNextFreeSeg;
 Emu_DosEnvBuildDefault(C, EmuDosEnvSeg);
 Inc(EmuNextFreeSeg, 16);
 Emu_WriteWord(C, C.Segs.CS, $2C, EmuDosEnvSeg);
 Emu_LoadComAt := True;
End;

Function Emu_LoadCom(Var C: TEmuCPU; Const FileName: String): Boolean;
Begin
 If EmuLoadFixArmOnLoad Then Begin
  EmuLoadFixArmOnLoad := False;
  Emu_LoadCom := Emu_LoadComAt(C, FileName, $1000, EmuStartCmdLine);
 End Else If EmuLoadHighArmOnLoad Then Begin
  EmuLoadHighArmOnLoad := False;
  Emu_LoadCom := Emu_LoadComAt(C, FileName, $C000, EmuStartCmdLine);
 End Else
  Emu_LoadCom := Emu_LoadComAt(C, FileName, $0060, EmuStartCmdLine);
End;

{ --- Charger un fichier .EXE dans la memoire emulee --- }

Function Emu_LoadExeAt(Var C: TEmuCPU; Const FileName: String; AtSeg: Word;
 Const CmdTail: String): Boolean;
Var
 HeadSize, Addr, RPos: LongInt;
 N: LongInt;
 I: LongInt;
 LoadSeg: LongInt;
 PSPSeg, ROff, RSeg, OldPspSeg, McbSize: Word;
 PSP: TEmuPSPRecord;
 Handle: File;
 ByteReaded: Word;
 Exe: TEmuHeaderEXE;
 Buffer: Array[0..255] Of Byte;
 Reloc: Array[0..1] Of Word;
 EnvOfs: Word;
 EnvName: String;
 LogF: Text;
Begin
 Emu_LoadExeAt := False;
 {$I-}
 Assign(Handle, FileName);
 Reset(Handle, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 Seek(Handle, 0);
 BlockRead(Handle, Exe, SizeOf(Exe), ByteReaded);
 If Not ((Exe.Sign[0] = 'M') And (Exe.Sign[1] = 'Z')) Then Begin
  Close(Handle);
  Exit;
 End;
 OldPspSeg := EmuPspSeg;     { PSP du parent (0 si premier niveau) - pour   }
                              { PSP.ParentSeg ci-dessous }
 HeadSize := Exe.SizeOfHeader * 16;
 PSPSeg := AtSeg + 15;       { AtSeg = segment du bloc d environnement ;    }
                              { convention : 15 paragraphes reserves entre   }
                              { l environnement et le PSP (identique a       }
                              { l ancien $0051->$0060 fige, desormais         }
                              { derive de AtSeg pour supporter un chargement }
                              { a un segment quelconque - voir AH=4Bh EXEC). }
 LoadSeg := PSPSeg + 16;     { convention DOS : programme charge a PSP+16 }
 EmuPspSeg := PSPSeg;
 { Memoriser le repertoire de l EXE pour le fallback de recherche
   de fichiers (QP cherche QPL.COM via PATH ; sans PATH defini il
   tombe sur la racine. On essayera donc aussi le dossier de l EXE.) }
 EmuExeDir := '';
 For I := Length(FileName) DownTo 1 Do
  If (FileName[I] = '\') Or (FileName[I] = '/') Then Begin
   EmuExeDir := Copy(FileName, 1, I - 1);
   Break;
  End;
 C.IP := Exe.IP;
 C.Segs.CS := Word(LoadSeg + Exe.OfsLoad);
 C.Segs.DS := PSPSeg;        { au demarrage DS = ES = PSPSeg }
 C.Segs.ES := PSPSeg;
 C.Segs.SS := Word(LoadSeg + Exe.OfsLoadStack);
 C.Regs.SP := Exe.SizeOfStack;
 C.Regs.BP := $091C;
 { PSP }
 FillChar(PSP, SizeOf(PSP), 0);
 PSP.Int20h := $20CD;
 PSP.EndSegPrg := $9FFF;
 PSP.ParentSeg := OldPspSeg;
 PSP.EnvSeg := AtSeg;
 PSP.LenHandle := 20;
 PSP.HandlePtrOfs := $18;
 PSP.HandlePtrSeg := C.Segs.CS;
 PSP.Int21h := $21CD;
 PSP.RETF := $CB;
 { Injecter la ligne de commande dans le PSP : offset $80 = longueur,
   $81..$FE = cmdline (max 126 octets), terminee par $0D ($FF reserve). }
 If Length(CmdTail) > 0 Then Begin
  N := Length(CmdTail);
  If N > 126 Then N := 126;
  PSP.Buffer[$80] := Byte(N);
  For I := 1 To N Do
   PSP.Buffer[$80 + I] := Byte(CmdTail[I]);
  PSP.Buffer[$81 + N] := $0D;
 End Else Begin
  PSP.Buffer[$80] := 0;
  PSP.Buffer[$81] := $0D;
 End;
 Emu_WriteBlock(C, PSPSeg, 0, PSP.Buffer, $100);
 { Environnement DOS reel (2026-08-31, Clear/Set-Variable) : AtSeg est      }
 { DEJA une vraie zone reservee de 15 paragraphes entre l'environnement et  }
 { le PSP (voir le commentaire sur PSPSeg ci-dessus) - jamais peuplee       }
 { jusqu'ici. Aucun carve/patch necessaire ici, juste la remplir. }
 EmuDosEnvSeg := AtSeg;
 Emu_DosEnvBuildDefault(C, EmuDosEnvSeg);
 { Installer un MCB (Memory Control Block) DOS a PSPSeg-1
   pour que le runtime TP/DOS voie la memoire disponible. Format MCB :
   offset 0 : byte 'M' (continue) ou 'Z' (dernier)
   offset 1 : Word owner segment (= PSP du proprietaire)
   offset 3 : Word size en paragraphes (sans le MCB lui-meme)
   offset 5..7 : reserve 3 octets
   offset 8..15 : nom proprietaire (8 octets) }
 { Taille declaree du bloc : jusqu au plafond reel $9F00 utilise par
   l allocateur bump AH=48 (Emu_DoInt21), PAS une valeur fixe $9F9F -
   sinon un programme qui lit cette taille pour dimensionner son propre
   tas (au lieu de systematiquement passer par AH=48/4A) croirait
   disposer de bien plus de memoire que ce qui lui est reellement
   reserve, en particulier pour un enfant EXEC (AH=4Bh) charge haut en
   memoire (PSPSeg proche de $9F00) - risque concret de corruption par
   ecriture au-dela de la zone reellement libre. }
 If PSPSeg < $9F00 Then McbSize := Word($9F00) - PSPSeg
                   Else McbSize := 1;
 Emu_WriteByte(C, Word(PSPSeg - 1), 0, $5A);     { 'Z' bloc final }
 Emu_WriteByte(C, Word(PSPSeg - 1), 1, Lo(PSPSeg));
 Emu_WriteByte(C, Word(PSPSeg - 1), 2, Hi(PSPSeg));
 Emu_WriteByte(C, Word(PSPSeg - 1), 3, Lo(McbSize));
 Emu_WriteByte(C, Word(PSPSeg - 1), 4, Hi(McbSize));
 { Construire un bloc d environnement standard a AtSeg:0000.
   Format DOS :
     [chaines "VAR=val\0" successives]
     \0                   (terminateur final de la liste)
     WORD count = 1
     ASCIIZ chemin complet de l executable
   Pour eviter tout probleme de scan, on ne met aucune variable :
   le bloc commence directement par le \0 final de la liste vide. }
 EnvOfs := 0;
 Emu_WriteByte(C, AtSeg, EnvOfs, 0); Inc(EnvOfs);  { fin liste vide }
 Emu_WriteByte(C, AtSeg, EnvOfs, 1); Inc(EnvOfs);  { count = 1 (Lo) }
 Emu_WriteByte(C, AtSeg, EnvOfs, 0); Inc(EnvOfs);  { count = 1 (Hi) }
 EnvName := FileName;
 For I := 1 To Length(EnvName) Do Begin
  Emu_WriteByte(C, AtSeg, EnvOfs, Byte(EnvName[I])); Inc(EnvOfs);
 End;
 Emu_WriteByte(C, AtSeg, EnvOfs, 0);  { ASCIIZ terminator }
 { Charger l image executable a LoadSeg:0000 (toute l image, pas a CS:IP).
   Calculer la taille reelle de l image : (PagesInFile-1)*512 + BytesInLastPage
   - SizeOfHeader (en octets). Le reste du fichier (overlays, donnees) n est
   PAS charge en memoire ; c est l overlay manager qui le lira a la demande. }
 N := (LongInt(Exe.LenShr9) - 1) * 512 + LongInt(Exe.LenN511) - HeadSize;
 If N < 0 Then N := 0;
 Addr := LongInt(LoadSeg) Shl 4;
 Seek(Handle, HeadSize);
 While (Not Eof(Handle)) And (N > 0) Do Begin
  I := SizeOf(Buffer);
  If LongInt(I) > N Then I := N;
  BlockRead(Handle, Buffer, I, ByteReaded);
  Emu_WriteAbsBlock(C, Addr, Buffer, ByteReaded);
  Addr := Addr + ByteReaded;
  N := N - ByteReaded;
  If ByteReaded < I Then Break;
 End; { Relogement (relocation table) }
 Seek(Handle, Exe.AdrExeTable);
 For I := 1 To Exe.NmSeg Do Begin
  BlockRead(Handle, Reloc, SizeOf(Reloc), ByteReaded);
  If ByteReaded <> SizeOf(Reloc) Then Break;
  ROff := Reloc[0];
  RSeg := Word(LoadSeg + Reloc[1]);
  RPos := LongInt(ROff) + 16 * LongInt(RSeg);
  Emu_ReadAbsBlock(C, RPos, N, 2);
  N := N + LoadSeg;
  Emu_WriteAbsBlock(C, RPos, N, 2);
 End;
 Close(Handle);
 { Initialiser pointeur de segment libre pour AH=48 (allocation memoire).
   Place juste apres l image chargee + MinParagraph (heap reserve). }
 If ((Addr + 15) Shr 4) + LongInt(Exe.MinParagraph) > 36864 Then
  EmuNextFreeSeg := $9000
 Else
  EmuNextFreeSeg := Word((Addr + 15) Shr 4) + Exe.MinParagraph;
 If EmuNextFreeSeg < $2000 Then EmuNextFreeSeg := $2000;
 Emu_LoadExeAt := True;
End;

Function Emu_LoadExe(Var C: TEmuCPU; Const FileName: String): Boolean;
Begin
 If EmuLoadFixArmOnLoad Then Begin
  EmuLoadFixArmOnLoad := False;
  Emu_LoadExe := Emu_LoadExeAt(C, FileName, $1000, EmuStartCmdLine);
 End Else If EmuLoadHighArmOnLoad Then Begin
  EmuLoadHighArmOnLoad := False;
  Emu_LoadExe := Emu_LoadExeAt(C, FileName, $C000, EmuStartCmdLine);
 End Else
  Emu_LoadExe := Emu_LoadExeAt(C, FileName, $0051, EmuStartCmdLine);
End;

{ --- Acces a la memoire virtuelle emulee de l ELF64 (petit-boutiste) --- }

Procedure Emu64_PutByte(Addr: QWord; V: Byte);
Begin
 If Addr <= QWord(High(ELF64_Mem)) Then ELF64_Mem[LongInt(Addr)] := V;
End;

Function Emu64_GetByte(Addr: QWord): Byte;
Begin
 If Addr <= QWord(High(ELF64_Mem)) Then
  Emu64_GetByte := ELF64_Mem[LongInt(Addr)]
 Else
  Emu64_GetByte := 0;
End;

Procedure Emu64_PutQWord(Addr: QWord; V: QWord);
Var
 I: Integer;
Begin
 For I := 0 To 7 Do
  Emu64_PutByte(Addr + QWord(I), Byte(V Shr (I * 8)));
End;

Function Emu64_GetQWord(Addr: QWord): QWord;
Var
 I: Integer;
 R: QWord;
Begin
 R := 0;
 For I := 7 DownTo 0 Do
  R := (R Shl 8) Or Emu64_GetByte(Addr + QWord(I));
 Emu64_GetQWord := R;
End;

Procedure Emu64_PutWord(Addr: QWord; V: Word);
Begin
 Emu64_PutByte(Addr, Byte(V And $FF));
 Emu64_PutByte(Addr + 1, Byte(V Shr 8));
End;

Function Emu64_GetWord(Addr: QWord): Word;
Begin
 Emu64_GetWord := Word(Emu64_GetByte(Addr)) Or (Word(Emu64_GetByte(Addr + 1)) Shl 8);
End;

Procedure Emu64_PutDWord(Addr: QWord; V: LongWord);
Var
 I: Integer;
Begin
 For I := 0 To 3 Do
  Emu64_PutByte(Addr + QWord(I), Byte(V Shr (I * 8)));
End;

Function Emu64_GetDWord(Addr: QWord): LongWord;
Var
 I: Integer;
 R: LongWord;
Begin
 R := 0;
 For I := 3 DownTo 0 Do
  R := (R Shl 8) Or Emu64_GetByte(Addr + QWord(I));
 Emu64_GetDWord := R;
End;

Function Emu64_GetDWordSigned(Addr: QWord): LongInt;
Begin
 Emu64_GetDWordSigned := LongInt(Emu64_GetDWord(Addr));
End;

{ --- Charger un executable Linux ELF64 x86-64 statique dans la memoire  }
{ virtuelle emulee, et preparer la pile initiale (argc/argv/envp/auxv)  }
{ selon l ABI SysV Linux x86-64. Ne prend en charge que les binaires    }
{ statiques (ET_EXEC, sans PT_INTERP/PT_DYNAMIC) - c est le cas de tous }
{ les binaires generes par les compilateurs *CW32 de ce projet pour la  }
{ cible Linux (ex: BINLINUX\*.exe), qui n ont pas d editeur de liens     }
{ dynamique a resoudre. --- }
Function Emu_LoadELF64(Const FileName: String; Const ArgStr: String): Boolean;
Const
 MAX_ELF_ARGS = 16;
Var
 F: File;
 Hdr: TELF64Header;
 PH: TELF64ProgHeader;
 BytesReaded: Word;
 I: Integer;
 SegBuf: Array[0..4095] Of Byte;
 SegLeft: LongInt;
 SegAddr: QWord;
 ToRead: Word;
 MaxAddr: QWord;
 StackTop: QWord;
 SP: QWord;
 Arg0Addr: QWord;
 ArgAddr: Array[1..MAX_ELF_ARGS - 1] Of QWord;
 ArgCount: Integer;
 ArgTok: String;
 APos: Integer;
Begin
 { Demasquer les exceptions arithmetiques du x87 HOTE reel (division par   }
 { zero, invalide, depassement...) pour qu'une division par zero du         }
 { programme invite produise Inf/NaN (IEEE-754) au lieu de declencher une   }
 { exception FPU non geree qui terminerait DEVENV.exe silencieusement.      }
 Set8087CW($037F);
 Emu_LoadELF64 := False;
 ELF64_BinaryPath := FileName;
 ELF64_Halted := False;
 ELF64_LastBadRIP := 0;
 ELF64_BreakHitCount := 0;
 ELF64_ExitCode := 0;
 ELF64_InstrCount := 0;
 ELF64_TraceCount := 0;
 ELF64_SegCount := 0;
 ELF64_LoadBase := 0;
 ELF64_LoadTop := 0;
 FillChar(ELF64_Mem, SizeOf(ELF64_Mem), 0);
 {$I-}
 Assign(F, FileName);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FillChar(Hdr, SizeOf(Hdr), 0);
 BlockRead(F, Hdr, SizeOf(Hdr), BytesReaded);
 If BytesReaded <> SizeOf(Hdr) Then Begin Close(F); Exit; End;
 { Verifier la signature magique 7F 45 4C 46 et le format }
 If (Hdr.Ident0 <> $7F) Or (Hdr.Ident1 <> Ord('E')) Or
    (Hdr.Ident2 <> Ord('L')) Or (Hdr.Ident3 <> Ord('F')) Then Begin
  Close(F); Exit;
 End;
 If Hdr.EIClass <> 2 Then Begin Close(F); Exit; End; { seul le 64 bits }
 If Hdr.EMachine <> $3E Then Begin Close(F); Exit; End; { EM_X86_64    }
 ELF64_EntryPoint := Hdr.EEntry;
 MaxAddr := 0;
 { Parcourir la table des program headers et charger chaque segment       }
 { PT_LOAD a son adresse virtuelle - le reste (PMemSz - PFileSz) est du   }
 { BSS, deja mis a zero par le FillChar ci-dessus.                        }
 For I := 0 To Integer(Hdr.EPhNum) - 1 Do Begin
  {$I-}
  Seek(F, LongInt(Hdr.EPhOff) + LongInt(I) * LongInt(Hdr.EPhEntSize));
  {$I+}
  If IOResult <> 0 Then Begin Close(F); Exit; End;
  FillChar(PH, SizeOf(PH), 0);
  BlockRead(F, PH, SizeOf(PH), BytesReaded);
  If BytesReaded <> SizeOf(PH) Then Begin Close(F); Exit; End;
  If PH.PType = 1 Then Begin { PT_LOAD }
   If (ELF64_SegCount = 0) Or (PH.PVAddr < ELF64_LoadBase) Then
    ELF64_LoadBase := PH.PVAddr;
   If PH.PVAddr + PH.PMemSz > MaxAddr Then MaxAddr := PH.PVAddr + PH.PMemSz;
   If PH.PVAddr + PH.PMemSz > QWord(High(ELF64_Mem)) Then Begin
    Close(F); Exit; { hors de l espace virtuel emule (128 Mo) }
   End;
   If PH.PFileSz > 0 Then Begin
    {$I-}
    Seek(F, LongInt(PH.POffset));
    {$I+}
    If IOResult <> 0 Then Begin Close(F); Exit; End;
    SegAddr := PH.PVAddr;
    SegLeft := LongInt(PH.PFileSz);
    While SegLeft > 0 Do Begin
     If SegLeft > SizeOf(SegBuf) Then ToRead := SizeOf(SegBuf)
                                  Else ToRead := Word(SegLeft);
     BlockRead(F, SegBuf, ToRead, BytesReaded);
     If BytesReaded = 0 Then Break;
     Move(SegBuf, ELF64_Mem[LongInt(SegAddr)], BytesReaded);
     SegAddr := SegAddr + QWord(BytesReaded);
     SegLeft := SegLeft - BytesReaded;
    End;
   End;
   Inc(ELF64_SegCount);
  End;
 End;
 Close(F);
 If ELF64_SegCount = 0 Then Exit; { aucun segment PT_LOAD trouve }
 ELF64_LoadTop := MaxAddr;
 { Le tas (brk) commence juste apres le dernier octet charge, aligne 4 Ko }
 ELF64_BrkStart := (MaxAddr + 4095) And Not QWord(4095);
 ELF64_BrkCur := ELF64_BrkStart;
 { Zone mmap anonyme : allocateur lineaire simple demarrant a 96 Mo, loin }
 { de l image chargee et du tas brk - largement suffisant pour un        }
 { executable statique dont l espace virtuel emule ne fait que 128 Mo.   }
 ELF64_MmapNext := QWord($6000000);
 FillChar(ELF64_FDOpen, SizeOf(ELF64_FDOpen), 0);
 For I := 0 To 7 Do ELF64_FpuReg[I] := 0;
 ELF64_FpuCW := $037F;
 ELF64_FpuC0 := False; ELF64_FpuC2 := False; ELF64_FpuC3 := False;
 ELF64_MXCSR := $1F80;
 FillChar(ELF64_Xmm, SizeOf(ELF64_Xmm), 0);
 { --- Mise en place de la pile initiale (ABI SysV Linux x86-64) ---      }
 { Le sommet de la pile emulee est fixe pres du haut de l espace virtuel  }
 { de 128 Mo (la pile croissant vers le bas). On y pousse d abord la      }
 { chaine argv[0] (chemin du binaire), puis - en remontant vers des       }
 { adresses plus basses - la zone canonique attendue par le code de       }
 { demarrage du runtime : argc, argv[], NULL, envp[], NULL, auxv,        }
 { AT_NULL. Un auxv minimal (AT_NULL seul) suffit a eviter un parcours    }
 { incorrect par le crt0 genere par Free Pascal. ArgStr (ex: "/? foo")    }
 { est decoupe sur les espaces en argv[1..N] (argv[0] restant le chemin   }
 { du binaire), jusqu a MAX_ELF_ARGS-1 arguments supplementaires.         }
 StackTop := QWord(High(ELF64_Mem)) - $10000; { marge de securite en haut }
 StackTop := StackTop And Not QWord(15);      { alignement 16 octets      }
 SP := StackTop;
 SP := SP - QWord(Length(FileName) + 1);
 For I := 1 To Length(FileName) Do
  Emu64_PutByte(SP + QWord(I) - 1, Ord(FileName[I]));
 Emu64_PutByte(SP + QWord(Length(FileName)), 0);
 Arg0Addr := SP;
 { Decouper ArgStr en jetons separes par des espaces, chacun pousse comme }
 { chaine C terminee par zero, son adresse memorisee dans ArgAddr[].      }
 ArgCount := 0;
 APos := 1;
 While APos <= Length(ArgStr) Do Begin
  While (APos <= Length(ArgStr)) And (ArgStr[APos] = ' ') Do Inc(APos);
  If APos > Length(ArgStr) Then Break;
  ArgTok := '';
  While (APos <= Length(ArgStr)) And (ArgStr[APos] <> ' ') Do Begin
   ArgTok := ArgTok + ArgStr[APos];
   Inc(APos);
  End;
  If ArgCount < MAX_ELF_ARGS - 1 Then Begin
   Inc(ArgCount);
   SP := SP - QWord(Length(ArgTok) + 1);
   For I := 1 To Length(ArgTok) Do
    Emu64_PutByte(SP + QWord(I) - 1, Ord(ArgTok[I]));
   Emu64_PutByte(SP + QWord(Length(ArgTok)), 0);
   ArgAddr[ArgCount] := SP;
  End;
 End;
 SP := SP And Not QWord(15); { realigner avant argc/argv/envp/auxv }
 { auxv : AT_NULL (type=0, valeur=0) }
 SP := SP - 16;
 Emu64_PutQWord(SP, 0);
 Emu64_PutQWord(SP + 8, 0);
 { envp[] : tableau vide (NULL final seulement) }
 SP := SP - 8;
 Emu64_PutQWord(SP, 0);
 { argv[] : argv[0], argv[1..ArgCount], puis NULL - pousse en ordre       }
 { inverse (NULL d abord, argv[0] en dernier) pour que argv[0] finisse a  }
 { l adresse la plus basse, celle que RSP pointera au final.              }
 SP := SP - 8;
 Emu64_PutQWord(SP, 0);
 For I := ArgCount DownTo 1 Do Begin
  SP := SP - 8;
  Emu64_PutQWord(SP, ArgAddr[I]);
 End;
 SP := SP - 8;
 Emu64_PutQWord(SP, Arg0Addr);
 { argc = 1 + ArgCount }
 SP := SP - 8;
 Emu64_PutQWord(SP, QWord(1 + ArgCount));
 FillChar(ELF64_Reg, SizeOf(ELF64_Reg), 0);
 ELF64_Reg[REG_RSP] := SP;
 ELF64_RIP := ELF64_EntryPoint;
 ELF64_RFlags := $202; { IF=1, bit reserve 1=1 (etat initial standard)    }
 ELF64_FSBase := 0;
 Emu_LoadELF64 := True;
End;

{ ==========================================================================
  Coeur d execution x86-64 (mode utilisateur) de l emulateur Linux ELF64.
  Decodeur ModRM/SIB/REX generique + jeu d instructions suffisant pour
  parcourir le prologue/corps d un binaire genere par Free Pascal Linux
  jusqu au premier SYSCALL (la table de dispatch des appels systeme
  elle-meme est ajoutee a l etape suivante de la feuille de route).
  ========================================================================== }

Function Elf64_FetchByte: Byte;
Begin
 Elf64_FetchByte := Emu64_GetByte(ELF64_RIP);
 ELF64_RIP := ELF64_RIP + 1;
End;

Function Elf64_FetchImm32Signed: LongInt;
Begin
 Elf64_FetchImm32Signed := Emu64_GetDWordSigned(ELF64_RIP);
 ELF64_RIP := ELF64_RIP + 4;
End;

Function Elf64_FetchImm64: QWord;
Begin
 Elf64_FetchImm64 := Emu64_GetQWord(ELF64_RIP);
 ELF64_RIP := ELF64_RIP + 8;
End;

Function Elf64_FetchImm8Signed: ShortInt;
Begin
 Elf64_FetchImm8Signed := ShortInt(Elf64_FetchByte);
End;

{ Immediat 16 bits (utilise par les formes "iz" des opcodes C7/81/69/B8-BF }
{ /F7 quand le prefixe 66 selectionne un operande 16 bits - sans ceci, un  }
{ immediat de 4 octets est lu a la place de 2, ce qui desynchronise tout   }
{ le decodage des instructions suivantes).                                 }
Function Elf64_FetchImm16Signed: SmallInt;
Var
 Lo, Hi: Byte;
Begin
 Lo := Elf64_FetchByte;
 Hi := Elf64_FetchByte;
 Elf64_FetchImm16Signed := SmallInt(Word(Lo) Or (Word(Hi) Shl 8));
End;

Type
 { Operande decode a partir d un octet ModR/M (+ eventuel SIB) x86-64 }
 TElf64EA = Record
  IsReg   : Boolean;    { True : operande registre (RegIdx)             }
  RegIdx  : Integer;    { si IsReg                                       }
  IsRipRel: Boolean;    { True : adressage relatif a RIP (RipDisp)       }
  RipDisp : LongInt;    { deplacement signe, si IsRipRel                 }
  Addr    : QWord;      { adresse effective deja calculee, sinon         }
 End;

{ Lecture/ecriture d un registre general a la largeur voulue (8/16/32/64).
  Simplification assumee : les registres 8 bits 4..7 sont toujours traites
  comme SPL/BPL/SIL/DIL (forme "avec REX"), jamais comme AH/CH/DH/BH -
  ce que produit toujours un compilateur moderne generant du code 64 bits. }
{ $Q-/$R- pour tout le sous-systeme ELF64 (jusqu a la fin de Elf64_Step) : }
{ l ALU x86-64 emulee doit boucler (wraparound) sur les depassements       }
{ signes/non signes comme le ferait un vrai processeur (ADD/SUB/IMUL/NEG   }
{ sur QWord/Int64, divisions 128 bits...) - sans cela, EIntOverflow ou     }
{ ERangeError termine tout DEVENV.exe des qu un programme invite execute   }
{ une operation arithmetique parfaitement legale qui deborde              }
{ arithmetiquement (meme convention deja appliquee aux autres emulateurs   }
{ de ce fichier pour Z80/6502/6809...).                                   }
{$PUSH}{$Q-}{$R-}
Function Elf64_GetReg(Idx, Size: Integer): QWord;
Begin
 Case Size Of
  8:  Elf64_GetReg := ELF64_Reg[Idx] And $FF;
  16: Elf64_GetReg := ELF64_Reg[Idx] And $FFFF;
  32: Elf64_GetReg := ELF64_Reg[Idx] And $FFFFFFFF;
  Else Elf64_GetReg := ELF64_Reg[Idx];
 End;
End;

Procedure Elf64_SetReg(Idx, Size: Integer; Val: QWord);
Begin
 Case Size Of
  8:  ELF64_Reg[Idx] := (ELF64_Reg[Idx] And Not QWord($FF)) Or (Val And $FF);
  16: ELF64_Reg[Idx] := (ELF64_Reg[Idx] And Not QWord($FFFF)) Or (Val And $FFFF);
  32: ELF64_Reg[Idx] := Val And $FFFFFFFF; { ecrire un registre 32 bits remet les 32 bits hauts a zero (ABI x86-64) }
  Else ELF64_Reg[Idx] := Val;
 End;
End;

{ Etend le signe d une valeur de Size bits (8/16/32/64) vers un Int64 -    }
{ utilise par IMUL/IDIV pour interpreter correctement les operandes.      }
Function Elf64_SignExtend(Val: QWord; Size: Integer): Int64;
Begin
 Case Size Of
  8:  Elf64_SignExtend := Int64(ShortInt(Val And $FF));
  16: Elf64_SignExtend := Int64(SmallInt(Val And $FFFF));
  32: Elf64_SignExtend := Int64(LongInt(Val And $FFFFFFFF));
  Else Elf64_SignExtend := Int64(Val);
 End;
End;

{ Construit un TElf64EA pointant directement sur une adresse memoire      }
{ deja calculee (utilise par CMPS/SCAS, qui adressent [RSI]/[RDI]         }
{ directement plutot que via un ModRM).                                   }
Function Elf64_MemEA(Addr: QWord): TElf64EA;
Var
 EA: TElf64EA;
Begin
 FillChar(EA, SizeOf(EA), 0);
 EA.Addr := Addr;
 Elf64_MemEA := EA;
End;

Function Elf64_ResolveEA(Const EA: TElf64EA): QWord;
Begin
 If EA.IsRipRel Then
  Elf64_ResolveEA := ELF64_RIP + QWord(Int64(EA.RipDisp))
 Else
  Elf64_ResolveEA := EA.Addr;
End;

{ Decode un octet ModR/M (et son eventuel octet SIB + deplacement) en      }
{ commencant a ELF64_RIP, qu il avance d autant d octets que necessaire.   }
{ RegField recoit le champ Reg (etendu par REX.R) - utilise soit comme     }
{ numero de registre, soit comme extension d opcode (groupes 80/81/83,     }
{ F6/F7, FF) selon l instruction appelante.                                }
Function Elf64_DecodeModRM(RexR, RexX, RexB: Boolean; Var RegField: Integer): TElf64EA;
Var
 EA: TElf64EA;
 ModRMByte, SibByte: Byte;
 Md, Rm, Scale, Idx, Base: Byte;
 Disp8: ShortInt;
 Disp32: LongInt;
 HasIndex, HasBase: Boolean;
 IdxVal, BaseVal: QWord;
Begin
 FillChar(EA, SizeOf(EA), 0);
 ModRMByte := Elf64_FetchByte;
 Md := (ModRMByte Shr 6) And 3;
 RegField := (ModRMByte Shr 3) And 7;
 If RexR Then RegField := RegField Or 8;
 Rm := ModRMByte And 7;
 If Md = 3 Then Begin
  EA.IsReg := True;
  EA.RegIdx := Rm;
  If RexB Then EA.RegIdx := EA.RegIdx Or 8;
  Elf64_DecodeModRM := EA;
  Exit;
 End;
 HasIndex := False; IdxVal := 0;
 HasBase := True; BaseVal := 0;
 Disp32 := 0;
 If Rm = 4 Then Begin
  { octet SIB present }
  SibByte := Elf64_FetchByte;
  Scale := (SibByte Shr 6) And 3;
  Idx := (SibByte Shr 3) And 7;
  Base := SibByte And 7;
  If (Idx = 4) And Not RexX Then
   HasIndex := False
  Else Begin
   HasIndex := True;
   If RexX Then Idx := Idx Or 8;
   IdxVal := ELF64_Reg[Idx] Shl Scale;
  End;
  If (Base = 5) And (Md = 0) Then Begin
   HasBase := False;
   Disp32 := Elf64_FetchImm32Signed;
  End Else Begin
   If RexB Then Base := Base Or 8;
   BaseVal := ELF64_Reg[Base];
  End;
 End Else If (Rm = 5) And (Md = 0) Then Begin
  { Adressage relatif a RIP : resolu plus tard (une fois l instruction    }
  { entiere, y compris un eventuel immediat final, consommee).            }
  Disp32 := Elf64_FetchImm32Signed;
  EA.IsRipRel := True;
  EA.RipDisp := Disp32;
  Elf64_DecodeModRM := EA;
  Exit;
 End Else Begin
  Base := Rm;
  If RexB Then Base := Base Or 8;
  BaseVal := ELF64_Reg[Base];
 End;
 If Md = 1 Then Begin
  Disp8 := Elf64_FetchImm8Signed;
  Disp32 := Disp8;
 End Else If Md = 2 Then
  Disp32 := Elf64_FetchImm32Signed;
 EA.Addr := 0;
 If HasBase Then EA.Addr := EA.Addr + BaseVal;
 If HasIndex Then EA.Addr := EA.Addr + IdxVal;
 EA.Addr := EA.Addr + QWord(Int64(Disp32));
 Elf64_DecodeModRM := EA;
End;

Function Elf64_ReadOperand(Const EA: TElf64EA; Size: Integer): QWord;
Var
 A: QWord;
Begin
 If EA.IsReg Then
  Elf64_ReadOperand := Elf64_GetReg(EA.RegIdx, Size)
 Else Begin
  A := Elf64_ResolveEA(EA);
  Case Size Of
   8:  Elf64_ReadOperand := Emu64_GetByte(A);
   16: Elf64_ReadOperand := Emu64_GetWord(A);
   32: Elf64_ReadOperand := Emu64_GetDWord(A);
   Else Elf64_ReadOperand := Emu64_GetQWord(A);
  End;
 End;
End;

Procedure Elf64_WriteOperand(Const EA: TElf64EA; Size: Integer; Val: QWord);
Var
 A: QWord;
Begin
 If EA.IsReg Then
  Elf64_SetReg(EA.RegIdx, Size, Val)
 Else Begin
  A := Elf64_ResolveEA(EA);
  Case Size Of
   8:  Emu64_PutByte(A, Byte(Val And $FF));
   16: Emu64_PutWord(A, Word(Val And $FFFF));
   32: Emu64_PutDWord(A, LongWord(Val And $FFFFFFFF));
   Else Emu64_PutQWord(A, Val);
  End;
 End;
End;

Procedure Elf64_SizeMaskAndSign(Size: Integer; Var Mask, SignBit: QWord);
Begin
 Case Size Of
  8:  Begin Mask := $FF; SignBit := $80; End;
  16: Begin Mask := $FFFF; SignBit := $8000; End;
  32: Begin Mask := $FFFFFFFF; SignBit := $80000000; End;
  Else Begin Mask := QWord($FFFFFFFFFFFFFFFF); SignBit := QWord($8000000000000000); End;
 End;
End;

Procedure Elf64_SetFlagsLogic(ResVal: QWord; Size: Integer);
Var
 Mask, SignBit: QWord;
Begin
 Elf64_SizeMaskAndSign(Size, Mask, SignBit);
 ResVal := ResVal And Mask;
 ELF64_FZF := (ResVal = 0);
 ELF64_FSF := (ResVal And SignBit) <> 0;
 ELF64_FCF := False;
 ELF64_FOF := False;
End;

Procedure Elf64_SetFlagsAdd(A, B, ResVal: QWord; Size: Integer);
Var
 Mask, SignBit: QWord;
 SignA, SignB, SignR: Boolean;
Begin
 Elf64_SizeMaskAndSign(Size, Mask, SignBit);
 A := A And Mask; B := B And Mask; ResVal := ResVal And Mask;
 ELF64_FZF := (ResVal = 0);
 ELF64_FSF := (ResVal And SignBit) <> 0;
 ELF64_FCF := (ResVal < A);
 SignA := (A And SignBit) <> 0;
 SignB := (B And SignBit) <> 0;
 SignR := (ResVal And SignBit) <> 0;
 ELF64_FOF := (SignA = SignB) And (SignR <> SignA);
End;

Procedure Elf64_SetFlagsSub(A, B, ResVal: QWord; Size: Integer);
Var
 Mask, SignBit: QWord;
 SignA, SignB, SignR: Boolean;
Begin
 Elf64_SizeMaskAndSign(Size, Mask, SignBit);
 A := A And Mask; B := B And Mask; ResVal := ResVal And Mask;
 ELF64_FZF := (ResVal = 0);
 ELF64_FSF := (ResVal And SignBit) <> 0;
 ELF64_FCF := (A < B);
 SignA := (A And SignBit) <> 0;
 SignB := (B And SignBit) <> 0;
 SignR := (ResVal And SignBit) <> 0;
 ELF64_FOF := (SignA <> SignB) And (SignR <> SignA);
End;

{ Calcule et applique les fanions pour l une des 8 operations ALU         }
{ standard (encodage x86 : 0=ADD 1=OR 2=ADC 3=SBB 4=AND 5=SUB 6=XOR       }
{ 7=CMP) - CMP se comporte comme SUB mais sans ecrire le resultat         }
{ (l appelant ne doit pas rappeler Elf64_WriteOperand pour AluOp=7).      }
Function Elf64_AluCompute(AluOp: Integer; A, B: QWord; Size: Integer): QWord;
Var
 R, CarryIn: QWord;
Begin
 CarryIn := 0;
 If ELF64_FCF Then CarryIn := 1;
 Case AluOp Of
  0: Begin R := A + B; Elf64_SetFlagsAdd(A, B, R, Size); End;
  1: Begin R := A Or B; Elf64_SetFlagsLogic(R, Size); End;
  2: Begin R := A + B + CarryIn; Elf64_SetFlagsAdd(A, B + CarryIn, R, Size); End;
  3: Begin R := A - B - CarryIn; Elf64_SetFlagsSub(A, B + CarryIn, R, Size); End;
  4: Begin R := A And B; Elf64_SetFlagsLogic(R, Size); End;
  5: Begin R := A - B; Elf64_SetFlagsSub(A, B, R, Size); End;
  6: Begin R := A Xor B; Elf64_SetFlagsLogic(R, Size); End;
  7: Begin R := A - B; Elf64_SetFlagsSub(A, B, R, Size); End;
  Else R := A;
 End;
 Elf64_AluCompute := R;
End;

Procedure Elf64_Push(Val: QWord);
Begin
 ELF64_Reg[REG_RSP] := ELF64_Reg[REG_RSP] - 8;
 Emu64_PutQWord(ELF64_Reg[REG_RSP], Val);
End;

Function Elf64_Pop: QWord;
Begin
 Elf64_Pop := Emu64_GetQWord(ELF64_Reg[REG_RSP]);
 ELF64_Reg[REG_RSP] := ELF64_Reg[REG_RSP] + 8;
End;

{ Conditions Jcc/SETcc standard (0..F). ELF64_FPF (JP/JPE/JNP/JPO) n est  }
{ alimente que par les comparaisons x87 (FCOM/FUCOM/FNSTSW+SAHF), le cas  }
{ d usage reel de ces conditions - la parite d un resultat ALU entier     }
{ n est elle pas calculee (limitation connue, rarement testee en          }
{ pratique par du code genere par un compilateur).                        }
Function Elf64_EvalCond(CondCode: Byte): Boolean;
Begin
 Case CondCode Of
  $0: Elf64_EvalCond := ELF64_FOF;
  $1: Elf64_EvalCond := Not ELF64_FOF;
  $2: Elf64_EvalCond := ELF64_FCF;
  $3: Elf64_EvalCond := Not ELF64_FCF;
  $4: Elf64_EvalCond := ELF64_FZF;
  $5: Elf64_EvalCond := Not ELF64_FZF;
  $6: Elf64_EvalCond := ELF64_FCF Or ELF64_FZF;
  $7: Elf64_EvalCond := (Not ELF64_FCF) And (Not ELF64_FZF);
  $8: Elf64_EvalCond := ELF64_FSF;
  $9: Elf64_EvalCond := Not ELF64_FSF;
  $A: Elf64_EvalCond := ELF64_FPF;
  $B: Elf64_EvalCond := Not ELF64_FPF;
  $C: Elf64_EvalCond := ELF64_FSF <> ELF64_FOF;
  $D: Elf64_EvalCond := ELF64_FSF = ELF64_FOF;
  $E: Elf64_EvalCond := ELF64_FZF Or (ELF64_FSF <> ELF64_FOF);
  $F: Elf64_EvalCond := (Not ELF64_FZF) And (ELF64_FSF = ELF64_FOF);
  Else Elf64_EvalCond := False;
 End;
End;

{ MOVSB/MOVSW/MOVSD/MOVSQ : copie [RSI]->[RDI] puis avance RSI/RDI de     }
{ Sz/8 octets (sens donne par ELF64_FDF, mis a jour par CLD/STD).         }
Procedure Elf64_DoMovs(Sz: Integer);
Var
 Step: QWord;
Begin
 Case Sz Of
  8:  Emu64_PutByte(ELF64_Reg[REG_RDI], Emu64_GetByte(ELF64_Reg[REG_RSI]));
  16: Emu64_PutWord(ELF64_Reg[REG_RDI], Emu64_GetWord(ELF64_Reg[REG_RSI]));
  32: Emu64_PutDWord(ELF64_Reg[REG_RDI], Emu64_GetDWord(ELF64_Reg[REG_RSI]));
  Else Emu64_PutQWord(ELF64_Reg[REG_RDI], Emu64_GetQWord(ELF64_Reg[REG_RSI]));
 End;
 Step := QWord(Sz Div 8);
 If ELF64_FDF Then Begin
  ELF64_Reg[REG_RSI] := ELF64_Reg[REG_RSI] - Step;
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - Step;
 End Else Begin
  ELF64_Reg[REG_RSI] := ELF64_Reg[REG_RSI] + Step;
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + Step;
 End;
End;

{ STOSB/STOSW/STOSD/STOSQ : ecrit AL/AX/EAX/RAX en [RDI] puis avance RDI. }
Procedure Elf64_DoStos(Sz: Integer);
Begin
 Case Sz Of
  8:  Emu64_PutByte(ELF64_Reg[REG_RDI], Byte(ELF64_Reg[REG_RAX] And $FF));
  16: Emu64_PutWord(ELF64_Reg[REG_RDI], Word(ELF64_Reg[REG_RAX] And $FFFF));
  32: Emu64_PutDWord(ELF64_Reg[REG_RDI], LongWord(ELF64_Reg[REG_RAX] And $FFFFFFFF));
  Else Emu64_PutQWord(ELF64_Reg[REG_RDI], ELF64_Reg[REG_RAX]);
 End;
 If ELF64_FDF Then
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - QWord(Sz Div 8)
 Else
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + QWord(Sz Div 8);
End;

{ Avance RSI et RDI de Sz/8 octets (sens ELF64_FDF) sans copier - utilise }
{ par CMPSB/CMPSW/CMPSD/CMPSQ.                                            }
Procedure Elf64_AdvanceSIDI(Sz: Integer);
Var
 Step: QWord;
Begin
 Step := QWord(Sz Div 8);
 If ELF64_FDF Then Begin
  ELF64_Reg[REG_RSI] := ELF64_Reg[REG_RSI] - Step;
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - Step;
 End Else Begin
  ELF64_Reg[REG_RSI] := ELF64_Reg[REG_RSI] + Step;
  ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + Step;
 End;
End;

{ Decalages/rotations (groupe 2 : C0/C1/D0/D1/D2/D3). AluOp : 0=ROL 1=ROR }
{ 2=RCL 3=RCR (non geres, traites en no-op - limitation connue) 4/6=SHL   }
{ 5=SHR 7=SAR. Limitation connue : OF n est calcule que pour un compte de }
{ 1 (comme l exige reellement le processeur, qui le laisse indefini au   }
{ dela) ; CF/ZF/SF sont mis a jour a chaque decalage effectue.           }
Function Elf64_DoShift(GroupOp: Integer; Val: QWord; Cnt, Size: Integer): QWord;
Var
 Mask, SignBit: QWord;
 Res: QWord;
 CFOut, SignWasSet: Boolean;
 I: Integer;
Begin
 Elf64_SizeMaskAndSign(Size, Mask, SignBit);
 Res := Val And Mask;
 CFOut := ELF64_FCF;
 Case GroupOp Of
  4, 6: { SHL/SAL }
   For I := 1 To Cnt Do Begin
    CFOut := (Res And SignBit) <> 0;
    Res := (Res Shl 1) And Mask;
   End;
  5: { SHR }
   For I := 1 To Cnt Do Begin
    CFOut := (Res And 1) <> 0;
    Res := Res Shr 1;
   End;
  7: { SAR }
   For I := 1 To Cnt Do Begin
    CFOut := (Res And 1) <> 0;
    SignWasSet := (Res And SignBit) <> 0;
    Res := Res Shr 1;
    If SignWasSet Then Res := Res Or SignBit;
   End;
  0: { ROL }
   For I := 1 To Cnt Do Begin
    CFOut := (Res And SignBit) <> 0;
    Res := ((Res Shl 1) Or QWord(Ord(CFOut))) And Mask;
   End;
  1: { ROR }
   For I := 1 To Cnt Do Begin
    CFOut := (Res And 1) <> 0;
    Res := (Res Shr 1);
    If CFOut Then Res := Res Or SignBit;
   End;
  { Else : RCL/RCR non geres, Res reste inchange }
 End;
 If Cnt > 0 Then Begin
  ELF64_FCF := CFOut;
  ELF64_FZF := (Res = 0);
  ELF64_FSF := (Res And SignBit) <> 0;
  If Cnt = 1 Then
   Case GroupOp Of
    4, 6: ELF64_FOF := (((Res And SignBit) <> 0) <> CFOut);
    5:    ELF64_FOF := (Val And SignBit) <> 0;
    7:    ELF64_FOF := False;
   End;
 End;
 Elf64_DoShift := Res;
End;

{ IMUL a 2/3 operandes (0F AF, 69, 6B) : ne conserve que les Size bits    }
{ de poids faible du produit signe (comme le fait reellement le          }
{ processeur pour ces formes). Limitation connue : pour Size=64, le      }
{ debordement (CF/OF) n est pas detecte precisement (necessiterait une   }
{ multiplication 128 bits complete) - seul le resultat tronque compte    }
{ pour la plupart du code genere par un compilateur.                     }
Function Elf64_ImulTrunc(A, B: QWord; Size: Integer): QWord;
Var
 Full: Int64;
 Res: QWord;
Begin
 If Size = 64 Then Begin
  Res := A * B;
  ELF64_FCF := False; ELF64_FOF := False;
  Elf64_ImulTrunc := Res;
  Exit;
 End;
 Full := Elf64_SignExtend(A, Size) * Elf64_SignExtend(B, Size);
 Case Size Of
  8: Begin
   Res := QWord(Full) And $FF;
   ELF64_FCF := (Full < -128) Or (Full > 127);
  End;
  16: Begin
   Res := QWord(Full) And $FFFF;
   ELF64_FCF := (Full < -32768) Or (Full > 32767);
  End;
  Else Begin
   Res := QWord(Full) And $FFFFFFFF;
   ELF64_FCF := (Full < -2147483648) Or (Full > 2147483647);
  End;
 End;
 ELF64_FOF := ELF64_FCF;
 Elf64_ImulTrunc := Res;
End;

{ Multiplication non signee 64x64 -> 128 bits (schoolbook, par moities   }
{ 32 bits) - necessaire car FPC 3.2.0 n a pas de type entier 128 bits    }
{ natif en mode TP. Utilisee par MUL/IMUL pleine largeur (F7 /4 et /5).  }
Procedure Elf64_UMul64(A, B: QWord; Var HiOut, LoOut: QWord);
Var
 ALo, AHi, BLo, BHi: QWord;
 Lo, M1, M2, Hi, T, Carry: QWord;
Begin
 ALo := A And $FFFFFFFF; AHi := A Shr 32;
 BLo := B And $FFFFFFFF; BHi := B Shr 32;
 Lo := ALo * BLo;
 M1 := ALo * BHi;
 M2 := AHi * BLo;
 Hi := AHi * BHi;
 T := Lo + (M1 Shl 32);
 If T < Lo Then Carry := 1 Else Carry := 0;
 Hi := Hi + (M1 Shr 32) + Carry;
 Lo := T;
 T := Lo + (M2 Shl 32);
 If T < Lo Then Carry := 1 Else Carry := 0;
 Hi := Hi + (M2 Shr 32) + Carry;
 LoOut := T;
 HiOut := Hi;
End;

{ Multiplication signee 64x64 -> 128 bits, via valeurs absolues puis     }
{ correction de signe sur le resultat 128 bits.                          }
Procedure Elf64_SMul64(A, B: QWord; Var HiOut, LoOut: QWord);
Var
 NegA, NegB: Boolean;
 AbsA, AbsB: QWord;
Begin
 NegA := (A And QWord($8000000000000000)) <> 0;
 NegB := (B And QWord($8000000000000000)) <> 0;
 If NegA Then AbsA := (Not A) + 1 Else AbsA := A;
 If NegB Then AbsB := (Not B) + 1 Else AbsB := B;
 Elf64_UMul64(AbsA, AbsB, HiOut, LoOut);
 If NegA <> NegB Then Begin
  LoOut := Not LoOut;
  HiOut := Not HiOut;
  LoOut := LoOut + 1;
  If LoOut = 0 Then HiOut := HiOut + 1;
 End;
End;

{ Division non signee d un dividende 128 bits (NHi:NLo) par un diviseur  }
{ 64 bits D, par division binaire restauree bit a bit (128 iterations).  }
{ Renvoie False si D=0 ou si le quotient deborde 64 bits (NHi >= D),      }
{ exactement comme le declenchement de l exception #DE reelle. Limitation}
{ connue : pour un diviseur D > 2^63, le calcul intermediaire du reste   }
{ peut deborder un QWord - cas extremement rare en code compile normal.  }
Function Elf64_UDiv128(NHi, NLo, D: QWord; Var Quot, Rem: QWord): Boolean;
Var
 I: Integer;
 R, Q, Bit: QWord;
Begin
 If (D = 0) Or (NHi >= D) Then Begin
  Elf64_UDiv128 := False;
  Exit;
 End;
 R := 0; Q := 0;
 For I := 63 DownTo 0 Do Begin
  Bit := (NHi Shr I) And 1;
  R := (R Shl 1) Or Bit;
  Q := Q Shl 1;
  If R >= D Then Begin R := R - D; Q := Q Or 1; End;
 End;
 For I := 63 DownTo 0 Do Begin
  Bit := (NLo Shr I) And 1;
  R := (R Shl 1) Or Bit;
  Q := Q Shl 1;
  If R >= D Then Begin R := R - D; Q := Q Or 1; End;
 End;
 Quot := Q; Rem := R;
 Elf64_UDiv128 := True;
End;

{ Division signee 128/64 : valeurs absolues via Elf64_UDiv128, puis       }
{ correction de signe (quotient = signe(N) xor signe(D), reste = signe   }
{ du dividende, comme l ABI). Limitation connue : le cas limite           }
{ MinInt64 div -1 (debordement signe) n est pas detecte specifiquement.  }
Function Elf64_SDiv128(NHi, NLo, D: QWord; Var Quot, Rem: QWord): Boolean;
Var
 NegN, NegD: Boolean;
 UHi, ULo, UD, UQuot, URem, Carry: QWord;
Begin
 NegD := (D And QWord($8000000000000000)) <> 0;
 If NegD Then UD := (Not D) + 1 Else UD := D;
 NegN := (NHi And QWord($8000000000000000)) <> 0;
 If NegN Then Begin
  ULo := (Not NLo) + 1;
  If ULo = 0 Then Carry := 1 Else Carry := 0;
  UHi := (Not NHi) + Carry;
 End Else Begin
  UHi := NHi; ULo := NLo;
 End;
 If Not Elf64_UDiv128(UHi, ULo, UD, UQuot, URem) Then Begin
  Elf64_SDiv128 := False;
  Exit;
 End;
 If NegN <> NegD Then Quot := (Not UQuot) + 1 Else Quot := UQuot;
 If NegN Then Rem := (Not URem) + 1 Else Rem := URem;
 Elf64_SDiv128 := True;
End;

{ ==========================================================================
  Coprocesseur x87 (mode utilisateur). La pile de registres est simulee
  par decalage physique du tableau ELF64_FpuReg (PUSH/POP deplacent les
  valeurs), ce qui permet d adresser ST(i) par un simple indice constant
  plutot que par un pointeur de sommet circulaire. L arithmetique est
  deleguee au type Extended natif de FPC (reel 80 bits x87 sur cette
  cible), ce qui evite de reimplementer un format flottant a la main.
  ========================================================================== }

Procedure Elf64_FpuPush(V: Extended);
Var
 I: Integer;
Begin
 For I := 7 DownTo 1 Do ELF64_FpuReg[I] := ELF64_FpuReg[I - 1];
 ELF64_FpuReg[0] := V;
End;

Function Elf64_FpuPop: Extended;
Var
 I: Integer;
Begin
 Elf64_FpuPop := ELF64_FpuReg[0];
 For I := 0 To 6 Do ELF64_FpuReg[I] := ELF64_FpuReg[I + 1];
 ELF64_FpuReg[7] := 0;
End;

{ Met a jour les fanions de condition x87 C0/C2/C3 (image de FCOM/FUCOM) }
{ - non ordonne (NaN) traite comme "non comparable" (C0=C2=C3=1).        }
Procedure Elf64_FpuCompare(A, B: Extended);
Begin
 If A > B Then Begin ELF64_FpuC0 := False; ELF64_FpuC2 := False; ELF64_FpuC3 := False; End
 Else If A < B Then Begin ELF64_FpuC0 := True; ELF64_FpuC2 := False; ELF64_FpuC3 := False; End
 Else If A = B Then Begin ELF64_FpuC0 := False; ELF64_FpuC2 := False; ELF64_FpuC3 := True; End
 Else Begin ELF64_FpuC0 := True; ELF64_FpuC2 := True; ELF64_FpuC3 := True; End;
End;

{ FCOMI/FUCOMI : comme Elf64_FpuCompare, mais expose directement le      }
{ resultat dans les fanions entiers (CF=C0, PF=C2, ZF=C3) sans passer    }
{ par FNSTSW+SAHF - c est la forme que les compilateurs modernes         }
{ preferent pour brancher sur une comparaison flottante.                 }
Procedure Elf64_FpuCompareToFlags(A, B: Extended);
Begin
 Elf64_FpuCompare(A, B);
 ELF64_FCF := ELF64_FpuC0;
 ELF64_FPF := ELF64_FpuC2;
 ELF64_FZF := ELF64_FpuC3;
End;

Function Elf64_ReadSingle(Addr: QWord): Extended;
Var
 Buf: Array[0..3] Of Byte;
 S: Single;
 I: Integer;
Begin
 For I := 0 To 3 Do Buf[I] := Emu64_GetByte(Addr + QWord(I));
 Move(Buf, S, SizeOf(S));
 Elf64_ReadSingle := S;
End;

Procedure Elf64_WriteSingle(Addr: QWord; V: Extended);
Var
 S: Single;
 Buf: Array[0..3] Of Byte;
 I: Integer;
Begin
 S := V;
 Move(S, Buf, SizeOf(S));
 For I := 0 To 3 Do Emu64_PutByte(Addr + QWord(I), Buf[I]);
End;

Function Elf64_ReadDouble(Addr: QWord): Extended;
Var
 Buf: Array[0..7] Of Byte;
 D: Double;
 I: Integer;
Begin
 For I := 0 To 7 Do Buf[I] := Emu64_GetByte(Addr + QWord(I));
 Move(Buf, D, SizeOf(D));
 Elf64_ReadDouble := D;
End;

Procedure Elf64_WriteDouble(Addr: QWord; V: Extended);
Var
 D: Double;
 Buf: Array[0..7] Of Byte;
 I: Integer;
Begin
 D := V;
 Move(D, Buf, SizeOf(D));
 For I := 0 To 7 Do Emu64_PutByte(Addr + QWord(I), Buf[I]);
End;

{ Charge/ecrit un reel 80 bits (m80real) directement, sans conversion -   }
{ le format memoire ELF64 et le type Extended de FPC sur cette cible     }
{ (i386) partagent le meme codage x87.                                   }
Function Elf64_ReadExtended(Addr: QWord): Extended;
Var
 Buf: Array[0..9] Of Byte;
 E: Extended;
 I: Integer;
Begin
 For I := 0 To 9 Do Buf[I] := Emu64_GetByte(Addr + QWord(I));
 E := 0;
 Move(Buf, E, SizeOf(E));
 Elf64_ReadExtended := E;
End;

Procedure Elf64_WriteExtended(Addr: QWord; V: Extended);
Var
 Buf: Array[0..9] Of Byte;
 I: Integer;
Begin
 FillChar(Buf, SizeOf(Buf), 0);
 Move(V, Buf, SizeOf(V));
 For I := 0 To 9 Do Emu64_PutByte(Addr + QWord(I), Buf[I]);
End;

Function Elf64_FildMem(Addr: QWord; Size: Integer): Extended;
Var
 V: Int64;
Begin
 Case Size Of
  16: V := Elf64_SignExtend(Emu64_GetWord(Addr), 16);
  32: V := Elf64_SignExtend(Emu64_GetDWord(Addr), 32);
  Else V := Int64(Emu64_GetQWord(Addr));
 End;
 Elf64_FildMem := V;
End;

{ Arrondit au plus proche (approximation du mode d arrondi controle par  }
{ le mot de controle x87, non applique ici - limitation connue) puis     }
{ ecrit l entier resultant en memoire ; SizeOf(Extended)-large donc le   }
{ Round(Extended) natif de FPC est directement utilisable.               }
Procedure Elf64_FistpMem(Addr: QWord; Size: Integer; V: Extended; DoPop: Boolean);
Var
 IV: Int64;
Begin
 IV := Round(V);
 Case Size Of
  16: Emu64_PutWord(Addr, Word(IV));
  32: Emu64_PutDWord(Addr, LongWord(IV));
  Else Emu64_PutQWord(Addr, QWord(IV));
 End;
 If DoPop Then Elf64_FpuPop;
End;

{ ==========================================================================
  SSE2 scalaire (registres XMM0-XMM15). Seules les formes couramment
  emises par un compilateur pour de l arithmetique flottante scalaire
  sont geres (MOVSS/MOVSD/MOVAPS/MOVAPD, ADD/SUB/MUL/DIV SS/SD, les
  conversions entier<->flottant, les comparaisons et les deplacements
  GPR<->XMM) - les instructions vectorielles empaquetees (arithmetique
  sur plusieurs elements a la fois) ne sont pas implementees.
  ========================================================================== }

Function Elf64_XmmGetDouble(Idx: Integer): Extended;
Var
 D: Double;
Begin
 Move(ELF64_Xmm[Idx, 0], D, SizeOf(D));
 Elf64_XmmGetDouble := D;
End;

{ ZeroUpper : True pour un chargement depuis la memoire (remet a zero les}
{ 64 bits hauts, comme l exige reellement MOVSD/MOVSS depuis m64/m32) ;  }
{ False pour une forme registre-a-registre ou arithmetique (fusion, les  }
{ bits hauts du registre destination sont preserves).                    }
Procedure Elf64_XmmSetDoubleLow(Idx: Integer; V: Extended; ZeroUpper: Boolean);
Var
 D: Double;
Begin
 D := V;
 Move(D, ELF64_Xmm[Idx, 0], SizeOf(D));
 If ZeroUpper Then ELF64_Xmm[Idx, 1] := 0;
End;

Function Elf64_XmmGetSingle(Idx: Integer): Extended;
Var
 S: Single;
 W: LongWord;
Begin
 W := LongWord(ELF64_Xmm[Idx, 0] And $FFFFFFFF);
 Move(W, S, SizeOf(S));
 Elf64_XmmGetSingle := S;
End;

Procedure Elf64_XmmSetSingleLow(Idx: Integer; V: Extended; ZeroRest: Boolean);
Var
 S: Single;
 W: LongWord;
Begin
 S := V;
 Move(S, W, SizeOf(S));
 If ZeroRest Then Begin
  ELF64_Xmm[Idx, 0] := QWord(W);
  ELF64_Xmm[Idx, 1] := 0;
 End Else
  ELF64_Xmm[Idx, 0] := (ELF64_Xmm[Idx, 0] And QWord($FFFFFFFF00000000)) Or QWord(W);
End;

Procedure Elf64_XmmGetPackedDoubles(Idx: Integer; Var D0, D1: Double);
Begin
 Move(ELF64_Xmm[Idx, 0], D0, SizeOf(D0));
 Move(ELF64_Xmm[Idx, 1], D1, SizeOf(D1));
End;

Procedure Elf64_XmmSetPackedDoubles(Idx: Integer; D0, D1: Double);
Begin
 Move(D0, ELF64_Xmm[Idx, 0], SizeOf(D0));
 Move(D1, ELF64_Xmm[Idx, 1], SizeOf(D1));
End;

Procedure Elf64_XmmGetPackedSingles(Idx: Integer; Var S0, S1, S2, S3: Single);
Var
 W: LongWord;
Begin
 W := LongWord(ELF64_Xmm[Idx, 0] And $FFFFFFFF); Move(W, S0, SizeOf(S0));
 W := LongWord(ELF64_Xmm[Idx, 0] Shr 32);        Move(W, S1, SizeOf(S1));
 W := LongWord(ELF64_Xmm[Idx, 1] And $FFFFFFFF); Move(W, S2, SizeOf(S2));
 W := LongWord(ELF64_Xmm[Idx, 1] Shr 32);        Move(W, S3, SizeOf(S3));
End;

Procedure Elf64_XmmSetPackedSingles(Idx: Integer; S0, S1, S2, S3: Single);
Var
 W0, W1, W2, W3: LongWord;
Begin
 Move(S0, W0, SizeOf(S0)); Move(S1, W1, SizeOf(S1));
 Move(S2, W2, SizeOf(S2)); Move(S3, W3, SizeOf(S3));
 ELF64_Xmm[Idx, 0] := QWord(W0) Or (QWord(W1) Shl 32);
 ELF64_Xmm[Idx, 1] := QWord(W2) Or (QWord(W3) Shl 32);
End;

{ Lit une chaine terminee par zero depuis la memoire emulee (chemin de   }
{ fichier passe a open/openat) - tronquee a 255 caracteres (String court)}
Function Elf64_ReadCString(Addr: QWord): String;
Var
 S: String;
 Ch: Byte;
Begin
 S := '';
 Ch := Emu64_GetByte(Addr);
 While (Ch <> 0) And (Length(S) < 255) Do Begin
  S := S + Chr(Ch);
  Addr := Addr + 1;
  Ch := Emu64_GetByte(Addr);
 End;
 Elf64_ReadCString := S;
End;

Function Elf64_AllocFD: Integer;
Var
 I: Integer;
Begin
 Elf64_AllocFD := -1;
 For I := 3 To ELF64_MAX_FD - 1 Do
  If Not ELF64_FDOpen[I] Then Begin
   Elf64_AllocFD := I;
   Exit;
  End;
End;

{ sys_open/sys_openat : ouvre un fichier HOTE (chemin resolu comme par    }
{ n importe quel Assign/Reset Pascal, donc relatif au repertoire courant }
{ du processus DEVENV - identique a ce que fait deja TermFindElfExecutable}
{ pour la resolution des chemins). Seuls O_RDONLY/O_WRONLY/O_RDWR,        }
{ O_CREAT et O_TRUNC sont distingues ; les autres indicateurs (O_APPEND, }
{ O_EXCL...) sont ignores.                                                }
Function Elf64_DoOpen(PathAddr: QWord; Flags: LongInt): Int64;
Const
 O_CREAT = $40;
 O_TRUNC = $200;
Var
 Path: String;
 FD: Integer;
 AccessMode: LongInt;
Begin
 Path := Elf64_ReadCString(PathAddr);
 FD := Elf64_AllocFD;
 If FD < 0 Then Begin Elf64_DoOpen := -24; Exit; End; { -EMFILE }
 AccessMode := Flags And 3; { 0=O_RDONLY 1=O_WRONLY 2=O_RDWR }
 {$I-}
 Assign(ELF64_FDFile[FD], Path);
 If AccessMode = 0 Then Begin
  Reset(ELF64_FDFile[FD], 1);
  ELF64_FDRead[FD] := True;
 End Else Begin
  If ((Flags And O_CREAT) <> 0) And Not FileExists(Path) Then
   Rewrite(ELF64_FDFile[FD], 1)
  Else Begin
   Reset(ELF64_FDFile[FD], 1);
   If (IOResult = 0) And ((Flags And O_TRUNC) <> 0) Then Begin
    Close(ELF64_FDFile[FD]);
    Rewrite(ELF64_FDFile[FD], 1);
   End;
  End;
  ELF64_FDRead[FD] := False;
 End;
 {$I+}
 If IOResult <> 0 Then Begin
  Elf64_DoOpen := -2; { -ENOENT }
  Exit;
 End;
 ELF64_FDOpen[FD] := True;
 Elf64_DoOpen := FD;
End;

Procedure Elf64_DoClose(FD: Integer);
Begin
 If (FD >= 3) And (FD < ELF64_MAX_FD) And ELF64_FDOpen[FD] Then Begin
  {$I-}
  Close(ELF64_FDFile[FD]);
  {$I+}
  If IOResult <> 0 Then ;
  ELF64_FDOpen[FD] := False;
 End;
End;

Function Elf64_DoRead(FD: Integer; BufAddr, Count: QWord): Int64;
Var
 Chunk: Array[0..511] Of Byte;
 ToRead, Got: Word;
 Total: QWord;
 J: Integer;
Begin
 If (FD < 3) Or (FD >= ELF64_MAX_FD) Or Not ELF64_FDOpen[FD] Then Begin
  Elf64_DoRead := -9; { -EBADF }
  Exit;
 End;
 Total := 0;
 While Total < Count Do Begin
  If Count - Total > QWord(SizeOf(Chunk)) Then ToRead := SizeOf(Chunk)
                                           Else ToRead := Word(Count - Total);
  {$I-}
  BlockRead(ELF64_FDFile[FD], Chunk, ToRead, Got);
  {$I+}
  If (IOResult <> 0) Or (Got = 0) Then Break;
  For J := 0 To Got - 1 Do
   Emu64_PutByte(BufAddr + Total + QWord(J), Chunk[J]);
  Total := Total + QWord(Got);
  If Got < ToRead Then Break;
 End;
 Elf64_DoRead := Int64(Total);
End;

Function Elf64_DoWriteFile(FD: Integer; BufAddr, Count: QWord): Int64;
Var
 Chunk: Array[0..511] Of Byte;
 ToWrite, Wrote: Word;
 Total: QWord;
 J: Integer;
Begin
 If (FD < 3) Or (FD >= ELF64_MAX_FD) Or Not ELF64_FDOpen[FD] Then Begin
  Elf64_DoWriteFile := -9; { -EBADF }
  Exit;
 End;
 Total := 0;
 While Total < Count Do Begin
  If Count - Total > QWord(SizeOf(Chunk)) Then ToWrite := SizeOf(Chunk)
                                           Else ToWrite := Word(Count - Total);
  For J := 0 To ToWrite - 1 Do
   Chunk[J] := Emu64_GetByte(BufAddr + Total + QWord(J));
  {$I-}
  BlockWrite(ELF64_FDFile[FD], Chunk, ToWrite, Wrote);
  {$I+}
  If (IOResult <> 0) Or (Wrote = 0) Then Break;
  Total := Total + QWord(Wrote);
  If Wrote < ToWrite Then Break;
 End;
 Elf64_DoWriteFile := Int64(Total);
End;

Function Elf64_DoLseek(FD: Integer; Offset: Int64; Whence: Integer): Int64;
Var
 NewPos: Int64;
Begin
 If (FD < 3) Or (FD >= ELF64_MAX_FD) Or Not ELF64_FDOpen[FD] Then Begin
  Elf64_DoLseek := -9; { -EBADF }
  Exit;
 End;
 Case Whence Of
  1: NewPos := Int64(FilePos(ELF64_FDFile[FD])) + Offset;   { SEEK_CUR }
  2: NewPos := Int64(FileSize(ELF64_FDFile[FD])) + Offset;  { SEEK_END }
  Else NewPos := Offset;                                    { SEEK_SET }
 End;
 If NewPos < 0 Then NewPos := 0;
 {$I-}
 Seek(ELF64_FDFile[FD], NewPos);
 {$I+}
 If IOResult <> 0 Then Begin
  Elf64_DoLseek := -22; { -EINVAL }
  Exit;
 End;
 Elf64_DoLseek := NewPos;
End;

{ Ecrit une struct stat Linux x86-64 minimale (144 octets) : tout a zero }
{ sauf st_nlink, st_mode (fichier regulier, 0644) et st_size - suffisant }
{ pour les usages les plus courants (verifier une taille ou S_ISREG).    }
Procedure Elf64_DoFstat(FD: Integer; StatAddr: QWord);
Var
 I: Integer;
 Sz: QWord;
Begin
 For I := 0 To 143 Do
  Emu64_PutByte(StatAddr + QWord(I), 0);
 If (FD >= 3) And (FD < ELF64_MAX_FD) And ELF64_FDOpen[FD] Then
  Sz := QWord(FileSize(ELF64_FDFile[FD]))
 Else
  Sz := 0;
 Emu64_PutQWord(StatAddr + 16, 1);       { st_nlink = 1 }
 Emu64_PutDWord(StatAddr + 24, $81A4);   { st_mode = S_IFREG | 0644 }
 Emu64_PutQWord(StatAddr + 48, Sz);      { st_size }
End;

{ Jours ecoules depuis 1970-01-01 pour une date Y/M/D donnee (algorithme }
{ "days_from_civil" de Howard Hinnant - exact sur tout le calendrier     }
{ gregorien, sans boucle). Sert de base a gettimeofday/clock_gettime.    }
Function Elf64_DaysFromEpoch(Y, M, D: LongInt): LongInt;
Var
 Era, YOE, DOY, DOE: LongInt;
Begin
 If M <= 2 Then Y := Y - 1;
 If Y >= 0 Then Era := Y Div 400 Else Era := (Y - 399) Div 400;
 YOE := Y - Era * 400;
 If M > 2 Then DOY := (153 * (M - 3) + 2) Div 5 + D - 1
           Else DOY := (153 * (M + 9) + 2) Div 5 + D - 1;
 DOE := YOE * 365 + YOE Div 4 - YOE Div 100 + DOY;
 Elf64_DaysFromEpoch := Era * 146097 + DOE - 719468;
End;

Function Elf64_UnixTime: LongInt;
Var
 Y, M, D, DOW: Word;
 H, Mi, S, S100: Word;
Begin
 GetDate(Y, M, D, DOW);
 GetTime(H, Mi, S, S100);
 Elf64_UnixTime := Elf64_DaysFromEpoch(Y, M, D) * 86400 +
  LongInt(H) * 3600 + LongInt(Mi) * 60 + LongInt(S);
End;

{ struct utsname Linux x86-64 : 6 champs de 65 octets (390 octets total).}
Procedure Elf64_DoUname(Addr: QWord);
 Procedure PutStr(Ofs: QWord; Const Txt: String);
 Var
  J: Integer;
 Begin
  For J := 1 To Length(Txt) Do Emu64_PutByte(Ofs + QWord(J) - 1, Ord(Txt[J]));
  Emu64_PutByte(Ofs + QWord(Length(Txt)), 0);
 End;
Var
 K: Integer;
Begin
 For K := 0 To 389 Do Emu64_PutByte(Addr + QWord(K), 0);
 PutStr(Addr, 'Linux');
 PutStr(Addr + 65, 'devenv');
 PutStr(Addr + 130, '5.0.0-devenv');
 PutStr(Addr + 195, '#1 SMP');
 PutStr(Addr + 260, 'x86_64');
 PutStr(Addr + 325, '');
End;

{ Ecrit Count octets depuis la memoire emulee vers la console virtuelle  }
{ du panneau (fd 1/2) - factorise entre sys_write et sys_writev.         }
Procedure Elf64_ConsoleWrite(BufAddr, Count: QWord);
Var
 K: QWord;
 Ch: Byte;
Begin
 If ELF64_Panel = Nil Then Exit;
 K := 0;
 While K < Count Do Begin
  Ch := Emu64_GetByte(BufAddr + K);
  If Ch = 10 Then Begin
   EmuVScr_PutChar(ELF64_Panel^, #13);
   EmuVScr_PutChar(ELF64_Panel^, #10);
  End Else If Ch <> 13 Then
   EmuVScr_PutChar(ELF64_Panel^, Chr(Ch));
  K := K + 1;
 End;
End;

{ Repartiteur d appels systeme Linux x86-64 (ABI SysV : numero dans RAX,  }
{ arguments dans RDI/RSI/RDX/R10/R8/R9, retour dans RAX). Geres pour le   }
{ moment : read/write/writev/open/openat/close/lseek/fstat/stat/lstat/   }
{ access/getcwd/readlink/ioctl(TCGETS)/uname/gettimeofday/clock_gettime/ }
{ getpid/sigaltstack/rt_sigprocmask/rt_sigaction/getrlimit/prlimit64/    }
{ exit/exit_group/brk/mmap/munmap/arch_prctl.                            }
Procedure Elf64_DoSyscall;
Var
 SysNum: QWord;
 FD: Int64;
 BufAddr, Count, I: QWord;
 Ch: Byte;
 ExitCode: Integer;
 ReqAddr, ReqLen, PageLen: QWord;
 S: String;
 TmpF: File;
 Sz: QWord;
 J, IovCnt: Integer;
 IovBase, IovLen: QWord;
Begin
 SysNum := ELF64_Reg[REG_RAX];
 Case SysNum Of
  0: Begin { sys_read(fd, buf, count) }
   FD := Int64(ELF64_Reg[REG_RDI]);
   If (FD >= 3) And (FD < ELF64_MAX_FD) And ELF64_FDOpen[FD] Then
    ELF64_Reg[REG_RAX] := QWord(Elf64_DoRead(Integer(FD),
     ELF64_Reg[REG_RSI], ELF64_Reg[REG_RDX]))
   Else
    ELF64_Reg[REG_RAX] := 0; { stdin non interactif pour le moment : fin de flux }
  End;
  1: Begin { sys_write(fd, buf, count) }
   FD := Int64(ELF64_Reg[REG_RDI]);
   BufAddr := ELF64_Reg[REG_RSI];
   Count := ELF64_Reg[REG_RDX];
   If (FD = 1) Or (FD = 2) Then Begin
    Elf64_ConsoleWrite(BufAddr, Count);
    ELF64_Reg[REG_RAX] := Count;
   End Else If (FD >= 3) And (FD < ELF64_MAX_FD) And ELF64_FDOpen[FD] Then
    ELF64_Reg[REG_RAX] := QWord(Elf64_DoWriteFile(Integer(FD), BufAddr, Count))
   Else
    ELF64_Reg[REG_RAX] := QWord(Int64(-9)); { -EBADF : descripteur non gere }
  End;
  2: { sys_open(path, flags, mode) }
   ELF64_Reg[REG_RAX] := QWord(Elf64_DoOpen(ELF64_Reg[REG_RDI],
    LongInt(ELF64_Reg[REG_RSI])));
  257: { sys_openat(dirfd, path, flags, mode) - dirfd ignore (relatif au }
       { repertoire courant du processus hote, comme AT_FDCWD).          }
   ELF64_Reg[REG_RAX] := QWord(Elf64_DoOpen(ELF64_Reg[REG_RSI],
    LongInt(ELF64_Reg[REG_RDX])));
  3: Begin { sys_close(fd) }
   Elf64_DoClose(Integer(ELF64_Reg[REG_RDI]));
   ELF64_Reg[REG_RAX] := 0;
  End;
  8: { sys_lseek(fd, offset, whence) }
   ELF64_Reg[REG_RAX] := QWord(Elf64_DoLseek(Integer(ELF64_Reg[REG_RDI]),
    Int64(ELF64_Reg[REG_RSI]), Integer(ELF64_Reg[REG_RDX])));
  5: Begin { sys_fstat(fd, statbuf) }
   Elf64_DoFstat(Integer(ELF64_Reg[REG_RDI]), ELF64_Reg[REG_RSI]);
   ELF64_Reg[REG_RAX] := 0;
  End;
  12: Begin { sys_brk(addr) - addr=0 interroge la position courante,     }
            { sinon tente de la deplacer ; renvoie toujours la valeur    }
            { resultante, comme le vrai appel systeme (pas le wrapper    }
            { libc, qui traduit cela en succes/echec de son cote).       }
   ReqAddr := ELF64_Reg[REG_RDI];
   If (ReqAddr <> 0) And (ReqAddr < QWord(High(ELF64_Mem))) Then
    ELF64_BrkCur := ReqAddr;
   ELF64_Reg[REG_RAX] := ELF64_BrkCur;
  End;
  9: Begin { sys_mmap(addr, length, prot, flags, fd, offset) - allocateur }
           { lineaire simplifie : renvoie toujours de la memoire a zero,  }
           { comme le ferait une zone anonyme fraichement mappee. Le     }
           { mmap de fichier (fd >= 0) n est pas distingue de l anonyme   }
           { pour le moment (le contenu du fichier n est pas projete).   }
   ReqLen := ELF64_Reg[REG_RSI];
   PageLen := (ReqLen + 4095) And Not QWord(4095);
   If PageLen = 0 Then PageLen := 4096;
   If ELF64_MmapNext + PageLen >= QWord(High(ELF64_Mem)) - $20000 Then
    ELF64_Reg[REG_RAX] := QWord(Int64(-12)) { -ENOMEM }
   Else Begin
    ELF64_Reg[REG_RAX] := ELF64_MmapNext;
    ELF64_MmapNext := ELF64_MmapNext + PageLen;
   End;
  End;
  11: ELF64_Reg[REG_RAX] := 0; { sys_munmap : demappage non suivi, "reussi" }
  4, 6: Begin { sys_stat/sys_lstat(path, statbuf) : pas de distinction    }
              { symlink sur cet hote - traites de facon identique.       }
   S := Elf64_ReadCString(ELF64_Reg[REG_RDI]);
   If Not FileExists(S) Then
    ELF64_Reg[REG_RAX] := QWord(Int64(-2)) { -ENOENT }
   Else Begin
    {$I-}
    Assign(TmpF, S);
    Reset(TmpF, 1);
    {$I+}
    If IOResult <> 0 Then
     ELF64_Reg[REG_RAX] := QWord(Int64(-2))
    Else Begin
     Sz := QWord(FileSize(TmpF));
     Close(TmpF);
     I := 0;
     While I <= 143 Do Begin Emu64_PutByte(ELF64_Reg[REG_RSI] + I, 0); I := I + 1; End;
     Emu64_PutQWord(ELF64_Reg[REG_RSI] + 16, 1);
     Emu64_PutDWord(ELF64_Reg[REG_RSI] + 24, $81A4);
     Emu64_PutQWord(ELF64_Reg[REG_RSI] + 48, Sz);
     ELF64_Reg[REG_RAX] := 0;
    End;
   End;
  End;
  14: Begin { sys_rt_sigprocmask : aucun signal reel n est bloque/debloque}
            { - no-op reussi (oldset mis a zero si demande).             }
   If ELF64_Reg[REG_RDX] <> 0 Then Emu64_PutQWord(ELF64_Reg[REG_RDX], 0);
   ELF64_Reg[REG_RAX] := 0;
  End;
  16: Begin { sys_ioctl : seul TCGETS (verification terminal) est simule,}
            { en repondant "oui" pour stdin/stdout/stderr - suffisant    }
            { pour satisfaire les verifications d interactivite (isatty).}
   If (ELF64_Reg[REG_RSI] = $5401) And (ELF64_Reg[REG_RDI] <= 2) Then Begin
    I := 0;
    While I <= 35 Do Begin Emu64_PutByte(ELF64_Reg[REG_RDX] + I, 0); I := I + 1; End;
    ELF64_Reg[REG_RAX] := 0;
   End Else
    ELF64_Reg[REG_RAX] := QWord(Int64(-25)); { -ENOTTY }
  End;
  20: Begin { sys_writev(fd, iov, iovcnt) }
   FD := Int64(ELF64_Reg[REG_RDI]);
   IovCnt := Integer(ELF64_Reg[REG_RDX]);
   IovBase := ELF64_Reg[REG_RSI];
   Count := 0;
   If (FD = 1) Or (FD = 2) Or ((FD >= 3) And (FD < ELF64_MAX_FD) And ELF64_FDOpen[FD]) Then Begin
    For J := 0 To IovCnt - 1 Do Begin
     BufAddr := Emu64_GetQWord(IovBase + QWord(J) * 16);
     IovLen := Emu64_GetQWord(IovBase + QWord(J) * 16 + 8);
     If (FD = 1) Or (FD = 2) Then Elf64_ConsoleWrite(BufAddr, IovLen)
                              Else Elf64_DoWriteFile(Integer(FD), BufAddr, IovLen);
     Count := Count + IovLen;
    End;
    ELF64_Reg[REG_RAX] := Count;
   End Else
    ELF64_Reg[REG_RAX] := QWord(Int64(-9)); { -EBADF }
  End;
  21: Begin { sys_access(path, mode) : approxime par une simple existence }
   S := Elf64_ReadCString(ELF64_Reg[REG_RDI]);
   If FileExists(S) Then ELF64_Reg[REG_RAX] := 0
                     Else ELF64_Reg[REG_RAX] := QWord(Int64(-2));
  End;
  23: Begin { sys_select(nfds, readfds, writefds, exceptfds, timeout) :      }
            { stdin n est pas interactif dans cet emulateur (sys_read sur   }
            { fd 0 renvoie deja systematiquement 0 = fin de flux), donc on  }
            { signale fd 0 immediatement "pret" quand il est demande dans   }
            { readfds - le programme invite appelle alors read(), recoit    }
            { EOF, et se termine normalement au lieu de boucler.            }
   Count := 0;
   If ELF64_Reg[REG_RSI] <> 0 Then Begin
    If (Emu64_GetQWord(ELF64_Reg[REG_RSI]) And 1) <> 0 Then Begin
     Emu64_PutQWord(ELF64_Reg[REG_RSI], 1);
     Count := 1;
    End Else
     Emu64_PutQWord(ELF64_Reg[REG_RSI], 0);
   End;
   If ELF64_Reg[REG_RDX] <> 0 Then Emu64_PutQWord(ELF64_Reg[REG_RDX], 0);
   If ELF64_Reg[REG_R10] <> 0 Then Emu64_PutQWord(ELF64_Reg[REG_R10], 0);
   ELF64_Reg[REG_RAX] := Count;
  End;
  39: ELF64_Reg[REG_RAX] := 1000; { sys_getpid : PID fixe, arbitraire }
  63: Begin { sys_uname(buf) }
   Elf64_DoUname(ELF64_Reg[REG_RDI]);
   ELF64_Reg[REG_RAX] := 0;
  End;
  79: Begin { sys_getcwd(buf, size) - renvoie la longueur (avec le zero   }
            { final) sur succes, comme le veut le vrai appel systeme.    }
   GetDir(0, S);
   S := S + Chr(0);
   If Length(S) > Integer(ELF64_Reg[REG_RSI]) Then
    ELF64_Reg[REG_RAX] := QWord(Int64(-34)) { -ERANGE }
   Else Begin
    I := 1;
    While I <= QWord(Length(S)) Do Begin
     Emu64_PutByte(ELF64_Reg[REG_RDI] + I - 1, Ord(S[Integer(I)]));
     I := I + 1;
    End;
    ELF64_Reg[REG_RAX] := QWord(Length(S));
   End;
  End;
  89: Begin { sys_readlink : seul /proc/self/exe est reconnu, necessaire  }
            { a l implementation de ParamStr(0) par le runtime FPC.      }
   S := Elf64_ReadCString(ELF64_Reg[REG_RDI]);
   If S = '/proc/self/exe' Then Begin
    S := ELF64_BinaryPath;
    If Length(S) > Integer(ELF64_Reg[REG_RDX]) Then S := Copy(S, 1, Integer(ELF64_Reg[REG_RDX]));
    I := 1;
    While I <= QWord(Length(S)) Do Begin
     Emu64_PutByte(ELF64_Reg[REG_RSI] + I - 1, Ord(S[Integer(I)]));
     I := I + 1;
    End;
    ELF64_Reg[REG_RAX] := QWord(Length(S));
   End Else
    ELF64_Reg[REG_RAX] := QWord(Int64(-2)); { -ENOENT }
  End;
  96: Begin { sys_gettimeofday(tv, tz) }
   If ELF64_Reg[REG_RDI] <> 0 Then Begin
    Emu64_PutQWord(ELF64_Reg[REG_RDI], QWord(Int64(Elf64_UnixTime)));
    Emu64_PutQWord(ELF64_Reg[REG_RDI] + 8, 0); { microsecondes non suivies }
   End;
   ELF64_Reg[REG_RAX] := 0;
  End;
  201: Begin { sys_time(tloc) : renvoie les secondes depuis l epoque, et    }
             { les ecrit aussi a *tloc si le pointeur n est pas NULL.       }
   If ELF64_Reg[REG_RDI] <> 0 Then
    Emu64_PutQWord(ELF64_Reg[REG_RDI], QWord(Int64(Elf64_UnixTime)));
   ELF64_Reg[REG_RAX] := QWord(Int64(Elf64_UnixTime));
  End;
  131: ELF64_Reg[REG_RAX] := 0; { sys_sigaltstack : no-op reussi }
  228: Begin { sys_clock_gettime(clockid, timespec) }
   If ELF64_Reg[REG_RSI] <> 0 Then Begin
    Emu64_PutQWord(ELF64_Reg[REG_RSI], QWord(Int64(Elf64_UnixTime)));
    Emu64_PutQWord(ELF64_Reg[REG_RSI] + 8, 0); { nanosecondes non suivies }
   End;
   ELF64_Reg[REG_RAX] := 0;
  End;
  302: Begin { sys_prlimit64(pid, resource, new_limit, old_limit) :       }
             { meme reponse "illimite" que getrlimit.                    }
   If ELF64_Reg[REG_R10] <> 0 Then Begin
    Emu64_PutQWord(ELF64_Reg[REG_R10], QWord($FFFFFFFFFFFFFFFF));
    Emu64_PutQWord(ELF64_Reg[REG_R10] + 8, QWord($FFFFFFFFFFFFFFFF));
   End;
   ELF64_Reg[REG_RAX] := 0;
  End;
  13: Begin { sys_rt_sigaction(signum, act, oldact, sigsetsize) : aucun   }
            { signal n est reellement delivre par cet emulateur, donc     }
            { installer un gestionnaire est un no-op sans consequence -   }
            { on renvoie simplement succes (et SIG_DFL dans oldact si     }
            { demande).                                                   }
   If ELF64_Reg[REG_RDX] <> 0 Then Begin
    Emu64_PutQWord(ELF64_Reg[REG_RDX], 0);
    Emu64_PutQWord(ELF64_Reg[REG_RDX] + 8, 0);
    Emu64_PutQWord(ELF64_Reg[REG_RDX] + 16, 0);
   End;
   ELF64_Reg[REG_RAX] := 0;
  End;
  97: Begin { sys_getrlimit(resource, rlim) : renvoie systematiquement    }
            { "illimite" (RLIM_INFINITY) pour les deux champs - aucune    }
            { limite reelle n est appliquee par cet emulateur.            }
   Emu64_PutQWord(ELF64_Reg[REG_RSI], QWord($FFFFFFFFFFFFFFFF));
   Emu64_PutQWord(ELF64_Reg[REG_RSI] + 8, QWord($FFFFFFFFFFFFFFFF));
   ELF64_Reg[REG_RAX] := 0;
  End;
  158: Begin { sys_arch_prctl(code, addr) }
   If ELF64_Reg[REG_RDI] = $1002 Then { ARCH_SET_FS }
    ELF64_FSBase := ELF64_Reg[REG_RSI];
   ELF64_Reg[REG_RAX] := 0;
  End;
  60, 231: Begin { sys_exit / sys_exit_group }
   ExitCode := Integer(ELF64_Reg[REG_RDI] And $FF);
   ELF64_Halted := True;
   ELF64_ExitCode := ExitCode;
   ELF64_HaltReason := 'Fin d''execution : fin de programme (code ' +
    IntToStr(ExitCode) + ') apres ' + IntToStr(ELF64_InstrCount) + ' instructions';
  End;
  Else Begin
   ELF64_Halted := True;
   ELF64_LastBadRIP := ELF64_RIP;
   ELF64_HaltReason := 'Appel systeme numero ' + IntToStr(LongInt(SysNum)) +
    ' non implemente';
  End;
 End;
End;

{ Execute UNE instruction a partir de ELF64_RIP. En cas d opcode non      }
{ reconnu ou de fonctionnalite non implementee, arrete proprement         }
{ l emulation (ELF64_Halted) avec un message diagnostic plutot que de     }
{ planter ou de continuer sur un etat incorrect.                         }
Procedure Elf64_Step;
Var
 StartRIP: QWord;
 B, Op, Op2: Byte;
 RexW, RexR, RexX, RexB: Boolean;
 OpSize: Integer;
 EA: TElf64EA;
 RegField, GroupOp: Integer;
 Imm8: ShortInt;
 Imm32: LongInt;
 Imm64: QWord;
 Val1, Val2, ResVal: QWord;
 Saw66, SawF3, SawF2: Boolean;
 HiRes, LoRes, QuotR, RemR, FullU: QWord;
 FullS, DivS: Int64;
 I: Integer;
 FVal: Extended;
 Addr: QWord;
 PD0, PD1, QD0, QD1: Double;
 PS0, PS1, PS2, PS3, QS0, QS1, QS2, QS3: Single;
 WScratch: LongWord;
 DstLoQ, SrcLoQ: QWord;
 PunpckDstB, PunpckSrcB: Array[0..7] Of Byte;
 PunpckRes: Array[0..15] Of Byte;
 PunpckElemSize, PunpckNElem, PunpckI: Integer;
 PshufImm: Byte;
 PshufSrcDW, PshufResDW: Array[0..3] Of LongWord;
 CmpDstB, CmpSrcB, CmpResB: Array[0..15] Of Byte;
 CmpElemSize, CmpNElem, CmpI: Integer;
 CmpEqual: Boolean;
Begin
 If ELF64_Halted Then Exit;
 StartRIP := ELF64_RIP;
 { Garde-fou anti-saut-errant : si RIP tombe sous le debut de l image     }
 { chargee, arreter IMMEDIATEMENT plutot que de continuer a "executer"    }
 { silencieusement des octets a zero (ce qui se decode comme une longue   }
 { suite de ADD [RAX],AL sans jamais planter, masquant le vrai probleme   }
 { pendant des millions d instructions). Cela garantit que l historique   }
 { ELF64_TraceBuf contient encore les instructions ayant reellement       }
 { cause le saut (RET avec pile corrompue, appel indirect invalide...).   }
 If (StartRIP < ELF64_LoadBase) And (ELF64_LoadBase > 0) Then Begin
  ELF64_Halted := True;
  ELF64_LastBadRIP := StartRIP;
  ELF64_HaltReason := 'Saut errant detecte : RIP (0x' + HexQWord(StartRIP) +
   ') est tombe sous le debut de l''image chargee (0x' +
   HexQWord(ELF64_LoadBase) +
   ') - probablement un RET avec une pile corrompue ou un appel indirect ' +
   'via un pointeur de fonction invalide.';
  Exit;
 End;
 If (ELF64_BreakAddr <> 0) And (StartRIP = ELF64_BreakAddr) Then Begin
  Inc(ELF64_BreakHitCount);
  If ELF64_BreakHitCount >= ELF64_BreakHitTarget Then Begin
   ELF64_Halted := True;
   ELF64_LastBadRIP := StartRIP;
   ELF64_HaltReason := 'Point d''arret atteint : RIP = 0x' + HexQWord(StartRIP) +
    ' (passage numero ' + IntToStr(LongInt(ELF64_BreakHitCount)) + ')';
   Exit;
  End;
 End;
 ELF64_TraceRIP[ELF64_TraceCount And 1023] := StartRIP;
 ELF64_TraceRSP[ELF64_TraceCount And 1023] := ELF64_Reg[REG_RSP];
 Inc(ELF64_TraceCount);
 RexW := False; RexR := False; RexX := False; RexB := False;
 Saw66 := False; SawF3 := False; SawF2 := False;

 { Prefixes : la plupart (segment, LOCK, taille d adresse) sont           }
 { simplement consommes - 66 (taille d operande), F3 (REP/REPE) et F2     }
 { (REPNE, utilises par MOVS/STOS/CMPS/SCAS) influencent le decodage.     }
 Repeat
  B := Emu64_GetByte(ELF64_RIP);
  Case B Of
   $66: Begin Saw66 := True; ELF64_RIP := ELF64_RIP + 1; End;
   $F3: Begin SawF3 := True; ELF64_RIP := ELF64_RIP + 1; End;
   $F2: Begin SawF2 := True; ELF64_RIP := ELF64_RIP + 1; End;
   $67, $2E, $36, $3E, $26, $64, $65, $F0:
    ELF64_RIP := ELF64_RIP + 1;
   Else Break;
  End;
 Until False;

 B := Emu64_GetByte(ELF64_RIP);
 If (B And $F0) = $40 Then Begin
  RexW := (B And $08) <> 0;
  RexR := (B And $04) <> 0;
  RexX := (B And $02) <> 0;
  RexB := (B And $01) <> 0;
  ELF64_RIP := ELF64_RIP + 1;
 End;

 If RexW Then OpSize := 64
 Else If Saw66 Then OpSize := 16
 Else OpSize := 32;

 Op := Elf64_FetchByte;

 If (Op < $40) And ((Op And 7) <= 5) Then Begin
  { Groupe ALU standard (ADD/OR/ADC/SBB/AND/SUB/XOR/CMP), 6 formes }
  GroupOp := Op Shr 3;
  Case Op And 7 Of
   0: Begin { Eb, Gb }
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Val1 := Elf64_ReadOperand(EA, 8);
    Val2 := Elf64_GetReg(RegField, 8);
    ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, 8);
    If GroupOp <> 7 Then Elf64_WriteOperand(EA, 8, ResVal);
   End;
   1: Begin { Ev, Gv }
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Val1 := Elf64_ReadOperand(EA, OpSize);
    Val2 := Elf64_GetReg(RegField, OpSize);
    ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, OpSize);
    If GroupOp <> 7 Then Elf64_WriteOperand(EA, OpSize, ResVal);
   End;
   2: Begin { Gb, Eb }
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Val1 := Elf64_GetReg(RegField, 8);
    Val2 := Elf64_ReadOperand(EA, 8);
    ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, 8);
    If GroupOp <> 7 Then Elf64_SetReg(RegField, 8, ResVal);
   End;
   3: Begin { Gv, Ev }
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Val1 := Elf64_GetReg(RegField, OpSize);
    Val2 := Elf64_ReadOperand(EA, OpSize);
    ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, OpSize);
    If GroupOp <> 7 Then Elf64_SetReg(RegField, OpSize, ResVal);
   End;
   4: Begin { AL, ib }
    Imm8 := Elf64_FetchImm8Signed;
    Val1 := Elf64_GetReg(REG_RAX, 8);
    ResVal := Elf64_AluCompute(GroupOp, Val1, QWord(Byte(Imm8)), 8);
    If GroupOp <> 7 Then Elf64_SetReg(REG_RAX, 8, ResVal);
   End;
   Else Begin { 5 : eAX, iz }
    Imm32 := Elf64_FetchImm32Signed;
    Val1 := Elf64_GetReg(REG_RAX, OpSize);
    If OpSize = 64 Then Val2 := QWord(Int64(Imm32)) Else Val2 := QWord(LongWord(Imm32));
    ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, OpSize);
    If GroupOp <> 7 Then Elf64_SetReg(REG_RAX, OpSize, ResVal);
   End;
  End;
 End Else Case Op Of

  $90: ; { NOP }

  $0F: Begin
   Op2 := Elf64_FetchByte;
   Case Op2 Of
    $1E: Elf64_FetchByte; { F3 0F 1E FA/FB = ENDBR64/ENDBR32, deja consomme }
    $1F: EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField); { NOP r/m multi-octets (remplissage d alignement) }
    $18: EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField); { PREFETCHx : indice de cache sans effet architectural }
    $05: Elf64_DoSyscall; { SYSCALL }
    $B6: Begin { MOVZX r, r/m8 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Elf64_SetReg(RegField, OpSize, Elf64_ReadOperand(EA, 8));
    End;
    $B7: Begin { MOVZX r, r/m16 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Elf64_SetReg(RegField, OpSize, Elf64_ReadOperand(EA, 16));
    End;
    $BE: Begin { MOVSX r, r/m8 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_ReadOperand(EA, 8);
     Elf64_SetReg(RegField, OpSize, QWord(Int64(ShortInt(Val1))));
    End;
    $BF: Begin { MOVSX r, r/m16 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_ReadOperand(EA, 16);
     Elf64_SetReg(RegField, OpSize, QWord(Int64(SmallInt(Val1))));
    End;
    $BC: Begin { BSF reg, r/m : indice du premier bit a 1 (LSB en premier).  }
               { Si la source est nulle, ZF=1 et le registre destination    }
               { reste inchange, comme sur un vrai processeur (resultat     }
               { architecturalement indefini dans ce cas).                  }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If Val1 = 0 Then
      ELF64_FZF := True
     Else Begin
      ELF64_FZF := False;
      ResVal := 0;
      While (Val1 And 1) = 0 Do Begin
       Val1 := Val1 Shr 1;
       ResVal := ResVal + 1;
      End;
      Elf64_SetReg(RegField, OpSize, ResVal);
     End;
    End;
    $BD: Begin { BSR reg, r/m : indice du dernier bit a 1 (MSB en premier) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If Val1 = 0 Then
      ELF64_FZF := True
     Else Begin
      ELF64_FZF := False;
      ResVal := 0;
      For I := OpSize - 1 DownTo 0 Do
       If (Val1 And (QWord(1) Shl I)) <> 0 Then Begin
        ResVal := QWord(I);
        Break;
       End;
      Elf64_SetReg(RegField, OpSize, ResVal);
     End;
    End;
    $40..$4F: Begin { CMOVcc r, r/m }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If Elf64_EvalCond(Op2 And $0F) Then
      Elf64_SetReg(RegField, OpSize, Val1);
    End;
    $80..$8F: Begin { Jcc rel32 }
     Imm32 := Elf64_FetchImm32Signed;
     If Elf64_EvalCond(Op2 And $0F) Then
      ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm32));
    End;
    $90..$9F: Begin { SETcc r/m8 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Elf64_EvalCond(Op2 And $0F) Then
      Elf64_WriteOperand(EA, 8, 1)
     Else
      Elf64_WriteOperand(EA, 8, 0);
    End;
    $AF: Begin { IMUL r, r/m (2 operandes, ne garde que les bits de poids faible) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     Val1 := Elf64_GetReg(RegField, OpSize);
     Val2 := Elf64_ReadOperand(EA, OpSize);
     Elf64_SetReg(RegField, OpSize, Elf64_ImulTrunc(Val1, Val2, OpSize));
    End;
    $AE: Begin { FXSAVE/FXRSTOR/LDMXCSR/STMXCSR/(L|M|S)FENCE/CLFLUSH }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      { formes registre (mod=11) : LFENCE(rm=5)/MFENCE(rm=6)/SFENCE(rm=7) - }
      { simples barrieres memoire, sans effet dans cet emulateur mono-fil.  }
      If Not (EA.RegIdx In [5, 6, 7]) Then Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Opcode 0F AE (registre) non supporte';
      End;
     End Else Case RegField Of
      0: FillChar(ELF64_Mem[LongInt(Elf64_ResolveEA(EA))], 512, 0); { FXSAVE : etat fige a zero (limitation connue) }
      1: ; { FXRSTOR : aucun effet (limitation connue) }
      2: ELF64_MXCSR := Emu64_GetDWord(Elf64_ResolveEA(EA));        { LDMXCSR }
      3: Emu64_PutDWord(Elf64_ResolveEA(EA), ELF64_MXCSR);          { STMXCSR }
      7: ; { CLFLUSH : sans effet (pas de cache simule) }
      Else Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Groupe 0F AE /' + IntToStr(RegField) + ' non supporte';
      End;
     End;
    End;

    $10: Begin { MOVSS/MOVSD/MOVUPS/MOVUPD : xmm(RegField) <- EA }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF2 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetDouble(EA.RegIdx)
                  Else FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
      Elf64_XmmSetDoubleLow(RegField, FVal, Not EA.IsReg);
     End Else If SawF3 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetSingle(EA.RegIdx)
                  Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
      Elf64_XmmSetSingleLow(RegField, FVal, Not EA.IsReg);
     End Else Begin
      If EA.IsReg Then Begin
       ELF64_Xmm[RegField, 0] := ELF64_Xmm[EA.RegIdx, 0];
       ELF64_Xmm[RegField, 1] := ELF64_Xmm[EA.RegIdx, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       ELF64_Xmm[RegField, 0] := Emu64_GetQWord(Addr);
       ELF64_Xmm[RegField, 1] := Emu64_GetQWord(Addr + 8);
      End;
     End;
    End;
    $11: Begin { MOVSS/MOVSD/MOVUPS/MOVUPD : EA <- xmm(RegField) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF2 Then Begin
      FVal := Elf64_XmmGetDouble(RegField);
      If EA.IsReg Then Elf64_XmmSetDoubleLow(EA.RegIdx, FVal, False)
                  Else Elf64_WriteDouble(Elf64_ResolveEA(EA), FVal);
     End Else If SawF3 Then Begin
      FVal := Elf64_XmmGetSingle(RegField);
      If EA.IsReg Then Elf64_XmmSetSingleLow(EA.RegIdx, FVal, True)
                  Else Elf64_WriteSingle(Elf64_ResolveEA(EA), FVal);
     End Else Begin
      If EA.IsReg Then Begin
       ELF64_Xmm[EA.RegIdx, 0] := ELF64_Xmm[RegField, 0];
       ELF64_Xmm[EA.RegIdx, 1] := ELF64_Xmm[RegField, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       Emu64_PutQWord(Addr, ELF64_Xmm[RegField, 0]);
       Emu64_PutQWord(Addr + 8, ELF64_Xmm[RegField, 1]);
      End;
     End;
    End;
    $28: Begin { MOVAPS/MOVAPD (traite comme MOVUPS/MOVUPD - pas de controle d alignement) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[EA.RegIdx, 0];
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[EA.RegIdx, 1];
     End Else Begin
      Addr := Elf64_ResolveEA(EA);
      ELF64_Xmm[RegField, 0] := Emu64_GetQWord(Addr);
      ELF64_Xmm[RegField, 1] := Emu64_GetQWord(Addr + 8);
     End;
    End;
    $29: Begin { MOVAPS/MOVAPD, sens inverse }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      ELF64_Xmm[EA.RegIdx, 0] := ELF64_Xmm[RegField, 0];
      ELF64_Xmm[EA.RegIdx, 1] := ELF64_Xmm[RegField, 1];
     End Else Begin
      Addr := Elf64_ResolveEA(EA);
      Emu64_PutQWord(Addr, ELF64_Xmm[RegField, 0]);
      Emu64_PutQWord(Addr + 8, ELF64_Xmm[RegField, 1]);
     End;
    End;
    $2A: Begin { CVTSI2SD/CVTSI2SS : entier (GPR/m) -> flottant }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If RexW Then FVal := Int64(Elf64_ReadOperand(EA, 64))
             Else FVal := Elf64_SignExtend(Elf64_ReadOperand(EA, 32), 32);
     If SawF2 Then Elf64_XmmSetDoubleLow(RegField, FVal, False)
     Else If SawF3 Then Elf64_XmmSetSingleLow(RegField, FVal, False);
    End;
    $2C: Begin { CVTTSD2SI/CVTTSS2SI : flottant -> entier, troncature vers zero }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF2 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetDouble(EA.RegIdx) Else FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
     End Else Begin
      If EA.IsReg Then FVal := Elf64_XmmGetSingle(EA.RegIdx) Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
     End;
     If RexW Then Elf64_SetReg(RegField, 64, QWord(Trunc(FVal)))
             Else Elf64_SetReg(RegField, 32, QWord(LongWord(Trunc(FVal))));
    End;
    $2D: Begin { CVTSD2SI/CVTSS2SI : flottant -> entier, arrondi au plus proche }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF2 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetDouble(EA.RegIdx) Else FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
     End Else Begin
      If EA.IsReg Then FVal := Elf64_XmmGetSingle(EA.RegIdx) Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
     End;
     If RexW Then Elf64_SetReg(RegField, 64, QWord(Round(FVal)))
             Else Elf64_SetReg(RegField, 32, QWord(LongWord(Round(FVal))));
    End;
    $2E, $2F: Begin { (U)COMISS/(U)COMISD : compare et fixe ZF/PF/CF directement }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetDouble(EA.RegIdx) Else FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
      Elf64_FpuCompareToFlags(Elf64_XmmGetDouble(RegField), FVal);
     End Else Begin
      If EA.IsReg Then FVal := Elf64_XmmGetSingle(EA.RegIdx) Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
      Elf64_FpuCompareToFlags(Elf64_XmmGetSingle(RegField), FVal);
     End;
    End;
    $54, $57: Begin { ANDPS/ANDPD (54) et XORPS/XORPD (57), 128 bits empaquetes }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      Val1 := ELF64_Xmm[EA.RegIdx, 0]; Val2 := ELF64_Xmm[EA.RegIdx, 1];
     End Else Begin
      Addr := Elf64_ResolveEA(EA);
      Val1 := Emu64_GetQWord(Addr); Val2 := Emu64_GetQWord(Addr + 8);
     End;
     If Op2 = $57 Then Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] Xor Val1;
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] Xor Val2;
     End Else Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] And Val1;
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] And Val2;
     End;
    End;
    $58, $59, $5C, $5E: Begin { ADD/MUL/SUB/DIV SS/SD : arithmetique scalaire }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF2 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetDouble(EA.RegIdx) Else FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
      Case Op2 Of
       $58: Elf64_XmmSetDoubleLow(RegField, Elf64_XmmGetDouble(RegField) + FVal, False);
       $59: Elf64_XmmSetDoubleLow(RegField, Elf64_XmmGetDouble(RegField) * FVal, False);
       $5C: Elf64_XmmSetDoubleLow(RegField, Elf64_XmmGetDouble(RegField) - FVal, False);
       $5E: Elf64_XmmSetDoubleLow(RegField, Elf64_XmmGetDouble(RegField) / FVal, False);
      End;
     End Else If SawF3 Then Begin
      If EA.IsReg Then FVal := Elf64_XmmGetSingle(EA.RegIdx) Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
      Case Op2 Of
       $58: Elf64_XmmSetSingleLow(RegField, Elf64_XmmGetSingle(RegField) + FVal, False);
       $59: Elf64_XmmSetSingleLow(RegField, Elf64_XmmGetSingle(RegField) * FVal, False);
       $5C: Elf64_XmmSetSingleLow(RegField, Elf64_XmmGetSingle(RegField) - FVal, False);
       $5E: Elf64_XmmSetSingleLow(RegField, Elf64_XmmGetSingle(RegField) / FVal, False);
      End;
     End Else If Saw66 Then Begin
      { PD : forme empaquetee, 2 doubles independants (ADDPD/MULPD/SUBPD/DIVPD) }
      Elf64_XmmGetPackedDoubles(RegField, PD0, PD1);
      If EA.IsReg Then Elf64_XmmGetPackedDoubles(EA.RegIdx, QD0, QD1)
      Else Begin
       Addr := Elf64_ResolveEA(EA);
       Move(Emu64_GetQWord(Addr), QD0, SizeOf(QD0));
       Move(Emu64_GetQWord(Addr + 8), QD1, SizeOf(QD1));
      End;
      Case Op2 Of
       $58: Begin PD0 := PD0 + QD0; PD1 := PD1 + QD1; End;
       $59: Begin PD0 := PD0 * QD0; PD1 := PD1 * QD1; End;
       $5C: Begin PD0 := PD0 - QD0; PD1 := PD1 - QD1; End;
       $5E: Begin PD0 := PD0 / QD0; PD1 := PD1 / QD1; End;
      End;
      Elf64_XmmSetPackedDoubles(RegField, PD0, PD1);
     End Else Begin
      { PS : forme empaquetee, 4 flottants simple precision independants }
      Elf64_XmmGetPackedSingles(RegField, PS0, PS1, PS2, PS3);
      If EA.IsReg Then Elf64_XmmGetPackedSingles(EA.RegIdx, QS0, QS1, QS2, QS3)
      Else Begin
       Addr := Elf64_ResolveEA(EA);
       Val1 := Emu64_GetQWord(Addr); Val2 := Emu64_GetQWord(Addr + 8);
       WScratch := LongWord(Val1 And $FFFFFFFF); Move(WScratch, QS0, SizeOf(QS0));
       WScratch := LongWord(Val1 Shr 32);        Move(WScratch, QS1, SizeOf(QS1));
       WScratch := LongWord(Val2 And $FFFFFFFF); Move(WScratch, QS2, SizeOf(QS2));
       WScratch := LongWord(Val2 Shr 32);        Move(WScratch, QS3, SizeOf(QS3));
      End;
      Case Op2 Of
       $58: Begin PS0 := PS0+QS0; PS1 := PS1+QS1; PS2 := PS2+QS2; PS3 := PS3+QS3; End;
       $59: Begin PS0 := PS0*QS0; PS1 := PS1*QS1; PS2 := PS2*QS2; PS3 := PS3*QS3; End;
       $5C: Begin PS0 := PS0-QS0; PS1 := PS1-QS1; PS2 := PS2-QS2; PS3 := PS3-QS3; End;
       $5E: Begin PS0 := PS0/QS0; PS1 := PS1/QS1; PS2 := PS2/QS2; PS3 := PS3/QS3; End;
      End;
      Elf64_XmmSetPackedSingles(RegField, PS0, PS1, PS2, PS3);
     End;
    End;

    $6F: Begin { MOVDQA (66) / MOVDQU (F3) : xmm(RegField) <- EA, 128 bits entiers }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 Or SawF3 Then Begin
      If EA.IsReg Then Begin
       ELF64_Xmm[RegField, 0] := ELF64_Xmm[EA.RegIdx, 0];
       ELF64_Xmm[RegField, 1] := ELF64_Xmm[EA.RegIdx, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       ELF64_Xmm[RegField, 0] := Emu64_GetQWord(Addr);
       ELF64_Xmm[RegField, 1] := Emu64_GetQWord(Addr + 8);
      End;
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F 6F (MMX) non supporte';
     End;
    End;
    $7F: Begin { MOVDQA/MOVDQU, sens inverse : EA <- xmm(RegField) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 Or SawF3 Then Begin
      If EA.IsReg Then Begin
       ELF64_Xmm[EA.RegIdx, 0] := ELF64_Xmm[RegField, 0];
       ELF64_Xmm[EA.RegIdx, 1] := ELF64_Xmm[RegField, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       Emu64_PutQWord(Addr, ELF64_Xmm[RegField, 0]);
       Emu64_PutQWord(Addr + 8, ELF64_Xmm[RegField, 1]);
      End;
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F 7F (MMX) non supporte';
     End;
    End;
    $EF: Begin { PXOR xmm(RegField), xmm/m128 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] Xor ELF64_Xmm[EA.RegIdx, 0];
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] Xor ELF64_Xmm[EA.RegIdx, 1];
     End Else Begin
      Addr := Elf64_ResolveEA(EA);
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] Xor Emu64_GetQWord(Addr);
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] Xor Emu64_GetQWord(Addr + 8);
     End;
    End;
    $DB, $EB: Begin { PAND (DB) / POR (EB) xmm(RegField), xmm/m128 }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If EA.IsReg Then Begin
      Val1 := ELF64_Xmm[EA.RegIdx, 0]; Val2 := ELF64_Xmm[EA.RegIdx, 1];
     End Else Begin
      Addr := Elf64_ResolveEA(EA);
      Val1 := Emu64_GetQWord(Addr); Val2 := Emu64_GetQWord(Addr + 8);
     End;
     If Op2 = $DB Then Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] And Val1;
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] And Val2;
     End Else Begin
      ELF64_Xmm[RegField, 0] := ELF64_Xmm[RegField, 0] Or Val1;
      ELF64_Xmm[RegField, 1] := ELF64_Xmm[RegField, 1] Or Val2;
     End;
    End;
    $60, $61, $62: Begin { PUNPCKLBW/WD/DQ xmm(RegField), xmm/m128 (SSE2) :   }
                          { entrelace les elements de poids faible (8 octets }
                          { bas) de la destination et de la source.          }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 Then Begin
      If EA.IsReg Then SrcLoQ := ELF64_Xmm[EA.RegIdx, 0]
      Else Begin
       Addr := Elf64_ResolveEA(EA);
       SrcLoQ := Emu64_GetQWord(Addr);
      End;
      DstLoQ := ELF64_Xmm[RegField, 0];
      Move(DstLoQ, PunpckDstB, 8);
      Move(SrcLoQ, PunpckSrcB, 8);
      Case Op2 Of
       $60: PunpckElemSize := 1;
       $61: PunpckElemSize := 2;
       Else PunpckElemSize := 4;
      End;
      PunpckNElem := 8 Div PunpckElemSize;
      For PunpckI := 0 To PunpckNElem - 1 Do Begin
       Move(PunpckDstB[PunpckI * PunpckElemSize],
        PunpckRes[2 * PunpckI * PunpckElemSize], PunpckElemSize);
       Move(PunpckSrcB[PunpckI * PunpckElemSize],
        PunpckRes[(2 * PunpckI + 1) * PunpckElemSize], PunpckElemSize);
      End;
      Move(PunpckRes[0], ELF64_Xmm[RegField, 0], 8);
      Move(PunpckRes[8], ELF64_Xmm[RegField, 1], 8);
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F ' + HexByte(Op2) + ' (MMX) non supporte';
     End;
    End;
    $70: Begin { PSHUFD xmm(RegField), xmm/m128, imm8 (SSE2, prefixe 66) :    }
              { chaque dword du resultat est choisi parmi les 4 dwords de la }
              { source, selon 2 bits de l immediat par position.             }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     PshufImm := Elf64_FetchByte;
     If Saw66 Then Begin
      If EA.IsReg Then Begin
       SrcLoQ := ELF64_Xmm[EA.RegIdx, 0];
       Val2   := ELF64_Xmm[EA.RegIdx, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       SrcLoQ := Emu64_GetQWord(Addr);
       Val2   := Emu64_GetQWord(Addr + 8);
      End;
      Move(SrcLoQ, PshufSrcDW[0], 8);
      Move(Val2, PshufSrcDW[2], 8);
      For PunpckI := 0 To 3 Do
       PshufResDW[PunpckI] := PshufSrcDW[(PshufImm Shr (2 * PunpckI)) And 3];
      Move(PshufResDW[0], ELF64_Xmm[RegField, 0], 8);
      Move(PshufResDW[2], ELF64_Xmm[RegField, 1], 8);
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F 70 (PSHUFB/W, prefixe non 66) non supporte';
     End;
    End;
    $74, $75, $76: Begin { PCMPEQB/W/D xmm(RegField), xmm/m128 (SSE2) :       }
                         { compare chaque element ; resultat tout-a-1 si     }
                         { egal, sinon tout-a-0 (masque classique strlen/    }
                         { memchr vectorise).                                }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 Then Begin
      If EA.IsReg Then Begin
       SrcLoQ := ELF64_Xmm[EA.RegIdx, 0]; Val2 := ELF64_Xmm[EA.RegIdx, 1];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       SrcLoQ := Emu64_GetQWord(Addr); Val2 := Emu64_GetQWord(Addr + 8);
      End;
      DstLoQ := ELF64_Xmm[RegField, 0];
      Move(DstLoQ, CmpDstB[0], 8);
      Move(ELF64_Xmm[RegField, 1], CmpDstB[8], 8);
      Move(SrcLoQ, CmpSrcB[0], 8);
      Move(Val2, CmpSrcB[8], 8);
      Case Op2 Of
       $74: CmpElemSize := 1;
       $75: CmpElemSize := 2;
       Else CmpElemSize := 4;
      End;
      CmpNElem := 16 Div CmpElemSize;
      For CmpI := 0 To CmpNElem - 1 Do Begin
       CmpEqual := True;
       For I := 0 To CmpElemSize - 1 Do
        If CmpDstB[CmpI * CmpElemSize + I] <> CmpSrcB[CmpI * CmpElemSize + I] Then
         CmpEqual := False;
       If CmpEqual Then FillChar(CmpResB[CmpI * CmpElemSize], CmpElemSize, $FF)
       Else FillChar(CmpResB[CmpI * CmpElemSize], CmpElemSize, 0);
      End;
      Move(CmpResB[0], ELF64_Xmm[RegField, 0], 8);
      Move(CmpResB[8], ELF64_Xmm[RegField, 1], 8);
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F ' + HexByte(Op2) + ' (MMX) non supporte';
     End;
    End;
    $D7: Begin { PMOVMSKB reg32, xmm (SSE2) : bit de poids fort de chaque    }
               { octet de la source -> un bit du masque 16 bits resultat    }
               { (forme registre uniquement, pas de forme memoire).         }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If Saw66 And EA.IsReg Then Begin
      Move(ELF64_Xmm[EA.RegIdx, 0], CmpDstB[0], 8);
      Move(ELF64_Xmm[EA.RegIdx, 1], CmpDstB[8], 8);
      ResVal := 0;
      For I := 0 To 15 Do
       If (CmpDstB[I] And $80) <> 0 Then ResVal := ResVal Or (QWord(1) Shl I);
      Elf64_SetReg(RegField, 32, ResVal);
     End Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode 0F D7 (MMX ou forme memoire) non supporte';
     End;
    End;
    $6E: Begin { MOVD/MOVQ : xmm(RegField) <- r/m (32 ou 64 bits selon REX.W) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If RexW Then Begin
      ELF64_Xmm[RegField, 0] := Elf64_ReadOperand(EA, 64);
     End Else
      ELF64_Xmm[RegField, 0] := QWord(LongWord(Elf64_ReadOperand(EA, 32)));
     ELF64_Xmm[RegField, 1] := 0;
    End;
    $7E: Begin { MOVD/MOVQ (66, entier) ou MOVQ xmm<-xmm/m64 (F3) }
     EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
     If SawF3 Then Begin
      If EA.IsReg Then Begin
       ELF64_Xmm[RegField, 0] := ELF64_Xmm[EA.RegIdx, 0];
      End Else Begin
       Addr := Elf64_ResolveEA(EA);
       ELF64_Xmm[RegField, 0] := Emu64_GetQWord(Addr);
      End;
      ELF64_Xmm[RegField, 1] := 0;
     End Else Begin
      If RexW Then Elf64_WriteOperand(EA, 64, ELF64_Xmm[RegField, 0])
              Else Elf64_WriteOperand(EA, 32, ELF64_Xmm[RegField, 0] And $FFFFFFFF);
     End;
    End;
    Else Begin
     ELF64_Halted := True;
     ELF64_LastBadRIP := StartRIP;
     ELF64_HaltReason := 'Opcode 0F ' + HexByte(Op2) + ' non supporte';
    End;
   End;
  End;

  $69: Begin { IMUL r, r/m, imm (imm16 si prefixe 66, sinon imm32) }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Val1 := Elf64_ReadOperand(EA, OpSize);
   If OpSize = 16 Then
    Val2 := QWord(Word(Elf64_FetchImm16Signed))
   Else Begin
    Imm32 := Elf64_FetchImm32Signed;
    If OpSize = 64 Then Val2 := QWord(Int64(Imm32)) Else Val2 := QWord(LongWord(Imm32));
   End;
   Elf64_SetReg(RegField, OpSize, Elf64_ImulTrunc(Val1, Val2, OpSize));
  End;
  $6B: Begin { IMUL r, r/m, imm8 (signe-etendu) }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Val1 := Elf64_ReadOperand(EA, OpSize);
   Imm8 := Elf64_FetchImm8Signed;
   Elf64_SetReg(RegField, OpSize, Elf64_ImulTrunc(Val1, QWord(Int64(Imm8)), OpSize));
  End;

  $99: Begin { CDQ/CQO/CWD : etend le signe de RAX/EAX/AX dans RDX/EDX/DX }
   If RexW Then Begin
    If (ELF64_Reg[REG_RAX] And QWord($8000000000000000)) <> 0 Then
     ELF64_Reg[REG_RDX] := QWord($FFFFFFFFFFFFFFFF)
    Else
     ELF64_Reg[REG_RDX] := 0;
   End Else If Saw66 Then Begin
    If (ELF64_Reg[REG_RAX] And $8000) <> 0 Then Elf64_SetReg(REG_RDX, 16, $FFFF)
                                            Else Elf64_SetReg(REG_RDX, 16, 0);
   End Else Begin
    If (ELF64_Reg[REG_RAX] And $80000000) <> 0 Then Elf64_SetReg(REG_RDX, 32, $FFFFFFFF)
                                               Else Elf64_SetReg(REG_RDX, 32, 0);
   End;
  End;

  $9B: ; { FWAIT/WAIT : synchronisation avec le x87 - sans effet ici,   }
        { aucune exception flottante asynchrone n est suivie.            }

  $9E: Begin { SAHF : charge AH dans les fanions (CF/PF/ZF/SF) - utilise }
            { avec FNSTSW AX pour brancher sur une comparaison x87.      }
   Val1 := Elf64_GetReg(REG_RAX, 16) Shr 8;
   ELF64_FCF := (Val1 And $01) <> 0;
   ELF64_FPF := (Val1 And $04) <> 0;
   ELF64_FZF := (Val1 And $40) <> 0;
   ELF64_FSF := (Val1 And $80) <> 0;
  End;

  $63: Begin { MOVSXD r64, r/m32 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Val1 := Elf64_ReadOperand(EA, 32);
   Elf64_SetReg(RegField, 64, QWord(Int64(LongInt(LongWord(Val1)))));
  End;

  $80: Begin { groupe 1 : Eb, ib }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Imm8 := Elf64_FetchImm8Signed;
   Val1 := Elf64_ReadOperand(EA, 8);
   ResVal := Elf64_AluCompute(GroupOp, Val1, QWord(Byte(Imm8)), 8);
   If GroupOp <> 7 Then Elf64_WriteOperand(EA, 8, ResVal);
  End;
  $81: Begin { groupe 1 : Ev, iz (iz = imm16 si prefixe 66, sinon imm32) }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Val1 := Elf64_ReadOperand(EA, OpSize);
   If OpSize = 16 Then
    Val2 := QWord(Word(Elf64_FetchImm16Signed))
   Else Begin
    Imm32 := Elf64_FetchImm32Signed;
    If OpSize = 64 Then Val2 := QWord(Int64(Imm32)) Else Val2 := QWord(LongWord(Imm32));
   End;
   ResVal := Elf64_AluCompute(GroupOp, Val1, Val2, OpSize);
   If GroupOp <> 7 Then Elf64_WriteOperand(EA, OpSize, ResVal);
  End;
  $83: Begin { groupe 1 : Ev, ib (signe-etendu) }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Imm8 := Elf64_FetchImm8Signed;
   Val1 := Elf64_ReadOperand(EA, OpSize);
   ResVal := Elf64_AluCompute(GroupOp, Val1, QWord(Int64(Imm8)), OpSize);
   If GroupOp <> 7 Then Elf64_WriteOperand(EA, OpSize, ResVal);
  End;

  $C0: Begin { groupe 2 : Eb, ib (decalage/rotation, compte immediat) }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Imm8 := Elf64_FetchImm8Signed;
   Val1 := Elf64_ReadOperand(EA, 8);
   Elf64_WriteOperand(EA, 8, Elf64_DoShift(GroupOp, Val1, Byte(Imm8) And 31, 8));
  End;
  $C1: Begin { groupe 2 : Ev, ib }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Imm8 := Elf64_FetchImm8Signed;
   Val1 := Elf64_ReadOperand(EA, OpSize);
   If OpSize = 64 Then I := Byte(Imm8) And 63 Else I := Byte(Imm8) And 31;
   Elf64_WriteOperand(EA, OpSize, Elf64_DoShift(GroupOp, Val1, I, OpSize));
  End;
  $D0: Begin { groupe 2 : Eb, 1 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Val1 := Elf64_ReadOperand(EA, 8);
   Elf64_WriteOperand(EA, 8, Elf64_DoShift(GroupOp, Val1, 1, 8));
  End;
  $D1: Begin { groupe 2 : Ev, 1 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Val1 := Elf64_ReadOperand(EA, OpSize);
   Elf64_WriteOperand(EA, OpSize, Elf64_DoShift(GroupOp, Val1, 1, OpSize));
  End;
  $D2: Begin { groupe 2 : Eb, CL }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Val1 := Elf64_ReadOperand(EA, 8);
   Elf64_WriteOperand(EA, 8, Elf64_DoShift(GroupOp, Val1,
    Integer(Elf64_GetReg(REG_RCX, 8)) And 31, 8));
  End;
  $D3: Begin { groupe 2 : Ev, CL }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Val1 := Elf64_ReadOperand(EA, OpSize);
   If OpSize = 64 Then I := Integer(Elf64_GetReg(REG_RCX, 8)) And 63
                  Else I := Integer(Elf64_GetReg(REG_RCX, 8)) And 31;
   Elf64_WriteOperand(EA, OpSize, Elf64_DoShift(GroupOp, Val1, I, OpSize));
  End;

  $A6: Begin { CMPSB, repete si prefixe REPE/REPNE (F3/F2) vu }
   If SawF3 Or SawF2 Then Begin
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Val1 := Emu64_GetByte(ELF64_Reg[REG_RSI]);
     Val2 := Emu64_GetByte(ELF64_Reg[REG_RDI]);
     Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, 8);
     Elf64_AdvanceSIDI(8);
     ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
     If SawF3 And Not ELF64_FZF Then Break;
     If SawF2 And ELF64_FZF Then Break;
    End;
   End Else Begin
    Val1 := Emu64_GetByte(ELF64_Reg[REG_RSI]);
    Val2 := Emu64_GetByte(ELF64_Reg[REG_RDI]);
    Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, 8);
    Elf64_AdvanceSIDI(8);
   End;
  End;
  $A7: Begin { CMPSW/CMPSD/CMPSQ, repete si prefixe REPE/REPNE (F3/F2) vu }
   If SawF3 Or SawF2 Then Begin
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Val1 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RSI]), OpSize);
     Val2 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RDI]), OpSize);
     Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, OpSize);
     Elf64_AdvanceSIDI(OpSize);
     ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
     If SawF3 And Not ELF64_FZF Then Break;
     If SawF2 And ELF64_FZF Then Break;
    End;
   End Else Begin
    Val1 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RSI]), OpSize);
    Val2 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RDI]), OpSize);
    Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, OpSize);
    Elf64_AdvanceSIDI(OpSize);
   End;
  End;
  $AE: Begin { SCASB, repete si prefixe REPE/REPNE (F3/F2) vu }
   If SawF3 Or SawF2 Then Begin
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Val1 := Elf64_GetReg(REG_RAX, 8);
     Val2 := Emu64_GetByte(ELF64_Reg[REG_RDI]);
     Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, 8);
     If ELF64_FDF Then ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - 1
                  Else ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + 1;
     ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
     If SawF3 And Not ELF64_FZF Then Break;
     If SawF2 And ELF64_FZF Then Break;
    End;
   End Else Begin
    Val1 := Elf64_GetReg(REG_RAX, 8);
    Val2 := Emu64_GetByte(ELF64_Reg[REG_RDI]);
    Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, 8);
    If ELF64_FDF Then ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - 1
                 Else ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + 1;
   End;
  End;
  $AF: Begin { SCASW/SCASD/SCASQ, repete si prefixe REPE/REPNE (F3/F2) vu }
   If SawF3 Or SawF2 Then Begin
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Val1 := Elf64_GetReg(REG_RAX, OpSize);
     Val2 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RDI]), OpSize);
     Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, OpSize);
     If ELF64_FDF Then ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - QWord(OpSize Div 8)
                  Else ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + QWord(OpSize Div 8);
     ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
     If SawF3 And Not ELF64_FZF Then Break;
     If SawF2 And ELF64_FZF Then Break;
    End;
   End Else Begin
    Val1 := Elf64_GetReg(REG_RAX, OpSize);
    Val2 := Elf64_ReadOperand(Elf64_MemEA(ELF64_Reg[REG_RDI]), OpSize);
    Elf64_SetFlagsSub(Val1, Val2, Val1 - Val2, OpSize);
    If ELF64_FDF Then ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] - QWord(OpSize Div 8)
                 Else ELF64_Reg[REG_RDI] := ELF64_Reg[REG_RDI] + QWord(OpSize Div 8);
   End;
  End;

  $84: Begin { TEST r/m8, r8 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Val1 := Elf64_ReadOperand(EA, 8);
   Val2 := Elf64_GetReg(RegField, 8);
   Elf64_SetFlagsLogic(Val1 And Val2, 8);
  End;
  $85: Begin { TEST r/m, r }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Val1 := Elf64_ReadOperand(EA, OpSize);
   Val2 := Elf64_GetReg(RegField, OpSize);
   Elf64_SetFlagsLogic(Val1 And Val2, OpSize);
  End;

  $88: Begin { MOV r/m8, r8 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Elf64_WriteOperand(EA, 8, Elf64_GetReg(RegField, 8));
  End;
  $89: Begin { MOV r/m, r }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Elf64_WriteOperand(EA, OpSize, Elf64_GetReg(RegField, OpSize));
  End;
  $8A: Begin { MOV r8, r/m8 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Elf64_SetReg(RegField, 8, Elf64_ReadOperand(EA, 8));
  End;
  $8B: Begin { MOV r, r/m }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Elf64_SetReg(RegField, OpSize, Elf64_ReadOperand(EA, OpSize));
  End;
  $8D: Begin { LEA r, m }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Elf64_SetReg(RegField, OpSize, Elf64_ResolveEA(EA));
  End;

  $A0: Begin { MOV AL, moffs8 : AL <- octet a l adresse absolue (64 bits)   }
             { qui suit directement l opcode (pas de ModRM pour cette forme}
             { rare d adressage direct, utilisee par certains acces a des  }
             { variables globales statiquement connues).                  }
   Addr := Elf64_FetchImm64;
   Elf64_SetReg(REG_RAX, 8, Emu64_GetByte(Addr));
  End;
  $A1: Begin { MOV eAX/rAX, moffs (32/64 bits selon la taille d operande) }
   Addr := Elf64_FetchImm64;
   If OpSize = 64 Then Elf64_SetReg(REG_RAX, 64, Emu64_GetQWord(Addr))
   Else If OpSize = 16 Then Elf64_SetReg(REG_RAX, 16, Emu64_GetWord(Addr))
   Else Elf64_SetReg(REG_RAX, 32, Emu64_GetDWord(Addr));
  End;
  $A2: Begin { MOV moffs8, AL }
   Addr := Elf64_FetchImm64;
   Emu64_PutByte(Addr, Byte(ELF64_Reg[REG_RAX] And $FF));
  End;
  $A3: Begin { MOV moffs, eAX/rAX }
   Addr := Elf64_FetchImm64;
   If OpSize = 64 Then Emu64_PutQWord(Addr, ELF64_Reg[REG_RAX])
   Else If OpSize = 16 Then Emu64_PutWord(Addr, Word(ELF64_Reg[REG_RAX] And $FFFF))
   Else Emu64_PutDWord(Addr, LongWord(ELF64_Reg[REG_RAX] And $FFFFFFFF));
  End;
  $B0..$B7: Begin { MOV r8, imm8 (registre code dans l opcode) }
   RegField := (Op - $B0);
   If RexB Then RegField := RegField Or 8;
   Elf64_SetReg(RegField, 8, QWord(Elf64_FetchByte));
  End;
  $B8..$BF: Begin { MOV r16/r32/r64, imm (registre code dans l opcode) }
   RegField := (Op - $B8);
   If RexB Then RegField := RegField Or 8;
   If RexW Then Begin
    Imm64 := Elf64_FetchImm64;
    Elf64_SetReg(RegField, 64, Imm64);
   End Else If Saw66 Then
    Elf64_SetReg(RegField, 16, QWord(Word(Elf64_FetchImm16Signed)))
   Else Begin
    Imm32 := Elf64_FetchImm32Signed;
    Elf64_SetReg(RegField, 32, QWord(LongWord(Imm32)));
   End;
  End;

  $C6: Begin { MOV r/m8, imm8 }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   Imm8 := Elf64_FetchImm8Signed;
   Elf64_WriteOperand(EA, 8, QWord(Byte(Imm8)));
  End;
  $C7: Begin { MOV r/m, imm (imm16 si prefixe 66, sinon imm32 signe-etendu }
             { si REX.W) - l immediat DOIT suivre la taille d operande,   }
             { sinon le decodage des instructions suivantes se desynchronise.}
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   If OpSize = 16 Then
    Elf64_WriteOperand(EA, 16, QWord(Word(Elf64_FetchImm16Signed)))
   Else Begin
    Imm32 := Elf64_FetchImm32Signed;
    If OpSize = 64 Then
     Elf64_WriteOperand(EA, 64, QWord(Int64(Imm32)))
    Else
     Elf64_WriteOperand(EA, OpSize, QWord(LongWord(Imm32)));
   End;
  End;

  $50..$57: Elf64_Push(ELF64_Reg[(Op - $50) Or Ord(RexB) Shl 3]);
  $58..$5F: Begin
   RegField := (Op - $58);
   If RexB Then RegField := RegField Or 8;
   ELF64_Reg[RegField] := Elf64_Pop;
  End;

  $C3: ELF64_RIP := Elf64_Pop; { RET }

  $E8: Begin { CALL rel32 }
   Imm32 := Elf64_FetchImm32Signed;
   Elf64_Push(ELF64_RIP);
   ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm32));
  End;
  $E9: Begin { JMP rel32 }
   Imm32 := Elf64_FetchImm32Signed;
   ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm32));
  End;
  $EB: Begin { JMP rel8 }
   Imm8 := Elf64_FetchImm8Signed;
   ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;

  $E2: Begin { LOOP rel8 : decremente RCX, saute si RCX <> 0 }
   Imm8 := Elf64_FetchImm8Signed;
   ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
   If ELF64_Reg[REG_RCX] <> 0 Then
    ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;
  $E1: Begin { LOOPE/LOOPZ rel8 : saute si RCX<>0 apres decrement ET ZF=1 }
   Imm8 := Elf64_FetchImm8Signed;
   ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
   If (ELF64_Reg[REG_RCX] <> 0) And ELF64_FZF Then
    ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;
  $E0: Begin { LOOPNE/LOOPNZ rel8 : saute si RCX<>0 apres decrement ET ZF=0 }
   Imm8 := Elf64_FetchImm8Signed;
   ELF64_Reg[REG_RCX] := ELF64_Reg[REG_RCX] - 1;
   If (ELF64_Reg[REG_RCX] <> 0) And (Not ELF64_FZF) Then
    ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;
  $E3: Begin { JRCXZ rel8 : saute si RCX = 0 (sans decrement) }
   Imm8 := Elf64_FetchImm8Signed;
   If ELF64_Reg[REG_RCX] = 0 Then
    ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;

  $70..$7F: Begin { Jcc rel8 }
   Imm8 := Elf64_FetchImm8Signed;
   If Elf64_EvalCond(Op And $0F) Then
    ELF64_RIP := QWord(Int64(ELF64_RIP) + Int64(Imm8));
  End;

  $FC: ELF64_FDF := False; { CLD }
  $FD: ELF64_FDF := True;  { STD }

  $A4: Begin { MOVSB, repete si prefixe REP (F3) vu }
   If SawF3 Then
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Elf64_DoMovs(8);
     Dec(ELF64_Reg[REG_RCX]);
    End
   Else
    Elf64_DoMovs(8);
  End;
  $A5: Begin { MOVSW/MOVSD/MOVSQ, repete si prefixe REP (F3) vu }
   If SawF3 Then
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Elf64_DoMovs(OpSize);
     Dec(ELF64_Reg[REG_RCX]);
    End
   Else
    Elf64_DoMovs(OpSize);
  End;
  $AA: Begin { STOSB, repete si prefixe REP (F3) vu }
   If SawF3 Then
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Elf64_DoStos(8);
     Dec(ELF64_Reg[REG_RCX]);
    End
   Else
    Elf64_DoStos(8);
  End;
  $AB: Begin { STOSW/STOSD/STOSQ, repete si prefixe REP (F3) vu }
   If SawF3 Then
    While ELF64_Reg[REG_RCX] <> 0 Do Begin
     Elf64_DoStos(OpSize);
     Dec(ELF64_Reg[REG_RCX]);
    End
   Else
    Elf64_DoStos(OpSize);
  End;

  $F6: Begin { groupe 3 : Eb }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Case GroupOp Of
    0, 1: Begin
     Imm8 := Elf64_FetchImm8Signed;
     Val1 := Elf64_ReadOperand(EA, 8);
     Elf64_SetFlagsLogic(Val1 And QWord(Byte(Imm8)), 8);
    End;
    2: Begin
     Val1 := Elf64_ReadOperand(EA, 8);
     Elf64_WriteOperand(EA, 8, (Not Val1) And $FF);
    End;
    3: Begin
     Val1 := Elf64_ReadOperand(EA, 8);
     ResVal := ((Not Val1) + 1) And $FF;
     Elf64_SetFlagsSub(0, Val1, ResVal, 8);
     Elf64_WriteOperand(EA, 8, ResVal);
    End;
    4: Begin { MUL : AX = AL * r/m8 (non signe) }
     Val1 := Elf64_ReadOperand(EA, 8);
     FullU := (ELF64_Reg[REG_RAX] And $FF) * (Val1 And $FF);
     Elf64_SetReg(REG_RAX, 16, FullU And $FFFF);
     ELF64_FCF := (FullU And $FF00) <> 0; ELF64_FOF := ELF64_FCF;
    End;
    5: Begin { IMUL : AX = AL * r/m8 (signe) }
     Val1 := Elf64_ReadOperand(EA, 8);
     FullS := Elf64_SignExtend(ELF64_Reg[REG_RAX], 8) * Elf64_SignExtend(Val1, 8);
     Elf64_SetReg(REG_RAX, 16, QWord(FullS) And $FFFF);
     ELF64_FCF := (FullS < -128) Or (FullS > 127); ELF64_FOF := ELF64_FCF;
    End;
    6: Begin { DIV : AL=quotient AH=reste = AX / r/m8 (non signe) }
     Val1 := Elf64_ReadOperand(EA, 8);
     If Val1 = 0 Then Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Division par zero (DIV 8 bits)';
     End Else Begin
      FullU := ELF64_Reg[REG_RAX] And $FFFF;
      QuotR := FullU Div (Val1 And $FF);
      RemR := FullU Mod (Val1 And $FF);
      If QuotR > 255 Then Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Depassement de quotient (DIV 8 bits)';
      End Else
       Elf64_SetReg(REG_RAX, 16, (RemR Shl 8) Or QuotR);
     End;
    End;
    7: Begin { IDIV : AL=quotient AH=reste = AX / r/m8 (signe) }
     Val1 := Elf64_ReadOperand(EA, 8);
     If Val1 = 0 Then Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Division par zero (IDIV 8 bits)';
     End Else Begin
      FullS := Elf64_SignExtend(ELF64_Reg[REG_RAX], 16);
      DivS := Elf64_SignExtend(Val1, 8);
      QuotR := QWord(FullS Div DivS);
      RemR := QWord(FullS Mod DivS);
      If (Int64(QuotR) < -128) Or (Int64(QuotR) > 127) Then Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Depassement de quotient (IDIV 8 bits)';
      End Else
       Elf64_SetReg(REG_RAX, 16, (RemR And $FF) Shl 8 Or (QuotR And $FF));
     End;
    End;
    Else Begin
     ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
     ELF64_HaltReason := 'Groupe F6 /' + IntToStr(GroupOp) + ' non supporte';
    End;
   End;
  End;
  $F7: Begin { groupe 3 : Ev }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Case GroupOp Of
    0, 1: Begin { TEST Ev, iz (iz = imm16 si prefixe 66, sinon imm32) }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If OpSize = 16 Then
      Val2 := QWord(Word(Elf64_FetchImm16Signed))
     Else Begin
      Imm32 := Elf64_FetchImm32Signed;
      If OpSize = 64 Then Val2 := QWord(Int64(Imm32)) Else Val2 := QWord(LongWord(Imm32));
     End;
     Elf64_SetFlagsLogic(Val1 And Val2, OpSize);
    End;
    2: Begin
     Val1 := Elf64_ReadOperand(EA, OpSize);
     Elf64_WriteOperand(EA, OpSize, Not Val1);
    End;
    3: Begin
     Val1 := Elf64_ReadOperand(EA, OpSize);
     ResVal := (Not Val1) + 1;
     Elf64_SetFlagsSub(0, Val1, ResVal, OpSize);
     Elf64_WriteOperand(EA, OpSize, ResVal);
    End;
    4: Begin { MUL : RDX:RAX (ou EDX:EAX) = RAX * r/m (non signe) }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If OpSize = 64 Then Begin
      Elf64_UMul64(ELF64_Reg[REG_RAX], Val1, HiRes, LoRes);
      ELF64_Reg[REG_RAX] := LoRes;
      ELF64_Reg[REG_RDX] := HiRes;
      ELF64_FCF := (HiRes <> 0); ELF64_FOF := ELF64_FCF;
     End Else Begin
      FullU := (ELF64_Reg[REG_RAX] And $FFFFFFFF) * (Val1 And $FFFFFFFF);
      Elf64_SetReg(REG_RAX, OpSize, FullU And $FFFFFFFF);
      Elf64_SetReg(REG_RDX, OpSize, FullU Shr 32);
      ELF64_FCF := ((FullU Shr 32) <> 0); ELF64_FOF := ELF64_FCF;
     End;
    End;
    5: Begin { IMUL : RDX:RAX (ou EDX:EAX) = RAX * r/m (signe) }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If OpSize = 64 Then Begin
      Elf64_SMul64(ELF64_Reg[REG_RAX], Val1, HiRes, LoRes);
      ELF64_Reg[REG_RAX] := LoRes;
      ELF64_Reg[REG_RDX] := HiRes;
      If (LoRes And QWord($8000000000000000)) <> 0 Then
       ELF64_FCF := (HiRes <> QWord($FFFFFFFFFFFFFFFF))
      Else
       ELF64_FCF := (HiRes <> 0);
      ELF64_FOF := ELF64_FCF;
     End Else Begin
      FullS := Elf64_SignExtend(ELF64_Reg[REG_RAX], 32) * Elf64_SignExtend(Val1, 32);
      Elf64_SetReg(REG_RAX, OpSize, QWord(FullS) And $FFFFFFFF);
      Elf64_SetReg(REG_RDX, OpSize, QWord(FullS Shr 32));
      ELF64_FCF := (FullS < -2147483648) Or (FullS > 2147483647);
      ELF64_FOF := ELF64_FCF;
     End;
    End;
    6: Begin { DIV : RAX=quotient RDX=reste = RDX:RAX / r/m (non signe) }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If Val1 = 0 Then Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Division par zero (DIV)';
     End Else If OpSize = 64 Then Begin
      If Not Elf64_UDiv128(ELF64_Reg[REG_RDX], ELF64_Reg[REG_RAX], Val1, QuotR, RemR) Then Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Depassement de quotient (DIV 64 bits)';
      End Else Begin
       ELF64_Reg[REG_RAX] := QuotR;
       ELF64_Reg[REG_RDX] := RemR;
      End;
     End Else Begin
      FullU := (Elf64_GetReg(REG_RDX, OpSize) Shl OpSize) Or Elf64_GetReg(REG_RAX, OpSize);
      QuotR := FullU Div Val1;
      RemR := FullU Mod Val1;
      Elf64_SetReg(REG_RAX, OpSize, QuotR);
      Elf64_SetReg(REG_RDX, OpSize, RemR);
     End;
    End;
    7: Begin { IDIV : RAX=quotient RDX=reste = RDX:RAX / r/m (signe) }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     If Val1 = 0 Then Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Division par zero (IDIV)';
     End Else If OpSize = 64 Then Begin
      If Not Elf64_SDiv128(ELF64_Reg[REG_RDX], ELF64_Reg[REG_RAX], Val1, QuotR, RemR) Then Begin
       ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
       ELF64_HaltReason := 'Depassement de quotient (IDIV 64 bits)';
      End Else Begin
       ELF64_Reg[REG_RAX] := QuotR;
       ELF64_Reg[REG_RDX] := RemR;
      End;
     End Else Begin
      FullS := Int64((Elf64_GetReg(REG_RDX, OpSize) Shl OpSize) Or Elf64_GetReg(REG_RAX, OpSize));
      DivS := Elf64_SignExtend(Val1, OpSize);
      Elf64_SetReg(REG_RAX, OpSize, QWord(FullS Div DivS));
      Elf64_SetReg(REG_RDX, OpSize, QWord(FullS Mod DivS));
     End;
    End;
    Else Begin
     ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
     ELF64_HaltReason := 'Groupe F7 /' + IntToStr(GroupOp) + ' non supporte';
    End;
   End;
  End;

  $FF: Begin { groupe 5 : INC/DEC/CALL/JMP indirect/PUSH }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   GroupOp := RegField And 7;
   Case GroupOp Of
    0: Begin { INC r/m - simplification : CF est egalement recalcule, }
              { alors qu INC ne devrait pas y toucher.                }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     ResVal := Val1 + 1;
     Elf64_SetFlagsAdd(Val1, 1, ResVal, OpSize);
     Elf64_WriteOperand(EA, OpSize, ResVal);
    End;
    1: Begin { DEC r/m - meme simplification pour CF }
     Val1 := Elf64_ReadOperand(EA, OpSize);
     ResVal := Val1 - 1;
     Elf64_SetFlagsSub(Val1, 1, ResVal, OpSize);
     Elf64_WriteOperand(EA, OpSize, ResVal);
    End;
    2: Begin { CALL r/m64 (indirect pres) }
     Val1 := Elf64_ReadOperand(EA, 64);
     Elf64_Push(ELF64_RIP);
     ELF64_RIP := Val1;
    End;
    4: Begin { JMP r/m64 (indirect pres) }
     ELF64_RIP := Elf64_ReadOperand(EA, 64);
    End;
    6: Elf64_Push(Elf64_ReadOperand(EA, 64)); { PUSH r/m64 }
    Else Begin
     ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
     ELF64_HaltReason := 'Groupe FF /' + IntToStr(GroupOp) + ' non supporte';
    End;
   End;
  End;

  $D8: Begin { x87 : ST0 op= (m32real ou ST(i)), reel simple precision }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   If EA.IsReg Then FVal := ELF64_FpuReg[EA.RegIdx]
               Else FVal := Elf64_ReadSingle(Elf64_ResolveEA(EA));
   Case RegField Of
    0: ELF64_FpuReg[0] := ELF64_FpuReg[0] + FVal; { FADD }
    1: ELF64_FpuReg[0] := ELF64_FpuReg[0] * FVal; { FMUL }
    2: Elf64_FpuCompare(ELF64_FpuReg[0], FVal);   { FCOM }
    3: Begin Elf64_FpuCompare(ELF64_FpuReg[0], FVal); Elf64_FpuPop; End; { FCOMP }
    4: ELF64_FpuReg[0] := ELF64_FpuReg[0] - FVal; { FSUB }
    5: ELF64_FpuReg[0] := FVal - ELF64_FpuReg[0]; { FSUBR }
    6: ELF64_FpuReg[0] := ELF64_FpuReg[0] / FVal; { FDIV }
    7: ELF64_FpuReg[0] := FVal / ELF64_FpuReg[0]; { FDIVR }
   End;
  End;

  $D9: Begin { x87 : chargement/format/constantes/transcendantes }
   B := Emu64_GetByte(ELF64_RIP);
   If (B And $C0) = $C0 Then Begin
    B := Elf64_FetchByte;
    Case B Of
     $C0..$C7: Elf64_FpuPush(ELF64_FpuReg[B And 7]); { FLD ST(i) }
     $C8..$CF: Begin { FXCH ST(i) }
      FVal := ELF64_FpuReg[0];
      ELF64_FpuReg[0] := ELF64_FpuReg[B And 7];
      ELF64_FpuReg[B And 7] := FVal;
     End;
     $D0: ; { FNOP }
     $E0: ELF64_FpuReg[0] := -ELF64_FpuReg[0];      { FCHS }
     $E1: ELF64_FpuReg[0] := Abs(ELF64_FpuReg[0]);  { FABS }
     $E4: Elf64_FpuCompare(ELF64_FpuReg[0], 0);     { FTST }
     $E8: Elf64_FpuPush(1.0);                       { FLD1 }
     $EE: Elf64_FpuPush(0.0);                       { FLDZ }
     $FA: ELF64_FpuReg[0] := Sqrt(ELF64_FpuReg[0]); { FSQRT }
     $FC: ELF64_FpuReg[0] := Int(ELF64_FpuReg[0]);  { FRNDINT (troncature, mode d arrondi non applique) }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode x87 D9 ' + HexByte(B) + ' non supporte';
     End;
    End;
   End Else Begin
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Case RegField Of
     0: Elf64_FpuPush(Elf64_ReadSingle(Elf64_ResolveEA(EA)));               { FLD m32real }
     2: Elf64_WriteSingle(Elf64_ResolveEA(EA), ELF64_FpuReg[0]);            { FST m32real }
     3: Begin Elf64_WriteSingle(Elf64_ResolveEA(EA), ELF64_FpuReg[0]); Elf64_FpuPop; End; { FSTP m32real }
     5: ELF64_FpuCW := Emu64_GetWord(Elf64_ResolveEA(EA));                  { FLDCW }
     7: Emu64_PutWord(Elf64_ResolveEA(EA), ELF64_FpuCW);                    { FNSTCW }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 D9 /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  $DA: Begin { x87 : entier 32 bits memoire, ou FUCOMPP/FCMOVcc en registre }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   If EA.IsReg Then Begin
    If (RegField = 5) And (EA.RegIdx = 1) Then Begin { DA E9 = FUCOMPP }
     Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[1]);
     Elf64_FpuPop; Elf64_FpuPop;
    End Else Begin
     ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
     ELF64_HaltReason := 'Opcode x87 DA (FCMOVcc) non supporte';
    End;
   End Else Begin
    FVal := Elf64_SignExtend(Emu64_GetDWord(Elf64_ResolveEA(EA)), 32);
    Case RegField Of
     0: ELF64_FpuReg[0] := ELF64_FpuReg[0] + FVal;
     1: ELF64_FpuReg[0] := ELF64_FpuReg[0] * FVal;
     4: ELF64_FpuReg[0] := ELF64_FpuReg[0] - FVal;
     5: ELF64_FpuReg[0] := FVal - ELF64_FpuReg[0];
     6: ELF64_FpuReg[0] := ELF64_FpuReg[0] / FVal;
     7: ELF64_FpuReg[0] := FVal / ELF64_FpuReg[0];
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 DA /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  $DB: Begin { x87 : entier 32 bits / reel 80 bits, controle }
   B := Emu64_GetByte(ELF64_RIP);
   If (B And $C0) = $C0 Then Begin
    B := Elf64_FetchByte;
    Case B Of
     $E3: Begin { FNINIT }
      For I := 0 To 7 Do ELF64_FpuReg[I] := 0;
      ELF64_FpuCW := $037F;
     End;
     $E2: ; { FNCLEX : aucun etat d exception suivi }
     $E8..$EF: Elf64_FpuCompareToFlags(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]); { FUCOMI }
     $F0..$F7: Elf64_FpuCompareToFlags(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]); { FCOMI }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode x87 DB ' + HexByte(B) + ' non supporte';
     End;
    End;
   End Else Begin
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Case RegField Of
     0: Elf64_FpuPush(Elf64_FildMem(Elf64_ResolveEA(EA), 32));              { FILD m32int }
     2: Elf64_FistpMem(Elf64_ResolveEA(EA), 32, ELF64_FpuReg[0], False);    { FIST m32int }
     3: Elf64_FistpMem(Elf64_ResolveEA(EA), 32, ELF64_FpuReg[0], True);     { FISTP m32int }
     5: Elf64_FpuPush(Elf64_ReadExtended(Elf64_ResolveEA(EA)));             { FLD m80real }
     7: Begin Elf64_WriteExtended(Elf64_ResolveEA(EA), ELF64_FpuReg[0]); Elf64_FpuPop; End; { FSTP m80real }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 DB /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  $DC: Begin { x87 : ST(i) op= (m64real ou ST0), reel double precision }
   EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
   If EA.IsReg Then Begin
    { forme registre : destination ST(i), inversee par rapport a D8 }
    Case RegField Of
     0: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[EA.RegIdx] + ELF64_FpuReg[0];
     1: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[EA.RegIdx] * ELF64_FpuReg[0];
     2: Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[EA.RegIdx]);
     3: Begin Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[EA.RegIdx]); Elf64_FpuPop; End;
     4: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[EA.RegIdx] - ELF64_FpuReg[0];
     5: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[0] - ELF64_FpuReg[EA.RegIdx];
     6: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[EA.RegIdx] / ELF64_FpuReg[0];
     7: ELF64_FpuReg[EA.RegIdx] := ELF64_FpuReg[0] / ELF64_FpuReg[EA.RegIdx];
    End;
   End Else Begin
    FVal := Elf64_ReadDouble(Elf64_ResolveEA(EA));
    Case RegField Of
     0: ELF64_FpuReg[0] := ELF64_FpuReg[0] + FVal;
     1: ELF64_FpuReg[0] := ELF64_FpuReg[0] * FVal;
     2: Elf64_FpuCompare(ELF64_FpuReg[0], FVal);
     3: Begin Elf64_FpuCompare(ELF64_FpuReg[0], FVal); Elf64_FpuPop; End;
     4: ELF64_FpuReg[0] := ELF64_FpuReg[0] - FVal;
     5: ELF64_FpuReg[0] := FVal - ELF64_FpuReg[0];
     6: ELF64_FpuReg[0] := ELF64_FpuReg[0] / FVal;
     7: ELF64_FpuReg[0] := FVal / ELF64_FpuReg[0];
    End;
   End;
  End;

  $DD: Begin { x87 : reel double precision (chargement/format), FST(P) ST(i) }
   B := Emu64_GetByte(ELF64_RIP);
   If (B And $C0) = $C0 Then Begin
    B := Elf64_FetchByte;
    Case B Of
     $C0..$C7: ; { FFREE ST(i) : tags non suivis, sans effet }
     $D0..$D7: ELF64_FpuReg[B And 7] := ELF64_FpuReg[0];                   { FST ST(i) }
     $D8..$DF: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[0]; Elf64_FpuPop; End; { FSTP ST(i) }
     $E0..$E7: Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]);   { FUCOM }
     $E8..$EF: Begin Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]); Elf64_FpuPop; End; { FUCOMP }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode x87 DD ' + HexByte(B) + ' non supporte';
     End;
    End;
   End Else Begin
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Case RegField Of
     0: Elf64_FpuPush(Elf64_ReadDouble(Elf64_ResolveEA(EA)));              { FLD m64real }
     2: Elf64_WriteDouble(Elf64_ResolveEA(EA), ELF64_FpuReg[0]);           { FST m64real }
     3: Begin Elf64_WriteDouble(Elf64_ResolveEA(EA), ELF64_FpuReg[0]); Elf64_FpuPop; End; { FSTP m64real }
     7: Emu64_PutWord(Elf64_ResolveEA(EA), (Ord(ELF64_FpuC3) Shl 14) Or    { FNSTSW m2byte }
        (Ord(ELF64_FpuC2) Shl 10) Or (Ord(ELF64_FpuC0) Shl 8));
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 DD /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  $DE: Begin { x87 : entier 16 bits memoire, ou *P (pop) en registre }
   B := Emu64_GetByte(ELF64_RIP);
   If (B And $C0) = $C0 Then Begin
    B := Elf64_FetchByte;
    Case B Of
     $C0..$C7: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[B And 7] + ELF64_FpuReg[0]; Elf64_FpuPop; End; { FADDP }
     $C8..$CF: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[B And 7] * ELF64_FpuReg[0]; Elf64_FpuPop; End; { FMULP }
     $D9: Begin Elf64_FpuCompare(ELF64_FpuReg[0], ELF64_FpuReg[1]); Elf64_FpuPop; Elf64_FpuPop; End; { FCOMPP }
     $E0..$E7: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[0] - ELF64_FpuReg[B And 7]; Elf64_FpuPop; End; { FSUBRP }
     $E8..$EF: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[B And 7] - ELF64_FpuReg[0]; Elf64_FpuPop; End; { FSUBP }
     $F0..$F7: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[0] / ELF64_FpuReg[B And 7]; Elf64_FpuPop; End; { FDIVRP }
     $F8..$FF: Begin ELF64_FpuReg[B And 7] := ELF64_FpuReg[B And 7] / ELF64_FpuReg[0]; Elf64_FpuPop; End; { FDIVP }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode x87 DE ' + HexByte(B) + ' non supporte';
     End;
    End;
   End Else Begin
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    FVal := Elf64_SignExtend(Emu64_GetWord(Elf64_ResolveEA(EA)), 16);
    Case RegField Of
     0: ELF64_FpuReg[0] := ELF64_FpuReg[0] + FVal;
     1: ELF64_FpuReg[0] := ELF64_FpuReg[0] * FVal;
     4: ELF64_FpuReg[0] := ELF64_FpuReg[0] - FVal;
     5: ELF64_FpuReg[0] := FVal - ELF64_FpuReg[0];
     6: ELF64_FpuReg[0] := ELF64_FpuReg[0] / FVal;
     7: ELF64_FpuReg[0] := FVal / ELF64_FpuReg[0];
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 DE /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  $DF: Begin { x87 : entier 16/64 bits, FNSTSW AX, FUCOMIP/FCOMIP }
   B := Emu64_GetByte(ELF64_RIP);
   If (B And $C0) = $C0 Then Begin
    B := Elf64_FetchByte;
    Case B Of
     $E0: Elf64_SetReg(REG_RAX, 16, (Ord(ELF64_FpuC3) Shl 14) Or           { FNSTSW AX }
          (Ord(ELF64_FpuC2) Shl 10) Or (Ord(ELF64_FpuC0) Shl 8));
     $E8..$EF: Begin Elf64_FpuCompareToFlags(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]); Elf64_FpuPop; End; { FUCOMIP }
     $F0..$F7: Begin Elf64_FpuCompareToFlags(ELF64_FpuReg[0], ELF64_FpuReg[B And 7]); Elf64_FpuPop; End; { FCOMIP }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Opcode x87 DF ' + HexByte(B) + ' non supporte';
     End;
    End;
   End Else Begin
    EA := Elf64_DecodeModRM(RexR, RexX, RexB, RegField);
    Case RegField Of
     0: Elf64_FpuPush(Elf64_FildMem(Elf64_ResolveEA(EA), 16));             { FILD m16int }
     3: Elf64_FistpMem(Elf64_ResolveEA(EA), 16, ELF64_FpuReg[0], True);    { FISTP m16int }
     5: Elf64_FpuPush(Elf64_FildMem(Elf64_ResolveEA(EA), 64));             { FILD m64int }
     7: Elf64_FistpMem(Elf64_ResolveEA(EA), 64, ELF64_FpuReg[0], True);    { FISTP m64int }
     Else Begin
      ELF64_Halted := True; ELF64_LastBadRIP := StartRIP;
      ELF64_HaltReason := 'Groupe x87 DF /' + IntToStr(RegField) + ' non supporte';
     End;
    End;
   End;
  End;

  Else Begin
   ELF64_Halted := True;
   ELF64_LastBadRIP := StartRIP;
   ELF64_HaltReason := 'Opcode ' + HexByte(Op) + ' non supporte';
  End;
 End;

 If Not ELF64_Halted Then Inc(ELF64_InstrCount);
End;
{$POP}

{ --- Charger un binaire DOS (auto-detection .COM / .EXE) --- }

Function Emu_LoadProgram(Var C: TEmuCPU; FileName: String): Boolean;
Var
 Ext: String;
 I: Integer;
Begin
 { Reset des handles et DTA a chaque chargement }
 For I := 5 To 31 Do EmuFileOpen[I] := False;
 EmuDtaSeg := $0060;
 EmuDtaOfs := $0080;     { DTA par defaut = PSP+80h }
 EmuFindCount := 0;
 EmuFindIndex := 0;
 EmuLfnFindActive := False;
 EmuExecDepth := 0;    { pas d EXEC (AH=4Bh) en cours pour un nouveau programme de premier niveau }
 EmuExitCode := 0;
 EmuExitType := 0;
 EmuExtErr := 0;
 EmuExtErrCls := 0;
 EmuExtErrAct := 0;
 EmuExtErrLoc := 0;
 EmuVerifyFlag := 0;
 EmuBreakFlag := 0;
 EmuAllocStrat := 0;
 EmuSwitchChar := Ord('/');
 EmuOS2SetTitle := '';
 EmuOS2TitleSaved := False;
 EmuOS2LastDrive := 'E';
 Ext := '';
 For I := Length(FileName) DownTo 1 Do
  If FileName[I] = '.' Then Begin
   Ext := Copy(FileName, I, Length(FileName) - I + 1);
   Break;
  End;
 { Comparaison insensible a la casse }
 For I := 1 To Length(Ext) Do
  If Ext[I] In ['a'..'z'] Then
   Ext[I] := Chr(Ord(Ext[I]) - 32);
 If Ext = '.EXE' Then
  Emu_LoadProgram := Emu_LoadExe(C, FileName)
 Else
  Emu_LoadProgram := Emu_LoadCom(C, FileName);
End;

{ Declaration anticipee : definie plus bas avec Emu_DiskIdxFromDL (dont      }
{ c est l inverse exact), section INT13h. }
Function Emu_DLFromDiskIdx(Idx: Byte): Byte; Forward;

{ Amorcage reel de type INT 19h (commande Terminal BOOT) : lit le tout      }
{ premier secteur physique (LBA 0) du lecteur virtuel DriveIdx (0..3, voir  }
{ EmuFloppyOpen/Emu_ImageReadSector - MBR pour un disque dur, secteur de    }
{ demarrage direct pour une disquette, EXACTEMENT ce qu un vrai BIOS lit    }
{ sans distinction), le place a l adresse physique 0000:7C00 et positionne  }
{ CS:IP/SS:SP/DL comme le ferait un vrai BIOS avant de rendre la main -     }
{ contrairement a Emu_LoadProgram (PSP/EXE, fichier NOMME), AUCUNE          }
{ construction de PSP ici : le secteur charge est cense etre lui-meme un    }
{ chargeur de bas niveau (MBR puis DOS/OS2, ou noyau), pas un programme DOS }
{ deja pret a tourner sous une PSP. Reutilise les memes resets de session   }
{ DOS que Emu_LoadProgram par coherence (handles/DTA/EXEC), meme si un      }
{ vrai secteur de boot ne les consulte generalement pas avant que DOS lui-  }
{ meme ne soit charge. }
Function Emu_LoadBootSector(Var C: TEmuCPU; DriveIdx: Byte): Boolean;
Var
 SectorBuf: Array[0..511] Of Byte;
 DriveParam: Array[0..10] Of Byte;
 I: Integer;
Begin
 Emu_LoadBootSector := False;
 For I := 5 To 31 Do EmuFileOpen[I] := False;
 EmuDtaSeg := $0060;
 EmuDtaOfs := $0080;
 EmuFindCount := 0;
 EmuFindIndex := 0;
 EmuLfnFindActive := False;
 EmuExecDepth := 0;
 EmuExitCode := 0;
 EmuExitType := 0;
 EmuExtErr := 0;
 EmuExtErrCls := 0;
 EmuExtErrAct := 0;
 EmuExtErrLoc := 0;
 EmuVerifyFlag := 0;
 EmuBreakFlag := 0;
 EmuAllocStrat := 0;
 EmuSwitchChar := Ord('/');
 EmuOS2SetTitle := '';
 EmuOS2TitleSaved := False;
 EmuOS2LastDrive := 'E';
 If Not Emu_ImageReadSector(DriveIdx, 0, SectorBuf) Then Exit;
 Emu_WriteBlock(C, 0, $7C00, SectorBuf, 512);
 { INT 1Eh doit pointer vers une vraie table de parametres BIOS : le VBR
   FAT16 la copie pendant son initialisation, meme pour un disque dur. La
   placer dans la zone BIOS evite de reutiliser la zone basse du boot. }
 DriveParam[0] := $F0;
 DriveParam[1] := $DF;
 DriveParam[2] := $02;
 DriveParam[3] := $25;
 DriveParam[4] := $02;
 DriveParam[5] := $09;
 DriveParam[6] := $2A;
 DriveParam[7] := $FF;
 DriveParam[8] := $50;
 DriveParam[9] := $F6;
 DriveParam[10] := $0F;
 Emu_WriteBlock(C, $F000, $0600, DriveParam, SizeOf(DriveParam));
 Emu_WriteWord(C, 0, $0078, $0600);
 Emu_WriteWord(C, 0, $007A, $F000);
 { Convention BIOS reelle : le secteur est charge a 0000:7C00.            }
 { Les deux formes 07C0:0000 et 0000:7C00 designent la meme adresse        }
 { physique, mais elles ne sont pas interchangeables pour un MBR qui       }
 { utilise des references relatives a CS. DOS_RunOneChunk exempte deja    }
 { EmuBootActive du garde-fou CS=0, ce qui permet de conserver cette        }
 { convention materielle sans arreter le boot des la premiere instruction. }
 C.Segs.CS := $0000;
 C.IP      := $7C00;
 C.Segs.DS := 0;
 C.Segs.ES := 0;
 C.Segs.SS := 0;
 C.Regs.SP := $7C00;  { convention BIOS courante : la pile descend juste   }
                       { sous le secteur charge, le code du secteur est    }
                       { cense reprogrammer sa propre pile immediatement.  }
 C.Regs.DL := Emu_DLFromDiskIdx(DriveIdx);
 Emu_LoadBootSector := True;
End;

{ ============================================================
  EMULATEUR 8086 - PHASE 2 (1) : moteur d execution minimal
  ----------------------------------------------------------
  Sous-ensemble d instructions supporte dans cette livraison :
    NOP (90), HLT (F4), INT imm8 (CD), IRET (CF), RET (C3, CB)
    MOV r8,imm8 (B0..B7), MOV r16,imm16 (B8..BF)
  Interruptions DOS (INT 21h) supportees :
    AH=$02 (afficher car DL), AH=$06 (E/S directe console DL),
    AH=$09 (afficher chaine $-terminee a DS:DX),
    AH=$4C (terminer programme avec code AL)
  Tout autre opcode/interruption met Fault := sfInvalidCode/Intr.
  ============================================================ }

{ --- Lire l octet code courant a CS:IP --- }

Function Emu_FetchByte(Var C: TEmuCPU; Step: Integer): Byte;
Begin
 Emu_FetchByte := Emu_ReadByte(C, C.Segs.CS, C.IP + Step);
End;

Function Emu_FetchWord(Var C: TEmuCPU; Step: Integer): Word;
Begin
 Emu_FetchWord := Emu_ReadWord(C, C.Segs.CS, C.IP + Step);
End;

{ --- Acces aux registres 16 bits par numero --- }

Function Emu_GetReg16(Var C: TEmuCPU; Num: Byte): Word;
Begin
 Case Num And 7 Of
  0: Emu_GetReg16 := C.Regs.AX;
  1: Emu_GetReg16 := C.Regs.CX;
  2: Emu_GetReg16 := C.Regs.DX;
  3: Emu_GetReg16 := C.Regs.BX;
  4: Emu_GetReg16 := C.Regs.SP;
  5: Emu_GetReg16 := C.Regs.BP;
  6: Emu_GetReg16 := C.Regs.SI;
  7: Emu_GetReg16 := C.Regs.DI;
 End;
End;

Procedure Emu_SetReg16(Var C: TEmuCPU; Num: Byte; Value: Word);
Begin
 Case Num And 7 Of
  0: C.Regs.AX := Value;
  1: C.Regs.CX := Value;
  2: C.Regs.DX := Value;
  3: C.Regs.BX := Value;
  4: C.Regs.SP := Value;
  5: C.Regs.BP := Value;
  6: C.Regs.SI := Value;
  7: C.Regs.DI := Value;
 End;
End;

{ --- Acces aux registres 32 bits par numero (meme numerotation que les      }
{ formes 16/8 bits ci-dessus - 386+ mode reel, prefixe $66) - la structure    }
{ TEmuRegs a toujours eu EAX/ECX/.../EDI comme alias LongInt des memes        }
{ octets (voir sa declaration), seuls ces accesseurs manquaient. --- }
Function Emu_GetReg32(Var C: TEmuCPU; Num: Byte): LongInt;
Begin
 Case Num And 7 Of
  0: Emu_GetReg32 := C.Regs.EAX;
  1: Emu_GetReg32 := C.Regs.ECX;
  2: Emu_GetReg32 := C.Regs.EDX;
  3: Emu_GetReg32 := C.Regs.EBX;
  4: Emu_GetReg32 := C.Regs.ESP;
  5: Emu_GetReg32 := C.Regs.EBP;
  6: Emu_GetReg32 := C.Regs.ESI;
  7: Emu_GetReg32 := C.Regs.EDI;
 End;
End;

Procedure Emu_SetReg32(Var C: TEmuCPU; Num: Byte; Value: LongInt);
Begin
 Case Num And 7 Of
  0: C.Regs.EAX := Value;
  1: C.Regs.ECX := Value;
  2: C.Regs.EDX := Value;
  3: C.Regs.EBX := Value;
  4: C.Regs.ESP := Value;
  5: C.Regs.EBP := Value;
  6: C.Regs.ESI := Value;
  7: C.Regs.EDI := Value;
 End;
End;

{ --- Acces aux registres de segment par numero (0=ES,1=CS,2=SS,3=DS) --- }

Function Emu_GetSReg(Var C: TEmuCPU; Num: Byte): Word;
Begin
 Case Num And 3 Of
  0: Emu_GetSReg := C.Segs.ES;
  1: Emu_GetSReg := C.Segs.CS;
  2: Emu_GetSReg := C.Segs.SS;
  3: Emu_GetSReg := C.Segs.DS;
 End;
End;

Procedure Emu_SetSReg(Var C: TEmuCPU; Num: Byte; Value: Word);
Begin
 Case Num And 3 Of
  0: C.Segs.ES := Value;
  1: C.Segs.CS := Value;
  2: C.Segs.SS := Value;
  3: C.Segs.DS := Value;
 End;
End;

{ --- "unreal mode" (2026-08-24, BOGUE REEL CORRIGE) : appele juste APRES     }
{ tout chargement d un registre de segment (MOV Sreg,rm16 / POP Sreg) pour    }
{ imiter la vraie mecanique materielle - si CR0.PE=1 A CET INSTANT PRECIS,    }
{ un vrai CPU interprete Value comme un SELECTEUR (indice dans le GDT/LDT,    }
{ pas une adresse segmentee classique) et met en cache la base 32 bits du     }
{ descripteur correspondant DANS le registre de segment - cette base cachee   }
{ SURVIT au retour en mode reel (PE=0), ce qui est exactement la technique    }
{ "unreal mode" que le vrai HIMEM.SYS utilise pour adresser >1 Mo avec des    }
{ registres 32 bits. Seul le GDT (pas le LDT - bit TI du selecteur ignore)    }
{ est resolu, et seule la BASE est memorisee (la LIMITE n est pas appliquee   }
{ - aucune verification de depassement de segment n est modelisee, portee    }
{ volontairement limitee au strict necessaire pour lever le bogue identifie). }
{ Format standard d un descripteur GDT (8 octets, Intel) :                    }
{  octets 0-1 : limite 0-15 ; 2-3 : base 0-15 ; 4 : base 16-23 ;              }
{  5 : droits d acces ; 6 : limite 16-19 (bits bas) + indicateurs (G etc,     }
{  bits hauts) ; 7 : base 24-31. }
Procedure Emu_LoadSregUnreal(Var C: TEmuCPU; SegVal: Word);
Var
 Idx: Word;
 B0, B1, B2, B3, B4, B7: Byte;
 Base: LongInt;
 Slot, I: Integer;
Begin
 If (C.CR0 And 1) = 0 Then Exit;   { PE=0 : chargement de segment classique }
 Idx := SegVal And $FFF8;         { masque RPL (bits 0-1) et TI (bit 2) }
 If (LongInt(Idx) + 7) > C.GdtLimit Then Exit;  { hors du GDT charge par LGDT }
 { GdtBase est une adresse LINEAIRE 32 bits (chargee telle quelle par LGDT),  }
 { PAS un segment:offset - lue directement via Emu_ReadAbsBlock (adresse     }
 { physique), jamais via Emu_ReadByte (qui interpreterait a tort son 1er     }
 { parametre comme un Seg a multiplier par 16). }
 B0 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx,     B0, 1);
 B1 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx + 1, B1, 1);
 B2 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx + 2, B2, 1);
 B3 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx + 3, B3, 1);
 B4 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx + 4, B4, 1);
 B7 := 0; Emu_ReadAbsBlock(C, C.GdtBase + Idx + 7, B7, 1);
 Base := LongInt(B2) Or (LongInt(B3) Shl 8) Or (LongInt(B4) Shl 16) Or
  (LongInt(B7) Shl 24);
 { Chercher un emplacement existant pour cette valeur, sinon le plus ancien   }
 { (rotation simple - 4 emplacements suffisent largement en pratique, voir    }
 { TEmuUnrealSeg). }
 Slot := -1;
 For I := 0 To 3 Do
  If C.UnrealSegs[I].Active And (C.UnrealSegs[I].SegVal = SegVal) Then Slot := I;
 If Slot = -1 Then
  For I := 0 To 3 Do
   If Not C.UnrealSegs[I].Active Then Begin Slot := I; Break; End;
 If Slot = -1 Then Slot := 0;
 C.UnrealSegs[Slot].Active := True;
 C.UnrealSegs[Slot].SegVal := SegVal;
 C.UnrealSegs[Slot].Base := Base;
End;

{ Segment de donnees a utiliser pour les operations string (DS sauf override) }
Function Emu_DataSeg(Var C: TEmuCPU): Word;
Begin
 If C.HasSegOvr Then Emu_DataSeg := C.SegOvr
                Else Emu_DataSeg := C.Segs.DS;
End;

{ --- Decoder un octet ModR/M en operande
       (cas mod=11 : registre, sinon : adresse memoire) --- }

Procedure Emu_DecodeModRM(Var C: TEmuCPU; ModRM: Byte;
 Var Op: TEmuOperand);
Var
 Mode, RM: Byte;
 Disp: Word;
 DefSeg: Word;
Begin
 Op.IsReg := False;
 Op.RegNum := 0;
 Op.Seg := C.Segs.DS;
 Op.Ofs := 0;
 Op.AddrIs32 := False;
 Op.Len := 1;            { ModRM byte }
 Mode := (ModRM Shr 6) And 3;
 RM := ModRM And 7;
 If Mode = 3 Then Begin
  Op.IsReg := True;
  Op.RegNum := RM;
  Exit;
 End;
 { Adresse effective : segment par defaut DS, sauf si BP est utilise }
 DefSeg := C.Segs.DS;
 Case RM Of
  0: Op.Ofs := Word(C.Regs.BX + C.Regs.SI);
  1: Op.Ofs := Word(C.Regs.BX + C.Regs.DI);
  2: Begin
      Op.Ofs := Word(C.Regs.BP + C.Regs.SI);
      DefSeg := C.Segs.SS;
     End;
  3: Begin
      Op.Ofs := Word(C.Regs.BP + C.Regs.DI);
      DefSeg := C.Segs.SS;
     End;
  4: Op.Ofs := C.Regs.SI;
  5: Op.Ofs := C.Regs.DI;
  6: Begin
      If Mode = 0 Then Begin
       { [disp16] }
       Op.Ofs := Emu_FetchWord(C, 2);
       Op.Len := 3;
      End Else Begin
       Op.Ofs := C.Regs.BP;
       DefSeg := C.Segs.SS;
      End;
     End;
  7: Op.Ofs := C.Regs.BX;
 End;
 { Ajouter le deplacement si mode <> 0, sauf rm=6 mode=0 deja traite }
 Case Mode Of
  1: Begin
      { Disp8 signe }
      Disp := Emu_FetchByte(C, 2);
      If (Disp And $80) <> 0 Then
       Disp := Disp Or $FF00;
      Op.Ofs := Word(Op.Ofs + Disp);
      Op.Len := 2;
     End;
  2: Begin
      Disp := Emu_FetchWord(C, 2);
      Op.Ofs := Word(Op.Ofs + Disp);
      Op.Len := 3;
     End;
 End;
 Op.Seg := DefSeg;
 If C.HasSegOvr Then Op.Seg := C.SegOvr;
End;

{ --- Decoder un octet ModR/M en operande, adressage 32 bits (prefixe $67) --
       BOGUE REEL CORRIGE (2026-08-24, retro-ingenierie du vrai HIMEM.SYS)  :
       le vrai HIMEM.SYS utilise `67h` pour un adressage direct disp32 sans
       base (mod=00,rm=101, ex. "XCHG EAX,[disp32]") lors de sa bascule
       "unreal mode". Portee couverte : mod=11 (registre, reutilise
       Emu_GetReg32 via RegNum), mod=00 rm=101 (disp32 seul, sans base),
       et les bases simples EAX/ECX/EDX/EBX/ESI/EDI/EBP (mod 00/01/10),
       DS par defaut sauf base EBP/ESP (SS, meme convention que le 16 bits).
       Le SIB (rm=100, ex. adressage base ESP) N est PAS implante - non
       rencontre dans le cas reel identifie ; s il est rencontre, l octet
       SIB est tout de meme consomme (pour ne pas desynchroniser le
       decodage des instructions suivantes) mais l adresse resultante n est
       pas garantie correcte - meme discipline de limite de portee
       documentee que $67 dans TEmuCPU. }

Procedure Emu_DecodeModRM32(Var C: TEmuCPU; ModRM: Byte;
 Var Op: TEmuOperand);
Var
 Mode, RM: Byte;
 Disp: LongInt;
 DefSeg: Word;
 Sib: Byte;
Begin
 Op.IsReg := False;
 Op.RegNum := 0;
 Op.Seg := C.Segs.DS;
 Op.Ofs := 0;
 Op.AddrIs32 := True;
 Op.Len := 1;            { ModRM byte }
 Mode := (ModRM Shr 6) And 3;
 RM := ModRM And 7;
 If Mode = 3 Then Begin
  Op.IsReg := True;
  Op.RegNum := RM;
  Exit;
 End;
 DefSeg := C.Segs.DS;
 If RM = 4 Then Begin
  { SIB - non implante, voir commentaire ci-dessus : consomme l octet pour   }
  { rester synchronise, mais l adresse produite n est pas fiable.            }
  Sib := Emu_FetchByte(C, 2);
  Op.Ofs := 0;
  Op.Len := 2;
 End Else Begin
  Case RM Of
   0: Op.Ofs := C.Regs.EAX;
   1: Op.Ofs := C.Regs.ECX;
   2: Op.Ofs := C.Regs.EDX;
   3: Op.Ofs := C.Regs.EBX;
   5: Begin
       If Mode = 0 Then Begin
        { [disp32] direct, sans base - le cas reellement utilise par HIMEM }
        Op.Ofs := Emu_FetchWord(C, 2) Or (LongInt(Emu_FetchWord(C, 4)) Shl 16);
        Op.Len := 5;
       End Else Begin
        Op.Ofs := C.Regs.EBP;
        DefSeg := C.Segs.SS;
       End;
      End;
   6: Op.Ofs := C.Regs.ESI;
   7: Op.Ofs := C.Regs.EDI;
  End;
 End;
 { Ajouter le deplacement si mode <> 0 (sauf rm=5 mode=0 deja traite ci-dessus) }
 If Not ((RM = 5) And (Mode = 0)) Then
  Case Mode Of
   1: Begin
       Disp := Emu_FetchByte(C, 1 + Op.Len);
       If (Disp And $80) <> 0 Then Disp := Disp Or LongInt($FFFFFF00);
       Op.Ofs := Op.Ofs + Disp;
       Inc(Op.Len);
      End;
   2: Begin
       Disp := Emu_FetchWord(C, 1 + Op.Len) Or
        (LongInt(Emu_FetchWord(C, 3 + Op.Len)) Shl 16);
       Op.Ofs := Op.Ofs + Disp;
       Inc(Op.Len, 4);
      End;
  End;
 Op.Seg := DefSeg;
 If C.HasSegOvr Then Op.Seg := C.SegOvr;
End;

{ --- Lire/ecrire un operande octet ou mot --- }

Function Emu_GetOpByte(Var C: TEmuCPU; Var Op: TEmuOperand): Byte;
Begin
 If Op.IsReg Then
  Emu_GetOpByte := Emu_GetReg8(C, Op.RegNum)
 Else If Op.AddrIs32 Then
  Emu_GetOpByte := Emu_ReadByteL(C, Op.Seg, Op.Ofs)
 Else
  Emu_GetOpByte := Emu_ReadByte(C, Op.Seg, Word(Op.Ofs));
End;

Procedure Emu_PutOpByte(Var C: TEmuCPU; Var Op: TEmuOperand; V: Byte);
Begin
 If Op.IsReg Then
  Emu_SetReg8(C, Op.RegNum, V)
 Else If Op.AddrIs32 Then
  Emu_WriteByteL(C, Op.Seg, Op.Ofs, V)
 Else
  Emu_WriteByte(C, Op.Seg, Word(Op.Ofs), V);
End;

Function Emu_GetOpWord(Var C: TEmuCPU; Var Op: TEmuOperand): Word;
Begin
 If Op.IsReg Then
  Emu_GetOpWord := Emu_GetReg16(C, Op.RegNum)
 Else If Op.AddrIs32 Then
  Emu_GetOpWord := Emu_ReadWordL(C, Op.Seg, Op.Ofs)
 Else
  Emu_GetOpWord := Emu_ReadWord(C, Op.Seg, Word(Op.Ofs));
End;

Procedure Emu_PutOpWord(Var C: TEmuCPU; Var Op: TEmuOperand; V: Word);
Begin
 If Op.IsReg Then
  Emu_SetReg16(C, Op.RegNum, V)
 Else If Op.AddrIs32 Then
  Emu_WriteWordL(C, Op.Seg, Op.Ofs, V)
 Else
  Emu_WriteWord(C, Op.Seg, Word(Op.Ofs), V);
End;

{ --- Operande 32 bits (prefixe $66) : meme motif Reg/Memoire que ci-dessus. }
{ L adresse (Op.Ofs/Op.AddrIs32) est 16 OU 32 bits selon que l operande a    }
{ ete decode par Emu_DecodeModRM (toujours 16 bits) ou Emu_DecodeModRM32     }
{ (prefixe $67 - voir TEmuCPU.AddrSize32) ; seule la LARGEUR de la valeur    }
{ transferee est pilotee par $66/OperandSize32, independamment. --- }
Function Emu_GetOpDWord(Var C: TEmuCPU; Var Op: TEmuOperand): LongInt;
Begin
 If Op.IsReg Then
  Emu_GetOpDWord := Emu_GetReg32(C, Op.RegNum)
 Else If Op.AddrIs32 Then
  Emu_GetOpDWord := Emu_ReadDWordL(C, Op.Seg, Op.Ofs)
 Else
  Emu_GetOpDWord := Emu_ReadDWord(C, Op.Seg, Word(Op.Ofs));
End;

Procedure Emu_PutOpDWord(Var C: TEmuCPU; Var Op: TEmuOperand; V: LongInt);
Begin
 If Op.IsReg Then
  Emu_SetReg32(C, Op.RegNum, V)
 Else If Op.AddrIs32 Then
  Emu_WriteDWordL(C, Op.Seg, Op.Ofs, V)
 Else
  Emu_WriteDWord(C, Op.Seg, Word(Op.Ofs), V);
End;

{ --- ALU 8 bits : Op=0:ADD 1:OR 2:ADC 3:SBB 4:AND 5:SUB 6:XOR 7:CMP --- }

{ BOGUE REEL CORRIGE (2026-08-25, trouve en tracant a la main l'affichage    }
{ d'erreur HIMEM "XMS non fiable" jusqu'a decouvrir que la valeur imprimee   }
{ ne correspondait a AUCUNE arithmetique plausible) : EFG_AF (retenue       }
{ auxiliaire) n'etait JAMAIS calcule par ADD/ADC/SUB/SBB/CMP - seuls         }
{ DAA/DAS/AAA/AAS le lisaient ET l'ecrivaient, donc il restait bloque a la   }
{ valeur laissee par le tout dernier DAA/DAS/AAA/AAS execute PENDANT TOUT LE }
{ RESTE DU BOOT, au lieu de refleter la VRAIE retenue bit3->bit4 de          }
{ l'addition/soustraction qui precede immediatement. Consequence directe :   }
{ toute conversion octet->2 chiffres hexa via l'idiome classique             }
{ ADD+DAA+ADC+DAA (utilise par le vrai HIMEM.SYS pour son message d'erreur,  }
{ et probablement par d'autres programmes DOS/BIOS reels) produisait un      }
{ decalage constant errone (chiffre '0' affiche '6', '1' affiche '7', etc.)  }
{ des que AF etait reste bloque a 1 par un DAA anterieur - la VALEUR REELLE  }
{ que HIMEM tentait d'afficher (0x00100000, coherente avec le correctif      }
{ AH=88h existant) etait donc totalement invisible derriere un message       }
{ d'erreur illisible (0x66760666). Corrige ici, au point d'entree ALU 8      }
{ bits partage par ADD/OR/ADC/SBB/AND/SUB/XOR/CMP (utilise par tout le       }
{ dispatch $00-$3D et le groupe 1 $80/$82) - meme formule XOR standard que   }
{ pour les autres emulateurs ALU deja presents dans ce fichier (Dpmi_Alu,    }
{ Elf64_AluCompute, etc.), qui eux geraient deja AF correctement. }
Function Emu_AluByte(Var C: TEmuCPU; AluOp, A, B: Byte): Byte;
Var
 R: LongInt;
 R8: Byte;
 OldCF: Byte;
Begin
 OldCF := 0;
 If EFG_CF In C.Flags.s Then OldCF := 1;
 Case AluOp Of
  0: Begin { ADD }
      R := LongInt(A) + B;
      R8 := Byte(R);
      If (R And $100) <> 0 Then Include(C.Flags.s, EFG_CF)
                            Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor R8) And (B Xor R8) And $80) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R8) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  1: Begin { OR }
      R8 := A Or B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  2: Begin { ADC }
      R := LongInt(A) + B + OldCF;
      R8 := Byte(R);
      If (R And $100) <> 0 Then Include(C.Flags.s, EFG_CF)
                            Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor R8) And (B Xor R8) And $80) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R8) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  3: Begin { SBB }
      R := LongInt(A) - B - OldCF;
      R8 := Byte(R);
      If (R And $100) <> 0 Then Include(C.Flags.s, EFG_CF)
                            Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor B) And (A Xor R8) And $80) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R8) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  4: Begin { AND }
      R8 := A And B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  5, 7: Begin { SUB / CMP }
      R := LongInt(A) - B;
      R8 := Byte(R);
      If (R And $100) <> 0 Then Include(C.Flags.s, EFG_CF)
                            Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor B) And (A Xor R8) And $80) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R8) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  6: Begin { XOR }
      R8 := A Xor B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  Else
   R8 := 0;
 End;
 Emu_SetSFB(C, R8);
 Emu_SetZFB(C, R8);
 Emu_SetPF(C, R8);
 Emu_AluByte := R8;
End;

{ --- ALU 16 bits --- }

Function Emu_AluWord(Var C: TEmuCPU; AluOp: Byte; A, B: Word): Word;
Var
 R: LongInt;
 R16: Word;
 OldCF: Word;
Begin
 OldCF := 0;
 If EFG_CF In C.Flags.s Then OldCF := 1;
 Case AluOp Of
  0: Begin { ADD }
      R := LongInt(A) + B;
      R16 := Word(R);
      If (R And $10000) <> 0 Then Include(C.Flags.s, EFG_CF)
                              Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor R16) And (B Xor R16) And $8000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R16) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  1: Begin
      R16 := A Or B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  2: Begin { ADC }
      R := LongInt(A) + B + OldCF;
      R16 := Word(R);
      If (R And $10000) <> 0 Then Include(C.Flags.s, EFG_CF)
                              Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor R16) And (B Xor R16) And $8000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R16) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  3: Begin { SBB }
      R := LongInt(A) - B - OldCF;
      R16 := Word(R);
      If (R And $10000) <> 0 Then Include(C.Flags.s, EFG_CF)
                              Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor B) And (A Xor R16) And $8000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R16) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  4: Begin
      R16 := A And B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  5, 7: Begin { SUB / CMP }
      R := LongInt(A) - B;
      R16 := Word(R);
      If (R And $10000) <> 0 Then Include(C.Flags.s, EFG_CF)
                              Else Exclude(C.Flags.s, EFG_CF);
      If ((A Xor B) And (A Xor R16) And $8000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((A Xor B) Xor R16) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  6: Begin
      R16 := A Xor B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  Else
   R16 := 0;
 End;
 Emu_SetSFW(C, R16);
 Emu_SetZFW(C, R16);
 Emu_SetPF(C, Byte(R16));
 Emu_AluWord := R16;
End;

{ --- ALU 32 bits (prefixe $66, 386+) - meme motif que Emu_AluWord ci-dessus,}
{ ajoute 2026-08-24 en poursuivant l enquete DOS=HIGH/XMS (HIMEM.SYS compare }
{ reellement des motifs de test 32 bits pour verifier la memoire etendue).   }
{ Utilise Int64 pour l intermediaire "R" (une LongInt 32 bits signee ne       }
{ pourrait pas detecter une retenue au-dela du bit 31 sans deborder). --- }
Function Emu_AluDWord(Var C: TEmuCPU; AluOp: Byte; A, B: LongInt): LongInt;
Var
 R: Int64;
 R32: LongInt;
 OldCF: LongInt;
Begin
 OldCF := 0;
 If EFG_CF In C.Flags.s Then OldCF := 1;
 Case AluOp Of
  0: Begin { ADD }
      R := Int64(LongWord(A)) + LongWord(B);
      R32 := LongInt(LongWord(R));
      If (R And $100000000) <> 0 Then Include(C.Flags.s, EFG_CF)
                                  Else Exclude(C.Flags.s, EFG_CF);
      If ((LongWord(A) Xor LongWord(R32)) And (LongWord(B) Xor LongWord(R32)) And $80000000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((LongWord(A) Xor LongWord(B)) Xor LongWord(R32)) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  1: Begin { OR }
      R32 := A Or B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  2: Begin { ADC }
      R := Int64(LongWord(A)) + LongWord(B) + OldCF;
      R32 := LongInt(LongWord(R));
      If (R And $100000000) <> 0 Then Include(C.Flags.s, EFG_CF)
                                  Else Exclude(C.Flags.s, EFG_CF);
      If ((LongWord(A) Xor LongWord(R32)) And (LongWord(B) Xor LongWord(R32)) And $80000000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((LongWord(A) Xor LongWord(B)) Xor LongWord(R32)) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  3: Begin { SBB }
      R := Int64(LongWord(A)) - LongWord(B) - OldCF;
      R32 := LongInt(LongWord(R));
      If (R And $100000000) <> 0 Then Include(C.Flags.s, EFG_CF)
                                  Else Exclude(C.Flags.s, EFG_CF);
      If ((LongWord(A) Xor LongWord(B)) And (LongWord(A) Xor LongWord(R32)) And $80000000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((LongWord(A) Xor LongWord(B)) Xor LongWord(R32)) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  4: Begin { AND }
      R32 := A And B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  5, 7: Begin { SUB / CMP }
      R := Int64(LongWord(A)) - LongWord(B);
      R32 := LongInt(LongWord(R));
      If (R And $100000000) <> 0 Then Include(C.Flags.s, EFG_CF)
                                  Else Exclude(C.Flags.s, EFG_CF);
      If ((LongWord(A) Xor LongWord(B)) And (LongWord(A) Xor LongWord(R32)) And $80000000) <> 0
       Then Include(C.Flags.s, EFG_OF)
       Else Exclude(C.Flags.s, EFG_OF);
      If (((LongWord(A) Xor LongWord(B)) Xor LongWord(R32)) And $10) <> 0
       Then Include(C.Flags.s, EFG_AF) Else Exclude(C.Flags.s, EFG_AF);
     End;
  6: Begin { XOR }
      R32 := A Xor B;
      Exclude(C.Flags.s, EFG_CF);
      Exclude(C.Flags.s, EFG_OF);
     End;
  Else
   R32 := 0;
 End;
 If (LongWord(R32) And $80000000) <> 0 Then Include(C.Flags.s, EFG_SF)
                                        Else Exclude(C.Flags.s, EFG_SF);
 If R32 = 0 Then Include(C.Flags.s, EFG_ZF) Else Exclude(C.Flags.s, EFG_ZF);
 Emu_SetPF(C, Byte(R32));
 Emu_AluDWord := R32;
End;

{ --- Tester une condition de saut conditionnel (cc = bits 3..0 de OpCode) --- }

Function Emu_TestCond(Var C: TEmuCPU; CC: Byte): Boolean;
Var
 Res: Boolean;
Begin
 Res := False;
 Case CC And $E Of
  $0: Res := EFG_OF In C.Flags.s;          { O   }
  $2: Res := EFG_CF In C.Flags.s;          { B/C }
  $4: Res := EFG_ZF In C.Flags.s;          { Z   }
  $6: Res := (EFG_CF In C.Flags.s)
          Or (EFG_ZF In C.Flags.s);        { BE  }
  $8: Res := EFG_SF In C.Flags.s;          { S   }
  $A: Res := EFG_PF In C.Flags.s;          { P   }
  $C: Res := (EFG_SF In C.Flags.s)
         <> (EFG_OF In C.Flags.s);         { L   }
  $E: Res := ((EFG_SF In C.Flags.s)
         <> (EFG_OF In C.Flags.s))
          Or (EFG_ZF In C.Flags.s);        { LE  }
 End;
 If (CC And 1) <> 0 Then Res := Not Res;
 Emu_TestCond := Res;
End;

{ Forward pour buffer clavier BIOS, defini plus loin avec les IRQ. }
Function Emu_BiosHasKey(Var P: TEmulatorPanel): Boolean; Forward;
Function Emu_BiosPopKey(Var P: TEmulatorPanel): Word; Forward;

{ ============================================================
  PHASE 0..2 : Carte video unifiee CGA / EGA / VGA.
  ------------------------------------------------------------
  Allocation 256 Ko, palette DAC VGA par defaut, registres
  Sequencer / GC / AC / CRTC / DAC / CGA tous expose via I/O.
  ============================================================ }

{ --- Initialiser la palette DAC VGA standard (256 entrees) --- }
Procedure Emu_VidInitDefaultDAC;
Var I: Integer;
    R, G, B: Byte;
    EgaToVga: Array[0..15] Of Byte;
Begin
 { Palette EGA 16 couleurs aux indices 0..15 (6 bits par composante) }
 EgaToVga[0] := 0;  EgaToVga[1] := 1;  EgaToVga[2] := 2;  EgaToVga[3] := 3;
 EgaToVga[4] := 4;  EgaToVga[5] := 5;  EgaToVga[6] := 20; EgaToVga[7] := 7;
 EgaToVga[8] := 56; EgaToVga[9] := 57; EgaToVga[10]:= 58; EgaToVga[11]:= 59;
 EgaToVga[12]:= 60; EgaToVga[13]:= 61; EgaToVga[14]:= 62; EgaToVga[15]:= 63;
 { Premier remplissage : 16 couleurs IBM standard }
 For I := 0 To 15 Do Begin
  R := 0; G := 0; B := 0;
  If (I And 4) <> 0 Then R := 42;
  If (I And 2) <> 0 Then G := 42;
  If (I And 1) <> 0 Then B := 42;
  If (I And 8) <> 0 Then Begin
   R := R + 21; G := G + 21; B := B + 21;
  End;
  { Cas particulier : 6 = brun (R=42, G=21, B=0) }
  If I = 6 Then Begin R := 42; G := 21; B := 0; End;
  EmuVideo.DAC[I*3 + 0] := R;
  EmuVideo.DAC[I*3 + 1] := G;
  EmuVideo.DAC[I*3 + 2] := B;
 End;
 { Indices 16..31 : niveaux de gris }
 For I := 0 To 15 Do Begin
  R := (I * 63) Div 15;
  EmuVideo.DAC[(16+I)*3 + 0] := R;
  EmuVideo.DAC[(16+I)*3 + 1] := R;
  EmuVideo.DAC[(16+I)*3 + 2] := R;
 End;
 { Indices 32..255 : remplissage RGB pseudo regulier (suffisant pour
   la plupart des programmes qui chargent leur propre palette). }
 For I := 32 To 255 Do Begin
  R := ((I Shr 5) And 7) * 9;
  G := ((I Shr 2) And 7) * 9;
  B := (I And 3) * 21;
  EmuVideo.DAC[I*3 + 0] := R;
  EmuVideo.DAC[I*3 + 1] := G;
  EmuVideo.DAC[I*3 + 2] := B;
 End;
End;

{ --- Allouer la memoire video et initialiser l etat --- }
Procedure Emu_VidInit;
Begin
 If Not EmuVideo.MemReady Then Begin
  New(EmuVideo.Mem);
  FillChar(EmuVideo.Mem^, SizeOf(EmuVideo.Mem^), 0);
  EmuVideo.MemReady := True;
 End;
 EmuVideo.Mode := $03;
 EmuVideo.Width := 720; EmuVideo.Height := 400;
 EmuVideo.TextCols := 80; EmuVideo.TextRows := 25;
 EmuVideo.BitsPerPix := 0;
 EmuVideo.IsGraphic := False;
 EmuVideo.IsPlanar := False;
 EmuVideo.ChainFour := False;
 EmuVideo.PageBase := 0;
 EmuVideo.DACWriteIdx := 0;
 EmuVideo.DACReadIdx := 0;
 EmuVideo.DACMask := $FF;
 EmuVideo.DACState := 0;
 EmuVideo.SeqIdx := 0;
 FillChar(EmuVideo.SeqReg, SizeOf(EmuVideo.SeqReg), 0);
 EmuVideo.SeqReg[2] := $0F;   { plane mask 1111 }
 EmuVideo.GCIdx := 0;
 FillChar(EmuVideo.GCReg, SizeOf(EmuVideo.GCReg), 0);
 EmuVideo.GCReg[6] := $0E;    { mem map = $A000-$AFFF, alpha disable }
 EmuVideo.GCReg[8] := $FF;    { bit mask = tous les bits }
 EmuVideo.ACFlipFlop := False;
 EmuVideo.ACIdx := 0;
 FillChar(EmuVideo.ACReg, SizeOf(EmuVideo.ACReg), 0);
 EmuVideo.CRTCIdx := 0;
 FillChar(EmuVideo.CRTCReg, SizeOf(EmuVideo.CRTCReg), 0);
 FillChar(EmuVideo.Latch, SizeOf(EmuVideo.Latch), 0);
 EmuVideo.CGAMode := 0;
 EmuVideo.CGAColor := 0;
 EmuVideo.StatusRetrace := 0;
 EmuVideo.GfxDirty := True;
 Emu_VidInitDefaultDAC;
End;

{ --- Tester si une adresse appartient a la fenetre video. --- }
Function Emu_VidIsVidAddr(Seg, Ofs: Word; Var Plane0Ofs: LongInt): Boolean;
Var Lin: LongInt;
Begin
 Lin := (LongInt(Seg) Shl 4) + Ofs;
 Emu_VidIsVidAddr := False;
 If (Lin >= $A0000) And (Lin < $B0000) Then Begin
  Plane0Ofs := Lin - $A0000;          { 0..$FFFF dans plan 0 }
  Emu_VidIsVidAddr := EmuVideo.IsGraphic Or (EmuVideo.Mode = 7);
  Exit;
 End;
 If (Lin >= $B8000) And (Lin < $C0000) Then Begin
  Plane0Ofs := Lin - $B8000 + $20000; { plage 'CGA' separee }
  Emu_VidIsVidAddr := True;
  Exit;
 End;
 If (Lin >= $B0000) And (Lin < $B8000) Then Begin
  Plane0Ofs := Lin - $B0000 + $30000; { plage 'MDA/Hercules' }
  Emu_VidIsVidAddr := True;
  Exit;
 End;
End;

{ --- Lire un octet depuis la VRAM unifiee (mode read 0 ou 1).
      MemAddr est l offset 0..$FFFF dans le plan 0 quand IsPlanar.
      Met a jour les 4 latches (read mode 0).                   --- }
Function Emu_VidReadByte(MemOfs: LongInt): Byte;
Var I, ReadPlane, ReadMode: Byte;
    V, Match, NotCare: Byte;
Begin
 Emu_VidReadByte := 0;
 If Not EmuVideo.MemReady Then Exit;
 { Plages CGA et MDA = lineaires simples }
 If (MemOfs >= $20000) And (MemOfs < $40000) Then Begin
  Emu_VidReadByte := EmuVideo.Mem^[MemOfs];
  Exit;
 End;
 If MemOfs < 0 Then Exit;
 If MemOfs >= $10000 Then Exit;
 If EmuVideo.IsPlanar Then Begin
  { Charger les 4 latches a chaque lecture }
  For I := 0 To 3 Do
   EmuVideo.Latch[I] := EmuVideo.Mem^[I * $10000 + MemOfs];
  ReadMode := (EmuVideo.GCReg[5] Shr 3) And 1;
  ReadPlane := EmuVideo.GCReg[4] And 3;
  If ReadMode = 0 Then
   Emu_VidReadByte := EmuVideo.Latch[ReadPlane]
  Else Begin
   { Read mode 1 : color compare }
   V := $FF;
   Match := EmuVideo.GCReg[2] And $0F;
   NotCare := EmuVideo.GCReg[7] And $0F;
   For I := 0 To 3 Do Begin
    If (NotCare And (1 Shl I)) <> 0 Then Continue;
    If (Match And (1 Shl I)) <> 0 Then
     V := V And EmuVideo.Latch[I]
    Else
     V := V And (Not EmuVideo.Latch[I]);
   End;
   Emu_VidReadByte := V;
  End;
 End Else If EmuVideo.ChainFour Then Begin
  { Mode 13h : chain-4 sur plan 0..3 entrelace }
  Emu_VidReadByte := EmuVideo.Mem^[(MemOfs And $FFFC) +
                                    ((MemOfs And 3) * $10000) Shr 2];
  { Implementation simple : on stocke lineaire dans plan 0 }
  Emu_VidReadByte := EmuVideo.Mem^[MemOfs];
 End Else Begin
  Emu_VidReadByte := EmuVideo.Mem^[MemOfs];
 End;
End;

{ --- Operation logique GC : V op Latch (rotation deja appliquee). --- }
Function Emu_VidLogicOp(Op: Byte; V, L: Byte): Byte;
Begin
 Case Op And 3 Of
  0: Emu_VidLogicOp := V;
  1: Emu_VidLogicOp := V And L;
  2: Emu_VidLogicOp := V Or L;
  3: Emu_VidLogicOp := V Xor L;
 End;
End;

{ --- Ecrire un octet dans la VRAM unifiee (write modes 0/1/2/3). --- }
Procedure Emu_VidWriteByte(MemOfs: LongInt; Value: Byte);
Var WriteMode, Plane, PlaneMask, Rot, BitMask: Byte;
    SetReset, EnableSR, LogicOp: Byte;
    I, NewVal, Src: Byte;
Begin
 If Not EmuVideo.MemReady Then Exit;
 Inc(EmuDiag_VidWrCnt);
 If (MemOfs >= $20000) And (MemOfs < $40000) Then Begin
  EmuVideo.Mem^[MemOfs] := Value;
  EmuVideo.GfxDirty := True;
  Exit;
 End;
 If MemOfs < 0 Then Exit;
 If MemOfs >= $10000 Then Exit;
 If Not EmuVideo.IsPlanar Then Begin
  { Mode lineaire (mode 13h ou non-graphique) }
  EmuVideo.Mem^[MemOfs] := Value;
  EmuVideo.GfxDirty := True;
  Exit;
 End;
 { --- Ecriture planar EGA/VGA --- }
 WriteMode := EmuVideo.GCReg[5] And 3;
 PlaneMask := EmuVideo.SeqReg[2] And $0F;
 Rot := EmuVideo.GCReg[3] And 7;
 LogicOp := (EmuVideo.GCReg[3] Shr 3) And 3;
 BitMask := EmuVideo.GCReg[8];
 SetReset := EmuVideo.GCReg[0] And $0F;
 EnableSR := EmuVideo.GCReg[1] And $0F;
 { Rotation a droite }
 If Rot <> 0 Then
  Value := ((Value Shr Rot) Or (Value Shl (8 - Rot))) And $FF;
 Case WriteMode Of
  0: Begin
   For Plane := 0 To 3 Do Begin
    If (PlaneMask And (1 Shl Plane)) = 0 Then Continue;
    If (EnableSR And (1 Shl Plane)) <> 0 Then Begin
     If (SetReset And (1 Shl Plane)) <> 0 Then Src := $FF
     Else Src := 0;
    End Else Src := Value;
    Src := Emu_VidLogicOp(LogicOp, Src, EmuVideo.Latch[Plane]);
    NewVal := (Src And BitMask) Or (EmuVideo.Latch[Plane] And (Not BitMask));
    EmuVideo.Mem^[Plane * $10000 + MemOfs] := NewVal;
   End;
  End;
  1: Begin
   { Recopie des latches, ignore Value }
   For Plane := 0 To 3 Do Begin
    If (PlaneMask And (1 Shl Plane)) = 0 Then Continue;
    EmuVideo.Mem^[Plane * $10000 + MemOfs] := EmuVideo.Latch[Plane];
   End;
  End;
  2: Begin
   For Plane := 0 To 3 Do Begin
    If (PlaneMask And (1 Shl Plane)) = 0 Then Continue;
    If (Value And (1 Shl Plane)) <> 0 Then Src := $FF
    Else Src := 0;
    Src := Emu_VidLogicOp(LogicOp, Src, EmuVideo.Latch[Plane]);
    NewVal := (Src And BitMask) Or (EmuVideo.Latch[Plane] And (Not BitMask));
    EmuVideo.Mem^[Plane * $10000 + MemOfs] := NewVal;
   End;
  End;
  3: Begin
   { Bit mask AND avec Value, set/reset utilise comme valeur }
   For Plane := 0 To 3 Do Begin
    If (PlaneMask And (1 Shl Plane)) = 0 Then Continue;
    If (SetReset And (1 Shl Plane)) <> 0 Then Src := $FF
    Else Src := 0;
    NewVal := (Src And (Value And BitMask)) Or
              (EmuVideo.Latch[Plane] And (Not (Value And BitMask)));
    EmuVideo.Mem^[Plane * $10000 + MemOfs] := NewVal;
   End;
  End;
 End;
 EmuVideo.GfxDirty := True;
End;

{ --- Set/Get pixel d apres le mode video courant. --- }
Procedure Emu_VidSetPixel(X, Y: Integer; Color: Byte);
Var Lin: LongInt;
    Plane, BitPos, Mask: Byte;
    OldByte: Byte;
    I: Byte;
    BankOfs: LongInt;
Begin
 If Not EmuVideo.MemReady Then Exit;
 If Not EmuVideo.IsGraphic Then Exit;
 If (X < 0) Or (Y < 0) Or
    (X >= EmuVideo.Width) Or (Y >= EmuVideo.Height) Then Exit;
 Inc(EmuDiag_PixWrCnt);
 Case EmuVideo.Mode Of
  $04, $05: Begin
   { CGA 320x200x4 : 2 bits par pixel, 80 octets par ligne,
     banque paire = lignes paires a $B8000, impaire a $BA000 }
   If (Y And 1) = 0 Then BankOfs := $20000
   Else BankOfs := $20000 + $2000;
   Lin := BankOfs + (Y Shr 1) * 80 + (X Shr 2);
   BitPos := (3 - (X And 3)) * 2;
   OldByte := EmuVideo.Mem^[Lin];
   Mask := 3 Shl BitPos;
   OldByte := (OldByte And (Not Mask)) Or ((Color And 3) Shl BitPos);
   EmuVideo.Mem^[Lin] := OldByte;
  End;
  $06: Begin
   { CGA 640x200x2 : 1 bit par pixel, 80 octets par ligne }
   If (Y And 1) = 0 Then BankOfs := $20000
   Else BankOfs := $20000 + $2000;
   Lin := BankOfs + (Y Shr 1) * 80 + (X Shr 3);
   BitPos := 7 - (X And 7);
   Mask := 1 Shl BitPos;
   OldByte := EmuVideo.Mem^[Lin];
   If (Color And 1) <> 0 Then OldByte := OldByte Or Mask
   Else OldByte := OldByte And (Not Mask);
   EmuVideo.Mem^[Lin] := OldByte;
  End;
  $0D, $0E, $10, $12: Begin
   { EGA/VGA planar 16 couleurs - une ecriture par plan }
   Lin := Y * (EmuVideo.Width Shr 3) + (X Shr 3);
   BitPos := 7 - (X And 7);
   Mask := 1 Shl BitPos;
   For Plane := 0 To 3 Do Begin
    OldByte := EmuVideo.Mem^[Plane * $10000 + Lin];
    If (Color And (1 Shl Plane)) <> 0 Then
     OldByte := OldByte Or Mask
    Else
     OldByte := OldByte And (Not Mask);
    EmuVideo.Mem^[Plane * $10000 + Lin] := OldByte;
   End;
  End;
  $13: Begin
   { VGA 320x200x256 : 1 octet par pixel, lineaire }
   Lin := Y * 320 + X;
   If Lin < $10000 Then
    EmuVideo.Mem^[Lin] := Color;
  End;
  EMU_MODE_GS640x16: Begin
   { ATI Graphics Solution 640x200x16 couleurs : entrelacement CGA a 4   }
   { bancs de 8192 (au lieu des bancs 2x80 du CGA natif), 2 plans de     }
   { 32 Ko - "Hi" (2 bits de poids fort) a $20000+, "Lo" (2 bits de      }
   { poids faible) a $30000+ (voir Emu_WriteByte pour le brochage des    }
   { segments B800h/B000h). Formules verifiees contre GS640200.PAS       }
   { (RealRawY/RawXv/RawKrLo/RawKrHi) - voir le plan d implementation.   }
   Lin := (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 4);
   BitPos := (3 - (X And 3)) * 2;
   Mask := 3 Shl BitPos;
   OldByte := EmuVideo.Mem^[$30000 + Lin]; { plan "Lo" }
   OldByte := (OldByte And (Not Mask)) Or
    (((Color Shr 1) And 3) Shl BitPos);
   EmuVideo.Mem^[$30000 + Lin] := OldByte;
   OldByte := EmuVideo.Mem^[$20000 + Lin]; { plan "Hi" }
   OldByte := (OldByte And (Not Mask)) Or
    ((((Color And 1) Shl 1) Or ((Color Shr 3) And 1)) Shl BitPos);
   EmuVideo.Mem^[$20000 + Lin] := OldByte;
  End;
  EMU_MODE_GS640x4: Begin
   { ATI Graphics Solution 640x200x4 couleurs - meme timing CRTC (donc    }
   { memes 160 octets/ligne) que le mode 320x200x16 ci-dessous et que le  }
   { plan individuel du mode 640x200x16 ci-dessus ; deduit par analogie   }
   { (confiance moderee, aucune source primaire dediee trouvee - voir le  }
   { plan d implementation) : 1 seul segment B800h, meme entrelacement    }
   { CGA a 4 bancs de 8192. }
   Lin := $20000 + (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 4);
   BitPos := (3 - (X And 3)) * 2;
   Mask := 3 Shl BitPos;
   OldByte := EmuVideo.Mem^[Lin];
   OldByte := (OldByte And (Not Mask)) Or ((Color And 3) Shl BitPos);
   EmuVideo.Mem^[Lin] := OldByte;
  End;
  EMU_MODE_GS320x16: Begin
   { ATI Graphics Solution 320x200x16 couleurs - meme principe (confiance }
   { moderee) : 1 seul segment B800h, 4 bits/pixel empaquetes 2/octet,    }
   { meme entrelacement CGA a 4 bancs de 8192. }
   Lin := $20000 + (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 2);
   BitPos := (1 - (X And 1)) * 4;
   Mask := $F Shl BitPos;
   OldByte := EmuVideo.Mem^[Lin];
   OldByte := (OldByte And (Not Mask)) Or ((Color And $F) Shl BitPos);
   EmuVideo.Mem^[Lin] := OldByte;
  End;
 End;
 EmuVideo.GfxDirty := True;
End;

Function Emu_VidGetPixel(X, Y: Integer): Byte;
Var Lin: LongInt;
    Plane, BitPos: Byte;
    Color: Byte;
    BankOfs: LongInt;
    LoV, HiV: Byte;
Begin
 Emu_VidGetPixel := 0;
 If Not EmuVideo.MemReady Then Exit;
 If Not EmuVideo.IsGraphic Then Exit;
 If (X < 0) Or (Y < 0) Or
    (X >= EmuVideo.Width) Or (Y >= EmuVideo.Height) Then Exit;
 Case EmuVideo.Mode Of
  $04, $05: Begin
   If (Y And 1) = 0 Then BankOfs := $20000
   Else BankOfs := $20000 + $2000;
   Lin := BankOfs + (Y Shr 1) * 80 + (X Shr 2);
   BitPos := (3 - (X And 3)) * 2;
   Emu_VidGetPixel := (EmuVideo.Mem^[Lin] Shr BitPos) And 3;
  End;
  $06: Begin
   If (Y And 1) = 0 Then BankOfs := $20000
   Else BankOfs := $20000 + $2000;
   Lin := BankOfs + (Y Shr 1) * 80 + (X Shr 3);
   BitPos := 7 - (X And 7);
   Emu_VidGetPixel := (EmuVideo.Mem^[Lin] Shr BitPos) And 1;
  End;
  $0D, $0E, $10, $12: Begin
   Lin := Y * (EmuVideo.Width Shr 3) + (X Shr 3);
   BitPos := 7 - (X And 7);
   Color := 0;
   For Plane := 0 To 3 Do Begin
    If ((EmuVideo.Mem^[Plane * $10000 + Lin] Shr BitPos) And 1) <> 0 Then
     Color := Color Or (1 Shl Plane);
   End;
   Emu_VidGetPixel := Color;
  End;
  $13: Begin
   Lin := Y * 320 + X;
   If Lin < $10000 Then
    Emu_VidGetPixel := EmuVideo.Mem^[Lin];
  End;
  EMU_MODE_GS640x16: Begin
   { Meme adressage que Emu_VidSetPixel ci-dessus ; decodage inverse      }
   { verifie algebriquement contre le GetPixel ASM de GS640200.PAS.       }
   Lin := (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 4);
   BitPos := (3 - (X And 3)) * 2;
   LoV := (EmuVideo.Mem^[$30000 + Lin] Shr BitPos) And 3;
   HiV := (EmuVideo.Mem^[$20000 + Lin] Shr BitPos) And 3;
   Emu_VidGetPixel := ((HiV And 1) Shl 3) Or (((LoV Shr 1) And 1) Shl 2) Or
    ((LoV And 1) Shl 1) Or ((HiV Shr 1) And 1);
  End;
  EMU_MODE_GS640x4: Begin
   Lin := $20000 + (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 4);
   BitPos := (3 - (X And 3)) * 2;
   Emu_VidGetPixel := (EmuVideo.Mem^[Lin] Shr BitPos) And 3;
  End;
  EMU_MODE_GS320x16: Begin
   Lin := $20000 + (Y Div 4) * 160 + (Y Mod 4) * 8192 + (X Div 2);
   BitPos := (1 - (X And 1)) * 4;
   Emu_VidGetPixel := (EmuVideo.Mem^[Lin] Shr BitPos) And $F;
  End;
 End;
End;

{ Vrai si la carte configuree (Video 1/2) sait afficher ce mode graphique  }
{ - un BIOS reel de CGA seule n a tout simplement pas les modes EGA/VGA    }
{ dans sa table, donc INT 10h AH=00h avec un tel AL doit etre sans effet.  }
Function Emu_VidModeSupported(Mode: Byte): Boolean;
Begin
 Case Mode Of
  $04, $05, $06: Emu_VidModeSupported := Emu_CGAActive;
  $0D, $0E, $0F, $10: Emu_VidModeSupported := Emu_EGAActive;
  $11, $12, $13: Emu_VidModeSupported := Emu_VGAActive;
 Else
  Emu_VidModeSupported := True; { modes texte de base : toujours dispo }
 End;
End;

{ --- Definir le mode video courant --- }
Procedure Emu_VidSetMode(NewMode: Byte; Var P: TEmulatorPanel);
Begin
 If Not EmuVideo.MemReady Then Emu_VidInit;
 { Carte absente pour ce mode : un vrai BIOS n aurait pas cette entree de }
 { table de modes, INT 10h AH=00h reste donc sans effet (mode inchange). }
 If Not Emu_VidModeSupported(NewMode And $7F) Then Exit;
 EmuVideo.Mode := NewMode And $7F;
 EmuDiag_LastMode := EmuVideo.Mode;
 { Reinitialiser registres de base }
 EmuVideo.IsGraphic := False;
 EmuVideo.IsPlanar := False;
 EmuVideo.ChainFour := False;
 EmuVideo.BitsPerPix := 0;
 EmuVideo.GfxDirty := True;
 Case EmuVideo.Mode Of
  $00, $01: Begin { texte 40x25 16 couleurs }
   EmuVideo.TextCols := 40; EmuVideo.TextRows := 25;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
   P.Cols := 40; P.Rows := 25;
  End;
  $02, $03: Begin { texte 80x25 16 couleurs }
   EmuVideo.TextCols := 80; EmuVideo.TextRows := 25;
   EmuVideo.Width := 720; EmuVideo.Height := 400;
   P.Cols := 80; P.Rows := 25;
  End;
  $04, $05: Begin { CGA 320x200x4 }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 2;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
  End;
  $06: Begin { CGA 640x200x2 }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 1;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
  End;
  $07: Begin { MDA 80x25 monochrome }
   EmuVideo.TextCols := 80; EmuVideo.TextRows := 25;
   EmuVideo.Width := 720; EmuVideo.Height := 350;
   P.Cols := 80; P.Rows := 25;
  End;
  $0D: Begin { EGA 320x200x16 planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
  End;
  $0E: Begin { EGA 640x200x16 planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
  End;
  $0F: Begin { EGA 640x350 mono planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 1;
   EmuVideo.Width := 640; EmuVideo.Height := 350;
  End;
  $10: Begin { EGA 640x350x16 planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 640; EmuVideo.Height := 350;
  End;
  $11: Begin { VGA 640x480x2 planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 1;
   EmuVideo.Width := 640; EmuVideo.Height := 480;
  End;
  $12: Begin { VGA 640x480x16 planar }
   EmuVideo.IsGraphic := True; EmuVideo.IsPlanar := True;
   EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 640; EmuVideo.Height := 480;
  End;
  $13: Begin { VGA 320x200x256 chain-4 }
   EmuVideo.IsGraphic := True; EmuVideo.ChainFour := True;
   EmuVideo.BitsPerPix := 8;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
  End;
 Else
  EmuVideo.TextCols := 80; EmuVideo.TextRows := 25;
  EmuVideo.Width := 720; EmuVideo.Height := 400;
 End;
 { Effacer la memoire video sur changement de mode (sauf bit 7 = no clear) }
 If (NewMode And $80) = 0 Then Begin
  FillChar(EmuVideo.Mem^, SizeOf(EmuVideo.Mem^), 0);
  { Effacer aussi la VRAM texte si on revient en mode texte }
  If Not EmuVideo.IsGraphic Then EmuVScr_Clear(P);
 End;
End;

{ --- Acces aux ports I/O video ---
  Chaque groupe de ports n est lu que si la carte qui l implante sur le
  vrai materiel est effectivement configuree (Options > Emulateur > DOS >
  Video 1/2) : sans cette garde, un programme qui sonde la presence d une
  EGA/VGA (ports $3C0-$3CF) verrait toujours une reponse meme sur une
  configuration CGA seule, ce qui fausserait sa detection de materiel. }
Function Emu_VidPortRead(Port: Word): Byte;
Var V: Byte;
Begin
 Emu_VidPortRead := 0;
 If Not Emu_AnyVideoActive Then Exit;
 Case Port Of
  $3C0: If Emu_EGAActive Then Emu_VidPortRead := EmuVideo.ACIdx;
  $3C1: If Emu_EGAActive And (EmuVideo.ACIdx < 32) Then
   Emu_VidPortRead := EmuVideo.ACReg[EmuVideo.ACIdx];
  $3C4: If Emu_EGAActive Then Emu_VidPortRead := EmuVideo.SeqIdx;
  $3C5: If Emu_EGAActive And (EmuVideo.SeqIdx < 8) Then
   Emu_VidPortRead := EmuVideo.SeqReg[EmuVideo.SeqIdx];
  { DAC couleur ($3C6-$3C9) : materiel VGA uniquement, une EGA n a pas ce }
  { registre (palette fixe 64 couleurs via l Attribute Controller).      }
  $3C6: If Emu_VGAActive Then Emu_VidPortRead := EmuVideo.DACMask;
  $3C7: If Emu_VGAActive Then Emu_VidPortRead := EmuVideo.DACState;
  $3C8: If Emu_VGAActive Then Emu_VidPortRead := EmuVideo.DACWriteIdx Div 3;
  $3C9: If Emu_VGAActive Then Begin
   V := EmuVideo.DAC[EmuVideo.DACReadIdx];
   EmuVideo.DACReadIdx := (EmuVideo.DACReadIdx + 1) Mod 768;
   Emu_VidPortRead := V;
  End;
  $3CC: If Emu_EGAActive Then
   Emu_VidPortRead := $C7; { Misc Output : couleur, 480, sync }
  $3CE: If Emu_EGAActive Then Emu_VidPortRead := EmuVideo.GCIdx;
  $3CF: If Emu_EGAActive And (EmuVideo.GCIdx < 16) Then
   Emu_VidPortRead := EmuVideo.GCReg[EmuVideo.GCIdx];
  { CRTC : commun a toutes les cartes (MDA/CGA/EGA/VGA/ATI GS), aucune   }
  { garde specifique au-dela de "une carte quelconque est presente".    }
  $3D4, $3B4: Emu_VidPortRead := EmuVideo.CRTCIdx;
  $3D5, $3B5:
   If EmuVideo.CRTCIdx < 32 Then
    Emu_VidPortRead := EmuVideo.CRTCReg[EmuVideo.CRTCIdx];
  $3D8: If Emu_CGAActive Or Emu_ATIActive Then
   Emu_VidPortRead := EmuVideo.CGAMode;
  $3D9: If Emu_CGAActive Or Emu_ATIActive Then
   Emu_VidPortRead := EmuVideo.CGAColor;
  $3BA, $3DA: Begin
   { Status register. Bit 3 (VRetrace) est cadence en temps reel par le  }
   { pas CPU (voir boucle principale) et non par la lecture : certains   }
   { logiciels (ex. GSDEMO1.COM) mesurent la frequence du retrace via le }
   { timer BIOS pour detecter le type de moniteur, ce qui echoue si le   }
   { bit ne bascule qu au gre des lectures. Bit 0 (HRetrace) continue de }
   { basculer a chaque lecture pour les boucles anti-neige classiques.   }
   EmuVideo.ACFlipFlop := False;  { reset l'AC flip-flop sur lecture }
   EmuVideo.StatusRetrace := EmuVideo.StatusRetrace Xor 1;
   Emu_VidPortRead := EmuVideo.StatusRetrace Or $06;
  End;
 End;
End;

{ Vrai si au moins un des deux emplacements Video 1/Video 2 porte une      }
{ carte reelle (different de "Aucune", EMU_VID_NONE=21). }
Function Emu_AnyVideoActive: Boolean;
Begin
 Emu_AnyVideoActive := (OptionsDlg.Data.DosVideo1 <> EMU_VID_NONE) Or
  (OptionsDlg.Data.DosVideo2 <> EMU_VID_NONE);
End;

{ VGA et compatibles (index 8 a 20 de DosVideoName). }
Function Emu_VGAActive: Boolean;
Var D1, D2: Integer;
Begin
 D1 := OptionsDlg.Data.DosVideo1;
 D2 := OptionsDlg.Data.DosVideo2;
 Emu_VGAActive := ((D1 >= 8) And (D1 <= 20)) Or ((D2 >= 8) And (D2 <= 20));
End;

{ EGA et compatibles (index 5 a 7). Une VGA est retrocompatible EGA sur le }
{ vrai materiel, donc Emu_VGAActive implique Emu_EGAActive. }
Function Emu_EGAActive: Boolean;
Var D1, D2: Integer;
Begin
 D1 := OptionsDlg.Data.DosVideo1;
 D2 := OptionsDlg.Data.DosVideo2;
 Emu_EGAActive := ((D1 >= 5) And (D1 <= 7)) Or ((D2 >= 5) And (D2 <= 7)) Or
  Emu_VGAActive;
End;

{ CGA et PCjr (index 0 et 4). Une EGA/VGA est retrocompatible CGA sur le   }
{ vrai materiel, donc Emu_EGAActive implique Emu_CGAActive. }
Function Emu_CGAActive: Boolean;
Var D1, D2: Integer;
Begin
 D1 := OptionsDlg.Data.DosVideo1;
 D2 := OptionsDlg.Data.DosVideo2;
 Emu_CGAActive := (D1 = 0) Or (D1 = 4) Or (D2 = 0) Or (D2 = 4) Or
  Emu_EGAActive;
End;

{ La carte "Graphics Solutions d'ATI" (Options > Emulateur > DOS > Video 1/  }
{ Video 2, index 3 de DosVideoName) est active si l un des deux champs     }
{ Video la selectionne. }
Function Emu_ATIActive: Boolean;
Begin
 Emu_ATIActive := (OptionsDlg.Data.DosVideo1 = 3) Or
  (OptionsDlg.Data.DosVideo2 = 3);
End;

{ Detection des modes ATI Graphics Solution par signature de registres -   }
{ cette carte n a PAS de BIOS (confirme par l utilisateur et par           }
{ https://www.gladir.com/LEXIQUE/CARD/graphicssolution.htm) : les          }
{ logiciels d epoque la programment exclusivement par ecriture directe de  }
{ ports, jamais via INT 10h AH=00h. Les 9 sequences exactes viennent de    }
{ https://raw.githubusercontent.com/gladir/GRAPHICSSOLUTIONLIB-TP/main/    }
{ MODES.PAS (verifie octet pres via telechargement direct, pas seulement   }
{ un resume) : chacune ecrit $3DD (avant la boucle CRTC), 16 registres     }
{ CRTC 0-7 (seuls 0-7 varient d un mode a l autre, 8-15 sont communs), et   }
{ eventuellement $3DF (apres). Cette fonction est appelee apres CHAQUE     }
{ ecriture sur $3D5/$3D8/$3D9/$3DD/$3DF (idempotent : tant que la          }
{ sequence n est pas terminee, l etat courant ne correspond a aucune       }
{ signature complete, donc aucun risque a l appeler trop souvent).         }
Procedure Emu_ATIDetectMode;
Var
 Sig: Byte;

 Function CrtcIs(A, B, C, D, E, F, G, H: Byte): Boolean;
 Begin
  CrtcIs := (EmuVideo.CRTCReg[0] = A) And (EmuVideo.CRTCReg[1] = B) And
   (EmuVideo.CRTCReg[2] = C) And (EmuVideo.CRTCReg[3] = D) And
   (EmuVideo.CRTCReg[4] = E) And (EmuVideo.CRTCReg[5] = F) And
   (EmuVideo.CRTCReg[6] = G) And (EmuVideo.CRTCReg[7] = H);
 End;

Begin
 If Not Emu_ATIActive Then Exit;
 Sig := 0;
 { GSTextModeC132x25 / GSEmulTextModeC132x25 : meme CRTC, distinguees par  }
 { la valeur finale de $3DF (90h = couleur, A8h = emulation mono).         }
 If CrtcIs($B5, $84, $97, $0A, $1F, $06, $19, $1C) And
    (EmuVideo.GSExt = 0) Then Begin
  If EmuVideo.GSFeature = $90 Then Sig := 2
  Else If EmuVideo.GSFeature = $A8 Then Sig := 3;
 End
 { GSColors320x200_16Colors / GSColors640x200_4Colors : meme CRTC,         }
 { distinguees par $3DD (10h = 320x16, 20h = 640x4).                       }
 Else If CrtcIs($38, $28, $2D, $0A, $7F, $06, $64, $70) Then Begin
  If EmuVideo.GSExt = $10 Then Sig := 4
  Else If EmuVideo.GSExt = $20 Then Sig := 5;
 End
 Else If CrtcIs($70, $50, $58, $0A, $40, $06, $32, $38) And
    (EmuVideo.GSExt = $80) Then
  Sig := 6
 { GSEmul320x200_16Colors / GSEmul640x200_4Colors : meme CRTC, idem. }
 Else If CrtcIs($36, $28, $2D, $08, $64, $06, $64, $64) And
    (EmuVideo.GSFeature = $A0) Then Begin
  If EmuVideo.GSExt = $10 Then Sig := 7
  Else If EmuVideo.GSExt = $20 Then Sig := 8;
 End
 Else If CrtcIs($61, $50, $52, $08, $32, $06, $32, $32) And
    (EmuVideo.GSExt = $80) And (EmuVideo.GSFeature = $A0) Then
  Sig := 9;
 If (Sig = 0) Or (Sig = EmuVideo.GSLastSig) Then Exit;
 EmuVideo.GSLastSig := Sig;
 EmuVideo.IsGraphic := False;
 EmuVideo.IsPlanar := False;
 EmuVideo.ChainFour := False;
 EmuVideo.GSTxt132Emul := False;
 Case Sig Of
  2, 3: Begin
   EmuVideo.TextCols := 132; EmuVideo.TextRows := 25;
   EmuVideo.Width := 660; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GSTXT132;
   EmuVideo.GSTxt132Emul := (Sig = 3);
   EmuPanel.Cols := 132; EmuPanel.Rows := 25;
  End;
  4: Begin { GSColors320x200_16Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS320x16;
  End;
  5: Begin { GSColors640x200_4Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 2;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS640x4;
  End;
  6: Begin { GSColors640x200_16Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS640x16;
  End;
  7: Begin { GSEmul320x200_16Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 320; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS320x16;
  End;
  8: Begin { GSEmul640x200_4Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 2;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS640x4;
  End;
  9: Begin { GSEmul640x200_16Colors }
   EmuVideo.IsGraphic := True; EmuVideo.BitsPerPix := 4;
   EmuVideo.Width := 640; EmuVideo.Height := 200;
   EmuVideo.Mode := EMU_MODE_GS640x16;
  End;
 End;
 FillChar(EmuVideo.Mem^, SizeOf(EmuVideo.Mem^), 0);
 If Not EmuVideo.IsGraphic Then EmuVScr_Clear(EmuPanel);
 EmuVideo.GfxDirty := True;
 EmuPanel.NeedRepaint := True;
End;

Procedure Emu_VidPortWrite(Port: Word; Value: Byte);
Begin
 If Not Emu_AnyVideoActive Then Exit;
 Case Port Of
  $3C0: If Emu_EGAActive Then Begin
   { AC : flip-flop alterne entre index et data }
   If Not EmuVideo.ACFlipFlop Then
    EmuVideo.ACIdx := Value And $1F
   Else If EmuVideo.ACIdx < 32 Then
    EmuVideo.ACReg[EmuVideo.ACIdx] := Value;
   EmuVideo.ACFlipFlop := Not EmuVideo.ACFlipFlop;
  End;
  $3C2: ; { Misc Output, ignore }
  $3C4: If Emu_EGAActive Then EmuVideo.SeqIdx := Value And 7;
  $3C5: If Emu_EGAActive And (EmuVideo.SeqIdx < 8) Then
   EmuVideo.SeqReg[EmuVideo.SeqIdx] := Value;
  { DAC couleur ($3C6-$3C9) : materiel VGA uniquement. }
  $3C6: If Emu_VGAActive Then EmuVideo.DACMask := Value;
  $3C7: If Emu_VGAActive Then Begin
   EmuVideo.DACReadIdx := (Value And $FF) * 3;
   EmuVideo.DACState := 3;
  End;
  $3C8: If Emu_VGAActive Then Begin
   EmuVideo.DACWriteIdx := (Value And $FF) * 3;
   EmuVideo.DACState := 0;
  End;
  $3C9: If Emu_VGAActive Then Begin
   EmuVideo.DAC[EmuVideo.DACWriteIdx] := Value And $3F;
   EmuVideo.DACWriteIdx := (EmuVideo.DACWriteIdx + 1) Mod 768;
  End;
  $3CE: If Emu_EGAActive Then EmuVideo.GCIdx := Value And $0F;
  $3CF: If Emu_EGAActive And (EmuVideo.GCIdx < 16) Then
   EmuVideo.GCReg[EmuVideo.GCIdx] := Value;
  { CRTC : commun a toutes les cartes, aucune garde specifique au-dela de }
  { "une carte quelconque est presente" (deja verifie plus haut). }
  $3D4, $3B4: EmuVideo.CRTCIdx := Value And $1F;
  $3D5, $3B5: Begin
   If EmuVideo.CRTCIdx < 32 Then
    EmuVideo.CRTCReg[EmuVideo.CRTCIdx] := Value;
   Emu_ATIDetectMode;
  End;
  $3D8: If Emu_CGAActive Or Emu_ATIActive Then Begin
   EmuVideo.CGAMode := Value; Emu_ATIDetectMode;
  End;
  $3D9: If Emu_CGAActive Or Emu_ATIActive Then Begin
   EmuVideo.CGAColor := Value; Emu_ATIDetectMode;
  End;
  { $3DD/$3DF : registres etendus ATI Graphics Solution, ignores par tout  }
  { autre materiel (aucune carte standard n y repond) - donc n existent    }
  { que si Video 1/2 pointe reellement sur cette carte. }
  $3DD: If Emu_ATIActive Then Begin
   EmuVideo.GSExt := Value; Emu_ATIDetectMode;
  End;
  $3DF: If Emu_ATIActive Then Begin
   EmuVideo.GSFeature := Value; Emu_ATIDetectMode;
  End;
 End;
End;

{ --- CMOS RAM/RTC (type MC146818, comme un AT) : les registres 00h-09h }
{ (horloge/date) sont calcules a la volee depuis l horloge hote (BCD,   }
{ le mode par defaut d un vrai AT) ; 0Ah-3Fh sont de la RAM generale    }
{ conservee dans EmuCMOS_Reg (initialisee par Emu_CMOSInit). Les ports  }
{ d acces dependent du Materiel choisi dans Options > Emulateur > DOS : }
{ 70h/71h partout, SAUF pour l Amdek System/88 qui a le meme CMOS "de   }
{ type AT" mais sur des ports differents (E0h/E1h) - voir               }
{ https://www.gladir.com/LEXIQUE/PORTS/00e0to00e1.htm et                }
{ https://www.gladir.com/LEXIQUE/SYSTEM/amdeksystem88.htm.              }
Function Emu_BCD(V: Byte): Byte;
Begin
 Emu_BCD := ((V Div 10) Shl 4) Or (V Mod 10);
End;

Procedure Emu_CMOSInit;
Begin
 FillChar(EmuCMOS_Reg, SizeOf(EmuCMOS_Reg), 0);
 EmuCMOS_Index := 0;
 EmuCMOS_Reg[$0A] := $26; { Registre A : frequences par defaut }
 EmuCMOS_Reg[$0B] := $02; { Registre B : format 24h, mode BCD }
 EmuCMOS_Reg[$0D] := $80; { Registre D : pile CMOS valide (VRT) }
 EmuCMOS_Reg[$10] := $40; { Type lecteurs disquette : A: 1,44 Mo }
 EmuCMOS_Reg[$14] := $2D; { Octet d equipement : disquette, VGA, 2 ports }
 EmuCMOS_Reg[$15] := $80; { Memoire conventionnelle 640 Ko, octet bas }
 EmuCMOS_Reg[$16] := $02; { Memoire conventionnelle 640 Ko, octet haut }
End;

{ Determine les deux ports d acces au CMOS (index/donnees) selon le     }
{ materiel emule actuellement selectionne. }
Procedure Emu_CMOSPorts(Var IdxPort, DataPort: Word);
Begin
 If OptionsDlg.Data.DosHardware = 4 Then Begin { Amdek System/88 }
  IdxPort := $E0;
  DataPort := $E1;
 End Else Begin
  IdxPort := $70;
  DataPort := $71;
 End;
End;

Function Emu_CMOS_ReadReg(Reg: Byte): Byte;
Var
 Yr, Mo, Dy, Wd: Word;
 Hr, Mn, Sc, Cs: Word;
Begin
 Case Reg Of
  $00: Begin GetTime(Hr, Mn, Sc, Cs); Emu_CMOS_ReadReg := Emu_BCD(Sc); End;
  $02: Begin GetTime(Hr, Mn, Sc, Cs); Emu_CMOS_ReadReg := Emu_BCD(Mn); End;
  $04: Begin GetTime(Hr, Mn, Sc, Cs); Emu_CMOS_ReadReg := Emu_BCD(Hr); End;
  $06: Begin GetDate(Yr, Mo, Dy, Wd); Emu_CMOS_ReadReg := Wd + 1; End;
  $07: Begin GetDate(Yr, Mo, Dy, Wd); Emu_CMOS_ReadReg := Emu_BCD(Dy); End;
  $08: Begin GetDate(Yr, Mo, Dy, Wd); Emu_CMOS_ReadReg := Emu_BCD(Mo); End;
  $09: Begin GetDate(Yr, Mo, Dy, Wd); Emu_CMOS_ReadReg := Emu_BCD(Yr Mod 100); End;
  { Registre A : bit7 (UIP) toujours a 0 - jamais "en cours de mise a jour" }
  $0A: Emu_CMOS_ReadReg := EmuCMOS_Reg[$0A] And $7F;
  { Registre D : bit7 (VRT) toujours a 1 - pile CMOS toujours valide }
  $0D: Emu_CMOS_ReadReg := EmuCMOS_Reg[$0D] Or $80;
  Else Emu_CMOS_ReadReg := EmuCMOS_Reg[Reg];
 End;
End;

Procedure Emu_CMOS_WriteReg(Reg: Byte; Value: Byte);
Begin
 { 00h-09h (horloge/alarme) : lecture seule - l heure emulee vient de    }
 { l horloge hote, on ne simule pas le reglage de l heure/alarme. }
 If Reg > $09 Then EmuCMOS_Reg[Reg] := Value;
End;

{ Vrai si le materiel emule actuellement choisi (Options > Emulateur > DOS:  }
{ Materiel) est de classe AT ou plus recent (second 8259A esclave present,   }
{ contoleur clavier 8042 au lieu du decodage incomplet 8255 sur 60h-6Fh).    }
{ Simplification assumee : seuls AT/PS2/Compaq Deskpro 386 (386, bus AT)     }
{ sont consideres AT+ ; tous les autres profils (PC 5150, XT, Amdek, Tandy,  }
{ Olivetti M24, Zenith Z-150, NCR PC4i, PCjr) sont traites comme classe      }
{ PC/XT (8255A simple, un seul 8259A, ports 210h-215h). }
Function Emu_IsATClassHw: Boolean;
Begin
 Case OptionsDlg.Data.DosHardware Of
  2, 3, 6: Emu_IsATClassHw := True;
 Else
  Emu_IsATClassHw := False;
 End;
End;

{ ============================================================
  Interface de disque (Options > Emulateur > DOS: Materiel > Interface de
  disque) - voir DosDiskInterfaceName, TEmuST506/TEmuATAChannel/
  TEmuSCSIHostAdapter. Emu_DiskIfFamily regroupe les 13 entrees
  choisissables en 3 protocoles materiels reels + 1 cas "aucun port"
  (NVMe/PCIe), garantissant qu une seule famille de ports repond a la
  fois (pas de "melange" possible - le materiel reel ne melange jamais
  deux protocoles de controleur de disque sur les memes ports). Chaque
  famille est developpee plus bas dans sa propre section.
  ============================================================ }
Const
 DIF_ST506 = 0;
 DIF_ATA   = 1;
 DIF_SCSI  = 2;
 DIF_NONE  = 3;

Function Emu_DiskIfFamily: Integer;
Begin
 Case OptionsDlg.Data.DosDiskInterface Of
  0, 1: Emu_DiskIfFamily := DIF_ST506;    { ST-506/ST-412 (MFM), RLL }
  3, 4, 11: Emu_DiskIfFamily := DIF_SCSI; { SASI, SCSI, SAS }
  12: Emu_DiskIfFamily := DIF_NONE;       { NVMe/PCIe : aucun port ISA reel }
 Else
  Emu_DiskIfFamily := DIF_ATA;            { ESDI,IDE,EIDE,ATAPI,UDMA,PATA,SATA }
 End;
End;

{ Capacites qui varient A L INTERIEUR de la famille ATA - chacune reflete }
{ une difference reelle et documentee entre generations, pas une          }
{ simplification arbitraire (voir le commentaire de TEmuATAChannel). }
Function Emu_ATA_SupportsMulti: Boolean;   { READ/WRITE MULTIPLE, EIDE+ }
Begin
 Case OptionsDlg.Data.DosDiskInterface Of
  6, 7, 8, 9, 10: Emu_ATA_SupportsMulti := True;
 Else
  Emu_ATA_SupportsMulti := False;
 End;
End;

Function Emu_ATA_SupportsLBA48: Boolean;   { PATA/SATA (derniere generation parallele/serie) }
Begin
 Emu_ATA_SupportsLBA48 :=
  (OptionsDlg.Data.DosDiskInterface = 9) Or (OptionsDlg.Data.DosDiskInterface = 10);
End;

Function Emu_ATA_IsPacketDevice: Boolean;  { ATAPI }
Begin
 Emu_ATA_IsPacketDevice := OptionsDlg.Data.DosDiskInterface = 7;
End;

{ INT13h etendu (AH=41h-49h, EDD) disponible - pas sur les generations     }
{ anterieures a la normalisation EDD (1996) : ST-506/RLL/ESDI/SASI/IDE     }
{ simple n en ont jamais eu besoin ni benefice dans leur epoque reelle.    }
Function Emu_DiskIfSupportsEDD: Boolean;
Begin
 Case OptionsDlg.Data.DosDiskInterface Of
  4, 5, 6, 7, 8, 9, 10, 11, 12: Emu_DiskIfSupportsEDD := True; { SCSI,IDE/EIDE+,SAS,NVMe }
 Else
  Emu_DiskIfSupportsEDD := False;
 End;
End;

{ ============================================================
  Famille A : ST-506/ST-412 (MFM) et RLL - ports 320h-323h. Voir le
  commentaire de TEmuST506 pour la justification du protocole. Deux
  unites possibles (0=maitre->EmuFloppy 2/C:, 1=esclave->EmuFloppy 3/D:),
  selectionnees par les bits 7-5 du 1er octet du bloc de commande.
  ============================================================ }

Procedure Emu_ST506_Complete(Var S: TEmuST506; ResultCode: Byte);
Begin
 S.ResultByte := ResultCode;
 S.Phase := 4; { STATUS_READY }
End;

Procedure Emu_ST506_Exec(Var S: TEmuST506);
Var
 Cmd, Head, Drive, Sect, Cnt: Byte; Cyl: Word; LBA: LongInt; U: Integer;
Begin
 Drive := (S.CmdBuf[0] Shr 5) And 1;
 Cmd   := S.CmdBuf[0] And $1F;
 Head  := S.CmdBuf[1] And $1F;
 Cyl   := Word(S.CmdBuf[2]) Or (Word(S.CmdBuf[1] And $E0) Shl 3);
 Sect  := S.CmdBuf[3];
 Cnt   := S.CmdBuf[4];
 If Cnt = 0 Then Cnt := 1;
 If Drive = 0 Then U := 2 Else U := 3;
 If Not EmuFloppyOpen[U] Then Begin
  Emu_ST506_Complete(S, $04); { unite non prete }
  Exit;
 End;
 LBA := Emu_FloppyCHS2LBA(U, Cyl, Head, Sect);
 S.PendingUnit := U;
 S.PendingLBA := LBA;
 Case Cmd Of
  0: Emu_ST506_Complete(S, 0);   { Test Drive Ready }
  1: Emu_ST506_Complete(S, 0);   { Recalibrate }
  8: Begin { Read }
   If (LBA < 0) Or Not Emu_ImageReadSector(U, LBA, S.DataBuf) Then Begin
    Emu_ST506_Complete(S, $11); { donnees irrecuperables }
    Exit;
   End;
   S.DataPos := 0; S.Phase := 2; { DATA_OUT }
  End;
  $0A: Begin { Write }
   If (LBA < 0) Or EmuFloppyRO[U] Then Begin
    Emu_ST506_Complete(S, $03); { defaut d ecriture }
    Exit;
   End;
   FillChar(S.DataBuf, SizeOf(S.DataBuf), 0);
   S.DataPos := 0; S.Phase := 3; { DATA_IN }
  End;
  $0B: Emu_ST506_Complete(S, 0); { Seek }
  $0C: Emu_ST506_Complete(S, 0); { Initialize }
 Else
  Emu_ST506_Complete(S, $20);    { commande invalide }
 End;
End;

Function Emu_ST506_ReadStatus(Var S: TEmuST506): Byte;
Begin
 { bit0=BSY,bit1=REQ,bit2=CD (1=commande/statut,0=donnees),bit3=IO
   (1=controleur->hote). Forme fidele au controleur d origine (voir
   TEmuST506) meme si les valeurs precises ne sont pas garanties
   identiques a une puce reelle - protocole interne coherent. }
 Case S.Phase Of
  2: Emu_ST506_ReadStatus := $0A; { DATA_OUT : REQ+IO }
  3: Emu_ST506_ReadStatus := $02; { DATA_IN : REQ }
  4: Emu_ST506_ReadStatus := $0E; { STATUS_READY : REQ+CD+IO }
 Else
  Emu_ST506_ReadStatus := $06;    { IDLE/CMD_RECEIVING : REQ+CD }
 End;
End;

Function Emu_ST506_ReadData(Var S: TEmuST506): Byte;
Begin
 Emu_ST506_ReadData := 0;
 Case S.Phase Of
  2: Begin
   If S.DataPos < 512 Then Begin
    Emu_ST506_ReadData := S.DataBuf[S.DataPos];
    Inc(S.DataPos);
    If S.DataPos >= 512 Then Emu_ST506_Complete(S, 0);
   End;
  End;
  4: Begin
   Emu_ST506_ReadData := S.ResultByte;
   S.Phase := 0; { la lecture du statut cloture la transaction }
  End;
 End;
End;

Procedure Emu_ST506_WriteData(Var S: TEmuST506; Value: Byte);
Begin
 Case S.Phase Of
  0: Begin
   S.CmdBuf[0] := Value; S.CmdLen := 1; S.Phase := 1;
  End;
  1: Begin
   If S.CmdLen < 6 Then Begin
    S.CmdBuf[S.CmdLen] := Value; Inc(S.CmdLen);
   End;
   If S.CmdLen >= 6 Then Emu_ST506_Exec(S);
  End;
  3: Begin
   If S.DataPos < 512 Then Begin
    S.DataBuf[S.DataPos] := Value; Inc(S.DataPos);
   End;
   If S.DataPos >= 512 Then Begin
    If Emu_ImageWriteSector(S.PendingUnit, S.PendingLBA, S.DataBuf) Then
     Emu_ST506_Complete(S, 0)
    Else
     Emu_ST506_Complete(S, $03);
   End;
  End;
 End;
End;

{ ============================================================
  Famille B : ESDI/IDE/EIDE/ATAPI/UDMA/PATA/SATA - protocole task-file ATA
  reel (canal 0=primaire 1F0h-1F7h/3F6h, canal 1=secondaire 170h-177h/
  376h). Voir le commentaire de TEmuATAChannel.
  ============================================================ }

Function Emu_ATA_UnitForChannel(Ch: Integer): Integer;
Begin
 If Ch = 0 Then Emu_ATA_UnitForChannel := 2 Else Emu_ATA_UnitForChannel := 3;
End;

Procedure Emu_ATA_SetSignature(Var C: TEmuATAChannel);
Begin
 { Signature ATA standard post-RESET (pas de peripherique ATAPI) }
 C.SectorCnt := 1; C.SectorNum := 1; C.CylLo := 0; C.CylHi := 0;
End;

Procedure Emu_ATA_Init(Var C: TEmuATAChannel; ChIdx: Integer);
Begin
 FillChar(C, SizeOf(C), 0);
 C.CmdUnit := Emu_ATA_UnitForChannel(ChIdx);
 If Not EmuFloppyOpen[C.CmdUnit] Then C.CmdUnit := -1;
 Emu_ATA_SetSignature(C);
 C.Status := $50; { DRDY+DSC }
 C.MultiCount := 1;
End;

Procedure Emu_ATA_Complete(Var C: TEmuATAChannel; Ok: Boolean; ErrByte: Byte);
Begin
 C.PioActive := False;
 If Ok Then Begin
  C.Status := $50;
  C.ErrFeat := 0;
 End Else Begin
  C.Status := $41; { DRDY+ERR }
  C.ErrFeat := ErrByte;
 End;
End;

{ LBA a partir des registres task-file courants (CHS, LBA28 ou LBA48).
  Simplification assumee et documentee : un compte de secteurs egal a 0
  vaut 256 dans TOUS les cas (le vrai LBA48 autoriserait 65536, au-dela de
  ce qu un test realiste sur cet emulateur exercerait). }
Function Emu_ATA_ComputeLBA(Var C: TEmuATAChannel; Var Cnt: Word): LongInt;
Var LBA: LongInt; Cyl, Head, Sect: Word;
Begin
 LBA := -1;
 If (C.DriveHead And $40) <> 0 Then Begin { mode LBA }
  If Emu_ATA_SupportsLBA48 And
     ((C.SectorCntHi <> 0) Or (C.SectorNumHi <> 0) Or (C.CylLoHi <> 0) Or (C.CylHiHi <> 0)) Then Begin
   LBA := LongInt(C.SectorNum) Or (LongInt(C.CylLo) Shl 8) Or (LongInt(C.CylHi) Shl 16) Or
    (LongInt(C.SectorNumHi) Shl 24);
   Cnt := C.SectorCnt;
  End Else Begin
   LBA := LongInt(C.SectorNum) Or (LongInt(C.CylLo) Shl 8) Or
    (LongInt(C.CylHi) Shl 16) Or (LongInt(C.DriveHead And $0F) Shl 24);
   Cnt := C.SectorCnt;
  End;
 End Else Begin { mode CHS }
  Cyl := Word(C.CylLo) Or (Word(C.CylHi) Shl 8);
  Head := C.DriveHead And $0F;
  Sect := C.SectorNum;
  If C.CmdUnit >= 0 Then LBA := Emu_FloppyCHS2LBA(C.CmdUnit, Cyl, Head, Sect);
  Cnt := C.SectorCnt;
 End;
 If Cnt = 0 Then Cnt := 256;
 Emu_ATA_ComputeLBA := LBA;
End;

{ Structure IDENTIFY DEVICE (256 mots) - champs les plus couramment lus   }
{ par MSDOS/pilotes de l epoque (modele, geometrie CHS, bit LBA, nb total }
{ de secteurs adressables, bits de capacite specifiques a la generation). }
Procedure Emu_ATA_FillIdentify(Var C: TEmuATAChannel);
Var TotalSectors: LongInt; Model: String;

 Procedure PutWord(WordIdx: Integer; V: Word);
 Begin
  C.PioBuf[WordIdx * 2]     := Lo(V);
  C.PioBuf[WordIdx * 2 + 1] := Hi(V);
 End;

 Procedure PutStringSwapped(WordStart, WordCount: Integer; Const S: String);
 Var K: Integer; Ch1, Ch2: Byte;
 Begin
  For K := 0 To WordCount - 1 Do Begin
   If K * 2 + 1 <= Length(S) Then Ch1 := Ord(S[K * 2 + 1]) Else Ch1 := Ord(' ');
   If K * 2 + 2 <= Length(S) Then Ch2 := Ord(S[K * 2 + 2]) Else Ch2 := Ord(' ');
   C.PioBuf[(WordStart + K) * 2]     := Ch2;
   C.PioBuf[(WordStart + K) * 2 + 1] := Ch1;
  End;
 End;

Begin
 FillChar(C.PioBuf, SizeOf(C.PioBuf), 0);
 If C.CmdUnit >= 0 Then
  TotalSectors := LongInt(EmuFloppyCyls[C.CmdUnit]) * EmuFloppyHeads[C.CmdUnit] * EmuFloppySpt[C.CmdUnit]
 Else
  TotalSectors := 0;
 PutWord(0, $0040); { disque fixe non amovible }
 If C.CmdUnit >= 0 Then Begin
  PutWord(1, EmuFloppyCyls[C.CmdUnit]);
  PutWord(3, EmuFloppyHeads[C.CmdUnit]);
  PutWord(6, EmuFloppySpt[C.CmdUnit]);
 End;
 Case OptionsDlg.Data.DosDiskInterface Of
  2:  Model := 'DEV-COOLS ESDI EMULATED DRIVE';
  5:  Model := 'DEV-COOLS IDE/ATA EMULATED DRIVE';
  6:  Model := 'DEV-COOLS EIDE/ATA-2 EMULATED DRIVE';
  7:  Model := 'DEV-COOLS ATAPI EMULATED DRIVE';
  8:  Model := 'DEV-COOLS ULTRA ATA/UDMA EMULATED DRIVE';
  9:  Model := 'DEV-COOLS PATA EMULATED DRIVE';
  10: Model := 'DEV-COOLS SATA EMULATED DRIVE';
 Else
  Model := 'DEV-COOLS ATA EMULATED DRIVE';
 End;
 PutStringSwapped(27, 20, Model);
 PutWord(49, $0200); { bit9 : LBA supportee }
 If Emu_ATA_SupportsMulti Then PutWord(47, $8000 Or C.MultiCount);
 If Emu_ATA_SupportsLBA48 Then PutWord(83, $0400); { bit10 : LBA48 supportee }
 PutWord(60, Word(TotalSectors)); PutWord(61, Word(TotalSectors Shr 16));
 If (OptionsDlg.Data.DosDiskInterface = 8) Or (OptionsDlg.Data.DosDiskInterface = 9) Or
    (OptionsDlg.Data.DosDiskInterface = 10) Then
  PutWord(88, $2007); { modes UDMA supportes, informatif }
End;

Procedure Emu_ATA_ProcessPacket(Var C: TEmuATAChannel); Forward;

Procedure Emu_ATA_ExecCommand(Var C: TEmuATAChannel; Cmd: Byte);
Var LBA: LongInt; Cnt: Word;
Begin
 C.PacketPending := False;
 Case Cmd Of
  $10..$1F: Emu_ATA_Complete(C, True, 0); { RECALIBRATE (+variantes) }
  $20, $21, $24: Begin { READ SECTOR(S) [EXT] }
   If (Cmd = $24) And Not Emu_ATA_SupportsLBA48 Then Begin
    Emu_ATA_Complete(C, False, $04); Exit;
   End;
   LBA := Emu_ATA_ComputeLBA(C, Cnt);
   If (C.CmdUnit < 0) Or (LBA < 0) Then Begin
    Emu_ATA_Complete(C, False, $10); Exit; { ID Not Found }
   End;
   If Not Emu_ImageReadSector(C.CmdUnit, LBA, C.PioBuf) Then Begin
    Emu_ATA_Complete(C, False, $40); Exit; { Uncorrectable }
   End;
   C.CmdLBA := LBA; C.CmdSectorsLeft := Cnt; C.PioIsWrite := False;
   C.PioLen := 512; C.PioPos := 0; C.PioActive := True;
   C.Status := $58; { DRDY+DRQ+DSC }
  End;
  $30, $31, $34: Begin { WRITE SECTOR(S) [EXT] }
   If (Cmd = $34) And Not Emu_ATA_SupportsLBA48 Then Begin
    Emu_ATA_Complete(C, False, $04); Exit;
   End;
   LBA := Emu_ATA_ComputeLBA(C, Cnt);
   If (C.CmdUnit < 0) Or (LBA < 0) Or EmuFloppyRO[C.CmdUnit] Then Begin
    Emu_ATA_Complete(C, False, $10); Exit;
   End;
   C.CmdLBA := LBA; C.CmdSectorsLeft := Cnt; C.PioIsWrite := True;
   FillChar(C.PioBuf, SizeOf(C.PioBuf), 0);
   C.PioLen := 512; C.PioPos := 0; C.PioActive := True;
   C.Status := $58;
  End;
  $C4: Begin { READ MULTIPLE }
   If Not Emu_ATA_SupportsMulti Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   Emu_ATA_ExecCommand(C, $20);
  End;
  $C5: Begin { WRITE MULTIPLE }
   If Not Emu_ATA_SupportsMulti Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   Emu_ATA_ExecCommand(C, $30);
  End;
  $C6: Begin { SET MULTIPLE MODE }
   If Not Emu_ATA_SupportsMulti Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   C.MultiCount := C.SectorCnt;
   Emu_ATA_Complete(C, True, 0);
  End;
  $90, $91: Emu_ATA_Complete(C, True, 0); { DEVICE DIAGNOSTIC / INIT DEVICE PARAMETERS }
  $EC: Begin { IDENTIFY DEVICE }
   If Emu_ATA_IsPacketDevice Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   Emu_ATA_FillIdentify(C);
   C.PioLen := 512; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := False;
   C.Status := $58;
  End;
  $A1: Begin { IDENTIFY PACKET DEVICE }
   If Not Emu_ATA_IsPacketDevice Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   Emu_ATA_FillIdentify(C);
   C.PioLen := 512; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := False;
   C.Status := $58;
  End;
  $A0: Begin { PACKET }
   If Not Emu_ATA_IsPacketDevice Then Begin Emu_ATA_Complete(C, False, $04); Exit; End;
   C.PacketPending := True;
   C.PioLen := 12; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := True;
   C.Status := $58;
  End;
  $E0, $E1, $E7: Emu_ATA_Complete(C, True, 0); { STANDBY/IDLE/FLUSH CACHE }
 Else
  Emu_ATA_Complete(C, False, $04); { ABRT : commande non geree }
 End;
End;

{ Interprete un paquet ATAPI de 12 octets recu via PIO comme un CDB SCSI  }
{ minimal (memes commandes que la famille SCSI generique ci-dessous) -    }
{ suffisant pour qu un pilote CD-ROM/disque ATAPI detecte et utilise      }
{ l unite. }
Procedure Emu_ATA_ProcessPacket(Var C: TEmuATAChannel);
Var Op: Byte; LBA: LongInt;
Begin
 Op := C.PioBuf[0];
 Case Op Of
  $00: Emu_ATA_Complete(C, True, 0); { TEST UNIT READY }
  $12: Begin { INQUIRY }
   FillChar(C.PioBuf, SizeOf(C.PioBuf), 0);
   C.PioBuf[0] := $05; { type peripherique : CD-ROM }
   C.PioBuf[1] := $80; { amovible }
   C.PioBuf[2] := $02;
   C.PioBuf[4] := 31;
   Move('DEV-COOLS ATAPI CDROM          '[1], C.PioBuf[8], 28);
   C.PioLen := 36; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := False;
   C.Status := $58;
  End;
  $25: Begin { READ CAPACITY }
   FillChar(C.PioBuf, SizeOf(C.PioBuf), 0);
   If C.CmdUnit >= 0 Then
    LBA := LongInt(EmuFloppyCyls[C.CmdUnit]) * EmuFloppyHeads[C.CmdUnit] * EmuFloppySpt[C.CmdUnit] - 1
   Else
    LBA := 0;
   C.PioBuf[0] := Byte(LBA Shr 24); C.PioBuf[1] := Byte(LBA Shr 16);
   C.PioBuf[2] := Byte(LBA Shr 8);  C.PioBuf[3] := Byte(LBA);
   C.PioBuf[6] := 2; { 512 octets/bloc }
   C.PioLen := 8; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := False;
   C.Status := $58;
  End;
  $28: Begin { READ(10) }
   LBA := (LongInt(C.PioBuf[2]) Shl 24) Or (LongInt(C.PioBuf[3]) Shl 16) Or
    (LongInt(C.PioBuf[4]) Shl 8) Or LongInt(C.PioBuf[5]);
   If (C.CmdUnit < 0) Or Not Emu_ImageReadSector(C.CmdUnit, LBA, C.PioBuf) Then Begin
    Emu_ATA_Complete(C, False, $04); Exit;
   End;
   C.PioLen := 512; C.PioPos := 0; C.PioActive := True; C.PioIsWrite := False;
   C.Status := $58;
  End;
 Else
  Emu_ATA_Complete(C, False, $04);
 End;
End;

Function Emu_ATA_ReadReg(Var C: TEmuATAChannel; RegIdx: Integer): Byte;
Var B: Byte;
Begin
 Emu_ATA_ReadReg := 0;
 Case RegIdx Of
  0: Begin { Data }
   If C.PioActive And Not C.PioIsWrite And (C.PioPos < C.PioLen) Then Begin
    B := C.PioBuf[C.PioPos]; Inc(C.PioPos);
    Emu_ATA_ReadReg := B;
    If C.PioPos >= C.PioLen Then Begin
     C.PioActive := False;
     Dec(C.CmdSectorsLeft);
     If (C.CmdSectorsLeft > 0) And (C.CmdUnit >= 0) Then Begin
      Inc(C.CmdLBA);
      If Emu_ImageReadSector(C.CmdUnit, C.CmdLBA, C.PioBuf) Then Begin
       C.PioLen := 512; C.PioPos := 0; C.PioActive := True;
       C.Status := $58;
      End Else
       Emu_ATA_Complete(C, False, $40);
     End Else
      Emu_ATA_Complete(C, True, 0);
    End;
   End;
  End;
  1: Emu_ATA_ReadReg := C.ErrFeat;
  2: Emu_ATA_ReadReg := C.SectorCnt;
  3: Emu_ATA_ReadReg := C.SectorNum;
  4: Emu_ATA_ReadReg := C.CylLo;
  5: Emu_ATA_ReadReg := C.CylHi;
  6: Emu_ATA_ReadReg := C.DriveHead Or $A0; { bits 7/5 toujours a 1 sur le vrai materiel }
  7: Emu_ATA_ReadReg := C.Status;
 End;
End;

Procedure Emu_ATA_WriteReg(Var C: TEmuATAChannel; RegIdx: Integer; Value: Byte);
Begin
 Case RegIdx Of
  0: Begin { Data }
   If C.PioActive And C.PioIsWrite And (C.PioPos < C.PioLen) Then Begin
    C.PioBuf[C.PioPos] := Value; Inc(C.PioPos);
    If C.PioPos >= C.PioLen Then Begin
     C.PioActive := False;
     If C.PacketPending Then Begin
      C.PacketPending := False;
      Emu_ATA_ProcessPacket(C);
     End Else Begin
      If (C.CmdUnit < 0) Or Not Emu_ImageWriteSector(C.CmdUnit, C.CmdLBA, C.PioBuf) Then Begin
       Emu_ATA_Complete(C, False, $40); Exit;
      End;
      Dec(C.CmdSectorsLeft);
      If C.CmdSectorsLeft > 0 Then Begin
       Inc(C.CmdLBA);
       FillChar(C.PioBuf, SizeOf(C.PioBuf), 0);
       C.PioLen := 512; C.PioPos := 0; C.PioActive := True;
       C.Status := $58;
      End Else
       Emu_ATA_Complete(C, True, 0);
     End;
    End;
   End;
  End;
  1: C.ErrFeat := Value;
  { Registres 2-5 : mecanisme HOB reel (LBA48) - chaque ecriture pousse   }
  { l ancienne valeur "courante" dans le registre "haut" (Hi) avant de    }
  { stocker la nouvelle - apres 2 ecritures, la 1ere est dans *Hi, la 2e  }
  { (la plus recente) est la valeur courante. }
  2: Begin C.SectorCntHi := C.SectorCnt; C.SectorCnt := Value; End;
  3: Begin C.SectorNumHi := C.SectorNum; C.SectorNum := Value; End;
  4: Begin C.CylLoHi := C.CylLo; C.CylLo := Value; End;
  5: Begin C.CylHiHi := C.CylHi; C.CylHi := Value; End;
  6: C.DriveHead := Value;
  7: Emu_ATA_ExecCommand(C, Value); { Command register }
 End;
End;

Function Emu_ATA_ReadAltStatus(Var C: TEmuATAChannel): Byte;
Begin
 Emu_ATA_ReadAltStatus := C.Status; { pas d effet de bord simule (pas d IRQ a acquitter) }
End;

Procedure Emu_ATA_WriteDevCtrl(Var C: TEmuATAChannel; Value: Byte);
Begin
 C.DevCtrl := Value;
 If (Value And $04) <> 0 Then Begin { SRST : reinitialisation logicielle }
  Emu_ATA_SetSignature(C);
  C.Status := $50;
  C.PioActive := False;
  C.PacketPending := False;
 End;
End;

{ ============================================================
  Famille C : SASI/SCSI/SAS - protocole hote registre-a-registre (330h-
  333h) construit sur des Command Descriptor Blocks SCSI standard. Voir
  le commentaire de TEmuSCSIHostAdapter. Une seule unite emulee (EmuFloppy
  2, "disque dur" C:), comme un adaptateur hote SCSI simple a un seul
  peripherique connecte.
  ============================================================ }

Function Emu_SCSI_UnitOpen: Boolean;
Begin
 Emu_SCSI_UnitOpen := EmuFloppyOpen[2];
End;

Procedure Emu_SCSI_Complete(Var S: TEmuSCSIHostAdapter; StatusByte: Byte);
Begin
 S.StatusByte := StatusByte;
 S.Phase := 4; { STATUS_READY }
End;

Procedure Emu_SCSI_Exec(Var S: TEmuSCSIHostAdapter);
Var Op: Byte; LBA: LongInt;
Begin
 Op := S.CDB[0];
 Case Op Of
  $00: Emu_SCSI_Complete(S, 0); { TEST UNIT READY }
  $12: Begin { INQUIRY }
   FillChar(S.DataBuf, SizeOf(S.DataBuf), 0);
   S.DataBuf[0] := 0; { disque direct-access }
   S.DataBuf[2] := 2; { ANSI SCSI-2 }
   S.DataBuf[4] := 31;
   Move('DEV-COOLS SCSI DISK             '[1], S.DataBuf[8], 28);
   S.DataLen := 36; S.DataPos := 0; S.Phase := 2; { DATA_IN cote hote }
  End;
  $25: Begin { READ CAPACITY(10) }
   FillChar(S.DataBuf, SizeOf(S.DataBuf), 0);
   If Emu_SCSI_UnitOpen Then
    LBA := LongInt(EmuFloppyCyls[2]) * EmuFloppyHeads[2] * EmuFloppySpt[2] - 1
   Else
    LBA := 0;
   S.DataBuf[0] := Byte(LBA Shr 24); S.DataBuf[1] := Byte(LBA Shr 16);
   S.DataBuf[2] := Byte(LBA Shr 8);  S.DataBuf[3] := Byte(LBA);
   S.DataBuf[6] := 2;
   S.DataLen := 8; S.DataPos := 0; S.Phase := 2;
  End;
  $08: Begin { READ(6) }
   LBA := (LongInt(S.CDB[1] And $1F) Shl 16) Or (LongInt(S.CDB[2]) Shl 8) Or LongInt(S.CDB[3]);
   If Not Emu_SCSI_UnitOpen Or Not Emu_ImageReadSector(2, LBA, S.DataBuf) Then Begin
    Emu_SCSI_Complete(S, 2); Exit;
   End;
   S.DataLen := 512; S.DataPos := 0; S.Phase := 2;
  End;
  $28: Begin { READ(10) }
   LBA := (LongInt(S.CDB[2]) Shl 24) Or (LongInt(S.CDB[3]) Shl 16) Or
    (LongInt(S.CDB[4]) Shl 8) Or LongInt(S.CDB[5]);
   If Not Emu_SCSI_UnitOpen Or Not Emu_ImageReadSector(2, LBA, S.DataBuf) Then Begin
    Emu_SCSI_Complete(S, 2); Exit;
   End;
   S.DataLen := 512; S.DataPos := 0; S.Phase := 2;
  End;
  $0A: Begin { WRITE(6) }
   If Not Emu_SCSI_UnitOpen Or EmuFloppyRO[2] Then Begin Emu_SCSI_Complete(S, 2); Exit; End;
   S.PendingLBA := (LongInt(S.CDB[1] And $1F) Shl 16) Or (LongInt(S.CDB[2]) Shl 8) Or LongInt(S.CDB[3]);
   FillChar(S.DataBuf, SizeOf(S.DataBuf), 0);
   S.DataLen := 512; S.DataPos := 0; S.Phase := 3; { DATA_OUT cote hote }
  End;
  $2A: Begin { WRITE(10) }
   If Not Emu_SCSI_UnitOpen Or EmuFloppyRO[2] Then Begin Emu_SCSI_Complete(S, 2); Exit; End;
   S.PendingLBA := (LongInt(S.CDB[2]) Shl 24) Or (LongInt(S.CDB[3]) Shl 16) Or
    (LongInt(S.CDB[4]) Shl 8) Or LongInt(S.CDB[5]);
   FillChar(S.DataBuf, SizeOf(S.DataBuf), 0);
   S.DataLen := 512; S.DataPos := 0; S.Phase := 3;
  End;
 Else
  Emu_SCSI_Complete(S, 2); { Check Condition : commande non geree }
 End;
End;

Function Emu_SCSI_ReadStatus(Var S: TEmuSCSIHostAdapter): Byte;
Begin
 { Meme forme BSY/REQ/CD/IO que Emu_ST506_ReadStatus, deliberement -      }
 { protocoles internes coherents, voir le commentaire de TEmuST506. }
 Case S.Phase Of
  2: Emu_SCSI_ReadStatus := $0A; { DATA_IN cote hote : REQ+IO }
  3: Emu_SCSI_ReadStatus := $02; { DATA_OUT cote hote : REQ }
  4: Emu_SCSI_ReadStatus := $0E; { STATUS_READY : REQ+CD+IO }
 Else
  Emu_SCSI_ReadStatus := $06;    { IDLE/CDB_RECEIVING : REQ+CD }
 End;
End;

Function Emu_SCSI_ReadData(Var S: TEmuSCSIHostAdapter): Byte;
Begin
 Emu_SCSI_ReadData := 0;
 Case S.Phase Of
  2: Begin
   If S.DataPos < S.DataLen Then Begin
    Emu_SCSI_ReadData := S.DataBuf[S.DataPos];
    Inc(S.DataPos);
    If S.DataPos >= S.DataLen Then Emu_SCSI_Complete(S, 0);
   End;
  End;
  4: Begin
   Emu_SCSI_ReadData := S.StatusByte;
   S.Phase := 0;
   S.CDBLen := 0; { arme un nouveau CDB des la prochaine ecriture - voir Emu_SCSI_WriteData }
  End;
 End;
End;

Procedure Emu_SCSI_WriteData(Var S: TEmuSCSIHostAdapter; Value: Byte);
Begin
 Case S.Phase Of
  0, 1: Begin
   If S.CDBLen = 0 Then Begin
    If Value < $20 Then S.CDBExpected := 6 Else S.CDBExpected := 10;
    S.Phase := 1;
   End;
   If S.CDBLen < 10 Then Begin
    S.CDB[S.CDBLen] := Value; Inc(S.CDBLen);
   End;
   If S.CDBLen >= S.CDBExpected Then Emu_SCSI_Exec(S);
  End;
  3: Begin
   If S.DataPos < S.DataLen Then Begin
    S.DataBuf[S.DataPos] := Value; Inc(S.DataPos);
   End;
   If S.DataPos >= S.DataLen Then Begin
    If Emu_ImageWriteSector(2, S.PendingLBA, S.DataBuf) Then
     Emu_SCSI_Complete(S, 0)
    Else
     Emu_SCSI_Complete(S, 2);
   End;
  End;
 End;
End;

{ ============================================================
  8259A PIC (maitre 20h/21h + esclave A0h/A1h) - voir TEmuPICChip.
  ============================================================ }

Procedure Emu_PIC_HandleEOI(Var C: TEmuPICChip; Value: Byte);
Var Lvl, B: Byte;
Begin
 If (Value And $20) = 0 Then Exit; { ni EOI specifique ni non-specifique }
 If (Value And $40) <> 0 Then Begin
  Lvl := Value And $07;
  C.ISR := C.ISR And Not (Byte(1) Shl Lvl);
 End Else Begin
  B := 0;
  While (B < 8) And ((C.ISR And (Byte(1) Shl B)) = 0) Do Inc(B);
  If B < 8 Then C.ISR := C.ISR And Not (Byte(1) Shl B);
 End;
End;

Procedure Emu_PIC_Reset(Var C: TEmuPICChip; DefaultVectorBase: Byte);
Begin
 C.IMR := 0; { rien de masque par defaut : preserve le comportement existant }
 C.ISR := 0;
 C.InitState := 0;
 C.VectorBase := DefaultVectorBase;
 C.SnglMode := False;
 C.NeedICW4 := False;
 C.AutoEOI := False;
 C.ReadISRNext := False;
End;

Function Emu_PIC_In(Var C: TEmuPICChip; CmdPort: Boolean; IrrBits: Byte): Byte;
Begin
 If CmdPort Then Begin
  If C.ReadISRNext Then Emu_PIC_In := C.ISR
  Else Emu_PIC_In := IrrBits;
 End Else
  Emu_PIC_In := C.IMR;
End;

Procedure Emu_PIC_Out(Var C: TEmuPICChip; CmdPort: Boolean; Value: Byte);
Begin
 If CmdPort Then Begin
  If (Value And $10) <> 0 Then Begin { ICW1 : (re)demarre l initialisation }
   C.SnglMode := (Value And $02) <> 0;
   C.NeedICW4 := (Value And $01) <> 0;
   C.InitState := 1;
   C.ISR := 0;
  End Else If (Value And $08) <> 0 Then Begin { OCW3 }
   If (Value And $02) <> 0 Then C.ReadISRNext := (Value And $01) <> 0;
   { SMM/ESMM (bits 5-6) et Poll (bit2) : accepte sans effet, aucun     }
   { logiciel DOS courant n en depend. }
  End Else
   Emu_PIC_HandleEOI(C, Value); { OCW2 }
  Exit;
 End;
 { Port donnees : ICW2/ICW3/ICW4 pendant l initialisation, sinon OCW1 (masque). }
 Case C.InitState Of
  1: Begin
      C.VectorBase := Value And $F8;
      If C.SnglMode Then Begin
       If C.NeedICW4 Then C.InitState := 3 Else C.InitState := 0;
      End Else
       C.InitState := 2;
     End;
  2: Begin
      If C.NeedICW4 Then C.InitState := 3 Else C.InitState := 0;
     End;
  3: Begin
      C.AutoEOI := (Value And $02) <> 0;
      C.InitState := 0;
     End;
 Else
  C.IMR := Value;
 End;
End;

{ ============================================================
  8255A PPI (60h-63h, miroir 64h-6Fh) - materiel PC/PC-XT/clones (voir
  Emu_IsATClassHw). Sur materiel classe AT+, 60h/64h suivent un protocole
  DIFFERENT (controleur clavier 8042 reel, voir plus bas) ; 62h/63h et le
  miroir 65h-6Fh n existent pas du tout sur un vrai AT (pas de PPI), d ou
  les gardes "Not Emu_IsATClassHw" separees plutot qu un simple partage
  de code entre les deux familles de materiel.
  ============================================================ }

{ Commutateurs de configuration SW1 (nb lecteurs disquette, mode video,
  presence coprocesseur) - source unique partagee par la lecture directe
  Port A (mux PortB bit7, voir Emu_PPI_ReadA) ET la lecture demi-octet
  Port C (mux PortB bit3, voir Emu_PPI_ReadC) : simplification assumee
  (un vrai 5150 distingue SW1 d un second banc SW2 pour la RAM systeme,
  non modelise ici faute de consommateur reel dans cet emulateur), mais
  la valeur elle-meme est deja verifiee fonctionnelle (GSDEMO1.COM). }
Function Emu_PPI_SW1: Byte;
Begin
 Case Emu_FloppyCount Of
  0: Emu_PPI_SW1 := $20;
  2: Emu_PPI_SW1 := $61;
 Else
  Emu_PPI_SW1 := $21;
 End;
End;

{ Lecture 60h (Port A) sur materiel PC/XT reel : mux materiel reel par
  PortB bit7 - 0 = scancode clavier courant (comportement historique de
  cet emulateur), 1 = commutateurs SW1 complets. Jamais implante avant
  cette revision (le mux etait ignore, toujours le scancode). }
Function Emu_PPI_ReadA(Var P: TEmulatorPanel): Byte;
Begin
 If (EmuPPI.PortB And $80) <> 0 Then
  Emu_PPI_ReadA := Emu_PPI_SW1
 Else
  Emu_PPI_ReadA := P.CPU.NextRawKey;
End;

{ Lecture 61h : bits 3-5 = ancien mecanisme de bascule d actualisation
  (StatusRetrace Xor $30, deja verifie fonctionnel pour la detection de
  frequence moniteur par GSDEMO1.COM - NE PAS modifier) ; bits 0-1
  (haut-parleur : gate timer2 + donnees) et bits 6-7 (mux SW1/clavier +
  horloge clavier) refletent la derniere ecriture OUT 61h. Registre
  IDENTIQUE sur PC/XT et AT+ (les cartes meres AT le conservent tel quel
  pour la compatibilite logicielle, meme si le clavier lui-meme passe par
  un 8042 des 60h/64h - voir plus bas). }
Function Emu_PPI_ReadB: Byte;
Begin
 Emu_PPI_ReadB := ((EmuVideo.StatusRetrace Xor $30) And $38) Or (EmuPPI.PortB And $C3);
End;

{ Lecture 62h (Port C) : bascule reelle SW1 haut/bas selon PortB bit3
  (mux materiel reel). N existe que sur PC/XT (voir Emu_IsATClassHw). }
Function Emu_PPI_ReadC: Byte;
Begin
 If (EmuPPI.PortB And $08) <> 0 Then
  Emu_PPI_ReadC := Emu_PPI_SW1 And $0F
 Else
  Emu_PPI_ReadC := (Emu_PPI_SW1 Shr 4) And $0F;
End;

{ Miroir 64h-6Fh (decodage materiel incomplet, PC/XT uniquement) : Port
  normalise vers 60h/61h/62h/63h par ses 2 bits de poids faible. }
Function Emu_PPI_MirrorRead(Var P: TEmulatorPanel; Port: Word): Byte;
Begin
 Case Port And 3 Of
  0: Emu_PPI_MirrorRead := Emu_PPI_ReadA(P);
  1: Emu_PPI_MirrorRead := Emu_PPI_ReadB;
  2: Emu_PPI_MirrorRead := Emu_PPI_ReadC;
 Else
  Emu_PPI_MirrorRead := EmuPPI.CtrlReg;
 End;
End;

Procedure Emu_PPI_MirrorWrite(Port: Word; Value: Byte);
Begin
 Case Port And 3 Of
  1: EmuPPI.PortB := Value;
  3: EmuPPI.CtrlReg := Value;
 Else
  ; { Port A (scancode) et Port C (commutateurs) : entrees pures sur le  }
    { vrai 8255A programme en mode 0, ecriture sans effet. }
 End;
End;

{ ============================================================
  Controleur clavier 8042 (60h/64h, materiel classe AT+ uniquement - voir
  Emu_IsATClassHw). Protocole reel : 60h = tampon de sortie (lecture,
  scancode/reponse de commande) et tampon d entree (ecriture, donnee pour
  une commande 64h en attente ou commande directe au clavier) ; 64h =
  registre d etat (lecture) et registre de commande (ecriture). Le
  registre "port de sortie" (commandes D0h/D1h) porte le VRAI bit de gate
  A20 (bit1), fidelement lu/ecrit - mais SANS effet sur l adressage
  memoire emule : aucun code de ce fichier ne consulte EmuA20 pour
  determiner un adressage au-dela de 1 Mo, ce qui depasserait largement
  le "rendre les ports 60h-63h fideles au materiel" demande ici. Un
  logiciel qui active puis relit la gate A20 verra donc un comportement
  materiel correct (bit qui "tient"), meme si aucun repli sur 1 Mo n est
  simule cote memoire.
  ============================================================ }

Procedure Emu_8042_Init;
Begin
 FillChar(Emu8042, SizeOf(Emu8042), 0);
 Emu8042.CmdByte := $45;    { IRQ1 active, indicateur systeme, translation activee }
 Emu8042.OutputPort := $02; { gate A20 active par defaut, comme un vrai AT apres POST }
 Emu8042.A20Enabled := True;
 Emu8042.KbdEnabled := True;
End;

Function Emu_8042_ReadData(Var P: TEmulatorPanel): Byte;
Begin
 If Emu8042.OutBufFull Then Begin
  Emu_8042_ReadData := Emu8042.OutBuf;
  Emu8042.OutBufFull := False;
 End Else
  Emu_8042_ReadData := P.CPU.NextRawKey; { pas de reponse en attente : scancode direct }
End;

Procedure Emu_8042_WriteData(Value: Byte);
Begin
 If Emu8042.PendingCmd <> 0 Then Begin
  Case Emu8042.PendingCmd Of
   $60: Emu8042.CmdByte := Value;
   $D1: Begin
         Emu8042.OutputPort := Value;
         Emu8042.A20Enabled := (Value And $02) <> 0;
        End;
  End;
  Emu8042.PendingCmd := 0;
  Exit;
 End;
 { Commande directe au clavier : aucun peripherique reel simule, mais les }
 { reponses ACK/autotest les plus courantes sont plausibles - suffisant   }
 { pour la detection/reinitialisation logicielle standard. }
 Case Value Of
  $FF: Begin Emu8042.OutBuf := $AA; Emu8042.OutBufFull := True; End; { reset -> BAT OK }
  $F4, $F5, $F6: Begin Emu8042.OutBuf := $FA; Emu8042.OutBufFull := True; End; { ACK }
 Else
  ;
 End;
End;

Function Emu_8042_ReadStatus: Byte;
Var S: Byte;
Begin
 S := $14; { bit4=clavier deverrouille, bit2=indicateur systeme (POST reussi) }
 If Emu8042.OutBufFull Then S := S Or $01;
 Emu_8042_ReadStatus := S;
End;

Procedure Emu_8042_WriteCmd(Value: Byte);
Begin
 Case Value Of
  $20: Begin Emu8042.OutBuf := Emu8042.CmdByte; Emu8042.OutBufFull := True; End;
  $60: Emu8042.PendingCmd := $60;
  $AD: Emu8042.KbdEnabled := False;
  $AE: Emu8042.KbdEnabled := True;
  $D0: Begin Emu8042.OutBuf := Emu8042.OutputPort; Emu8042.OutBufFull := True; End;
  $D1: Emu8042.PendingCmd := $D1;
 Else
  ; { autotest 0AAh, lecture/ecriture RAM interne 20h-3Fh/60h-7Fh, reset  }
    { systeme FEh, etc. : acceptees sans effet, hors perimetre demande.  }
 End;
End;

{ ============================================================
  Port parallele generique (LPT1/LPT2) - voir TEmuLPT. Offset 0=donnees,
  1=etat (lecture seule), 2=controle. Aucune imprimante physique n est
  emulee : l etat par defaut ($D8 : pret, en ligne, pas d erreur, papier
  present) evite tout blocage logiciel qui attendrait un vrai peripherique.
  ============================================================ }

Function Emu_LPT_Read(Var L: TEmuLPT; Ofs: Word): Byte;
Begin
 Case Ofs Of
  0: Emu_LPT_Read := L.DataReg;
  1: Emu_LPT_Read := $D8;
  2: Emu_LPT_Read := L.CtrlReg;
 Else
  Emu_LPT_Read := 0;
 End;
End;

Procedure Emu_LPT_Write(Var L: TEmuLPT; Ofs: Word; Value: Byte);
Begin
 Case Ofs Of
  0: L.DataReg := Value;
  2: L.CtrlReg := Value;
 End;
End;

{ ============================================================
  UART 8250/16450 generique (COM2/COM4) - voir TEmuUART.
  ============================================================ }

Procedure Emu_UART_Init(Var U: TEmuUART);
Begin
 FillChar(U, SizeOf(U), 0);
 U.LSR := $60; { THRE + TEMT : toujours pret a transmettre, jamais bloquant }
 U.MSR := $B0; { CTS + DSR actifs, DCD/RI inactifs : "cable branche, rien en ligne" }
End;

Function Emu_UART_Read(Var U: TEmuUART; Reg: Byte): Byte;
Begin
 Emu_UART_Read := 0;
 Case Reg Of
  0: If (U.LCR And $80) <> 0 Then Emu_UART_Read := U.DLL
     Else Begin
      Emu_UART_Read := U.RBR;
      U.DataReady := False;
      U.LSR := U.LSR And Not Byte($01);
     End;
  1: If (U.LCR And $80) <> 0 Then Emu_UART_Read := U.DLM
     Else Emu_UART_Read := U.IER;
  2: Emu_UART_Read := U.IIR Or $01; { pas d interruption en attente }
  3: Emu_UART_Read := U.LCR;
  4: Emu_UART_Read := U.MCR;
  5: Emu_UART_Read := U.LSR;
  6: Emu_UART_Read := U.MSR;
  7: Emu_UART_Read := U.SCR;
 End;
End;

Procedure Emu_UART_Write(Var U: TEmuUART; Reg: Byte; Value: Byte);
Begin
 Case Reg Of
  0: If (U.LCR And $80) <> 0 Then U.DLL := Value
     Else Begin
      U.THR := Value;
      { Boucle locale (MCR bit4) uniquement : rien n est cable a l autre
        bout de ce port, donc un octet transmis hors boucle est simplement
        perdu (comportement d un cable debranche), jamais bloquant cote
        LSR (voir Emu_UART_Init). }
      If (U.MCR And $10) <> 0 Then Begin
       U.RBR := Value;
       U.DataReady := True;
       U.LSR := U.LSR Or $01;
      End;
     End;
  1: If (U.LCR And $80) <> 0 Then U.DLM := Value
     Else U.IER := Value;
  2: ; { FCR (16550+) : sans objet pour un 16450, ecriture ignoree }
  3: U.LCR := Value;
  4: U.MCR := Value;
  7: U.SCR := Value;
 End;
End;

{ ============================================================
  NE2000/DP8390 (260h-27Fh) - voir TEmuNE2000. Detection/reset
  uniquement, voir commentaire de TEmuNE2000.
  ============================================================ }

Procedure Emu_NE2000_Init(Var N: TEmuNE2000);
Begin
 FillChar(N, SizeOf(N), 0);
End;

Function Emu_NE2000_CurPage(Var N: TEmuNE2000): Byte;
Begin
 Emu_NE2000_CurPage := (N.Regs0[0] Shr 6) And $03;
End;

Function Emu_NE2000_Read(Var N: TEmuNE2000; Ofs: Byte): Byte;
Begin
 Emu_NE2000_Read := 0;
 If Ofs <= $0F Then Begin { registres, page selectionnee par CR bits 6-7 }
  Case Emu_NE2000_CurPage(N) Of
   0: Emu_NE2000_Read := N.Regs0[Ofs];
   1: Emu_NE2000_Read := N.Regs1[Ofs];
  Else
   Emu_NE2000_Read := N.Regs2[Ofs];
  End;
  Exit;
 End;
 If Ofs <= $17 Then Begin { 10h-17h : fenetre DMA distante locale }
  Emu_NE2000_Read := N.DmaWindow[Ofs And $07];
  Exit;
 End;
 { 18h-1Fh : port de reinitialisation - la lecture declenche un reset qui
   se termine immediatement (pas de latence simulee) et se signale via le
   bit RST (80h) de l ISR (Page 0, registre 07h), exactement la sequence
   qu un pilote de paquets/pile reseau sonde pour confirmer la presence
   d une carte NE2000 avant de s en servir. }
 N.Regs0[$07] := N.Regs0[$07] Or $80;
End;

Procedure Emu_NE2000_Write(Var N: TEmuNE2000; Ofs: Byte; Value: Byte);
Begin
 If Ofs <= $0F Then Begin
  If Ofs = $07 Then Begin { ISR : ecriture 1 pour effacer (comportement reel) }
   Case Emu_NE2000_CurPage(N) Of
    0: N.Regs0[$07] := N.Regs0[$07] And Not Value;
   Else
    ; { ISR n existe que page 0 sur le vrai chip }
   End;
   Exit;
  End;
  Case Emu_NE2000_CurPage(N) Of
   0: N.Regs0[Ofs] := Value;
   1: N.Regs1[Ofs] := Value;
  Else
   N.Regs2[Ofs] := Value;
  End;
  Exit;
 End;
 If Ofs <= $17 Then Begin
  N.DmaWindow[Ofs And $07] := Value;
  Exit;
 End;
 { 18h-1Fh : accuse de reception de la reinitialisation - accepte sans effet
   supplementaire (le bit RST a deja ete pose par la lecture prealable). }
End;

{ ============================================================
  Controleur de disquette (FDC) - ports 3F0h-3F7h. Voir le commentaire de
  TEmuFDC pour le perimetre (PIO complet, pas de vrai DMA materiel, 3F0h/
  3F1h/3F7h reserves au materiel classe AT+). Unites 0/1 = EmuFloppy 0/1,
  memes images/geometrie que INT13h (Emu_FloppyCHS2LBA/Emu_ImageReadSector/
  Emu_ImageWriteSector, deja utilises par ce dernier).
  ============================================================ }

{ Registre Status Main (3F4h, lecture seule) : bit7=RQM (pret, toujours 1
  dans ce modele sans latence simulee), bit6=DIO (1=controleur->hote, actif
  en phase RESULT ou en phase EXEC-lecture), bit4=CB (commande en cours,
  actif des que l etat n est plus IDLE). Bits 0-3 (unite en recherche) non
  modelises (pas de suivi de "busy" par unite dans ce modele instantane). }
Function Emu_FDC_MSR(Var F: TEmuFDC): Byte;
Var M: Byte; Dio: Boolean;
Begin
 M := $80;
 Dio := (F.State = 3) Or ((F.State = 2) And (Not F.DataIsWrite));
 If Dio Then M := M Or $40;
 If F.State <> 0 Then M := M Or $10;
 Emu_FDC_MSR := M;
End;

{ Status Register A (3F0h, 82077AA mode PC-AT, AT+ seulement) : bit2=INDEX
  (actif bas, 1=inactif - aucune rotation simulee), bit1=WP (actif bas,
  1=pas protege). Autres bits (STEP/TRK0/HDSEL/DRQ/INT) non modelises. }
Function Emu_FDC_ReadSRA(Var F: TEmuFDC): Byte;
Begin
 Emu_FDC_ReadSRA := $06;
End;

{ Status Register B (3F1h, AT+ seulement) : rarement sonde en pratique,
  non modelise en detail. }
Function Emu_FDC_ReadSRB(Var F: TEmuFDC): Byte;
Begin
 Emu_FDC_ReadSRB := $00;
End;

{ Digital Input Register (3F7h en lecture, AT+ seulement) : bit7=disk
  change (0=pas de changement depuis le dernier acces - aucune ejection de
  media simulee dans cet emulateur). }
Function Emu_FDC_ReadDIR(Var F: TEmuFDC): Byte;
Begin
 Emu_FDC_ReadDIR := $00;
End;

{ Remplit le resultat 7 octets d une commande READ/WRITE DATA ou READ ID
  (ST0/ST1/ST2/C/H/R/N) et bascule en phase RESULT. }
Procedure Emu_FDC_BuildDataResult(Var F: TEmuFDC; ST0, ST1, ST2: Byte);
Begin
 F.ResBuf[0] := ST0; F.ResBuf[1] := ST1; F.ResBuf[2] := ST2;
 F.ResBuf[3] := F.XferCyl; F.ResBuf[4] := F.XferHead;
 F.ResBuf[5] := F.XferSec; F.ResBuf[6] := F.XferSize;
 F.ResLen := 7; F.ResPos := 0; F.State := 3;
End;

{ Execute la commande accumulee dans CmdBuf (dernier octet de parametre
  vient d etre recu - voir Emu_FDC_WriteData). Opcode masque sur 5 bits
  (bits 7-5 = MT/MFM/SK, modificateurs sans effet sur le protocole simplifie
  ici, sauf a determiner READ (06h) vs WRITE (05h) qui reste distinct). }
Procedure Emu_FDC_Exec(Var F: TEmuFDC);
Var
 Op, U, Head, Cyl, Sec, Sz: Byte;
 LBA: LongInt;
Begin
 Op := F.CmdBuf[0] And $1F;
 Case Op Of
  $03: F.State := 0; { SPECIFY : SRT/HUT+HLT/ND consommes, pas de resultat }
  $04: Begin { SENSE DRIVE STATUS }
   U := F.CmdBuf[1] And 3;
   F.ResBuf[0] := $20 Or U; { TS (deux faces) + unite }
   If EmuFloppyOpen[U] And (F.PCN[U] = 0) Then F.ResBuf[0] := F.ResBuf[0] Or $10; { TRK0 }
   F.ResLen := 1; F.ResPos := 0; F.State := 3;
  End;
  $07: Begin { RECALIBRATE : retour piste 0, resultat via SENSE INTERRUPT STATUS }
   U := F.CmdBuf[1] And 3;
   F.PCN[U] := 0;
   F.SeekIntPending[U] := True;
   F.State := 0;
  End;
  $0F: Begin { SEEK : idem, cylindre cible explicite }
   U := F.CmdBuf[1] And 3;
   F.PCN[U] := F.CmdBuf[2];
   F.SeekIntPending[U] := True;
   F.State := 0;
  End;
  $08: Begin { SENSE INTERRUPT STATUS }
   U := 0;
   While (U < 4) And (Not F.SeekIntPending[U]) Do Inc(U);
   If U < 4 Then Begin
    F.ResBuf[0] := $20 Or U; { SE=1 (seek end) + unite }
    F.ResBuf[1] := F.PCN[U];
    F.ResLen := 2; F.SeekIntPending[U] := False;
   End Else Begin
    F.ResBuf[0] := $80; { commande invalide : aucune interruption en attente }
    F.ResLen := 1;
   End;
   F.ResPos := 0; F.State := 3;
  End;
  $0A: Begin { READ ID : identifie le prochain secteur sous la tete }
   U := F.CmdBuf[1] And 3;
   Head := (F.CmdBuf[1] Shr 2) And 1;
   If Not EmuFloppyOpen[U] Then Begin
    Emu_FDC_BuildDataResult(F, $48 Or U, 0, 0); { unite non prete }
    Exit;
   End;
   F.XferCyl := F.PCN[U]; F.XferHead := Head; F.XferSec := 1; F.XferSize := 2;
   Emu_FDC_BuildDataResult(F, $20 Or U, 0, 0);
  End;
  $06, $05: Begin { READ DATA (06h) / WRITE DATA (05h) }
   U := F.CmdBuf[1] And 3;
   Head := (F.CmdBuf[1] Shr 2) And 1;
   Cyl  := F.CmdBuf[2];
   Sec  := F.CmdBuf[4];
   Sz   := F.CmdBuf[5];
   F.XferUnit := U; F.XferCyl := Cyl; F.XferHead := Head;
   F.XferSec := Sec; F.XferSize := Sz;
   If Not EmuFloppyOpen[U] Then Begin
    Emu_FDC_BuildDataResult(F, $48 Or U, $01, 0); { unite non prete }
    Exit;
   End;
   LBA := Emu_FloppyCHS2LBA(U, Cyl, Head, Sec);
   If LBA < 0 Then Begin
    Emu_FDC_BuildDataResult(F, $40 Or U, $01, 0); { fin anormale, pas de donnees }
    Exit;
   End;
   If Op = $06 Then Begin { READ }
    If Not Emu_ImageReadSector(U, LBA, F.DataBuf) Then Begin
     Emu_FDC_BuildDataResult(F, $40 Or U, $01, 0);
     Exit;
    End;
    F.DataIsWrite := False;
   End Else Begin { WRITE }
    If EmuFloppyRO[U] Then Begin
     Emu_FDC_BuildDataResult(F, $40 Or U, $02, 0); { protection ecriture }
     Exit;
    End;
    FillChar(F.DataBuf, SizeOf(F.DataBuf), 0);
    F.DataIsWrite := True;
   End;
   F.DataPos := 0; F.DataLen := 512; F.State := 2;
  End;
 Else
  F.ResBuf[0] := $80; F.ResLen := 1; F.ResPos := 0; F.State := 3; { invalide }
 End;
End;

{ Ecriture registre Data (3F5h) : selon l etat courant, accumule un octet
  de commande/parametre (IDLE/CMD) ou recoit un octet de donnees en phase
  EXEC-ecriture (flush vers l image disque des que DataLen octets recus). }
Procedure Emu_FDC_WriteData(Var F: TEmuFDC; Value: Byte);
Var LBA: LongInt;
Begin
 Case F.State Of
  0: Begin
   F.CmdBuf[0] := Value; F.CmdLen := 1;
   Case Value And $1F Of
    $03: F.CmdExpected := 3;
    $04: F.CmdExpected := 2;
    $07: F.CmdExpected := 2;
    $08: F.CmdExpected := 1;
    $0F: F.CmdExpected := 3;
    $0A: F.CmdExpected := 2;
    $06, $05: F.CmdExpected := 9;
   Else
    F.CmdExpected := 1;
   End;
   If F.CmdLen >= F.CmdExpected Then Emu_FDC_Exec(F) Else F.State := 1;
  End;
  1: Begin
   If F.CmdLen <= 8 Then Begin F.CmdBuf[F.CmdLen] := Value; Inc(F.CmdLen); End;
   If F.CmdLen >= F.CmdExpected Then Emu_FDC_Exec(F);
  End;
  2: If F.DataIsWrite And (F.DataPos < F.DataLen) Then Begin
    F.DataBuf[F.DataPos] := Value; Inc(F.DataPos);
    If F.DataPos >= F.DataLen Then Begin
     LBA := Emu_FloppyCHS2LBA(F.XferUnit, F.XferCyl, F.XferHead, F.XferSec);
     If (LBA < 0) Or (Not Emu_ImageWriteSector(F.XferUnit, LBA, F.DataBuf)) Then
      Emu_FDC_BuildDataResult(F, $40 Or F.XferUnit, $02, 0)
     Else
      Emu_FDC_BuildDataResult(F, $20 Or F.XferUnit, 0, 0);
    End;
   End;
 End;
End;

{ Lecture registre Data (3F5h) : octet de donnees en phase EXEC-lecture, ou
  octet de resultat en phase RESULT (bascule a IDLE une fois tout consomme). }
Function Emu_FDC_ReadData(Var F: TEmuFDC): Byte;
Begin
 Emu_FDC_ReadData := 0;
 Case F.State Of
  2: If (Not F.DataIsWrite) And (F.DataPos < F.DataLen) Then Begin
    Emu_FDC_ReadData := F.DataBuf[F.DataPos]; Inc(F.DataPos);
    If F.DataPos >= F.DataLen Then Emu_FDC_BuildDataResult(F, $20 Or F.XferUnit, 0, 0);
   End;
  3: If F.ResPos < F.ResLen Then Begin
    Emu_FDC_ReadData := F.ResBuf[F.ResPos]; Inc(F.ResPos);
    If F.ResPos >= F.ResLen Then F.State := 0;
   End;
 End;
End;

{ Ecriture registre DOR (3F2h) : la transition /RESET 0->1 (sortie de reset)
  arme les 4 drapeaux SENSE INTERRUPT STATUS d un coup (un vrai 8272A/82077
  genere 4 interruptions de "polling" successives, une par unite, chacune
  necessitant son propre SENSE INTERRUPT STATUS pour etre acquittee - le
  nombre et l effet final sont fideles, l ordre exact d acquittement est une
  simplification documentee) et reinitialise l etat de commande courant. }
Procedure Emu_FDC_WriteDOR(Var F: TEmuFDC; Value: Byte);
Begin
 If ((F.DOR And $04) = 0) And ((Value And $04) <> 0) Then Begin
  F.SeekIntPending[0] := True; F.SeekIntPending[1] := True;
  F.SeekIntPending[2] := True; F.SeekIntPending[3] := True;
  F.State := 0; F.CmdLen := 0; F.ResLen := 0; F.ResPos := 0;
 End;
 F.DOR := Value;
End;

{ --- Forward / dispatcher I/O global pour IN AL,DX et OUT DX,AL.
      Les ports non ger?s retournent 0. --- }
Function Emu_PortRead(Var P: TEmulatorPanel; Port: Word): Byte;
Var
 CmosIdxPort, CmosDataPort: Word;
Begin
 Emu_PortRead := 0;
 Emu_CMOSPorts(CmosIdxPort, CmosDataPort);
 If Port = CmosIdxPort Then Begin
  Emu_PortRead := EmuCMOS_Index;
  Exit;
 End;
 If Port = CmosDataPort Then Begin
  Emu_PortRead := Emu_CMOS_ReadReg(EmuCMOS_Index And $3F);
  Exit;
 End;
 Case Port Of
  $20, $21: Emu_PortRead := Emu_PIC_In(EmuPICMaster, Port = $20, EmuIrqPending);
  { PIC esclave (IRQ8-15) : uniquement sur materiel classe AT+ (voir
    Emu_IsATClassHw) - un PC/XT d origine n a qu un seul 8259A, sonder
    A0h/A1h dessus ne doit rien trouver (comportement par defaut : 0). }
  $A0, $A1: If Emu_IsATClassHw Then
             Emu_PortRead := Emu_PIC_In(EmuPICSlave, Port = $A0, 0);
  $40, $41, $42: Begin
   { PIT 8253 - lecture de compteur. Retourne un compteur libre. }
   Inc(EmuTickCounter);
   Emu_PortRead := Byte(EmuTickCounter);
  End;
  $43: Emu_PortRead := 0;
  { 60h/64h : 8255A PPI (PC/XT/clones) ou 8042 (AT/PS2/Compaq Deskpro 386,  }
  { voir Emu_IsATClassHw) - PROTOCOLE REELLEMENT DIFFERENT selon le        }
  { materiel choisi (Options > Emulateur > DOS: Materiel), pas juste un    }
  { alias. 61h identique sur les deux familles (voir Emu_PPI_ReadB). 62h/  }
  { 63h et le miroir 65h-6Fh n existent que sur PC/XT (un vrai AT n a pas  }
  { de PPI du tout a ces adresses). }
  $60: If Emu_IsATClassHw Then Emu_PortRead := Emu_8042_ReadData(P)
       Else Emu_PortRead := Emu_PPI_ReadA(P);
  $61: Emu_PortRead := Emu_PPI_ReadB;
  $62: If Not Emu_IsATClassHw Then Emu_PortRead := Emu_PPI_ReadC;
  $63: If Not Emu_IsATClassHw Then Emu_PortRead := EmuPPI.CtrlReg;
  $64: If Emu_IsATClassHw Then Emu_PortRead := Emu_8042_ReadStatus
       Else Emu_PortRead := Emu_PPI_MirrorRead(P, Port);
  $65..$6F: If Not Emu_IsATClassHw Then Emu_PortRead := Emu_PPI_MirrorRead(P, Port);
  { Unite d extension 5161 (PC/XT uniquement) : aucune unite reelle       }
  { emulee, mais repond 0 au lieu de rester totalement muette, pour       }
  { les rares utilitaires de diagnostic d epoque qui la sondent. }
  $210..$215: If Not Emu_IsATClassHw Then Emu_PortRead := 0;
  { Interface de disque (Options > Emulateur > DOS: Materiel) - voir       }
  { Emu_DiskIfFamily : UNE SEULE famille de ports repond a la fois, jamais }
  { de melange, fidele au fait qu un PC reel n a jamais deux protocoles de }
  { controleur de disque actifs sur les memes ports. }
  $1F0..$1F7: If Emu_DiskIfFamily = DIF_ATA Then
               Emu_PortRead := Emu_ATA_ReadReg(EmuATA[0], Port - $1F0);
  $170..$177: If Emu_DiskIfFamily = DIF_ATA Then
               Emu_PortRead := Emu_ATA_ReadReg(EmuATA[1], Port - $170);
  $320..$323: If Emu_DiskIfFamily = DIF_ST506 Then
   Case Port Of
    $320: Emu_PortRead := Emu_ST506_ReadData(EmuST506);
    $321: Emu_PortRead := Emu_ST506_ReadStatus(EmuST506);
   Else
    Emu_PortRead := 0;
   End;
  $330..$333: If Emu_DiskIfFamily = DIF_SCSI Then
   Case Port Of
    $330: Emu_PortRead := Emu_SCSI_ReadStatus(EmuSCSI);
    $331: Emu_PortRead := Emu_SCSI_ReadData(EmuSCSI);
   Else
    Emu_PortRead := 0;
   End;
  { NE2000 (Reseau LAN = NE2000 compatible) : 278h-27Ah reserve a LPT2    }
  { (conflit reel d adresses connu de l epoque entre une carte reseau     }
  { configuree en base 260h et un 2e port parallele - voir le commentaire }
  { du bloc LPT2 ci-dessous) ; le port de reinitialisation canonique      }
  { (base+1Fh = 27Fh) reste joignable, suffisant pour la sequence de      }
  { detection standard d un pilote de paquets. }
  $260..$277, $27B..$27F:
   If OptionsDlg.Data.DosLAN And (OptionsDlg.Data.DosLANVendor = 0) Then
    Emu_PortRead := Emu_NE2000_Read(EmuNE2000, Byte(Port - $260));
  { LPT2 : garde la priorite sur le sous-intervalle partage avec NE2000   }
  { ci-dessus (278h-27Ah), fidele au compromis reel de l epoque. }
  $278..$27A: Emu_PortRead := Emu_LPT_Read(EmuLPT2, Port - $278);
  $2E8..$2EF: Emu_PortRead := Emu_UART_Read(EmuCOM4, Byte(Port - $2E8));
  $2F8..$2FF: Emu_PortRead := Emu_UART_Read(EmuCOM2, Byte(Port - $2F8));
  $3B4..$3BB: Emu_PortRead := Emu_VidPortRead(Port);
  { LPT1 (carte combo mono+imprimante) : 3BCh=donnees,3BDh=etat,3BEh=     }
  { controle - jamais interprete par Emu_VidPortRead auparavant (son      }
  { Case interne n a pas d entree pour ces adresses, il retombait sur son }
  { defaut 0), donc ce nouveau branchement n enleve aucun comportement    }
  { video existant. }
  $3BC..$3BE: Emu_PortRead := Emu_LPT_Read(EmuLPT1, Port - $3BC);
  $3BF: Emu_PortRead := 0;
  $3C0..$3DF: Emu_PortRead := Emu_VidPortRead(Port);
  $3F6: If Emu_DiskIfFamily = DIF_ATA Then
         Emu_PortRead := Emu_ATA_ReadAltStatus(EmuATA[0]);
  $376: If Emu_DiskIfFamily = DIF_ATA Then
         Emu_PortRead := Emu_ATA_ReadAltStatus(EmuATA[1]);
  { Controleur de disquette (FDC) - TOUJOURS present, independant de       }
  { l Interface de disque ci-dessus (peripherique distinct, voir TEmuFDC). }
  { 3F0h/3F1h/3F7h : materiel classe AT+ seulement (82077AA integre), un   }
  { PC/XT avec 8272A discret ne repond pas du tout a ces adresses. }
  $3F0: If Emu_IsATClassHw Then Emu_PortRead := Emu_FDC_ReadSRA(EmuFDC);
  $3F1: If Emu_IsATClassHw Then Emu_PortRead := Emu_FDC_ReadSRB(EmuFDC);
  $3F2: Emu_PortRead := EmuFDC.DOR;
  $3F4: Emu_PortRead := Emu_FDC_MSR(EmuFDC);
  $3F5: Emu_PortRead := Emu_FDC_ReadData(EmuFDC);
  $3F7: If Emu_IsATClassHw Then Emu_PortRead := Emu_FDC_ReadDIR(EmuFDC);
 End;
End;

Procedure Emu_PortWrite(Var P: TEmulatorPanel; Port: Word; Value: Byte);
Var
 CmosIdxPort, CmosDataPort: Word;
Begin
 Emu_CMOSPorts(CmosIdxPort, CmosDataPort);
 If Port = CmosIdxPort Then Begin
  EmuCMOS_Index := Value;
  Exit;
 End;
 If Port = CmosDataPort Then Begin
  Emu_CMOS_WriteReg(EmuCMOS_Index And $3F, Value);
  Exit;
 End;
 Case Port Of
  $20, $21: Emu_PIC_Out(EmuPICMaster, Port = $20, Value);
  $A0, $A1: If Emu_IsATClassHw Then Emu_PIC_Out(EmuPICSlave, Port = $A0, Value);
  $60: If Emu_IsATClassHw Then Emu_8042_WriteData(Value); { XT : Port A entree pure }
  $61: EmuPPI.PortB := Value;
  $63: If Not Emu_IsATClassHw Then EmuPPI.CtrlReg := Value;
  $64: If Emu_IsATClassHw Then Emu_8042_WriteCmd(Value)
       Else Emu_PPI_MirrorWrite(Port, Value);
  $65..$6F: If Not Emu_IsATClassHw Then Emu_PPI_MirrorWrite(Port, Value);
  $1F0..$1F7: If Emu_DiskIfFamily = DIF_ATA Then
               Emu_ATA_WriteReg(EmuATA[0], Port - $1F0, Value);
  $170..$177: If Emu_DiskIfFamily = DIF_ATA Then
               Emu_ATA_WriteReg(EmuATA[1], Port - $170, Value);
  $320..$323: If Emu_DiskIfFamily = DIF_ST506 Then
   Case Port Of
    $320: Emu_ST506_WriteData(EmuST506, Value);
    $322: EmuST506.Phase := 0; { reinitialisation controleur }
   Else
    ; { 323h : masque DMA/IRQ, accepte sans effet (voir TEmuST506) }
   End;
  $330..$333: If Emu_DiskIfFamily = DIF_SCSI Then
   Case Port Of
    $330: If (Value And $80) <> 0 Then EmuSCSI.Phase := 0; { HRST }
    $331: Emu_SCSI_WriteData(EmuSCSI, Value);
   Else
    ;
   End;
  $260..$277, $27B..$27F:
   If OptionsDlg.Data.DosLAN And (OptionsDlg.Data.DosLANVendor = 0) Then
    Emu_NE2000_Write(EmuNE2000, Byte(Port - $260), Value);
  $278..$27A: Emu_LPT_Write(EmuLPT2, Port - $278, Value);
  $2E8..$2EF: Emu_UART_Write(EmuCOM4, Byte(Port - $2E8), Value);
  $2F8..$2FF: Emu_UART_Write(EmuCOM2, Byte(Port - $2F8), Value);
  $3B4..$3BB: Emu_VidPortWrite(Port, Value);
  $3BC..$3BE: Emu_LPT_Write(EmuLPT1, Port - $3BC, Value);
  $3C0..$3DF: Emu_VidPortWrite(Port, Value);
  $3F6: If Emu_DiskIfFamily = DIF_ATA Then Emu_ATA_WriteDevCtrl(EmuATA[0], Value);
  $376: If Emu_DiskIfFamily = DIF_ATA Then Emu_ATA_WriteDevCtrl(EmuATA[1], Value);
  { Controleur de disquette (FDC) - voir le commentaire de lecture ci-dessus. }
  $3F2: Emu_FDC_WriteDOR(EmuFDC, Value);
  $3F5: Emu_FDC_WriteData(EmuFDC, Value);
  $3F7: If Emu_IsATClassHw Then EmuFDC.CCR := Value And $03;
 End;
End;

{ --- INT 10h : services video (BIOS) --- }

{ ============================================================
  INT 10h : services video BIOS.
  Implementation complete couvrant CGA/EGA/VGA en mode texte.
  Mode graphique non emul? - DEV-COOLS travaille uniquement en
  texte 80x25 ; les fonctions graphiques sont stubbed.
  ============================================================ }

{ Defilement / effacement d un rectangle de la VRAM.
  AL = nb de lignes (0 = clear toute la fenetre).
  Top, Left, Bot, Right = coordonnees inclusives.
  Attr = attribut de remplissage (FG bas, BG haut).
  Up = True = scroll vers haut (AH=06), False = vers bas (AH=07). }
Procedure Emu_VideoScrollRect(Var P: TEmulatorPanel;
                              AL, Top, Left, Bot, Right, Attr: Byte;
                              Up: Boolean);
Var
 X, Y, N: Integer;
 BlankCh: Char;
Begin
 If Top > 24 Then Top := 24;
 If Bot > 24 Then Bot := 24;
 If Left > 79 Then Left := 79;
 If Right > 79 Then Right := 79;
 If Top > Bot Then Exit;
 If Left > Right Then Exit;
 N := AL;
 BlankCh := ' ';
 If (N = 0) Or (N > Bot - Top + 1) Then Begin
  { Effacer tout le rectangle. }
  For Y := Top To Bot Do
   For X := Left To Right Do Begin
    P.VRAM[Y, X].Ch := BlankCh;
    P.VRAM[Y, X].Fg := Attr And $0F;
    P.VRAM[Y, X].Bg := (Attr Shr 4) And $07;
   End;
  P.NeedRepaint := True;
  Exit;
 End;
 If Up Then Begin
  { Lignes [Top+N..Bot] -> [Top..Bot-N], puis blanchir [Bot-N+1..Bot]. }
  For Y := Top To Bot - N Do
   For X := Left To Right Do
    P.VRAM[Y, X] := P.VRAM[Y + N, X];
  For Y := Bot - N + 1 To Bot Do
   For X := Left To Right Do Begin
    P.VRAM[Y, X].Ch := BlankCh;
    P.VRAM[Y, X].Fg := Attr And $0F;
    P.VRAM[Y, X].Bg := (Attr Shr 4) And $07;
   End;
 End Else Begin
  { Lignes [Top..Bot-N] -> [Top+N..Bot], blanchir [Top..Top+N-1]. }
  For Y := Bot DownTo Top + N Do
   For X := Left To Right Do
    P.VRAM[Y, X] := P.VRAM[Y - N, X];
  For Y := Top To Top + N - 1 Do
   For X := Left To Right Do Begin
    P.VRAM[Y, X].Ch := BlankCh;
    P.VRAM[Y, X].Fg := Attr And $0F;
    P.VRAM[Y, X].Bg := (Attr Shr 4) And $07;
   End;
 End;
 P.NeedRepaint := True;
End;

Procedure Emu_DoInt10(Var P: TEmulatorPanel);
Var
 I: Integer;
 B: Byte;
 Mode: Byte;
Begin
 Inc(EmuDiag_Int10Cnt);
 Case P.CPU.Regs.AH Of
  $00:
   { Set video mode. AL = mode. On enregistre dans 0040:0049 et
     on efface l ecran si mode texte. Bit 7 d AL = ne pas effacer. }
   Begin
    Mode := P.CPU.Regs.AL And $7F;
    Emu_VidSetMode(P.CPU.Regs.AL, P);
    { EmuVideo.Mode (et non Mode ci-dessus) : si la carte configuree ne  }
    { supporte pas ce mode (voir Emu_VidModeSupported), Emu_VidSetMode   }
    { n a rien change et la BDA doit refleter le mode reellement actif,  }
    { pas la demande rejetee - un vrai BIOS n aurait pas altere l ecran. }
    Emu_WriteByte(P.CPU, $40, $49, EmuVideo.Mode);
    Emu_WriteWord(P.CPU, $40, $4A, EmuVideo.TextCols);
    Emu_WriteWord(P.CPU, $40, $4C,
      LongInt(EmuVideo.TextCols) * EmuVideo.TextRows * 2);
    Emu_WriteWord(P.CPU, $40, $4E, 0);
    Emu_WriteByte(P.CPU, $40, $84, EmuVideo.TextRows - 1);
    Emu_WriteByte(P.CPU, $40, $85, 16);
    { Reinitialiser les positions de curseur des 8 pages dans la BDA. }
    For I := 0 To 7 Do Begin
     Emu_WriteByte(P.CPU, $40, $50 + I * 2, 0);
     Emu_WriteByte(P.CPU, $40, $51 + I * 2, 0);
    End;
   End;
  $01:
   { Set cursor type. CH=start scan (bit 5 = hide), CL=end scan. }
   Begin
    Emu_WriteByte(P.CPU, $40, $60, P.CPU.Regs.CL);
    Emu_WriteByte(P.CPU, $40, $61, P.CPU.Regs.CH);
    P.CursorOn := (P.CPU.Regs.CH And $20) = 0;
   End;
  $02:
   { Set cursor pos. BH=page, DH=row, DL=col. }
   Begin
    EmuVScr_GotoXY(P, P.CPU.Regs.DL, P.CPU.Regs.DH);
    { Mettre a jour la BDA 0040:0050+page*2 (CRT FPC/TP lit
      directement la BDA pour calculer l adresse VRAM). }
    Emu_WriteByte(P.CPU, $40, $50 + (P.CPU.Regs.BH And 7) * 2,
                  P.CPU.Regs.DL);
    Emu_WriteByte(P.CPU, $40, $51 + (P.CPU.Regs.BH And 7) * 2,
                  P.CPU.Regs.DH);
   End;
  $03:
   { Get cursor pos+type. CH:CL = scan lines, DH:DL = row:col. }
   Begin
    P.CPU.Regs.DL := P.CursorX;
    P.CPU.Regs.DH := P.CursorY;
    P.CPU.Regs.CL := Emu_ReadByte(P.CPU, $40, $60);
    P.CPU.Regs.CH := Emu_ReadByte(P.CPU, $40, $61);
    If (P.CPU.Regs.CL = 0) And (P.CPU.Regs.CH = 0) Then
     P.CPU.Regs.CX := $0607;
   End;
  $04:
   { Read light pen. Pas de stylo : AH=0. }
   P.CPU.Regs.AH := 0;
  $05:
   { Set active page. On ignore (page 0 unique). }
   Emu_WriteByte(P.CPU, $40, $62, P.CPU.Regs.AL);
  $06:
   { Scroll up. AL=lignes, BH=attr, CH/CL=top-left, DH/DL=bot-right. }
   Emu_VideoScrollRect(P, P.CPU.Regs.AL, P.CPU.Regs.CH,
     P.CPU.Regs.CL, P.CPU.Regs.DH, P.CPU.Regs.DL, P.CPU.Regs.BH, True);
  $07:
   { Scroll down. Memes parametres. }
   Emu_VideoScrollRect(P, P.CPU.Regs.AL, P.CPU.Regs.CH,
     P.CPU.Regs.CL, P.CPU.Regs.DH, P.CPU.Regs.DL, P.CPU.Regs.BH, False);
  $08:
   { Read char & attr at cursor. AL=char, AH=attr. }
   Begin
    If (P.CursorY <= 24) And (P.CursorX <= 79) Then Begin
     P.CPU.Regs.AL := Byte(P.VRAM[P.CursorY, P.CursorX].Ch);
     P.CPU.Regs.AH := (P.VRAM[P.CursorY, P.CursorX].Fg And $0F) Or
                      ((P.VRAM[P.CursorY, P.CursorX].Bg And $07) Shl 4);
    End Else Begin
     P.CPU.Regs.AL := 32;
     P.CPU.Regs.AH := $07;
    End;
   End;
  $09:
   { Write char+attr at cursor, CX fois (sans avancer le curseur). }
   Begin
    For I := 0 To P.CPU.Regs.CX - 1 Do Begin
     If (P.CursorX + I) <= 79 Then Begin
      P.VRAM[P.CursorY, P.CursorX + I].Ch := Chr(P.CPU.Regs.AL);
      P.VRAM[P.CursorY, P.CursorX + I].Fg := P.CPU.Regs.BL And $0F;
      P.VRAM[P.CursorY, P.CursorX + I].Bg := (P.CPU.Regs.BL Shr 4) And $07;
     End;
    End;
    P.NeedRepaint := True;
   End;
  $0A:
   { Write char only at cursor, CX fois. }
   Begin
    For I := 0 To P.CPU.Regs.CX - 1 Do
     If (P.CursorX + I) <= 79 Then
      P.VRAM[P.CursorY, P.CursorX + I].Ch := Chr(P.CPU.Regs.AL);
    P.NeedRepaint := True;
   End;
  $0B:
   { Set palette / border color. BH=0 set border (CGA), BH=1 set palette.
     On peut stocker dans CGAColor : bits 0..3 border, bit 5 = palette. }
   Begin
    If P.CPU.Regs.BH = 0 Then
     EmuVideo.CGAColor := (EmuVideo.CGAColor And $E0) Or (P.CPU.Regs.BL And $1F)
    Else If P.CPU.Regs.BH = 1 Then Begin
     EmuVideo.CGAColor := EmuVideo.CGAColor And $DF;
     If (P.CPU.Regs.BL And 1) <> 0 Then
      EmuVideo.CGAColor := EmuVideo.CGAColor Or $20;
    End;
   End;
  $0C:
   { Write graphics pixel. AL=color, CX=col, DX=row.
     Bit 7 d AL = XOR avec pixel existant. }
   Begin
    If (P.CPU.Regs.AL And $80) <> 0 Then
     Emu_VidSetPixel(P.CPU.Regs.CX, P.CPU.Regs.DX,
       Emu_VidGetPixel(P.CPU.Regs.CX, P.CPU.Regs.DX) Xor (P.CPU.Regs.AL And $7F))
    Else
     Emu_VidSetPixel(P.CPU.Regs.CX, P.CPU.Regs.DX, P.CPU.Regs.AL);
   End;
  $0D:
   { Read graphics pixel. CX=col, DX=row, retourne AL. }
   P.CPU.Regs.AL := Emu_VidGetPixel(P.CPU.Regs.CX, P.CPU.Regs.DX);
  $0E:
   { TTY write char. AL=char, BL=color (mode graph seulement). }
   Begin
    P.CurFg := P.CPU.Regs.BL And $0F;
    EmuVScr_PutChar(P, Chr(P.CPU.Regs.AL));
   End;
  $0F:
   { Get current video mode. AL=mode, AH=cols, BH=page. }
   Begin
    P.CPU.Regs.AL := Emu_ReadByte(P.CPU, $40, $49);
    If P.CPU.Regs.AL = 0 Then P.CPU.Regs.AL := 3;
    P.CPU.Regs.AH := 80;
    P.CPU.Regs.BH := Emu_ReadByte(P.CPU, $40, $62);
   End;
  $10:
   { Set palette registers. Sous-fonctions diverses, on les ignore
     toutes (la palette EGA/VGA n est pas emulee en mode texte). }
   Begin
    Case P.CPU.Regs.AL Of
     $00: { Set EGA palette register : BL=index, BH=value }
       If P.CPU.Regs.BL < 32 Then
        EmuVideo.ACReg[P.CPU.Regs.BL] := P.CPU.Regs.BH;
     $01: EmuVideo.ACReg[$11] := P.CPU.Regs.BH;  { set border color }
     $02: { Set all 16 palette + border : ES:DX = 17 octets }
      Begin
       For I := 0 To 16 Do
        EmuVideo.ACReg[I] := Emu_ReadByte(P.CPU, P.CPU.Segs.ES,
                                          P.CPU.Regs.DX + I);
      End;
     $03: { Toggle intensity / blink bit }
       If (P.CPU.Regs.BL And 1) <> 0 Then
        EmuVideo.ACReg[$10] := EmuVideo.ACReg[$10] Or $08
       Else
        EmuVideo.ACReg[$10] := EmuVideo.ACReg[$10] And $F7;
     $07: { Read EGA palette register : BL = index, retour BH=value }
       If P.CPU.Regs.BL < 32 Then
        P.CPU.Regs.BH := EmuVideo.ACReg[P.CPU.Regs.BL];
     $08: P.CPU.Regs.BH := EmuVideo.ACReg[$11];  { read border }
     $09: { Read all palette : ES:DX = 17 octets }
      Begin
       For I := 0 To 16 Do
        Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I,
                      EmuVideo.ACReg[I]);
      End;
     $10: Begin   { Set DAC entry : BX=index, DH=R, CH=G, CL=B }
       If P.CPU.Regs.BX < 256 Then Begin
        EmuVideo.DAC[P.CPU.Regs.BX * 3 + 0] := P.CPU.Regs.DH And $3F;
        EmuVideo.DAC[P.CPU.Regs.BX * 3 + 1] := P.CPU.Regs.CH And $3F;
        EmuVideo.DAC[P.CPU.Regs.BX * 3 + 2] := P.CPU.Regs.CL And $3F;
        EmuVideo.GfxDirty := True;
       End;
      End;
     $12: Begin   { Set DAC block : BX=start, CX=count, ES:DX=triplets }
       For I := 0 To P.CPU.Regs.CX - 1 Do
        If (P.CPU.Regs.BX + I) < 256 Then Begin
         EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 0] :=
           Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3) And $3F;
         EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 1] :=
           Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3 + 1) And $3F;
         EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 2] :=
           Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3 + 2) And $3F;
        End;
       EmuVideo.GfxDirty := True;
      End;
     $15: Begin   { Read DAC entry : BX=index, retour DH=R, CH=G, CL=B }
       If P.CPU.Regs.BX < 256 Then Begin
        P.CPU.Regs.DH := EmuVideo.DAC[P.CPU.Regs.BX * 3 + 0];
        P.CPU.Regs.CH := EmuVideo.DAC[P.CPU.Regs.BX * 3 + 1];
        P.CPU.Regs.CL := EmuVideo.DAC[P.CPU.Regs.BX * 3 + 2];
       End;
      End;
     $17: Begin   { Read DAC block : BX=start, CX=count, ES:DX=dest }
       For I := 0 To P.CPU.Regs.CX - 1 Do
        If (P.CPU.Regs.BX + I) < 256 Then Begin
         Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3,
           EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 0]);
         Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3 + 1,
           EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 1]);
         Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DX + I*3 + 2,
           EmuVideo.DAC[(P.CPU.Regs.BX + I) * 3 + 2]);
        End;
      End;
     $1A: Begin   { Read combination : BH=color, BL=palette page }
           P.CPU.Regs.BX := $0008;
          End;
    End;
   End;
  $11:
   { Character generator. Sous-fonctions :
     $30 get font info -> ES:BP = adresse fonte, CX=hauteur, DL=lignes-1. }
   Begin
    If P.CPU.Regs.AL = $30 Then Begin
     P.CPU.Segs.ES := $C000;
     P.CPU.Regs.BP := 0;
     P.CPU.Regs.CX := 16;
     P.CPU.Regs.DL := 24;
    End;
   End;
  $12:
   { Video subsystem config. BL=10 -> EGA info. BL=20 alt PrtSc.
     BL=30 select scan lines. BL=32 video CPU access. }
   Begin
    Case P.CPU.Regs.BL Of
     $10: Begin
           P.CPU.Regs.BH := 0;       { color }
           P.CPU.Regs.BL := 3;       { 256K EGA }
           P.CPU.Regs.CH := 0;       { feature bits }
           P.CPU.Regs.CL := 9;       { switch settings }
          End;
     $20: ;                          { alt PrtSc : ignore }
     $30: P.CPU.Regs.AL := $12;      { scan lines OK }
     $32: P.CPU.Regs.AL := $12;      { CPU access toggled }
     $33: P.CPU.Regs.AL := $12;      { gray scale }
     $34: P.CPU.Regs.AL := $12;      { cursor emul }
     $36: P.CPU.Regs.AL := $12;      { video screen on/off }
    End;
   End;
  $13:
   { Write string. ES:BP=string, CX=length, DH/DL=row/col, BH=page.
     AL bit 0 : update cursor a la fin. AL bit 1 : chars+attrs entrelaces. }
   Begin
    EmuVScr_GotoXY(P, P.CPU.Regs.DL, P.CPU.Regs.DH);
    If (P.CPU.Regs.AL And 2) = 0 Then Begin
     P.CurFg := P.CPU.Regs.BL And $0F;
     P.CurBg := (P.CPU.Regs.BL Shr 4) And $07;
    End;
    For I := 0 To P.CPU.Regs.CX - 1 Do Begin
     If (P.CPU.Regs.AL And 2) <> 0 Then Begin
      B := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BP + I * 2);
      Mode := Emu_ReadByte(P.CPU, P.CPU.Segs.ES,
                           P.CPU.Regs.BP + I * 2 + 1);
      P.CurFg := Mode And $0F;
      P.CurBg := (Mode Shr 4) And $07;
     End Else
      B := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BP + I);
     EmuVScr_PutChar(P, Chr(B));
    End;
    If (P.CPU.Regs.AL And 1) = 0 Then
     EmuVScr_GotoXY(P, P.CPU.Regs.DL, P.CPU.Regs.DH);
   End;
  $1A:
   { Display combination. AL=$1A si supporte, BL=combinaison active,
     BH=combinaison alternative. }
   Begin
    P.CPU.Regs.AL := $1A;
    P.CPU.Regs.BL := 8;     { VGA color }
    P.CPU.Regs.BH := 0;
   End;
  $1B:
   { Functionality info. ES:DI -> bloc 64 octets. }
   Begin
    For I := 0 To 63 Do
     Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I), 0);
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + 4,
                  Emu_ReadByte(P.CPU, $40, $49));
    Emu_WriteWord(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + 5, 80);
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + 7, 0);
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + $22, 25);
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + $23, 16);
    P.CPU.Regs.AL := $1B;
   End;
  $1C:
   { Save/restore video state. AL=00 query size, AL=01 save, AL=02 restore. }
   Begin
    P.CPU.Regs.AL := $1C;
    P.CPU.Regs.BX := 64;
   End;
  $4F:
   { VESA SuperVGA BIOS. Non supporte : retourner AH=01 (echec). }
   P.CPU.Regs.AX := $0100;
  $FE, $FF:
   { Topview/DESQview. Stub. }
   ;
  Else
   ;
 End;
End;

{ --- INT 16h : services clavier (BIOS) --- }

{ ============================================================
  INT 16h : services clavier BIOS.
  Implementation complete couvrant clavier standard et etendu.
  La file de touches BIOS est a 0040:001E..003D (16 mots),
  head a 0040:001A, tail a 0040:001C. Les touches non-IBM
  presentes uniquement dans EmuVScr sont fournies en complement.
  ============================================================ }
Procedure Emu_DoInt16(Var P: TEmulatorPanel);
Var
 KW: Word;
 Head: Word;
 LogF_R: Text;
Begin
 Case P.CPU.Regs.AH Of
  $00, $10:
   { Lire la prochaine touche (bloquant). AH=scan, AL=ASCII.
     Retire la touche du buffer. AH=10h gere les touches etendues
     (F11/F12, touches grises) - meme comportement chez nous. }
   Begin
    If Emu_BiosHasKey(P) Then Begin
     P.CPU.Regs.AX := Emu_BiosPopKey(P);
     {$I-} Assign(LogF_R, 'EMUKEY.LOG'); Append(LogF_R);
     If IOResult <> 0 Then Begin Assign(LogF_R,'EMUKEY.LOG'); Rewrite(LogF_R); End;
     WriteLn(LogF_R, 'INT16-Pop AX=', HexWord(P.CPU.Regs.AX));
     Close(LogF_R); {$I+} If IOResult <> 0 Then ;
     If P.CPU.Regs.AL = $0D Then EmuTraceCnt := 400;
    End Else If EmuVScr_HasKey(P) Then Begin
     KW := EmuVScr_PopKey(P);
     P.CPU.Regs.AL := Byte(KW And $FF);
     P.CPU.Regs.AH := Byte((KW Shr 8) And $FF);
     If P.CPU.Regs.AH = 0 Then P.CPU.Regs.AH := P.CPU.Regs.AL;
    End Else
     { Pas de touche : retro-IP de 2 octets pour reexecuter
       INT 16h au prochain step (l hote pompe entre les iterations). }
     Dec(P.CPU.IP, 2);
   End;
  $01, $11:
   { Tester sans bloquer ni retirer. ZF=1 si pas de touche.
     AH=11h supporte F11/F12 (memes valeurs chez nous). }
   Begin
    If Emu_BiosHasKey(P) Then Begin
     Head := Emu_ReadWord(P.CPU, $40, $1A);
     P.CPU.Regs.AX := Emu_ReadWord(P.CPU, $40, Head);
     Exclude(P.CPU.Flags.s, EFG_ZF);
    End Else If EmuVScr_HasKey(P) Then Begin
     KW := P.KeyBuf[P.KeyTail];
     P.CPU.Regs.AL := Byte(KW And $FF);
     P.CPU.Regs.AH := Byte((KW Shr 8) And $FF);
     If P.CPU.Regs.AH = 0 Then P.CPU.Regs.AH := P.CPU.Regs.AL;
     Exclude(P.CPU.Flags.s, EFG_ZF);
    End Else
     Include(P.CPU.Flags.s, EFG_ZF);
   End;
  $02:
   { Etat des touches modificatrices (lit 0040:0017). }
   P.CPU.Regs.AL := Emu_ReadByte(P.CPU, $40, $17);
  $03:
   { AH=03 : set typematic rate. AL=05 = set rate (BL=delay,
     BH=rate). On l ignore (pas de typematic dans l emul). }
   ;
  $05:
   { AH=05 : keyboard write. CX = scan:ascii a inserer dans
     le buffer BIOS. AL=00 succes, AL=01 buffer plein. }
   Begin
    Head := Emu_ReadWord(P.CPU, $40, $1C);  { tail }
    KW := Head + 2;
    If KW >= $3E Then KW := $1E;
    If KW = Emu_ReadWord(P.CPU, $40, $1A) Then
     P.CPU.Regs.AL := 1   { buffer plein }
    Else Begin
     Emu_WriteWord(P.CPU, $40, Head, P.CPU.Regs.CX);
     Emu_WriteWord(P.CPU, $40, $1C, KW);
     P.CPU.Regs.AL := 0;
    End;
   End;
  $09:
   { AH=09 : get keyboard functionality (PS/2). AL = bitmask. }
   P.CPU.Regs.AL := $0F;
  $0A:
   { AH=0A : keyboard ID. BX = ID. $AB41 = 101-key MF II. }
   P.CPU.Regs.BX := $AB41;
  $12:
   { AH=12 : extended shift status. AL = 0040:0017 (comme AH=02),
     AH = 0040:0018 (etat etendu). }
   Begin
    P.CPU.Regs.AL := Emu_ReadByte(P.CPU, $40, $17);
    P.CPU.Regs.AH := Emu_ReadByte(P.CPU, $40, $18);
   End;
  $55:
   { AH=55 : AAS internal (utilise par certains drivers). Ignore. }
   P.CPU.Regs.AL := 0;
  Else
   { Sous-fonction non geree : succes silencieux. }
   ;
 End;
End;

{ --- Executer une interruption DOS (INT 21h) --- }

{ Trouver un handle libre (5..31). Retourne 0 si aucun. }
Function Emu_AllocHandle: Integer;
Var I: Integer;
Begin
  Emu_AllocHandle := 0;
  For I := 5 To 31 Do
    If Not EmuFileOpen[I] Then Begin
      Emu_AllocHandle := I;
      Exit;
    End;
End;

{ Lire la chaine ASCIIZ a Seg:Ofs (max 79 octets). }
Function Emu_ReadAsciiz(Var C: TEmuCPU; Seg, Ofs: Word): String;
Var
  S: String;
  I: Integer;
  B: Byte;
Begin
  S := '';
  For I := 0 To 79 Do Begin
    B := Emu_ReadByte(C, Seg, Ofs + I);
    If B = 0 Then Break;
    S := S + Chr(B);
  End;
  Emu_ReadAsciiz := S;
End;

{ Variante longue (jusqu a 254 caracteres, plafond du type String par      }
{ defaut de ce fichier) - les fonctions LFN Windows 95 (INT 21h/AH=71h,    }
{ Stage 5) annoncent des tampons de chemin jusqu a 260/261 octets, bien    }
{ au-dela des 79 de Emu_ReadAsciiz (suffisants pour les fonctions DOS      }
{ classiques 8.3, jamais pour un nom long reel). }
Function Emu_ReadAsciizLong(Var C: TEmuCPU; Seg, Ofs: Word): String;
Var
  S: String;
  I: Integer;
  B: Byte;
Begin
  S := '';
  For I := 0 To 254 Do Begin
    B := Emu_ReadByte(C, Seg, Ofs + I);
    If B = 0 Then Break;
    S := S + Chr(B);
  End;
  Emu_ReadAsciizLong := S;
End;

{ Ecrire une chaine ASCIZ (terminee par un octet nul) en memoire emulee -  }
{ inverse d Emu_ReadAsciiz/Emu_ReadAsciizLong, reutilise par toutes les    }
{ fonctions LFN qui rendent un chemin/nom au programme appelant. }
Procedure Emu_WriteAsciiz(Var C: TEmuCPU; Seg, Ofs: Word; Const S: String);
Var
  I: Integer;
Begin
  For I := 1 To Length(S) Do
    Emu_WriteByte(C, Seg, Word(Ofs + I - 1), Byte(S[I]));
  Emu_WriteByte(C, Seg, Word(Ofs + Length(S)), 0);
End;

{ Convertir nom DOS en nom hote. Si chemin absolu avec drive (X:\...),
  le passer tel quel a FreePascal Windows (qui le supporte). Sinon
  conversion / -> \, drop des prefixes pour relatif. }
Function Emu_HostPath(Const DosName: String): String;
Var
  S: String;
  I: Integer;
Begin
  S := DosName;
  { Retirer espaces et NUL en queue (champ FCB DOS souvent paddee) }
  While (Length(S) > 0) And ((S[Length(S)] = ' ') Or (S[Length(S)] = #0)) Do
    S := Copy(S, 1, Length(S) - 1);
  { Convertir / en \ d abord }
  For I := 1 To Length(S) Do
    If S[I] = '/' Then S[I] := '\';
  { Si chemin absolu avec drive (X:\...), le passer tel quel }
  If (Length(S) >= 3) And (S[2] = ':') And (S[3] = '\') Then Begin
    { Fallback : si le fichier n existe pas a la racine indiquee
      mais existe dans le dossier de l EXE, utiliser ce dernier.
      Cela permet a QP de trouver QPL.COM, QP.HLP, etc. quand il
      les cherche sur "C:\" sans PATH defini. }
    If (Length(EmuExeDir) > 0) And (Not FileExists(S)) Then Begin
      I := Length(S);
      While (I > 0) And (S[I] <> '\') Do Dec(I);
      If (I > 0) And (I = 3) Then Begin
        { Le fichier est a la racine du drive, ex: C:\QPL.COM }
        Emu_HostPath := EmuExeDir + '\' + Copy(S, 4, Length(S) - 3);
        Exit;
      End;
    End;
    Emu_HostPath := S;
    Exit;
  End;
  { Retirer eventuellement le prefixe drive 'X:' }
  If (Length(S) >= 2) And (S[2] = ':') Then S := Copy(S, 3, Length(S) - 2);
  { Retirer prefixe '\' (chemin absolu DOS -> relatif hote) si present }
  If (Length(S) >= 1) And (S[1] = '\') Then S := Copy(S, 2, Length(S) - 1);
  { Fallback : chemin relatif introuvable dans le repertoire courant
    (celui de DEVENV.exe) -> tenter le repertoire de l EXE charge.
    Indispensable pour TP4/TP5/TP6/QP qui cherchent TURBO.TPL,
    TURBO.HLP, QPL.COM, etc. au repertoire courant. }
  If (Length(EmuExeDir) > 0) And (Not FileExists(S)) Then Begin
    If FileExists(EmuExeDir + '\' + S) Then Begin
      Emu_HostPath := EmuExeDir + '\' + S;
      Exit;
    End;
  End;
  Emu_HostPath := S;
End;

{ Canonicaliser un chemin DOS (AH=60h) : majuscules, '/' -> '\', ajoute la  }
{ lettre de lecteur par defaut (C:) si absente, resout les composants '.'   }
{ et '..'. Pas de suivi reel d un "repertoire courant par lecteur" dans cet }
{ emulateur (aucune convention DOS CHDIR persistante ailleurs non plus) -   }
{ un chemin relatif est donc toujours resolu depuis la racine du lecteur,   }
{ suffisant pour l usage typique (normaliser un chemin deja construit par   }
{ le programme, pas taper un chemin relatif au shell). }
{ Version generalisee (Windows 95, Stage 5, AX=7160h) - UpperCase=True     }
{ reproduit exactement l ancien comportement inconditionnel d             }
{ Emu_CanonicalizePath (AH=60h classique, CL implicite "01h majuscules")   }
{ ; UpperCase=False conserve la casse d origine (CL=00h/02h de 7160h, qui  }
{ documentent explicitement la conservation de casse). }
Function Emu_CanonicalizePathCase(Const DosPath: String; UpperCase: Boolean): String;
Var
 S, Seg, Res: String;
 Parts: Array[0..31] Of String;
 PartCount, CI, P1: Integer;
Begin
 S := DosPath;
 For CI := 1 To Length(S) Do
  If S[CI] = '/' Then S[CI] := '\';
 If UpperCase Then
  For CI := 1 To Length(S) Do
   If S[CI] In ['a'..'z'] Then S[CI] := Chr(Ord(S[CI]) - 32);
 If Not ((Length(S) >= 2) And (S[2] = ':')) Then
  S := 'C:' + S;
 If (Length(S) < 3) Or (S[3] <> '\') Then
  S := Copy(S, 1, 2) + '\' + Copy(S, 3, Length(S) - 2);
 PartCount := 0;
 P1 := 4;
 While P1 <= Length(S) Do Begin
  Seg := '';
  While (P1 <= Length(S)) And (S[P1] <> '\') Do Begin
   Seg := Seg + S[P1]; Inc(P1);
  End;
  Inc(P1);
  If (Seg = '') Or (Seg = '.') Then
   { ignorer }
  Else If Seg = '..' Then Begin
   If PartCount > 0 Then Dec(PartCount);
  End Else If PartCount < 32 Then Begin
   Parts[PartCount] := Seg;
   Inc(PartCount);
  End;
 End;
 Res := Copy(S, 1, 3);
 For CI := 0 To PartCount - 1 Do Begin
  Res := Res + Parts[CI];
  If CI < PartCount - 1 Then Res := Res + '\';
 End;
 Emu_CanonicalizePathCase := Res;
End;

{ Canonicaliser un chemin DOS (AH=60h) : majuscules, '/' -> '\', ajoute la  }
{ lettre de lecteur par defaut (C:) si absente, resout les composants '.'   }
{ et '..'. Pas de suivi reel d un "repertoire courant par lecteur" dans cet }
{ emulateur (aucune convention DOS CHDIR persistante ailleurs non plus) -   }
{ un chemin relatif est donc toujours resolu depuis la racine du lecteur,   }
{ suffisant pour l usage typique (normaliser un chemin deja construit par   }
{ le programme, pas taper un chemin relatif au shell). }
Function Emu_CanonicalizePath(Const DosPath: String): String;
Begin
 Emu_CanonicalizePath := Emu_CanonicalizePathCase(DosPath, True);
End;

{ Conversions calendaires FILETIME<->DOS (Windows 95, Stage 5, AX=71A7h et }
{ FindData de 714Eh/714Fh) - algorithme "days_from_civil"/"civil_from_days"}
{ de Howard Hinnant (calendrier gregorien proleptique, correct sur toute   }
{ la plage utile ici). DaysSinceCivilEpoch est appelee UNIQUEMENT en       }
{ difference (jamais comme date absolue en soi), ce qui evite d avoir a    }
{ deriver a la main la constante de decalage entre son epoque interne      }
{ (0000-03-01) et l epoque reelle de FILETIME (1601-01-01 UTC). }
Function DaysSinceCivilEpoch(Y, M, D: LongInt): LongInt;
Var
 Y2, Era, Yoe, Doy, Doe: LongInt;
Begin
 If M <= 2 Then Y2 := Y - 1 Else Y2 := Y;
 If Y2 >= 0 Then Era := Y2 Div 400 Else Era := (Y2 - 399) Div 400;
 Yoe := Y2 - Era * 400;
 If M > 2 Then Doy := (153 * (M - 3) + 2) Div 5 + D - 1
           Else Doy := (153 * (M + 9) + 2) Div 5 + D - 1;
 Doe := Yoe * 365 + Yoe Div 4 - Yoe Div 100 + Doy;
 DaysSinceCivilEpoch := Era * 146097 + Doe;
End;

Function DaysSince1601(Y, M, D: Word): LongInt;
Begin
 DaysSince1601 := DaysSinceCivilEpoch(LongInt(Y), LongInt(M), LongInt(D))
                - DaysSinceCivilEpoch(1601, 1, 1);
End;

Procedure DaysToCivil(Z: LongInt; Var Y, M, D: LongInt);
Var
 Era, Doe, Yoe, Doy, Mp: LongInt;
Begin
 If Z >= 0 Then Era := Z Div 146097 Else Era := (Z - 146096) Div 146097;
 Doe := Z - Era * 146097;
 Yoe := (Doe - Doe Div 1460 + Doe Div 36524 - Doe Div 146096) Div 365;
 Y := Yoe + Era * 400;
 Doy := Doe - (365 * Yoe + Yoe Div 4 - Yoe Div 100);
 Mp := (5 * Doy + 2) Div 153;
 D := Doy - (153 * Mp + 2) Div 5 + 1;
 If Mp < 10 Then M := Mp + 3 Else M := Mp - 9;
 If M <= 2 Then Y := Y + 1;
End;

{ PackDate/PackTime : meme paquet DOS que SearchRec.Time (haut=date,        }
{ bas=heure) - convertit vers un QWORD FILETIME (100 ns depuis 1601-01-01   }
{ UTC). Pas de fraction de seconde en dessous de la resolution DOS (2 s),   }
{ les 100 ns restent a 0 - limitation documentee, coherente avec le fait    }
{ que Dos.SearchRec ne rend de toute facon qu un seul horodatage a la       }
{ resolution DOS standard. }
Function DosDateTimeToFileTime(PackDate, PackTime: Word): QWord;
Var
 Y, M, D, Hr, Mn, Se: Word;
 Days: LongInt;
 Secs: QWord;
Begin
 Y := ((PackDate Shr 9) And $7F) + 1980;
 M := (PackDate Shr 5) And $0F;
 D := PackDate And $1F;
 If M = 0 Then M := 1;
 If D = 0 Then D := 1;
 Hr := (PackTime Shr 11) And $1F;
 Mn := (PackTime Shr 5) And $3F;
 Se := (PackTime And $1F) * 2;
 Days := DaysSince1601(Y, M, D);
 Secs := QWord(Days) * 86400 + QWord(Hr) * 3600 + QWord(Mn) * 60 + QWord(Se);
 DosDateTimeToFileTime := Secs * 10000000;
End;

{ Inverse : QWORD FILETIME -> paquet DOS date/heure + centiemes BH (0..199,}
{ unites de 10 ms) - utilisee par AX=71A7h/BL=01h. Hors plage DOS valide    }
{ (1980-2107), on plafonne plutot que de deborder silencieusement. }
Procedure FileTimeToDosDateTime(FT: QWord; Var PackDate, PackTime: Word;
 Var Centi: Byte);
Var
 TotalSecs, Rem, Frac100ns: QWord;
 Days: LongInt;
 Hr, Mn, Se: Word;
 Y, M, D: LongInt;
Begin
 Frac100ns := FT Mod 10000000;
 TotalSecs := FT Div 10000000;
 Days := LongInt(TotalSecs Div 86400);
 Rem := TotalSecs Mod 86400;
 Hr := Word(Rem Div 3600); Rem := Rem Mod 3600;
 Mn := Word(Rem Div 60); Se := Word(Rem Mod 60);
 DaysToCivil(Days + DaysSinceCivilEpoch(1601, 1, 1), Y, M, D);
 If Y < 1980 Then Begin Y := 1980; M := 1; D := 1; Hr := 0; Mn := 0; Se := 0; Frac100ns := 0; End;
 If Y > 2107 Then Begin Y := 2107; M := 12; D := 31; Hr := 23; Mn := 59; Se := 58; End;
 PackDate := Word(((LongInt(Y) - 1980) Shl 9) Or (M Shl 5) Or D);
 PackTime := Word((LongInt(Hr) Shl 11) Or (LongInt(Mn) Shl 5) Or (Se Div 2));
 Centi := Byte((Se Mod 2) * 100 + Frac100ns Div 100000);
End;

{ Ecrire une structure FindData de 318 octets (Windows 95, Stage 5,        }
{ AX=714Eh/714Fh - format documente dans DOC/DOS_FOR_WINDOWS95_           }
{ PROGRAMMING.txt section 8) a partir d un TLfnFindEntry deja capture.     }
{ Le meme QWORD FILETIME est ecrit aux 3 emplacements creation/acces/      }
{ ecriture, et le nom court est laisse vide - Dos.SearchRec ne rend qu UN   }
{ seul horodatage et aucun alias 8.3 separe, la meme limitation deja        }
{ documentee pour 7143h/71A6h ; un nom court vide est explicitement         }
{ un etat valide selon la documentation ("le nom court peut etre vide"). }
Procedure Emu_WriteLfnFindData(Var C: TEmuCPU; Seg, Ofs: Word;
 Const E: TLfnFindEntry);
Var
 FT: QWord;
 I: Integer;
Begin
 Emu_WriteWord(C, Seg, Word(Ofs), Word(E.Attr));
 Emu_WriteWord(C, Seg, Word(Ofs + 2), 0);
 FT := DosDateTimeToFileTime(Word((E.Time Shr 16) And $FFFF),
                              Word(E.Time And $FFFF));
 For I := 0 To 2 Do Begin
  Emu_WriteWord(C, Seg, Word(Ofs + 4 + I * 8), Word(FT And $FFFF));
  Emu_WriteWord(C, Seg, Word(Ofs + 4 + I * 8 + 2), Word((FT Shr 16) And $FFFF));
  Emu_WriteWord(C, Seg, Word(Ofs + 4 + I * 8 + 4), Word((FT Shr 32) And $FFFF));
  Emu_WriteWord(C, Seg, Word(Ofs + 4 + I * 8 + 6), Word((FT Shr 48) And $FFFF));
 End;
 Emu_WriteWord(C, Seg, Word(Ofs + $1C), 0);
 Emu_WriteWord(C, Seg, Word(Ofs + $1E), 0);
 Emu_WriteWord(C, Seg, Word(Ofs + $20), Word(E.Size And $FFFF));
 Emu_WriteWord(C, Seg, Word(Ofs + $22), Word((E.Size Shr 16) And $FFFF));
 For I := 0 To 7 Do Emu_WriteByte(C, Seg, Word(Ofs + $24 + I), 0);
 Emu_WriteAsciiz(C, Seg, Word(Ofs + $2C), E.Name);
 Emu_WriteByte(C, Seg, Word(Ofs + $130), 0);
End;

{ Generer un alias 8.3 SANS garantie d unicite (AX=71A8h) - a la difference}
{ de Fat_GenerateUniqueAlias (Stage 4), qui doit garantir l unicite         }
{ puisqu il ecrit reellement une nouvelle entree de repertoire, 71A8h est    }
{ un algorithme purement informatif : le vrai Windows 95 lui-meme ne         }
{ garantit pas l unicite a ce niveau et n ajoute pas de suffixe ~n (voir     }
{ DOC/DOS_FOR_WINDOWS95_PROGRAMMING.txt section 13). Reutilise               }
{ Fat_CleanFor83 (Stage 4) - pure manipulation de chaine, sans dependance    }
{ FatVol malgre son prefixe. }
Procedure Emu_MakeSimpleAlias11(LongName: String; Var N11: Array Of Byte);
Var
 DotPos, I: Integer;
 Base, Ext, CBase, CExt: String;
Begin
 DotPos := 0;
 For I := Length(LongName) DownTo 1 Do
  If LongName[I] = '.' Then Begin DotPos := I; Break; End;
 If DotPos = 0 Then Begin Base := LongName; Ext := ''; End
 Else Begin
  Base := Copy(LongName, 1, DotPos - 1);
  Ext  := Copy(LongName, DotPos + 1, Length(LongName) - DotPos);
 End;
 CBase := Fat_CleanFor83(Base);
 CExt  := Fat_CleanFor83(Ext);
 If Length(CExt) > 3 Then CExt := Copy(CExt, 1, 3);
 If Length(CBase) > 8 Then CBase := Copy(CBase, 1, 8);
 If CBase = '' Then CBase := 'FILE';
 For I := 0 To 10 Do N11[I] := Ord(' ');
 For I := 1 To Length(CBase) Do N11[I - 1] := Ord(CBase[I]);
 For I := 1 To Length(CExt) Do N11[8 + I - 1] := Ord(CExt[I]);
End;

(* ===== ANCIENNE IMPLEMENTATION INT 21h - DESACTIVEE =====
   Conservee comme reference historique, neutralisee par
   commentaire bloc FreePascal. Remplacee par Emu_DoInt21
   propre situee plus bas dans le source.

Procedure Emu_DoInt21_Legacy(Var P: TEmulatorPanel);
Var
 I, J: Integer;
 Ofs: Word;
 B: Byte;
 ExitCode: Word;
 LogF: Text;
 H: Integer;
 K: LongInt;
 FName: String;
 HPath: String;
 IORes: Word;
 BytesIO: Word;
 SeekPos: LongInt;
 IoI, IoJ: LongInt;        { compteurs 32-bit pour AH=3F/40 (fichiers > 32K) }
 Buffer: Array[0..2047] Of Byte;
 OpenMode: Byte;
 Yr, Mo, Dy, Wd: Word;
 Hr, Mn, Sc, Cs: Word;
 RSeg, ROff: Word;
Begin
 { TRACE diagnostic : ecrire chaque INT21h dans EMU21.LOG }
 {$I-}
 Assign(LogF, 'EMU21.LOG');
 Append(LogF);
 If IOResult <> 0 Then Begin
  Assign(LogF, 'EMU21.LOG');
  Rewrite(LogF);
 End;
 WriteLn(LogF, 'INT21h AH=', HexByte(P.CPU.Regs.AH),
   ' AL=', HexByte(P.CPU.Regs.AL),
   ' BX=', HexWord(P.CPU.Regs.BX),
   ' CX=', HexWord(P.CPU.Regs.CX),
   ' DX=', HexWord(P.CPU.Regs.DX),
   ' DS=', HexWord(P.CPU.Segs.DS));
 Close(LogF);
 {$I+}
 If IOResult <> 0 Then ;
 Case P.CPU.Regs.AH Of
  $00:
   P.CPU.Fault := sfEndProgram;
  $02:
   { Afficher le caractere DL }
   EmuVScr_PutChar(P, Chr(P.CPU.Regs.DL));
  $06:
   { Direct console I/O. DL=$FF = lire, autre = ecrire }
   If P.CPU.Regs.DL = $FF Then Begin
    If EmuVScr_HasKey(P) Then Begin
     P.CPU.Regs.AL := EmuVScr_PopKey(P);
     Exclude(P.CPU.Flags.s, EFG_ZF);
    End Else Begin
     P.CPU.Regs.AL := 0;
     Include(P.CPU.Flags.s, EFG_ZF);
    End;
   End Else
    EmuVScr_PutChar(P, Chr(P.CPU.Regs.DL));
  $01, $07, $08:
   { AH=01/07/08 : lecture clavier bloquante DOS. Lit BIOS d abord
     puis EmuVScr ; si vide, retro-deplacer IP pour re-executer
     l INT 21 (la boucle principale continue a pomper l hote). }
   Begin
    If Emu_BiosHasKey(P) Then Begin
     P.CPU.Regs.AL := Byte(Emu_BiosPopKey(P) And $FF);
     If P.CPU.Regs.AH = $01 Then Begin
      EmuVScr_PutChar(P, Chr(P.CPU.Regs.AL));
      { DOS ajoute LF automatiquement apres CR pour fonction 01. }
      If P.CPU.Regs.AL = 13 Then EmuVScr_PutChar(P, #10);
     End;
    End Else If EmuVScr_HasKey(P) Then Begin
     P.CPU.Regs.AL := EmuVScr_PopKey(P);
     If P.CPU.Regs.AH = $01 Then Begin
      EmuVScr_PutChar(P, Chr(P.CPU.Regs.AL));
      If P.CPU.Regs.AL = 13 Then EmuVScr_PutChar(P, #10);
     End;
    End Else
     Dec(P.CPU.IP, 2);
   End;
  $09:
   Begin
    { Afficher la chaine $-terminee a DS:DX, max 4096 caracteres }
    Ofs := P.CPU.Regs.DX;
    For I := 0 To 4095 Do Begin
     B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs + I);
     If Chr(B) = '$' Then Break;
     EmuVScr_PutChar(P, Chr(B));
    End;
   End;
  $4C:
   Begin
    ExitCode := P.CPU.Regs.AL;
    P.CPU.Fault := sfEndProgram;
    P.StatusMsg := 'Programme termine (code ' + IntToStr(ExitCode) + ')';
   End;
  $31:
   Begin
    { AH=31h : Terminate-and-Stay-Resident - traite comme terminaison }
    ExitCode := P.CPU.Regs.AL;
    P.CPU.Fault := sfEndProgram;
    P.StatusMsg := 'Programme termine TSR (code ' + IntToStr(ExitCode) + ')';
   End;
  $40:
   Begin
    { AH=40h : write CX bytes from DS:DX to handle BX }
    Ofs := P.CPU.Regs.DX;
    H := P.CPU.Regs.BX;
    If (H = 1) Or (H = 2) Then Begin
     For I := 0 To P.CPU.Regs.CX - 1 Do Begin
      B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs + I);
      EmuVScr_PutChar(P, Chr(B));
     End;
     {$I-}
     Assign(LogF, 'EMU21.LOG'); Append(LogF);
     If IOResult <> 0 Then Begin Assign(LogF,'EMU21.LOG'); Rewrite(LogF); End;
     Write(LogF, '   AH=40 h=', H, ' msg="');
     For I := 0 To P.CPU.Regs.CX - 1 Do Begin
      B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs + I);
      If (B >= 32) And (B < 127) Then Write(LogF, Chr(B))
      Else Write(LogF, '\x', HexByte(B));
     End;
     WriteLn(LogF, '"');
     Close(LogF);
     {$I+} If IOResult <> 0 Then ;
     P.CPU.Regs.AX := P.CPU.Regs.CX;
     Exclude(P.CPU.Flags.s, EFG_CF);
    End Else If (H >= 5) And (H <= 31) And EmuFileOpen[H] Then Begin
     IoI := 0;
     BytesIO := 0;
     While IoI < P.CPU.Regs.CX Do Begin
      IoJ := LongInt(P.CPU.Regs.CX) - IoI;
      If IoJ > SizeOf(EmuIoBuf) Then IoJ := SizeOf(EmuIoBuf);
      For ExitCode := 0 To IoJ - 1 Do
       EmuIoBuf[ExitCode] := Emu_ReadByte(P.CPU, P.CPU.Segs.DS,
         Word(Ofs + Word(IoI) + ExitCode));
      {$I-} BlockWrite(EmuFileH[H], EmuIoBuf, IoJ, BytesIO); {$I+}
      If IOResult <> 0 Then Break;
      Inc(IoI, BytesIO);
      If BytesIO < IoJ Then Break;
     End;
     P.CPU.Regs.AX := Word(IoI);
     Exclude(P.CPU.Flags.s, EFG_CF);
    End Else Begin
     Include(P.CPU.Flags.s, EFG_CF);
     P.CPU.Regs.AX := 6;  { invalid handle }
    End;
   End;
  $3F:
   Begin
    { AH=3Fh : read CX bytes from handle BX into DS:DX (0=stdin) }
    Ofs := P.CPU.Regs.DX;
    H := P.CPU.Regs.BX;
    I := 0;
    { Diagnostic overlay : si DS<$100 (lecture vers IVT/PSP, donc
      buffer overlay TP non alloue), dumper le DGROUP de TP pour
      identifier les variables runtime (HeapPtr, FreePtr, OvrHeapOrg,
      OvrCodeStart...). Le DGROUP est le segment dans lequel on a
      vu DS=$0F9F lors des appels DOS precedents. }
    If (H >= 5) And (P.CPU.Segs.DS < $0100) And (Not EmuOvrDumped) Then Begin
     EmuOvrDumped := True;
     {$I-}
     Assign(LogF, 'EMU21.LOG'); Append(LogF);
     If IOResult <> 0 Then Begin Assign(LogF,'EMU21.LOG'); Rewrite(LogF); End;
     WriteLn(LogF, '  ## OVR DIAG: DS:DX=', HexWord(P.CPU.Segs.DS),
       ':', HexWord(Word(Ofs)), ' CX=', HexWord(P.CPU.Regs.CX),
       ' ES:DI=', HexWord(P.CPU.Segs.ES), ':', HexWord(P.CPU.Regs.DI),
       ' SS:SP=', HexWord(P.CPU.Segs.SS), ':', HexWord(P.CPU.Regs.SP));
     { Dump du DGROUP suppose (0F9F) : 256 octets en debut + zone HEAP }
     Write(LogF, '  DGROUP@0F9F:0000..00FF :');
     For J := 0 To $FF Do Begin
      If (J And 15) = 0 Then Begin
       WriteLn(LogF);
       Write(LogF, '    ', HexWord(Word(J)), ': ');
      End;
      Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0F9F, Word(J))), ' ');
     End;
     WriteLn(LogF);
     { Variables RTM TP7 typiques (offsets approximatifs) :
       HeapOrg, HeapPtr, FreePtr, FreeMin, OvrHeapOrg, OvrHeapPtr,
       OvrHeapEnd, OvrLoadList, OvrFileHandle. }
     WriteLn(LogF, '  TP RTM probable vars (32-bit pointers little-endian):');
     For J := 0 To 31 Do Begin
      RSeg := Emu_ReadWord(P.CPU, $0F9F, Word(J*4 + 2));
      ROff := Emu_ReadWord(P.CPU, $0F9F, Word(J*4));
      WriteLn(LogF, '    [+', HexWord(Word(J*4)), '] = ',
        HexWord(RSeg), ':', HexWord(ROff));
     End;
     Close(LogF);
     {$I+} If IOResult <> 0 Then ;
    End;
    If H = 0 Then Begin
     { Lecture stdin : drainer BIOS d abord, puis EmuVScr.
       Si rien et CX>0, retro-IP de 2 pour bloquer en attendant
       une touche (DOS standard). }
     While I < P.CPU.Regs.CX Do Begin
      If Emu_BiosHasKey(P) Then
       B := Byte(Emu_BiosPopKey(P) And $FF)
      Else If EmuVScr_HasKey(P) Then
       B := Byte(EmuVScr_PopKey(P) And $FF)
      Else Break;
      Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + I, B);
      Inc(I);
      EmuVScr_PutChar(P, Chr(B));
      If B = 13 Then Begin
       EmuVScr_PutChar(P, #10);
       If I < P.CPU.Regs.CX Then Begin
        Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + I, 10);
        Inc(I);
       End;
       Break;
      End;
     End;
     If (I = 0) And (P.CPU.Regs.CX > 0) Then Begin
      { Aucune touche : retro-IP de 2 pour reexecuter l INT 21
        au prochain step. La boucle principale pompe le clavier. }
      Dec(P.CPU.IP, 2);
      Exit;
     End;
     P.CPU.Regs.AX := Word(I);
     Exclude(P.CPU.Flags.s, EFG_CF);
    End Else If (H >= 5) And (H <= 31) And EmuFileOpen[H] Then Begin
     BytesIO := 0;
     IORes := 0;
     IoI := 0;
     While IoI < P.CPU.Regs.CX Do Begin
      IoJ := LongInt(P.CPU.Regs.CX) - IoI;
      If IoJ > SizeOf(EmuIoBuf) Then IoJ := SizeOf(EmuIoBuf);
      {$I-} BlockRead(EmuFileH[H], EmuIoBuf, IoJ, BytesIO); {$I+}
      IORes := IOResult;
      If IORes <> 0 Then Break;
      { BUG FIX : si BytesIO=0 (EOF), ne PAS entrer dans For 0 To BytesIO-1
        car BytesIO-1 wrap a $FFFF (Word) -> 65536 ecritures de garbage. }
      If BytesIO > 0 Then
       For ExitCode := 0 To BytesIO - 1 Do
        Emu_WriteByte(P.CPU, P.CPU.Segs.DS,
          Word(Ofs + Word(IoI) + ExitCode), EmuIoBuf[ExitCode]);
      Inc(IoI, BytesIO);
      If BytesIO < IoJ Then Break;
     End;
     P.CPU.Regs.AX := Word(IoI);
     Exclude(P.CPU.Flags.s, EFG_CF);
     If EmuFileFirstRd[H] Then Begin
      EmuFileFirstRd[H] := False;
      {$I-} Assign(LogF,'EMU21.LOG'); Append(LogF);
      If IOResult <> 0 Then Begin Assign(LogF,'EMU21.LOG'); Rewrite(LogF); End;
      Write(LogF, '  3F FIRST READ h=', H, ' name="', EmuFileName[H],
       '" req=', P.CPU.Regs.CX, ' got=', IoI, ' iores=', IORes,
       ' fpos=', FilePos(EmuFileH[H]),
       ' fsize=', FileSize(EmuFileH[H]),
       ' bytes=');
      For ExitCode := 0 To 15 Do
       If ExitCode < IoI Then
        Write(LogF, HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs + ExitCode)),' ');
      WriteLn(LogF);
      Close(LogF); {$I+} If IOResult <> 0 Then ;
     End;
    End Else Begin
     Include(P.CPU.Flags.s, EFG_CF);
     P.CPU.Regs.AX := 6;
    End;
   End;
  $30:
   Begin
    { AH=30h : DOS version. Renvoyer 3.30 (AL=3 AH=1Eh = 30 dec).
      TP4 (1987) cible DOS 2.x/3.x ; renvoyer 6.22 fait croire a TP4
      qu il tourne sur un DOS futur, ce qui peut perturber certains
      checks internes. }
    P.CPU.Regs.AL := 3;
    P.CPU.Regs.AH := 30;  { decimal 30 = $1E (DOS 3.30) }
    P.CPU.Regs.BX := 0;
    P.CPU.Regs.CX := 0;
   End;
  $19:
   { AH=19h : current default drive. C: = 2 }
   P.CPU.Regs.AL := 2;
  $25:
   Begin
    { AH=25h : set interrupt vector AL = DS:DX. Ecrit dans l IVT
      a l adresse physique 0000:AL*4 (offset puis segment). }
    Ofs := Word(P.CPU.Regs.AL) * 4;
    Emu_WriteByte(P.CPU, 0, Ofs,     Byte(P.CPU.Regs.DX And $FF));
    Emu_WriteByte(P.CPU, 0, Ofs + 1, Byte(P.CPU.Regs.DX Shr 8));
    Emu_WriteByte(P.CPU, 0, Ofs + 2, Byte(P.CPU.Segs.DS And $FF));
    Emu_WriteByte(P.CPU, 0, Ofs + 3, Byte(P.CPU.Segs.DS Shr 8));
   End;
  $35:
   Begin
    { AH=35h : get interrupt vector AL -> ES:BX. Lit l IVT a 0000:AL*4. }
    Ofs := Word(P.CPU.Regs.AL) * 4;
    P.CPU.Regs.BX := Emu_ReadWord(P.CPU, 0, Ofs);
    P.CPU.Segs.ES := Emu_ReadWord(P.CPU, 0, Ofs + 2);
   End;
  $3D:
   Begin
    { AH=3Dh : open existing file. DS:DX -> ASCIIZ name. AL = mode. }
    FName := Emu_ReadAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
    HPath := Emu_HostPath(FName);
    {$I-}
    Assign(LogF, 'EMU21.LOG'); Append(LogF);
    WriteLn(LogF, '  3D OPEN dos="', FName, '" host="', HPath, '"');
    { Tracer la chaine d appels : remonter les BP pour identifier les
      callers TP (chaque frame = saved BP + ret IP + ret CS). }
    Ofs := P.CPU.Regs.BP;
    For I := 0 To 6 Do Begin
     Write(LogF, '     frame[', I, '] BP=', HexWord(Ofs),
       ' ret=', HexWord(Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(Ofs + 4))),
       ':', HexWord(Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Word(Ofs + 2))));
     WriteLn(LogF);
     Ofs := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, Ofs);
     If (Ofs = 0) Or (Ofs > $FF00) Then Break;
    End;
    Close(LogF);
    {$I+} If IOResult <> 0 Then ;
    { Dump une seule fois du caller pour analyse offline }
    If Not EmuCallDumped Then Begin
    EmuCallDumped := True;
    {$I-}
    Assign(LogF, 'EMUCALL.LOG'); Append(LogF);
    If IOResult <> 0 Then Begin
     Assign(LogF, 'EMUCALL.LOG'); Rewrite(LogF);
    End;
    WriteLn(LogF, 'Caller code at 00E6:0000..00FF :');
    For I := 0 To 255 Do Begin
     If (I And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(I), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $00E6, Word(I))), ' ');
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'Stack frame data 0F9F:A100..A2A0 :');
    K := $A100;
    While K <= $A2A0 Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0F9F, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'Local buffers 0F9F:9FD0..A0E0 :');
    K := $9FD0;
    While K <= $A0E0 Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0F9F, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'Sub at 0EB5:0890..097F :');
    K := $0890;
    While K <= $097F Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0EB5, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'Sub at 0B98:0040..00FF :');
    K := $0040;
    While K <= $00FF Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0B98, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'TP runtime PSP word at 0F9F:[4756] = ',
      HexWord(Emu_ReadWord(P.CPU, $0F9F, $4756)));
    WriteLn(LogF, 'Env block at 0051:0000..003F :');
    K := 0;
    While K <= $003F Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0051, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    WriteLn(LogF, 'PSP at 0060:002C (env seg) = ',
      HexWord(Emu_ReadWord(P.CPU, $0060, $002C)));
    WriteLn(LogF, 'PSP block at 0060:0000..003F :');
    K := 0;
    While K <= $003F Do Begin
     If (K And 15) = 0 Then Begin
      WriteLn(LogF);
      Write(LogF, HexWord(Word(K)), ': ');
     End;
     Write(LogF, HexByte(Emu_ReadByte(P.CPU, $0060, Word(K))), ' ');
     Inc(K);
    End;
    WriteLn(LogF);
    Close(LogF);
    {$I+} If IOResult <> 0 Then ;
    End;
    H := Emu_AllocHandle;
    If (H = 0) Or (Length(HPath) = 0) Then Begin
      Include(P.CPU.Flags.s, EFG_CF);
      P.CPU.Regs.AX := 4;  { too many open files }
    End Else Begin
      Assign(EmuFileH[H], HPath);
      OpenMode := P.CPU.Regs.AL And 3;
      {$I-} Reset(EmuFileH[H], 1); {$I+}
      IORes := IOResult;
      If IORes <> 0 Then Begin
        Include(P.CPU.Flags.s, EFG_CF);
        P.CPU.Regs.AX := 2;  { file not found }
      End Else Begin
        EmuFileOpen[H] := True;
        EmuFileName[H] := HPath;
        EmuFileMode[H] := OpenMode;
        EmuFileFirstRd[H] := True;
        Exclude(P.CPU.Flags.s, EFG_CF);
        P.CPU.Regs.AX := H;
      End;
    End;
   End;  $3E:
   Begin
    { AH=3Eh : close handle BX }
    H := P.CPU.Regs.BX;
    If (H >= 5) And (H <= 31) And EmuFileOpen[H] Then Begin
      {$I-} Close(EmuFileH[H]); {$I+}
      If IOResult <> 0 Then ;
      EmuFileOpen[H] := False;
    End;
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  $3C:
   Begin
    { AH=3Ch : create or truncate file. DS:DX = ASCIIZ, CX = attributes. }
    FName := Emu_ReadAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
    HPath := Emu_HostPath(FName);
    H := Emu_AllocHandle;
    If (H = 0) Or (Length(HPath) = 0) Then Begin
      Include(P.CPU.Flags.s, EFG_CF);
      P.CPU.Regs.AX := 4;
    End Else Begin
      Assign(EmuFileH[H], HPath);
      {$I-} Rewrite(EmuFileH[H], 1); {$I+}
      IORes := IOResult;
      If IORes <> 0 Then Begin
        Include(P.CPU.Flags.s, EFG_CF);
        P.CPU.Regs.AX := 5;  { access denied }
      End Else Begin
        EmuFileOpen[H] := True;
        EmuFileName[H] := HPath;
        EmuFileMode[H] := 2;
        Exclude(P.CPU.Flags.s, EFG_CF);
        P.CPU.Regs.AX := H;
      End;
    End;
   End;
  $5B:
   Begin
    { AH=5Bh : create new file (fail if exists). DS:DX = ASCIIZ. }
    FName := Emu_ReadAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
    HPath := Emu_HostPath(FName);
    Assign(EmuFileH[5], HPath);
    {$I-} Reset(EmuFileH[5], 1); {$I+}
    If IOResult = 0 Then Begin
      Close(EmuFileH[5]);
      Include(P.CPU.Flags.s, EFG_CF);
      P.CPU.Regs.AX := 80;  { file exists }
    End Else Begin
      H := Emu_AllocHandle;
      If H = 0 Then Begin
        Include(P.CPU.Flags.s, EFG_CF);
        P.CPU.Regs.AX := 4;
      End Else Begin
        Assign(EmuFileH[H], HPath);
        {$I-} Rewrite(EmuFileH[H], 1); {$I+}
        If IOResult <> 0 Then Begin
          Include(P.CPU.Flags.s, EFG_CF);
          P.CPU.Regs.AX := 5;
        End Else Begin
          EmuFileOpen[H] := True;
          EmuFileName[H] := HPath;
          EmuFileMode[H] := 2;
          Exclude(P.CPU.Flags.s, EFG_CF);
          P.CPU.Regs.AX := H;
        End;
      End;
    End;
   End;
  $41:
   Begin
    { AH=41h : delete file DS:DX }
    FName := Emu_ReadAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
    HPath := Emu_HostPath(FName);
    {$I-}
    Assign(LogF, 'EMU21.LOG'); Append(LogF);
    WriteLn(LogF, '  41 DELETE dos="', FName, '" host="', HPath, '" -- IGNORE');
    Close(LogF);
    {$I+} If IOResult <> 0 Then ;
    { Securite : NE PAS supprimer reellement les fichiers, simuler succes. }
    Exclude(P.CPU.Flags.s, EFG_CF);
    P.CPU.Regs.AX := 0;
   End;
  $42:
   Begin
    { AH=42h LSEEK : DX:AX = position resultante.
      AL=00 from start, AL=01 from current, AL=02 from end. }
    H := P.CPU.Regs.BX;
    SeekPos := (LongInt(P.CPU.Regs.CX) Shl 16) Or P.CPU.Regs.DX;
    If (H >= 5) And (H <= 31) And EmuFileOpen[H] Then Begin
     Case P.CPU.Regs.AL Of
      $00: ;
      $01: SeekPos := SeekPos + FilePos(EmuFileH[H]);
      $02: SeekPos := SeekPos + FileSize(EmuFileH[H]);
     End;
     If SeekPos < 0 Then SeekPos := 0;
     {$I-} Seek(EmuFileH[H], SeekPos); {$I+}
     If IOResult <> 0 Then ;
     P.CPU.Regs.AX := Word(SeekPos And $FFFF);
     P.CPU.Regs.DX := Word((SeekPos Shr 16) And $FFFF);
     Exclude(P.CPU.Flags.s, EFG_CF);
    End Else Begin
     { stdin/stdout : pas reellement seekable }
     Exclude(P.CPU.Flags.s, EFG_CF);
     If P.CPU.Regs.AL = $02 Then Begin
      P.CPU.Regs.AX := 0; P.CPU.Regs.DX := 0;
     End Else Begin
      P.CPU.Regs.AX := P.CPU.Regs.DX;
      P.CPU.Regs.DX := P.CPU.Regs.CX;
     End;
    End;
   End;
  $44:
   Begin
    { AH=44h IOCTL : detection peripherique caractere vs fichier }
    Case P.CPU.Regs.AL Of
     $00:
      Begin
       { Get Device Information : DX = info. Bit 7 = char device. }
       If P.CPU.Regs.BX <= 4 Then
        P.CPU.Regs.DX := $80D3
       Else
        P.CPU.Regs.DX := $0000;
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     Else
      Exclude(P.CPU.Flags.s, EFG_CF);
    End;
   End;
  $48:
   { AH=48h : allocate memory. BX = paragraphes demandes.
     Retour : si succes AX=segment, CF=0. Si echec CF=1, AX=8,
     BX=plus grand bloc disponible (pratique : TP appelle d abord
     avec BX=$FFFF pour interroger la taille maximum). }
   Begin
    If EmuNextFreeSeg = 0 Then EmuNextFreeSeg := $2000;
    { Calculer les paragraphes disponibles jusqu a $9F00. }
    If EmuNextFreeSeg >= $9F00 Then K := 0
    Else K := LongInt($9F00) - LongInt(EmuNextFreeSeg);
    If LongInt(P.CPU.Regs.BX) > K Then Begin
     { Echec : pas assez de memoire }
     Include(P.CPU.Flags.s, EFG_CF);
     P.CPU.Regs.AX := 8;
     P.CPU.Regs.BX := Word(K);
    End Else Begin
     P.CPU.Regs.AX := EmuNextFreeSeg;
     EmuNextFreeSeg := EmuNextFreeSeg + P.CPU.Regs.BX;
     Exclude(P.CPU.Flags.s, EFG_CF);
    End;
   End;  $49:
   { AH=49h free memory : succes simule }
   Begin
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  $4A:
   { AH=4Ah : resize memory block ES = AL = result.
     Si BX > paragraphes disponibles depuis ES jusqu a $9FFF inclus,
     retourner CF=1 + BX = max disponible (TP s en sert pour decouvrir
     la taille de son bloc memoire au demarrage). }
   Begin
    If LongInt(P.CPU.Segs.ES) + LongInt(P.CPU.Regs.BX) > LongInt($A000) Then Begin
     Include(P.CPU.Flags.s, EFG_CF);
     P.CPU.Regs.BX := Word($A000 - P.CPU.Segs.ES);
     P.CPU.Regs.AX := 8;     { code erreur : insufficient memory }
    End Else Begin
     Exclude(P.CPU.Flags.s, EFG_CF);
    End;
   End;
  $62:
   { AH=62h : get PSP segment }
   P.CPU.Regs.BX := EmuPspSeg;
  $1A:
   Begin
    { AH=1Ah : set DTA = DS:DX }
    EmuDtaSeg := P.CPU.Segs.DS;
    EmuDtaOfs := P.CPU.Regs.DX;
   End;
  $2F:
   Begin
    { AH=2Fh : get DTA -> ES:BX }
    P.CPU.Segs.ES := EmuDtaSeg;
    P.CPU.Regs.BX := EmuDtaOfs;
   End;
  $2A:
   Begin
    { AH=2Ah : get system date }
    GetDate(Yr, Mo, Dy, Wd);
    P.CPU.Regs.CX := Yr;
    P.CPU.Regs.DH := Byte(Mo);
    P.CPU.Regs.DL := Byte(Dy);
    P.CPU.Regs.AL := Byte(Wd);
   End;
  $2C:
   Begin
    { AH=2Ch : get system time }
    GetTime(Hr, Mn, Sc, Cs);
    P.CPU.Regs.CH := Byte(Hr);
    P.CPU.Regs.CL := Byte(Mn);
    P.CPU.Regs.DH := Byte(Sc);
    P.CPU.Regs.DL := Byte(Cs);
   End;
  $36:
   Begin
    { AH=36h : get free disk space. Renvoyer 64Mo libres. }
    P.CPU.Regs.AX := 8;        { sectors per cluster }
    P.CPU.Regs.BX := 16384;    { available clusters }
    P.CPU.Regs.CX := 512;      { bytes per sector }
    P.CPU.Regs.DX := 32768;    { total clusters }
   End;
  $47:
   Begin
    { AH=47h : get current dir into DS:SI (max 64). DL = drive (0=current). }
    Emu_WriteByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI, 0);
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  $50:
   { AH=50h : set PSP segment (BX) - on l ignore }
   ;
  $51:
   { AH=51h : get current PSP -> BX }
   P.CPU.Regs.BX := EmuPspSeg;
  $33:
   Begin
    { AH=33h : Ctrl-Break check. AL=00 get -> DL=state ; AL=01 set ignored. }
    If P.CPU.Regs.AL = 0 Then P.CPU.Regs.DL := 0;
   End;
  $38:
   Begin
    { AH=38h : country info. Renvoyer DL=0 (US) et CF=0. }
    Exclude(P.CPU.Flags.s, EFG_CF);
    P.CPU.Regs.AX := 1;        { US country code }
   End;
  Else
   { Fonction DOS non supportee dans cette livraison : on ignore }
   ;
 End;
End;
*)

{ ============================================================
  Implementation propre et complete de INT 21h (DOS API).
  Couvre les fonctions DOS handle-based jusqu a la version 5.0.
  Les fonctions FCB sont des stubs qui renvoient AL=$FF (echec)
  car DEV-COOLS utilise exclusivement les handles.
  ============================================================ }

{ Helpers DOS internes. }

Function Emu_PackDate(Y, M, D: Word): Word;
Begin
 If Y >= 1980 Then Y := Y - 1980 Else Y := 0;
 Emu_PackDate := (Y Shl 9) Or (M Shl 5) Or D;
End;

Function Emu_PackTime(H, M, S: Word): Word;
Begin
 Emu_PackTime := (H Shl 11) Or (M Shl 5) Or (S Shr 1);
End;

Procedure Emu_SetDosErr(Var P: TEmulatorPanel; Code: Word);
Begin
 EmuExtErr := Code;
 EmuExtErrCls := $0B;
 EmuExtErrAct := $07;
 EmuExtErrLoc := $03;
 Include(P.CPU.Flags.s, EFG_CF);
 P.CPU.Regs.AX := Code;
End;

{ Fin de programme "gracieuse" (AH=00h/31h/4Ch) : si un INT 21h AH=4Bh       }
{ (EXEC) est en cours (EmuExecDepth>0), on "revient" au parent - restaure   }
{ son contexte CPU + etat DOS "par processus" - au lieu de terminer toute   }
{ la session emulateur. Sinon, comportement inchange (fin de session).      }
{ EmuExitCode/EmuExitType restent DELIBEREMENT non touches ici : deja       }
{ assignes par l appelant juste avant, ils doivent "remonter" au parent     }
{ pour qu AH=4Dh (get return code) lise le code de sortie de l enfant.      }
Procedure Emu_DosTerminate(Var P: TEmulatorPanel; Const NormalMsg: String);
Begin
 If EmuExecDepth > 0 Then Begin
  Dec(EmuExecDepth);
  P.CPU.Regs  := EmuExecStack[EmuExecDepth].Regs;
  P.CPU.Segs  := EmuExecStack[EmuExecDepth].Segs;
  P.CPU.Flags := EmuExecStack[EmuExecDepth].Flags;
  P.CPU.IP    := EmuExecStack[EmuExecDepth].IP;
  EmuPspSeg := EmuExecStack[EmuExecDepth].PspSeg;
  EmuDtaSeg := EmuExecStack[EmuExecDepth].DtaSeg;
  EmuDtaOfs := EmuExecStack[EmuExecDepth].DtaOfs;
  EmuExeDir := EmuExecStack[EmuExecDepth].ExeDir;
  EmuFindIsCdrom := EmuExecStack[EmuExecDepth].FindIsCdrom;
  { Move() plutot que := : tableaux anonymes de meme forme mais de types    }
  { distincts pour FPC (meme convention que DOS_SaveState/DOS_LoadState).   }
  Move(EmuExecStack[EmuExecDepth].CdFindSize, EmuCdFindSize, SizeOf(EmuCdFindSize));
  Move(EmuExecStack[EmuExecDepth].CdFindIsDir, EmuCdFindIsDir, SizeOf(EmuCdFindIsDir));
  Move(EmuExecStack[EmuExecDepth].CdFindDate, EmuCdFindDate, SizeOf(EmuCdFindDate));
  Move(EmuExecStack[EmuExecDepth].CdFindTime, EmuCdFindTime, SizeOf(EmuCdFindTime));
  EmuFindMask := EmuExecStack[EmuExecDepth].FindMask;
  EmuFindAttr := EmuExecStack[EmuExecDepth].FindAttr;
  Move(EmuExecStack[EmuExecDepth].FindResults, EmuFindResults, SizeOf(EmuFindResults));
  EmuFindCount := EmuExecStack[EmuExecDepth].FindCount;
  EmuFindIndex := EmuExecStack[EmuExecDepth].FindIndex;
  EmuExtErr := EmuExecStack[EmuExecDepth].ExtErr;
  EmuExtErrCls := EmuExecStack[EmuExecDepth].ExtErrCls;
  EmuExtErrAct := EmuExecStack[EmuExecDepth].ExtErrAct;
  EmuExtErrLoc := EmuExecStack[EmuExecDepth].ExtErrLoc;
  Exclude(P.CPU.Flags.s, EFG_CF);  { EXEC "reussit" du point de vue du parent }
  P.StatusMsg := '';
 End Else Begin
  P.CPU.Fault := sfEndProgram;
  P.StatusMsg := NormalMsg;
 End;
End;

{ Coeur partage de l ouverture/creation etendue AH=6Ch (DOS 4+) - extrait   }
{ tel quel du corps original du case $6C pour etre reutilise par AX=716Ch   }
{ (Windows 95, Stage 5) : les deux fonctions sont IDENTIQUES cote hote (le  }
{ systeme de fichiers Windows reel gere deja nativement les noms longs,     }
{ Emu_HostPath les laisse passer tels quels) - seule la maniere de LIRE le  }
{ nom depuis la memoire emulee differe entre les deux appelants (79         }
{ caracteres classique vs 254 pour un nom long, voir Emu_ReadAsciizLong).   }
{ BL=mode de partage, DL=action si existe/n existe pas (bits bas/hauts),    }
{ retourne AX=handle, CX=action realisee (1=ouvert existant, 2=tronque      }
{ existant, 3=cree). }
Procedure Emu_DoOpen6C(Var P: TEmulatorPanel; Const FName: String);
Var
 HPath: String;
 H: Integer;
 K: LongInt;
 OpenMode: Byte;
Begin
 HPath := Emu_HostPath(FName);
 OpenMode := P.CPU.Regs.BL And 3;
 H := Emu_AllocHandle;
 If H = 0 Then
  Emu_SetDosErr(P, 4)
 Else If FileExists(HPath) Then Begin
  If (P.CPU.Regs.DL And $0F) = 0 Then
   Emu_SetDosErr(P, 80)
  Else Begin
   Assign(EmuFileH[H], HPath);
   If (P.CPU.Regs.DL And $0F) = 2 Then Begin
    {$I-} Rewrite(EmuFileH[H], 1); {$I+}
    K := 2;
   End Else Begin
    {$I-} Reset(EmuFileH[H], 1); {$I+}
    K := 1;
   End;
   If IOResult <> 0 Then
    Emu_SetDosErr(P, 5)
   Else Begin
    EmuFileOpen[H] := True; EmuFileIsCdrom[H] := False;
    EmuFileName[H] := HPath; EmuFileMode[H] := OpenMode; EmuFileFirstRd[H] := True;
    P.CPU.Regs.AX := H; P.CPU.Regs.CX := Word(K);
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
 End Else Begin
  If ((P.CPU.Regs.DL Shr 4) And $0F) = 0 Then
   Emu_SetDosErr(P, 2)
  Else Begin
   Assign(EmuFileH[H], HPath);
   {$I-} Rewrite(EmuFileH[H], 1); {$I+}
   If IOResult <> 0 Then
    Emu_SetDosErr(P, 5)
   Else Begin
    EmuFileOpen[H] := True; EmuFileIsCdrom[H] := False;
    EmuFileName[H] := HPath; EmuFileMode[H] := OpenMode; EmuFileFirstRd[H] := True;
    P.CPU.Regs.AX := H; P.CPU.Regs.CX := 3;
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
 End;
End;

Procedure Emu_DoInt21(Var P: TEmulatorPanel);
Var
 I: Integer;
 Ofs, Ofs2: Word;
 B: Byte;
 H, H2: Integer;
 K: LongInt;
 FName, HPath: String;
 IORes: Word;
 BytesIO: Word;
 SeekPos: LongInt;
 IoI, IoJ: LongInt;
 OpenMode: Byte;
 Yr, Mo, Dy, Wd: Word;
 Hr, Mn, Sc, Cs: Word;
 W: Word;
 SR: SearchRec;
 KW: Word;
 { --- CD-ROM ISO9660 (voir Emu_CdromDriveFromPath/Emu_IsoResolve) --- }
 CdIdx: Integer;
 CdRel, CdDir, CdPattern: String;
 CdErr: Word;
 CdSplit: Integer;
 CdEntry: TEmuIsoEntry;
 { --- AH=4Bh EXEC (voir Emu_DosTerminate pour le retour au parent) --- }
 ExecChildPath, ExecHostPath, ExecCmdTail, ExecExt: String;
 ExecFrame: TEmuExecFrame;
 ExecChildSeg, ExecTailOfs, ExecTailSeg: Word;
 ExecTailLen: Byte;
 ExecLoadOk: Boolean;
 ExecI: Integer;
 { --- FCB (AH=0Fh/10h/14h/16h/29h) : voir Emu_FcbParse/Emu_FcbBuildName --- }
 FcbName, FcbExt: String;
 FcbDrive: Byte;
 FcbH: Integer;
 FcbRecSize: Word;
 FcbAbsRec: LongInt;
 FcbBytesIO: Word;
 FcbI: Integer;
 FcbHasWild: Boolean;
 { --- AH=71h : API de noms longs Windows 95 (Stage 5), voir              }
 { DOC/DOS_FOR_WINDOWS95_PROGRAMMING.txt section 4+ --- }
 LName, LName2, LHost, LHost2: String;
 LN11: Array[0..10] Of Byte;
 LAttrW: Word;
 LTimeVal: LongInt;
 LPackDate, LPackTime: Word;
 LCenti: Byte;
 LFT: QWord;
 LFindCnt: Integer;
Begin
 Case P.CPU.Regs.AH Of
  $00:
   Begin
    EmuExitCode := 0;
    EmuExitType := 0;
    Emu_DosTerminate(P, '');
   End;
  $01:
   Begin
    If Emu_BiosHasKey(P) Then KW := Emu_BiosPopKey(P)
    Else If EmuVScr_HasKey(P) Then KW := EmuVScr_PopKey(P)
    Else Begin Dec(P.CPU.IP, 2); Exit; End;
    P.CPU.Regs.AL := Byte(KW And $FF);
    EmuVScr_PutChar(P, Chr(P.CPU.Regs.AL));
   End;
  $02:
   EmuVScr_PutChar(P, Chr(P.CPU.Regs.DL));
  $03:
   P.CPU.Regs.AL := 0;
  $04:
   ;
  $05:
   ;
  $06:
   Begin
    If P.CPU.Regs.DL = $FF Then Begin
     If Emu_BiosHasKey(P) Then Begin
      KW := Emu_BiosPopKey(P);
      P.CPU.Regs.AL := Byte(KW And $FF);
      Exclude(P.CPU.Flags.s, EFG_ZF);
     End Else If EmuVScr_HasKey(P) Then Begin
      P.CPU.Regs.AL := EmuVScr_PopKey(P);
      Exclude(P.CPU.Flags.s, EFG_ZF);
     End Else Begin
      P.CPU.Regs.AL := 0;
      Include(P.CPU.Flags.s, EFG_ZF);
     End;
    End Else
     EmuVScr_PutChar(P, Chr(P.CPU.Regs.DL));
   End;
  $07, $08:
   Begin
    If Emu_BiosHasKey(P) Then P.CPU.Regs.AL := Byte(Emu_BiosPopKey(P) And $FF)
    Else If EmuVScr_HasKey(P) Then P.CPU.Regs.AL := EmuVScr_PopKey(P)
    Else Dec(P.CPU.IP, 2);
   End;
  $09:
   Begin
    Ofs := P.CPU.Regs.DX;
    For I := 0 To 8191 Do Begin
     B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs + I);
     If Chr(B) = '$' Then Break;
     EmuVScr_PutChar(P, Chr(B));
    End;
    P.CPU.Regs.AL := Ord('$');
   End;
  $0A:
   Begin
    Ofs := P.CPU.Regs.DX;
    H := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Ofs);
    If H = 0 Then Begin
     Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + 1, 0);
     Exit;
    End;
    I := 0;
    Repeat
     If Emu_BiosHasKey(P) Then KW := Emu_BiosPopKey(P)
     Else If EmuVScr_HasKey(P) Then KW := EmuVScr_PopKey(P)
     Else Begin Dec(P.CPU.IP, 2); Exit; End;
     B := Byte(KW And $FF);
     If B = 13 Then Begin
      Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + 2 + I, 13);
      EmuVScr_PutChar(P, #13);
      EmuVScr_PutChar(P, #10);
      Break;
     End;
     If B = 8 Then Begin
      If I > 0 Then Begin
       Dec(I);
       EmuVScr_PutChar(P, #8);
       EmuVScr_PutChar(P, ' ');
       EmuVScr_PutChar(P, #8);
      End;
     End Else If (B >= 32) And (I < H - 1) Then Begin
      Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + 2 + I, B);
      Inc(I);
      EmuVScr_PutChar(P, Chr(B));
     End;
    Until False;
    Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Ofs + 1, Byte(I));
   End;
  $0B:
   Begin
    If Emu_BiosHasKey(P) Or EmuVScr_HasKey(P) Then P.CPU.Regs.AL := $FF
    Else P.CPU.Regs.AL := $00;
   End;
  $0C:
   Begin
    While Emu_BiosHasKey(P) Do Emu_BiosPopKey(P);
    While EmuVScr_HasKey(P) Do EmuVScr_PopKey(P);
    Case P.CPU.Regs.AL Of
     $01, $06, $07, $08, $0A:
      Begin
       P.CPU.Regs.AH := P.CPU.Regs.AL;
       Emu_DoInt21(P);
      End;
    End;
   End;
  $0D:
   ;
  $0E:
   P.CPU.Regs.AL := 4;
  $0F:
   { Ouvrir un fichier via FCB (DS:DX = FCB non ouvert : drive(1) +          }
   { nom(8) + ext(3), espaces en padding). Le "handle" hote interne est      }
   { stocke dans l octet reserve du FCB a l offset 24 (jamais interprete     }
   { par le programme invite, purement une convention de cet emulateur -    }
   { voir AH=10h/14h qui le relisent). Necessaire : decouvert en tracant      }
   { NCMAIN.EXE (via NC.EXE/EXEC) - 47600 appels AH=0Fh, tous en echec       }
   { immediat faute d implementation, entrainant une cascade de messages     }
   { d erreur affiches caractere par caractere (AH=02, 71961 appels) qui      }
   { se chevauchent a l ecran faute d effacement propre entre essais. }
   Begin
    FcbName := '';
    For FcbI := 1 To 8 Do Begin
     B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + FcbI);
     If B <> 32 Then FcbName := FcbName + Chr(B);
    End;
    FcbExt := '';
    For FcbI := 9 To 11 Do Begin
     B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + FcbI);
     If B <> 32 Then FcbExt := FcbExt + Chr(B);
    End;
    FName := FcbName;
    If FcbExt <> '' Then FName := FName + '.' + FcbExt;
    HPath := Emu_HostPath(FName);
    If (Not FileExists(HPath)) And (EmuExeDir <> '') And
       FileExists(EmuExeDir + '\' + FName) Then
     HPath := EmuExeDir + '\' + FName;
    If (Length(FName) = 0) Or (Not FileExists(HPath)) Then
     P.CPU.Regs.AL := $FF
    Else Begin
     FcbH := Emu_AllocHandle;
     If FcbH = 0 Then
      P.CPU.Regs.AL := $FF
     Else Begin
      Assign(EmuFileH[FcbH], HPath);
      {$I-} Reset(EmuFileH[FcbH], 1); {$I+}
      If IOResult <> 0 Then
       P.CPU.Regs.AL := $FF
      Else Begin
       EmuFileOpen[FcbH] := True;
       EmuFileIsCdrom[FcbH] := False;
       EmuFileName[FcbH] := HPath;
       EmuFileMode[FcbH] := 0;
       EmuFileFirstRd[FcbH] := True;
       Emu_WriteByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 24, Byte(FcbH));
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 12, 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 16,
        Word(FileSize(EmuFileH[FcbH]) And $FFFF));
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 18,
        Word((FileSize(EmuFileH[FcbH]) Shr 16) And $FFFF));
       Emu_WriteByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 32, 0);
       P.CPU.Regs.AL := 0;
      End;
     End;
    End;
   End;
  $10:
   { Fermer un fichier FCB - handle interne relu depuis l octet reserve }
   Begin
    FcbH := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 24);
    If (FcbH >= 5) And (FcbH <= 31) And EmuFileOpen[FcbH] Then Begin
     {$I-} Close(EmuFileH[FcbH]); {$I+} If IOResult <> 0 Then ;
     EmuFileOpen[FcbH] := False;
     P.CPU.Regs.AL := 0;
    End Else
     P.CPU.Regs.AL := $FF;
   End;
  $14:
   { Lecture sequentielle FCB : RecSize (offset 14-15, 128 par defaut si 0)  }
   { octets a l enregistrement courant (CurBlock*128+CurRec) vers la DTA,    }
   { puis avance l enregistrement courant (CurRec 0..127, retenue sur       }
   { CurBlock). }
   Begin
    FcbH := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 24);
    FcbRecSize := Emu_ReadWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 14);
    If FcbRecSize = 0 Then FcbRecSize := 128;
    If FcbRecSize > SizeOf(EmuIoBuf) Then FcbRecSize := SizeOf(EmuIoBuf);
    If (FcbH < 5) Or (FcbH > 31) Or (Not EmuFileOpen[FcbH]) Then
     P.CPU.Regs.AL := 1
    Else Begin
     FcbAbsRec := LongInt(Emu_ReadWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 12)) * 128 +
      Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 32);
     {$I-} Seek(EmuFileH[FcbH], FcbAbsRec * LongInt(FcbRecSize));
     BlockRead(EmuFileH[FcbH], EmuIoBuf, FcbRecSize, FcbBytesIO); {$I+}
     If IOResult <> 0 Then FcbBytesIO := 0;
     If FcbBytesIO = 0 Then
      P.CPU.Regs.AL := 1  { fin de fichier, rien lu }
     Else Begin
      For FcbI := FcbBytesIO To FcbRecSize - 1 Do EmuIoBuf[FcbI] := 0;
      For FcbI := 0 To FcbRecSize - 1 Do
       Emu_WriteByte(P.CPU, EmuDtaSeg, EmuDtaOfs + FcbI, EmuIoBuf[FcbI]);
      { Avancer CurRec/CurBlock (CurRec 0..127, retenue sur CurBlock). }
      B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 32);
      If B >= 127 Then Begin
       Emu_WriteByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 32, 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 12,
        Emu_ReadWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 12) + 1);
      End Else
       Emu_WriteByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX + 32, B + 1);
      If FcbBytesIO < FcbRecSize Then
       P.CPU.Regs.AL := 3  { enregistrement partiel en fin de fichier }
      Else
       P.CPU.Regs.AL := 0;
     End;
    End;
   End;
  $29:
   { Analyser un nom de fichier ASCIIZ/espace-termine a DS:SI vers un FCB    }
   { non ouvert a ES:DI (version simplifiee : ignore les nuances de         }
   { AL en entree sur les separateurs, gere lettre de lecteur "X:" et       }
   { les jokers */? de facon minimale). }
   Begin
    FcbI := 0;
    B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI);
    While (B = 32) Or (B = 9) Do Begin
     Inc(FcbI); B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
    End;
    FcbDrive := 0;
    If (B <> 0) And (Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI + 1) = Ord(':')) Then Begin
     If B In [Ord('a')..Ord('z')] Then B := B - 32;
     FcbDrive := B - Ord('A') + 1;
     Inc(FcbI, 2);
     B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
    End;
    FcbName := ''; FcbHasWild := False;
    While (B <> 0) And (B <> 32) And (B <> Ord('.')) And (Length(FcbName) < 8) Do Begin
     If B In [Ord('a')..Ord('z')] Then B := B - 32;
     If (B = Ord('*')) Then FcbHasWild := True;
     FcbName := FcbName + Chr(B);
     Inc(FcbI); B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
    End;
    While (B <> 0) And (B <> 32) And (B <> Ord('.')) Do Begin
     Inc(FcbI); B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
    End;
    FcbExt := '';
    If B = Ord('.') Then Begin
     Inc(FcbI); B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
     While (B <> 0) And (B <> 32) And (Length(FcbExt) < 3) Do Begin
      If B In [Ord('a')..Ord('z')] Then B := B - 32;
      If (B = Ord('*')) Then FcbHasWild := True;
      FcbExt := FcbExt + Chr(B);
      Inc(FcbI); B := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + FcbI);
     End;
    End;
    P.CPU.Regs.SI := P.CPU.Regs.SI + FcbI;
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI, FcbDrive);
    For FcbI := 1 To 8 Do
     If FcbI <= Length(FcbName) Then
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + FcbI, Byte(FcbName[FcbI]))
     Else
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + FcbI, 32);
    For FcbI := 1 To 3 Do
     If FcbI <= Length(FcbExt) Then
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + 8 + FcbI, Byte(FcbExt[FcbI]))
     Else
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + 8 + FcbI, 32);
    For FcbI := 12 To 32 Do
     Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + FcbI, 0);
    If FcbHasWild Then P.CPU.Regs.AL := 1 Else P.CPU.Regs.AL := 0;
   End;
  $11, $12, $13, $15, $16, $17,
  $21, $22, $23, $24, $27, $28:
   { Fonctions FCB restantes non implementees (find first/next, ecriture,   }
   { creation, acces aleatoire...) : echec explicite plutot qu un etat       }
   { silencieusement incorrect - voir AH=0Fh/10h/14h/29h ci-dessus pour le   }
   { sous-ensemble reellement exerce par NC.EXE/NCMAIN.EXE. }
   P.CPU.Regs.AL := $FF;
  $19:
   P.CPU.Regs.AL := 2;
  $1A:
   Begin
    EmuDtaSeg := P.CPU.Segs.DS;
    EmuDtaOfs := P.CPU.Regs.DX;
   End;
  $1B, $1C:
   Begin
    P.CPU.Regs.AL := 8;
    P.CPU.Regs.CX := 512;
    P.CPU.Regs.DX := 32768;
    P.CPU.Segs.DS := $40;
    P.CPU.Regs.BX := $0;
    Emu_WriteByte(P.CPU, $40, $0, $F8);
   End;
  $25:
   Begin
    Ofs := Word(P.CPU.Regs.AL) * 4;
    Emu_WriteWord(P.CPU, 0, Ofs,     P.CPU.Regs.DX);
    Emu_WriteWord(P.CPU, 0, Ofs + 2, P.CPU.Segs.DS);
   End;
  $26:
   Begin
    For I := 0 To 255 Do
     Emu_WriteByte(P.CPU, P.CPU.Regs.DX, Word(I),
       Emu_ReadByte(P.CPU, EmuPspSeg, Word(I)));
   End;
  $2A:
   Begin
    GetDate(Yr, Mo, Dy, Wd);
    P.CPU.Regs.CX := Yr;
    P.CPU.Regs.DH := Byte(Mo);
    P.CPU.Regs.DL := Byte(Dy);
    P.CPU.Regs.AL := Byte(Wd);
   End;
  $2B:
   P.CPU.Regs.AL := 0;
  $2C:
   Begin
    GetTime(Hr, Mn, Sc, Cs);
    P.CPU.Regs.CH := Byte(Hr);
    P.CPU.Regs.CL := Byte(Mn);
    P.CPU.Regs.DH := Byte(Sc);
    P.CPU.Regs.DL := Byte(Cs);
   End;
  $2D:
   P.CPU.Regs.AL := 0;
  $2E:
   EmuVerifyFlag := P.CPU.Regs.AL;
  $2F:
   Begin
    P.CPU.Segs.ES := EmuDtaSeg;
    P.CPU.Regs.BX := EmuDtaOfs;
   End;
  $30:
   { Renvoyer DOS 5.00 par defaut (compatible TP4..TP7, QP, etc), sauf si  }
   { l utilisateur a choisi "OS/2" ou "Windows 95" dans Options >          }
   { Emulateur > DOS: OS (OptionsDlg.Data.DosType, meme patron de lecture  }
   { directe que DosHardwareBiosId/OptionsDlg.Data.DosHardware) - alors    }
   { rapporter la version DOS synthetique correspondante (AL=majeur        }
   { decimal, AH=mineur decimal, voir DOC/DOS_FOR_OS2_PROGRAMMING.txt      }
   { section "AH=30h" et DOC/DOS_FOR_WINDOWS95_PROGRAMMING.txt section 2,  }
   { EMU_OS2_VER_MAJOR/MINOR et EMU_WIN95_VER_MAJOR/MINOR). BH=0 (OEM      }
   { IBM/Microsoft) quand AL d entree=0, sinon flags=0 (aucun rapporte) -  }
   { CX (numero de serie) reste 0 dans tous les cas, comme avant. }
   Begin
    If OptionsDlg.Data.DosType = DOS_TYPE_OS2 Then Begin
     P.CPU.Regs.AL := EMU_OS2_VER_MAJOR;
     P.CPU.Regs.AH := EMU_OS2_VER_MINOR;
     P.CPU.Regs.BH := 0;
    End Else If OptionsDlg.Data.DosType = DOS_TYPE_WIN95 Then Begin
     P.CPU.Regs.AL := EMU_WIN95_VER_MAJOR;
     P.CPU.Regs.AH := EMU_WIN95_VER_MINOR;
     P.CPU.Regs.BH := 0;
    End Else Begin
     P.CPU.Regs.AL := 5;
     P.CPU.Regs.AH := 0;
     P.CPU.Regs.BH := $FF;
    End;
    P.CPU.Regs.BL := 0;
    P.CPU.Regs.CX := 0;
   End;
  $31:
   Begin
    EmuExitCode := P.CPU.Regs.AL;
    EmuExitType := 3;
    Emu_DosTerminate(P, 'Programme termine TSR (code ' + IntToStr(EmuExitCode) + ')');
   End;
  $33:
   Begin
    Case P.CPU.Regs.AL Of
     0: P.CPU.Regs.DL := EmuBreakFlag;
     1: EmuBreakFlag := P.CPU.Regs.DL;
     2: Begin
         B := EmuBreakFlag;
         EmuBreakFlag := P.CPU.Regs.DL;
         P.CPU.Regs.DL := B;
        End;
     5: P.CPU.Regs.DL := 3;
     6:
      { AX=3306h : version "vraie" de la personnalite DOS, pensee pour       }
      { contourner un eventuel SETVER (DOC/DOS_FOR_OS2_PROGRAMMING.txt       }
      { section "AX=3306h", et DOC/DOS_FOR_WINDOWS95_PROGRAMMING.txt          }
      { section 2 - "AH=30h peut etre influence par SETVER, donc 3306h        }
      { convient mieux au diagnostic") - generique, independant de DosType.   }
      { Ce clone n emule pas de mecanisme SETVER separe, donc la version      }
      { "vraie" coincide toujours avec la version "presentee" par AH=30h      }
      { (voir le case $30 ci-dessus, memes branches OS/2/Windows 95 via       }
      { OptionsDlg.Data.DosType). }
      Begin
       If OptionsDlg.Data.DosType = DOS_TYPE_OS2 Then Begin
        P.CPU.Regs.BL := EMU_OS2_VER_MAJOR;
        P.CPU.Regs.BH := EMU_OS2_VER_MINOR;
       End Else If OptionsDlg.Data.DosType = DOS_TYPE_WIN95 Then Begin
        P.CPU.Regs.BL := EMU_WIN95_VER_MAJOR;
        P.CPU.Regs.BH := EMU_WIN95_VER_MINOR;
       End Else Begin
        P.CPU.Regs.BL := 5;
        P.CPU.Regs.BH := 0;
       End;
       P.CPU.Regs.AL := 0;  { <> FFh : version vraie disponible (>= DOS 5.0) }
       P.CPU.Regs.DL := 0;  { revision }
       P.CPU.Regs.DH := 0;  { pas de DOS en ROM/HMA emule }
