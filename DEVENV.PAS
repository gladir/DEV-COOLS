  TermCmd_PSCRIPT(TermPanels[ActiveShell], Opts.PascalScriptFile);
 End;
 { /PS:fichier.ps1 - meme principe exact que /TERMINALDOS:/                }
 { /TERMINALOS2: ci-dessus, mais ouvre "PowerShell dev" (SK_POWERSHELL) -   }
 { demande explicite de l'utilisateur (2026-08-30) : PowerShell dev est le  }
 { shell qu'il utilise/oublie de changer le plus souvent, ce nouveau         }
 { indicateur de ligne de commande lui evite d'avoir a naviguer manuellement}
 { jusqu'a ce shell puis a taper chaque ligne d'un script a la main. Chaque }
 { ligne du fichier est executee telle quelle via TermExecuteCommand,       }
 { exactement comme si elle avait ete tapee dans ce terminal - CE N'EST PAS }
 { un vrai interprete PowerShell (aucun script .ps1 reel, avec sa syntaxe   }
 { complete, n'est execute) mais le meme jeu de commandes internes/alias    }
 { verbe-nom deja disponibles dans ce shell (voir HELP). }
 If Opts.PSFile <> '' Then Begin
  StartPage.Visible := False;
  ActiveShell := SK_POWERSHELL;
  TermVisible := True;
  TermX := 0;
  TermY := GetScreenHeight - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
  TermWidth := GetScreenWidth - EXPLORER_WIDTH;
  TermHeight := OUTPUT_HEIGHT;
  TerminalHasFocus := True;
  TermSelectOpen := False;
  TerminalOnTop := True;
  TermPanels[ActiveShell].NeedRepaint := True;
  {$I-} Assign(BatchFile, Opts.PSFile); Reset(BatchFile); {$I+}
  If IOResult = 0 Then Begin
   While Not Eof(BatchFile) Do Begin
    ReadLn(BatchFile, BatchLine);
    { Route par TermPSHandleInputLine (2026-08-31, demande explicite :      }
    { variables/here-strings) plutot que TermExecuteCommand directement -   }
    { meme chemin que la touche Entree interactive, indispensable pour      }
    { qu'un here-string @"..."@ multi-lignes dans un script /PS: fonctionne }
    { (une ligne VIDE a l'interieur d'un here-string fait partie du texte,  }
    { d'ou l'abandon du filtre TermTrim<>'' ci-dessus qui l'aurait          }
    { silencieusement supprimee). }
    TermPanels[ActiveShell].InputLine := BatchLine;
    TermPSHandleInputLine(TermPanels[ActiveShell]);
   End;
   Close(BatchFile);
  End;
 End;
 { Si un fichier solution .sln a ete passe en argument }
 If Opts.SolutionFile <> '' Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
  OpenSolutionFile(Opts.SolutionFile);
 End
 { Mode -emu:XXX,fichier : lancer immediatement l emulateur }
 Else If Opts.EmuMode Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
  EmuStartCmdLine := Opts.EmuArgs;
  CreateEmulatorTab(Opts.EmuFile, Opts.EmuTarget, Opts.EmuArgs);
 End
 { Si un fichier source a ete passe en argument, ouvrir directement l editeur }
 Else If Opts.SourceFile <> '' Then Begin
  StartPage.Visible := False;
  CreateEditorWindow(Opts.SourceFile);
  { Charger le fichier dans l editeur alloue }
  LoadFile(Editors[WinMgr.ActiveIdx]^.Buffer, Opts.SourceFile);
  ActiveEditor := Editors[WinMgr.ActiveIdx]^;
  EditorReady := True;
  { Peupler l explorateur de solutions avec le fichier ouvert }
  ClearExplorer(SolExplorer);
  AddExplorerNode(SolExplorer, 'Solution sans nom',
   ENK_SOLUTION, -1);
  SolExplorer.Nodes[0].Expanded := True;
  SolExplorer.Nodes[0].HasChildren := True;
  AddExplorerNode(SolExplorer,
   ExtractFileName(Opts.SourceFile),
   NodeKindFromExtension(Opts.SourceFile), 0);
  SolExplorer.SelectedIdx := 1;
  SolExplorer.Nodes[1].Selected := True;
  SolExplorer.NeedRepaint := True;
 End;
 { /NC : ouvrir le Terminal directement en Norton Commander des le          }
 { demarrage - evite plusieurs etapes de souris (menu Affichage >           }
 { Terminal puis selection du shell dans le selecteur). Reproduit             }
 { exactement l action manuelle equivalente (voir ExecuteMenuItem, tag       }
 { 303, et le clic sur l item 5 du selecteur de shell du Terminal).           }
 { Independant des branches ci-dessus (solution/emulateur/fichier          }
 { source) : peut se combiner avec elles. }
 { BOGUE REEL corrige 2026-08-16 (trouve en testant une AUTRE demande de     }
 { l utilisateur, pas signale directement) : utilise SEUL (aucune des 3      }
 { branches ci-dessus, donc StartPage.Visible jamais mis a False par         }
 { aucune d elles), /NC laissait la page de demarrage visible PAR-DESSUS      }
 { le terminal. `DispatchEvent` teste `StartPage.Visible` en TOUTE            }
 { PRIORITE (avant meme le routage clavier vers le terminal, voir plus bas    }
 { "Page de demarrage en priorite si visible") - CHAQUE evenement clavier/    }
 { souris etait donc intercepte par la page de demarrage, empechant           }
 { totalement de taper quoi que ce soit dans Norton Commander (observe        }
 { concretement : taper du texte + Entree ouvrait "Nouveau projet", le        }
 { bouton par defaut de la page). }
 If Opts.NCMode Then Begin
  StartPage.Visible := False;
  ActiveShell := SK_NCOMMANDER;
  TermVisible := True;
  TermX := 0;
  TermY := GetScreenHeight - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
  TermWidth := GetScreenWidth - EXPLORER_WIDTH;
  TermHeight := OUTPUT_HEIGHT;
  TerminalHasFocus := True;
  TermSelectOpen := False;
  TerminalOnTop := True;
  TermPanels[ActiveShell].NeedRepaint := True;
  FullRepaintNeeded := True;
 End;
 DrawAllWidgets;
 MainLoop;
 SaveMRUList(MRUList);
End;

