{ Dernier segment d un chemin (nom affiche dans l arbre NCD, Commandes  }
{ item 0) - utilise par DrawNCommanderPanel (etape 4). --- }
Function NCLastComponent(Const Path: String): String;
Var
 P: Integer;
 R: String;
Begin
 P := Length(Path);
 While (P > 0) And (Path[P] <> '\') Do Dec(P);
 R := Copy(Path, P + 1, Length(Path) - P);
 If R = '' Then R := Path; { racine "C:\" }
 NCLastComponent := R;
End;

{ Formate un entier avec des virgules tous les 3 chiffres (10220 ->      }
{ "10,220") - barre de titre de la visionneuse F3, comme WPVIEW. --- }
Function NCFormatThousands(N: LongInt): String;
Var
 S, R: String;
 I, Cnt: Integer;
Begin
 S := IntToStr(N);
 R := '';
 Cnt := 0;
 For I := Length(S) DownTo 1 Do Begin
  R := S[I] + R;
  Inc(Cnt);
  If (Cnt Mod 3 = 0) And (I > 1) And (S[I - 1] <> '-') Then R := ',' + R;
 End;
 NCFormatThousands := R;
End;

{ Meme principe que NCFormatThousands mais pour un Int64 - necessaire   }
{ pour l espace disque (menu Gauche/Droite, item "Info") : la taille           }
{ totale/libre d un disque moderne depasse largement les 2 Go du         }
{ LongInt 32 bits utilise partout ailleurs dans ce fichier. Str() (et           }
{ non IntToStr, qui ne prend qu un LongInt) gere nativement l Int64. --- }
Function NCFormatBytes64(N: Int64): String;
Var
 S, R: String;
 I, Cnt: Integer;
Begin
 Str(N, S);
 R := '';
 Cnt := 0;
 For I := Length(S) DownTo 1 Do Begin
  R := S[I] + R;
  Inc(Cnt);
  If (Cnt Mod 3 = 0) And (I > 1) And (S[I - 1] <> '-') Then R := ',' + R;
 End;
 NCFormatBytes64 := R;
End;

{ Etiquette de volume du lecteur DriveCh (ex: 'C') - parcourt la racine   }
{ a la recherche de l entree speciale VolumeID (NC.PAS: menu Gauche/          }
{ Droite, item "Info"). Renvoie '(aucune)' si absente ou si le systeme   }
{ hote ne l expose pas via FindFirst. --- }
Function NCGetVolumeLabel(DriveCh: Char): String;
Var
 SR: SearchRec;
 Found: String;
Begin
 Found := '';
 FindFirst(DriveCh + ':\*.*', VolumeID, SR);
 While (DosError = 0) And (Found = '') Do Begin
  If (SR.Attr And VolumeID) <> 0 Then Found := SR.Name;
  FindNext(SR);
 End;
 {$IFDEF FPC} FindClose(SR); {$ENDIF}
 If Found = '' Then Found := '(aucune)';
 NCGetVolumeLabel := Found;
End;

{ Tronque un chemin trop long pour la barre de titre de la visionneuse   }
{ en gardant le debut (lettre de lecteur) et la fin (nom de fichier),      }
{ separes par "..." - imite l affichage "C:\...e\tp\bin\binobj.exe" de   }
{ WPVIEW plutot que de couper brutalement la fin utile du chemin. --- }
Function NCTruncatePathMiddle(Const Path: String; MaxLen: Integer): String;
Var
 Keep: Integer;
Begin
 If Length(Path) <= MaxLen Then Begin
  NCTruncatePathMiddle := Path;
  Exit;
 End;
 Keep := MaxLen - 6; { 3 caracteres de tete + les 3 points }
 If Keep < 1 Then Keep := 1;
 NCTruncatePathMiddle := Copy(Path, 1, 3) + '...' +
  Copy(Path, Length(Path) - Keep + 1, Keep);
End;

{ Nombre total de rangees d affichage du fichier charge, selon le mode   }
{ courant (Hex : groupes de 16 octets ; Texte non renvoye a la ligne :   }
{ une rangee par ligne source ; Texte renvoye a la ligne : chaque ligne   }
{ source longue occupe plusieurs rangees, recalculees a partir de           }
{ ViewCharsPerRow, mis a jour au dernier tracer). Utilise pour borner           }
{ le defilement (Fin/PgDn) et calculer le pourcentage affiche. --- }
Function NCViewTotalRows: LongInt;
Var
 SrcLine, ChunkStart, Cnt, CPR: LongInt;
 LineStr: String;
Begin
 If NCState.ViewHex Then
  Cnt := (NCState.ViewRawSize + 15) Div 16
 Else If Not NCState.ViewWrap Then
  Cnt := NCState.ViewCount
 Else Begin
  CPR := NCState.ViewCharsPerRow;
  If CPR < 1 Then CPR := 1;
  Cnt := 0;
  For SrcLine := 0 To NCState.ViewCount - 1 Do Begin
   LineStr := NCState.ViewLines[SrcLine];
   ChunkStart := 1;
   Repeat
    Inc(Cnt);
    ChunkStart := ChunkStart + CPR;
   Until ChunkStart > Length(LineStr);
  End;
 End;
 If Cnt < 1 Then Cnt := 1;
 NCViewTotalRows := Cnt;
End;

{ Represente N en hexadecimal sur exactement Digits chiffres (zeros a   }
{ gauche) - dump hexadecimal du mode Hex (F4) de la visionneuse. --- }
Function NCHexDigits(N: LongInt; Digits: Integer): String;
Const
 HexChars: Array[0..15] Of Char = '0123456789ABCDEF';
Var
 R: String;
 I: Integer;
Begin
 R := '';
 For I := 1 To Digits Do Begin
  R := HexChars[N And $F] + R;
  N := N Shr 4;
 End;
 NCHexDigits := R;
End;

Procedure DrawNCommanderPanel(Var TP: TTerminalPanel; PX, PY, PW, PH: Integer);
Const
 { Libelles francais authentiques de NC.PAS (FunctionKeyValue). }
 NC_FKEY_LABELS: Array[1..10] Of String[7] = (
  'Aide', 'Menu', 'Affich', 'Editer', 'Copier', 'RenDep', 'CreRep',
  'Suppr.', 'Menu', 'Sortie'
 );
Var
 CW, RH: Integer;
 PaneW: Integer;
 Side, Row, VisRows, Idx: Integer;
 Y, X0, PaneRight: Integer;
 E: TNCEntry;
 S: String;
 HeaderY, ColHeadY, ListTop, ListBot, InfoY, PromptY, FKeyY: Integer;
 NameCols, DTCols: Integer;
 FKeyColW, I, CurX, CenterX: Integer;
 IsHost: Boolean;
 HistTop: Integer;
 InViewer: Boolean;
 LabelStr: String[7];
 CharsPerRow, BodyTop, BodyBottom, TotalRows, Percent: Integer;
 HexRow, HexOffset: LongInt;
 J, SrcLine, ChunkStart: Integer;
 HexLine, AsciiPart, TitlePrefix: String;
 ByteVal: Byte;
 DriveCh: Char;
 TotalBytes64, FreeBytes64: Int64;
 FileCnt: Integer;
 TotalSz: LongInt;
 VolLabel: String;
Begin
 If Not NCState.Initialized Then Begin
  NCRefreshPanes;
  NCState.Initialized := True;
 End;
 IsHost := NCState.Slot < 0;
 InViewer := NCState.Mode In [ncViewFile, ncViewSearch, ncViewSelectViewer];
 If (NCState.Mode = ncMessage) And
    (NCState.MessageReturnMode In [ncViewFile, ncViewSearch, ncViewSelectViewer]) Then
  InViewer := True;
 CW := TextWidth('M');
 If CW < 1 Then CW := 8;
 RH := TERM_LINE_HEIGHT;
 NCState.CharW := CW;
 NCState.CharH := RH;

 SetFillStyle(SolidFill, 1);
 Bar(PX, PY + TERM_TAB_HEIGHT, PX + PW - 1, PY + PH - 1);

 { NOTE : l index de couleur 0 est globalement remappe par SetBkColor       }
 { (voir EmuColor, DEVENV.PAS ~38541) - il n affiche pas un noir fixe    }
 { mais LA couleur passee au dernier SetBkColor (7=CLR_BACKGROUND,             }
 { gris clair, ailleurs dans l appli - BOGUE REEL 2026-08-09 : les             }
 { fonds "noirs" 0 de la barre F-touches/ligne de commande/entete de           }
 { colonnes rendaient donc ce gris). Palette 0 redefinie en noir reel      }
 { pour toute la duree du rendu de ce panneau, puis restauree a la fin. }
 SetBkColor(0);

 { Barre de touches de fonction F1..F10 - fond noir, numeros gris,      }
 { libelles noirs sur fond cyan, exactement comme l original (ShowKeyFunc). }
 FKeyY := PY + PH - RH;
 SetFillStyle(SolidFill, 0);
 Bar(PX, FKeyY, PX + PW - 1, PY + PH - 1);
 FKeyColW := (PW - 2 * CW) Div 10;
 If FKeyColW < 8 * CW Then FKeyColW := 8 * CW;
 X0 := PX;
 For I := 1 To 10 Do Begin
  { Case du chiffre : fond explicitement noir (ne pas se fier au fond   }
  { deja peint plus haut - BOGUE REEL 2026-08-09 : apparaissait gris). }
  SetFillStyle(SolidFill, 0);
  Bar(X0, FKeyY, X0 + 2 * CW - 1, FKeyY + RH - 1);
  SetColor(7);
  OutTextXY(X0, FKeyY + 1, IntToStr(I));
  { La visionneuse F3 a son propre jeu de libelles (WPVIEW) - certaines   }
  { cases (3/5/6/9) y restent vides, comme dans l original. }
  If InViewer Then LabelStr := NC_VIEWFKEY_LABELS[I] Else LabelStr := NC_FKEY_LABELS[I];
  If LabelStr <> '' Then Begin
   SetFillStyle(SolidFill, 3);
   Bar(X0 + 2 * CW, FKeyY, X0 + FKeyColW - 1, FKeyY + RH - 1);
   SetColor(0);
   OutTextXY(X0 + 2 * CW + 2, FKeyY + 1, LabelStr);
  End;
  X0 := X0 + FKeyColW;
 End;

 If InViewer Then Begin
  { --- Visionneuse F3 (WPVIEW) : prend tout le panneau, comme dans           }
  { l original - pas de double panneau ni de ligne de commande visibles   }
  { pendant la visualisation. --- }
  BodyTop := PY + TERM_TAB_HEIGHT + RH;
  BodyBottom := FKeyY;
  CharsPerRow := (PW - 4) Div CW;
  If CharsPerRow < 10 Then CharsPerRow := 10;
  NCState.ViewCharsPerRow := CharsPerRow;

  { Barre de titre : fond cyan, texte noir - nom (tronque au milieu),      }
  { colonne, taille en octets et pourcentage visualise, comme WPVIEW. }
  SetFillStyle(SolidFill, 3);
  Bar(PX, PY + TERM_TAB_HEIGHT, PX + PW - 1, BodyTop - 1);
  SetColor(0);
  TotalRows := NCViewTotalRows;
  If TotalRows > 1 Then Percent := (NCState.ViewTop * 100) Div (TotalRows - 1)
  Else Percent := 0;
  If Percent > 100 Then Percent := 100;
  If Percent < 0 Then Percent := 0;
  If NCState.ViewHex Then TitlePrefix := 'Hex View: ' Else TitlePrefix := 'Text View: ';
  S := '   Col ' + IntToStr(NCState.ViewCol) + '   ' +
   NCFormatThousands(NCState.ViewFileSize) + ' Bytes   ' + IntToStr(Percent) + '%';
  J := CharsPerRow - Length(TitlePrefix) - Length(S);
  If J < 10 Then J := 10;
  S := TitlePrefix + NCTruncatePathMiddle(NCState.ViewFileName, J) + S;
  If Length(S) > CharsPerRow Then S := Copy(S, 1, CharsPerRow);
  OutTextXY(PX + 2, PY + TERM_TAB_HEIGHT + 1, S);

  { Corps : dump hexadecimal (F4) ou texte, renvoye a la ligne (F2) ou    }
  { defilant horizontalement (Col, fleches Gauche/Droite). }
  SetColor(11);
  Y := BodyTop;
  If NCState.ViewHex Then Begin
   HexRow := NCState.ViewTop;
   While Y + RH <= BodyBottom Do Begin
    HexOffset := HexRow * 16;
    If HexOffset >= NCState.ViewRawSize Then Break;
    HexLine := NCHexDigits(HexOffset, 8) + '  ';
    AsciiPart := '';
    For J := 0 To 15 Do Begin
     If HexOffset + J < NCState.ViewRawSize Then Begin
      ByteVal := NCState.ViewRaw[HexOffset + J];
      HexLine := HexLine + NCHexDigits(ByteVal, 2) + ' ';
      If (ByteVal < 32) Or (ByteVal > 126) Then AsciiPart := AsciiPart + '.'
      Else AsciiPart := AsciiPart + Chr(ByteVal);
     End Else Begin
      HexLine := HexLine + '   ';
      AsciiPart := AsciiPart + ' ';
     End;
     If J = 7 Then HexLine := HexLine + ' ';
    End;
    OutTextXY(PX + 2, Y, HexLine + ' ' + AsciiPart);
    Y := Y + RH;
    Inc(HexRow);
   End;
  End Else If Not NCState.ViewWrap Then Begin
   SrcLine := NCState.ViewTop;
   While (Y + RH <= BodyBottom) And (SrcLine < NCState.ViewCount) Do Begin
    OutTextXY(PX + 2, Y,
     Copy(NCState.ViewLines[SrcLine], NCState.ViewCol + 1, CharsPerRow));
    Y := Y + RH;
    Inc(SrcLine);
   End;
  End Else Begin
   SrcLine := 0;
   J := 0; { compteur de rangees d affichage, y compris celles sautees }
   While (SrcLine < NCState.ViewCount) And (Y + RH <= BodyBottom) Do Begin
    S := NCState.ViewLines[SrcLine];
    ChunkStart := 1;
    Repeat
     If (J >= NCState.ViewTop) And (Y + RH <= BodyBottom) Then Begin
      OutTextXY(PX + 2, Y, Copy(S, ChunkStart, CharsPerRow));
      Y := Y + RH;
     End;
     Inc(J);
     ChunkStart := ChunkStart + CharsPerRow;
    Until (ChunkStart > Length(S)) Or (Y + RH > BodyBottom);
    Inc(SrcLine);
   End;
  End;
 End Else Begin
  { Ligne de commande - gris sur fond noir, comme une vraie invite DOS. }
  PromptY := FKeyY - RH;
  SetFillStyle(SolidFill, 0);
  Bar(PX, PromptY, PX + PW - 1, PromptY + RH - 1);
  SetColor(7);
  S := NCState.Panes[NCState.Active].Path + '>' + TP.InputLine;
  OutTextXY(PX + 2, PromptY + 1, S);
  If ExplorerSearchCursorVisible Then Begin
   CurX := PX + 2 + TextWidth(S);
   Line(CurX, PromptY, CurX, PromptY + RH - 1);
  End;

  PaneW := (PW - 2) Div 2;
  HeaderY := PY + TERM_TAB_HEIGHT + 4;
  ColHeadY := HeaderY + RH;
  ListTop := ColHeadY + RH + 1;
  InfoY := PromptY - 2 - RH;
  ListBot := InfoY - 1;
  VisRows := (ListBot - ListTop) Div RH;
  If VisRows < 1 Then VisRows := 1;
  DTCols := 15; { " MM/DD/YY HH:MM" }
  NameCols := (PaneW Div CW) - 11 - DTCols;
  If NameCols < 8 Then NameCols := 8;

  For Side := 0 To 1 Do Begin
  X0 := PX + Side * PaneW;
  If Side = 0 Then PaneRight := X0 + PaneW - 2
  Else PaneRight := PX + PW - 2;

  If Side = NCState.Active Then SetColor(15) Else SetColor(7);
  Rectangle(X0, HeaderY - 3, PaneRight, InfoY + RH);

  { Repertoire courant, centre en haut du panneau, dans une pastille    }
  { cyan (seulement autour du texte, pas toute la largeur de la barre - }
  { le reste de la barre de titre reste bleu, comme dans l original). }
  S := NCState.Panes[Side].Path;
  If Length(S) > (PaneRight - X0) Div CW - 1 Then
   S := Copy(S, 1, (PaneRight - X0) Div CW - 1);
  CenterX := X0 + ((PaneRight - X0) - TextWidth(S)) Div 2;
  SetFillStyle(SolidFill, 3);
  Bar(CenterX - CW Div 2, HeaderY - 2, CenterX + TextWidth(S) + CW Div 2,
   HeaderY + RH - 3);
  SetColor(0);
  OutTextXY(CenterX, HeaderY - 2, S);

  If NCState.Panes[Side].InfoMode Then Begin
   { Menu Gauche/Droite, item "Info" : espace disque, etiquette de           }
   { volume et statistiques du repertoire courant, a la place de la       }
   { liste de fichiers - a partir des entrees deja chargees (aucune           }
   { E/S supplementaire pour les stats de repertoire). }
   If (NCState.Slot < 0) And (Length(NCState.Panes[Side].Path) >= 1) Then
    DriveCh := UpCase(NCState.Panes[Side].Path[1])
   Else
    DriveCh := 'C';
   TotalBytes64 := DiskSize(Ord(DriveCh) - Ord('A') + 1);
   FreeBytes64 := DiskFree(Ord(DriveCh) - Ord('A') + 1);
   VolLabel := NCGetVolumeLabel(DriveCh);
   FileCnt := 0;
   TotalSz := 0;
   For Idx := 0 To NCState.Panes[Side].Count - 1 Do
    If Not NCState.Panes[Side].Entries[Idx].IsDir Then Begin
     Inc(FileCnt);
     TotalSz := TotalSz + NCState.Panes[Side].Entries[Idx].Size;
    End;
   Y := ColHeadY;
   SetColor(14);
   S := 'Informations';
   OutTextXY(X0 + ((PaneRight - X0) - TextWidth(S)) Div 2, Y, S);
   Y := Y + 2 * RH;
   SetColor(11);
   OutTextXY(X0 + 4, Y, 'Espace disque total : ' +
    NCFormatBytes64(TotalBytes64) + ' octets');
   Y := Y + RH;
   OutTextXY(X0 + 4, Y, 'Espace disque libre : ' +
    NCFormatBytes64(FreeBytes64) + ' octets');
   Y := Y + 2 * RH;
   OutTextXY(X0 + 4, Y, 'Etiquette de volume : ' + VolLabel);
   Y := Y + 2 * RH;
   OutTextXY(X0 + 4, Y, IntToStr(FileCnt) + ' fichier(s), ' +
    NCFormatThousands(TotalSz) + ' octets');
   Y := Y + RH;
   OutTextXY(X0 + 4, Y, 'dans ' + NCState.Panes[Side].Path);
  End Else Begin
   { Entete de colonnes (Nom / Taille / Date Heure) - fond bleu, texte    }
   { jaune, comme dans l original. }
   SetFillStyle(SolidFill, 1);
   Bar(X0 + 1, ColHeadY - 1, PaneRight - 1, ColHeadY + RH - 2);
   SetColor(14);
   S := PadRight('Nom', NameCols, ' ') + ' ' + PadLeft('Taille', 9, ' ') +
    '  ' + PadRight('Date/Heure', DTCols - 2, ' ');
   OutTextXY(X0 + 3, ColHeadY, S);
   SetColor(15);
   Line(X0 + 1, ColHeadY + RH - 2, PaneRight - 1, ColHeadY + RH - 2);

   If NCState.Panes[Side].Cursor < NCState.Panes[Side].ScrollTop Then
    NCState.Panes[Side].ScrollTop := NCState.Panes[Side].Cursor;
   If NCState.Panes[Side].Cursor >= NCState.Panes[Side].ScrollTop + VisRows Then
    NCState.Panes[Side].ScrollTop := NCState.Panes[Side].Cursor - VisRows + 1;
   If NCState.Panes[Side].ScrollTop < 0 Then NCState.Panes[Side].ScrollTop := 0;

   Y := ListTop;
   For Row := 0 To VisRows - 1 Do Begin
    Idx := NCState.Panes[Side].ScrollTop + Row;
    If Idx < NCState.Panes[Side].Count Then Begin
     E := NCState.Panes[Side].Entries[Idx];
     If Idx = NCState.Panes[Side].Cursor Then Begin
      If Side = NCState.Active Then SetFillStyle(SolidFill, 3)
      Else SetFillStyle(SolidFill, 8);
      Bar(X0 + 1, Y, PaneRight - 1, Y + RH - 1);
     End Else Begin
      SetFillStyle(SolidFill, 1);
      Bar(X0 + 1, Y, PaneRight - 1, Y + RH - 1);
     End;
     If NCState.Panes[Side].Marked[Idx] Then SetColor(14)
     Else If E.IsDir Then SetColor(15)
     Else SetColor(11);
     S := E.Name;
     If Length(S) > NameCols Then S := Copy(S, 1, NameCols);
     S := PadRight(S, NameCols, ' ');
     If E.IsDir Then
      S := S + ' ' + PadLeft('<DIR>', 9, ' ')
     Else
      S := S + ' ' + PadLeft(IntToStr(E.Size), 9, ' ');
     If E.Name = '..' Then
      S := S + '  ' + PadRight('', DTCols - 2, ' ') { pas de date pour ".." }
     Else
      S := S + '  ' + NCFormatDateTime(E, IsHost);
     OutTextXY(X0 + 3, Y + 1, S);
    End;
    Y := Y + RH;
   End;

   { Lignes verticales cyan clair separant les colonnes Nom/Taille/           }
   { Date/Heure - dessinees apres les lignes de la liste pour rester              }
   { visibles par-dessus leurs fonds (curseur, marquage...). }
   SetColor(11);
   Line(X0 + 3 + NameCols * CW, ColHeadY - 1, X0 + 3 + NameCols * CW, Y - 1);
   Line(X0 + 3 + (NameCols + 10) * CW + CW Div 2, ColHeadY - 1,
    X0 + 3 + (NameCols + 10) * CW + CW Div 2, Y - 1);
  End;

  { Barre d info : ligne du fichier courant du panneau (ou rappel du      }
  { mode Info si actif). }
  SetFillStyle(SolidFill, 3);
  Bar(X0 + 1, InfoY, PaneRight - 1, InfoY + RH - 1);
  SetColor(0);
  If NCState.Panes[Side].InfoMode Then
   S := 'Mode Info'
  Else If NCState.Panes[Side].Count > 0 Then Begin
   E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
   If E.IsDir Then
    S := E.Name + '  <DIR>'
   Else
    S := E.Name + '  ' + IntToStr(E.Size) + ' octets  ' +
     NCFormatDateTime(E, IsHost);
  End Else
   S := '(repertoire vide)';
  If Length(S) > (PaneRight - X0 - 4) Div CW Then
   S := Copy(S, 1, (PaneRight - X0 - 4) Div CW);
  OutTextXY(X0 + 3, InfoY + 1, S);
  End;
 End;

 { Dialogues modaux (F5/F6/F7 saisie, F8 confirmation, menu deroulant,   }
 { historique, arbre NCD, recherche/choix de visionneuse F3) - dessines  }
 { par-dessus les panneaux ou par-dessus la visionneuse. --- }
 Case NCState.Mode Of
  ncPromptMkDir: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Creer un repertoire');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6,
    'Nom : ' + NCState.PromptBuf + '_');
  End;
  ncPromptCopy: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Copier');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6,
    'Vers : ' + NCState.PromptBuf + '_');
  End;
  ncPromptRenMov: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Renommer/Deplacer');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6,
    'Nouveau nom : ' + NCState.PromptBuf + '_');
  End;
  ncConfirmDelete: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Supprimer');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6,
    'Confirmer la suppression ? (O/N)');
  End;
  ncViewSearch: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Rechercher');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6,
    'Texte : ' + NCState.ViewSearchBuf + '_');
  End;
  ncViewSelectViewer: Begin
   { Boite centree listant les formats (WPVIEW: "Select Viewer") - seuls  }
   { Text View et Hex sont reellement cables (voir NC_VIEWER_NAMES). }
   NameCols := 0;
   For I := 0 To NC_VIEWER_COUNT - 1 Do
    If Length(NC_VIEWER_NAMES[I]) > NameCols Then
     NameCols := Length(NC_VIEWER_NAMES[I]);
   PaneW := (NameCols + 4) * CW;
   VisRows := (NC_VIEWER_COUNT + 2) * RH;
   X0 := PX + (PW - PaneW) Div 2;
   PaneRight := X0 + PaneW;
   HeaderY := PY + (PH - VisRows) Div 2;
   InfoY := HeaderY + VisRows;
   SetFillStyle(SolidFill, 3);
   Bar(X0, HeaderY, PaneRight, InfoY);
   SetColor(15);
   Rectangle(X0, HeaderY, PaneRight, InfoY);
   SetColor(0);
   S := 'Select Viewer';
   OutTextXY(X0 + ((PaneRight - X0) - TextWidth(S)) Div 2, HeaderY + 4, S);
   For I := 0 To NC_VIEWER_COUNT - 1 Do Begin
    Y := HeaderY + RH + I * RH + 4;
    If I = NCState.ViewSelIdx Then Begin
     SetFillStyle(SolidFill, 0);
     Bar(X0 + 2, Y - 2, PaneRight - 2, Y + RH - 2);
     SetColor(11);
    End Else Begin
     SetFillStyle(SolidFill, 3);
     Bar(X0 + 2, Y - 2, PaneRight - 2, Y + RH - 2);
     SetColor(0);
    End;
    OutTextXY(X0 + 2 * CW, Y, NC_VIEWER_NAMES[I]);
   End;
  End;
  ncMenuBar: Begin
   { Barre superieure des 5 menus (Gauche/Fichiers/Disque/Commandes/       }
   { Droite), l entree active en surbrillance, puis le sous-menu           }
   { deroulant de l entree active juste en dessous (NC.PAS: PullDnMenu). }
   Y := PY + TERM_TAB_HEIGHT;
   SetFillStyle(SolidFill, 3);
   Bar(PX, Y, PX + PW - 1, Y + RH - 1);
   X0 := PX + CW;
   For I := 0 To NC_MENU_TOP_COUNT - 1 Do Begin
    S := ' ' + NC_MENU_TOP[I] + ' ';
    If I = NCState.MenuTop Then Begin
     SetFillStyle(SolidFill, 0);
     Bar(X0 - 2, Y, X0 + TextWidth(S) + 1, Y + RH - 1);
     SetColor(11);
    End Else
     SetColor(0);
    OutTextXY(X0, Y + 1, S);
    X0 := X0 + TextWidth(S) + 3 * CW;
   End;

   { Position horizontale du sous-menu deroulant : alignee sur l entree   }
   { superieure active, calculee par le meme parcours que ci-dessus. }
   X0 := PX + CW;
   For I := 0 To NCState.MenuTop - 1 Do
    X0 := X0 + TextWidth(' ' + NC_MENU_TOP[I] + ' ') + 3 * CW;

   CurX := NCMenuItemCount(NCState.MenuTop);
   NameCols := 0;
   For I := 0 To CurX - 1 Do
    If Length(NCMenuItemLabel(NCState.MenuTop, I)) > NameCols Then
     NameCols := Length(NCMenuItemLabel(NCState.MenuTop, I));
   PaneRight := X0 + (NameCols + 4) * CW;
   If PaneRight > PX + PW - 2 Then Begin
    X0 := PX + PW - 2 - (NameCols + 4) * CW;
    PaneRight := PX + PW - 2;
   End;
   ListTop := Y + RH;
   ListBot := ListTop + CurX * RH;
   SetFillStyle(SolidFill, 3);
   Bar(X0, ListTop, PaneRight, ListBot + 1);
   SetColor(15);
   Rectangle(X0, ListTop, PaneRight, ListBot + 1);
   For I := 0 To CurX - 1 Do Begin
    If I = NCState.MenuItem Then Begin
     SetFillStyle(SolidFill, 0);
     Bar(X0 + 1, ListTop + I * RH, PaneRight - 1, ListTop + (I + 1) * RH - 1);
     SetColor(11);
    End Else Begin
     SetFillStyle(SolidFill, 3);
     Bar(X0 + 1, ListTop + I * RH, PaneRight - 1, ListTop + (I + 1) * RH - 1);
     SetColor(0);
    End;
    OutTextXY(X0 + 2 * CW Div 2 + 2, ListTop + I * RH + 1,
     NCMenuItemLabel(NCState.MenuTop, I));
   End;
  End;
  ncMessage: Begin
   NCDrawModalBox(PX, PY, PW, PH, 'Norton Commander');
   SetColor(15);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6, NCState.PromptBuf);
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + 2 * RH + 6,
    '-- Appuyez sur une touche --');
  End;
  ncHistory: Begin
   SetFillStyle(SolidFill, 1);
   Bar(PX + 4, PY + TERM_TAB_HEIGHT + 4, PX + PW - 5, InfoY + RH);
   SetColor(15);
   Rectangle(PX + 4, PY + TERM_TAB_HEIGHT + 4, PX + PW - 5, InfoY + RH);
   OutTextXY(PX + 8, PY + TERM_TAB_HEIGHT + 6, 'Historique des commandes');
   VisRows := (InfoY + RH - (PY + TERM_TAB_HEIGHT + 4 + RH + 4)) Div RH;
   If VisRows < 1 Then VisRows := 1;
   HistTop := NCState.HistCursor - VisRows Div 2;
   If HistTop > TP.NumberHistory - VisRows + 1 Then
    HistTop := TP.NumberHistory - VisRows + 1;
   If HistTop < 1 Then HistTop := 1;
   Y := PY + TERM_TAB_HEIGHT + 4 + RH + 4;
   For I := HistTop To TP.NumberHistory Do Begin
    If Y > InfoY + RH - RH Then Break;
    If I = NCState.HistCursor Then Begin
     SetFillStyle(SolidFill, 3);
     Bar(PX + 6, Y, PX + PW - 7, Y + RH - 1);
     SetColor(0);
    End Else Begin
     SetFillStyle(SolidFill, 1);
     SetColor(15);
    End;
    S := TP.TermHistory[I];
    If Length(S) > (PW - 16) Div CW Then S := Copy(S, 1, (PW - 16) Div CW);
    OutTextXY(PX + 8, Y, S);
    Y := Y + RH;
   End;
   SetColor(11);
   OutTextXY(PX + 8, InfoY + RH - RH,
    '-- Entree pour utiliser, Echap pour fermer --');
  End;
  ncTree: Begin
   SetFillStyle(SolidFill, 1);
   Bar(PX + 4, PY + TERM_TAB_HEIGHT + 4, PX + PW - 5, InfoY + RH);
   SetColor(15);
   Rectangle(PX + 4, PY + TERM_TAB_HEIGHT + 4, PX + PW - 5, InfoY + RH);
   OutTextXY(PX + 8, PY + TERM_TAB_HEIGHT + 6, 'Arbre NCD');
   VisRows := (InfoY + RH - (PY + TERM_TAB_HEIGHT + 4 + RH + 4)) Div RH;
   If VisRows < 1 Then VisRows := 1;
   If NCState.TreeCursor < NCState.TreeTop Then
    NCState.TreeTop := NCState.TreeCursor;
   If NCState.TreeCursor >= NCState.TreeTop + VisRows Then
    NCState.TreeTop := NCState.TreeCursor - VisRows + 1;
   If NCState.TreeTop < 0 Then NCState.TreeTop := 0;
   Y := PY + TERM_TAB_HEIGHT + 4 + RH + 4;
   For I := NCState.TreeTop To NCState.TreeCount - 1 Do Begin
    If Y > InfoY + RH - RH Then Break;
    If I = NCState.TreeCursor Then Begin
     SetFillStyle(SolidFill, 3);
     Bar(PX + 6, Y, PX + PW - 7, Y + RH - 1);
     SetColor(0);
    End Else Begin
     SetFillStyle(SolidFill, 1);
     SetColor(15);
    End;
    S := PadLeft('', NCState.TreeNodes[I].Depth * 2, ' ') +
     NCLastComponent(NCState.TreeNodes[I].Path);
    If Length(S) > (PW - 16) Div CW Then S := Copy(S, 1, (PW - 16) Div CW);
    OutTextXY(PX + 8, Y, S);
    Y := Y + RH;
   End;
   If NCState.TreeCount = 0 Then Begin
    SetColor(15);
    OutTextXY(PX + 8, PY + TERM_TAB_HEIGHT + 4 + RH + 4, '(aucun sous-repertoire)');
   End;
   SetColor(11);
   OutTextXY(PX + 8, InfoY + RH - RH,
    '-- Entree pour se deplacer, Echap pour fermer --');
  End;
  ncChangeDrive: Begin
   { Alt+F1/Alt+F2 (NC.PAS: ChangeDrive) - petite boite modale avec une      }
   { rangee horizontale de lettres de lecteur, la selection courante en      }
   { surbrillance, exactement comme le "Lettre de disque" original. --- }
   NCDrawModalBox(PX, PY, PW, PH, 'Lettre de disque');
   SetColor(15);
   If NCState.CdSide = 0 Then S := 'Choisir le disque gauche :'
   Else S := 'Choisir le disque droite :';
   OutTextXY(PX + PW Div 6 + 6, PY + PH Div 3 + RH + 6, S);
   X0 := PX + PW Div 6 + 6;
   Y := PY + PH Div 3 + 2 * RH + 6;
   For I := 0 To NCState.CdCount - 1 Do Begin
    S := NCState.CdLetter[I] + ':';
    If I = NCState.CdCursor Then Begin
     SetFillStyle(SolidFill, 0);
     Bar(X0 - 1, Y - 2, X0 + TextWidth(S) + 3, Y + RH - 2);
     SetColor(11);
    End Else Begin
     SetFillStyle(SolidFill, 3);
     Bar(X0 - 1, Y - 2, X0 + TextWidth(S) + 3, Y + RH - 2);
     SetColor(0);
    End;
    OutTextXY(X0 + 1, Y, S);
    X0 := X0 + TextWidth(S) + 6;
   End;
  End;
 End;
End;

{ Aller dans le sous-repertoire nomme Name du panneau Side (ou remonter }
{ d un niveau si Name = '..'), puis recharger ce panneau. --- }
Procedure NCEnterDir(Side: Integer; Const Name: String);
Var
 NewPath: String;
Begin
 If Name = '..' Then
  NewPath := NCParentPath(NCState.Panes[Side].Path)
 Else Begin
  NewPath := NCState.Panes[Side].Path;
  { Deja termine par '\' ("\" virtuel ou "C:\" hote) : ne pas doubler. }
  If (Length(NewPath) > 0) And (NewPath[Length(NewPath)] = '\') Then
   NewPath := NewPath + Name
  Else
   NewPath := NewPath + '\' + Name;
 End;
 NCState.Panes[Side].Path := NewPath;
 NCListDir(NCState.Slot, NCState.Panes[Side]);
End;

{ Construire le chemin absolu Name a l interieur de DirPath, sans           }
{ doubler le separateur si DirPath se termine deja par '\'. --- }
Function NCFullPath(Const DirPath, Name: String): String;
Begin
 If (Length(DirPath) > 0) And (DirPath[Length(DirPath)] = '\') Then
  NCFullPath := DirPath + Name
 Else
  NCFullPath := DirPath + '\' + Name;
End;

{ Le curseur du panneau Side est-il sur l entree ".." (remontee au      }
{ parent, NCListDir) ? Elle ne doit jamais etre marquable ni la cible   }
{ de Copier/RenDep/Supprimer, seulement de la navigation (Entree). --- }
Function NCCursorOnDotDot(Side: Integer): Boolean;
Begin
 NCCursorOnDotDot := (NCState.Panes[Side].Count > 0) And
  (NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name = '..');
End;

{ --- F7/MKDIR, F8/Supprimer, F6/RenDep sur le systeme HOTE reel : ces   }
{ operations sont plus simples que sur la disquette virtuelle puisque       }
{ le Pascal standard (MkDir/RmDir/Erase/Rename) suffit. --- }
Function NCCmd_MkDirHost(ParentPath, DirName: String): Boolean;
Var
 Err: Word;
Begin
 NCCmd_MkDirHost := False;
 If DirName = '' Then Exit;
 {$I-} MkDir(NCFullPath(ParentPath, DirName)); {$I+}
 Err := IOResult;
 NCCmd_MkDirHost := (Err = 0);
End;

Function NCCmd_DeleteHost(FullPath: String; IsDir: Boolean): Boolean;
Var
 F: File;
 Err: Word;
Begin
 If IsDir Then Begin
  {$I-} RmDir(FullPath); {$I+}
 End Else Begin
  {$I-} Assign(F, FullPath); Erase(F); {$I+}
 End;
 Err := IOResult;
 NCCmd_DeleteHost := (Err = 0);
End;

Function NCCmd_RenameHost(OldFullPath, NewFullPath: String): Boolean;
Var
 F: File;
 Err: Word;
Begin
 {$I-} Assign(F, OldFullPath); Rename(F, NewFullPath); {$I+}
 Err := IOResult;
 NCCmd_RenameHost := (Err = 0);
End;

{ Convertit Len octets de Buf (a partir de Start, 0-based) en une chaine  }
{ affichable pour le mode Texte : les octets non imprimables (hors           }
{ 32..126) sont remplaces par '.', comme la colonne ASCII d un dump           }
{ hexadecimal classique - evite tout risque lie a des octets nuls ou           }
{ codes de controle dans un ShortString. Tronque a 255 caracteres           }
{ (limite native d un String en mode Turbo Pascal). --- }
Function NCViewBytesToLine(Const Buf: Array Of Byte; Start, Len: LongInt): String;
Var
 I: LongInt;
 B: Byte;
 R: String;
Begin
 If Len > 255 Then Len := 255;
 R := '';
 For I := 0 To Len - 1 Do Begin
  B := Buf[Start + I];
  If (B < 32) Or (B > 126) Then B := Ord('.');
  R := R + Chr(B);
 End;
 NCViewBytesToLine := R;
End;

{ Decoupe NCState.ViewRaw[0..ViewRawSize-1] (deja rempli par l appelant, }
{ hote ou disque virtuel) en lignes de texte sur CR/LF/CRLF               }
{ (NCState.ViewLines/ViewCount), pour le mode Texte du F3 par defaut -    }
{ partage entre toutes les sources de donnees de la visionneuse. --- }
Procedure NCViewSplitLines;
Var
 LineStart, I: LongInt;
Begin
 NCState.ViewCount := 0;
 LineStart := 0;
 I := 0;
 While (I < NCState.ViewRawSize) And (NCState.ViewCount < MAX_NC_VIEW_LINES) Do Begin
  If (NCState.ViewRaw[I] = 13) Or (NCState.ViewRaw[I] = 10) Then Begin
   NCState.ViewLines[NCState.ViewCount] :=
    NCViewBytesToLine(NCState.ViewRaw, LineStart, I - LineStart);
   Inc(NCState.ViewCount);
   If (NCState.ViewRaw[I] = 13) And (I + 1 < NCState.ViewRawSize) And
      (NCState.ViewRaw[I + 1] = 10) Then Inc(I); { sauter le LF du CRLF }
   Inc(I);
   LineStart := I;
  End Else
   Inc(I);
 End;
 If (LineStart < NCState.ViewRawSize) And (NCState.ViewCount < MAX_NC_VIEW_LINES) Then Begin
  NCState.ViewLines[NCState.ViewCount] :=
   NCViewBytesToLine(NCState.ViewRaw, LineStart, NCState.ViewRawSize - LineStart);
  Inc(NCState.ViewCount);
 End;
 If NCState.ViewCount = 0 Then Begin
  NCState.ViewLines[0] := '';
  NCState.ViewCount := 1;
 End;
End;

{ F3 : charger le fichier hote FullPath pour la visionneuse en lecture   }
{ seule - lecture binaire brute (NCState.ViewRaw/ViewRawSize, plafonnee  }
{ a MAX_NC_VIEW_RAW octets) qui alimente a la fois le mode Hexadecimal   }
{ (F4) et la recherche (F7), puis decoupage en lignes de texte           }
{ (NCState.ViewLines/ViewCount) pour le mode Texte par defaut. --- }
Procedure NCCmd_ViewFile(FullPath: String);
Var
 F: File;
 I: LongInt;
Begin
 NCState.ViewCount := 0;
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := True;
 NCState.ViewFileName := FullPath;
 NCState.ViewFileSize := 0;
 NCState.ViewRawSize := 0;
 {$I-} Assign(F, FullPath); Reset(F, 1); {$I+}
 If IOResult <> 0 Then Begin
  NCState.ViewLines[0] := '(impossible d''ouvrir le fichier)';
  NCState.ViewCount := 1;
  Exit;
 End;
 NCState.ViewFileSize := FileSize(F);
 I := NCState.ViewFileSize;
 If I > MAX_NC_VIEW_RAW Then I := MAX_NC_VIEW_RAW;
 {$I-} BlockRead(F, NCState.ViewRaw, I, NCState.ViewRawSize); {$I+}
 IOResult;
 Close(F);
 NCViewSplitLines;
End;

{ F3 sur un fichier d une disquette virtuelle Commodore 64 (.D64) :       }
{ StartTrack/StartSector viennent de TNCEntry.Cluster (empaquete par        }
{ NCListDir en Track Shl 8 Or Sector, D64 n a pas de "cluster" FAT).        }
{ Parcourt la chaine de secteurs de donnees exactement comme le ferait    }
{ le KERNAL C64 (LOAD) : chaque secteur non terminal contribue ses 254    }
{ octets de donnees (Buf[2..255]), le dernier secteur de la chaine            }
{ (Track de chainage = 0) ne contribue que jusqu a l octet indique par       }
{ le 2e octet de chainage - convention standard 1541 documentee dans          }
{ plusieurs sources independantes (ex. c1541/cbmconvert), mais jamais         }
{ recoupee avec la specification Commodore primaire : a corriger si un        }
{ fichier de test revele un decalage d un octet. --- }
Procedure NCCmd_ViewD64File(Slot: Byte; StartTrack, StartSector: Byte;
 Const DisplayName: String);
Begin
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := True;
 NCState.ViewFileName := DisplayName;
 D64_ReadFileChain(Slot, StartTrack, StartSector, NCState.ViewRaw,
  MAX_NC_VIEW_RAW, NCState.ViewRawSize);
 NCState.ViewFileSize := NCState.ViewRawSize;
 NCViewSplitLines;
End;

{ Disque > "Utilitaire reseau..." - extension DEV-COOLS sans equivalent   }
{ dans l ORIGINAL : etat courant de tout ce qui touche au reseau dans     }
{ l emulateur DOS 8086 (EmuPanel), pour qu un developpeur testant un      }
{ programme reseau DOS puisse voir d un coup d oeil ce qui est reellement }
{ emule (et donc pourquoi un programme peut echouer). Reutilise le        }
{ visualiseur texte F3 (NCState.ViewLines/ViewCount) comme un fichier      }
{ genere a la volee plutot qu un mode d affichage dedie. }
Procedure NCCmd_ViewNetworkStatus;
Var
 I, TotalChars: Integer;
 S: String;
 AnyFound: Boolean;

 Procedure Add(Const T: String);
 Begin
  If NCState.ViewCount < MAX_NC_VIEW_LINES Then Begin
   NCState.ViewLines[NCState.ViewCount] := T;
   Inc(NCState.ViewCount);
  End;
 End;

Begin
 NCState.ViewCount := 0;
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := False;
 NCState.ViewFileName := 'Utilitaires reseau - etat de l''emulateur DOS';
 NCState.ViewRawSize := 0;

 Add('ETAT RESEAU DE L''EMULATEUR DOS (Options > Emulateur > DOS)');
 Add('================================================================');
 Add('');
 Add('Reseau Novell (IPX/SPX) - INT 7Ah / INT 2Fh AX=7A00h');
 Add('----------------------------------------------------------------');
 If OptionsDlg.Data.DosNovell Then
  Add('  Case "Reseau Novell NetWare"  : cochee')
 Else
  Add('  Case "Reseau Novell NetWare"  : DEcochee (pile inactive)');
 If EmuIpx.Active Then Begin
  Add('  Etat de la pile               : ACTIVE');
  S := '  Adresse locale                : reseau ' +
   HexByte(EmuIpx.LocalNet[0]) + '-' + HexByte(EmuIpx.LocalNet[1]) + '-' +
   HexByte(EmuIpx.LocalNet[2]) + '-' + HexByte(EmuIpx.LocalNet[3]) +
   ', noeud ' +
   HexByte(EmuIpx.LocalNode[0]) + '-' + HexByte(EmuIpx.LocalNode[1]) + '-' +
   HexByte(EmuIpx.LocalNode[2]) + '-' + HexByte(EmuIpx.LocalNode[3]) + '-' +
   HexByte(EmuIpx.LocalNode[4]) + '-' + HexByte(EmuIpx.LocalNode[5]);
  Add(S);
  Add('');
  Add('  Sockets ouverts :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Sockets) Do
   If EmuIpx.Sockets[I].InUse Then Begin
    Add('    - ' + HexWord(EmuIpx.Sockets[I].SocketNum) + 'h');
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucun)');
  Add('');
  Add('  Ecoutes en attente (LISTEN poste, aucun paquet recu) :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Pending) Do
   If EmuIpx.Pending[I].InUse Then Begin
    Add('    - socket ' + HexWord(EmuIpx.Pending[I].SocketNum) + 'h, ECB a ' +
     HexWord(EmuIpx.Pending[I].ECBSeg) + ':' + HexWord(EmuIpx.Pending[I].ECBOfs));
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
  Add('');
  Add('  Paquets en file (SEND effectue, aucune ecoute correspondante) :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Queue) Do
   If EmuIpx.Queue[I].InUse Then Begin
    Add('    - destination ' + HexWord(EmuIpx.Queue[I].DestSocket) + 'h, ' +
     IntToStr(EmuIpx.Queue[I].Len) + ' octets');
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucun)');
  Add('');
  Add('  Connexions SPX actives :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Conns) Do
   If EmuIpx.Conns[I].InUse Then Begin
    S := '    - id ' + IntToStr(I + 1) + ' : local ' +
     HexWord(EmuIpx.Conns[I].LocalSocket) + 'h <-> distant ' +
     HexWord(EmuIpx.Conns[I].RemoteSocket) + 'h';
    If EmuIpx.Conns[I].Established Then S := S + ' (etablie)'
    Else S := S + ' (non etablie)';
    Add(S);
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
 End Else Begin
  Add('  Etat de la pile               : INACTIVE');
  Add('  (INT 7Ah/INT 2Fh AX=7A00h ne repondent pas - comme une vraie');
  Add('   machine sans IPX.COM/IPXODI charge)');
 End;
 Add('');

 Add('Ports serie (COM1-COM4) - INT 14h');
 Add('----------------------------------------------------------------');
 If EmuPanel.CPU.MemReady Then Begin
  Add('  COM1 (BDA 0040:0000) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $00)) + 'h');
  Add('  COM2 (BDA 0040:0002) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $02)) + 'h');
  Add('  COM3 (BDA 0040:0004) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $04)) + 'h');
  Add('  COM4 (BDA 0040:0006) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $06)) + 'h');
 End Else Begin
  Add('  (zone de donnees BIOS indisponible - aucune session emulateur');
  Add('   active pour l''instant : lancez d''abord un programme DOS)');
 End;
 Add('  => INT 14h (services serie BIOS) n''est PAS implante dans cet');
 Add('     emulateur : tout logiciel DOS s''appuyant sur un modem ou un');
 Add('     cable null-modem (jeux multijoueur par COM, LapLink/Interlnk,');
 Add('     BBS/terminal) ne pourra pas fonctionner ici.');
 Add('');

 Add('Reseau LAN generique (PC/TCP Packet Driver Specification, INT 60h)');
 Add('----------------------------------------------------------------');
 If OptionsDlg.Data.DosLAN Then
  Add('  Case "Reseau LAN"             : cochee')
 Else
  Add('  Case "Reseau LAN"             : DEcochee (pilote inactif)');
 Add('  Fabricant/produit             : ' +
  DosLANVendorName(OptionsDlg.Data.DosLANVendor));
 If EmuPkt.Active Then Begin
  Add('  Etat du pilote                : ACTIF (vecteur INT 60h)');
  S := '  Adresse locale                : ' +
   HexByte(EmuPkt.LocalMAC[0]) + '-' + HexByte(EmuPkt.LocalMAC[1]) + '-' +
   HexByte(EmuPkt.LocalMAC[2]) + '-' + HexByte(EmuPkt.LocalMAC[3]) + '-' +
   HexByte(EmuPkt.LocalMAC[4]) + '-' + HexByte(EmuPkt.LocalMAC[5]);
  Add(S);
  Add('');
  Add('  Poignees ouvertes (access_type) :');
  AnyFound := False;
  For I := 0 To High(EmuPkt.Handles) Do
   If EmuPkt.Handles[I].InUse Then Begin
    S := '    - handle ' + IntToStr(I + 1) + ' : classe ' +
     IntToStr(EmuPkt.Handles[I].IfClass) + ', ';
    If EmuPkt.Handles[I].TypeLen = 0 Then
     S := S + 'tout accepter (promiscuous)'
    Else
     S := S + IntToStr(EmuPkt.Handles[I].TypeLen) + ' octet(s) de filtre';
    S := S + ', mode reception ' + IntToStr(EmuPkt.Handles[I].RcvMode) +
     ', recepteur ' + HexWord(EmuPkt.Handles[I].RecvSeg) + ':' +
     HexWord(EmuPkt.Handles[I].RecvOfs);
    Add(S);
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
  Add('');
  Add('  Livraison en cours (cascade upcall recepteur/as_send_pkt) : ' );
  If EmuPkt.Cont.Pending Then
   Add('    oui (etape ' + IntToStr(EmuPkt.Cont.Stage) + ')')
  Else
   Add('    non');
  Add('');
  Add('  Statistiques :');
  Add('    Paquets recus     : ' + IntToStr(EmuPkt.Stats.PacketsIn));
  Add('    Paquets envoyes   : ' + IntToStr(EmuPkt.Stats.PacketsOut));
  Add('    Octets recus      : ' + IntToStr(EmuPkt.Stats.BytesIn));
  Add('    Octets envoyes    : ' + IntToStr(EmuPkt.Stats.BytesOut));
  Add('    Paquets perdus    : ' + IntToStr(EmuPkt.Stats.PacketsLost) +
   ' (file de livraison saturee)');
 End Else Begin
  Add('  Etat du pilote                : INACTIF');
  Add('  (INT 60h ne repond pas - comme une vraie machine sans pilote de');
  Add('   paquets charge : aucun octet "PKT DRVR" trouvable en memoire)');
 End;
 Add('  => Seule la specification Packet Driver (FTP Software/Crynwr) est');
 Add('     emulee. Un logiciel cherchant specifiquement un pilote ODI');
 Add('     (Novell Open Data-Link Interface) ou NDIS (Microsoft/3Com),');
 Add('     architectures a chainage de pilotes distinctes, ne trouvera');
 Add('     rien - seul le vecteur INT 60h "brut" ci-dessus existe.');

 { Estimation de la taille pour l affichage (cosmetique, comme pour un   }
 { vrai fichier charge par F3 - voir NCCmd_ViewFile). }
 TotalChars := 0;
 For I := 0 To NCState.ViewCount - 1 Do
  TotalChars := TotalChars + Length(NCState.ViewLines[I]) + 2;
 NCState.ViewFileSize := TotalChars;
End;

{ --- Actions F3/F4/F5/F6/F7/F8/F10, extraites de HandleNCommanderEvent  }
{ pour etre appelables a la fois par la touche directe ET par le menu    }
{ deroulant F9 (NCMenuExecute, menu "Fichiers") - meme comportement,           }
{ un seul endroit a maintenir. --- }
Procedure NCActionView(Side: Integer);
Var
 E: TNCEntry;
 TempPath: String;
Begin
 If NCState.Panes[Side].Count = 0 Then Exit;
 E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
 If E.IsDir Then Exit;
 If NCState.Slot < 0 Then Begin
  NCCmd_ViewFile(NCFullPath(NCState.Panes[Side].Path, E.Name));
  NCState.Mode := ncViewFile;
 End Else If FatVol[NCState.Slot].IsD64 Then Begin
  { La disquette virtuelle FAT (Slot >= 0 mais pas D64) reste hors de       }
  { portee ici, meme limitation preexistante que NCActionEdit/            }
  { NCActionOpenAssociated : pas de chemin hote direct pour ces fichiers. }
  NCCmd_ViewD64File(Byte(NCState.Slot), Byte(E.Cluster Shr 8),
   Byte(E.Cluster And $FF), E.Name);
  NCState.Mode := ncViewFile;
 End Else If FatVol[NCState.Slot].IsH8D Then Begin
  { Image .H8D : extrait vers un fichier hote temporaire (H8D_ExtractToTempFile, }
  { HDOS/UCSD uniquement - voir commentaire d en-tete du sous-systeme H8D    }
  { pour la limitation CP/M-80) puis reutilise NCCmd_ViewFile tel quel. }
  If H8D_ExtractToTempFile(Byte(NCState.Slot), E.Name, TempPath) Then Begin
   NCCmd_ViewFile(TempPath);
   NCState.ViewFileName := E.Name;
   NCState.Mode := ncViewFile;
  End;
 End;
End;

Procedure NCActionEdit(Side: Integer);
Var
 E: TNCEntry;
Begin
 If (NCState.Panes[Side].Count > 0) And (NCState.Slot < 0) Then Begin
  E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
  If Not E.IsDir Then
   PasChatOpenGeneratedFile(NCFullPath(NCState.Panes[Side].Path, E.Name));
 End;
End;

{ Un ".EXE" peut etre un vrai executable DOS 16 bits (en-tete MZ pur) ou }
{ un executable Win32/Win64 moderne (en-tete MZ suivi d un en-tete PE,   }
{ le classique stub "This program cannot be run in DOS mode") - seul le }
{ premier cas doit etre lance dans l emulateur 8086 integre. Le champ   }
{ e_lfanew (offset $3C) pointe vers la signature secondaire : 'PE'#0#0  }
{ pour Win32/Win64, 'NE' pour Windows 16 bits, 'LE'/'LX' pour OS/2/VxD  }
{ - toute autre valeur (ou l absence d en-tete secondaire exploitable)  }
{ signe un executable MZ classique. Un ".COM" n a pas d en-tete du tout }
{ (code brut charge a CS:0100h) et est donc toujours du DOS 16 bits.    }
{                                                                        }
{ PIEGE (trouve via BP.EXE, Borland Pascal 7.0, 1992, ~490 Ko) : sur un  }
{ VRAI executable DOS 16 bits ancien, l offset $3C n a jamais ete reserve}
{ par le linker de l epoque pour un e_lfanew - il contient simplement    }
{ des octets de programme/donnees quelconques qui, LUS COMME s ils       }
{ etaient un pointeur, peuvent par pure coincidence tomber sur une paire }
{ d octets 'N','E' (ou pire) ailleurs dans le fichier et declencher un   }
{ faux "c est du Win16 NE" - exactement ce qui arrive avec BP.EXE. Pour  }
{ eviter ce faux positif, on verifie D ABORD e_crlc (offset 6, nombre    }
{ d entrees de la table de translation) : un vrai executable DOS 16 bits}
{ RELOCALISABLE (le cas normal pour un programme d une taille pareille)  }
{ a TOUJOURS e_crlc > 0, alors qu un stub MZ precedant un vrai en-tete   }
{ PE/NE/LE (genere par le linker specifiquement comme code fixe, jamais  }
{ realloue) a TOUJOURS e_crlc = 0 - un signal beaucoup plus fiable que   }
{ de suivre un e_lfanew qui n a jamais ete ecrit intentionnellement.     }
Function NCIsDos16Exe(Const Path: String): Boolean;
Var
 F: File;
 Sig: Array[0..1] Of Char;
 CrlcBuf: Array[0..1] Of Byte;
 LfanewBuf: Array[0..3] Of Byte;
 HdrSig: Array[0..3] Of Char;
 Lfanew: LongInt;
 FSize: LongInt;
 BytesRead: Word;
Begin
 NCIsDos16Exe := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FSize := FileSize(F);
 If FSize < 64 Then Begin
  Close(F);
  Exit;
 End;
 BlockRead(F, Sig, 2, BytesRead);
 If (BytesRead <> 2) Or (Sig[0] <> 'M') Or (Sig[1] <> 'Z') Then Begin
  Close(F);
  Exit;
 End;
 Seek(F, 6);
 BlockRead(F, CrlcBuf, 2, BytesRead);
 If (BytesRead = 2) And ((CrlcBuf[0] <> 0) Or (CrlcBuf[1] <> 0)) Then Begin
  { e_crlc > 0 : de vraies relocalisations sont presentes - executable DOS}
  { 16 bits authentique, voir le commentaire de tete. Inutile (et risque) }
  { de suivre e_lfanew dans ce cas. }
  Close(F);
  NCIsDos16Exe := True;
  Exit;
 End;
 Seek(F, $3C);
 BlockRead(F, LfanewBuf, 4, BytesRead);
 If BytesRead <> 4 Then Begin
  Close(F);
  NCIsDos16Exe := True;
  Exit;
 End;
 Lfanew := LongInt(LfanewBuf[0]) Or (LongInt(LfanewBuf[1]) Shl 8) Or
  (LongInt(LfanewBuf[2]) Shl 16) Or (LongInt(LfanewBuf[3]) Shl 24);
 If (Lfanew <= 0) Or (Lfanew + 4 > FSize) Then Begin
  Close(F);
  NCIsDos16Exe := True;
  Exit;
 End;
 Seek(F, Lfanew);
 BlockRead(F, HdrSig, 4, BytesRead);
 Close(F);
 If BytesRead <> 4 Then Begin
  NCIsDos16Exe := True;
  Exit;
 End;
 If (HdrSig[0] = 'P') And (HdrSig[1] = 'E') And (HdrSig[2] = #0) And
    (HdrSig[3] = #0) Then Exit;
 If (HdrSig[0] = 'N') And (HdrSig[1] = 'E') Then Exit;
 If (HdrSig[0] = 'L') And ((HdrSig[1] = 'E') Or (HdrSig[1] = 'X')) Then
  Exit;
 NCIsDos16Exe := True;
End;

{ Binaire Linux ELF64 x86-64 (ex: BINLINUX\tp2js) - ces binaires n ont   }
{ generalement pas d extension, contrairement aux .EXE/.COM DOS ; seule }
{ la signature magique (7F 45 4C 46 = #$7F,'E','L','F') permet de les   }
{ reconnaitre. Meme verification que TermFindElfExecutable, mais sur un }
{ chemin deja connu plutot que par recherche-par-nom dans un repertoire.}
Function NCIsElfExecutable(Const Path: String): Boolean;
Var
 F: File;
 Magic: Array[0..3] Of Byte;
 BytesRead: Word;
Begin
 NCIsElfExecutable := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 BlockRead(F, Magic, SizeOf(Magic), BytesRead);
 Close(F);
 NCIsElfExecutable := (BytesRead = 4) And (Magic[0] = $7F) And
  (Magic[1] = Ord('E')) And (Magic[2] = Ord('L')) And (Magic[3] = Ord('F'));
End;

{ Un ".PRG" est ambigu entre deux plateformes emulees ici : un binaire      }
{ GEMDOS Atari ST (en-tete 28 octets, magic $60,$1A - voir M68K_LoadPRG)     }
{ ou un programme Commodore 64 (2 octets d adresse de chargement, aucune    }
{ signature fiable en soi, mais $60,$1A est un couple d octets qui ne          }
{ correspond a aucune adresse de chargement C64 plausible). On tranche         }
{ donc simplement sur la signature GEMDOS : presente -> Atari ST, absente     }
{ -> Commodore 64 (l hypothese par defaut, plus frequente dans ce depot). --- }
Function NCIsAtariSTPrg(Const Path: String): Boolean;
Var
 F: File;
 Magic: Array[0..1] Of Byte;
 BytesRead: Word;
Begin
 NCIsAtariSTPrg := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 BlockRead(F, Magic, SizeOf(Magic), BytesRead);
 Close(F);
 NCIsAtariSTPrg := (BytesRead = 2) And (Magic[0] = $60) And (Magic[1] = $1A);
End;

{ Entree sur un fichier associe a un emulateur integre plutot que de ne  }
{ rien faire (comme le ferait NC pour un fichier non associe) - le       }
{ disque hote (Slot<0) et une disquette virtuelle Commodore 64 montee    }
{ (Slot>=0 et FatVol[Slot].IsD64) sont tous deux supportes ; la           }
{ disquette virtuelle FAT reste hors de portee (meme limitation que          }
{ NCActionView/NCActionEdit, pas de chemin hote direct). Renvoie True si }
{ le fichier a ete pris en charge (l appelant ne doit alors rien faire      }
{ d autre). --- }
Function NCActionOpenAssociated(Side: Integer): Boolean;
Var
 E: TNCEntry;
 Ext, FullPath, TempPath: String;
Begin
 NCActionOpenAssociated := False;
 If NCState.Panes[Side].Count = 0 Then Exit;
 E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
 If E.IsDir Then Exit;
 If (NCState.Slot >= 0) And FatVol[NCState.Slot].IsD64 Then Begin
  { Disquette virtuelle .D64 : seul PRG est executable (SEQ/USR/REL/DEL   }
  { ne le sont pas) - extrait vers un fichier hote temporaire, puisque       }
  { CPU6502_LoadC64Prg lit toujours un chemin hote reel. }
  If UpCaseStr(NCExtractExt(E.Name)) = 'PRG' Then Begin
   If D64_ExtractToTempFile(Byte(NCState.Slot), Byte(E.Cluster Shr 8),
    Byte(E.Cluster And $FF), TempPath) Then Begin
    CreateEmulatorTab(TempPath, '-CC64', '');
    NCActionOpenAssociated := True;
   End;
  End;
  Exit;
 End;
 If (NCState.Slot >= 0) And FatVol[NCState.Slot].IsH8D Then Begin
  { Image .H8D : seuls les fichiers .CODE (p-code UCSD p-System) sont      }
  { executables - extraits vers un fichier hote temporaire (HDOS ou UCSD,  }
  { voir H8D_ExtractToTempFile) puis lances par l emulateur -CPCODE, meme  }
  { mecanisme que le .PRG D64 ci-dessus. }
  If UpCaseStr(NCExtractExt(E.Name)) = 'CODE' Then Begin
   If H8D_ExtractToTempFile(Byte(NCState.Slot), E.Name, TempPath) Then Begin
    CreateEmulatorTab(TempPath, '-CPCODE', '');
    NCActionOpenAssociated := True;
   End;
  End;
  Exit;
 End;
 If NCState.Slot < 0 Then Begin
  Ext := UpCaseStr(NCExtractExt(E.Name));
  FullPath := NCFullPath(NCState.Panes[Side].Path, E.Name);
  If Ext = 'NES' Then Begin
   CreateEmulatorTab(FullPath, '-CNES', '');
   NCActionOpenAssociated := True;
  End
  Else If Ext = 'XEX' Then Begin
   { Format binaire Atari 8-bit (segments [FF FF] start end data...),   }
   { charge par CPU6502_LoadAtariXex - un seul et meme chargeur pour        }
   { les deux cibles Atari 400/800 (memoire RAM disponible differente,    }
   { sans effet sur le format .XEX lui-meme). Atari 800 choisi par         }
   { defaut (plus de RAM, cible la plus courante) - aucune ambiguite         }
   { de format ne permet de deduire 400 vs 800 depuis le fichier seul. }
   CreateEmulatorTab(FullPath, '-CATARI800', '');
   NCActionOpenAssociated := True;
  End
  Else If Ext = 'PRG' Then Begin
   { .PRG hote : ambigu C64/Atari ST, tranche par la signature GEMDOS      }
   { (voir NCIsAtariSTPrg). }
   If NCIsAtariSTPrg(FullPath) Then
    CreateEmulatorTab(FullPath, '-CATARIST', '')
   Else
    CreateEmulatorTab(FullPath, '-CC64', '');
   NCActionOpenAssociated := True;
  End
  Else If Ext = 'CODE' Then Begin
   { p-code UCSD p-System brut mono-segment (convention DISPCODE/ASMPCODE.PAS }
   { de C:\SOURCE\PCODE) - voir PCode_Step. }
   CreateEmulatorTab(FullPath, '-CPCODE', '');
   NCActionOpenAssociated := True;
  End
  Else If (Ext = 'COM') Or
   ((Ext = 'EXE') And NCIsDos16Exe(FullPath)) Then Begin
   CreateEmulatorTab(FullPath, '-CD', '');
   NCActionOpenAssociated := True;
   End
   Else If (Ext = '') And NCIsElfExecutable(FullPath) Then Begin
    CreateEmulatorTab(FullPath, '-CELF64', '');
    NCActionOpenAssociated := True;
   End;
  End;
End;

Procedure NCActionCopyStart(Side, OtherSide: Integer);
Begin
 If (NCState.Panes[Side].Count > 0) And
    ((NCState.Panes[Side].MarkCount > 0) Or Not NCCursorOnDotDot(Side)) Then Begin
  NCState.PromptBuf := NCState.Panes[OtherSide].Path;
  NCState.Mode := ncPromptCopy;
 End;
End;

Procedure NCActionRenMovStart(Side: Integer);
Begin
 If (NCState.Panes[Side].Count > 0) And Not NCCursorOnDotDot(Side) Then Begin
  NCState.PromptBuf := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name;
  NCState.Mode := ncPromptRenMov;
 End;
End;

Procedure NCActionMkDirStart;
Begin
 NCState.PromptBuf := '';
 NCState.Mode := ncPromptMkDir;
End;

Procedure NCActionDeleteStart(Side: Integer);
Begin
 If (NCState.Panes[Side].MarkCount > 0) Or
    ((NCState.Panes[Side].Count > 0) And Not NCCursorOnDotDot(Side)) Then
  NCState.Mode := ncConfirmDelete;
End;

Procedure NCActionQuit;
Begin
 ActiveShell := SK_POWERSHELL;
 TermPanels[ActiveShell].NeedRepaint := True;
End;

{ Afficher un message simple (mode ncMessage) - reproduit fidelement          }
{ DialogNotImplement (NC.PAS:1373), deja un stub dans l ORIGINAL pour les          }
{ items du menu qui ne correspondent a aucune fonction cablee. ReturnMode  }
{ precise le mode a restaurer a la fermeture (ncBrowse depuis le menu           }
{ F9, mais ncViewFile depuis un choix non cable de "Select Viewer" F8,   }
{ pour ne pas ejecter l utilisateur de la visionneuse). --- }
Procedure NCShowMessage(Const Msg: String; ReturnMode: TNCMode);
Begin
 NCState.MessageReturnMode := ReturnMode;
 NCState.PromptBuf := Msg;
 NCState.Mode := ncMessage;
End;

{ F7 dans la visionneuse F3 : cherche NCState.ViewSearchBuf (insensible  }
{ a la casse) dans les lignes de texte a partir de la ligne suivant           }
{ la position courante, en bouclant sur tout le fichier si necessaire.   }
{ Bascule en mode Texte non renvoye a la ligne pour que ViewTop (index   }
{ de ligne) reste coherent avec le resultat trouve. --- }
Procedure NCViewPerformSearch;
Var
 I, StartLine: Integer;
 Found: Boolean;
 UpNeedle: String;
Begin
 If NCState.ViewSearchBuf = '' Then Exit;
 NCState.ViewHex := False;
 NCState.ViewWrap := False;
 NCState.ViewCol := 0;
 UpNeedle := UpCaseStr(NCState.ViewSearchBuf);
 Found := False;
 StartLine := NCState.ViewTop + 1;
 For I := StartLine To NCState.ViewCount - 1 Do
  If Pos(UpNeedle, UpCaseStr(NCState.ViewLines[I])) > 0 Then Begin
   NCState.ViewTop := I;
   Found := True;
   Break;
  End;
 If Not Found Then
  For I := 0 To StartLine - 1 Do
   If Pos(UpNeedle, UpCaseStr(NCState.ViewLines[I])) > 0 Then Begin
    NCState.ViewTop := I;
    Found := True;
    Break;
   End;
 If Not Found Then
  NCShowMessage('Chaine introuvable : ' + NCState.ViewSearchBuf, ncViewFile);
End;

{ Trier le panneau Side selon SortKind (0=Nom 1=Extension 2=Heure                }
{ 3=Taille 4=Desordre) - menu Gauche/Droite, items 8..12 (NC.PAS: TypeTri). --- }
Procedure NCActionSort(Side, SortKind: Integer);
Begin
 NCState.Panes[Side].SortMode := SortKind;
 NCListDir(NCState.Slot, NCState.Panes[Side]);
End;

{ "Permuter les panneaux" (menu Commandes, item 4) - echange entierement }
{ l etat des deux panneaux (chemin, curseur, tri, selection). --- }
Procedure NCActionSwapPanels;
Var
 Tmp: TNCPane;
Begin
 Tmp := NCState.Panes[0];
 NCState.Panes[0] := NCState.Panes[1];
 NCState.Panes[1] := Tmp;
End;

{ --- Etape 4 : Historique, Comparer/Synchroniser repertoires, Arbre NCD }
{ (menu Commandes). Le menu Disque reste entierement non implemente,           }
{ fidele a l ORIGINAL (deja confirme a l etape 3) - "Formater" n a donc  }
{ pas ete cable ici. --- }

{ Chercher Name (insensible a la casse) dans Pane ; -1 si absent. --- }
Function NCFindEntryByName(Const Pane: TNCPane; Const Name: String): Integer;
Var
 I: Integer;
Begin
 NCFindEntryByName := -1;
 For I := 0 To Pane.Count - 1 Do
  If UpCaseStr(Pane.Entries[I].Name) = UpCaseStr(Name) Then Begin
   NCFindEntryByName := I;
   Exit;
  End;
End;

{ "Compare les repertoires" (Commandes, item 6) : marque dans chaque      }
{ panneau les fichiers absents de l autre cote ou dont la taille differe. }
Procedure NCActionCompareDirs;
Var
 I, J: Integer;
Begin
 FillChar(NCState.Panes[0].Marked, SizeOf(NCState.Panes[0].Marked), False);
 FillChar(NCState.Panes[1].Marked, SizeOf(NCState.Panes[1].Marked), False);
 NCState.Panes[0].MarkCount := 0;
 NCState.Panes[1].MarkCount := 0;
 For I := 0 To NCState.Panes[0].Count - 1 Do
  If Not NCState.Panes[0].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[1], NCState.Panes[0].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[1].Entries[J].Size <> NCState.Panes[0].Entries[I].Size) Then Begin
    NCState.Panes[0].Marked[I] := True;
    Inc(NCState.Panes[0].MarkCount);
   End;
  End;
 For I := 0 To NCState.Panes[1].Count - 1 Do
  If Not NCState.Panes[1].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[0], NCState.Panes[1].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[0].Entries[J].Size <> NCState.Panes[1].Entries[I].Size) Then Begin
    NCState.Panes[1].Marked[I] := True;
    Inc(NCState.Panes[1].MarkCount);
   End;
  End;
End;

{ "Synchroniser les repertoires" (Commandes, item 7) : copie de Side vers }
{ l autre cote chaque fichier absent ou de taille differente, pour que          }
{ l autre panneau finisse par correspondre a celui-ci - systeme hote           }
{ uniquement, meme limitation que Copier/RenDep/Supprimer (etape 2). --- }
Procedure NCActionSyncDirs(Var TP: TTerminalPanel; Side: Integer);
Var
 OtherSide, I, J: Integer;
Begin
 If NCState.Slot >= 0 Then Begin
  NCShowMessage('La synchronisation n''est pas encore implementee pour la disquette virtuelle.', ncBrowse);
  Exit;
 End;
 OtherSide := Side Xor 1;
 For I := 0 To NCState.Panes[Side].Count - 1 Do
  If Not NCState.Panes[Side].Entries[I].IsDir Then Begin
   J := NCFindEntryByName(NCState.Panes[OtherSide], NCState.Panes[Side].Entries[I].Name);
   If (J < 0) Or
      (NCState.Panes[OtherSide].Entries[J].Size <> NCState.Panes[Side].Entries[I].Size) Then
    TermCopyFile(TP, NCFullPath(NCState.Panes[Side].Path,
     NCState.Panes[Side].Entries[I].Name), NCState.Panes[OtherSide].Path);
  End;
 NCListDir(NCState.Slot, NCState.Panes[0]);
 NCListDir(NCState.Slot, NCState.Panes[1]);
End;

{ "Historique" (Commandes, item 2) : ouvre la liste des commandes deja   }
{ tapees dans ce panneau (NC.PAS: DialogHistory, TP.TermHistory partage  }
{ avec les 4 autres shells). --- }
Procedure NCActionHistoryStart(Var TP: TTerminalPanel);
Begin
 If TP.NumberHistory <= 0 Then Begin
  NCShowMessage('Aucune commande dans l''historique.', ncBrowse);
  Exit;
 End;
 NCState.HistCursor := TP.NumberHistory;
 NCState.Mode := ncHistory;
End;

{ Parcours recursif des sous-repertoires de Path (systeme hote), borne  }
{ par MAX_NC_TREE_NODES et NC_TREE_MAX_DEPTH pour rester rapide sur une   }
{ arborescence reelle potentiellement tres grande (NC.PAS: NCD Arbre). --- }
Procedure NCTreeScan(Const Path: String; Depth: Integer);
Var
 SR: SearchRec;
Begin
 If (NCState.TreeCount >= MAX_NC_TREE_NODES) Or (Depth > NC_TREE_MAX_DEPTH) Then
  Exit;
 FindFirst(Path + '\*.*', Directory, SR);
 While (DosError = 0) And (NCState.TreeCount < MAX_NC_TREE_NODES) Do Begin
  If (SR.Name <> '.') And (SR.Name <> '..') And
     ((SR.Attr And Directory) <> 0) Then Begin
   NCState.TreeNodes[NCState.TreeCount].Path := NCFullPath(Path, SR.Name);
   NCState.TreeNodes[NCState.TreeCount].Depth := Depth;
   Inc(NCState.TreeCount);
   NCTreeScan(NCFullPath(Path, SR.Name), Depth + 1);
  End;
  FindNext(SR);
 End;
 {$IFDEF FPC} FindClose(SR); {$ENDIF}
End;

{ "Arbre NCD" (Commandes, item 0) : construit l arbre des sous-           }
{ repertoires du lecteur du panneau Side puis ouvre le mode ncTree. --- }
Procedure NCActionTreeStart(Side: Integer);
Var
 Root: String;
Begin
 If NCState.Slot >= 0 Then Begin
  NCShowMessage('L''arbre NCD n''est pas encore implemente pour la disquette virtuelle.', ncBrowse);
  Exit;
 End;
 NCState.TreeCount := 0;
 If Length(NCState.Panes[Side].Path) >= 2 Then
  Root := Copy(NCState.Panes[Side].Path, 1, 2) + '\'
 Else
  Root := NCState.Panes[Side].Path;
 NCTreeScan(Root, 0);
 NCState.TreeCursor := 0;
 NCState.TreeTop := 0;
 NCState.Mode := ncTree;
End;

{ Dispatcher central du menu deroulant F9 - reproduit fidelement le          }
{ Case PosMenu/PosItem de PullDnMenu (NC.PAS:2824-2946), y compris les          }
{ items reellement non implementes dans l ORIGINAL lui-meme : tout le          }
{ menu Disque, la plupart de Commandes, et les modes d affichage 0..7 de       }
{ Gauche/Droite (Arbre/Bref/Info/Link/Plein/Regard/Ouvert/Fermer). --- }
Procedure NCMenuExecute(Var TP: TTerminalPanel; Side, Top, Item: Integer);
Var
 TargetSide: Integer;
Begin
 Case Top Of
  0, 4: Begin
   { Gauche (Top=0) et Droite (Top=4) agissent toujours sur leur propre  }
   { cote, quel que soit le panneau actif - comme dans l original. }
   If Top = 0 Then TargetSide := 0 Else TargetSide := 1;
   Case Item Of
    2: NCState.Panes[TargetSide].InfoMode :=
     Not NCState.Panes[TargetSide].InfoMode; { Info }
    0, 1, 3..7:
     NCShowMessage('Ce mode d''affichage n''est pas encore implemente.', ncBrowse);
    8:  NCActionSort(TargetSide, 0);  { Nom }
    9:  NCActionSort(TargetSide, 1);  { Extension }
    10: NCActionSort(TargetSide, 2);  { Heure }
    11: NCActionSort(TargetSide, 3);  { Taille }
    12: NCActionSort(TargetSide, 4);  { Desordre }
    13: NCListDir(NCState.Slot, NCState.Panes[TargetSide]); { Relire }
    14: NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse); { Filtre }
    15: NCShowMessage('Le changement de lecteur n''est pas encore implemente.', ncBrowse);
   End;
  End;
  1: { Fichiers }
   Case Item Of
    2: NCActionView(Side);
    3: NCActionEdit(Side);
    4: NCActionCopyStart(Side, Side Xor 1);
    5: NCActionRenMovStart(Side);
    6: NCActionMkDirStart;
    7: NCActionDeleteStart(Side);
    13: NCActionQuit;
   Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
   End;
  2: { Disque : le reste du menu (Copier/Formater une disquette, Nommer  }
     { un disque, Nettoyage disque) reste non implemente, comme dans     }
     { l ORIGINAL. "Utilitaire reseau..." (item 3) est une extension     }
     { DEV-COOLS sans equivalent dans l ORIGINAL - voir                  }
     { NCCmd_ViewNetworkStatus. }
   If Item = 3 Then Begin
    NCCmd_ViewNetworkStatus;
    NCState.Mode := ncViewFile;
   End Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
  3: { Commandes : Arbre NCD, Historique, Permuter, Comparer et                 }
     { Synchroniser sont reellement cables (etape 4) ; le reste           }
     { (Recherche, Ligne EGA, Emulation terminal, editeurs/configuration)  }
     { reste hors-cadre, comme dans l ORIGINAL au-dela de ce sous-ensemble. }
   Case Item Of
    0: NCActionTreeStart(Side);      { Arbre NCD }
    2: NCActionHistoryStart(TP);     { Historique }
    4: NCActionSwapPanels;           { Permuter les panneaux }
    6: NCActionCompareDirs;          { Compare les repertoires }
    7: NCActionSyncDirs(TP, Side);   { Synchroniser les repertoires }
   Else
    NCShowMessage('Cette option n''est pas encore implementee.', ncBrowse);
   End;
 End;
End;

{ Support souris du menu deroulant F9 (Gauche/Fichiers/Disque/Commandes/  }
{ Droite) - ces deux fonctions recalculent EXACTEMENT la meme geometrie  }
{ que le tracer de ncMenuBar (DrawNCommanderPanel) pour que les zones           }
{ cliquables correspondent pixel pour pixel a ce qui est affiche. --- }

{ Index (0..4) du menu superieur sous MouseX, ou -1 si aucun. --- }
Function NCMenuHitTopItem(MouseX: Integer): Integer;
Var
 X0, W, I, CW: Integer;
 S: String;
Begin
 NCMenuHitTopItem := -1;
 CW := NCState.CharW;
 If CW < 1 Then CW := 8;
 X0 := TermX + CW;
 For I := 0 To NC_MENU_TOP_COUNT - 1 Do Begin
  S := ' ' + NC_MENU_TOP[I] + ' ';
  W := TextWidth(S);
  If (MouseX >= X0 - 2) And (MouseX <= X0 + W + 1) Then Begin
   NCMenuHitTopItem := I;
   Exit;
  End;
  X0 := X0 + W + 3 * CW;
 End;
End;

{ Rectangle du sous-menu deroulant actuellement ouvert (NCState.MenuTop). --- }
Procedure NCMenuDropdownBounds(Var DDLeft, DDRight, DDTop, DDBottom: Integer);
Var
 I, NameCols, CurCount, CW, RH: Integer;
Begin
 CW := NCState.CharW;
 If CW < 1 Then CW := 8;
 RH := TERM_LINE_HEIGHT;
 DDLeft := TermX + CW;
 For I := 0 To NCState.MenuTop - 1 Do
  DDLeft := DDLeft + TextWidth(' ' + NC_MENU_TOP[I] + ' ') + 3 * CW;
 CurCount := NCMenuItemCount(NCState.MenuTop);
 NameCols := 0;
 For I := 0 To CurCount - 1 Do
  If Length(NCMenuItemLabel(NCState.MenuTop, I)) > NameCols Then
   NameCols := Length(NCMenuItemLabel(NCState.MenuTop, I));
 DDRight := DDLeft + (NameCols + 4) * CW;
 If DDRight > TermX + TermWidth - 2 Then Begin
  DDLeft := TermX + TermWidth - 2 - (NameCols + 4) * CW;
  DDRight := TermX + TermWidth - 2;
 End;
 DDTop := TermY + TERM_TAB_HEIGHT + RH;
 DDBottom := DDTop + CurCount * RH;
End;

{ Gerer un evenement clavier/souris pour Norton Commander : navigation,   }
{ dialogues modaux (F5/F6/F7 saisie, F8 confirmation, F3 visionneuse),          }
{ et les touches de fonction elles-memes (TODO NC 2). --- }
Procedure HandleNCommanderEvent(Var TP: TTerminalPanel; Var Ev: TEvent);
Var
 Side, OtherSide, I: Integer;
 E: TNCEntry;
 CmdUp, CmdArg, FullSrc, FullDst: String;
Begin
 Side := NCState.Active;
 OtherSide := Side Xor 1;

 { --- Dialogues modaux : capturent le clavier avant la navigation. --- }
 If NCState.Mode <> ncBrowse Then Begin
  If Ev.Kind = EV_KEY_DOWN Then Begin
   If NCState.Mode = ncViewFile Then Case Ev.KeyCode Of
    72: If NCState.ViewTop > 0 Then Dec(NCState.ViewTop);
    80: If NCState.ViewTop < NCViewTotalRows - 1 Then Inc(NCState.ViewTop);
    73: Begin { PgUp }
     Dec(NCState.ViewTop, 10);
     If NCState.ViewTop < 0 Then NCState.ViewTop := 0;
    End;
    81: Begin { PgDn }
     Inc(NCState.ViewTop, 10);
     If NCState.ViewTop > NCViewTotalRows - 1 Then
      NCState.ViewTop := NCViewTotalRows - 1;
     If NCState.ViewTop < 0 Then NCState.ViewTop := 0;
    End;
    71: NCState.ViewTop := 0; { Home }
    79: NCState.ViewTop := NCViewTotalRows - 1; { Fin }
    75: { Gauche : defilement horizontal (Texte non renvoye a la ligne) }
     If (Not NCState.ViewHex) And (Not NCState.ViewWrap) And
        (NCState.ViewCol > 0) Then Dec(NCState.ViewCol);
    77: { Droite : idem }
     If (Not NCState.ViewHex) And (Not NCState.ViewWrap) Then
      Inc(NCState.ViewCol);
    $3B: NCShowMessage('Aide non disponible pour l''instant.', ncViewFile); { F1 }
    $3C: Begin { F2 : Unwrap - bascule le renvoi a la ligne }
     NCState.ViewWrap := Not NCState.ViewWrap;
     NCState.ViewTop := 0;
     NCState.ViewCol := 0;
    End;
    $3E: Begin { F4 : Hex - bascule Texte/Hexadecimal }
     NCState.ViewHex := Not NCState.ViewHex;
     NCState.ViewTop := 0;
     NCState.ViewCol := 0;
    End;
    $41: NCState.Mode := ncViewSearch; { F7 : Search }
    $42: Begin { F8 : Viewer - liste "Select Viewer" }
     If NCState.ViewHex Then NCState.ViewSelIdx := 6 Else NCState.ViewSelIdx := 5;
     NCState.Mode := ncViewSelectViewer;
    End;
    $44: NCState.Mode := ncBrowse; { F10 : Quit - retour aux 2 panneaux }
   End;
   If NCState.Mode = ncViewSelectViewer Then Case Ev.KeyCode Of
    72: If NCState.ViewSelIdx = 0 Then NCState.ViewSelIdx := NC_VIEWER_COUNT - 1
     Else Dec(NCState.ViewSelIdx);
    80: NCState.ViewSelIdx := (NCState.ViewSelIdx + 1) Mod NC_VIEWER_COUNT;
   End;
   If NCState.Mode = ncMenuBar Then Case Ev.KeyCode Of
    75: Begin { Gauche : menu superieur precedent, avec bouclage }
     If NCState.MenuTop = 0 Then NCState.MenuTop := NC_MENU_TOP_COUNT - 1
     Else Dec(NCState.MenuTop);
     NCState.MenuItem := 0;
    End;
    77: Begin { Droite : menu superieur suivant, avec bouclage }
     NCState.MenuTop := (NCState.MenuTop + 1) Mod NC_MENU_TOP_COUNT;
     NCState.MenuItem := 0;
    End;
    72: { Haut : item precedent dans le menu deroulant, avec bouclage }
     If NCState.MenuItem = 0 Then
      NCState.MenuItem := NCMenuItemCount(NCState.MenuTop) - 1
     Else
      Dec(NCState.MenuItem);
    80: { Bas : item suivant dans le menu deroulant, avec bouclage }
     NCState.MenuItem := (NCState.MenuItem + 1) Mod NCMenuItemCount(NCState.MenuTop);
   End;
   If NCState.Mode = ncHistory Then Case Ev.KeyCode Of
    72: If NCState.HistCursor > 1 Then Dec(NCState.HistCursor);
    80: If NCState.HistCursor < TP.NumberHistory Then Inc(NCState.HistCursor);
   End;
   If NCState.Mode = ncTree Then Begin
    Case Ev.KeyCode Of
     72: If NCState.TreeCursor > 0 Then Dec(NCState.TreeCursor);
     80: If NCState.TreeCursor < NCState.TreeCount - 1 Then Inc(NCState.TreeCursor);
     73: Begin { PgUp }
      Dec(NCState.TreeCursor, 10);
      If NCState.TreeCursor < 0 Then NCState.TreeCursor := 0;
     End;
     81: Begin { PgDn }
      Inc(NCState.TreeCursor, 10);
      If NCState.TreeCursor > NCState.TreeCount - 1 Then
       NCState.TreeCursor := NCState.TreeCount - 1;
      If NCState.TreeCursor < 0 Then NCState.TreeCursor := 0;
     End;
    End;
    If NCState.TreeCursor < NCState.TreeTop Then
     NCState.TreeTop := NCState.TreeCursor;
   End;
   If NCState.Mode = ncChangeDrive Then Case Ev.KeyCode Of
    75: { Gauche : lettre precedente, avec bouclage (NC.PAS: ChangeDrive) }
     If NCState.CdCount > 0 Then Begin
      If NCState.CdCursor = 0 Then NCState.CdCursor := NCState.CdCount - 1
      Else Dec(NCState.CdCursor);
     End;
    77: { Droite : lettre suivante, avec bouclage }
     If NCState.CdCount > 0 Then
      NCState.CdCursor := (NCState.CdCursor + 1) Mod NCState.CdCount;
   End;
   If NCState.Mode = ncMessage Then
    NCState.Mode := NCState.MessageReturnMode; { toute touche ferme }
  End;
  If Ev.Kind = EV_KEY_CHAR Then Begin
   Case NCState.Mode Of
    ncPromptMkDir, ncPromptCopy, ncPromptRenMov: Case Ev.KeyChar Of
     #27: Begin NCState.Mode := ncBrowse; NCState.PromptBuf := ''; End;
     #13: Begin
      Case NCState.Mode Of
       ncPromptMkDir:
        If NCState.PromptBuf <> '' Then Begin
         If NCState.Slot < 0 Then
          NCCmd_MkDirHost(NCState.Panes[Side].Path, NCState.PromptBuf)
         Else
          NCCmd_MkDir(NCState.Slot, NCState.Panes[Side].Path, NCState.PromptBuf);
         NCListDir(NCState.Slot, NCState.Panes[Side]);
        End;
       ncPromptCopy:
        If (NCState.PromptBuf <> '') And (NCState.Slot < 0) Then Begin
         If NCState.Panes[Side].MarkCount > 0 Then Begin
          For I := 0 To NCState.Panes[Side].Count - 1 Do
           If NCState.Panes[Side].Marked[I] Then
            TermCopyFile(TP, NCFullPath(NCState.Panes[Side].Path,
             NCState.Panes[Side].Entries[I].Name), NCState.PromptBuf);
         End Else If NCState.Panes[Side].Count > 0 Then
          TermCopyFile(TP, NCFullPath(NCState.Panes[Side].Path,
           NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name),
           NCState.PromptBuf);
         NCListDir(NCState.Slot, NCState.Panes[0]);
         NCListDir(NCState.Slot, NCState.Panes[1]);
        End;
       ncPromptRenMov:
        If (NCState.PromptBuf <> '') And (NCState.Slot < 0) And
           (NCState.Panes[Side].Count > 0) Then Begin
         FullSrc := NCFullPath(NCState.Panes[Side].Path,
          NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name);
         If Pos('\', NCState.PromptBuf) > 0 Then
          FullDst := NCState.PromptBuf
         Else
          FullDst := NCFullPath(NCState.Panes[Side].Path, NCState.PromptBuf);
         NCCmd_RenameHost(FullSrc, FullDst);
         NCListDir(NCState.Slot, NCState.Panes[Side]);
        End;
      End;
      NCState.Mode := ncBrowse;
      NCState.PromptBuf := '';
     End;
     #8:
      If Length(NCState.PromptBuf) > 0 Then
       NCState.PromptBuf := Copy(NCState.PromptBuf, 1, Length(NCState.PromptBuf) - 1);
    Else
     If (Ord(Ev.KeyChar) >= 32) And (Length(NCState.PromptBuf) < 200) Then
      NCState.PromptBuf := NCState.PromptBuf + Ev.KeyChar;
    End;
    ncConfirmDelete: Case UpCase(Ev.KeyChar) Of
     'O': Begin
      If NCState.Slot < 0 Then Begin
       If NCState.Panes[Side].MarkCount > 0 Then Begin
        For I := 0 To NCState.Panes[Side].Count - 1 Do
         If NCState.Panes[Side].Marked[I] Then
          NCCmd_DeleteHost(NCFullPath(NCState.Panes[Side].Path,
           NCState.Panes[Side].Entries[I].Name),
           NCState.Panes[Side].Entries[I].IsDir);
       End Else If NCState.Panes[Side].Count > 0 Then Begin
        E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
        NCCmd_DeleteHost(NCFullPath(NCState.Panes[Side].Path, E.Name), E.IsDir);
       End;
       NCListDir(NCState.Slot, NCState.Panes[Side]);
      End;
      NCState.Mode := ncBrowse;
     End;
     #27, 'N': NCState.Mode := ncBrowse;
    End;
    ncViewFile: If Ev.KeyChar = #27 Then NCState.Mode := ncBrowse;
    ncViewSearch: Case Ev.KeyChar Of
     #27: NCState.Mode := ncViewFile;
     #13: Begin
      NCViewPerformSearch;
      NCState.Mode := ncViewFile;
     End;
     #8:
      If Length(NCState.ViewSearchBuf) > 0 Then
       NCState.ViewSearchBuf :=
        Copy(NCState.ViewSearchBuf, 1, Length(NCState.ViewSearchBuf) - 1);
    Else
     If (Ord(Ev.KeyChar) >= 32) And (Length(NCState.ViewSearchBuf) < 120) Then
      NCState.ViewSearchBuf := NCState.ViewSearchBuf + Ev.KeyChar;
    End;
    ncViewSelectViewer: Case Ev.KeyChar Of
     #27: NCState.Mode := ncViewFile;
     #13: Begin
      Case NCState.ViewSelIdx Of
       5: NCState.ViewHex := False; { Text View }
       6: NCState.ViewHex := True;  { Hex }
      Else
       NCShowMessage('Ce format de visualisation n''est pas encore implemente.',
        ncViewFile);
      End;
      If NCState.Mode = ncViewSelectViewer Then Begin
       NCState.ViewTop := 0;
       NCState.ViewCol := 0;
       NCState.Mode := ncViewFile;
      End;
     End;
    End;
    ncMenuBar: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      NCMenuExecute(TP, Side, NCState.MenuTop, NCState.MenuItem);
      { NCMenuExecute peut deja avoir bascule vers un autre mode (saisie,   }
      { message...) - ne revenir a la navigation normale que s il ne l a   }
      { pas fait. }
      If NCState.Mode = ncMenuBar Then NCState.Mode := ncBrowse;
     End;
    End;
    ncMessage: NCState.Mode := NCState.MessageReturnMode; { toute touche ferme }
    ncHistory: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      TP.InputLine := TP.TermHistory[NCState.HistCursor];
      TP.InputCol := Length(TP.InputLine) + 1;
      NCState.Mode := ncBrowse;
     End;
    End;
    ncTree: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      If NCState.TreeCount > 0 Then Begin
       NCState.Panes[Side].Path := NCState.TreeNodes[NCState.TreeCursor].Path;
       NCListDir(NCState.Slot, NCState.Panes[Side]);
      End;
      NCState.Mode := ncBrowse;
     End;
    End;
    ncChangeDrive: Case Ev.KeyChar Of
     #27: NCState.Mode := ncBrowse;
     #13: Begin
      If NCState.CdCount > 0 Then Begin
       If NCState.CdIsVirt[NCState.CdCursor] Then Begin
        { NCState.Slot est PARTAGE entre les deux panneaux (limitation      }
        { architecturale preexistante) - choisir un lecteur virtuel ici    }
        { change donc aussi l interpretation de l AUTRE panneau. }
        NCState.Slot := NCState.CdSlotIdx[NCState.CdCursor];
        NCState.Panes[NCState.CdSide].Path := '\';
       End Else Begin
        NCState.Slot := -1;
        NCState.Panes[NCState.CdSide].Path :=
         NCState.CdLetter[NCState.CdCursor] + ':\';
       End;
       NCListDir(NCState.Slot, NCState.Panes[NCState.CdSide]);
      End;
      NCState.Mode := ncBrowse;
     End;
    End;
   End;
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;

 { --- Navigation et touches de fonction (mode normal). --- }
 If Ev.Kind = EV_KEY_DOWN Then Begin
  Case Ev.KeyCode Of
   72: { Haut }
    If NCState.Panes[Side].Cursor > 0 Then
     Dec(NCState.Panes[Side].Cursor);
   80: { Bas }
    If NCState.Panes[Side].Cursor < NCState.Panes[Side].Count - 1 Then
     Inc(NCState.Panes[Side].Cursor);
   73: { PgUp }
    Begin
     Dec(NCState.Panes[Side].Cursor, 10);
     If NCState.Panes[Side].Cursor < 0 Then NCState.Panes[Side].Cursor := 0;
    End;
   81: { PgDn }
    Begin
     Inc(NCState.Panes[Side].Cursor, 10);
     If NCState.Panes[Side].Cursor > NCState.Panes[Side].Count - 1 Then
      NCState.Panes[Side].Cursor := NCState.Panes[Side].Count - 1;
     If NCState.Panes[Side].Cursor < 0 Then NCState.Panes[Side].Cursor := 0;
    End;
   71: { Home }
    NCState.Panes[Side].Cursor := 0;
   79: { End }
    If NCState.Panes[Side].Count > 0 Then
     NCState.Panes[Side].Cursor := NCState.Panes[Side].Count - 1;
   82: { Insert : marquer/demarquer l entree courante (jamais ".." - comme  }
       { dans l original, elle ne se marque pas, on avance juste dessus). }
    If NCState.Panes[Side].Count > 0 Then Begin
     If Not NCCursorOnDotDot(Side) Then Begin
      NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor] :=
       Not NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor];
      If NCState.Panes[Side].Marked[NCState.Panes[Side].Cursor] Then
       Inc(NCState.Panes[Side].MarkCount)
      Else
       Dec(NCState.Panes[Side].MarkCount);
     End;
     If NCState.Panes[Side].Cursor < NCState.Panes[Side].Count - 1 Then
      Inc(NCState.Panes[Side].Cursor);
    End;
   $3D: NCActionView(Side);           { F3 : Voir }
   $3E: NCActionEdit(Side);            { F4 : Editer }
   $3F: NCActionCopyStart(Side, OtherSide); { F5 : Copier }
   $40: NCActionRenMovStart(Side);     { F6 : RenDep }
   $41: NCActionMkDirStart;            { F7 : CreRep }
   $42: NCActionDeleteStart(Side);     { F8 : Supprimer }
   $43: Begin { F9 : ouvrir le menu deroulant Gauche/Fichiers/Disque/       }
             { Commandes/Droite (NC.PAS: PullDnMenu). }
    NCState.MenuTop := 0;
    NCState.MenuItem := 0;
    NCState.Mode := ncMenuBar;
   End;
   $44: NCActionQuit;                  { F10 : Sortie - revenir a PowerShell dev }
   $3B, $3C:
    ; { F1 (Aide) / F2 (Menu utilisateur) : deja des stubs dans l ORIGINAL }
       { pour ce sous-ensemble - restent hors-cadre pour l instant. }
   $68: NCBuildChangeDriveList(0);  { Alt+F1 : lettre de disque, panneau gauche }
   $69: NCBuildChangeDriveList(1);  { Alt+F2 : lettre de disque, panneau droite }
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;
 If Ev.Kind = EV_KEY_CHAR Then Begin
  Case Ev.KeyChar Of
   #9: { Tab : changer de panneau actif }
    NCState.Active := NCState.Active Xor 1;
   #12: { Ctrl+L : basculer Fichiers/Info sur l AUTRE panneau (pas          }
        { celui actif) - menu Gauche/Droite, item "Info", NC.PAS. }
    NCState.Panes[OtherSide].InfoMode := Not NCState.Panes[OtherSide].InfoMode;
   #13: { Entree : executer la ligne de commande si non vide, sinon    }
         { ouvrir le repertoire sous le curseur. }
    If TrimStr(TP.InputLine) <> '' Then Begin
     CmdUp := UpCaseStr(TrimStr(TP.InputLine));
     If Copy(CmdUp, 1, 6) = 'MKDIR ' Then
      CmdArg := TrimStr(Copy(TP.InputLine, 7, Length(TP.InputLine) - 6))
     Else If Copy(CmdUp, 1, 3) = 'MD ' Then
      CmdArg := TrimStr(Copy(TP.InputLine, 4, Length(TP.InputLine) - 3))
     Else
      CmdArg := '';
     If CmdArg <> '' Then Begin
      { MKDIR/MD : chemin absolu explicite (hote ou disquette virtuelle) }
      { plutot que de dependre du repertoire courant reel du processus,      }
      { que TermExecuteCommand seul ne synchronise pas de facon fiable. }
      If NCState.Slot < 0 Then
       NCCmd_MkDirHost(NCState.Panes[Side].Path, CmdArg)
      Else
       NCCmd_MkDir(NCState.Slot, NCState.Panes[Side].Path, CmdArg);
      NCListDir(NCState.Slot, NCState.Panes[Side]);
     End Else Begin
      { Toute autre commande : moteur partage des 4 autres shells      }
      { (limitation connue pour le mode disque virtuel uniquement). }
      TP.VirtDrive := NCState.Slot;
      TP.VirtCwd := NCState.Panes[Side].Path;
      TermExecuteCommand(TP, TP.InputLine);
      NCState.Panes[Side].Path := TP.VirtCwd;
      NCListDir(NCState.Slot, NCState.Panes[Side]);
     End;
     TP.InputLine := '';
     TP.InputCol := 1;
    End Else If NCState.Panes[Side].Count > 0 Then Begin
     E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
     If E.IsDir Then NCEnterDir(Side, E.Name)
     Else NCActionOpenAssociated(Side);
    End;
   #8: { Retour arriere : effacer la ligne de commande, sinon remonter }
    If Length(TP.InputLine) > 0 Then
     TP.InputLine := Copy(TP.InputLine, 1, Length(TP.InputLine) - 1)
    Else
     NCEnterDir(Side, '..');
  Else
   If (Ord(Ev.KeyChar) >= 32) And (Length(TP.InputLine) < 200) Then
    TP.InputLine := TP.InputLine + Ev.KeyChar;
  End;
  TP.NeedRepaint := True;
  FullRepaintNeeded := True;
  Exit;
 End;
End;

{ --- Dessiner le panneau terminal avec selecteur deroulant --- }

Procedure DrawTerminalPanel(Var TP: TTerminalPanel);
Var
 I, YPos, VisLines: Integer;
 S, PromptStr, SelLabel: String;
 MaxCols: Integer;
 PX, PY, PW, PH: Integer;
 SBX, SBY: Integer;
 SBarX, TextRight: Integer;
 TrackTop, TrackBottom, TrackH: Integer;
 ThumbY, ThumbH: Integer;
 Node: PTermLine;
 SkipBack: LongInt;
 TextLines: LongInt;
Begin
 If Not TermVisible Then Exit;
 PX := TermX;
 PY := TermY;
 PW := TermWidth;
 PH := TermHeight;
 { Fond sombre (8=gris fonce, pas 0 car SetBkColor remappe 0) }
 SetFillStyle(SolidFill, 8);
 Bar(PX, PY, PX + PW - 1, PY + PH - 1);
 { Barre du haut avec titre TERMINAL et SelectBox }
 SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
 Bar(PX, PY, PX + PW - 1, PY + TERM_TAB_HEIGHT - 1);
 SetColor(15);
 OutTextXY(PX + 4, PY + 4, 'TERMINAL');
 { SelectBox deroulant a droite du titre }
 SBX := PX + 80;
 SBY := PY + 2;
 { Fond du selectbox : gris fonce }
 SetFillStyle(SolidFill, 8);
 Bar(SBX, SBY, SBX + TERM_SELECT_WIDTH - 1,
  SBY + TERM_SELECT_HEIGHT - 1);
 { Bordure du selectbox }
 SetColor(CLR_BORDER);
 Rectangle(SBX, SBY, SBX + TERM_SELECT_WIDTH - 1,
  SBY + TERM_SELECT_HEIGHT - 1);
 { Texte du SelectBox : nom du shell actif }
 Case ActiveShell Of
  SK_CMD:        SelLabel := 'Invite de commandes';
  SK_POWERSHELL: SelLabel := 'PowerShell dev';
  SK_BASH:       SelLabel := 'Bash';
  SK_AMIGADOS:   SelLabel := 'AmigaDOS';
  SK_NCOMMANDER: SelLabel := 'Norton Commander';
 End;
 SetColor(15);
 OutTextXY(SBX + 4, SBY + 3, SelLabel);
 { Fleche vers le bas }
 OutTextXY(SBX + TERM_SELECT_WIDTH - 14, SBY + 3, #31);
 { Bordure du panneau }
 SetColor(CLR_BORDER);
 Rectangle(PX, PY, PX + PW - 1, PY + PH - 1);
 SBarX := PX + PW - TERM_SCROLLBAR_WIDTH - 1;
 If TP.Shell = SK_NCOMMANDER Then Begin
  { Norton Commander remplace entierement le corps du panneau (grille
    double-panneau) - seule la liste deroulante du selecteur (dessinee
    plus bas, commune aux 5 shells) reste partagee. }
  DrawNCommanderPanel(TP, PX, PY, PW, PH);
 End Else Begin
  { DrawNCommanderPanel redefinit la palette 0 en noir reel pour toute  }
  { la duree ou Norton Commander est affiche (necessaire pour un fond   }
  { vraiment noir - voir la note dans DrawNCommanderPanel) et ne la          }
  { restaure pas elle-meme (un SetBkColor de restauration en fin de           }
  { fonction s est revele sans effet, probablement resolu au moment de   }
  { l affichage de l image plutot qu au moment du tracer). On la               }
  { restaure donc ici, cote "on quitte Norton Commander". }
  SetBkColor(CLR_BACKGROUND);
  { Zone de texte (reserver TERM_SCROLLBAR_WIDTH a droite) }
  TextRight := SBarX - 1;
  VisLines := (PH - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
   Div TERM_LINE_HEIGHT;
  If VisLines < 1 Then VisLines := 1;
  MaxCols := (TextRight - (PX + 4)) Div TERM_CHAR_WIDTH;
  If MaxCols < 10 Then MaxCols := 10;
  { Borner le decalage de defilement }
  If TP.HistCount = 0 Then TP.ScrollOffset := 0
  Else Begin
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   If TP.ScrollOffset > TP.HistCount - 1 Then
    TP.ScrollOffset := TP.HistCount - 1;
  End;
  { Trouver le noeud le plus en haut de la fenetre visible.
    Depuis le tail, reculer de (ScrollOffset + VisLines - 1) noeuds. }
  Node := TP.HistTail;
  SkipBack := TP.ScrollOffset + VisLines - 1;
  While (SkipBack > 0) And (Node <> Nil) And (Node^.Prev <> Nil) Do Begin
   Node := Node^.Prev;
   Dec(SkipBack);
  End;
  { Afficher VisLines lignes en avant }
  SetColor(15);
  YPos := PY + TERM_TAB_HEIGHT + 2;
  TextLines := 0;
  For I := 0 To VisLines - 1 Do Begin
   If Node <> Nil Then Begin
    S := Node^.S;
    If Length(S) > MaxCols Then
     S := Copy(S, 1, MaxCols);
    OutTextXY(PX + 4, YPos, S);
    Node := Node^.Next;
    Inc(TextLines);
   End;
   YPos := YPos + TERM_LINE_HEIGHT;
  End;
  { Ligne de saisie : visible uniquement si on n est pas remonte
    dans l historique (ScrollOffset = 0). Sinon on conserve la
    ligne pour le prochain affichage. }
  SetColor(10);
  If TextLines < VisLines Then
   YPos := PY + TERM_TAB_HEIGHT + 2
    + TextLines * TERM_LINE_HEIGHT
  Else
   YPos := PY + TERM_TAB_HEIGHT + 2
    + VisLines * TERM_LINE_HEIGHT;
  GetDir(0, PromptStr);
  If TP.VirtDrive >= 0 Then
   PromptStr := Term_VirtFullPath(TP);
  Case TP.Shell Of
   SK_POWERSHELL:
    PromptStr := 'PS ' + PromptStr + '> ' + TP.InputLine + '_';
   SK_BASH:
    PromptStr := 'user$ ' + TP.InputLine + '_';
   SK_AMIGADOS:
    PromptStr := '1.SYS:> ' + TP.InputLine + '_';
  Else
   PromptStr := PromptStr + '> ' + TP.InputLine + '_';
  End;
  If TP.ScrollOffset > 0 Then
   PromptStr := '-- defilement (PgUp/PgDn pour naviguer) --';
  If Length(PromptStr) > MaxCols Then
   PromptStr := Copy(PromptStr, 1, MaxCols);
  OutTextXY(PX + 4, YPos, PromptStr);
  { ===== Barre de defilement a droite ===== }
  { Fond de la barre }
  SetFillStyle(SolidFill, 7);
  Bar(SBarX, PY + TERM_TAB_HEIGHT,
   SBarX + TERM_SCROLLBAR_WIDTH - 1, PY + PH - 2);
  { Bordure }
  SetColor(CLR_BORDER);
  Rectangle(SBarX, PY + TERM_TAB_HEIGHT,
   SBarX + TERM_SCROLLBAR_WIDTH - 1, PY + PH - 2);
  { Bouton fleche haut }
  SetFillStyle(SolidFill, 8);
  Bar(SBarX + 1, PY + TERM_TAB_HEIGHT + 1,
   SBarX + TERM_SCROLLBAR_WIDTH - 2,
   PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H - 1);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 1, PY + TERM_TAB_HEIGHT + 1,
   SBarX + TERM_SCROLLBAR_WIDTH - 2,
   PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H - 1);
  SetColor(15);
  OutTextXY(SBarX + 3, PY + TERM_TAB_HEIGHT + 3, #30);
  { Bouton fleche bas }
  SetFillStyle(SolidFill, 8);
  Bar(SBarX + 1, PY + PH - 2 - TERM_SCROLL_BTN_H,
   SBarX + TERM_SCROLLBAR_WIDTH - 2, PY + PH - 3);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 1, PY + PH - 2 - TERM_SCROLL_BTN_H,
   SBarX + TERM_SCROLLBAR_WIDTH - 2, PY + PH - 3);
  SetColor(15);
  OutTextXY(SBarX + 3, PY + PH - 1 - TERM_SCROLL_BTN_H + 2, #31);
  { Zone du curseur (entre les deux fleches) }
  TrackTop := PY + TERM_TAB_HEIGHT + TERM_SCROLL_BTN_H + 1;
  TrackBottom := PY + PH - 3 - TERM_SCROLL_BTN_H;
  TrackH := TrackBottom - TrackTop + 1;
  If TrackH < 4 Then TrackH := 4;
  { Curseur proportionnel : taille = VisLines / HistCount }
  If TP.HistCount > VisLines Then Begin
   ThumbH := (LongInt(VisLines) * TrackH) Div TP.HistCount;
   If ThumbH < 8 Then ThumbH := 8;
   If ThumbH > TrackH Then ThumbH := TrackH;
   { Position : 0 (bas) -> bas du track, max -> haut du track }
   { Position depuis le bas : ScrollOffset / (HistCount - VisLines) }
   If TP.HistCount > VisLines Then
    ThumbY := TrackBottom - ThumbH + 1
     - (LongInt(TP.ScrollOffset) * (TrackH - ThumbH))
       Div (TP.HistCount - VisLines)
   Else
    ThumbY := TrackTop;
  End Else Begin
   ThumbH := TrackH;
   ThumbY := TrackTop;
  End;
  SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
  Bar(SBarX + 2, ThumbY,
   SBarX + TERM_SCROLLBAR_WIDTH - 3, ThumbY + ThumbH - 1);
  SetColor(CLR_BORDER);
  Rectangle(SBarX + 2, ThumbY,
   SBarX + TERM_SCROLLBAR_WIDTH - 3, ThumbY + ThumbH - 1);
 End;
 { Dessiner la liste deroulante PAR-DESSUS le texte }
 If TermSelectOpen Then Begin
  { Item 1 : Invite de commandes }
  If TermSelectIdx = 0 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4, SBY + TERM_SELECT_HEIGHT + 3,
   'Invite de commandes');
  { Item 2 : PowerShell dev }
  If TermSelectIdx = 1 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + TERM_SELECT_ITEM_H + 3,
   'PowerShell dev');
  { Item 3 : Bash }
  If TermSelectIdx = 2 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 2 * TERM_SELECT_ITEM_H + 3,
   'Bash');
  { Item 4 : AmigaDOS }
  If TermSelectIdx = 3 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 3 * TERM_SELECT_ITEM_H + 3,
   'AmigaDOS');
  { Item 5 : Norton Commander }
  If TermSelectIdx = 4 Then
   SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE)
  Else
   SetFillStyle(SolidFill, 8);
  Bar(SBX, SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 5 * TERM_SELECT_ITEM_H - 1);
  SetColor(15);
  OutTextXY(SBX + 4,
   SBY + TERM_SELECT_HEIGHT + 4 * TERM_SELECT_ITEM_H + 3,
   'Norton Commander');
  { Bordure de la liste }
  SetColor(CLR_BORDER);
  Rectangle(SBX, SBY + TERM_SELECT_HEIGHT,
   SBX + TERM_SELECT_WIDTH - 1,
   SBY + TERM_SELECT_HEIGHT + 5 * TERM_SELECT_ITEM_H - 1);
 End;
 TP.NeedRepaint := False;
End;

Procedure HandleTerminalEvent(Var TP: TTerminalPanel;
 Var Ev: TEvent);
Var
 Ch: Char;
 Dir: String;
 SBX, SBY: Integer;
 NewShell: TShellKind;
 FKBarCW, FKBarY, FKBarColW, FKBarSlot: Integer;
 FakeEv: TEvent;
 DDLeft, DDRight, DDTop, DDBottom, TopHit, ItemHit: Integer;
Begin
 If Not TermVisible Then Exit;
 { Position du SelectBox }
 SBX := TermX + 80;
 SBY := TermY + 2;
 { Clic souris }
 If (Ev.Kind = EV_MOUSE_DOWN) Then Begin
  { Clic droit dans la zone du terminal : menu contextuel }
  If (Ev.MouseBtn = MB_RIGHT) And
     (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   InitContextMenu(CtxMenu);
   CtxMenu.X := Ev.MouseX;
   CtxMenu.Y := Ev.MouseY;
   CtxMenu.Width := 200;
   AddContextItem(CtxMenu, 'Aide', 900);
   AddContextItem(CtxMenu, 'Sauvegarder historiques', 901);
   AddContextItem(CtxMenu, 'Zoom', 902);
   CtxMenu.Visible := True;
   DrawContextMenu(CtxMenu);
   Exit;
  End;
  { Si la liste deroulante est ouverte, verifier clic sur un item }
  If TermSelectOpen Then Begin
   { Item 1 : Invite de commandes }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_CMD;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_CMD].LineCount = 0 Then
      TermAddLine(TermPanels[SK_CMD],
       'Invite de commandes developpeur. Tapez HELP.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 2 : PowerShell dev }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 2 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_POWERSHELL;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_POWERSHELL].LineCount = 0 Then
      TermAddLine(TermPanels[SK_POWERSHELL],
       'PowerShell developpeur. Tapez HELP.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 3 : Bash }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 2 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 3 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_BASH;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_BASH].LineCount = 0 Then
      TermAddLine(TermPanels[SK_BASH],
       'Bash terminal. Tapez help.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 4 : AmigaDOS }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 3 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 4 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_AMIGADOS;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[SK_AMIGADOS].LineCount = 0 Then
      TermAddLine(TermPanels[SK_AMIGADOS],
       'AmigaDOS 3.1. Tapez ? pour la liste des commandes.');
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Item 5 : Norton Commander }
   If (Ev.MouseX >= SBX) And
      (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
      (Ev.MouseY >= SBY + TERM_SELECT_HEIGHT
       + 4 * TERM_SELECT_ITEM_H) And
      (Ev.MouseY < SBY + TERM_SELECT_HEIGHT
       + 5 * TERM_SELECT_ITEM_H) Then Begin
    NewShell := SK_NCOMMANDER;
    TermSelectOpen := False;
    ActiveShell := NewShell;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   { Clic ailleurs : fermer la liste }
   TermSelectOpen := False;
   FullRepaintNeeded := True;
  End;
  { Clic sur le SelectBox ferme : ouvrir/fermer la liste }
  If (Ev.MouseX >= SBX) And
     (Ev.MouseX < SBX + TERM_SELECT_WIDTH) And
     (Ev.MouseY >= SBY) And
     (Ev.MouseY < SBY + TERM_SELECT_HEIGHT) Then Begin
   TermSelectOpen := Not TermSelectOpen;
   If TermSelectOpen Then
    Case ActiveShell Of
     SK_CMD:        TermSelectIdx := 0;
     SK_POWERSHELL: TermSelectIdx := 1;
     SK_BASH:       TermSelectIdx := 2;
     SK_AMIGADOS:   TermSelectIdx := 3;
     SK_NCOMMANDER: TermSelectIdx := 4;
    End;
   FullRepaintNeeded := True;
   Exit;
  End;
  { Clic dans la zone du terminal }
  If (Ev.MouseX >= TermX) And
     (Ev.MouseX < TermX + TermWidth) And
     (Ev.MouseY >= TermY) And
     (Ev.MouseY < TermY + TermHeight) Then Begin
   If TermSelectOpen Then Begin
    TermSelectOpen := False;
    FullRepaintNeeded := True;
   End;
   { Clic sur la barre de touches de fonction de Norton Commander : agit }
   { comme la touche F correspondante (le "message du bouton" clique),   }
   { pour les utilisateurs qui preferent la souris au clavier. Fonctionne  }
   { quel que soit le mode courant (parcours, dialogue, visionneuse F3)   }
   { puisqu on simule simplement l appui de touche - HandleNCommanderEvent  }
   { route deja correctement chaque code de touche selon le mode actif. }
   If ActiveShell = SK_NCOMMANDER Then Begin
    FKBarCW := NCState.CharW;
    If FKBarCW < 1 Then FKBarCW := 8;
    FKBarY := TermY + TermHeight - TERM_LINE_HEIGHT;
    If (Ev.MouseY >= FKBarY) And (Ev.MouseY < TermY + TermHeight) Then Begin
     FKBarColW := (TermWidth - 2 * FKBarCW) Div 10;
     If FKBarColW < 8 * FKBarCW Then FKBarColW := 8 * FKBarCW;
     FKBarSlot := (Ev.MouseX - TermX) Div FKBarColW + 1;
     If (FKBarSlot >= 1) And (FKBarSlot <= 10) Then Begin
      FillChar(FakeEv, SizeOf(FakeEv), 0);
      FakeEv.Kind := EV_KEY_DOWN;
      FakeEv.KeyCode := $3A + FKBarSlot; { F1=$3B .. F10=$44 }
      HandleNCommanderEvent(TP, FakeEv);
     End;
     Exit;
    End;
    { Clic dans le menu deroulant F9 (Gauche/Fichiers/Disque/Commandes/    }
    { Droite), quand il est ouvert - meme geometrie que ncMenuBar dans           }
    { DrawNCommanderPanel (NCMenuHitTopItem/NCMenuDropdownBounds). }
    If NCState.Mode = ncMenuBar Then Begin
     TopHit := NCMenuHitTopItem(Ev.MouseX);
     If (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) And
        (Ev.MouseY < TermY + TERM_TAB_HEIGHT + TERM_LINE_HEIGHT) And
        (TopHit >= 0) Then Begin
      { Clic sur un des 5 menus superieurs : y basculer (comme            }
      { Gauche/Droite au clavier), sans executer d item. }
      NCState.MenuTop := TopHit;
      NCState.MenuItem := 0;
      FullRepaintNeeded := True;
      Exit;
     End;
     NCMenuDropdownBounds(DDLeft, DDRight, DDTop, DDBottom);
     If (Ev.MouseX >= DDLeft) And (Ev.MouseX <= DDRight) And
        (Ev.MouseY >= DDTop) And (Ev.MouseY < DDBottom + 1) Then Begin
      { Clic sur un item du sous-menu : le selectionner ET l executer,       }
      { comme Entree au clavier. }
      ItemHit := (Ev.MouseY - DDTop) Div TERM_LINE_HEIGHT;
      If ItemHit < 0 Then ItemHit := 0;
      If ItemHit > NCMenuItemCount(NCState.MenuTop) - 1 Then
       ItemHit := NCMenuItemCount(NCState.MenuTop) - 1;
      NCState.MenuItem := ItemHit;
      NCMenuExecute(TP, NCState.Active, NCState.MenuTop, NCState.MenuItem);
      If NCState.Mode = ncMenuBar Then NCState.Mode := ncBrowse;
      FullRepaintNeeded := True;
      Exit;
     End;
     { Clic en dehors de la barre et du sous-menu : fermer le menu,             }
     { comme Echap (convention habituelle des menus deroulants). }
     NCState.Mode := ncBrowse;
     FullRepaintNeeded := True;
     Exit;
    End;
   End;
   { Defilement via la barre a droite }
   If (Ev.MouseX >= TermX + TermWidth - TERM_SCROLLBAR_WIDTH - 1)
    And (Ev.MouseX < TermX + TermWidth - 1)
    And (Ev.MouseY >= TermY + TERM_TAB_HEIGHT) Then Begin
    { Bouton fleche haut : remonter d une ligne }
    If Ev.MouseY < TermY + TERM_TAB_HEIGHT
     + TERM_SCROLL_BTN_H Then Begin
     If TP.ScrollOffset < TP.HistCount - 1 Then Begin
      Inc(TP.ScrollOffset);
      TP.NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     Exit;
    End;
    { Bouton fleche bas : descendre d une ligne }
    If Ev.MouseY >= TermY + TermHeight - 2
     - TERM_SCROLL_BTN_H Then Begin
     If TP.ScrollOffset > 0 Then Begin
      Dec(TP.ScrollOffset);
      TP.NeedRepaint := True;
      FullRepaintNeeded := True;
     End;
     Exit;
    End;
    { Clic dans le track : page up/down selon position relative
      au curseur (heuristique simple : moitie haute = remonter,
      moitie basse = descendre, page = hauteur visible). }
    If Ev.MouseY < (TermY + TERM_TAB_HEIGHT
     + (TermHeight - TERM_TAB_HEIGHT) Div 2) Then Begin
     TP.ScrollOffset := TP.ScrollOffset +
      ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
       Div TERM_LINE_HEIGHT);
     If TP.ScrollOffset > TP.HistCount - 1 Then
      TP.ScrollOffset := TP.HistCount - 1;
    End Else Begin
     TP.ScrollOffset := TP.ScrollOffset -
      ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
       Div TERM_LINE_HEIGHT);
     If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
    End;
    TP.NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   Exit;
  End;
 End;
 { Navigation clavier dans la liste deroulante }
 If TermSelectOpen Then Begin
  If Ev.Kind = EV_KEY_DOWN Then Begin
   If Ev.KeyCode = $48 Then Begin { Fleche haut }
    If TermSelectIdx > 0 Then
     Dec(TermSelectIdx);
    FullRepaintNeeded := True;
    Exit;
   End;
   If Ev.KeyCode = $50 Then Begin { Fleche bas }
    If TermSelectIdx < 4 Then
     Inc(TermSelectIdx);
    FullRepaintNeeded := True;
    Exit;
   End;
  End;
  If Ev.Kind = EV_KEY_CHAR Then Begin
   If Ev.KeyChar = #13 Then Begin { Enter : confirmer }
    Case TermSelectIdx Of
     0: NewShell := SK_CMD;
     1: NewShell := SK_POWERSHELL;
     2: NewShell := SK_BASH;
     3: NewShell := SK_AMIGADOS;
     4: NewShell := SK_NCOMMANDER;
    End;
    TermSelectOpen := False;
    If ActiveShell <> NewShell Then Begin
     ActiveShell := NewShell;
     If TermPanels[ActiveShell].LineCount = 0 Then
      Case ActiveShell Of
       SK_CMD:
        TermAddLine(TermPanels[SK_CMD],
         'Invite de commandes developpeur. Tapez HELP.');
       SK_POWERSHELL:
        TermAddLine(TermPanels[SK_POWERSHELL],
         'PowerShell developpeur. Tapez HELP.');
       SK_BASH:
        TermAddLine(TermPanels[SK_BASH],
         'Bash terminal. Tapez help.');
       SK_AMIGADOS:
        TermAddLine(TermPanels[SK_AMIGADOS],
         'AmigaDOS 3.1. Tapez ? pour la liste des commandes.');
      End;
    End;
    TermPanels[ActiveShell].NeedRepaint := True;
    FullRepaintNeeded := True;
    Exit;
   End;
   If Ev.KeyChar = #27 Then Begin { Echap : fermer }
    TermSelectOpen := False;
    FullRepaintNeeded := True;
    Exit;
   End;
  End;
  Exit;
 End;
 { Norton Commander : modele d interaction completement different       }
 { (grille double-panneau + touches de fonction), pas de ligne de           }
 { commande partagee - delegue entierement a son propre gestionnaire. }
 If TP.Shell = SK_NCOMMANDER Then Begin
  HandleNCommanderEvent(TP, Ev);
  Exit;
 End;
 { Clavier }
 If Ev.Kind = EV_KEY_CHAR Then Begin
  Ch := Ev.KeyChar;
  Case Ch Of
   #8: Begin { Backspace }
    If Length(TP.InputLine) > 0 Then Begin
     TP.InputLine := Copy(TP.InputLine, 1,
      Length(TP.InputLine) - 1);
     TP.NeedRepaint := True;
    End;
   End;
   #13: Begin { Enter }
    GetDir(0, Dir);
    { Toute saisie ramene la fenetre au bas de l historique }
    TP.ScrollOffset := 0;
    Case TP.Shell Of
     SK_POWERSHELL:
      TermAddLine(TP, 'PS ' + Dir + '> ' + TP.InputLine);
     SK_BASH:
      TermAddLine(TP, 'user$ ' + TP.InputLine);
     SK_AMIGADOS:
      TermAddLine(TP, '1.SYS:> ' + TP.InputLine);
    Else
     TermAddLine(TP, Dir + '> ' + TP.InputLine);
    End;
    TermExecuteCommand(TP, TP.InputLine);
    TP.InputLine := '';
    TP.InputCol := 1;
    TP.ScrollOffset := 0;
    TP.NeedRepaint := True;
   End;
   #27: ; { Echap : ne rien faire }
  Else
   If (Ord(Ch) >= 32) And
    (Length(TP.InputLine) < 240) Then Begin
    TP.InputLine := TP.InputLine + Ch;
    Inc(TP.InputCol);
    TP.NeedRepaint := True;
   End;
  End;
 End;
 { Fleche haut/bas pour naviguer dans l historique }
 If Ev.Kind = EV_KEY_DOWN Then Begin
  If (Ev.KeyCode = $48) And { Fleche haut }
   (TP.NumberHistory > 0) Then Begin
   If TP.HistoryPos > 1 Then
    Dec(TP.HistoryPos);
   TP.InputLine := TP.TermHistory[TP.HistoryPos];
   TP.InputCol := Length(TP.InputLine) + 1;
   TP.NeedRepaint := True;
  End
  Else If (Ev.KeyCode = $50) And { Fleche bas }
   (TP.NumberHistory > 0) Then Begin
   If TP.HistoryPos < TP.NumberHistory Then Begin
    Inc(TP.HistoryPos);
    TP.InputLine := TP.TermHistory[TP.HistoryPos];
   End Else Begin
    TP.HistoryPos := TP.NumberHistory + 1;
    TP.InputLine := '';
   End;
   TP.InputCol := Length(TP.InputLine) + 1;
   TP.NeedRepaint := True;
  End;
  { PageUp / PageDown : defilement de la fenetre d historique }
  If Ev.KeyCode = $49 Then Begin { PgUp }
   TP.ScrollOffset := TP.ScrollOffset +
    ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
     Div TERM_LINE_HEIGHT);
   If TP.ScrollOffset > TP.HistCount - 1 Then
    TP.ScrollOffset := TP.HistCount - 1;
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   TP.NeedRepaint := True;
   FullRepaintNeeded := True;
  End
  Else If Ev.KeyCode = $51 Then Begin { PgDn }
   TP.ScrollOffset := TP.ScrollOffset -
    ((TermHeight - TERM_TAB_HEIGHT - TERM_LINE_HEIGHT - 4)
     Div TERM_LINE_HEIGHT);
   If TP.ScrollOffset < 0 Then TP.ScrollOffset := 0;
   TP.NeedRepaint := True;
   FullRepaintNeeded := True;
  End;
 End;
End;

