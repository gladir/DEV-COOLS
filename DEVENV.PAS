     End;
    End;
   End;
  End Else Begin
   If EmuDbg.Paused Or (EmuPanel.Loaded And Not EmuHasFocus) Then Begin
    { Debogueur en pause, ou pas le focus emulateur : laisser passer. }
   End Else Begin
    HandleEmulatorPanelEvent(EmuPanel, Ev);
