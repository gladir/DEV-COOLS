{ --- Tester si un mot est un type/builtin Modula-3 --- }

Function IsMod3Builtin(Word: String): Boolean;
Begin
 IsMod3Builtin :=
  { Types primitifs }
  (Word = 'INTEGER')   Or (Word = 'REAL')      Or (Word = 'LONGREAL') Or
  (Word = 'EXTENDED')  Or (Word = 'BOOLEAN')   Or (Word = 'CHAR')     Or
