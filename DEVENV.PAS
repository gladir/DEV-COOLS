 If IsValidWindowIndex(Index) Then
  WinMgr.Windows[Index].Modified := True;
End;

{ --- Marquer une fenetre comme sauvegardee --- }

Procedure MarkWindowSaved(Index: Integer);
Begin
 If IsValidWindowIndex(Index) Then
