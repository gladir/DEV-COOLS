{ Tenter de basculer le terminal sur le lecteur virtuel Idx (image
  montee via /DISK0, /DISK1, /DISK80 ou /DISK81). Affiche un message
  d erreur si l unite n est pas montee ou pas reconnue comme FAT. }
Procedure Term_TryEnterVirtDrive(Var TP: TTerminalPanel; Idx: Byte;
 MountHint: String);
Var
 DL: Char;
Begin
 DL := Term_DriveLetterFromIdx(Idx);
 Term_VirtEnsureMounted(Idx);
 If EmuFloppyOpen[Idx] And FatVol[Idx].Mounted Then Begin
  TP.VirtDrive := Idx;
  If TP.VirtCwd = '' Then TP.VirtCwd := '\';
 End Else If EmuFloppyOpen[Idx] Then
  TermAddLine(TP, 'Volume ' + DL + ': monte mais format FAT non reconnu.')
 Else Begin
  TermAddLine(TP, 'Le systeme ne peut pas trouver le lecteur specifie.');
  TermAddLine(TP, '(Monter une image avec ' + MountHint + ' au demarrage.)');
 End;
End;

{ Cherche un executable DOS 16 bits (CmdName.COM puis CmdName.EXE, ou      }
{ CmdName tel quel s il a deja une extension .COM/.EXE) dans Dir - pour   }
{ le "fallback" du shell CMD : une commande non reconnue qui correspond   }
{ a un vrai binaire DOS present dans le repertoire courant est lancee           }
{ dans l emulateur 8086 integre plutot que de simplement s afficher            }
{ "non reconnue", comme le ferait authentiquement un vrai DOS. Renvoie   }
{ le chemin complet, ou '' si rien de correspondant n a ete trouve. --- }
Function TermFindDosExecutable(Const Dir, CmdName: String): String;
Var
 Base, UpName, Candidate: String;
Begin
 TermFindDosExecutable := '';
 Base := Dir;
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 UpName := UpCaseStr(CmdName);
 If (Length(UpName) > 4) And
    ((Copy(UpName, Length(UpName) - 3, 4) = '.COM') Or
     (Copy(UpName, Length(UpName) - 3, 4) = '.EXE')) Then Begin
  Candidate := Base + CmdName;
  If FileExists(Candidate) Then TermFindDosExecutable := Candidate;
  Exit;
 End;
 Candidate := Base + CmdName + '.COM';
 If FileExists(Candidate) Then Begin TermFindDosExecutable := Candidate; Exit; End;
 Candidate := Base + CmdName + '.EXE';
 If FileExists(Candidate) Then TermFindDosExecutable := Candidate;
End;

{ Cherche un executable Linux (ELF64 x86-64, sans extension - c est ainsi }
{ que les compilateurs *CW32 de ce projet nomment leur sortie Linux, voir }
{ BINLINUX\*) dans Dir - meme principe que TermFindDosExecutable ci-      }
{ dessus, mais la reconnaissance se fait sur la signature magique du      }
{ fichier (7F 45 4C 46) plutot que sur son extension, puisqu un binaire   }
{ Linux n en porte generalement pas. Renvoie le chemin complet, ou ''.   }
Function TermFindElfExecutable(Const Dir, CmdName: String): String;
Var
 Base, Candidate: String;
 F: File;
 Magic: Array[0..3] Of Byte;
 BytesReaded: Word;
Begin
 TermFindElfExecutable := '';
 Base := Dir;
 If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
 Candidate := Base + CmdName;
 If Not FileExists(Candidate) Then Exit;
 {$I-}
 Assign(F, Candidate);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FillChar(Magic, SizeOf(Magic), 0);
 BlockRead(F, Magic, SizeOf(Magic), BytesReaded);
 Close(F);
 If (BytesReaded = 4) And (Magic[0] = $7F) And (Magic[1] = Ord('E')) And
    (Magic[2] = Ord('L')) And (Magic[3] = Ord('F')) Then
  TermFindElfExecutable := Candidate;
End;

{ Cherche un .PRG executable pour CmdName tape dans un shell terminal -   }
{ soit sur le disque HOTE (TP.VirtDrive<0, dans Dir, tranche entre               }
{ Commodore 64 et Atari ST par signature GEMDOS, voir NCIsAtariSTPrg),      }
{ soit sur une disquette virtuelle Commodore 64 montee (TP.VirtDrive>=0     }
{ et FatVol[TP.VirtDrive].IsD64 - toujours C64, aucune ambiguite possible   }
{ sur ce format), auquel cas le fichier trouve est extrait vers un           }
{ fichier hote temporaire (voir D64_ExtractToTempFile) puisque              }
{ ShowEmulatorPanel/CPU6502_LoadC64Prg n acceptent qu un chemin hote reel.  }
{ Renvoie True si un .PRG a ete trouve et resolu, avec TargetCPU/                }
{ ResolvedPath prets pour ShowEmulatorPanel. --- }
Function TermFindPrgExecutable(Var TP: TTerminalPanel; Const Dir, CmdName: String;
 Var TargetCPU, ResolvedPath: String): Boolean;
Var
 Base, UpName, Candidate, BaseNoExt: String;
 Track, Sector: Byte;
Begin
 TermFindPrgExecutable := False;
 If TP.VirtDrive < 0 Then Begin
  Base := Dir;
  If (Length(Base) > 0) And (Base[Length(Base)] <> '\') Then Base := Base + '\';
  UpName := UpCaseStr(CmdName);
  If (Length(UpName) > 4) And (Copy(UpName, Length(UpName) - 3, 4) = '.PRG') Then
   Candidate := Base + CmdName
  Else
   Candidate := Base + CmdName + '.PRG';
  If Not FileExists(Candidate) Then Exit;
  ResolvedPath := Candidate;
  If NCIsAtariSTPrg(Candidate) Then TargetCPU := '-CATARIST'
  Else TargetCPU := '-CC64';
  TermFindPrgExecutable := True;
 End Else If FatVol[TP.VirtDrive].IsD64 Then Begin
  BaseNoExt := CmdName;
  If (Length(BaseNoExt) > 4) And
     (UpCaseStr(Copy(BaseNoExt, Length(BaseNoExt) - 3, 4)) = '.PRG') Then
   BaseNoExt := Copy(BaseNoExt, 1, Length(BaseNoExt) - 4);
  If D64_FindPrgEntry(Byte(TP.VirtDrive), BaseNoExt, Track, Sector) Then
   If D64_ExtractToTempFile(Byte(TP.VirtDrive), Track, Sector, ResolvedPath) Then Begin
    TargetCPU := '-CC64';
    TermFindPrgExecutable := True;
   End;
 End;
End;

Procedure TermExecuteCommand(Var TP: TTerminalPanel;
 CmdStr: String);
Var
 CurrCmd, ParamStr, PipeS: String;
 Err: Word;
 CurDir, DosExe, ElfExe: String;
 PrgTarget, PrgPath: String;
Begin
 CmdStr := TermTrim(CmdStr);
 If CmdStr = '' Then Exit;
 TermAddHistory(TP, CmdStr);
 { Changement de lecteur : A:, B:, C:, D:, ... }
 If (Length(CmdStr) = 2) And (CmdStr[2] = ':') And
  (CmdStr[1] In ['A'..'Z', 'a'..'z']) Then Begin
  { Lecteurs virtuels A:/B: (disquettes) et C:/D: (disques durs) :
    sur image montee, on bascule le terminal en mode disque virtuel. }
  If UpCase(CmdStr[1]) = 'A' Then Begin
   Term_TryEnterVirtDrive(TP, 0, '/DISK0:fichier.img');
   Exit;
  End;
  If UpCase(CmdStr[1]) = 'B' Then Begin
   Term_TryEnterVirtDrive(TP, 1, '/DISK1:fichier.img');
   Exit;
  End;
  { C:/D: ne sont consideres comme lecteurs virtuels que si une image
    disque dur a effectivement ete montee (/DISK80//DISK81) : sinon
    on garde le comportement d origine (changement de lecteur hote,
    C: etant le plus souvent le disque principal de la machine reelle). }
  If (UpCase(CmdStr[1]) = 'C') And EmuFloppyOpen[2] Then Begin
   Term_TryEnterVirtDrive(TP, 2, '/DISK80:fichier.img');
   Exit;
  End;
  If (UpCase(CmdStr[1]) = 'D') And EmuFloppyOpen[3] Then Begin
   Term_TryEnterVirtDrive(TP, 3, '/DISK81:fichier.img');
   Exit;
  End;
  { Autres lecteurs : on revient au mode hote standard }
  TP.VirtDrive := -1;
  {$I-}
  GetDir(Ord(UpCase(CmdStr[1])) - 64, PipeS);
  If PipeS <> '' Then ChDir(PipeS)
   Else ChDir(CmdStr + '\');
  {$I+}
  Err := IOResult;
  If Err <> 0 Then
   TermAddLine(TP, TermGetErrorMessage(Err));
  Exit;
 End;
 { Extraire la commande et les parametres }
 TermExtractCommand(CmdStr, CurrCmd, ParamStr);
 { Dispatcher selon le type de shell }
 Case TP.Shell Of
  SK_CMD: Begin
   If CurrCmd = 'EXIT' Then
    TermVisible := False
   Else If (CurrCmd = 'CD') Or (CurrCmd = 'CHDIR') Then
    TermCmd_CD(TP, ParamStr)
   Else If CurrCmd = 'CLS' Then
    TermCmd_CLS(TP)
   Else If (CurrCmd = 'DIR') Then
    TermCmd_DIR_CMD(TP, ParamStr)
   Else If CurrCmd = 'COPY' Then
    TermCmd_COPY(TP, ParamStr)
   Else If (CurrCmd = 'DEL') Or (CurrCmd = 'DELETE') Or
    (CurrCmd = 'ERASE') Or (CurrCmd = 'ERA') Then
    TermCmd_DEL(TP, ParamStr)
   Else If CurrCmd = 'ECHO' Then
    TermCmd_ECHO(TP, ParamStr)
   Else If (CurrCmd = 'MKDIR') Or (CurrCmd = 'MD') Then
    TermCmd_MKDIR(TP, ParamStr)
   Else If (CurrCmd = 'RMDIR') Or (CurrCmd = 'RD') Then
    TermCmd_RMDIR(TP, ParamStr)
   Else If (CurrCmd = 'REN') Or (CurrCmd = 'RENAME') Then
    TermCmd_REN(TP, ParamStr)
   Else If CurrCmd = 'MOVE' Then
    TermCmd_MOVE(TP, ParamStr)
   Else If CurrCmd = 'TYPE' Then
    TermCmd_TYPE(TP, ParamStr)
   Else If CurrCmd = 'DATE' Then
    TermCmd_DATE(TP)
   Else If CurrCmd = 'TIME' Then
    TermCmd_TIME(TP)
   Else If CurrCmd = 'VER' Then
    TermCmd_VER(TP)
   Else If CurrCmd = 'PWD' Then
    TermCmd_PWD(TP)
   Else If CurrCmd = 'PUSHD' Then
    TermCmd_PUSHD(TP, ParamStr)
   Else If CurrCmd = 'POPD' Then
    TermCmd_POPD(TP)
   Else If CurrCmd = 'SET' Then
    TermCmd_SET(TP, ParamStr)
   Else If CurrCmd = 'VOL' Then
    TermCmd_VOL(TP, ParamStr)
   Else If CurrCmd = 'ELFBP' Then
    TermCmd_ELFBP(TP, ParamStr)
   Else If (CurrCmd = 'HELP') Or (CurrCmd = '?') Then
    TermCmd_HELP(TP)
   Else Begin
    { Commande inconnue : si un binaire DOS 16 bits du meme nom existe   }
    { dans le repertoire courant (systeme hote uniquement), le lancer          }
    { dans l emulateur 8086 integre plutot que d afficher "non              }
    { reconnue" - BOGUE REEL 2026-08-10 signale par l utilisateur :       }
    { taper le nom d un vrai .EXE/.COM 16 bits ne faisait jusqu ici             }
    { jamais rien de plus que cette erreur, comme les 4 autres shells. }
    DosExe := '';
    ElfExe := '';
    If TP.VirtDrive < 0 Then Begin
     GetDir(0, CurDir);
     DosExe := TermFindDosExecutable(CurDir, CurrCmd);
     { Idem pour un binaire Linux ELF64 x86-64 (ex : BINLINUX\tp2js) -    }
     { BOGUE REEL 2026-08-10 signale par l utilisateur : lancer un        }
     { programme Linux dans le terminal affichait "non reconnue" au lieu }
     { d etre execute par l emulateur integre.                            }
     If DosExe = '' Then ElfExe := TermFindElfExecutable(CurDir, CurrCmd);
    End;
    If DosExe <> '' Then
     CreateEmulatorTab(DosExe, '-CD', ParamStr)
    Else If ElfExe <> '' Then
     CreateEmulatorTab(ElfExe, '-CELF64', ParamStr)
    { Idem pour un .PRG Commodore 64/Atari ST - sur le disque hote OU sur }
    { une disquette virtuelle .D64 montee (TermFindPrgExecutable gere       }
    { les deux cas et extrait vers un fichier hote temporaire si besoin). }
    Else If TermFindPrgExecutable(TP, CurDir, CurrCmd, PrgTarget, PrgPath) Then
     CreateEmulatorTab(PrgPath, PrgTarget, ParamStr)
    Else
     TermAddLine(TP,
      '''' + CurrCmd +
      ''' n''est pas reconnu comme commande interne.');
   End;
  End;
  SK_POWERSHELL: Begin
   If CurrCmd = 'EXIT' Then
    TermVisible := False
   Else If (CurrCmd = 'CD') Or (CurrCmd = 'CHDIR') Or
    (CurrCmd = 'SET-LOCATION') Then
    TermCmd_CD(TP, ParamStr)
   Else If (CurrCmd = 'CLS') Or
    (CurrCmd = 'CLEAR-HOST') Or
    (CurrCmd = 'CLEAR') Then
    TermCmd_CLS(TP)
   Else If (CurrCmd = 'DIR') Or (CurrCmd = 'LS') Or
    (CurrCmd = 'GET-CHILDITEM') Then
    TermCmd_DIR_PS(TP, ParamStr)
   Else If (CurrCmd = 'COPY') Or
    (CurrCmd = 'COPY-ITEM') Then
    TermCmd_COPY(TP, ParamStr)
   Else If (CurrCmd = 'DEL') Or
    (CurrCmd = 'REMOVE-ITEM') Then
    TermCmd_DEL(TP, ParamStr)
   Else If (CurrCmd = 'ECHO') Or
    (CurrCmd = 'WRITE-OUTPUT') Then
    TermCmd_ECHO(TP, ParamStr)
   Else If (CurrCmd = 'MKDIR') Or
    (CurrCmd = 'NEW-ITEM') Then
    TermCmd_MKDIR(TP, ParamStr)
   Else If (CurrCmd = 'RMDIR') Or (CurrCmd = 'RD') Then
    TermCmd_RMDIR(TP, ParamStr)
   Else If (CurrCmd = 'REN') Or
    (CurrCmd = 'RENAME-ITEM') Then
    TermCmd_REN(TP, ParamStr)
   Else If (CurrCmd = 'MOVE') Or
    (CurrCmd = 'MOVE-ITEM') Then
    TermCmd_MOVE(TP, ParamStr)
   Else If (CurrCmd = 'TYPE') Or (CurrCmd = 'CAT') Or
    (CurrCmd = 'GET-CONTENT') Then
    TermCmd_TYPE(TP, ParamStr)
   Else If CurrCmd = 'DATE' Then
    TermCmd_DATE(TP)
   Else If CurrCmd = 'TIME' Then
    TermCmd_TIME(TP)
   Else If CurrCmd = 'VER' Then
    TermCmd_VER(TP)
   Else If CurrCmd = 'PWD' Then
    TermCmd_PWD(TP)
   Else If (CurrCmd = 'PUSHD') Or
    (CurrCmd = 'PUSH-LOCATION') Then
    TermCmd_PUSHD(TP, ParamStr)
   Else If (CurrCmd = 'POPD') Or
    (CurrCmd = 'POP-LOCATION') Then
    TermCmd_POPD(TP)
   Else If CurrCmd = 'SET' Then
    TermCmd_SET(TP, ParamStr)
   Else If CurrCmd = 'VOL' Then
    TermCmd_VOL(TP, ParamStr)
   Else If (CurrCmd = 'HELP') Or
    (CurrCmd = 'GET-HELP') Or (CurrCmd = '?') Then
    TermCmd_HELP(TP)
   Else Begin
    { Meme repli que le shell CMD (voir plus haut) : un vrai PowerShell }
    { execute egalement un binaire DOS/Linux tape par son nom.          }
    DosExe := '';
    ElfExe := '';
    If TP.VirtDrive < 0 Then Begin
     GetDir(0, CurDir);
     DosExe := TermFindDosExecutable(CurDir, CurrCmd);
     If DosExe = '' Then ElfExe := TermFindElfExecutable(CurDir, CurrCmd);
    End;
    If DosExe <> '' Then
     CreateEmulatorTab(DosExe, '-CD', ParamStr)
    Else If ElfExe <> '' Then
     CreateEmulatorTab(ElfExe, '-CELF64', ParamStr)
    Else If TermFindPrgExecutable(TP, CurDir, CurrCmd, PrgTarget, PrgPath) Then
     CreateEmulatorTab(PrgPath, PrgTarget, ParamStr)
    Else
     TermAddLine(TP, CurrCmd +
      ' : le terme n''est pas reconnu comme nom de cmdlet.');
   End;
  End;
  SK_BASH: Begin
   If CurrCmd = 'EXIT' Then
    TermVisible := False
   Else If CurrCmd = 'CD' Then
    TermCmd_CD(TP, ParamStr)
   Else If CurrCmd = 'CLEAR' Then
    TermCmd_CLS(TP)
   Else If (CurrCmd = 'LS') Or (CurrCmd = 'DIR') Then
    TermCmd_DIR_BASH(TP, ParamStr)
   Else If CurrCmd = 'CP' Then
    TermCmd_COPY(TP, ParamStr)
   Else If CurrCmd = 'RM' Then
    TermCmd_DEL(TP, ParamStr)
   Else If CurrCmd = 'ECHO' Then
    TermCmd_ECHO(TP, ParamStr)
   Else If CurrCmd = 'MKDIR' Then
    TermCmd_MKDIR(TP, ParamStr)
   Else If CurrCmd = 'RMDIR' Then
    TermCmd_RMDIR(TP, ParamStr)
   Else If CurrCmd = 'MV' Then
    TermCmd_MOVE(TP, ParamStr)
   Else If CurrCmd = 'CAT' Then
    TermCmd_TYPE(TP, ParamStr)
   Else If CurrCmd = 'DATE' Then
    TermCmd_DATE(TP)
   Else If CurrCmd = 'PWD' Then
    TermCmd_PWD(TP)
   Else If CurrCmd = 'PUSHD' Then
    TermCmd_PUSHD(TP, ParamStr)
   Else If CurrCmd = 'POPD' Then
    TermCmd_POPD(TP)
   Else If CurrCmd = 'EXPORT' Then
    TermCmd_SET(TP, ParamStr)
   Else If CurrCmd = 'DF' Then
    TermCmd_DF(TP)
   Else If CurrCmd = 'HISTORY' Then
    TermCmd_HELP(TP)
   Else If CurrCmd = 'HELP' Then
    TermCmd_HELP(TP)
   Else Begin
    { Meme repli que les shells CMD/PowerShell (voir plus haut) : un vrai }
    { bash execute egalement un binaire tape par son nom - c est meme le  }
    { cas d usage le plus naturel pour un binaire Linux ELF64.            }
    DosExe := '';
    ElfExe := '';
    If TP.VirtDrive < 0 Then Begin
     GetDir(0, CurDir);
     DosExe := TermFindDosExecutable(CurDir, CurrCmd);
     If DosExe = '' Then ElfExe := TermFindElfExecutable(CurDir, CurrCmd);
    End;
    If DosExe <> '' Then
     CreateEmulatorTab(DosExe, '-CD', ParamStr)
    Else If ElfExe <> '' Then
     CreateEmulatorTab(ElfExe, '-CELF64', ParamStr)
    Else If TermFindPrgExecutable(TP, CurDir, CurrCmd, PrgTarget, PrgPath) Then
     CreateEmulatorTab(PrgPath, PrgTarget, ParamStr)
    Else
     TermAddLine(TP, 'bash: ' + CurrCmd +
      ': command not found');
   End;
  End;
  SK_AMIGADOS: Begin
   If (CurrCmd = 'QUIT') Or (CurrCmd = 'ENDCLI') Then
    TermVisible := False
   Else If CurrCmd = 'CD' Then
    TermCmd_CD(TP, ParamStr)
   Else If CurrCmd = 'DIR' Then
    TermCmd_DIR_AMIGA(TP, ParamStr)
   Else If CurrCmd = 'LIST' Then
    TermCmd_DIR_AMIGA(TP, ParamStr)
   Else If CurrCmd = 'COPY' Then
    TermCmd_COPY(TP, ParamStr)
   Else If CurrCmd = 'DELETE' Then
    TermCmd_DEL(TP, ParamStr)
   Else If CurrCmd = 'ECHO' Then
    TermCmd_ECHO(TP, ParamStr)
   Else If CurrCmd = 'MAKEDIR' Then
    TermCmd_MKDIR(TP, ParamStr)
   Else If CurrCmd = 'RENAME' Then
    TermCmd_REN(TP, ParamStr)
   Else If CurrCmd = 'TYPE' Then
    TermCmd_TYPE(TP, ParamStr)
   Else If CurrCmd = 'DATE' Then
    TermCmd_DATE(TP)
   Else If CurrCmd = 'INFO' Then
    TermCmd_PWD(TP)
   Else If CurrCmd = 'STACK' Then
    TermAddLine(TP, 'Stack size: 4096')
   Else If CurrCmd = 'STATUS' Then
    TermAddLine(TP, 'Process 1: AmigaDOS console')
   Else If CurrCmd = 'FAULT' Then
    TermAddLine(TP, 'No error')
   Else If CurrCmd = 'WHY' Then
    TermAddLine(TP, 'No error to report')
   Else If CurrCmd = 'PROTECT' Then
    TermAddLine(TP, 'Usage: PROTECT file flags')
   Else If CurrCmd = 'SEARCH' Then
    TermAddLine(TP, 'Usage: SEARCH FROM path SEARCH string')
   Else If CurrCmd = 'SORT' Then
    TermAddLine(TP, 'Usage: SORT FROM file TO file')
   Else If CurrCmd = 'JOIN' Then
    TermAddLine(TP, 'Usage: JOIN file1 file2 AS destfile')
   Else If CurrCmd = 'PATH' Then
    TermCmd_PWD(TP)
   Else If CurrCmd = 'NEWCLI' Then
    TermAddLine(TP, 'New CLI process started.')
   Else If CurrCmd = 'ASSIGN' Then
    TermAddLine(TP, 'Usage: ASSIGN name: device')
   Else If (CurrCmd = '?') Or (CurrCmd = 'HELP') Then Begin
    TermAddLine(TP, 'AmigaDOS built-in commands:');
    TermAddLine(TP, ' ASSIGN  CD     COPY    DATE   DELETE');
    TermAddLine(TP, ' DIR     ECHO   ENDCLI  FAULT  INFO');
    TermAddLine(TP, ' JOIN    LIST   MAKEDIR NEWCLI PATH');
    TermAddLine(TP, ' PROTECT QUIT   RENAME  SEARCH SORT');
    TermAddLine(TP, ' STACK   STATUS TYPE    WHY');
   End
   Else
    TermAddLine(TP, CurrCmd +
     ': Unknown command');
  End;
  SK_NCOMMANDER: Begin
   { Ce Case n avait ici AUCUNE branche pour SK_NCOMMANDER : une         }
   { commande tapee dans la ligne de commande de Norton Commander        }
   { (ex: "asm86 /?") tombait dans le vide et ne faisait donc            }
   { litteralement rien - BOGUE REEL signale par l utilisateur. Meme     }
   { repli "commande inconnue -> executable DOS/ELF" que SK_CMD          }
   { ci-dessus, mais recherche dans TP.VirtCwd (le chemin du panneau NC  }
   { actuellement parcouru, synchronise par l appelant juste avant cet   }
   { appel) plutot que GetDir(0,...) (repertoire reel du PROCESSUS, sans }
   { rapport avec la navigation virtuelle propre a NC). }
   DosExe := '';
   ElfExe := '';
   If TP.VirtDrive < 0 Then Begin
    DosExe := TermFindDosExecutable(TP.VirtCwd, CurrCmd);
    If DosExe = '' Then ElfExe := TermFindElfExecutable(TP.VirtCwd, CurrCmd);
   End;
   If DosExe <> '' Then
    CreateEmulatorTab(DosExe, '-CD', ParamStr)
   Else If ElfExe <> '' Then
    CreateEmulatorTab(ElfExe, '-CELF64', ParamStr)
   Else If TermFindPrgExecutable(TP, TP.VirtCwd, CurrCmd, PrgTarget, PrgPath) Then
    CreateEmulatorTab(PrgPath, PrgTarget, ParamStr)
   Else
    TermAddLine(TP,
     '''' + CurrCmd +
     ''' n''est pas reconnu comme commande interne.');
  End;
 End;
End;

{ --- Nom du fichier d historique des commandes par shell --- }

Function TermCmdHistFile(Kind: TShellKind): String;
Begin
 Case Kind Of
  SK_CMD:        TermCmdHistFile := 'devenv-cmd.hist';
  SK_POWERSHELL: TermCmdHistFile := 'devenv-ps.hist';
  SK_BASH:       TermCmdHistFile := 'devenv-bash.hist';
  SK_AMIGADOS:   TermCmdHistFile := 'devenv-amiga.hist';
 Else
  TermCmdHistFile := 'devenv-term.hist';
 End;
End;

{ --- Charger l historique des commandes depuis le fichier --- }

Procedure TermLoadCmdHistory(Var TP: TTerminalPanel);
Var
 F: Text;
 FName, L: String;
Begin
 FName := TermCmdHistFile(TP.Shell);
 Assign(F, FName);
 {$I-} Reset(F); {$I+}
 If IOResult <> 0 Then Exit;
 While Not Eof(F) Do Begin
  ReadLn(F, L);
  If L = '' Then Continue;
  If TP.NumberHistory >= MAX_TERM_HISTORY Then Begin
   Move(TP.TermHistory[2], TP.TermHistory[1],
    (MAX_TERM_HISTORY - 1) * SizeOf(TP.TermHistory[1]));
   TP.TermHistory[MAX_TERM_HISTORY] := L;
  End Else Begin
   Inc(TP.NumberHistory);
   TP.TermHistory[TP.NumberHistory] := L;
  End;
 End;
 Close(F);
 TP.HistoryPos := TP.NumberHistory + 1;
End;

{ --- Sauvegarder l historique des commandes dans le fichier --- }

Procedure TermSaveCmdHistory(Var TP: TTerminalPanel);
Var
 F: Text;
 FName: String;
 I: Integer;
Begin
 FName := TermCmdHistFile(TP.Shell);
 Assign(F, FName);
 {$I-} Rewrite(F); {$I+}
 If IOResult <> 0 Then Exit;
 For I := 1 To TP.NumberHistory Do
  WriteLn(F, TP.TermHistory[I]);
 Close(F);
End;

{ --- Initialiser un terminal (buffer seulement, pas le layout) --- }

Procedure InitTerminalPanel(Var TP: TTerminalPanel;
 Kind: TShellKind);
Var
 I: Integer;
Begin
 For I := 0 To MAX_TERM_LINES - 1 Do
  TP.Lines[I] := '';
 TP.LineCount := 0;
 TP.ScrollTop := 0;
 TP.HistHead := Nil;
 TP.HistTail := Nil;
 TP.HistCount := 0;
 TP.ScrollOffset := 0;
 TP.InputLine := '';
 TP.InputCol := 1;
 TP.PartialLine := '';
 TP.X := 0;
 TP.Y := 0;
 TP.Width := 0;
 TP.Height := 0;
 TP.Visible := False;
 TP.NeedRepaint := True;
 TP.Shell := Kind;
 TP.Echo := True;
 TP.NumberHistory := 0;
 TP.HistoryPos := 0;
 TP.NumberDirStack := 0;
 { Si un disque dur est monte et reconnu (FAT12/16/32), le terminal
   demarre directement sur ce lecteur (C:), comme un DOS reel
   demarrant sur son disque dur. Sinon, mode hote standard. }
 If EmuFloppyOpen[2] And FatVol[2].Mounted Then
  TP.VirtDrive := 2
 Else
  TP.VirtDrive := -1;
 TP.VirtCwd   := '\';
 TermLoadCmdHistory(TP);
End;

{ --- Initialiser le conteneur des deux terminaux --- }

Procedure InitTerminals;
Var
 ScrW, ScrH, BottomY: Integer;
 NCCwd: String;
Begin
 ScrW := GetScreenWidth;
 ScrH := GetScreenHeight;
 BottomY := ScrH - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 TermX := 0;
 TermY := BottomY;
 TermWidth := ScrW - EXPLORER_WIDTH;
 TermHeight := OUTPUT_HEIGHT;
 TermZoomLvl := 0;
 TermVisible := False;
 TermSelectOpen := False;
 TermSelectIdx := 1;
 TerminalOnTop := True;
 TerminalHasFocus := False;
 ExplorerHasFocus := False;
 ActiveShell := SK_POWERSHELL;
 InitTerminalPanel(TermPanels[SK_CMD], SK_CMD);
 InitTerminalPanel(TermPanels[SK_POWERSHELL], SK_POWERSHELL);
 InitTerminalPanel(TermPanels[SK_BASH], SK_BASH);
 InitTerminalPanel(TermPanels[SK_AMIGADOS], SK_AMIGADOS);
 InitTerminalPanel(TermPanels[SK_NCOMMANDER], SK_NCOMMANDER);
 { Comme l original sur DOS reel (et comme les 4 autres shells de ce      }
 { panneau) : demarrer sur le repertoire courant de la machine hote,           }
 { lettre de lecteur incluse (ex: C:\SOURCE\GITHUB\DEV-COOLS), pas sur           }
 { une disquette virtuelle isolee - bien plus utile au quotidien. }
 GetDir(0, NCCwd);
 NCState.Active := 0;
 NCState.Slot := -1;
 NCState.Mode := ncBrowse;
 NCState.Initialized := False;
 NCState.PromptBuf := '';
 NCState.Panes[0].Path := NCCwd;
 NCState.Panes[0].Count := 0;
 NCState.Panes[0].Cursor := 0;
 NCState.Panes[0].ScrollTop := 0;
 NCState.Panes[0].MarkCount := 0;
 NCState.Panes[1].Path := NCCwd;
 NCState.Panes[1].Count := 0;
 NCState.Panes[1].Cursor := 0;
 NCState.Panes[1].ScrollTop := 0;
 NCState.Panes[1].MarkCount := 0;
End;

{ ============================================================
  NORTON COMMANDER (5e shell du panneau Terminal) - TODO NC 1 :
  squelette, disquette virtuelle par defaut, listage structure,
  navigation double-panneau (pas encore de touches de fonction).
  ============================================================ }

{ Creer une image de disquette virtuelle 1.44 Mo vierge, formatee
  FAT12 (secteur de demarrage + BPB minimal + FAT/racine vides), pour
  que Norton Commander ait toujours un support a parcourir des le
  premier lancement, sans obliger l utilisateur a monter une image
  existante au prealable (menu "Disque virtuel"). --- }
Function NCCreateBlankFloppyImage(FileName: String): Boolean;
Var
 F: File;
 Boot: Array[0..511] Of Byte;
 Fat: Array[0..511] Of Byte;
 Root: Array[0..511] Of Byte;
 I: Integer;
 Zero: Byte;
Begin
 NCCreateBlankFloppyImage := False;
 FillChar(Boot, SizeOf(Boot), 0);
 { Instruction de saut + nom OEM }
 Boot[0] := $EB; Boot[1] := $3C; Boot[2] := $90;
 Boot[3] := Ord('N'); Boot[4] := Ord('C'); Boot[5] := Ord('D');
 Boot[6] := Ord('E'); Boot[7] := Ord('V'); Boot[8] := Ord('E');
 Boot[9] := Ord('N'); Boot[10] := Ord('V');
 { BPB : 512 octets/secteur, 1 secteur/cluster, 1 secteur reserve,
   2 FAT, 224 entrees racine, 2880 secteurs totaux, 9 secteurs/FAT,
   18 secteurs/piste, 2 tetes. }
 Boot[11] := 0; Boot[12] := 2;               { BytesPerSector = 512  }
 Boot[13] := 1;                              { SectorsPerCluster     }
 Boot[14] := 1; Boot[15] := 0;               { ReservedSectors = 1   }
 Boot[16] := 2;                              { NumFATs = 2           }
 Boot[17] := 224; Boot[18] := 0;             { RootEntries = 224     }
 Boot[19] := Lo(NC_FLOPPY_SECTORS);
 Boot[20] := Hi(NC_FLOPPY_SECTORS);          { TotalSectors16 = 2880 }
 Boot[21] := $F0;                            { MediaDescriptor       }
 Boot[22] := 9; Boot[23] := 0;               { SectorsPerFAT = 9     }
 Boot[24] := 18; Boot[25] := 0;              { SectorsPerTrack       }
 Boot[26] := 2; Boot[27] := 0;               { NumHeads              }
 { Etiquette de volume (offset 43, 11 caracteres) }
 Boot[38] := $29;                            { signature EBPB        }
 For I := 0 To 10 Do Boot[43 + I] := Ord(' ');
 Boot[43] := Ord('N'); Boot[44] := Ord('C'); Boot[45] := Ord('_');
 Boot[46] := Ord('A');
 Boot[510] := $55; Boot[511] := $AA;

 FillChar(Fat, SizeOf(Fat), 0);
 Fat[0] := $F0; Fat[1] := $FF; Fat[2] := $FF;  { entrees reservees 0/1 }
 FillChar(Root, SizeOf(Root), 0);              { racine vide (0 = fin) }

 {$I-}
 Assign(F, FileName);
 Rewrite(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 BlockWrite(F, Boot, 512);
 For I := 1 To 9 Do BlockWrite(F, Fat, 512);   { FAT #1 }
 For I := 1 To 9 Do BlockWrite(F, Fat, 512);   { FAT #2 }
 For I := 1 To 14 Do BlockWrite(F, Root, 512); { zone racine (224 * 32) }
 { Etendre le fichier a sa taille finale (1.44 Mo) sans ecrire tous les
   secteurs de donnees un par un - le dernier octet suffit. }
 Zero := 0;
 Seek(F, LongInt(NC_FLOPPY_SECTORS) * 512 - 1);
 BlockWrite(F, Zero, 1);
 Close(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 NCCreateBlankFloppyImage := True;
End;

{ S assurer qu un support est monte pour Norton Commander : reutilise
  un lecteur virtuel deja monte (A: ou B:) s il y en a un, sinon cree
  et monte l image par defaut. Renvoie l index FatVol (0 ou 1), ou -1
  en cas d echec. --- }
Function NCEnsureMounted: ShortInt;
Begin
 If EmuFloppyOpen[0] And FatVol[0].Mounted Then Begin
  NCEnsureMounted := 0;
  Exit;
 End;
 If EmuFloppyOpen[1] And FatVol[1].Mounted Then Begin
  NCEnsureMounted := 1;
  Exit;
 End;
 NCEnsureMounted := -1;
 If Not FileExists(NC_DEFAULT_IMAGE) Then
  If Not NCCreateBlankFloppyImage(NC_DEFAULT_IMAGE) Then Exit;
 If Emu_MountDiskSlot(0, NC_DEFAULT_IMAGE) Then
  NCEnsureMounted := 0;
End;

{ Comparer deux entrees pour le tri Norton Commander habituel :
  repertoires d abord, puis ordre alphabetique du nom. --- }
{ Extension d un nom de fichier (partie apres le dernier '.'), ou chaine  }
{ vide s il n y en a pas - utilise par le tri "Extension" du menu           }
{ Gauche/Droite (NC.PAS: TypeTri). --- }
Function NCExtractExt(Const Name: String): String;
Var
 P: Integer;
Begin
 P := Length(Name);
 While (P > 0) And (Name[P] <> '.') Do Dec(P);
 If P > 0 Then NCExtractExt := Copy(Name, P + 1, Length(Name) - P)
 Else NCExtractExt := '';
End;

{ Comparateur de tri generalise pour le menu Gauche/Droite (NC.PAS:           }
{ TypeTri) : 0=Nom 1=Extension 2=Heure(date) 3=Taille 4=Desordre (ordre     }
{ naturel du disque, aucun tri). Les repertoires restent groupes en tete       }
{ dans tous les modes sauf Desordre. --- }
Function NCEntryBefore(Const A, B: TNCEntry; SortMode: Integer; IsHost: Boolean): Boolean;
Var
 KeyA, KeyB: LongInt;
Begin
 NCEntryBefore := False;
 If SortMode = 4 Then Exit; { Desordre : conserver l ordre naturel du disque }
 If A.IsDir <> B.IsDir Then Begin
  NCEntryBefore := A.IsDir;
  Exit;
 End;
 Case SortMode Of
  1: { Extension }
   If UpCaseStr(NCExtractExt(A.Name)) <> UpCaseStr(NCExtractExt(B.Name)) Then
    NCEntryBefore := UpCaseStr(NCExtractExt(A.Name)) < UpCaseStr(NCExtractExt(B.Name))
   Else
    NCEntryBefore := UpCaseStr(A.Name) < UpCaseStr(B.Name);
  2: Begin { Heure/Date }
   If IsHost Then Begin
    KeyA := A.PackedDT; KeyB := B.PackedDT;
   End Else Begin
    KeyA := (LongInt(A.FDate) Shl 16) Or A.FTime;
    KeyB := (LongInt(B.FDate) Shl 16) Or B.FTime;
   End;
   NCEntryBefore := KeyA < KeyB;
  End;
  3: NCEntryBefore := A.Size < B.Size; { Taille }
 Else
  NCEntryBefore := UpCaseStr(A.Name) < UpCaseStr(B.Name); { Nom (0) par defaut }
 End;
End;

{ Alt+F1 (panneau gauche, Side=0) / Alt+F2 (panneau droite, Side=1) :        }
{ construit la liste des lettres de lecteur disponibles (lecteurs Windows      }
{ reels A-Z + disquettes virtuelles FAT montees) pour le panneau NC vise,      }
{ exactement comme ChangeDrive() dans le projet de reference NC.PAS. }
Procedure NCBuildChangeDriveList(Side: Integer);
Var
 L: Char;
 I: Integer;
 CurLetter: Char;
Begin
 NCState.CdSide := Side;
 NCState.CdCount := 0;
 For L := 'A' To 'Z' Do
  If (DiskSize(Ord(L) - Ord('A') + 1) <> -1) And
     (NCState.CdCount < MAX_NC_CD_ENTRIES) Then Begin
   NCState.CdLetter[NCState.CdCount] := L;
   NCState.CdIsVirt[NCState.CdCount] := False;
   NCState.CdSlotIdx[NCState.CdCount] := -1;
   Inc(NCState.CdCount);
  End;
 For I := 0 To 3 Do
  If EmuFloppyOpen[I] And (NCState.CdCount < MAX_NC_CD_ENTRIES) Then Begin
   NCState.CdLetter[NCState.CdCount] := Term_DriveLetterFromIdx(I);
   NCState.CdIsVirt[NCState.CdCount] := True;
   NCState.CdSlotIdx[NCState.CdCount] := I;
   Inc(NCState.CdCount);
  End;
 { Positionner le curseur sur le lecteur actuellement affiche par ce         }
 { panneau, si on le retrouve dans la liste (sinon debut de liste). }
 NCState.CdCursor := 0;
 If NCState.Slot >= 0 Then Begin
  For I := 0 To NCState.CdCount - 1 Do
   If NCState.CdIsVirt[I] And (NCState.CdSlotIdx[I] = NCState.Slot) Then Begin
    NCState.CdCursor := I;
    Break;
   End;
 End Else If Length(NCState.Panes[Side].Path) > 0 Then Begin
  CurLetter := UpCase(NCState.Panes[Side].Path[1]);
  For I := 0 To NCState.CdCount - 1 Do
   If (Not NCState.CdIsVirt[I]) And (NCState.CdLetter[I] = CurLetter) Then Begin
    NCState.CdCursor := I;
    Break;
   End;
 End;
 NCState.Mode := ncChangeDrive;
End;

{ Lister le repertoire Pane.Path dans Pane.Entries/Count (donnees          }
{ structurees). Slot < 0 : systeme de fichiers HOTE reel (FindFirst/           }
{ FindNext, mode par defaut) - Slot >= 0 : disquette virtuelle FAT             }
{ montee (reutilise les memes primitives bas niveau que Fat_ListDir). --- }
Procedure NCListDir(Slot: ShortInt; Var Pane: TNCPane);
Var
 Buf: Array[0..511] Of Byte;
 IsRoot: Boolean;
 StartCl, Cur: LongInt;
 SecInClu, I, EntOff: Integer;
 RootCnt, S2: Integer;
 LBA: LongInt;
 EntName: String;
 Attr: Byte;
 Sz: LongInt;
 Done, Swapped: Boolean;
 J: Integer;
 Tmp: TNCEntry;
 SR: SearchRec;
 SearchPath: String;
 AtRoot: Boolean;
 RootChk: String;
 NextT, NextS, Kind: Byte;
Begin
 Pane.Count := 0;
 Pane.Cursor := 0;
 Pane.ScrollTop := 0;
 Pane.MarkCount := 0;
 FillChar(Pane.Marked, SizeOf(Pane.Marked), False);

 If Slot < 0 Then Begin
  { Systeme hote reel. }
  SearchPath := Pane.Path;
  If (Length(SearchPath) = 0) Or
     (SearchPath[Length(SearchPath)] <> '\') Then
   SearchPath := SearchPath + '\';
  SearchPath := SearchPath + '*.*';
  { FindFirst/FindNext ne passent PAS par le protocole IOResult standard -  }
  { l etat de reussite est dans DosError, pas dans IOResult (qui pourrait      }
  { encore contenir une valeur perimee d une AUTRE operation anterieure          }
  { et faire sortir la fonction immediatement a tort). }
  FindFirst(SearchPath, AnyFile, SR);
  While (DosError = 0) And (Pane.Count < MAX_NC_ENTRIES) Do Begin
   If (SR.Name <> '.') And (SR.Name <> '..') Then Begin
    Pane.Entries[Pane.Count].Name := SR.Name;
    Pane.Entries[Pane.Count].IsDir := (SR.Attr And Directory) <> 0;
    If Pane.Entries[Pane.Count].IsDir Then Pane.Entries[Pane.Count].Size := 0
    Else Pane.Entries[Pane.Count].Size := SR.Size;
    Pane.Entries[Pane.Count].PackedDT := SR.Time;
    Inc(Pane.Count);
   End;
   FindNext(SR);
  End;
  {$IFDEF FPC} FindClose(SR); {$ENDIF}
 End Else If FatVol[Slot].IsD64 Then Begin
  { Disquette virtuelle Commodore 64 (.D64) : repertoire CBM DOS a plat  }
  { (pas de sous-repertoires) - lecture directe de la chaine de secteurs }
  { de repertoire a partir du BAM (piste 18/secteur 0), meme parcours       }
  { que D64_ListDir mais en remplissant Pane.Entries au lieu d ecrire       }
  { des lignes de texte dans un panneau Terminal. }
  If D64_ReadSector(Slot, 18, 0, Buf) Then Begin
   NextT := Buf[0];
   NextS := Buf[1];
   If (NextT = 0) Or (NextT > 40) Then Begin
    NextT := 18;
    NextS := 1;
   End;
   Done := False;
   While (NextT <> 0) And (Not Done) And
         D64_ReadSector(Slot, NextT, NextS, Buf) Do Begin
    NextT := Buf[0];
    NextS := Buf[1];
    For I := 0 To 7 Do Begin
     EntOff := 2 + I * 32;
     Kind := Buf[EntOff];
     If Kind = 0 Then Continue;
     If Pane.Count >= MAX_NC_ENTRIES Then Begin Done := True; Break; End;
     EntName := '';
     J := 0;
     While (J < 16) And (Buf[EntOff + 3 + J] <> $A0) Do Begin
      EntName := EntName + D64_PetsciiToAscii(Buf[EntOff + 3 + J]);
      Inc(J);
     End;
     EntName := EntName + '.' + D64_KindName[Kind And 15];
     Pane.Entries[Pane.Count].Name := EntName;
     { Approximation assumee : le repertoire CBM DOS ne stocke que le      }
     { nombre de blocs (254 octets utiles chacun, 2 octets de chainage      }
     { en moins par secteur de 256), jamais la taille exacte en octets     }
     { du dernier bloc partiel. }
     Pane.Entries[Pane.Count].Size :=
      LongInt(Word(Buf[EntOff + 28]) Or (Word(Buf[EntOff + 29]) Shl 8)) * 254;
     Pane.Entries[Pane.Count].IsDir := False;
     Pane.Entries[Pane.Count].FTime := 0;
     Pane.Entries[Pane.Count].FDate := 0;
     { Pas de "cluster" en CBM DOS - on y empaquete plutot la piste/secteur }
     { du 1er bloc de donnees (Buf[EntOff+1]/+2), pour que F3 (NCActionView/ }
     { NCCmd_ViewD64File) puisse retrouver le debut de la chaine du fichier. }
     Pane.Entries[Pane.Count].Cluster :=
      (LongInt(Buf[EntOff + 1]) Shl 8) Or Buf[EntOff + 2];
     Inc(Pane.Count);
    End;
   End;
  End;
 End Else If FatVol[Slot].IsH8D Then Begin
  { Image Heath/Zenith .H8D (HDOS, CP/M-80 ou UCSD p-System) - voir     }
  { H8D_ListDir (aiguille sur FatVol[Slot].H8DFsType, chacun des 3        }
  { formats remplit Pane.Entries directement). }
  H8D_ListDir(Byte(Slot), Pane);
 End Else Begin
  { Disquette virtuelle FAT montee. }
  If Not Fat_ResolveDir(Byte(Slot), Pane.Path, IsRoot, StartCl) Then Exit;
  Done := False;
  If IsRoot Then Begin
   RootCnt := 0;
   For S2 := 0 To FatVol[Slot].RootDirSectors - 1 Do Begin
    If Done Then Break;
    LBA := FatVol[Slot].RootStart + S2;
    If Not Fat_ReadSector(Byte(Slot), LBA, Buf) Then Break;
    For I := 0 To 15 Do Begin
     If RootCnt >= FatVol[Slot].RootEntries Then Begin Done := True; Break; End;
     Inc(RootCnt);
     EntOff := I * 32;
     If Buf[EntOff] = 0 Then Begin Done := True; Break; End;
     EntName := Fat_EntryName(Buf, EntOff);
     If EntName = '' Then Continue;
     Attr := Fat_EntryAttr(Buf, EntOff);
     If (Attr And $08) <> 0 Then Continue; { etiquette de volume }
     If Pane.Count >= MAX_NC_ENTRIES Then Begin Done := True; Break; End;
     Sz := Fat_EntrySize(Buf, EntOff);
     Pane.Entries[Pane.Count].Name := EntName;
     Pane.Entries[Pane.Count].Size := Sz;
     Pane.Entries[Pane.Count].IsDir := (Attr And $10) <> 0;
     Pane.Entries[Pane.Count].FTime := Fat_LE16(Buf, EntOff + 22);
     Pane.Entries[Pane.Count].FDate := Fat_LE16(Buf, EntOff + 24);
     Pane.Entries[Pane.Count].Cluster := Fat_LE16(Buf, EntOff + 26);
     Inc(Pane.Count);
    End;
   End;
  End Else Begin
   Cur := StartCl;
   While (Cur >= 2) And (Not Fat_IsEOC(Byte(Slot), Cur)) And (Not Done) Do Begin
    For SecInClu := 0 To FatVol[Slot].SectorsPerCluster - 1 Do Begin
     If Done Then Break;
     LBA := Fat_ClusterToLBA(Byte(Slot), Cur) + SecInClu;
     If Not Fat_ReadSector(Byte(Slot), LBA, Buf) Then Begin Done := True; Break; End;
     For I := 0 To 15 Do Begin
      EntOff := I * 32;
      If Buf[EntOff] = 0 Then Begin Done := True; Break; End;
      EntName := Fat_EntryName(Buf, EntOff);
      If EntName = '' Then Continue;
      Attr := Fat_EntryAttr(Buf, EntOff);
      If (Attr And $08) <> 0 Then Continue;
      If (EntName = '.') Or (EntName = '..') Then Continue;
      If Pane.Count >= MAX_NC_ENTRIES Then Begin Done := True; Break; End;
      Sz := Fat_EntrySize(Buf, EntOff);
      Pane.Entries[Pane.Count].Name := EntName;
      Pane.Entries[Pane.Count].Size := Sz;
      Pane.Entries[Pane.Count].IsDir := (Attr And $10) <> 0;
      Pane.Entries[Pane.Count].FTime := Fat_LE16(Buf, EntOff + 22);
      Pane.Entries[Pane.Count].FDate := Fat_LE16(Buf, EntOff + 24);
      Pane.Entries[Pane.Count].Cluster := Fat_LE16(Buf, EntOff + 26);
      Inc(Pane.Count);
     End;
    End;
    If Done Then Break;
    Cur := Fat_NextCluster(Byte(Slot), Cur);
   End;
  End;
 End;

 { Tri a bulles (nombre d'entrees d'un repertoire reste modeste) :
   repertoires d abord, puis alphabetique. }
 Repeat
  Swapped := False;
  For J := 0 To Pane.Count - 2 Do
   If NCEntryBefore(Pane.Entries[J + 1], Pane.Entries[J], Pane.SortMode, Slot < 0) Then Begin
    Tmp := Pane.Entries[J];
    Pane.Entries[J] := Pane.Entries[J + 1];
    Pane.Entries[J + 1] := Tmp;
    Swapped := True;
   End;
 Until Not Swapped;

 { Epingler ".." en tete de liste, sauf a la racine - BOGUE REEL             }
 { 2026-08-09 : NC.PAS original affiche toujours cette entree pour           }
 { remonter au repertoire parent (deja gere par NCEnterDir), mais elle       }
 { avait ete purement et simplement omise de l affichage. Ajoutee apres           }
 { le tri pour qu elle reste toujours premiere, quel que soit SortMode. }
 If Slot < 0 Then Begin
  RootChk := Pane.Path;
  If (Length(RootChk) > 0) And (RootChk[Length(RootChk)] = '\') Then
   RootChk := Copy(RootChk, 1, Length(RootChk) - 1);
  AtRoot := (Length(RootChk) = 2) And (RootChk[2] = ':');
 End Else
  AtRoot := (Pane.Path = '\') Or (Pane.Path = '');
 If Not AtRoot Then Begin
  If Pane.Count < MAX_NC_ENTRIES Then Inc(Pane.Count);
  For J := Pane.Count - 1 DownTo 1 Do
   Pane.Entries[J] := Pane.Entries[J - 1];
  FillChar(Pane.Entries[0], SizeOf(Pane.Entries[0]), 0);
  Pane.Entries[0].Name := '..';
  Pane.Entries[0].IsDir := True;
 End;
End;

{ Construire le chemin absolu du parent de Path : '\' si deja racine        }
{ virtuelle, ou la racine du lecteur (ex: "C:\") si deja a la racine            }
{ d un chemin hote - remonter plus haut demanderait un changement de           }
{ lecteur, non gere ici. --- }
Function NCParentPath(Const Path: String): String;
Var
 P: Integer;
Begin
 If (Path = '\') Or (Path = '') Then Begin
  NCParentPath := '\';
  Exit;
 End;
 If (Length(Path) = 3) And (Path[2] = ':') And (Path[3] = '\') Then Begin
  NCParentPath := Path; { deja a la racine du lecteur hote }
  Exit;
 End;
 P := Length(Path);
 While (P > 1) And (Path[P] <> '\') Do Dec(P);
 If P <= 1 Then NCParentPath := '\'
 Else If (P = 3) And (Path[2] = ':') Then
  NCParentPath := Copy(Path, 1, 3) { garder "C:\", pas "C:" }
 Else
  NCParentPath := Copy(Path, 1, P - 1);
End;

{ Recharger les deux panneaux (apres changement de repertoire, retour
  au selecteur de shell, etc.). --- }
Procedure NCRefreshPanes;
Begin
 { Slot < 0 = systeme hote (mode par defaut, PAS "pas encore monte") -   }
 { ne jamais sortir prematurement ici (BOGUE REEL 2026-08-09 : cette          }
 { garde, heritee de l etape 1 ou -1 signifiait "aucune disquette              }
 { montee", empechait tout listage en mode hote). }
 NCListDir(NCState.Slot, NCState.Panes[0]);
 NCListDir(NCState.Slot, NCState.Panes[1]);
End;

{ Creer un repertoire DirName dans ParentPath du volume FatVol[Slot] -   }
{ contrairement a TermCmd_MKDIR (qui appelle le vrai MkDir de l HOTE et    }
{ ne touche donc jamais la disquette virtuelle), ceci ecrit reellement          }
{ une nouvelle entree de repertoire + un nouveau cluster ('.'/'..') sur           }
{ la disquette virtuelle, comme l original le ferait sur une vraie             }
{ disquette. Reutilise les primitives FAT bas niveau deja ecrites pour           }
{ Fat_WriteFileFromHost (Fat_AllocCluster, Fat_FindFreeSlot, etc.). --- }
Function NCCmd_MkDir(Slot: Byte; ParentPath, DirName: String): Boolean;
Var
 IsRoot: Boolean;
 StartCl, ParentClu, NewClu: LongInt;
 SlotLBA: LongInt;
 SlotIdx, I: Integer;
 N11: Array[0..10] Of Byte;
 Buf: Array[0..511] Of Byte;
Begin
 NCCmd_MkDir := False;
 If DirName = '' Then Exit;
 If Not Fat_ResolveDir(Slot, ParentPath, IsRoot, StartCl) Then Exit;
 If Not Fat_MakeName11(DirName, N11) Then Exit;
 If Not Fat_FindFreeSlot(Slot, IsRoot, StartCl, SlotLBA, SlotIdx) Then Exit;
 NewClu := Fat_AllocCluster(Slot);
 If NewClu < 2 Then Exit;
 If IsRoot Then ParentClu := 0 Else ParentClu := StartCl;

 { Initialiser le nouveau repertoire avec ses propres entrees "." et    }
 { ".." (convention FAT standard), puis vider le reste du cluster. }
 FillChar(Buf, SizeOf(Buf), 0);
 Buf[0] := Ord('.');
 For I := 1 To 10 Do Buf[I] := Ord(' ');
 Buf[11] := $10;
 Buf[26] := Byte(NewClu And $FF);
 Buf[27] := Byte((NewClu Shr 8) And $FF);
 Buf[32] := Ord('.'); Buf[33] := Ord('.');
 For I := 34 To 42 Do Buf[I] := Ord(' ');
 Buf[32 + 11] := $10;
 Buf[32 + 26] := Byte(ParentClu And $FF);
 Buf[32 + 27] := Byte((ParentClu Shr 8) And $FF);
 If Not Fat_WriteSector(Slot, Fat_ClusterToLBA(Slot, NewClu), Buf) Then Exit;
 FillChar(Buf, SizeOf(Buf), 0);
 For I := 1 To FatVol[Slot].SectorsPerCluster - 1 Do
  Fat_WriteSector(Slot, Fat_ClusterToLBA(Slot, NewClu) + I, Buf);

 NCCmd_MkDir := Fat_WriteDirEntry(Slot, SlotLBA, SlotIdx, N11, $10, NewClu, 0);
End;

{ Dessiner le double panneau Norton Commander (remplace entierement le
  rendu ligne de commande / historique des 4 autres shells). --- }
{ Formater la date/heure d une entree (hote : PackedDT via UnpackTime ; }
{ disquette virtuelle : FDate/FTime, champs de bits FAT deja empaquetes). }
Function NCFormatDateTime(Const E: TNCEntry; IsHost: Boolean): String;
Var
 DT: DateTime;
 Yr, Mo, Dy, Hr, Mn: Word;
Begin
 If IsHost Then Begin
  UnpackTime(E.PackedDT, DT);
  Yr := DT.Year; Mo := DT.Month; Dy := DT.Day; Hr := DT.Hour; Mn := DT.Min;
 End Else Begin
  Yr := ((E.FDate Shr 9) And $7F) + 1980;
  Mo := (E.FDate Shr 5) And $0F;
  Dy := E.FDate And $1F;
  Hr := (E.FTime Shr 11) And $1F;
  Mn := (E.FTime Shr 5) And $3F;
 End;
 NCFormatDateTime := PadLeft(IntToStr(Mo), 2, '0') + '/' +
  PadLeft(IntToStr(Dy), 2, '0') + '/' + PadLeft(IntToStr(Yr Mod 100), 2, '0') +
  ' ' + PadLeft(IntToStr(Hr), 2, '0') + ':' + PadLeft(IntToStr(Mn), 2, '0');
End;

{ Dessiner une petite boite modale centree (dialogues F5/F6/F7/F8 et       }
{ visionneuse F3) par-dessus le panneau. --- }
Procedure NCDrawModalBox(PX, PY, PW, PH: Integer; Title: String);
Var
 BX1, BY1, BX2, BY2: Integer;
Begin
 BX1 := PX + PW Div 6;
 BX2 := PX + PW - PW Div 6;
 BY1 := PY + PH Div 3;
