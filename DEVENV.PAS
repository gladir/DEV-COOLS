  $86,$8E,$96: EmuDbg_Mnem6502 := 'STX';
  $88: EmuDbg_Mnem6502 := 'DEY';
  $8A: EmuDbg_Mnem6502 := 'TXA';
  $90: EmuDbg_Mnem6502 := 'BCC';
