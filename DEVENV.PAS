   DrawText(FX + OPT_LABEL_WIDTH + 4, BaseY,
    Dlg.C64PathEditBuf + '_', CLR_WINDOWTEXT);
  End Else Begin
   DrawRect(FX + OPT_LABEL_WIDTH, BaseY - 2, FX + FW,
    BaseY + OPT_FIELD_HEIGHT, CLR_BORDER);
   If Value = '' Then
    DrawText(FX + OPT_LABEL_WIDTH + 4, BaseY,
     '(cliquer pour indiquer le chemin)', CLR_BORDER)
   Else
    DrawText(FX + OPT_LABEL_WIDTH + 4, BaseY, Value, CLR_WINDOWTEXT);
  End;
  BaseY := BaseY + OPT_ROW_SPACING;
 End;

