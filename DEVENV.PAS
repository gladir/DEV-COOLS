  Name : String;
  Attr : Byte;
  Size : LongInt;
  Time : LongInt;      { paquet DOS SearchRec.Time : bits 0-15 heure,      }
                        { bits 16-31 date - meme convention que partout    }
                        { ailleurs dans ce fichier. }
 End;
