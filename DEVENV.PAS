 TEmuSegs = Record Case Byte Of
  0:(ES,CS,SS,DS : Word);
  1:(Abs        : Array[0..3] Of Word);
 End;

 { Etat complet du CPU emule }
 { HMA (High Memory Area) : FFFF:0010-FFFF:FFFF = adresses physiques        }
 { $100000-$10FFEF (65520 octets) - le plus haut octet reellement            }
 { adressable par un couple segment:offset reel x86 (FFFF*16+FFFF=$10FFEF). }
 { Voir Emu_Addr pour l emulation de la gate A20 (Emu8042.A20Enabled) qui    }
 { decide si ce prolongement est reellement accessible (machine AT+, gate   }
 { armee) ou si l adressage s enroule a 1 Mo comme sur un vrai 8086/PC-XT.  }
 TEmuMemBuf = Array[0..$10FFEF] Of Byte;
 PEmuMemBuf = ^TEmuMemBuf;

 { Cache "unreal mode" (2026-08-24, BOGUE REEL CORRIGE - voir CR0/GdtBase/     }
 { UnrealSegs dans TEmuCPU ci-dessous pour le contexte complet) : un registre  }
 { de segment reel garde une base cachee sur 32 bits (issue d un descripteur   }
 { GDT charge PENDANT un bref basculement en mode protege) qui survit au       }
 { retour en mode reel - c est la technique authentique "unreal mode" que le   }
 { vrai HIMEM.SYS utilise pour adresser la memoire etendue au-dela de 1 Mo     }
 { avec des registres 32 bits. Cette base n a AUCUN rapport avec la formule    }
 { habituelle Seg*16 - jusqu a ce correctif, Emu_Addr/Emu_AddrL l ignoraient   }
 { completement, ce qui faisait atterrir toute ecriture "unreal mode" a une    }
 { adresse essentiellement arbitraire (explique le tampon de relecture rempli }
 { de donnees sans rapport observe lors de l enquete HIMEM "memoire etendue    }
 { non fiable"). Table associative simple valeur->base (4 entrees, largement   }
 { suffisant : le code DOS reel de cette epoque reutilise la meme poignee de   }
 { selecteurs "plats" en boucle, jamais des dizaines de valeurs distinctes). }
 TEmuUnrealSeg = Record
  Active: Boolean;
  SegVal: Word;
  Base  : LongInt;
 End;

 TEmuCPU = Record
  Memory       : PEmuMemBuf;          { 1 Mo de memoire RAM emulee  }
  MemReady     : Boolean;             { buffer alloue ?             }
  Regs         : TEmuRegs;
  Segs         : TEmuSegs;
  Flags        : TEmuFlags;
  OldFlags     : TEmuFlags;
  IP, FS, GS   : Word;
  CPU          : Word;                { type de CPU (cpu8086...)    }
  Fault        : Word;                { code de fin (sf*)           }
  NextRawKey   : Byte;
  CmosPos      : Byte;
  CurrSeg      : Byte;
  OldCSeg      : Word;
  CodeBrk      : Integer;
  PSP          : Word;
  ParityTable  : Array[0..255] Of Boolean;
  ModelComputer: Word;
  CPUVendor    : Byte;
  ReadOnly     : Boolean;
  Verbose      : Boolean;
  DebugMode    : Boolean;
  LastBadOp    : Byte;
  LastBadCS    : Word;
  LastBadIP    : Word;
  HasSegOvr    : Boolean;
  SegOvr       : Word;
  { Prefixe $66 (taille d operande 32 bits, 386+ en mode reel) - voir         }
  { Emu_StepOne (ajoute 2026-08-24 en poursuivant l enquete DOS=HIGH/XMS :    }
  { HIMEM.SYS utilise reellement des instructions 32 bits pour verifier la    }
  { memoire etendue). Meme discipline que HasSegOvr : remis a False           }
  { INCONDITIONNELLEMENT en tete de CHAQUE nouvelle instruction (jamais de    }
  { fuite au-dela de l instruction que le prefixe precede immediatement).     }
  OperandSize32 : Boolean;
  { Prefixe $67 (taille d ADRESSE 32 bits) - BOGUE REEL CORRIGE (2026-08-24,  }
  { retro-ingenierie directe du vrai HIMEM.SYS 3.10 extrait du VHD : sa       }
  { routine de copie "unreal mode" (offset fichier 0x6D65) utilise           }
  { REELLEMENT `67h` sur REP MOVSW/MOVSD (ESI/EDI 32 bits) et sur un XCHG/MOV }
  { a adressage direct disp32 - sans ce prefixe, toute adresse etendue au-    }
  { dela de 64 Ko s enroule sur 16 bits, ce qui fait echouer silencieusement  }
  { le test d ecriture/relecture et declenche le faux "XMS non fiable").      }
  { Meme discipline de remise a False inconditionnelle que HasSegOvr/         }
  { OperandSize32. Portee couverte : adressage direct disp32 (ModRM mod=00,   }
  { rm=101, sans base) et bases simples EAX/ECX/EDX/EBX/ESI/EDI (mod          }
  { 00/01/10) - voir Emu_DecodeModRM32. Le SIB (ModRM rm=100, ex. adressage   }
  { base ESP) N est TOUJOURS PAS implante - non rencontre dans le cas reel    }
  { identifie, portee delibarement limitee comme documente ailleurs dans ce   }
  { fichier pour $67. }
  AddrSize32 : Boolean;
  { --- Support "unreal mode" (2026-08-24, BOGUE REEL CORRIGE) - voir         }
  { TEmuUnrealSeg ci-dessus pour le contexte complet. }
  CR0      : LongInt;   { seul le bit 0 (PE, Protection Enable) est suivi -    }
                         { le reste de ce fichier ne modelise pas un vrai      }
                         { mode protege, seulement le bref basculement que     }
                         { "unreal mode" exploite pour charger un descripteur. }
  GdtBase  : LongInt;    { charges par LGDT (0F 01 /2) }
  GdtLimit : Word;
  UnrealSegs: Array[0..3] Of TEmuUnrealSeg;  { cache valeur -> base 32 bits,  }
                                              { rempli par un MOV Sreg,r/m16   }
                                              { execute pendant que CR0.PE=1 }
 End;

 { Operande decode a partir d un octet ModR/M }
 TEmuOperand = Record
  IsReg : Boolean;
  RegNum: Byte;
  Seg   : Word;
  Ofs   : LongInt;       { 16 bits (adressage classique) ou 32 bits si       }
                          { AddrIs32 (prefixe $67 - voir Emu_DecodeModRM32)  }
  AddrIs32: Boolean;      { True si Ofs doit etre traite comme un offset 32  }
                          { bits (Emu_*L) plutot que 16 bits (Emu_ReadByte/  }
                          { Word classiques) - voir Emu_GetOpByte etc.       }
  Len   : Integer;       { octets consommes (ModRM + deplacement)  }
 End;

 { ========================================================
   PHASE 0 : Etat unifie de la carte video CGA / EGA / VGA.
   --------------------------------------------------------
   La memoire video est 256 Ko ($00000-$3FFFF) car les modes
   EGA/VGA planar ont 4 plans de 64 Ko chacun a $A000.
   En mode texte, on duplique aussi le contenu vers la VRAM
   80x25 du panneau pour le rendu rapide.
   ======================================================== }
 TEmuVideoMem = Array[0..262143] Of Byte;  { 4 plans x 64K }
 PEmuVideoMem = ^TEmuVideoMem;

 TEmuVideoState = Record
  Mode       : Byte;    { 0..13h, 7Fh inconnu               }
  Width      : Word;    { largeur en pixels                  }
  Height     : Word;    { hauteur en pixels                  }
  TextCols   : Byte;    { 40 ou 80                          }
  TextRows   : Byte;    { 25 typique                         }
  BitsPerPix : Byte;    { 0=texte, 1, 2, 4, 8                }
  IsGraphic  : Boolean; { mode graphique vs texte            }
  IsPlanar   : Boolean; { EGA/VGA planar vs lineaire         }
  ChainFour  : Boolean; { mode 13h = chain-4 lineaire        }
  PageBase   : LongInt; { offset dans VideoMem               }
  Mem        : PEmuVideoMem;{ buffer 256 Ko alloue            }
  MemReady   : Boolean;
  { --- DAC (registres VGA $3C7-$3C9) --- }
  DAC        : Array[0..767] Of Byte; { 256 RGB, 6 bits     }
  DACWriteIdx: Word;    { index octet courant ecriture       }
  DACReadIdx : Word;    { index octet courant lecture        }
  DACMask    : Byte;    { masque pixel ($3C6)                }
  DACState   : Byte;    { etat $3C7 : 0=write, 3=read        }
  { --- Sequencer ($3C4 / $3C5) --- }
  SeqIdx     : Byte;
  SeqReg     : Array[0..7] Of Byte;
  { --- Graphics Controller ($3CE / $3CF) --- }
  GCIdx      : Byte;
  GCReg      : Array[0..15] Of Byte;
  { --- Attribute Controller ($3C0 / $3C1) --- }
  ACFlipFlop : Boolean; { 0=index, 1=data                    }
  ACIdx      : Byte;
  ACReg      : Array[0..31] Of Byte;
  { --- CRT Controller ($3D4 / $3D5) --- }
  CRTCIdx    : Byte;
  CRTCReg    : Array[0..31] Of Byte;
  { --- 4 latches plan (lus par MOV reg,[mem] en mode planar) --- }
  Latch      : Array[0..3] Of Byte;
  { --- CGA registers ($3D8 / $3D9) --- }
  CGAMode    : Byte;    { Mode Control Register $3D8         }
  CGAColor   : Byte;    { Color Select Register $3D9         }
  { --- Status (lecture de $3DA) --- }
  StatusRetrace : Byte; { bit 0 = HRetrace (bascule a la lecture), bit 3 = }
                         { VRetrace (libre, cadencee par VRetraceAcc)     }
  VRetraceAcc   : LongInt; { accumulateur de pas CPU pour la bascule VRetrace }
  { --- Dirty flag pour le rendu graphique --- }
  GfxDirty   : Boolean;
  { --- Registres etendus ATI Graphics Solution ($3DD/$3DF) - carte sans   }
  { BIOS, programmee uniquement par sequences de ports directes. Voir      }
  { Emu_ATIDetectMode. --- }
  GSExt      : Byte;    { dernier octet ecrit sur $3DD                     }
  GSFeature  : Byte;    { dernier octet ecrit sur $3DF                     }
  GSLastSig  : Byte;    { dernier mode ATI detecte (0=aucun), evite les    }
                         { reinitialisations redondantes                   }
  GSTxt132Emul: Boolean;{ Vrai = GSEmulTextModeC132x25 (132 col, moniteur  }
                         { monochrome), Faux = GSTextModeC132x25 (couleur) }
 End;

 { --- Controleur d interruptions programmable 8259A (Options > Emulateur >  }
 { DOS: Materiel) - un exemplaire "maitre" (20h/21h, tout materiel) et un    }
 { exemplaire "esclave" (A0h/A1h, IRQ8-15, uniquement materiel classe AT+ :  }
 { voir Emu_IsATClassHw). Sequence ICW1-4/OCW1-3 reelle ; le registre ISR    }
 { est reellement mis a jour a la livraison et efface par EOI (OCW2) pour   }
 { la coherence visible du logiciel invite, mais NE conditionne PAS a lui   }
 { seul la livraison d une IRQ suivante (voir Emu_ServiceIrqs) - seul l IMR  }
 { (masque, OCW1) le fait, car Emu_FireHwInt ne modelise pas un retour      }
 { d interruption trace independamment ; gater sur l ISR pourrait geler     }
 { pour de bon la minuterie/le clavier pour tout logiciel invite qui utilise}
 { le gestionnaire par defaut de l emulateur (jamais d EOI explicite emis). }
 TEmuPICChip = Record
  IMR         : Byte;    { masque d interruption (OCW1) }
  ISR         : Byte;    { interruptions "en service" (informatif, voir ci-dessus) }
  InitState   : Byte;    { 0=normal, 1=attend ICW2, 2=attend ICW3, 3=attend ICW4 }
  VectorBase  : Byte;    { ICW2 : base des vecteurs INT (defaut reel $08 maitre, $70 esclave) }
  SnglMode    : Boolean; { ICW1 bit1 : 1=pas de cascade, saute ICW3 }
  NeedICW4    : Boolean; { ICW1 bit0 : ICW4 attendu }
  AutoEOI     : Boolean; { ICW4 bit1 }
  ReadISRNext : Boolean; { OCW3 : prochaine lecture du port commande = ISR sinon IRR }
 End;

 { --- 8255A PPI (Options > Emulateur > DOS: Materiel) - ports 60h-63h,     }
 { repetes sur 64h-6Fh sur le materiel PC/XT d origine (decodage incomplet  }
 { 2 bits d adresse, voir Emu_IsATClassHw) ; le port A (60h, scancode       }
 { clavier) reste servi par P.CPU.NextRawKey deja existant, pas stocke ici. }
 { Port A (60h) n a pas de stockage : lecture directe soit du scancode      }
 { clavier (P.CPU.NextRawKey), soit des commutateurs SW1 (Emu_PPI_SW1),      }
 { selon PortB bit7 - voir Emu_PPI_ReadA. Port C (62h) est de meme calcule  }
 { a la volee (Emu_PPI_ReadC), pas stocke : ce sont des ports d ENTREE pure  }
 { sur le vrai 8255A (ecriture ignoree), rien a memoriser. }
 TEmuPPI = Record
  PortB   : Byte; { 61h : reel (gate/donnees haut-parleur, mux SW1/clavier) }
  CtrlReg : Byte; { 63h : registre de mode, ecriture seule sur le vrai chip, relu tel quel ici }
 End;

 { --- Controleur clavier 8042 (materiel classe AT+, voir Emu_IsATClassHw) - }
 { PROTOCOLE DIFFERENT du 8255A ci-dessus : 60h=tampon sortie/entree,        }
 { 64h=registre etat (lecture)/commande (ecriture). Le port de sortie       }
 { (commande D0h/D1h) porte le bit reel de gate A20 (bit1) - lu/ecrit        }
 { fidelement, mais SANS effet sur l adressage memoire emule (aucun          }
 { consommateur de ce drapeau ailleurs dans le fichier actuellement ; hors   }
 { perimetre demande, voir le commentaire d Emu_8042_WriteCmd). }
 TEmu8042 = Record
  OutBuf     : Byte;    { tampon de sortie (60h en lecture) }
  OutBufFull : Boolean;
  CmdByte    : Byte;    { octet de commande interne (mode) }
  OutputPort : Byte;    { registre "port de sortie" (bit1 = gate A20) }
  A20Enabled : Boolean;
  PendingCmd : Byte;    { commande 64h en attente d un octet de donnees sur 60h ; 0 = aucune }
  KbdEnabled : Boolean;
 End;

 { --- UART 8250/16450 generique (COM2 02F8h-02FFh, COM4 02E8h-02EFh). Rien }
 { n est cable a l autre bout (pas de modem/liaison reelle emulee) : les    }
 { octets transmis (THR) sont perdus SAUF en boucle locale (MCR bit4=Loop), }
 { LSR indique toujours "pret a transmettre" pour ne jamais bloquer un      }
 { logiciel qui attend un tampon libre. }
 TEmuUART = Record
  RBR, THR   : Byte;
  IER, IIR   : Byte;
  LCR, MCR   : Byte;
  LSR, MSR   : Byte;
  SCR        : Byte;
  DLL, DLM   : Byte; { diviseur de baudrate (DLAB=1, LCR bit7) }
  DataReady  : Boolean;
 End;

 { --- Port parallele generique (LPT1 03BCh-03BFh, LPT2 0278h-027Fh). }
 TEmuLPT = Record
  DataReg : Byte;
  CtrlReg : Byte;
 End;

 { --- Registres NE2000/DP8390 (260h-27Fh, Options > Emulateur > DOS:        }
 { Logiciel > Reseau LAN = NE2000 compatible). Niveau de fidelite           }
 { DELIBEREMENT limite a la DETECTION/RESET (ce qu un pilote de paquets ou   }
 { une pile reseau sonde pour confirmer la presence de la carte avant de     }
 { l utiliser) - le transfert de paquets reel se fait deja plus haut, via    }
 { le vecteur INT logiciel EmuPkt (voir Emu_DoInt7A-style hook), PAS via ces }
 { registres materiel : la fenetre DMA distante (10h-17h) est un tampon      }
 { local sans lien avec cette couche, ne pas s attendre a y voir de vraies   }
 { trames. }
 TEmuNE2000 = Record
  Regs0     : Array[0..15] Of Byte; { Page 0 }
  Regs1     : Array[0..15] Of Byte; { Page 1 (adresse MAC, page courante) }
  Regs2     : Array[0..15] Of Byte; { Page 2 }
  DmaWindow : Array[0..7]  Of Byte; { fenetre DMA distante (10h-17h), locale uniquement }
 End;

 { ============================================================
   Interface de disque (Options > Emulateur > DOS: Materiel >
   Interface de disque, voir DosDiskInterfaceName/Emu_DiskIfFamily) -
   3 protocoles materiels reels regroupent les 13 entrees choisissables
   (voir le commentaire complet pres d Emu_DiskIfFamily), plus NVMe/PCIe
   qui n a authentiquement AUCUN port ISA sur du materiel reel. Toutes
   les operations de secteur passent par les images virtuelles deja
   montees (EmuFloppyOpen/Emu_ImageReadSector/WriteSector, unites 2/3 =
   disque "dur" C:/D:) - memes donnees que INT13h, aucune divergence
   possible entre acces logiciel bas niveau et acces BIOS.
   ============================================================ }

 { --- Famille A : ST-506/ST-412 (MFM) et RLL, ports 320h-323h. Protocole  }
 { reel par bloc de commande de 6 octets ecrit octet-par-octet dans le    }
 { registre Data (320h) pendant que le registre Status (321h) indique la  }
 { phase courante (REQ/IO/CD/BSY) - forme fidele au controleur Xebec/IBM  }
 { Fixed Disk Adapter d origine ; le decoupage EXACT bit-a-bit du bloc de }
 { commande (au-dela de Commande/Tete/Cylindre/Secteur/Compte, dans cet   }
 { ordre) est une reconstruction raisonnable et INTERNE A CET EMULATEUR   }
 { (confiance moindre que pour le protocole ATA ci-dessous, voir          }
 { Emu_ST506_Exec) - suffisant pour un test reel bout-en-bout coherent.   }
 TEmuST506 = Record
  Phase       : Byte;   { 0=IDLE,1=CMD_RECEIVING,2=DATA_OUT,3=DATA_IN,4=STATUS_READY }
  CmdBuf      : Array[0..5] Of Byte;
  CmdLen      : Byte;
  DataBuf     : Array[0..511] Of Byte;
  DataPos     : Word;
  ResultByte  : Byte;
  PendingUnit : Integer;  { unite EmuFloppy visee par la commande en cours }
  PendingLBA  : LongInt;  { LBA visee, calculee a l execution de la commande }
 End;

 { --- Famille B : ESDI/IDE/EIDE/ATAPI/UDMA/PATA/SATA, protocole task-file }
 { ATA reel (canal primaire 1F0h-1F7h+3F6h, secondaire 170h-177h+376h).    }
 { Un seul disque "dur" mappe par canal dans cet emulateur (2 unites       }
 { EmuFloppy 2/3 disponibles au total) : maitre canal primaire = unite 2   }
 { (C:), maitre canal secondaire = unite 3 (D:) - esclaves toujours        }
 { absents (pas de 3e/4e image montable actuellement). }
 TEmuATAChannel = Record
  ErrFeat, SectorCnt, SectorNum, CylLo, CylHi, DriveHead : Byte;
  Status, DevCtrl : Byte;
  { Registres "hauts" LBA48 (double ecriture/HOB - voir Emu_ATA_WriteReg) }
  SectorCntHi, SectorNumHi, CylLoHi, CylHiHi : Byte;
  { Tampon de transfert PIO (secteur 512o, bloc IDENTIFY 512o, ou paquet   }
  { ATAPI 12o) }
  PioBuf      : Array[0..511] Of Byte;
  PioLen      : Word;    { octets valides pour ce transfert }
  PioPos      : Word;
  PioActive   : Boolean;
  PioIsWrite  : Boolean; { vrai = ecriture hote->disque en cours }
  PacketPending: Boolean; { commande A0h (PACKET) emise, attend 12 octets }
  { Commande multi-secteurs en cours }
  CmdLBA         : LongInt;
  CmdSectorsLeft : Word;
  CmdUnit        : Integer; { index EmuFloppy reel (2 ou 3), -1 = absent }
  MultiCount     : Byte;    { SET MULTIPLE MODE }
 End;

 { --- Famille C : SASI/SCSI/SAS, protocole hote registre-a-registre reel  }
 { (330h-333h) construit sur les Command Descriptor Blocks SCSI standard  }
 { (INQUIRY/READ CAPACITY/READ(6)/READ(10)/etc, bien documentes et        }
 { stables depuis SCSI-1) - PAS une reproduction bit-a-bit d une carte    }
 { commerciale precise (Adaptec AHA-154x et consorts utilisent une        }
 { architecture de mailbox en memoire hote bien plus lourde), mais un     }
 { protocole registre reel et coherent, suffisant pour un test bout-en-   }
 { bout verifiable. SASI (protocole DIRECTEMENT ancetre de SCSI) et SAS   }
 { (meme jeu de commandes SCSI, transport different invisible pour DOS)   }
 { partagent volontairement ce meme code - voir Emu_DiskIfFamily. }
 TEmuSCSIHostAdapter = Record
  Phase      : Byte;  { 0=IDLE,1=CDB_RECEIVING,2=DATA_IN,3=DATA_OUT,4=STATUS_READY }
  CDB        : Array[0..9] Of Byte;
  CDBLen     : Byte;
  CDBExpected: Byte;  { 6 ou 10 selon l opcode (determine des le 1er octet) }
  DataBuf    : Array[0..511] Of Byte;
  DataLen    : Word;
  DataPos    : Word;
  StatusByte : Byte;  { 0=Good, 2=Check Condition }
  PendingLBA : LongInt;
 End;

 { --- Controleur de disquette (FDC, NEC 765/8272A discret sur PC/XT ou      }
 { 82077AA integre sur AT+, voir Emu_IsATClassHw) - ports 3F0h-3F7h,         }
 { TOUJOURS present quel que soit le choix "Interface de disque" (Options > }
 { Emulateur > DOS: Materiel) : un lecteur de disquette est un peripherique  }
 { DISTINCT du disque "dur" (ST-506/ATA/SCSI/NVMe ci-dessus), jamais         }
 { mutuellement exclusif avec lui sur du materiel reel. Protocole PIO        }
 { complet (pas de vrai canal DMA materiel - meme simplification assumee    }
 { que pour ST-506/SCSI) : SPECIFY/RECALIBRATE/SEEK/SENSE INTERRUPT STATUS/  }
 { SENSE DRIVE STATUS/READ ID/READ DATA/WRITE DATA, octets de commande et    }
 { de resultat via le registre Data (3F5h), phase courante lisible via le    }
 { registre Status Main (3F4h). 3F0h/3F1h (Status Register A/B) et 3F7h      }
 { (Digital Input Register en lecture, Configuration Control Register en    }
 { ecriture) n existent que sur le controleur 82077AA integre des systemes   }
 { AT+ - un vrai PC/XT avec 8272A discret ne repond pas du tout a ces        }
 { adresses (voir Emu_PortRead/Write). Unites 0/1 = EmuFloppy 0/1 (A:/B:),   }
 { memes images que INT13h - aucune divergence possible entre acces bas      }
 { niveau et acces BIOS. }
 TEmuFDC = Record
  DOR      : Byte;   { 3F2h : bit0-1=unite selectionnee, bit2=/RESET (0=     }
                      { controleur en reset), bit3=DMA/IRQ actif, bit4-7=    }
                      { moteur unites 0-3 }
  CCR      : Byte;   { 3F7h ecriture (AT+ seulement) : bit0-1=debit }
  State    : Byte;   { 0=IDLE, 1=CMD (accumule les parametres), 2=EXEC       }
                      { (phase donnees), 3=RESULT }
  CmdBuf   : Array[0..8] Of Byte;
  CmdLen, CmdExpected : Integer;
  ResBuf   : Array[0..6] Of Byte;
  ResLen, ResPos : Integer;
  DataBuf  : Array[0..511] Of Byte;
  DataPos, DataLen : Integer;
  DataIsWrite : Boolean;
  PCN      : Array[0..3] Of Byte;          { present cylinder number/unite }
  SeekIntPending : Array[0..3] Of Boolean; { attend SENSE INTERRUPT STATUS }
  XferUnit, XferCyl, XferHead, XferSec, XferSize : Byte;
 End;

 { ============================================================
   IBM TopView (Options > Emulateur > DOS: OS > TopView) - INT 15h
   AH=10h/11h/12h, voir DOC/TOPVIEW_PROGRAMMING.txt et Emu_Tv*.
   PERIMETRE ASSUME (documente ici une fois, voir aussi les commentaires
   pres d Emu_DoInt15Tv) : cet emulateur execute UN SEUL programme DOS a
   la fois (un seul contexte CPU 8086) - il n y a donc PAS de vrai
   ordonnanceur multitache a proteger. Le modele d objets TopView (fenetres,
   boites aux lettres, claviers, temporisateurs, pointeurs, panneaux,
   OBJECTQ) est implante REELLEMENT (etat veritable, verifiable), mais la
   MULTITACHE PREEMPTIVE/COOPERATIVE elle-meme (executer plusieurs taches
   invitees en parallele) est HORS PERIMETRE - une fenetre creee avec
   l indicateur "tache" (NEW WINDOW) est acceptee et inspectable, mais son
   point d entree n est jamais reellement lance comme un second flux
   d execution concurrent. INT 50h-57h (IRQ materielles remappees, voir la
   section 2 du document) ne sont PAS relogees : le 8259A de cet emulateur
   garde sa base de vecteurs habituelle, car il n y a aucune seconde tache
   dont il faudrait proteger les IRQ. }

 Const
  TVOT_WINDOW   = 0;
  TVOT_MAILBOX  = 1;
  TVOT_KEYBOARD = 2;
  TVOT_TIMER    = 3;
  TVOT_POINTER  = 4;
  TVOT_PANEL    = 5;
  TVOT_OBJECTQ  = 6;
  TVOT_FREE     = 255;

 Type
 { Detail d une fenetre/tache (classe WINDOW, NEW BL=08h). Le tampon video
   virtuel reel (voir GETBUF) vient d un pool physique limite a
   TV_MAX_WINDOWS emplacements (WinBufIdx = -1 si aucun assigne). }
 TTvWindow = Record
  Cols, Rows       : Word;
  Title            : String[64];
  CursorX, CursorY : Word;
  PosX, PosY       : Word;    { voir POSWIN/Emu_Tv_ApplyPosWin }
  WinBufIdx        : Integer; { 0..TV_MAX_WINDOWS-1, -1 si aucun tampon }
  IsTask           : Boolean; { indicateur tache/fenetre de NEW - voir le
                                 commentaire de perimetre ci-dessus : accepte
                                 et memorise, jamais reellement ordonnance }
  EntrySeg, EntryOfs : Word;
  KbdSlot, PtrSlot : Integer; { objets clavier/pointeur associes (OPEN), -1 si aucun }
 End;

 { Detail d une boite aux lettres (classe MAILBOX, NEW BL=09h) - file
   circulaire d octets simple, READ/WRITE. }
 TTvMailbox = Record
  Data          : Array[0..255] Of Byte;
  Head, Tail, Count : Integer;
  LastSenderSeg, LastSenderOfs : Word; { pour ADDR - expediteur du dernier message }
 End;

 TTvKeyboard = Record
  BoundWindow : Integer; { -1 si non associe a une fenetre (OPEN) }
 End;

 { Compteur en centiemes de seconde depuis minuit, pas de 10 ms reel
   (Emu_Tv_ServiceTimers, appele depuis Emu_TimerTick). }
 TTvTimer = Record
  ExpiryCenti : LongInt;
  Running     : Boolean;
 End;

 { Reflete l etat souris reel existant (EmuMouseX/Y/Btns) au lieu de le
   dupliquer - voir Emu_Tv_PointerRead. }
 TTvPointer = Record
  BoundWindow    : Integer;
  ScaleX, ScaleY : Word;
  Icon           : Byte;
 End;

 { Support PANEL delibirement minimal (voir le commentaire de perimetre) :
   un fichier de panneaux reel n est pas parse, DIR renvoie une liste vide
   plutot que d inventer un format non verifie. }
 TTvPanel = Record
  FileName : String[80];
 End;

 { ============================================================ }

 { --- Pile reseau Novell IPX/SPX (Options > Emulateur > DOS > "Reseau     }
 { Novell NetWare") - voir Emu_DoInt7A/Emu_DoInt2F. Modele "boucle         }
 { locale" : aucune autre machine sur le fil, donc tout paquet envoye est  }
 { livre a une ecoute active du MEME programme emule sur le meme socket,  }
 { instantanement ou des qu une ecoute correspondante est postee. Base sur }
 { la disposition verifiee du ECB (Event Control Block) et de l en-tete   }
 { IPX du pilote reseau de DOOM (id-Software/DOOM, ipx/IPXNET.H) et sur    }
 { les numeros de fonction INT 7Ah du Ralph Brown Interrupt List.         }
 TIpxBuf = Array[0..1023] Of Byte;

 TEmuIpxSocket = Record
  InUse     : Boolean;
  SocketNum : Word;
 End;

 { ECB en attente d une livraison (LISTEN FOR PACKET poste, aucun paquet   }
 { correspondant encore en file). }
 TEmuIpxPending = Record
  InUse     : Boolean;
  SocketNum : Word;
  ECBSeg, ECBOfs : Word;
 End;

 { Paquet IPX complet (en-tete 30 octets + charge utile) en attente d une  }
 { ecoute correspondante (SEND PACKET arrive avant tout LISTEN). }
 TEmuIpxQPacket = Record
  InUse      : Boolean;
  DestSocket : Word;
  Len        : Word;
  Data       : TIpxBuf;
 End;

 { Connexion SPX (au-dessus de la meme file de livraison IPX ci-dessus -   }
 { un paquet SPX EST un paquet IPX de PacketType=5h avec un en-tete SPX de }
 { 12 octets ajoute apres les 30 octets d en-tete IPX). }
 TEmuSpxConn = Record
  InUse        : Boolean;
  LocalSocket  : Word;
  RemoteSocket : Word;
  Established  : Boolean;
 End;

 TEmuIpxState = Record
  Active   : Boolean;              { vrai si case "Reseau Novell NetWare" }
                                    { cochee ET pile initialisee          }
  LocalNet  : Array[0..3] Of Byte; { numero de reseau synthetique         }
  LocalNode : Array[0..5] Of Byte; { adresse "materielle" synthetique     }
  Sockets   : Array[0..31] Of TEmuIpxSocket;
  Pending   : Array[0..15] Of TEmuIpxPending;
  Queue     : Array[0..15] Of TEmuIpxQPacket;
  NextDynSocket : Word;            { prochain socket dynamique (DX=0)     }
  Conns     : Array[0..15] Of TEmuSpxConn;
  NextConnId    : Word;
  StubSeg, StubOfs : Word;         { adresse du stub resident CD 7A CB    }
 End;

 { --- Pilote de paquets generique (Options > Emulateur > DOS > "Reseau    }
 { LAN") - PC/TCP Packet Driver Specification (FTP Software/Crynwr,       }
 { 1983), INT 60h. Voir Emu_DoInt60/Emu_PktInit. Modele "boucle locale"    }
 { identique a la pile IPX : un seul noeud virtuel, tout SEND_PKT est      }
 { compare aux filtres de TOUTES les poignees ouvertes et livre a celles   }
 { qui correspondent - la difference fondamentale avec IPX est que la     }
 { livraison d un paquet recu se fait EXCLUSIVEMENT par "upcall" (appel    }
 { far synchrone en 2 temps dans la fonction receiver enregistree par     }
 { l application, jamais par sondage d une structure comme le ECB IPX) :  }
 { il n y a donc pas de raccourci possible, contrairement a l ESR IPX -    }
 { voir Emu_PktCont/Emu_PktStartDelivery pour l injection reelle de code   }
 { invite (meme principe que Emu_FireHwInt pour les IRQ materielles, mais  }
 { enchainee sur 2 appels via un point de retour interne prive, INT FDh,   }
 { plutot qu un simple IRET). }
 TEmuPktHandle = Record
  InUse    : Boolean;
  IfClass  : Byte;                 { classe demandee (access_type AL)     }
  TypeSpec : Array[0..15] Of Byte; { motif de correspondance du type      }
  TypeLen  : Byte;                 { 0 = tout accepter (mode promiscuous) }
  RecvSeg, RecvOfs : Word;         { ES:DI du recepteur enregistre        }
  RcvMode  : Byte;                 { set_rcv_mode/get_rcv_mode, defaut 3  }
 End;

 { Machine a etats pour l injection de code invite en cours (livraison    }
 { reception 2 temps OU upcall as_send_pkt 1 temps - Stage disambigue) :  }
 {   Stage 0 = 1er appel recepteur (AX=0, demande de tampon) en vol       }
 {   Stage 1 = 2e appel recepteur (AX=1, livraison) en vol                }
 {   Stage 2 = upcall as_send_pkt (AX=resultat) en vol                    }
 TEmuPktCont = Record
  Pending  : Boolean;
  Stage    : Byte;
  HandleIdx: Integer;              { Stage 0/1 uniquement                }
  PktLen   : Word;
  Data     : TIpxBuf;
  BufSeg, BufOfs   : Word;         { tampon fourni par l appli (Stage 0->1)}
  SavedCS, SavedIP : Word;         { point de reprise apres toute la cascade}
  UpcallSeg, UpcallOfs : Word;     { Stage 2 uniquement                  }
 End;

 TEmuPktBacklogItem = Record
  InUse    : Boolean;
  HandleIdx: Integer;
  Len      : Word;
  Data     : TIpxBuf;
 End;

 TEmuPktStats = Record
  PacketsIn, PacketsOut : LongInt;
  BytesIn, BytesOut     : LongInt;
  ErrorsIn, ErrorsOut   : LongInt;
  PacketsLost           : LongInt;
 End;

 TEmuPktState = Record
  Active   : Boolean;
  Vector   : Byte;                 { = $60, seul vecteur emule            }
  LocalMAC : Array[0..5] Of Byte;  { adresse "materielle" synthetique     }
  Handles  : Array[0..7] Of TEmuPktHandle;
  NextHandleNum : Word;
  Cont     : TEmuPktCont;
  Backlog  : Array[0..7] Of TEmuPktBacklogItem; { autres poignees en      }
                                    { attente pour le MEME paquet envoye  }
  Stats    : TEmuPktStats;
  StubSeg, StubOfs : Word;         { signature de decouverte (jmp+PKT DRVR)}
  ContSeg, ContOfs : Word;         { trampoline de continuation (INT FDh) }
  NameSeg, NameOfs : Word;         { chaine ASCIIZ du nom (driver_info)   }
  { Upcall as_send_pkt (AH=11) en attente - voir Emu_PktFireAsSendUpcall  }
  { et la limite documentee (un seul upcall en vol a la fois). }
  AsSendPending    : Boolean;
  AsSendUpcallSeg, AsSendUpcallOfs : Word;
  AsSendBufSeg, AsSendBufOfs       : Word;
  AsSendResult     : Word;
 End;

 { --- Pilote XMS (Options > Emulateur > DOS: OS > "XMS") - eXtended       }
 { Memory Specification version 3.0 (Microsoft/Lotus/Intel/AST, 1991),     }
 { source verifiee : texte integral de la specification (xms30.txt).       }
 { Contrairement a IPX/Packet Driver, XMS n a PAS de numero d interruption }
 { dedie : l installation se verifie via INT 2Fh AX=4300h, et l adresse    }
 { d un point d entree "appel far direct" est obtenue via AX=4310h -       }
 { toutes les fonctions XMM (numero dans AH) passent ensuite par ce SEUL   }
 { appel far, jamais par interruption - voir Emu_DoIntFE/Emu_XmsInit.      }
 { Aucune des fonctions XMM de base ne necessite de rappeler du code       }
 { invite (pas d "upcall" comme Packet Driver) : chaque appel est          }
 { entierement synchrone, ce qui rend cette pile plus simple que les deux  }
 { precedentes malgre son nombre de fonctions. }
 TEmuXmsBuf = Array[0..EMU_XMS_CAP_KB * 1024 - 1] Of Byte;

 TEmuXmsHandle = Record
  InUse      : Boolean;
  SizeKB     : LongInt; { taille en Ko (32 bits pour AH=89h/8Fh) }
  LockCount  : Byte;
  StoreOffset: LongInt; { decalage en octets dans EmuXmsMem^ }
 End;

 TEmuXmsState = Record
  Active    : Boolean;
  StubSeg, StubOfs : Word;    { trampoline "appel far direct" (INT FEh)   }
  TotalKB   : LongInt;        { taille totale annoncee (DosXMSSize plafonne)}
  UsedBytes : LongInt;        { allocateur "bump" - voir Emu_XmsAlloc     }
  { Handle 0 = "memoire conventionnelle" par convention XMS (voir MOVE) - }
  { la table commence donc a l indice 1, comme les vrais handles XMS.     }
  Handles   : Array[1..64] Of TEmuXmsHandle;
  HmaOwned  : Boolean;         { HMA attribuee (fonctions 01h/02h)        }
  A20LocalCount : Integer;     { compteur local (fonctions 05h/06h)       }
  A20Global : Boolean;         { drapeau global (fonctions 03h/04h)       }
  UmbInUse  : Boolean;         { bloc UMB unique (EMU_UMB_SEG) deja       }
                                { accorde (fonctions 10h/11h/12h)          }
 End;

 { --- Pilote EMS (Options > Emulateur > DOS: OS > "EMS") - LIM/Microsoft  }
 { Expanded Memory Specification, versions 3.0/3.2/4.0 (source verifiee : }
 { limems40.txt, RBIL). INT 67h, numero de fonction dans AH (et parfois    }
 { un sous-numero dans AL, ex. 4Eh/50h/52h/53h/54h/57h/58h/59h). A         }
 { la difference de XMS, EMS est un VRAI numero d interruption (comme      }
 { Packet Driver) et non un point d entree obtenu par appel indirect.      }
 {                                                                        }
 { La case a cocher "Version EMS" (DosEMSVersion, 0=3.0/1=3.2/2=4.0)       }
 { determine QUELLES fonctions repondent - voir Emu_EmsVerAtLeast. C est   }
 { la demande explicite qui justifie ce champ : un developpeur qui teste   }
 { un programme cense fonctionner sous EMS 3.2 doit voir les fonctions     }
 { 4.0 echouer avec le code 84h ("fonction non definie"), exactement       }
 { comme sur un vrai gestionnaire EMS 3.2 qui ne les connait pas -         }
 { sans cette restriction, un programme mal ecrit qui suppose a tort la    }
 { presence de fonctions 4.0 pourrait sembler fonctionner alors qu il       }
 { echouerait sur du materiel/logiciel reel plus ancien.                   }
 {                                                                        }
 { Modele memoire : un tampon "memoire expansee" separe (EmuEmsMem, comme  }
 { EmuXmsMem) decoupe en pages fixes de 16 Ko, et une fenetre "page frame" }
 { de 4 emplacements de 16 Ko (EMU_EMS_FRAME_SEG) dans les 1 Mo            }
 { conventionnels (C.Memory) - Map/Unmap (44h) fait un VRAI va-et-vient de }
 { donnees entre les deux (bascule de banc), pas une simple redirection    }
 { d adresse, pour que la persistance des donnees d une page demappee      }
 { soit correcte quand elle est remappee plus tard - voir                  }
 { Emu_EmsSetSlot/Emu_EmsFlushSlot/Emu_EmsLoadSlot.                        }
 {                                                                        }
 { Limite assumee : le mode "adresse segment" de la fonction 50h (4.0,     }
 { AL=01h, qui permet en theorie de mapper une page EMS dans N IMPORTE     }
 { QUEL segment, pas seulement les 4 emplacements fixes de la page frame)  }
 { fait une copie ponctuelle sans suivi de banc persistant - les ecritures }
 { du programme dans ce segment ne seront pas reportees vers la memoire    }
 { expansee lors d un remappage ulterieur. Le mode "numero de page         }
 { physique" standard (AL=00h) et la fonction 44h, eux, ont une bascule    }
 { de banc complete et correcte. }
 TEmuEmsBuf = Array[0..EMU_EMS_CAP_KB * 1024 - 1] Of Byte;

 { Tampon "memoire etendue" DPMI separe (voir TEmuDpmiState/Dpmi_ReadByte) -}
 { meme principe que TEmuEmsBuf/TEmuXmsBuf : adresses lineaires DPMI       }
 { >= EMU_DPMI_EXT_BASE (1 Mo) redirigees ici plutot que vers P.CPU.Memory.}
 TDpmiExtBuf = Array[0..EMU_DPMI_EXT_CAP_KB * 1024 - 1] Of Byte;

 TEmuEmsHandle = Record
  InUse        : Boolean;
  PageCount    : Word;          { nombre de pages logiques de 16 Ko       }
  StorePageBase: LongInt;       { index de la 1ere page dans le pool EMS  }
  Attribute    : Byte;          { 0=volatile (EMS 4.0, fn 52h)            }
  Name         : Array[0..7] Of Byte; { nom 8 caracteres (EMS 4.0, fn 53h)}
 End;

 TEmuEmsSlot = Record          { un des 4 emplacements de la page frame   }
  MappedHandle : Word;          { 0 = aucune poignee mappee ici           }
  MappedPage   : Word;          { page logique actuellement chargee       }
 End;

 TEmuEmsState = Record
  Active     : Boolean;
  Version    : Byte;            { 0=3.0, 1=3.2, 2=4.0 (voir DosEMSVersion)}
  TotalPages : LongInt;         { capacite totale, en pages de 16 Ko      }
  UsedPages  : LongInt;         { allocateur "bump" en pages              }
  { Handle 0 n existe pas en EMS reel (contrairement a XMS) - la table     }
  { commence donc a l indice 1 comme les vrais handles EMM. }
  Handles    : Array[1..EMU_EMS_MAX_HANDLES] Of TEmuEmsHandle;
  Slots      : Array[0..3] Of TEmuEmsSlot;
  { Contexte de sauvegarde par poignee (fonctions 47h/48h, EMS 3.2+). }
  SavedSlots      : Array[1..EMU_EMS_MAX_HANDLES] Of Array[0..3] Of TEmuEmsSlot;
  SavedSlotsValid : Array[1..EMU_EMS_MAX_HANDLES] Of Boolean;
 End;

 { ========================================================================
   DPMI (DOS Protected Mode Interface, voir DOC/DPMI.txt) - coeur CPU 32   }
 { bits protege PARALLELE au coeur 8086 reel (P.CPU/TEmuCPU), et non une   }
 { extension de celui-ci : contrairement a l emulateur Linux ELF64 (memoire}
 { et registres entierement independants du reste de l IDE), ce coeur DOIT }
 { partager la memoire du programme DOS hote (P.CPU.Memory, voir           }
 { Dpmi_ReadByte/WriteByte) puisque le "client DPMI" est le MEME programme }
 { DOS qui vient de commuter en mode protege via INT 2Fh AX=1687h et       }
 { continue d appeler INT 21h/BIOS via les services DPMI "simuler          }
 { interruption mode reel" (AX=0300h, etape ulterieure) qui retombent sur  }
 { Emu_DoInt21 deja existant. Etat conserve en singleton global (DpmiCPU/  }
 { EmuDpmi), comme EmuEms/EmuXms/EmuMouse - un seul programme DOS          }
 { s execute a la fois dans cet IDE, donc pas besoin d un champ par panel. }
 { ======================================================================== }

 { Descripteur de segment logiciel (8 octets reels du x86, voir DOC/       }
 { DPMI.txt section 2.2) - stocke ici sous forme deja decodee plutot que   }
 { comme 8 octets bruts, sauf pour AX=000Bh/000Ch (descripteur brut) qui   }
 { re-assemblent AccessByte/FlagsByte a la volee. }
 TDpmiDescriptor = Record
  Present    : Boolean;
  Base       : LongInt;   { adresse lineaire de base }
  Limit      : LongInt;   { taille du segment moins 1, en octets (deja     }
                           { multiplie par 4096 si le bit G etait pose)    }
  AccessByte : Byte;      { octet de droits d acces brut (P/DPL/S/Type)    }
  FlagsByte  : Byte;      { octet de flags brut (G/D-B/L/AVL)              }
  Big        : Boolean;   { D/B=1 : segment "32 bits" (limite/adressage)   }
  IsCode     : Boolean;
 End;

 { LDT logicielle du client DPMI courant (voir DOC/DPMI.txt section 2.3 -  }
 { "le client peut allouer/modifier des descripteurs LDT" - la GDT elle-   }
 { meme n est pas exposee separement : un seul client actif a la fois dans}
 { cet emulateur, donc LDT et GDT seraient equivalentes en pratique). }
 TDpmiLDT = Array[0..EMU_DPMI_MAX_SEL] Of TDpmiDescriptor;

 { Poignee de bloc de memoire etendue DPMI (AX=0501h/0502h/0503h) - meme   }
 { principe d allocateur "bump" que EmuXms/EmuEms (voir leur commentaire   }
 { d en-tete respectif) : seulement recupere quand TOUTES les poignees     }
 { sont liberees simultanement. }
 TDpmiMemHandle = Record
  InUse   : Boolean;
  LinAddr : LongInt;
  Size    : LongInt;
 End;

 { Etat de configuration DPMI (case a cocher "DPMI"/"Taille", voir          }
 { Emu_DpmiInit) - separe de TDpmiCPU (etat d execution) comme              }
 { EmuEms/EmuXms separent deja configuration et etat d execution. }
 TEmuDpmiState = Record
  Active       : Boolean;   { case "DPMI" (DosDPMI) - voir Emu_DpmiInit }
  ExtCapBytes  : LongInt;   { plafond configure (DosDPMISize, en Ko*1024) }
  UsedBytes    : LongInt;   { allocateur "bump" de memoire etendue }
  Handles      : Array[0..EMU_DPMI_MAX_HANDLE - 1] Of TDpmiMemHandle;
  DosMemUsedOfs: Word;      { allocateur "bump" memoire DOS basse (AX=0100h),}
                             { offset courant dans EMU_DPMI_DOSMEM_SEG }
 End;

 { Etat d execution du coeur CPU 32 bits protege - actif seulement entre    }
 { l entree en mode protege (INT 2Fh AX=1687h) et la sortie finale (fin du }
 { programme). Reutilise TEmuFlags (drapeaux CF/ZF/SF/OF/... identiques en }
 { 32 bits) plutot que d en redefinir un jeu distinct. }
 TDpmiCPU = Record
  Active  : Boolean;    { le programme est actuellement en mode protege }
  Is32Bit : Boolean;    { AX=0/1 demande a l entree (16 ou 32 bits) }
  Reg     : TEmuRegs;   { reutilise le meme record variant EAX/AX/AL... que }
                         { le coeur 8086 (TEmuCPU.Regs) - memes alias }
  EIP     : LongInt;
  Flags   : TEmuFlags;
  SegSel  : Array[0..5] Of Word; { 0=ES 1=CS 2=SS 3=DS 4=FS 5=GS,           }
                                  { selecteurs (pas des segments reels)     }
  LDT      : TDpmiLDT;
  LDTCount : Integer;   { nombre d entrees allouees, pour AX=0000h }
  { Point de reprise en mode reel (CS:IP/SS:SP captures au moment de la    }
  { commutation initiale AX=1687h) - restaure a la sortie DPMI finale.     }
  RealCS, RealIP, RealSS, RealSP : Word;
  { Vecteurs d exception/interruption mode protege installes par le        }
  { client (AX=0203h/0205h, etape ulterieure) - Sel/Ofs par numero 0..FFh. }
  IntSel : Array[0..255] Of Word;
  IntOfs : Array[0..255] Of LongInt;
  { Rappels mode reel installes par AX=0303h (etape ulterieure). }
  CbUsed    : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Boolean;
  CbPmSel   : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
  CbPmOfs   : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of LongInt;
  CbRealSeg : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
  CbRealOfs : Array[0..EMU_DPMI_MAX_CALLBACK - 1] Of Word;
 End;

 { Operande decode a partir d un octet ModR/M (+ eventuel SIB) par          }
 { Dpmi_DecodeModRM - equivalent 32 bits proteges de TEmuOperand (coeur     }
 { 8086), mais LinAddr est deja l adresse LINEAIRE finale (base du          }
 { selecteur + deplacement), pas un couple segment:offset. }
 TDpmiOperand = Record
  IsReg  : Boolean;
  RegNum : Byte;
  LinAddr: LongInt;
  Len    : Integer;      { octets consommes (ModRM + SIB + deplacement) }
 End;

 { RealModeCallStructure (50 octets, voir DOC/DPMI.txt 7.1) utilisee par    }
 { AX=0300h/0301h/0302h - voir Dpmi_ReadRMCall/Dpmi_WriteRMCall. }
 TDpmiRMCall = Record
  EDI, ESI, EBP, EBX, EDX, ECX, EAX : LongInt;
  Flags, ESeg, DSeg, FSeg, GSeg, IPw, CSw, SPw, SSw : Word;
 End;

 { Etat de l emulateur 8086 + ecran virtuel + clavier }
 TEmulatorPanel = Record
  Base       : TDialog;          { dialogue de base                }
  Visible    : Boolean;          { panneau visible                 }
  Running    : Boolean;          { execution en cours              }
  Fault      : Integer;          { code de fin (sf*)               }
  BinaryPath : String[127];      { chemin du binaire DOS charge    }
  TargetCPU  : String[16];       { drapeau cible (-CD ou -CP)      }
  CPU        : TEmuCPU;          { etat complet du processeur 8086 }
  { Ecran virtuel 80 colonnes x 25 lignes }
  { Borne a 131 (132 colonnes) pour supporter le mode texte couleur       }
  { 132x25 de la carte ATI Graphics Solution (Options > Emulateur > DOS). }
  VRAM       : TEmuVRAMArr;
  CursorX    : Byte;             { colonne curseur (0..79)         }
  CursorY    : Byte;             { ligne curseur (0..24)           }
  CurFg      : Byte;             { couleur courante FG             }
  CurBg      : Byte;             { couleur courante BG             }
  CursorOn   : Boolean;          { curseur visible (clignotant)    }
  { Etat machine ANSI.SYS (Options > Emulateur > DOS: OS >          }
  { Pilote ANSI.SYS), voir EmuVScr_AnsiFeed/EmuVScr_AnsiExec.        }
  AnsiState  : Byte;             { 0=normal 1=ESC vu 2=ESC[ vu       }
  AnsiParams : Array[0..7] Of Integer; { parametres numeriques ESC[n;n...}
  AnsiNParam : Integer;          { index du parametre en cours       }
  AnsiSaveX  : Byte;             { colonne sauvee (ESC[s)            }
  AnsiSaveY  : Byte;             { ligne sauvee (ESC[u)              }
  AnsiBold   : Boolean;          { attribut "intense" (SGR 1) actif  }
  { File d attente clavier (ring buffer 64 entrees Word :
    octet bas = ASCII, octet haut = scancode BIOS) }
  KeyBuf     : Array[0..63] Of Word;
  KeyHead    : Byte;
  KeyTail    : Byte;
  { Geometrie du panneau }
  PanelX     : Integer;
  PanelY     : Integer;
  CharW      : Integer;          { largeur d un caractere (px)     }
  CharH      : Integer;          { hauteur d un caractere (px)     }
  Cols       : Integer;          { colonnes effectives (40 ou 80)  }
  Rows       : Integer;          { lignes effectives (typ. 25)     }
  NeedRepaint: Boolean;          { redessin complet requis         }
  StatusMsg  : String[127];      { message d etat affiche en bas   }
  { Stage 1 "multi-fenetre" (2026-08-15) : Loaded distingue "binaire      }
  { charge, execution pilotee par petits pas via l idle-tick de MainLoop" }
  { de l ancien modele "ShowEmulatorPanel bloque jusqu a la fin". Seuls    }
  { les backends convertis (voir EmuPanel_ContinueStep) positionnent      }
  { Loaded a True ; les autres restent sur l ancien chemin bloquant        }
  { inchange (Loaded jamais mis a True pour eux). TotalSteps remplace la   }
  { variable locale "Steps" qui ne peut plus survivre entre les appels.    }
  Loaded     : Boolean;
  TotalSteps : LongInt;
  { BOGUE REEL (2026-08-29) signale par l utilisateur : le pompage         }
  { periodique (DOS_RunOneChunk, toutes les 80 ms) rappelait               }
  { INCONDITIONNELLEMENT DrawEmulatorPanel meme quand P.VRAM/le curseur/   }
  { la barre d etat etaient IDENTIQUES au dernier rendu - un ecran DOS      }
  { texte tres statique (ex. Norton Commander en attente d une touche)      }
  { redessinait donc ~12 fois/seconde POUR RIEN (copie plein ecran +       }
  { ~3300 cellules + flip de page a chaque fois), percu comme un           }
  { scintillement genant. Ces champs memorisent le DERNIER etat REELLEMENT }
  { dessine pour permettre de sauter entierement l appel (aucun dessin,    }
  { aucun flip de page) quand rien n a change - contrairement a la          }
  { tentative de rendu differentiel CELLULE PAR CELLULE deja essayee et    }
  { REVERTEE pour le C64 (voir [[project_devenv]]), ceci ne saute JAMAIS    }
  { un dessin partiel : soit la trame COMPLETE est identique et on ne      }
  { touche a rien (la page visible deja correcte le reste), soit elle       }
  { differe et DrawEmulatorPanel s execute exactement comme avant,          }
  { integralement, code de dessin inchange. }
  PrevDrawValid    : Boolean;
  PrevDrawVRAM     : TEmuVRAMArr;
  PrevDrawCursorX  : Byte;
  PrevDrawCursorY  : Byte;
  PrevDrawCursorOn : Boolean;
  PrevDrawBlink    : Boolean;
  PrevDrawStatusMsg: String[127];
  PrevDrawRunning  : Boolean;
  PrevDrawFault    : Integer;
 End;

 { Stage 2 "multi-onglets emulateur" (2026-08-15) : instantane complet de }
 { tout l etat C64 qui vit dans des GLOBALES partagees (CPU6502_*/C64_*)  }
 { plutot que dans TEmulatorPanel - necessaire pour qu un onglet C64 non    }
 { actif garde son etat intact pendant qu un AUTRE onglet (texte, ou un     }
 { second C64) est actif. Un seul de ces instantanes est "en vigueur" a la }
 { fois (celui de l onglet actif est charge dans les globales, voir          }
 { C64_LoadState/C64_SaveState + SyncActiveWindowOut/In) - PAS d execution }
 { concurrente reelle, seulement une pause/reprise par bascule d onglet,    }
 { exactement comme demande ("l emulateur non actif se met en pause"). }
 { Types NOMMES (pas anonymes) pour les tableaux partages entre les          }
 { globales CPU6502_*/C64_* et TC64Snapshot - FPC traite deux tableaux         }
 { anonymes de meme forme comme des types DIFFERENTS, incompatibles pour        }
 { l affectation (`:=`) meme s ils sont structurellement identiques ; un        }
 { type nomme partage est necessaire pour que C64_SaveState/C64_LoadState        }
 { puissent faire de simples affectations de tableau entier. }
 T6502MemArr      = Array[0..$FFFF] Of Byte;
 TC64HiRamArr     = Array[$A000..$FFFF] Of Byte;
 TC64VicRegArr    = Array[0..$3F] Of Byte;
 TC64SidRegArr    = Array[0..$1F] Of Byte;
 TC64ColorRamArr  = Array[0..$3FF] Of Byte;
 TC64CiaRegArr    = Array[0..$0F] Of Byte;
 TC64KeyMatrixArr = Array[0..7, 0..7] Of Boolean;

 TC64Snapshot = Record
  Mem            : T6502MemArr;
  HiRam          : TC64HiRamArr;
  A, X, Y, P, S  : Byte;
  PC             : Word;
  Halted         : Boolean;
  ExitCode       : Integer;
  Variant        : Integer;
  Port01, Port00 : Byte;
  VicReg         : TC64VicRegArr;
  SidReg         : TC64SidRegArr;
  ColorRam       : TC64ColorRamArr;
  Cia1Reg        : TC64CiaRegArr;
  Cia2Reg        : TC64CiaRegArr;
  Cia1TimerA, Cia1TimerALatch: Word;
  Cia1TimerB, Cia1TimerBLatch: Word;
  Cia1IcrMask, Cia1IcrPending: Byte;
  IrqPending     : Boolean;
  KeyMatrix      : TC64KeyMatrixArr;
  FrameNo        : LongInt;
  RasterLine     : Word;
  RasterAcc      : Integer;
  PendingInject  : String;
  TypeIdx        : Integer;
  TypeCounter    : Integer;
  TypePressed    : Boolean;
  PendingVartab  : Word;
  PendingJumpPC  : Word;
  PendingJumpTimeout: LongInt;
  PendingInjectFallback: String;
  PendingPrgData : Array[0..65535] Of Byte;
  PendingPrgLen  : LongInt;
  PendingPrgLoadAddr: Word;
  AsyncKeyEsc    : Boolean;
  AsyncLastFrameTS: LongInt;
 End;

 { Meme motif que TC64Snapshot (Stage 1+2, meme session 2026-08-15),      }
 { backends NES/Atari 2600. Contrairement a TC64Snapshot, les champs      }
 { tableaux ne reutilisent PAS de type nomme partage : Nes_SaveState/     }
 { Nes_LoadState (et A2600 plus bas) utilisent Move() plutot que `:=`     }
 { pour ces champs, ce qui contourne l incompatibilite FPC entre deux     }
 { tableaux anonymes de meme forme SANS avoir a retyper les globales      }
 { NesXxx/A2600_Xxx elles-memes (Move() ne verifie que la taille, pas le  }
 { type). CPU/Mem reutilise T6502MemArr (deja partage avec C64/A2600 -    }
 { meme coeur 6502 generique) car ce champ-la utilise bien `:=`. }
 TNesSnapshot = Record
  Mem            : T6502MemArr;
  A, X, Y, P, S  : Byte;
  PC             : Word;
  Halted         : Boolean;
  ExitCode       : Integer;
  Variant        : Integer;
  Chr            : Array[0..$1FFF] Of Byte;
  NT             : Array[0..$7FF] Of Byte;
  Pal            : Array[0..$1F] Of Byte;
  Oam            : Array[0..$FF] Of Byte;
  FB             : Array[0..239, 0..255] Of Byte;
  FBPrev         : Array[0..239, 0..255] Of Byte;
  FBFirst        : Boolean;
  PpuCtrl, PpuMask, PpuStatus, OamAddr : Byte;
  ScrollX, ScrollY : Byte;
  PpuLatch       : Boolean;
  PpuAddr        : Word;
  PpuBuf         : Byte;
  Mirror         : Byte;
  PadStrobe      : Byte;
  NmiPending     : Boolean;
  FrameDone      : Boolean;
  FrameNo        : LongInt;
  Pad1, Pad2, Pad1Sh, Pad2Sh : Byte;
  PrgRom         : Array[0..$7FFFF] Of Byte;
  ChrRom         : Array[0..$3FFFF] Of Byte;
  PrgBlocksTotal, ChrBlocksTotal : Integer;
  Mapper         : Integer;
  UseChrRam      : Boolean;
  M1Shift, M1ShiftCount, M1Ctrl, M1Chr0, M1Chr1, M1Prg : Byte;
  M3BankSelect   : Byte;
  M3Banks        : Array[0..7] Of Byte;
  AsyncKeyEsc    : Boolean;
  AsyncLastFrameTS: LongInt;
 End;

 { Meme motif que TNesSnapshot (Move() pour les tableaux), backend Atari  }
 { 2600 - le plus gros des trois par NOMBRE de champs (nombreux schemas   }
 { de bank-switching de cartouche : F8/F6/F4/F8SC/F6SC/F4SC/FA/FE/E0/3F/  }
 { E7/3E/3E+/AR, chacun avec son propre etat), mais PAS par taille (les   }
 { tableaux restent petits, quelques dizaines de Ko au total). Les champs }
 { dont le nom d origine commence par un chiffre (A2600_3E_xxx, A2600_3EP_}
 { xxx) sont renommes E3_xxx/E3P_xxx ici - Pascal interdit un identifiant }
 { commencant par un chiffre. }
 TA2600Snapshot = Record
  Mem            : T6502MemArr;
  A, X, Y, P, S  : Byte;
  PC             : Word;
  Halted         : Boolean;
  ExitCode       : Integer;
  Variant        : Integer;
  Active         : Boolean;
  FB             : Array[0..191, 0..159] Of Byte;
  FBPrev         : Array[0..191, 0..159] Of Byte;
  FBFirst        : Boolean;
