{ --- Calcul du rectangle occupe par un menu deroulant --- }

Procedure GetMenuRect(Idx: Integer; Var X1,Y1,X2,Y2: Integer);
Var
 M: TMenu;
 MW, MH, I, SW: Integer;
Begin
 M := MainMenuBar.Menus[Idx];
 X1 := M.X;
 Y1 := MainMenuBar.Height;
 MW := M.Width;
 If MW < 160 Then MW := 160;
 MH := 4;
 For I := 0 To M.ItemCount - 1 Do Begin
  If M.Items[I].Separator Then MH := MH + 8
  Else MH := MH + 16;
 End;
 { Si le menu deroulant deborde a droite, le decaler vers la gauche
   pour qu il reste totalement visible }
 SW := GetScreenWidth;
 If X1 + MW + 2 > SW - 1 Then X1 := SW - 1 - MW - 2;
 If X1 < 0 Then X1 := 0;
 { +2 pour l ombre }
 X2 := X1 + MW + 2;
 Y2 := Y1 + MH + 2;
End;

{ --- Sauvegarder le fond avant d afficher un menu deroulant --- }

Procedure SaveMenuBackground(Idx: Integer);
Var
 BufSize: LongInt;
Begin
 GetMenuRect(Idx, MenuBgX1, MenuBgY1, MenuBgX2, MenuBgY2);
 BufSize := ImageSize(MenuBgX1, MenuBgY1, MenuBgX2, MenuBgY2);
 GetMem(MenuBgBuf, BufSize);
 GetImage(MenuBgX1, MenuBgY1, MenuBgX2, MenuBgY2, MenuBgBuf^);
 MenuBgSaved := True;
End;

{ --- Restaurer le fond sauvegarde (efface le menu deroulant) --- }

Procedure RestoreMenuBackground;
Var
 BufSize: LongInt;
Begin
 If Not MenuBgSaved Then Exit;
 PutImage(MenuBgX1, MenuBgY1, MenuBgBuf^, NormalPut);
 BufSize := ImageSize(MenuBgX1, MenuBgY1, MenuBgX2, MenuBgY2);
 FreeMem(MenuBgBuf, BufSize);
 MenuBgBuf := nil;
 MenuBgSaved := False;
End;

{ Declaration anticipee : implementee plus bas avec les autres
  routines de dessin d icones de la barre d outils }
Procedure DrawIcon16x16(X, Y: Integer; Var Icon: TIcon16); Forward;

Procedure DrawMenuBar;
Var
 I, TX, BX, BY: Integer;
Begin
 { Fond de la barre }
 SetColor(CLR_MENUBAR);
 { Correctif 2026-08-15 : Bar() utilise la couleur de SetFillStyle (pas   }
 { celle de SetColor) dans PtcGraph. Sans cet appel, Bar() heritait de la }
 { derniere couleur de remplissage laissee par DrawFilledRect (utilisee   }
 { par le rendu de l ecran emulateur), rendant la barre de menus grise    }
 { uniforme des qu un emulateur avait dessine au moins une fois. }
 SetFillStyle(SolidFill, CLR_MENUBAR);
 Bar(0, MainMenuBar.Y, GetScreenWidth - 1,
     MainMenuBar.Y + MainMenuBar.Height - 1);
 { Ligne de separation }
 SetColor(CLR_BORDER);
 Line(0, MainMenuBar.Y + MainMenuBar.Height - 1,
      GetScreenWidth - 1, MainMenuBar.Y + MainMenuBar.Height - 1);
 { Titres des menus }
 TX := 4;
 For I := 0 To MainMenuBar.MenuCount - 1 Do Begin
  If I = OpenMenuIdx Then Begin
   SetColor(CLR_MENU_HIGHLIGHT);
   SetFillStyle(SolidFill, CLR_MENU_HIGHLIGHT);
   Bar(TX - 4, MainMenuBar.Y,
       TX + Length(MainMenuBar.Menus[I].Title) * 8 + 12,
       MainMenuBar.Y + MainMenuBar.Height - 2);
   SetColor(CLR_EDITOR_BG);
  End Else
   SetColor(CLR_MENU_TEXT);
  OutTextXY(TX, MainMenuBar.Y + 4, MainMenuBar.Menus[I].Title);
  TX := TX + Length(MainMenuBar.Menus[I].Title) * 8 + 16;
 End;
 { Bouton de zoom ecran (plein ecran / VGA 640x480), coin sup. droit }
 BX := GetScreenWidth - SCRZOOM_BTN_SIZE - SCRZOOM_BTN_MARGIN;
 BY := MainMenuBar.Y + (MainMenuBar.Height - SCRZOOM_BTN_SIZE) Div 2;
 If ScrZoomHover Then Begin
  SetColor(CLR_MENU_HIGHLIGHT);
  SetFillStyle(SolidFill, CLR_MENU_HIGHLIGHT);
  Bar(BX - 2, MainMenuBar.Y, BX + SCRZOOM_BTN_SIZE + 1,
      MainMenuBar.Y + MainMenuBar.Height - 2);
 End;
 DrawIcon16x16(BX, BY, ScrZoomIcon);
End;

{ --- Ouverture d un menu deroulant --- }

Procedure DrawOpenMenu;
Var
 I, YPos, MX, MW, MH, SW: Integer;
 M: TMenu;
Begin
 If OpenMenuIdx < 0 Then Exit;
 M := MainMenuBar.Menus[OpenMenuIdx];
 MX := M.X;
 MW := M.Width;
 If MW < 160 Then MW := 160;
 MH := 4;
 For I := 0 To M.ItemCount - 1 Do Begin
  If M.Items[I].Separator Then
   MH := MH + 8
  Else
   MH := MH + 16;
 End;
 { Decalage vers la gauche si le menu deroulant deborde a droite,
   afin qu il reste totalement visible. Doit etre coherent avec
   GetMenuRect pour que la sauvegarde/restauration du fond couvre
   exactement la meme zone. }
 SW := GetScreenWidth;
 If MX + MW + 2 > SW - 1 Then MX := SW - 1 - MW - 2;
 If MX < 0 Then MX := 0;
 { Ombre }
 SetColor(CLR_TITLEBAR);
 SetFillStyle(SolidFill, CLR_TITLEBAR);
 Bar(MX + 2, MainMenuBar.Height + 2, MX + MW + 2,
     MainMenuBar.Height + MH + 2);
 { Fond du menu }
 SetColor(CLR_EDITOR_BG);
 { Correctif 2026-08-15 : voir DrawMenuBar - Bar() suit SetFillStyle,       }
 { pas SetColor ; sans ceci le fond du menu deroulant heritait de la       }
 { derniere couleur de remplissage de l ecran emulateur (DrawFilledRect),  }
 { produisant un rectangle gris uniforme sans texte visible. }
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(MX, MainMenuBar.Height, MX + MW, MainMenuBar.Height + MH);
 { Bordure }
 SetColor(CLR_BORDER);
 Rectangle(MX, MainMenuBar.Height, MX + MW, MainMenuBar.Height + MH);
 { Items }
 YPos := MainMenuBar.Height + 2;
 For I := 0 To M.ItemCount - 1 Do Begin
  If M.Items[I].Separator Then Begin
   SetColor(CLR_BORDER);
   Line(MX + 2, YPos + 3, MX + MW - 2, YPos + 3);
   YPos := YPos + 8;
  End Else Begin
   If I = SelItemIdx Then Begin
    SetColor(CLR_MENU_HIGHLIGHT);
    SetFillStyle(SolidFill, CLR_MENU_HIGHLIGHT);
    Bar(MX + 1, YPos, MX + MW - 1, YPos + 15);
    SetColor(CLR_EDITOR_BG);
   End Else Begin
    If Not M.Items[I].Enabled Then
     SetColor(CLR_BORDER)
    Else
     SetColor(CLR_MENU_TEXT);
   End;
   { Coche }
   If M.Items[I].Checked Then
    OutTextXY(MX + 4, YPos + 2, #251);
   { Caption }
   OutTextXY(MX + 16, YPos + 2, M.Items[I].Caption);
   { Raccourci }
   If Length(M.Items[I].ShortCut) > 0 Then Begin
    If I = SelItemIdx Then
     SetColor(CLR_EDITOR_BG)
    Else
     SetColor(CLR_BORDER);
    OutTextXY(MX + MW - Length(M.Items[I].ShortCut) * 8 - 8,
              YPos + 2, M.Items[I].ShortCut);
   End;
   YPos := YPos + 16;
  End;
 End;
End;

Procedure OpenMenu(Index: Integer);
Begin
 If (Index >= 0) And (Index < MainMenuBar.MenuCount) Then Begin
  { Si un menu est deja ouvert, restaurer le fond avant d afficher le nouveau }
  If MenuActive Then
   RestoreMenuBackground;
  OpenMenuIdx := Index;
  SelItemIdx := -1;
  MenuActive := True;
  DrawMenuBar;
  SaveMenuBackground(Index);  { sauvegarder le fond AVANT de dessiner }
  DrawOpenMenu;
 End;
End;

Procedure CloseMenu;
Begin
 { Restaurer le fond sauvegarde pour effacer le menu deroulant }
 RestoreMenuBackground;
 OpenMenuIdx := -1;
 SelItemIdx := -1;
 MenuActive := False;
 DrawMenuBar; { redessiner la barre sans surbrillance }
End;

{ --- Basculer entre le mode plein ecran et le mode VGA 640x480 :
  PtcGraph ne supporte pas de changer de mode graphique de facon
  fiable au sein d un meme processus (CloseGraph puis InitGraph a
  nouveau provoque un plantage). On redemarre donc DEVENV avec
  l autre mode, comme s il avait ete relance avec/sans -maxscreen. }

Procedure ToggleScreenZoom;
Var
 ExeName, CmdArgs, FullCmd, Arg: String;
 WantMax: Boolean;
 I: Integer;
Begin
 If ShowMessageBox('Changer de mode d''affichage',
  'DEVENV doit redemarrer pour changer de mode d''affichage.' + #10 +
  'Les modifications non enregistrees seront perdues.' + #10 +
  'Continuer ?', MB_YESNO, MI_WARNING) <> DR_YES Then Exit;
 If MenuActive Then CloseMenu;
 WantMax := Not ScreenMaxMode;
 ExeName := ParamStr(0);
 CmdArgs := '';
 For I := 1 To ParamCount Do Begin
  Arg := ParamStr(I);
  If UpCaseStr(Arg) <> '-MAXSCREEN' Then
   CmdArgs := CmdArgs + ' "' + Arg + '"';
 End;
 If WantMax Then CmdArgs := CmdArgs + ' -maxscreen';
 FullCmd := '"' + ExeName + '"' + CmdArgs;
 CloseGraph;
 {$IFDEF WINDOWS}
  Exec(GetEnv('COMSPEC'), '/C START "" ' + FullCmd);
 {$ELSE}
  Exec('/bin/sh', '-c ''' + FullCmd + ' &''');
 {$ENDIF}
 Halt(EXIT_OK);
End;

