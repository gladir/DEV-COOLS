{ ============================================================
  TERMINAL INTEGRE - SHELL INTERNE
  ============================================================ }

{ --- Ajouter une ligne au buffer du terminal --- }

Procedure TermAddLine(Var TP: TTerminalPanel; S: String);
Var
 Node, Old: PTermLine;
Begin
 If TP.LineCount < MAX_TERM_LINES Then Begin
  TP.Lines[TP.LineCount] := S;
  Inc(TP.LineCount);
 End Else Begin
  { Buffer plein : decaler vers le haut }
  Move(TP.Lines[1], TP.Lines[0],
   (MAX_TERM_LINES - 1) * SizeOf(String));
  TP.Lines[MAX_TERM_LINES - 1] := S;
 End;
 { Ajouter aussi a la liste chainee (historique d affichage) }
 New(Node);
 Node^.S := S;
 Node^.Prev := TP.HistTail;
 Node^.Next := Nil;
 If TP.HistTail <> Nil Then TP.HistTail^.Next := Node
 Else TP.HistHead := Node;
 TP.HistTail := Node;
 Inc(TP.HistCount);
 { Cap maximum : retirer la tete }
 While TP.HistCount > MAX_TERM_HIST_LINES Do Begin
  Old := TP.HistHead;
  If Old = Nil Then Break;
  TP.HistHead := Old^.Next;
  If TP.HistHead <> Nil Then TP.HistHead^.Prev := Nil
  Else TP.HistTail := Nil;
  Dispose(Old);
  Dec(TP.HistCount);
 End;
 { Si l utilisateur a remonte dans l historique, garder son point
   de vue stable en suivant les nouvelles lignes. }
 If TP.ScrollOffset > 0 Then Begin
  Inc(TP.ScrollOffset);
  If TP.ScrollOffset >= TP.HistCount Then
   TP.ScrollOffset := TP.HistCount - 1;
 End;
 TP.NeedRepaint := True;
End;

{ --- Fonctions utilitaires du shell --- }

Function TermStrToUpper(S: String): String;
Var
 I: Integer;
Begin
 For I := 1 To Length(S) Do
  If S[I] In ['a'..'z'] Then
   S[I] := Chr(Ord(S[I]) - 32);
 TermStrToUpper := S;
End;

Function TermTrimL(S: String): String;
Var
 I: Integer;
Begin
 For I := 1 To Length(S) Do Begin
  If S[I] <> ' ' Then Begin
   TermTrimL := Copy(S, I, 255);
   Exit;
  End;
 End;
 TermTrimL := S;
End;

Function TermTrimR(S: String): String;
Var
 I: Integer;
Begin
 I := Length(S);
 While (I > 0) And (S[I] In [#9, ' ']) Do Dec(I);
 S[0] := Chr(I);
 TermTrimR := S;
End;

Function TermTrim(S: String): String;
Begin
 TermTrim := TermTrimL(TermTrimR(S));
End;

Function TermPadRight(S: String; Space: Integer): String;
Var
 I: Integer;
Begin
 If Length(S) < Space Then
  For I := Length(S) + 1 To Space Do
   S := S + ' ';
 TermPadRight := S;
End;

Function TermPadZeroLeft(Value: Integer; Space: Integer): String;
Var
 S: String;
Begin
 Str(Value, S);
 While Length(S) < Space Do S := '0' + S;
 TermPadZeroLeft := S;
End;

Function TermGetCurrentDir: String;
Var
 Dir: String;
Begin
 GetDir(0, Dir);
 TermGetCurrentDir := Dir;
End;

Function TermGetErrorMessage(Code: Word): String;
Begin
 Case Code Of
  0: TermGetErrorMessage := '';
  2: TermGetErrorMessage := 'Fichier introuvable';
  3: TermGetErrorMessage := 'Chemin introuvable';
  4: TermGetErrorMessage := 'Trop de fichiers ouverts';
  5: TermGetErrorMessage := 'Acces refuse';
  6: TermGetErrorMessage := 'Handle de fichier invalide';
  12: TermGetErrorMessage := 'Mode d''acces sur disque invalide';
  15: TermGetErrorMessage := 'Numero de disque invalide';
  16: TermGetErrorMessage := 'Impossible de supprimer le repertoire';
  17: TermGetErrorMessage := 'Impossible de renommer sur plusieurs volumes';
  100: TermGetErrorMessage := 'Erreur de lecture a partir du disque';
  101: TermGetErrorMessage := 'Erreur d''ecriture sur le disque';
  102: TermGetErrorMessage := 'Fichier non attribue';
  103: TermGetErrorMessage := 'Le fichier n''est pas ouvert';
  104: TermGetErrorMessage := 'Le fichier n''est pas ouvert a l''entree';
  105: TermGetErrorMessage := 'Le fichier n''est pas ouvert a la sortie';
  106: TermGetErrorMessage := 'Numero invalide';
  150: TermGetErrorMessage := 'Disque protege en ecriture';
  152: TermGetErrorMessage := 'Disque pas pret';
  Else TermGetErrorMessage := 'Erreur inconnue';
 End;
End;

{ --- Extraction de la commande et des parametres --- }

Procedure TermExtractCommand(CmdStr: String;
 Var CurrCmd, ParamStr: String);
Var
 I: Integer;
Begin
 CmdStr := TermTrim(CmdStr);
 For I := 1 To Length(CmdStr) Do Begin
  If Not (CmdStr[I] In ['A'..'Z', 'a'..'z', '_', '-',
   '0'..'9']) Then Begin
   CurrCmd := TermStrToUpper(Copy(CmdStr, 1, I - 1));
   ParamStr := TermTrimL(Copy(CmdStr, I, 255));
   Exit;
  End;
 End;
 CurrCmd := TermStrToUpper(CmdStr);
 ParamStr := '';
End;

Function TermExtractParam(ParamStr: String;
 Index: Integer): String;
Var
 Count, LocalIndex, L: Integer;
 Temp: String;
Begin
 Temp := '';
 Count := 1;
 LocalIndex := 1;
 L := 0;
 While Count <= Length(ParamStr) Do Begin
  If Not (ParamStr[Count] In [' ', #9]) Then Begin
   If LocalIndex = Index Then Begin
    While (Count <= Length(ParamStr)) And
     (Not (ParamStr[Count] In [' ', #9])) And
     (L < 255) Do Begin
     Temp := Temp + ParamStr[Count];
     Inc(L);
     Inc(Count);
    End;
    TermExtractParam := Temp;
    Exit;
   End;
   While (Count <= Length(ParamStr)) And
    (Not (ParamStr[Count] In [' ', #9])) Do
    Inc(Count);
   Inc(LocalIndex);
  End;
  If Count >= Length(ParamStr) Then Break;
  Inc(Count);
 End;
 TermExtractParam := Temp;
End;

{ --- Ajouter une commande a l historique du terminal --- }

Procedure TermAddHistory(Var TP: TTerminalPanel; S: String);
Var
 I: Integer;
Begin
 If S = '' Then Exit;
 If TP.NumberHistory >= MAX_TERM_HISTORY Then Begin
  For I := 1 To MAX_TERM_HISTORY - 1 Do
   TP.TermHistory[I] := TP.TermHistory[I + 1];
  TP.TermHistory[MAX_TERM_HISTORY] := S;
 End Else Begin
  Inc(TP.NumberHistory);
  TP.TermHistory[TP.NumberHistory] := S;
 End;
 TP.HistoryPos := TP.NumberHistory + 1;
End;

{ --- Copie de fichier interne (definition apres helpers FAT) --- }

{ ============================================================
  ACCES FAT12/16 POUR LE TERMINAL INTEGRE
  ============================================================
  Les images montees via /DISK0, /DISK1, /DISK80 et /DISK81 sont
  lues via la couche de traduction de conteneur (Emu_ImageReadSector/
  Emu_ImageWriteSector, definie plus bas avec l emulateur), decalee
  de FatVol[Idx].PartitionStart pour les disques durs partitionnes
  (MBR). Ces helpers fournissent une couche suffisante pour
  DIR / CD / TYPE / VOL. }

{ Declarations anticipees : implementees avec le reste du support
  disque de l emulateur (conteneurs VHD/VMDK). }
Function Emu_ImageReadSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean; Forward;
Function Emu_ImageWriteSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean; Forward;

Function Fat_ReadSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean;
Begin
 Fat_ReadSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If LBA < 0 Then Exit;
 Fat_ReadSector :=
  Emu_ImageReadSector(Idx, FatVol[Idx].PartitionStart + LBA, Buf);
End;

Function Fat_LE16(Var Buf: Array Of Byte; Off: Integer): Word;
Begin
 Fat_LE16 := Word(Buf[Off]) Or (Word(Buf[Off + 1]) Shl 8);
End;

Function Fat_LE32(Var Buf: Array Of Byte; Off: Integer): LongInt;
Begin
 Fat_LE32 := LongInt(Buf[Off]) +
             LongInt(Buf[Off + 1]) * 256 +
             LongInt(Buf[Off + 2]) * 65536 +
             LongInt(Buf[Off + 3]) * 16777216;
End;

{ --- Format image Commodore 64 (.D64) : 35 ou 40 pistes, secteurs
      de 256 octets, nombre variable par piste (17..21). ----------- }

Const
 D64_SectorCount: Array[1..40] Of Byte = (
  21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,21,
  19,19,19,19,19,19,19,
  18,18,18,18,18,18,
  17,17,17,17,17,
  17,17,17,17,17);
 D64_SectorOfs: Array[1..40] Of Word = (
  0,21,42,63,84,105,126,147,168,189,210,231,252,273,294,315,336,
  357,376,395,414,433,452,471,
  490,508,526,544,562,580,
  598,615,632,649,666,
  683,700,717,734,751);
 D64_KindName: Array[0..15] Of String[3] = (
  'DEL','SEQ','PRG','USR','REL','EL?','EQ?','RG?',
  'SR?','EL?','L??','Q??','G??','R??','L??','???');

Function D64_SectorOffset(Track, Sector: Word): LongInt;
Begin
 If (Track < 1) Or (Track > 40) Or
    (Sector >= D64_SectorCount[Track]) Then
  D64_SectorOffset := -1
 Else
  D64_SectorOffset := (LongInt(D64_SectorOfs[Track]) +
                       LongInt(Sector)) Shl 8;
End;

Function D64_ReadSector(Idx: Byte; Track, Sector: Word;
 Var Buf: Array Of Byte): Boolean;
Var
 Ofs: LongInt;
 BR: Word;
Begin
 D64_ReadSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 Ofs := D64_SectorOffset(Track, Sector);
 If Ofs < 0 Then Exit;
 If Ofs + 256 > EmuFloppySize[Idx] Then Exit;
 {$I-}
 Seek(EmuFloppyFile[Idx], Ofs);
 If IOResult <> 0 Then Exit;
 BR := 0;
 BlockRead(EmuFloppyFile[Idx], Buf, 256, BR);
 {$I+} If IOResult <> 0 Then Exit;
 D64_ReadSector := (BR = 256);
End;

{ Convertir un caractere PETSCII screen-padding ($A0) en espace, et
  filtrer les codes non imprimables. }
Function D64_PetsciiToAscii(B: Byte): Char;
Begin
 If B = $A0 Then D64_PetsciiToAscii := ' '
 Else If (B >= 32) And (B < 127) Then D64_PetsciiToAscii := Chr(B)
 Else If (B >= 193) And (B <= 218) Then
  D64_PetsciiToAscii := Chr(B - 193 + Ord('a'))
 Else D64_PetsciiToAscii := '.';
End;

Function D64_TryMount(Idx: Byte; Var V: TFatVol): Boolean;
Var
 Buf: Array[0..255] Of Byte;
 I: Integer;
 Sz: LongInt;
Begin
 D64_TryMount := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 Sz := EmuFloppySize[Idx];
 { Tailles supportees : 35 pistes (174848/175531) ou 40 (196608/197376) }
 If (Sz <> 174848) And (Sz <> 175531) And
    (Sz <> 196608) And (Sz <> 197376) Then Exit;
 If Sz >= 196608 Then V.D64Tracks := 40 Else V.D64Tracks := 35;
 { Lire le BAM : piste 18, secteur 0 }
 If Not D64_ReadSector(Idx, 18, 0, Buf) Then Exit;
 { Extraire le nom du disque (offset 144..159) avec padding $A0 }
 V.VolLabel := '';
 For I := 0 To 15 Do Begin
  If Buf[144 + I] = $A0 Then Break;
  V.VolLabel := V.VolLabel + D64_PetsciiToAscii(Buf[144 + I]);
 End;
 While (V.VolLabel <> '') And
       (V.VolLabel[Length(V.VolLabel)] = ' ') Do
  V.VolLabel := Copy(V.VolLabel, 1, Length(V.VolLabel) - 1);
 V.IsD64 := True;
 V.Mounted := True;
 D64_TryMount := True;
End;

{ --- Format image Heath/Zenith .H8D : HDOS, CP/M-80 ou UCSD p-System, }
{ secteurs de 256 octets - reference complete (lecture ET ecriture) :  }
{ C:\SOURCE\GITHUB\corail\H8D.PAS (meme utilisateur). Ici, lecture       }
{ seule pour NC (listage F3/Entree + extraction par nom, meme motif       }
{ que D64_ExtractToTempFile) : CP/M-80 est liste mais son extraction       }
{ (extents/blocs d allocation chaines par nom) reste hors de portee -    }
{ seuls HDOS (chaine GRT simple) et UCSD p-System (blocs contigus,       }
{ necessaire pour executer les .CODE via l emulateur -CPCODE) sont         }
{ extractibles. }

Const
 H8D_FS_HDOS = 1;
 H8D_FS_CPM  = 2;
 H8D_FS_UCSD = 3;
 H8D_SECSIZE = 256;

Function H8D_ReadSector(Idx: Byte; SecNo: LongInt; Var Buf: Array Of Byte): Boolean;
Var
 Ofs: LongInt;
 BR: Word;
Begin
 H8D_ReadSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If SecNo < 0 Then Exit;
 Ofs := SecNo * H8D_SECSIZE;
 If Ofs + H8D_SECSIZE > EmuFloppySize[Idx] Then Exit;
 {$I-}
 Seek(EmuFloppyFile[Idx], Ofs);
 If IOResult <> 0 Then Exit;
 BR := 0;
 BlockRead(EmuFloppyFile[Idx], Buf, H8D_SECSIZE, BR);
 {$I+} If IOResult <> 0 Then Exit;
 H8D_ReadSector := (BR = H8D_SECSIZE);
End;

Function H8D_Read512(Idx: Byte; SecNo: LongInt; Var Buf: Array Of Byte): Boolean;
Var B1: Array[0..255] Of Byte;
Begin
 H8D_Read512 := False;
 If Not H8D_ReadSector(Idx, SecNo, B1) Then Exit;
 Move(B1, Buf[0], 256);
 If H8D_ReadSector(Idx, SecNo + 1, B1) Then Move(B1, Buf[256], 256)
 Else FillChar(Buf[256], 256, 0);
 H8D_Read512 := True;
End;

{ HDOS : signature de secteur de boot (3 variantes historiques) puis    }
{ en-tete DiskInfo au secteur 9 (DirSector@3, GrtSector@5, Spg@7 -       }
{ enregistrement octet-a-octet cote source, pas de remplissage d        }
{ alignement). }
Function H8D_DetectHDOS(Idx: Byte; Var DirSector, GrtSector: Word;
 Var Spg: Byte): Boolean;
Var
 Buf: Array[0..255] Of Byte;
 MaxSec: LongInt;
Begin
 H8D_DetectHDOS := False;
 If Not H8D_ReadSector(Idx, 0, Buf) Then Exit;
 If Not (
   ((Buf[0] = $C3) And (Buf[1] = $C0) And (Buf[2] = $22) And (Buf[3] = $00)) Or
   ((Buf[0] = $C3) And (Buf[1] = $A0) And (Buf[2] = $22) And (Buf[3] = $20)) Or
   ((Buf[0] = $AF) And (Buf[1] = $D3) And (Buf[2] = $7D) And (Buf[3] = $CD))
 ) Then Exit;
 If Not H8D_ReadSector(Idx, 9, Buf) Then Exit;
 DirSector := Word(Buf[3]) Or (Word(Buf[4]) Shl 8);
 GrtSector := Word(Buf[5]) Or (Word(Buf[6]) Shl 8);
 Spg := Buf[7];
 MaxSec := EmuFloppySize[Idx] Div H8D_SECSIZE;
 If (DirSector <= 0) Or (LongInt(DirSector) >= MaxSec) Or
    (LongInt(GrtSector) >= MaxSec) Or (Spg = 0) Then Exit;
 H8D_DetectHDOS := True;
End;

{ UCSD p-System : balaie les 40 premiers secteurs a la recherche d un    }
{ en-tete de volume plausible (FirstBlock=0, LastBlock 2..64, FileType=0,}
{ NameLen 1..7, nom ASCII imprimable). }
Function H8D_DetectUCSD(Idx: Byte; Var DirSecStart: LongInt): Boolean;
Var
 Buf: Array[0..255] Of Byte;
 S: LongInt;
 FB, LB, FT: Word;
 NL, I: Integer;
 C: Byte;
 OkName, R: Boolean;
Begin
 R := False; S := 0;
 While (Not R) And (S < 40) And
       (LongInt(S + 1) * H8D_SECSIZE <= EmuFloppySize[Idx]) Do Begin
  If Not H8D_ReadSector(Idx, S, Buf) Then Break;
  FB := Word(Buf[0]) Or (Word(Buf[1]) Shl 8);
  LB := Word(Buf[2]) Or (Word(Buf[3]) Shl 8);
  FT := Word(Buf[4]) Or (Word(Buf[5]) Shl 8);
  NL := Buf[6];
  If (FB = 0) And (LB >= 2) And (LB <= 64) And (FT = 0) And
     (NL >= 1) And (NL <= 7) Then Begin
   OkName := True;
   For I := 0 To NL - 1 Do Begin
    C := Buf[7 + I];
    If (C < $20) Or (C >= $7F) Then OkName := False;
   End;
   If OkName Then Begin DirSecStart := S; R := True; End;
  End;
  Inc(S);
 End;
 H8D_DetectUCSD := R;
End;

Function H8D_ScanCpmDirSector(Idx: Byte; StartSec: LongInt): Integer;
Var
 Buf: Array[0..255] Of Byte;
 I, K, Score: Integer;
 U, C: Byte;
 EmptyEnt, GoodEnt: Integer;
 OkName: Boolean;
Begin
 H8D_ScanCpmDirSector := 0;
 If LongInt(StartSec + 1) * H8D_SECSIZE > EmuFloppySize[Idx] Then Exit;
 If Not H8D_ReadSector(Idx, StartSec, Buf) Then Exit;
 EmptyEnt := 0; GoodEnt := 0;
 For I := 0 To 7 Do Begin
  U := Buf[I * 32];
  If U = $E5 Then Begin
   If (Buf[I * 32 + 1] = $E5) And (Buf[I * 32 + 2] = $E5) Then Inc(EmptyEnt);
  End Else If U <= $0F Then Begin
   OkName := True;
   For K := 1 To 11 Do Begin
    C := Buf[I * 32 + K] And $7F;
    If (C < $20) Or (C >= $7F) Then OkName := False;
   End;
   If OkName Then Inc(GoodEnt);
  End;
 End;
 Score := GoodEnt * 4 + EmptyEnt;
 If (GoodEnt = 0) And (EmptyEnt < 8) Then Score := 0;
 H8D_ScanCpmDirSector := Score;
End;

Function H8D_DetectCPM(Idx: Byte; Var DirSector: LongInt): Boolean;
Const
 Cand: Array[0..7] Of LongInt = (30, 20, 10, 8, 4, 40, 80, 2);
Var
 I: Integer;
 Best, BestSec, Sc: LongInt;
Begin
 Best := 0; BestSec := -1;
 For I := 0 To 7 Do Begin
  Sc := H8D_ScanCpmDirSector(Idx, Cand[I]);
  If Sc > Best Then Begin Best := Sc; BestSec := Cand[I]; End;
 End;
 If BestSec >= 0 Then Begin DirSector := BestSec; H8D_DetectCPM := True; End
 Else H8D_DetectCPM := False;
End;

Function H8D_TryMount(Idx: Byte; Var V: TFatVol): Boolean;
Var
 DirSec, GrtSec: Word;
 Spg: Byte;
 LDirSec: LongInt;
Begin
 H8D_TryMount := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 { Meme ordre de detection que DetectFs dans H8D.PAS : HDOS d abord     }
 { (signature de boot fiable), puis UCSD (en-tete distinctif), puis      }
 { CP/M-80 (heuristique la plus faible, en dernier recours). }
 If H8D_DetectHDOS(Idx, DirSec, GrtSec, Spg) Then Begin
  V.IsH8D := True; V.H8DFsType := H8D_FS_HDOS; V.VolLabel := 'HDOS';
  V.Mounted := True; H8D_TryMount := True; Exit;
 End;
 If H8D_DetectUCSD(Idx, LDirSec) Then Begin
  V.IsH8D := True; V.H8DFsType := H8D_FS_UCSD; V.VolLabel := 'UCSD';
  V.Mounted := True; H8D_TryMount := True; Exit;
 End;
 If H8D_DetectCPM(Idx, LDirSec) Then Begin
  V.IsH8D := True; V.H8DFsType := H8D_FS_CPM; V.VolLabel := 'CP/M';
  V.Mounted := True; H8D_TryMount := True; Exit;
 End;
End;

Function H8D_TrimName(Var Buf: Array Of Byte; Off, Len: Integer): String;
Var S: String; I: Integer; C: Char;
Begin
 S := '';
 For I := 0 To Len - 1 Do Begin
  C := Chr(Buf[Off + I]);
  If (C <> #0) And (C <> ' ') Then S := S + C;
 End;
 H8D_TrimName := S;
End;

{ Repertoire HDOS : chaine de blocs de 512 octets (2 secteurs), 22       }
{ entrees de 23 octets par bloc (Name[8]+Ext[3]+Prj+Ver+Clf+Flags+Rsvd+  }
{ Fgn+Lgn+Lsi+CreDate[2]+ModDate[2]), pointeur de bloc suivant aux           }
{ octets 510-511 (0 = fin de chaine) - meme parcours que BuildDir. }
Procedure H8D_ListHDOS(Idx: Byte; Var Pane: TNCPane);
Var
 DirSec, GrtSec: Word;
 Spg: Byte;
 GrtBuf: Array[0..255] Of Byte;
 Buf: Array[0..511] Of Byte;
 NxtSector: LongInt;
 Block, I, EntOff: Integer;
 Done: Boolean;
 NameStr, ExtStr, DName: String;
 Clu: Byte;
 CC, SafetyClu: Integer;
 SizeSec: LongInt;
Begin
 If Not H8D_DetectHDOS(Idx, DirSec, GrtSec, Spg) Then Exit;
 If Not H8D_ReadSector(Idx, GrtSec, GrtBuf) Then Exit;
 NxtSector := DirSec; Block := 0; Done := False;
 While Not Done Do Begin
  If Not H8D_Read512(Idx, NxtSector, Buf) Then Break;
  Inc(Block);
  For I := 0 To 21 Do Begin
   EntOff := I * 23;
   If (Buf[EntOff] < 32) Or (Buf[EntOff] > 126) Then Continue;
   If Pane.Count >= MAX_NC_ENTRIES Then Begin Done := True; Break; End;
   NameStr := H8D_TrimName(Buf, EntOff, 8);
   ExtStr := H8D_TrimName(Buf, EntOff + 8, 3);
   DName := NameStr; If ExtStr <> '' Then DName := DName + '.' + ExtStr;
   Clu := Buf[EntOff + 16]; CC := 0; SafetyClu := 0;
   Repeat Inc(CC); Clu := GrtBuf[Clu]; Inc(SafetyClu);
   Until (Clu = 0) Or (SafetyClu > 300);
   SizeSec := (LongInt(CC) - 1) * Spg + Buf[EntOff + 18];
   If SizeSec < 0 Then SizeSec := 0;
   Pane.Entries[Pane.Count].Name := DName;
   Pane.Entries[Pane.Count].Size := SizeSec * H8D_SECSIZE;
   Pane.Entries[Pane.Count].IsDir := False;
   Pane.Entries[Pane.Count].FTime := 0;
   Pane.Entries[Pane.Count].FDate := 0;
   Pane.Entries[Pane.Count].Cluster := 0;
   Inc(Pane.Count);
  End;
  If Not Done Then Begin
   NxtSector := Word(Buf[510]) Or (Word(Buf[511]) Shl 8);
   If NxtSector = 0 Then Done := True;
   If Block > 200 Then Done := True;
  End;
 End;
End;

{ Repertoire UCSD p-System : bloc de 512 octets (2 secteurs) a           }
{ DirSecStart, NumFiles (mot @16), puis NumFiles entrees de 26 octets a  }
{ partir de l octet 26 (FirstBlk[2]/LastBlk[2]/FileKind[2]/NameLen[1]/    }
{ Name[15]/LastByte[2]/Access[2]) - fichiers en blocs CONTIGUS (pas de    }
{ chainage), FileKind=2 = Code (executable p-code). }
Procedure H8D_ListUCSD(Idx: Byte; Var Pane: TNCPane);
Var
 DirSec: LongInt;
 Buf: Array[0..511] Of Byte;
 NumFiles, I, J, Off: Integer;
 NL: Byte;
 FBlk, LBlk, EovBlk: Word;
 Name: String;
Begin
 If Not H8D_DetectUCSD(Idx, DirSec) Then Exit;
 If Not H8D_Read512(Idx, DirSec, Buf) Then Exit;
 NumFiles := Word(Buf[16]) Or (Word(Buf[17]) Shl 8);
 EovBlk := Word(Buf[14]) Or (Word(Buf[15]) Shl 8);
 If NumFiles > 78 Then NumFiles := 78;
 For I := 0 To NumFiles - 1 Do Begin
  Off := 26 + I * 26;
  If Off + 26 > 512 Then Break;
  FBlk := Word(Buf[Off]) Or (Word(Buf[Off + 1]) Shl 8);
  LBlk := Word(Buf[Off + 2]) Or (Word(Buf[Off + 3]) Shl 8);
  NL := Buf[Off + 6];
  If (FBlk >= LBlk) Or (LBlk > EovBlk) Or (NL < 1) Or (NL > 15) Then Break;
  If Pane.Count >= MAX_NC_ENTRIES Then Break;
  Name := '';
  For J := 0 To NL - 1 Do Name := Name + Chr(Buf[Off + 7 + J]);
  Pane.Entries[Pane.Count].Name := Name;
  Pane.Entries[Pane.Count].Size := (LongInt(LBlk - FBlk - 1) * 512) +
   (Word(Buf[Off + 22]) Or (Word(Buf[Off + 23]) Shl 8));
  Pane.Entries[Pane.Count].IsDir := False;
  Pane.Entries[Pane.Count].FTime := 0;
  Pane.Entries[Pane.Count].FDate := 0;
  Pane.Entries[Pane.Count].Cluster := FBlk;
  Inc(Pane.Count);
 End;
End;

{ Repertoire CP/M-80 : entrees 32 octets, un fichier = un ou plusieurs   }
{ extents (meme Nom+Ext+User) - regroupe par nom pour l affichage,        }
{ taille approximee via l extent de plus haut numero (comme CpmFileSize).}
{ Liste uniquement (voir commentaire d en-tete : extraction non            }
{ supportee pour ce format). }
Procedure H8D_ListCPM(Idx: Byte; Var Pane: TNCPane);
Var
 DirSec: LongInt;
 Buf: Array[0..255] Of Byte;
 S, I, K, J: Integer;
 U, C, Rc: Byte;
 OkName: Boolean;
 Name, Ext, FullName: String;
 SeenNames: Array[0..255] Of String[12];
 SeenUser: Array[0..255] Of Byte;
 SeenMaxExt: Array[0..255] Of Integer;
 NSeen, Found: Integer;
 ExtNum: Integer;
Begin
 If Not H8D_DetectCPM(Idx, DirSec) Then Exit;
 NSeen := 0;
 For S := 0 To 7 Do Begin
  If LongInt(DirSec + S + 1) * H8D_SECSIZE > EmuFloppySize[Idx] Then Break;
  If Not H8D_ReadSector(Idx, DirSec + S, Buf) Then Break;
  For I := 0 To 7 Do Begin
   U := Buf[I * 32];
   If U > $0F Then Continue;
   OkName := True;
   For K := 1 To 11 Do Begin
    C := Buf[I * 32 + K] And $7F;
    If (C < $20) Or (C >= $7F) Then OkName := False;
   End;
   If Not OkName Then Continue;
   Name := '';
   For K := 0 To 7 Do If (Buf[I * 32 + 1 + K] And $7F) <> 32 Then
    Name := Name + Chr(Buf[I * 32 + 1 + K] And $7F);
   Ext := '';
   For K := 0 To 2 Do If (Buf[I * 32 + 9 + K] And $7F) <> 32 Then
    Ext := Ext + Chr(Buf[I * 32 + 9 + K] And $7F);
   FullName := Name; If Ext <> '' Then FullName := FullName + '.' + Ext;
   Rc := Buf[I * 32 + 15];
   ExtNum := (Buf[I * 32 + 14] And $3F) * 32 + (Buf[I * 32 + 12] And $1F);
   Found := -1;
   For J := 0 To NSeen - 1 Do
    If (SeenUser[J] = U) And (SeenNames[J] = FullName) Then Begin Found := J; Break; End;
   If Found < 0 Then Begin
    If (NSeen >= 256) Or (Pane.Count >= MAX_NC_ENTRIES) Then Continue;
    Found := NSeen; Inc(NSeen);
    SeenUser[Found] := U; SeenNames[Found] := FullName; SeenMaxExt[Found] := -1;
    Pane.Entries[Pane.Count].Name := FullName;
    Pane.Entries[Pane.Count].Size := 0;
    Pane.Entries[Pane.Count].IsDir := False;
    Pane.Entries[Pane.Count].FTime := 0;
    Pane.Entries[Pane.Count].FDate := 0;
    Pane.Entries[Pane.Count].Cluster := 0;
    Inc(Pane.Count);
   End;
   If ExtNum > SeenMaxExt[Found] Then Begin
    SeenMaxExt[Found] := ExtNum;
    Pane.Entries[Found].Size := (LongInt(ExtNum) * 128 + Rc) * 128;
   End;
  End;
 End;
End;

Procedure H8D_ListDir(Idx: Byte; Var Pane: TNCPane);
Begin
 Case FatVol[Idx].H8DFsType Of
  H8D_FS_HDOS: H8D_ListHDOS(Idx, Pane);
  H8D_FS_UCSD: H8D_ListUCSD(Idx, Pane);
  H8D_FS_CPM:  H8D_ListCPM(Idx, Pane);
 End;
End;

Function H8D_ExtractHDOSByName(Idx: Byte; Const Name: String;
 Var OutPath: String): Boolean;
Var
 DirSec, GrtSec: Word;
 Spg: Byte;
 GrtBuf: Array[0..255] Of Byte;
 Buf: Array[0..511] Of Byte;
 NxtSector: LongInt;
 Block, I, EntOff: Integer;
 Done: Boolean;
 NameStr, ExtStr, DName: String;
 Clu: Byte;
 F: File;
 SizeSec: LongInt;
 CC, SafetyClu: Integer;
 SecBuf: Array[0..255] Of Byte;
 SecsLeft, S: LongInt;
 BR: Word;
Begin
 H8D_ExtractHDOSByName := False;
 If Not H8D_DetectHDOS(Idx, DirSec, GrtSec, Spg) Then Exit;
 If Not H8D_ReadSector(Idx, GrtSec, GrtBuf) Then Exit;
 NxtSector := DirSec; Block := 0; Done := False;
 While Not Done Do Begin
  If Not H8D_Read512(Idx, NxtSector, Buf) Then Break;
  Inc(Block);
  For I := 0 To 21 Do Begin
   EntOff := I * 23;
   If (Buf[EntOff] < 32) Or (Buf[EntOff] > 126) Then Continue;
   NameStr := H8D_TrimName(Buf, EntOff, 8);
   ExtStr := H8D_TrimName(Buf, EntOff + 8, 3);
   DName := NameStr; If ExtStr <> '' Then DName := DName + '.' + ExtStr;
   If UpCaseStr(DName) = UpCaseStr(Name) Then Begin
    Clu := Buf[EntOff + 16]; CC := 0; SafetyClu := 0;
    Repeat Inc(CC); Clu := GrtBuf[Clu]; Inc(SafetyClu);
    Until (Clu = 0) Or (SafetyClu > 300);
    SizeSec := (LongInt(CC) - 1) * Spg + Buf[EntOff + 18];
    If SizeSec < 0 Then SizeSec := 0;
    OutPath := GetEnv('TEMP');
    If OutPath = '' Then OutPath := '.';
    If OutPath[Length(OutPath)] <> '\' Then OutPath := OutPath + '\';
    OutPath := OutPath + 'DEVENV_NC_H8D_HDOS.TMP';
    {$I-} Assign(F, OutPath); Rewrite(F, 1); {$I+}
    If IOResult <> 0 Then Exit;
    Clu := Buf[EntOff + 16];
    SecsLeft := SizeSec;
    While SecsLeft > 0 Do Begin
     For S := 0 To Spg - 1 Do Begin
      If SecsLeft <= 0 Then Break;
      If Not H8D_ReadSector(Idx, LongInt(Clu) * Spg + S, SecBuf) Then Begin
       SecsLeft := 0; Break;
      End;
      BlockWrite(F, SecBuf, H8D_SECSIZE, BR);
      Dec(SecsLeft);
     End;
     Clu := GrtBuf[Clu];
     If Clu = 0 Then Break;
    End;
    Close(F);
    H8D_ExtractHDOSByName := True;
    Exit;
   End;
  End;
  NxtSector := Word(Buf[510]) Or (Word(Buf[511]) Shl 8);
  If NxtSector = 0 Then Done := True;
  If Block > 200 Then Done := True;
 End;
End;

Function H8D_ExtractUCSDByName(Idx: Byte; Const Name: String;
 Var OutPath: String): Boolean;
Var
 DirSec: LongInt;
 Buf: Array[0..511] Of Byte;
 SecBuf: Array[0..511] Of Byte;
 NumFiles, I, J, Off: Integer;
 NL: Byte;
 FBlk, LBlk, EovBlk: Word;
 EName: String;
 F: File;
 Blk: LongInt;
 NBytes: Integer;
 BR: Word;
Begin
 H8D_ExtractUCSDByName := False;
 If Not H8D_DetectUCSD(Idx, DirSec) Then Exit;
 If Not H8D_Read512(Idx, DirSec, Buf) Then Exit;
 NumFiles := Word(Buf[16]) Or (Word(Buf[17]) Shl 8);
 EovBlk := Word(Buf[14]) Or (Word(Buf[15]) Shl 8);
 If NumFiles > 78 Then NumFiles := 78;
 For I := 0 To NumFiles - 1 Do Begin
  Off := 26 + I * 26;
  If Off + 26 > 512 Then Break;
  FBlk := Word(Buf[Off]) Or (Word(Buf[Off + 1]) Shl 8);
  LBlk := Word(Buf[Off + 2]) Or (Word(Buf[Off + 3]) Shl 8);
  NL := Buf[Off + 6];
  If (FBlk >= LBlk) Or (LBlk > EovBlk) Or (NL < 1) Or (NL > 15) Then Break;
  EName := '';
  For J := 0 To NL - 1 Do EName := EName + Chr(Buf[Off + 7 + J]);
  If UpCaseStr(EName) = UpCaseStr(Name) Then Begin
   OutPath := GetEnv('TEMP');
   If OutPath = '' Then OutPath := '.';
   If OutPath[Length(OutPath)] <> '\' Then OutPath := OutPath + '\';
   OutPath := OutPath + 'DEVENV_NC_H8D_UCSD.TMP';
   {$I-} Assign(F, OutPath); Rewrite(F, 1); {$I+}
   If IOResult <> 0 Then Exit;
   Blk := FBlk;
   While Blk < LBlk Do Begin
    If Not H8D_Read512(Idx, Blk * 2, SecBuf) Then Break;
    If Blk = LBlk - 1 Then Begin
     NBytes := Word(Buf[Off + 22]) Or (Word(Buf[Off + 23]) Shl 8);
     If NBytes = 0 Then NBytes := 512;
    End Else NBytes := 512;
    BlockWrite(F, SecBuf, NBytes, BR);
    Inc(Blk);
   End;
   Close(F);
   H8D_ExtractUCSDByName := True;
   Exit;
  End;
 End;
End;

Function H8D_ExtractToTempFile(Idx: Byte; Const Name: String;
 Var OutPath: String): Boolean;
Begin
 H8D_ExtractToTempFile := False;
 Case FatVol[Idx].H8DFsType Of
  H8D_FS_HDOS: H8D_ExtractToTempFile := H8D_ExtractHDOSByName(Idx, Name, OutPath);
  H8D_FS_UCSD: H8D_ExtractToTempFile := H8D_ExtractUCSDByName(Idx, Name, OutPath);
 End;
End;

{ Types de partition MBR pouvant contenir un systeme de fichiers FAT
  (port de IsFATPartitionType, DISKPC.PAS / UNDISKPC.PAS). }
Function Fat_IsFATPartitionType(T: Byte): Boolean;
Begin
 Fat_IsFATPartitionType :=
  T In [$01, $04, $06, $0B, $0C, $0E, $11, $14, $16, $1B, $1C, $1E];
End;

Procedure Fat_TryMount(Idx: Byte);
Var
 Buf: Array[0..511] Of Byte;
 BPS: Word;
 SPC: Byte;
 TS16: Word;
 TS32: LongInt;
 SPF: Word;
 V: TFatVol;
 I: Integer;
 C: Char;
 PartStart: LongInt;
 PI, PO: Integer;
 PType: Byte;
 PLBA, PSZ: LongInt;
Begin
 FillChar(V, SizeOf(V), 0);
 V.Mounted := False;
 V.CachedFatLBA := -1;
 { Lecture absolue (disque entier) pour la sonde initiale. }
 FatVol[Idx].PartitionStart := 0;
 If Not EmuFloppyOpen[Idx] Then Begin
  FatVol[Idx] := V;
  Exit;
 End;
 { Essayer d abord le format Commodore 64 (.D64) }
 If D64_TryMount(Idx, V) Then Begin
  FatVol[Idx] := V;
  Exit;
 End;
 If H8D_TryMount(Idx, V) Then Begin
  FatVol[Idx] := V;
  Exit;
 End;
 If Not Fat_ReadSector(Idx, 0, Buf) Then Begin
  FatVol[Idx] := V;
  Exit;
 End;
 BPS := Fat_LE16(Buf, 11);
 SPC := Buf[13];
 PartStart := 0;
 If (BPS <> 512) Or (SPC = 0) Then Begin
  { Pas de BPB au secteur 0 : un disque dur (/DISK80, /DISK81) porte
    en general une table de partitions (MBR). Chercher la premiere
    partition FAT primaire et y monter le volume. }
  PartStart := -1;
  If (Buf[510] = $55) And (Buf[511] = $AA) Then Begin
   For PI := 0 To 3 Do Begin
    PO := 446 + PI * 16;
    PType := Buf[PO + 4];
    PLBA  := Fat_LE32(Buf, PO + 8);
    PSZ   := Fat_LE32(Buf, PO + 12);
    If Fat_IsFATPartitionType(PType) And (PLBA > 0) And (PSZ > 0) Then Begin
     PartStart := PLBA;
     Break;
    End;
   End;
  End;
  If PartStart < 0 Then Begin
   FatVol[Idx] := V;
   Exit;
  End;
  FatVol[Idx].PartitionStart := PartStart;
  If Not Fat_ReadSector(Idx, 0, Buf) Then Begin
   FatVol[Idx] := V;
   Exit;
  End;
  BPS := Fat_LE16(Buf, 11);
  SPC := Buf[13];
  If (BPS <> 512) Or (SPC = 0) Then Begin
   FatVol[Idx] := V;
   Exit;
  End;
 End;
 V.PartitionStart   := PartStart;
 V.BytesPerSector   := BPS;
 V.SectorsPerCluster := SPC;
 V.ReservedSectors  := Fat_LE16(Buf, 14);
 V.NumFATs          := Buf[16];
 V.RootEntries      := Fat_LE16(Buf, 17);  { 0 = FAT32 (racine = cluster) }
 TS16               := Fat_LE16(Buf, 19);
 TS32               := Fat_LE32(Buf, 32);
 If TS16 <> 0 Then V.TotalSectors := TS16
              Else V.TotalSectors := TS32;
 SPF                := Fat_LE16(Buf, 22);
 If SPF <> 0 Then V.SectorsPerFAT := SPF
             Else V.SectorsPerFAT := Fat_LE32(Buf, 36);  { FAT32 : 32 bits }
 If (V.NumFATs = 0) Or (V.ReservedSectors = 0) Or
    (V.SectorsPerFAT = 0) Or (V.TotalSectors = 0) Then Begin
  FatVol[Idx] := V;
  Exit;
 End;
 V.FATStart       := V.ReservedSectors;
 V.RootStart      := V.FATStart + LongInt(V.NumFATs) * V.SectorsPerFAT;
 If V.RootEntries = 0 Then Begin
  { FAT32 : pas de zone racine fixe, la racine est une chaine de
    clusters comme tout autre repertoire (BPB_RootClus a l offset 44). }
  V.RootDirSectors := 0;
  V.RootCluster    := Fat_LE32(Buf, 44);
  If V.RootCluster < 2 Then V.RootCluster := 2;
 End Else
  V.RootDirSectors := (LongInt(V.RootEntries) * 32 + 511) Div 512;
 V.DataStart      := V.RootStart + V.RootDirSectors;
 V.ClusterCount   := (V.TotalSectors - (V.ReservedSectors +
                       LongInt(V.NumFATs) * V.SectorsPerFAT +
                       V.RootDirSectors)) Div V.SectorsPerCluster;
 If V.RootEntries = 0 Then V.FATType := 32
 Else If V.ClusterCount < 4085 Then V.FATType := 12
 Else V.FATType := 16;
 { Label de volume : offset 43 (BPB 12/16) ou 71 (EBPB FAT32, le champ
   a 43 etant occupe par BPB_RootClus/FSInfo/BkBootSec en FAT32). }
 V.VolLabel := '';
 For I := 0 To 10 Do Begin
  If V.FATType = 32 Then C := Chr(Buf[71 + I]) Else C := Chr(Buf[43 + I]);
  If C = ' ' Then Continue;
  If (Ord(C) < 32) Or (Ord(C) > 126) Then Begin
   V.VolLabel := '';
   Break;
  End;
  V.VolLabel := V.VolLabel + C;
 End;
 V.Mounted := True;
 FatVol[Idx] := V;
End;

Function Fat_FATByte(Idx: Byte; Offset: LongInt): Byte;
Var
 LBA: LongInt;
 Within: Word;
Begin
 Fat_FATByte := 0;
 LBA := FatVol[Idx].FATStart + (Offset Div 512);
 Within := Word(Offset Mod 512);
 If LBA <> FatVol[Idx].CachedFatLBA Then Begin
  If Not Fat_ReadSector(Idx, LBA, FatVol[Idx].CachedFatBuf) Then Exit;
  FatVol[Idx].CachedFatLBA := LBA;
 End;
 Fat_FATByte := FatVol[Idx].CachedFatBuf[Within];
End;

Function Fat_NextCluster(Idx: Byte; Cl: LongInt): LongInt;
Var
 O: LongInt;
 B1, B2: Byte;
 V: LongInt;
Begin
 If FatVol[Idx].FATType = 12 Then Begin
  O := Cl + (Cl Div 2);
  B1 := Fat_FATByte(Idx, O);
  B2 := Fat_FATByte(Idx, O + 1);
  V := Word(B1) Or (Word(B2) Shl 8);
  If (Cl And 1) <> 0 Then V := V Shr 4
                     Else V := V And $0FFF;
  Fat_NextCluster := V;
 End Else If FatVol[Idx].FATType = 32 Then Begin
  O := Cl * 4;
  V := LongInt(Fat_FATByte(Idx, O)) Or
       (LongInt(Fat_FATByte(Idx, O + 1)) Shl 8) Or
       (LongInt(Fat_FATByte(Idx, O + 2)) Shl 16) Or
       (LongInt(Fat_FATByte(Idx, O + 3)) Shl 24);
  Fat_NextCluster := V And $0FFFFFFF;
 End Else Begin
  O := Cl * 2;
  Fat_NextCluster := Word(Fat_FATByte(Idx, O)) Or
                     (Word(Fat_FATByte(Idx, O + 1)) Shl 8);
 End;
End;

Function Fat_IsEOC(Idx: Byte; Cl: LongInt): Boolean;
Begin
 If FatVol[Idx].FATType = 12 Then Fat_IsEOC := Cl >= $0FF8
 Else If FatVol[Idx].FATType = 32 Then Fat_IsEOC := Cl >= $0FFFFFF8
 Else Fat_IsEOC := Cl >= $FFF8;
End;

Function Fat_ClusterToLBA(Idx: Byte; Cl: LongInt): LongInt;
Begin
 Fat_ClusterToLBA := FatVol[Idx].DataStart +
   LongInt(Cl - 2) * FatVol[Idx].SectorsPerCluster;
End;

Function Fat_UpStr(S: String): String;
Var I: Integer;
Begin
 For I := 1 To Length(S) Do
  If S[I] In ['a'..'z'] Then S[I] := Chr(Ord(S[I]) - 32);
 Fat_UpStr := S;
End;

{ Decoder un nom 8.3 a partir d une entree de repertoire (32 octets).
  Renvoie '' si entree libre/effacee ou nom long VFAT. }
Function Fat_EntryName(Var Buf: Array Of Byte; Off: Integer): String;
Var
 I: Integer;
 N, E: String;
 B: Byte;
Begin
 Fat_EntryName := '';
 If (Buf[Off] = 0) Or (Buf[Off] = $E5) Then Exit;
 If (Buf[Off + 11] And $0F) = $0F Then Exit;   { LFN }
 N := '';
 For I := 0 To 7 Do Begin
  B := Buf[Off + I];
  If B = 32 Then Continue;
  If (B < 32) Or (B > 126) Then Exit;
  N := N + Chr(B);
 End;
 E := '';
 For I := 8 To 10 Do Begin
  B := Buf[Off + 10 - (10 - I)]; { offsets 8..10 }
  B := Buf[Off + I];
  If B = 32 Then Continue;
  If (B < 32) Or (B > 126) Then Exit;
  E := E + Chr(B);
 End;
 { Premier byte $05 = caractere $E5 reel }
 If Buf[Off] = $05 Then N[1] := Chr($E5);
 If E <> '' Then Fat_EntryName := N + '.' + E
            Else Fat_EntryName := N;
End;

Function Fat_EntryAttr(Var Buf: Array Of Byte; Off: Integer): Byte;
Begin
 Fat_EntryAttr := Buf[Off + 11];
End;

Function Fat_EntryCluster(Idx: Byte; Var Buf: Array Of Byte;
 Off: Integer): LongInt;
Var
 Clu: LongInt;
Begin
 Clu := Fat_LE16(Buf, Off + 26);
 { FAT32 : 16 bits de poids fort a l offset 20 (DIR_FstClusHI). }
 If FatVol[Idx].FATType = 32 Then
  Clu := Clu Or (LongInt(Fat_LE16(Buf, Off + 20)) Shl 16);
 Fat_EntryCluster := Clu;
End;

Function Fat_EntrySize(Var Buf: Array Of Byte; Off: Integer): LongInt;
Begin
 Fat_EntrySize := Fat_LE32(Buf, Off + 28);
End;

{ Decoder l etiquette de volume depuis le repertoire racine si elle
  n a pas ete trouvee dans le BPB. }
Procedure Fat_FindVolLabel(Idx: Byte);
Var
 Buf: Array[0..511] Of Byte;
 S: LongInt;
 I, Cnt, Attr: Integer;
 LBA: LongInt;
 N: String;
 K: Integer;
Begin
 If Not FatVol[Idx].Mounted Then Exit;
 Cnt := 0;
 For S := 0 To FatVol[Idx].RootDirSectors - 1 Do Begin
  LBA := FatVol[Idx].RootStart + S;
  If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
  For I := 0 To 15 Do Begin
   If Cnt >= FatVol[Idx].RootEntries Then Exit;
   Inc(Cnt);
   If Buf[I * 32] = 0 Then Exit;
   If Buf[I * 32] = $E5 Then Continue;
   Attr := Buf[I * 32 + 11];
   If (Attr And $0F) = $0F Then Continue;   { LFN }
   If (Attr And $08) <> 0 Then Begin
    { Volume label }
    N := '';
    For K := 0 To 10 Do
     If (Buf[I * 32 + K] >= 32) And (Buf[I * 32 + K] <= 126) Then
      N := N + Chr(Buf[I * 32 + K]);
    While (Length(N) > 0) And (N[Length(N)] = ' ') Do
     N := Copy(N, 1, Length(N) - 1);
    If N <> '' Then FatVol[Idx].VolLabel := N;
    Exit;
   End;
  End;
 End;
End;

{ Decouper un chemin '\AAA\BBB\CCC' en composantes UPPER. Le slash
  '/' est aussi accepte. Renvoie le nombre de composantes (max 16). }
Procedure Fat_SplitPath(P: String; Var N: Integer;
 Var Parts: Array Of String);
Var
 I, Start: Integer;
 Sub: String;
Begin
 N := 0;
 I := 1;
 While I <= Length(P) Do Begin
  If (P[I] = '\') Or (P[I] = '/') Then Inc(I)
  Else Begin
   Start := I;
   While (I <= Length(P)) And (P[I] <> '\') And (P[I] <> '/') Do
    Inc(I);
   Sub := Copy(P, Start, I - Start);
   If N < 16 Then Begin
    Parts[N] := Fat_UpStr(Sub);
    Inc(N);
   End;
  End;
 End;
End;

{ Resoudre Cwd + Rel -> chemin absolu (commencant par '\'). Gere
  '.' et '..'. }
Function Fat_AbsPath(Cwd, Rel: String): String;
Var
 Comb: String;
 NParts: Integer;
 Parts: Array[0..15] Of String;
 OutP: String;
 I: Integer;
 NOut: Integer;
 OutParts: Array[0..15] Of String;
Begin
 If (Rel <> '') And ((Rel[1] = '\') Or (Rel[1] = '/')) Then
  Comb := Rel
 Else Begin
  If Cwd = '' Then Cwd := '\';
  If Cwd[Length(Cwd)] = '\' Then Comb := Cwd + Rel
  Else Comb := Cwd + '\' + Rel;
 End;
 Fat_SplitPath(Comb, NParts, Parts);
 NOut := 0;
 For I := 0 To NParts - 1 Do Begin
  If Parts[I] = '.' Then Continue;
  If Parts[I] = '..' Then Begin
   If NOut > 0 Then Dec(NOut);
   Continue;
  End;
  If NOut < 16 Then Begin
   OutParts[NOut] := Parts[I];
   Inc(NOut);
  End;
 End;
 OutP := '\';
 For I := 0 To NOut - 1 Do Begin
  If I > 0 Then OutP := OutP + '\';
  OutP := OutP + OutParts[I];
 End;
 If (Length(OutP) > 1) And (OutP[Length(OutP)] = '\') Then
  OutP := Copy(OutP, 1, Length(OutP) - 1);
 Fat_AbsPath := OutP;
End;

{ Chercher dans le repertoire de cluster StartCl (ou racine si IsRoot)
  une entree de nom NameUp. Si trouve, renvoie True et remplit
  Attr/Cluster/Size. }
Function Fat_FindInDir(Idx: Byte; IsRoot: Boolean; StartCl: LongInt;
 NameUp: String; Var Attr: Byte; Var Cluster: LongInt;
 Var Size: LongInt): Boolean;
Var
 Buf: Array[0..511] Of Byte;
 SecInClu, I: Integer;
 EntName: String;
 Cur: LongInt;
 S: LongInt;
 RootCnt: Integer;
 LBA: LongInt;
Begin
 Fat_FindInDir := False;
 If IsRoot Then Begin
  RootCnt := 0;
  For S := 0 To FatVol[Idx].RootDirSectors - 1 Do Begin
   LBA := FatVol[Idx].RootStart + S;
   If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
   For I := 0 To 15 Do Begin
    If RootCnt >= FatVol[Idx].RootEntries Then Exit;
    Inc(RootCnt);
    If Buf[I * 32] = 0 Then Exit;
    EntName := Fat_EntryName(Buf, I * 32);
    If EntName = '' Then Continue;
    If (Fat_EntryAttr(Buf, I * 32) And $08) <> 0 Then Continue;
    If Fat_UpStr(EntName) = NameUp Then Begin
     Attr    := Fat_EntryAttr(Buf, I * 32);
     Cluster := Fat_EntryCluster(Idx, Buf, I * 32);
     Size    := Fat_EntrySize(Buf, I * 32);
     Fat_FindInDir := True;
     Exit;
    End;
   End;
  End;
 End Else Begin
  Cur := StartCl;
  While (Cur >= 2) And (Not Fat_IsEOC(Idx, Cur)) Do Begin
   For SecInClu := 0 To FatVol[Idx].SectorsPerCluster - 1 Do Begin
    LBA := Fat_ClusterToLBA(Idx, Cur) + SecInClu;
    If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
    For I := 0 To 15 Do Begin
     If Buf[I * 32] = 0 Then Exit;
     EntName := Fat_EntryName(Buf, I * 32);
     If EntName = '' Then Continue;
     If (Fat_EntryAttr(Buf, I * 32) And $08) <> 0 Then Continue;
     If Fat_UpStr(EntName) = NameUp Then Begin
      Attr    := Fat_EntryAttr(Buf, I * 32);
      Cluster := Fat_EntryCluster(Idx, Buf, I * 32);
      Size    := Fat_EntrySize(Buf, I * 32);
      Fat_FindInDir := True;
      Exit;
     End;
    End;
   End;
   Cur := Fat_NextCluster(Idx, Cur);
  End;
 End;
End;

{ Definir IsRoot/StartCl pour designer la racine du volume : secteurs
  fixes (IsRoot=True) pour FAT12/16, ou chaine de clusters a partir de
  RootCluster (IsRoot=False) pour FAT32, ou la racine se traite comme
  n importe quel autre repertoire. }
Procedure Fat_SetRootRef(Idx: Byte; Var IsRoot: Boolean; Var StartCl: LongInt);
Begin
 If FatVol[Idx].FATType = 32 Then Begin
  IsRoot  := False;
  StartCl := FatVol[Idx].RootCluster;
 End Else Begin
  IsRoot  := True;
  StartCl := 0;
 End;
End;

{ Resoudre AbsPath (commencant par '\') vers un descripteur :
  IsRoot=True si racine, sinon StartCl = cluster de depart. Si le
  chemin n existe pas, renvoie False. SkipLast=True : on resout le
  parent et OutName = nom final restant. }
Function Fat_ResolveDir(Idx: Byte; AbsPath: String;
 Var IsRoot: Boolean; Var StartCl: LongInt): Boolean;
Var
 NParts: Integer;
 Parts: Array[0..15] Of String;
 I: Integer;
 Attr: Byte;
 Cluster: LongInt;
 Sz: LongInt;
Begin
 Fat_ResolveDir := False;
 Fat_SetRootRef(Idx, IsRoot, StartCl);
 If Not FatVol[Idx].Mounted Then Exit;
 Fat_SplitPath(AbsPath, NParts, Parts);
 For I := 0 To NParts - 1 Do Begin
  If Not Fat_FindInDir(Idx, IsRoot, StartCl, Parts[I],
   Attr, Cluster, Sz) Then Exit;
  If (Attr And $10) = 0 Then Exit;  { pas un repertoire }
  IsRoot  := False;
  StartCl := Cluster;
  If StartCl < 2 Then Begin
   { ".." sur sous-rep racine -> retourner racine }
   Fat_SetRootRef(Idx, IsRoot, StartCl);
  End;
 End;
 Fat_ResolveDir := True;
End;

{ Resoudre un chemin de fichier : separe parent + nom feuille, puis
  cherche le nom dans le parent. }
Function Fat_FindPath(Idx: Byte; AbsPath: String;
 Var Attr: Byte; Var Cluster: LongInt; Var Size: LongInt): Boolean;
Var
 NParts: Integer;
 Parts: Array[0..15] Of String;
 I: Integer;
 ParentPath, Leaf: String;
 IsRoot: Boolean;
 StartCl: LongInt;
Begin
 Fat_FindPath := False;
 If Not FatVol[Idx].Mounted Then Exit;
 Fat_SplitPath(AbsPath, NParts, Parts);
 If NParts = 0 Then Begin
  Attr := $10;
  Cluster := 0;
  Size := 0;
  Fat_FindPath := True;
  Exit;
 End;
 ParentPath := '\';
 For I := 0 To NParts - 2 Do Begin
  If Length(ParentPath) > 1 Then ParentPath := ParentPath + '\';
  ParentPath := ParentPath + Parts[I];
 End;
 Leaf := Parts[NParts - 1];
 If Not Fat_ResolveDir(Idx, ParentPath, IsRoot, StartCl) Then Exit;
 Fat_FindPath := Fat_FindInDir(Idx, IsRoot, StartCl, Leaf,
  Attr, Cluster, Size);
End;

{ Iterer toutes les entrees d un repertoire (root ou cluster chain)
  et accumuler les noms via TermAddLine pour la commande DIR. }
Procedure Fat_ListDir(Idx: Byte; IsRoot: Boolean; StartCl: LongInt;
 Var TP: TTerminalPanel; Style: Byte);
{ Style : 0 = CMD (date taille nom), 1 = PowerShell }
Var
 Buf: Array[0..511] Of Byte;
 SecInClu, I: Integer;
 EntName, Line, S: String;
 Cur: LongInt;
 S2: LongInt;
 RootCnt: Integer;
 LBA: LongInt;
 Attr: Byte;
 Sz: LongInt;
 T, D: Word;
 Hr, Mn, Yr, Mo, Dy: Word;
 TotalFiles, TotalDirs: LongInt;
 TotalSize: LongInt;
 Done: Boolean;
 EntOff: Integer;
Begin
 TotalFiles := 0;
 TotalDirs  := 0;
 TotalSize  := 0;
 Done := False;
 If IsRoot Then Begin
  RootCnt := 0;
  For S2 := 0 To FatVol[Idx].RootDirSectors - 1 Do Begin
   If Done Then Break;
   LBA := FatVol[Idx].RootStart + S2;
   If Not Fat_ReadSector(Idx, LBA, Buf) Then Break;
   For I := 0 To 15 Do Begin
    If RootCnt >= FatVol[Idx].RootEntries Then Begin
     Done := True; Break;
    End;
    Inc(RootCnt);
    EntOff := I * 32;
    If Buf[EntOff] = 0 Then Begin Done := True; Break; End;
    EntName := Fat_EntryName(Buf, EntOff);
    If EntName = '' Then Continue;
    Attr := Fat_EntryAttr(Buf, EntOff);
    If (Attr And $08) <> 0 Then Continue;
    Sz := Fat_EntrySize(Buf, EntOff);
    T := Fat_LE16(Buf, EntOff + 22);
    D := Fat_LE16(Buf, EntOff + 24);
    Yr := ((D Shr 9) And $7F) + 1980;
    Mo := (D Shr 5) And $0F;
    Dy := D And $1F;
    Hr := (T Shr 11) And $1F;
    Mn := (T Shr 5)  And $3F;
    Line := TermPadZeroLeft(Mo, 2) + '/' +
            TermPadZeroLeft(Dy, 2) + '/' +
            TermPadZeroLeft(Yr, 4) + '  ' +
            TermPadZeroLeft(Hr, 2) + ':' +
            TermPadZeroLeft(Mn, 2) + '    ';
    If (Attr And $10) <> 0 Then Begin
     Line := Line + '<DIR>          ' + EntName;
     Inc(TotalDirs);
    End Else Begin
     Str(Sz, S);
     While Length(S) < 14 Do S := ' ' + S;
     Line := Line + S + ' ' + EntName;
     Inc(TotalFiles);
     Inc(TotalSize, Sz);
    End;
    TermAddLine(TP, Line);
   End;
  End;
 End Else Begin
  Cur := StartCl;
  While (Cur >= 2) And (Not Fat_IsEOC(Idx, Cur)) And (Not Done) Do Begin
   For SecInClu := 0 To FatVol[Idx].SectorsPerCluster - 1 Do Begin
    If Done Then Break;
    LBA := Fat_ClusterToLBA(Idx, Cur) + SecInClu;
    If Not Fat_ReadSector(Idx, LBA, Buf) Then Begin
     Done := True; Break;
    End;
    For I := 0 To 15 Do Begin
     EntOff := I * 32;
     If Buf[EntOff] = 0 Then Begin Done := True; Break; End;
     EntName := Fat_EntryName(Buf, EntOff);
     If EntName = '' Then Continue;
     Attr := Fat_EntryAttr(Buf, EntOff);
     If (Attr And $08) <> 0 Then Continue;
     Sz := Fat_EntrySize(Buf, EntOff);
     T := Fat_LE16(Buf, EntOff + 22);
     D := Fat_LE16(Buf, EntOff + 24);
     Yr := ((D Shr 9) And $7F) + 1980;
     Mo := (D Shr 5) And $0F;
     Dy := D And $1F;
     Hr := (T Shr 11) And $1F;
     Mn := (T Shr 5)  And $3F;
     Line := TermPadZeroLeft(Mo, 2) + '/' +
             TermPadZeroLeft(Dy, 2) + '/' +
             TermPadZeroLeft(Yr, 4) + '  ' +
             TermPadZeroLeft(Hr, 2) + ':' +
             TermPadZeroLeft(Mn, 2) + '    ';
     If (Attr And $10) <> 0 Then Begin
      Line := Line + '<DIR>          ' + EntName;
      Inc(TotalDirs);
     End Else Begin
      Str(Sz, S);
      While Length(S) < 14 Do S := ' ' + S;
      Line := Line + S + ' ' + EntName;
      Inc(TotalFiles);
      Inc(TotalSize, Sz);
     End;
     TermAddLine(TP, Line);
    End;
   End;
   If Done Then Break;
   Cur := Fat_NextCluster(Idx, Cur);
  End;
 End;
 If Style = 0 Then Begin
  Str(TotalFiles, S);
  While Length(S) < 16 Do S := ' ' + S;
  Str(TotalSize, Line);
  While Length(Line) < 14 Do Line := ' ' + Line;
  TermAddLine(TP, S + ' File(s)' + Line + ' bytes');
  Str(TotalDirs, S);
  While Length(S) < 16 Do S := ' ' + S;
  TermAddLine(TP, S + ' Dir(s)');
 End;
End;

{ Lire un fichier (cluster chain) et l afficher ligne par ligne sur
  le terminal. Coupe sur CR/LF. Marque les fichiers binaires (octet
  < 32 hors TAB/CR/LF) par un avertissement et arrete. }
Procedure Fat_TypeFile(Idx: Byte; StartCl: LongInt; Size: LongInt;
 Var TP: TTerminalPanel);
Var
 Buf: Array[0..511] Of Byte;
 Cur: LongInt;
 SecInClu, J: Integer;
 LBA: LongInt;
 Remain: LongInt;
 ToRead: Integer;
 B: Byte;
 Line: String;
 IsBin: Boolean;
Begin
 Cur := StartCl;
 Remain := Size;
 Line := '';
 IsBin := False;
 If (StartCl < 2) Or (Size <= 0) Then Exit;
 While (Cur >= 2) And (Not Fat_IsEOC(Idx, Cur)) And
       (Remain > 0) And (Not IsBin) Do Begin
  For SecInClu := 0 To FatVol[Idx].SectorsPerCluster - 1 Do Begin
   If Remain <= 0 Then Break;
   LBA := Fat_ClusterToLBA(Idx, Cur) + SecInClu;
   If Not Fat_ReadSector(Idx, LBA, Buf) Then Begin
    TermAddLine(TP, 'Erreur de lecture sur l image');
    Exit;
   End;
   If Remain > 512 Then ToRead := 512
                   Else ToRead := Integer(Remain);
   For J := 0 To ToRead - 1 Do Begin
    B := Buf[J];
    Case B Of
     10: Begin
      TermAddLine(TP, Line);
      Line := '';
     End;
     13: ;       { ignore CR }
      9: Begin
      Line := Line + '    ';
     End;
     26: Begin   { EOF DOS }
      If Line <> '' Then TermAddLine(TP, Line);
      Exit;
     End;
    Else
     If B < 32 Then Begin
      IsBin := True;
      Break;
     End;
     If Length(Line) >= 250 Then Begin
      TermAddLine(TP, Line);
      Line := '';
     End;
     Line := Line + Chr(B);
    End;
   End;
   Dec(Remain, ToRead);
   If IsBin Then Break;
  End;
  If IsBin Then Break;
  Cur := Fat_NextCluster(Idx, Cur);
 End;
 If Line <> '' Then TermAddLine(TP, Line);
 If IsBin Then
  TermAddLine(TP, '(fichier binaire : affichage interrompu)');
End;

{ Calcul de l espace libre en octets sur le volume. }
Function Fat_FreeBytes(Idx: Byte): LongInt;
Var
 Cl: LongInt;
 V: LongInt;
 Free: LongInt;
 MaxCl: LongInt;
Begin
 Fat_FreeBytes := 0;
 If Not FatVol[Idx].Mounted Then Exit;
 Free := 0;
 MaxCl := FatVol[Idx].ClusterCount + 1;
 For Cl := 2 To MaxCl Do Begin
  V := Fat_NextCluster(Idx, Cl);
  If V = 0 Then Inc(Free);
 End;
 Fat_FreeBytes := Free * LongInt(FatVol[Idx].SectorsPerCluster) * 512;
End;

{ --- Lister le repertoire d une image .D64 dans le terminal --- }

Procedure D64_ListDir(Idx: Byte; Var TP: TTerminalPanel);
Var
 Buf: Array[0..255] Of Byte;
 NextT, NextS: Byte;
 BAM: Array[0..255] Of Byte;
 E, I, FreeBlk: Integer;
 Name: String;
 Blocks: Word;
 Kind: Byte;
 KFlag: Char;
 KStr: String;
 Line, S: String;
Begin
 If Not FatVol[Idx].Mounted Then Exit;
 If Not FatVol[Idx].IsD64 Then Exit;
 If Not D64_ReadSector(Idx, 18, 0, BAM) Then Exit;
 { Entete : titre du disque + ID + DOS type }
 Name := '"';
 For I := 0 To 15 Do
  Name := Name + D64_PetsciiToAscii(BAM[144 + I]);
 { Trim trailing $A0 padding (deja converti en espaces) }
 While (Length(Name) > 1) And (Name[Length(Name)] = ' ') Do
  Name := Copy(Name, 1, Length(Name) - 1);
 Name := Name + '"';
 S := '';
 For I := 0 To 1 Do S := S + D64_PetsciiToAscii(BAM[162 + I]);
 Line := '0 ' + Name + ' ' + S + ' ';
 For I := 0 To 1 Do Line := Line + D64_PetsciiToAscii(BAM[165 + I]);
 TermAddLine(TP, Line);
 { Parcourir la chaine du repertoire a partir de l entree dans le BAM
   (offsets 0/1 = piste/secteur du premier secteur de directory). Les
   images standard pointent vers 18:1. }
 NextT := BAM[0];
 NextS := BAM[1];
 If (NextT = 0) Or (NextT > 40) Then Begin
  NextT := 18;
  NextS := 1;
 End;
 While (NextT <> 0) And D64_ReadSector(Idx, NextT, NextS, Buf) Do Begin
  NextT := Buf[0];
  NextS := Buf[1];
  For E := 0 To 7 Do Begin
   I := 2 + E * 32;
   Kind := Buf[I];
   If Kind = 0 Then Continue;
   { Nom : 16 octets en PETSCII (terminateur $A0 + padding) }
   Name := '"';
   FreeBlk := 0;
   While (FreeBlk < 16) And (Buf[I + 3 + FreeBlk] <> $A0) Do Begin
    Name := Name + D64_PetsciiToAscii(Buf[I + 3 + FreeBlk]);
    Inc(FreeBlk);
   End;
   Name := Name + '"';
   Blocks := Word(Buf[I + 28]) Or (Word(Buf[I + 29]) Shl 8);
   KStr := D64_KindName[Kind And 15];
   If (Kind And $80) <> 0 Then KFlag := ' ' Else KFlag := '*';
   Str(Blocks, S);
   While Length(S) < 4 Do S := ' ' + S;
   TermAddLine(TP, S + ' ' + Name + ' ' + KFlag + ' ' + KStr);
  End;
 End;
 { Blocks libres = somme des compteurs FAT (offsets 4, 8, 12, ...) }
 FreeBlk := 0;
 For I := 1 To 35 Do Inc(FreeBlk, BAM[4 + (I - 1) * 4]);
 Str(FreeBlk, S);
 TermAddLine(TP, S + ' BLOCKS FREE.');
End;

{ Parcourt la chaine de secteurs de donnees d un fichier D64 a partir de   }
{ StartTrack/StartSector et copie les octets dans OutBuf (jusqu a            }
{ MaxSize octets) - meme convention 1541 que D64_ListDir : un secteur       }
{ non terminal fournit ses 254 octets utiles (Buf[2..255]), le secteur      }
{ terminal est signale par Buf[0]=0 et Buf[1]=index du dernier octet          }
{ valide. Partagee par la visionneuse F3 (NCCmd_ViewD64File) et             }
{ l extraction vers un fichier hote temporaire (D64_ExtractToTempFile). --- }
Procedure D64_ReadFileChain(Slot: Byte; StartTrack, StartSector: Byte;
 Var OutBuf: Array Of Byte; MaxSize: LongInt; Var OutSize: LongInt);
Var
 Buf: Array[0..255] Of Byte;
 NextT, NextS: Byte;
 N, Cnt, I, Safety: Integer;
Begin
 OutSize := 0;
 NextT := StartTrack;
 NextS := StartSector;
 Safety := 0;
 While (NextT <> 0) And (Safety < 800) Do Begin
  { 800 > nombre total de secteurs d une image 40 pistes (768, le maximum }
  { supporte) : garde-fou anti-boucle infinie si l image est corrompue        }
  { (chaine circulaire), sans jamais tronquer un fichier legitime. }
  Inc(Safety);
  If Not D64_ReadSector(Slot, NextT, NextS, Buf) Then Break;
  If Buf[0] = 0 Then Begin
   N := Buf[1];
   If N < 2 Then Cnt := 0 Else Cnt := N - 1;
   For I := 0 To Cnt - 1 Do
    If OutSize < MaxSize Then Begin
     OutBuf[OutSize] := Buf[2 + I];
     Inc(OutSize);
    End;
   NextT := 0;
  End Else Begin
   For I := 0 To 253 Do
    If OutSize < MaxSize Then Begin
     OutBuf[OutSize] := Buf[2 + I];
     Inc(OutSize);
    End;
   NextT := Buf[0];
   NextS := Buf[1];
  End;
 End;
End;

{ Cherche dans le repertoire (a plat) de l image D64 montee sur Slot une   }
{ entree de type PRG (seul type executable directement lancable) dont le  }
{ nom decode correspond a BaseNoExt (comparaison insensible a la casse,    }
{ comme TermFindDosExecutable pour le disque hote). Renvoie la piste/          }
{ secteur du 1er bloc de donnees si trouvee. --- }
Function D64_FindPrgEntry(Slot: Byte; Const BaseNoExt: String;
 Var Track, Sector: Byte): Boolean;
Var
 Buf: Array[0..255] Of Byte;
 NextT, NextS: Byte;
 E, I, EntOff: Integer;
 Kind: Byte;
 Name: String;
 UpBase: String;
Begin
 D64_FindPrgEntry := False;
 If Not FatVol[Slot].Mounted Then Exit;
 If Not FatVol[Slot].IsD64 Then Exit;
 If Not D64_ReadSector(Slot, 18, 0, Buf) Then Exit;
 UpBase := UpCaseStr(BaseNoExt);
 NextT := Buf[0];
 NextS := Buf[1];
 If (NextT = 0) Or (NextT > 40) Then Begin
  NextT := 18;
  NextS := 1;
 End;
 While (NextT <> 0) And D64_ReadSector(Slot, NextT, NextS, Buf) Do Begin
  NextT := Buf[0];
  NextS := Buf[1];
  For E := 0 To 7 Do Begin
   EntOff := 2 + E * 32;
   Kind := Buf[EntOff];
   If Kind = 0 Then Continue;
   If (Kind And 15) <> 2 Then Continue; { seul PRG (2) est executable }
   Name := '';
   I := 0;
   While (I < 16) And (Buf[EntOff + 3 + I] <> $A0) Do Begin
    Name := Name + D64_PetsciiToAscii(Buf[EntOff + 3 + I]);
    Inc(I);
   End;
   If UpCaseStr(Name) = UpBase Then Begin
    Track := Buf[EntOff + 1];
    Sector := Buf[EntOff + 2];
    D64_FindPrgEntry := True;
    Exit;
   End;
  End;
 End;
End;

{ Extrait un fichier PRG d une image D64 montee vers un fichier hote       }
{ temporaire (necessaire car les chargeurs d emulateur - CPU6502_LoadC64Prg }
{ - lisent toujours un chemin hote reel, jamais un tampon memoire) et       }
{ renvoie ce chemin dans OutPath. Ecrit secteur par secteur directement     }
{ sur disque (meme parcours de chaine que D64_ReadFileChain, mais sans     }
{ tampon intermediaire pour tout le fichier - inutile de garder jusqu a     }
{ ~197 Ko en memoire alors que D64_ReadSector lit deja secteur par           }
{ secteur). Le fichier temporaire est ecrase a chaque appel (nom fixe)     }
{ plutot que d accumuler des fichiers orphelins. --- }
Function D64_ExtractToTempFile(Slot: Byte; StartTrack, StartSector: Byte;
 Var OutPath: String): Boolean;
Var
 Buf: Array[0..255] Of Byte;
 NextT, NextS: Byte;
 N, Cnt, Safety: Integer;
 F: File;
 BW: Word;
 TotalWritten: LongInt;
Begin
 D64_ExtractToTempFile := False;
 OutPath := GetEnv('TEMP');
 If OutPath = '' Then OutPath := '.';
 If OutPath[Length(OutPath)] <> '\' Then OutPath := OutPath + '\';
 OutPath := OutPath + 'DEVENV_NC_D64.PRG';
 {$I-}
 Assign(F, OutPath);
 Rewrite(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 TotalWritten := 0;
 NextT := StartTrack;
 NextS := StartSector;
 Safety := 0;
 While (NextT <> 0) And (Safety < 800) Do Begin
  { 800 > nombre total de secteurs d une image 40 pistes (768) : garde-fou }
  { anti-boucle infinie si l image est corrompue. }
  Inc(Safety);
  If Not D64_ReadSector(Slot, NextT, NextS, Buf) Then Break;
  If Buf[0] = 0 Then Begin
   N := Buf[1];
   If N < 2 Then Cnt := 0 Else Cnt := N - 1;
   If Cnt > 0 Then Begin
    BlockWrite(F, Buf[2], Cnt, BW);
    Inc(TotalWritten, BW);
   End;
   NextT := 0;
  End Else Begin
   BlockWrite(F, Buf[2], 254, BW);
   Inc(TotalWritten, BW);
   NextT := Buf[0];
   NextS := Buf[1];
  End;
 End;
 Close(F);
 D64_ExtractToTempFile := (TotalWritten > 0);
End;

{ ============================================================
  ECRITURE FAT12/16 (creation de fichier dans une image montee)
  ============================================================ }

Function Fat_WriteSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean;
Begin
 Fat_WriteSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If LBA < 0 Then Exit;
 If Not Emu_ImageWriteSector(Idx, FatVol[Idx].PartitionStart + LBA, Buf) Then
  Exit;
 { Invalider le cache FAT si on ecrit sur le LBA cache }
 If LBA = FatVol[Idx].CachedFatLBA Then
  FatVol[Idx].CachedFatLBA := -1;
 Fat_WriteSector := True;
End;

{ Modifier un octet de la FAT et repercuter sur toutes les copies. }
Function Fat_FATWriteByte(Idx: Byte; Offset: LongInt;
 Val: Byte): Boolean;
Var
 Buf: Array[0..511] Of Byte;
 K: Integer;
 LBA, BaseLBA: LongInt;
 Within: Word;
Begin
 Fat_FATWriteByte := False;
 BaseLBA := FatVol[Idx].FATStart + (Offset Div 512);
 Within  := Word(Offset Mod 512);
 If Not Fat_ReadSector(Idx, BaseLBA, Buf) Then Exit;
 Buf[Within] := Val;
 For K := 0 To FatVol[Idx].NumFATs - 1 Do Begin
  LBA := BaseLBA + LongInt(K) * FatVol[Idx].SectorsPerFAT;
  If Not Fat_WriteSector(Idx, LBA, Buf) Then Exit;
 End;
 Fat_FATWriteByte := True;
End;

{ Ecrire la valeur 12 ou 16 bits dans la FAT pour le cluster Cl. }
Function Fat_SetNextCluster(Idx: Byte; Cl, Val: LongInt): Boolean;
Var
 O: LongInt;
 B1, B2: Byte;
Begin
 Fat_SetNextCluster := False;
 If FatVol[Idx].FATType = 12 Then Begin
  O := Cl + (Cl Div 2);
  B1 := Fat_FATByte(Idx, O);
  B2 := Fat_FATByte(Idx, O + 1);
  If (Cl And 1) = 0 Then Begin
   B1 := Byte(Val And $FF);
   B2 := Byte((B2 And $F0) Or ((Val Shr 8) And $0F));
  End Else Begin
   B1 := Byte((B1 And $0F) Or ((Val Shl 4) And $F0));
   B2 := Byte((Val Shr 4) And $FF);
  End;
  If Not Fat_FATWriteByte(Idx, O, B1) Then Exit;
  If Not Fat_FATWriteByte(Idx, O + 1, B2) Then Exit;
 End Else If FatVol[Idx].FATType = 32 Then Begin
  O := Cl * 4;
  Val := Val And $0FFFFFFF;
  If Not Fat_FATWriteByte(Idx, O, Byte(Val And $FF)) Then Exit;
  If Not Fat_FATWriteByte(Idx, O + 1, Byte((Val Shr 8) And $FF)) Then Exit;
  If Not Fat_FATWriteByte(Idx, O + 2, Byte((Val Shr 16) And $FF)) Then Exit;
  { Les 4 bits hauts (reserves) du 4e octet sont preserves. }
  If Not Fat_FATWriteByte(Idx, O + 3,
   Byte((Fat_FATByte(Idx, O + 3) And $F0) Or
        ((Val Shr 24) And $0F))) Then Exit;
 End Else Begin
  O := Cl * 2;
  If Not Fat_FATWriteByte(Idx, O, Byte(Val And $FF)) Then Exit;
  If Not Fat_FATWriteByte(Idx, O + 1,
   Byte((Val Shr 8) And $FF)) Then Exit;
 End;
 Fat_SetNextCluster := True;
End;

{ Trouver un cluster libre et le marquer EOC. Renvoie 0 si plein. }
Function Fat_AllocCluster(Idx: Byte): LongInt;
Var
 Cl: LongInt;
 EOC: LongInt;
Begin
 Fat_AllocCluster := 0;
 If FatVol[Idx].FATType = 12 Then EOC := $0FFF
 Else If FatVol[Idx].FATType = 32 Then EOC := $0FFFFFFF
 Else EOC := $FFFF;
 For Cl := 2 To FatVol[Idx].ClusterCount + 1 Do
  If Fat_NextCluster(Idx, Cl) = 0 Then Begin
   If Fat_SetNextCluster(Idx, Cl, EOC) Then
    Fat_AllocCluster := Cl;
   Exit;
  End;
End;

{ Convertir un nom en 11 octets 8.3 (espaces pad). Tronque base a 8 et
  extension a 3 si necessaire. Retourne False si caracteres invalides. }
Function Fat_MakeName11(Name: String;
 Var N11: Array Of Byte): Boolean;
Var
 I, DotPos: Integer;
 Base, Ext: String;
 C: Char;
Begin
 Fat_MakeName11 := False;
 Name := Fat_UpStr(Name);
 If Length(Name) = 0 Then Exit;
 DotPos := 0;
 For I := Length(Name) DownTo 1 Do
  If Name[I] = '.' Then Begin DotPos := I; Break; End;
 If DotPos = 0 Then Begin
  Base := Name; Ext := '';
 End Else Begin
  Base := Copy(Name, 1, DotPos - 1);
  Ext  := Copy(Name, DotPos + 1, Length(Name) - DotPos);
 End;
 If Length(Base) = 0 Then Exit;
 If Length(Base) > 8 Then Base := Copy(Base, 1, 8);
 If Length(Ext)  > 3 Then Ext  := Copy(Ext,  1, 3);
 For I := 0 To 10 Do N11[I] := Ord(' ');
 For I := 1 To Length(Base) Do N11[I - 1] := Ord(Base[I]);
 For I := 1 To Length(Ext)  Do N11[8 + I - 1] := Ord(Ext[I]);
 For I := 0 To 10 Do Begin
  C := Chr(N11[I]);
  If (N11[I] < 32) Or (C = '"') Or (C = '*') Or (C = '+') Or
     (C = ',') Or (C = '/') Or (C = ':') Or (C = ';') Or
     (C = '<') Or (C = '=') Or (C = '>') Or (C = '?') Or
     (C = '[') Or (C = '\') Or (C = ']') Or (C = '|') Then Exit;
 End;
 Fat_MakeName11 := True;
End;

{ Trouver un slot libre dans un repertoire (root ou cluster chain). }
Function Fat_FindFreeSlot(Idx: Byte; IsRoot: Boolean; StartCl: LongInt;
 Var SlotLBA: LongInt; Var SlotIdx: Integer): Boolean;
Var
 Buf: Array[0..511] Of Byte;
 SecInClu, I: Integer;
 Cur: LongInt;
 S: LongInt;
 RootCnt: Integer;
 LBA: LongInt;
 B0: Byte;
Begin
 Fat_FindFreeSlot := False;
 If IsRoot Then Begin
  RootCnt := 0;
  For S := 0 To FatVol[Idx].RootDirSectors - 1 Do Begin
   LBA := FatVol[Idx].RootStart + S;
   If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
   For I := 0 To 15 Do Begin
    If RootCnt >= FatVol[Idx].RootEntries Then Exit;
    Inc(RootCnt);
    B0 := Buf[I * 32];
    If (B0 = 0) Or (B0 = $E5) Then Begin
     SlotLBA := LBA;
     SlotIdx := I;
     Fat_FindFreeSlot := True;
     Exit;
    End;
   End;
  End;
 End Else Begin
  Cur := StartCl;
  While (Cur >= 2) And (Not Fat_IsEOC(Idx, Cur)) Do Begin
   For SecInClu := 0 To FatVol[Idx].SectorsPerCluster - 1 Do Begin
    LBA := Fat_ClusterToLBA(Idx, Cur) + SecInClu;
    If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
    For I := 0 To 15 Do Begin
     B0 := Buf[I * 32];
     If (B0 = 0) Or (B0 = $E5) Then Begin
      SlotLBA := LBA;
      SlotIdx := I;
      Fat_FindFreeSlot := True;
      Exit;
     End;
    End;
   End;
   Cur := Fat_NextCluster(Idx, Cur);
  End;
 End;
End;

{ Ecrire une entree 32 octets dans le slot indique. }
Function Fat_WriteDirEntry(Idx: Byte; LBA: LongInt; SlotIdx: Integer;
 Var N11: Array Of Byte; Attr: Byte; FirstClu: LongInt;
 Size: LongInt): Boolean;
Var
 Buf: Array[0..511] Of Byte;
 Off, I: Integer;
Begin
 Fat_WriteDirEntry := False;
 If Not Fat_ReadSector(Idx, LBA, Buf) Then Exit;
 Off := SlotIdx * 32;
 For I := 0 To 10 Do Buf[Off + I] := N11[I];
 Buf[Off + 11] := Attr;
 For I := 12 To 19 Do Buf[Off + I] := 0;
 { Offset 20-21 : 16 bits de poids fort du cluster (FAT32 seulement ;
   toujours 0 pour FAT12/16 puisque FirstClu < 65536). }
 Buf[Off + 20] := Byte((FirstClu Shr 16) And $FF);
 Buf[Off + 21] := Byte((FirstClu Shr 24) And $FF);
 Buf[Off + 22] := 0; Buf[Off + 23] := 0;   { time }
 Buf[Off + 24] := 0; Buf[Off + 25] := 0;   { date }
 Buf[Off + 26] := Byte(FirstClu And $FF);
 Buf[Off + 27] := Byte((FirstClu Shr 8) And $FF);
 Buf[Off + 28] := Byte(Size And $FF);
 Buf[Off + 29] := Byte((Size Shr 8) And $FF);
 Buf[Off + 30] := Byte((Size Shr 16) And $FF);
 Buf[Off + 31] := Byte((Size Shr 24) And $FF);
 Fat_WriteDirEntry := Fat_WriteSector(Idx, LBA, Buf);
End;

{ Creer un fichier dans le repertoire AbsParent du disque virtuel Idx,
  avec le nom Leaf (8.3), en lisant les donnees depuis SrcPath (hote).
  Retourne False et remplit ErrMsg en cas d echec. }
Function Fat_WriteFileFromHost(Idx: Byte; AbsParent, Leaf: String;
 SrcPath: String; Var ErrMsg: String): Boolean;
Var
 IsRoot: Boolean;
 StartCl: LongInt;
 N11: Array[0..10] Of Byte;
 Attr: Byte;
 ExClu: LongInt;
 ExSize: LongInt;
 SrcF: File;
 BR: Word;
 ClusterSize: LongInt;
 ClBuf: Array[0..4095] Of Byte;
 FirstClu, PrevClu, NewClu: LongInt;
 SlotLBA: LongInt;
 SlotIdx: Integer;
 TotalSize: LongInt;
 SecInClu: Integer;
 LBA: LongInt;
 SecBuf: Array[0..511] Of Byte;
 J: Integer;
Begin
 Fat_WriteFileFromHost := False;
 ErrMsg := '';
 If Not FatVol[Idx].Mounted Then Begin
  ErrMsg := 'Disque virtuel non monte';
  Exit;
 End;
 ClusterSize := LongInt(FatVol[Idx].SectorsPerCluster) * 512;
 If (ClusterSize <= 0) Or (ClusterSize > 4096) Then Begin
  ErrMsg := 'Taille de cluster non supportee';
  Exit;
 End;
 If Not Fat_MakeName11(Leaf, N11) Then Begin
  ErrMsg := 'Nom de fichier 8.3 invalide : ' + Leaf;
  Exit;
 End;
 If Not Fat_ResolveDir(Idx, AbsParent, IsRoot, StartCl) Then Begin
  ErrMsg := 'Repertoire introuvable : ' + AbsParent;
  Exit;
 End;
 If Fat_FindInDir(Idx, IsRoot, StartCl, Fat_UpStr(Leaf), Attr,
  ExClu, ExSize) Then Begin
  ErrMsg := 'Le fichier existe deja : ' + Leaf;
  Exit;
 End;
 Assign(SrcF, SrcPath);
 {$I-} Reset(SrcF, 1); {$I+}
 If IOResult <> 0 Then Begin
  ErrMsg := 'Source hote introuvable : ' + SrcPath;
  Exit;
 End;
 FirstClu := 0;
 PrevClu := 0;
 TotalSize := 0;
 Repeat
  FillChar(ClBuf, ClusterSize, 0);
  BR := 0;
  {$I-} BlockRead(SrcF, ClBuf, ClusterSize, BR); {$I+}
  If IOResult <> 0 Then Begin
   ErrMsg := 'Erreur de lecture sur l hote';
   Close(SrcF);
   Exit;
  End;
  If BR = 0 Then Break;
  NewClu := Fat_AllocCluster(Idx);
  If NewClu = 0 Then Begin
   ErrMsg := 'Disque virtuel plein';
   Close(SrcF);
   Exit;
  End;
  If FirstClu = 0 Then FirstClu := NewClu
  Else If Not Fat_SetNextCluster(Idx, PrevClu, NewClu) Then Begin
   ErrMsg := 'Erreur d ecriture FAT';
   Close(SrcF);
   Exit;
  End;
  PrevClu := NewClu;
  For SecInClu := 0 To FatVol[Idx].SectorsPerCluster - 1 Do Begin
   LBA := Fat_ClusterToLBA(Idx, NewClu) + SecInClu;
   For J := 0 To 511 Do SecBuf[J] := ClBuf[SecInClu * 512 + J];
   If Not Fat_WriteSector(Idx, LBA, SecBuf) Then Begin
    ErrMsg := 'Erreur d ecriture des donnees';
    Close(SrcF);
    Exit;
   End;
  End;
  Inc(TotalSize, BR);
 Until BR < Word(ClusterSize);
 Close(SrcF);
 If Not Fat_FindFreeSlot(Idx, IsRoot, StartCl, SlotLBA, SlotIdx) Then
 Begin
  ErrMsg := 'Repertoire plein';
  Exit;
 End;
 If Not Fat_WriteDirEntry(Idx, SlotLBA, SlotIdx, N11, $20,
  FirstClu, TotalSize) Then Begin
  ErrMsg := 'Erreur d ecriture de l entree repertoire';
  Exit;
 End;
 Fat_WriteFileFromHost := True;
End;

{ Construire le chemin "X:\..." courant du terminal sur le disque virtuel }
{ Correspondance lettre de lecteur <-> index FatVol/EmuFloppy* :
  A:=0 B:=1 (disquettes /DISK0//DISK1), C:=2 D:=3 (disques durs
  /DISK80//DISK81). }
Function Term_DriveLetterFromIdx(Idx: Byte): Char;
Begin
 Case Idx Of
  0: Term_DriveLetterFromIdx := 'A';
  1: Term_DriveLetterFromIdx := 'B';
  2: Term_DriveLetterFromIdx := 'C';
  3: Term_DriveLetterFromIdx := 'D';
 Else
  Term_DriveLetterFromIdx := '?';
 End;
End;

Function Term_DriveIdxFromLetter(DL: Char; Var Idx: Byte): Boolean;
Begin
 Term_DriveIdxFromLetter := True;
 Case UpCase(DL) Of
  'A': Idx := 0;
  'B': Idx := 1;
  'C': Idx := 2;
  'D': Idx := 3;
 Else
  Term_DriveIdxFromLetter := False;
 End;
End;

Function Term_VirtFullPath(Var TP: TTerminalPanel): String;
Var
 DL: Char;
Begin
 If TP.VirtDrive >= 0 Then DL := Term_DriveLetterFromIdx(TP.VirtDrive)
                       Else DL := '?';
 If (TP.VirtCwd = '') Or (TP.VirtCwd = '\') Then
  Term_VirtFullPath := DL + ':\'
 Else
  Term_VirtFullPath := DL + ':' + TP.VirtCwd;
End;

{ Tenter de monter le volume si pas deja fait (lazy). }
Procedure Term_VirtEnsureMounted(Idx: Byte);
Begin
 If EmuFloppyOpen[Idx] And (Not FatVol[Idx].Mounted) Then Begin
  Fat_TryMount(Idx);
  Fat_FindVolLabel(Idx);
 End;
End;

{ Resoudre une cible (eventuellement prefixee A:/B:) en mode virtuel.
  Retourne True si la cible designe une unite FAT montee, et remplit
  Idx + AbsP (chemin absolu sur ce volume). P peut etre vide. }
Function Term_ResolveVirtTarget(Var TP: TTerminalPanel; P: String;
 Var Idx: Byte; Var AbsP: String): Boolean;
Var
 DL: Char;
 Rest: String;
 TIdx: Byte;
 HasColon: Boolean;
Begin
 Term_ResolveVirtTarget := False;
 HasColon := (Length(P) >= 2) And (P[2] = ':');
 If HasColon Then Begin
  DL := UpCase(P[1]);
  Rest := Copy(P, 3, Length(P) - 2);
  If Not Term_DriveIdxFromLetter(DL, TIdx) Then Exit;
  Term_VirtEnsureMounted(TIdx);
  If Not FatVol[TIdx].Mounted Then Exit;
  Idx := TIdx;
  If Rest = '' Then Begin
   { "A:" tout court : si TP est deja sur ce lecteur,
     utiliser le cwd virtuel ; sinon racine. }
   If TP.VirtDrive = Idx Then AbsP := TP.VirtCwd
                          Else AbsP := '\';
  End Else If Rest[1] = '\' Then Begin
   AbsP := Rest;
  End Else Begin
   { "A:foo" : relatif au cwd si meme lecteur, sinon a la racine. }
   If TP.VirtDrive = Idx Then AbsP := Fat_AbsPath(TP.VirtCwd, Rest)
                          Else AbsP := Fat_AbsPath('\', Rest);
  End;
  Term_ResolveVirtTarget := True;
  Exit;
 End;
 If TP.VirtDrive >= 0 Then Begin
  Idx := TP.VirtDrive;
  If P = '' Then AbsP := TP.VirtCwd
            Else AbsP := Fat_AbsPath(TP.VirtCwd, P);
  Term_ResolveVirtTarget := True;
 End;
End;

{ --- Copie de fichier interne (supporte disques virtuels) --- }

Function TermCopyFile(Var TP: TTerminalPanel;
 Source, Target: String): Boolean;
Var
 SourceFile, TargetFile: File;
 RecordsRead: Integer;
 Buffer: Array[1..1000] Of Byte;
 SrcIdx, DstIdx: Byte;
 SrcAbs, DstAbs: String;
 SrcIsVirt, DstIsVirt: Boolean;
 Attr: Byte;
 SrcCluster: LongInt;
 SrcSize: LongInt;
 Cur: LongInt;
 SecInClu, BaseSlash, I: Integer;
 LBA, Remain: LongInt;
 ToRead: Integer;
 SBuf: Array[0..511] Of Byte;
 TLast: Char;
 ParentAbs, Leaf: String;
 ErrMsg: String;
 DstIsDir: Boolean;
 DummyAttr: Byte;
 DummyClu: LongInt;
 DummySz: LongInt;
 SrcBase: String;
Begin
 TermCopyFile := False;
 { Si la cible se termine par ':' ou '\\' ou '/', ajouter le nom de
   base de la source pour conserver le nom du fichier. }
 If Length(Target) > 0 Then Begin
  TLast := Target[Length(Target)];
  If (TLast = ':') Or (TLast = '\') Or (TLast = '/') Then Begin
   BaseSlash := 0;
   For I := Length(Source) DownTo 1 Do
    If (Source[I] = '\') Or (Source[I] = '/') Or
       (Source[I] = ':') Then Begin
     BaseSlash := I;
     Break;
    End;
   Target := Target + Copy(Source, BaseSlash + 1,
    Length(Source) - BaseSlash);
  End;
 End;
 { Determiner si source/cible sont sur un disque virtuel }
 SrcIsVirt := Term_ResolveVirtTarget(TP, Source, SrcIdx, SrcAbs);
 DstIsVirt := Term_ResolveVirtTarget(TP, Target, DstIdx, DstAbs);
 { ---- Cible sur disque virtuel : ecriture FAT ---- }
 If DstIsVirt Then Begin
  If SrcIsVirt Then Begin
   TermAddLine(TP,
    'Copie virtuel -> virtuel non supportee pour l instant.');
   Exit;
  End;
  { Si la cible designe un repertoire (racine, '.', '..' ou entree
    FAT avec attr repertoire), ajouter le basename de la source. }
  DstIsDir := (DstAbs = '') Or (DstAbs = '\');
  If Not DstIsDir Then
   If Fat_FindPath(DstIdx, DstAbs, DummyAttr, DummyClu, DummySz) Then
    DstIsDir := (DummyAttr And $10) <> 0;
  If DstIsDir Then Begin
   BaseSlash := 0;
   For I := Length(Source) DownTo 1 Do
    If (Source[I] = '\') Or (Source[I] = '/') Or
       (Source[I] = ':') Then Begin
     BaseSlash := I;
     Break;
    End;
   SrcBase := Copy(Source, BaseSlash + 1,
    Length(Source) - BaseSlash);
   If SrcBase = '' Then Begin
    TermAddLine(TP, 'Nom de fichier cible manquant.');
    Exit;
   End;
   If (DstAbs = '') Or (DstAbs = '\') Then DstAbs := '\' + SrcBase
   Else DstAbs := DstAbs + '\' + SrcBase;
  End;
  { Decouper DstAbs en parent + feuille }
  ParentAbs := '\';
  Leaf := '';
  For I := Length(DstAbs) DownTo 1 Do
   If DstAbs[I] = '\' Then Begin
    If I = 1 Then ParentAbs := '\'
             Else ParentAbs := Copy(DstAbs, 1, I - 1);
    Leaf := Copy(DstAbs, I + 1, Length(DstAbs) - I);
    Break;
   End;
  If Leaf = '' Then Begin
   TermAddLine(TP, 'Nom de fichier cible manquant.');
   Exit;
  End;
  If Fat_WriteFileFromHost(DstIdx, ParentAbs, Leaf, Source,
   ErrMsg) Then Begin
   TermCopyFile := True;
   Exit;
  End;
  TermAddLine(TP, ErrMsg);
  Exit;
 End;
 { ---- Source sur disque virtuel : lecture via FAT ---- }
 If SrcIsVirt Then Begin
  If Not Fat_FindPath(SrcIdx, SrcAbs, Attr, SrcCluster, SrcSize) Then
  Begin
   TermAddLine(TP, 'Fichier source introuvable : ' + Source);
   Exit;
  End;
  If (Attr And $10) <> 0 Then Begin
   TermAddLine(TP, Source + ' est un repertoire.');
   Exit;
  End;
  Assign(TargetFile, Target);
  {$I-} Rewrite(TargetFile, 1); {$I+}
  If IOResult <> 0 Then Begin
   TermAddLine(TP, 'Impossible de creer : ' + Target);
   Exit;
  End;
  Cur := SrcCluster;
  Remain := SrcSize;
  While (Cur >= 2) And (Not Fat_IsEOC(SrcIdx, Cur)) And
        (Remain > 0) Do Begin
   For SecInClu := 0 To FatVol[SrcIdx].SectorsPerCluster - 1 Do Begin
    If Remain <= 0 Then Break;
    LBA := Fat_ClusterToLBA(SrcIdx, Cur) + SecInClu;
    If Not Fat_ReadSector(SrcIdx, LBA, SBuf) Then Begin
     TermAddLine(TP, 'Erreur de lecture sur l image');
     Close(TargetFile);
     Exit;
    End;
    If Remain > 512 Then ToRead := 512
                    Else ToRead := Integer(Remain);
    {$I-} BlockWrite(TargetFile, SBuf, ToRead); {$I+}
    If IOResult <> 0 Then Begin
     TermAddLine(TP, 'Erreur d ecriture : ' + Target);
     Close(TargetFile);
     Exit;
    End;
    Dec(Remain, ToRead);
   End;
   Cur := Fat_NextCluster(SrcIdx, Cur);
  End;
  Close(TargetFile);
  TermCopyFile := True;
  Exit;
 End;
 { Cas hote -> hote }
 Assign(SourceFile, Source);
 {$I-} Reset(SourceFile, 1); {$I+}
 If IOResult <> 0 Then Begin
  TermAddLine(TP, 'Fichier source introuvable : ' + Source);
  Exit;
 End;
 Assign(TargetFile, Target);
 {$I-} Rewrite(TargetFile, 1);
 BlockRead(SourceFile, Buffer, SizeOf(Buffer), RecordsRead);
 While RecordsRead > 0 Do Begin
  BlockWrite(TargetFile, Buffer, RecordsRead);
  BlockRead(SourceFile, Buffer, SizeOf(Buffer), RecordsRead);
 End;
 Close(SourceFile);
 Close(TargetFile);
 {$I+}
 TermCopyFile := True;
End;

{ ============================================================
  COMMANDES INTERNES DU TERMINAL
  ============================================================ }

{ --- CD / CHDIR / SET-LOCATION --- }

Procedure TermCmd_CD(Var TP: TTerminalPanel; ParamStr: String);
Var
 Err: Word;
 FirstParam, Dir, AbsP: String;
 IsRoot: Boolean;
 StartCl: LongInt;
 Idx: Byte;
Begin
 FirstParam := TermExtractParam(ParamStr, 1);
 { Mode disque virtuel : naviguer dans le FAT image }
 If TP.VirtDrive >= 0 Then Begin
  Idx := TP.VirtDrive;
  If Length(FirstParam) = 0 Then Begin
   TermAddLine(TP, Term_VirtFullPath(TP));
   Exit;
  End;
  { Si le parametre contient un lecteur (X:), on bascule. }
  If (Length(FirstParam) >= 2) And (FirstParam[2] = ':') Then Begin
   { Bascule de lecteur dans CD : seulement informer si X: != A: ou B: }
   TermAddLine(TP,
    'CD inter-lecteur non supporte ; utiliser X: directement.');
   Exit;
  End;
  AbsP := Fat_AbsPath(TP.VirtCwd, FirstParam);
  If Not Fat_ResolveDir(Idx, AbsP, IsRoot, StartCl) Then Begin
   TermAddLine(TP,
    'Le systeme ne trouve pas le chemin specifie.');
   Exit;
  End;
  TP.VirtCwd := AbsP;
  Exit;
 End;
 If Length(FirstParam) > 0 Then Begin
  {$I-} ChDir(FirstParam); {$I+}
  Err := IOResult;
  If Err <> 0 Then
   TermAddLine(TP, TermGetErrorMessage(Err))
  Else Begin
   GetDir(0, Dir);
   TermAddLine(TP, Dir);
  End;
 End Else Begin
  GetDir(0, Dir);
  TermAddLine(TP, Dir);
 End;
End;

{ --- CLS / CLEAR-HOST --- }

Procedure TermCmd_CLS(Var TP: TTerminalPanel);
Var
 I: Integer;
 N, NN: PTermLine;
Begin
 For I := 0 To MAX_TERM_LINES - 1 Do
  TP.Lines[I] := '';
 TP.LineCount := 0;
 TP.ScrollTop := 0;
 { Liberer la liste chainee }
 N := TP.HistHead;
 While N <> Nil Do Begin
  NN := N^.Next;
  Dispose(N);
  N := NN;
 End;
 TP.HistHead := Nil;
 TP.HistTail := Nil;
 TP.HistCount := 0;
 TP.ScrollOffset := 0;
 TP.NeedRepaint := True;
End;

{ --- DIR / LS / GET-CHILDITEM --- }

{ --- DIR style CMD (Windows command prompt) --- }

Procedure TermCmd_DIR_CMD(Var TP: TTerminalPanel; ParamStr: String);
Var
 Info: SearchRec;
 T: DateTime;
 ShowDir, S, Line: String;
 TotalFiles, TotalDirs: LongInt;
 TotalSize: LongInt;
 FirstParam: String;
 Idx: Byte;
 AbsP: String;
 IsRoot: Boolean;
 StartCl: LongInt;
 Free: LongInt;
 LblTxt: String;
Begin
 FirstParam := TermExtractParam(ParamStr, 1);
 { Mode disque virtuel : utiliser le FAT image (cwd ou cible explicite
   prefixee A:/B:). }
 If Term_ResolveVirtTarget(TP, FirstParam, Idx, AbsP) Then Begin
  { Image Commodore 64 (.D64) : listage natif CBM DOS. }
  If FatVol[Idx].IsD64 Then Begin
   D64_ListDir(Idx, TP);
   Exit;
  End;
  If Not Fat_ResolveDir(Idx, AbsP, IsRoot, StartCl) Then Begin
   TermAddLine(TP,
    'Le systeme ne trouve pas le chemin specifie.');
   Exit;
  End;
  If FatVol[Idx].VolLabel <> '' Then
   LblTxt := FatVol[Idx].VolLabel
  Else
   LblTxt := 'no label';
  TermAddLine(TP, ' Volume in drive ' +
   Chr(Ord('A') + Idx) + ' is ' + LblTxt);
  TermAddLine(TP, '');
  If (AbsP = '') Or (AbsP = '\') Then
   TermAddLine(TP, ' Directory of ' + Chr(Ord('A') + Idx) + ':\')
  Else
   TermAddLine(TP, ' Directory of ' + Chr(Ord('A') + Idx) + ':' + AbsP);
  TermAddLine(TP, '');
  Fat_ListDir(Idx, IsRoot, StartCl, TP, 0);
  Free := Fat_FreeBytes(Idx);
  Str(Free, S);
  While Length(S) < 14 Do S := ' ' + S;
  TermAddLine(TP, '              ' + S + ' bytes free');
  Exit;
 End;
 If FirstParam = '' Then
  ShowDir := '*.*'
 Else
  ShowDir := FirstParam;
 TermAddLine(TP, ' Volume in drive C has no label.');
 TermAddLine(TP, ' Volume Serial Number is 1234-5678');
 TermAddLine(TP, '');
 TermAddLine(TP, ' Directory of ' + TermGetCurrentDir);
 TermAddLine(TP, '');
 TotalFiles := 0;
 TotalDirs := 0;
 TotalSize := 0;
 FindFirst(ShowDir, AnyFile, Info);
 While DosError = 0 Do Begin
  UnpackTime(Info.Time, T);
  Line := TermPadZeroLeft(T.Month, 2) + '/' +
   TermPadZeroLeft(T.Day, 2) + '/' +
   TermPadZeroLeft(T.Year, 4) + '  ';
  Str(T.Hour:2, S);
  Line := Line + S + ':' + TermPadZeroLeft(T.Min, 2) + '    ';
  If Info.Attr And Directory = Directory Then Begin
   Line := Line + '<DIR>          ' + Info.Name;
   Inc(TotalDirs);
  End Else Begin
   Str(Info.Size, S);
   While Length(S) < 14 Do S := ' ' + S;
   Line := Line + S + ' ' + Info.Name;
   Inc(TotalFiles);
   Inc(TotalSize, Info.Size);
  End;
  TermAddLine(TP, Line);
  FindNext(Info);
 End;
 Str(TotalFiles, S);
 While Length(S) < 16 Do S := ' ' + S;
 Str(TotalSize, Line);
 While Length(Line) < 14 Do Line := ' ' + Line;
 TermAddLine(TP, S + ' File(s)' + Line + ' bytes');
 Str(TotalDirs, S);
 While Length(S) < 16 Do S := ' ' + S;
 TermAddLine(TP, S + ' Dir(s)   bytes free');
End;

{ --- DIR style PowerShell (Get-ChildItem) --- }

Procedure TermCmd_DIR_PS(Var TP: TTerminalPanel; ParamStr: String);
Var
 Info: SearchRec;
 T: DateTime;
 ShowDir, S, Line: String;
 FirstParam: String;
 Idx: Byte;
 AbsP: String;
 IsRoot: Boolean;
 StartCl: LongInt;
Begin
 FirstParam := TermExtractParam(ParamStr, 1);
 If Term_ResolveVirtTarget(TP, FirstParam, Idx, AbsP) Then Begin
  If FatVol[Idx].IsD64 Then Begin
   D64_ListDir(Idx, TP);
   Exit;
  End;
  If Not Fat_ResolveDir(Idx, AbsP, IsRoot, StartCl) Then Begin
   TermAddLine(TP,
    'Get-ChildItem : Impossible de trouver le chemin ' + AbsP);
   Exit;
  End;
  TermAddLine(TP, '');
  If (AbsP = '') Or (AbsP = '\') Then
   TermAddLine(TP,
    '    Directory: ' + Chr(Ord('A') + Idx) + ':\')
  Else
   TermAddLine(TP,
    '    Directory: ' + Chr(Ord('A') + Idx) + ':' + AbsP);
  TermAddLine(TP, '');
  TermAddLine(TP,
   'Mode                 LastWriteTime         Length Name');
  TermAddLine(TP,
   '----                 -------------         ------ ----');
  Fat_ListDir(Idx, IsRoot, StartCl, TP, 1);
  TermAddLine(TP, '');
  Exit;
 End;
 If FirstParam = '' Then
  ShowDir := '*.*'
 Else
  ShowDir := FirstParam;
 TermAddLine(TP, '');
 TermAddLine(TP,
  '    Directory: ' + TermGetCurrentDir);
 TermAddLine(TP, '');
 TermAddLine(TP,
  'Mode                 LastWriteTime         Length Name');
 TermAddLine(TP,
  '----                 -------------         ------ ----');
 FindFirst(ShowDir, AnyFile, Info);
 While DosError = 0 Do Begin
  Line := '';
  If Info.Attr And Directory = Directory Then
   Line := Line + 'd' Else Line := Line + '-';
  If Info.Attr And Archive = Archive Then
   Line := Line + 'a' Else Line := Line + '-';
  If Info.Attr And ReadOnly = ReadOnly Then
   Line := Line + 'r' Else Line := Line + '-';
  If Info.Attr And Hidden = Hidden Then
   Line := Line + 'h' Else Line := Line + '-';
  If Info.Attr And SysFile = SysFile Then
   Line := Line + 's' Else Line := Line + '-';
  Line := Line + '-  ';
  UnpackTime(Info.Time, T);
  Str(T.Month, S);
  Line := Line + S + '/' +
   TermPadZeroLeft(T.Day, 2) + '/' +
   TermPadZeroLeft(T.Year, 4) + '  ';
  Str(T.Hour, S);
  Line := Line + S + ':' +
   TermPadZeroLeft(T.Min, 2) + ' ';
  If T.Hour >= 12 Then Line := Line + 'PM'
  Else Line := Line + 'AM';
  Line := Line + '  ';
  If Info.Attr And Directory = Directory Then
   Line := Line + TermPadRight('', 14)
  Else Begin
   Str(Info.Size, S);
   While Length(S) < 14 Do S := ' ' + S;
   Line := Line + S;
  End;
  Line := Line + ' ' + Info.Name;
  TermAddLine(TP, Line);
  FindNext(Info);
 End;
 TermAddLine(TP, '');
End;

{ --- LS style Bash (colonnes simples) --- }

Procedure TermCmd_DIR_BASH(Var TP: TTerminalPanel;
 ParamStr: String);
Var
 Info: SearchRec;
 T: DateTime;
 ShowDir, S, Line: String;
 FirstParam: String;
 TotalSize: LongInt;
 Idx: Byte;
 AbsP: String;
Begin
 FirstParam := TermExtractParam(ParamStr, 1);
 If Term_ResolveVirtTarget(TP, FirstParam, Idx, AbsP) Then Begin
  If FatVol[Idx].IsD64 Then Begin
   D64_ListDir(Idx, TP);
   Exit;
  End;
 End;
 If FirstParam = '' Then
  ShowDir := '*.*'
 Else
  ShowDir := FirstParam;
 TotalSize := 0;
 FindFirst(ShowDir, AnyFile, Info);
 While DosError = 0 Do Begin
  Inc(TotalSize, Info.Size);
  FindNext(Info);
 End;
 Str(TotalSize Div 1024, S);
 TermAddLine(TP, 'total ' + S);
 FindFirst(ShowDir, AnyFile, Info);
 While DosError = 0 Do Begin
  { drwxr-xr-x style permissions }
  Line := '';
  If Info.Attr And Directory = Directory Then
   Line := 'd' Else Line := '-';
  If Info.Attr And ReadOnly = ReadOnly Then
   Line := Line + 'r--r--r--'
  Else
   Line := Line + 'rw-rw-rw-';
  Line := Line + ' 1 user user ';
  Str(Info.Size, S);
  While Length(S) < 8 Do S := ' ' + S;
  Line := Line + S + ' ';
  UnpackTime(Info.Time, T);
  Case T.Month Of
   1: S := 'Jan'; 2: S := 'Feb'; 3: S := 'Mar';
   4: S := 'Apr'; 5: S := 'May'; 6: S := 'Jun';
   7: S := 'Jul'; 8: S := 'Aug'; 9: S := 'Sep';
   10: S := 'Oct'; 11: S := 'Nov'; 12: S := 'Dec';
  Else S := '???';
  End;
  Line := Line + S + ' ';
  Str(T.Day:2, S);
  Line := Line + S + ' ';
  Str(T.Hour:2, S);
  Line := Line + S + ':' + TermPadZeroLeft(T.Min, 2) + ' ';
  Line := Line + Info.Name;
  TermAddLine(TP, Line);
  FindNext(Info);
 End;
End;

