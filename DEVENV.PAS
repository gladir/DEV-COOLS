{ Declaration anticipee : OpenHelpFile est defini apres CreateEditorWindow
  et FindEditorByFileName car il les utilise. }
Procedure OpenHelpFile(BaseName: String; Context: String); Forward;

Procedure ExecuteMenuItem(Var Item: TMenuItem);
Var
 I: Integer;
Begin
 CloseMenu;
 Case Item.Tag Of
  100: Begin { Nouveau projet }
        ShowNewProjectDialog(NewProjDlg);
       End;
  101: Begin { Nouveau fichier (Ctrl+N) }
        ShowNewFileDialog(NewFileDlg);
       End;
  102: Begin { Nouvelle solution }
        InitNewProjectDialog(NewProjDlg);
        NewProjDlg.Base.Title := 'Nouvelle solution';
        NewProjDlg.Base.Visible := True;
        DrawNewProjectDialog(NewProjDlg);
       End;
  110: Begin { Ouvrir projet/solution (Ctrl+Maj+O) }
        InitFileDialog(FileDlg, False);
        LoadDirectoryFiles(FileDlg);
        FileDlg.Base.Title := 'Ouvrir projet/solution';
        FileDlg.Base.Visible := True;
        DrawFileDialog(FileDlg);
       End;
  111: Begin { Ouvrir fichier (Ctrl+O) }
        InitFileDialog(FileDlg, False);
        LoadDirectoryFiles(FileDlg);
        FileDlg.Base.Visible := True;
        DrawFileDialog(FileDlg);
       End;
  112: Begin { Ouvrir dossier... }
        InitFileDialog(FileDlg, False);
        FileDlg.FolderMode := True;
        LoadDirectoryFiles(FileDlg);
        FileDlg.Base.Title := 'Ouvrir dossier...';
        FileDlg.Base.Visible := True;
        DrawFileDialog(FileDlg);
       End;
  120: Begin { Fermer (Ctrl+W) : fermer l onglet actif }
        If (WinMgr.ActiveIdx >= 0) And
           (WinMgr.ActiveIdx < WinMgr.WinCount) Then Begin
         CloseEditorWindow(WinMgr.ActiveIdx);
         FullRepaintNeeded := True;
        End;
       End;
  121: Begin { Fermer la solution }
        While WinMgr.WinCount > 0 Do
         CloseEditorWindow(WinMgr.WinCount - 1);
        ClearExplorer(SolExplorer);
        SolutionLoaded := False;
        SolutionModified := False;
        SolExplorer.NeedRepaint := True;
        FullRepaintNeeded := True;
        AppendOutput(OutputPanel,
         'Solution fermee.', Ord(OTK_BUILD));
       End;
  130: HandleSaveCurrentFile;  { Enregistrer (Ctrl+S) }
  132: HandleSaveAll;          { Enregistrer tout (Ctrl+Maj+S) }
  150: Begin { Fichiers recents : popup }
        InitContextMenu(CtxMenu);
        CtxMenu.Width := 400;
        MRUPopupCount := 0;
        For I := 0 To MRUList.Count - 1 Do
         If MRUPopupCount < MRU_MAX_ENTRIES Then Begin
          MRUPopupPaths[MRUPopupCount] :=
           MRUList.Entries[I].FilePath;
          AddContextItem(CtxMenu,
           MRUList.Entries[I].FilePath,
           5000 + MRUPopupCount);
          Inc(MRUPopupCount);
         End;
        If MRUPopupCount = 0 Then
         AddContextItem(CtxMenu, '(aucun fichier recent)', 0);
        CtxMenu.X := 8;
        CtxMenu.Y := MainMenuBar.Y + MainMenuBar.Height;
        CtxMenu.Visible := True;
        DrawContextMenu(CtxMenu);
       End;
  151: Begin { Projets recents : popup .sln seulement }
        InitContextMenu(CtxMenu);
        CtxMenu.Width := 400;
        MRUPopupCount := 0;
        For I := 0 To MRUList.Count - 1 Do
         If (MRUPopupCount < MRU_MAX_ENTRIES) And
            (UpCaseStr(ExtractFileExt(
             MRUList.Entries[I].FilePath)) = '.SLN') Then Begin
          MRUPopupPaths[MRUPopupCount] :=
           MRUList.Entries[I].FilePath;
          AddContextItem(CtxMenu,
           MRUList.Entries[I].FilePath,
           5100 + MRUPopupCount);
          Inc(MRUPopupCount);
         End;
        If MRUPopupCount = 0 Then
         AddContextItem(CtxMenu, '(aucun projet recent)', 0);
        CtxMenu.X := 8;
        CtxMenu.Y := MainMenuBar.Y + MainMenuBar.Height;
        CtxMenu.Visible := True;
        DrawContextMenu(CtxMenu);
       End;
  199: Begin { Quitter }
        TryQuit;
       End;
  200: Begin { Annuler (Ctrl+Z) }
        If EditorReady Then
         Undo(ActiveEditor, EditorUndo, EditorRedo);
       End;
  201: Begin { Retablir (Ctrl+Y) }
        If EditorReady Then
         Redo(ActiveEditor, EditorUndo, EditorRedo);
       End;
  210: Begin { Couper (Ctrl+X) }
        If EditorReady Then Begin
         ClipboardCut(ActiveEditor, EditorSel, EditorClip);
         EnsureCursorVisible(ActiveEditor);
        End;
       End;
  211: Begin { Copier (Ctrl+C) }
        If EditorReady Then
         ClipboardCopy(ActiveEditor, EditorSel, EditorClip);
       End;
  212: Begin { Coller (Ctrl+V) }
        If EditorReady Then Begin
         If EditorSel.Active Then
          DeleteSelectedText(ActiveEditor, EditorSel);
         ClipboardPaste(ActiveEditor, EditorSel, EditorClip);
         EnsureCursorVisible(ActiveEditor);
        End;
       End;
  220: Begin { Selectionner tout (Ctrl+A) }
        If EditorReady Then
         SelectAll(ActiveEditor, EditorSel);
       End;
  230: ShowFindDialog(FindReplaceDlg); { Rechercher (Ctrl+F) }
  231: ShowReplaceDialog(FindReplaceDlg); { Remplacer (Ctrl+H) }
  232: Begin { Aller a la ligne (Ctrl+G) }
        If EditorReady Then
         ShowGoToLineDialog(ActiveEditor);
       End;
  242: Begin { Mettre en majuscules }
        If EditorReady Then
         TransformSelection(ActiveEditor, EditorSel, True);
       End;
  243: Begin { Mettre en minuscules }
        If EditorReady Then
         TransformSelection(ActiveEditor, EditorSel, False);
       End;
  410: Begin { Proprietes du projet }
        InitProjectPropertiesDialog(ProjPropDlg);
        LoadProjectProperties(ProjPropDlg, CurrentProject);
        ShowProjectPropertiesDialog(ProjPropDlg);
       End;
  500: HandleStartDebugging; { Generer la solution (F6) }
  530: Begin { Gestionnaire de configuration }
        If BuildMgr.ActiveConfig = '' Then
         BuildMgr.ActiveConfig := 'Debug';
        If UpCaseStr(BuildMgr.ActiveConfig) = 'DEBUG' Then Begin
         If ShowMessageBox('Gestionnaire de configuration',
          'Configuration active : Debug.' + #10 +
          'Basculer en Release ?',
          MB_YESNO, MI_INFO) = DR_OK Then Begin
          BuildMgr.ActiveConfig := 'Release';
          AppendOutput(OutputPanel,
           'Configuration active : Release.', 0);
         End;
        End Else Begin
         If ShowMessageBox('Gestionnaire de configuration',
          'Configuration active : ' + BuildMgr.ActiveConfig + '.' +
          #10 + 'Basculer en Debug ?',
          MB_YESNO, MI_INFO) = DR_OK Then Begin
          BuildMgr.ActiveConfig := 'Debug';
          AppendOutput(OutputPanel,
           'Configuration active : Debug.', 0);
         End;
        End;
        FullRepaintNeeded := True;
       End;
  600: Begin { Demarrer le debogage (F5) }
        If EmuDbg.Paused Then EmuDbg_Continue
        Else HandleStartDebugging;
       End;
  601: Begin { Demarrer sans debogage (Ctrl+F5) }
        If EmuDbg.Paused Then EmuDbg_Continue
        Else StartWithoutDebugging(BPMgr, OutputPanel);
       End;
  610: Begin { Point d arret (F9) }
        If EmuDbg.Active Or EmuDbg.Paused Then Begin
         EmuDbg_ToggleBPAtPC;
         FullRepaintNeeded := True;
        End;
       End;
  620: Begin { Pas a pas principal (F10) }
        If EmuDbg.Paused Then EmuDbg_StepOver
        Else StepOver(BPMgr, OutputPanel);
       End;
  621: Begin { Pas a pas detaille (F11) }
        If EmuDbg.Paused Then EmuDbg_StepInto
        Else StepInto(BPMgr, OutputPanel);
       End;
  622: Begin { Pas a pas sortant (Shift+F11) }
        If EmuDbg.Paused Then EmuDbg_StepOut;
       End;
  630: Begin { Arreter le debogage (Shift+F5) }
        If EmuDbg.Active Or EmuDbg.Paused Then EmuDbg_Stop
        Else StopDebugging(BPMgr, OutputPanel);
       End;
  700: Begin { Options... }
        ShowOptionsDialog(OptionsDlg);
        FullRepaintNeeded := True;
       End;
  705: Begin { Disque virtuel... }
        ShowVirtualDiskDialog(VirtualDiskDlg);
        FullRepaintNeeded := True;
       End;
  701: Begin { Personnaliser... }
        ShowMessageBox('Personnaliser',
         'La personnalisation des barres d outils et des menus' +
         #10 + 'n est pas encore disponible dans cette version.' +
         #10 + 'Utilisez Outils > Options pour configurer l IDE.',
         MB_OK, MI_INFO);
        FullRepaintNeeded := True;
       End;
  721: HandleRunCommentTool; { Outils > COMMENT }
  900: Begin { Aide > A propos de DEVENV }
        ShowMessageBox('A propos de DEVENV',
         'DEVENV - Clone de Visual Studio en mode graphique' + #10 +
         'Version ' + DEVENV_VERSION + ' (' + DEVENV_DATE + ')' + #10 +
         #10 +
         'Auteur  : Sylvain Maltais' + #10 +
         'Web     : https://www.gladir.com/dev-cools' + #10 +
         'Licence : MIT' + #10 +
         #10 +
         'Compilateurs integres :' + #10 +
         '  C#      (CSC)' + #10 +
         '  VB.NET  (VBC)' + #10 +
         '  Pascal  (TPC)' + #10 +
         #10 +
         'Cliquez sur Aide > Documentation pour consulter' + #10 +
         'la documentation detaillee.',
         MB_OK, MI_INFO);
        FullRepaintNeeded := True;
       End;
  901: Begin { Aide > Documentation en ligne }
        OpenHelpFile('DEVENV.HLP', '');
       End;
  910: Begin { Aide > Raccourcis clavier }
        OpenHelpFile('DEVENV.HLP', 'IDH_RACCOURCIS');
       End;
  911: Begin { Aide > Bienvenue : revenir a la page de demarrage }
        StartPage.Visible := True;
        FullRepaintNeeded := True;
       End;
  303: Begin { Terminal }
        TermVisible := Not TermVisible;
        If TermVisible Then Begin
         { Le terminal occupe tout le bas de l ecran }
         TermX := 0;
         TermY := GetScreenHeight - OUTPUT_HEIGHT
          - STATUSBAR_HEIGHT;
         TermWidth := GetScreenWidth - EXPLORER_WIDTH;
         TermHeight := OUTPUT_HEIGHT;
         If TermPanels[ActiveShell].LineCount = 0 Then
          TermAddLine(TermPanels[ActiveShell],
           'Terminal integre. Tapez HELP pour la liste des commandes.');
         TerminalHasFocus := True;
         TermSelectOpen := False;
         TerminalOnTop := True;
        End Else Begin
         TerminalHasFocus := False;
        End;
        FullRepaintNeeded := True;
       End;
 End;
End;

{ --- Trouver l index de menu sous la souris --- }

Function MenuBarHitTest(MX, MY: Integer): Integer;
Var
 I, TX, TW: Integer;
Begin
 MenuBarHitTest := -1;
 If (MY < MainMenuBar.Y) Or
    (MY >= MainMenuBar.Y + MainMenuBar.Height) Then Exit;
 TX := 0;
 For I := 0 To MainMenuBar.MenuCount - 1 Do Begin
  TW := Length(MainMenuBar.Menus[I].Title) * 8 + 16;
  If (MX >= TX) And (MX < TX + TW) Then Begin
   MenuBarHitTest := I;
   Exit;
  End;
  TX := TX + TW;
 End;
End;

{ --- Tester si la souris survole le bouton de zoom ecran --- }

Function ScrZoomBtnHitTest(MX, MY: Integer): Boolean;
Var
 BX, BY: Integer;
Begin
 BX := GetScreenWidth - SCRZOOM_BTN_SIZE - SCRZOOM_BTN_MARGIN;
 BY := MainMenuBar.Y + (MainMenuBar.Height - SCRZOOM_BTN_SIZE) Div 2;
 ScrZoomBtnHitTest := (MX >= BX - 2) And
  (MX <= BX + SCRZOOM_BTN_SIZE + 1) And
  (MY >= MainMenuBar.Y) And (MY < MainMenuBar.Y + MainMenuBar.Height - 1);
End;

{ --- Trouver l item sous la souris dans le menu ouvert --- }

Function MenuItemHitTest(MX, MY: Integer): Integer;
Var
 I, YPos, MW, MXOrig, SW: Integer;
 M: TMenu;
Begin
 MenuItemHitTest := -1;
 If OpenMenuIdx < 0 Then Exit;
 M := MainMenuBar.Menus[OpenMenuIdx];
 MW := M.Width;
 If MW < 160 Then MW := 160;
 { Appliquer le meme decalage que DrawOpenMenu/GetMenuRect quand le menu
   deroulant deborde a droite de l ecran }
 MXOrig := M.X;
 SW := GetScreenWidth;
 If MXOrig + MW + 2 > SW - 1 Then MXOrig := SW - 1 - MW - 2;
 If MXOrig < 0 Then MXOrig := 0;
 If (MX < MXOrig) Or (MX > MXOrig + MW) Then Exit;
 YPos := MainMenuBar.Height + 2;
 For I := 0 To M.ItemCount - 1 Do Begin
  If M.Items[I].Separator Then
   YPos := YPos + 8
  Else Begin
   If (MY >= YPos) And (MY < YPos + 16) Then Begin
    If M.Items[I].Enabled Then
     MenuItemHitTest := I;
    Exit;
   End;
   YPos := YPos + 16;
  End;
 End;
End;

{ --- Gestion des evenements de menu --- }

Procedure HandleMenuEvent(Var Ev: TEvent);
Var
 Hit, ItemHit: Integer;
 NewHover: Boolean;
Begin
 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  { Clic sur le bouton de zoom ecran (plein ecran / VGA 640x480) }
  If ScrZoomBtnHitTest(Ev.MouseX, Ev.MouseY) Then Begin
   ToggleScreenZoom;
   Exit;
  End;
  { Clic sur la barre de menus }
  Hit := MenuBarHitTest(Ev.MouseX, Ev.MouseY);
  If Hit >= 0 Then Begin
   If (OpenMenuIdx = Hit) And MenuActive Then
    CloseMenu
   Else
    OpenMenu(Hit);
   Exit;
  End;
  { Clic dans un menu ouvert }
  If MenuActive And (OpenMenuIdx >= 0) Then Begin
   ItemHit := MenuItemHitTest(Ev.MouseX, Ev.MouseY);
   If ItemHit >= 0 Then Begin
    ExecuteMenuItem(MainMenuBar.Menus[OpenMenuIdx].Items[ItemHit]);
    Exit;
   End;
   { Clic ailleurs : fermer }
   CloseMenu;
  End;
 End
 Else If Ev.Kind = EV_MOUSE_MOVE Then Begin
  { Survol du bouton de zoom ecran }
  NewHover := ScrZoomBtnHitTest(Ev.MouseX, Ev.MouseY);
  If NewHover <> ScrZoomHover Then
   ScrZoomHover := NewHover;
  { Survol de la barre de menus avec menu ouvert }
  If MenuActive And (OpenMenuIdx >= 0) Then Begin
   Hit := MenuBarHitTest(Ev.MouseX, Ev.MouseY);
   If (Hit >= 0) And (Hit <> OpenMenuIdx) Then
    OpenMenu(Hit);
   { Survol des items }
   ItemHit := MenuItemHitTest(Ev.MouseX, Ev.MouseY);
   If ItemHit <> SelItemIdx Then Begin
    SelItemIdx := ItemHit;
    DrawOpenMenu;
   End;
  End;
 End
 Else If Ev.Kind = EV_KEY_DOWN Then Begin
  If MenuActive Then Begin
   Case Ev.KeyCode Of
    72: { Fleche haut }
     Begin
      If OpenMenuIdx >= 0 Then Begin
       If SelItemIdx > 0 Then
        Dec(SelItemIdx)
       Else
        SelItemIdx := MainMenuBar.Menus[OpenMenuIdx].ItemCount - 1;
       { Sauter les separateurs }
       While (SelItemIdx >= 0) And
             MainMenuBar.Menus[OpenMenuIdx].Items[SelItemIdx].Separator Do
        Dec(SelItemIdx);
       DrawOpenMenu;
      End;
     End;
    80: { Fleche bas }
     Begin
      If OpenMenuIdx >= 0 Then Begin
       If SelItemIdx < MainMenuBar.Menus[OpenMenuIdx].ItemCount - 1 Then
        Inc(SelItemIdx)
       Else
        SelItemIdx := 0;
       { Sauter les separateurs }
       While (SelItemIdx < MainMenuBar.Menus[OpenMenuIdx].ItemCount) And
             MainMenuBar.Menus[OpenMenuIdx].Items[SelItemIdx].Separator Do
        Inc(SelItemIdx);
       DrawOpenMenu;
      End;
     End;
    75: { Fleche gauche }
     Begin
      If OpenMenuIdx > 0 Then
       OpenMenu(OpenMenuIdx - 1)
      Else
       OpenMenu(MainMenuBar.MenuCount - 1);
     End;
    77: { Fleche droite }
     Begin
      If OpenMenuIdx < MainMenuBar.MenuCount - 1 Then
       OpenMenu(OpenMenuIdx + 1)
      Else
       OpenMenu(0);
     End;
    28: { Entree }
     Begin
      If (SelItemIdx >= 0) And (OpenMenuIdx >= 0) Then
       ExecuteMenuItem(MainMenuBar.Menus[OpenMenuIdx].Items[SelItemIdx]);
     End;
    1:  { Echap }
     CloseMenu;
   End;
  End Else Begin
   { Alt+lettre pour ouvrir un menu depuis l etat inactif }
   { En DOS, Alt+lettre genere EV_KEY_DOWN avec le scan code BIOS }
   Case Ev.KeyCode Of
    $21: OpenMenu(0); { Alt+F : Fichier  (scan code 0x21=33) }
    $12: OpenMenu(1); { Alt+E : Edition  (scan code 0x12=18) }
    $1E: OpenMenu(2); { Alt+A : Affichage(scan code 0x1E=30) }
    $19: OpenMenu(3); { Alt+P : Projet   (scan code 0x19=25) }
    $22: OpenMenu(4); { Alt+G : Generer  (scan code 0x22=34) }
    $20: OpenMenu(5); { Alt+D : Deboguer (scan code 0x20=32) }
    $18: OpenMenu(6); { Alt+O : Outils   (scan code 0x18=24) }
    $31: OpenMenu(7); { Alt+N : feNetre  (scan code 0x31=49) }
    $17: OpenMenu(8); { Alt+I : aIde     (scan code 0x17=23) }
   End;
  End;
 End
 Else If Ev.Kind = EV_KEY_CHAR Then Begin
  { Touches de controle du menu si actif }
  If MenuActive Then Begin
   Case Ev.KeyChar Of
    #13: Begin { Entree : valider l element pointe par la souris }
          If (SelItemIdx >= 0) And (OpenMenuIdx >= 0) Then
           ExecuteMenuItem(MainMenuBar.Menus[OpenMenuIdx].Items[SelItemIdx]);
         End;
    #27: CloseMenu; { Echap : fermer le menu }
   End;
   Exit;
  End;
  { Raccourcis clavier globaux }
  { Pas de raccourcis ici pour l instant, les TODOs futurs
    connecteront les raccourcis aux commandes reelles. }
 End;
End;

{ --- Compter les elements de menu --- }

Function CountMenuItems: Integer;
Var
 I, Total: Integer;
Begin
 Total := 0;
 For I := 0 To MainMenuBar.MenuCount - 1 Do
  Total := Total + MainMenuBar.Menus[I].ItemCount;
 CountMenuItems := Total;
End;

Function CountMenuSeparators: Integer;
Var
 I, J, Total: Integer;
Begin
 Total := 0;
 For I := 0 To MainMenuBar.MenuCount - 1 Do
  For J := 0 To MainMenuBar.Menus[I].ItemCount - 1 Do
   If MainMenuBar.Menus[I].Items[J].Separator Then
    Inc(Total);
 CountMenuSeparators := Total;
End;

