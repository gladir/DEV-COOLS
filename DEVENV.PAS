{ ============================================================
  VISIONNEUSE WinHelp .HLP
  ============================================================
  Compatible avec le format genere par HC.PAS :
   - En-tete 16 octets (Magic, DirStart, FreeChain, EOFOfs)
   - Fichiers internes |SYSTEM, |TOPIC, |CONTEXT, ...
   - Compression LZ77 optionnelle (bit 0 de FileFlags)
   - Topics : RTF brut precede d un en-tete 21 octets
       octet 0  = 02h
       octets 1..4 = taille des donnees RTF (LongInt LE)
       octets 5..20 = reserve (zero)
       octets 21.. = donnees RTF brutes
  Rendu RTF minimal : commandes b, i, ul, uldb (hyperlien),
  v (cible cachee), par, line, tab, plain, cf, f, et echappements
  hex et caracteres de groupe. Les groupes fonttbl, colortbl,
  stylesheet, info, footnote, header, footer, pict, field sont
  ignores.
}

Const
 HLPV_MAX_TOPICS = 1024;
 HLPV_MAX_CTX    = 2048;
 HLPV_MAX_RUNS   = 4096;
 HLPV_MAGIC      : LongInt = $00035F3F;

Type
 PHlpByteArr = ^THlpByteArr;
 THlpByteArr = Array[0..0] Of Byte;

 THlpvTopic = Record
  Offset    : LongInt;   { offset dans le buffer TOPIC decompresse }
  RtfStart  : LongInt;   { offset des octets RTF utiles }
  RtfLen    : LongInt;   { taille RTF }
 End;

 THlpvCtx = Record
  Hash      : LongInt;
  TopicOfs  : LongInt;
 End;

 THlpvRunKind = (HRK_Text, HRK_Newline);

 THlpvRun = Record
  Kind     : THlpvRunKind;
  Txt      : String[80];
  X, Y     : Integer;
  W        : Integer;
  Bold     : Boolean;
  Italic   : Boolean;
  Under    : Boolean;
  Color    : Byte;
  Hot      : Boolean;
  Target   : String[60];
 End;

Var
 HlpvFileBuf     : PHlpByteArr;     { fichier .HLP entier en memoire }
 HlpvFileLen     : LongInt;
 HlpvTopicData   : PHlpByteArr;     { donnees |TOPIC decompressees }
 HlpvTopicLen    : LongInt;
 HlpvTopics      : Array[1..HLPV_MAX_TOPICS] Of THlpvTopic;
 HlpvNumTopics   : Integer;
 HlpvCtxTbl      : Array[1..HLPV_MAX_CTX] Of THlpvCtx;
 HlpvNumCtx      : Integer;
 HlpvRuns        : Array[1..HLPV_MAX_RUNS] Of THlpvRun;
 HlpvNumRuns     : Integer;
 HlpvDocHeight   : Integer;
 HlpvScrollY     : Integer;
 HlpvCurTopic    : Integer;        { index dans HlpvTopics }
 HlpvBackHistory : Array[1..32] Of Integer;
 HlpvHistCount   : Integer;
 HlpvTitle       : String;

{ Lecture little-endian dans un buffer brut }
Function HlpvLE16(Buf: PHlpByteArr; Ofs: LongInt): Word;
Begin
 HlpvLE16 := Word(Buf^[Ofs]) Or (Word(Buf^[Ofs + 1]) Shl 8);
End;

Function HlpvLE32(Buf: PHlpByteArr; Ofs: LongInt): LongInt;
Begin
 HlpvLE32 := LongInt(Buf^[Ofs]) Or (LongInt(Buf^[Ofs + 1]) Shl 8) Or
             (LongInt(Buf^[Ofs + 2]) Shl 16) Or
             (LongInt(Buf^[Ofs + 3]) Shl 24);
End;

Function HlpvUpCh(C: Char): Char;
Begin
 If (C >= 'a') And (C <= 'z') Then
  HlpvUpCh := Chr(Ord(C) - 32)
 Else
  HlpvUpCh := C;
End;

{ Hash WinHelp (identique a HC.HashContext) }
{$PUSH}{$Q-}{$R-}
Function HlpvHashContext(S: String): LongInt;
Var I: Integer; H: LongInt;
Begin
 H := 0;
 For I := 1 To Length(S) Do
  H := H * 43 + Ord(HlpvUpCh(S[I]));
 HlpvHashContext := H;
End;
{$POP}

{ Decompression LZ77 (inverse de HC.PAS LZ77Compress)
  Format :
   - 4 octets : taille decompressee (LongInt LE)
   - Suite de groupes : 1 octet de flags + 8 entrees (LSB first)
     bit=1 : 1 octet litteral
     bit=0 : 2 octets match (len = (b1 shr 4)+3, ofs = ((b1 and 0F) shl 8) | b2)
}
Procedure HlpvLZ77Decompress(Src: PHlpByteArr; SrcLen: LongInt;
                              Var Dst: PHlpByteArr; Var DstLen: LongInt);
Var
 SrcPos, DstPos, MatchOfs: LongInt;
 OrigSize, Len, K: LongInt;
 Flag: Byte;
 BitMask: Byte;
 B1, B2: Byte;
Begin
 Dst := Nil;
 DstLen := 0;
 If SrcLen < 4 Then Exit;
 OrigSize := LongInt(Src^[0]) Or (LongInt(Src^[1]) Shl 8) Or
             (LongInt(Src^[2]) Shl 16) Or (LongInt(Src^[3]) Shl 24);
 If (OrigSize <= 0) Or (OrigSize > 16000000) Then Exit;
 GetMem(Dst, OrigSize);
 FillChar(Dst^, OrigSize, 0);
 SrcPos := 4;
 DstPos := 0;
 While (SrcPos < SrcLen) And (DstPos < OrigSize) Do Begin
  Flag := Src^[SrcPos];
  Inc(SrcPos);
  BitMask := 1;
  While (BitMask <> 0) And (SrcPos < SrcLen) And (DstPos < OrigSize) Do Begin
   If (Flag And BitMask) <> 0 Then Begin
    { Litteral }
    Dst^[DstPos] := Src^[SrcPos];
    Inc(SrcPos);
    Inc(DstPos);
   End Else Begin
    { Match }
    If SrcPos + 1 >= SrcLen Then Break;
    B1 := Src^[SrcPos];
    B2 := Src^[SrcPos + 1];
    Inc(SrcPos, 2);
    Len := LongInt((B1 Shr 4) And $0F) + 3;
    MatchOfs := (LongInt(B1 And $0F) Shl 8) Or LongInt(B2);
    If MatchOfs = 0 Then Break;
    For K := 1 To Len Do Begin
     If DstPos >= OrigSize Then Break;
     If DstPos - MatchOfs < 0 Then
      Dst^[DstPos] := 0
     Else
      Dst^[DstPos] := Dst^[DstPos - MatchOfs];
     Inc(DstPos);
    End;
   End;
   If BitMask = 128 Then BitMask := 0 Else BitMask := BitMask Shl 1;
  End;
 End;
 DstLen := DstPos;
End;

{ Lit un fichier .HLP entier en memoire. Retourne True si OK. }
Function HlpvLoadFile(FileName: String): Boolean;
Var
 F: File;
 OldFM: Byte;
 Got: Word;
 Remain: LongInt;
 P: LongInt;
Begin
 HlpvLoadFile := False;
 HlpvFileBuf := Nil;
 HlpvFileLen := 0;
 OldFM := FileMode;
 FileMode := 0;
 Assign(F, FileName);
 {$I-} Reset(F, 1); {$I+}
 If IOResult <> 0 Then Begin FileMode := OldFM; Exit; End;
 HlpvFileLen := FileSize(F);
 If HlpvFileLen < 16 Then Begin Close(F); FileMode := OldFM; Exit; End;
 GetMem(HlpvFileBuf, HlpvFileLen);
 P := 0;
 Remain := HlpvFileLen;
 While Remain > 0 Do Begin
  If Remain > 32000 Then BlockRead(F, HlpvFileBuf^[P], 32000, Got)
  Else BlockRead(F, HlpvFileBuf^[P], Remain, Got);
  If Got = 0 Then Break;
  Inc(P, Got);
  Dec(Remain, Got);
 End;
 Close(F);
 FileMode := OldFM;
 { Verifier le magic }
 If HlpvLE32(HlpvFileBuf, 0) <> HLPV_MAGIC Then Exit;
 HlpvLoadFile := True;
End;

{ Trouve l offset du fichier interne nomme Name dans le directory.
  Retourne -1 si introuvable. }
Function HlpvFindFile(Name: String): LongInt;
Var
 DirStart: LongInt;
 PagePtr, J: LongInt;
 PagePos, NEntries, I, NL: Integer;
 EntName: String;
 EntOfs: LongInt;
Begin
 HlpvFindFile := -1;
 DirStart := HlpvLE32(HlpvFileBuf, 4);
 If (DirStart < 16) Or (DirStart + 9 + 38 + 1024 > HlpvFileLen) Then Exit;
 { Sauter l en-tete de fichier interne (9 octets) puis l en-tete B-tree (38 octets) }
 PagePos := 9 + 38;
 PagePtr := DirStart + PagePos;
 { En-tete de page : 2 octets unused, 2 octets nentries, 4 octets prev/next }
 NEntries := HlpvLE16(HlpvFileBuf, PagePtr + 2);
 J := PagePtr + 8;
 For I := 1 To NEntries Do Begin
  { Lire le nom ASCIIZ }
  EntName := '';
  NL := 0;
  While (J < HlpvFileLen) And (NL < 80) And (HlpvFileBuf^[J] <> 0) Do Begin
   EntName := EntName + Chr(HlpvFileBuf^[J]);
   Inc(J);
   Inc(NL);
  End;
  Inc(J); { sauter le 0 terminal }
  EntOfs := HlpvLE32(HlpvFileBuf, J);
  Inc(J, 4);
  If EntName = Name Then Begin
   HlpvFindFile := EntOfs;
   Exit;
  End;
 End;
End;

{ Charge et decompresse le fichier interne |TOPIC. }
Function HlpvLoadTopicFile: Boolean;
Var
 TopicOfs: LongInt;
 Reserved, Used: LongInt;
 Flags: Byte;
 RawPtr: PHlpByteArr;
 Tmp: PHlpByteArr;
 TmpLen: LongInt;
Begin
 HlpvLoadTopicFile := False;
 HlpvTopicData := Nil;
 HlpvTopicLen := 0;
 TopicOfs := HlpvFindFile('|TOPIC');
 If TopicOfs < 0 Then Exit;
 If TopicOfs + 9 > HlpvFileLen Then Exit;
 Reserved := HlpvLE32(HlpvFileBuf, TopicOfs);
 Used := HlpvLE32(HlpvFileBuf, TopicOfs + 4);
 Flags := HlpvFileBuf^[TopicOfs + 8];
 If TopicOfs + 9 + Used > HlpvFileLen Then Exit;
 RawPtr := PHlpByteArr(@HlpvFileBuf^[TopicOfs + 9]);
 If (Flags And 1) <> 0 Then Begin
  { Compresse : decompresser }
  HlpvLZ77Decompress(RawPtr, Used, Tmp, TmpLen);
  If Tmp = Nil Then Exit;
  HlpvTopicData := Tmp;
  HlpvTopicLen := TmpLen;
 End Else Begin
  { Brut : copier dans un buffer dedie }
  GetMem(HlpvTopicData, Used);
  Move(RawPtr^, HlpvTopicData^, Used);
  HlpvTopicLen := Used;
 End;
 { Reserved : non utilise ici, supprimer warning -Mtp }
 If Reserved = -1 Then ;
 HlpvLoadTopicFile := True;
End;

{ Parcourt |TOPIC pour extraire la liste des topics (offset + bornes RTF). }
Procedure HlpvScanTopics;
Var
 P: LongInt;
 Sz: LongInt;
Begin
 HlpvNumTopics := 0;
 P := 0;
 While (P + 21 <= HlpvTopicLen) And (HlpvNumTopics < HLPV_MAX_TOPICS) Do Begin
  If HlpvTopicData^[P] <> 2 Then Break;
  Sz := HlpvLE32(HlpvTopicData, P + 1);
  If (Sz < 0) Or (P + 21 + Sz > HlpvTopicLen) Then Break;
  Inc(HlpvNumTopics);
  HlpvTopics[HlpvNumTopics].Offset := P;
  HlpvTopics[HlpvNumTopics].RtfStart := P + 21;
  HlpvTopics[HlpvNumTopics].RtfLen := Sz;
  P := P + 21 + Sz;
 End;
End;

{ Charge la table de contextes |CONTEXT. Contient des paires
  (hash LongInt, offset LongInt) de 8 octets. }
Procedure HlpvLoadContext;
Var
 CtxOfs: LongInt;
 Used: LongInt;
 P: LongInt;
Begin
 HlpvNumCtx := 0;
 CtxOfs := HlpvFindFile('|CONTEXT');
 If CtxOfs < 0 Then Exit;
 If CtxOfs + 9 > HlpvFileLen Then Exit;
 Used := HlpvLE32(HlpvFileBuf, CtxOfs + 4);
 If CtxOfs + 9 + Used > HlpvFileLen Then Exit;
 P := CtxOfs + 9;
 While (P + 8 <= CtxOfs + 9 + Used) And (HlpvNumCtx < HLPV_MAX_CTX) Do Begin
  Inc(HlpvNumCtx);
  HlpvCtxTbl[HlpvNumCtx].Hash := HlpvLE32(HlpvFileBuf, P);
  HlpvCtxTbl[HlpvNumCtx].TopicOfs := HlpvLE32(HlpvFileBuf, P + 4);
  Inc(P, 8);
 End;
End;

{ Lit le titre du systeme dans |SYSTEM. }
Procedure HlpvLoadSystemTitle;
Var
 SysOfs, Used: LongInt;
 P, EndP: LongInt;
 RecType, RecLen: Word;
 I: Integer;
Begin
 HlpvTitle := '';
 SysOfs := HlpvFindFile('|SYSTEM');
 If SysOfs < 0 Then Exit;
 Used := HlpvLE32(HlpvFileBuf, SysOfs + 4);
 P := SysOfs + 9;
 EndP := P + Used;
 { En-tete : Magic(2), MinorVer(2), MajorVer(2), GenDate(4), Flags(2) = 12 octets }
 If P + 12 > EndP Then Exit;
 Inc(P, 12);
 While P + 4 <= EndP Do Begin
  RecType := HlpvLE16(HlpvFileBuf, P);
  RecLen := HlpvLE16(HlpvFileBuf, P + 2);
  Inc(P, 4);
  If P + RecLen > EndP Then Break;
  If RecType = 1 Then Begin
   { Title : ASCIIZ }
   HlpvTitle := '';
   For I := 0 To RecLen - 1 Do Begin
    If HlpvFileBuf^[P + I] = 0 Then Break;
    HlpvTitle := HlpvTitle + Chr(HlpvFileBuf^[P + I]);
   End;
  End;
  Inc(P, RecLen);
 End;
End;

{ Trouve l index du topic dont l offset correspond a TopicOfs.
  Retourne 0 si introuvable. }
Function HlpvFindTopicByOffset(TopicOfs: LongInt): Integer;
Var I: Integer;
Begin
 HlpvFindTopicByOffset := 0;
 For I := 1 To HlpvNumTopics Do
  If HlpvTopics[I].Offset = TopicOfs Then Begin
   HlpvFindTopicByOffset := I;
   Exit;
  End;
End;

{ Resout un contexte texte vers un index de topic. Retourne 0 si non trouve. }
Function HlpvFindTopicByContext(Ctx: String): Integer;
Var H: LongInt; I: Integer;
Begin
 HlpvFindTopicByContext := 0;
 H := HlpvHashContext(Ctx);
 For I := 1 To HlpvNumCtx Do
  If HlpvCtxTbl[I].Hash = H Then Begin
   HlpvFindTopicByContext := HlpvFindTopicByOffset(HlpvCtxTbl[I].TopicOfs);
   Exit;
  End;
End;

{ ============================================================
  Parseur RTF minimaliste
  ============================================================ }

Const
 HLPV_CONTENT_X      = 12;     { marge gauche }
 HLPV_LINE_HEIGHT    = 14;     { hauteur d une ligne }
 HLPV_TITLEBAR_H     = 22;     { hauteur de la barre de titre du viewer }

Type
 THlpvFmt = Record
  Bold      : Boolean;
  Italic    : Boolean;
  Under     : Boolean;
  Hot       : Boolean;
  Color     : Byte;
 End;

{ Ajoute un run de texte aux runs courants. }
Procedure HlpvAddRun(Const ATxt: String; AX, AY, AW: Integer;
                     Const Fmt: THlpvFmt; Const ATarget: String);
Begin
 If HlpvNumRuns >= HLPV_MAX_RUNS Then Exit;
 Inc(HlpvNumRuns);
 With HlpvRuns[HlpvNumRuns] Do Begin
  Kind   := HRK_Text;
  Txt    := ATxt;
  X      := AX;
  Y      := AY;
  W      := AW;
  Bold   := Fmt.Bold;
  Italic := Fmt.Italic;
  Under  := Fmt.Under;
  Color  := Fmt.Color;
  Hot    := Fmt.Hot;
  Target := ATarget;
 End;
End;

{ Parse les octets RTF du topic Idx et calcule les runs avec mise en page
  par retour a la ligne (word-wrap). Renseigne HlpvDocHeight. }
Procedure HlpvLayoutTopic(Idx: Integer; AvailWidth: Integer);
Var
 P, EndP, GroupDepth, IgnoreDepth: LongInt;
 B: Byte;
 C, NextC: Char;
 CurX, CurY: Integer;
 Word: String;
 WordW: Integer;
 Fmt: THlpvFmt;
 SavedFmt: Array[1..16] Of THlpvFmt;
 FmtStack: Integer;
 CmdName: String;
 CmdParam: LongInt;
 HasParam, ParamNeg: Boolean;
 InUldb: Boolean;       { dans un groupe \uldb (texte chaud) }
 InV: Boolean;          { dans un groupe \v (cible cachee) }
 PendingTarget: String; { cible accumulee depuis \v }
 LastTarget: String;    { derniere cible captureee, attribuee aux runs }
 HotRunsStart: Integer; { premier run du groupe \uldb courant }
 HexHi, HexLo: Char;
 Skip: Boolean;
 K: Integer;

 Procedure FlushWord;
 Var W2: Integer; XEnd: Integer;
 Begin
  If Word = '' Then Exit;
  W2 := Length(Word) * 8;
  XEnd := CurX + W2;
  If (CurX > HLPV_CONTENT_X) And (XEnd > AvailWidth - 8) Then Begin
   CurX := HLPV_CONTENT_X;
   Inc(CurY, HLPV_LINE_HEIGHT);
  End;
  HlpvAddRun(Word, CurX, CurY, Length(Word) * 8, Fmt, LastTarget);
  Inc(CurX, W2);
  Word := '';
  WordW := 0;
 End;

 Procedure NewLine;
 Begin
  FlushWord;
  CurX := HLPV_CONTENT_X;
  Inc(CurY, HLPV_LINE_HEIGHT);
 End;

 Procedure AppendCh(Ch: Char);
 Begin
  If Ch = ' ' Then Begin
   FlushWord;
   { Espace inter-mots : ajoute un blanc visible (largeur 8) }
   If CurX + 8 > AvailWidth - 8 Then Begin
    CurX := HLPV_CONTENT_X;
    Inc(CurY, HLPV_LINE_HEIGHT);
   End Else
    Inc(CurX, 8);
  End Else Begin
   If Length(Word) < 80 Then Word := Word + Ch;
  End;
 End;

Begin
 HlpvNumRuns := 0;
 HlpvDocHeight := 0;
 If (Idx < 1) Or (Idx > HlpvNumTopics) Then Exit;
 P := HlpvTopics[Idx].RtfStart;
 EndP := P + HlpvTopics[Idx].RtfLen;
 GroupDepth := 0;
 IgnoreDepth := 0;
 CurX := HLPV_CONTENT_X;
 CurY := 8;
 Word := '';
 WordW := 0;
 Fmt.Bold := False; Fmt.Italic := False; Fmt.Under := False;
 Fmt.Hot := False; Fmt.Color := CLR_EDITOR_TEXT;
 FmtStack := 0;
 InUldb := False; InV := False;
 PendingTarget := ''; LastTarget := '';
 HotRunsStart := 0;
 While P < EndP Do Begin
  B := HlpvTopicData^[P];
  C := Chr(B);
  Inc(P);
  If IgnoreDepth > 0 Then Begin
   { Dans un groupe ignore : suivre uniquement les accolades pour ressortir }
   If C = '{' Then Inc(IgnoreDepth)
   Else If C = '}' Then Begin
    Dec(IgnoreDepth);
    If IgnoreDepth = 0 Then ;
   End;
   Continue;
  End;
  Case C Of
   '{': Begin
    FlushWord;
    Inc(GroupDepth);
    If FmtStack < 16 Then Begin
     Inc(FmtStack);
     SavedFmt[FmtStack] := Fmt;
    End;
   End;
   '}': Begin
    FlushWord;
    If GroupDepth > 0 Then Dec(GroupDepth);
    If InV And (PendingTarget <> '') Then Begin
     { Fin de groupe \v : assigne la cible aux runs Hot precedents }
     For K := HotRunsStart To HlpvNumRuns Do
      If (K >= 1) And (K <= HlpvNumRuns) And HlpvRuns[K].Hot Then
       HlpvRuns[K].Target := PendingTarget;
     LastTarget := '';
     PendingTarget := '';
     InV := False;
    End;
    If InUldb And (GroupDepth < FmtStack) Then Begin
     InUldb := False;
    End;
    If FmtStack > 0 Then Begin
     Fmt := SavedFmt[FmtStack];
     Dec(FmtStack);
    End;
   End;
   '\': Begin
    If P >= EndP Then Break;
    NextC := Chr(HlpvTopicData^[P]);
    { Echappements simples }
    If (NextC = '\') Or (NextC = '{') Or (NextC = '}') Then Begin
     AppendCh(NextC);
     Inc(P);
    End Else If NextC = '''' Then Begin
     { \'XX : hex byte }
     Inc(P);
     If P + 1 < EndP Then Begin
      HexHi := Chr(HlpvTopicData^[P]);
      HexLo := Chr(HlpvTopicData^[P + 1]);
      Inc(P, 2);
      B := 0;
      Case HexHi Of
       '0'..'9': B := (Ord(HexHi) - Ord('0')) Shl 4;
       'a'..'f': B := (Ord(HexHi) - Ord('a') + 10) Shl 4;
       'A'..'F': B := (Ord(HexHi) - Ord('A') + 10) Shl 4;
      End;
      Case HexLo Of
       '0'..'9': B := B Or (Ord(HexLo) - Ord('0'));
       'a'..'f': B := B Or (Ord(HexLo) - Ord('a') + 10);
       'A'..'F': B := B Or (Ord(HexLo) - Ord('A') + 10);
      End;
      If B >= 32 Then AppendCh(Chr(B));
     End;
    End Else If NextC = '*' Then Begin
     { \*\xxx : extension ignoree, sauter le groupe englobant }
     Inc(P);
     { On laisse le parseur continuer ; le mot-cle qui suit sera lu }
    End Else If NextC = #10 Then Begin
     NewLine;
     Inc(P);
    End Else If NextC = #13 Then Begin
     Inc(P);
     If (P < EndP) And (HlpvTopicData^[P] = 10) Then Inc(P);
    End Else Begin
     { Lire le nom de commande }
     CmdName := '';
     While (P < EndP) And (HlpvTopicData^[P] >= Ord('a')) And
           (HlpvTopicData^[P] <= Ord('z')) Do Begin
      If Length(CmdName) < 30 Then
       CmdName := CmdName + Chr(HlpvTopicData^[P]);
      Inc(P);
     End;
     { Parametre numerique optionnel }
     HasParam := False; ParamNeg := False; CmdParam := 0;
     If (P < EndP) And (Chr(HlpvTopicData^[P]) = '-') Then Begin
      ParamNeg := True; Inc(P);
     End;
     While (P < EndP) And (HlpvTopicData^[P] >= Ord('0')) And
           (HlpvTopicData^[P] <= Ord('9')) Do Begin
      HasParam := True;
      CmdParam := CmdParam * 10 + (HlpvTopicData^[P] - Ord('0'));
      Inc(P);
     End;
     If ParamNeg Then CmdParam := -CmdParam;
     { Avaler l espace de delimitation }
     If (P < EndP) And (HlpvTopicData^[P] = 32) Then Inc(P);
     { Traiter la commande }
     Skip := False;
     If CmdName = 'b' Then Fmt.Bold := Not (HasParam And (CmdParam = 0))
     Else If CmdName = 'i' Then Fmt.Italic := Not (HasParam And (CmdParam = 0))
     Else If CmdName = 'ul' Then Fmt.Under := True
     Else If CmdName = 'ulnone' Then Fmt.Under := False
     Else If CmdName = 'uldb' Then Begin
      Fmt.Under := True;
      Fmt.Hot := True;
      Fmt.Color := 1;  { bleu }
      InUldb := True;
      HotRunsStart := HlpvNumRuns + 1;
     End
     Else If CmdName = 'v' Then Begin
      InV := True;
      PendingTarget := '';
      Continue;
     End
     Else If CmdName = 'plain' Then Begin
      Fmt.Bold := False; Fmt.Italic := False;
      Fmt.Under := False; Fmt.Hot := False;
      Fmt.Color := CLR_EDITOR_TEXT;
     End
     Else If CmdName = 'par' Then NewLine
     Else If CmdName = 'line' Then NewLine
     Else If CmdName = 'tab' Then Begin
      FlushWord;
      CurX := ((CurX - HLPV_CONTENT_X) Div 64 + 1) * 64 + HLPV_CONTENT_X;
     End
     Else If CmdName = 'cf' Then Begin
      If HasParam Then Begin
       Case CmdParam Of
        0: Fmt.Color := CLR_EDITOR_TEXT;
        1: Fmt.Color := 4;   { rouge }
        2: Fmt.Color := 2;   { vert }
        3: Fmt.Color := 1;   { bleu }
       Else
        Fmt.Color := CLR_EDITOR_TEXT;
       End;
      End;
     End
     Else If (CmdName = 'fonttbl') Or (CmdName = 'colortbl') Or
             (CmdName = 'stylesheet') Or (CmdName = 'info') Or
             (CmdName = 'footnote') Or (CmdName = 'header') Or
             (CmdName = 'footer') Or (CmdName = 'pict') Or
             (CmdName = 'field') Or (CmdName = 'xe') Or
             (CmdName = 'comment') Then Begin
      IgnoreDepth := 1;
      Skip := True;
     End;
     If Skip Then Continue;
    End;
   End;
   #13: ; { ignore - traite avec #10 }
   #10: If Word <> '' Then AppendCh(' '); { CRLF source RTF = separateur de mots }
   #9: Begin
    FlushWord;
    CurX := ((CurX - HLPV_CONTENT_X) Div 64 + 1) * 64 + HLPV_CONTENT_X;
   End;
  Else
   If InV Then Begin
    { Caracteres dans \v : accumuler comme cible }
    PendingTarget := PendingTarget + C;
   End Else Begin
    AppendCh(C);
   End;
  End;
 End;
 FlushWord;
 HlpvDocHeight := CurY + HLPV_LINE_HEIGHT;
End;

{ ============================================================
  Rendu graphique + boucle modale
  ============================================================ }

Var
 HlpvViewX1, HlpvViewY1, HlpvViewX2, HlpvViewY2: Integer;
 HlpvDone: Boolean;
 HlpvBgBuf: Pointer;
 HlpvBgSize: LongInt;

Procedure HlpvDrawRun(Const R: THlpvRun; ScreenY: Integer);
Var TX, TY, I, ShadowColor: Integer;
Begin
 TX := HlpvViewX1 + R.X;
 TY := ScreenY;
 If (TY + HLPV_LINE_HEIGHT < HlpvViewY1 + HLPV_TITLEBAR_H) Or
    (TY > HlpvViewY2) Then Exit;
 If R.Hot Then SetColor(1)              { bleu pour hyperlien }
 Else SetColor(R.Color);
 OutTextXY(TX, TY, R.Txt);
 If R.Bold Then Begin
  { Double-strike pour simuler le gras }
  OutTextXY(TX + 1, TY, R.Txt);
 End;
 If R.Italic Then Begin
  { Simuler l italique par un decalage decalee : ombre claire }
  ShadowColor := R.Color;
  If R.Hot Then ShadowColor := 9 { bleu clair };
  SetColor(ShadowColor);
  OutTextXY(TX, TY + 1, R.Txt);
 End;
 If R.Under Or R.Hot Then Begin
  If R.Hot Then SetColor(1) Else SetColor(R.Color);
  Line(TX, TY + 9, TX + R.W - 1, TY + 9);
 End;
 I := 0;
End;

Procedure HlpvDraw;
Var I, SY: Integer; S: String;
Begin
 { Cadre du viewer }
 SetFillStyle(SolidFill, CLR_EDITOR_BG);
 Bar(HlpvViewX1, HlpvViewY1, HlpvViewX2, HlpvViewY2);
 { Barre de titre }
 SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
 Bar(HlpvViewX1, HlpvViewY1,
     HlpvViewX2, HlpvViewY1 + HLPV_TITLEBAR_H - 1);
 SetColor(15);
 S := 'Aide';
 If HlpvTitle <> '' Then S := 'Aide - ' + HlpvTitle;
 OutTextXY(HlpvViewX1 + 6, HlpvViewY1 + 6, S);
 { Bouton fermer [X] a droite }
 SetColor(15);
 OutTextXY(HlpvViewX2 - 16, HlpvViewY1 + 6, '[X]');
 { Bordure }
 SetColor(CLR_BORDER);
 Rectangle(HlpvViewX1, HlpvViewY1, HlpvViewX2, HlpvViewY2);
 Line(HlpvViewX1, HlpvViewY1 + HLPV_TITLEBAR_H - 1,
      HlpvViewX2, HlpvViewY1 + HLPV_TITLEBAR_H - 1);
 { Contenu : runs decales par HlpvScrollY }
 For I := 1 To HlpvNumRuns Do Begin
  SY := HlpvViewY1 + HLPV_TITLEBAR_H + HlpvRuns[I].Y - HlpvScrollY;
  If (SY >= HlpvViewY1 + HLPV_TITLEBAR_H) And
     (SY + HLPV_LINE_HEIGHT <= HlpvViewY2) Then
   HlpvDrawRun(HlpvRuns[I], SY);
 End;
 { Indicateur d aide en bas }
 SetColor(CLR_BORDER);
 Bar(HlpvViewX1 + 1, HlpvViewY2 - 14,
     HlpvViewX2 - 1, HlpvViewY2 - 1);
 SetColor(15);
 OutTextXY(HlpvViewX1 + 6, HlpvViewY2 - 12,
  'Esc=Fermer  Fleches/PgUp/PgDn=Defilement  Clic=Lien  Backspace=Retour');
End;

Procedure HlpvScrollBy(Delta: Integer);
Var MaxScroll: Integer;
Begin
 MaxScroll := HlpvDocHeight - (HlpvViewY2 - HlpvViewY1 - HLPV_TITLEBAR_H - 16);
 If MaxScroll < 0 Then MaxScroll := 0;
 Inc(HlpvScrollY, Delta);
 If HlpvScrollY < 0 Then HlpvScrollY := 0;
 If HlpvScrollY > MaxScroll Then HlpvScrollY := MaxScroll;
End;

Procedure HlpvNavigateTo(NewIdx: Integer);
Begin
 If (NewIdx < 1) Or (NewIdx > HlpvNumTopics) Then Exit;
 If HlpvHistCount < 32 Then Begin
  Inc(HlpvHistCount);
  HlpvBackHistory[HlpvHistCount] := HlpvCurTopic;
 End;
 HlpvCurTopic := NewIdx;
 HlpvScrollY := 0;
 HlpvLayoutTopic(HlpvCurTopic, HlpvViewX2 - HlpvViewX1 - 16);
End;

Procedure HlpvNavigateBack;
Begin
 If HlpvHistCount <= 0 Then Exit;
 HlpvCurTopic := HlpvBackHistory[HlpvHistCount];
 Dec(HlpvHistCount);
 HlpvScrollY := 0;
 HlpvLayoutTopic(HlpvCurTopic, HlpvViewX2 - HlpvViewX1 - 16);
End;

Procedure HlpvHandleClick(MX, MY: Integer);
Var
 I, SY: Integer;
 NewIdx: Integer;
Begin
 { Clic sur [X] ? }
 If (MY >= HlpvViewY1) And (MY < HlpvViewY1 + HLPV_TITLEBAR_H) And
    (MX >= HlpvViewX2 - 18) And (MX <= HlpvViewX2 - 2) Then Begin
  HlpvDone := True;
  Exit;
 End;
 { Clic sur un run hot ? }
 For I := 1 To HlpvNumRuns Do Begin
  If Not HlpvRuns[I].Hot Then Continue;
  SY := HlpvViewY1 + HLPV_TITLEBAR_H + HlpvRuns[I].Y - HlpvScrollY;
  If (MX >= HlpvViewX1 + HlpvRuns[I].X) And
     (MX < HlpvViewX1 + HlpvRuns[I].X + HlpvRuns[I].W) And
     (MY >= SY) And (MY < SY + HLPV_LINE_HEIGHT) Then Begin
   If HlpvRuns[I].Target <> '' Then Begin
    NewIdx := HlpvFindTopicByContext(HlpvRuns[I].Target);
    If NewIdx > 0 Then HlpvNavigateTo(NewIdx);
   End;
   Exit;
  End;
 End;
End;

{ Boucle modale de la visionneuse. }
Procedure HlpvRun;
Var Ev: TEvent;
Begin
 HlpvDone := False;
 HlpvDraw;
 While Not HlpvDone Do Begin
  PollEvents(Ev);
  If Ev.Kind = EV_NONE Then Continue;
  Case Ev.Kind Of
   EV_KEY_DOWN: Begin
    Case Ev.KeyCode Of
     27: HlpvDone := True;             { Esc }
     72: HlpvScrollBy(-HLPV_LINE_HEIGHT);  { Fleche haut }
     80: HlpvScrollBy(HLPV_LINE_HEIGHT);   { Fleche bas }
     73: HlpvScrollBy(-(HlpvViewY2 - HlpvViewY1) Div 2); { PgUp }
     81: HlpvScrollBy((HlpvViewY2 - HlpvViewY1) Div 2);  { PgDn }
     71: HlpvScrollY := 0;             { Home }
     79: HlpvScrollBy(HlpvDocHeight);   { End }
    End;
    HlpvDraw;
   End;
   EV_KEY_CHAR: Begin
    If Ev.KeyChar = #8 Then HlpvNavigateBack;
    If Ev.KeyChar = #27 Then HlpvDone := True;
    HlpvDraw;
   End;
   EV_MOUSE_DOWN: Begin
    If Ev.MouseBtn = MB_LEFT Then HlpvHandleClick(Ev.MouseX, Ev.MouseY);
    HlpvDraw;
   End;
  End;
 End;
End;

{ Entree principale : affiche le fichier .HLP donne, en partant du
  topic identifie par Context (ou le 1er topic si Context vide). }
Procedure HlpvShow(FileName, Context: String);
Var Idx: Integer;
Begin
 If Not HlpvLoadFile(FileName) Then Begin
  ShowMessageBox('Aide',
   'Impossible de charger le fichier d aide :' + #10 + FileName + #10 +
   'Le fichier est absent, illisible ou n est pas au format WinHelp.',
   MB_OK, MI_WARNING);
  FullRepaintNeeded := True;
  Exit;
 End;
 If Not HlpvLoadTopicFile Then Begin
  ShowMessageBox('Aide',
   'Le fichier |TOPIC interne est introuvable ou corrompu :' + #10 + FileName,
   MB_OK, MI_WARNING);
  If HlpvFileBuf <> Nil Then Begin
   FreeMem(HlpvFileBuf, HlpvFileLen); HlpvFileBuf := Nil;
  End;
  FullRepaintNeeded := True;
  Exit;
 End;
 HlpvScanTopics;
 HlpvLoadContext;
 HlpvLoadSystemTitle;
 If HlpvNumTopics = 0 Then Begin
  ShowMessageBox('Aide',
   'Le fichier d aide ne contient aucun topic.',
   MB_OK, MI_WARNING);
  If HlpvTopicData <> Nil Then Begin
   FreeMem(HlpvTopicData, HlpvTopicLen); HlpvTopicData := Nil;
  End;
  FreeMem(HlpvFileBuf, HlpvFileLen); HlpvFileBuf := Nil;
  FullRepaintNeeded := True;
  Exit;
 End;
 { Topic initial }
 Idx := 0;
 If Context <> '' Then Idx := HlpvFindTopicByContext(Context);
 If Idx = 0 Then Idx := 1;
 HlpvCurTopic := Idx;
 HlpvScrollY := 0;
 HlpvHistCount := 0;
 { Geometrie : centre dans la zone editeur }
 HlpvViewX1 := 8;
 HlpvViewY1 := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + 8;
 HlpvViewX2 := GetScreenWidth - 8;
 HlpvViewY2 := GetScreenHeight - 24;
 HlpvLayoutTopic(HlpvCurTopic, HlpvViewX2 - HlpvViewX1 - 16);
 HlpvRun;
 { Liberation }
 If HlpvTopicData <> Nil Then Begin
  FreeMem(HlpvTopicData, HlpvTopicLen); HlpvTopicData := Nil;
 End;
 If HlpvFileBuf <> Nil Then Begin
  FreeMem(HlpvFileBuf, HlpvFileLen); HlpvFileBuf := Nil;
 End;
 FullRepaintNeeded := True;
End;

{ Verifie si une chaine se termine par un suffixe donne (insensible a la casse). }
Function HlpvEndsWith(S, Suffix: String): Boolean;
Var I, L1, L2: Integer; C1, C2: Char;
Begin
 HlpvEndsWith := False;
 L1 := Length(S); L2 := Length(Suffix);
 If L2 > L1 Then Exit;
 For I := 1 To L2 Do Begin
  C1 := S[L1 - L2 + I]; C2 := Suffix[I];
  If (C1 >= 'a') And (C1 <= 'z') Then C1 := Chr(Ord(C1) - 32);
  If (C2 >= 'a') And (C2 <= 'z') Then C2 := Chr(Ord(C2) - 32);
  If C1 <> C2 Then Exit;
 End;
 HlpvEndsWith := True;
End;

{ Recherche BaseName dans :
    - <ExeDir>\HELP\DEVENV\
    - .\HELP\DEVENV\
    - <ExeDir>\
    - .\
  Si l extension est .HLP : ouverture dans la visionneuse WinHelp dediee.
  Sinon : ouverture dans un editeur de texte (comportement historique). }
Procedure OpenHelpFile(BaseName: String; Context: String);
Var
 Candidates: Array[1..5] Of String;
 FN, ExeDir: String;
 I, Idx: Integer;
 Found: Boolean;
Begin
 ExeDir := ExtractFilePath(ParamStr(0));
 Candidates[1] := ExeDir + 'HELP\DEVENV\' + BaseName;
 Candidates[2] := 'HELP\DEVENV\' + BaseName;
 Candidates[3] := ExeDir + BaseName;
 Candidates[4] := BaseName;
 Candidates[5] := '..\HELP\DEVENV\' + BaseName;
 Found := False;
 FN := '';
 For I := 1 To 5 Do
  If (Not Found) And FileExists(Candidates[I]) Then Begin
   FN := Candidates[I];
   Found := True;
  End;
 If Not Found Then Begin
  ShowMessageBox('Documentation',
   'Le fichier d aide ' + BaseName + ' est introuvable.' + #10 +
   'Verifiez que le dossier HELP\DEVENV est present a cote' + #10 +
   'de l executable DEVENV.EXE et qu il contient les' + #10 +
   'fichiers .HLP generes par HC.PAS.',
   MB_OK, MI_WARNING);
  FullRepaintNeeded := True;
  Exit;
 End;
 { Pour les fichiers .HLP : visionneuse WinHelp dediee (rendu RTF
   formate, hyperliens cliquables, navigation par contexte). }
 If HlpvEndsWith(FN, '.HLP') Then Begin
  HlpvShow(FN, Context);
  Exit;
 End;
 If EditorReady Then SyncActiveWindowOut;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 Idx := FindEditorByFileName(FN);
 If Idx >= 0 Then Begin
  ActivateWindow(Idx);
  FullRepaintNeeded := True;
  Exit;
 End;
 CreateEditorWindow(FN);
 Idx := WinMgr.ActiveIdx;
 LoadFile(Editors[Idx]^.Buffer, FN);
 ActiveEditor := Editors[Idx]^;
 EditorReady := True;
 FullRepaintNeeded := True;
End;

{ --- Sauvegarder l etat de la fenetre active (texte ou hexa) dans
  son tableau de stockage --- }

Procedure SyncActiveWindowOut;
Begin
 If (WinMgr.ActiveIdx < 0) Or (WinMgr.ActiveIdx >= WinMgr.WinCount) Then
  Exit;
 If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX Then Begin
  If HexEditors[WinMgr.ActiveIdx] <> Nil Then
   HexEditors[WinMgr.ActiveIdx]^ := ActiveHexEditor;
 End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_FORM Then Begin
  If FormEditors[WinMgr.ActiveIdx] <> Nil Then
   FormEditors[WinMgr.ActiveIdx]^ := ActiveFormEditor;
 End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_EXTMGR Then Begin
  { Rien a synchroniser : ExtMgr est un singleton global, pas un etat  }
  { par-index comme HexEditors[]/FormEditors[]. }
 End Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_EMU Then Begin
  { Stage 2 : met en securite le panneau ET (pour C64) tout l etat qui vit  }
  { hors de TEmulatorPanel, dans des globales partagees CPU6502_*/C64_*.   }
  EmuTabs[WinMgr.ActiveIdx] := EmuPanel;
  If EmuPanel.TargetCPU = '-CC64' Then
   C64_SaveState(C64Snaps[WinMgr.ActiveIdx])
  Else If EmuPanel.TargetCPU = '-CNES' Then
   Nes_SaveState(NesSnaps[WinMgr.ActiveIdx])
  Else If EmuPanel.TargetCPU = '-CATARI2600' Then
   A2600_SaveState(A2600Snaps[WinMgr.ActiveIdx])
  Else If (EmuPanel.TargetCPU = '-CCOCO3') Or (EmuPanel.TargetCPU = '-CDRAGON32') Or
          (EmuPanel.TargetCPU = '-CDRAGON64') Or (EmuPanel.TargetCPU = '-CTO7') Or
          (EmuPanel.TargetCPU = '-CTO8') Or (EmuPanel.TargetCPU = '-CMO5') Then
   { Reutilise Coco3_SaveState/Coco3Snaps[] pour les 2 modes CoCo3 (materiel  }
   { ET texte, voir StepEmulator) ET Dragon32/64/TO7/TO8/MO5 - tous ne          }
   { partagent que le coeur M6809, deja entierement capture par ce type. }
   Coco3_SaveState(Coco3Snaps[WinMgr.ActiveIdx])
  Else If (EmuPanel.TargetCPU = '-CAPPLEII') Or (EmuPanel.TargetCPU = '-CATARI400') Or
          (EmuPanel.TargetCPU = '-CATARI800') Then
   AppleAtari_SaveState(AppleAtariSnaps[WinMgr.ActiveIdx])
  Else If (EmuPanel.TargetCPU = '-C68000') Or (EmuPanel.TargetCPU = '-CATARIST') Or
          (EmuPanel.TargetCPU = '-CAMIGA') Then
   M68K_SaveState(M68KSnaps[WinMgr.ActiveIdx])
  Else If EmuPanel.TargetCPU = '-CCRAY1' Then
   Cray_SaveState(CraySnaps[WinMgr.ActiveIdx])
  Else If EmuPanel.TargetCPU = '-CPCODE' Then
   PCode2_SaveState(PCode2Snaps[WinMgr.ActiveIdx])
  Else If (EmuPanel.TargetCPU = '-CTRS80') Or (EmuPanel.TargetCPU = '-CMSX') Or
          (EmuPanel.TargetCPU = '-CADAM') Then
   Z80_SaveState(Z80Snaps[WinMgr.ActiveIdx])
  Else If (EmuPanel.TargetCPU = '-CD') Or (EmuPanel.TargetCPU = '-CP') Then
   DOS_SaveState(DOSSnaps[WinMgr.ActiveIdx])
  Else If EmuPanel.TargetCPU = '-CWIN16' Then
   Win16_SaveVideoState;
 End Else Begin
  If Editors[WinMgr.ActiveIdx] <> Nil Then
   Editors[WinMgr.ActiveIdx]^ := ActiveEditor;
 End;
End;

{ --- Restaurer dans ActiveEditor/ActiveHexEditor/ActiveFormEditor/EmuPanel
  l etat stocke de la fenetre Idx (texte, hexa, apercu formulaire ou
  emulateur) --- }

Procedure SyncActiveWindowIn(Idx: Integer);
Begin
 If (Idx < 0) Or (Idx >= WinMgr.WinCount) Then Exit;
 { Stage 2 : par defaut, masquer le panneau emulateur - la branche WK_EMU  }
 { ci-dessous le restaure a son etat sauvegarde (visible ou non) si          }
 { l onglet cible en est bien un ; sinon, on bascule vers un onglet texte/  }
 { hexa/formulaire, qui ne doit jamais laisser le panneau emulateur d un      }
 { AUTRE onglet rester affiche par-dessus. }
 EmuPanel.Base.Visible := False;
 If WinMgr.Windows[Idx].Kind = WK_HEX Then Begin
  If HexEditors[Idx] <> Nil Then
   ActiveHexEditor := HexEditors[Idx]^;
 End Else If WinMgr.Windows[Idx].Kind = WK_FORM Then Begin
  If FormEditors[Idx] <> Nil Then
   ActiveFormEditor := FormEditors[Idx]^;
 End Else If WinMgr.Windows[Idx].Kind = WK_EXTMGR Then Begin
  { Rien a restaurer : ExtMgr est un singleton global. }
 End Else If WinMgr.Windows[Idx].Kind = WK_EMU Then Begin
  EmuPanel := EmuTabs[Idx];
  If EmuPanel.TargetCPU = '-CC64' Then C64_LoadState(C64Snaps[Idx])
  Else If EmuPanel.TargetCPU = '-CNES' Then Nes_LoadState(NesSnaps[Idx])
  Else If EmuPanel.TargetCPU = '-CATARI2600' Then A2600_LoadState(A2600Snaps[Idx])
  Else If (EmuPanel.TargetCPU = '-CCOCO3') Or (EmuPanel.TargetCPU = '-CDRAGON32') Or
          (EmuPanel.TargetCPU = '-CDRAGON64') Or (EmuPanel.TargetCPU = '-CTO7') Or
          (EmuPanel.TargetCPU = '-CTO8') Or (EmuPanel.TargetCPU = '-CMO5') Then
   Coco3_LoadState(Coco3Snaps[Idx])
  Else If (EmuPanel.TargetCPU = '-CAPPLEII') Or (EmuPanel.TargetCPU = '-CATARI400') Or
          (EmuPanel.TargetCPU = '-CATARI800') Then
   AppleAtari_LoadState(AppleAtariSnaps[Idx])
  Else If (EmuPanel.TargetCPU = '-C68000') Or (EmuPanel.TargetCPU = '-CATARIST') Or
          (EmuPanel.TargetCPU = '-CAMIGA') Then
   M68K_LoadState(M68KSnaps[Idx])
  Else If EmuPanel.TargetCPU = '-CCRAY1' Then
   Cray_LoadState(CraySnaps[Idx])
  Else If EmuPanel.TargetCPU = '-CPCODE' Then
   PCode2_LoadState(PCode2Snaps[Idx])
  Else If (EmuPanel.TargetCPU = '-CTRS80') Or (EmuPanel.TargetCPU = '-CMSX') Or
          (EmuPanel.TargetCPU = '-CADAM') Then
   Z80_LoadState(Z80Snaps[Idx])
  Else If (EmuPanel.TargetCPU = '-CD') Or (EmuPanel.TargetCPU = '-CP') Then
   DOS_LoadState(DOSSnaps[Idx])
  Else If EmuPanel.TargetCPU = '-CWIN16' Then
   Win16_LoadVideoState;
  { Naviguer VERS un onglet emulateur vaut "focus" - reprend l affichage   }
  { "En cours d execution..." (pas "En pause") des le prochain idle-tick,  }
  { coherent avec le fait que StepEmulator ne fait avancer QUE l onglet     }
  { actif de toute facon (voir Stage 1/2). }
  EmuHasFocus := True;
  EmuLastActiveState := True;
  If EmuPanel.StatusMsg = 'En pause (cliquez sur l''ecran pour reprendre)' Then
   EmuPanel.StatusMsg := '';
 End Else Begin
  If Editors[Idx] <> Nil Then
   ActiveEditor := Editors[Idx]^;
 End;
End;

{ --- Fermer une fenetre d editeur --- }

Procedure CloseEditorWindow(Index: Integer);
Var
 I: Integer;
 ClosingDOSCPU: String;
Begin
 If (Index < 0) Or (Index >= WinMgr.WinCount) Then Exit;
 { Onglet DOS/8086 (Stage 2) : contrairement aux autres backends (dont les  }
 { snapshots sont de simples copies de valeurs), DOS_SaveState/LoadState     }
 { echangent des POINTEURS geants (video 256 Ko, XMS jusqu a 64 Mo, EMS     }
 { jusqu a 32 Mo, memoire etendue DPMI jusqu a 64 Mo - voir TDOSSnapshot) -  }
 { fermer un onglet DOS sans liberer explicitement ces tampons serait une   }
 { vraie fuite memoire (jusqu a ~160 Mo par onglet DOS ferme, si XMS/EMS/   }
 { DPMI etaient actifs pour ce programme). L onglet ACTIF garde ses          }
 { pointeurs dans les GLOBALES (EmuVideo.Mem/EmuXmsMem/EmuEmsMem/            }
 { EmuDpmiExtMem) ; un onglet INACTIF les garde dans DOSSnaps[Index]. }
 If WinMgr.Windows[Index].Kind = WK_EMU Then Begin
  If Index = WinMgr.ActiveIdx Then ClosingDOSCPU := EmuPanel.TargetCPU
  Else ClosingDOSCPU := EmuTabs[Index].TargetCPU;
  If (ClosingDOSCPU = '-CD') Or (ClosingDOSCPU = '-CP') Then Begin
   If Index = WinMgr.ActiveIdx Then Begin
    If EmuVideo.Mem <> Nil Then Begin Dispose(EmuVideo.Mem); EmuVideo.Mem := Nil; EmuVideo.MemReady := False; End;
    If EmuXmsMem <> Nil Then Begin Dispose(EmuXmsMem); EmuXmsMem := Nil; End;
    If EmuEmsMem <> Nil Then Begin Dispose(EmuEmsMem); EmuEmsMem := Nil; End;
    If EmuDpmiExtMem <> Nil Then Begin Dispose(EmuDpmiExtMem); EmuDpmiExtMem := Nil; End;
   End Else Begin
    If DOSSnaps[Index].Video.Mem <> Nil Then Dispose(DOSSnaps[Index].Video.Mem);
    If DOSSnaps[Index].XmsMemPtr <> Nil Then Dispose(DOSSnaps[Index].XmsMemPtr);
    If DOSSnaps[Index].EmsMemPtr <> Nil Then Dispose(DOSSnaps[Index].EmsMemPtr);
    If DOSSnaps[Index].DpmiExtMemPtr <> Nil Then Dispose(DOSSnaps[Index].DpmiExtMemPtr);
    FillChar(DOSSnaps[Index], SizeOf(DOSSnaps[Index]), 0);
   End;
  End;
 End;
 { Liberer l editeur, l editeur hexadecimal ou l apercu de formulaire }
 If Editors[Index] <> Nil Then Begin
  Dispose(Editors[Index]);
  Editors[Index] := Nil;
 End;
 If HexEditors[Index] <> Nil Then Begin
  FreeHexEditor(HexEditors[Index]^);
  Dispose(HexEditors[Index]);
  HexEditors[Index] := Nil;
 End;
 If FormEditors[Index] <> Nil Then Begin
  FreeFormEditor(FormEditors[Index]^);
  Dispose(FormEditors[Index]);
  FormEditors[Index] := Nil;
 End;
 { Onglet emulateur (Stage 2) : rien a Dispose (EmuTabs[]/C64Snaps[] sont   }
 { des enregistrements simples, pas des pointeurs) - juste s assurer que    }
 { l emulateur ne continue pas de tourner "fantome" si c est l onglet ACTIF }
 { qu on ferme (sinon StepEmulator continuerait de piloter EmuPanel meme     }
 { apres la fermeture visuelle de son onglet). }
 If (WinMgr.Windows[Index].Kind = WK_EMU) And (Index = WinMgr.ActiveIdx) Then
  EmuPanel.Running := False;
 { Decaler les fenetres et editeurs suivants }
 For I := Index To WinMgr.WinCount - 2 Do Begin
  WinMgr.Windows[I] := WinMgr.Windows[I + 1];
  WinMgr.Windows[I].TabIndex := I;
  Editors[I] := Editors[I + 1];
  HexEditors[I] := HexEditors[I + 1];
  FormEditors[I] := FormEditors[I + 1];
  EmuTabs[I] := EmuTabs[I + 1];
  C64Snaps[I] := C64Snaps[I + 1];
  NesSnaps[I] := NesSnaps[I + 1];
  A2600Snaps[I] := A2600Snaps[I + 1];
  Coco3Snaps[I] := Coco3Snaps[I + 1];
  AppleAtariSnaps[I] := AppleAtariSnaps[I + 1];
  M68KSnaps[I] := M68KSnaps[I + 1];
  CraySnaps[I] := CraySnaps[I + 1];
  PCode2Snaps[I] := PCode2Snaps[I + 1];
  Z80Snaps[I] := Z80Snaps[I + 1];
  DOSSnaps[I] := DOSSnaps[I + 1];
 End;
 Editors[WinMgr.WinCount - 1] := Nil;
 HexEditors[WinMgr.WinCount - 1] := Nil;
 FormEditors[WinMgr.WinCount - 1] := Nil;
 Dec(WinMgr.WinCount);
 { Ajuster l index actif }
 If WinMgr.WinCount = 0 Then Begin
  WinMgr.ActiveIdx := -1;
  EditorReady := False;
  { BOGUE REEL signale par l utilisateur 2026-08-15 : fermer le DERNIER      }
  { onglet restant, quand c est un onglet emulateur, laissait le panneau      }
  { emulateur visible a l ecran indefiniment ("l emulateur reste ouvert").   }
  { Cause : EmuPanel.Base.Visible n est jamais remis a False QUE dans          }
  { SyncActiveWindowIn (voir plus haut), qui n est jamais appelee ici          }
  { puisqu il n y a plus aucune fenetre vers laquelle basculer. }
  EmuPanel.Base.Visible := False;
 End Else Begin
  If WinMgr.ActiveIdx >= WinMgr.WinCount Then
   WinMgr.ActiveIdx := WinMgr.WinCount - 1;
  { Restaurer l editeur actif }
  SyncActiveWindowIn(WinMgr.ActiveIdx);
 End;
End;

{ --- Activer une fenetre --- }

Procedure ActivateWindow(Index: Integer);
Begin
 If (Index >= 0) And (Index < WinMgr.WinCount) Then Begin
  { Sauvegarder l editeur actuel }
  SyncActiveWindowOut;
  { Activer la nouvelle fenetre }
  WinMgr.ActiveIdx := Index;
  { Restaurer l editeur selectionne }
  SyncActiveWindowIn(Index);
 End;
End;

{ --- Obtenir la fenetre active --- }

Function GetActiveWindow: Integer;
Begin
 GetActiveWindow := WinMgr.ActiveIdx;
End;

{ --- Fenetre suivante --- }

Procedure NextWindow;
Begin
 If WinMgr.WinCount <= 1 Then Exit;
 { Stage 2 (2026-08-15) : BOGUE PREEXISTANT trouve pendant le test des        }
 { onglets emulateur - cette procedure ne changeait QUE WinMgr.ActiveIdx,     }
 { sans jamais appeler SyncActiveWindowOut/In, donc ActiveEditor/EmuPanel      }
 { (et l affichage) ne suivaient jamais le nouvel index actif (Ctrl+F6         }
 { semblait ne rien faire). Meme correctif que ActivateWindow. }
 SyncActiveWindowOut;
 WinMgr.ActiveIdx := (WinMgr.ActiveIdx + 1) Mod WinMgr.WinCount;
 SyncActiveWindowIn(WinMgr.ActiveIdx);
End;

{ --- Fenetre precedente --- }

Procedure PreviousWindow;
Begin
 If WinMgr.WinCount <= 1 Then Exit;
 SyncActiveWindowOut;
 If WinMgr.ActiveIdx > 0 Then
  Dec(WinMgr.ActiveIdx)
 Else
  WinMgr.ActiveIdx := WinMgr.WinCount - 1;
 SyncActiveWindowIn(WinMgr.ActiveIdx);
End;

{ --- Calculer la largeur d un onglet --- }

Function TabWidth(Index: Integer): Integer;
Var
 W: Integer;
 T: String;
Begin
 T := WinMgr.Windows[Index].Title;
 If WinMgr.Windows[Index].Modified Then
  T := '*' + T;
 W := Length(T) * 8 + TAB_PADDING * 2 + TAB_CLOSE_SIZE + 4;
 If W > TAB_MAX_WIDTH Then
  W := TAB_MAX_WIDTH;
 TabWidth := W;
End;

{ --- Dessiner les onglets --- }

Procedure DrawWindowTabs;
Var
 I, TX, TW, TY: Integer;
 Lbl: String;
Begin
 TY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT;
 { Fond de la barre d onglets }
 SetColor(CLR_BACKGROUND);
 { Correctif 2026-08-15 : voir DrawMenuBar - Bar() suit SetFillStyle, pas }
 { SetColor. }
 SetFillStyle(SolidFill, CLR_BACKGROUND);
 Bar(0, TY, GetScreenWidth - EXPLORER_WIDTH - 1, TY + TAB_HEIGHT - 1);
 TX := 0 - WinMgr.TabScrollX;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  TW := TabWidth(I);
  If (TX + TW > 0) And (TX < GetScreenWidth - EXPLORER_WIDTH) Then Begin
   { Fond de l onglet }
   If I = WinMgr.ActiveIdx Then Begin
    SetColor(CLR_EDITOR_BG);
    SetFillStyle(SolidFill, CLR_EDITOR_BG);
    Bar(TX, TY, TX + TW - 1, TY + TAB_HEIGHT - 1);
   End Else Begin
    SetColor(CLR_BACKGROUND);
    SetFillStyle(SolidFill, CLR_BACKGROUND);
    Bar(TX, TY, TX + TW - 1, TY + TAB_HEIGHT - 1);
    SetColor(CLR_BORDER);
    Rectangle(TX, TY, TX + TW - 1, TY + TAB_HEIGHT - 1);
   End;
   { Texte de l onglet }
   Lbl := WinMgr.Windows[I].Title;
   If WinMgr.Windows[I].Modified Then
    Lbl := '*' + Lbl;
   If Length(Lbl) > 18 Then
    Lbl := Copy(Lbl, 1, 15) + '...';
   SetColor(CLR_MENU_TEXT);
   OutTextXY(TX + TAB_PADDING, TY + 4, Lbl);
   { Bouton de fermeture (X) }
   SetColor(CLR_BORDER);
   OutTextXY(TX + TW - TAB_CLOSE_SIZE - 2, TY + 4, 'x');
  End;
  TX := TX + TW;
 End;
 { Ligne de separation sous les onglets }
 SetColor(CLR_BORDER);
 Line(0, TY + TAB_HEIGHT - 1,
      GetScreenWidth - EXPLORER_WIDTH - 1, TY + TAB_HEIGHT - 1);
End;

{ --- Test de clic sur les onglets --- }

Function TabHitTest(MX, MY: Integer): Integer;
Var
 I, TX, TW, TY: Integer;
Begin
 TabHitTest := -1;
 TY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT;
 If (MY < TY) Or (MY >= TY + TAB_HEIGHT) Then Exit;
 If MX < 0 Then Exit;
 TX := 0 - WinMgr.TabScrollX;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  TW := TabWidth(I);
  If (MX >= TX) And (MX < TX + TW) Then Begin
   TabHitTest := I;
   Exit;
  End;
  TX := TX + TW;
 End;
End;

{ --- Test de clic sur le bouton de fermeture d un onglet --- }

Function TabCloseHitTest(MX, MY: Integer; TabIdx: Integer): Boolean;
Var
 TX, TW, TY, CX: Integer;
 I: Integer;
Begin
 TabCloseHitTest := False;
 If (TabIdx < 0) Or (TabIdx >= WinMgr.WinCount) Then Exit;
 TY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT;
 TX := 0 - WinMgr.TabScrollX;
 For I := 0 To TabIdx - 1 Do
  TX := TX + TabWidth(I);
 TW := TabWidth(TabIdx);
 CX := TX + TW - TAB_CLOSE_SIZE - 2;
 If (MX >= CX) And (MX < CX + TAB_CLOSE_SIZE) And
    (MY >= TY + 2) And (MY < TY + TAB_HEIGHT - 2) Then
  TabCloseHitTest := True;
End;

{ --- Gestion des evenements des onglets --- }

Procedure HandleTabEvent(Var Ev: TEvent);
Var
 Hit: Integer;
Begin
 If Ev.Kind = EV_MOUSE_DOWN Then Begin
  Hit := TabHitTest(Ev.MouseX, Ev.MouseY);
  If Hit >= 0 Then Begin
   If TabCloseHitTest(Ev.MouseX, Ev.MouseY, Hit) Then Begin
    CloseEditorWindow(Hit);
    { BOGUE REEL signale par l utilisateur 2026-08-15 (2e volet du meme      }
    { rapport que le correctif EmuPanel.Base.Visible ci-dessus, dans          }
    { CloseEditorWindow) : cliquer sur le "x" d un onglet ne redessinait      }
    { QUE la barre d onglets elle-meme - contrairement aux autres chemins     }
    { de fermeture (Ctrl+W, Fermer la solution, Echap dans le panneau         }
    { emulateur) qui positionnent tous FullRepaintNeeded apres avoir           }
    { ferme l onglet. Consequence : meme une fois EmuPanel.Base.Visible       }
    { correctement remis a False, les anciens pixels du panneau emulateur    }
    { restaient affiches a l ecran (jamais effaces/redessines par-dessus)     }
    { jusqu au prochain evenement qui declenchait un repaint complet par      }
    { ailleurs. }
    FullRepaintNeeded := True;
    DrawWindowTabs;
   End Else Begin
    ActivateWindow(Hit);
    DrawWindowTabs;
   End;
  End;
 End;
End;

{ --- Sauvegarder toutes les fenetres --- }

Procedure SaveAllWindows;
Var
 I: Integer;
 FN: String;
Begin
 { Synchroniser la fenetre active avant de sauvegarder }
 If EditorReady Then SyncActiveWindowOut;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  If (Editors[I] <> Nil) And Editors[I]^.Buffer.Modified Then Begin
   FN := WinMgr.Windows[I].FileName;
   If FN <> '' Then Begin
    SaveFile(Editors[I]^.Buffer, FN);
    WinMgr.Windows[I].Modified := False;
   End;
  End;
  If (HexEditors[I] <> Nil) And HexEditors[I]^.Modified Then Begin
   FN := WinMgr.Windows[I].FileName;
   If FN <> '' Then Begin
    SaveFileHex(HexEditors[I]^, FN);
    WinMgr.Windows[I].Modified := False;
   End;
  End;
 End;
End;

{ --- Fermer toutes les fenetres --- }

Procedure CloseAllWindows;
Begin
 WinMgr.WinCount := 0;
 WinMgr.ActiveIdx := -1;
End;

{ --- Disposition en mosaique --- }

Procedure ArrangeTile;
Var
 I, Cols, Rows, C, R, W, H, ZX, ZY, ZW, ZH: Integer;
Begin
 If WinMgr.WinCount <= 0 Then Exit;
 { Zone d edition }
 ZX := 0;
 ZY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
 ZW := GetScreenWidth - EXPLORER_WIDTH;
 ZH := GetScreenHeight - MENUBAR_HEIGHT - TOOLBAR_HEIGHT
       - TAB_HEIGHT - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 { Calcul grille }
 Cols := 1;
 While Cols * Cols < WinMgr.WinCount Do Inc(Cols);
 Rows := (WinMgr.WinCount + Cols - 1) Div Cols;
 W := ZW Div Cols;
 H := ZH Div Rows;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  C := I Mod Cols;
  R := I Div Cols;
  WinMgr.Windows[I].X := ZX + C * W;
  WinMgr.Windows[I].Y := ZY + R * H;
  WinMgr.Windows[I].Width := W;
  WinMgr.Windows[I].Height := H;
  WinMgr.Windows[I].Maximized := False;
  WinMgr.Windows[I].Minimized := False;
 End;
End;

{ --- Disposition en cascade --- }

Procedure ArrangeCascade;
Var
 I, ZX, ZY, ZW, ZH, Offset: Integer;
Begin
 If WinMgr.WinCount <= 0 Then Exit;
 ZX := 0;
 ZY := MENUBAR_HEIGHT + TOOLBAR_HEIGHT + TAB_HEIGHT;
 ZW := GetScreenWidth - EXPLORER_WIDTH;
 ZH := GetScreenHeight - MENUBAR_HEIGHT - TOOLBAR_HEIGHT
       - TAB_HEIGHT - OUTPUT_HEIGHT - STATUSBAR_HEIGHT;
 Offset := 20;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  WinMgr.Windows[I].X := ZX + I * Offset;
  WinMgr.Windows[I].Y := ZY + I * Offset;
  WinMgr.Windows[I].Width := ZW - (WinMgr.WinCount - 1) * Offset;
  WinMgr.Windows[I].Height := ZH - (WinMgr.WinCount - 1) * Offset;
  WinMgr.Windows[I].Maximized := False;
  WinMgr.Windows[I].Minimized := False;
 End;
End;

{ --- Fractionner la vue --- }

Procedure SplitView;
Begin
 If WinMgr.SplitMode Then Begin
  WinMgr.SplitMode := False;
  WinMgr.SplitPos := 0;
 End Else Begin
  WinMgr.SplitMode := True;
  WinMgr.SplitPos := (GetScreenWidth - EXPLORER_WIDTH) Div 2;
 End;
End;

{ --- Compter les fenetres ouvertes --- }

Function CountEditorWindows: Integer;
Begin
 CountEditorWindows := WinMgr.WinCount;
End;

{ --- Compter les fenetres modifiees --- }

Function CountModifiedWindows: Integer;
Var
 I, Total: Integer;
Begin
 { Synchroniser la fenetre active dans le tableau }
 If EditorReady Then SyncActiveWindowOut;
 Total := 0;
 For I := 0 To WinMgr.WinCount - 1 Do Begin
  If (Editors[I] <> Nil) And Editors[I]^.Buffer.Modified Then
   Inc(Total);
  If (HexEditors[I] <> Nil) And HexEditors[I]^.Modified Then
   Inc(Total);
 End;
 CountModifiedWindows := Total;
End;

{ --- Trouver une fenetre par nom de fichier --- }

Function FindWindowByFileName(AFileName: String): Integer;
Var
 I: Integer;
Begin
 FindWindowByFileName := -1;
 For I := 0 To WinMgr.WinCount - 1 Do
  If WinMgr.Windows[I].FileName = AFileName Then Begin
   FindWindowByFileName := I;
   Exit;
  End;
End;

{ --- Determiner si un index de fenetre est valide --- }

Function IsValidWindowIndex(Index: Integer): Boolean;
Begin
 IsValidWindowIndex := (Index >= 0) And (Index < WinMgr.WinCount);
End;

{ --- Obtenir le titre d une fenetre --- }

Function GetWindowTitle(Index: Integer): String;
Begin
 If IsValidWindowIndex(Index) Then
