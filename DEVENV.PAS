{ --- Sauvegarder le fichier source courant --- }

Procedure HandleSaveCurrentFile;
Var
 FN: String;
Begin
 If Not EditorReady Then Begin
  AppendOutput(OutputPanel, 'Aucun fichier ouvert a enregistrer.',
   Ord(OTK_BUILD));
  Exit;
 End;
 If (WinMgr.ActiveIdx >= 0) And
    (WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX) Then Begin
  FN := WinMgr.Windows[WinMgr.ActiveIdx].FileName;
  If FN = '' Then Begin
   AppendOutput(OutputPanel, 'Aucun nom de fichier.',
    Ord(OTK_BUILD));
   Exit;
  End;
  SaveFileHex(ActiveHexEditor, FN);
  MarkWindowSaved(WinMgr.ActiveIdx);
  AppendOutput(OutputPanel, 'Fichier enregistre : ' + FN,
   Ord(OTK_BUILD));
  Exit;
 End;
 FN := '';
 If Opts.SourceFile <> '' Then
  FN := Opts.SourceFile
 Else If WinMgr.ActiveIdx >= 0 Then
  FN := WinMgr.Windows[WinMgr.ActiveIdx].FileName;
 If FN = '' Then Begin
  AppendOutput(OutputPanel, 'Aucun nom de fichier.',
   Ord(OTK_BUILD));
  Exit;
 End;
 SaveFile(ActiveEditor.Buffer, FN);
 AppendOutput(OutputPanel, 'Fichier enregistre : ' + FN,
  Ord(OTK_BUILD));
End;

{ --- Localiser un executable compagnon (PATH, repertoire courant,
  puis repertoire de DEVENV.EXE lui-meme), pour les commandes du
  menu Outils qui invoquent un outil externe de cette meme suite. --- }
Function FindToolExe(Name: String): String;
Var
 FullPath, ExeDir, CurDir: String;
Begin
 FindToolExe := '';
 {$IFDEF WINDOWS}
 FullPath := FSearch(Name + '.exe', GetEnv('PATH'));
 {$ELSE}
 FullPath := FSearch(Name, GetEnv('PATH'));
 {$ENDIF}
 If FullPath <> '' Then Begin
  FindToolExe := FullPath;
  Exit;
 End;
 { Repertoire courant : on construit un chemin absolu plutot que de
   renvoyer le nom nu, car la recherche implicite de l executable
   par cmd.exe dans le repertoire courant n est pas garantie sur
   toutes les configurations (variable NoDefaultCurrentDirectoryInExePath,
   constate sur certains postes) ; un chemin absolu evite toute
   ambiguite, ici comme dans le repertoire de DEVENV.EXE plus bas. }
 GetDir(0, CurDir);
 If CurDir[Length(CurDir)] <> '\' Then CurDir := CurDir + '\';
 {$IFDEF WINDOWS}
 If FileExists(CurDir + Name + '.exe') Then Begin
  FindToolExe := CurDir + Name + '.exe';
  Exit;
 End;
 {$ELSE}
 If FileExists(CurDir + Name) Then Begin
  FindToolExe := CurDir + Name;
  Exit;
 End;
 {$ENDIF}
 { Repertoire de DEVENV.EXE lui-meme : les outils de cette suite
   (COMMENT, OBJDUMP, NM, ...) sont habituellement compiles cote a
   cote avec DEVENV dans le meme repertoire de projet. }
 ExeDir := ExtractFilePath(ParamStr(0));
 {$IFDEF WINDOWS}
 If FileExists(ExeDir + Name + '.exe') Then
  FindToolExe := ExeDir + Name + '.exe';
 {$ELSE}
 If FileExists(ExeDir + Name) Then
  FindToolExe := ExeDir + Name;
 {$ENDIF}
End;

{ --- Outils > COMMENT : ajoute les commentaires manquants au
  fichier actuellement edite, via la commande externe COMMENT
  (COMMENT.PAS), puis recharge l editeur avec le resultat. La
  sortie de la commande (stdout/stderr) est affichee dans l onglet
  "Sortie de build" du panneau de sortie, comme une compilation. --- }
Procedure HandleRunCommentTool;
Const
 CommentTempFile = 'COMMENT.TMP';
Var
 FN, ToolPath, CmdLine: String;
 ExitCode: Integer;
 SavedCursorLine: LongInt;
Begin
 If Not EditorReady Then Begin
  AppendOutput(OutputPanel, 'Aucun fichier ouvert pour COMMENT.',
   Ord(OTK_BUILD));
  Exit;
 End;
 If (WinMgr.ActiveIdx >= 0) And
    (WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX) Then Begin
  AppendOutput(OutputPanel,
   'COMMENT ne s''applique pas a un fichier ouvert en hexadecimal.',
   Ord(OTK_BUILD));
  Exit;
 End;
 FN := '';
 If Opts.SourceFile <> '' Then
  FN := Opts.SourceFile
 Else If WinMgr.ActiveIdx >= 0 Then
  FN := WinMgr.Windows[WinMgr.ActiveIdx].FileName;
 If FN = '' Then Begin
  AppendOutput(OutputPanel, 'Aucun nom de fichier pour COMMENT.',
   Ord(OTK_BUILD));
  Exit;
 End;

 ClearOutput(OutputPanel, Ord(OTK_BUILD));
 OutputPanel.ActiveTab := OTK_BUILD;
 OutputPanel.Visible := True;
 AppendOutput(OutputPanel,
  '------ COMMENT : ' + FN + ' ------', Ord(OTK_BUILD));

 { Le fichier doit refleter le contenu en cours d edition : COMMENT
   travaille sur le fichier disque, pas sur le tampon memoire. }
 SaveFile(ActiveEditor.Buffer, FN);
 If WinMgr.ActiveIdx >= 0 Then
  Editors[WinMgr.ActiveIdx]^ := ActiveEditor;

 ToolPath := FindToolExe('COMMENT');
 If ToolPath = '' Then Begin
  AppendOutputEx(OutputPanel,
   'COMMENT.EXE introuvable (PATH, repertoire courant, ' +
   'repertoire de DEVENV.EXE).',
   Ord(OTK_BUILD), OLK_ERROR, '', 0, 0);
  FullRepaintNeeded := True;
  Exit;
 End;

 { Pas de guillemets ici : ExecuteCompiler ajoute une redirection
   shell (> fichier 2>&1) au bout de CmdLine puis lance le tout via
   "cmd /C ...". La regle de conservation des guillemets de cmd.exe
   n est valide que si la ligne entiere contient EXACTEMENT deux
   guillemets ; en ajouter une seconde paire (autour de FN) en
   introduit quatre, ce qui fait retomber cmd.exe sur son
   comportement historique (il retire le premier et le DERNIER
   guillemet de toute la ligne, avalant au passage la redirection
   dans l argument). Meme limitation, deja acceptee ailleurs dans ce
   fichier (voir BuildCSCCommandLine), pour les chemins avec
   espaces. }
 CmdLine := ToolPath + ' ' + FN;
 AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
 ExitCode := ExecuteCompiler(CmdLine, CommentTempFile);
 ReadOutputFile(CommentTempFile, OutputPanel, Ord(OTK_BUILD));
 CleanupTempFile(CommentTempFile);

 { Recharger l editeur avec le resultat : que COMMENT ait reussi ou
   non, le fichier disque est dans un etat valide (remplace
   uniquement apres confirmation, sinon laisse intact), donc
   recharger est toujours sans risque. }
 LoadFile(ActiveEditor.Buffer, FN);
 SavedCursorLine := ActiveEditor.CursorLine;
 If SavedCursorLine >= ActiveEditor.Buffer.LineCount Then
  SavedCursorLine := ActiveEditor.Buffer.LineCount - 1;
 If SavedCursorLine < 0 Then SavedCursorLine := 0;
 ActiveEditor.CursorLine := SavedCursorLine;
 ActiveEditor.CursorCol := 1;
 ActiveEditor.ScrollLine := 0;
 If WinMgr.ActiveIdx >= 0 Then
  Editors[WinMgr.ActiveIdx]^ := ActiveEditor;

 If ExitCode = 0 Then
  AppendOutputEx(OutputPanel,
   '------ COMMENT termine : ' + FN + ' (editeur recharge) ------',
   Ord(OTK_BUILD), OLK_SUCCESS, '', 0, 0)
 Else
  AppendOutputEx(OutputPanel,
   '------ COMMENT a echoue (code ' + IntToStr(ExitCode) +
   ') : ' + FN + ' ------',
   Ord(OTK_BUILD), OLK_ERROR, '', 0, 0);
 FullRepaintNeeded := True;
End;

{ --- Sauvegarder tous les fichiers ouverts --- }

Procedure HandleSaveAll;
Begin
 If EditorReady Then Begin
  SaveAllWindows;
  AppendOutput(OutputPanel, 'Tous les fichiers enregistres.',
   Ord(OTK_BUILD));
 End;
End;

{ --- Ajouter les fichiers/references d un projet DEJA analyse           }
{ (ParseProjectFile) dans l explorateur de solutions - factorise HORS de     }
{ OpenSolutionFile (voir sa note d en-tete complete) pour etre appelable         }
{ TANT avec CurrentProject (premier projet, MEME convention "projet actif"        }
{ que le reste de l IDE pour Build/Deboguer) QU AVEC un TProject                    }
{ TEMPORAIRE local (deuxieme projet et suivants, dont le contenu n a pas          }
{ besoin de survivre au-dela de cette seule fonction). ---                        }
Procedure AddProjectFilesAndRefsToExplorer(Var Proj: TProject;
 ProjIdx, PropsIdx, RefsIdx: Integer);
Var
 J, NewIdx: Integer;
 FName, DisplayName: String;
 ParentForFile: Integer;
Begin
 { RefsIdx est passe par VALEUR (copie locale) : chaque insertion sous     }
 { PropsIdx decale physiquement tous les noeuds a partir de cette              }
 { position (voir InsertExplorerNodeSlot) - "References" est TOUJOURS le          }
 { frere suivant de "Properties", donc systematiquement decale d un rang           }
 { par CHAQUE fichier imbriquer sous Properties. Sans ce recalage,                    }
 { RefsIdx pointait vers le mauvais noeud (BOGUE REEL observe en test :               }
 { les references .dll apparaissaient imbriquees sous AssemblyInfo.cs). }
 For J := 0 To Proj.FileCount - 1 Do Begin
  FName := Proj.Files[J].FileName;
  { EXTENSION (2026-08-08) : Visual Studio imbrique les fichiers dont le    }
  { chemin commence par "Properties\" (ex. AssemblyInfo.cs, toujours          }
  { genere par le modele de projet .NET classique) SOUS le noeud                  }
  { "Properties" plutot que de les montrer a plat au niveau du projet -            }
  { l utilisateur a fourni une capture d ecran de Visual Studio le                     }
  { confirmant. Le prefixe est retire de la legende affichee puisque le             }
  { noeud parent EST deja "Properties". }
  If (PropsIdx >= 0) And
     ((Pos('PROPERTIES\', UpCaseStr(FName)) = 1) Or
      (Pos('PROPERTIES/', UpCaseStr(FName)) = 1)) Then Begin
   ParentForFile := PropsIdx;
   DisplayName := Copy(FName, Length('Properties') + 2,
    Length(FName) - Length('Properties') - 1);
   SolExplorer.Nodes[PropsIdx].HasChildren := True;
  End Else Begin
   ParentForFile := ProjIdx;
   DisplayName := FName;
  End;
  NewIdx := AddExplorerNode(SolExplorer, DisplayName,
   NodeKindFromExtension(FName), ParentForFile);
  { RelPath (voir sa note dans TExplorerNode) doit rester le chemin REEL }
  { ("Properties\AssemblyInfo.cs"), meme quand Caption est abrege pour     }
  { l affichage - sinon l ouverture du fichier cherche au mauvais endroit. }
  If NewIdx >= 0 Then SolExplorer.Nodes[NewIdx].RelPath := FName;
  If (NewIdx >= 0) And (NewIdx <= RefsIdx) Then Inc(RefsIdx);
 End;
 If RefsIdx >= 0 Then Begin
  For J := 0 To Proj.RefCount - 1 Do
   AddExplorerNode(SolExplorer, Proj.Refs[J].ReferenceName,
    ENK_REFERENCE, RefsIdx);
  SolExplorer.Nodes[RefsIdx].HasChildren := Proj.RefCount > 0;
 End;
End;

{ --- Ouvrir un fichier solution .sln --- }

Procedure OpenSolutionFile(FileName: String);
Var
 I: Integer;
 SolIdx, ProjIdx, PropsIdx, RefsIdx: Integer;
 SolDir: String;
 ProjFile: String;
 TempProj: TProject;
Begin
 { Convertir en chemin absolu pour que ExtractFilePath ne soit pas vide }
 FileName := FExpand(FileName);
 CurrentSolutionFilePath := FileName;
 ParseSolutionFile(FileName, CurrentSolution);
 SolutionLoaded := True;
 SolutionModified := False;
 { Chemin du repertoire de la solution }
 SolDir := CurrentSolution.Info.SolutionPath;
 If Length(SolDir) > 0 Then Begin
  If SolDir[Length(SolDir)] <> '\' Then
   SolDir := SolDir + '\';
 End;
 { Peupler l explorateur avec la solution }
 ClearExplorer(SolExplorer);
 SolIdx := AddExplorerNode(SolExplorer,
  CurrentSolution.Info.SolutionName, ENK_SOLUTION, -1);
 If SolIdx >= 0 Then Begin
  SolExplorer.Nodes[SolIdx].Expanded := True;
  SolExplorer.Nodes[SolIdx].HasChildren :=
   CurrentSolution.ProjectCount > 0;
  For I := 0 To CurrentSolution.ProjectCount - 1 Do Begin
   ProjIdx := AddExplorerNode(SolExplorer,
    CurrentSolution.Projects[I].ProjectName,
    ENK_PROJECT, SolIdx);
   If ProjIdx >= 0 Then Begin
    SolExplorer.Nodes[ProjIdx].Expanded := True;
    SolExplorer.Nodes[ProjIdx].HasChildren := True;
    PropsIdx := AddExplorerNode(SolExplorer, 'Properties',
     ENK_PROPERTIES, ProjIdx);
    If PropsIdx >= 0 Then
     SolExplorer.Nodes[PropsIdx].Expanded := True;
    RefsIdx := AddExplorerNode(SolExplorer, 'References',
     ENK_REFERENCES, ProjIdx);
    { Parser le fichier projet pour charger les fichiers - BOGUE REEL       }
    { (2026-08-08) : "If (I = 0)" limitait CECI au PREMIER projet             }
    { seulement - toute solution a PLUSIEURS projets (le cas normal en             }
    { pratique, ex. une vraie solution Visual Studio) montrait donc un                }
    { arbre "incomplet" pour le deuxieme projet et les suivants                       }
    { (Properties/References vides, AUCUN fichier reel) - symptome                     }
    { signale par l utilisateur. Corrige : TOUS les projets sont analyses,               }
    { celui d indice 0 dans CurrentProject (MEME convention "projet actif"               }
    { pour Build/Deboguer qu ailleurs dans l IDE), les suivants dans un                    }
    { TProject TEMPORAIRE local (TempProj) dont le contenu ne sert qu a                     }
    { peupler l explorateur - voir AddProjectFilesAndRefsToExplorer                          }
    { ci-dessus, factorisee pour ne pas dupliquer cette logique deux fois. }
    If SolDir <> '' Then Begin
     ProjFile := SolDir
      + CurrentSolution.Projects[I].ProjectPath;
     If I = 0 Then Begin
      ParseProjectFile(ProjFile, CurrentProject);
      AddProjectFilesAndRefsToExplorer(CurrentProject, ProjIdx, PropsIdx,
       RefsIdx);
     End Else Begin
      ParseProjectFile(ProjFile, TempProj);
      AddProjectFilesAndRefsToExplorer(TempProj, ProjIdx, PropsIdx, RefsIdx);
     End;
    End;
   End;
  End;
 End;
 If SolExplorer.NodeCount > 0 Then Begin
  SolExplorer.SelectedIdx := 0;
  SolExplorer.Nodes[0].Selected := True;
 End;
 { BOGUE REEL (2026-08-08) : AddExplorerNode met TOUJOURS Visible := True }
 { sur un noeud tout juste cree, sans tenir compte de l etat Expanded de   }
 { ses ancetres - jamais corrige ici car "Properties"/"References"                }
 { n avaient jamais de VRAIS enfants avant (voir AddProjectFilesAndRefsToExplorer)  }
 { donc le symptome (enfants d un noeud REPLIE visibles quand meme) restait          }
 { invisible. RefreshExplorer recalcule Visible pour TOUS les noeuds selon             }
 { la chaine complete de parents (meme logique que ExpandNode/CollapseNode). }
 RefreshExplorer(SolExplorer);
 AddMRUEntry(MRUList, FileName);
 AppendOutput(OutputPanel,
  'Solution ouverte : ' + FileName, Ord(OTK_BUILD));
End;

{ --- Traitement de l ouverture d un dossier --- }

Procedure HandleOpenFolderConfirmed;
Var
 Folder: String;
 SR: SearchRec;
 RootIdx: Integer;
 FolderName: String;
 LastSlash, I: Integer;
Begin
 Folder := FileDlg.CurrentPath;
 If Folder = '' Then Exit;
 { Normaliser le separateur final. }
 If (Folder[Length(Folder)] <> '\') And
    (Folder[Length(Folder)] <> '/') Then
  Folder := Folder + '\';
 { Extraire le nom du dossier (dernier segment). }
 FolderName := Folder;
 If (Length(FolderName) > 0) And
    ((FolderName[Length(FolderName)] = '\') Or
     (FolderName[Length(FolderName)] = '/')) Then
  Dec(FolderName[0]);
 LastSlash := 0;
 For I := 1 To Length(FolderName) Do
  If (FolderName[I] = '\') Or (FolderName[I] = '/') Then
   LastSlash := I;
 If LastSlash > 0 Then
  FolderName := Copy(FolderName, LastSlash + 1,
   Length(FolderName) - LastSlash);
 If FolderName = '' Then FolderName := Folder;
 { Masquer la page de demarrage. }
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 { Reinitialiser l explorateur avec un noeud racine 'dossier'. }
 ClearExplorer(SolExplorer);
 SolutionLoaded := False;
 SolutionModified := False;
 RootIdx := AddExplorerNode(SolExplorer, FolderName,
  ENK_FOLDER, -1);
 If RootIdx >= 0 Then Begin
  SolExplorer.Nodes[RootIdx].Expanded := True;
  { Lister sous-dossiers en premier. }
  FindFirst(Folder + '*.*', Directory, SR);
  While DosError = 0 Do Begin
   If ((SR.Attr And Directory) <> 0) And
      (SR.Name <> '.') And (SR.Name <> '..') And
      (SR.Name[1] <> '.') Then
    AddExplorerNode(SolExplorer, SR.Name, ENK_FOLDER, RootIdx);
   Dos.FindNext(SR);
  End;
  FindClose(SR);
  { Lister fichiers. }
  FindFirst(Folder + '*.*', AnyFile, SR);
  While DosError = 0 Do Begin
   If ((SR.Attr And Directory) = 0) And
      (SR.Name <> '.') And (SR.Name <> '..') Then
    AddExplorerNode(SolExplorer, SR.Name,
     NodeKindFromExtension(SR.Name), RootIdx);
   Dos.FindNext(SR);
  End;
  FindClose(SR);
  SolExplorer.Nodes[RootIdx].HasChildren :=
   SolExplorer.NodeCount > 1;
  SolExplorer.SelectedIdx := RootIdx;
  SolExplorer.Nodes[RootIdx].Selected := True;
 End;
 SolExplorer.NeedRepaint := True;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel,
  'Dossier ouvert : ' + Folder, Ord(OTK_BUILD));
End;

{ --- Traitement de l ouverture d un fichier --- }

Procedure HandleOpenFileConfirmed;
Var
 FN: String;
 Ext: String;
 Idx: Integer;
 I: Integer;
 ProjIdx: Integer;
 RelPath: String;
 ProjDir: String;
 SolDir: String;
Begin
 FN := FileDlg.SelectedFile;
 If FN = '' Then Exit;
 { Sauvegarder la fenetre active avant d en ouvrir une autre }
 If EditorReady Then SyncActiveWindowOut;
 { Masquer la page de demarrage }
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 Ext := UpCaseStr(ExtractFileExt(FN));
 { Fichier solution .sln : ouvrir comme solution }
 If Ext = '.SLN' Then Begin
  OpenSolutionFile(FN);
  FullRepaintNeeded := True;
  Exit;
 End;
 { Fichier source : verifier si deja ouvert }
 Idx := FindEditorByFileName(FN);
 If Idx >= 0 Then Begin
  ActivateWindow(Idx);
  FullRepaintNeeded := True;
  Exit;
 End;
 { Ouvrir dans un nouvel editeur }
 CreateEditorWindow(FN);
 Idx := WinMgr.ActiveIdx;
 { Charger le fichier dans l editeur alloue }
 LoadFile(Editors[Idx]^.Buffer, FN);
 ActiveEditor := Editors[Idx]^;
 Opts.SourceFile := FN;
 EditorReady := True;
 { Ajouter le fichier a l explorateur }
 If (SolExplorer.NodeCount = 0) Or
    (SolExplorer.Nodes[0].Kind <> ENK_SOLUTION) Then Begin
  ClearExplorer(SolExplorer);
  AddExplorerNode(SolExplorer, 'Solution sans nom',
   ENK_SOLUTION, -1);
  SolExplorer.Nodes[0].Expanded := True;
  SolExplorer.Nodes[0].HasChildren := True;
 End;
 { Trouver le premier noeud projet pour y ajouter le fichier }
 ProjIdx := -1;
 For I := 0 To SolExplorer.NodeCount - 1 Do
  If SolExplorer.Nodes[I].Kind = ENK_PROJECT Then Begin
   ProjIdx := I;
   Break;
  End;
 If ProjIdx < 0 Then
  ProjIdx := 0; { Ajouter sous la solution si pas de projet }
 { Calculer le chemin relatif par rapport au repertoire du projet }
 RelPath := ExtractFileName(FN);
 If SolutionLoaded And (CurrentSolution.ProjectCount > 0) Then
 Begin
  SolDir := CurrentSolution.Info.SolutionPath;
  If Length(SolDir) > 0 Then Begin
   If (SolDir[Length(SolDir)] <> '\') And
      (SolDir[Length(SolDir)] <> '/') Then
    SolDir := SolDir + '\';
  End;
  ProjDir := SolDir + ExtractFilePath(
   CurrentSolution.Projects[0].ProjectPath);
  { Normaliser les separateurs pour comparaison }
  For I := 1 To Length(ProjDir) Do
   If ProjDir[I] = '/' Then ProjDir[I] := '\';
  For I := 1 To Length(FN) Do
   If FN[I] = '/' Then FN[I] := '\';
  { Retirer le prefixe du repertoire projet du chemin absolu }
  If Length(ProjDir) > 0 Then Begin
   If UpCaseStr(Copy(FN, 1, Length(ProjDir)))
      = UpCaseStr(ProjDir) Then
    RelPath := Copy(FN, Length(ProjDir) + 1,
     Length(FN) - Length(ProjDir));
  End;
 End;
 AddExplorerNode(SolExplorer,
  RelPath,
  NodeKindFromExtension(FN), ProjIdx);
 SolExplorer.SelectedIdx := SolExplorer.NodeCount - 1;
 SolExplorer.Nodes[SolExplorer.NodeCount - 1].Selected := True;
 SolExplorer.NeedRepaint := True;
 { Ajouter le fichier dans le projet courant }
 If SolutionLoaded Then Begin
  AddFileToProject(CurrentProject, RelPath);
  SolutionModified := True;
  SaveCurrentSolution;
 End;
 AddMRUEntry(MRUList, FN);
 AppendOutput(OutputPanel, 'Fichier ouvert : ' + FN,
  Ord(OTK_BUILD));
End;

Procedure HandleNewSolutionConfirmed;
Var
 SolName: String;
 ProjName: String;
 ProjExt: String;
 ProjType: TProjectType;
 SolIdx, ProjIdx: Integer;
Begin
 SolName := NewProjDlg.SolutionName;
 ProjName := NewProjDlg.ProjectName;
 If SolName = '' Then SolName := 'MaSolution';
 If ProjName = '' Then ProjName := 'MonProjet';
 ProjType := NewProjectTypeToProjectType(NewProjDlg.SelType);
 ProjExt := NewProjectTypeExtension(NewProjDlg.SelType);
 { Initialiser la structure de la solution courante }
 CurrentSolution := CreateNewSolution(SolName,
  NewProjDlg.Location);
 AddProjectToSolution(CurrentSolution, ProjName,
  ProjName + ProjExt, ProjType);
 { Initialiser le projet courant }
 InitProject(CurrentProject);
 CurrentProject.Info.ProjectName := ProjName;
 CurrentProject.Info.AssemblyName := ProjName;
 CurrentProject.Info.RootNamespace := ProjName;
 CurrentProject.Info.ProjectType := ProjType;
 CurrentProject.Info.OutputType :=
  NewProjectTypeToOutputType(NewProjDlg.SelType);
 CurrentProject.Info.TargetFramework := 'v4.8';
 CurrentProject.Info.OutputPath := 'bin\Debug\';
 CurrentProject.CfgCount := 2;
 CurrentProject.Configs[0].ConfigName := 'Debug|AnyCPU';
 CurrentProject.Configs[0].OutputPath := 'bin\Debug\';
 CurrentProject.Configs[0].Optimize := False;
 CurrentProject.Configs[0].DebugSymbols := True;
 CurrentProject.Configs[1].ConfigName := 'Release|AnyCPU';
 CurrentProject.Configs[1].OutputPath := 'bin\Release\';
 CurrentProject.Configs[1].Optimize := True;
 CurrentProject.Configs[1].DebugSymbols := False;
 SolutionLoaded := True;
 SolutionModified := True;
 { Peupler l explorateur avec la nouvelle solution }
 ClearExplorer(SolExplorer);
 SolIdx := AddExplorerNode(SolExplorer, SolName,
  ENK_SOLUTION, -1);
 If SolIdx >= 0 Then Begin
  SolExplorer.Nodes[SolIdx].Expanded := True;
  ProjIdx := AddExplorerNode(SolExplorer, ProjName,
   ENK_PROJECT, SolIdx);
  If ProjIdx >= 0 Then Begin
   SolExplorer.Nodes[ProjIdx].Expanded := True;
   AddExplorerNode(SolExplorer, 'Properties',
    ENK_PROPERTIES, ProjIdx);
   AddExplorerNode(SolExplorer, 'References',
    ENK_REFERENCES, ProjIdx);
  End;
 End;
 If SolExplorer.NodeCount > 0 Then Begin
  SolExplorer.SelectedIdx := 0;
  SolExplorer.Nodes[0].Selected := True;
 End;
 SolExplorer.NeedRepaint := True;
 { Masquer la page de demarrage si visible }
 StartPage.Visible := False;
 FullRepaintNeeded := True;
 { Afficher un message dans le panneau de sortie }
 ClearOutput(OutputPanel, Ord(OTK_BUILD));
 AppendOutput(OutputPanel,
  'Solution ''' + SolName + ''' creee avec le projet ''' +
  ProjName + '''.',
  Ord(OTK_BUILD));
End;

{ --- Traitement de la confirmation nouveau fichier --- }

Procedure HandleNewFileConfirmed;
Var
 FN: String;
 FullPath: String;
 SolDir: String;
 ProjDir: String;
 I: Integer;
 ProjIdx: Integer;
 WIdx: Integer;
 TmpF: Text;
Begin
 FN := GetNewFileFullName(NewFileDlg);
 If FN = '' Then Exit;
 { Sauvegarder la fenetre active }
 If EditorReady Then SyncActiveWindowOut;
 { Masquer la page de demarrage }
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 { Construire le chemin complet du fichier }
 If SolutionLoaded And (CurrentSolution.ProjectCount > 0) Then
 Begin
  SolDir := CurrentSolution.Info.SolutionPath;
  If Length(SolDir) > 0 Then Begin
   If (SolDir[Length(SolDir)] <> '\') And
      (SolDir[Length(SolDir)] <> '/') Then
    SolDir := SolDir + '\';
  End;
  ProjDir := ExtractFilePath(
   CurrentSolution.Projects[0].ProjectPath);
  FullPath := SolDir + ProjDir + FN;
 End
 Else
  FullPath := FN;
 { Normaliser les separateurs }
 For I := 1 To Length(FullPath) Do
  If FullPath[I] = '/' Then FullPath[I] := '\';
 { Creer le fichier vide s il n existe pas }
 If Not FileExists(FullPath) Then Begin
  Assign(TmpF, FullPath);
  {$I-}
  Rewrite(TmpF);
  Close(TmpF);
  {$I+}
  If IOResult <> 0 Then ;
 End;
 { Verifier si le fichier est deja ouvert }
 WIdx := FindEditorByFileName(FullPath);
 If WIdx >= 0 Then Begin
  ActivateWindow(WIdx);
  FullRepaintNeeded := True;
  Exit;
 End;
 { Ouvrir dans un nouvel editeur }
 CreateEditorWindow(FullPath);
 WIdx := WinMgr.ActiveIdx;
 LoadFile(Editors[WIdx]^.Buffer, FullPath);
 ActiveEditor := Editors[WIdx]^;
 Opts.SourceFile := FullPath;
 EditorReady := True;
 { Ajouter le fichier a l explorateur }
 If (SolExplorer.NodeCount = 0) Or
    (SolExplorer.Nodes[0].Kind <> ENK_SOLUTION) Then Begin
  ClearExplorer(SolExplorer);
  AddExplorerNode(SolExplorer, 'Solution sans nom',
   ENK_SOLUTION, -1);
  SolExplorer.Nodes[0].Expanded := True;
  SolExplorer.Nodes[0].HasChildren := True;
 End;
 ProjIdx := -1;
 For I := 0 To SolExplorer.NodeCount - 1 Do
  If SolExplorer.Nodes[I].Kind = ENK_PROJECT Then Begin
   ProjIdx := I;
   Break;
  End;
 If ProjIdx < 0 Then
  ProjIdx := 0;
 AddExplorerNode(SolExplorer,
  FN, NodeKindFromExtension(FN), ProjIdx);
 SolExplorer.SelectedIdx := SolExplorer.NodeCount - 1;
 SolExplorer.Nodes[SolExplorer.NodeCount - 1].Selected := True;
 SolExplorer.NeedRepaint := True;
 { Ajouter au projet et sauvegarder }
 If SolutionLoaded Then Begin
  AddFileToProject(CurrentProject, FN);
  SolutionModified := True;
  SaveCurrentSolution;
 End;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel,
  'Nouveau fichier cree : ' + FullPath, Ord(OTK_BUILD));
End;

{ --- Dessiner tous les widgets de l IDE --- }

Procedure DrawAllWidgets;
Begin
 If StartPage.Visible Then Begin
  ClearScreen(CLR_BACKGROUND);
  DrawStartPage(StartPage, MRUList);
  DrawStatusBar(StatusBar);
  Exit;
 End;
 { Nettoyage unique lors de la transition page de demarrage -> IDE }
 If FullRepaintNeeded Then Begin
  ClearScreen(CLR_BACKGROUND);
  FullRepaintNeeded := False;
 End;
 DrawMenuBar;
 DrawToolBar;
 DrawWindowTabs;
 { Dessiner l editeur actif si une fenetre est ouverte }
 If EditorReady And (WinMgr.ActiveIdx >= 0) Then Begin
  If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_HEX Then
   DrawHexEditor(ActiveHexEditor)
  Else If WinMgr.Windows[WinMgr.ActiveIdx].Kind = WK_FORM Then
   DrawFormEditor(ActiveFormEditor)
  Else
   DrawEditor(ActiveEditor);
 End;
 DrawExplorer(SolExplorer);
 DrawPropertiesPanel(PropsPanel);
 { Dessiner Output et Terminal selon le z-order }
 If TermVisible And TerminalOnTop Then Begin
  DrawOutputPanel(OutputPanel);
  DrawTerminalPanel(TermPanels[ActiveShell]);
 End Else Begin
  DrawTerminalPanel(TermPanels[ActiveShell]);
  DrawOutputPanel(OutputPanel);
 End;
 DrawErrorList(ErrorList);
 { Fenetre debogueur emulateur (par-dessus tout sauf menus et dialogues) }
 If EmuDbg.WinVisible And (Not MenuActive) Then EmuDbg_DrawWindow;
 DrawStatusBar(StatusBar);
