   EmuCmdConsole_AddLine(C, '  E seg:ofs v..  Modifier des octets memoire');
   EmuCmdConsole_AddLine(C, '  S seg:ofs len texte  Chercher une chaine ASCII');
   EmuCmdConsole_AddLine(C, '  U [seg:ofs]    Desassembler');
   EmuCmdConsole_AddLine(C, '  G [seg:ofs]    Executer (jusqu''a l''adresse si donnee)');
   EmuCmdConsole_AddLine(C, '  T / TRACE      Pas a pas detaille');
   EmuCmdConsole_AddLine(C, '  P              Pas a pas principal');
   EmuCmdConsole_AddLine(C, '  BPX/BP seg:ofs[:N[:LEN]] Poser un point d''arret (Nieme passage, vidage LEN octets)');
   EmuCmdConsole_AddLine(C, '  BC/BD/BE n     Retirer/desactiver/activer un point d''arret');
   EmuCmdConsole_AddLine(C, '  BL             Lister les points d''arret');
   EmuCmdConsole_AddLine(C, '  ? expr         Evaluer (registre ou litteral)');
   EmuCmdConsole_AddLine(C, '  CLS            Effacer la console');
   EmuCmdConsole_AddLine(C, '  SET RADIX n    Changer la base d''affichage (10/16)');
   EmuCmdConsole_AddLine(C, '  WATCH seg:ofs [len] | WATCH OFF  Watchpoint memoire -> EMUWATCH.LOG');
   EmuCmdConsole_AddLine(C, '  TRACELOG       Vider les 8192 dernieres instr. -> EMUTRACE.LOG');
   EmuCmdConsole_AddLine(C, '  ENTROPY [seg:ofs] [len]  Entropie Shannon (code vs donnees compressees)');
   EmuCmdConsole_AddLine(C, '  STACK/SYM      (pas encore implementees)');
   EmuCmdConsole_AddLine(C, '  QUIT/EXIT/Q    Fermer la console');
   EmuCmdConsole_AddLine(C, 'Les commandes specifiques au noyau Windows NT sont');
   EmuCmdConsole_AddLine(C, 'reconnues mais signalees non applicables.');
  End;
  ECD_VSTUDIO: Begin
   EmuCmdConsole_AddLine(C, 'Commandes Visual Studio gerees :');
   EmuCmdConsole_AddLine(C, '  Debug.Start / Debug.StopDebugging / Debug.BreakAll');
   EmuCmdConsole_AddLine(C, '  Debug.StepInto / Debug.StepOver / Debug.StepOut');
   EmuCmdConsole_AddLine(C, '  Debug.RunToCursor');
   EmuCmdConsole_AddLine(C, '  Debug.Restart (pas encore implementee)');
  End;
  ECD_GDB: Begin
   EmuCmdConsole_AddLine(C, 'Commandes GDB gerees :');
   EmuCmdConsole_AddLine(C, '  run/r  break/b addr  continue/c  next/n  step/s');
   EmuCmdConsole_AddLine(C, '  print/p expr  info registers  disassemble  bt  quit/q');
  End;
 End;
End;

{ --- Dispatcheurs par dialecte (idiome If/ElseIf de TermExecuteCommand,
  le mode Turbo Pascal n a pas de Case-de-chaine) --- }

Procedure EmuCmdConsole_ExecSoftICE(Var C: TEmuCmdConsole;
 Const Cmd, Args, RawLine: String);
Begin
 If Cmd = '.' Then EmuCmdConsole_ShowCurrentInstr(C)
 Else If Cmd = 'R' Then EmuCmdConsole_CmdR(C, Args)
 Else If Cmd = 'D' Then EmuCmdConsole_CmdD(C, Args)
 Else If Cmd = 'E' Then EmuCmdConsole_CmdE(C, Args)
 Else If Cmd = 'S' Then EmuCmdConsole_CmdS(C, Args)
 Else If (Cmd = 'U') Or (Cmd = 'UNASSEMBLE') Then EmuCmdConsole_CmdU(C, Args)
 Else If (Cmd = 'G') Or (Cmd = 'GO') Then EmuCmdConsole_CmdG(C, Args)
 Else If (Cmd = 'T') Or (Cmd = 'TRACE') Then Begin
  EmuPanel_TryResume; EmuDbg_StepInto;
  EmuCmdConsole_AddLine(C, 'Trace (T)...');
 End
 Else If Cmd = 'P' Then Begin
  EmuPanel_TryResume; EmuDbg_StepOver;
  EmuCmdConsole_AddLine(C, 'Pas a pas (P)...');
 End
 Else If (Cmd = 'BPX') Or (Cmd = 'BP') Then EmuCmdConsole_CmdBPX(C, Args)
 Else If Cmd = 'BC' Then EmuCmdConsole_CmdBC(C, Args)
 Else If Cmd = 'BD' Then EmuCmdConsole_CmdBD(C, Args, False)
 Else If Cmd = 'BE' Then EmuCmdConsole_CmdBD(C, Args, True)
 Else If Cmd = 'BL' Then EmuCmdConsole_CmdBL(C)
 Else If Cmd = '?' Then EmuCmdConsole_CmdEval(C, Args)
 Else If Cmd = 'CLS' Then EmuCmdConsole_Clear(C)
 Else If (Cmd = 'HELP') Or (Cmd = 'H') Then EmuCmdConsole_CmdHelp(C)
 Else If (Cmd = 'QUIT') Or (Cmd = 'EXIT') Or (Cmd = 'Q') Then
  C.Base.Visible := False
 Else If Cmd = 'SET' Then EmuCmdConsole_CmdSet(C, Args)
 Else If (Cmd = 'STACK') Or (Cmd = 'K') Then EmuCmdConsole_NotYetImplemented(C, Cmd)
 Else If Cmd = 'WATCH' Then EmuCmdConsole_CmdWatch(C, Args)
 Else If Cmd = 'SYM' Then EmuCmdConsole_NotYetImplemented(C, Cmd)
 Else If Cmd = 'TRACELOG' Then EmuCmdConsole_CmdTraceLog(C)
 Else If Cmd = 'ENTROPY' Then EmuCmdConsole_CmdEntropy(C, Args)
 Else If EmuCmdConsole_IsNtKernelCmd(Cmd) Then EmuCmdConsole_NotApplicable(C, Cmd)
 Else EmuCmdConsole_Unknown(C, RawLine);
End;

Procedure EmuCmdConsole_ExecVStudio(Var C: TEmuCmdConsole;
 Const Cmd, Args, RawLine: String);
Var VisIdx: LongInt;
Begin
 If Cmd = 'DEBUG.START' Then Begin
  If EmuDbg.Paused Then Begin
   EmuPanel_TryResume; EmuDbg_Continue;
   EmuCmdConsole_AddLine(C, 'Demarrage (Debug.Start)...');
  End Else
   EmuCmdConsole_AddLine(C, 'Aucune session en pause a demarrer.');
 End
 Else If Cmd = 'DEBUG.STOPDEBUGGING' Then Begin
  EmuDbg_Stop; EmuCmdConsole_AddLine(C, 'Arret (Debug.StopDebugging).');
 End
 Else If Cmd = 'DEBUG.BREAKALL' Then Begin
  EmuDbg.BreakReq := True;
  EmuCmdConsole_AddLine(C, 'Pause demandee (Debug.BreakAll).');
 End
 Else If Cmd = 'DEBUG.RESTART' Then EmuCmdConsole_NotYetImplemented(C, Cmd)
 Else If Cmd = 'DEBUG.STEPINTO' Then Begin
  EmuPanel_TryResume; EmuDbg_StepInto;
  EmuCmdConsole_AddLine(C, 'Pas a pas detaille (Debug.StepInto)...');
 End
 Else If Cmd = 'DEBUG.STEPOVER' Then Begin
  EmuPanel_TryResume; EmuDbg_StepOver;
  EmuCmdConsole_AddLine(C, 'Pas a pas principal (Debug.StepOver)...');
 End
 Else If Cmd = 'DEBUG.STEPOUT' Then Begin
  EmuPanel_TryResume; EmuDbg_StepOut;
  EmuCmdConsole_AddLine(C, 'Pas a pas sortant (Debug.StepOut)...');
 End
 Else If Cmd = 'DEBUG.RUNTOCURSOR' Then Begin
  VisIdx := EmuDbg.SelOfs - EmuDbg.DisasmTopOfs;
  If (VisIdx >= 0) And (VisIdx <= 63) Then
   EmuDbg_AddBP(EmuDbg.DisasmAddrs[VisIdx], EDC_8086)
  Else
   EmuDbg_AddBP((LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + EmuPanel.CPU.IP, EDC_8086);
  EmuPanel_TryResume; EmuDbg_Continue;
  EmuCmdConsole_AddLine(C, 'Execution jusqu''au curseur (Debug.RunToCursor)...');
 End
 Else EmuCmdConsole_Unknown(C, RawLine);
End;

Procedure EmuCmdConsole_ExecGDB(Var C: TEmuCmdConsole;
 Const Cmd, Args, RawLine: String);
Begin
 If (Cmd = 'RUN') Or (Cmd = 'R') Then Begin
  If EmuDbg.Paused Then Begin
   EmuPanel_TryResume; EmuDbg_Continue;
   EmuCmdConsole_AddLine(C, 'Demarrage (run)...');
  End Else
   EmuCmdConsole_AddLine(C, 'Aucune session en pause a demarrer.');
 End
 Else If (Cmd = 'BREAK') Or (Cmd = 'B') Then EmuCmdConsole_CmdBPX(C, Args)
 Else If (Cmd = 'CONTINUE') Or (Cmd = 'C') Then Begin
  EmuPanel_TryResume; EmuDbg_Continue;
  EmuCmdConsole_AddLine(C, 'continue...');
 End
 Else If (Cmd = 'NEXT') Or (Cmd = 'N') Then Begin
  EmuPanel_TryResume; EmuDbg_StepOver;
  EmuCmdConsole_AddLine(C, 'next...');
 End
 Else If (Cmd = 'STEP') Or (Cmd = 'S') Then Begin
  EmuPanel_TryResume; EmuDbg_StepInto;
  EmuCmdConsole_AddLine(C, 'step...');
 End
 Else If (Cmd = 'PRINT') Or (Cmd = 'P') Then EmuCmdConsole_CmdEval(C, Args)
 Else If (Cmd = 'BACKTRACE') Or (Cmd = 'BT') Then EmuCmdConsole_NotYetImplemented(C, Cmd)
 Else If Cmd = 'INFO' Then Begin
  If UpCaseStr(Args) = 'REGISTERS' Then EmuCmdConsole_ShowRegs(C)
  Else EmuCmdConsole_Unknown(C, RawLine);
 End
 Else If Cmd = 'DISASSEMBLE' Then EmuCmdConsole_CmdU(C, Args)
 Else If (Cmd = 'QUIT') Or (Cmd = 'Q') Then C.Base.Visible := False
 Else EmuCmdConsole_Unknown(C, RawLine);
End;

Procedure EmuCmdConsole_Submit(Var C: TEmuCmdConsole);
Var Cmd, Args, InputLine: String;
Begin
 InputLine := TermTrim(C.InputText);
 EmuCmdConsole_AddLine(C, EmuCmdConsole_PromptChar(C.Dialect) + InputLine);
 EmuCmdConsole_HistPush(C, InputLine);
 If InputLine <> '' Then Begin
  Cmd := UpCaseStr(EmuCmdConsole_FirstWord(InputLine));
  Args := EmuCmdConsole_Rest(InputLine);
  Case C.Dialect Of
   ECD_SOFTICE: EmuCmdConsole_ExecSoftICE(C, Cmd, Args, InputLine);
   ECD_VSTUDIO: EmuCmdConsole_ExecVStudio(C, Cmd, Args, InputLine);
   ECD_GDB:     EmuCmdConsole_ExecGDB(C, Cmd, Args, InputLine);
  End;
 End;
 C.InputText := ''; C.InputCursor := 0; C.ScrollOffset := 0;
End;

Procedure EmuCmdConsole_InsertChar(Var C: TEmuCmdConsole; Ch: Char);
Begin
 If Length(C.InputText) >= 250 Then Exit;
 Insert(Ch, C.InputText, C.InputCursor + 1);
 Inc(C.InputCursor);
 C.NeedRepaint := True;
End;

Procedure EmuCmdConsole_Backspace(Var C: TEmuCmdConsole);
Begin
 If C.InputCursor <= 0 Then Exit;
 Delete(C.InputText, C.InputCursor, 1);
 Dec(C.InputCursor);
 C.NeedRepaint := True;
End;

Procedure EmuCmdConsole_DrawTab(TX, TY, TW, TH: Integer; Caption: String;
 Active: Boolean);
Var TXOfs: Integer;
Begin
 If Active Then Begin
  SetFillStyle(SolidFill, CLR_TITLEBAR_ACTIVE);
  SetColor(15);
 End Else Begin
  SetFillStyle(SolidFill, CLR_BACKGROUND);
  SetColor(CLR_BORDER);
 End;
 Bar(TX, TY, TX + TW - 2, TY + TH - 1);
 Rectangle(TX, TY, TX + TW - 2, TY + TH - 1);
 { Ne jamais laisser le texte deborder AVANT le debut de l onglet (sur
   l onglet precedent deja dessine) sur un onglet etroit - au pire il
   deborde legerement sur sa propre bordure droite, jamais a gauche. }
 TXOfs := (TW - TextWidth(Caption)) Div 2;
 If TXOfs < 2 Then TXOfs := 2;
 OutTextXY(TX + TXOfs, TY + (TH - TextHeight(Caption)) Div 2, Caption);
End;

{ --- Triptyque Show/Draw/Handle --- }

Procedure ShowEmuCmdConsole(Var C: TEmuCmdConsole);
Var NX, NY, NW, NH: Integer;
Begin
 EmuCmdConsole_ComputeRect(NX, NY, NW, NH);
 C.Base.Title := 'Console de commandes du debogueur';
 C.Base.X := NX; C.Base.Y := NY;
 C.Base.Width := NW; C.Base.Height := NH;
 C.Base.Result := DR_NONE;
 C.Base.Visible := True;
 C.Base.HasCancel := False;
 If C.OutHead = Nil Then Begin
  C.Dialect := ECD_SOFTICE;
  C.Radix := 16;
  C.LastDumpSeg := EmuPanel.CPU.Segs.DS; C.LastDumpOfs := 0;
  C.LastUnasmSeg := EmuPanel.CPU.Segs.CS; C.LastUnasmOfs := EmuPanel.CPU.IP;
  EmuCmdConsole_AddLine(C, 'SoftICE - tapez HELP pour la liste des commandes.');
 End;
 C.InputText := ''; C.InputCursor := 0;
 C.CmdHistPos := -1;
 C.WinFocused := True;
 C.NeedRepaint := True;
End;

{ Tronque S pour que sa largeur en pixels ne depasse pas MaxW - la console
  n a pas de retour a la ligne automatique, et OutTextXY ne clippe rien
  tout seul (dessine par-dessus les panneaux voisins si on ne borne pas
  la largeur explicitement, comme un vrai debogueur en mode texte le
  ferait). }
Function EmuCmdConsole_TruncateToWidth(S: String; MaxW: Integer): String;
Begin
 While (Length(S) > 1) And (TextWidth(S) > MaxW) Do
  S := Copy(S, 1, Length(S) - 1);
 EmuCmdConsole_TruncateToWidth := S;
End;

Procedure DrawEmuCmdConsole(Var C: TEmuCmdConsole);
Const MAX_VIS_LINES = 200;
Var
 FX, FY, TabX, TabY, TabW, TabH, I, VisRows, TextH, PromptY, MaxTextW: Integer;
 Node: PEmuCmdLine;
 Buf: Array[0..MAX_VIS_LINES - 1] Of String;
 N, Skip: Integer;
 PS: String;
Begin
 DrawDialogFrame(C.Base);
 EmuCmdConsole_TabRect(C, 0, TabX, TabY, TabW, TabH);
 EmuCmdConsole_DrawTab(TabX, TabY, TabW, TabH, 'SoftICE', C.Dialect = ECD_SOFTICE);
 EmuCmdConsole_TabRect(C, 1, TabX, TabY, TabW, TabH);
 EmuCmdConsole_DrawTab(TabX, TabY, TabW, TabH, 'VStudio', C.Dialect = ECD_VSTUDIO);
 EmuCmdConsole_TabRect(C, 2, TabX, TabY, TabW, TabH);
 EmuCmdConsole_DrawTab(TabX, TabY, TabW, TabH, 'GDB', C.Dialect = ECD_GDB);
 TextH := TextHeight('X') + 2;
 FX := C.Base.X + DLG_PADDING;
 FY := C.Base.Y + DLG_TITLE_HEIGHT + TabH + 8;
 PromptY := C.Base.Y + C.Base.Height - DLG_PADDING - TextH - 4;
 VisRows := (PromptY - FY) Div TextH;
 If VisRows > MAX_VIS_LINES Then VisRows := MAX_VIS_LINES;
 If VisRows < 1 Then VisRows := 1;
 Node := C.OutTail;
 Skip := C.ScrollOffset;
 While (Node <> Nil) And (Skip > 0) Do Begin
  Node := Node^.Prev; Dec(Skip);
 End;
 N := 0;
 While (Node <> Nil) And (N < VisRows) Do Begin
  Buf[N] := Node^.S;
  Inc(N);
  Node := Node^.Prev;
 End;
 MaxTextW := C.Base.X + C.Base.Width - DLG_PADDING - FX;
 SetColor(CLR_BORDER);
 For I := N - 1 DownTo 0 Do
  OutTextXY(FX, FY + (N - 1 - I) * TextH,
   EmuCmdConsole_TruncateToWidth(Buf[I], MaxTextW));
 SetColor(8);
 Line(C.Base.X + 4, PromptY - 2, C.Base.X + C.Base.Width - 4, PromptY - 2);
 PS := EmuCmdConsole_PromptChar(C.Dialect);
 SetColor(10);
 OutTextXY(FX, PromptY, PS + C.InputText);
 SetColor(15);
 OutTextXY(FX + TextWidth(PS + Copy(C.InputText, 1, C.InputCursor)), PromptY, '_');
End;

Function HandleEmuCmdConsoleEvent(Var C: TEmuCmdConsole; Var Ev: TEvent): Boolean;
Begin
 HandleEmuCmdConsoleEvent := False;
 If Not C.Base.Visible Then Exit;
 If Ev.Kind In [EV_MOUSE_DOWN, EV_MOUSE_UP, EV_MOUSE_MOVE, EV_MOUSE_DBLCLICK] Then Begin
  If C.Dragging Then Begin
   If Ev.Kind = EV_MOUSE_MOVE Then Begin
    C.Base.X := Ev.MouseX - C.DragOfsX;
    C.Base.Y := Ev.MouseY - C.DragOfsY;
    If C.Base.X < 0 Then C.Base.X := 0;
    If C.Base.Y < 0 Then C.Base.Y := 0;
    HandleEmuCmdConsoleEvent := True;
    Exit;
   End Else If Ev.Kind = EV_MOUSE_UP Then Begin
    C.Dragging := False;
    HandleEmuCmdConsoleEvent := True;
    Exit;
   End;
  End;
  If Ev.Kind = EV_MOUSE_DOWN Then Begin
   If Not EmuCmdConsole_HitWindow(C, Ev.MouseX, Ev.MouseY) Then Begin
    C.WinFocused := False;
    Exit;
   End;
   C.WinFocused := True;
   HandleEmuCmdConsoleEvent := True;
   If EmuCmdConsole_HitCloseBox(C, Ev.MouseX, Ev.MouseY) Then
    C.Base.Visible := False
   Else If EmuCmdConsole_HitTitleBar(C, Ev.MouseX, Ev.MouseY) Then Begin
    C.Dragging := True;
    C.DragOfsX := Ev.MouseX - C.Base.X;
    C.DragOfsY := Ev.MouseY - C.Base.Y;
   End Else If EmuCmdConsole_HitTab(C, Ev.MouseX, Ev.MouseY, 0) Then
    C.Dialect := ECD_SOFTICE
   Else If EmuCmdConsole_HitTab(C, Ev.MouseX, Ev.MouseY, 1) Then
    C.Dialect := ECD_VSTUDIO
   Else If EmuCmdConsole_HitTab(C, Ev.MouseX, Ev.MouseY, 2) Then
    C.Dialect := ECD_GDB;
   Exit;
  End;
  Exit;
 End;
 If Not C.WinFocused Then Exit;
 If (Ev.Kind = EV_KEY_CHAR) Or (Ev.Kind = EV_KEY_DOWN) Then Begin
  HandleEmuCmdConsoleEvent := True;
  If Ev.Kind = EV_KEY_CHAR Then Begin
   If Ev.KeyChar = #13 Then EmuCmdConsole_Submit(C)
   Else If Ev.KeyChar = #8 Then EmuCmdConsole_Backspace(C)
   Else If Ev.KeyChar = #27 Then C.Base.Visible := False
   Else If Ev.KeyChar In [#32..#126] Then EmuCmdConsole_InsertChar(C, Ev.KeyChar);
  End Else Begin
   Case Ev.KeyCode Of
    $48: Begin { Fleche haut : rappel historique precedent }
     If C.CmdHistCount > 0 Then Begin
      If C.CmdHistPos = -1 Then C.CmdHistPos := C.CmdHistCount - 1
      Else If C.CmdHistPos > 0 Then Dec(C.CmdHistPos);
      C.InputText := C.CmdHist[C.CmdHistPos];
      C.InputCursor := Length(C.InputText);
     End;
    End;
    $50: Begin { Fleche bas : rappel historique suivant }
     If C.CmdHistPos <> -1 Then Begin
      If C.CmdHistPos < C.CmdHistCount - 1 Then Begin
       Inc(C.CmdHistPos);
       C.InputText := C.CmdHist[C.CmdHistPos];
      End Else Begin
       C.CmdHistPos := -1;
       C.InputText := '';
      End;
      C.InputCursor := Length(C.InputText);
     End;
    End;
    $4B: If C.InputCursor > 0 Then Dec(C.InputCursor); { Fleche gauche }
    $4D: If C.InputCursor < Length(C.InputText) Then Inc(C.InputCursor); { Fleche droite }
    $49: Begin { Page precedente : remonter dans le defilement }
     Inc(C.ScrollOffset, 10);
     If C.ScrollOffset > C.OutCount Then C.ScrollOffset := C.OutCount;
    End;
    $51: Begin { Page suivante : redescendre }
     Dec(C.ScrollOffset, 10);
     If C.ScrollOffset < 0 Then C.ScrollOffset := 0;
    End;
   End;
  End;
 End;
End;

{ --- Gerer une touche pendant la pause. Retourne True si consomme. --- }

Function EmuDbg_HandleKey(Var Ev: TEvent): Boolean;
Var
 L: Integer;
Begin
 EmuDbg_HandleKey := False;
 If Not EmuDbg.Paused Then Exit;
 { Si un menu deroulant est ouvert, le laisser traiter les touches
   (Esc/fleches/Entree pour la navigation menu) et ne rien absorber. }
 If MenuActive Then Exit;
 { Idem pour le menu contextuel du Debogueur (EmuDbg_ShowContextMenu) -
   voir le meme raisonnement dans EmuDbg_HandleMouse ci-dessous. }
 If CtxMenu.Visible Then Exit;
 { Animer : Echap/Ctrl+C/Ctrl+Break interrompent l animation en cours -
   ne consomme la touche que si une animation est REELLEMENT active,
   pour ne rien changer au comportement existant (Echap notamment,
   deliberement laissee passer plus bas sinon - voir commentaire en
   fin de fonction) quand aucune animation ne tourne. }
 If EmuDbg.Animating Then Begin
  If EmuDbg_IsBreakKey(Ev) Or
     ((Ev.Kind = EV_KEY_CHAR) And (Ev.KeyChar = #27)) Then Begin
   EmuDbg.Animating := False;
   EmuDbg_HandleKey := True;
   Exit;
  End;
 End;
 L := EmuDbg.DisasmLines;
 If L < 1 Then L := 1;
 If Ev.Kind = EV_KEY_DOWN Then Begin
  Case Ev.KeyCode Of
   $3F: Begin EmuDbg_Continue;  EmuDbg_HandleKey := True; End; { F5 }
   $43: Begin EmuDbg_ToggleBPAtPC; EmuDbg_HandleKey := True; End; { F9 }
   $44: Begin EmuDbg_StepOver;  EmuDbg_HandleKey := True; End; { F10 }
   $85: Begin EmuDbg_StepInto;  EmuDbg_HandleKey := True; End; { F11 }
   $87: Begin EmuDbg_StepOut;   EmuDbg_HandleKey := True; End; { Shift+F11 }
   { Rechanges de Ctrl+F10/Alt+F10 pour Pas a pas detaille/sortant : F11
     et Maj+F11 n atteignent JAMAIS le systeme d evenements de cette
     application (verifie empiriquement - intercepte en amont, tres
     probablement par Windows/PtcGraph qui reserve F11 pour un bascule
     plein ecran interne - les touches "clavier etendu" F11/F12 n ont
     d ailleurs jamais fait partie de la table de scan codes BIOS
     d origine PC/XT, contrairement a F1-F10, ce qui explique aussi
     pourquoi F10 lui-meme reste fiable). Ctrl+F10/Alt+F10 restent DANS
     cette table d origine (comme Ctrl+F5/Maj+F5 deja fiables ci-dessus)
     et sont donc attendus fiables sur tout clavier, y compris ceux sans
     rangee de touches de fonction confortable qui motivent ce rechange. }
   $67: Begin EmuDbg_StepInto;  EmuDbg_HandleKey := True; End; { Ctrl+F10 }
   $71: Begin EmuDbg_StepOut;   EmuDbg_HandleKey := True; End; { Alt+F10 }
   $58: Begin EmuDbg_Stop;      EmuDbg_HandleKey := True; End; { Shift+F5 }
   $62: Begin EmuDbg_Continue;  EmuDbg_HandleKey := True; End; { Ctrl+F5 }
   $48: Begin { Fleche haut : selection precedente }
    If EmuDbg.SelOfs > 0 Then Dec(EmuDbg.SelOfs);
    EmuDbg_HandleKey := True;
   End;
   $50: Begin { Fleche bas : selection suivante }
    Inc(EmuDbg.SelOfs);
    EmuDbg_HandleKey := True;
   End;
   $49: Begin { Page Up : reculer d une page }
    EmuDbg.SelOfs := EmuDbg.SelOfs - L;
    If EmuDbg.SelOfs < 0 Then EmuDbg.SelOfs := 0;
    EmuDbg_HandleKey := True;
   End;
   $51: Begin { Page Down : avancer d une page }
    EmuDbg.SelOfs := EmuDbg.SelOfs + L;
    EmuDbg_HandleKey := True;
   End;
   $47: Begin { Home : retour au PC }
    EmuDbg.SelOfs := 0;
    EmuDbg.DisasmTopOfs := 0;
    EmuDbg_HandleKey := True;
   End;
  End;
  { Defilement du dump DS via '+' / '-' (huit octets par cran) }
  If Ev.KeyChar = '+' Then Begin
   EmuDbg.DataOfs := Word(EmuDbg.DataOfs + 8);
   EmuDbg_HandleKey := True;
  End Else If Ev.KeyChar = '-' Then Begin
   EmuDbg.DataOfs := Word(EmuDbg.DataOfs - 8);
   EmuDbg_HandleKey := True;
  End;
 End;
 { Note : Echap (#27) n est PLUS traitee comme Continue car c est aussi
   la touche standard pour fermer les menus deroulants ou les dialogues.
   L utilisateur doit explicitement appuyer sur F5 pour reprendre. }
End;

{ --- Gerer un evenement souris dans la fenetre debug. Renvoie True
      si l evenement a ete absorbe par la fenetre debug --- }

Function EmuDbg_HandleMouse(Var Ev: TEvent): Boolean;
Var
 NewW, NewH: Integer;
Begin
 EmuDbg_HandleMouse := False;
 { Menu contextuel (EmuDbg_ShowContextMenu) ouvert : le laisser gerer TOUS  }
 { les evenements souris suivants (survol/clic sur ses propres items) via  }
 { DispatchEvent - sinon ce hit-test "corps de la fenetre" les absorberait }
 { avant meme qu ils atteignent HandleContextMenuEvent, rendant le menu    }
 { injouable des qu il chevauche la fenetre du Debogueur (cas courant). }
 If CtxMenu.Visible Then Exit;
 If Not EmuDbg.WinVisible Then Begin
  EmuDbg.Dragging := False;
  EmuDbg.Resizing := False;
  Exit;
 End;
 { Drag ou resize en cours : suivre la souris quelle que soit sa position }
 If EmuDbg.Dragging Then Begin
  If Ev.Kind = EV_MOUSE_MOVE Then Begin
   EmuDbg.WinX := Ev.MouseX - EmuDbg.DragOfsX;
   EmuDbg.WinY := Ev.MouseY - EmuDbg.DragOfsY;
   If EmuDbg.WinX < 0 Then EmuDbg.WinX := 0;
   If EmuDbg.WinY < 0 Then EmuDbg.WinY := 0;
   FullRepaintNeeded := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else If Ev.Kind = EV_MOUSE_UP Then Begin
   EmuDbg.Dragging := False;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
 End;
 If EmuDbg.Resizing Then Begin
  If Ev.Kind = EV_MOUSE_MOVE Then Begin
   NewW := Ev.MouseX - EmuDbg.WinX + 1;
   NewH := Ev.MouseY - EmuDbg.WinY + 1;
   If NewW < 200 Then NewW := 200;
   If NewH < 120 Then NewH := 120;
   EmuDbg.WinW := NewW;
   EmuDbg.WinH := NewH;
   FullRepaintNeeded := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else If Ev.Kind = EV_MOUSE_UP Then Begin
   EmuDbg.Resizing := False;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
 End;
 If Ev.Kind In [EV_MOUSE_DOWN, EV_MOUSE_UP, EV_MOUSE_DBLCLICK] Then Begin
  { Close box : juste cacher (l emulateur reste en pause) }
  If EmuDbg_HitCloseBox(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.WinVisible := False;
    FullRepaintNeeded := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Coin BD : commencer un resize }
  If EmuDbg_HitResize(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.Resizing := True;
    EmuDbg.WinFocused := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Barre de titre : commencer un drag }
  If EmuDbg_HitTitleBar(Ev.MouseX, Ev.MouseY) Then Begin
   If Ev.Kind = EV_MOUSE_DOWN Then Begin
    EmuDbg.Dragging := True;
    EmuDbg.DragOfsX := Ev.MouseX - EmuDbg.WinX;
    EmuDbg.DragOfsY := Ev.MouseY - EmuDbg.WinY;
    EmuDbg.WinFocused := True;
   End;
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Clic droit dans le corps de la fenetre : menu contextuel d outils      }
  { d investigation (voir EmuDbg_ShowContextMenu) - demande explicite       }
  { utilisateur, place AVANT le "corps de la fenetre : absorber" generique  }
  { ci-dessous puisque c est un cas plus specifique du meme hit-test. }
  If (Ev.Kind = EV_MOUSE_DOWN) And (Ev.MouseBtn = MB_RIGHT) And
     EmuDbg_HitWindow(Ev.MouseX, Ev.MouseY) And
     (Not EmuDbg_HitTitleBar(Ev.MouseX, Ev.MouseY)) Then Begin
   EmuDbg.WinFocused := True;
   EmuDbg_ShowContextMenu(Ev.MouseX, Ev.MouseY);
   EmuDbg_HandleMouse := True;
   Exit;
  End;
  { Corps de la fenetre : absorber pour ne pas activer autre chose }
  If EmuDbg_HitWindow(Ev.MouseX, Ev.MouseY) Then Begin
   EmuDbg.WinFocused := True;
   EmuDbg_HandleMouse := True;
   Exit;
  End Else Begin
   EmuDbg.WinFocused := False;
   { Laisser passer aux autres fenetres }
  End;
 End;
End;

{ --- Boucle de pump pendant la pause : preserve l interactivite de
      l IDE (menus, autres fenetres) tant que l utilisateur n a pas
      relance via F5/F10/F11/Shift+F11/Shift+F5. --- }

Procedure EmuDbg_PumpPause;
Var
 Ev: TEvent;
Begin
 EmuDbg.WinVisible := True;
 EmuDbg.WinFocused := True;
 EmuDbg.NeedRepaint := True;
 FullRepaintNeeded := True;
 { BOGUE REEL (2026-08-18) : DrawAllWidgets dessine DEJA EmuDbg_DrawWindow
   en interne (voir son propre "If EmuDbg.WinVisible And (Not MenuActive)
   Then EmuDbg_DrawWindow", desormais place APRES DrawEmulatorPanel pour
   eviter la troncature via double-buffering - voir son commentaire). Un
   second appel direct ICI juste apres etait exactement le motif que le
   commentaire plus bas (voir Continue-loop ci-dessous) documente deja
   comme corrompant l affichage (desassemblage/dump tronques a 1 ligne) -
   mais ce site D ENTREE EN PAUSE avait ete oublie lors de ce correctif
   anterieur, donc le bogue se reproduisait a CHAQUE arret (point d arret/
   pas-a-pas), pas seulement apres ouverture/fermeture d un menu. Supprime
   l appel redondant : DrawAllWidgets suffit, comme plus bas dans la
   boucle de pump. }
 DrawAllWidgets;
 While EmuDbg.Paused And (Not EmuDbg.ContinueReq) And
       (Not EmuDbg.StopReq) And (Not QuitRequested) Do Begin
  PollEvents(Ev);
  If Ev.Kind = EV_NONE Then Begin
   { Animer : un pas automatique toutes les 1000 ms. EmuDbg_StepInto
     met Paused a False (le While ci-dessus se termine alors de lui
     meme au prochain tour) - l instruction s execute reellement plus
     haut dans la pile d appel (hook pre-instruction), puis rappelle
     EmuDbg_EnterPause/EmuDbg_PumpPause pour le pas suivant : c est ce
     va-et-vient qui produit l effet "anime" sans boucle bloquante
     dediee. AnimLastStep est mis a jour ICI (pas seulement a l
     activation) pour que la cadence de 1s/pas reste correcte d un
     passage a l autre dans EmuDbg_PumpPause. }
   If EmuDbg.Animating And
      ((GetTimestamp - EmuDbg.AnimLastStep) >= 1000) Then Begin
    EmuDbg.AnimLastStep := GetTimestamp;
    EmuDbg_StepInto;
   End;
   { Pas d evenement : on reste idle. Pas de Sleep car le pump host
     gere deja le pacing. }
   Continue;
  End;
  { Priorite : la fenetre debug consomme F5/F9/F10/F11/Shift+F5/F11 }
  If EmuDbg_HandleKey(Ev) Then Begin
   EmuDbg_DrawWindow;
   Continue;
  End;
  { Souris dans la fenetre debug : absorber }
  If EmuDbg_HandleMouse(Ev) Then Begin
   { BOGUE REEL (2026-08-18) : si ce clic vient d ouvrir le menu contextuel  }
   { (EmuDbg_ShowContextMenu, voir EmuDbg_HandleMouse), NE PAS redessiner    }
   { EmuDbg_DrawWindow ici - il repeindrait PAR-DESSUS le menu tout juste    }
   { affiche (le menu est positionne DANS/pres du rectangle de la fenetre   }
   { Debogueur), l effacant instantanement ("flash puis rien" signale par   }
   { l utilisateur). Meme raisonnement deja documente plus bas pour         }
   { MenuActive - manquait ici pour CtxMenu. }
   If Not CtxMenu.Visible Then EmuDbg_DrawWindow;
   Continue;
  End;
  { Sinon laisser le dispatcher normal traiter l evenement (menus,
    autres fenetres, etc.) pour preserver l interactivite. }
  DispatchEvent(Ev);
  If FullRepaintNeeded Then Begin
   DrawAllWidgets;
   { BOGUE REEL (2026-08-18, signale par l utilisateur : "flash puis rien"    }
   { en cliquant sur le menu contextuel du Debogueur) : DrawAllWidgets        }
   { efface le menu contextuel (DrawToolBar/DrawWindowTabs le recouvrent),    }
   { EXACTEMENT le meme bogue deja corrige dans la boucle PRINCIPALE (voir    }
   { plus bas dans ce fichier, "DrawAllWidgets appelle DrawToolBar qui         }
   { ecrase le menu deroulant") - manquait ici, dans la boucle DEDIEE de      }
   { EmuDbg_PumpPause, ou s ouvre desormais aussi EmuDbg_ShowContextMenu.     }
   { Meme correctif : redessiner le menu contextuel PAR-DESSUS juste apres. }
   If CtxMenu.Visible Then DrawContextMenu(CtxMenu);
   FullRepaintNeeded := False;
  End Else If Not MenuActive And Not CtxMenu.Visible Then Begin
   { Ne pas redessiner la fenetre debug si un menu deroulant est ouvert :
     cela ecraserait le menu. Le menu reste en avant-plan tant qu il est
     ouvert ; il restaurera l arriere-plan a sa fermeture. Si un repaint
     complet vient d avoir lieu (branche ci-dessus), NE PAS redessiner
     une 2e fois ici : DrawAllWidgets a deja redessine EmuDbg lui-meme
     (voir son propre `If EmuDbg.WinVisible And (Not MenuActive) Then
     EmuDbg_DrawWindow`) - un second appel redondant juste apres a ete
     empiriquement observe corrompre l affichage (desassemblage/dump
     tronques a 1 ligne apres une simple ouverture/fermeture de menu
     PENDANT la pause, reproduit meme sans aucun rapport avec "Animer").
     BOGUE REEL (2026-08-18, suite) : `Not CtxMenu.Visible` manquait ICI
     AUSSI - un simple survol souris (EV_MOUSE_MOVE, ne declenche PAS
     FullRepaintNeeded, seulement HandleContextMenuEvent qui redessine le
     menu tout seul) tombait dans cette branche EmuDbg_DrawWindow, effacant
     le menu contextuel a CHAQUE mouvement de souris - invisible avec un
     clic automatise (teleporte le curseur sans MOUSE_MOVE intermediaire)
     mais rendait le menu impossible a utiliser a la souris reelle (signale
     par l utilisateur : "le debogueur redessine par dessus... je ne suis
     jamais capable de selectionner les options"). }
   EmuDbg_DrawWindow;
  End;
 End;
 { Si l utilisateur a demande de quitter pendant la pause (Alt+X /
   Alt+F4), forcer l arret de l emulateur pour sortir proprement. }
 If QuitRequested Then Begin
  EmuDbg.StopReq := True;
  EmuDbg.Paused := False;
 End;
End;

{ --- Entrer en pause : appele par les hooks pre-step des emulateurs --- }

Procedure EmuDbg_EnterPause(ACPU: TEmuDbgCPU);
Begin
 EmuDbg.Active := True;
 EmuDbg.CPU := ACPU;
 EmuDbg.Paused := True;
 EmuDbg.BreakReq := False;
 EmuDbg.ContinueReq := False;
 EmuDbg.StepMode := ESM_NONE;
 { Reinitialiser le curseur du listing sur l instruction courante }
 EmuDbg.SelOfs := 0;
 EmuDbg.DisasmTopOfs := 0;
 If ACPU = EDC_6502 Then
  EmuDbg.LastAddr := CPU6502_PC
 Else If ACPU = EDC_8086 Then Begin
  EmuDbg.LastCS := EmuPanel.CPU.Segs.CS;
  EmuDbg.LastIP := EmuPanel.CPU.IP;
  EmuDbg.LastAddr := (LongInt(EmuDbg.LastCS) Shl 4) + EmuDbg.LastIP;
 End
 Else If ACPU = EDC_6809 Then
  EmuDbg.LastAddr := M6809_PC;
 { Vider le tampon circulaire (8192 dernieres instructions, deja rempli en
   continu par le coeur d execution) vers EMUTRACE.LOG a CHAQUE entree en
   pause - pas seulement en fin de session (voir Emu_DumpTrace, qui existait
   deja pour ce cas). Permet de voir tout ce qui a mene a un point d arret
   PRECIS (ex. /BP:SEG:OFS:N) sans devoir laisser tourner jusqu a la fin. }
 If OptionsDlg.Data.DosLogDiag Then Emu_DumpTrace;
 EmuDbg_PumpPause;
 { Sortie de pause : redessiner toute l interface puis le panneau
   emulateur afin que la zone qui etait sous la fenetre debug soit
   restauree avant de relancer la boucle CPU. Les emulateurs avec
   framebuffer differentiel (NES, Atari 2600) doivent forcer un
   repaint complet, sinon DrawEmulatorPanel ne redessine que les
   pixels qui changent et la zone effacee reste vide. }
 NesFBFirst    := True;
 A2600_FBFirst := True;
 Coco3_FBFirst := True;
 FillChar(Coco3_FBPrev, SizeOf(Coco3_FBPrev), $FF);
 FullRepaintNeeded := True;
 DrawAllWidgets;
 If EmuPanel.Base.Visible Then DrawEmulatorPanel(EmuPanel);
End;

{ --- Hook a appeler AVANT chaque instruction CPU. Retourne True si
      l execution doit etre suspendue (gestion deja faite). --- }

Procedure EmuDbg_OnBeforeStep6502;
Begin
 If Not EmuDbg.Active Then Exit;
 If EmuDbg_ShouldBreak(EDC_6502, CPU6502_PC) Then
  EmuDbg_EnterPause(EDC_6502);
End;

Procedure EmuDbg_OnBeforeStep8086;
Var
 LinAddr: LongInt;
Begin
 If Not EmuDbg.Active Then Exit;
 LinAddr := (LongInt(EmuPanel.CPU.Segs.CS) Shl 4) + EmuPanel.CPU.IP;
 If EmuDbg_ShouldBreak(EDC_8086, LinAddr) Then
  EmuDbg_EnterPause(EDC_8086);
End;

Procedure EmuDbg_OnBeforeStep6809;
Begin
 If Not EmuDbg.Active Then Exit;
 If EmuDbg_ShouldBreak(EDC_6809, M6809_PC) Then
  EmuDbg_EnterPause(EDC_6809);
End;

{ --- Verifier dans le pump d emulateur si Ctrl+C/Ctrl+Break a ete pressee --- }

Function EmuDbg_IsBreakKey(Var Ev: TEvent): Boolean;
Begin
 EmuDbg_IsBreakKey := False;
 If Ev.Kind = EV_KEY_CHAR Then Begin
  { #3 = Ctrl+C ; certains hotes envoient aussi #0 pour Ctrl+Break. }
  If Ev.KeyChar = #3 Then EmuDbg_IsBreakKey := True;
 End Else If Ev.Kind = EV_KEY_DOWN Then Begin
  { Ctrl+Break en mode etendu : scan code = $00 et KeyChar = #0.
    Certains terminaux mappent aussi $46 (ScrLk+Ctrl). }
  If (Ev.KeyCode = 0) Or (Ev.KeyCode = $46) Then
   EmuDbg_IsBreakKey := True;
 End;
End;

{ --- Drainer le buffer Crt (KeyPressed/ReadKey) pour detecter Ctrl+C
      ou Ctrl+Break depuis les boucles emulateur qui n utilisent pas
      le pump d evenements DEVENV. Retourne True si une demande de
      pause a ete enregistree. --- }

Function EmuDbg_PollCrtBreak: Boolean;
Var
 C: Char;
Begin
 EmuDbg_PollCrtBreak := False;
 If KeyPressed Then Begin
  C := ReadKey;
  If C = #3 Then Begin
   EmuDbg_PollCrtBreak := True;
  End Else If C = #0 Then Begin
   If KeyPressed Then Begin
    C := ReadKey;
    { Scan code 0 = Ctrl+Break sur PC BIOS }
    If C = #0 Then EmuDbg_PollCrtBreak := True;
   End Else
    EmuDbg_PollCrtBreak := True;
  End;
 End;
End;

{ --- Traiter un evenement global --- }

Procedure RunTranspilerOnFile(ExeName, OutExt: String);
Var
 NodeIdx : Integer;
 NodeCap : String;
 SolDir  : String;
 ProjDir : String;
 SrcPath : String;
 OutPath : String;
 ExePath : String;
 WIdx    : Integer;
 I       : Integer;
Begin
 NodeIdx := CtxMenu.NodeIdx;
 If (NodeIdx < 0) Or (NodeIdx >= SolExplorer.NodeCount) Then Exit;
 NodeCap := SolExplorer.Nodes[NodeIdx].RelPath;
 If NodeCap = '' Then Exit;
 { Construire le chemin source (meme logique que OpenExplorerFileNode) }
 If SolutionLoaded And (CurrentSolution.ProjectCount > 0) Then Begin
  SolDir := CurrentSolution.Info.SolutionPath;
  If Length(SolDir) > 0 Then Begin
   If (SolDir[Length(SolDir)] <> '\') And
      (SolDir[Length(SolDir)] <> '/') Then
    SolDir := SolDir + '\';
  End;
  { BOGUE REEL (2026-08-08) : voir la note d en-tete complete de           }
  { FindProjectIndexForExplorerNode - utilisait TOUJOURS Projects[0]. }
  ProjDir := ExtractFilePath(CurrentSolution.Projects[
   FindProjectIndexForExplorerNode(SolExplorer, NodeIdx)].ProjectPath);
  SrcPath := SolDir + ProjDir + NodeCap;
  For I := 1 To Length(SrcPath) Do
   If SrcPath[I] = '/' Then SrcPath[I] := '\';
 End Else
  SrcPath := NodeCap;
 { Chemin du fichier de sortie : meme dossier, extension remplacee }
 OutPath := ChangeFileExt(SrcPath, OutExt);
 { Chercher le transpilateur : meme dossier que DEVENV.EXE, WIN32\, puis CWD }
 ExePath := ExtractFilePath(ParamStr(0)) + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExtractFilePath(ParamStr(0)) + 'WIN32\' + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExeName;
 If Not FileExists(ExePath) Then Begin
  ShowMessageBox('Transpilateur',
   'Transpilateur introuvable :' + #13#10 + ExeName,
   MB_OK, MI_ERROR);
  AppendOutput(OutputPanel, 'Transpilateur introuvable : ' + ExeName, 2);
  Exit;
 End;
 { Lancer directement (le transpilateur cree son propre fichier de sortie) }
 AppendOutput(OutputPanel,
  'Transpilation : ' + ExeName + ' ' + SrcPath, 0);
 Exec(ExePath, '"' + SrcPath + '"');
 { Verifier le fichier produit }
 If Not FileExists(OutPath) Then Begin
  ShowMessageBox('Transpilateur',
   'Aucun fichier produit :' + #13#10 + OutPath,
   MB_OK, MI_ERROR);
  AppendOutput(OutputPanel, 'Aucun fichier produit : ' + OutPath, 2);
  Exit;
 End;
 If EditorReady Then SyncActiveWindowOut;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 WIdx := FindEditorByFileName(OutPath);
 If WIdx >= 0 Then
  ActivateWindow(WIdx)
 Else Begin
  CreateEditorWindow(OutPath);
  WIdx := WinMgr.ActiveIdx;
  LoadFile(Editors[WIdx]^.Buffer, OutPath);
  ActiveEditor := Editors[WIdx]^;
 End;
 EditorReady := True;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel, 'Transpilation terminee : ' + OutPath, 0);
End;

{ --- Deboguer > "Desassembler l executable..." : appelle DISEXE.PAS
  (cibles DOS/DPMI -CD/-CP, autodetecte aussi le format PE Windows) ou
  DISPRG.PAS (cible Atari ST -CATARIST) sur le binaire actuellement
  charge dans le panneau emulateur, puis ouvre le .ASM/.S resultant
  dans un nouvel onglet editeur - meme motif que RunTranspilerOnFile
  ci-dessus, mais la source vient du panneau emulateur (EmuPanel),
  pas d un noeud de l Explorateur de solutions. }

Procedure RunDisassemblerOnEmulatorBinary;
Var
 BinaryPath, OutPath, ExeName, ExePath: String;
 WIdx: Integer;
Begin
 If (Not EmuPanel.Loaded) Or (EmuPanel.BinaryPath = '') Then Begin
  ShowMessageBox('Desassembler l''executable',
   'Aucun executable charge dans l''emulateur.', MB_OK, MI_INFO);
  Exit;
 End;
 BinaryPath := EmuPanel.BinaryPath;
 If (EmuPanel.TargetCPU = '-CD') Or (EmuPanel.TargetCPU = '-CP') Then Begin
  ExeName := 'DISEXE.exe';
  OutPath := ChangeFileExt(BinaryPath, '.ASM');
 End Else If EmuPanel.TargetCPU = '-CATARIST' Then Begin
  ExeName := 'DISPRG.exe';
  OutPath := ChangeFileExt(BinaryPath, '.S');
 End Else Begin
  ShowMessageBox('Desassembler l''executable',
   'Cible non prise en charge par cet outil : ' + EmuPanel.TargetCPU +
   #13#10 + '(seuls DOS/DPMI/Windows -CD/-CP et Atari ST -CATARIST ' +
   'sont geres, via DISEXE.PAS/DISPRG.PAS).', MB_OK, MI_INFO);
  Exit;
 End;
 { Meme convention de recherche que RunTranspilerOnFile : a cote de
   DEVENV.exe, puis WIN32\, puis PATH. }
 ExePath := ExtractFilePath(ParamStr(0)) + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExtractFilePath(ParamStr(0)) + 'WIN32\' + ExeName;
 If Not FileExists(ExePath) Then
  ExePath := ExeName;
 If Not FileExists(ExePath) Then Begin
  ShowMessageBox('Desassembler l''executable',
   'Outil introuvable : ' + ExeName, MB_OK, MI_ERROR);
  Exit;
 End;
 AppendOutput(OutputPanel,
  'Desassemblage : ' + ExeName + ' "' + BinaryPath + '"', 0);
 Exec(ExePath, '"' + BinaryPath + '"');
 If Not FileExists(OutPath) Then Begin
  ShowMessageBox('Desassembler l''executable',
   'Aucun fichier produit : ' + OutPath, MB_OK, MI_ERROR);
  AppendOutput(OutputPanel, 'Echec du desassemblage : ' + OutPath, 2);
  Exit;
 End;
 If EditorReady Then SyncActiveWindowOut;
 If StartPage.Visible Then Begin
  StartPage.Visible := False;
  FullRepaintNeeded := True;
 End;
 WIdx := FindEditorByFileName(OutPath);
 If WIdx >= 0 Then
  ActivateWindow(WIdx)
 Else Begin
  CreateEditorWindow(OutPath);
  WIdx := WinMgr.ActiveIdx;
  LoadFile(Editors[WIdx]^.Buffer, OutPath);
  ActiveEditor := Editors[WIdx]^;
 End;
 EditorReady := True;
 FullRepaintNeeded := True;
 AppendOutput(OutputPanel, 'Desassemblage termine : ' + OutPath, 0);
End;

{ --- Appliquer le resultat du dialogue Ajouter une reference : ajoute  }
{ chaque reference cochee (non deja presente) au projet courant et au  }
{ noeud "References" de l explorateur, puis persiste sur disque.       }

Procedure ApplyAddReferenceDialogResult(Var Dlg: TAddReferenceDialog);
Var
 I, RefsIdx, Added: Integer;
Begin
 RefsIdx := -1;
 For I := 0 To SolExplorer.NodeCount - 1 Do
  If SolExplorer.Nodes[I].Kind = ENK_REFERENCES Then Begin
   RefsIdx := I;
   Break;
  End;
 Added := 0;
 For I := 0 To Dlg.ItemCount - 1 Do Begin
  If Dlg.Items[I].Checked Then Begin
   If FindReferenceInProject(CurrentProject, Dlg.Items[I].Name) < 0 Then Begin
    AddReferenceToProject(CurrentProject, Dlg.Items[I].Name);
    If RefsIdx >= 0 Then Begin
     AddExplorerNode(SolExplorer, Dlg.Items[I].Name, ENK_REFERENCE, RefsIdx);
     SolExplorer.Nodes[RefsIdx].HasChildren := True;
    End;
    Inc(Added);
   End;
  End;
 End;
 If Added > 0 Then Begin
  RefreshExplorer(SolExplorer);
  SolExplorer.NeedRepaint := True;
  If SolutionLoaded Then Begin
   SolutionModified := True;
   SaveCurrentSolution;
  End;
 End;
End;

