  { Detecter fin de bloc Java %> }
  If InCode And (Pos < Len) And
     (Line[Pos] = '%') And (Line[Pos + 1] = '>') Then
  Begin
   { Colorier %> en gris fonce (directive) }
   Clr := Byte(TokenClassToColor(TC_PREPROCESSOR));
   Colors[Pos - 1] := Clr;
   Colors[Pos] := Clr;
   Inc(Pos, 2);
   InCode := False;
   Continue;
  End;
  { Selon le mode, utiliser le tokenizer Java ou XML }
