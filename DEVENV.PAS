 { EXTENSION (2026-08-08) : le panneau "Explorateur de solutions" devient   }
 { un conteneur a onglets, comme Visual Studio - 4 onglets partageant           }
 { la meme zone (titre + bande d onglets communs), un seul visible a la          }
 { fois. Voir ActiveExplorerTab, DrawExplorer, HandleExplorerEvent. }
 TExplorerTabKind = (
  ETAB_SOLUTION,       { Explorateur de solutions (arbre existant)   }
  ETAB_GITCHANGES,     { Modification Git (git status/add/commit)    }
  ETAB_TEAMEXPLORER,   { Team Explorer (branches/sync/historique)    }
  ETAB_PASCHAT         { PasChat (agent conversationnel Pascal)      }
 );

 { --- Git : etat d un fichier modifie (onglet Modification Git) --- }
 TGitFileStatus = Record
  Path      : String[255];   { chemin relatif au depot              }
  IndexStat : Char;          { statut dans l index (colonne 1 de     }
                              { "git status --porcelain")            }
  WorkStat  : Char;          { statut dans l arbre de travail (col 2)}
  Staged    : Boolean;       { True si IndexStat <> ' ' et <> '?'    }
  Selected  : Boolean;       { ligne selectionnee (pour l affichage)  }
 End;

 { --- Git : une branche (locale ou distante) --- }
 TGitBranch = Record
  Name    : String[127];
  Current : Boolean;        { branche courante (marquee "*")        }
  Remote  : Boolean;        { branche distante (ex. remotes/origin/) }
 End;

 { --- Git : une entree d historique (un commit) --- }
 TGitLogEntry = Record
  Hash    : String[12];
  Author  : String[63];
  DateStr : String[19];
  Subject : String[127];
 End;

 { --- Team Explorer : vue active (sous-onglet) --- }
 TTeamViewKind = (TVIEW_BRANCHES, TVIEW_SYNC, TVIEW_HISTORY);

 { --- PasChat : un message de la conversation (bulle) --- }
 TChatSender = (CHS_USER, CHS_BOT);
 TChatMessage = Record
  Sender  : TChatSender;
  { AnsiString, pas String[255] : le code Pascal genere par PasChat        }
  { peut largement depasser 255 caracteres. }
  Text    : AnsiString;
 End;

 { --- Tampon generique pour capturer la sortie texte d une commande      }
 { externe (git, ...) - voir RunCommandCaptureOutput. --- }
 TCmdOutputLines = Array[0..MAX_CMD_OUTPUT_LINES - 1] Of String[255];

 { --- Lignes resultant du retour a la ligne automatique d un texte       }
 { (bulles de conversation PasChat) - voir WrapText. --- }
 TWrapLines = Array[0..MAX_WRAP_LINES - 1] Of String[255];

 { Noeud dans l arbre de l explorateur }
 TExplorerNode = Record
  Caption    : String[127];         { texte affiche                  }
  { RelPath (2026-08-08) : chemin relatif REEL du fichier par rapport   }
  { au dossier du projet, utilise pour reconstruire le chemin complet     }
  { (voir OpenExplorerFileNode/Hex/Form, RunTranspilerOnFile) - distinct    }
  { de Caption depuis que les fichiers sous "Properties" affichent un        }
  { Caption ABREGE (ex. "AssemblyInfo.cs") different du chemin reel             }
  { ("Properties\AssemblyInfo.cs"). Pour tout AUTRE noeud, RelPath = Caption. }
  RelPath    : String[255];
  Kind       : TExplorerNodeKind;   { type de noeud                  }
  ParentIdx  : Integer;             { index du parent (-1 = racine)  }
  Level      : Integer;             { profondeur dans l arbre        }
  Expanded   : Boolean;             { noeud deplie                   }
  Visible    : Boolean;             { visible dans l affichage       }
  Selected   : Boolean;             { noeud selectionne              }
  HasChildren: Boolean;             { possede des enfants            }
  Tag        : LongInt;             { valeur utilisateur             }
 End;

 { Explorateur de solution }
 TSolutionExplorer = Record
  Nodes      : Array[0..MAX_EXPLORER_NODES - 1] Of TExplorerNode;
  NodeCount  : Integer;             { nombre de noeuds               }
  SelectedIdx: Integer;             { index du noeud selectionne     }
  ScrollTop  : Integer;             { premier noeud visible          }
  X          : Integer;             { position X du panneau          }
  Y          : Integer;             { position Y du panneau          }
  Width      : Integer;             { largeur du panneau             }
  Height     : Integer;             { hauteur du panneau             }
  SplitterX  : Integer;             { position X du splitter         }
  Dragging   : Boolean;             { splitter en cours de drag      }
  NeedRepaint: Boolean;             { doit etre redessine            }
  Renaming   : Boolean;             { mode renommage actif           }
  RenameIdx  : Integer;             { index du noeud en renommage    }
  RenameBuf  : String[127];         { tampon de saisie renommage     }
  RenameCPos : Integer;             { position curseur renommage     }
  { EXTENSION (2026-08-08) : champ de recherche live, comme Visual       }
  { Studio - filtre l arbre pendant la frappe (voir RefreshExplorer). }
  SearchBuf     : String[63];       { texte de recherche courant     }
  SearchCPos    : Integer;          { position curseur recherche     }
  SearchFocused : Boolean;          { champ de recherche actif       }
 End;

 { Type de source pour le panneau de proprietes }
 TPropertyKind = (
  PK_NONE,             { aucune source                           }
  PK_PROJECT,          { proprietes du projet                    }
  PK_FILE,             { proprietes du fichier                   }
  PK_SOLUTION,         { proprietes de la solution               }
  PK_REFERENCE,        { proprietes d une reference              }
  PK_FRM_CONTROL       { proprietes d un controle de formulaire  }
 );

 { Mode de tri des proprietes }
 TPropertySort = (
  PS_ALPHABETICAL,     { tri alphabetique                        }
  PS_CATEGORIZED       { tri par categorie                       }
 );

 { Propriete individuelle (nom/valeur) }
 TPropertyItem = Record
  Name       : String[63];           { nom de la propriete            }
  Value      : String[255];          { valeur de la propriete         }
  Category   : String[31];           { categorie (pour tri)           }
  ReadOnly   : Boolean;              { propriete en lecture seule     }
  Editing    : Boolean;              { en cours d edition             }
  Key        : String[31];          { identifiant stable pour le commit }
  IsEnum     : Boolean;              { valeur cyclee par simple clic  }
 End;

 { Panneau de proprietes }
 TPropertiesPanel = Record
  Items      : Array[0..MAX_PROPERTIES - 1] Of TPropertyItem;
  ItemCount  : Integer;              { nombre de proprietes           }
  SelectedIdx: Integer;              { index de la propriete active   }
  ScrollTop  : Integer;              { premiere ligne visible         }
  X          : Integer;              { position X du panneau          }
  Y          : Integer;              { position Y du panneau          }
  Width      : Integer;              { largeur du panneau             }
  Height     : Integer;              { hauteur du panneau             }
  NameColWidth: Integer;             { largeur colonne nom            }
  SplitterY  : Integer;              { position Y du splitter         }
  Dragging   : Boolean;              { splitter en cours de drag      }
  NeedRepaint: Boolean;              { doit etre redessine            }
  SourceKind : TPropertyKind;        { type de source active          }
  SourceTitle: String[63];           { titre de la source             }
  SortMode   : TPropertySort;        { mode de tri                    }
  EditBuffer : String[255];          { tampon d edition temporaire    }
  EditActive : Boolean;              { edition en cours               }
 End;

 { Onglets du panneau de sortie }
 TOutputTabKind = (
  OTK_BUILD,            { sortie de build                     }
  OTK_DEBUG,            { sortie de debogage                  }
  OTK_SEARCH            { resultats de recherche              }
 );

 { Type de ligne de sortie }
 TOutputLineKind = (
  OLK_INFO,             { information (blanc)                 }
  OLK_ERROR,            { erreur (rouge)                      }
  OLK_WARNING,          { avertissement (jaune/orange)        }
  OLK_SUCCESS           { succes (vert)                       }
 );

 { Ligne du panneau de sortie }
 TOutputLine = Record
  Text     : String[255];          { texte de la ligne              }
  Kind     : TOutputLineKind;      { type du message                }
  FileName : String[127];          { fichier source associe         }
  Line     : Integer;              { numero de ligne source         }
  Col      : Integer;              { numero de colonne source       }
 End;

 { Panneau de sortie }
 TOutputPanel = Record
  Lines    : Array[0..MAX_OUTPUT_LINES - 1] Of TOutputLine;
  LineCounts: Array[0..OUTPUT_TAB_COUNT - 1] Of Integer;
  ActiveTab: TOutputTabKind;       { onglet actif                   }
  ScrollTop: Integer;              { premiere ligne visible         }
  SelectedIdx: Integer;            { index de la ligne selectionnee }
  X        : Integer;              { position X du panneau          }
  Y        : Integer;              { position Y du panneau          }
  Width    : Integer;              { largeur du panneau             }
  Height   : Integer;              { hauteur du panneau             }
  SplitterY: Integer;              { position Y du splitter         }
  Dragging : Boolean;              { splitter en cours de drag      }
  Visible  : Boolean;              { panneau visible                }
  NeedRepaint: Boolean;            { doit etre redessine            }
 End;

 { Type de shell du terminal }
 TShellKind = (SK_CMD, SK_POWERSHELL, SK_BASH, SK_AMIGADOS, SK_NCOMMANDER,
  SK_OS2REXX);

 { Noeud de liste chainee pour l historique d affichage du terminal }
 PTermLine = ^TTermLine;
 TTermLine = Record
  S    : String;
  Prev : PTermLine;
  Next : PTermLine;
 End;

 { Terminal integre }
 TTerminalPanel = Record
  Lines     : Array[0..MAX_TERM_LINES - 1] Of String;
  LineCount : Integer;             { nombre de lignes dans le buffer}
  ScrollTop : Integer;             { premiere ligne visible (legacy)}
  HistHead  : PTermLine;           { tete de liste (plus ancien)    }
  HistTail  : PTermLine;           { queue de liste (plus recent)   }
  HistCount : LongInt;             { nombre de noeuds en liste      }
  ScrollOffset: LongInt;           { 0=bas, N=remonte de N lignes   }
  { Defilement horizontal, en colonnes (2026-08-30, demande explicite de   }
  { l utilisateur - voir TERM_HSCROLL_HEIGHT plus haut). }
  HScrollOffset: LongInt;
  InputLine : String;              { ligne de saisie en cours       }
  InputCol  : Integer;             { position du curseur de saisie  }
  PartialLine: String;             { fragment de ligne incomplete   }
  X         : Integer;             { position X du panneau          }
  Y         : Integer;             { position Y du panneau          }
  Width     : Integer;             { largeur du panneau             }
  Height    : Integer;             { hauteur du panneau             }
  Visible   : Boolean;             { panneau visible                }
  NeedRepaint: Boolean;            { doit etre redessine            }
  Shell     : TShellKind;          { type de shell                  }
  Echo      : Boolean;             { affichage du prompt actif      }
  TermHistory: Array[1..MAX_TERM_HISTORY] Of String;
  NumberHistory: Integer;          { nombre d entrees dans l histo  }
  HistoryPos: Integer;             { position courante dans l histo }
  DirStack  : Array[1..MAX_TERM_DIRSTACK] Of String;
  NumberDirStack: Integer;         { taille de la pile repertoires  }
  VirtDrive : ShortInt;            { -1=hote, 0=A:, 1=B:            }
  VirtCwd   : String;              { chemin courant sur disque virt }
  { Completion de nom de fichier par <TAB> (2026-08-29, demande explicite  }
  { de l utilisateur : "comme le fait CMD.EXE") - voir TermTab_Complete.   }
  { Cycle entre les correspondances tant que <TAB> est presse a nouveau    }
  { SANS autre frappe entre-temps (TabActive bascule a False des qu une    }
  { autre touche modifie InputLine - voir HandleTerminalEvent). }
  TabActive    : Boolean;
  TabTokenStart: Integer;          { position dans InputLine ou le "mot" }
                                    { en cours de completion commence     }
  TabDirPart   : String;           { prefixe repertoire du mot (conserve }
                                    { tel quel a chaque cycle)            }
  TabMatchCount: Integer;
  TabMatchIdx  : Integer;
  TabMatches   : Array[0..31] Of String[80];
  { Interprete REXX integre (2026-08-30, demande explicite de l utilisateur }
  { - integration complete de REXX.PAS, voir le grand bloc Rexx_* pres de   }
  { TermCmd_IMGMOUNT) : etat de la fibre Win32 en cours d execution dans ce }
  { panneau, si un script REXX y tourne (SK_OS2REXX uniquement). }
  RexxFiber      : Pointer;
  RexxActive     : Boolean;
  RexxWaiting    : (rwNone, rwLine, rwKey);
  RexxPendingLine: String;
  RexxPendingKey : Char;
 End;

 { Etat d un disque virtuel FAT12/16/32 monte via /DISK0, /DISK1,
   /DISK80 ou /DISK81 }
 TFatVol = Record
  Mounted        : Boolean;
  IsD64          : Boolean;        { image Commodore 64 .D64        }
  D64Tracks      : Byte;           { nombre de pistes (35 ou 40)    }
  IsH8D          : Boolean;        { image Heath/Zenith .H8D (HDOS/CP-M-80/UCSD p-System) }
  H8DFsType      : Byte;           { 1=HDOS 2=CP/M-80 3=UCSD p-System (voir H8D_FS_*) }
  IsHPFS         : Boolean;        { partition OS/2 HPFS (type MBR $07,     }
                                    { signature SuperBlock verifiee - voir   }
                                    { HPFS_CheckSuperBlock), lecture seule   }
  HPFSRootFNode  : LongInt;        { FNode racine, partition-relatif        }
  HPFSPartSize   : LongInt;        { taille de la partition en secteurs     }
                                    { (bornes pour HPFS_ScanForDirBlk)       }
  FATType        : Byte;           { 12, 16 ou 32                   }
  BytesPerSector : Word;
  SectorsPerCluster: Byte;
  ReservedSectors: Word;
  NumFATs        : Byte;
  RootEntries    : Word;           { 0 pour FAT32 (racine = cluster) }
  RootCluster    : LongInt;        { FAT32 seulement : 1er cluster racine }
  TotalSectors   : LongInt;
  SectorsPerFAT  : LongInt;
  PartitionStart : LongInt;        { LBA de la partition FAT (MBR disque
                                      dur) ; 0 pour une image disquette
                                      ou un disque dur sans MBR        }
  FATStart       : LongInt;
  RootStart      : LongInt;
  DataStart      : LongInt;
  RootDirSectors : LongInt;        { 0 pour FAT32 }
  ClusterCount   : LongInt;
  VolLabel       : String[11];
  CachedFatLBA   : LongInt;
  CachedFatBuf   : Array[0..511] Of Byte;
 End;

 { Une plage contigue de secteurs allouee a un fichier HPFS (feuille de   }
 { l arbre B+ d allocation) - voir HPFS_AddAllocBplus. }
 THPFSRun = Record
  DiskSec: LongInt;
  RunLen : LongInt;
 End;

 { Volume CD-ROM ISO9660 monte en lecture seule depuis une image .iso     }
 { (/CDROM0:/CDROM1:) - voir Emu_CdromOpenOne/Emu_IsoResolve. Contrairement}
 { a TFatVol (FAT12/16, mutable, avec cache), c est une simple "racine"   }
 { de depart (LBA+taille de l extent racine ISO9660) : la resolution de   }
 { chemin parcourt directement les enregistrements de repertoire (pas de  }
 { table des chemins ni d arbre pre-charge), suffisant pour un lecteur    }
 { en lecture seule sans ecriture. }
 TEmuCdromVol = Record
  Open          : Boolean;
  FileName      : String;
  F             : File;
  IsoSize       : LongInt;
  RootLBA       : LongInt;
  RootSize      : LongInt;
  VolLabel      : String[32];
  CopyrightFile : String[38];
  AbstractFile  : String[37];
  BiblioFile    : String[37];
  DriveLetter   : Byte;          { 0=A: .. 25=Z: ; 255 si Open=False }
 End;

 { Un enregistrement de repertoire ISO9660 decode (voir                  }
 { Emu_IsoEntryFromRecord) - Name est deja en majuscules, sans le         }
 { suffixe ";n" de version, tronque a 12 caracteres (8.3) si l identifiant}
 { d origine (Niveau 2, jusqu a 30 caracteres) est plus long - voir le    }
 { commentaire pres de Emu_IsoEntryFromRecord pour cette simplification. }
 TEmuIsoEntry = Record
  IsDir  : Boolean;
  Name   : String[12];
  LBA    : LongInt;
  Size   : LongInt;
  Year, Month, Day, Hour, Minute, Second : Byte;
 End;

 { Un secteur logique ISO9660 brut (2048 octets, voir EMU_ISO_SECTOR). }
 TEmuIsoSector = Array[0..EMU_ISO_SECTOR - 1] Of Byte;

 { Norton Commander (5e shell du panneau Terminal, DEVENV.PAS) - navigation
   double-panneau sur la disquette virtuelle FAT deja utilisee par les 4
   autres shells (jamais le systeme de fichiers reel de la machine). }
 TNCEntry = Record
  Name    : String[80];            { nom affiche : long VFAT reel si     }
                                    { present et valide (voir Fat_LFNAcc* }
                                    { / NCListDir, 2026-08-23), sinon 8.3 }
                                    { (tronque a 80 caracteres si un nom  }
                                    { long depasse - limite documentee,   }
                                    { acceptee plutot que d elargir un    }
                                    { type largement partage)             }
  ShortName: String[12];           { alias 8.3 toujours present sur      }
                                    { disque virtuel FAT (vide sur les    }
                                    { autres backends - hote/D64/H8D/HPFS)}
  Size    : LongInt;                { taille en octets (0 si repert.)}
  IsDir   : Boolean;                { True = sous-repertoire         }
  FTime   : Word;                   { heure DOS empaquetee (FAT)     }
  FDate   : Word;                   { date DOS empaquetee (FAT)      }
  PackedDT: LongInt;                { date/heure empaquetee (hote,   }
                                    { format SearchRec.Time/UnpackTime) }
  Cluster : LongInt;                { 1er cluster (disque virtuel)   }
 End;

 TNCPane = Record
  Path      : String;              { chemin courant (chemin hote absolu }
                                    { avec lettre de lecteur, ou '\..'       }
                                    { sur disque virtuel)            }
  Entries   : Array[0..MAX_NC_ENTRIES - 1] Of TNCEntry;
  Count     : Integer;
  Cursor    : Integer;             { entree selectionnee (0-based)  }
  ScrollTop : Integer;             { 1ere entree visible             }
  Marked    : Array[0..MAX_NC_ENTRIES - 1] Of Boolean; { selection multiple }
  MarkCount : Integer;
  SortMode  : Integer;             { 0=Nom 1=Extension 2=Heure(date) }
                                    { 3=Taille 4=Desordre (menu Gauche/Droite) }
  InfoMode  : Boolean;             { menu Gauche/Droite, item "Info" -    }
                                    { affiche l espace disque/l etiquette  }
                                    { de volume/les stats du repertoire       }
                                    { a la place de la liste de fichiers }
 End;

 { TODO NC 2/3 : navigation, dialogues modaux pour les operations sur    }
 { fichiers (F5 Copier, F6 RenDep, F7 CreRep, F8 Supprimer), apercu             }
 { (F3) et menu deroulant complet (F9). }
 TNCMode = (
  ncBrowse,          { navigation normale                            }
  ncPromptMkDir,     { F7 : saisie du nom du nouveau repertoire       }
  ncPromptCopy,      { F5 : saisie du chemin destination              }
  ncPromptRenMov,    { F6 : saisie du nouveau nom/chemin              }
  ncConfirmDelete,   { F8 : confirmation Oui/Non                      }
  ncConfirmOverwrite,{ F5 : "Le fichier X existe deja" - Ecraser/Tous/ }
                     { Sauter, fidele au vrai NC 5.0 (capture DOSBox   }
                     { fournie par l utilisateur) - voir NCCopyStepNext}
  ncViewFile,        { F3 : apercu texte en lecture seule             }
  ncMenuBar,         { F9 : menu deroulant Gauche/Fichiers/Disque/    }
                     { Commandes/Droite                               }
  ncMessage,         { message simple (ex: "non implemente"), toute   }
                     { touche le ferme                                }
  ncHistory,         { Commandes/Historique : liste des commandes           }
                     { tapees dans ce panneau (NC.PAS: DialogHistory)  }
  ncTree,            { Commandes/Arbre NCD : arborescence des                 }
                     { sous-repertoires du lecteur du panneau actif    }
  ncViewSearch,      { F7 dans la visionneuse F3 : saisie du texte     }
                     { recherche                                      }
  ncViewSelectViewer,{ F8 dans la visionneuse F3 : choix du format          }
                     { d affichage (WPVIEW: "Select Viewer")          }
  ncChangeDrive      { Alt+F1 (panneau gauche) / Alt+F2 (panneau droite) :  }
                     { choix de la lettre de lecteur (NC.PAS: ChangeDrive), }
                     { voir NCBuildChangeDriveList/NCState.Cd*             }
 );

 TNCTreeNode = Record
  Path  : String;                  { chemin absolu complet          }
  Depth : Integer;                 { niveau d indentation (0=racine) }
 End;

 TNCState = Record
  Panes       : Array[0..1] Of TNCPane;
  Active      : Integer;           { 0 = gauche, 1 = droite          }
  { BOGUE REEL (2026-08-23, 3e rapport du meme utilisateur) : Slot etait  }
  { un DRAPEAU GLOBAL UNIQUE partage par les deux panneaux (limitation     }
  { deja documentee au moins depuis le selecteur de lecteur, voir          }
  { ncChangeDrive) - choisir un disque virtuel pour UN panneau changeait   }
  { silencieusement l interpretation de L AUTRE, cassant sa navigation      }
  { normale (Entree/".."/Copier) des qu on y touchait. Remplace par un      }
  { slot PAR PANNEAU - Slot lui-meme est conserve pour l instant en tant    }
  { qu alias du panneau ACTIF (Panes[Active]), pour tout code qui n a pas   }
  { encore ete audite/migre vers PaneSlot[Side], mais toute la navigation   }
  { par panneau (NCListDir, Copier/RenDep/MkDir/Supprimer/Voir/Ouvrir)      }
  { utilise desormais PaneSlot[Side] directement. }
  PaneSlot    : Array[0..1] Of ShortInt; { -1 = hote, >=0 = FatVol, PAR PANNEAU }
  Slot        : ShortInt;          { -1 = systeme hote, >=0 = FatVol ; ALIAS du panneau actif, voir ci-dessus }
  Mode        : TNCMode;
  Initialized : Boolean;
  CharW       : Integer;           { largeur de caractere mesuree    }
  CharH       : Integer;           { hauteur de ligne mesuree        }
  PromptBuf   : String;            { texte saisi dans le dialogue actif }
  MessageReturnMode : TNCMode;     { mode a restaurer apres fermeture de   }
                                    { ncMessage (pas toujours ncBrowse -    }
                                    { ex: message depuis la visionneuse F3) }
  MessageIsError : Boolean;        { BOGUE REEL (2026-08-23, 5e rapport) :  }
                                    { toutes les boites ncMessage (succes   }
                                    { comme echec) partageaient le meme      }
                                    { style bleu/cyan neutre - le vrai NC    }
                                    { (ErrorOk dans le projet de reference   }
                                    { NORTONCOMMANDER-0/NC.PAS) affiche les  }
                                    { erreurs dans une boite ROUGE ($4F)      }
                                    { nettement distincte, capture d ecran   }
                                    { fournie par l utilisateur a l appui -  }
                                    { True fait basculer le rendu ncMessage  }
                                    { sur ce style rouge (voir NCShowError). }
  ViewLines   : Array[0..MAX_NC_VIEW_LINES - 1] Of String; { lignes texte  }
  ViewCount   : Integer;
  ViewTop     : Integer;           { defilement (ligne ou rangee hex)  }
  ViewHex     : Boolean;           { F4 : False=Texte True=Hexadecimal }
  ViewWrap    : Boolean;           { F2 : renvoi a la ligne (mode Texte) }
  ViewCol     : Integer;           { defilement horizontal (mode Texte      }
                                    { non renvoye a la ligne)          }
  ViewCharsPerRow : Integer;       { cache : largeur d affichage en           }
                                    { caracteres, mesuree au dernier tracer }
  ViewFileName: String;            { chemin complet du fichier visualise }
  ViewFileSize: LongInt;           { taille reelle du fichier (peut          }
                                    { depasser MAX_NC_VIEW_RAW)        }
  ViewRaw     : Array[0..MAX_NC_VIEW_RAW - 1] Of Byte; { octets bruts     }
  ViewRawSize : LongInt;           { nombre d octets reellement charges }
  ViewSearchBuf : String;          { F7 : texte recherche              }
  ViewSelIdx  : Integer;           { F8 : curseur dans Select Viewer  }
  MenuTop     : Integer;           { 0..4 : menu superieur selectionne }
  MenuItem    : Integer;           { item selectionne dans le menu deroulant }
  HistCursor  : Integer;           { index (1-based) dans TP.TermHistory }
  TreeNodes   : Array[0..MAX_NC_TREE_NODES - 1] Of TNCTreeNode;
  TreeCount   : Integer;
  TreeCursor  : Integer;           { 0-based }
  TreeTop     : Integer;           { defilement de l arbre          }
  TreeForCopy : Boolean;           { True : cet Arbre a ete ouvert via F10  }
                                    { depuis le prompt Copier (comme le vrai }
                                    { NC 5.0) - Entree renvoie alors le      }
                                    { chemin choisi dans PromptBuf et         }
                                    { revient a ncPromptCopy au lieu de       }
                                    { naviguer un panneau et revenir a       }
                                    { ncBrowse. }
  CdSide      : Integer;           { 0=gauche 1=droite - panneau ayant  }
                                    { declenche Alt+F1/Alt+F2            }
  CdCount     : Integer;
  CdLetter    : Array[0..MAX_NC_CD_ENTRIES - 1] Of Char;
  CdIsVirt    : Array[0..MAX_NC_CD_ENTRIES - 1] Of Boolean;
  CdSlotIdx   : Array[0..MAX_NC_CD_ENTRIES - 1] Of Integer;
  CdCursor    : Integer;
  { Lot de copie F5 resumable (2026-08-23, 6e rapport - "il faut copier    }
  { sans se poser de question... s il le fichier existe, il pose la        }
  { question Ecraser/Tous/Sauter", capture DOSBox/NC5 fournie a l appui) : }
  { HandleNCommanderEvent traite un evenement clavier par appel (jamais de }
  { boucle bloquante ReadKey comme le DOS original) - impossible de mettre }
  { le traitement du lot "en pause" au milieu d une boucle For classique   }
  { pour attendre la reponse Ecraser/Tous/Sauter de l utilisateur. Ces      }
  { champs portent donc l etat du lot de copie EN COURS a travers          }
  { plusieurs evenements/images, voir NCCopyBatchStart/NCCopyStepNext.     }
  CopySrcSide    : Integer;        { panneau source, fige au debut du lot }
  CopyDstSide    : Integer;        { panneau destinataire, fige au debut  }
