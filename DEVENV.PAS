{ Aller dans le sous-repertoire nomme Name du panneau Side (ou remonter }
{ d un niveau si Name = '..'), puis recharger ce panneau. --- }
Procedure NCEnterDir(Side: Integer; Const Name: String);
Var
 NewPath: String;
Begin
 If Name = '..' Then
  NewPath := NCParentPath(NCState.Panes[Side].Path)
 Else Begin
  NewPath := NCState.Panes[Side].Path;
  { Deja termine par '\' ("\" virtuel ou "C:\" hote) : ne pas doubler. }
  If (Length(NewPath) > 0) And (NewPath[Length(NewPath)] = '\') Then
   NewPath := NewPath + Name
  Else
   NewPath := NewPath + '\' + Name;
 End;
 NCState.Panes[Side].Path := NewPath;
 NCListDir(NCState.PaneSlot[Side], NCState.Panes[Side]);
End;

{ Construire le chemin absolu Name a l interieur de DirPath, sans           }
{ doubler le separateur si DirPath se termine deja par '\'. --- }
Function NCFullPath(Const DirPath, Name: String): String;
Begin
 If (Length(DirPath) > 0) And (DirPath[Length(DirPath)] = '\') Then
  NCFullPath := DirPath + Name
 Else
  NCFullPath := DirPath + '\' + Name;
End;

{ Le curseur du panneau Side est-il sur l entree ".." (remontee au      }
{ parent, NCListDir) ? Elle ne doit jamais etre marquable ni la cible   }
{ de Copier/RenDep/Supprimer, seulement de la navigation (Entree). --- }
Function NCCursorOnDotDot(Side: Integer): Boolean;
Begin
 NCCursorOnDotDot := (NCState.Panes[Side].Count > 0) And
  (NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].Name = '..');
End;

{ --- F7/MKDIR, F8/Supprimer, F6/RenDep sur le systeme HOTE reel : ces   }
{ operations sont plus simples que sur la disquette virtuelle puisque       }
{ le Pascal standard (MkDir/RmDir/Erase/Rename) suffit. --- }
Function NCCmd_MkDirHost(ParentPath, DirName: String): Boolean;
Var
 Err: Word;
Begin
 NCCmd_MkDirHost := False;
 If DirName = '' Then Exit;
 {$I-} MkDir(NCFullPath(ParentPath, DirName)); {$I+}
 Err := IOResult;
 NCCmd_MkDirHost := (Err = 0);
End;

Function NCCmd_DeleteHost(FullPath: String; IsDir: Boolean): Boolean;
Var
 F: File;
 Err: Word;
Begin
 If IsDir Then Begin
  {$I-} RmDir(FullPath); {$I+}
 End Else Begin
  {$I-} Assign(F, FullPath); Erase(F); {$I+}
 End;
 Err := IOResult;
 NCCmd_DeleteHost := (Err = 0);
End;

Function NCCmd_RenameHost(OldFullPath, NewFullPath: String): Boolean;
Var
 F: File;
 Err: Word;
Begin
 {$I-} Assign(F, OldFullPath); Rename(F, NewFullPath); {$I+}
 Err := IOResult;
 NCCmd_RenameHost := (Err = 0);
End;

{ Convertit Len octets de Buf (a partir de Start, 0-based) en une chaine  }
{ affichable pour le mode Texte : les octets non imprimables (hors           }
{ 32..126) sont remplaces par '.', comme la colonne ASCII d un dump           }
{ hexadecimal classique - evite tout risque lie a des octets nuls ou           }
{ codes de controle dans un ShortString. Tronque a 255 caracteres           }
{ (limite native d un String en mode Turbo Pascal). --- }
Function NCViewBytesToLine(Const Buf: Array Of Byte; Start, Len: LongInt): String;
Var
 I: LongInt;
 B: Byte;
 R: String;
Begin
 If Len > 255 Then Len := 255;
 R := '';
 For I := 0 To Len - 1 Do Begin
  B := Buf[Start + I];
  If (B < 32) Or (B > 126) Then B := Ord('.');
  R := R + Chr(B);
 End;
 NCViewBytesToLine := R;
End;

{ Decoupe NCState.ViewRaw[0..ViewRawSize-1] (deja rempli par l appelant, }
{ hote ou disque virtuel) en lignes de texte sur CR/LF/CRLF               }
{ (NCState.ViewLines/ViewCount), pour le mode Texte du F3 par defaut -    }
{ partage entre toutes les sources de donnees de la visionneuse. --- }
Procedure NCViewSplitLines;
Var
 LineStart, I: LongInt;
Begin
 NCState.ViewCount := 0;
 LineStart := 0;
 I := 0;
 While (I < NCState.ViewRawSize) And (NCState.ViewCount < MAX_NC_VIEW_LINES) Do Begin
  If (NCState.ViewRaw[I] = 13) Or (NCState.ViewRaw[I] = 10) Then Begin
   NCState.ViewLines[NCState.ViewCount] :=
    NCViewBytesToLine(NCState.ViewRaw, LineStart, I - LineStart);
   Inc(NCState.ViewCount);
   If (NCState.ViewRaw[I] = 13) And (I + 1 < NCState.ViewRawSize) And
      (NCState.ViewRaw[I + 1] = 10) Then Inc(I); { sauter le LF du CRLF }
   Inc(I);
   LineStart := I;
  End Else
   Inc(I);
 End;
 If (LineStart < NCState.ViewRawSize) And (NCState.ViewCount < MAX_NC_VIEW_LINES) Then Begin
  NCState.ViewLines[NCState.ViewCount] :=
   NCViewBytesToLine(NCState.ViewRaw, LineStart, NCState.ViewRawSize - LineStart);
  Inc(NCState.ViewCount);
 End;
 If NCState.ViewCount = 0 Then Begin
  NCState.ViewLines[0] := '';
  NCState.ViewCount := 1;
 End;
End;

{ F3 : charger le fichier hote FullPath pour la visionneuse en lecture   }
{ seule - lecture binaire brute (NCState.ViewRaw/ViewRawSize, plafonnee  }
{ a MAX_NC_VIEW_RAW octets) qui alimente a la fois le mode Hexadecimal   }
{ (F4) et la recherche (F7), puis decoupage en lignes de texte           }
{ (NCState.ViewLines/ViewCount) pour le mode Texte par defaut. --- }
Procedure NCCmd_ViewFile(FullPath: String);
Var
 F: File;
 I: LongInt;
Begin
 NCState.ViewCount := 0;
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := True;
 NCState.ViewFileName := FullPath;
 NCState.ViewFileSize := 0;
 NCState.ViewRawSize := 0;
 {$I-} Assign(F, FullPath); Reset(F, 1); {$I+}
 If IOResult <> 0 Then Begin
  NCState.ViewLines[0] := '(impossible d''ouvrir le fichier)';
  NCState.ViewCount := 1;
  Exit;
 End;
 NCState.ViewFileSize := FileSize(F);
 I := NCState.ViewFileSize;
 If I > MAX_NC_VIEW_RAW Then I := MAX_NC_VIEW_RAW;
 {$I-} BlockRead(F, NCState.ViewRaw, I, NCState.ViewRawSize); {$I+}
 IOResult;
 Close(F);
 NCViewSplitLines;
End;

{ F3 sur un fichier d une disquette virtuelle Commodore 64 (.D64) :       }
{ StartTrack/StartSector viennent de TNCEntry.Cluster (empaquete par        }
{ NCListDir en Track Shl 8 Or Sector, D64 n a pas de "cluster" FAT).        }
{ Parcourt la chaine de secteurs de donnees exactement comme le ferait    }
{ le KERNAL C64 (LOAD) : chaque secteur non terminal contribue ses 254    }
{ octets de donnees (Buf[2..255]), le dernier secteur de la chaine            }
{ (Track de chainage = 0) ne contribue que jusqu a l octet indique par       }
{ le 2e octet de chainage - convention standard 1541 documentee dans          }
{ plusieurs sources independantes (ex. c1541/cbmconvert), mais jamais         }
{ recoupee avec la specification Commodore primaire : a corriger si un        }
{ fichier de test revele un decalage d un octet. --- }
Procedure NCCmd_ViewD64File(Slot: Byte; StartTrack, StartSector: Byte;
 Const DisplayName: String);
Begin
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := True;
 NCState.ViewFileName := DisplayName;
 D64_ReadFileChain(Slot, StartTrack, StartSector, NCState.ViewRaw,
  MAX_NC_VIEW_RAW, NCState.ViewRawSize);
 NCState.ViewFileSize := NCState.ViewRawSize;
 NCViewSplitLines;
End;

{ Disque > "Utilitaire reseau..." - extension DEV-COOLS sans equivalent   }
{ dans l ORIGINAL : etat courant de tout ce qui touche au reseau dans     }
{ l emulateur DOS 8086 (EmuPanel), pour qu un developpeur testant un      }
{ programme reseau DOS puisse voir d un coup d oeil ce qui est reellement }
{ emule (et donc pourquoi un programme peut echouer). Reutilise le        }
{ visualiseur texte F3 (NCState.ViewLines/ViewCount) comme un fichier      }
{ genere a la volee plutot qu un mode d affichage dedie. }
Procedure NCCmd_ViewNetworkStatus;
Var
 I, TotalChars: Integer;
 S: String;
 AnyFound: Boolean;

 Procedure Add(Const T: String);
 Begin
  If NCState.ViewCount < MAX_NC_VIEW_LINES Then Begin
   NCState.ViewLines[NCState.ViewCount] := T;
   Inc(NCState.ViewCount);
  End;
 End;

Begin
 NCState.ViewCount := 0;
 NCState.ViewTop := 0;
 NCState.ViewCol := 0;
 NCState.ViewHex := False;
 NCState.ViewWrap := False;
 NCState.ViewFileName := 'Utilitaires reseau - etat de l''emulateur DOS';
 NCState.ViewRawSize := 0;

 Add('ETAT RESEAU DE L''EMULATEUR DOS (Options > Emulateur > DOS)');
 Add('================================================================');
 Add('');
 Add('Reseau Novell (IPX/SPX) - INT 7Ah / INT 2Fh AX=7A00h');
 Add('----------------------------------------------------------------');
 If OptionsDlg.Data.DosNovell Then
  Add('  Case "Reseau Novell NetWare"  : cochee')
 Else
  Add('  Case "Reseau Novell NetWare"  : DEcochee (pile inactive)');
 If EmuIpx.Active Then Begin
  Add('  Etat de la pile               : ACTIVE');
  S := '  Adresse locale                : reseau ' +
   HexByte(EmuIpx.LocalNet[0]) + '-' + HexByte(EmuIpx.LocalNet[1]) + '-' +
   HexByte(EmuIpx.LocalNet[2]) + '-' + HexByte(EmuIpx.LocalNet[3]) +
   ', noeud ' +
   HexByte(EmuIpx.LocalNode[0]) + '-' + HexByte(EmuIpx.LocalNode[1]) + '-' +
   HexByte(EmuIpx.LocalNode[2]) + '-' + HexByte(EmuIpx.LocalNode[3]) + '-' +
   HexByte(EmuIpx.LocalNode[4]) + '-' + HexByte(EmuIpx.LocalNode[5]);
  Add(S);
  Add('');
  Add('  Sockets ouverts :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Sockets) Do
   If EmuIpx.Sockets[I].InUse Then Begin
    Add('    - ' + HexWord(EmuIpx.Sockets[I].SocketNum) + 'h');
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucun)');
  Add('');
  Add('  Ecoutes en attente (LISTEN poste, aucun paquet recu) :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Pending) Do
   If EmuIpx.Pending[I].InUse Then Begin
    Add('    - socket ' + HexWord(EmuIpx.Pending[I].SocketNum) + 'h, ECB a ' +
     HexWord(EmuIpx.Pending[I].ECBSeg) + ':' + HexWord(EmuIpx.Pending[I].ECBOfs));
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
  Add('');
  Add('  Paquets en file (SEND effectue, aucune ecoute correspondante) :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Queue) Do
   If EmuIpx.Queue[I].InUse Then Begin
    Add('    - destination ' + HexWord(EmuIpx.Queue[I].DestSocket) + 'h, ' +
     IntToStr(EmuIpx.Queue[I].Len) + ' octets');
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucun)');
  Add('');
  Add('  Connexions SPX actives :');
  AnyFound := False;
  For I := 0 To High(EmuIpx.Conns) Do
   If EmuIpx.Conns[I].InUse Then Begin
    S := '    - id ' + IntToStr(I + 1) + ' : local ' +
     HexWord(EmuIpx.Conns[I].LocalSocket) + 'h <-> distant ' +
     HexWord(EmuIpx.Conns[I].RemoteSocket) + 'h';
    If EmuIpx.Conns[I].Established Then S := S + ' (etablie)'
    Else S := S + ' (non etablie)';
    Add(S);
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
 End Else Begin
  Add('  Etat de la pile               : INACTIVE');
  Add('  (INT 7Ah/INT 2Fh AX=7A00h ne repondent pas - comme une vraie');
  Add('   machine sans IPX.COM/IPXODI charge)');
 End;
 Add('');

 Add('Ports serie (COM1-COM4) - INT 14h');
 Add('----------------------------------------------------------------');
 If EmuPanel.CPU.MemReady Then Begin
  Add('  COM1 (BDA 0040:0000) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $00)) + 'h');
  Add('  COM2 (BDA 0040:0002) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $02)) + 'h');
  Add('  COM3 (BDA 0040:0004) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $04)) + 'h');
  Add('  COM4 (BDA 0040:0006) : ' + HexWord(Emu_ReadWord(EmuPanel.CPU, $40, $06)) + 'h');
 End Else Begin
  Add('  (zone de donnees BIOS indisponible - aucune session emulateur');
  Add('   active pour l''instant : lancez d''abord un programme DOS)');
 End;
 Add('  => INT 14h (services serie BIOS) n''est PAS implante dans cet');
 Add('     emulateur : tout logiciel DOS s''appuyant sur un modem ou un');
 Add('     cable null-modem (jeux multijoueur par COM, LapLink/Interlnk,');
 Add('     BBS/terminal) ne pourra pas fonctionner ici.');
 Add('');

 Add('Reseau LAN generique (PC/TCP Packet Driver Specification, INT 60h)');
 Add('----------------------------------------------------------------');
 If OptionsDlg.Data.DosLAN Then
  Add('  Case "Reseau LAN"             : cochee')
 Else
  Add('  Case "Reseau LAN"             : DEcochee (pilote inactif)');
 Add('  Fabricant/produit             : ' +
  DosLANVendorName(OptionsDlg.Data.DosLANVendor));
 If EmuPkt.Active Then Begin
  Add('  Etat du pilote                : ACTIF (vecteur INT 60h)');
  S := '  Adresse locale                : ' +
   HexByte(EmuPkt.LocalMAC[0]) + '-' + HexByte(EmuPkt.LocalMAC[1]) + '-' +
   HexByte(EmuPkt.LocalMAC[2]) + '-' + HexByte(EmuPkt.LocalMAC[3]) + '-' +
   HexByte(EmuPkt.LocalMAC[4]) + '-' + HexByte(EmuPkt.LocalMAC[5]);
  Add(S);
  Add('');
  Add('  Poignees ouvertes (access_type) :');
  AnyFound := False;
  For I := 0 To High(EmuPkt.Handles) Do
   If EmuPkt.Handles[I].InUse Then Begin
    S := '    - handle ' + IntToStr(I + 1) + ' : classe ' +
     IntToStr(EmuPkt.Handles[I].IfClass) + ', ';
    If EmuPkt.Handles[I].TypeLen = 0 Then
     S := S + 'tout accepter (promiscuous)'
    Else
     S := S + IntToStr(EmuPkt.Handles[I].TypeLen) + ' octet(s) de filtre';
    S := S + ', mode reception ' + IntToStr(EmuPkt.Handles[I].RcvMode) +
     ', recepteur ' + HexWord(EmuPkt.Handles[I].RecvSeg) + ':' +
     HexWord(EmuPkt.Handles[I].RecvOfs);
    Add(S);
    AnyFound := True;
   End;
  If Not AnyFound Then Add('    (aucune)');
  Add('');
  Add('  Livraison en cours (cascade upcall recepteur/as_send_pkt) : ' );
  If EmuPkt.Cont.Pending Then
   Add('    oui (etape ' + IntToStr(EmuPkt.Cont.Stage) + ')')
  Else
   Add('    non');
  Add('');
  Add('  Statistiques :');
  Add('    Paquets recus     : ' + IntToStr(EmuPkt.Stats.PacketsIn));
  Add('    Paquets envoyes   : ' + IntToStr(EmuPkt.Stats.PacketsOut));
  Add('    Octets recus      : ' + IntToStr(EmuPkt.Stats.BytesIn));
  Add('    Octets envoyes    : ' + IntToStr(EmuPkt.Stats.BytesOut));
  Add('    Paquets perdus    : ' + IntToStr(EmuPkt.Stats.PacketsLost) +
   ' (file de livraison saturee)');
 End Else Begin
  Add('  Etat du pilote                : INACTIF');
  Add('  (INT 60h ne repond pas - comme une vraie machine sans pilote de');
  Add('   paquets charge : aucun octet "PKT DRVR" trouvable en memoire)');
 End;
 Add('  => Seule la specification Packet Driver (FTP Software/Crynwr) est');
 Add('     emulee. Un logiciel cherchant specifiquement un pilote ODI');
 Add('     (Novell Open Data-Link Interface) ou NDIS (Microsoft/3Com),');
 Add('     architectures a chainage de pilotes distinctes, ne trouvera');
 Add('     rien - seul le vecteur INT 60h "brut" ci-dessus existe.');

 { Estimation de la taille pour l affichage (cosmetique, comme pour un   }
 { vrai fichier charge par F3 - voir NCCmd_ViewFile). }
 TotalChars := 0;
 For I := 0 To NCState.ViewCount - 1 Do
  TotalChars := TotalChars + Length(NCState.ViewLines[I]) + 2;
 NCState.ViewFileSize := TotalChars;
End;

{ Declaration anticipee : definie plus bas (avec le reste de la           }
{ visionneuse F3), utilisee par NCActionView pour le message de           }
{ fragmentation HPFS ci-dessous. }
Procedure NCShowMessage(Const Msg: String; ReturnMode: TNCMode); Forward;
Procedure NCShowError(Const Msg: String; ReturnMode: TNCMode); Forward;

{ --- Actions F3/F4/F5/F6/F7/F8/F10, extraites de HandleNCommanderEvent  }
{ pour etre appelables a la fois par la touche directe ET par le menu    }
{ deroulant F9 (NCMenuExecute, menu "Fichiers") - meme comportement,           }
{ un seul endroit a maintenir. --- }
Procedure NCActionView(Side: Integer);
Var
 E: TNCEntry;
 TempPath: String;
 Attr: Byte;
 Cluster, Sz: LongInt;
Begin
 If NCState.Panes[Side].Count = 0 Then Exit;
 E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
 If E.IsDir Then Exit;
 If NCState.PaneSlot[Side] < 0 Then Begin
  NCCmd_ViewFile(NCFullPath(NCState.Panes[Side].Path, E.Name));
  NCState.Mode := ncViewFile;
 End Else If FatVol[NCState.PaneSlot[Side]].IsD64 Then Begin
  { La disquette virtuelle FAT (Slot >= 0 mais pas D64) reste hors de       }
  { portee ici, meme limitation preexistante que NCActionEdit/            }
  { NCActionOpenAssociated : pas de chemin hote direct pour ces fichiers. }
  NCCmd_ViewD64File(Byte(NCState.PaneSlot[Side]), Byte(E.Cluster Shr 8),
   Byte(E.Cluster And $FF), E.Name);
  NCState.Mode := ncViewFile;
 End Else If FatVol[NCState.PaneSlot[Side]].IsH8D Then Begin
  { Image .H8D : extrait vers un fichier hote temporaire (H8D_ExtractToTempFile, }
  { HDOS/UCSD uniquement - voir commentaire d en-tete du sous-systeme H8D    }
  { pour la limitation CP/M-80) puis reutilise NCCmd_ViewFile tel quel. }
  If H8D_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), E.Name, TempPath) Then Begin
   NCCmd_ViewFile(TempPath);
   NCState.ViewFileName := E.Name;
   NCState.Mode := ncViewFile;
  End;
 End Else If FatVol[NCState.PaneSlot[Side]].IsHPFS Then Begin
  { Partition HPFS (lecture seule) : extrait vers un fichier hote           }
  { temporaire (HPFS_ExtractToTempFile, E.Cluster porte le FNode - voir     }
  { NCListDir) puis reutilise NCCmd_ViewFile tel quel, meme mecanisme que   }
  { H8D ci-dessus. }
  If HPFS_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), E.Cluster, E.Size, TempPath) Then Begin
   NCCmd_ViewFile(TempPath);
   NCState.ViewFileName := E.Name;
   NCState.Mode := ncViewFile;
   { HPFSRunOverflow (voir HPFS_AddAllocBplus/HPFS_MAX_RUNS) : un fichier   }
   { extremement fragmente peut avoir ete tronque - avertir plutot que de   }
   { laisser croire silencieusement a un contenu complet. }
   If HPFSRunOverflow Then
    NCShowMessage('Attention : fichier tres fragmente, contenu possiblement tronque.',
     ncViewFile);
  End;
 End Else Begin
  { Disquette/disque virtuel FAT "ordinaire" (ex. un vrai .vhd MS-DOS       }
  { monte) : extrait vers un fichier hote temporaire (Fat_ExtractToTempFile,}
  { nouveau) puis reutilise NCCmd_ViewFile tel quel, meme mecanisme que     }
  { H8D/HPFS ci-dessus. }
  If Fat_FindPath(Byte(NCState.PaneSlot[Side]),
     NCFullPath(NCState.Panes[Side].Path, E.Name), Attr, Cluster, Sz) And
     ((Attr And $10) = 0) Then Begin
   If Fat_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), Cluster, Sz, E.Name, TempPath) Then Begin
    NCCmd_ViewFile(TempPath);
    NCState.ViewFileName := E.Name;
    NCState.Mode := ncViewFile;
   End;
  End;
 End;
End;

Procedure NCActionEdit(Side: Integer);
Var
 E: TNCEntry;
Begin
 If (NCState.Panes[Side].Count > 0) And (NCState.PaneSlot[Side] < 0) Then Begin
  E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
  If Not E.IsDir Then
   PasChatOpenGeneratedFile(NCFullPath(NCState.Panes[Side].Path, E.Name));
 End;
End;

{ Un ".EXE" peut etre un vrai executable DOS 16 bits (en-tete MZ pur) ou }
{ un executable Win32/Win64 moderne (en-tete MZ suivi d un en-tete PE,   }
{ le classique stub "This program cannot be run in DOS mode") - seul le }
{ premier cas doit etre lance dans l emulateur 8086 integre. Le champ   }
{ e_lfanew (offset $3C) pointe vers la signature secondaire : 'PE'#0#0  }
{ pour Win32/Win64, 'NE' pour Windows 16 bits, 'LE'/'LX' pour OS/2/VxD  }
{ - toute autre valeur (ou l absence d en-tete secondaire exploitable)  }
{ signe un executable MZ classique. Un ".COM" n a pas d en-tete du tout }
{ (code brut charge a CS:0100h) et est donc toujours du DOS 16 bits.    }
{                                                                        }
{ PIEGE (trouve via BP.EXE, Borland Pascal 7.0, 1992, ~490 Ko) : sur un  }
{ VRAI executable DOS 16 bits ancien, l offset $3C n a jamais ete reserve}
{ par le linker de l epoque pour un e_lfanew - il contient simplement    }
{ des octets de programme/donnees quelconques qui, LUS COMME s ils       }
{ etaient un pointeur, peuvent par pure coincidence tomber sur une paire }
{ d octets 'N','E' (ou pire) ailleurs dans le fichier et declencher un   }
{ faux "c est du Win16 NE" - exactement ce qui arrive avec BP.EXE. Pour  }
{ eviter ce faux positif, on verifie D ABORD e_crlc (offset 6, nombre    }
{ d entrees de la table de translation) : un vrai executable DOS 16 bits}
{ RELOCALISABLE (le cas normal pour un programme d une taille pareille)  }
{ a TOUJOURS e_crlc > 0, alors qu un stub MZ precedant un vrai en-tete   }
{ PE/NE/LE (genere par le linker specifiquement comme code fixe, jamais  }
{ realloue) a TOUJOURS e_crlc = 0 - un signal beaucoup plus fiable que   }
{ de suivre un e_lfanew qui n a jamais ete ecrit intentionnellement.     }
Const
 NCEXE_NONE   = 0;  { pas un executable MZ reconnaissable                }
 NCEXE_DOS16  = 1;  { DOS 16 bits classique - lancable par -CD           }
 NCEXE_OS2LX  = 2;  { OS/2 LX (32 bits, "Linear Executable")             }
 NCEXE_OTHER  = 3;  { PE (Win32/64) - non supporte                       }
 NCEXE_WIN16  = 4;  { NE (Windows 1.x/2.x/3.x 16 bits) - chantier en cours }

{ Chantier OS/2 LX (2026-08-22, Stage 0) : NCIsDos16Exe se contentait de }
{ rejeter silencieusement PE/NE/LE/LX (un seul Boolean, aucune           }
{ distinction entre les formats rejetes) - NCFindExeKind reprend le meme }
{ parcours MZ/e_crlc/e_lfanew mais retourne le format precis, pour       }
{ pouvoir router LX vers l emulateur OS/2 (ou, avant Stage 4, au moins    }
{ afficher un message clair) au lieu de ne rien faire. NCIsDos16Exe reste}
{ un simple wrapper pour ne pas toucher aux sites d appel DOS existants. }
Function NCFindExeKind(Const Path: String): Byte;
Var
 F: File;
 Sig: Array[0..1] Of Char;
 CrlcBuf: Array[0..1] Of Byte;
 LfanewBuf: Array[0..3] Of Byte;
 HdrSig: Array[0..3] Of Char;
 Lfanew: LongInt;
 FSize: LongInt;
 BytesRead: Word;
Begin
 NCFindExeKind := NCEXE_NONE;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 FSize := FileSize(F);
 If FSize < 64 Then Begin
  Close(F);
  Exit;
 End;
 BlockRead(F, Sig, 2, BytesRead);
 If (BytesRead <> 2) Or (Sig[0] <> 'M') Or (Sig[1] <> 'Z') Then Begin
  Close(F);
  Exit;
 End;
 Seek(F, 6);
 BlockRead(F, CrlcBuf, 2, BytesRead);
 If (BytesRead = 2) And ((CrlcBuf[0] <> 0) Or (CrlcBuf[1] <> 0)) Then Begin
  { e_crlc > 0 : de vraies relocalisations sont presentes - executable DOS}
  { 16 bits authentique, voir le commentaire de tete. Inutile (et risque) }
  { de suivre e_lfanew dans ce cas. }
  Close(F);
  NCFindExeKind := NCEXE_DOS16;
  Exit;
 End;
 Seek(F, $3C);
 BlockRead(F, LfanewBuf, 4, BytesRead);
 If BytesRead <> 4 Then Begin
  Close(F);
  NCFindExeKind := NCEXE_DOS16;
  Exit;
 End;
 Lfanew := LongInt(LfanewBuf[0]) Or (LongInt(LfanewBuf[1]) Shl 8) Or
  (LongInt(LfanewBuf[2]) Shl 16) Or (LongInt(LfanewBuf[3]) Shl 24);
 If (Lfanew <= 0) Or (Lfanew + 4 > FSize) Then Begin
  Close(F);
  NCFindExeKind := NCEXE_DOS16;
  Exit;
 End;
 Seek(F, Lfanew);
 BlockRead(F, HdrSig, 4, BytesRead);
 Close(F);
 If BytesRead <> 4 Then Begin
  NCFindExeKind := NCEXE_DOS16;
  Exit;
 End;
 If (HdrSig[0] = 'P') And (HdrSig[1] = 'E') And (HdrSig[2] = #0) And
    (HdrSig[3] = #0) Then Begin
  NCFindExeKind := NCEXE_OTHER;
  Exit;
 End;
 If (HdrSig[0] = 'N') And (HdrSig[1] = 'E') Then Begin
  NCFindExeKind := NCEXE_WIN16;
  Exit;
 End;
 If (HdrSig[0] = 'L') And ((HdrSig[1] = 'E') Or (HdrSig[1] = 'X')) Then Begin
  NCFindExeKind := NCEXE_OS2LX;
  Exit;
 End;
 NCFindExeKind := NCEXE_DOS16;
End;

Function NCIsDos16Exe(Const Path: String): Boolean;
Begin
 NCIsDos16Exe := NCFindExeKind(Path) = NCEXE_DOS16;
End;

{ Binaire Linux ELF64 x86-64 (ex: BINLINUX\tp2js) - ces binaires n ont   }
{ generalement pas d extension, contrairement aux .EXE/.COM DOS ; seule }
{ la signature magique (7F 45 4C 46 = #$7F,'E','L','F') permet de les   }
{ reconnaitre. Meme verification que TermFindElfExecutable, mais sur un }
{ chemin deja connu plutot que par recherche-par-nom dans un repertoire.}
Function NCIsElfExecutable(Const Path: String): Boolean;
Var
 F: File;
 Magic: Array[0..3] Of Byte;
 BytesRead: Word;
Begin
 NCIsElfExecutable := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 BlockRead(F, Magic, SizeOf(Magic), BytesRead);
 Close(F);
 NCIsElfExecutable := (BytesRead = 4) And (Magic[0] = $7F) And
  (Magic[1] = Ord('E')) And (Magic[2] = Ord('L')) And (Magic[3] = Ord('F'));
End;

{ Un ".PRG" est ambigu entre deux plateformes emulees ici : un binaire      }
{ GEMDOS Atari ST (en-tete 28 octets, magic $60,$1A - voir M68K_LoadPRG)     }
{ ou un programme Commodore 64 (2 octets d adresse de chargement, aucune    }
{ signature fiable en soi, mais $60,$1A est un couple d octets qui ne          }
{ correspond a aucune adresse de chargement C64 plausible). On tranche         }
{ donc simplement sur la signature GEMDOS : presente -> Atari ST, absente     }
{ -> Commodore 64 (l hypothese par defaut, plus frequente dans ce depot). --- }
Function NCIsAtariSTPrg(Const Path: String): Boolean;
Var
 F: File;
 Magic: Array[0..1] Of Byte;
 BytesRead: Word;
Begin
 NCIsAtariSTPrg := False;
 {$I-}
 Assign(F, Path);
 Reset(F, 1);
 {$I+}
 If IOResult <> 0 Then Exit;
 BlockRead(F, Magic, SizeOf(Magic), BytesRead);
 Close(F);
 NCIsAtariSTPrg := (BytesRead = 2) And (Magic[0] = $60) And (Magic[1] = $1A);
End;

{ Entree sur un fichier associe a un emulateur integre plutot que de ne  }
{ rien faire (comme le ferait NC pour un fichier non associe) - le       }
{ disque hote (Slot<0) et une disquette virtuelle Commodore 64 montee    }
{ (Slot>=0 et FatVol[Slot].IsD64) sont tous deux supportes ; la           }
{ disquette virtuelle FAT reste hors de portee (meme limitation que          }
{ NCActionView/NCActionEdit, pas de chemin hote direct). Renvoie True si }
{ le fichier a ete pris en charge (l appelant ne doit alors rien faire      }
{ d autre). --- }
Function NCActionOpenAssociated(Side: Integer): Boolean;
Var
 E: TNCEntry;
 Ext, FullPath, TempPath: String;
 Attr: Byte;
 Cluster, Sz: LongInt;
Begin
 NCActionOpenAssociated := False;
 If NCState.Panes[Side].Count = 0 Then Exit;
 E := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor];
 If E.IsDir Then Exit;
 If (NCState.PaneSlot[Side] >= 0) And FatVol[NCState.PaneSlot[Side]].IsD64 Then Begin
  { Disquette virtuelle .D64 : seul PRG est executable (SEQ/USR/REL/DEL   }
  { ne le sont pas) - extrait vers un fichier hote temporaire, puisque       }
  { CPU6502_LoadC64Prg lit toujours un chemin hote reel. }
  If UpCaseStr(NCExtractExt(E.Name)) = 'PRG' Then Begin
   If D64_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), Byte(E.Cluster Shr 8),
    Byte(E.Cluster And $FF), TempPath) Then Begin
    CreateEmulatorTab(TempPath, '-CC64', '');
    NCActionOpenAssociated := True;
   End;
  End;
  Exit;
 End;
 If (NCState.PaneSlot[Side] >= 0) And FatVol[NCState.PaneSlot[Side]].IsH8D Then Begin
  { Image .H8D : seuls les fichiers .CODE (p-code UCSD p-System) sont      }
  { executables - extraits vers un fichier hote temporaire (HDOS ou UCSD,  }
  { voir H8D_ExtractToTempFile) puis lances par l emulateur -CPCODE, meme  }
  { mecanisme que le .PRG D64 ci-dessus. }
  If UpCaseStr(NCExtractExt(E.Name)) = 'CODE' Then Begin
   If H8D_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), E.Name, TempPath) Then Begin
    CreateEmulatorTab(TempPath, '-CPCODE', '');
    NCActionOpenAssociated := True;
   End;
  End;
  Exit;
 End;
 If (NCState.PaneSlot[Side] >= 0) And FatVol[NCState.PaneSlot[Side]].IsHPFS Then Begin
  { BOGUE REEL (2026-08-22, signale par l utilisateur sur un vrai VHD       }
  { eComStation/OS-2 - \OS2\MDOS\APPEND.EXE) : cette branche n existait pas }
  { du tout - une entree HPFS ne correspondait a AUCUN des cas ci-dessus    }
  { (D64/H8D/"FAT ordinaire" explicitement exclu via Not IsHPFS/hote), donc }
  { Entree sur un .EXE/.COM HPFS ne faisait RIEN, silencieusement - meme    }
  { categorie de trou que le bogue FAT "ordinaire" deja corrige plus haut   }
  { cette session (voir Fat_ExtractToTempFile), jamais couvert pour HPFS.   }
  { HPFS_ExtractToTempFile (deja existant, session precedente) attend       }
  { directement le FNode LBA - TNCEntry.Cluster le porte deja (meme motif   }
  { de reutilisation que D64 piste/secteur), pas besoin d une resolution    }
  { de chemin supplementaire comme Fat_FindPath pour le cas FAT. }
  Ext := UpCaseStr(NCExtractExt(E.Name));
  If (Ext = 'COM') Or (Ext = 'EXE') Then Begin
   If HPFS_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), E.Cluster, E.Size, TempPath) Then Begin
    If (Ext = 'COM') Or NCIsDos16Exe(TempPath) Then Begin
     CreateEmulatorTab(TempPath, '-CD', '');
     NCActionOpenAssociated := True;
    End
    { Chantier OS/2 LX (2026-08-22/23, Stage 0->4) : un .EXE au format LX  }
    { etait rejete silencieusement par NCIsDos16Exe (aucune branche Else)  }
    { - Stage 0 a d abord ajoute un simple message, Stage 4 lance          }
    { desormais reellement l emulateur (mode console uniquement - voir     }
    { project_devenv_os2lx.md pour le perimetre). }
    Else If (Ext = 'EXE') And (NCFindExeKind(TempPath) = NCEXE_OS2LX) Then Begin
     CreateEmulatorTab(TempPath, '-COS2LX', '');
     NCActionOpenAssociated := True;
    End
    { Chantier Windows 16 bits (2026-08-25/28, Stage 0->4) : un .EXE au    }
    { format NE etait rejete silencieusement (NCEXE_OTHER, aucune branche  }
    { Else) - Stage 0 a d abord ajoute un simple message, Stage 4 lance    }
    { desormais reellement l emulateur (mode console texte uniquement -    }
    { voir project_devenv_win16.md pour le perimetre). }
    Else If (Ext = 'EXE') And (NCFindExeKind(TempPath) = NCEXE_WIN16) Then Begin
     CreateEmulatorTab(TempPath, '-CWIN16', '');
     NCActionOpenAssociated := True;
    End;
   End;
  End;
  Exit;
 End;
 If (NCState.PaneSlot[Side] >= 0) And (Not FatVol[NCState.PaneSlot[Side]].IsHPFS) Then Begin
  { Disquette/disque virtuel FAT "ordinaire" (le cas general - /DISK0..     }
  { /DISK81 sans format special D64/H8D/HPFS ci-dessus, ex. un vrai .vhd    }
  { MS-DOS monte) : extrait vers un fichier hote temporaire                 }
  { (Fat_ExtractToTempFile, nouveau - jusqu ici seul le Terminal, commande  }
  { COPY, savait extraire un fichier FAT virtuel vers l hote) puis relance  }
  { le meme aiguillage COM/EXE que le systeme de fichiers hote ci-dessous   }
  { (NCIsDos16Exe verifie sur le fichier EXTRAIT, puisqu il n y a pas de    }
  { chemin hote direct pour une entree sur disque virtuel). }
  Ext := UpCaseStr(NCExtractExt(E.Name));
  If (Ext = 'COM') Or (Ext = 'EXE') Then Begin
   If Fat_FindPath(Byte(NCState.PaneSlot[Side]),
      NCFullPath(NCState.Panes[Side].Path, E.Name), Attr, Cluster, Sz) And
      ((Attr And $10) = 0) Then Begin
    If Fat_ExtractToTempFile(Byte(NCState.PaneSlot[Side]), Cluster, Sz, E.Name, TempPath) Then Begin
     If (Ext = 'COM') Or NCIsDos16Exe(TempPath) Then Begin
      CreateEmulatorTab(TempPath, '-CD', '');
      NCActionOpenAssociated := True;
     End
     Else If (Ext = 'EXE') And (NCFindExeKind(TempPath) = NCEXE_OS2LX) Then Begin
      CreateEmulatorTab(TempPath, '-COS2LX', '');
      NCActionOpenAssociated := True;
     End
     { Chantier Windows 16 bits (2026-08-25/28, Stage 0->4) - voir le      }
     { commentaire jumeau au site HPFS ci-dessus pour le contexte complet. }
     Else If (Ext = 'EXE') And (NCFindExeKind(TempPath) = NCEXE_WIN16) Then Begin
      CreateEmulatorTab(TempPath, '-CWIN16', '');
      NCActionOpenAssociated := True;
     End;
    End;
   End;
  End;
  Exit;
 End;
 If NCState.PaneSlot[Side] < 0 Then Begin
  Ext := UpCaseStr(NCExtractExt(E.Name));
  FullPath := NCFullPath(NCState.Panes[Side].Path, E.Name);
  If Ext = 'NES' Then Begin
   CreateEmulatorTab(FullPath, '-CNES', '');
   NCActionOpenAssociated := True;
  End
    Else If Ext = 'A26' Then Begin
     CreateEmulatorTab(FullPath, '-CATARI2600', '');
     NCActionOpenAssociated := True;
    End
  Else If Ext = 'XEX' Then Begin
   { Format binaire Atari 8-bit (segments [FF FF] start end data...),   }
   { charge par CPU6502_LoadAtariXex - un seul et meme chargeur pour        }
   { les deux cibles Atari 400/800 (memoire RAM disponible differente,    }
   { sans effet sur le format .XEX lui-meme). Atari 800 choisi par         }
   { defaut (plus de RAM, cible la plus courante) - aucune ambiguite         }
   { de format ne permet de deduire 400 vs 800 depuis le fichier seul. }
   CreateEmulatorTab(FullPath, '-CATARI800', '');
   NCActionOpenAssociated := True;
  End
  Else If Ext = 'PRG' Then Begin
   { .PRG hote : ambigu C64/Atari ST, tranche par la signature GEMDOS      }
   { (voir NCIsAtariSTPrg). }
   If NCIsAtariSTPrg(FullPath) Then
    CreateEmulatorTab(FullPath, '-CATARIST', '')
   Else
    CreateEmulatorTab(FullPath, '-CC64', '');
   NCActionOpenAssociated := True;
  End
  Else If Ext = 'CODE' Then Begin
   { p-code UCSD p-System brut mono-segment (convention DISPCODE/ASMPCODE.PAS }
   { de C:\SOURCE\PCODE) - voir PCode_Step. }
   CreateEmulatorTab(FullPath, '-CPCODE', '');
   NCActionOpenAssociated := True;
  End
  Else If (Ext = 'COM') Or
   ((Ext = 'EXE') And NCIsDos16Exe(FullPath)) Then Begin
   CreateEmulatorTab(FullPath, '-CD', '');
   NCActionOpenAssociated := True;
   End
   Else If (Ext = 'EXE') And (NCFindExeKind(FullPath) = NCEXE_OS2LX) Then Begin
    CreateEmulatorTab(FullPath, '-COS2LX', '');
    NCActionOpenAssociated := True;
   End
   { Chantier Windows 16 bits (2026-08-25/28, Stage 0->4) - voir le        }
   { commentaire jumeau au site HPFS plus haut pour le contexte complet. }
   Else If (Ext = 'EXE') And (NCFindExeKind(FullPath) = NCEXE_WIN16) Then Begin
    CreateEmulatorTab(FullPath, '-CWIN16', '');
    NCActionOpenAssociated := True;
   End
   Else If (Ext = '') And NCIsElfExecutable(FullPath) Then Begin
    CreateEmulatorTab(FullPath, '-CELF64', '');
    NCActionOpenAssociated := True;
   End;
  End;
End;

{ BOGUE REEL (2026-08-23, signale par l utilisateur) : Copier (F5) sur une }
{ entree d un panneau NC en train de parcourir un disque virtuel ne         }
{ faisait RIEN, silencieusement - le gestionnaire de ncPromptCopy (plus     }
{ bas) etait explicitement garde par "NCState.Slot < 0", sautant tout       }
{ l appel a TermCopyFile des que le panneau SOURCE est virtuel. Simplement  }
{ retirer cette garde n aurait pas suffi : TermCopyFile a bien deja une     }
{ branche "source virtuelle" (voir Term_ResolveVirtTarget), mais elle ne    }
{ reconnait un chemin comme virtuel QUE via un prefixe "X:" ou via          }
{ TP.VirtDrive (etat du TERMINAL) - jamais via NCState.Slot (etat du        }
{ PANNEAU NC, un objet totalement independant) - et NCFullPath ne produit   }
{ de toute facon jamais de prefixe "X:". De plus, cette branche existante   }
{ n aurait de toute facon gere que le FAT (Fat_FindPath), jamais HPFS.      }
{ Reutilise donc le motif deja prouve cette session (extraction vers un     }
{ fichier hote temporaire PUIS traitement comme hote-a-hote, meme principe  }
{ que HPFS_FindDosExecutable/Fat_FindDosExecutable) plutot que d etendre    }
{ Term_ResolveVirtTarget pour comprendre l etat du panneau NC. }
Function NCCopyVirtEntryToHost(Var TP: TTerminalPanel; Slot: Byte;
 Const E: TNCEntry; Const DestSpec: String): Boolean;
Var
 TempPath, FinalDest: String;
 Extracted: Boolean;
 SrcFile, DstFile: File;
 Buffer: Array[1..4096] Of Byte;
 RecordsRead: Word;
Begin
 NCCopyVirtEntryToHost := False;
 If E.IsDir Then Exit;
 If FatVol[Slot].IsHPFS Then
  Extracted := HPFS_ExtractToTempFile(Slot, E.Cluster, E.Size, TempPath)
 Else
  Extracted := Fat_ExtractToTempFile(Slot, E.Cluster, E.Size, E.Name, TempPath);
 If Not Extracted Then Begin
  TermAddLine(TP, 'Copie : extraction impossible pour ' + E.Name);
  Exit;
 End;
 { Le fichier temporaire extrait porte un nom GENERIQUE (DEVENV_NC_FAT.<ext>}
 { ou DEVENV_NC_HPFS.TMP, jamais le vrai nom d origine) - reconstruire ici  }
 { le nom de cible REEL via NCCopyComputeDest (voir son commentaire de     }
 { tete). }
 FinalDest := NCCopyComputeDest(DestSpec, E.Name);
 { BOGUE REEL trouve en verifiant (2026-08-23) : appeler TermCopyFile ici    }
 { serait tentant (TempPath et FinalDest sont tous deux DEFINITIVEMENT des   }
 { chemins HOTE), mais TermCopyFile fait passer FinalDest par              }
 { Term_ResolveVirtTarget, qui traite TOUT chemin commencant par "X:" comme  }
 { potentiellement une lettre de LECTEUR VIRTUEL (Term_DriveIdxFromLetter)   }
 { - or le disque virtuel courant peut lui-meme etre presente sous la        }
 { lettre "C:" (confirme : le selecteur Alt+F1 liste bien 2 entrees "C:",    }
 { une hote et une virtuelle) - EXACTEMENT la lettre par laquelle commencent }
 { la plupart des chemins hote reels (dont celui de l utilisateur qui a      }
 { signale ce bogue, "C:\SOURCE\GITHUB\DEV-COOLS"). Le fichier atterrissait   }
 { donc silencieusement sur le disque VIRTUEL (no-op, l ecriture y est deja  }
 { bloquee de toute facon) au lieu du vrai chemin hote voulu. Copie hote-a-  }
 { hote DIRECTE ici (meme boucle simple que la branche "Cas hote -> hote"    }
 { de TermCopyFile) pour ne jamais retraverser cette resolution ambigue.     }
 {$I-}
 Assign(SrcFile, TempPath);
 Reset(SrcFile, 1);
 {$I+}
 If IOResult <> 0 Then Begin
  TermAddLine(TP, 'Copie : fichier temporaire introuvable : ' + TempPath);
  Exit;
 End;
 {$I-}
 Assign(DstFile, FinalDest);
 Rewrite(DstFile, 1);
 {$I+}
 If IOResult <> 0 Then Begin
  TermAddLine(TP, 'Copie : impossible de creer : ' + FinalDest);
  Close(SrcFile);
  Exit;
 End;
 BlockRead(SrcFile, Buffer, SizeOf(Buffer), RecordsRead);
 While RecordsRead > 0 Do Begin
  BlockWrite(DstFile, Buffer, RecordsRead);
  BlockRead(SrcFile, Buffer, SizeOf(Buffer), RecordsRead);
 End;
 Close(SrcFile);
 Close(DstFile);
 NCCopyVirtEntryToHost := True;
End;

Procedure NCActionCopyStart(Side, OtherSide: Integer);
Var
 I: Integer;
 HasDir: Boolean;
Begin
 If (NCState.Panes[Side].Count > 0) And
    ((NCState.Panes[Side].MarkCount > 0) Or Not NCCursorOnDotDot(Side)) Then Begin
  { BOGUE REEL (2026-08-23, 4e rapport du meme utilisateur) :             }
  { NCCopyVirtEntryToHost ne copie jamais un repertoire (If E.IsDir Then   }
  { Exit, silencieux par conception - copie non recursive, hors du        }
  { perimetre actuel) - l utilisateur voyait le prompt "Vers" s ouvrir     }
  { normalement puis, apres Entree, absolument rien ne se passait, sans   }
  { le moindre message (curseur reellement pose sur un repertoire, pas    }
  { sur le fichier voulu). Bloque desormais ICI, avant meme d ouvrir le    }
  { prompt, avec un message explicite. }
  If NCState.PaneSlot[Side] >= 0 Then Begin
   HasDir := False;
   If NCState.Panes[Side].MarkCount > 0 Then Begin
    For I := 0 To NCState.Panes[Side].Count - 1 Do
     If NCState.Panes[Side].Marked[I] And NCState.Panes[Side].Entries[I].IsDir Then
      HasDir := True;
   End Else
    HasDir := NCState.Panes[Side].Entries[NCState.Panes[Side].Cursor].IsDir;
   If HasDir Then Begin
    NCShowError('Copie de repertoire non prise en charge depuis un disque virtuel.',
     ncBrowse);
    Exit;
   End;
  End;
  NCState.PromptBuf := NCState.Panes[OtherSide].Path;
  NCState.Mode := ncPromptCopy;
 End;
End;

