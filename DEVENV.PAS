    If EFG_DF In P.CPU.Flags.s Then Inc16 := -1 Else Inc16 := 1;
    If RepPrefix <> 0 Then Begin
     If P.CPU.AddrSize32 Then Cnt := P.CPU.Regs.ECX
                          Else Cnt := P.CPU.Regs.CX;
