{ Recherche lineaire (pas de Case-de-chaine possible en mode Turbo Pascal)
  des commandes SoftICE specifiques au noyau Windows NT, sans equivalent
  dans un emulateur DOS 8086 reel-mode - liste transcrite depuis la
  reference SoftICE standard. }
Function EmuCmdConsole_IsNtKernelCmd(Const Cmd: String): Boolean;
Const
 NT_COUNT = 74;
 NtCmds: Array[1..NT_COUNT] Of String = (
  'DEVICE','DPC','ERESOURCE','FIBER','GDT','HEAP','IDT','INTOBJ','IRP',
  'IRB','KMUTEX','KEVENT','KOBJECT','KSEM','MSR','OBJDIR','OBJTAB','PAGE',
  'PCI','SRB','SYMLINK','THREAD','URB','APC','ARBITER','DEVMGR','DM',
  'DEVNODE','DRIVER','FMUTEX','FOBJ','HWND','CLASS','NETFIND','NTCALL',
  'NTSTATUS','WINERROR','PROCESS','SVCMGR','SM','SVCSTART','SVCSTOP',
  'TCONFIG','TDIR','TMKDIR','TMOVE','TRENAME','TRMDIR','TRMFILE','TVOL',
  'TATTRIB','CONNECT','DISCONNECT','CLOSE','WCONNECT','PING','REBOOT',
  'SHUTDOWN','HBOOT','WB','WC','WD','WE','WF','WG','WI','WL','WMSG','WP',
  'WR','WS','WT','WV','WX'
 );
Var I: Integer;
Begin
 EmuCmdConsole_IsNtKernelCmd := False;
 For I := 1 To NT_COUNT Do
  If Cmd = NtCmds[I] Then Begin
   EmuCmdConsole_IsNtKernelCmd := True;
   Exit;
  End;
End;

{ --- Formatage registres / instruction courante --- }

Procedure EmuCmdConsole_ShowRegs(Var C: TEmuCmdConsole);
Begin
 { Registres 32 bits (EAX=/EBX=/...) quand l utilisateur a coche            }
 { "Emulation 80386" dans Options > Emulateur > DOS: Materiel               }
 { (OptionsDlg.Data.DosEmu80386) - demande explicite de l utilisateur       }
 { 2026-08-24 : sur un 386+, les registres visibles au deboguage sont       }
 { reellement 32 bits (EAX/EBX/...), meme quand le code execute est en      }
 { mode reel 16 bits. Emu_GetReg32 existe deja (support $66/OperandSize32   }
 { ajoute plus tot cette session) - simple reutilisation pour l affichage.  }
 If OptionsDlg.Data.DosEmu80386 Then Begin
  EmuCmdConsole_AddLine(C, 'EAX=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 0)) +
   ' EBX=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 3)) +
   ' ECX=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 1)) +
   ' EDX=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 2)));
  EmuCmdConsole_AddLine(C, 'ESI=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 6)) +
   ' EDI=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 7)) +
   ' EBP=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 5)) +
   ' ESP=' + HexLong(Emu_GetReg32(EmuPanel.CPU, 4)));
 End Else Begin
  EmuCmdConsole_AddLine(C, 'AX=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 0)) +
   ' BX=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 3)) +
   ' CX=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 1)) +
   ' DX=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 2)));
  EmuCmdConsole_AddLine(C, 'SI=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 6)) +
   ' DI=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 7)) +
   ' BP=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 5)) +
   ' SP=' + HexWord(Emu_GetReg16(EmuPanel.CPU, 4)));
 End;
 EmuCmdConsole_AddLine(C, 'DS=' + HexWord(Emu_GetSReg(EmuPanel.CPU, 3)) +
  ' ES=' + HexWord(Emu_GetSReg(EmuPanel.CPU, 0)) +
  ' SS=' + HexWord(Emu_GetSReg(EmuPanel.CPU, 2)) +
  ' CS=' + HexWord(Emu_GetSReg(EmuPanel.CPU, 1)) +
  ' IP=' + HexWord(EmuPanel.CPU.IP));
 EmuCmdConsole_AddLine(C, 'FLAGS=' + HexWord(EmuPanel.CPU.Flags.Base));
End;

Procedure EmuCmdConsole_ShowCurrentInstr(Var C: TEmuCmdConsole);
Var Sz: Integer; S: String;
Begin
 S := EmuDbg_Disasm8086(EmuPanel.CPU.Segs.CS, EmuPanel.CPU.IP, Sz);
 EmuCmdConsole_AddLine(C, HexWord(EmuPanel.CPU.Segs.CS) + ':' +
  HexWord(EmuPanel.CPU.IP) + '  ' + S);
End;

{ --- Commandes a back-end reel (partagees SoftICE/GDB) --- }

Procedure EmuCmdConsole_CmdR(Var C: TEmuCmdConsole; Const Args: String);
Var RegName, ValStr: String; V: LongInt; ErrPos: Word;
Begin
 RegName := TermExtractParam(Args, 1);
 If RegName = '' Then Begin
  EmuCmdConsole_ShowRegs(C);
  Exit;
 End;
 If EmuDbg_RegByName(RegName, EmuPanel.CPU) = -1 Then Begin
  EmuCmdConsole_AddLine(C, 'Registre inconnu : ' + RegName);
  Exit;
 End;
 ValStr := TermExtractParam(Args, 2);
 If ValStr = '' Then
  EmuCmdConsole_AddLine(C, UpCaseStr(RegName) + '=' +
   HexWord(Word(EmuDbg_RegByName(RegName, EmuPanel.CPU))))
 Else Begin
  Val('$' + ValStr, V, ErrPos);
  If ErrPos <> 0 Then Val(ValStr, V, ErrPos);
  If ErrPos <> 0 Then
   EmuCmdConsole_AddLine(C, 'Valeur invalide : ' + ValStr)
  Else Begin
   EmuDbg_SetRegByName(RegName, EmuPanel.CPU, Word(V));
   EmuCmdConsole_AddLine(C, UpCaseStr(RegName) + '=' + HexWord(Word(V)));
  End;
 End;
End;

Procedure EmuCmdConsole_CmdD(Var C: TEmuCmdConsole; Const Args: String);
Var Seg: Word; Ofs: LongInt; I: Integer; A: String;
Begin
 A := TermExtractParam(Args, 1);
 If A = '' Then Begin
  Seg := C.LastDumpSeg; Ofs := C.LastDumpOfs;
 End Else If Not EmuCmdConsole_ParseSegOfsL(A, Seg, Ofs) Then Begin
  EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
  Exit;
 End;
 For I := 0 To 7 Do
  EmuCmdConsole_AddLine(C,
   EmuDbg_FormatMemLineL(EmuPanel.CPU, Seg, Ofs + I * 16, 16));
 C.LastDumpSeg := Seg; C.LastDumpOfs := Ofs + 128;
End;

Procedure EmuCmdConsole_CmdE(Var C: TEmuCmdConsole; Const Args: String);
Var Seg: Word; Ofs: LongInt; A, ValTok: String; I: Integer; V: LongInt; ErrPos: Word;
Begin
 A := TermExtractParam(Args, 1);
 If (A = '') Or (Not EmuCmdConsole_ParseSegOfsL(A, Seg, Ofs)) Then Begin
  EmuCmdConsole_AddLine(C, 'Syntaxe : E SEG:OFS valeur [valeur...]');
  Exit;
 End;
 I := 0;
 Repeat
  ValTok := TermExtractParam(Args, I + 2);
  If ValTok <> '' Then Begin
   Val('$' + ValTok, V, ErrPos);
   If ErrPos = 0 Then
    Emu_WriteByteL(EmuPanel.CPU, Seg, Ofs + I, Byte(V));
   Inc(I);
  End;
 Until ValTok = '';
 EmuCmdConsole_AddLine(C, EmuDbg_FormatMemLineL(EmuPanel.CPU, Seg, Ofs, 16));
End;

{ Renvoie la portion de S restant APRES avoir saute N mots separes par des    }
{ espaces/tabulations - contrairement a TermExtractParam (qui isole UN seul  }
{ mot), ceci garde tout le reste TEL QUEL (espaces internes preserves), utile }
{ pour un motif de recherche ou un chemin pouvant contenir des espaces. }
Function EmuCmdConsole_RestAfterTokens(Const S: String; N: Integer): String;
Var
 I, Count: Integer;
Begin
 I := 1; Count := 0;
 While (Count < N) And (I <= Length(S)) Do Begin
  While (I <= Length(S)) And (S[I] In [' ', #9]) Do Inc(I);
  If I > Length(S) Then Break;
  While (I <= Length(S)) And (Not (S[I] In [' ', #9])) Do Inc(I);
  Inc(Count);
 End;
 While (I <= Length(S)) And (S[I] In [' ', #9]) Do Inc(I);
 EmuCmdConsole_RestAfterTokens := Copy(S, I, Length(S) - I + 1);
End;

{ Commande S SEG:OFS LEN texte - recherche une chaine ASCII (insensible a la }
{ casse) dans LEN octets de memoire EMULEE REELLE a partir de SEG:OFS.       }
{ Ajoutee (2026-08-25) faute de mieux pour l enquete CONFIG.SYS/SYSINIT :    }
{ aucune reference statique directe aux messages d erreur de IO.SYS n a pu   }
{ etre trouvee (adressage indirect probable), et il n existait jusqu ici     }
{ AUCUN moyen de localiser en direct, dans la memoire EMULEE, la ou les      }
{ chaines/tables de mots-cles de CONFIG.SYS (DEVICE/DOS/COUNTRY/FILES/...)   }
{ sont effectivement chargees au moment du boot reel - seule alternative     }
{ avant cet ajout : deviner un point d arret puis tracer pas-a-pas a l aveugle. }
{ Reutilise Emu_ReadByteL (deja unreal-aware) - fonctionne donc aussi bien   }
{ en mode reel classique qu en mode "unreal" 32 bits. Plafonne a 50          }
{ resultats pour ne jamais noyer la console sur un motif trop court/frequent. }
Procedure EmuCmdConsole_CmdS(Var C: TEmuCmdConsole; Const Args: String);
Var
 Seg: Word; StartOfs, LenBytes, Ofs, I, MatchCount: LongInt;
 A, LenStr, Pattern, UpPattern: String;
 B: Byte; Matches: Boolean; ErrPos: Word;
Begin
 A := TermExtractParam(Args, 1);
 LenStr := TermExtractParam(Args, 2);
 Pattern := EmuCmdConsole_RestAfterTokens(Args, 2);
 If (A = '') Or (LenStr = '') Or (Pattern = '') Then Begin
  EmuCmdConsole_AddLine(C, 'Syntaxe : S SEG:OFS LEN texte');
  Exit;
 End;
 If Not EmuCmdConsole_ParseSegOfsL(A, Seg, StartOfs) Then Begin
  EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
  Exit;
 End;
 Val('$' + LenStr, LenBytes, ErrPos);
 If (ErrPos <> 0) Or (LenBytes <= 0) Then Begin
  EmuCmdConsole_AddLine(C, 'Longueur invalide : ' + LenStr);
  Exit;
 End;
 UpPattern := UpCaseStr(Pattern);
 MatchCount := 0;
 Ofs := StartOfs;
 While Ofs <= StartOfs + LenBytes - LongInt(Length(UpPattern)) Do Begin
  Matches := True;
  For I := 0 To Length(UpPattern) - 1 Do Begin
   B := Emu_ReadByteL(EmuPanel.CPU, Seg, Ofs + I);
   If UpCase(Chr(B)) <> UpPattern[I + 1] Then Begin
    Matches := False;
    Break;
   End;
  End;
  If Matches Then Begin
   EmuCmdConsole_AddLine(C, 'Trouve : ' + HexWord(Seg) + ':' + HexLong(Ofs));
   Inc(MatchCount);
   If MatchCount >= 50 Then Begin
    EmuCmdConsole_AddLine(C, '(arret apres 50 resultats)');
    Break;
   End;
  End;
  Inc(Ofs);
 End;
 If MatchCount = 0 Then
  EmuCmdConsole_AddLine(C, 'Aucune occurrence de "' + Pattern + '" trouvee.');
End;

Procedure EmuCmdConsole_CmdU(Var C: TEmuCmdConsole; Const Args: String);
Var Seg, Ofs: Word; A: String; I, Sz: Integer; S: String;
Begin
 A := TermExtractParam(Args, 1);
 If A = '' Then Begin
  Seg := C.LastUnasmSeg; Ofs := C.LastUnasmOfs;
 End Else If Not EmuCmdConsole_ParseSegOfs(A, Seg, Ofs) Then Begin
  EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
  Exit;
 End;
 For I := 1 To 10 Do Begin
  S := EmuDbg_Disasm8086(Seg, Ofs, Sz);
  If Sz < 1 Then Sz := 1;
  EmuCmdConsole_AddLine(C, HexWord(Seg) + ':' + HexWord(Ofs) + '  ' + S);
  Ofs := Word(Ofs + Sz);
 End;
 C.LastUnasmSeg := Seg; C.LastUnasmOfs := Ofs;
End;

{ Syntaxe etendue BPX SEG:OFS[:N[:LEN]] - meme parametres que le parametre
  /BP:SEG:OFS:N:LEN deja existant de la commande Terminal DEBUG (N =
  Nieme passage decimal avant de vraiment declencher la pause,
  EmuDbg_CheckBPHit/HitCountTarget ; LEN = octets de memoire EMULEE REELLE
  a vider dans EMUDUMP.BIN/.LOG au declenchement, EmuDbg_DumpMemoryAt) -
  ajoute explicitement pour cibler une occurrence PRECISE d une routine
  visitee de nombreuses fois (necessaire pour l enquete NC3 : le premier
  passage par le gestionnaire de recouvrements $2999 est loin d etre le
  seul, ni le plus interessant). }
Procedure EmuCmdConsole_CmdBPX(Var C: TEmuCmdConsole; Const Args: String);
Var
 Seg, Ofs: Word; A, NStr, LenStr: String; Addr: LongInt; Idx: Integer;
 N, Len: LongInt; ErrPos: Word; P1, P2: Integer;
Begin
 A := TermExtractParam(Args, 1);
 If A = '' Then Begin
  EmuCmdConsole_AddLine(C, 'Syntaxe : BPX SEG:OFS[:N[:LEN]]');
  Exit;
 End;
 { BOGUE REEL corrige (2026-08-25, trouve en cherchant a isoler un passage    }
 { precis du mover XMS pendant l enquete CONFIG.SYS) : EmuCmdConsole_ParseSegOfs }
 { ne comprend que "SEG:OFS" - toute la portion apres le 1er ":" est collee   }
 { telle quelle dans OfsStr et passee a Val(), qui echoue des qu il reste un  }
 { 2e/3e ":" (le N et le LEN documentes ci-dessus). Consequence : la syntaxe  }
 { documentee "BPX SEG:OFS:N:LEN" (et "SEG:OFS:N") echouait TOUJOURS avec     }
 { "Syntaxe : BPX SEG:OFS[:N[:LEN]]", quelle que soit la validite des         }
 { valeurs - seule la forme alternative espaces "BPX OFS N [LEN]" (jamais     }
 { documentee dans ce message d aide) fonctionnait. On decoupe donc ici       }
 { nous-memes les eventuels 2e/3e champs ":" AVANT d appeler ParseSegOfs sur   }
 { la seule portion SEG:OFS restante - un seul ":" reste toujours "SEG:OFS"   }
 { (comportement inchange pour D/E/U), 2 ou 3 ":" liberent N et LEN. }
 NStr := ''; LenStr := '';
 P1 := Pos(':', A);
 If P1 > 0 Then Begin
  P2 := Pos(':', Copy(A, P1 + 1, Length(A) - P1));
  If P2 > 0 Then Begin
   P2 := P1 + P2;
   NStr := Copy(A, P2 + 1, Length(A) - P2);
   A := Copy(A, 1, P2 - 1);
   P1 := Pos(':', NStr);
   If P1 > 0 Then Begin
    LenStr := Copy(NStr, P1 + 1, Length(NStr) - P1);
    NStr := Copy(NStr, 1, P1 - 1);
   End;
  End;
 End;
 If Not EmuCmdConsole_ParseSegOfs(A, Seg, Ofs) Then Begin
  EmuCmdConsole_AddLine(C, 'Syntaxe : BPX SEG:OFS[:N[:LEN]]');
  Exit;
 End;
 Addr := (LongInt(Seg) Shl 4) + Ofs;
 EmuDbg_AddBP(Addr, EDC_8086);
 { Forme alternative espaces (BPX OFS N [LEN]) - ne s'applique que si la      }
 { forme ":" n'a rien fourni, pour ne pas casser cette syntaxe deja en usage. }
 If NStr = '' Then NStr := TermExtractParam(Args, 2);
 If LenStr = '' Then LenStr := TermExtractParam(Args, 3);
 If (NStr <> '') Or (LenStr <> '') Then Begin
  Idx := EmuDbg_FindBP(Addr, EDC_8086);
  If Idx >= 0 Then Begin
   If NStr <> '' Then Begin
    Val(NStr, N, ErrPos);
    If ErrPos = 0 Then EmuDbg.BPs[Idx].HitCountTarget := N;
   End;
   If LenStr <> '' Then Begin
    Val(LenStr, Len, ErrPos);
    If ErrPos = 0 Then EmuDbg.BPs[Idx].DumpLen := Len;
   End;
  End;
 End;
 A := 'Point d''arret pose : ' + HexWord(Seg) + ':' + HexWord(Ofs);
 If NStr <> '' Then A := A + ' (passage #' + NStr + ')';
 If LenStr <> '' Then A := A + ' (vidage ' + LenStr + ' octets -> EMUDUMP.LOG)';
 EmuCmdConsole_AddLine(C, A);
End;

Procedure EmuCmdConsole_CmdBC(Var C: TEmuCmdConsole; Const Args: String);
Var N: Integer; A: String; ErrPos: Word; V: LongInt; Addr: LongInt; ACPU: TEmuDbgCPU;
Begin
 A := TermExtractParam(Args, 1);
 Val(A, V, ErrPos);
 N := V;
 If (ErrPos <> 0) Or (N < 0) Or (N >= EmuDbg.BPCount) Then Begin
  EmuCmdConsole_AddLine(C, 'Index de point d''arret invalide : ' + A);
  Exit;
 End;
 Addr := EmuDbg.BPs[N].Addr;
 ACPU := EmuDbg.BPs[N].CPU;
 EmuDbg_RemoveBP(Addr, ACPU);
 EmuCmdConsole_AddLine(C, 'Point d''arret ' + A + ' supprime.');
End;

Procedure EmuCmdConsole_CmdBD(Var C: TEmuCmdConsole; Const Args: String; Enable: Boolean);
Var N: Integer; A: String; ErrPos: Word; V: LongInt;
Begin
 A := TermExtractParam(Args, 1);
 Val(A, V, ErrPos);
 N := V;
 If (ErrPos <> 0) Or (N < 0) Or (N >= EmuDbg.BPCount) Then Begin
  EmuCmdConsole_AddLine(C, 'Index de point d''arret invalide : ' + A);
  Exit;
 End;
 EmuDbg.BPs[N].Enabled := Enable;
 If Enable Then EmuCmdConsole_AddLine(C, 'Point d''arret ' + A + ' active.')
 Else EmuCmdConsole_AddLine(C, 'Point d''arret ' + A + ' desactive.');
End;

Procedure EmuCmdConsole_CmdBL(Var C: TEmuCmdConsole);
Var I: Integer; St: String;
Begin
 If EmuDbg.BPCount = 0 Then Begin
  EmuCmdConsole_AddLine(C, '(aucun point d''arret)');
  Exit;
 End;
 For I := 0 To EmuDbg.BPCount - 1 Do Begin
  If EmuDbg.BPs[I].Enabled Then St := 'actif' Else St := 'inactif';
  EmuCmdConsole_AddLine(C, IntToStr(I) + ': ' + HexLong(EmuDbg.BPs[I].Addr) +
   '  ' + St + '  hits=' + IntToStr(EmuDbg.BPs[I].HitCount));
 End;
End;

{ BOGUE REEL trouve en reprenant l enquete NC3 avec la console (2026-08-19) :
  cliquer DANS la console (necessaire pour lui donner le focus clavier) est
  un clic HORS du rectangle du panneau emulateur, ce qui declenche le code
  EXISTANT de DispatchEvent "clic hors du panneau -> EmuHasFocus := False"
  (~ligne 86982) - or StepEmulator (DOS_RunOneChunk) EXIGE EmuHasFocus=True
  pour avancer ne serait-ce que d une instruction (piege deja documente
  pour le clavier/souris, jamais applique a la console puisqu elle n
  existait pas encore). PREMIERE tentative de correctif (mettre
  EmuHasFocus:=True depuis la console avant G/T/P) etait INCOMPLETE : ce
  drapeau sert AUSSI a router le clavier dans DispatchEvent, donc le
  forcer a True depuis la console lui faisait perdre le focus clavier des
  la commande suivante (le clic sur l ecran emulateur devenait
  prioritaire). Corrige a la RACINE a la place, directement dans
  StepEmulator (voir plus bas, branche '-CD'/'-CP') : la console visible
  est desormais une justification ALTERNATIVE a EmuHasFocus, sans jamais
  toucher ce drapeau depuis ici - le clavier reste donc correctement
  route vers la console entre deux commandes.
  DEUXIEME bogue trouve en poursuivant la MEME enquete : meme apres ce
  premier correctif, G/T/P depuis la console ne faisaient toujours RIEN
  avancer - `StepEmulator` sortait avant meme d atteindre le test
  EmuHasFocus/console via son tout premier `If Not P.Running Then Exit;`.
  `EmuPanel.Running` (alias `P.Running` ici) n est JAMAIS mis a True par
  `EmuDbg_Continue`/`StepInto`/`StepOver`/`StepOut` (qui ne touchent que
  les champs `EmuDbg.*`, un record DIFFERENT) - il n est mis a True QUE
  par `EmuPanel_TryResume` (~ligne 9723), elle-meme appelee UNIQUEMENT par
  le tout premier F5 clavier alors qu on n est PAS encore dans une pause
  du debogueur (raccourci global de DispatchEvent, PAS EmuDbg_HandleKey -
  cette branche est court-circuitee des le 2e F5, une fois a l interieur
  de la pause). Toute commande console qui reprend/avance l execution doit
  donc appeler `EmuPanel_TryResume;` (resultat ignore) AVANT le primitif
  EmuDbg_* correspondant, pour reproduire fidelement ce que fait F5 la
  toute premiere fois - sinon P.Running reste bloque a False pour de bon. }
Procedure EmuCmdConsole_CmdG(Var C: TEmuCmdConsole; Const Args: String);
Var Seg, Ofs: Word; A: String;
Begin
 A := TermExtractParam(Args, 1);
 If A <> '' Then Begin
  If Not EmuCmdConsole_ParseSegOfs(A, Seg, Ofs) Then Begin
   EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
   Exit;
  End;
  EmuDbg_AddBP((LongInt(Seg) Shl 4) + Ofs, EDC_8086);
  EmuCmdConsole_AddLine(C, 'Point d''arret pose a ' + HexWord(Seg) + ':' +
   HexWord(Ofs) + ', execution en cours (G)... (BC pour le retirer)');
 End Else
  EmuCmdConsole_AddLine(C, 'Execution (G)...');
 EmuPanel_TryResume;
 EmuDbg_Continue;
End;

Procedure EmuCmdConsole_CmdSet(Var C: TEmuCmdConsole; Const Args: String);
Var Sub, ValStr: String;
Begin
 Sub := UpCaseStr(TermExtractParam(Args, 1));
 If Sub = 'RADIX' Then Begin
  ValStr := TermExtractParam(Args, 2);
  If ValStr = '10' Then Begin
   C.Radix := 10; EmuCmdConsole_AddLine(C, 'Radix = 10');
  End Else If ValStr = '16' Then Begin
   C.Radix := 16; EmuCmdConsole_AddLine(C, 'Radix = 16');
  End Else
   EmuCmdConsole_AddLine(C, 'Syntaxe : SET RADIX 10|16');
 End Else
  EmuCmdConsole_NotApplicable(C, 'SET ' + Sub);
End;

{ Evaluateur minimal : un seul jeton (nom de registre ou litteral
  hexa/decimal). PAS un evaluateur d expressions complet - voir WATCH/SYM
  ci-dessous pour ce qui reste hors perimetre de ce chantier. }
Procedure EmuCmdConsole_CmdEval(Var C: TEmuCmdConsole; Const Args: String);
Var Tok: String; V: LongInt; ErrPos: Word; RegV: LongInt;
Begin
 Tok := TermExtractParam(Args, 1);
 If (Tok = '') Or (TermExtractParam(Args, 2) <> '') Then Begin
  EmuCmdConsole_AddLine(C, '? : seules les expressions a un seul jeton ' +
   '(registre ou litteral hexa/decimal) sont gerees dans cette version.');
  Exit;
 End;
 RegV := EmuDbg_RegByName(Tok, EmuPanel.CPU);
 If RegV <> -1 Then Begin
  EmuCmdConsole_AddLine(C, Tok + ' = ' + HexWord(Word(RegV)) + ' (' +
   IntToStr(RegV) + ')');
  Exit;
 End;
 Val('$' + Tok, V, ErrPos);
 If ErrPos <> 0 Then Val(Tok, V, ErrPos);
 If ErrPos = 0 Then
  EmuCmdConsole_AddLine(C, HexLong(V) + ' (' + IntToStr(V) + ')')
 Else
  EmuCmdConsole_AddLine(C, 'Expression non reconnue : ' + Tok);
End;

{ --- WATCH : arme/desarme le watchpoint memoire existant (EmuWatchEnabled/
  PhysLo/PhysHi/Hits, deja utilise ponctuellement par edition manuelle du
  code + recompilation lors de l enquete NC3 - expose ici de facon
  PERMANENTE via la console pour eviter cet aller-retour a chaque fois). }
Procedure EmuCmdConsole_CmdWatch(Var C: TEmuCmdConsole; Const Args: String);
Var A, LenStr: String; Seg, Ofs: Word; Len: LongInt; ErrPos: Word; V: LongInt;
Begin
 A := TermExtractParam(Args, 1);
 If UpCaseStr(A) = 'OFF' Then Begin
  EmuWatchEnabled := False;
  EmuCmdConsole_AddLine(C, 'Watch desactive (' + IntToStr(EmuWatchHits) + ' evenement(s) journalise(s)).');
  Exit;
 End;
 If A = '' Then Begin
  If EmuWatchEnabled Then
   EmuCmdConsole_AddLine(C, 'Watch actif : ' + HexLong(EmuWatchPhysLo) + '-' +
    HexLong(EmuWatchPhysHi) + '  hits=' + IntToStr(EmuWatchHits) +
    '  (EMUWATCH.LOG, plafond 200)')
  Else
   EmuCmdConsole_AddLine(C, 'Watch inactif. Syntaxe : WATCH seg:ofs [longueur] | WATCH OFF');
  Exit;
 End;
 If Not EmuCmdConsole_ParseSegOfs(A, Seg, Ofs) Then Begin
  EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
  Exit;
 End;
 LenStr := TermExtractParam(Args, 2);
 If LenStr = '' Then Len := 1
 Else Begin
  Val(LenStr, V, ErrPos);
  If ErrPos <> 0 Then Val('$' + LenStr, V, ErrPos);
  If ErrPos <> 0 Then Len := 1 Else Len := V;
 End;
 If Len < 1 Then Len := 1;
 EmuWatchPhysLo := (LongInt(Seg) Shl 4) + Ofs;
 EmuWatchPhysHi := EmuWatchPhysLo + Len - 1;
 EmuWatchHits := 0;
 EmuWatchEnabled := True;
 EmuCmdConsole_AddLine(C, 'Watch arme sur ' + HexLong(EmuWatchPhysLo) + '-' +
  HexLong(EmuWatchPhysHi) + ' (' + HexWord(Seg) + ':' + HexWord(Ofs) +
  ', ' + IntToStr(Len) + ' octet(s)) -> EMUWATCH.LOG, plafond 200 evenements.');
End;

{ --- TRACELOG : vide sur demande le tampon circulaire des 8192 dernieres
  instructions executees (Emu_DumpTrace, deja existant, normalement
  reserve a la fin de session/entree en pause sous Options DOS:Debug) vers
  EMUTRACE.LOG - complement a T/P/G qui n a PAS d equivalent direct dans
  la table SoftICE originale, ajoute explicitement pour cette console. }
Procedure EmuCmdConsole_CmdTraceLog(Var C: TEmuCmdConsole);
Begin
 Emu_DumpTrace;
 EmuCmdConsole_AddLine(C, 'Historique des dernieres instructions -> EMUTRACE.LOG');
End;

{ --- ENTROPY seg:ofs [longueur] : meme calcul que EmuDbg_CtxEntropy (menu
  contextuel du Debogueur) mais sur une adresse ARBITRAIRE (pas seulement
  CS:IP) et affiche directement dans la console - complement sans
  equivalent SoftICE natif, ajoute explicitement pour cette console
  (technique deja centrale a l enquete NC3 : ~5.5-6.5 bits/octet = code
  x86 authentique, ~8.0 = donnees compressees/chiffrees). }
Procedure EmuCmdConsole_CmdEntropy(Var C: TEmuCmdConsole; Const Args: String);
Const MAX_SZ = 4096;
Var
 A, LenStr: String; Seg, Ofs: Word; Sz: LongInt; ErrPos: Word; V: LongInt;
 Addr: LongInt; Buf: Array[0..MAX_SZ - 1] Of Byte;
 Freq: Array[0..255] Of LongInt; I: Integer; Pr, Ent: Double; EntStr: String;
Begin
 A := TermExtractParam(Args, 1);
 If A = '' Then Begin
  Seg := EmuPanel.CPU.Segs.CS; Ofs := EmuPanel.CPU.IP;
 End Else If Not EmuCmdConsole_ParseSegOfs(A, Seg, Ofs) Then Begin
  EmuCmdConsole_AddLine(C, 'Adresse invalide : ' + A);
  Exit;
 End;
 LenStr := TermExtractParam(Args, 2);
 If LenStr = '' Then Sz := MAX_SZ
 Else Begin
  Val(LenStr, V, ErrPos);
  If ErrPos = 0 Then Sz := V Else Sz := MAX_SZ;
 End;
 If (Sz < 1) Or (Sz > MAX_SZ) Then Sz := MAX_SZ;
 Addr := (LongInt(Seg) Shl 4) + Ofs;
 Emu_ReadAbsBlock(EmuPanel.CPU, Addr, Buf, Word(Sz));
 FillChar(Freq, SizeOf(Freq), 0);
 For I := 0 To Sz - 1 Do Inc(Freq[Buf[I]]);
 Ent := 0.0;
 For I := 0 To 255 Do
  If Freq[I] > 0 Then Begin
   Pr := Freq[I] / Sz;
   Ent := Ent - Pr * (Ln(Pr) / Ln(2));
  End;
 Str(Ent:0:3, EntStr);
 EmuCmdConsole_AddLine(C, 'Entropie de ' + IntToStr(Sz) + ' octets depuis ' +
  HexWord(Seg) + ':' + HexWord(Ofs) + ' (phys=' + HexLong(Addr) + ') : ' +
  EntStr + ' bits/octet (max 8.0)');
 EmuCmdConsole_AddLine(C, '  ~5.5-6.5 = code x86 authentique typique ; ~8.0 = donnees compressees/chiffrees.');
End;

