  4: DosCPUVendorID12 := 'GenuineTMx86';
  5: DosCPUVendorID12 := 'NexGenDriven';
  6: DosCPUVendorID12 := 'UMC UMC UMC ';
  7: DosCPUVendorID12 := 'IBM IBM IBM ';
 Else
