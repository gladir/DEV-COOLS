   { existe/n existe pas) - decouvert manquant en comparant avec dos.cpp     }
   { de DOSBox (AH=6Ch), utilisee par des programmes DOS 4+ a la place de   }
   { AH=3Dh/3Ch quand le comportement exact (echouer/ouvrir/tronquer/creer)  }
   { doit etre choisi en un seul appel. Retourne CX=action realisee          }
   { (1=ouvert existant, 2=tronque existant, 3=cree). Coeur partage avec     }
   { AX=716Ch (Windows 95, Stage 5) via Emu_DoOpen6C - seule la lecture du   }
   { nom differe (79 caracteres ici, jusqu a 254 pour 716Ch). }
   Emu_DoOpen6C(P, Emu_ReadAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI));
  $71:
   { API de noms longs Windows 95 (INT 21h/AH=71h, Stage 5) - branchee      }
   { UNIQUEMENT si DosType=Windows 95, sinon ce case se comporte EXACTEMENT }
   { comme si l aiguillage $71 n existait pas du tout (Emu_SetDosErr(P,1),  }
   { meme discipline que le fallthrough generique Else ci-dessous et que le }
   { case $64 OS/2) - AX=7100h+CF (la convention documentee pour "IFSMgr    }
   { present mais cette sous-fonction precise non geree") ne s applique      }
   { QU APRES avoir confirme DosType=Windows 95, jamais avant. }
   If OptionsDlg.Data.DosType <> DOS_TYPE_WIN95 Then
    Emu_SetDosErr(P, 1)
   Else Case P.CPU.Regs.AL Of
    $39:
     { 7139h : creer un repertoire (nom long) - hote uniquement, comme       }
     { toutes les fonctions de ce bloc (voir Emu_DoOpen6C : aucune fonction  }
     { INT 21h classique de ce fichier n a jamais touche les disques         }
     { virtuels FAT montes via /DISK0-1/80/81, seulement le systeme de       }
     { fichiers hote via Emu_HostPath - introduire une branche disque        }
     { virtuel ICI, seule parmi toutes les fonctions AH=71h, aurait ete une  }
     { asymetrie architecturale surprenante ; le systeme de fichiers hote    }
     { gere de toute facon deja nativement les noms longs sans travail       }
     { supplementaire). }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      {$I-} MkDir(LHost); {$I+}
      If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
      Else Emu_SetDosErr(P, 3);
     End;
    $3A:
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      {$I-} RmDir(LHost); {$I+}
      If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
      Else Emu_SetDosErr(P, 3);
     End;
    $3B:
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      {$I-} ChDir(LHost); {$I+}
      If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
      Else Emu_SetDosErr(P, 3);
     End;
    $41:
     { 7141h : supprimer (nom long). SI=1 autorise les jokers - CL/CH        }
     { (attributs admis/obligatoires) simplifies a un simple masque passe a  }
     { FindFirst, meme niveau de fidelite que le $43 classique existant. }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      If P.CPU.Regs.SI = 0 Then Begin
       {$I-} Assign(EmuFileH[5], LHost); Erase(EmuFileH[5]); {$I+}
       If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
       Else Emu_SetDosErr(P, 2);
      End Else Begin
       { FindFirst/Next ne rendent QUE le nom trouve (SR.Name), sans le      }
       { repertoire du motif - reconstituer le chemin complet a chaque       }
       { correspondance avant Erase, sinon Assign viserait le repertoire     }
       { courant du PROCESSUS HOTE au lieu du repertoire du motif. }
       I := Length(LHost);
       While (I > 0) And (LHost[I] <> '\') Do Dec(I);
       LFindCnt := 0;
       {$I-}
       FindFirst(LHost, Byte(P.CPU.Regs.CL), SR);
       While DosError = 0 Do Begin
        LHost2 := Copy(LHost, 1, I) + SR.Name;
        {$I-} Assign(EmuFileH[5], LHost2); Erase(EmuFileH[5]); {$I+}
        If IOResult = 0 Then Inc(LFindCnt);
        FindNext(SR);
       End;
       FindClose(SR);
       {$I+} If IOResult <> 0 Then ;
       If LFindCnt > 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
       Else Emu_SetDosErr(P, 2);
      End;
     End;
    $43:
     { 7143h : attributs et horodatages - BL selectionne la sous-operation   }
     { (voir DOC section 6). Une seule paire GetFTime/SetFTime existe cote   }
     { hote (Unit Dos) : creation/acces/modification s y ramenent toutes     }
     { les trois, limitation documentee (deja la meme pour 71A6h et pour le  }
     { FindData de 714Eh/714Fh). }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      Case P.CPU.Regs.BL Of
       0: Begin
           {$I-} Assign(EmuFileH[5], LHost); GetFAttr(EmuFileH[5], LAttrW); {$I+}
           If IOResult = 0 Then Begin
            P.CPU.Regs.CX := LAttrW;
            Exclude(P.CPU.Flags.s, EFG_CF);
           End Else Emu_SetDosErr(P, 2);
          End;
       1: Begin
           {$I-} Assign(EmuFileH[5], LHost); SetFAttr(EmuFileH[5], P.CPU.Regs.CX); {$I+}
           If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
           Else Emu_SetDosErr(P, 2);
          End;
       2: Begin
           {$I-} FindFirst(LHost, AnyFile, SR); {$I+}
           If (IOResult = 0) And (DosError = 0) Then Begin
            P.CPU.Regs.AX := Word(SR.Size And $FFFF);
            P.CPU.Regs.DX := Word((SR.Size Shr 16) And $FFFF);
            Exclude(P.CPU.Flags.s, EFG_CF);
           End Else Emu_SetDosErr(P, 2);
           {$I-} FindClose(SR); {$I+} If IOResult <> 0 Then ;
          End;
       3, 5, 7:
        Begin
         { Ecrire (DI=date [,CX=heure pour BL=03/07]) - BL=05/07 n ont pas  }
         { d emplacement de stockage distinct de la derniere modification    }
         { dans ce modele (Unit Dos, GetFTime/SetFTime), donc DI/CX s y       }
         { appliquent egalement plutot que d etre ignores en silence. }
         {$I-} Assign(EmuFileH[5], LHost); GetFTime(EmuFileH[5], LTimeVal); {$I+}
         If IOResult = 0 Then Begin
          If P.CPU.Regs.BL = 5 Then
           LTimeVal := (LongInt(P.CPU.Regs.DI) Shl 16) Or (LTimeVal And $FFFF)
          Else
           LTimeVal := (LongInt(P.CPU.Regs.DI) Shl 16) Or P.CPU.Regs.CX;
          {$I-} SetFTime(EmuFileH[5], LTimeVal); {$I+}
          If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
          Else Emu_SetDosErr(P, 2);
         End Else Emu_SetDosErr(P, 2);
        End;
       4, 6, 8:
        Begin
         {$I-} Assign(EmuFileH[5], LHost); GetFTime(EmuFileH[5], LTimeVal); {$I+}
         If IOResult = 0 Then Begin
          P.CPU.Regs.DI := Word((LTimeVal Shr 16) And $FFFF);
          P.CPU.Regs.CX := Word(LTimeVal And $FFFF);
          P.CPU.Regs.SI := 0;   { centiemes : non modelises, voir ci-dessus }
          Exclude(P.CPU.Flags.s, EFG_CF);
         End Else Emu_SetDosErr(P, 2);
        End;
       Else Emu_SetDosErr(P, 1);
      End;
     End;
    $47:
     { 7147h : repertoire courant SANS lettre/':'/'\' initial - a la         }
     { difference du $47 classique (stub qui renvoie toujours une chaine     }
     { vide), le vrai repertoire courant du PROCESSUS HOTE est bien suivi    }
     { (voir $3B/713Bh ci-dessus, qui appellent reellement ChDir), donc      }
     { GetDir(0,...) le rend fidelement. DL (numero de lecteur) ignore -     }
     { aucune notion de repertoire courant PAR LECTEUR dans cet emulateur,   }
     { meme limitation documentee que Emu_CanonicalizePath. }
     Begin
      GetDir(0, LName);
      If (Length(LName) >= 2) And (LName[2] = ':') Then
       LName := Copy(LName, 3, Length(LName) - 2);
      If (Length(LName) >= 1) And (LName[1] = '\') Then
       LName := Copy(LName, 2, Length(LName) - 1);
      Emu_WriteAsciiz(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI, LName);
      Exclude(P.CPU.Flags.s, EFG_CF);
     End;
    $4E:
     { 714Eh : FindFirst LFN - un seul slot de recherche global (voir         }
     { EmuLfnFind*), memes limites que le FindFirst/Next classique existant. }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LHost := Emu_HostPath(LName);
      EmuLfnFindCount := 0;
      EmuLfnFindIndex := 0;
      {$I-}
      FindFirst(LHost, Byte(P.CPU.Regs.CL), SR);
      While (DosError = 0) And (EmuLfnFindCount < 64) Do Begin
       EmuLfnFindResults[EmuLfnFindCount].Name := SR.Name;
       EmuLfnFindResults[EmuLfnFindCount].Attr := Byte(SR.Attr);
       EmuLfnFindResults[EmuLfnFindCount].Size := SR.Size;
       EmuLfnFindResults[EmuLfnFindCount].Time := SR.Time;
       Inc(EmuLfnFindCount);
       FindNext(SR);
      End;
      FindClose(SR);
      {$I+} If IOResult <> 0 Then ;
      If EmuLfnFindCount = 0 Then Emu_SetDosErr(P, 18)
      Else Begin
       EmuLfnFindActive := True;
       Emu_WriteLfnFindData(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI,
        EmuLfnFindResults[0]);
       EmuLfnFindIndex := 1;
       P.CPU.Regs.AX := 1;      { handle - un seul slot possible ici }
       P.CPU.Regs.CX := 0;      { aucune substitution '_' (pas de conversion OEM) }
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     End;
    $4F:
     Begin
      If (Not EmuLfnFindActive) Or (P.CPU.Regs.BX <> 1) Then
       Emu_SetDosErr(P, 6)
      Else If EmuLfnFindIndex >= EmuLfnFindCount Then
       Emu_SetDosErr(P, 18)
      Else Begin
       Emu_WriteLfnFindData(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI,
        EmuLfnFindResults[EmuLfnFindIndex]);
       Inc(EmuLfnFindIndex);
       P.CPU.Regs.AX := 0;
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     End;
    $56:
     Begin
      LName  := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX);
      LName2 := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI);
      LHost  := Emu_HostPath(LName);
      LHost2 := Emu_HostPath(LName2);
      {$I-} Assign(EmuFileH[5], LHost); Rename(EmuFileH[5], LHost2); {$I+}
      If IOResult = 0 Then Exclude(P.CPU.Flags.s, EFG_CF)
      Else Emu_SetDosErr(P, 2);
     End;
    $60:
     { 7160h : canonisation/conversion 8.3<->long - CL=01h majuscules        }
     { (documente explicitement), CL=00h/02h conservent la casse ; CH        }
     { (SUBST) ignore, aucun SUBST modelise dans cet emulateur. }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI);
      Case P.CPU.Regs.CL Of
       0, 2: LName2 := Emu_CanonicalizePathCase(LName, False);
       1:    LName2 := Emu_CanonicalizePathCase(LName, True);
       Else Begin
        LName2 := '';
        Emu_SetDosErr(P, 1);
       End;
      End;
      If LName2 <> '' Then Begin
       Emu_WriteAsciiz(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI, LName2);
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     End;
    $6C:
     { 716Ch : creer/ouvrir (nom long) - coeur partage avec le $6C classique,}
     { voir Emu_DoOpen6C (seule la lecture du nom, ici jusqu a 254           }
     { caracteres via DS:SI au lieu de DS:DX, differe). }
     Emu_DoOpen6C(P, Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI));
    $A0:
     { 71A0h : informations de volume - BX bit14=1 (LFN pris en charge),     }
     { CX=255 (longueur nom max), DX=260 (longueur chemin max, coherent      }
     { avec le plafond de Emu_ReadAsciizLong/String), nom systeme de         }
     { fichiers fixe a 'FAT' (coherent avec le cadrage general de ce         }
     { chantier - pas de sonde reelle du systeme de fichiers hote). }
     Begin
      If P.CPU.Regs.CX < 4 Then
       Emu_SetDosErr(P, 1)
      Else Begin
       Emu_WriteAsciiz(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI, 'FAT');
       P.CPU.Regs.BX := $4000;
       P.CPU.Regs.CX := 255;
       P.CPU.Regs.DX := 260;
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     End;
    $A1:
     Begin
      If EmuLfnFindActive And (P.CPU.Regs.BX = 1) Then Begin
       EmuLfnFindActive := False;
       Exclude(P.CPU.Flags.s, EFG_CF);
      End Else Emu_SetDosErr(P, 6);
     End;
    $A6:
     { 71A6h : informations par handle - tampon de 52 octets, meme mise en   }
     { page que BY_HANDLE_FILE_INFORMATION (attr[4]+3xFILETIME[24]+          }
     { volserial[4]+taille64[8]+liens[4]+id64[8]=52, verifie par calcul).    }
     { Numero de serie de volume et identifiant de fichier : valeurs         }
     { plausibles fixes, aucune notion de volume/inode reelle a exposer      }
     { cote hote ici - documente, meme esprit que les autres limites de ce   }
     { chantier. }
     Begin
      H := P.CPU.Regs.BX;
      If (H < 5) Or (H > 31) Or (Not EmuFileOpen[H]) Then
       Emu_SetDosErr(P, 6)
      Else Begin
       {$I-} GetFAttr(EmuFileH[H], LAttrW); {$I+}
       If IOResult <> 0 Then LAttrW := 0;
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.DX, LAttrW);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + 2), 0);
       {$I-} GetFTime(EmuFileH[H], LTimeVal); {$I+}
       If IOResult <> 0 Then LTimeVal := 0;
       LFT := DosDateTimeToFileTime(Word((LTimeVal Shr 16) And $FFFF),
                                     Word(LTimeVal And $FFFF));
       For I := 0 To 2 Do Begin
        Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + 4 + I * 8), Word(LFT And $FFFF));
        Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + 4 + I * 8 + 2), Word((LFT Shr 16) And $FFFF));
        Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + 4 + I * 8 + 4), Word((LFT Shr 32) And $FFFF));
        Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + 4 + I * 8 + 6), Word((LFT Shr 48) And $FFFF));
       End;
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $1C), $4C46); { volserial fictif "FL" }
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $1E), $4E00);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $20), Word(FileSize(EmuFileH[H]) And $FFFF));
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $22), Word((FileSize(EmuFileH[H]) Shr 16) And $FFFF));
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $24), 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $26), 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $28), 1); { nombre de liens }
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $2A), 0);
       { Identifiant de fichier 64 bits : fabrique a partir du seul handle - }
       { stable tant que le fichier reste ouvert (satisfait la garantie du   }
       { document), sans pretendre a un vrai numero d inode/MFT hote. }
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $2C), Word(H));
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $2E), 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $30), 0);
       Emu_WriteWord(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.DX + $32), 0);
       Exclude(P.CPU.Flags.s, EFG_CF);
      End;
     End;
    $A7:
     { 71A7h : conversion FILETIME <-> heure/date DOS locales (aucun         }
     { decalage de fuseau applique - FILETIME traite comme s il etait deja   }
     { local, limitation documentee). }
     Begin
      Case P.CPU.Regs.BL Of
       0: Begin
           LFT := 0;
           For I := 0 To 3 Do
            LFT := LFT Or (QWord(Emu_ReadByte(P.CPU, P.CPU.Segs.DS,
             Word(P.CPU.Regs.SI + I))) Shl (I * 8));
           For I := 4 To 7 Do
            LFT := LFT Or (QWord(Emu_ReadByte(P.CPU, P.CPU.Segs.DS,
             Word(P.CPU.Regs.SI + I))) Shl (I * 8));
           FileTimeToDosDateTime(LFT, LPackDate, LPackTime, LCenti);
           P.CPU.Regs.CX := LPackTime;
           P.CPU.Regs.DX := LPackDate;
           P.CPU.Regs.BH := LCenti;
           Exclude(P.CPU.Flags.s, EFG_CF);
          End;
       1: Begin
           LFT := DosDateTimeToFileTime(P.CPU.Regs.DX, P.CPU.Regs.CX);
           For I := 0 To 7 Do
            Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I),
             Byte((LFT Shr (I * 8)) And $FF));
           Exclude(P.CPU.Flags.s, EFG_CF);
          End;
       Else Emu_SetDosErr(P, 1);
      End;
     End;
    $A8:
     { 71A8h : generer un alias 8.3 SANS garantie d unicite (voir            }
     { Emu_MakeSimpleAlias11) - DH=0 format FCB 11 octets bruts (non         }
     { termine par un octet nul, format a taille fixe), DH=1 format "NOM.EXT}
     { " ASCIZ. DL (jeu de caracteres) ignore, ce chantier est ASCII/Latin-1 }
     { uniquement de bout en bout. }
     Begin
      LName := Emu_ReadAsciizLong(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI);
      Emu_MakeSimpleAlias11(LName, LN11);
      If P.CPU.Regs.DH = 0 Then Begin
       For I := 0 To 10 Do
        Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I), LN11[I]);
      End Else
       Emu_WriteAsciiz(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI, Fat_Name11ToDisplay(LN11));
      Exclude(P.CPU.Flags.s, EFG_CF);
     End;
    $AA:
     { 71AAh : fonctions LFN SUBST - aucune notion de SUBST dans cet          }
     { emulateur, repondre "non pris en charge" proprement plutot que de      }
     { batir un sous-systeme SUBST complet hors de la portee de ce chantier. }
     Emu_SetDosErr(P, 1);
    Else Begin
     { Sous-fonction 71xxh reconnue par le document mais volontairement      }
     { hors de la portee de ce chantier (710Dh reset lecteur, 71A9h usage    }
     { serveur interne, 71A2h-71A5h explicitement internes) - ou toute       }
     { valeur AL inconnue : signal documente "IFSMgr present mais cette      }
     { sous-fonction precise non geree". }
     P.CPU.Regs.AX := $7100;
     Include(P.CPU.Flags.s, EFG_CF);
    End;
   End;
  Else
   Emu_SetDosErr(P, 1);
 End;
End;

{ --- Executer une interruption logicielle --- }

{ Forcer le CPU a passer dans la routine d interruption Num via l IVT.
  Pousse FLAGS, CS, IP et saute a IVT[Num].
  Si IVT[Num] = 0:0 (vecteur vide), on traite comme INT logiciel
  via Emu_DoInt directement (compatibilit? avec le mode stub). }
Procedure Emu_FireHwInt(Var P: TEmulatorPanel; Num: Byte); Forward;

{ --- INT 33h : pilote souris (Microsoft Mouse API) ---
  Implementation des sous-fonctions les plus utilisees par les
  programmes DOS Pascal/C. La souris hote est traduite vers les
  coordonnees logiques de l ecran emule par EmuMouse_UpdateFromHost.
  Les coordonnees rendues sont en PIXELS pour les modes graphiques
  et en COLONNES DE 8 PIXELS pour les modes texte (convention IBM). }
{ Palier de version (0..3, voir DosMouseVersionName) auquel appartient une }
{ fonction INT 33h donnee - regroupement par PLAGE DE NUMERO DE FONCTION   }
{ (aucune date d introduction par fonction n a pu etre confirmee avec la   }
{ meme certitude que pour EMS/LIM, dont les paliers viennent directement   }
{ de la specification - voir DosMouseVersionName). }
Function Emu_MouseFuncTier(Func: Word): Byte;
Begin
 If Func <= $0F Then Emu_MouseFuncTier := 0
 Else If Func <= $1B Then Emu_MouseFuncTier := 1
 Else If Func <= $21 Then Emu_MouseFuncTier := 2
 Else Emu_MouseFuncTier := 3;
End;

{ Vrai si la version de pilote configuree (EmuMouseVersion) sait repondre  }
{ a la fonction demandee - voir Emu_MouseFuncTier. Meme principe que       }
{ Emu_EmsVerAtLeast : une fonction "trop recente" pour la version choisie  }
{ ne repond pas, exactement comme un vrai pilote plus ancien ignorerait un}
{ numero de fonction qu il ne connait pas (c est le but recherche : tester }
{ un programme contre une version precise plutot que contre "tout ce que   }
{ l emulateur sait faire"). }
Function Emu_MouseVerOK(Func: Word): Boolean;
Begin
 Emu_MouseVerOK := EmuMouseVersion >= Emu_MouseFuncTier(Func);
End;

Procedure Emu_DoInt33(Var P: TEmulatorPanel);
Var
 BIdx: Integer;
Begin
 If Not Emu_MouseVerOK(P.CPU.Regs.AX) Then Exit; { fonction trop recente     }
                                                  { pour la version choisie   }
 Case P.CPU.Regs.AX Of
  $0000: Begin   { Reset / detect driver }
   P.CPU.Regs.AX := $FFFF;     { driver present }
   P.CPU.Regs.BX := 3;         { 3 boutons }
   EmuMouseVis := -1;
   EmuMouseBtns := 0;
   EmuMouseHRatio := 8; EmuMouseVRatio := 16;
   EmuMouseMickX := 0; EmuMouseMickY := 0;
   EmuMouseHandlerMsk := 0;
   EmuMouseHandlerSeg := 0; EmuMouseHandlerOfs := 0;
   EmuMouseAltHandlerMsk := 0;
   EmuMouseAltHandlerSeg := 0; EmuMouseAltHandlerOfs := 0;
   EmuMouseSoftDisabled := False;
   For BIdx := 0 To 2 Do Begin
    EmuMousePressCnt[BIdx] := 0; EmuMouseRelCnt[BIdx] := 0;
    EmuMousePressX[BIdx] := 0;   EmuMousePressY[BIdx] := 0;
    EmuMouseRelX[BIdx]   := 0;   EmuMouseRelY[BIdx]   := 0;
   End;
   { Plages selon le mode video courant }
   EmuMouseXMin := 0; EmuMouseYMin := 0;
   If EmuVideo.IsGraphic Then Begin
    EmuMouseXMax := EmuVideo.Width  - 1;
    EmuMouseYMax := EmuVideo.Height - 1;
   End Else Begin
    EmuMouseXMax := EmuVideo.TextCols * 8 - 1;
    EmuMouseYMax := EmuVideo.TextRows * 8 - 1;
   End;
  End;
  $0001: { Show cursor }
   If EmuMouseVis < 0 Then Inc(EmuMouseVis);
  $0002: { Hide cursor }
   Dec(EmuMouseVis);
  $0003: Begin   { Get position+buttons }
   P.CPU.Regs.BX := EmuMouseBtns;
   P.CPU.Regs.CX := Word(EmuMouseX);
   P.CPU.Regs.DX := Word(EmuMouseY);
  End;
  $0004: Begin   { Set position }
   EmuMouseX := P.CPU.Regs.CX;
   EmuMouseY := P.CPU.Regs.DX;
   If EmuMouseX < EmuMouseXMin Then EmuMouseX := EmuMouseXMin;
   If EmuMouseX > EmuMouseXMax Then EmuMouseX := EmuMouseXMax;
   If EmuMouseY < EmuMouseYMin Then EmuMouseY := EmuMouseYMin;
   If EmuMouseY > EmuMouseYMax Then EmuMouseY := EmuMouseYMax;
  End;
  $0005: Begin   { Get button press info. BX=button (0=L 1=R 2=M) }
   BIdx := P.CPU.Regs.BX And 3;
   If BIdx > 2 Then BIdx := 2;
   P.CPU.Regs.AX := EmuMouseBtns;
   P.CPU.Regs.BX := EmuMousePressCnt[BIdx];
   P.CPU.Regs.CX := Word(EmuMousePressX[BIdx]);
   P.CPU.Regs.DX := Word(EmuMousePressY[BIdx]);
   EmuMousePressCnt[BIdx] := 0;
  End;
  $0006: Begin   { Get button release info }
   BIdx := P.CPU.Regs.BX And 3;
   If BIdx > 2 Then BIdx := 2;
   P.CPU.Regs.AX := EmuMouseBtns;
   P.CPU.Regs.BX := EmuMouseRelCnt[BIdx];
   P.CPU.Regs.CX := Word(EmuMouseRelX[BIdx]);
   P.CPU.Regs.DX := Word(EmuMouseRelY[BIdx]);
   EmuMouseRelCnt[BIdx] := 0;
  End;
  $0007: Begin   { Set X range. CX=min DX=max }
   EmuMouseXMin := P.CPU.Regs.CX;
   EmuMouseXMax := P.CPU.Regs.DX;
   If EmuMouseXMin > EmuMouseXMax Then Begin
    BIdx := EmuMouseXMin;
    EmuMouseXMin := EmuMouseXMax;
    EmuMouseXMax := BIdx;
   End;
   If EmuMouseX < EmuMouseXMin Then EmuMouseX := EmuMouseXMin;
   If EmuMouseX > EmuMouseXMax Then EmuMouseX := EmuMouseXMax;
  End;
  $0008: Begin   { Set Y range }
   EmuMouseYMin := P.CPU.Regs.CX;
   EmuMouseYMax := P.CPU.Regs.DX;
   If EmuMouseYMin > EmuMouseYMax Then Begin
    BIdx := EmuMouseYMin;
    EmuMouseYMin := EmuMouseYMax;
    EmuMouseYMax := BIdx;
   End;
   If EmuMouseY < EmuMouseYMin Then EmuMouseY := EmuMouseYMin;
   If EmuMouseY > EmuMouseYMax Then EmuMouseY := EmuMouseYMax;
  End;
  $0009: ; { Set graphics cursor (ignore) }
  $000A: ; { Set text cursor (ignore) }
  $000B: Begin   { Read motion counters }
   P.CPU.Regs.CX := Word(EmuMouseMickX);
   P.CPU.Regs.DX := Word(EmuMouseMickY);
   EmuMouseMickX := 0; EmuMouseMickY := 0;
  End;
  $000C: Begin   { Set user handler - invoque reellement par              }
                 { Emu_MouseFireEvents/Emu_MouseNextCall. }
   EmuMouseHandlerMsk := P.CPU.Regs.CX;
   EmuMouseHandlerSeg := P.CPU.Segs.ES;
   EmuMouseHandlerOfs := P.CPU.Regs.DX;
  End;
  $000D, $000E: ; { Light pen on/off (ignore) }
  $000F: Begin   { Set mickey/pixel ratio. CX=horiz DX=vert }
   If P.CPU.Regs.CX > 0 Then EmuMouseHRatio := P.CPU.Regs.CX;
   If P.CPU.Regs.DX > 0 Then EmuMouseVRatio := P.CPU.Regs.DX;
  End;
  $0010: ; { Conditional off (ignore) }
  $0011, $0012: ; { Reserve / non implante - ignore, comme une vraie        }
                  { machine sans cette fonction. }
  $0013: ; { Set max mickey speed (ignore) }
  $0014: Begin   { Swap interrupt subroutine }
   P.CPU.Regs.CX := EmuMouseHandlerMsk;
   P.CPU.Segs.ES := EmuMouseHandlerSeg;
   P.CPU.Regs.DX := EmuMouseHandlerOfs;
   EmuMouseHandlerMsk := P.CPU.Regs.CX;
  End;
  $0015: Begin   { Get save state buffer size }
   P.CPU.Regs.BX := 64;
  End;
  $0016, $0017: ; { Save / restore driver state (stubs) }
  $0018: Begin   { Set Alternate Mouse User Handler - meme mecanisme d      }
                 { invocation que le gestionnaire principal (0Ch), en plus }
                 { et non a la place (voir Emu_MouseNextCall). }
   EmuMouseAltHandlerMsk := P.CPU.Regs.CX;
   EmuMouseAltHandlerSeg := P.CPU.Segs.ES;
   EmuMouseAltHandlerOfs := P.CPU.Regs.DX;
  End;
  $0019: Begin   { Get Alternate Mouse User Handler Address }
   P.CPU.Regs.CX := EmuMouseAltHandlerMsk;
   P.CPU.Segs.ES := EmuMouseAltHandlerSeg;
   P.CPU.Regs.DX := EmuMouseAltHandlerOfs;
  End;
  $001A: Begin   { Set mouse sensitivity. BX=horiz CX=vert DX=seuil double }
                 { vitesse - bogue corrige : la version precedente          }
                 { ignorait totalement les valeurs recues. }
   If P.CPU.Regs.BX > 0 Then EmuMouseHRatio := P.CPU.Regs.BX;
   If P.CPU.Regs.CX > 0 Then EmuMouseVRatio := P.CPU.Regs.CX;
  End;
  $001B: Begin   { Get sensitivity }
   P.CPU.Regs.BX := EmuMouseHRatio;
   P.CPU.Regs.CX := EmuMouseVRatio;
   P.CPU.Regs.DX := 50;
  End;
  $001C: ; { Set mouse interrupt rate (souris serie InPort - accepte,      }
            { sans effet sur une souris PS/2 emulee) }
  $001D: EmuMouseDisplayPage := P.CPU.Regs.BX;      { Set display page }
  $001E: P.CPU.Regs.BX := EmuMouseDisplayPage;      { Get display page }
  $001F: Begin   { Disable Mouse Driver (non documente officiellement) -    }
                 { la chaine du vecteur INT 33h precedent n est pas suivie  }
                 { par cet emulateur, contrairement a un vrai pilote. }
   EmuMouseSoftDisabled := True;
   P.CPU.Regs.AX := 0;
   P.CPU.Segs.ES := 0; P.CPU.Regs.BX := 0;
  End;
  $0020: EmuMouseSoftDisabled := False; { Enable mouse driver }
  $0021: Begin   { Software reset }
   P.CPU.Regs.AX := $FFFF;
   P.CPU.Regs.BX := 3;
   EmuMouseSoftDisabled := False;
  End;
  $0022: ; { Set language for messages (accepte, aucun message texte emis  }
            { par ce pilote) }
  $0023: P.CPU.Regs.BX := 0;   { Get language number (0=anglais) }
  $0024: Begin   { Get driver version / mouse type / IRQ - reflete la       }
                 { "Version pilote" choisie dans Options > Emulateur > DOS: }
                 { Logiciel (DosMouseVersionName). }
   Case EmuMouseVersion Of
    0: P.CPU.Regs.BX := $0100;  { v1.00 }
    1: P.CPU.Regs.BX := $0300;  { v3.00 }
    2: P.CPU.Regs.BX := $0600;  { v6.00 }
   Else
    P.CPU.Regs.BX := $0800;     { v8.00 }
   End;
   P.CPU.Regs.CH := 4;         { PS/2 }
   P.CPU.Regs.CL := 0;
  End;
  $0025: ; { Get general driver info }
  $0026: Begin   { Get max virtual coords }
   P.CPU.Regs.BX := Byte(EmuMouseSoftDisabled); { 0=actif 1=desactive }
   P.CPU.Regs.CX := EmuMouseXMax;
   P.CPU.Regs.DX := EmuMouseYMax;
  End;
  $0027: Begin   { Get Screen/Cursor Mask and Mickey Counts (combine 03h+   }
                 { 0Bh) - approximation raisonnable, voir le commentaire    }
                 { pres de DosMouseVersionName. }
   P.CPU.Regs.AX := EmuMouseBtns;
   P.CPU.Regs.CX := Word(EmuMouseMickX);
   P.CPU.Regs.DX := Word(EmuMouseMickY);
   EmuMouseMickX := 0; EmuMouseMickY := 0;
  End;
 Else
  ;
 End;
End;

{ ========================================================================= }
{ Invocation reelle du/des gestionnaire(s) utilisateur INT 33h (fn 0Ch/    }
{ 18h) et du callback BIOS PS/2 (INT 15h AH=C2h fn 07h) par injection de   }
{ code invite - meme principe que l upcall du pilote de paquets (voir      }
{ Emu_PktFireAsSendUpcall/Emu_PktCont) : empiler ContSeg:ContOfs (un        }
{ trampoline prive "INT FCh", jamais rencontre par du logiciel DOS reel)    }
{ comme le ferait un vrai CALL FAR, rediriger CS:IP vers le gestionnaire    }
{ invite avec les registres d appel attendus, et laisser la boucle          }
{ d execution normale executer ce code ; le RETF final atterrit sur le      }
{ trampoline, qui repasse par Emu_DoInt (case $FC) pour enchainer sur le    }
{ prochain gestionnaire en attente ou reprendre le programme interrompu.    }
{ Un seul appel peut etre "en vol" a la fois (CS:IP est unique) : un        }
{ evenement qui survient pendant qu un appel precedent est encore en cours  }
{ est tout simplement perdu (limitation documentee, comme le Backlog        }
{ sature du pilote de paquets - voir EmuPkt.Stats.PacketsLost). }
{ ========================================================================= }

{ Demarre le "temps" de cascade correspondant a Kind (0=gestionnaire        }
{ principal 1=alternatif 2=callback BIOS PS/2) - suppose EmuMouseCallMask/  }
{ Btn/CX/DX/SI/DI deja renseignes par Emu_MouseFireEvents. }
Procedure Emu_MouseFireOne(Var P: TEmulatorPanel; Kind: Byte);
Begin
 EmuMouseCallKind := Kind;
 Emu_PushWord(P.CPU, EmuMouseContSeg);
 Emu_PushWord(P.CPU, EmuMouseContOfs);
 Case Kind Of
  0, 1: Begin
   P.CPU.Regs.AX := EmuMouseCallMask;
   P.CPU.Regs.BX := EmuMouseCallBtn;
   P.CPU.Regs.CX := EmuMouseCallCX;
   P.CPU.Regs.DX := EmuMouseCallDX;
   P.CPU.Regs.SI := EmuMouseCallSI;
   P.CPU.Regs.DI := EmuMouseCallDI;
   If Kind = 0 Then Begin
    P.CPU.Segs.CS := EmuMouseHandlerSeg; P.CPU.IP := EmuMouseHandlerOfs;
   End Else Begin
    P.CPU.Segs.CS := EmuMouseAltHandlerSeg; P.CPU.IP := EmuMouseAltHandlerOfs;
   End;
  End;
  2: Begin
   { Convention du callback BIOS PS/2 (fn 07h) d apres la documentation la  }
   { plus repandue (AL=octet d etat, BX=delta X, CX=delta Y, DX=reserve) -  }
   { voir le commentaire pres de Emu_DoInt15C2 pour la reserve de confiance }
   { sur cette convention precise. }
   P.CPU.Regs.AL := EmuMouseCallBtn;
   P.CPU.Regs.BX := EmuMouseCallSI; { delta X }
   P.CPU.Regs.CX := EmuMouseCallDI; { delta Y }
   P.CPU.Regs.DX := 0;
   P.CPU.Segs.CS := EmuMouseBiosCallbackSeg; P.CPU.IP := EmuMouseBiosCallbackOfs;
  End;
 End;
End;

{ Determine et demarre le prochain "temps" de la cascade (ou la termine et }
{ restaure CS:IP si plus rien a appeler) - appelee au demarrage            }
{ (Emu_MouseFireEvents) et a chaque retour de gestionnaire (Emu_MouseCont).}
Procedure Emu_MouseNextCall(Var P: TEmulatorPanel);
Begin
 If (Not EmuMouseCallPrimDone) And
    ((EmuMouseHandlerMsk And EmuMouseCallMask) <> 0) Then Begin
  EmuMouseCallPrimDone := True;
  Emu_MouseFireOne(P, 0);
  Exit;
 End;
 EmuMouseCallPrimDone := True;
 If (Not EmuMouseCallAltDone) And
    ((EmuMouseAltHandlerMsk And EmuMouseCallMask) <> 0) Then Begin
  EmuMouseCallAltDone := True;
  Emu_MouseFireOne(P, 1);
  Exit;
 End;
 EmuMouseCallAltDone := True;
 If (Not EmuMouseCallBiosDone) And EmuMouseBiosEnabled And
    (EmuMouseBiosCallbackSeg <> 0) Then Begin
  EmuMouseCallBiosDone := True;
  Emu_MouseFireOne(P, 2);
  Exit;
 End;
 { Plus rien a appeler : reprendre le programme interrompu. }
 P.CPU.Segs.CS := EmuMouseCallSavedCS;
 P.CPU.IP := EmuMouseCallSavedIP;
 EmuMouseCallPending := False;
End;

{ Point d entree appele par EmuMouse_UpdateFromHost a chaque evenement      }
{ souris (mouvement et/ou changement de bouton) - Mask = bits de condition  }
{ (bit0=mouvement, bit1/2=bouton gauche presse/relache, bit3/4=droit,       }
{ bit5/6=milieu, meme codage que le masice d appel fn 0Ch/18h). }
Procedure Emu_MouseFireEvents(Var P: TEmulatorPanel; Mask: Word;
 CX_, DX_, SI_, DI_: Word);
Begin
 If Mask = 0 Then Exit;
 If EmuMouseCallPending Then Exit; { appel deja en cours - evenement perdu,  }
                                    { voir le commentaire d en-tete de       }
                                    { section. }
 EmuMouseCallMask := Mask;
 EmuMouseCallBtn  := EmuMouseBtns;
 EmuMouseCallCX := CX_; EmuMouseCallDX := DX_;
 EmuMouseCallSI := SI_; EmuMouseCallDI := DI_;
 EmuMouseCallPrimDone := False;
 EmuMouseCallAltDone  := False;
 EmuMouseCallBiosDone := False;
 EmuMouseCallSavedCS := P.CPU.Segs.CS;
 EmuMouseCallSavedIP := P.CPU.IP;
 EmuMouseCallPending := True;
 Emu_MouseNextCall(P);
End;

{ Gestionnaire du point de retour interne (INT FCh) : execute uniquement    }
{ parce qu un RETF invite vient de "revenir" sur ce trampoline apres que    }
{ Emu_MouseFireOne a redirige le CPU emule vers du code invite - voir l en- }
{ tete de section pour la justification de ce mecanisme. }
Procedure Emu_MouseCont(Var P: TEmulatorPanel);
Begin
 If Not EmuMouseCallPending Then Exit; { securite, ne devrait pas arriver }
 Emu_MouseNextCall(P);
End;

{ Reinitialise le pilote souris et, si la case "Souris" est cochee,        }
{ installe le trampoline d upcall interne (voir Emu_MouseFireOne). Appelee }
{ a chaque (re)demarrage de l emulateur, comme                             }
{ Emu_IpxInit/Emu_PktInit/Emu_XmsInit/Emu_EmsInit. }
Procedure Emu_MouseInit(Var P: TEmulatorPanel);
Var BIdx: Integer;
Begin
 EmuMouseActive := OptionsDlg.Data.DosSouris;
 EmuMousePS2Active := OptionsDlg.Data.DosMousePS2BIOS;
 EmuMouseVendor := Byte(OptionsDlg.Data.DosMouseVendor);
 EmuMouseVersion := Byte(OptionsDlg.Data.DosMouseVersion);
 EmuMouseInst := EmuMouseActive;
 EmuMouseVis := -1;
 EmuMouseX := 0; EmuMouseY := 0;
 EmuMouseBtns := 0;
 EmuMouseXMin := 0; EmuMouseYMin := 0;
 EmuMouseXMax := 639; EmuMouseYMax := 199;
 EmuMouseHRatio := 8; EmuMouseVRatio := 16;
 EmuMouseMickX := 0; EmuMouseMickY := 0;
 EmuMouseHandlerMsk := 0;
 EmuMouseHandlerSeg := 0; EmuMouseHandlerOfs := 0;
 EmuMouseAltHandlerMsk := 0;
 EmuMouseAltHandlerSeg := 0; EmuMouseAltHandlerOfs := 0;
 EmuMouseDisplayPage := 0;
 EmuMouseSoftDisabled := False;
 For BIdx := 0 To 2 Do Begin
  EmuMousePressCnt[BIdx] := 0; EmuMouseRelCnt[BIdx] := 0;
  EmuMousePressX[BIdx] := 0;   EmuMousePressY[BIdx] := 0;
  EmuMouseRelX[BIdx]   := 0;   EmuMouseRelY[BIdx]   := 0;
 End;
 EmuMouseBiosEnabled := False;
 EmuMouseBiosCallbackSeg := 0; EmuMouseBiosCallbackOfs := 0;
 EmuMouseBiosSampleRate := 3;  { 100 echantillons/s, valeur par defaut reelle}
 EmuMouseBiosResolution := 2;  { 4 comptes/mm, valeur par defaut reelle }
 EmuMouseCallPending := False;
 If Not EmuMouseActive Then Exit;
 EmuMouseContSeg := EMU_MOUSE_STUB_SEG; EmuMouseContOfs := EMU_MOUSE_STUB_OFS;
 { Trampoline de continuation interne : INT FCh, jamais rencontre par du    }
 { logiciel DOS reel - voir Emu_MouseCont. }
 Emu_WriteByte(P.CPU, EmuMouseContSeg, EmuMouseContOfs,     $CD);
 Emu_WriteByte(P.CPU, EmuMouseContSeg, EmuMouseContOfs + 1, $FC);
End;

{ ========================================================================= }
{ INT 15h AH=C2h : interface BIOS PS/2 du pointeur (Pointing Device BIOS   }
{ Interface), gatee par la case "Souris BIOS PS/2" (voir Emu_DoInt et       }
{ EmuMousePS2Active). Sous-fonctions AL=00h-07h implantees d apres la       }
{ documentation la plus repandue (Ralph Brown Interrupt List) ; la          }
{ convention exacte des registres du callback installe par AL=07h (utilisee}
{ ici : AL=octet d etat, BX=delta X, CX=delta Y, DX=reserve/0) est celle    }
{ la plus couramment documentee mais n a pas pu etre recoupee avec          }
{ plusieurs sources primaires independantes lors de la recherche - a        }
{ traiter comme une approximation raisonnable plutot qu une certitude       }
{ absolue, contrairement au reste de cette section (voir Emu_MouseFireOne   }
{ pour le point d injection reel). }
{ ========================================================================= }
{ ========================================================================= }
{ IBM TopView (Options > Emulateur > DOS: OS > TopView) - INT 15h AH=10h/   }
{ 11h/12h. Voir DOC/TOPVIEW_PROGRAMMING.txt et le commentaire de perimetre  }
{ pres de TVOT_WINDOW (TEmuVideoState/etc, ~ligne 3525) : cet emulateur est }
{ MONO-TACHE (un seul contexte CPU 8086) - le modele d objets TopView est   }
{ implante REELLEMENT, mais la multitache preemptive/cooperative et le      }
{ remappage IRQ (INT 50h-57h) sont HORS PERIMETRE, aucune tache concurrente }
{ n existe a proteger.                                                      }
{                                                                            }
{ Convention d appel AH=12h (messages/objets) : le document precise         }
{ lui-meme que le nettoyage de pile DWORD "varie" et recommande un wrapper  }
{ assembleur dedie meme pour du code TopView natif - plutot que de deviner  }
{ un ordre de pile non verifie, cette implementation utilise une convention }
{ REGISTRE simple et coherente (BH=verbe, BL=selecteur de cible comme       }
{ documente, ES=segment de poignee quand BL=00h, CX/DX/DS:SI/ES:DI pour les }
{ parametres/resultats selon le verbe - documente au cas par cas ci-dessous)}
{ plutot qu une reproduction bit-a-bit d un format de pile non specifie.    }
{ ========================================================================= }

Function Emu_Tv_HandleSeg(Slot: Integer): Word;
Begin
 Emu_Tv_HandleSeg := EMU_TV_HANDLE_SEG_BASE + Word(Slot);
End;

Function Emu_Tv_SlotFromSeg(Seg: Word): Integer;
Var Slot: Integer;
Begin
 Emu_Tv_SlotFromSeg := -1;
 If (Seg < EMU_TV_HANDLE_SEG_BASE) Or (Seg >= EMU_TV_HANDLE_SEG_BASE + TV_MAX_OBJECTS) Then Exit;
 Slot := Seg - EMU_TV_HANDLE_SEG_BASE;
 If EmuTvObjType[Slot] = TVOT_FREE Then Exit;
 Emu_Tv_SlotFromSeg := Slot;
End;

Function Emu_Tv_AllocSlot: Integer;
Var I: Integer;
Begin
 Emu_Tv_AllocSlot := -1;
 For I := 0 To TV_MAX_OBJECTS - 1 Do
  If EmuTvObjType[I] = TVOT_FREE Then Begin
   Emu_Tv_AllocSlot := I;
   Exit;
  End;
End;

Function Emu_Tv_AllocWinBuf: Integer;
Var I: Integer;
Begin
 Emu_Tv_AllocWinBuf := -1;
 For I := 0 To TV_MAX_WINDOWS - 1 Do
  If Not EmuTvWinBufUsed[I] Then Begin
   EmuTvWinBufUsed[I] := True;
   Emu_Tv_AllocWinBuf := I;
   Exit;
  End;
End;

Function Emu_Tv_WinBufOfs(Idx: Integer): Word;
Begin
 Emu_Tv_WinBufOfs := EMU_TV_WINBUF_OFS + Word(Idx) * TV_WINBUF_SIZE;
End;

{ --- Tas GETMEM/PUTMEM (1001h/1002h) : liste libre simple, en-tete 4o par }
{ bloc (Taille utile:Word, Libre 0/1:Word), fusion avec le bloc suivant a   }
{ la liberation. }
Procedure Emu_Tv_HeapInit(Var P: TEmulatorPanel);
Begin
 Emu_WriteWord(P.CPU, EMU_TV_SEG, EMU_TV_HEAP_OFS, TV_HEAP_SIZE - 4);
 Emu_WriteWord(P.CPU, EMU_TV_SEG, EMU_TV_HEAP_OFS + 2, 1);
End;

Function Emu_Tv_HeapAlloc(Var P: TEmulatorPanel; Bytes: Word; Var OutSeg, OutOfs: Word): Boolean;
Var Cur, BlkSize, Free, Remain: Word;
Begin
 Emu_Tv_HeapAlloc := False;
 OutSeg := 0; OutOfs := 0;
 If Bytes = 0 Then Bytes := 1;
 Cur := EMU_TV_HEAP_OFS;
 While Cur < EMU_TV_HEAP_OFS + TV_HEAP_SIZE Do Begin
  BlkSize := Emu_ReadWord(P.CPU, EMU_TV_SEG, Cur);
  Free := Emu_ReadWord(P.CPU, EMU_TV_SEG, Cur + 2);
  If (Free = 1) And (BlkSize >= Bytes) Then Begin
   If BlkSize >= LongInt(Bytes) + 4 + 1 Then Begin
    Remain := BlkSize - Bytes - 4;
    Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur + 4 + Bytes, Remain);
    Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur + 4 + Bytes + 2, 1);
    Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur, Bytes);
   End;
   Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur + 2, 0);
   OutSeg := EMU_TV_SEG; OutOfs := Cur + 4;
   Emu_Tv_HeapAlloc := True;
   Exit;
  End;
  Cur := Cur + 4 + BlkSize;
 End;
End;

Procedure Emu_Tv_HeapFree(Var P: TEmulatorPanel; Seg, Ofs: Word);
Var Cur, BlkSize, NextSize, NextFree: Word;
Begin
 If (Seg <> EMU_TV_SEG) Or (Ofs < EMU_TV_HEAP_OFS + 4) Then Exit;
 Cur := Ofs - 4;
 If (Cur < EMU_TV_HEAP_OFS) Or (Cur >= EMU_TV_HEAP_OFS + TV_HEAP_SIZE) Then Exit;
 Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur + 2, 1);
 BlkSize := Emu_ReadWord(P.CPU, EMU_TV_SEG, Cur);
 If Cur + 4 + BlkSize < EMU_TV_HEAP_OFS + TV_HEAP_SIZE Then Begin
  NextSize := Emu_ReadWord(P.CPU, EMU_TV_SEG, Cur + 4 + BlkSize);
  NextFree := Emu_ReadWord(P.CPU, EMU_TV_SEG, Cur + 4 + BlkSize + 2);
  If NextFree = 1 Then
   Emu_WriteWord(P.CPU, EMU_TV_SEG, Cur, BlkSize + 4 + NextSize);
 End;
End;

{ --- Injection d appel FAR "propre" (empile CS:IP courant, saute a la     }
{ cible) - PAS de fanions empiles, la cible doit finir par RETF (voir       }
{ GETBIT/PGMINT dans le document, contrairement a un vecteur d IRQ reel qui }
{ termine par IRET). Reutilisee par le service GETBIT/SETBIT et par PGMINT.}
Procedure Emu_Tv_FarCallInject(Var P: TEmulatorPanel; TargetSeg, TargetOfs: Word);
Begin
 Emu_PushWord(P.CPU, P.CPU.Segs.CS);
 Emu_PushWord(P.CPU, P.CPU.IP);
 P.CPU.Segs.CS := TargetSeg;
 P.CPU.IP := TargetOfs;
End;

{ Sert au plus UN bit arme par pas CPU (comme Emu_ServiceIrqs) - jamais    }
{ pendant une region critique BEGINC/ENDC. }
Procedure Emu_Tv_ServiceBits(Var P: TEmulatorPanel);
Var B, TargetSlot: Integer;
Begin
 If EmuTvCritical Or (EmuTvBitPending = 0) Then Exit;
 B := 0;
 While (B < TV_MAX_BITS) And ((EmuTvBitPending And (Word(1) Shl B)) = 0) Do Inc(B);
 If B >= TV_MAX_BITS Then Exit;
 EmuTvBitPending := EmuTvBitPending And Not (Word(1) Shl B);
 If Not EmuTvBitUsed[B] Then Exit;
 If EmuTvDefWindow >= 0 Then TargetSlot := EmuTvDefWindow
 Else If EmuTvDefObjectQ >= 0 Then TargetSlot := EmuTvDefObjectQ
 Else TargetSlot := -1;
 If TargetSlot >= 0 Then P.CPU.Segs.ES := Emu_Tv_HandleSeg(TargetSlot)
 Else P.CPU.Segs.ES := EMU_TV_SEG;
 Emu_Tv_FarCallInject(P, EmuTvBitSeg[B], EmuTvBitOfs[B]);
End;

{ PGMINT (1021h) : file LIFO, servie au plus une injection par pas CPU. }
Procedure Emu_Tv_ServiceInjects(Var P: TEmulatorPanel);
Begin
 If EmuTvCritical Or (EmuTvInjectCount <= 0) Then Exit;
 Dec(EmuTvInjectCount);
 Emu_Tv_FarCallInject(P, EmuTvInjectSeg[EmuTvInjectCount], EmuTvInjectOfs[EmuTvInjectCount]);
End;

{ SOUND (1019h) : etat REEL du haut-parleur (EmuPPI.PortB bits 0-1, voir   }
{ Emu_PPI_ReadB) - aucune sortie audio hote n existe dans cet emulateur,   }
{ mais un logiciel qui relit le port 61h apres un SOUND voit un etat       }
{ coherent avec une vraie carte mere. }
Procedure Emu_Tv_ApplySound(Hz: Word);
Begin
 If Hz = 0 Then
  EmuPPI.PortB := EmuPPI.PortB And Not Byte($03)
 Else
  EmuPPI.PortB := EmuPPI.PortB Or $03;
End;

Procedure Emu_Tv_Sound(Hz, Ticks: Word);
Begin
 If (Hz = 0) And (Ticks = 0) Then Begin
  EmuTvSoundCount := 0;
  EmuTvSoundActiveTicks := 0;
  Emu_Tv_ApplySound(0);
  Exit;
 End;
 If Ticks = 0 Then Begin
  EmuTvSoundActiveTicks := 0; { annule la note en cours, la file avance au prochain tick }
  Exit;
 End;
 If EmuTvSoundActiveTicks = 0 Then Begin
  Emu_Tv_ApplySound(Hz);
  EmuTvSoundActiveTicks := Ticks;
 End Else If EmuTvSoundCount < TV_MAX_SOUNDS Then Begin
  EmuTvSoundHz[EmuTvSoundCount] := Hz;
  EmuTvSoundTicks[EmuTvSoundCount] := Ticks;
  Inc(EmuTvSoundCount);
 End;
End;

{ Appelee depuis Emu_TimerTick (tops BIOS 18,2 Hz, voir Emu_Tv_ServiceTimers}
{ ci-dessous pour le meme point d ancrage) - avance la file SOUND. }
Procedure Emu_Tv_ServiceSound;
Var I: Integer;
Begin
 If EmuTvSoundActiveTicks = 0 Then Exit;
 Dec(EmuTvSoundActiveTicks);
 If EmuTvSoundActiveTicks > 0 Then Exit;
 Emu_Tv_ApplySound(0);
 If EmuTvSoundCount > 0 Then Begin
  Emu_Tv_ApplySound(EmuTvSoundHz[0]);
  EmuTvSoundActiveTicks := EmuTvSoundTicks[0];
  For I := 0 To EmuTvSoundCount - 2 Do Begin
   EmuTvSoundHz[I] := EmuTvSoundHz[I + 1];
   EmuTvSoundTicks[I] := EmuTvSoundTicks[I + 1];
  End;
  Dec(EmuTvSoundCount);
 End;
End;

{ TIMER (1er type NEW BL=0Bh) : pas de 10 ms reel approxime a 5 centiemes  }
{ par tick BIOS 18,2 Hz (~5,49 exacts) - assez precis pour un compteur     }
{ applicatif, documente comme approximation plutot que suppose exact. }
Procedure Emu_Tv_ServiceTimers;
Var I: Integer;
Begin
 For I := 0 To TV_MAX_OBJECTS - 1 Do
  If (EmuTvObjType[I] = TVOT_TIMER) And EmuTvTimer[I].Running Then
   Inc(EmuTvTimer[I].ExpiryCenti, 5);
End;

{ Ecrit un caractere+attribut dans le tampon virtuel d une fenetre et      }
{ avance le curseur logique (repli simple en debut de zone en bout de      }
{ fenetre - pas de vrai defilement, voir le commentaire de perimetre). }
Procedure Emu_Tv_WindowPutChar(Var P: TEmulatorPanel; Slot: Integer; Ch, Attr: Byte);
Var Seg, Ofs, CellOfs: Word;
Begin
 If EmuTvWindow[Slot].WinBufIdx < 0 Then Exit;
 Seg := EMU_TV_SEG;
 Ofs := Emu_Tv_WinBufOfs(EmuTvWindow[Slot].WinBufIdx);
 CellOfs := (EmuTvWindow[Slot].CursorY * EmuTvWindow[Slot].Cols + EmuTvWindow[Slot].CursorX) * 2;
 If LongInt(CellOfs) + 1 < TV_WINBUF_SIZE Then Begin
  Emu_WriteByte(P.CPU, Seg, Ofs + CellOfs, Ch);
  Emu_WriteByte(P.CPU, Seg, Ofs + CellOfs + 1, Attr);
 End;
 Inc(EmuTvWindow[Slot].CursorX);
 If EmuTvWindow[Slot].CursorX >= EmuTvWindow[Slot].Cols Then Begin
  EmuTvWindow[Slot].CursorX := 0;
  Inc(EmuTvWindow[Slot].CursorY);
  If EmuTvWindow[Slot].CursorY >= EmuTvWindow[Slot].Rows Then EmuTvWindow[Slot].CursorY := 0;
 End;
End;

{ Curseur logique de l "ecran par defaut" (DX non reconnu comme une        }
{ fenetre TopView dans PRINTC) - ecrit directement dans la VRAM texte      }
{ reelle B800:0000, comme un vrai TopView non-fenetre le ferait pour le    }
{ moniteur physique. }
Procedure Emu_Tv_ScreenPutChar(Var P: TEmulatorPanel; Ch, Attr: Byte);
Var CellOfs: Word;
Begin
 CellOfs := (EmuTvDefCursorY * 80 + EmuTvDefCursorX) * 2;
 Emu_WriteByte(P.CPU, $B800, CellOfs, Ch);
 Emu_WriteByte(P.CPU, $B800, CellOfs + 1, Attr);
 Inc(EmuTvDefCursorX);
 If EmuTvDefCursorX >= 80 Then Begin
  EmuTvDefCursorX := 0;
  Inc(EmuTvDefCursorY);
  If EmuTvDefCursorY >= 25 Then EmuTvDefCursorY := 0;
 End;
End;

{ Reinitialise tout l etat TopView - appelee depuis Emu_InitBDA. L etat    }
{ materiel volatil (comme le reste de cette famille de sous-systemes,      }
{ EmuPPI/EmuNE2000/etc) est remis a neuf a chaque session DOS. }
Procedure Emu_Tv_Init(Var P: TEmulatorPanel);
Var I: Integer;
Begin
 For I := 0 To TV_MAX_OBJECTS - 1 Do EmuTvObjType[I] := TVOT_FREE;
 For I := 0 To TV_MAX_WINDOWS - 1 Do EmuTvWinBufUsed[I] := False;
 EmuTvDefWindow := -1; EmuTvDefMailbox := -1; EmuTvDefKeyboard := -1; EmuTvDefObjectQ := -1;
 For I := 0 To TV_MAX_BITS - 1 Do Begin
  EmuTvBitUsed[I] := False; EmuTvBitSeg[I] := 0; EmuTvBitOfs[I] := 0;
 End;
 EmuTvBitPending := 0;
 EmuTvInjectCount := 0;
 EmuTvSoundCount := 0;
 EmuTvSoundActiveTicks := 0;
 EmuTvSavedSS := 0; EmuTvSavedSP := 0; EmuTvOnPrivStack := False;
 EmuTvCritical := False;
 EmuTvTaskStopped := False;
 EmuTvDefCursorX := 0; EmuTvDefCursorY := 0;
 If OptionsDlg.Data.DosTopView Then Begin
  Emu_Tv_HeapInit(P);
  { Un OBJECTQ est toujours associe a la tache courante dans un vrai       }
  { environnement TopView - cree implicitement des l activation. }
  EmuTvDefObjectQ := Emu_Tv_AllocSlot;
  If EmuTvDefObjectQ >= 0 Then EmuTvObjType[EmuTvDefObjectQ] := TVOT_OBJECTQ;
 End;
End;

{ Cree un objet (BH=01h NEW, BL=classe) - convention registre propre a      }
{ cette implementation (voir le grand commentaire d en-tete de section) :   }
{ WINDOW(08h) CX=colonnes,DX=lignes,ES:DI=titre ASCIIZ,SI bit0=indicateur   }
{ tache ; MAILBOX(09h)/KEYBOARD(0Ah)/TIMER(0Bh)/POINTER(0Fh) sans parametre;}
{ PANEL(10h) ES:DI=nom de fichier ASCIIZ. Resultat : BX=segment de la       }
{ nouvelle poignee (0 et CF si echec - table pleine ou pool de tampons      }
{ fenetre epuise). }
Procedure Emu_Tv_HandleNew(Var P: TEmulatorPanel);
Var
 Slot, WinBuf, I: Integer;
 TitleStr, FileStr: String;
 Ch: Byte;
 ReqClass: Byte;
Begin
 { IMPORTANT : capturer BL AVANT d ecrire BX=0 ci-dessous - BX et BL/BH     }
 { partagent le meme octet en memoire (TEmuRegs est un enregistrement      }
 { variant, voir sa declaration), donc "P.CPU.Regs.BX := 0" ecrase aussi   }
 { silencieusement BL. Bogue reel trouve en testant NEW WINDOW (BL         }
 { toujours lu comme 0 malgre un appelant qui le programmait a 08h). }
 ReqClass := P.CPU.Regs.BL;
 P.CPU.Regs.BX := 0;
 Case ReqClass Of
  $08: Begin { WINDOW }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   WinBuf := Emu_Tv_AllocWinBuf;
   If WinBuf < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   TitleStr := '';
   I := 0;
   While I < 63 Do Begin
    Ch := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + I);
    If Ch = 0 Then Break;
    TitleStr := TitleStr + Chr(Ch);
    Inc(I);
   End;
   FillChar(EmuTvWindow[Slot], SizeOf(EmuTvWindow[Slot]), 0);
   EmuTvObjType[Slot] := TVOT_WINDOW;
   EmuTvWindow[Slot].Cols := P.CPU.Regs.CX;
   If EmuTvWindow[Slot].Cols = 0 Then EmuTvWindow[Slot].Cols := 80;
   If EmuTvWindow[Slot].Cols > 80 Then EmuTvWindow[Slot].Cols := 80;
   EmuTvWindow[Slot].Rows := P.CPU.Regs.DX;
   If EmuTvWindow[Slot].Rows = 0 Then EmuTvWindow[Slot].Rows := 25;
   If EmuTvWindow[Slot].Rows > 25 Then EmuTvWindow[Slot].Rows := 25;
   EmuTvWindow[Slot].Title := TitleStr;
   EmuTvWindow[Slot].WinBufIdx := WinBuf;
   EmuTvWindow[Slot].IsTask := (P.CPU.Regs.SI And 1) <> 0;
   EmuTvWindow[Slot].KbdSlot := -1;
   EmuTvWindow[Slot].PtrSlot := -1;
   For I := 0 To TV_WINBUF_SIZE - 1 Do
    Emu_WriteByte(P.CPU, EMU_TV_SEG, Emu_Tv_WinBufOfs(WinBuf) + I, 0);
   If EmuTvDefWindow < 0 Then EmuTvDefWindow := Slot;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
  $09: Begin { MAILBOX }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   EmuTvObjType[Slot] := TVOT_MAILBOX;
   FillChar(EmuTvMailbox[Slot], SizeOf(EmuTvMailbox[Slot]), 0);
   If EmuTvDefMailbox < 0 Then EmuTvDefMailbox := Slot;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
  $0A: Begin { KEYBOARD }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   EmuTvObjType[Slot] := TVOT_KEYBOARD;
   EmuTvKeyboard[Slot].BoundWindow := -1;
   If EmuTvDefKeyboard < 0 Then EmuTvDefKeyboard := Slot;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
  $0B: Begin { TIMER }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   EmuTvObjType[Slot] := TVOT_TIMER;
   EmuTvTimer[Slot].ExpiryCenti := 0;
   EmuTvTimer[Slot].Running := False;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
  $0F: Begin { POINTER }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   EmuTvObjType[Slot] := TVOT_POINTER;
   EmuTvPointer[Slot].BoundWindow := -1;
   EmuTvPointer[Slot].ScaleX := 8; EmuTvPointer[Slot].ScaleY := 16;
   EmuTvPointer[Slot].Icon := 0;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
  $10: Begin { PANEL }
   Slot := Emu_Tv_AllocSlot;
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   EmuTvObjType[Slot] := TVOT_PANEL;
   FileStr := '';
   I := 0;
   While I < 79 Do Begin
    Ch := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + I);
    If Ch = 0 Then Break;
    FileStr := FileStr + Chr(Ch);
    Inc(I);
   End;
   EmuTvPanel[Slot].FileName := FileStr;
   P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot);
  End;
 Else
  Include(P.CPU.Flags.s, EFG_CF);
 End;
End;

Procedure Emu_Tv_HandleFree(Var P: TEmulatorPanel; Slot: Integer);
Begin
 If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
 Case EmuTvObjType[Slot] Of
  TVOT_WINDOW: Begin
   If EmuTvWindow[Slot].WinBufIdx >= 0 Then EmuTvWinBufUsed[EmuTvWindow[Slot].WinBufIdx] := False;
   If EmuTvDefWindow = Slot Then EmuTvDefWindow := -1;
  End;
  TVOT_MAILBOX: If EmuTvDefMailbox = Slot Then EmuTvDefMailbox := -1;
  TVOT_KEYBOARD: If EmuTvDefKeyboard = Slot Then EmuTvDefKeyboard := -1;
  TVOT_OBJECTQ: If EmuTvDefObjectQ = Slot Then EmuTvDefObjectQ := -1;
 End;
 EmuTvObjType[Slot] := TVOT_FREE;
End;

{ Vrai si une touche est disponible pour un objet KEYBOARD TopView -       }
{ tampon BIOS (0040:001A/001C) prioritaire, meme ordre que Emu_DoInt16      }
{ AH=00h/10h, PUIS la file hote brute EmuVScr en repli (voir le             }
{ commentaire de Emu_Tv_KeyboardRead pour pourquoi l ordre inverse ferait   }
{ perdre la course au drainage par tick de StepEmulator). }
Function Emu_Tv_KeyAvail(Var P: TEmulatorPanel): Boolean;
Begin
 Emu_Tv_KeyAvail := Emu_BiosHasKey(P) Or EmuVScr_HasKey(P);
End;

{ Resout l objet cible d un message AH=12h d apres BL (voir la table       }
{ HANDLE section 5 du document) : 00h=poignee dans ES, 01h/03h/05h/07h=     }
{ objet par defaut de l unique tache emulee (fenetre/boite/clavier/OBJECTQ).}
Function Emu_Tv_TargetSlot(Var P: TEmulatorPanel): Integer;
Begin
 Case P.CPU.Regs.BL Of
  $00: Emu_Tv_TargetSlot := Emu_Tv_SlotFromSeg(P.CPU.Segs.ES);
  $01: Emu_Tv_TargetSlot := EmuTvDefWindow;
  $03: Emu_Tv_TargetSlot := EmuTvDefMailbox;
  $05: Emu_Tv_TargetSlot := EmuTvDefKeyboard;
  $07: Emu_Tv_TargetSlot := EmuTvDefObjectQ;
 Else
  Emu_Tv_TargetSlot := -1;
 End;
End;

{ INT 15h AH=12h : messages/objets (voir la table de verbes BH section 5   }
{ du document, et le commentaire d en-tete sur la convention registre      }
{ utilisee ici plutot que le format de pile DWORD non totalement specifie).}
Procedure Emu_DoInt15Tv12(Var P: TEmulatorPanel);
Var
 Slot, I, N: Integer;
 Ch, Attr: Byte;
Begin
 Exclude(P.CPU.Flags.s, EFG_CF);
 Case P.CPU.Regs.BH Of
  $00: Begin { HANDLE }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot >= 0 Then P.CPU.Regs.BX := Emu_Tv_HandleSeg(Slot)
   Else Begin P.CPU.Regs.BX := 0; Include(P.CPU.Flags.s, EFG_CF); End;
  End;
  $01: Emu_Tv_HandleNew(P);
  $02: Emu_Tv_HandleFree(P, Emu_Tv_TargetSlot(P));
  $03: Begin { ADDR (mailbox) / DIR (panel - meme numero de verbe, voir BX=0300h) }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: P.CPU.Regs.BX := EmuTvMailbox[Slot].LastSenderSeg;
    TVOT_PANEL: Begin
     P.CPU.Regs.CX := 0; { liste toujours vide, voir le commentaire de TTvPanel }
     P.CPU.Segs.ES := 0; P.CPU.Regs.DI := 0;
    End;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $04: Begin { READ }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: Begin
     If EmuTvMailbox[Slot].Count = 0 Then
      Include(P.CPU.Flags.s, EFG_CF)
     Else Begin
      P.CPU.Regs.AL := EmuTvMailbox[Slot].Data[EmuTvMailbox[Slot].Head];
      EmuTvMailbox[Slot].Head := (EmuTvMailbox[Slot].Head + 1) Mod 256;
      Dec(EmuTvMailbox[Slot].Count);
     End;
    End;
    TVOT_KEYBOARD: Begin
     { Tampon BIOS (0040:001A/001C) prioritaire, meme ordre que Emu_DoInt16 }
     { AH=00h/10h - PAS la file hote brute EmuVScr, deja videe vers ce      }
     { tampon a chaque tick BIOS (voir StepEmulator) : la lire directement  }
     { ferait perdre la course a ce drainage et ne verrait jamais rien.     }
     If Emu_BiosHasKey(P) Then Begin
      N := Emu_BiosPopKey(P);
      P.CPU.Regs.AL := Lo(N); P.CPU.Regs.AH := Hi(N);
     End Else If EmuVScr_HasKey(P) Then Begin
      N := EmuVScr_PopKey(P);
      P.CPU.Regs.AL := Lo(N); P.CPU.Regs.AH := Hi(N);
     End Else
      Include(P.CPU.Flags.s, EFG_CF);
    End;
    TVOT_TIMER: Begin
     P.CPU.Regs.AX := Word(EmuTvTimer[Slot].ExpiryCenti);
     P.CPU.Regs.DX := Word(EmuTvTimer[Slot].ExpiryCenti Shr 16);
    End;
    TVOT_POINTER: Begin
     P.CPU.Regs.CX := Word(EmuMouseX); P.CPU.Regs.DX := Word(EmuMouseY);
     P.CPU.Regs.AL := EmuMouseBtns;
    End;
    TVOT_OBJECTQ: Begin
     { Simplifie (voir le commentaire de perimetre) : verifie clavier puis }
     { boites aux lettres, renvoie la premiere avec activite - un vrai     }
     { OBJECTQ multitache attendrait, ici l appel revient immediatement.   }
     N := -1;
     If (EmuTvDefKeyboard >= 0) And Emu_Tv_KeyAvail(P) Then N := EmuTvDefKeyboard
     Else Begin
      I := 0;
      While (I < TV_MAX_OBJECTS) And (N < 0) Do Begin
       If (EmuTvObjType[I] = TVOT_MAILBOX) And (EmuTvMailbox[I].Count > 0) Then N := I;
       Inc(I);
      End;
     End;
     If N >= 0 Then P.CPU.Regs.BX := Emu_Tv_HandleSeg(N)
     Else Begin P.CPU.Regs.BX := 0; Include(P.CPU.Flags.s, EFG_CF); End;
    End;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $05: Begin { WRITE }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: Begin
     N := P.CPU.Regs.CX;
     For I := 0 To N - 1 Do Begin
      If EmuTvMailbox[Slot].Count >= 256 Then Break;
      Ch := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + I);
      EmuTvMailbox[Slot].Data[EmuTvMailbox[Slot].Tail] := Ch;
      EmuTvMailbox[Slot].Tail := (EmuTvMailbox[Slot].Tail + 1) Mod 256;
      Inc(EmuTvMailbox[Slot].Count);
     End;
     EmuTvMailbox[Slot].LastSenderSeg := EMU_TV_SEG;
    End;
    TVOT_WINDOW: Begin
     N := P.CPU.Regs.CX;
     Attr := P.CPU.Regs.DL;
     For I := 0 To N - 1 Do Begin
      Ch := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + I);
      Emu_Tv_WindowPutChar(P, Slot, Ch, Attr);
     End;
    End;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $08: Begin { SIZEOF }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: P.CPU.Regs.AX := 256;
    TVOT_WINDOW: P.CPU.Regs.AX := EmuTvWindow[Slot].Cols * EmuTvWindow[Slot].Rows;
   Else
    P.CPU.Regs.AX := 0;
   End;
  End;
  $09: Begin { LEN }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   If EmuTvObjType[Slot] = TVOT_MAILBOX Then P.CPU.Regs.AX := EmuTvMailbox[Slot].Count
   Else P.CPU.Regs.AX := 0;
  End;
  $0A: Begin { ADDTO : ecriture avec attribut dans une fenetre (DS:SI,CX=longueur,DL=attribut) }
   Slot := Emu_Tv_TargetSlot(P);
   If (Slot < 0) Or (EmuTvObjType[Slot] <> TVOT_WINDOW) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); Exit;
   End;
   N := P.CPU.Regs.CX;
   Attr := P.CPU.Regs.DL;
   For I := 0 To N - 1 Do Begin
    Ch := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, P.CPU.Regs.SI + I);
    Emu_Tv_WindowPutChar(P, Slot, Ch, Attr);
   End;
  End;
  $0C: Begin { OPEN : DX=segment de la fenetre a associer }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   N := Emu_Tv_SlotFromSeg(P.CPU.Regs.DX);
   Case EmuTvObjType[Slot] Of
    TVOT_KEYBOARD: EmuTvKeyboard[Slot].BoundWindow := N;
    TVOT_POINTER: EmuTvPointer[Slot].BoundWindow := N;
    TVOT_PANEL: ;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $0D: Begin { CLOSE }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_KEYBOARD: EmuTvKeyboard[Slot].BoundWindow := -1;
    TVOT_POINTER: EmuTvPointer[Slot].BoundWindow := -1;
   End;
  End;
  $0E: Begin { ERASE }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: Begin
     EmuTvMailbox[Slot].Head := 0; EmuTvMailbox[Slot].Tail := 0; EmuTvMailbox[Slot].Count := 0;
    End;
    TVOT_WINDOW: Begin
     EmuTvWindow[Slot].CursorX := 0; EmuTvWindow[Slot].CursorY := 0;
     If EmuTvWindow[Slot].WinBufIdx >= 0 Then
      For I := 0 To TV_WINBUF_SIZE - 1 Do
       Emu_WriteByte(P.CPU, EMU_TV_SEG, Emu_Tv_WinBufOfs(EmuTvWindow[Slot].WinBufIdx) + I, 0);
    End;
   End;
  End;
  $0F: Begin { STATUS }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: If EmuTvMailbox[Slot].Count > 0 Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
    TVOT_KEYBOARD: If Emu_Tv_KeyAvail(P) Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
    TVOT_TIMER: If EmuTvTimer[Slot].Running Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   Else
    P.CPU.Regs.AX := 0;
   End;
  End;
  $10: Begin { EOF }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: If EmuTvMailbox[Slot].Count = 0 Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
    TVOT_KEYBOARD: If Not Emu_Tv_KeyAvail(P) Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   Else
    P.CPU.Regs.AX := 1;
   End;
  End;
  $11: Begin { AT (fenetre : DH=ligne,DL=colonne ; timer : DX:AX=echeance) / }
             { SETSCALE (pointeur, CX/DX - meme numero de verbe, BX=1100h)  }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_WINDOW: Begin
     EmuTvWindow[Slot].CursorY := P.CPU.Regs.DH;
     EmuTvWindow[Slot].CursorX := P.CPU.Regs.DL;
     If EmuTvWindow[Slot].CursorX >= EmuTvWindow[Slot].Cols Then EmuTvWindow[Slot].CursorX := 0;
     If EmuTvWindow[Slot].CursorY >= EmuTvWindow[Slot].Rows Then EmuTvWindow[Slot].CursorY := 0;
    End;
    TVOT_TIMER: Begin
     EmuTvTimer[Slot].ExpiryCenti := (LongInt(P.CPU.Regs.DX) Shl 16) Or P.CPU.Regs.AX;
     EmuTvTimer[Slot].Running := True;
    End;
    TVOT_POINTER: Begin
     EmuTvPointer[Slot].ScaleX := P.CPU.Regs.CX;
     EmuTvPointer[Slot].ScaleY := P.CPU.Regs.DX;
    End;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $12: Begin { READN (mailbox, ES:DI=tampon,CX=max) / GETSCALE (pointeur, BX=1200h) }
   Slot := Emu_Tv_TargetSlot(P);
   If Slot < 0 Then Begin Include(P.CPU.Flags.s, EFG_CF); Exit; End;
   Case EmuTvObjType[Slot] Of
    TVOT_MAILBOX: Begin
     N := P.CPU.Regs.CX;
     I := 0;
     While (I < N) And (EmuTvMailbox[Slot].Count > 0) Do Begin
      Ch := EmuTvMailbox[Slot].Data[EmuTvMailbox[Slot].Head];
      EmuTvMailbox[Slot].Head := (EmuTvMailbox[Slot].Head + 1) Mod 256;
      Dec(EmuTvMailbox[Slot].Count);
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + I, Ch);
      Inc(I);
     End;
     P.CPU.Regs.AX := I;
    End;
    TVOT_POINTER: Begin
     P.CPU.Regs.CX := EmuTvPointer[Slot].ScaleX;
     P.CPU.Regs.DX := EmuTvPointer[Slot].ScaleY;
    End;
   Else
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $13: Begin { REDRAW (accepte sans effet - pas de compositeur reel) / SETICON (pointeur, DL, BX=1300h) }
   Slot := Emu_Tv_TargetSlot(P);
   If (Slot >= 0) And (EmuTvObjType[Slot] = TVOT_POINTER) Then
    EmuTvPointer[Slot].Icon := P.CPU.Regs.DL;
  End;
  $14: ; { SETESC : accepte sans effet, voir le commentaire de perimetre }
 Else
  Include(P.CPU.Flags.s, EFG_CF);
 End;
End;

{ INT 15h AH=11h : seul AL=17h (ASSERTMAP) est documente comme un appel    }
{ IBM TopView reel (voir la section 4 du document) - le reste (DE00h..     }
{ DE30h et alias) sont des extensions DESQview, pas des fonctions a         }
{ implanter sans certitude du contrat IBM. }
Procedure Emu_DoInt15Tv11(Var P: TEmulatorPanel);
Begin
 Case P.CPU.Regs.AL Of
  $17: Begin { ASSERTMAP - memoire conventionnelle plate unique dans cet     }
              { emulateur, aucune zone evincable : accepte, ancien contexte }
              { toujours 0 (le seul qui existe). }
   P.CPU.Regs.BX := 0;
   Include(P.CPU.Flags.s, EFG_IF);
  End;
 Else
  Include(P.CPU.Flags.s, EFG_CF);
 End;
End;

{ INT 15h AH=10h : services directs (voir la table complete section 3 du   }
{ document). AX=1004h-1012h/1017h/1020h/1026h+ ne sont implantes ni ici ni  }
{ dans DESQview 2.x d apres le document - tombent dans le Else (CF, comme   }
{ AX non reconnu). }
Procedure Emu_DoInt15Tv10(Var P: TEmulatorPanel);
Var
 OutSeg, OutOfs, Len: Word;
 WinSlot, I, Res, BitIdx: Integer;
 Ch, Attr: Byte;
 Txt: String;
Begin
 Exclude(P.CPU.Flags.s, EFG_CF);
 Case P.CPU.Regs.AX Of
  $1000: ; { PAUSE : rien a ceder, un seul contexte CPU (voir le commentaire de perimetre) }
  $1001: Begin { GETMEM }
   If Emu_Tv_HeapAlloc(P, P.CPU.Regs.BX, OutSeg, OutOfs) Then Begin
    P.CPU.Segs.ES := OutSeg; P.CPU.Regs.DI := OutOfs;
   End Else Begin
    P.CPU.Segs.ES := 0; P.CPU.Regs.DI := 0;
   End;
  End;
  $1002: Emu_Tv_HeapFree(P, P.CPU.Segs.ES, P.CPU.Regs.DI); { PUTMEM }
  $1003: Begin { PRINTC }
   If P.CPU.Regs.BX <> 0 Then Begin
    Attr := P.CPU.Regs.BH; Ch := P.CPU.Regs.BL;
    WinSlot := Emu_Tv_SlotFromSeg(P.CPU.Regs.DX);
    If (WinSlot >= 0) And (EmuTvObjType[WinSlot] = TVOT_WINDOW) Then
     Emu_Tv_WindowPutChar(P, WinSlot, Ch, Attr)
    Else
     Emu_Tv_ScreenPutChar(P, Ch, Attr);
   End;
   { BX=0000h : synchronise seulement le curseur materiel - le curseur     }
   { logique est deja tenu a jour par les ecritures precedentes. }
  End;
  $1013: Begin { GETBIT }
   BitIdx := -1;
   For I := 0 To TV_MAX_BITS - 1 Do
    If Not EmuTvBitUsed[I] Then Begin BitIdx := I; Break; End;
   If BitIdx < 0 Then P.CPU.Regs.BX := 0
   Else Begin
    EmuTvBitUsed[BitIdx] := True;
    EmuTvBitSeg[BitIdx] := P.CPU.Segs.ES;
    EmuTvBitOfs[BitIdx] := P.CPU.Regs.DI;
    P.CPU.Regs.BX := Word(1) Shl BitIdx;
   End;
  End;
  $1014: Begin { FREEBIT }
   For I := 0 To TV_MAX_BITS - 1 Do
    If (P.CPU.Regs.BX And (Word(1) Shl I)) <> 0 Then Begin
     EmuTvBitUsed[I] := False;
     EmuTvBitPending := EmuTvBitPending And Not (Word(1) Shl I);
    End;
  End;
  $1015: EmuTvBitPending := EmuTvBitPending Or P.CPU.Regs.BX; { SETBIT }
  $1016: Begin { ISOBJ }
   If Emu_Tv_SlotFromSeg(P.CPU.Segs.ES) >= 0 Then P.CPU.Regs.BX := $FFFF
   Else P.CPU.Regs.BX := 0;
  End;
  $1018: Begin { LOCATE - pas de vrai Z-order/composition (voir le          }
   { commentaire de perimetre) : renvoie la fenetre par defaut si elle      }
   { couvre (BL,BH), sinon 0. }
   P.CPU.Segs.ES := 0;
   If EmuTvDefWindow >= 0 Then Begin
    WinSlot := EmuTvDefWindow;
    If (P.CPU.Regs.BH >= EmuTvWindow[WinSlot].PosY) And
       (P.CPU.Regs.BH < EmuTvWindow[WinSlot].PosY + EmuTvWindow[WinSlot].Rows) And
       (P.CPU.Regs.BL >= EmuTvWindow[WinSlot].PosX) And
       (P.CPU.Regs.BL < EmuTvWindow[WinSlot].PosX + EmuTvWindow[WinSlot].Cols) Then
     P.CPU.Segs.ES := Emu_Tv_HandleSeg(WinSlot);
   End;
  End;
  $1019: Emu_Tv_Sound(P.CPU.Regs.BX, P.CPU.Regs.CX); { SOUND }
  $101A: Begin { OSTACK }
   If Not EmuTvOnPrivStack Then Begin
    EmuTvSavedSS := P.CPU.Segs.SS; EmuTvSavedSP := P.CPU.Regs.SP;
    P.CPU.Segs.SS := EMU_TV_SEG;
    P.CPU.Regs.SP := EMU_TV_STACK_OFS + TV_STACK_SIZE;
    EmuTvOnPrivStack := True;
   End;
  End;
  $1025: Begin { USTACK }
   If EmuTvOnPrivStack Then Begin
    P.CPU.Segs.SS := EmuTvSavedSS; P.CPU.Regs.SP := EmuTvSavedSP;
    EmuTvOnPrivStack := False;
   End;
  End;
  $101B: EmuTvCritical := True;  { BEGINC }
  $101C: EmuTvCritical := False; { ENDC }
  $101D: EmuTvTaskStopped := True;  { STOP - voir le commentaire de perimetre }
  $101E: EmuTvTaskStopped := False; { START }
  $101F: Begin { DISPEROR }
   Len := P.CPU.Regs.BX And $1FFF;
   Txt := '';
   For I := 0 To Len - 1 Do
    Txt := Txt + Chr(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.DI + I));
   If (P.CPU.Regs.BX And $8000) <> 0 Then Emu_Tv_Sound(800, 2); { bit15 : bip }
   Res := ShowMessageBox('TopView', Txt, MB_OKCANCEL, MI_ERROR);
   If Res = DR_OK Then P.CPU.Regs.BX := 1
   Else If Res = DR_CANCEL Then P.CPU.Regs.BX := 2
   Else P.CPU.Regs.BX := 27;
  End;
  $1021: Begin { PGMINT }
   If EmuTvInjectCount < TV_MAX_INJECT Then Begin
    EmuTvInjectSeg[EmuTvInjectCount] := P.CPU.Regs.DX;
    EmuTvInjectOfs[EmuTvInjectCount] := P.CPU.Regs.CX;
    Inc(EmuTvInjectCount);
   End;
  End;
  $1022: Begin { GETVER }
   If P.CPU.Regs.BX = 0 Then
    P.CPU.Regs.BX := $0001; { v1.0, comme TaskView (BL=1 majeur, BH=0 mineur) }
  End;
  $1023: Begin { POSWIN }
   WinSlot := Emu_Tv_SlotFromSeg(P.CPU.Segs.ES);
   If (WinSlot >= 0) And (EmuTvObjType[WinSlot] = TVOT_WINDOW) Then Begin
    EmuTvWindow[WinSlot].PosX := P.CPU.Regs.CH;
    EmuTvWindow[WinSlot].PosY := P.CPU.Regs.CL;
   End;
  End;
  $1024: Begin { GETBUF }
   If P.CPU.Regs.BX = 0 Then Begin
    P.CPU.Segs.ES := $B800; P.CPU.Regs.DI := 0;
    P.CPU.Regs.CX := 4000; P.CPU.Regs.DL := 0;
   End Else Begin
    WinSlot := Emu_Tv_SlotFromSeg(P.CPU.Regs.BX);
    If (WinSlot >= 0) And (EmuTvObjType[WinSlot] = TVOT_WINDOW) And
       (EmuTvWindow[WinSlot].WinBufIdx >= 0) Then Begin
     P.CPU.Segs.ES := EMU_TV_SEG;
     P.CPU.Regs.DI := Emu_Tv_WinBufOfs(EmuTvWindow[WinSlot].WinBufIdx);
     P.CPU.Regs.CX := EmuTvWindow[WinSlot].Cols * EmuTvWindow[WinSlot].Rows * 2;
     P.CPU.Regs.DL := 0;
    End Else Begin
     P.CPU.Segs.ES := 0; P.CPU.Regs.DI := 0; P.CPU.Regs.CX := 0;
    End;
   End;
  End;
 Else
  Include(P.CPU.Flags.s, EFG_CF);
 End;
End;

{ Point d entree unique - voir Emu_DoInt (Case AH=15h). }
Procedure Emu_DoInt15Tv(Var P: TEmulatorPanel);
Begin
 Case P.CPU.Regs.AH Of
  $10: Emu_DoInt15Tv10(P);
  $11: Emu_DoInt15Tv11(P);
  $12: Emu_DoInt15Tv12(P);
 End;
End;

Procedure Emu_DoInt15C2(Var P: TEmulatorPanel);
Begin
 Exclude(P.CPU.Flags.s, EFG_CF);
 P.CPU.Regs.AH := 0; { succes par defaut }
 Case P.CPU.Regs.AL Of
  $00: Begin   { Enable/Disable : BH=00 disable 01 enable }
   If P.CPU.Regs.BH = 0 Then EmuMouseBiosEnabled := False
   Else If P.CPU.Regs.BH = 1 Then EmuMouseBiosEnabled := True
   Else Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := 1; End;
  End;
  $01: Begin   { Reset }
   EmuMouseBiosSampleRate := 3; EmuMouseBiosResolution := 2;
   P.CPU.Regs.BX := 0; { ID peripherique : 00h = souris standard 2 boutons }
  End;
  $02: Begin   { Set Sample Rate : BH=0..7 }
   If P.CPU.Regs.BH <= 7 Then EmuMouseBiosSampleRate := P.CPU.Regs.BH
   Else Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := 2; End;
  End;
  $03: Begin   { Set Resolution : BH=0..3 }
   If P.CPU.Regs.BH <= 3 Then EmuMouseBiosResolution := P.CPU.Regs.BH
   Else Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := 2; End;
  End;
  $04: P.CPU.Regs.BH := 0;   { Get Device ID (souris standard 2 boutons) }
  $05: If P.CPU.Regs.BH = 0 Then P.CPU.Regs.BH := 3; { Initialize : taille  }
                                                      { paquet (3 standard) }
  $06: Begin   { Extended commands (mise a l echelle, resolution...) }
   Case P.CPU.Regs.BH Of
    0, 1, 2: ; { Get status / Set scaling 1:1 / 2:1 - acceptees, sans effet }
                { sur les donnees produites par cet emulateur. }
    3: If P.CPU.Regs.CL <= 3 Then EmuMouseBiosResolution := P.CPU.Regs.CL;
   Else
    Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := 1; End;
   End;
  End;
  $07: Begin   { Set Device Handler Address : ES:BX = callback invoque par  }
               { Emu_MouseFireOne (Kind=2). }
   EmuMouseBiosCallbackSeg := P.CPU.Segs.ES;
   EmuMouseBiosCallbackOfs := P.CPU.Regs.BX;
  End;
 Else
  Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := 1; End; { fonction  }
                                                                  { invalide }
 End;
End;

{ INT 15h AH=C0h/88h/90h/91h : services materiel AT+ (voir Emu_IsATClassHw) -  }
{ jusqu ici seuls AH=C2h (souris PS/2) et 10h/11h/12h (TopView) etaient geres, }
{ toute autre sous-fonction (y compris C0h, pourtant la plus classique et la  }
{ plus testee par MS-DOS SYSINIT au demarrage) tombait dans le "non          }
{ supporte" generique - incoherence reelle signalee par l utilisateur en      }
{ investiguant le blocage BOOT/IO.SYS : un materiel AT/PS2/Compaq Deskpro 386 }
{ choisi dans "Materiel :" annonce pourtant sa classe via l octet ROM         }
{ F000:FFFE (DosHardwareBiosId, voir Emu_InitBDA) sans jamais repondre a      }
{ l appel INT 15h AH=C0h qu un vrai BIOS de cette classe implante toujours -  }
{ corrige ici en repondant reellement pour la classe AT+ (Emu_IsATClassHw),   }
{ tout en laissant PC/XT/PCjr/clones PC anterieurs repondre "non supporte"    }
{ (fidele : ces BIOS n avaient pas cette fonction). AH=41h (Wait on External  }
{ Event) reste volontairement hors de cette liste et continue de repondre    }
{ "non supporte" : recherche faite (Ralf Brown's Interrupt List) confirme que }
{ cette fonction est exclusive aux IBM PC Convertible - aucun des 11 profils  }
{ materiel de "Materiel :" n en fait partie, donc CF=1/AH=86h y est la        }
{ reponse correcte pour TOUTE classe materiel choisissable ici, pas une       }
{ lacune. }
Procedure Emu_DoInt15AT(Var P: TEmulatorPanel);
Var Seg, Ofs: Word;
    Int87SrcBase, Int87DstBase, Int87I: LongInt;
    Int87TmpByte: Byte;
Begin
 Exclude(P.CPU.Flags.s, EFG_CF);
 Case P.CPU.Regs.AH Of
  $C0: Begin  { Get System Configuration Parameters : ES:BX -> table de 8    }
              { octets precedee de sa longueur (voir RBIL "System Model      }
              { Byte"/"Feature Byte 1"). BOGUE REEL CORRIGE (2026-08-24,     }
              { voir EMU_SYSCONF_SEG/OFS) : un vrai BIOS ne recoit jamais     }
              { ES:BX de l appelant pour cette fonction, il renvoie un        }
              { pointeur vers SA PROPRE table (en ROM) - ecrire a l ancienne  }
              { adresse fournie par l appelant (jamais destinee a servir de   }
              { cible d ecriture) ecrasait de la memoire arbitraire. }
   Seg := EMU_SYSCONF_SEG; Ofs := EMU_SYSCONF_OFS;
   Emu_WriteWord(P.CPU, Seg, Ofs,     8);  { longueur : 8 octets suivent }
   Emu_WriteByte(P.CPU, Seg, Ofs + 2, DosHardwareBiosId(OptionsDlg.Data.DosHardware));
   Emu_WriteByte(P.CPU, Seg, Ofs + 3, 0);  { sous-modele }
   Emu_WriteByte(P.CPU, Seg, Ofs + 4, 0);  { revision BIOS }
   { Octet fonctionnalites 1 : bit5=horloge CMOS reelle presente (voir        }
   { Emu_CMOSPorts, deja implantee et testee) ; bit3=attente d evenement      }
   { externe (INT 15h AH=41h/4xh, "Convertible" uniquement, jamais implante   }
   { ici, voir le commentaire de tete) ; bit1=bus Micro Channel (aucun        }
   { POS/AH=C4h implante, donc annonce ISA) ; bit7=canal DMA 3 reserve au     }
   { BIOS disque dur (notre interface disque est PIO pure, jamais de DMA reel }
   { - annoncer 0 plutot que le 1 "historique" reste honnete envers un        }
   { pilote qui verifierait cette disponibilite avant d utiliser ce canal     }
   { lui-meme). Seul bit5 est donc actif. }
   Emu_WriteByte(P.CPU, Seg, Ofs + 5, $20);
   Emu_WriteByte(P.CPU, Seg, Ofs + 6, 0);
   Emu_WriteByte(P.CPU, Seg, Ofs + 7, 0);
   Emu_WriteByte(P.CPU, Seg, Ofs + 8, 0);
   Emu_WriteByte(P.CPU, Seg, Ofs + 9, 0);
   { Renvoyer a l appelant le pointeur vers NOTRE table (jamais l inverse -   }
   { voir le commentaire ci-dessus) - c est le comportement reel attendu. }
   P.CPU.Segs.ES := Seg;
   P.CPU.Regs.BX := Ofs;
   P.CPU.Regs.AH := 0;
  End;
  $88: Begin  { Get Extended Memory Size (Ko au-dela de 1 Mo). BOGUE REEL     }
              { CORRIGE (2026-08-24, trouve en poursuivant l enquete         }
              { DOS=HIGH/XMS) : ce commentaire datait d avant l implantation  }
              { de la HMA (2026-08-24, voir TEmuMemBuf/Emu_Addr) - retourner  }
              { $0000 inconditionnellement etait honnete a l epoque (aucune   }
              { memoire au-dela de 1 Mo n existait reellement) mais rendait   }
              { la HMA fraichement implantee totalement INUTILISABLE : le     }
              { vrai HIMEM.SYS verifie explicitement "cmp ax,64 / jb erreur"  }
              { (voir sysinit1.asm AllocHMA, vrai source MS-DOS 6.0 divulgue) }
              { avant meme d essayer d utiliser la HMA. Cet emulateur fournit }
              { desormais reellement 65520 octets au-dela de 1 Mo (la HMA     }
              { complete, $FFF0=65520, PAS 65536 - meme frontiere reelle      }
              { qu un vrai systeme AT, ou le plus haut octet adressable via   }
              { FFFF:FFFF s arrete 16 octets avant 64 Ko) - arrondi a la      }
              { convention universelle "64 Ko" (65520 div 1024 tronque a 63   }
              { ferait echouer a tort le test ">=64" reel alors que la HMA    }
              { EST reellement backee au complet). }
   P.CPU.Regs.AX := 64;
  End;
  $87: Begin { Deplacement de bloc en memoire etendue (service BIOS           }
             { classique). BOGUE REEL CORRIGE (2026-08-25, trouve en tracant  }
             { HIMEM.SYS, qui utilise ce service comme repli de son           }
             { verificateur de memoire etendue quand le "unreal mode" 32      }
             { bits n est pas emprunte) : totalement absent (tombait dans     }
             { l Else generique "fonction non geree" ci-dessous) - un         }
             { CF=1/AH=86h en reponse dit a l appelant "ce BIOS ne sait pas    }
             { deplacer de memoire etendue du tout", ce qui est FAUX et fait   }
             { echouer silencieusement toute verification qui l utilise (le    }
             { tampon destination n est alors jamais rempli). ES:SI pointe     }
             { vers une table de 6 descripteurs de 8 octets (format RBIL       }
             { classique) - seuls les descripteurs SOURCE (offset+16) et       }
             { DESTINATION (offset+24) sont utilises ici. Par descripteur :    }
             { octets 2-4 = base 24 bits (poids faible->fort), octet 7 = base  }
             { bits 24-31 (extension 32 bits non-standard mais largement       }
             { supportee - et c est exactement le format que le vrai           }
             { HIMEM.SYS construit lui-meme, confirme par tracage direct de    }
             { son code). CX = nombre de MOTS a deplacer. }
   Int87SrcBase :=
     LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 16 + 2)) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 16 + 3)) Shl 8) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 16 + 4)) Shl 16) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 16 + 7)) Shl 24);
   Int87DstBase :=
     LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 24 + 2)) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 24 + 3)) Shl 8) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 24 + 4)) Shl 16) Or
     (LongInt(Emu_ReadByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.SI + 24 + 7)) Shl 24);
   For Int87I := 0 To (LongInt(P.CPU.Regs.CX) * 2) - 1 Do Begin
    Int87TmpByte := 0;
    Emu_ReadAbsBlock(P.CPU, Int87SrcBase + Int87I, Int87TmpByte, 1);
    Emu_WriteAbsBlock(P.CPU, Int87DstBase + Int87I, Int87TmpByte, 1);
   End;
   P.CPU.Regs.AH := 0;
  End;
  $90, $91: ; { Device Busy / Interrupt Complete : notification de chainage   }
              { d ISR (reseau/souris) sans contrepartie multitache reelle ici }
              { - acceptee sans effet (CF=0), comme un vrai BIOS le ferait    }
              { pour un peripherique qu il ne reconnait pas specifiquement. }
 Else
  Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AH := $86; End;
 End;
End;

{ Mettre a jour la position de la souris emulee a partir d un
  evenement hote (PollEvents). Convertit les coords ecran de DEVENV
  vers les coords logiques de l ecran emule (pixel pour graphique,
  ColonneDe8 pour texte). PressMask/ReleaseMask = bits L/R/M qui
  changent. Declenche aussi l invocation reelle du/des gestionnaire(s)     }
  { INT 33h et du callback BIOS PS/2 le cas echeant - voir                }
  { Emu_MouseFireEvents. }
Procedure EmuMouse_UpdateFromHost(Var P: TEmulatorPanel;
                                  HostX, HostY: Integer;
                                  NewBtns: Byte);
Var
 LX, LY: Integer;
 GfxW, GfxH, Scale, GridX, GridY: Integer;
 Changed: Byte;
 BIdx: Integer;
 EvMask: Word;
 DeltaMickX, DeltaMickY: Integer;
Begin
 If Not EmuMouseInst Then Exit;
 { Recalculer offsets/scale comme DrawEmulatorPanel }
 If EmuVideo.IsGraphic Then Begin
  GfxW := EmuVideo.Width;
  GfxH := EmuVideo.Height;
  Scale := 1;
  If GfxW <= 320 Then Scale := 2;
  If GfxW <= 160 Then Scale := 4;
  GridX := P.PanelX;
  GridY := P.PanelY + 24;
  LX := (HostX - GridX) Div Scale;
  LY := (HostY - GridY) Div Scale;
 End Else Begin
  GridX := P.PanelX;
  GridY := P.PanelY + 24;
  If P.CharW <= 0 Then P.CharW := 8;
  If P.CharH <= 0 Then P.CharH := 16;
  { Coords texte : INT 33h utilise des pixels (col*8, row*8) }
  LX := ((HostX - GridX) * 8) Div P.CharW;
  LY := ((HostY - GridY) * 8) Div P.CharH;
 End;
 { Mettre a jour les compteurs mickeys avant de cliper }
 EvMask := 0;
 DeltaMickX := LX - EmuMouseX;
 DeltaMickY := LY - EmuMouseY;
 If (DeltaMickX <> 0) Or (DeltaMickY <> 0) Then EvMask := EvMask Or 1;
 EmuMouseMickX := EmuMouseMickX + DeltaMickX;
 EmuMouseMickY := EmuMouseMickY + DeltaMickY;
 { Cliper aux plages courantes }
 If LX < EmuMouseXMin Then LX := EmuMouseXMin;
 If LX > EmuMouseXMax Then LX := EmuMouseXMax;
 If LY < EmuMouseYMin Then LY := EmuMouseYMin;
 If LY > EmuMouseYMax Then LY := EmuMouseYMax;
 EmuMouseX := LX;
 EmuMouseY := LY;
 { Detecter changements de boutons (press / release) }
 Changed := EmuMouseBtns Xor NewBtns;
 For BIdx := 0 To 2 Do Begin
  If (Changed And (1 Shl BIdx)) <> 0 Then Begin
   If (NewBtns And (1 Shl BIdx)) <> 0 Then Begin
    Inc(EmuMousePressCnt[BIdx]);
    EmuMousePressX[BIdx] := LX;
    EmuMousePressY[BIdx] := LY;
    EvMask := EvMask Or (1 Shl (1 + BIdx * 2));
   End Else Begin
    Inc(EmuMouseRelCnt[BIdx]);
    EmuMouseRelX[BIdx] := LX;
    EmuMouseRelY[BIdx] := LY;
    EvMask := EvMask Or (1 Shl (2 + BIdx * 2));
   End;
  End;
 End;
 EmuMouseBtns := NewBtns And $07;
 If EmuMouseActive And (Not EmuMouseSoftDisabled) Then
  Emu_MouseFireEvents(P, EvMask, Word(EmuMouseX), Word(EmuMouseY),
   Word(DeltaMickX), Word(DeltaMickY));
End;

{ ============================================================
  Support des images disquettes A:/B: pour l emulateur DOS
  ============================================================
  Les images brutes (raw, .IMG/.IMA) sont supportees nativement.
  La detection de geometrie repose sur la taille du fichier
  (formats standards 160K..2.88M).
  Les formats compresses (TeleDisk td, VHD dynamique, VMDK
  sparse, VDI...) ne sont PAS supportes a ce stade : un
  avertissement est emis et l unite reste fermee. }

Procedure Emu_FloppyDetectGeom(Sz: LongInt;
 Var Cyls: Word; Var Heads, Spt, BiosType: Byte);
Begin
 { Defaults : 1.44 Mo }
 Cyls := 80; Heads := 2; Spt := 18; BiosType := 4;
 Case Sz Of
  163840: Begin   { 160K - SS DD 40T 8S }
   Cyls := 40; Heads := 1; Spt := 8;  BiosType := 1;
  End;
  184320: Begin   { 180K - SS DD 40T 9S }
   Cyls := 40; Heads := 1; Spt := 9;  BiosType := 1;
  End;
  327680: Begin   { 320K - DS DD 40T 8S }
   Cyls := 40; Heads := 2; Spt := 8;  BiosType := 1;
  End;
  368640: Begin   { 360K - DS DD 40T 9S }
   Cyls := 40; Heads := 2; Spt := 9;  BiosType := 1;
  End;
  737280: Begin   { 720K - 3.5 DD 80T 9S }
   Cyls := 80; Heads := 2; Spt := 9;  BiosType := 3;
  End;
  1228800: Begin  { 1.2M - 5.25 HD 80T 15S }
   Cyls := 80; Heads := 2; Spt := 15; BiosType := 2;
  End;
  1474560: Begin  { 1.44M - 3.5 HD 80T 18S }
   Cyls := 80; Heads := 2; Spt := 18; BiosType := 4;
  End;
  2949120: Begin  { 2.88M - 3.5 ED 80T 36S }
   Cyls := 80; Heads := 2; Spt := 36; BiosType := 6;
  End;
 Else
  { Format non standard : tenter de deduire avec 2 tetes, 18 spt }
  If (Sz Mod 512) = 0 Then Begin
   Heads := 2; Spt := 18;
   Cyls := Word((Sz Div 512) Div (LongInt(Heads) * Spt));
   If Cyls = 0 Then Cyls := 80;
   BiosType := 4;
  End;
 End;
End;

{ Detecter le format de l image en lisant les premiers octets.
  Retourne True si raw (supporte), False si format compresse / non
  reconnu (un message est imprime). }
Function Emu_FloppyIsRaw(FName: String): Boolean;
Var
 F: File;
 Buf: Array[0..511] Of Byte;
 BR: Word;
 Sig2: String;
 Sig4: String;
 I: Integer;
Begin
 Emu_FloppyIsRaw := False;
 {$I-}
 Assign(F, FName); Reset(F, 1);
 If IOResult <> 0 Then Begin
  WriteLn('DEVENV: impossible d ouvrir ', FName);
  Exit;
 End;
 FillChar(Buf, SizeOf(Buf), 0);
 BlockRead(F, Buf, SizeOf(Buf), BR);
 Close(F);
 {$I+} If IOResult <> 0 Then ;
 If BR < 16 Then Begin
  WriteLn('DEVENV: image trop petite : ', FName);
  Exit;
 End;
 Sig2 := Chr(Buf[0]) + Chr(Buf[1]);
 Sig4 := '';
 For I := 0 To 3 Do Sig4 := Sig4 + Chr(Buf[I]);
 { TeleDisk : 'TD' (non compresse) ou 'td' (LZHUF) }
 If (Sig2 = 'TD') Or (Sig2 = 'td') Then Begin
  WriteLn('DEVENV: format TeleDisk non supporte pour ', FName);
  WriteLn('        Convertir en .IMG brut (ex: WTELEDSK / WTD2IMG).');
  Exit;
 End;
 { VMDK descripteur ou sparse }
 If (Sig4 = 'KDMV') Or (Copy(Sig4, 1, 4) = '# Di') Then Begin
  WriteLn('DEVENV: format VMDK non supporte pour ', FName);
  Exit;
 End;
 { VDI VirtualBox : signature texte au debut }
 If (Copy(Sig4, 1, 4) = '<<< ') Then Begin
  WriteLn('DEVENV: format VDI non supporte pour ', FName);
  Exit;
 End;
 { QCOW (QEMU) }
 If (Sig4 = 'QFI' + Chr($FB)) Then Begin
  WriteLn('DEVENV: format QCOW non supporte pour ', FName);
  Exit;
 End;
 { VHD : footer 'conectix' en fin de fichier. On suppose qu une image
   floppy < 3 Mo ne sera pas VHD : on accepte comme raw. }
 Emu_FloppyIsRaw := True;
End;

{ ============================================================
  Traduction de conteneurs disque (VHD fixe/dynamique, VMDK
  sparse ou descripteur texte, VDI VirtualBox) pour les disques
  durs montes via /DISK80 et /DISK81. VHD/VMDK portes depuis
  DISKPC.PAS / UNDISKPC.PAS (projet Corail) ; VDI ajoute
  separement (absent de ces deux references - ni l un ni l autre
  ne le supporte), d apres le format d en-tete VDI 1.1 documente
  publiquement (implementation QEMU block/vdi.c notamment) - voir
  Emu_DiskDetectFormat pour le detail des offsets. Les disquettes
  (/DISK0, /DISK1) restent brutes uniquement (Emu_FloppyIsRaw
  ci-dessus) : EmuFloppyKind vaut toujours 0 pour les unites 0/1.
  ============================================================ }

Function Emu_BufLE32(Var Buf; Off: Integer): LongInt;
Var
 B: Array[0..2047] Of Byte Absolute Buf;
Begin
 Emu_BufLE32 := LongInt(B[Off]) Or (LongInt(B[Off + 1]) Shl 8) Or
   (LongInt(B[Off + 2]) Shl 16) Or (LongInt(B[Off + 3]) Shl 24);
End;

Function Emu_BufBE32(Var Buf; Off: Integer): LongInt;
Var
 B: Array[0..2047] Of Byte Absolute Buf;
Begin
 Emu_BufBE32 := (LongInt(B[Off]) Shl 24) Or (LongInt(B[Off + 1]) Shl 16) Or
   (LongInt(B[Off + 2]) Shl 8) Or LongInt(B[Off + 3]);
End;

{ Detecter le format du fichier deja ouvert dans EmuFloppyFile[Idx]
  (raw, VHD fixe/dynamique, VMDK sparse/descripteur, VDI dynamique/fixe)
  et remplir les champs EmuFloppyKind/BlockSec/BitmapSecs/BATFileOfs/
  GTEsPerGT/DataOfs et EmuFloppySize (taille VIRTUELLE en octets).
  L appelant doit avoir prealablement mis EmuFloppySize[Idx] a la taille
  du fichier brut (valeur conservee si aucun conteneur n est detecte).
  Retourne False si le format est reconnu mais non supporte (message
  imprime). }
Function Emu_DiskDetectFormat(Idx: Byte): Boolean;
Var
 Raw: Array[0..511] Of Byte;
 R: Word;
 Sz, DT, CurSz, CurSzHi, HdrOfs, BAToff, BlockSz: LongInt;
 GDOffset, NumGTEs, Capacity, GrainSize: LongInt;
 S, ExtName, DescDir: String;
 I, K: Integer;
 WinBuf: Array[0..575] Of Byte;
 WinSz: Word;
 WinR: Word;
 FtrRelOfs: Integer;
Begin
 Emu_DiskDetectFormat := True;
 EmuFloppyKind[Idx]      := 0;
 EmuFloppyBlockSec[Idx]   := 0;
 EmuFloppyBitmapSecs[Idx] := 0;
 EmuFloppyBATFileOfs[Idx] := 0;
 EmuFloppyGTEsPerGT[Idx]  := 0;
 EmuFloppyDataOfs[Idx]    := 0;
 {$I-}
 Sz := FileSize(EmuFloppyFile[Idx]);
 {$I+} If IOResult <> 0 Then ;
 If Sz < 512 Then Exit;
 {$I-}
 Seek(EmuFloppyFile[Idx], 0);
 R := 0;
 BlockRead(EmuFloppyFile[Idx], Raw, 512, R);
 {$I+} If IOResult <> 0 Then ;
 If R < 512 Then Exit;
 { TeleDisk : signature 'TD' ou 'td' }
 If ((Raw[0] = Ord('T')) And (Raw[1] = Ord('D'))) Or
    ((Raw[0] = Ord('t')) And (Raw[1] = Ord('d'))) Then Begin
  WriteLn('DEVENV: format TeleDisk non supporte pour ', EmuFloppyName[Idx]);
  Emu_DiskDetectFormat := False;
  Exit;
 End;
 { VDI VirtualBox : preambule texte '<<< ' (ex. "<<< Oracle VM VirtualBox
   Disk Image >>>"), confirme par la vraie signature binaire 0xBEDA107F
   (petit-boutiste) a l offset 0x40 du fichier - format d en-tete V1.1
   (struct VdiHeader), le seul produit par toute version moderne de
   VirtualBox. Tous les champs necessaires (image_type/offset_bmap/
   offset_data/disk_size/block_size) tiennent dans les 512 premiers
   octets deja lus, contrairement a VHD dynamique (2e lecture) ou au
   descripteur VMDK (redirection vers un autre fichier). Le block map
   VDI (a offset_bmap) stocke, par bloc, un INDEX (pas un offset ni un
   numero de secteur) dans la zone de donnees (a offset_data) - voir
   Emu_ImageReadSector/WriteSector pour la traduction. }
 If (Raw[0] = Ord('<')) And (Raw[1] = Ord('<')) And (Raw[2] = Ord('<')) Then Begin
  If (Raw[$40] = $7F) And (Raw[$41] = $10) And (Raw[$42] = $DA) And (Raw[$43] = $BE) Then Begin
   DT      := Emu_BufLE32(Raw, $4C);   { image_type : 1=dynamique 2=fixe }
   BAToff  := Emu_BufLE32(Raw, $154);  { offset_bmap }
   HdrOfs  := Emu_BufLE32(Raw, $158);  { offset_data (reutilise HdrOfs) }
   CurSz   := Emu_BufLE32(Raw, $170);  { disk_size, 32 bits faibles }
   BlockSz := Emu_BufLE32(Raw, $178);  { block_size en octets }
   If (BlockSz > 0) And (BlockSz Mod 512 = 0) And (BAToff > 0) And
      (HdrOfs > 0) And ((DT = 1) Or (DT = 2)) Then Begin
    EmuFloppyKind[Idx]      := 4;
    EmuFloppySize[Idx]      := LongWord(CurSz);
    EmuFloppyBlockSec[Idx]  := BlockSz Div 512;
    EmuFloppyBATFileOfs[Idx]:= BAToff;
    EmuFloppyDataOfs[Idx]   := HdrOfs;
   End Else Begin
    WriteLn('DEVENV: en-tete VDI non reconnu (version non standard) pour ', EmuFloppyName[Idx]);
    Emu_DiskDetectFormat := False;
   End;
  End Else Begin
   WriteLn('DEVENV: format VDI non reconnu (signature binaire absente) pour ', EmuFloppyName[Idx]);
   Emu_DiskDetectFormat := False;
  End;
  Exit;
 End;
 { QCOW (QEMU) }
 If (Raw[0] = Ord('Q')) And (Raw[1] = Ord('F')) And
    (Raw[2] = Ord('I')) And (Raw[3] = $FB) Then Begin
  WriteLn('DEVENV: format QCOW non supporte pour ', EmuFloppyName[Idx]);
  Emu_DiskDetectFormat := False;
  Exit;
 End;
 { VMDK sparse : magic 'KDMV' (little-endian) }
 If (Raw[0] = $4B) And (Raw[1] = $44) And
    (Raw[2] = $4D) And (Raw[3] = $56) Then Begin
  Capacity  := Emu_BufLE32(Raw, 12);
  GrainSize := Emu_BufLE32(Raw, 20);
  NumGTEs   := Emu_BufLE32(Raw, 44);
  GDOffset  := Emu_BufLE32(Raw, 56);
  If (GrainSize > 0) And (NumGTEs > 0) And (GDOffset > 0) Then Begin
   EmuFloppyKind[Idx]      := 3;
   EmuFloppySize[Idx]      := LongWord(Capacity) * 512;
   EmuFloppyBlockSec[Idx]   := GrainSize;
   EmuFloppyGTEsPerGT[Idx]  := NumGTEs;
   EmuFloppyBATFileOfs[Idx] := GDOffset * 512;
  End;
  Exit;
 End;
 { VMDK descripteur texte : redirige vers le fichier flat (ligne
   'RW <n> FLAT "fichier" <ofs>') puis ranalyse ce fichier. }
 If (Raw[0] = $23) Or ((Raw[0] >= Ord('A')) And (Raw[0] <= Ord('z'))) Then Begin
  S := '';
  For I := 0 To 511 Do
   If (Raw[I] >= 32) Or (Raw[I] = 10) Or (Raw[I] = 13) Then S := S + Chr(Raw[I])
                                                          Else S := S + ' ';
  If (Pos('DescriptorFile', S) > 0) Or (Pos('createType', S) > 0) Then Begin
   I := Pos('RW ', S);
   If (I > 0) And (Pos('FLAT', S) > I) Then Begin
    I := Pos('FLAT', S);
    K := I + 4;
    While (K <= Length(S)) And (S[K] <> '"') Do Inc(K);
    If (K < Length(S)) And (S[K] = '"') Then Begin
     Inc(K);
     ExtName := '';
     While (K <= Length(S)) And (S[K] <> '"') Do Begin
      ExtName := ExtName + S[K];
      Inc(K);
     End;
     DescDir := ExtractFilePath(EmuFloppyName[Idx]);
     If (Pos(':', ExtName) = 0) And (Length(ExtName) > 0) And
        (ExtName[1] <> '\') And (ExtName[1] <> '/') Then
      ExtName := DescDir + ExtName;
     {$I-}
     Close(EmuFloppyFile[Idx]);
     Assign(EmuFloppyFile[Idx], ExtName);
     FileMode := 2;
     Reset(EmuFloppyFile[Idx], 1);
     If IOResult <> 0 Then Begin
      FileMode := 0;
      Assign(EmuFloppyFile[Idx], ExtName);
      Reset(EmuFloppyFile[Idx], 1);
      If IOResult <> 0 Then Begin
       FileMode := 0;
       WriteLn('DEVENV: impossible d ouvrir l extension VMDK : ', ExtName);
       Emu_DiskDetectFormat := False;
       Exit;
      End;
      EmuFloppyRO[Idx] := True;
     End;
     FileMode := 0;
     {$I+} If IOResult <> 0 Then ;
     EmuFloppyName[Idx] := ExtName;
     EmuFloppySize[Idx] := LongWord(FileSize(EmuFloppyFile[Idx]));
     Emu_DiskDetectFormat := Emu_DiskDetectFormat(Idx);
     Exit;
    End;
   End;
   Exit;  { descripteur reconnu mais sans ligne FLAT : traiter en brut }
  End;
 End;
 { VHD : footer 'conectix', normalement aux 512 derniers octets - mais un   }
 { VHD reel rencontre en pratique (fichier de 2009, lu sans probleme par    }
 { VirtualBox) s est avere tronque d exactement 1 octet en fin de fichier   }
 { (perte historique probable lors d un transfert), decalant le vrai debut }
 { du footer a Sz-511 plutot que Sz-512 - la queue "Reserved" du footer     }
 { (427 octets, jamais consultee ici) absorbe la perte sans consequence     }
 { fonctionnelle. Cherche donc le cookie dans une fenetre de tolerance      }
 { autour de Sz-512 (plutot que d exiger un alignement exact) et reconstruit}
 { les 512 octets du footer, completes de zeros si le fichier n a pas       }
 { assez d octets restants apres le cookie trouve. }
 If Sz < 512 Then Exit;
 WinSz := 576; If LongInt(WinSz) > Sz Then WinSz := Word(Sz);
 FillChar(WinBuf, SizeOf(WinBuf), 0);
 {$I-}
 Seek(EmuFloppyFile[Idx], Sz - WinSz);
 WinR := 0;
 BlockRead(EmuFloppyFile[Idx], WinBuf, WinSz, WinR);
 {$I+} If IOResult <> 0 Then ;
 FtrRelOfs := -1;
 If WinR >= 8 Then
  For K := 0 To Integer(WinR) - 8 Do
   If (WinBuf[K] = $63) And (WinBuf[K + 1] = $6F) And (WinBuf[K + 2] = $6E) And
      (WinBuf[K + 3] = $65) And (WinBuf[K + 4] = $63) And (WinBuf[K + 5] = $74) And
      (WinBuf[K + 6] = $69) And (WinBuf[K + 7] = $78) Then
    FtrRelOfs := K;  { derniere occurrence : le vrai footer, pas une        }
                      { coincidence eventuelle plus tot dans les donnees.    }
 If FtrRelOfs < 0 Then Exit;
 FillChar(Raw, SizeOf(Raw), 0);
 For K := 0 To 511 Do
  If FtrRelOfs + K < WinR Then Raw[K] := WinBuf[FtrRelOfs + K];
 DT := Emu_BufBE32(Raw, 60);
 { "Current Size" est un vrai champ 64 bits BIG-ENDIAN (poids fort a       }
 { l offset 48, poids faible a l offset 52 - specification VHD). L ancien   }
 { code ne lisait QUE le mot faible (offset 52), ignorant totalement le     }
 { mot fort - correct par coincidence pour un disque < 4 Go dont le mot     }
 { fort vaut 0, mais BOGUE REEL (2026-08-22, signale par l utilisateur -    }
 { un vrai VHD eComStation 2.0/OS-2 dont la taille declaree est EXACTEMENT  }
 { 4 Go = 0x100000000) : le mot faible seul y vaut 0 (le mot fort vaut 1),  }
 { l ancien code y voyait donc "0", retombait sur Sz-512 (taille du         }
 { FICHIER sparse, ~1,1 Go), et toute lecture au-dela de ce faux plafond     }
 { (le vrai FNode racine HPFS vit a un secteur bien plus loin) echouait      }
 { silencieusement - meme categorie de bogue que le debordement LongInt      }
 { signe deja corrige pour un disque de 2 Go exactement, mais a la          }
 { frontiere 32 bits SUIVANTE (4 Go). EmuFloppySize restant LongWord (32     }
 { bits non signe, max ~4,29 Go) faute d un chantier plus large migrant      }
 { tout le sous-systeme disque vers QWord, un mot fort <>0 est ecrete au     }
 { maximum LongWord plutot que d etre silencieusement tronque/enveloppe -    }
 { perd au plus le tout dernier secteur adressable, sans consequence        }
 { pratique pour ce sous-systeme (deja borne par ailleurs a 1024 cylindres  }
 { CHS classiques). }
 CurSzHi := Emu_BufBE32(Raw, 48);
 CurSz := Emu_BufBE32(Raw, 52);
 If (CurSzHi = 0) And (CurSz = 0) Then CurSz := Sz - 512
 Else If CurSzHi <> 0 Then CurSz := -1;  { motif de bits FFFFFFFF, voir     }
                                          { LongWord(CurSz) plus bas -      }
                                          { max LongWord ~4,29 Go.          }
 If DT = 2 Then Begin
  EmuFloppyKind[Idx] := 1;
  EmuFloppySize[Idx] := LongWord(CurSz);
  Exit;
 End;
 If (DT = 3) Or (DT = 4) Then Begin
  HdrOfs := Emu_BufBE32(Raw, 20);
  {$I-}
  Seek(EmuFloppyFile[Idx], HdrOfs);
  R := 0;
  BlockRead(EmuFloppyFile[Idx], Raw, 512, R);
  {$I+} If IOResult <> 0 Then ;
  If R <> 512 Then Exit;
  If (Raw[0] <> $63) Or (Raw[1] <> $78) Or (Raw[2] <> $73) Or (Raw[3] <> $70) Or
     (Raw[4] <> $61) Or (Raw[5] <> $72) Or (Raw[6] <> $73) Or (Raw[7] <> $65) Then Exit;
  BAToff  := Emu_BufBE32(Raw, 20);
  BlockSz := Emu_BufBE32(Raw, 32);
  If (BlockSz = 0) Or (BlockSz Mod 512 <> 0) Then Exit;
  EmuFloppyKind[Idx]       := 2;
  EmuFloppySize[Idx]       := LongWord(CurSz);
  EmuFloppyBlockSec[Idx]   := BlockSz Div 512;
  EmuFloppyBitmapSecs[Idx] := ((EmuFloppyBlockSec[Idx] Div 8) + 511) Div 512;
  If EmuFloppyBitmapSecs[Idx] < 1 Then EmuFloppyBitmapSecs[Idx] := 1;
  EmuFloppyBATFileOfs[Idx] := BAToff;
  Exit;
 End;
End;

{ Lire un secteur logique (LBA, disque entier) de l unite Idx en
  traduisant a travers le conteneur (VHD/VMDK) si necessaire. Pour
  un bloc/grain non alloue (VHD dynamique/VMDK sparse), renvoie un
  secteur a zero (comportement standard : zone jamais ecrite). }
Function Emu_ImageReadSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean;
Var
 R: Word;
 Ofs, BlockIdx, OfsInBlock, BATEntry: LongInt;
 GrainNum, GTIdx, GTOff, GTSec, GrainSec: LongInt;
 Buf4: Array[0..3] Of Byte;
Begin
 Emu_ImageReadSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If LBA < 0 Then Exit;
 If LBA >= (EmuFloppySize[Idx] Div 512) Then Exit;
 Case EmuFloppyKind[Idx] Of
  2: Begin
   BlockIdx   := LBA Div EmuFloppyBlockSec[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + BlockIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   BATEntry := (LongInt(Buf4[0]) Shl 24) Or (LongInt(Buf4[1]) Shl 16) Or
               (LongInt(Buf4[2]) Shl 8) Or LongInt(Buf4[3]);
   If BATEntry = -1 Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   Ofs := (BATEntry + EmuFloppyBitmapSecs[Idx]) * 512 + OfsInBlock * 512;
  End;
  3: Begin
   GrainNum   := LBA Div EmuFloppyBlockSec[Idx];
   GTIdx      := GrainNum Div EmuFloppyGTEsPerGT[Idx];
   GTOff      := GrainNum Mod EmuFloppyGTEsPerGT[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + GTIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   GTSec := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
            (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   If GTSec = 0 Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   {$I-}
   Seek(EmuFloppyFile[Idx], GTSec * 512 + GTOff * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   GrainSec := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
               (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   If GrainSec = 0 Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   Ofs := GrainSec * 512 + OfsInBlock * 512;
  End;
  4: Begin { VDI VirtualBox : block map -> INDEX de bloc (pas un offset  }
            { ni un numero de secteur), voir Emu_DiskDetectFormat.       }
   BlockIdx   := LBA Div EmuFloppyBlockSec[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + BlockIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   BATEntry := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
               (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   { $FFFFFFFF (jamais alloue) et $FFFFFFFE (alloue-mais-zero) se lisent
     tous deux comme un secteur a zero. }
   If (BATEntry = -1) Or (BATEntry = -2) Then Begin
    FillChar(Buf, 512, 0);
    Emu_ImageReadSector := True;
    Exit;
   End;
   Ofs := EmuFloppyDataOfs[Idx] + BATEntry * (EmuFloppyBlockSec[Idx] * 512) +
          OfsInBlock * 512;
  End;
 Else
  Ofs := LBA * 512;     { 0=brut, 1=VHD fixe : disposition identique }
 End;
 {$I-}
 Seek(EmuFloppyFile[Idx], Ofs);
 If IOResult <> 0 Then Exit;
 R := 0;
 BlockRead(EmuFloppyFile[Idx], Buf, 512, R);
 {$I+} If IOResult <> 0 Then Exit;
 If R = 512 Then Begin
  If (Buf[510] = $55) And (Buf[511] = $AA) And
     ((Buf[0] = $EB) Or (Buf[0] = $E9)) Then Begin
   If (Buf[24] = 0) And (Buf[25] = 0) And (EmuFloppySpt[Idx] > 0) Then Begin
    Buf[24] := Byte(EmuFloppySpt[Idx] And $FF);
    Buf[25] := Byte((EmuFloppySpt[Idx] Shr 8) And $FF);
   End;
   If (Buf[26] = 0) And (Buf[27] = 0) And (EmuFloppyHeads[Idx] > 0) Then Begin
    Buf[26] := Byte(EmuFloppyHeads[Idx] And $FF);
    Buf[27] := Byte((EmuFloppyHeads[Idx] Shr 8) And $FF);
   End;
  End;
  Emu_ImageReadSector := True;
 End;
End;

{ Ecrire un secteur logique (LBA, disque entier) de l unite Idx.
  Comme DISKPC.PAS, l ecriture sur un bloc/grain non alloue d une
  image VHD dynamique/VMDK sparse est refusee (pas d allocation de
  nouveaux blocs) ; seuls le brut et le VHD fixe l autorisent. }
Function Emu_ImageWriteSector(Idx: Byte; LBA: LongInt;
 Var Buf: Array Of Byte): Boolean;
Var
 W, R: Word;
 Ofs, BlockIdx, OfsInBlock, BATEntry: LongInt;
 GrainNum, GTIdx, GTOff, GTSec, GrainSec: LongInt;
 Buf4: Array[0..3] Of Byte;
Begin
 Emu_ImageWriteSector := False;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If EmuFloppyRO[Idx] Then Exit;
 If LBA < 0 Then Exit;
 If LBA >= (EmuFloppySize[Idx] Div 512) Then Exit;
 Case EmuFloppyKind[Idx] Of
  2: Begin
   BlockIdx   := LBA Div EmuFloppyBlockSec[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + BlockIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Exit;
   BATEntry := (LongInt(Buf4[0]) Shl 24) Or (LongInt(Buf4[1]) Shl 16) Or
               (LongInt(Buf4[2]) Shl 8) Or LongInt(Buf4[3]);
   If BATEntry = -1 Then Exit;
   Ofs := (BATEntry + EmuFloppyBitmapSecs[Idx]) * 512 + OfsInBlock * 512;
  End;
  3: Begin
   GrainNum   := LBA Div EmuFloppyBlockSec[Idx];
   GTIdx      := GrainNum Div EmuFloppyGTEsPerGT[Idx];
   GTOff      := GrainNum Mod EmuFloppyGTEsPerGT[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + GTIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Exit;
   GTSec := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
            (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   If GTSec = 0 Then Exit;
   {$I-}
   Seek(EmuFloppyFile[Idx], GTSec * 512 + GTOff * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Exit;
   GrainSec := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
               (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   If GrainSec = 0 Then Exit;
   Ofs := GrainSec * 512 + OfsInBlock * 512;
  End;
  4: Begin { VDI VirtualBox - voir Emu_ImageReadSector pour le detail. }
   BlockIdx   := LBA Div EmuFloppyBlockSec[Idx];
   OfsInBlock := LBA Mod EmuFloppyBlockSec[Idx];
   {$I-}
   Seek(EmuFloppyFile[Idx], EmuFloppyBATFileOfs[Idx] + BlockIdx * 4);
   R := 0;
   BlockRead(EmuFloppyFile[Idx], Buf4, 4, R);
   {$I+} If (IOResult <> 0) Or (R <> 4) Then Exit;
   BATEntry := LongInt(Buf4[0]) Or (LongInt(Buf4[1]) Shl 8) Or
               (LongInt(Buf4[2]) Shl 16) Or (LongInt(Buf4[3]) Shl 24);
   If (BATEntry = -1) Or (BATEntry = -2) Then Exit;
   Ofs := EmuFloppyDataOfs[Idx] + BATEntry * (EmuFloppyBlockSec[Idx] * 512) +
          OfsInBlock * 512;
  End;
 Else
  Ofs := LBA * 512;
 End;
 {$I-}
 Seek(EmuFloppyFile[Idx], Ofs);
 If IOResult <> 0 Then Exit;
 W := 0;
 BlockWrite(EmuFloppyFile[Idx], Buf, 512, W);
 {$I+} If IOResult <> 0 Then Exit;
 Emu_ImageWriteSector := (W = 512);
End;

Procedure Emu_FloppyOpenOne(Idx: Byte; FName: String);
Var
 Sz: LongInt;
Begin
 EmuFloppyOpen[Idx]  := False;
 EmuFloppyName[Idx]  := '';
 EmuFloppySize[Idx]  := 0;
 EmuFloppyCyls[Idx]  := 0;
 EmuFloppyHeads[Idx] := 0;
 EmuFloppySpt[Idx]   := 0;
 EmuFloppyType[Idx]  := 0;
 EmuFloppyRO[Idx]    := False;
 If FName = '' Then Exit;
 If Not Emu_FloppyIsRaw(FName) Then Exit;
 {$I-}
 Assign(EmuFloppyFile[Idx], FName);
 FileMode := 2;          { read/write }
 Reset(EmuFloppyFile[Idx], 1);
 If IOResult <> 0 Then Begin
  FileMode := 0;
  Assign(EmuFloppyFile[Idx], FName);
  Reset(EmuFloppyFile[Idx], 1);
  If IOResult <> 0 Then Begin
   FileMode := 0;
   WriteLn('DEVENV: impossible d ouvrir l image disque : ', FName);
   Exit;
  End;
  EmuFloppyRO[Idx] := True;
 End;
 FileMode := 0;
 Sz := FileSize(EmuFloppyFile[Idx]);
 {$I+} If IOResult <> 0 Then ;
 EmuFloppyName[Idx] := FName;
 EmuFloppySize[Idx] := Sz;
 Emu_FloppyDetectGeom(Sz,
  EmuFloppyCyls[Idx], EmuFloppyHeads[Idx],
  EmuFloppySpt[Idx],  EmuFloppyType[Idx]);
 EmuFloppyOpen[Idx] := True;
End;

{ Afficher un diagnostic de montage pour l unite Idx (console), utile
  pour comprendre pourquoi une image /DISK0../DISK81 n est pas
  reconnue comme volume FAT par le terminal integre. }
Procedure Emu_ReportDiskMount(Idx: Byte);
Begin
 If Not EmuFloppyOpen[Idx] Then Exit;
 Write('DEVENV: ', Term_DriveLetterFromIdx(Idx), ': ', EmuFloppyName[Idx]);
 If FatVol[Idx].IsD64 Then
  WriteLn(' -> Commodore 64 (.D64, ', FatVol[Idx].D64Tracks, ' pistes)')
 Else If FatVol[Idx].IsHPFS Then
  { BOGUE REEL (2026-08-22, signale par l utilisateur sur un vrai VHD      }
  { eComStation/OS-2) : cette branche HPFS de Fat_TryMount ne renseigne     }
  { jamais FATType/TotalSectors (champs propres au FAT, sans equivalent    }
  { direct ici) - le Else ci-dessous imprimait donc a tort "FAT0 monte     }
  { (0 secteurs...)" (les deux champs restant a leur valeur par defaut     }
  { FillChar=0) alors que le montage HPFS avait REELLEMENT reussi,         }
  { laissant croire a un echec. }
  WriteLn(' -> HPFS monte (', FatVol[Idx].HPFSPartSize,
   ' secteurs, partition LBA=', FatVol[Idx].PartitionStart, ')')
 Else If FatVol[Idx].Mounted Then
  WriteLn(' -> FAT', FatVol[Idx].FATType, ' monte (',
   FatVol[Idx].TotalSectors, ' secteurs, partition LBA=',
   FatVol[Idx].PartitionStart, ')')
 Else
  WriteLn(' -> ouvert mais aucun systeme de fichiers FAT12/16/32 reconnu',
   ' (DIR/CD/TYPE non disponibles sur cette unite)');
End;

Procedure Emu_FloppyOpenAll;
Begin
 EmuFloppyOpen[0] := False;
 EmuFloppyOpen[1] := False;
 EmuFloppyMotor := 0;
 If Opts.DiskImg0 <> '' Then Emu_FloppyOpenOne(0, Opts.DiskImg0);
 If Opts.DiskImg1 <> '' Then Emu_FloppyOpenOne(1, Opts.DiskImg1);
 { Tenter le mount FAT pour les terminaux (DIR/TYPE/VOL/CD) }
 FatVol[0].Mounted := False;
 FatVol[1].Mounted := False;
 If EmuFloppyOpen[0] Then Begin Fat_TryMount(0); Fat_FindVolLabel(0); End;
 If EmuFloppyOpen[1] Then Begin Fat_TryMount(1); Fat_FindVolLabel(1); End;
 Emu_ReportDiskMount(0);
 Emu_ReportDiskMount(1);
End;

{ BOGUE REEL (2026-08-22, investigation BOOT sur un vrai VHD MS-DOS 6.22) : }
{ un vrai disque de 2009 booté jusqu au chargement d IO.SYS puis restait     }
{ bloque dans une boucle de comparaison FAT/repertoire qui ne se terminait   }
{ jamais - cause tracee a la table de partitions MBR du disque LUI-MEME :   }
{ son entree de partition se termine a CHS cylindre 518/tete 127/secteur    }
{ 63, ce qui implique AU MOINS 128 tetes (convention "grand disque" de      }
{ vieux BIOS pour depasser la barriere des ~528 Mo), alors que              }
{ Emu_HardDiskOpenOne codait en dur 16 tetes pour TOUT disque dur virtuel.  }
{ Avec 16 tetes, seuls les ~528 premiers Mo du disque restent adressables   }
{ via CHS (INT13h AH=02/03) - toute lecture plus profonde (FAT/repertoire   }
{ d une partition de 2 Go) vise donc un secteur physique completement       }
{ different de celui que le disque reel utilise, d ou des donnees           }
{ incoherentes qui RESSEMBLENT a du contenu FAT/repertoire valide sans      }
{ jamais atteindre de fin de chaine reelle. }
{ Deduit la geometrie REELLE (tetes/secteurs-par-piste) d un disque a       }
{ partir de sa PROPRE table de partitions MBR (secteur 0), au lieu de la    }
{ constante fixe utilisee jusqu ici - motif standard (deja utilise a        }
{ l epoque par la plupart des utilitaires de partitionnement compatibles    }
{ DOS) : une partition FDISK se termine TOUJOURS au dernier secteur/piste    }
{ d un cylindre, donc le champ "secteur" du triplet CHS de FIN egale les    }
{ vrais secteurs/piste, et (tete de fin + 1) egale le vrai nombre de tetes. }
{ Retombe sur le format brut (pas de MBR/signature 55AAh, ou table de       }
{ partitions entierement vide - ex. une image FAT sans partitionnement) en  }
{ renvoyant False, laissant Emu_HardDiskOpenOne utiliser son repli 16/63.   }
Function Emu_DetectHardDiskGeometry(Idx: Byte;
 Var HeadsOut, SptOut: Word): Boolean;
Var
 Mbr: Array[0..511] Of Byte;
 Vbr: Array[0..511] Of Byte;
 POfs: Word;
 PType, EndHead, EndSecCylHi: Byte;
 Spt, Heads: Word;
 PLBA: LongInt;
 I: Integer;
Begin
 Emu_DetectHardDiskGeometry := False;
 If Not Emu_ImageReadSector(Idx, 0, Mbr) Then Exit;
 If (Mbr[510] <> $55) Or (Mbr[511] <> $AA) Then Exit;
 For I := 0 To 3 Do Begin
  POfs := 446 + I * 16;
  PType := Mbr[POfs + 4];
  PLBA  := LongInt(Mbr[POfs + 8]) Or (LongInt(Mbr[POfs + 9]) Shl 8) Or
           (LongInt(Mbr[POfs + 10]) Shl 16) Or (LongInt(Mbr[POfs + 11]) Shl 24);
  If (PType <> 0) And (PLBA > 0) Then Begin
   { 1. Tenter de lire la geometrie BPB depuis le secteur de boot VBR (LBA PLBA) }
   If Emu_ImageReadSector(Idx, PLBA, Vbr) Then Begin
    Spt   := Word(Vbr[24]) Or (Word(Vbr[25]) Shl 8);
    Heads := Word(Vbr[26]) Or (Word(Vbr[27]) Shl 8);
    If (Spt >= 1) And (Spt <= 63) And (Heads >= 1) And (Heads <= 255) Then Begin
     HeadsOut := Heads;
     SptOut   := Spt;
     Emu_DetectHardDiskGeometry := True;
     Exit;
    End;
   End;
   { 2. Repli : fin de partition CHS dans la table MBR }
   EndHead     := Mbr[POfs + 5];
   EndSecCylHi := Mbr[POfs + 6];
   Spt   := EndSecCylHi And $3F;
   Heads := Word(EndHead) + 1;
   If (Spt >= 1) And (Spt <= 63) And (Heads >= 1) And (Heads <= 255) Then Begin
    HeadsOut := Heads;
    SptOut   := Spt;
    Emu_DetectHardDiskGeometry := True;
    Exit;
   End;
  End;
 End;
End;

{ Ouvrir une image de disque dur (/DISK80 -> Idx=2, /DISK81 -> Idx=3).
  Contrairement aux disquettes, les conteneurs VHD/VMDK sont acceptes
  (Emu_DiskDetectFormat) ; les disques peuvent aussi porter une table
  de partitions (MBR), detectee plus loin par Fat_TryMount. La geometrie
  CHS reelle est deduite de la table de partitions du disque lui-meme
  (Emu_DetectHardDiskGeometry) quand c est possible, sinon synthetisee
  (16 tetes, 63 secteurs/piste, comme la plupart des BIOS pour les
  disques non standards depourvus de MBR exploitable) a partir de la
  taille virtuelle ; au-dela de 1024 cylindres, seule la zone couverte
  par l adressage CHS classique reste accessible via INT 13h AH=02/03
  (pas d extensions LBA/EDD). }
Procedure Emu_HardDiskOpenOne(Idx: Byte; FName: String);
Var
 Sz: LongInt;
 VirtSec: LongInt;
 DetHeads, DetSpt: Word;
Begin
 EmuFloppyOpen[Idx]  := False;
 EmuFloppyName[Idx]  := '';
 EmuFloppySize[Idx]  := 0;
 EmuFloppyCyls[Idx]  := 0;
 EmuFloppyHeads[Idx] := 0;
 EmuFloppySpt[Idx]   := 0;
 EmuFloppyType[Idx]  := 0;
 EmuFloppyRO[Idx]    := False;
 EmuFloppyKind[Idx]  := 0;
 If FName = '' Then Exit;
 {$I-}
 Assign(EmuFloppyFile[Idx], FName);
 FileMode := 2;          { read/write }
 Reset(EmuFloppyFile[Idx], 1);
 If IOResult <> 0 Then Begin
  FileMode := 0;
  Assign(EmuFloppyFile[Idx], FName);
  Reset(EmuFloppyFile[Idx], 1);
  If IOResult <> 0 Then Begin
   FileMode := 0;
   WriteLn('DEVENV: impossible d ouvrir l image disque : ', FName);
   Exit;
  End;
  EmuFloppyRO[Idx] := True;
 End;
 FileMode := 0;
 Sz := FileSize(EmuFloppyFile[Idx]);
 {$I+} If IOResult <> 0 Then ;
 EmuFloppyName[Idx] := FName;
 EmuFloppySize[Idx] := Sz;
 If Not Emu_DiskDetectFormat(Idx) Then Begin
  {$I-} Close(EmuFloppyFile[Idx]); {$I+} If IOResult <> 0 Then ;
  EmuFloppyName[Idx] := '';
  EmuFloppySize[Idx] := 0;
  Exit;
 End;
 VirtSec := EmuFloppySize[Idx] Div 512;
 If VirtSec < 1 Then Begin
  {$I-} Close(EmuFloppyFile[Idx]); {$I+} If IOResult <> 0 Then ;
  WriteLn('DEVENV: image disque dur vide ou invalide : ', FName);
  EmuFloppyName[Idx] := '';
  EmuFloppySize[Idx] := 0;
  Exit;
 End;
 EmuFloppyHeads[Idx] := 255;
 EmuFloppySpt[Idx]   := 63;
 { Emu_DetectHardDiskGeometry a besoin de EmuFloppyOpen=True pour que      }
 { Emu_ImageReadSector accepte de lire (son tout premier garde-fou) - sans }
 { consequence de l activer un peu plus tot ici puisque tous les champs    }
 { Kind/BAT necessaires viennent d etre remplis par Emu_DiskDetectFormat   }
 { ci-dessus, et Open est de toute facon mis a True inconditionnellement   }
 { a la fin de cette procedure. }
 EmuFloppyOpen[Idx] := True;
 If Emu_DetectHardDiskGeometry(Idx, DetHeads, DetSpt) Then Begin
  If (DetHeads >= 1) And (DetHeads <= 255) Then EmuFloppyHeads[Idx] := DetHeads;
  If (DetSpt >= 1) And (DetSpt <= 63) Then EmuFloppySpt[Idx] := DetSpt;
 End;
 If EmuFloppySize[Idx] > 500 * 1024 * 1024 Then Begin
  EmuFloppyHeads[Idx] := 255;
  EmuFloppySpt[Idx]   := 63;
 End;
 If EmuFloppySpt[Idx] < 1 Then EmuFloppySpt[Idx] := 63;
 If EmuFloppyHeads[Idx] < 1 Then EmuFloppyHeads[Idx] := 16;
 EmuFloppyCyls[Idx]  := Word(VirtSec Div
  (LongInt(EmuFloppyHeads[Idx]) * EmuFloppySpt[Idx]));
 If EmuFloppyCyls[Idx] < 1 Then EmuFloppyCyls[Idx] := 1;
 If EmuFloppyCyls[Idx] > 1024 Then EmuFloppyCyls[Idx] := 1024;
 EmuFloppyOpen[Idx] := True;
End;

Procedure Emu_HardDiskOpenAll;
Begin
 EmuFloppyOpen[2] := False;
 EmuFloppyOpen[3] := False;
 If Opts.DiskImg80 <> '' Then Emu_HardDiskOpenOne(2, Opts.DiskImg80);
 If Opts.DiskImg81 <> '' Then Emu_HardDiskOpenOne(3, Opts.DiskImg81);
 { Tenter le mount FAT pour les terminaux (DIR/TYPE/VOL/CD) ;
   Fat_TryMount detecte lui-meme une eventuelle table de partitions. }
 FatVol[2].Mounted := False;
 FatVol[3].Mounted := False;
 If EmuFloppyOpen[2] Then Begin Fat_TryMount(2); Fat_FindVolLabel(2); End;
 If EmuFloppyOpen[3] Then Begin Fat_TryMount(3); Fat_FindVolLabel(3); End;
 Emu_ReportDiskMount(2);
 Emu_ReportDiskMount(3);
End;

{ ============================================================
  Lecteur ISO9660 en lecture seule pour les CD-ROM montes via
  /CDROM0:/CDROM1: (voir TEmuCdromVol/TEmuIsoEntry) - consulte par
  Emu_DoInt21 (unite CD-ROM) et Emu_DoInt2F AX=15xxh (MSCDEX). Format
  ISO9660 "brut" (secteurs de 2048 octets, Niveau 1/2, systeme de
  fichiers en "d-characters") uniquement - PAS de support Joliet ni
  Rock Ridge (superflu ici : les programmes DOS testes ne voient de
  toute facon que des noms courts 8.3, jamais les noms longs exposes
  par ces extensions). Resolution de chemin par parcours direct des
  enregistrements de repertoire (pas de table des chemins ISO9660 -
  optionnelle dans la specification, simple raccourci de performance
  qu un lecteur correct n a pas besoin d implanter). }

{ Lire le secteur logique LBA (EMU_ISO_SECTOR octets) du volume Idx dans
  Buf. Retourne False si le volume n est pas monte ou en cas d erreur E/S. }
Function Emu_IsoReadLBA(Idx: Byte; LBA: LongInt;
 Var Buf: TEmuIsoSector): Boolean;
Var BytesIO: Word;
Begin
 Emu_IsoReadLBA := False;
 If Not EmuCdrom[Idx].Open Then Exit;
 {$I-}
 Seek(EmuCdrom[Idx].F, LongInt(LBA) * EMU_ISO_SECTOR);
 BlockRead(EmuCdrom[Idx].F, Buf, EMU_ISO_SECTOR, BytesIO);
 {$I+}
 If IOResult <> 0 Then Exit;
 Emu_IsoReadLBA := BytesIO = EMU_ISO_SECTOR;
End;

{ Decoder un enregistrement de repertoire ISO9660 a Buf[Ofs..] dans Entry.
  Retourne False pour un enregistrement vide (fin de la zone utile du
  secteur - le reste est du remplissage jusqu a la fin du secteur, les
  enregistrements ne pouvant pas chevaucher deux secteurs) ou pour les
  entrees speciales "." (identifiant=00h) et ".." (identifiant=01h), que
  l appelant reconstruit lui-meme si necessaire (voir Emu_CdromFindFirst)
  plutot que de les exposer ici. }
Function Emu_IsoEntryFromRecord(Var Buf: TEmuIsoSector; Ofs: Integer;
 Var Entry: TEmuIsoEntry): Boolean;
Var
 IdLen, I, Semi: Integer;
 Raw: String;
Begin
 Emu_IsoEntryFromRecord := False;
 If Buf[Ofs] = 0 Then Exit;
 IdLen := Buf[Ofs + 32];
 If IdLen = 0 Then Exit;
 If (IdLen = 1) And ((Buf[Ofs + 33] = 0) Or (Buf[Ofs + 33] = 1)) Then Exit;
 Raw := '';
 For I := 0 To IdLen - 1 Do
  Raw := Raw + Chr(Buf[Ofs + 33 + I]);
 { Retirer le suffixe ";n" (numero de version, toujours ";1" en pratique  }
 { sur les images produites par les outils modernes). }
 Semi := Pos(';', Raw);
 If Semi > 0 Then Raw := Copy(Raw, 1, Semi - 1);
 { "NOM." (extension vide, forme valide en ISO9660) -> "NOM" }
 If (Length(Raw) > 0) And (Raw[Length(Raw)] = '.') Then
  Raw := Copy(Raw, 1, Length(Raw) - 1);
 Raw := UpCaseStr(Raw);
 { Troncature defensive : le Niveau 2 autorise jusqu a 30 caracteres,     }
 { mais cet emulateur ne reformate pas un nom long en 8.3 "abbrege"      }
 { (algorithme MSCDEX reel non implante ici) - se contente de tronquer.  }
 { Sans effet sur des images conformes au Niveau 1 (8.3 des la gravure). }
 If Length(Raw) > 12 Then Raw := Copy(Raw, 1, 12);
 Entry.IsDir  := (Buf[Ofs + 25] And 2) <> 0;
 Entry.Name   := Raw;
 Entry.LBA    := Emu_BufLE32(Buf, Ofs + 2);
 Entry.Size   := Emu_BufLE32(Buf, Ofs + 10);
 Entry.Year   := Buf[Ofs + 18];
 Entry.Month  := Buf[Ofs + 19];
 Entry.Day    := Buf[Ofs + 20];
 Entry.Hour   := Buf[Ofs + 21];
 Entry.Minute := Buf[Ofs + 22];
 Entry.Second := Buf[Ofs + 23];
 Emu_IsoEntryFromRecord := True;
End;

{ Chercher l entree nommee Name (comparaison insensible a la casse) dans le
  repertoire dont l extent est DirLBA/DirSize (en octets). }
Function Emu_IsoFindInDir(Idx: Byte; DirLBA, DirSize: LongInt;
 Const Name: String; Var Entry: TEmuIsoEntry): Boolean;
Var
 Buf: TEmuIsoSector;
 SecCount, S: LongInt;
 RecOfs: Integer;
 UpName: String;
Begin
 Emu_IsoFindInDir := False;
 UpName := UpCaseStr(Name);
 SecCount := (DirSize + EMU_ISO_SECTOR - 1) Div EMU_ISO_SECTOR;
 For S := 0 To SecCount - 1 Do Begin
  If Not Emu_IsoReadLBA(Idx, DirLBA + S, Buf) Then Exit;
  RecOfs := 0;
  While RecOfs < EMU_ISO_SECTOR - 1 Do Begin
   If Buf[RecOfs] = 0 Then Break; { fin des enregistrements de ce secteur }
   If Emu_IsoEntryFromRecord(Buf, RecOfs, Entry) Then
    If UpCaseStr(Entry.Name) = UpName Then Begin
     Emu_IsoFindInDir := True;
     Exit;
    End;
   Inc(RecOfs, Buf[RecOfs]);
  End;
 End;
End;

{ Resoudre un chemin DOS ("\SOUSREP\FICHIER.EXT", sans lettre de lecteur -
  voir Emu_CdromDriveFromPath qui la retire avant l appel ; "" = racine)
  dans le volume ISO9660 Idx. Retourne True et remplit Entry si trouve. }
Function Emu_IsoResolve(Idx: Byte; DosPath: String;
 Var Entry: TEmuIsoEntry): Boolean;
Var
 Seg: String;
 P: Integer;
 CurLBA, CurSize: LongInt;
Begin
 Emu_IsoResolve := False;
 If Not EmuCdrom[Idx].Open Then Exit;
 For P := 1 To Length(DosPath) Do
  If DosPath[P] = '/' Then DosPath[P] := '\';
 While (Length(DosPath) > 0) And (DosPath[1] = '\') Do Delete(DosPath, 1, 1);
 CurLBA := EmuCdrom[Idx].RootLBA;
 CurSize := EmuCdrom[Idx].RootSize;
 If DosPath = '' Then Begin
  Entry.IsDir := True; Entry.Name := '';
  Entry.LBA := CurLBA; Entry.Size := CurSize;
  Entry.Year := 100; Entry.Month := 1; Entry.Day := 1;
  Entry.Hour := 0; Entry.Minute := 0; Entry.Second := 0;
  Emu_IsoResolve := True;
  Exit;
 End;
 While DosPath <> '' Do Begin
  P := Pos('\', DosPath);
  If P = 0 Then Begin Seg := DosPath; DosPath := ''; End
  Else Begin Seg := Copy(DosPath, 1, P - 1); Delete(DosPath, 1, P); End;
  If Not Emu_IsoFindInDir(Idx, CurLBA, CurSize, Seg, Entry) Then Exit;
  If DosPath <> '' Then Begin
   If Not Entry.IsDir Then Exit; { segment intermediaire non-repertoire }
   CurLBA := Entry.LBA; CurSize := Entry.Size;
  End;
 End;
 Emu_IsoResolve := True;
End;

{ Monter Idx (0 ou 1) depuis l image ISO FName - lit le Volume Descriptor
  Primaire (secteur logique 16, le premier apres la "zone systeme"
  reservee de 16 secteurs) et en extrait l extent racine, l etiquette de
  volume et les 3 noms de fichiers "documentaires" (copyright/abstract/
  bibliographique, voir Emu_DoInt2F AX=1502h/1503h/1504h). }
Procedure Emu_CdromOpenOne(Idx: Byte; FName: String);
Var
 Buf: TEmuIsoSector;
 I: Integer;
Begin
 EmuCdrom[Idx].Open := False;
 EmuCdrom[Idx].FileName := '';
 EmuCdrom[Idx].DriveLetter := 255;
 If FName = '' Then Exit;
 {$I-}
 Assign(EmuCdrom[Idx].F, FName);
 FileMode := 0;  { lecture seule - un CD-ROM ne s ecrit jamais }
 Reset(EmuCdrom[Idx].F, 1);
 {$I+}
 If IOResult <> 0 Then Begin
  WriteLn('DEVENV: impossible d ouvrir l image CD-ROM : ', FName);
  Exit;
 End;
 EmuCdrom[Idx].IsoSize := FileSize(EmuCdrom[Idx].F);
 { Emu_IsoReadLBA exige EmuCdrom[Idx].Open=True pour accepter de lire -   }
 { l activer des maintenant (desactive plus bas en cas d echec). }
 EmuCdrom[Idx].Open := True;
 If Not Emu_IsoReadLBA(Idx, 16, Buf) Then Begin
  EmuCdrom[Idx].Open := False;
  {$I-} Close(EmuCdrom[Idx].F); {$I+} If IOResult <> 0 Then ;
  WriteLn('DEVENV: image CD-ROM trop petite ou illisible : ', FName);
  Exit;
 End;
 If (Buf[0] <> 1) Or (Chr(Buf[1]) <> 'C') Or (Chr(Buf[2]) <> 'D') Or
    (Chr(Buf[3]) <> '0') Or (Chr(Buf[4]) <> '0') Or (Chr(Buf[5]) <> '1') Then Begin
  EmuCdrom[Idx].Open := False;
  {$I-} Close(EmuCdrom[Idx].F); {$I+} If IOResult <> 0 Then ;
  WriteLn('DEVENV: pas un volume ISO9660 valide (PVD introuvable) : ', FName);
  Exit;
 End;
 { Le repertoire racine porte l identifiant special "." (00h) : passer   }
 { directement par Emu_BufLE32 plutot que par Emu_IsoEntryFromRecord,    }
 { qui exclut expres ce cas (voir son commentaire d en-tete). }
 EmuCdrom[Idx].RootLBA  := Emu_BufLE32(Buf, 156 + 2);
 EmuCdrom[Idx].RootSize := Emu_BufLE32(Buf, 156 + 10);
 EmuCdrom[Idx].VolLabel := '';
 For I := 40 To 71 Do
  If Buf[I] <> 32 Then EmuCdrom[Idx].VolLabel := EmuCdrom[Idx].VolLabel + Chr(Buf[I])
  Else Break;
 EmuCdrom[Idx].CopyrightFile := '';
 For I := 702 To 739 Do
  If Buf[I] <> 32 Then EmuCdrom[Idx].CopyrightFile := EmuCdrom[Idx].CopyrightFile + Chr(Buf[I])
  Else Break;
 EmuCdrom[Idx].AbstractFile := '';
 For I := 740 To 776 Do
  If Buf[I] <> 32 Then EmuCdrom[Idx].AbstractFile := EmuCdrom[Idx].AbstractFile + Chr(Buf[I])
  Else Break;
 EmuCdrom[Idx].BiblioFile := '';
 For I := 777 To 813 Do
  If Buf[I] <> 32 Then EmuCdrom[Idx].BiblioFile := EmuCdrom[Idx].BiblioFile + Chr(Buf[I])
  Else Break;
 EmuCdrom[Idx].FileName := FName;
End;

{ Recalcule les lettres de lecteur CD-ROM (D: puis E:, uniquement pour les }
{ unites REELLEMENT montees) - extrait de Emu_CdromOpenAll ci-dessous       }
{ (2026-08-30) pour etre REUTILISE tel quel par Add-VMDvdDrive (terminal,   }
{ montage a chaud en cours de session) sans dupliquer cette logique. }
Procedure Emu_CdromAssignDriveLetters;
Begin
 If EmuCdrom[0].Open Then EmuCdrom[0].DriveLetter := 3;  { D: }
 If EmuCdrom[1].Open Then Begin
  If EmuCdrom[0].Open Then EmuCdrom[1].DriveLetter := 4  { E: }
  Else EmuCdrom[1].DriveLetter := 3;                     { D: }
 End;
End;

{ Monter les 2 lecteurs CD-ROM depuis Opts.CdromImg0/1 (appelee une seule
  fois au demarrage de l IDE, comme Emu_FloppyOpenAll/Emu_HardDiskOpenAll -
  un CD-ROM monte reste insere pour toute la session, independamment des
  demarrages/arrets de l emulateur DOS, exactement comme un vrai lecteur).
  Les lettres de lecteur sont assignees de facon contigue a partir de D:,
  uniquement aux unites reellement montees (voir Emu_DoInt2F AX=1500h). }
Procedure Emu_CdromOpenAll;
Begin
 Emu_CdromOpenOne(0, Opts.CdromImg0);
 Emu_CdromOpenOne(1, Opts.CdromImg1);
 Emu_CdromAssignDriveLetters;
 If EmuCdrom[0].Open Then
  WriteLn('DEVENV: ', Chr(65 + EmuCdrom[0].DriveLetter), ': ', Opts.CdromImg0,
   ' -> CD-ROM ISO9660 "', EmuCdrom[0].VolLabel, '"');
 If EmuCdrom[1].Open Then
  WriteLn('DEVENV: ', Chr(65 + EmuCdrom[1].DriveLetter), ': ', Opts.CdromImg1,
   ' -> CD-ROM ISO9660 "', EmuCdrom[1].VolLabel, '"');
End;

{ Si DosName commence par "X:" ou X est la lettre d un lecteur CD-ROM     }
{ monte, retourne True, Idx=son index EmuCdrom et Rel=le reste du chemin  }
{ (sans la lettre ni le ":"). Utilise par Emu_DoInt21 pour intercepter    }
{ les operations fichier AVANT qu elles n atteignent Emu_HostPath, qui ne }
{ connait aucune notion de lecteur. }
Function Emu_CdromDriveFromPath(Const DosName: String; Var Idx: Integer;
 Var Rel: String): Boolean;
Var Letter: Char;
Begin
 Emu_CdromDriveFromPath := False;
 If (Length(DosName) < 2) Or (DosName[2] <> ':') Then Exit;
 Letter := UpCase(DosName[1]);
 If EmuCdrom[0].Open And (Chr(65 + EmuCdrom[0].DriveLetter) = Letter) Then Idx := 0
 Else If EmuCdrom[1].Open And (Chr(65 + EmuCdrom[1].DriveLetter) = Letter) Then Idx := 1
 Else Exit;
 Rel := Copy(DosName, 3, Length(DosName) - 2);
 Emu_CdromDriveFromPath := True;
End;

{ Ouvrir en lecture un fichier du volume CD-ROM Idx (chemin Rel deja      }
{ debarrasse de sa lettre de lecteur, voir Emu_CdromDriveFromPath) sur le }
{ handle H (alloue via Emu_AllocHandle par l appelant). Retourne un code   }
{ d erreur DOS standard (0=succes, 2=introuvable, 5=acces refuse si c est }
{ un repertoire, la encore comme pour un vrai fichier hote). }
Function Emu_CdromOpenFile(Idx: Integer; Const Rel: String; H: Integer): Word;
Var Entry: TEmuIsoEntry;
Begin
 If Not Emu_IsoResolve(Idx, Rel, Entry) Then Begin Emu_CdromOpenFile := 2; Exit; End;
 If Entry.IsDir Then Begin Emu_CdromOpenFile := 5; Exit; End;
 EmuFileOpen[H]    := True;
 EmuFileIsCdrom[H] := True;
 EmuFileFirstRd[H] := False;
 EmuCdFileVol[H]  := Idx;
 EmuCdFileLBA[H]  := Entry.LBA;
 EmuCdFileSize[H] := Entry.Size;
 EmuCdFilePos[H]  := 0;
 Emu_CdromOpenFile := 0;
End;

{ Lire jusqu a Count octets du handle CD-ROM H a partir de sa position     }
{ courante (EmuCdFilePos[H]) vers DS:Ofs du CPU emule, en traversant au    }
{ besoin plusieurs secteurs logiques - meme forme de retour (nombre reel   }
{ d octets lus) que la boucle BlockRead de l AH=3Fh existant. }
Function Emu_CdromReadFile(Var P: TEmulatorPanel; H: Integer;
 GuestOfs: Word; Count: Word): Word;
Var
 Idx: Integer;
 Remain, ToRead, ChunkLen, LBA, SecOfs: LongInt;
 Buf: TEmuIsoSector;
 GotTotal: Word;
 W: Integer;
Begin
 Idx := EmuCdFileVol[H];
 Remain := EmuCdFileSize[H] - EmuCdFilePos[H];
 If Remain < 0 Then Remain := 0;
 ToRead := Count;
 If ToRead > Remain Then ToRead := Remain;
 GotTotal := 0;
 While ToRead > 0 Do Begin
  LBA := EmuCdFileLBA[H] + (EmuCdFilePos[H] Div EMU_ISO_SECTOR);
  SecOfs := EmuCdFilePos[H] Mod EMU_ISO_SECTOR;
  If Not Emu_IsoReadLBA(Idx, LBA, Buf) Then Break;
  ChunkLen := EMU_ISO_SECTOR - SecOfs;
  If ChunkLen > ToRead Then ChunkLen := ToRead;
  For W := 0 To ChunkLen - 1 Do
   Emu_WriteByte(P.CPU, P.CPU.Segs.DS, Word(GuestOfs + GotTotal + W),
    Buf[SecOfs + W]);
  Inc(EmuCdFilePos[H], ChunkLen);
  Inc(GotTotal, ChunkLen);
  Dec(ToRead, ChunkLen);
 End;
 Emu_CdromReadFile := GotTotal;
End;

{ Convertir une date ISO9660 decodee (Emu_IsoEntryFromRecord) en date/heure}
{ DOS empaquetee (meme format que SR.Time apres decoupage 16 bits haut/bas }
{ utilise par l AH=4Eh existant - voir Emu_PackDate/Emu_PackTime). }
Procedure Emu_IsoDateToDos(Const Entry: TEmuIsoEntry; Var DDate, DTime: Word);
Var Y: Word;
Begin
 Y := Word(Entry.Year) + 1900;
 If Y < 1980 Then Y := 1980;
 DDate := Emu_PackDate(Y, Entry.Month, Entry.Day);
 DTime := Emu_PackTime(Entry.Hour, Entry.Minute, Entry.Second);
End;

{ Correspondance de motif DOS classique ('*' et '?', insensible a la      }
{ casse) - algorithme iteratif standard avec point de reprise sur le      }
{ dernier '*' rencontre (pas de recursion, donc pas de limite de          }
{ profondeur liee a la pile). }
Function Emu_DosWildMatch(Const Name, Pattern: String): Boolean;
Var
 NI, PI, StarNI, StarPI: Integer;
Begin
 NI := 1; PI := 1; StarPI := 0; StarNI := 0;
 While NI <= Length(Name) Do Begin
  If (PI <= Length(Pattern)) And
     ((Pattern[PI] = '?') Or (UpCase(Pattern[PI]) = UpCase(Name[NI]))) Then Begin
   Inc(NI); Inc(PI);
  End Else If (PI <= Length(Pattern)) And (Pattern[PI] = '*') Then Begin
   StarPI := PI; StarNI := NI;
   Inc(PI);
  End Else If StarPI > 0 Then Begin
   Inc(StarNI);
   NI := StarNI;
   PI := StarPI + 1;
  End Else Begin
   Emu_DosWildMatch := False;
   Exit;
  End;
 End;
 While (PI <= Length(Pattern)) And (Pattern[PI] = '*') Do Inc(PI);
 Emu_DosWildMatch := PI > Length(Pattern);
End;

{ FindFirst ($4E) pour un repertoire resolu (DirRel) sur un lecteur       }
{ CD-ROM, filtre par le motif DOS Pattern (nom de fichier seul, sans      }
{ chemin - voir Emu_DosWildMatch) : enumere le repertoire dans            }
{ EmuFindResults/EmuCdFind* comme le fait l AH=4Eh existant via l hote.   }
{ Retourne False si le repertoire est introuvable ou vide apres filtrage. }
Function Emu_CdromFindFirst(Idx: Integer; Const DirRel, Pattern: String): Boolean;
Var
 DirEntry: TEmuIsoEntry;
 Buf: TEmuIsoSector;
 SecCount, S: LongInt;
 RecOfs: Integer;
 Entry: TEmuIsoEntry;
Begin
 Emu_CdromFindFirst := False;
 EmuFindCount := 0;
 EmuFindIndex := 0;
 If Not Emu_IsoResolve(Idx, DirRel, DirEntry) Then Exit;
 If Not DirEntry.IsDir Then Exit;
 SecCount := (DirEntry.Size + EMU_ISO_SECTOR - 1) Div EMU_ISO_SECTOR;
 For S := 0 To SecCount - 1 Do Begin
  If Not Emu_IsoReadLBA(Idx, DirEntry.LBA + S, Buf) Then Break;
  RecOfs := 0;
  While RecOfs < EMU_ISO_SECTOR - 1 Do Begin
   If Buf[RecOfs] = 0 Then Break;
   If Emu_IsoEntryFromRecord(Buf, RecOfs, Entry) And (EmuFindCount < 64) And
      Emu_DosWildMatch(Entry.Name, Pattern) Then Begin
    EmuFindResults[EmuFindCount] := Entry.Name;
    EmuCdFindSize[EmuFindCount]  := Entry.Size;
    EmuCdFindIsDir[EmuFindCount] := Entry.IsDir;
    Emu_IsoDateToDos(Entry, EmuCdFindDate[EmuFindCount], EmuCdFindTime[EmuFindCount]);
    Inc(EmuFindCount);
   End;
   Inc(RecOfs, Buf[RecOfs]);
  End;
 End;
 EmuFindIsCdrom := True;
 Emu_CdromFindFirst := EmuFindCount > 0;
End;

{ ============================================================
  Gestion individuelle d un emplacement (0=A: 1=B: 2=C: 3=D:) pour
  le dialogue Outils > Disque virtuel. Equivalent fonctionnel des
  parametres /DISK0:, /DISK1:, /DISK80: et /DISK81: au demarrage. }

{ Demonter l unite Idx (ferme le fichier, sans toucher aux autres). }
Procedure Emu_FloppyCloseOne(Idx: Byte);
Begin
 If EmuFloppyOpen[Idx] Then Begin
  {$I-} Close(EmuFloppyFile[Idx]); {$I+} If IOResult <> 0 Then ;
  EmuFloppyOpen[Idx] := False;
 End;
 EmuFloppyName[Idx] := '';
 EmuFloppySize[Idx] := 0;
 FatVol[Idx].Mounted := False;
End;

{ Synchroniser Opts.DiskImgN avec l emplacement Idx, pour rester
  coherent avec les parametres /DISK0:/DISK1:/DISK80:/DISK81: passes
  en ligne de commande. }
Procedure Emu_SetDiskOpt(Idx: Byte; FName: String);
Begin
 Case Idx Of
  0: Opts.DiskImg0  := FName;
  1: Opts.DiskImg1  := FName;
  2: Opts.DiskImg80 := FName;
  3: Opts.DiskImg81 := FName;
 End;
End;

{ Monter (ou remonter) l image FName sur l emplacement Idx : ferme
  l ancien fichier s il y en a un, ouvre le nouveau (disquette pour
  0/1 via Emu_FloppyOpenOne, disque dur pour 2/3 via
  Emu_HardDiskOpenOne), tente le montage FAT et synchronise
  Opts.DiskImgN. Retourne False si l ouverture du fichier echoue. }
Function Emu_MountDiskSlot(Idx: Byte; FName: String): Boolean;
Begin
 Emu_FloppyCloseOne(Idx);
 If Idx < 2 Then Emu_FloppyOpenOne(Idx, FName)
            Else Emu_HardDiskOpenOne(Idx, FName);
 If EmuFloppyOpen[Idx] Then Begin
  Fat_TryMount(Idx);
  Fat_FindVolLabel(Idx);
  Emu_SetDiskOpt(Idx, FName);
  Emu_MountDiskSlot := True;
 End Else Begin
  Emu_SetDiskOpt(Idx, '');
  Emu_MountDiskSlot := False;
 End;
End;

{ Demonter l emplacement Idx et synchroniser Opts.DiskImgN (= ''). }
Procedure Emu_UnmountDiskSlot(Idx: Byte);
Begin
 Emu_FloppyCloseOne(Idx);
 Emu_SetDiskOpt(Idx, '');
End;

Procedure Emu_FloppyCloseAll;
Var
 I: Byte;
Begin
 For I := 0 To 3 Do
  Emu_FloppyCloseOne(I);
End;

{ Convertir un triplet CHS en LBA (offset secteur) selon la geometrie
  de l unite Idx. Retourne -1 si CHS hors limites. }
 Function Emu_FloppyCHS2LBA(Idx: Byte; Cyl, Head, Sect: Word): LongInt;
Var
 LBA: LongInt;
 TotalSec: LongInt;
 H, S: Word;
Begin
 Emu_FloppyCHS2LBA := -1;
 If Not EmuFloppyOpen[Idx] Then Exit;
 H := EmuFloppyHeads[Idx]; If H < 1 Then H := 255;
 S := EmuFloppySpt[Idx];   If S < 1 Then S := 63;
 If (Sect < 1) Or (Sect > S) Then Exit;
 If Head >= H Then Exit;
 LBA := ((LongInt(Cyl) * H) + Head) * S + (Sect - 1);
 TotalSec := EmuFloppySize[Idx] Div 512;
 If (LBA < 0) Or (LBA >= TotalSec) Then Exit;
 Emu_FloppyCHS2LBA := LBA;
End;

{ Lire NSect secteurs depuis l image Idx vers la memoire emulee
  ES:BX. Retourne le nombre de secteurs effectivement lus. }
Function Emu_FloppyReadSectors(Var P: TEmulatorPanel; Idx: Byte;
 LBA: LongInt; NSect: Word; Seg, Ofs: Word): Word;
Var
 SBuf: Array[0..511] Of Byte;
 N: Word;
 J: Integer;
 PhysAddr: LongInt;
 WriteSeg, WriteOfs: Word;
Begin
 Emu_FloppyReadSectors := 0;
 If Not EmuFloppyOpen[Idx] Then Exit;
 N := 0;
 While N < NSect Do Begin
  If Not Emu_ImageReadSector(Idx, LBA + N, SBuf) Then Break;
  { Le BIOS fait progresser l adresse physique du buffer ; un simple
    enveloppement de l offset a 16 bits corrompt les chargements a cheval
    sur 64 Ko (cas frequent pour IO.SYS/MSDOS.SYS). }
  PhysAddr := (LongInt(Seg) Shl 4) + Ofs + LongInt(N) * 512;
  WriteSeg := Word(PhysAddr Shr 4);
  WriteOfs := Word(PhysAddr And $000F);
  For J := 0 To 511 Do Begin
   Emu_WriteByte(P.CPU, WriteSeg, WriteOfs, SBuf[J]);
   Inc(WriteOfs);
  If WriteOfs = 0 Then Inc(WriteSeg);
  End;
  Inc(N);
 End;
 Emu_FloppyReadSectors := N;
End;

{ Ecrire NSect secteurs depuis ES:BX vers l image Idx. Retourne le
  nombre de secteurs effectivement ecrits. }
Function Emu_FloppyWriteSectors(Var P: TEmulatorPanel; Idx: Byte;
 LBA: LongInt; NSect: Byte; Seg, Ofs: Word): Byte;
Var
 SBuf: Array[0..511] Of Byte;
 N: Byte;
 J: Integer;
Begin
 Emu_FloppyWriteSectors := 0;
 If Not EmuFloppyOpen[Idx] Then Exit;
 If EmuFloppyRO[Idx] Then Exit;
 N := 0;
 While N < NSect Do Begin
  For J := 0 To 511 Do
   SBuf[J] := Emu_ReadByte(P.CPU, Seg, Word(Ofs + LongInt(N) * 512 + J));
  If Not Emu_ImageWriteSector(Idx, LBA + N, SBuf) Then Break;
  Inc(N);
 End;
 Emu_FloppyWriteSectors := N;
End;

{ Compter le nombre d unites floppy disponibles (0..2). }
Function Emu_FloppyCount: Byte;
Var N: Byte;
Begin
 N := 0;
 If EmuFloppyOpen[0] Then Inc(N);
 If EmuFloppyOpen[1] Then Inc(N);
 Emu_FloppyCount := N;
End;

{ ============================================================
  INT 13h : BIOS Disk Services (disquettes A:/B: et disques durs
  C:/D: montes via /DISK0, /DISK1, /DISK80, /DISK81)
  ============================================================
  DL = numero d unite (00=A:, 01=B:, 80=C:, 81=D:). Services
  supportes :
   AH=00 Reset disk system
   AH=01 Get status
   AH=02 Read sectors  (CHS dans CH/CL/DH/DL, AL=N, ES:BX)
   AH=03 Write sectors
   AH=04 Verify sectors
   AH=05 Format track (stub)
   AH=08 Get drive parameters
   AH=15 Get disk type
   AH=16 Detect disk change
   AH=17 Set DASD type
   AH=18 Set media type for format
  CF=0 et AH=00 si succes. CF=1 et AH=code d erreur sinon.
  Pas d extensions LBA/EDD (AH=41h/42h/...) : seul l acces CHS
  classique est emule, comme pour les disquettes. }
Var
 EmuFloppyLastStatus: Array[0..3] Of Byte;

{ Traduire DL (numero d unite BIOS) en index 0..3 dans les tableaux
  EmuFloppy*/FatVol : 00h/01h -> 0/1 (A:/B:), 80h/81h -> 2/3 (C:/D:).
  Retourne False si DL ne correspond a aucune unite supportee. }
Function Emu_DiskIdxFromDL(DL: Byte; Var Idx: Byte): Boolean;
Begin
 Emu_DiskIdxFromDL := True;
 If (DL And $80) <> 0 Then Begin
  If (DL And $7F) > 1 Then Begin
   Emu_DiskIdxFromDL := False;
   Exit;
  End;
  Idx := 2 + (DL And $7F);
 End Else Begin
  If DL > 1 Then Begin
   Emu_DiskIdxFromDL := False;
   Exit;
  End;
  Idx := DL;
 End;
End;

{ Inverse exact de Emu_DiskIdxFromDL ci-dessus : index 0..3 -> numero       }
{ d unite BIOS (0/1 -> 00h/01h pour A:/B:, 2/3 -> 80h/81h pour C:/D:) -     }
{ utilise par Emu_LoadBootSector pour positionner DL avant l amorcage,     }
{ exactement comme un vrai BIOS le ferait avant de sauter au secteur       }
{ charge a 0000:7C00. }
Function Emu_DLFromDiskIdx(Idx: Byte): Byte;
Begin
 If Idx >= 2 Then Emu_DLFromDiskIdx := $80 + (Idx - 2)
 Else Emu_DLFromDiskIdx := Idx;
End;

{ Nombre de disques durs disponibles (unites 2/3, /DISK80//DISK81). }
Function Emu_HardDiskCount: Byte;
Var N: Byte;
Begin
 N := 0;
 If EmuFloppyOpen[2] Then Inc(N);
 If EmuFloppyOpen[3] Then Inc(N);
 Emu_HardDiskCount := N;
End;

Procedure Emu_Int13SetError(Var P: TEmulatorPanel; Idx, Status: Byte);
Begin
 P.CPU.Regs.AH := Status;
 EmuFloppyLastStatus[Idx] := Status;
 Include(P.CPU.Flags.s, EFG_CF);
End;

Procedure Emu_Int13SetOK(Var P: TEmulatorPanel; Idx: Byte);
Begin
 P.CPU.Regs.AH := 0;
 EmuFloppyLastStatus[Idx] := 0;
 Exclude(P.CPU.Flags.s, EFG_CF);
End;

Procedure Emu_LogInt13(Const Phase: String; AH, AL, CH, CL, DH, DL: Byte;
 CX, DX, ES, BX: Word; LBA, Count: LongInt);
Var LogF: Text;
Begin
 If Not OptionsDlg.Data.DosLogInt13 Then Exit;
 {$I-}
 Assign(LogF, 'EMUINT13.LOG'); Append(LogF);
 If IOResult <> 0 Then Begin Assign(LogF, 'EMUINT13.LOG'); Rewrite(LogF); End;
 WriteLn(LogF, Phase, ' #', EmuInt13LogCount,
  ' AH=', AH, ' AL=', AL,
  ' CH=', CH, ' CL=', CL, ' DH=', DH, ' DL=', DL,
  ' CX=', CX, ' DX=', DX, ' ES=', ES, ' BX=', BX,
  ' LBA=', LBA, ' COUNT=', Count);
 Close(LogF);
 {$I+} If IOResult <> 0 Then ;
 Inc(EmuInt13LogCount);
End;

Procedure Emu_DoInt13(Var P: TEmulatorPanel);
Var
 DL, AH, AL: Byte;
 Cyl, Head, Sect: Word;
 LBA: LongInt;
 NSect, Done: Word;
 Idx: Byte;
 IsHD: Boolean;
 DapSeg, DapOfs, NSectW, BufOfs, BufSeg, LBALo, LBAHi: Word;
 TotalLBA: LongInt;
Begin
 AH := P.CPU.Regs.AH;
 AL := P.CPU.Regs.AL;
 DL := P.CPU.Regs.DL;
 Emu_LogInt13('INT13', AH, AL, P.CPU.Regs.CH, P.CPU.Regs.CL,
  P.CPU.Regs.DH, DL, P.CPU.Regs.CX, P.CPU.Regs.DX,
  P.CPU.Segs.ES, P.CPU.Regs.BX, -1, AL);
 If Not Emu_DiskIdxFromDL(DL, Idx) Then Begin
  { Unite hors plage (ni 00h/01h, ni 80h/81h) : pas de slot de statut
    a mettre a jour, juste signaler l erreur. }
  P.CPU.Regs.AH := $01;            { 01 = invalid function/parameter }
  Include(P.CPU.Flags.s, EFG_CF);
  P.CPU.Regs.AL := 0;
  Exit;
 End;
 IsHD := Idx >= 2;
 Case AH Of
  $00: Begin   { Reset disk system }
   Emu_Int13SetOK(P, Idx);
  End;
  $01: Begin   { Get status of last operation }
   P.CPU.Regs.AH := EmuFloppyLastStatus[Idx];
   If EmuFloppyLastStatus[Idx] = 0 Then
    Exclude(P.CPU.Flags.s, EFG_CF)
   Else
    Include(P.CPU.Flags.s, EFG_CF);
  End;
  $02: Begin   { Read sectors  AL=count, CH=cyl(low8), CL=cyl(hi2)|sec,
                                DH=head, ES:BX -> buffer }
   If Not EmuFloppyOpen[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $80);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   NSect := AL;
   If NSect = 0 Then Begin
    Emu_Int13SetOK(P, Idx);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Cyl   := (P.CPU.Regs.CX Shr 8) Or
            ((P.CPU.Regs.CX And $00C0) Shl 2);
   Sect  := P.CPU.Regs.CX And $003F;
   Head  := P.CPU.Regs.DH;
   LBA   := Emu_FloppyCHS2LBA(Idx, Cyl, Head, Sect);
  Emu_LogInt13('CHS', AH, AL, P.CPU.Regs.CH, P.CPU.Regs.CL,
   P.CPU.Regs.DH, DL, P.CPU.Regs.CX, P.CPU.Regs.DX,
   P.CPU.Segs.ES, P.CPU.Regs.BX, LBA, NSect);
   If LBA < 0 Then Begin
    Emu_Int13SetError(P, Idx, $04);  { 04 = sector not found }
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Done := Emu_FloppyReadSectors(P, Idx, LBA, NSect,
            P.CPU.Segs.ES, P.CPU.Regs.BX);
   P.CPU.Regs.AL := Done;
  If Done = NSect Then
   Emu_Int13SetOK(P, Idx)
  Else
   Emu_Int13SetError(P, Idx, $04);
  Emu_LogInt13('CHS_RESULT', P.CPU.Regs.AH, P.CPU.Regs.AL,
   P.CPU.Regs.CH, P.CPU.Regs.CL, P.CPU.Regs.DH, DL,
   P.CPU.Regs.CX, P.CPU.Regs.DX, P.CPU.Segs.ES,
   P.CPU.Regs.BX, LBA, Done);
  End;
  $03: Begin   { Write sectors }
   If Not EmuFloppyOpen[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $80);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   If EmuFloppyRO[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $03);  { 03 = write protected }
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   NSect := AL;
   If NSect = 0 Then Begin
    Emu_Int13SetOK(P, Idx);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Cyl   := (P.CPU.Regs.CX Shr 8) Or
            ((P.CPU.Regs.CX And $00C0) Shl 2);
   Sect  := P.CPU.Regs.CX And $003F;
   Head  := P.CPU.Regs.DH;
   LBA   := Emu_FloppyCHS2LBA(Idx, Cyl, Head, Sect);
   If LBA < 0 Then Begin
    Emu_Int13SetError(P, Idx, $04);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Done := Emu_FloppyWriteSectors(P, Idx, LBA, NSect,
            P.CPU.Segs.ES, P.CPU.Regs.BX);
   P.CPU.Regs.AL := Done;
   If Done = NSect Then Emu_Int13SetOK(P, Idx)
   Else Emu_Int13SetError(P, Idx, $04);
  End;
  $04: Begin   { Verify sectors : on valide simplement la plage }
   If Not EmuFloppyOpen[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $80);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   NSect := AL;
   If NSect = 0 Then Begin
    Emu_Int13SetOK(P, Idx);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Cyl   := (P.CPU.Regs.CX Shr 8) Or
            ((P.CPU.Regs.CX And $00C0) Shl 2);
   Sect  := P.CPU.Regs.CX And $003F;
   Head  := P.CPU.Regs.DH;
   LBA   := Emu_FloppyCHS2LBA(Idx, Cyl, Head, Sect);
   If LBA < 0 Then Begin
    Emu_Int13SetError(P, Idx, $04);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   If LBA + NSect > (EmuFloppySize[Idx] Div 512) Then Begin
    Emu_Int13SetError(P, Idx, $04);
    P.CPU.Regs.AL := 0;
    Exit;
   End;
   Emu_Int13SetOK(P, Idx);
  End;
  $05: Begin   { Format track : stub - on accepte sans rien faire
                 si l unite est ouverte en ecriture. }
   If Not EmuFloppyOpen[Idx] Then
    Emu_Int13SetError(P, Idx, $80)
   Else If EmuFloppyRO[Idx] Then
    Emu_Int13SetError(P, Idx, $03)
   Else
    Emu_Int13SetOK(P, Idx);
  End;
  $08: Begin   { Get drive parameters }
   If Not EmuFloppyOpen[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $07);  { 07 = no drive }
    { BOGUE REEL (trouve 2026-08-22 en investiguant le blocage BOOT/IO.SYS) }
    { Emu_Int13SetError vient de placer AH=07 (+ CF) - un AX:=0 juste       }
    { apres ecrasait cet AH avec 0, renvoyant a l appelant un etat          }
    { contradictoire (CF=1 "erreur" mais AH=0 "succes"). Ne remettre a 0    }
    { que AL (comme le fait deja le vrai BIOS), jamais AH ici. }
    P.CPU.Regs.AL := 0;
    P.CPU.Regs.BX := 0;
    P.CPU.Regs.CX := 0;
    If IsHD Then P.CPU.Regs.DL := Emu_HardDiskCount
            Else P.CPU.Regs.DL := Emu_FloppyCount;
    P.CPU.Regs.DH := 0;
    Exit;
   End;
   If IsHD And (EmuFloppySpt[Idx] < 1) Then EmuFloppySpt[Idx] := 63;
   If IsHD And (EmuFloppyHeads[Idx] < 1) Then EmuFloppyHeads[Idx] := 16;
   P.CPU.Regs.BL := EmuFloppyType[Idx];
   P.CPU.Regs.CH := Byte((EmuFloppyCyls[Idx] - 1) And $FF);
   P.CPU.Regs.CL := Byte(((EmuFloppyCyls[Idx] - 1) Shr 2) And $C0)
                 Or Byte(EmuFloppySpt[Idx] And $3F);
   P.CPU.Regs.DH := EmuFloppyHeads[Idx] - 1;
   If IsHD Then P.CPU.Regs.DL := Emu_HardDiskCount
           Else P.CPU.Regs.DL := Emu_FloppyCount;
   { BOGUE REEL (2026-08-24, trouve en investiguant le blocage BOOT/getclus/  }
   { get_fat_sector - fbigfat correctement calcule par fat_big_small puis     }
   { efface par une relecture ulterieure de bds_fatsiz a une AUTRE adresse) : }
   { ES:DI -> table de parametres n est un vrai contrat BIOS QUE pour les      }
   { lecteurs de DISQUETTE (table de parametres disquette 1Eh, format         }
   { standard depuis le PC original) - pour un DISQUE DUR, ES:DI n est ni      }
   { documente ni utilise par aucun BIOS reel, qui laisse donc ces registres   }
   { tels quels plutot que de les ecraser explicitement. Le code source reel   }
   { de MS-DOS 6.0 (sethard, msinit.asm) exploite precisement cette garantie : }
   { il appelle INT 13h AH=08h AVEC ds:di deja positionne sur la structure     }
   { BDS du disque en cours de construction (et le reutilise IMMEDIATEMENT     }
   { apres pour fat_big_small et le calcul FAT12/FAT16), sans jamais le        }
   { sauvegarder/restaurer autour de cet appel precis - un choix delibere,     }
   { fidele au comportement documente reel. Mettre ES:DI a 0:0 "pour avoir     }
   { une valeur definie" ecrasait donc silencieusement le pointeur BDS de      }
   { l appelant pour TOUT disque dur, faisant calculer et ecrire fbigfat au    }
   { mauvais endroit (jamais chaine dans la liste que setdrive parcourt        }
   { ensuite) - boucle infinie dans get_fat_sector (mauvaise formule de        }
   { desassemblage FAT12 au lieu de FAT16) des la premiere lecture de          }
   { MSDOS.SYS. Corrige en ne touchant ES:DI que pour les VRAIES disquettes.  }
   If Not IsHD Then Begin
    P.CPU.Segs.ES := 0;
    P.CPU.Regs.DI := 0;
   End;
   Emu_Int13SetOK(P, Idx);
  End;
  $15: Begin   { Get disk type }
   If Not EmuFloppyOpen[Idx] Then Begin
    P.CPU.Regs.AH := 0;     { 00 = no disk present }
    Exclude(P.CPU.Flags.s, EFG_CF);
   End Else If IsHD Then Begin
    P.CPU.Regs.AH := 3;     { 03 = disque dur, CX:DX = nb secteurs }
    P.CPU.Regs.CX := Word((LongInt(EmuFloppySize[Idx] Div 512)
                            Shr 16) And $FFFF);
    P.CPU.Regs.DX := Word(LongInt(EmuFloppySize[Idx] Div 512) And $FFFF);
    Exclude(P.CPU.Flags.s, EFG_CF);
   End Else Begin
    If EmuFloppyType[Idx] >= 3 Then
     P.CPU.Regs.AH := 2      { 02 = floppy with changeline (3.5") }
    Else
     P.CPU.Regs.AH := 1;     { 01 = floppy sans changeline (5.25") }
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $16: Begin   { Detect disk change (sans objet pour un disque dur) }
   If Not EmuFloppyOpen[Idx] Then
    Emu_Int13SetError(P, Idx, $80)
   Else Begin
    P.CPU.Regs.AH := 0;     { 00 = pas de changement }
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $17, $18: Begin   { Set DASD / Set media type for format : stubs OK }
   If EmuFloppyOpen[Idx] Then Emu_Int13SetOK(P, Idx)
   Else Emu_Int13SetError(P, Idx, $80);
  End;
  { INT13h etendu (EDD, AH=41h-49h) - disponible seulement sur les        }
  { interfaces de disque assez recentes pour en avoir eu besoin/beneficie }
  { historiquement (voir Emu_DiskIfSupportsEDD). Sur ST-506/RLL/ESDI/     }
  { SASI/IDE simple, ces AH tombent dans le Else ci-dessous (AH=01h,      }
  { invalide) - fidele au fait qu un vrai BIOS de cette generation ne les }
  { reconnait pas du tout. }
  $41: Begin { Check Extensions Present (entree : BX=55AAh) }
   If Emu_DiskIfSupportsEDD And (P.CPU.Regs.BX = $55AA) Then Begin
    P.CPU.Regs.BX := $AA55;
    P.CPU.Regs.AH := $21; { version EDD 2.1 }
    P.CPU.Regs.CX := $0001; { bit0 : jeu de fonctions DAP lecture/ecriture etendues }
    Exclude(P.CPU.Flags.s, EFG_CF);
   End Else Begin
    P.CPU.Regs.AH := $01;
    Include(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $42, $43: Begin { Extended Read / Extended Write - DAP a DS:SI }
   If Not Emu_DiskIfSupportsEDD Then Begin
    Emu_Int13SetError(P, Idx, $01); Exit;
   End;
   If Not EmuFloppyOpen[Idx] Then Begin
    Emu_Int13SetError(P, Idx, $80); Exit;
   End;
   DapSeg := P.CPU.Segs.DS; DapOfs := P.CPU.Regs.SI;
   NSectW := Emu_ReadWord(P.CPU, DapSeg, DapOfs + 2);
  If NSectW = 0 Then Begin
   Emu_Int13SetError(P, Idx, $01);
   Exit;
  End;
  If NSectW > 256 Then NSectW := 256;
   BufOfs := Emu_ReadWord(P.CPU, DapSeg, DapOfs + 4);
   BufSeg := Emu_ReadWord(P.CPU, DapSeg, DapOfs + 6);
   LBALo  := Emu_ReadWord(P.CPU, DapSeg, DapOfs + 8);
   LBAHi  := Emu_ReadWord(P.CPU, DapSeg, DapOfs + 10);
   LBA := LongInt(LBALo) Or (LongInt(LBAHi) Shl 16);
  Emu_LogInt13('EDD', AH, AL, P.CPU.Regs.CH, P.CPU.Regs.CL,
   P.CPU.Regs.DH, DL, P.CPU.Regs.CX, P.CPU.Regs.DX,
   BufSeg, BufOfs, LBA, NSectW);
   If AH = $42 Then
    Done := Emu_FloppyReadSectors(P, Idx, LBA, NSectW, BufSeg, BufOfs)
   Else Begin
    If EmuFloppyRO[Idx] Then Begin Emu_Int13SetError(P, Idx, $03); Exit; End;
    Done := Emu_FloppyWriteSectors(P, Idx, LBA, Byte(NSectW), BufSeg, BufOfs);
   End;
  If Done = NSectW Then
   Emu_Int13SetOK(P, Idx)
  Else
   Emu_Int13SetError(P, Idx, $04);
  Emu_LogInt13('EDD_RESULT', P.CPU.Regs.AH, P.CPU.Regs.AL,
   P.CPU.Regs.CH, P.CPU.Regs.CL, P.CPU.Regs.DH, DL,
   P.CPU.Regs.CX, P.CPU.Regs.DX, BufSeg, BufOfs, LBA, Done);
  End;
  $44: Begin { Extended Verify }
   If Not Emu_DiskIfSupportsEDD Then Begin Emu_Int13SetError(P, Idx, $01); Exit; End;
   If Not EmuFloppyOpen[Idx] Then Emu_Int13SetError(P, Idx, $80)
   Else Emu_Int13SetOK(P, Idx);
  End;
  $45, $46, $47, $49: Begin { Lock/Unlock, Eject, Seek, Media Change etendus : stubs OK }
   If Emu_DiskIfSupportsEDD And EmuFloppyOpen[Idx] Then Emu_Int13SetOK(P, Idx)
   Else Emu_Int13SetError(P, Idx, $01);
  End;
  $48: Begin { Extended Get Drive Parameters - tampon a DS:SI }
   If Not Emu_DiskIfSupportsEDD Then Begin Emu_Int13SetError(P, Idx, $01); Exit; End;
   If Not EmuFloppyOpen[Idx] Then Begin Emu_Int13SetError(P, Idx, $80); Exit; End;
   DapSeg := P.CPU.Segs.DS; DapOfs := P.CPU.Regs.SI;
   Emu_WriteWord(P.CPU, DapSeg, DapOfs, 26);     { taille remplie }
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 2, 3);  { CHS+LBA valides }
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 4, EmuFloppyCyls[Idx]);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 6, 0);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 8, EmuFloppyHeads[Idx]);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 10, 0);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 12, EmuFloppySpt[Idx]);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 14, 0);
   TotalLBA := EmuFloppySize[Idx] Div 512;
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 16, Word(TotalLBA));
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 18, Word(TotalLBA Shr 16));
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 20, 0); { bits 48-63 : toujours 0 ici }
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 22, 0);
   Emu_WriteWord(P.CPU, DapSeg, DapOfs + 24, 512); { octets/secteur }
   Emu_Int13SetOK(P, Idx);
  End;
 Else
  Emu_Int13SetError(P, Idx, $01);  { 01 = invalid function }
 End;
End;

{ INT 1Ah : services horloge temps reel. Seul AH=00h (lire le compteur de  }
{ ticks 18.2 Hz depuis minuit, deja tenu a jour dans la BDA 0040:006C par  }
{ Emu_TimerTick) est implante - c est le seul sous-service dont dependent  }
{ les logiciels DOS classiques pour cadencer une boucle sur le temps reel  }
{ (ex. GSDEMO1.COM qui mesure la frequence du retrace video via ce        }
{ compteur). Sans ce handler, INT 1Ah ne faisait rien : AX/CX/DX du       }
{ programme restaient inchanges et une boucle "attendre que le compteur   }
{ change" tournait indefiniment. }
Procedure Emu_DoInt1A(Var P: TEmulatorPanel);
Begin
 Case P.CPU.Regs.AH Of
  $00: Begin
   P.CPU.Regs.CX := Emu_ReadWord(P.CPU, $40, $6E); { poids fort }
   P.CPU.Regs.DX := Emu_ReadWord(P.CPU, $40, $6C); { poids faible }
   P.CPU.Regs.AL := 0; { drapeau minuit : non gere }
  End;
 End;
End;

{ ========================================================================= }
{ Pile reseau Novell IPX/SPX (Options > Emulateur > DOS > "Reseau Novell    }
{ NetWare") - INT 2Fh AX=7A00h (verification d installation + adresse du   }
{ point d entree) et INT 7Ah (toutes les fonctions IPX et SPX, numero de   }
{ fonction dans BX). Modele "boucle locale" (choisi explicitement) : il    }
{ n y a aucune autre machine sur le fil virtuel, donc un paquet envoye est }
{ livre a une ecoute (LISTEN) active du MEME programme emule sur le meme   }
{ socket - immediatement si l ecoute existe deja, sinon des qu elle est    }
{ postee. Sources verifiees : la structure ECB/en-tete IPX du pilote       }
{ reseau de DOOM (id-Software/DOOM, ipx/IPXNET.H, code reellement          }
{ expedie et interoperable avec de vrais pilotes IPX/IPXODI d epoque) et   }
{ les numeros de fonction/registres du Ralph Brown Interrupt List (INT     }
{ 7Ah). Limites assumees (documentees ici plutot que devinees) :           }
{  - L ESR (Event Service Routine) d une ECB n est PAS appelee de facon    }
{    asynchrone : completer une ECB en attente ecrit directement ses       }
{    champs InUseFlag/CompletionCode/donnees, sans executer de code invite }
{    en arriere-plan. La grande majorite des logiciels de l epoque (dont   }
{    le pilote IPX de DOOM lui-meme) sondent InUseFlag plutot que de       }
{    dependre exclusivement de l ESR, donc cette simplification couvre     }
{    l ecrasante majorite des cas reels sans le risque d une injection     }
{    d appel far asynchrone mal imbriquee dans le CPU emule.               }
{  - Cote SPX, aucune disposition verifiee du CCB etendu n a ete trouvee ; }
{    les fonctions SPX reutilisent donc le MEME ECB que IPX (ce que la     }
{    documentation elle-meme indique pour Send/Listen SPX Packet) et       }
{    s appuient sur la table de connexions interne EmuIpx.Conns plutot     }
{    que sur des champs CCB non verifies. Establish/Listen For Connection  }
{    aboutissent immediatement (pas de vraie poignee de main a simuler     }
{    sans pair distant) - coherent avec le modele "boucle locale".         }
{ ========================================================================= }

{ Reinitialise toute la pile IPX/SPX et, si la case "Reseau Novell         }
{ NetWare" est cochee, installe le stub resident (3 octets CD 7Ah/RETF a   }
{ $F000:0000 - segment inutilise par le reste de l emulateur 8086) qui     }
{ sert de point d entree "appel far direct" retourne par INT 2Fh AX=7A00h  }
{ en plus de INT 7Ah lui-meme. Appelee a chaque (re)demarrage de           }
{ l emulateur, comme Emu_InitBDA. }
Procedure Emu_IpxInit(Var P: TEmulatorPanel);
Begin
 FillChar(EmuIpx, SizeOf(EmuIpx), 0);
 EmuIpx.Active := OptionsDlg.Data.DosNovell;
 EmuIpx.NextDynSocket := $4000; { plage habituelle des sockets dynamiques }
 EmuIpx.NextConnId := 1;
 { Adresse "materielle" synthetique (bit 02h du 1er octet = adresse geree  }
 { localement, convention IEEE normale pour une adresse qui n est pas une  }
 { vraie adresse MAC gravee) - aucune carte reseau reelle n existe ici.    }
 EmuIpx.LocalNode[0] := $02; EmuIpx.LocalNode[1] := $00;
 EmuIpx.LocalNode[2] := $00; EmuIpx.LocalNode[3] := $00;
 EmuIpx.LocalNode[4] := $00; EmuIpx.LocalNode[5] := $01;
 EmuIpx.LocalNet[0] := $00; EmuIpx.LocalNet[1] := $00;
 EmuIpx.LocalNet[2] := $00; EmuIpx.LocalNet[3] := $01;
 If Not EmuIpx.Active Then Exit;
 EmuIpx.StubSeg := $F000;
 EmuIpx.StubOfs := $0000;
 Emu_WriteByte(P.CPU, EmuIpx.StubSeg, EmuIpx.StubOfs,     $CD); { INT }
 Emu_WriteByte(P.CPU, EmuIpx.StubSeg, EmuIpx.StubOfs + 1, $7A); {  7Ah }
 Emu_WriteByte(P.CPU, EmuIpx.StubSeg, EmuIpx.StubOfs + 2, $CB); { RETF }
End;

{ Renvoie dans FSeg/FOfs/FSize le descripteur de fragment Idx (0-based) de }
{ l ECB a ECBSeg:ECBOfs. False si Idx depasse FragmentCount. }
Function Emu_IpxFragGet(Var P: TEmulatorPanel; ECBSeg, ECBOfs: Word;
 Idx: Integer; Var FSeg, FOfs, FSize: Word): Boolean;
Var FragCount: Word; Base: Word;
Begin
 Emu_IpxFragGet := False;
 FragCount := Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_FRAGCOUNT);
 If (Idx < 0) Or (Idx >= FragCount) Then Exit;
 Base := ECBOfs + EMU_ECB_FRAG0 + Word(Idx * EMU_ECB_FRAG_SIZE);
 FOfs  := Emu_ReadWord(P.CPU, ECBSeg, Base);
 FSeg  := Emu_ReadWord(P.CPU, ECBSeg, Base + 2);
 FSize := Emu_ReadWord(P.CPU, ECBSeg, Base + 4);
 Emu_IpxFragGet := True;
End;

{ Concatene tous les fragments de l ECB dans Buf (borne a SizeOf(TIpxBuf)) }
{ et renvoie la longueur totale copiee. }
Function Emu_IpxCopyFragsToBuf(Var P: TEmulatorPanel; ECBSeg, ECBOfs: Word;
 Var Buf: TIpxBuf): Word;
Var FragCount, Pos: Word; I, J: Integer; FSeg, FOfs, FSize: Word;
Begin
 Pos := 0;
 FragCount := Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_FRAGCOUNT);
 For I := 0 To FragCount - 1 Do Begin
  If Not Emu_IpxFragGet(P, ECBSeg, ECBOfs, I, FSeg, FOfs, FSize) Then Break;
  For J := 0 To Integer(FSize) - 1 Do Begin
   If Pos > High(Buf) Then Break;
   Buf[Pos] := Emu_ReadByte(P.CPU, FSeg, Word(FOfs + J));
   Inc(Pos);
  End;
 End;
 Emu_IpxCopyFragsToBuf := Pos;
End;

{ Ecrit les Len premiers octets de Buf dans les fragments de l ECB (autant }
{ que necessaire), en s arretant si les fragments sont epuises avant Len - }
{ le paquet livre est alors tronque, comme sur du vrai materiel avec des   }
{ tampons applicatifs trop petits. }
Procedure Emu_IpxCopyBufToFrags(Var P: TEmulatorPanel; ECBSeg, ECBOfs: Word;
 Var Buf: TIpxBuf; Len: Word);
Var FragCount, Pos: Word; I, J: Integer; FSeg, FOfs, FSize: Word;
Begin
 Pos := 0;
 FragCount := Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_FRAGCOUNT);
 For I := 0 To FragCount - 1 Do Begin
  If Pos >= Len Then Break;
  If Not Emu_IpxFragGet(P, ECBSeg, ECBOfs, I, FSeg, FOfs, FSize) Then Break;
  For J := 0 To Integer(FSize) - 1 Do Begin
   If Pos >= Len Then Break;
   Emu_WriteByte(P.CPU, FSeg, Word(FOfs + J), Buf[Pos]);
   Inc(Pos);
  End;
 End;
End;

{ Marque l ECB comme terminee (InUseFlag=0, CompletionCode=Completion). }
Procedure Emu_IpxSetECBDone(Var P: TEmulatorPanel; ECBSeg, ECBOfs: Word;
 Completion: Byte);
Begin
 Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_INUSE, 0);
 Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_COMPLETION, Completion);
End;

Function Emu_IpxSocketSlot(Num: Word): Integer;
Var I: Integer;
Begin
 Emu_IpxSocketSlot := -1;
 For I := 0 To High(EmuIpx.Sockets) Do
  If EmuIpx.Sockets[I].InUse And (EmuIpx.Sockets[I].SocketNum = Num) Then Begin
   Emu_IpxSocketSlot := I; Exit;
  End;
End;

{ Met Buf/Len en file d attente pour DestSocket (livraison differee tant   }
{ qu aucun LISTEN correspondant n est poste). File pleine = paquet perdu,  }
{ comme un vrai tampon materiel sature - pas d erreur remontee au          }
{ programme, puisque SEND PACKET ne renvoie pas de statut synchrone. }
Procedure Emu_IpxQueuePush(DestSocket: Word; Var Buf: TIpxBuf; Len: Word);
Var I: Integer;
Begin
 For I := 0 To High(EmuIpx.Queue) Do
  If Not EmuIpx.Queue[I].InUse Then Begin
   EmuIpx.Queue[I].InUse := True;
   EmuIpx.Queue[I].DestSocket := DestSocket;
   EmuIpx.Queue[I].Len := Len;
   EmuIpx.Queue[I].Data := Buf;
   Exit;
  End;
End;

{ Cherche dans la file un paquet pour SocketNum et le livre directement    }
{ dans les fragments de l ECB donnee (utilise par LISTEN quand un paquet   }
{ attendait deja). }
Function Emu_IpxQueuePopInto(Var P: TEmulatorPanel; SocketNum: Word;
 ECBSeg, ECBOfs: Word): Boolean;
Var I: Integer;
Begin
 Emu_IpxQueuePopInto := False;
 For I := 0 To High(EmuIpx.Queue) Do
  If EmuIpx.Queue[I].InUse And
     (EmuIpx.Queue[I].DestSocket = SocketNum) Then Begin
   Emu_IpxCopyBufToFrags(P, ECBSeg, ECBOfs, EmuIpx.Queue[I].Data,
    EmuIpx.Queue[I].Len);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE,     EmuIpx.LocalNode[0]);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE + 1, EmuIpx.LocalNode[1]);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE + 2, EmuIpx.LocalNode[2]);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE + 3, EmuIpx.LocalNode[3]);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE + 4, EmuIpx.LocalNode[4]);
   Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_IMMEDIATE + 5, EmuIpx.LocalNode[5]);
   Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, 0);
   EmuIpx.Queue[I].InUse := False;
   Emu_IpxQueuePopInto := True;
   Exit;
  End;
End;

{ Enregistre une ECB LISTEN en attente pour SocketNum. False si la table   }
{ des ecoutes en attente est pleine (cas limite : trop de LISTEN postees   }
{ sans jamais etre servies). }
Function Emu_IpxPendingAdd(SocketNum, ECBSeg, ECBOfs: Word): Boolean;
Var I: Integer;
Begin
 Emu_IpxPendingAdd := False;
 For I := 0 To High(EmuIpx.Pending) Do
  If Not EmuIpx.Pending[I].InUse Then Begin
   EmuIpx.Pending[I].InUse := True;
   EmuIpx.Pending[I].SocketNum := SocketNum;
   EmuIpx.Pending[I].ECBSeg := ECBSeg;
   EmuIpx.Pending[I].ECBOfs := ECBOfs;
   Emu_IpxPendingAdd := True;
   Exit;
  End;
End;

{ Cherche une ECB LISTEN deja en attente sur DestSocket et lui livre       }
{ directement Buf/Len (utilise par SEND quand une ecoute attendait deja). }
Function Emu_IpxPendingDeliver(Var P: TEmulatorPanel; DestSocket: Word;
 Var Buf: TIpxBuf; Len: Word): Boolean;
Var I: Integer;
Begin
 Emu_IpxPendingDeliver := False;
 For I := 0 To High(EmuIpx.Pending) Do
  If EmuIpx.Pending[I].InUse And
     (EmuIpx.Pending[I].SocketNum = DestSocket) Then Begin
   Emu_IpxCopyBufToFrags(P, EmuIpx.Pending[I].ECBSeg, EmuIpx.Pending[I].ECBOfs,
    Buf, Len);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE,     EmuIpx.LocalNode[0]);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE + 1, EmuIpx.LocalNode[1]);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE + 2, EmuIpx.LocalNode[2]);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE + 3, EmuIpx.LocalNode[3]);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE + 4, EmuIpx.LocalNode[4]);
   Emu_WriteByte(P.CPU, EmuIpx.Pending[I].ECBSeg,
    EmuIpx.Pending[I].ECBOfs + EMU_ECB_IMMEDIATE + 5, EmuIpx.LocalNode[5]);
   Emu_IpxSetECBDone(P, EmuIpx.Pending[I].ECBSeg, EmuIpx.Pending[I].ECBOfs, 0);
   EmuIpx.Pending[I].InUse := False;
   Emu_IpxPendingDeliver := True;
   Exit;
  End;
End;

{ Point d entree unique de livraison "boucle locale" : livre a une ecoute  }
{ deja en attente si possible, sinon met en file pour une ecoute future. }
Procedure Emu_IpxDeliverOrQueue(Var P: TEmulatorPanel; DestSocket: Word;
 Var Buf: TIpxBuf; Len: Word);
Begin
 If Not Emu_IpxPendingDeliver(P, DestSocket, Buf, Len) Then
  Emu_IpxQueuePush(DestSocket, Buf, Len);
End;

{ --- IPX : OPEN SOCKET (BX=0000h) --- }
Procedure Emu_Ipx_OpenSocket(Var P: TEmulatorPanel);
Var Want: Word; Slot, I: Integer;
Begin
 Want := P.CPU.Regs.DX;
 If Want <> 0 Then Begin
  If Emu_IpxSocketSlot(Want) >= 0 Then Begin
   P.CPU.Regs.AL := $FF; { deja ouvert }
   Exit;
  End;
 End Else Begin
  { allocation dynamique }
  While Emu_IpxSocketSlot(EmuIpx.NextDynSocket) >= 0 Do
   Inc(EmuIpx.NextDynSocket);
  Want := EmuIpx.NextDynSocket;
  Inc(EmuIpx.NextDynSocket);
 End;
 Slot := -1;
 For I := 0 To High(EmuIpx.Sockets) Do
  If Not EmuIpx.Sockets[I].InUse Then Begin
   Slot := I; Break;
  End;
 If Slot < 0 Then Begin
  P.CPU.Regs.AL := $FE; { table des sockets pleine }
  Exit;
 End;
 EmuIpx.Sockets[Slot].InUse := True;
 EmuIpx.Sockets[Slot].SocketNum := Want;
 P.CPU.Regs.AL := 0;
 P.CPU.Regs.DX := Want;
End;

{ --- IPX : CLOSE SOCKET (BX=0001h) --- }
Procedure Emu_Ipx_CloseSocket(Var P: TEmulatorPanel);
Var Slot, I: Integer; Num: Word;
Begin
 Num := P.CPU.Regs.DX;
 Slot := Emu_IpxSocketSlot(Num);
 If Slot >= 0 Then EmuIpx.Sockets[Slot].InUse := False;
 { Annule toute ECB LISTEN encore en attente sur ce socket - une vraie     }
 { pile IPX annule aussi les ev?nements en cours a la fermeture. }
 For I := 0 To High(EmuIpx.Pending) Do
  If EmuIpx.Pending[I].InUse And (EmuIpx.Pending[I].SocketNum = Num) Then Begin
   Emu_IpxSetECBDone(P, EmuIpx.Pending[I].ECBSeg, EmuIpx.Pending[I].ECBOfs, $FC);
   EmuIpx.Pending[I].InUse := False;
  End;
End;

{ --- IPX : GET LOCAL TARGET (BX=0002h) --- }
{ ES:SI -> adresse internetwork cible (4 octets reseau + 6 octets noeud),  }
{ ES:DI -> tampon 6 octets pour la cible locale. Sur un segment non route  }
{ (notre seul cas ici), la "cible locale" est simplement le noeud cible    }
{ lui-meme - pas de pont/routeur a resoudre. }
Procedure Emu_Ipx_GetLocalTarget(Var P: TEmulatorPanel);
Var I: Integer; B: Byte;
Begin
 For I := 0 To 5 Do Begin
  B := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.SI + 4 + I));
  Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I), B);
 End;
 P.CPU.Regs.AL := 0;
 P.CPU.Regs.CX := 1; { temps de transfert estime (tick), boucle locale }
End;

{ --- IPX : SEND PACKET (BX=0003h) --- }
{ ES:SI -> ECB dont le premier fragment contient un en-tete IPX de 30      }
{ octets deja construit par l application. Comme un vrai pilote, on        }
{ complete la longueur totale et l adresse source dans cet en-tete avant   }
{ de livrer le paquet. }
Procedure Emu_Ipx_SendPacket(Var P: TEmulatorPanel);
Var Buf: TIpxBuf; Len, DestSocket, SrcSocket: Word; ECBSeg, ECBOfs: Word;
 FSeg, FOfs, FSize: Word;
Begin
 ECBSeg := P.CPU.Segs.ES; ECBOfs := P.CPU.Regs.SI;
 Len := Emu_IpxCopyFragsToBuf(P, ECBSeg, ECBOfs, Buf);
 If Len < EMU_IPX_HDR_SIZE Then Begin
  Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, $FF); { en-tete IPX incomplet }
  Exit;
 End;
 SrcSocket := Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_SOCKET);
 DestSocket := (Word(Buf[EMU_IPX_HDR_DSOCKET]) Shl 8) Or
  Buf[EMU_IPX_HDR_DSOCKET + 1];
 { Complete longueur (reseau, octet fort en premier) et adresse source,    }
 { comme le fait un vrai pilote IPX (voir SEND PACKET dans le RBIL). }
 Buf[EMU_IPX_HDR_LEN]     := Hi(Len);
 Buf[EMU_IPX_HDR_LEN + 1] := Lo(Len);
 Buf[EMU_IPX_HDR_SNET]     := EmuIpx.LocalNet[0];
 Buf[EMU_IPX_HDR_SNET + 1] := EmuIpx.LocalNet[1];
 Buf[EMU_IPX_HDR_SNET + 2] := EmuIpx.LocalNet[2];
 Buf[EMU_IPX_HDR_SNET + 3] := EmuIpx.LocalNet[3];
 Buf[EMU_IPX_HDR_SNODE]     := EmuIpx.LocalNode[0];
 Buf[EMU_IPX_HDR_SNODE + 1] := EmuIpx.LocalNode[1];
 Buf[EMU_IPX_HDR_SNODE + 2] := EmuIpx.LocalNode[2];
 Buf[EMU_IPX_HDR_SNODE + 3] := EmuIpx.LocalNode[3];
 Buf[EMU_IPX_HDR_SNODE + 4] := EmuIpx.LocalNode[4];
 Buf[EMU_IPX_HDR_SNODE + 5] := EmuIpx.LocalNode[5];
 Buf[EMU_IPX_HDR_SSOCKET]     := Hi(SrcSocket);
 Buf[EMU_IPX_HDR_SSOCKET + 1] := Lo(SrcSocket);
 { Recopie les octets corriges dans le 1er fragment de l application (un   }
 { vrai pilote modifie aussi le tampon appelant). }
 If Emu_IpxFragGet(P, ECBSeg, ECBOfs, 0, FSeg, FOfs, FSize) And
    (FSize >= EMU_IPX_HDR_SIZE) Then
  Emu_IpxCopyBufToFrags(P, ECBSeg, ECBOfs, Buf, EMU_IPX_HDR_SIZE);
 { SEND PACKET revient immediatement ; le statut n est jamais dans AL mais }
 { dans l ECB - ici toujours un succes instantane (boucle locale). }
 Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, 0);
 Emu_IpxDeliverOrQueue(P, DestSocket, Buf, Len);
End;

{ --- IPX : LISTEN FOR PACKET (BX=0004h) --- }
Procedure Emu_Ipx_ListenForPacket(Var P: TEmulatorPanel);
Var ECBSeg, ECBOfs: Word; Sock: Word;
Begin
 ECBSeg := P.CPU.Segs.ES; ECBOfs := P.CPU.Regs.SI;
 Sock := Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_SOCKET);
 If Emu_IpxQueuePopInto(P, Sock, ECBSeg, ECBOfs) Then Begin
  P.CPU.Regs.AL := 0;
  Exit;
 End;
 { Aucun paquet deja en file : poser l ECB en attente. InUseFlag reste     }
 { non nul jusqu a livraison (l application est censee le sonder). }
 Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_INUSE, $FF);
 If Emu_IpxPendingAdd(Sock, ECBSeg, ECBOfs) Then
  P.CPU.Regs.AL := 0
 Else
  P.CPU.Regs.AL := $FF; { table des ecoutes en attente pleine }
End;

{ --- IPX : GET INTERNETWORK ADDRESS (BX=0009h) --- }
Procedure Emu_Ipx_GetInternetworkAddress(Var P: TEmulatorPanel);
Var I: Integer;
Begin
 For I := 0 To 3 Do
  Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.SI + I), EmuIpx.LocalNet[I]);
 For I := 0 To 5 Do
  Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.SI + 4 + I),
   EmuIpx.LocalNode[I]);
End;

{ --- SPX : trouve une connexion par son identifiant --- }
Function Emu_SpxConnSlot(ConnId: Word): Integer;
Var I: Integer;
Begin
 Emu_SpxConnSlot := -1;
 For I := 0 To High(EmuIpx.Conns) Do
  If EmuIpx.Conns[I].InUse And (I + 1 = Integer(ConnId)) Then Begin
   Emu_SpxConnSlot := I; Exit;
  End;
 { NextConnId demarre a 1 et l ID retourne = index+1 (voir              }
 { Emu_Spx_Establish/ListenForConnection), donc ce calcul reste valide   }
 { tant que les connexions ne sont jamais reindexees. }
End;

{ --- SPX : INITIALIZE / INSTALLATION CHECK (BX=0010h) --- }
Procedure Emu_Spx_Initialize(Var P: TEmulatorPanel);
Var I, Free: Integer;
Begin
 Free := 0;
 For I := 0 To High(EmuIpx.Conns) Do If Not EmuIpx.Conns[I].InUse Then Inc(Free);
 P.CPU.Regs.AL := $FF; { SPX charge }
 P.CPU.Regs.BH := 1; P.CPU.Regs.BL := 2; { version synthetique 1.2 }
 P.CPU.Regs.CX := High(EmuIpx.Conns) + 1; { connexions max }
 P.CPU.Regs.DX := Free; { connexions disponibles }
End;

{ --- SPX : ESTABLISH / LISTEN FOR CONNECTION (BX=0011h/0012h) ---
  Modele "boucle locale" : comme il n y a pas de second programme pour     }
{ repondre a une vraie poignee de main, les deux aboutissent               }
{ immediatement (pas d attente indefinie sans pair). Le socket local       }
{ vient de l ECB (ECBSocket) ; le socket distant est extrait de l en-tete  }
{ IPX deja construit dans le 1er fragment (Etablir uniquement). }
Procedure Emu_Spx_EstablishOrListen(Var P: TEmulatorPanel; IsListen: Boolean);
Var ECBSeg, ECBOfs: Word; Buf: TIpxBuf; Len: Word; Slot, I: Integer;
Begin
 ECBSeg := P.CPU.Segs.ES; ECBOfs := P.CPU.Regs.SI;
 Slot := -1;
 For I := 0 To High(EmuIpx.Conns) Do
  If Not EmuIpx.Conns[I].InUse Then Begin
   Slot := I; Break;
  End;
 If Slot < 0 Then Begin
  P.CPU.Regs.AL := $EF; { plus de connexion SPX disponible }
  Exit;
 End;
 EmuIpx.Conns[Slot].InUse := True;
 EmuIpx.Conns[Slot].Established := True;
 EmuIpx.Conns[Slot].LocalSocket :=
  Emu_ReadWord(P.CPU, ECBSeg, ECBOfs + EMU_ECB_SOCKET);
 EmuIpx.Conns[Slot].RemoteSocket := EmuIpx.Conns[Slot].LocalSocket;
 If Not IsListen Then Begin
  Len := Emu_IpxCopyFragsToBuf(P, ECBSeg, ECBOfs, Buf);
  If Len >= EMU_IPX_HDR_SIZE Then
   EmuIpx.Conns[Slot].RemoteSocket :=
    (Word(Buf[EMU_IPX_HDR_DSOCKET]) Shl 8) Or Buf[EMU_IPX_HDR_DSOCKET + 1];
 End;
 Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, 0);
 P.CPU.Regs.AL := 0;
 P.CPU.Regs.DX := Word(Slot + 1); { identifiant de connexion attribue }
End;

{ --- SPX : TERMINATE/ABORT CONNECTION (BX=0013h/0014h) --- }
Procedure Emu_Spx_EndConnection(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_SpxConnSlot(P.CPU.Regs.DX);
 If Slot >= 0 Then EmuIpx.Conns[Slot].InUse := False;
 P.CPU.Regs.AL := 0;
End;

{ --- SPX : GET CONNECTION STATUS (BX=0015h) --- }
{ Seul AL est renseigne (connectee ou non) : la disposition exacte d un    }
{ eventuel tampon d etat etendu (ES:SI) n a pas de source verifiee, donc   }
{ elle n est pas fabriquee ici plutot que de risquer un mauvais format. }
Procedure Emu_Spx_GetStatus(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_SpxConnSlot(P.CPU.Regs.DX);
 If (Slot >= 0) And EmuIpx.Conns[Slot].Established Then
  P.CPU.Regs.AL := 0
 Else
  P.CPU.Regs.AL := $FF;
End;

{ --- SPX : SEND / LISTEN FOR SPX PACKET (BX=0016h/0017h) --- }
{ Un paquet SPX voyage comme un paquet IPX (PacketType=5) sur le meme      }
{ "fil" virtuel que les paquets IPX bruts ; on reutilise donc directement  }
{ Emu_IpxDeliverOrQueue/Emu_IpxQueuePopInto/Emu_IpxPendingAdd, indexes par  }
{ le socket local/distant de la connexion plutot que par un socket ouvert  }
{ explicitement par l application. }
Procedure Emu_Spx_SendPacket(Var P: TEmulatorPanel);
Var ECBSeg, ECBOfs: Word; Slot: Integer; Buf: TIpxBuf; Len: Word;
Begin
 ECBSeg := P.CPU.Segs.ES; ECBOfs := P.CPU.Regs.SI;
 Slot := Emu_SpxConnSlot(P.CPU.Regs.DX);
 If (Slot < 0) Or Not EmuIpx.Conns[Slot].Established Then Begin
  Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, $FF);
  Exit;
 End;
 Len := Emu_IpxCopyFragsToBuf(P, ECBSeg, ECBOfs, Buf);
 Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, 0);
 Emu_IpxDeliverOrQueue(P, EmuIpx.Conns[Slot].RemoteSocket, Buf, Len);
End;

Procedure Emu_Spx_ListenForPacket(Var P: TEmulatorPanel);
Var ECBSeg, ECBOfs: Word; Slot: Integer;
Begin
 ECBSeg := P.CPU.Segs.ES; ECBOfs := P.CPU.Regs.SI;
 Slot := Emu_SpxConnSlot(P.CPU.Regs.DX);
 If (Slot < 0) Or Not EmuIpx.Conns[Slot].Established Then Begin
  Emu_IpxSetECBDone(P, ECBSeg, ECBOfs, $FF);
  Exit;
 End;
 If Emu_IpxQueuePopInto(P, EmuIpx.Conns[Slot].LocalSocket, ECBSeg, ECBOfs) Then
  Exit;
 Emu_WriteByte(P.CPU, ECBSeg, ECBOfs + EMU_ECB_INUSE, $FF);
 Emu_IpxPendingAdd(EmuIpx.Conns[Slot].LocalSocket, ECBSeg, ECBOfs);
End;

{ --- Repartiteur INT 7Ah : numero de fonction dans BX (IPX 0000h-001Fh,   }
{ SPX 0010h-0017h). N est jamais appele si EmuIpx.Active=False (voir       }
{ Emu_DoInt) - c est le cas dans lequel une vraie machine sans pilote      }
{ IPX charge laisserait juste ce vecteur inutilise. --- }
Procedure Emu_DoInt7A(Var P: TEmulatorPanel);
Begin
 Case P.CPU.Regs.BX Of
  $0000: Emu_Ipx_OpenSocket(P);
  $0001: Emu_Ipx_CloseSocket(P);
  $0002: Emu_Ipx_GetLocalTarget(P);
  $0003: Emu_Ipx_SendPacket(P);
  $0004: Emu_Ipx_ListenForPacket(P);
  $0005, $0006, $0007: ; { Schedule/Cancel (Special) Event : pas de       }
                          { minuterie interne emulee - accepte silencieux }
  $0008: P.CPU.Regs.AX := Word(EmuTickCounter); { Get Interval Marker }
  $0009: Emu_Ipx_GetInternetworkAddress(P);
  $000A: ; { Relinquish Control : rien a faire (pas de tache de fond) }
  $000B: P.CPU.Regs.AL := 0; { Disconnect From Target : sans objet ici }
  $0010: Emu_Spx_Initialize(P);
  $0011: Emu_Spx_EstablishOrListen(P, False);
  $0012: Emu_Spx_EstablishOrListen(P, True);
  $0013, $0014: Emu_Spx_EndConnection(P);
  $0015: Emu_Spx_GetStatus(P);
  $0016: Emu_Spx_SendPacket(P);
  $0017: Emu_Spx_ListenForPacket(P);
  $001A: P.CPU.Regs.CX := SizeOf(TIpxBuf) - EMU_IPX_HDR_SIZE; { taille max }
 End;
End;

{ ========================================================================= }
{ Pilote de paquets generique (Options > Emulateur > DOS > "Reseau LAN") -  }
{ PC/TCP Packet Driver Specification (FTP Software / Crynwr Software,      }
{ 1983), INT 60h. Source verifiee : http://www.ibiblio.org/towfiq/         }
{ packet-d.html (texte integral de la specification). Modele "boucle      }
{ locale" identique a la pile IPX/SPX ci-dessus (voir la section IPX pour  }
{ la justification) : un seul noeud virtuel, tout SEND_PKT est compare aux }
{ filtres de TOUTES les poignees ouvertes et livre a celles qui             }
{ correspondent.                                                           }
{                                                                          }
{ Difference architecturale majeure avec IPX : la specification ne         }
{ prevoit AUCUN mecanisme de sondage pour la reception - un paquet recu    }
{ est TOUJOURS livre par un "upcall", un appel FAR synchrone en DEUX temps }
{ dans la fonction "receiver" enregistree par l application (1er appel :   }
{ demande de tampon, AX=0 ; 2e appel : livraison effective, AX=1). Il n y  }
{ a donc pas de raccourci "on ecrit juste les champs et on laisse le        }
{ programme sonder" comme pour l ECB IPX - il faut reellement rediriger    }
{ le CPU emule vers le code de l application, le laisser executer          }
{ normalement jusqu a son RETF, puis enchainer le second appel. Ceci       }
{ reutilise le meme principe que Emu_FireHwInt (empiler une adresse de     }
{ retour, sauter dans le gestionnaire) mais enchaine sur 2 appels via un   }
{ point de retour interne prive (INT FDh, jamais utilise par du logiciel   }
{ DOS reel) plutot qu un simple IRET - voir Emu_PktCont.                   }
{                                                                          }
{ Limite assumee : un seul upcall as_send_pkt() peut etre "en vol" a la    }
{ fois (EmuPkt.AsSendPending) ; un second appel as_send_pkt() avant que    }
{ le premier upcall n ait ete livre ecrase silencieusement le premier -    }
{ cas limite juge acceptable (AH=11 est une extension haute performance    }
{ rarement utilisee, contrairement a SEND_PKT/AH=4).                       }
{ ========================================================================= }

Function Emu_PktHandleSlot(HandleNum: Word): Integer;
Var Idx: Integer;
Begin
 Emu_PktHandleSlot := -1;
 If (HandleNum < 1) Or (HandleNum > High(EmuPkt.Handles) + 1) Then Exit;
 Idx := HandleNum - 1;
 If EmuPkt.Handles[Idx].InUse Then Emu_PktHandleSlot := Idx;
End;

{ Une poignee correspond si TypeLen=0 (mode "tout recevoir") ou si les     }
{ TypeLen octets a l offset 12 de la trame (position de l "ethertype"      }
{ DIX Ethernet, la seule classe d interface emulee - classe 1) egalent     }
{ le motif enregistre. }
Function Emu_PktMatchType(Var H: TEmuPktHandle; Var Frame: TIpxBuf;
 FrameLen: Word): Boolean;
Var I: Integer;
Begin
 Emu_PktMatchType := False;
 If H.TypeLen = 0 Then Begin
  Emu_PktMatchType := True;
  Exit;
 End;
 If FrameLen < Word(12 + H.TypeLen) Then Exit;
 For I := 0 To H.TypeLen - 1 Do
  If Frame[12 + I] <> H.TypeSpec[I] Then Exit;
 Emu_PktMatchType := True;
End;

{ Demarre (ou enchaine, si un upcall etait deja en attente) l upcall       }
{ as_send_pkt - voir la limite documentee plus haut. Ne touche SavedCS/IP  }
{ que si aucune cascade n etait en cours (Cont.Pending=False), pour ne pas }
{ ecraser le point de reprise d une cascade de reception deja demarree. }
Procedure Emu_PktFireAsSendUpcall(Var P: TEmulatorPanel);
Begin
 If Not EmuPkt.Cont.Pending Then Begin
  EmuPkt.Cont.SavedCS := P.CPU.Segs.CS;
  EmuPkt.Cont.SavedIP := P.CPU.IP;
 End;
 EmuPkt.AsSendPending := False;
 EmuPkt.Cont.Pending := True;
 EmuPkt.Cont.Stage := 2;
 Emu_PushWord(P.CPU, EmuPkt.ContSeg);
 Emu_PushWord(P.CPU, EmuPkt.ContOfs);
 P.CPU.Regs.AX := EmuPkt.AsSendResult;
 P.CPU.Segs.ES := EmuPkt.AsSendBufSeg;
 P.CPU.Regs.DI := EmuPkt.AsSendBufOfs;
 P.CPU.Segs.CS := EmuPkt.AsSendUpcallSeg;
 P.CPU.IP := EmuPkt.AsSendUpcallOfs;
End;

{ Un "temps" de la cascade de reception vient de se terminer (soit le 2e   }
{ appel recepteur, soit un refus au 1er appel) : sert le prochain paquet   }
{ en file (Backlog) le cas echeant, sinon declenche un upcall as_send_pkt  }
{ en attente, sinon reprend l execution du programme qui a declenche toute }
{ la cascade (SavedCS/SavedIP). }
Procedure Emu_PktContFinishOne(Var P: TEmulatorPanel);
Var I: Integer; Found: Boolean;
Begin
 Found := False;
 For I := 0 To High(EmuPkt.Backlog) Do
  If EmuPkt.Backlog[I].InUse Then Begin
   EmuPkt.Cont.Stage := 0;
   EmuPkt.Cont.HandleIdx := EmuPkt.Backlog[I].HandleIdx;
   EmuPkt.Cont.PktLen := EmuPkt.Backlog[I].Len;
   EmuPkt.Cont.Data := EmuPkt.Backlog[I].Data;
   EmuPkt.Backlog[I].InUse := False;
   Emu_PushWord(P.CPU, EmuPkt.ContSeg);
   Emu_PushWord(P.CPU, EmuPkt.ContOfs);
   P.CPU.Regs.AX := 0;
   P.CPU.Regs.BX := EmuPkt.Cont.HandleIdx + 1;
   P.CPU.Regs.CX := EmuPkt.Cont.PktLen;
   P.CPU.Segs.CS := EmuPkt.Handles[EmuPkt.Cont.HandleIdx].RecvSeg;
   P.CPU.IP := EmuPkt.Handles[EmuPkt.Cont.HandleIdx].RecvOfs;
   Found := True;
   Break;
  End;
 If Found Then Exit;
 If EmuPkt.AsSendPending Then
  Emu_PktFireAsSendUpcall(P)
 Else Begin
  P.CPU.Segs.CS := EmuPkt.Cont.SavedCS;
  P.CPU.IP := EmuPkt.Cont.SavedIP;
  EmuPkt.Cont.Pending := False;
 End;
End;

{ Gestionnaire du point de retour interne (INT FDh) : execute uniquement   }
{ parce qu un RETF invite vient de "revenir" sur ce trampoline apres que    }
{ Emu_PktDeliverToHandle/Emu_PktContFinishOne/Emu_PktFireAsSendUpcall ont   }
{ redirige le CPU emule vers du code invite - voir l en-tete de section    }
{ pour la justification de ce mecanisme. }
Procedure Emu_PktCont(Var P: TEmulatorPanel);
Var BufSeg, BufOfs: Word; I: Integer;
Begin
 If Not EmuPkt.Cont.Pending Then Exit; { securite, ne devrait pas arriver }
 Case EmuPkt.Cont.Stage Of
  0: Begin
   { 1er appel recepteur (AX=0) vient de rendre la main : ES:DI = tampon   }
   { fourni par l application, ou 0000:0000 si elle refuse le paquet.      }
   BufSeg := P.CPU.Segs.ES; BufOfs := P.CPU.Regs.DI;
   If (BufSeg = 0) And (BufOfs = 0) Then
    Emu_PktContFinishOne(P)
   Else Begin
    For I := 0 To Integer(EmuPkt.Cont.PktLen) - 1 Do
     Emu_WriteByte(P.CPU, BufSeg, Word(BufOfs + I), EmuPkt.Cont.Data[I]);
    EmuPkt.Cont.BufSeg := BufSeg; EmuPkt.Cont.BufOfs := BufOfs;
    EmuPkt.Cont.Stage := 1;
    Emu_PushWord(P.CPU, EmuPkt.ContSeg);
    Emu_PushWord(P.CPU, EmuPkt.ContOfs);
    P.CPU.Regs.AX := 1;
    P.CPU.Regs.BX := EmuPkt.Cont.HandleIdx + 1;
    P.CPU.Regs.CX := EmuPkt.Cont.PktLen;
    P.CPU.Segs.DS := BufSeg;
    P.CPU.Regs.SI := BufOfs;
    P.CPU.Segs.CS := EmuPkt.Handles[EmuPkt.Cont.HandleIdx].RecvSeg;
    P.CPU.IP := EmuPkt.Handles[EmuPkt.Cont.HandleIdx].RecvOfs;
   End;
  End;
  1: Emu_PktContFinishOne(P); { 2e appel (AX=1) termine pour cette poignee }
  2: Begin { upcall as_send_pkt termine }
   P.CPU.Segs.CS := EmuPkt.Cont.SavedCS;
   P.CPU.IP := EmuPkt.Cont.SavedIP;
   EmuPkt.Cont.Pending := False;
  End;
 End;
End;

{ Point d entree unique de livraison "boucle locale" pour la reception :   }
{ demarre la cascade d upcall immediatement si aucune n est en cours,      }
{ sinon met Data/Len en file (Backlog) pour etre servi une fois la         }
{ cascade en cours terminee - voir Emu_PktContFinishOne. }
Procedure Emu_PktDeliverToHandle(Var P: TEmulatorPanel; HandleIdx: Integer;
 Var Data: TIpxBuf; Len: Word);
Var I: Integer;
Begin
 If EmuPkt.Cont.Pending Then Begin
  For I := 0 To High(EmuPkt.Backlog) Do
   If Not EmuPkt.Backlog[I].InUse Then Begin
    EmuPkt.Backlog[I].InUse := True;
    EmuPkt.Backlog[I].HandleIdx := HandleIdx;
    EmuPkt.Backlog[I].Len := Len;
    EmuPkt.Backlog[I].Data := Data;
    Exit;
   End;
  Inc(EmuPkt.Stats.PacketsLost); { file de reception saturee }
  Exit;
 End;
 EmuPkt.Cont.Pending := True;
 EmuPkt.Cont.Stage := 0;
 EmuPkt.Cont.HandleIdx := HandleIdx;
 EmuPkt.Cont.PktLen := Len;
 EmuPkt.Cont.Data := Data;
 EmuPkt.Cont.SavedCS := P.CPU.Segs.CS;
 EmuPkt.Cont.SavedIP := P.CPU.IP;
 Emu_PushWord(P.CPU, EmuPkt.ContSeg);
 Emu_PushWord(P.CPU, EmuPkt.ContOfs);
 P.CPU.Regs.AX := 0;
 P.CPU.Regs.BX := HandleIdx + 1;
 P.CPU.Regs.CX := Len;
 P.CPU.Segs.CS := EmuPkt.Handles[HandleIdx].RecvSeg;
 P.CPU.IP := EmuPkt.Handles[HandleIdx].RecvOfs;
End;

{ --- AH=1 : driver_info --- }
Procedure Emu_Pkt_DriverInfo(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.BX := 1;   { "version materielle" }
 P.CPU.Regs.CH := 1;   { classe 1 = DIX Ethernet }
 P.CPU.Regs.DX := 1;   { type (specifique au pilote, generique ici) }
 P.CPU.Regs.CL := 0;   { numero d interface (une seule carte emulee) }
 P.CPU.Segs.DS := EmuPkt.NameSeg;
 P.CPU.Regs.SI := EmuPkt.NameOfs;
 P.CPU.Regs.AL := 6; { fonctions de base + haute performance + etendues }
End;

{ --- AH=2 : access_type --- }
Procedure Emu_Pkt_AccessType(Var P: TEmulatorPanel);
Var IfClass: Byte; TypeLen: Word; Slot, I: Integer;
Begin
 IfClass := P.CPU.Regs.AL;
 If (IfClass <> 0) And (IfClass <> 1) Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 2; { NO_CLASS }
  Exit;
 End;
 Slot := -1;
 For I := 0 To High(EmuPkt.Handles) Do
  If Not EmuPkt.Handles[I].InUse Then Begin Slot := I; Break; End;
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 9; { NO_SPACE }
  Exit;
 End;
 TypeLen := P.CPU.Regs.CX;
 If TypeLen > High(EmuPkt.Handles[Slot].TypeSpec) + 1 Then
  TypeLen := High(EmuPkt.Handles[Slot].TypeSpec) + 1;
 EmuPkt.Handles[Slot].InUse := True;
 EmuPkt.Handles[Slot].IfClass := 1;
 EmuPkt.Handles[Slot].TypeLen := TypeLen;
 For I := 0 To Integer(TypeLen) - 1 Do
  EmuPkt.Handles[Slot].TypeSpec[I] :=
   Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.SI + I));
 EmuPkt.Handles[Slot].RecvSeg := P.CPU.Segs.ES;
 EmuPkt.Handles[Slot].RecvOfs := P.CPU.Regs.DI;
 EmuPkt.Handles[Slot].RcvMode := 3; { defaut : adresse propre + diffusion }
 P.CPU.Regs.AX := Word(Slot + 1); { handle }
End;

{ --- AH=3 : release_type --- }
Procedure Emu_Pkt_ReleaseType(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 EmuPkt.Handles[Slot].InUse := False;
End;

{ --- AH=4 : send_pkt --- }
Procedure Emu_Pkt_SendPacket(Var P: TEmulatorPanel);
Var Buf: TIpxBuf; Len: Word; I: Integer;
Begin
 Len := P.CPU.Regs.CX;
 If Len > SizeOf(Buf) Then Len := SizeOf(Buf);
 For I := 0 To Integer(Len) - 1 Do
  Buf[I] := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.SI + I));
 Inc(EmuPkt.Stats.PacketsOut);
 EmuPkt.Stats.BytesOut := EmuPkt.Stats.BytesOut + Len;
 For I := 0 To High(EmuPkt.Handles) Do
  If EmuPkt.Handles[I].InUse And
     Emu_PktMatchType(EmuPkt.Handles[I], Buf, Len) Then Begin
   Inc(EmuPkt.Stats.PacketsIn); EmuPkt.Stats.BytesIn := EmuPkt.Stats.BytesIn + Len;
   Emu_PktDeliverToHandle(P, I, Buf, Len);
  End;
End;

{ --- AH=5 : terminate --- }
Procedure Emu_Pkt_Terminate(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 EmuPkt.Handles[Slot].InUse := False;
End;

{ --- AH=6 : get_address --- }
Procedure Emu_Pkt_GetAddress(Var P: TEmulatorPanel);
Var Slot, I: Integer; Len: Word;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 Len := P.CPU.Regs.CX;
 If Len > 6 Then Len := 6;
 For I := 0 To Integer(Len) - 1 Do
  Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I), EmuPkt.LocalMAC[I]);
 P.CPU.Regs.CX := Len;
End;

{ --- AH=7 : reset_interface --- }
Procedure Emu_Pkt_ResetInterface(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 { Rien a reinitialiser physiquement dans le modele "boucle locale" -     }
 { aucune transmission en cours ne peut rester bloquee (SEND_PKT est      }
 { toujours instantane). }
End;

{ --- AH=10 : get_parameters (haute performance) --- }
Procedure Emu_Pkt_GetParameters(Var P: TEmulatorPanel);
Begin
 Emu_WriteByte(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS,      1); { major_rev }
 Emu_WriteByte(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 1,  9); { minor_rev }
 Emu_WriteByte(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 2, 14); { length }
 Emu_WriteByte(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 3,  6); { addr_len }
 Emu_WriteWord(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 4,  1514); { mtu }
 Emu_WriteWord(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 6,     0); { multicast_aval }
 Emu_WriteWord(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 8,     8); { rcv_bufs }
 Emu_WriteWord(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 10,    8); { xmt_bufs }
 Emu_WriteWord(P.CPU, EMU_PKT_PARAMS_SEG, EMU_PKT_PARAMS_OFS + 12,
  EmuPkt.Vector); { int_num }
 P.CPU.Segs.ES := EMU_PKT_PARAMS_SEG;
 P.CPU.Regs.DI := EMU_PKT_PARAMS_OFS;
End;

{ --- AH=11 : as_send_pkt (haute performance, envoi + upcall de           }
{ confirmation) --- }
Procedure Emu_Pkt_AsSendPacket(Var P: TEmulatorPanel);
Var Buf: TIpxBuf; Len: Word; I: Integer;
Begin
 Len := P.CPU.Regs.CX;
 If Len > SizeOf(Buf) Then Len := SizeOf(Buf);
 For I := 0 To Integer(Len) - 1 Do
  Buf[I] := Emu_ReadByte(P.CPU, P.CPU.Segs.DS, Word(P.CPU.Regs.SI + I));
 Inc(EmuPkt.Stats.PacketsOut);
 EmuPkt.Stats.BytesOut := EmuPkt.Stats.BytesOut + Len;
 EmuPkt.AsSendPending := True;
 EmuPkt.AsSendUpcallSeg := P.CPU.Segs.ES;
 EmuPkt.AsSendUpcallOfs := P.CPU.Regs.DI;
 EmuPkt.AsSendBufSeg := P.CPU.Segs.DS;
 EmuPkt.AsSendBufOfs := P.CPU.Regs.SI;
 EmuPkt.AsSendResult := 0; { la boucle locale reussit toujours }
 For I := 0 To High(EmuPkt.Handles) Do
  If EmuPkt.Handles[I].InUse And
     Emu_PktMatchType(EmuPkt.Handles[I], Buf, Len) Then Begin
   Inc(EmuPkt.Stats.PacketsIn); EmuPkt.Stats.BytesIn := EmuPkt.Stats.BytesIn + Len;
   Emu_PktDeliverToHandle(P, I, Buf, Len);
  End;
 { Si aucune poignee ne correspondait (donc aucune cascade demarree),     }
 { declencher l upcall de confirmation immediatement ; sinon              }
 { Emu_PktContFinishOne s en chargera automatiquement une fois la         }
 { cascade de reception videe. }
 If Not EmuPkt.Cont.Pending Then Emu_PktFireAsSendUpcall(P);
End;

{ --- AH=20 : set_rcv_mode (etendu) --- }
Procedure Emu_Pkt_SetRcvMode(Var P: TEmulatorPanel);
Var Slot: Integer; Mode: Word;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 Mode := P.CPU.Regs.CX;
 If (Mode < 1) Or (Mode > 6) Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 8; { BAD_MODE }
  Exit;
 End;
 EmuPkt.Handles[Slot].RcvMode := Mode;
End;

{ --- AH=21 : get_rcv_mode (etendu) --- }
Procedure Emu_Pkt_GetRcvMode(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 P.CPU.Regs.AX := EmuPkt.Handles[Slot].RcvMode;
End;

{ --- AH=22/23 : set/get_multicast_list (etendu) - le materiel "virtuel"  }
{ emule n a pas de filtre multicast distinct (comme beaucoup de vrais      }
{ pilotes simples de cette epoque), d ou NO_MULTICAST dans les deux cas. }
Procedure Emu_Pkt_SetMulticastList(Var P: TEmulatorPanel);
Begin
 Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 6; { NO_MULTICAST }
End;

Procedure Emu_Pkt_GetMulticastList(Var P: TEmulatorPanel);
Begin
 Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 6; { NO_MULTICAST }
End;

Procedure Emu_PktWriteLong(Var P: TEmulatorPanel; Seg, Ofs: Word; V: LongInt);
Begin
 Emu_WriteWord(P.CPU, Seg, Ofs, Word(V And $FFFF));
 Emu_WriteWord(P.CPU, Seg, Ofs + 2, Word((V Shr 16) And $FFFF));
End;

{ --- AH=24 : get_statistics (etendu) --- }
Procedure Emu_Pkt_GetStatistics(Var P: TEmulatorPanel);
Var Slot: Integer;
Begin
 Slot := Emu_PktHandleSlot(P.CPU.Regs.BX);
 If Slot < 0 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 1; { BAD_HANDLE }
  Exit;
 End;
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS,      EmuPkt.Stats.PacketsIn);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 4,  EmuPkt.Stats.PacketsOut);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 8,  EmuPkt.Stats.BytesIn);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 12, EmuPkt.Stats.BytesOut);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 16, EmuPkt.Stats.ErrorsIn);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 20, EmuPkt.Stats.ErrorsOut);
 Emu_PktWriteLong(P, EMU_PKT_STATS_SEG, EMU_PKT_STATS_OFS + 24, EmuPkt.Stats.PacketsLost);
 P.CPU.Segs.DS := EMU_PKT_STATS_SEG;
 P.CPU.Regs.SI := EMU_PKT_STATS_OFS;
End;

{ --- AH=25 : set_address (etendu) --- }
Procedure Emu_Pkt_SetAddress(Var P: TEmulatorPanel);
Var I: Integer; AnyOpen: Boolean; Len: Word;
Begin
 AnyOpen := False;
 For I := 0 To High(EmuPkt.Handles) Do
  If EmuPkt.Handles[I].InUse Then AnyOpen := True;
 If AnyOpen Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 13; { CANT_SET }
  Exit;
 End;
 Len := P.CPU.Regs.CX;
 If Len <> 6 Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.DH := 14; { BAD_ADDRESS }
  Exit;
 End;
 For I := 0 To 5 Do
  EmuPkt.LocalMAC[I] := Emu_ReadByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.DI + I));
 P.CPU.Regs.CX := 6;
End;

{ --- Repartiteur INT 60h : numero de fonction dans AH. N est jamais       }
{ appele si EmuPkt.Active=False (voir Emu_DoInt) - c est le cas dans       }
{ lequel une vraie machine sans pilote de paquets charge laisserait ce     }
{ vecteur inutilise. --- }
Procedure Emu_DoInt60(Var P: TEmulatorPanel);
Begin
 Exclude(P.CPU.Flags.s, EFG_CF); { succes par defaut, comme la specif. }
 Case P.CPU.Regs.AH Of
  1:  Emu_Pkt_DriverInfo(P);
  2:  Emu_Pkt_AccessType(P);
  3:  Emu_Pkt_ReleaseType(P);
  4:  Emu_Pkt_SendPacket(P);
  5:  Emu_Pkt_Terminate(P);
  6:  Emu_Pkt_GetAddress(P);
  7:  Emu_Pkt_ResetInterface(P);
  10: Emu_Pkt_GetParameters(P);
  11: Emu_Pkt_AsSendPacket(P);
  20: Emu_Pkt_SetRcvMode(P);
  21: Emu_Pkt_GetRcvMode(P);
  22: Emu_Pkt_SetMulticastList(P);
  23: Emu_Pkt_GetMulticastList(P);
  24: Emu_Pkt_GetStatistics(P);
  25: Emu_Pkt_SetAddress(P);
 Else Begin
  Include(P.CPU.Flags.s, EFG_CF);
  P.CPU.Regs.DH := 11; { BAD_COMMAND }
 End;
 End;
End;

{ Reinitialise le pilote de paquets et, si la case "Reseau LAN" est        }
{ cochee, installe le vecteur INT 60h, le stub de signature de decouverte  }
{ ("PKT DRVR"), le trampoline de continuation interne et le nom du         }
{ pilote. Appelee a chaque (re)demarrage de l emulateur, comme             }
{ Emu_InitBDA/Emu_IpxInit. }
Procedure Emu_PktInit(Var P: TEmulatorPanel);
Var I: Integer; NameStr: String;
Begin
 FillChar(EmuPkt, SizeOf(EmuPkt), 0);
 EmuPkt.Active := OptionsDlg.Data.DosLAN;
 EmuPkt.Vector := $60;
 EmuPkt.LocalMAC[0] := $02; EmuPkt.LocalMAC[1] := $00; EmuPkt.LocalMAC[2] := $00;
 EmuPkt.LocalMAC[3] := $00; EmuPkt.LocalMAC[4] := $00; EmuPkt.LocalMAC[5] := $02;
 For I := 0 To High(EmuPkt.Handles) Do
  EmuPkt.Handles[I].RcvMode := 3;
 If Not EmuPkt.Active Then Exit;
 EmuPkt.StubSeg := $F000; EmuPkt.StubOfs := $0010;
 EmuPkt.ContSeg := $F000; EmuPkt.ContOfs := $0030;
 EmuPkt.NameSeg := $F000; EmuPkt.NameOfs := $0050;

 { Vecteur reel INT 60h : pointe vers le stub de signature, pour les       }
 { applications qui SONDENT LA MEMOIRE a la recherche du motif "PKT DRVR" }
 { (voir la specification, section decouverte) - l appel fonctionnel      }
 { INT 60h lui-meme est intercepte directement par Emu_DoInt et n execute }
 { jamais ce stub (voir Emu_DoInt, case $60). }
 Emu_WriteWord(P.CPU, 0, Word(EmuPkt.Vector) * 4, EmuPkt.StubOfs);
 Emu_WriteWord(P.CPU, 0, Word(EmuPkt.Vector) * 4 + 2, EmuPkt.StubSeg);

 { Stub : JMP SHORT +0Ah ; NOP ; "PKT DRVR",0 (9 octets) ; IRET (jamais    }
 { execute, juste pour que la zone ait l air d un vrai gestionnaire). }
 Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs,     $EB);
 Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs + 1, $0A);
 Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs + 2, $90);
 NameStr := 'PKT DRVR';
 For I := 1 To Length(NameStr) Do
  Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs + 2 + I, Ord(NameStr[I]));
 Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs + 11, 0);
 Emu_WriteByte(P.CPU, EmuPkt.StubSeg, EmuPkt.StubOfs + 12, $CF); { IRET, inerte }

 { Trampoline de continuation interne : INT FDh, jamais utilise par du     }
 { logiciel DOS reel - voir Emu_PktCont. }
 Emu_WriteByte(P.CPU, EmuPkt.ContSeg, EmuPkt.ContOfs,     $CD);
 Emu_WriteByte(P.CPU, EmuPkt.ContSeg, EmuPkt.ContOfs + 1, $FD);

 { Nom du pilote (driver_info, DS:SI) - reflete le "Fabricant reseau LAN" }
 { choisi dans Options > Emulateur > DOS: Logiciel (DosLANVendorName) ;   }
 { une seule implementation Packet Driver generique sous-tend tous ces    }
 { choix, seul le nom retourne change reellement. }
 Case OptionsDlg.Data.DosLANVendor Of
  1: NameStr := 'LANTASTIC PKTDRV';
  2: NameStr := '3C503 PKTDRV';
  3: NameStr := '3C509 PKTDRV';
  4: NameStr := 'WD8003 PKTDRV';
  5: NameStr := 'NE1000 PKTDRV';
  6: NameStr := 'IBMTOK PKTDRV';
  7: NameStr := 'MSLANMAN PKTDRV';
 Else
  NameStr := 'NE2000 PKTDRV';
 End;
 For I := 1 To Length(NameStr) Do
  Emu_WriteByte(P.CPU, EmuPkt.NameSeg, EmuPkt.NameOfs + I - 1, Ord(NameStr[I]));
 Emu_WriteByte(P.CPU, EmuPkt.NameSeg, EmuPkt.NameOfs + Length(NameStr), 0);
End;

{ ========================================================================= }
{ Pilote XMS (Options > Emulateur > DOS: OS > "XMS") - eXtended Memory     }
{ Specification version 3.0 (Microsoft/Lotus/Intel/AST, janvier 1991).     }
{ Source verifiee : texte integral de la specification (xms30.txt,        }
{ phatcode.net/res/219/files/xms30.txt). Toutes les fonctions AH=00h-12h   }
{ et leurs variantes 32 bits AH=88h/89h/8Eh/8Fh sont implantees.           }
{                                                                          }
{ Limites assumees (documentees ici plutot que devinees) :                }
{  - Allocateur "bump" : la memoire liberee (FreeExtendedMemoryBlock)      }
{    n est reellement recuperee que lorsque TOUTES les poignees sont       }
{    liberees simultanement (auquel cas le pointeur d allocation repart   }
{    de zero). Suffisant pour l usage typique (allouer, utiliser, liberer  }
{    a la fin) mais un programme qui alloue/libere en boucle sans jamais   }
{    tout liberer d un coup finira par epuiser les 64 Mo du tampon.        }
{  - Agrandir un bloc (Resize, AH=0Fh/8Fh) au-dela de sa taille actuelle   }
{    n est possible que s il s agit du DERNIER bloc alloue (le seul cas    }
{    ou l allocateur bump peut l etendre en place sans deplacer de         }
{    donnees) - sinon erreur A0h, comme si la memoire etait pleine.        }
{  - HMA (fonctions 01h/02h) : depuis le 2026-08-24 (voir Emu_Addr), la     }
{    HMA (FFFF:0010-FFFF:FFFF, $100000-$10FFEF) est une VRAIE zone de       }
{    memoire adressable en mode reel (TEmuMemBuf etendu, gate A20 reelle    }
{    via Emu8042.A20Enabled - materiel AT+ uniquement, comme sur un vrai    }
{    PC/XT qui n a physiquement pas de 21e ligne d adresse). Request/       }
{    Release (01h/02h) restent de la pure comptabilite (un seul            }
{    "proprietaire" a la fois, fidele a la spec XMS) mais les octets y      }
{    sont desormais reellement lus/ecrits/executes une fois la gate armee   }
{    (Enable Global/Local A20, fonctions 03h/05h, pilote reellement la      }
{    gate materielle - voir Emu_Xms_GlobalEnableA20 et voisines). Le        }
{    "verrouillage" (0Ch/0Dh) d un bloc XMS classique (AH=09h, PAS la HMA)  }
{    reste de la pure comptabilite : aucune adresse physique reelle n est   }
{    fournie derriere le DX:BX retourne par Lock (le stockage des blocs     }
{    XMS "normaux" ne vit pas dans la memoire adressable du CPU emule -     }
{    un vrai programme XMS ne s attend de toute facon qu a y acceder via    }
{    Move Extended Memory Block, jamais par segment:offset direct). Les UMB}
{    (10h-12h) repondent honnetement "aucune                               }
{    UMB disponible" plutot que d en fabriquer qui risqueraient de         }
{    chevaucher la VRAM ($A000-$BFFF) ou les stubs internes ($F000).       }
{ ========================================================================= }

Function Emu_XmsHandleValid(H: Word): Boolean;
Begin
 Emu_XmsHandleValid := (H >= 1) And (H <= High(EmuXms.Handles)) And
  EmuXms.Handles[H].InUse;
End;

{ --- Allocateur "bump" (voir la limite documentee plus haut) --- }
{ Retourne 0 en cas de succes, sinon le code d erreur XMS (BL). }
Function Emu_XmsAllocBlock(SizeKB: LongInt; Var OutHandle: Word): Byte;
Var H: Word; Slot: Integer; NeedBytes: LongInt;
Begin
 Slot := -1;
 For H := 1 To High(EmuXms.Handles) Do
  If Not EmuXms.Handles[H].InUse Then Begin Slot := H; Break; End;
 If Slot < 0 Then Begin
  Emu_XmsAllocBlock := $A1; { pas de poignee disponible }
  Exit;
 End;
 NeedBytes := SizeKB * 1024;
 If EmuXms.UsedBytes + NeedBytes > EmuXms.TotalKB * 1024 Then Begin
  Emu_XmsAllocBlock := $A0; { memoire etendue toute allouee }
  Exit;
 End;
 EmuXms.Handles[Slot].InUse := True;
 EmuXms.Handles[Slot].SizeKB := SizeKB;
 EmuXms.Handles[Slot].LockCount := 0;
 EmuXms.Handles[Slot].StoreOffset := EmuXms.UsedBytes;
 EmuXms.UsedBytes := EmuXms.UsedBytes + NeedBytes;
 OutHandle := Slot;
 Emu_XmsAllocBlock := 0;
End;

Function Emu_XmsFreeBlock(H: Word): Byte;
Var I: Integer; AnyLeft: Boolean;
Begin
 If Not Emu_XmsHandleValid(H) Then Begin
  Emu_XmsFreeBlock := $A2; { poignee invalide }
  Exit;
 End;
 If EmuXms.Handles[H].LockCount > 0 Then Begin
  Emu_XmsFreeBlock := $AB; { bloc verrouille }
  Exit;
 End;
 EmuXms.Handles[H].InUse := False;
 AnyLeft := False;
 For I := 1 To High(EmuXms.Handles) Do
  If EmuXms.Handles[I].InUse Then AnyLeft := True;
 If Not AnyLeft Then EmuXms.UsedBytes := 0; { recupere tout le tampon }
 Emu_XmsFreeBlock := 0;
End;

{ --- AH=00h : Get Version Number --- }
Procedure Emu_Xms_GetVersion(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.AX := $0300; { version 3.00 (BCD) }
 P.CPU.Regs.BX := $0000; { revision interne, sans objet ici }
 P.CPU.Regs.DX := 1;     { la HMA existe (voir AH=01h) }
End;

{ --- AH=01h/02h : Request/Release High Memory Area --- }
{ Arbitrage d un seul "proprietaire" a la fois (pure comptabilite) - voir  }
{ Emu_Addr pour l acces reel aux octets de la HMA une fois la gate A20     }
{ armee (voir la limite documentee plus haut pour le detail). }
Procedure Emu_Xms_RequestHMA(Var P: TEmulatorPanel);
Begin
 If EmuXms.HmaOwned Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $91; { HMA deja utilisee }
  Exit;
 End;
 EmuXms.HmaOwned := True;
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_ReleaseHMA(Var P: TEmulatorPanel);
Begin
 If Not EmuXms.HmaOwned Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $93; { HMA non attribuee }
  Exit;
 End;
 EmuXms.HmaOwned := False;
 P.CPU.Regs.AX := 1;
End;

{ --- AH=03h/04h : Global Enable/Disable A20 --- }
{ AH=05h/06h : Local Enable/Disable A20 --- }
{ AH=07h : Query A20 --- }
{ BOGUE REEL CORRIGE (2026-08-24, HMA totalement absente auparavant - voir  }
{ Emu_Addr) : ces 4 fonctions se contentaient de comptabilite (drapeau/     }
{ compteur EmuXms.A20Global/A20LocalCount) SANS jamais agir sur la vraie    }
{ gate materielle Emu8042.A20Enabled - inoffensif tant que la HMA n etait   }
{ pas adressable, mais desormais Emu_Addr consulte REELLEMENT cette gate    }
{ pour decider si un acces a FFFF:0010+ atteint la HMA ou s enroule a 1 Mo. }
{ Un vrai pilote HIMEM.SYS agit sur le MEME port materiel (92h/8042) que      }
{ cet appel API XMS logique - les deux ne sont que deux facons d atteindre   }
{ la meme gate physique. Chaque fonction recalcule donc l etat NET          }
{ (active si LocalCount>0 OU Global, exactement la logique deja utilisee    }
{ par Emu_Xms_QueryA20 plus bas) et le reporte sur Emu8042.A20Enabled -      }
{ une ecriture materielle DIRECTE au port 92h (Emu_PortWrite) reste          }
{ prioritaire/immediate si elle survient ensuite, fidele a un vrai systeme   }
{ ou les deux chemins pilotent la meme gate sans coordination garantie. }
Procedure Emu_Xms_GlobalEnableA20(Var P: TEmulatorPanel);
Begin
 EmuXms.A20Global := True;
 Emu8042.A20Enabled := True;
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_GlobalDisableA20(Var P: TEmulatorPanel);
Begin
 EmuXms.A20Global := False;
 Emu8042.A20Enabled := (EmuXms.A20LocalCount > 0);
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_LocalEnableA20(Var P: TEmulatorPanel);
Begin
 Inc(EmuXms.A20LocalCount);
 Emu8042.A20Enabled := True;
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_LocalDisableA20(Var P: TEmulatorPanel);
Begin
 If EmuXms.A20LocalCount > 0 Then Dec(EmuXms.A20LocalCount);
 Emu8042.A20Enabled := (EmuXms.A20LocalCount > 0) Or EmuXms.A20Global;
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_QueryA20(Var P: TEmulatorPanel);
Begin
 { Interroge la vraie gate materielle (Emu8042.A20Enabled), pas seulement la }
 { comptabilite XMS locale - une ecriture materielle directe au port 92h     }
 { (hors de tout appel XMS) doit aussi se refleter ici, fidele a un vrai     }
 { systeme ou XMS et le materiel partagent la meme gate physique. }
 If Emu8042.A20Enabled Then
  P.CPU.Regs.AX := 1
 Else
  P.CPU.Regs.AX := 0;
 P.CPU.Regs.BL := 0;
End;

{ --- AH=08h : Query Free Extended Memory (16 bits, Ko) --- }
Procedure Emu_Xms_QueryFreeMem(Var P: TEmulatorPanel);
Var FreeKB: LongInt;
Begin
 FreeKB := EmuXms.TotalKB - (EmuXms.UsedBytes Div 1024);
 If FreeKB > 65535 Then FreeKB := 65535; { plafond 16 bits, voir AH=88h }
 If FreeKB < 0 Then FreeKB := 0;
 P.CPU.Regs.AX := Word(FreeKB); { plus grand bloc libre = tout le reste,  }
 P.CPU.Regs.DX := Word(FreeKB); { l allocateur bump n a pas de fragments  }
 If FreeKB = 0 Then P.CPU.Regs.BL := $A0;
End;

{ --- AH=09h : Allocate Extended Memory Block (16 bits, Ko) --- }
Procedure Emu_Xms_AllocBlock(Var P: TEmulatorPanel);
Var H: Word; Err: Byte;
Begin
 Err := Emu_XmsAllocBlock(P.CPU.Regs.DX, H);
 If Err = 0 Then Begin
  P.CPU.Regs.AX := 1; P.CPU.Regs.DX := H;
 End Else Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := Err;
 End;
End;

{ --- AH=0Ah : Free Extended Memory Block --- }
Procedure Emu_Xms_FreeBlock(Var P: TEmulatorPanel);
Var Err: Byte;
Begin
 Err := Emu_XmsFreeBlock(P.CPU.Regs.DX);
 If Err = 0 Then P.CPU.Regs.AX := 1
 Else Begin P.CPU.Regs.AX := 0; P.CPU.Regs.BL := Err; End;
End;

Function Emu_XmsReadDWord(Var C: TEmuCPU; Seg, Ofs: Word): LongInt;
Begin
 Emu_XmsReadDWord := LongInt(Emu_ReadWord(C, Seg, Ofs)) Or
  (LongInt(Emu_ReadWord(C, Seg, Ofs + 2)) Shl 16);
End;

{ --- AH=0Bh : Move Extended Memory Block --- }
{ DS:SI -> structure de 16 octets (voir l en-tete de section) : Length     }
{ (DD), SourceHandle (DW), SourceOffset (DD), DestHandle (DW), DestOffset  }
{ (DD). Handle=0 signifie memoire conventionnelle, auquel cas le champ     }
{ Offset correspondant est relu comme un pointeur reel segment:offset      }
{ (mot bas = offset, mot haut = segment - "notation DWORD Intel"). }
Procedure Emu_Xms_MoveBlock(Var P: TEmulatorPanel);
Var StructSeg, StructOfs: Word;
 Length_: LongInt; SrcHandle, DstHandle: Word;
 SrcOfs, DstOfs: LongInt;
 SrcSeg, SrcRealOfs, DstSeg, DstRealOfs: Word;
 I: LongInt; B: Byte;
Begin
 StructSeg := P.CPU.Segs.DS; StructOfs := P.CPU.Regs.SI;
 Length_   := Emu_XmsReadDWord(P.CPU, StructSeg, StructOfs);
 SrcHandle := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 4);
 SrcOfs    := Emu_XmsReadDWord(P.CPU, StructSeg, StructOfs + 6);
 DstHandle := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 10);
 DstOfs    := Emu_XmsReadDWord(P.CPU, StructSeg, StructOfs + 12);

 If (Length_ And 1) <> 0 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A7; { longueur invalide (impaire) }
  Exit;
 End;
 If SrcHandle <> 0 Then Begin
  If Not Emu_XmsHandleValid(SrcHandle) Then Begin
   P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A3; Exit;
  End;
  If SrcOfs + Length_ > EmuXms.Handles[SrcHandle].SizeKB * 1024 Then Begin
   P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A4; Exit;
  End;
 End Else Begin
  SrcRealOfs := Word(SrcOfs And $FFFF);
  SrcSeg     := Word((SrcOfs Shr 16) And $FFFF);
 End;
 If DstHandle <> 0 Then Begin
  If Not Emu_XmsHandleValid(DstHandle) Then Begin
   P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A5; Exit;
  End;
  If DstOfs + Length_ > EmuXms.Handles[DstHandle].SizeKB * 1024 Then Begin
   P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A6; Exit;
  End;
 End Else Begin
  DstRealOfs := Word(DstOfs And $FFFF);
  DstSeg     := Word((DstOfs Shr 16) And $FFFF);
 End;

 { Copie octet par octet - simple et correcte quel que soit le sens (pas  }
 { besoin d optimiser un "memmove" pour des tailles DOS-era typiques), a   }
 { la difference d un vrai pilote qui doit gerer le chevauchement en       }
 { copiant en sens inverse le cas echeant ; la specification elle-meme ne  }
 { garantit le resultat que pour les copies "vers l avant" (voir l en-tete }
 { de section), donc une copie octet-par-octet en ordre croissant reste    }
 { conforme au contrat documente. }
 For I := 0 To Length_ - 1 Do Begin
  If SrcHandle <> 0 Then
   B := EmuXmsMem^[EmuXms.Handles[SrcHandle].StoreOffset + SrcOfs + I]
  Else
   B := Emu_ReadByte(P.CPU, SrcSeg, Word(SrcRealOfs + I));
  If DstHandle <> 0 Then
   EmuXmsMem^[EmuXms.Handles[DstHandle].StoreOffset + DstOfs + I] := B
  Else
   Emu_WriteByte(P.CPU, DstSeg, Word(DstRealOfs + I), B);
 End;
 P.CPU.Regs.AX := 1;
End;

{ --- AH=0Ch : Lock Extended Memory Block --- }
Procedure Emu_Xms_LockBlock(Var P: TEmulatorPanel);
Var H: Word; Phys: LongInt;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_XmsHandleValid(H) Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A2; Exit;
 End;
 If EmuXms.Handles[H].LockCount = 255 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $AC; { debordement du compteur }
  Exit;
 End;
 Inc(EmuXms.Handles[H].LockCount);
 { Adresse "physique" synthetique (voir la limite documentee plus haut) - }
 { base arbitraire 1 Mo (debut conventionnel de la memoire etendue) plus  }
 { le decalage du bloc dans notre tampon interne. }
 Phys := $100000 + EmuXms.Handles[H].StoreOffset;
 P.CPU.Regs.DX := Word((Phys Shr 16) And $FFFF);
 P.CPU.Regs.BX := Word(Phys And $FFFF);
 P.CPU.Regs.AX := 1;
End;

{ --- AH=0Dh : Unlock Extended Memory Block --- }
Procedure Emu_Xms_UnlockBlock(Var P: TEmulatorPanel);
Var H: Word;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_XmsHandleValid(H) Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A2; Exit;
 End;
 If EmuXms.Handles[H].LockCount = 0 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $AA; { pas verrouille }
  Exit;
 End;
 Dec(EmuXms.Handles[H].LockCount);
 P.CPU.Regs.AX := 1;
End;

{ --- AH=0Eh : Get EMB Handle Information (16 bits) --- }
Procedure Emu_Xms_GetHandleInfo(Var P: TEmulatorPanel);
Var H, FreeCount, I: Word;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_XmsHandleValid(H) Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A2; Exit;
 End;
 FreeCount := 0;
 For I := 1 To High(EmuXms.Handles) Do
  If Not EmuXms.Handles[I].InUse Then Inc(FreeCount);
 P.CPU.Regs.BH := EmuXms.Handles[H].LockCount;
 P.CPU.Regs.BL := Byte(FreeCount And $FF); { plafonne 8 bits, comme le    }
                                            { veut la specification 16 bits}
 P.CPU.Regs.DX := Word(EmuXms.Handles[H].SizeKB);
 P.CPU.Regs.AX := 1;
End;

{ --- AH=0Fh : Reallocate Extended Memory Block (16 bits, Ko) --- }
{ Voir la limite documentee en tete de section : n agrandit en place que   }
{ le DERNIER bloc alloue (celui dont StoreOffset+Taille = UsedBytes). }
Procedure Emu_Xms_ResizeBlock(Var P: TEmulatorPanel);
Var H: Word; NewSizeKB: LongInt; OldSizeKB: LongInt; IsLast: Boolean;
Begin
 H := P.CPU.Regs.DX;
 NewSizeKB := P.CPU.Regs.BX;
 If Not Emu_XmsHandleValid(H) Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A2; Exit;
 End;
 If EmuXms.Handles[H].LockCount > 0 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $AB; Exit;
 End;
 OldSizeKB := EmuXms.Handles[H].SizeKB;
 IsLast := EmuXms.Handles[H].StoreOffset + OldSizeKB * 1024 =
  EmuXms.UsedBytes;
 If NewSizeKB <= OldSizeKB Then Begin
  { Retrecir est toujours possible ; si c est le dernier bloc, recuperer  }
  { immediatement l espace libere. }
  If IsLast Then
   EmuXms.UsedBytes := EmuXms.UsedBytes - (OldSizeKB - NewSizeKB) * 1024;
  EmuXms.Handles[H].SizeKB := NewSizeKB;
  P.CPU.Regs.AX := 1;
  Exit;
 End;
 If Not IsLast Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A0; { simplification assumee }
  Exit;
 End;
 If EmuXms.UsedBytes + (NewSizeKB - OldSizeKB) * 1024 >
    EmuXms.TotalKB * 1024 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A0;
  Exit;
 End;
 EmuXms.UsedBytes := EmuXms.UsedBytes + (NewSizeKB - OldSizeKB) * 1024;
 EmuXms.Handles[H].SizeKB := NewSizeKB;
 P.CPU.Regs.AX := 1;
End;

{ --- AH=10h/11h/12h : UMB - 2026-08-30, demande explicite de l utilisateur}
{ ("case a cocher UMB... il est possible qu il faille implementer le UMB").}
{ Gere UN SEUL bloc reel (EMU_UMB_SEG=$D000, 64 Ko) - voir le commentaire   }
{ pres de EMU_UMB_SEG pour la recherche qui a confirme ce segment          }
{ genuinement libre (pas une simulation/un placeholder). Gate par la       }
{ case a cocher "UMB" (Options > Emulateur > DOS: OS, OptionsDlg.Data.      }
{ DosUMB) - a decocher, le comportement redevient l ancien refus honnete   }
{ "aucune UMB disponible", exactement comme un vrai DOS sans EMM386/QEMM   }
{ charge (DOS=UMB absent de CONFIG.SYS). }
Procedure Emu_Xms_RequestUMB(Var P: TEmulatorPanel);
Var RequestedParas: Word;
Begin
 RequestedParas := P.CPU.Regs.DX;
 If (Not OptionsDlg.Data.DosUMB) Or EmuXms.UmbInUse Then Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $B1; { aucune UMB disponible }
  P.CPU.Regs.DX := 0;   { plus grande taille disponible = aucune }
  Exit;
 End;
 If RequestedParas > EMU_UMB_SIZE_PARAS Then Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $B0; { taille demandee superieure au plus grand bloc }
  P.CPU.Regs.DX := EMU_UMB_SIZE_PARAS; { taille du plus grand bloc disponible }
  Exit;
 End;
 EmuXms.UmbInUse := True;
 P.CPU.Regs.AX := 1;
 P.CPU.Regs.BX := EMU_UMB_SEG;
 P.CPU.Regs.DX := EMU_UMB_SIZE_PARAS; { taille reelle accordee (bloc entier) }
End;

Procedure Emu_Xms_ReleaseUMB(Var P: TEmulatorPanel);
Begin
 If (Not OptionsDlg.Data.DosUMB) Or (Not EmuXms.UmbInUse) Or
    (P.CPU.Regs.DX <> EMU_UMB_SEG) Then Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $B2; { segment invalide : aucune UMB n a jamais ete accordee }
  Exit;
 End;
 EmuXms.UmbInUse := False;
 P.CPU.Regs.AX := 1;
End;

Procedure Emu_Xms_ResizeUMB(Var P: TEmulatorPanel);
Begin
 If (Not OptionsDlg.Data.DosUMB) Or (Not EmuXms.UmbInUse) Or
    (P.CPU.Regs.DX <> EMU_UMB_SEG) Then Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $B2;
  P.CPU.Regs.DX := 0;
  Exit;
 End;
 { Bloc physique de taille FIXE (pas de sous-allocation reelle) : toute      }
 { demande qui tient dans le bloc reussit trivialement en rapportant sa      }
 { taille reelle ; au-dela, echec honnete avec la taille reellement          }
 { disponible - jamais une taille inventee. }
 If P.CPU.Regs.BX <= EMU_UMB_SIZE_PARAS Then Begin
  P.CPU.Regs.AX := 1;
  P.CPU.Regs.BX := EMU_UMB_SIZE_PARAS;
 End Else Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $B0;
  P.CPU.Regs.DX := EMU_UMB_SIZE_PARAS;
 End;
End;

{ --- AH=88h : Query Any Free Extended Memory (32 bits) --- }
Procedure Emu_Xms_QueryFreeMem32(Var P: TEmulatorPanel);
Var FreeKB: LongInt;
Begin
 If Not OptionsDlg.Data.DosEmu80386 Then Begin
  P.CPU.Regs.BL := $80; Exit; { reserve aux 80386+, voir la specification }
 End;
 FreeKB := EmuXms.TotalKB - (EmuXms.UsedBytes Div 1024);
 If FreeKB < 0 Then FreeKB := 0;
 P.CPU.Regs.EAX := FreeKB;
 P.CPU.Regs.EDX := FreeKB;
 P.CPU.Regs.ECX := $100000 + EmuXms.UsedBytes; { plus haute adresse       }
                                                { "physique" utilisee      }
 P.CPU.Regs.BL := 0;
 If FreeKB = 0 Then P.CPU.Regs.BL := $A0;
End;

{ --- AH=89h : Allocate Any Extended Memory Block (32 bits) --- }
Procedure Emu_Xms_AllocBlock32(Var P: TEmulatorPanel);
Var H: Word; Err: Byte;
Begin
 If Not OptionsDlg.Data.DosEmu80386 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $80; Exit;
 End;
 Err := Emu_XmsAllocBlock(LongInt(P.CPU.Regs.EDX), H);
 If Err = 0 Then Begin
  P.CPU.Regs.AX := 1; P.CPU.Regs.DX := H;
 End Else Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := Err;
 End;
End;

{ --- AH=8Eh : Get Extended EMB Handle Information (32 bits) --- }
Procedure Emu_Xms_GetHandleInfo32(Var P: TEmulatorPanel);
Var H, I: Word; FreeCount: Word;
Begin
 If Not OptionsDlg.Data.DosEmu80386 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $80; Exit;
 End;
 H := P.CPU.Regs.DX;
 If Not Emu_XmsHandleValid(H) Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $A2; Exit;
 End;
 FreeCount := 0;
 For I := 1 To High(EmuXms.Handles) Do
  If Not EmuXms.Handles[I].InUse Then Inc(FreeCount);
 P.CPU.Regs.BH := EmuXms.Handles[H].LockCount;
 P.CPU.Regs.CX := FreeCount;
 P.CPU.Regs.EDX := EmuXms.Handles[H].SizeKB;
 P.CPU.Regs.AX := 1;
End;

{ --- AH=8Fh : Reallocate Any Extended Memory Block (32 bits) --- }
Procedure Emu_Xms_ResizeBlock32(Var P: TEmulatorPanel);
Var Save: Word;
Begin
 If Not OptionsDlg.Data.DosEmu80386 Then Begin
  P.CPU.Regs.AX := 0; P.CPU.Regs.BL := $80; Exit;
 End;
 { Reutilise Emu_Xms_ResizeBlock (16 bits) : BX y attend la nouvelle       }
 { taille - EBX depasse rarement 65535 Ko en pratique (64 Mo de tampon     }
 { total de toute facon), donc le mot bas suffit. }
 Save := P.CPU.Regs.BX;
 P.CPU.Regs.BX := Word(P.CPU.Regs.EBX And $FFFF);
 Emu_Xms_ResizeBlock(P);
 If Save = Save Then ; { evite un avertissement }
End;

{ --- Repartiteur du point d entree XMM (appel far, jamais par            }
{ interruption reelle - voir Emu_DoIntFE, atteint uniquement via le        }
{ trampoline installe par Emu_XmsInit). Numero de fonction dans AH. --- }
Procedure Emu_DoIntFE(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.BL := 0; { pas d erreur par defaut }
 Case P.CPU.Regs.AH Of
  $00: Emu_Xms_GetVersion(P);
  $01: Emu_Xms_RequestHMA(P);
  $02: Emu_Xms_ReleaseHMA(P);
  $03: Emu_Xms_GlobalEnableA20(P);
  $04: Emu_Xms_GlobalDisableA20(P);
  $05: Emu_Xms_LocalEnableA20(P);
  $06: Emu_Xms_LocalDisableA20(P);
  $07: Emu_Xms_QueryA20(P);
  $08: Emu_Xms_QueryFreeMem(P);
  $09: Emu_Xms_AllocBlock(P);
  $0A: Emu_Xms_FreeBlock(P);
  $0B: Emu_Xms_MoveBlock(P);
  $0C: Emu_Xms_LockBlock(P);
  $0D: Emu_Xms_UnlockBlock(P);
  $0E: Emu_Xms_GetHandleInfo(P);
  $0F: Emu_Xms_ResizeBlock(P);
  $10: Emu_Xms_RequestUMB(P);
  $11: Emu_Xms_ReleaseUMB(P);
  $12: Emu_Xms_ResizeUMB(P);
  $88: Emu_Xms_QueryFreeMem32(P);
  $89: Emu_Xms_AllocBlock32(P);
  $8E: Emu_Xms_GetHandleInfo32(P);
  $8F: Emu_Xms_ResizeBlock32(P);
 Else Begin
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := $80; { fonction non implantee }
 End;
 End;
End;

{ Reinitialise le pilote XMS et, si la case "XMS" est cochee, alloue le    }
{ tampon "memoire etendue" (separe des 1 Mo conventionnels de C.Memory)    }
{ et installe le trampoline "appel far direct" (INT FEh) retourne par      }
{ INT 2Fh AX=4310h. Appelee a chaque (re)demarrage de l emulateur, comme   }
{ Emu_IpxInit/Emu_PktInit. }
Procedure Emu_XmsInit(Var P: TEmulatorPanel);
Begin
 FillChar(EmuXms, SizeOf(EmuXms), 0);
 EmuXms.Active := OptionsDlg.Data.DosXMS;
 If EmuXmsMem <> Nil Then Begin
  Dispose(EmuXmsMem);
  EmuXmsMem := Nil;
 End;
 If Not EmuXms.Active Then Exit;
 EmuXms.TotalKB := OptionsDlg.Data.DosXMSSize;
 If EmuXms.TotalKB > EMU_XMS_CAP_KB Then EmuXms.TotalKB := EMU_XMS_CAP_KB;
 If EmuXms.TotalKB < 0 Then EmuXms.TotalKB := 0;
 New(EmuXmsMem);
 If EmuXmsMem = Nil Then Begin
  EmuXms.Active := False; { echec d allocation hote : agir comme inactif }
  Exit;
 End;
 FillChar(EmuXmsMem^, SizeOf(EmuXmsMem^), 0);
 EmuXms.StubSeg := EMU_XMS_STUB_SEG;
 EmuXms.StubOfs := EMU_XMS_STUB_OFS;
 { Trampoline "appel far direct" : INT FEh ; RETF - INT FEh est intercepte }
 { directement par Emu_DoInt (jamais execute pour de vrai, comme les       }
 { stubs IPX/Packet Driver), le RETF n est donc la que pour completude.    }
 Emu_WriteByte(P.CPU, EmuXms.StubSeg, EmuXms.StubOfs,     $CD);
 Emu_WriteByte(P.CPU, EmuXms.StubSeg, EmuXms.StubOfs + 1, $FE);
 Emu_WriteByte(P.CPU, EmuXms.StubSeg, EmuXms.StubOfs + 2, $CB);
End;

{ ========================================================================= }
{ Pilote EMS (Options > Emulateur > DOS: OS > "EMS" + "Version EMS") -     }
{ LIM/Microsoft Expanded Memory Specification, versions 3.0/3.2/4.0.       }
{ Source verifiee : texte integral limems40.txt + Ralph Brown Interrupt    }
{ List (fonctions 50h/57h). INT 67h, fonction dans AH (sous-fonction dans  }
{ AL pour 4Eh/50h/52h/53h/54h/57h/58h/59h). Voir l en-tete du type          }
{ TEmuEmsState pour le modele memoire (page frame a bascule reelle) et la  }
{ justification du gating par version.                                    }
{                                                                          }
{ Fonctions volontairement NON implantees, quelle que soit la version      }
{ (retournent 84h "fonction non definie" - honnete plutot que fabrique) :  }
{  - 4Fh (Get/Set Partial Page Map) - variante partielle de 4Eh, rarement  }
{    utilisee en pratique une fois 4Eh disponible.                        }
{  - 55h/56h (Alter Page Map and Jump/Call) - exigeraient une injection    }
{    de code invite (changer de banc puis sauter/appeler une adresse       }
{    invite) d une complexite disproportionnee face a leur usage reel      }
{    tres marginal.                                                       }
{  - 5Ah (Allocate Standard/Raw Pages) - alias mineur de 43h sans valeur    }
{    ajoutee dans notre modele (nous ne distinguons pas les deux types).   }
{  - 5Bh (jeux de registres de correspondance alternatifs / DMA) - fonction}
{    tres rarement utilisee (pilotes materiels specifiques), dont l ajout  }
{    n apporterait rien pour tester un programme DOS ordinaire.            }
{  - 5Ch (preparation redemarrage a chaud) - sans objet dans un emulateur. }
{  - 5Dh (fonctions OS/E) - extension multitache jamais adoptee en         }
{    pratique.                                                            }
{ ========================================================================= }

{ EmuEms.Version (0/1/2) -> Needed utilise le MEME codage - vrai si la     }
{ version configuree est au moins celle requise par la fonction demandee. }
Function Emu_EmsVerAtLeast(Needed: Byte): Boolean;
Begin
 Emu_EmsVerAtLeast := EmuEms.Version >= Needed;
End;

{ Octet de version BCD retourne par AH=46h (Get EMM Version). }
Function Emu_EmsVersionBCD: Byte;
Begin
 Case EmuEms.Version Of
  0: Emu_EmsVersionBCD := $30;
  1: Emu_EmsVersionBCD := $32;
 Else
  Emu_EmsVersionBCD := $40;
 End;
End;

Function Emu_EmsHandleValid(H: Word): Boolean;
Begin
 Emu_EmsHandleValid := (H >= 1) And (H <= EMU_EMS_MAX_HANDLES) And
  EmuEms.Handles[H].InUse;
End;

Function Emu_EmsSlotSeg(Slot: Integer): Word;
Begin
 Emu_EmsSlotSeg := EMU_EMS_FRAME_SEG + Word(Slot * (EMU_EMS_PAGE_SIZE Div 16));
End;

{ Copie les 16 Ko actuellement visibles dans l emplacement Slot de la      }
{ fenetre "page frame" (memoire conventionnelle C.Memory) VERS le pool     }
{ EMS, a l endroit ou vit la page logique qui y etait chargee - c est ce   }
{ qui rend le contenu ecrit par le programme persistant quand la page      }
{ sera remappee plus tard (vraie bascule de banc, pas une simple           }
{ redirection d adresse). Ne fait rien si l emplacement n a rien de mappe. }
Procedure Emu_EmsFlushSlot(Var P: TEmulatorPanel; Slot: Integer);
Var H, Pg: Word; PoolOfs: LongInt;
Begin
 H := EmuEms.Slots[Slot].MappedHandle;
 If H = 0 Then Exit;
 Pg := EmuEms.Slots[Slot].MappedPage;
 PoolOfs := (EmuEms.Handles[H].StorePageBase + Pg) * EMU_EMS_PAGE_SIZE;
 Move(P.CPU.Memory^[Emu_Addr(P.CPU, Emu_EmsSlotSeg(Slot), 0)],
  EmuEmsMem^[PoolOfs], EMU_EMS_PAGE_SIZE);
End;

{ Copie la page logique Pg de la poignee H DEPUIS le pool EMS VERS         }
{ l emplacement Slot de la page frame, et met a jour le suivi de banc. }
Procedure Emu_EmsLoadSlot(Var P: TEmulatorPanel; Slot: Integer; H, Pg: Word);
Var PoolOfs: LongInt;
Begin
 PoolOfs := (EmuEms.Handles[H].StorePageBase + Pg) * EMU_EMS_PAGE_SIZE;
 Move(EmuEmsMem^[PoolOfs],
  P.CPU.Memory^[Emu_Addr(P.CPU, Emu_EmsSlotSeg(Slot), 0)], EMU_EMS_PAGE_SIZE);
 EmuEms.Slots[Slot].MappedHandle := H;
 EmuEms.Slots[Slot].MappedPage := Pg;
End;

{ Point d entree unique pour changer ce qui est mappe dans un emplacement  }
{ de la page frame - flush de l ancien contenu (si different) puis         }
{ chargement du nouveau (ou simple demappage si NewHandle=0). Reutilise    }
{ par Map/Unmap (44h), Restore Page Map (48h), Set Page Map (4Eh01) et     }
{ Map Multiple Handle Pages (50h00). }
Procedure Emu_EmsSetSlot(Var P: TEmulatorPanel; Slot: Integer;
 NewHandle, NewPage: Word);
Begin
 If (EmuEms.Slots[Slot].MappedHandle <> 0) And
    ((EmuEms.Slots[Slot].MappedHandle <> NewHandle) Or
     (EmuEms.Slots[Slot].MappedPage <> NewPage)) Then
  Emu_EmsFlushSlot(P, Slot);
 If NewHandle = 0 Then
  EmuEms.Slots[Slot].MappedHandle := 0
 Else
  Emu_EmsLoadSlot(P, Slot, NewHandle, NewPage);
End;

{ --- Allocateur "bump" en pages de 16 Ko - meme principe et meme limite   }
{ documentee que Emu_XmsAllocBlock (la memoire liberee n est recuperee     }
{ que lorsque TOUTES les poignees sont liberees en meme temps). --- }
Function Emu_EmsAllocHandle(PageCount: Word; Var OutHandle: Word): Byte;
Var H: Word; Slot: Integer;
Begin
 If (PageCount = 0) And Not Emu_EmsVerAtLeast(2) Then Begin
  Emu_EmsAllocHandle := $89; { allocation de zero page (interdit avant 4.0)}
  Exit;
 End;
 If PageCount > EmuEms.TotalPages Then Begin
  Emu_EmsAllocHandle := $87; { pas assez de pages dans tout le systeme }
  Exit;
 End;
 If EmuEms.UsedPages + PageCount > EmuEms.TotalPages Then Begin
  Emu_EmsAllocHandle := $88; { pas assez de pages NON allouees }
  Exit;
 End;
 Slot := -1;
 For H := 1 To EMU_EMS_MAX_HANDLES Do
  If Not EmuEms.Handles[H].InUse Then Begin Slot := H; Break; End;
 If Slot < 0 Then Begin
  Emu_EmsAllocHandle := $85; { toutes les poignees sont utilisees }
  Exit;
 End;
 EmuEms.Handles[Slot].InUse := True;
 EmuEms.Handles[Slot].PageCount := PageCount;
 EmuEms.Handles[Slot].StorePageBase := EmuEms.UsedPages;
 EmuEms.Handles[Slot].Attribute := 0;
 FillChar(EmuEms.Handles[Slot].Name, SizeOf(EmuEms.Handles[Slot].Name), 0);
 EmuEms.UsedPages := EmuEms.UsedPages + PageCount;
 OutHandle := Word(Slot);
 Emu_EmsAllocHandle := 0;
End;

Function Emu_EmsFreeHandle(Var P: TEmulatorPanel; H: Word): Byte;
Var I, Slot: Integer; AnyLeft: Boolean;
Begin
 If Not Emu_EmsHandleValid(H) Then Begin
  Emu_EmsFreeHandle := $83; { poignee introuvable }
  Exit;
 End;
 { Demapper (sans flush - la memoire de la poignee va disparaitre) tout    }
 { emplacement de la page frame qui pointait encore vers cette poignee.   }
 For Slot := 0 To 3 Do
  If EmuEms.Slots[Slot].MappedHandle = H Then
   EmuEms.Slots[Slot].MappedHandle := 0;
 EmuEms.Handles[H].InUse := False;
 EmuEms.SavedSlotsValid[H] := False;
 AnyLeft := False;
 For I := 1 To EMU_EMS_MAX_HANDLES Do
  If EmuEms.Handles[I].InUse Then AnyLeft := True;
 If Not AnyLeft Then EmuEms.UsedPages := 0; { recupere tout le pool }
 Emu_EmsFreeHandle := 0;
 If P.CPU.Regs.AX = P.CPU.Regs.AX Then ; { evite un avertissement }
End;

{ --- AH=40h : Get Manager Status --- }
Procedure Emu_Ems_GetStatus(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.AH := 0;
End;

{ --- AH=41h : Get Page Frame Segment --- }
Procedure Emu_Ems_GetPageFrame(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.BX := EMU_EMS_FRAME_SEG;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=42h : Get Unallocated Page Count --- }
Procedure Emu_Ems_GetUnallocatedPageCount(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.BX := Word(EmuEms.TotalPages - EmuEms.UsedPages);
 P.CPU.Regs.DX := Word(EmuEms.TotalPages);
 P.CPU.Regs.AH := 0;
End;

{ --- AH=43h : Allocate Pages --- }
Procedure Emu_Ems_AllocatePages(Var P: TEmulatorPanel);
Var H: Word; Err: Byte;
Begin
 Err := Emu_EmsAllocHandle(P.CPU.Regs.BX, H);
 P.CPU.Regs.AH := Err;
 If Err = 0 Then P.CPU.Regs.DX := H;
End;

{ --- AH=44h : Map/Unmap Handle Page --- }
Procedure Emu_Ems_MapPage(Var P: TEmulatorPanel);
Var Phys: Byte; Logical, H: Word;
Begin
 Phys := P.CPU.Regs.AL;
 Logical := P.CPU.Regs.BX;
 H := P.CPU.Regs.DX;
 If Phys > 3 Then Begin
  P.CPU.Regs.AH := $8B; { page physique hors limites }
  Exit;
 End;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83;
  Exit;
 End;
 If Logical <> $FFFF Then Begin
  If Logical >= EmuEms.Handles[H].PageCount Then Begin
   P.CPU.Regs.AH := $8A; { page logique hors limites }
   Exit;
  End;
  Emu_EmsSetSlot(P, Phys, H, Logical);
 End Else
  Emu_EmsSetSlot(P, Phys, 0, 0); { BX=FFFFh = demapper cet emplacement }
 P.CPU.Regs.AH := 0;
End;

{ --- AH=45h : Deallocate Pages --- }
Procedure Emu_Ems_DeallocatePages(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.AH := Emu_EmsFreeHandle(P, P.CPU.Regs.DX);
End;

{ --- AH=46h : Get EMM Version --- }
Procedure Emu_Ems_GetVersion(Var P: TEmulatorPanel);
Begin
 P.CPU.Regs.AL := Emu_EmsVersionBCD;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=47h/48h : Save/Restore Page Map (EMS 3.2+) --- }
Procedure Emu_Ems_SavePageMap(Var P: TEmulatorPanel);
Var H: Word; I: Integer;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83; Exit;
 End;
 If EmuEms.SavedSlotsValid[H] Then Begin
  P.CPU.Regs.AH := $8D; { la zone de sauvegarde contient deja un contexte }
  Exit;
 End;
 For I := 0 To 3 Do EmuEms.SavedSlots[H][I] := EmuEms.Slots[I];
 EmuEms.SavedSlotsValid[H] := True;
 P.CPU.Regs.AH := 0;
End;

Procedure Emu_Ems_RestorePageMap(Var P: TEmulatorPanel);
Var H: Word; I: Integer;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83; Exit;
 End;
 If Not EmuEms.SavedSlotsValid[H] Then Begin
  P.CPU.Regs.AH := $8E; { aucun contexte en zone de sauvegarde }
  Exit;
 End;
 For I := 0 To 3 Do
  Emu_EmsSetSlot(P, I, EmuEms.SavedSlots[H][I].MappedHandle,
   EmuEms.SavedSlots[H][I].MappedPage);
 EmuEms.SavedSlotsValid[H] := False;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=4Bh/4Ch/4Dh : infos poignees (EMS 3.2+) --- }
Procedure Emu_Ems_GetHandleCount(Var P: TEmulatorPanel);
Var I: Integer; Cnt: Word;
Begin
 Cnt := 0;
 For I := 1 To EMU_EMS_MAX_HANDLES Do If EmuEms.Handles[I].InUse Then Inc(Cnt);
 P.CPU.Regs.BX := Cnt;
 P.CPU.Regs.AH := 0;
End;

Procedure Emu_Ems_GetHandlePages(Var P: TEmulatorPanel);
Var H: Word;
Begin
 H := P.CPU.Regs.DX;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83; Exit;
 End;
 P.CPU.Regs.BX := EmuEms.Handles[H].PageCount;
 P.CPU.Regs.AH := 0;
End;

Procedure Emu_Ems_GetAllHandlePages(Var P: TEmulatorPanel);
Var I: Integer; Cnt: Word; Seg, Ofs: Word;
Begin
 Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
 Cnt := 0;
 For I := 1 To EMU_EMS_MAX_HANDLES Do
  If EmuEms.Handles[I].InUse Then Begin
   Emu_WriteWord(P.CPU, Seg, Ofs, Word(I));
   Emu_WriteWord(P.CPU, Seg, Ofs + 2, EmuEms.Handles[I].PageCount);
   Ofs := Ofs + 4;
   Inc(Cnt);
  End;
 P.CPU.Regs.BX := Cnt;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=4Eh : Get/Set Page Map (EMS 4.0+) - format de tableau propre a    }
{ cet emulateur (la specification laisse ce format au choix du pilote,    }
{ voir l en-tete de section) : 4 entrees de 4 octets (WORD poignee mappee, }
{ WORD page logique mappee), une par emplacement de la page frame. --- }
Procedure Emu_Ems_GetPageMap(Var P: TEmulatorPanel);
Var I: Integer; Seg, Ofs: Word;
Begin
 Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
 For I := 0 To 3 Do Begin
  Emu_WriteWord(P.CPU, Seg, Ofs, EmuEms.Slots[I].MappedHandle);
  Emu_WriteWord(P.CPU, Seg, Ofs + 2, EmuEms.Slots[I].MappedPage);
  Ofs := Ofs + 4;
 End;
 P.CPU.Regs.AH := 0;
End;

Procedure Emu_Ems_SetPageMap(Var P: TEmulatorPanel);
Var I: Integer; Seg, Ofs: Word; NH, NP: Word;
Begin
 Seg := P.CPU.Segs.DS; Ofs := P.CPU.Regs.SI;
 For I := 0 To 3 Do Begin
  NH := Emu_ReadWord(P.CPU, Seg, Ofs);
  NP := Emu_ReadWord(P.CPU, Seg, Ofs + 2);
  If (NH <> 0) And Not Emu_EmsHandleValid(NH) Then Begin
   P.CPU.Regs.AH := $83; Exit;
  End;
  Emu_EmsSetSlot(P, I, NH, NP);
  Ofs := Ofs + 4;
 End;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=50h : Map/Unmap Multiple Handle Pages (EMS 4.0+) - format         }
{ verifie (RBIL) : tableau d entrees de 4 octets (WORD page logique ou      }
{ FFFFh pour demapper, WORD page physique [AL=00h] ou segment [AL=01h]).   }
{ Voir la limite documentee en tete de section pour le mode segment. --- }
Procedure Emu_Ems_MapMultiple(Var P: TEmulatorPanel);
Var Mode: Byte; H, Count, I: Word; Seg, Ofs: Word;
 Logical, PhysOrSeg: Word; PoolOfs: LongInt;
Begin
 Mode := P.CPU.Regs.AL;
 H := P.CPU.Regs.DX;
 Count := P.CPU.Regs.CX;
 Seg := P.CPU.Segs.DS; Ofs := P.CPU.Regs.SI;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83; Exit;
 End;
 For I := 0 To Count - 1 Do Begin
  Logical := Emu_ReadWord(P.CPU, Seg, Ofs);
  PhysOrSeg := Emu_ReadWord(P.CPU, Seg, Ofs + 2);
  If (Logical <> $FFFF) And (Logical >= EmuEms.Handles[H].PageCount) Then Begin
   P.CPU.Regs.AH := $8A; Exit;
  End;
  If Mode = 0 Then Begin { AL=00h : numero de page physique (0-3) }
   If PhysOrSeg > 3 Then Begin P.CPU.Regs.AH := $8B; Exit; End;
   If Logical = $FFFF Then Emu_EmsSetSlot(P, PhysOrSeg, 0, 0)
   Else Emu_EmsSetSlot(P, PhysOrSeg, H, Logical);
  End Else Begin { AL=01h : segment arbitraire - copie ponctuelle, voir   }
                 { la limite documentee en tete de section }
   If Logical <> $FFFF Then Begin
    PoolOfs := (EmuEms.Handles[H].StorePageBase + Logical) * EMU_EMS_PAGE_SIZE;
    Move(EmuEmsMem^[PoolOfs], P.CPU.Memory^[Emu_Addr(P.CPU, PhysOrSeg, 0)],
     EMU_EMS_PAGE_SIZE);
   End;
  End;
  Ofs := Ofs + 4;
 End;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=51h : Reallocate Pages (EMS 4.0+) - meme limite que le resize     }
{ XMS (Emu_Xms_ResizeBlock) : n agrandit en place que le DERNIER bloc      }
{ alloue. --- }
Procedure Emu_Ems_ReallocatePages(Var P: TEmulatorPanel);
Var H, NewCount: Word; OldCount: Word; IsLast: Boolean;
Begin
 H := P.CPU.Regs.DX;
 NewCount := P.CPU.Regs.BX;
 If Not Emu_EmsHandleValid(H) Then Begin
  P.CPU.Regs.AH := $83; Exit;
 End;
 OldCount := EmuEms.Handles[H].PageCount;
 IsLast := EmuEms.Handles[H].StorePageBase + OldCount = EmuEms.UsedPages;
 If NewCount <= OldCount Then Begin
  If IsLast Then EmuEms.UsedPages := EmuEms.UsedPages - (OldCount - NewCount);
  EmuEms.Handles[H].PageCount := NewCount;
  P.CPU.Regs.AH := 0;
  Exit;
 End;
 If (Not IsLast) Or
    (EmuEms.UsedPages + (NewCount - OldCount) > EmuEms.TotalPages) Then Begin
  P.CPU.Regs.AH := $88; { simplification assumee, voir Emu_Xms_ResizeBlock }
  Exit;
 End;
 EmuEms.UsedPages := EmuEms.UsedPages + (NewCount - OldCount);
 EmuEms.Handles[H].PageCount := NewCount;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=52h : Get/Set Handle Attribute, Get Attribute Capability          }
{ (EMS 4.0+) - notre modele ne distingue pas volatile/persistant (aucune   }
{ des deux n a d effet observable dans un emulateur sans veille froide),   }
{ donc seule la valeur est memorisee/restituee fidelement. --- }
Procedure Emu_Ems_HandleAttribute(Var P: TEmulatorPanel);
Var H: Word;
Begin
 Case P.CPU.Regs.AL Of
  0: Begin { Get }
   H := P.CPU.Regs.DX;
   If Not Emu_EmsHandleValid(H) Then Begin P.CPU.Regs.AH := $83; Exit; End;
   P.CPU.Regs.AL := EmuEms.Handles[H].Attribute;
   P.CPU.Regs.AH := 0;
  End;
  1: Begin { Set }
   H := P.CPU.Regs.DX;
   If Not Emu_EmsHandleValid(H) Then Begin P.CPU.Regs.AH := $83; Exit; End;
   EmuEms.Handles[H].Attribute := P.CPU.Regs.BL;
   P.CPU.Regs.AH := 0;
  End;
  2: Begin { Get Attribute Capability }
   P.CPU.Regs.AL := 1; { seul l attribut "volatile" (0) est reellement    }
                        { distinct dans notre modele - bit0=1 uniquement  }
   P.CPU.Regs.AH := 0;
  End;
 Else
  P.CPU.Regs.AH := $8F; { sous-fonction invalide }
 End;
End;

{ --- AH=53h : Get/Set Handle Name (EMS 4.0+) --- }
Procedure Emu_Ems_HandleName(Var P: TEmulatorPanel);
Var H: Word; I: Integer; Seg, Ofs: Word;
Begin
 Case P.CPU.Regs.AL Of
  0: Begin { Get }
   H := P.CPU.Regs.DX;
   If Not Emu_EmsHandleValid(H) Then Begin P.CPU.Regs.AH := $83; Exit; End;
   Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
   For I := 0 To 7 Do
    Emu_WriteByte(P.CPU, Seg, Ofs + I, EmuEms.Handles[H].Name[I]);
   P.CPU.Regs.AH := 0;
  End;
  1: Begin { Set }
   H := P.CPU.Regs.DX;
   If Not Emu_EmsHandleValid(H) Then Begin P.CPU.Regs.AH := $83; Exit; End;
   Seg := P.CPU.Segs.DS; Ofs := P.CPU.Regs.SI;
   For I := 0 To 7 Do
    EmuEms.Handles[H].Name[I] := Emu_ReadByte(P.CPU, Seg, Ofs + I);
   P.CPU.Regs.AH := 0;
  End;
 Else
  P.CPU.Regs.AH := $8F;
 End;
End;

{ --- AH=54h : Get Handle Directory / Search Named Handle / Get Total      }
{ Handles (EMS 4.0+) --- }
Procedure Emu_Ems_HandleDirectory(Var P: TEmulatorPanel);
Var I, J: Integer; Cnt: Word; Seg, Ofs: Word; Name: Array[0..7] Of Byte;
 Match: Boolean;
Begin
 Case P.CPU.Regs.AL Of
  0: Begin { Get Handle Directory : ES:DI <- (poignee WORD, nom 8 octets) x N }
   Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
   Cnt := 0;
   For I := 1 To EMU_EMS_MAX_HANDLES Do
    If EmuEms.Handles[I].InUse Then Begin
     Emu_WriteWord(P.CPU, Seg, Ofs, Word(I));
     For J := 0 To 7 Do
      Emu_WriteByte(P.CPU, Seg, Ofs + 2 + J, EmuEms.Handles[I].Name[J]);
     Ofs := Ofs + 10;
     Inc(Cnt);
    End;
   P.CPU.Regs.BX := Cnt;
   P.CPU.Regs.AH := 0;
  End;
  1: Begin { Search Named Handle : DS:SI -> nom 8 octets, DX <- poignee }
   Seg := P.CPU.Segs.DS; Ofs := P.CPU.Regs.SI;
   For J := 0 To 7 Do Name[J] := Emu_ReadByte(P.CPU, Seg, Ofs + J);
   For I := 1 To EMU_EMS_MAX_HANDLES Do
    If EmuEms.Handles[I].InUse Then Begin
     Match := True;
     For J := 0 To 7 Do
      If EmuEms.Handles[I].Name[J] <> Name[J] Then Match := False;
     If Match Then Begin
      P.CPU.Regs.DX := Word(I);
      P.CPU.Regs.AH := 0;
      Exit;
     End;
    End;
   P.CPU.Regs.AH := $83; { aucune poignee ne porte ce nom }
  End;
  2: Begin { Get Total Handles }
   P.CPU.Regs.BX := EMU_EMS_MAX_HANDLES;
   P.CPU.Regs.AH := 0;
  End;
 Else
  P.CPU.Regs.AH := $8F;
 End;
End;

{ --- AH=57h : Move/Exchange Memory Region (EMS 4.0+) - structure de 18    }
{ octets verifiee (RBIL) : Length(DD) SrcType(B) SrcHandle(W)              }
{ SrcOffset(W) SrcSeg-ou-Page(W) DstType(B) DstHandle(W) DstOffset(W)      }
{ DstSeg-ou-Page(W). Type=00h -> memoire conventionnelle (Offset=offset    }
{ reel, Seg-ou-Page=segment reel) ; Type=01h -> memoire expansee           }
{ (Offset=offset dans la page, Seg-ou-Page=numero de page logique) - les   }
{ pages d une poignee etant deja contigues dans notre pool, page*16Ko+     }
{ offset se ramene a un simple decalage plat, comme pour Emu_Xms_MoveBlock.}
Procedure Emu_Ems_MoveExchange(Var P: TEmulatorPanel);
Var StructSeg, StructOfs: Word;
 Length_: LongInt;
 SrcType, DstType: Byte;
 SrcHandle, DstHandle: Word;
 SrcOfs16, DstOfs16, SrcSegPage, DstSegPage: Word;
 SrcFlat, DstFlat: LongInt;
 I: LongInt; B, B2: Byte;
Begin
 StructSeg := P.CPU.Segs.DS; StructOfs := P.CPU.Regs.SI;
 Length_    := Emu_XmsReadDWord(P.CPU, StructSeg, StructOfs);
 SrcType    := Emu_ReadByte(P.CPU, StructSeg, StructOfs + 4);
 SrcHandle  := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 5);
 SrcOfs16   := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 7);
 SrcSegPage := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 9);
 DstType    := Emu_ReadByte(P.CPU, StructSeg, StructOfs + 11);
 DstHandle  := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 12);
 DstOfs16   := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 14);
 DstSegPage := Emu_ReadWord(P.CPU, StructSeg, StructOfs + 16);

 If SrcType = 1 Then Begin
  If Not Emu_EmsHandleValid(SrcHandle) Then Begin P.CPU.Regs.AH := $83; Exit; End;
  SrcFlat := LongInt(SrcSegPage) * EMU_EMS_PAGE_SIZE + SrcOfs16;
  If SrcFlat + Length_ > LongInt(EmuEms.Handles[SrcHandle].PageCount) *
     EMU_EMS_PAGE_SIZE Then Begin P.CPU.Regs.AH := $8A; Exit; End;
 End;
 If DstType = 1 Then Begin
  If Not Emu_EmsHandleValid(DstHandle) Then Begin P.CPU.Regs.AH := $83; Exit; End;
  DstFlat := LongInt(DstSegPage) * EMU_EMS_PAGE_SIZE + DstOfs16;
  If DstFlat + Length_ > LongInt(EmuEms.Handles[DstHandle].PageCount) *
     EMU_EMS_PAGE_SIZE Then Begin P.CPU.Regs.AH := $8A; Exit; End;
 End;

 For I := 0 To Length_ - 1 Do Begin
  If SrcType = 1 Then
   B := EmuEmsMem^[(EmuEms.Handles[SrcHandle].StorePageBase *
    EMU_EMS_PAGE_SIZE) + SrcFlat + I]
  Else
   B := Emu_ReadByte(P.CPU, SrcSegPage, Word(SrcOfs16 + I));
  If P.CPU.Regs.AL = 1 Then Begin { echanger : lire aussi la destination }
   If DstType = 1 Then
    B2 := EmuEmsMem^[(EmuEms.Handles[DstHandle].StorePageBase *
     EMU_EMS_PAGE_SIZE) + DstFlat + I]
   Else
    B2 := Emu_ReadByte(P.CPU, DstSegPage, Word(DstOfs16 + I));
  End Else
   B2 := 0;
  If DstType = 1 Then
   EmuEmsMem^[(EmuEms.Handles[DstHandle].StorePageBase *
    EMU_EMS_PAGE_SIZE) + DstFlat + I] := B
  Else
   Emu_WriteByte(P.CPU, DstSegPage, Word(DstOfs16 + I), B);
  If P.CPU.Regs.AL = 1 Then Begin
   If SrcType = 1 Then
    EmuEmsMem^[(EmuEms.Handles[SrcHandle].StorePageBase *
     EMU_EMS_PAGE_SIZE) + SrcFlat + I] := B2
   Else
    Emu_WriteByte(P.CPU, SrcSegPage, Word(SrcOfs16 + I), B2);
  End;
 End;
 P.CPU.Regs.AH := 0;
End;

{ --- AH=58h : Get Mappable Physical Address Array (EMS 4.0+) --- }
Procedure Emu_Ems_MappableArray(Var P: TEmulatorPanel);
Var I: Integer; Seg, Ofs: Word;
Begin
 Case P.CPU.Regs.AL Of
  0: Begin
   Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
   For I := 0 To 3 Do Begin
    Emu_WriteWord(P.CPU, Seg, Ofs, Emu_EmsSlotSeg(I));
    Emu_WriteWord(P.CPU, Seg, Ofs + 2, Word(I));
    Ofs := Ofs + 4;
   End;
   P.CPU.Regs.AH := 0;
  End;
  1: Begin
   P.CPU.Regs.CX := 4;
   P.CPU.Regs.AH := 0;
  End;
 Else
  P.CPU.Regs.AH := $8F;
 End;
End;

{ --- AH=59h : Get Hardware Configuration / Get Number of Raw Pages        }
{ (EMS 4.0+) - structure synthetique documentee (aucune des fonctionnalites}
{ avancees qu elle decrit habituellement - jeux de registres alternatifs,  }
{ DMA - n est implantee ici, voir l en-tete de section). --- }
Procedure Emu_Ems_HardwareInfo(Var P: TEmulatorPanel);
Var Seg, Ofs: Word;
Begin
 Case P.CPU.Regs.AL Of
  0: Begin
   Seg := P.CPU.Segs.ES; Ofs := P.CPU.Regs.DI;
   Emu_WriteWord(P.CPU, Seg, Ofs,      EMU_EMS_PAGE_SIZE Div 16); { taille}
   Emu_WriteWord(P.CPU, Seg, Ofs + 2,  0); { jeux de registres alternatifs}
   Emu_WriteWord(P.CPU, Seg, Ofs + 4,  0); { taille zone de sauvegarde    }
   Emu_WriteWord(P.CPU, Seg, Ofs + 6,  0); { jeux de registres DMA        }
   Emu_WriteWord(P.CPU, Seg, Ofs + 8,  0); { drapeaux                     }
   P.CPU.Regs.AH := 0;
  End;
  1: Begin { Get Number of Raw Pages - pas de distinction standard/brut }
   P.CPU.Regs.BX := Word(EmuEms.TotalPages - EmuEms.UsedPages);
   P.CPU.Regs.DX := Word(EmuEms.TotalPages);
   P.CPU.Regs.AH := 0;
  End;
 Else
  P.CPU.Regs.AH := $8F;
 End;
End;

{ --- Repartiteur INT 67h : fonction dans AH, sous-fonction dans AL pour   }
{ certaines fonctions 4.0. Le gating par version (Emu_EmsVerAtLeast) est   }
{ fait ICI, pas dans chaque fonction, pour qu il soit impossible d oublier }
{ de le verifier quelque part - voir l en-tete de section. --- }
Procedure Emu_DoInt67(Var P: TEmulatorPanel);
Begin
 Case P.CPU.Regs.AH Of
  $40: Emu_Ems_GetStatus(P);
  $41: Emu_Ems_GetPageFrame(P);
  $42: Emu_Ems_GetUnallocatedPageCount(P);
  $43: Emu_Ems_AllocatePages(P);
  $44: Emu_Ems_MapPage(P);
  $45: Emu_Ems_DeallocatePages(P);
  $46: Emu_Ems_GetVersion(P);
  $47: If Emu_EmsVerAtLeast(1) Then Emu_Ems_SavePageMap(P)
       Else P.CPU.Regs.AH := $84;
  $48: If Emu_EmsVerAtLeast(1) Then Emu_Ems_RestorePageMap(P)
       Else P.CPU.Regs.AH := $84;
  $4B: If Emu_EmsVerAtLeast(1) Then Emu_Ems_GetHandleCount(P)
       Else P.CPU.Regs.AH := $84;
  $4C: If Emu_EmsVerAtLeast(1) Then Emu_Ems_GetHandlePages(P)
       Else P.CPU.Regs.AH := $84;
  $4D: If Emu_EmsVerAtLeast(1) Then Emu_Ems_GetAllHandlePages(P)
       Else P.CPU.Regs.AH := $84;
  $4E: If Emu_EmsVerAtLeast(2) Then Begin
        Case P.CPU.Regs.AL Of
         0: Emu_Ems_GetPageMap(P);
         1: Emu_Ems_SetPageMap(P);
         2: Begin Emu_Ems_GetPageMap(P);
             If P.CPU.Regs.AH = 0 Then Emu_Ems_SetPageMap(P); End;
         3: Begin P.CPU.Regs.AL := 16; P.CPU.Regs.AH := 0; End;
        Else
         P.CPU.Regs.AH := $8F;
        End;
       End Else P.CPU.Regs.AH := $84;
  $50: If Emu_EmsVerAtLeast(2) Then Emu_Ems_MapMultiple(P)
       Else P.CPU.Regs.AH := $84;
  $51: If Emu_EmsVerAtLeast(2) Then Emu_Ems_ReallocatePages(P)
       Else P.CPU.Regs.AH := $84;
  $52: If Emu_EmsVerAtLeast(2) Then Emu_Ems_HandleAttribute(P)
       Else P.CPU.Regs.AH := $84;
  $53: If Emu_EmsVerAtLeast(2) Then Emu_Ems_HandleName(P)
       Else P.CPU.Regs.AH := $84;
  $54: If Emu_EmsVerAtLeast(2) Then Emu_Ems_HandleDirectory(P)
       Else P.CPU.Regs.AH := $84;
  $57: If Emu_EmsVerAtLeast(2) Then Emu_Ems_MoveExchange(P)
       Else P.CPU.Regs.AH := $84;
  $58: If Emu_EmsVerAtLeast(2) Then Emu_Ems_MappableArray(P)
       Else P.CPU.Regs.AH := $84;
  $59: If Emu_EmsVerAtLeast(2) Then Emu_Ems_HardwareInfo(P)
       Else P.CPU.Regs.AH := $84;
 Else
  P.CPU.Regs.AH := $84; { fonction non definie - inclut 4Fh/55h/56h/5Ah/   }
                         { 5Bh/5Ch/5Dh, volontairement non implantees }
 End;
End;

{ Reinitialise le pilote EMS et, si la case "EMS" est cochee, alloue le    }
{ tampon "memoire expansee" separe et prepare la page frame (4             }
{ emplacements vides). Appelee a chaque (re)demarrage de l emulateur,      }
{ comme Emu_IpxInit/Emu_PktInit/Emu_XmsInit. }
Procedure Emu_EmsInit(Var P: TEmulatorPanel);
Begin
 FillChar(EmuEms, SizeOf(EmuEms), 0);
 EmuEms.Active := OptionsDlg.Data.DosEMS;
 EmuEms.Version := Byte(OptionsDlg.Data.DosEMSVersion);
 If EmuEmsMem <> Nil Then Begin
  Dispose(EmuEmsMem);
  EmuEmsMem := Nil;
 End;
 If Not EmuEms.Active Then Exit;
 EmuEms.TotalPages := OptionsDlg.Data.DosEMSSize Div (EMU_EMS_PAGE_SIZE Div 1024);
 If EmuEms.TotalPages > EMU_EMS_CAP_KB Div (EMU_EMS_PAGE_SIZE Div 1024) Then
  EmuEms.TotalPages := EMU_EMS_CAP_KB Div (EMU_EMS_PAGE_SIZE Div 1024);
 If EmuEms.TotalPages < 0 Then EmuEms.TotalPages := 0;
 New(EmuEmsMem);
 If EmuEmsMem = Nil Then Begin
  EmuEms.Active := False;
  Exit;
 End;
 FillChar(EmuEmsMem^, SizeOf(EmuEmsMem^), 0);
 If P.CPU.Regs.AX = P.CPU.Regs.AX Then ; { evite un avertissement }
End;

{ Active ou desactive la reponse MSCDEX (INT 2Fh AX=15xxh) selon la case  }
{ "MSCDEX" (DosMSCDEX) - contrairement a Emu_EmsInit/Emu_XmsInit/etc, ne   }
{ touche PAS aux volumes CD-ROM eux-memes (EmuCdrom, montes une seule fois}
{ au demarrage de l IDE par Emu_CdromOpenAll, voir le commentaire pres de }
{ cette derniere) : un CD-ROM reste "insere" d un demarrage a l autre de   }
{ l emulateur DOS, exactement comme sur une vraie machine - seule la      }
{ visibilite du pilote MSCDEX lui-meme (et donc l acces au(x) lecteur(s)  }
{ via Emu_DoInt21) suit la case a cocher. }
Procedure Emu_MscdexInit(Var P: TEmulatorPanel);
Begin
 EmuMscdexActive := OptionsDlg.Data.DosMSCDEX;
 If P.CPU.Regs.AX = P.CPU.Regs.AX Then ; { evite un avertissement }
End;

{ ========================================================================= }
{ INT 2Fh AH=15h : API MSCDEX (MS-DOS CD-ROM Extensions), gatee par la     }
{ case "MSCDEX" (EmuMscdexActive, voir Emu_MscdexInit). Fonctions AL=00h-  }
{ 10h implantees d apres la documentation la plus repandue et recoupee     }
{ (Ralph Brown Interrupt List et documentation MSCDEX communautaire) -     }
{ couvre toute la surface "haut niveau" documentee de l API (les fonctions }
{ au-dela de 10h sont reservees/non definies, meme dans la specification   }
{ reelle). La fonction 10h (Send Device Driver Request) decode l en-tete   }
{ de requete pilote DOS standard (voir Emu_MscdexDeviceRequest) mais       }
{ repond aux sous-commandes IOCTL Entree/Sortie par un succes generique    }
{ "sans effet reel" : il n y a pas de vrai lecteur audio derriere une      }
{ image .iso montee, donc aucune fonction de lecture/arret audio ne peut   }
{ avoir d effet reel de toute facon ; les codes precis de sous-commande    }
{ IOCTL specifiques au controle audio/plateau (lecture/pause/ejection/     }
{ verrouillage) n ont pas pu etre confirmes contre une specification       }
{ Microsoft primaire lors de la recherche pour cette implementation -      }
{ traiter ce point precis comme une simplification assumee, pas une        }
{ negligence (voir aussi Emu_DoInt15C2 pour un cas similaire deja assume   }
{ dans ce fichier). }
{ ========================================================================= }

{ Traduit une lettre de lecteur (0=A:..25=Z:) en index EmuCdrom, si cette  }
{ lettre correspond bien a un lecteur CD-ROM effectivement monte. }
Function Emu_CdromIdxFromLetter(DL: Byte; Var Idx: Integer): Boolean;
Begin
 Emu_CdromIdxFromLetter := False;
 If EmuCdrom[0].Open And (EmuCdrom[0].DriveLetter = DL) Then Begin
  Idx := 0; Emu_CdromIdxFromLetter := True;
 End Else If EmuCdrom[1].Open And (EmuCdrom[1].DriveLetter = DL) Then Begin
  Idx := 1; Emu_CdromIdxFromLetter := True;
 End;
End;

{ Ecrit une chaine ASCIIZ (au plus MaxLen-1 caracteres utiles) vers ES:BX -}
{ utilise par AX=1502h/1503h/1504h (noms de fichiers copyright/abstract/   }
{ bibliographique). }
Procedure Emu_MscdexWriteAsciiz(Var P: TEmulatorPanel; Const S: String;
 MaxLen: Integer);
Var I: Integer;
Begin
 For I := 1 To Length(S) Do
  If I < MaxLen Then
   Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.BX + I - 1), Byte(S[I]));
 Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.BX + Length(S)), 0);
End;

{ Ecrit un champ both-endian ISO9660 (8 octets : LE32 puis BE32, voir      }
{ EMU_ISO_SECTOR / Emu_IsoEntryFromRecord) - utilise par AX=150Fh pour     }
{ reconstruire un enregistrement de repertoire. }
Procedure Emu_WriteBoth32(Var P: TEmulatorPanel; Seg, Ofs: Word; V: LongInt);
Var I: Integer;
Begin
 For I := 0 To 3 Do
  Emu_WriteByte(P.CPU, Seg, Ofs + I, Byte(V Shr (I * 8)));
 For I := 0 To 3 Do
  Emu_WriteByte(P.CPU, Seg, Ofs + 4 + I, Byte(V Shr ((3 - I) * 8)));
End;

{ Fonction 10h (Send Device Driver Request) : decode l en-tete de requete  }
{ pilote DOS standard (octet 0=longueur, 1=sous-unite, 2=code commande,    }
{ mot 3=statut - voir le commentaire de tete de section pour la reserve    }
{ sur les sous-commandes IOCTL). }
Procedure Emu_MscdexDeviceRequest(Var P: TEmulatorPanel);
Var
 Idx: Integer;
 ReqSeg, ReqOfs: Word;
 Cmd: Byte;
 StatusW: Word;
Begin
 If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
  Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 15; Exit;
 End;
 ReqSeg := P.CPU.Segs.ES; ReqOfs := P.CPU.Regs.BX;
 Cmd := Emu_ReadByte(P.CPU, ReqSeg, ReqOfs + 2);
 Case Cmd Of
  0, 1, 13, 14, 15: StatusW := $0100;  { Init/MediaCheck/Open/Close/       }
                                        { RemovableMedia : succes trivial  }
  3, 12: StatusW := $0100;             { IOCTL Entree/Sortie : accepte     }
                                        { "sans effet reel" (voir ci-dessus)}
 Else
  StatusW := $8103;  { bit15=erreur, bit8=Done, 03h=commande inconnue }
 End;
 Emu_WriteWord(P.CPU, ReqSeg, ReqOfs + 3, StatusW);
 Exclude(P.CPU.Flags.s, EFG_CF);
 If Idx = Idx Then ; { evite un avertissement }
End;

Procedure Emu_DoMscdex(Var P: TEmulatorPanel);
Var
 Idx: Integer;
 I, N: Integer;
 Buf: TEmuIsoSector;
 Entry: TEmuIsoEntry;
 Path: String;
 SecIdx, LBA0: LongInt;
 RecLen: Byte;
 Ok: Boolean;
Begin
 Case P.CPU.Regs.AL Of
  $00: Begin  { Installation check / nombre de lettres de lecteur CD-ROM.  }
              { BX reste a 0 (et CX inchange) si aucun lecteur n est monte,}
              { exactement comme un MSCDEX charge mais sans pilote bas     }
              { niveau detecte - voir le commentaire de tete de section.  }
   N := 0;
   If EmuCdrom[0].Open Then Inc(N);
   If EmuCdrom[1].Open Then Inc(N);
   P.CPU.Regs.BX := N;
   If N > 0 Then Begin
    If EmuCdrom[0].Open Then P.CPU.Regs.CX := EmuCdrom[0].DriveLetter
    Else P.CPU.Regs.CX := EmuCdrom[1].DriveLetter;
   End;
  End;
  $01: Begin  { Get CD-ROM Drive Device List - l adresse d en-tete de      }
              { pilote retournee est purement cosmetique (jamais           }
              { dereferencee par cet emulateur, comme le stub "PKT DRVR"   }
              { de Emu_PktInit). }
   N := 0;
   For Idx := 0 To 1 Do
    If EmuCdrom[Idx].Open Then Begin
     Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX + N * 5, Byte(Idx));
     Emu_WriteWord(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX + N * 5 + 1, EMU_MSCDEX_INFO_OFS);
     Emu_WriteWord(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX + N * 5 + 3, EMU_MSCDEX_INFO_SEG);
     Inc(N);
    End;
  End;
  $02, $03, $04: Begin  { Get Copyright/Abstract/Bibliographic filename }
   If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 15;
   End Else Begin
    Case P.CPU.Regs.AL Of
     2: Emu_MscdexWriteAsciiz(P, EmuCdrom[Idx].CopyrightFile, 38);
     3: Emu_MscdexWriteAsciiz(P, EmuCdrom[Idx].AbstractFile, 38);
     4: Emu_MscdexWriteAsciiz(P, EmuCdrom[Idx].BiblioFile, 38);
    End;
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $05: Begin  { Read VTOC : DX = index de secteur relatif au premier       }
              { Volume Descriptor (secteur logique 16 + DX). }
   If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AL := 15;
   End Else If Not Emu_IsoReadLBA(Idx, 16 + LongInt(P.CPU.Regs.DX), Buf) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AL := 21;
   End Else Begin
    For I := 0 To EMU_ISO_SECTOR - 1 Do
     Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.BX + I), Buf[I]);
    If Buf[0] = 255 Then P.CPU.Regs.AX := $FF
    Else If Buf[0] = 1 Then P.CPU.Regs.AX := 1
    Else P.CPU.Regs.AX := 0;
    Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $06, $07: Exclude(P.CPU.Flags.s, EFG_CF);  { Debogage on/off - non       }
                                              { fonctionnel, comme sur un   }
                                              { pilote reel en production. }
  $08: Begin  { Absolute Disk Read : SI:DI = secteur de depart (32 bits,   }
              { SI=poids fort), DX = nombre de secteurs. }
   If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AL := 15;
   End Else Begin
    LBA0 := (LongInt(P.CPU.Regs.SI) Shl 16) Or P.CPU.Regs.DI;
    N := P.CPU.Regs.DX;
    If N < 1 Then N := 1;
    Ok := True;
    For SecIdx := 0 To N - 1 Do Begin
     If Not Emu_IsoReadLBA(Idx, LBA0 + SecIdx, Buf) Then Begin Ok := False; Break; End;
     For I := 0 To EMU_ISO_SECTOR - 1 Do
      Emu_WriteByte(P.CPU, P.CPU.Segs.ES,
       Word(P.CPU.Regs.BX + SecIdx * EMU_ISO_SECTOR + I), Buf[I]);
    End;
    If Not Ok Then Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AL := 21; End
    Else Exclude(P.CPU.Flags.s, EFG_CF);
   End;
  End;
  $09: Begin  { Absolute Disk Write - reserve/non supporte (media en       }
              { lecture seule). }
   Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AL := 5;
  End;
  $0B: Begin  { CD-ROM Drive Check }
   P.CPU.Regs.BX := $ADAD;
   If Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then P.CPU.Regs.AX := 1
   Else P.CPU.Regs.AX := 0;
  End;
  $0C: P.CPU.Regs.BX := $020A;  { Version MSCDEX simulee : v2.10 }
  $0D: Begin  { Get CD-ROM Drive Letters }
   N := 0;
   If EmuCdrom[0].Open Then Begin
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX + N, EmuCdrom[0].DriveLetter);
    Inc(N);
   End;
   If EmuCdrom[1].Open Then Begin
    Emu_WriteByte(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX + N, EmuCdrom[1].DriveLetter);
    Inc(N);
   End;
  End;
  $0E: Begin  { Get/Set Volume Descriptor Preference - seul le PVD est     }
              { supporte (pas de Joliet/SVD, voir le commentaire de tete   }
              { de la section lecteur ISO9660 pres de Emu_CdromOpenAll). }
   If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 15;
   End Else If P.CPU.Regs.BX = 0 Then Begin { get }
    P.CPU.Regs.DX := 1;
    Exclude(P.CPU.Flags.s, EFG_CF);
   End Else Begin { set }
    If P.CPU.Regs.DH = 1 Then Exclude(P.CPU.Flags.s, EFG_CF)
    Else Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 1; End;
   End;
  End;
  $0F: Begin  { Get Directory Entry : ES:BX = chemin ASCIIZ, SI:DI =        }
              { tampon de sortie. Reconstruit un enregistrement MINIMAL    }
              { (LBA/taille/indicateurs/nom) plutot qu une copie brute de   }
              { l original (deja perdue apres decodage par Emu_IsoResolve),}
              { suffisant pour les usages reels documentes de cette         }
              { fonction. }
   If Not Emu_CdromIdxFromLetter(Byte(P.CPU.Regs.CX), Idx) Then Begin
    Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 15;
   End Else Begin
    Path := Emu_ReadAsciiz(P.CPU, P.CPU.Segs.ES, P.CPU.Regs.BX);
    If Not Emu_IsoResolve(Idx, Path, Entry) Then Begin
     Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 2;
    End Else Begin
     RecLen := 33 + Length(Entry.Name);
     If (RecLen And 1) = 1 Then Inc(RecLen);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI, RecLen);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 1, 0);
     Emu_WriteBoth32(P, P.CPU.Regs.SI, P.CPU.Regs.DI + 2, Entry.LBA);
     Emu_WriteBoth32(P, P.CPU.Regs.SI, P.CPU.Regs.DI + 10, Entry.Size);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 18, Entry.Year);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 19, Entry.Month);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 20, Entry.Day);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 21, Entry.Hour);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 22, Entry.Minute);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 23, Entry.Second);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 24, 0);
     If Entry.IsDir Then Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 25, 2)
     Else Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 25, 0);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 26, 0);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 27, 0);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 28, 1);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 29, 0);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 30, 0);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 31, 1);
     Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 32, Length(Entry.Name));
     For I := 1 To Length(Entry.Name) Do
      Emu_WriteByte(P.CPU, P.CPU.Regs.SI, P.CPU.Regs.DI + 32 + I, Byte(Entry.Name[I]));
     P.CPU.Regs.AX := 1;  { 1=ISO9660 (0=High Sierra, jamais produit ici) }
     Exclude(P.CPU.Flags.s, EFG_CF);
    End;
   End;
  End;
  $10: Emu_MscdexDeviceRequest(P);  { Send Device Driver Request }
 Else
  Begin Include(P.CPU.Flags.s, EFG_CF); P.CPU.Regs.AX := 1; End; { fonction }
                                                                  { non definie}
 End;
End;

{ ========================================================================= }
{ DPMI (DOS Protected Mode Interface, voir DOC/DPMI.txt) - services et      }
{ traduction memoire du coeur CPU 32 bits protege PARALLELE (DpmiCPU/       }
{ EmuDpmi, voir leur commentaire de tete pres de leur declaration de type,  }
{ juste apres TEmuEmsState). Etape 1/5 de cette fonctionnalite : les        }
{ services descripteurs/memoire (bien specifies, autonomes) et le          }
{ mecanisme de detection/commutation sont implantes ici ; le decodeur      }
{ d instructions 32 bits protegees (Dpmi_Step) et son branchement dans la  }
{ boucle principale suivent plus bas dans ce fichier. Les rappels mode reel}
{ (AX=0300h-0306h) et la gestion des exceptions (AX=0200h-0205h) sont      }
{ prevus pour des etapes ulterieures (voir le plan en tete de session). }
{ ========================================================================= }

{ --- Traduction memoire lineaire -> emplacement physique reel : < 1 Mo    }
{ (EMU_DPMI_EXT_BASE) redirige vers P.CPU.Memory (memoire conventionnelle, }
{ PARTAGEE avec le coeur 8086 reel - un programme DPMI qui touche a de la  }
{ memoire basse doit voir/modifier les MEMES octets que son propre code    }
{ mode reel, ex. son PSP/tas), >= 1 Mo redirige vers EmuDpmiExtMem (pool   }
{ separe, comme EmuXmsMem/EmuEmsMem). Hors bornes : 0 en lecture, ignore   }
{ en ecriture (meme convention defensive que Emu64_GetByte de l emulateur  }
{ ELF64). --- }
Function Dpmi_ReadByte(Var P: TEmulatorPanel; LinAddr: LongInt): Byte;
Begin
 If (LinAddr >= 0) And (LinAddr < EMU_DPMI_EXT_BASE) Then
  Dpmi_ReadByte := P.CPU.Memory^[LinAddr]
 Else If (LinAddr >= EMU_DPMI_EXT_BASE) And
    (LinAddr < EMU_DPMI_EXT_BASE + EmuDpmi.ExtCapBytes) And
    (EmuDpmiExtMem <> Nil) Then
  Dpmi_ReadByte := EmuDpmiExtMem^[LinAddr - EMU_DPMI_EXT_BASE]
 Else
  Dpmi_ReadByte := 0;
End;

Procedure Dpmi_WriteByte(Var P: TEmulatorPanel; LinAddr: LongInt; V: Byte);
Begin
 If (LinAddr >= 0) And (LinAddr < EMU_DPMI_EXT_BASE) Then
  P.CPU.Memory^[LinAddr] := V
 Else If (LinAddr >= EMU_DPMI_EXT_BASE) And
    (LinAddr < EMU_DPMI_EXT_BASE + EmuDpmi.ExtCapBytes) And
    (EmuDpmiExtMem <> Nil) Then
  EmuDpmiExtMem^[LinAddr - EMU_DPMI_EXT_BASE] := V;
End;

Function Dpmi_ReadWord(Var P: TEmulatorPanel; LinAddr: LongInt): Word;
Begin
 Dpmi_ReadWord := Word(Dpmi_ReadByte(P, LinAddr)) Or
  (Word(Dpmi_ReadByte(P, LinAddr + 1)) Shl 8);
End;

Procedure Dpmi_WriteWord(Var P: TEmulatorPanel; LinAddr: LongInt; V: Word);
Begin
 Dpmi_WriteByte(P, LinAddr, Byte(V And $FF));
 Dpmi_WriteByte(P, LinAddr + 1, Byte(V Shr 8));
End;

Function Dpmi_ReadDWord(Var P: TEmulatorPanel; LinAddr: LongInt): LongInt;
Begin
 Dpmi_ReadDWord := LongInt(Dpmi_ReadWord(P, LinAddr)) Or
  (LongInt(Dpmi_ReadWord(P, LinAddr + 2)) Shl 16);
End;

Procedure Dpmi_WriteDWord(Var P: TEmulatorPanel; LinAddr: LongInt; V: LongInt);
Begin
 Dpmi_WriteWord(P, LinAddr, Word(V And $FFFF));
 Dpmi_WriteWord(P, LinAddr + 2, Word((V Shr 16) And $FFFF));
End;

{ --- Selecteurs -> descripteurs : le TI (bit 2) et le RPL (bits 1-0) sont  }
{ ignores (un seul client actif a la fois dans cet emulateur, donc LDT et  }
{ GDT sont confondues - voir le commentaire de tete pres de TDpmiLDT) :    }
{ seul l INDEX (bits 15-3) est significatif. --- }
Function Dpmi_SelToIdx(Sel: Word; Var Idx: Integer): Boolean;
Begin
 Idx := Sel Shr 3;
 Dpmi_SelToIdx := (Idx >= 0) And (Idx <= EMU_DPMI_MAX_SEL) And
  DpmiCPU.LDT[Idx].Present;
End;

Function Dpmi_SelBase(Sel: Word): LongInt;
Var Idx: Integer;
Begin
 If Dpmi_SelToIdx(Sel, Idx) Then Dpmi_SelBase := DpmiCPU.LDT[Idx].Base
 Else Dpmi_SelBase := 0;
End;

Function Dpmi_SelLimit(Sel: Word): LongInt;
Var Idx: Integer;
Begin
 If Dpmi_SelToIdx(Sel, Idx) Then Dpmi_SelLimit := DpmiCPU.LDT[Idx].Limit
 Else Dpmi_SelLimit := 0;
End;

{ Adresse lineaire d un couple selecteur:offset - AUCUNE verification de   }
{ limite n est appliquee (un vrai serveur DPMI declencherait une exception }
{ 0Dh GPF au-dela de la limite - non implante dans cette premiere etape,   }
{ voir le commentaire de tete de Dpmi_Step plus bas). }
Function Dpmi_LinAddr(Sel: Word; Ofs: LongInt): LongInt;
Begin
 Dpmi_LinAddr := Dpmi_SelBase(Sel) + Ofs;
End;

Procedure Dpmi_SetDescBase(Sel: Word; NewBase: LongInt);
Var Idx: Integer;
Begin
 If Dpmi_SelToIdx(Sel, Idx) Then DpmiCPU.LDT[Idx].Base := NewBase;
End;

Procedure Dpmi_SetDescLimit(Sel: Word; NewLimit: LongInt);
Var Idx: Integer;
Begin
 If Dpmi_SelToIdx(Sel, Idx) Then Begin
  DpmiCPU.LDT[Idx].Limit := NewLimit;
  DpmiCPU.LDT[Idx].Big := NewLimit > $FFFF; { deduit, voir AX=0008h }
 End;
End;

{ --- Registres 8/16/32 bits par numero ModRM (0=A 1=C 2=D 3=B 4=SP/AH     }
{ 5=BP/CH 6=SI/DH 7=DI/BH) - equivalent de Emu_GetReg16/SetReg16 (coeur    }
{ 8086) mais operant directement sur un TEmuRegs autonome (celui de        }
{ DpmiCPU), reutilise par Dpmi_Step (decodeur d instructions, plus bas). }
Function Dpmi_GetReg32(Var R: TEmuRegs; Num: Byte): LongInt;
Begin
 Case Num And 7 Of
  0: Dpmi_GetReg32 := R.EAX; 1: Dpmi_GetReg32 := R.ECX;
  2: Dpmi_GetReg32 := R.EDX; 3: Dpmi_GetReg32 := R.EBX;
  4: Dpmi_GetReg32 := R.ESP; 5: Dpmi_GetReg32 := R.EBP;
  6: Dpmi_GetReg32 := R.ESI; 7: Dpmi_GetReg32 := R.EDI;
 End;
End;

Procedure Dpmi_SetReg32(Var R: TEmuRegs; Num: Byte; V: LongInt);
Begin
 Case Num And 7 Of
  0: R.EAX := V; 1: R.ECX := V; 2: R.EDX := V; 3: R.EBX := V;
  4: R.ESP := V; 5: R.EBP := V; 6: R.ESI := V; 7: R.EDI := V;
 End;
End;

Function Dpmi_GetReg16(Var R: TEmuRegs; Num: Byte): Word;
Begin
 Case Num And 7 Of
  0: Dpmi_GetReg16 := R.AX; 1: Dpmi_GetReg16 := R.CX;
  2: Dpmi_GetReg16 := R.DX; 3: Dpmi_GetReg16 := R.BX;
  4: Dpmi_GetReg16 := R.SP; 5: Dpmi_GetReg16 := R.BP;
  6: Dpmi_GetReg16 := R.SI; 7: Dpmi_GetReg16 := R.DI;
 End;
End;

Procedure Dpmi_SetReg16(Var R: TEmuRegs; Num: Byte; V: Word);
Begin
 Case Num And 7 Of
  0: R.AX := V; 1: R.CX := V; 2: R.DX := V; 3: R.BX := V;
  4: R.SP := V; 5: R.BP := V; 6: R.SI := V; 7: R.DI := V;
 End;
End;

Function Dpmi_GetReg8(Var R: TEmuRegs; Num: Byte): Byte;
Begin
 Case Num And 7 Of
  0: Dpmi_GetReg8 := R.AL; 1: Dpmi_GetReg8 := R.CL;
  2: Dpmi_GetReg8 := R.DL; 3: Dpmi_GetReg8 := R.BL;
  4: Dpmi_GetReg8 := R.AH; 5: Dpmi_GetReg8 := R.CH;
  6: Dpmi_GetReg8 := R.DH; 7: Dpmi_GetReg8 := R.BH;
 End;
End;

Procedure Dpmi_SetReg8(Var R: TEmuRegs; Num: Byte; V: Byte);
Begin
 Case Num And 7 Of
  0: R.AL := V; 1: R.CL := V; 2: R.DL := V; 3: R.BL := V;
  4: R.AH := V; 5: R.CH := V; 6: R.DH := V; 7: R.BH := V;
 End;
End;

{ --- AX=0000h : allouer Count descripteurs LDT CONTIGUS (voir DOC/       }
{ DPMI.txt 4.1) - cherche une plage libre de la bonne taille. --- }
Function Dpmi_AllocLDT(Count: Integer; Var FirstSel: Word): Boolean;
Var I, J, Run: Integer;
Begin
 Dpmi_AllocLDT := False;
 If Count < 1 Then Exit;
 I := 0;
 While I + Count - 1 <= EMU_DPMI_MAX_SEL Do Begin
  Run := 0;
  For J := 0 To Count - 1 Do
   If Not DpmiCPU.LDT[I + J].Present Then Inc(Run);
  If Run = Count Then Begin
   For J := 0 To Count - 1 Do Begin
    FillChar(DpmiCPU.LDT[I + J], SizeOf(TDpmiDescriptor), 0);
    DpmiCPU.LDT[I + J].Present := True;
    DpmiCPU.LDT[I + J].AccessByte := $92; { donnees lire/ecrire present DPL0 }
   End;
   FirstSel := Word((I Shl 3) Or 4);  { TI=1 (LDT), RPL=0 - purement       }
   Inc(DpmiCPU.LDTCount, Count);      { cosmetique ici (voir Dpmi_SelToIdx)}
   Dpmi_AllocLDT := True;
   Exit;
  End;
  Inc(I, Run + 1);
 End;
End;

{ AX=0001h }
Function Dpmi_FreeLDT(Sel: Word): Boolean;
Var Idx: Integer;
Begin
 Dpmi_FreeLDT := False;
 If Not Dpmi_SelToIdx(Sel, Idx) Then Exit;
 FillChar(DpmiCPU.LDT[Idx], SizeOf(TDpmiDescriptor), 0);
 If DpmiCPU.LDTCount > 0 Then Dec(DpmiCPU.LDTCount);
 Dpmi_FreeLDT := True;
End;

{ AX=0002h - creer un selecteur pour le segment reel RealSeg (base =      }
{ RealSeg*16, limite = 64 Ko - 1), voir DOC/DPMI.txt 4.3. }
Function Dpmi_SegToSel(RealSeg: Word): Word;
Var Sel: Word;
Begin
 If Not Dpmi_AllocLDT(1, Sel) Then Begin Dpmi_SegToSel := 0; Exit; End;
 Dpmi_SetDescBase(Sel, LongInt(RealSeg) Shl 4);
 Dpmi_SetDescLimit(Sel, $FFFF);
 Dpmi_SegToSel := Sel;
End;

{ --- AX=0100h/0101h/0102h : memoire DOS basse (bump allocator dedie dans  }
{ le segment scratch EMU_DPMI_DOSMEM_SEG, voir son commentaire de tete -   }
{ jamais recupere avant que TOUTE la zone soit consideree libre, meme      }
{ principe assume que les autres allocateurs "bump" de cette session       }
{ (XMS/EMS/IPX) - documente comme limitation acceptable). --- }
Function Dpmi_AllocDosMem(Paragraphs: Word; Var RealSeg, Sel: Word): Boolean;
Var Bytes: LongInt;
Begin
 Dpmi_AllocDosMem := False;
 Bytes := LongInt(Paragraphs) * 16;
 If EmuDpmi.DosMemUsedOfs + Bytes > EMU_DPMI_DOSMEM_START + EMU_DPMI_DOSMEM_CAP Then
  Exit;
 RealSeg := EMU_DPMI_DOSMEM_SEG + (EmuDpmi.DosMemUsedOfs Shr 4);
 Sel := Dpmi_SegToSel(RealSeg);
 If Sel = 0 Then Exit;
 Inc(EmuDpmi.DosMemUsedOfs, Word(Bytes));
 Dpmi_AllocDosMem := True;
End;

{ --- AX=0501h/0502h/0503h : memoire etendue DPMI (bump allocator, meme    }
{ principe que Emu_XmsAllocBlock/Emu_EmsAllocHandle). --- }
Function Dpmi_ExtAlloc(SizeBytes: LongInt; Var OutHandle: Integer;
 Var LinAddr: LongInt): Boolean;
Var I: Integer;
Begin
 Dpmi_ExtAlloc := False;
 If EmuDpmiExtMem = Nil Then Exit;
 If EmuDpmi.UsedBytes + SizeBytes > EmuDpmi.ExtCapBytes Then Exit;
 For I := 0 To EMU_DPMI_MAX_HANDLE - 1 Do
  If Not EmuDpmi.Handles[I].InUse Then Begin
   EmuDpmi.Handles[I].InUse := True;
   EmuDpmi.Handles[I].LinAddr := EMU_DPMI_EXT_BASE + EmuDpmi.UsedBytes;
   EmuDpmi.Handles[I].Size := SizeBytes;
   Inc(EmuDpmi.UsedBytes, SizeBytes);
   OutHandle := I;
   LinAddr := EmuDpmi.Handles[I].LinAddr;
   Dpmi_ExtAlloc := True;
   Exit;
  End;
End;

Function Dpmi_ExtFree(H: Integer): Boolean;
Var I: Integer;
 AllFree: Boolean;
Begin
 Dpmi_ExtFree := False;
 If (H < 0) Or (H >= EMU_DPMI_MAX_HANDLE) Or (Not EmuDpmi.Handles[H].InUse) Then
  Exit;
 EmuDpmi.Handles[H].InUse := False;
 AllFree := True;
 For I := 0 To EMU_DPMI_MAX_HANDLE - 1 Do
  If EmuDpmi.Handles[I].InUse Then AllFree := False;
 If AllFree Then EmuDpmi.UsedBytes := 0; { recuperation seulement quand TOUT }
                                          { est libere, voir le commentaire  }
                                          { de tete de section }
 Dpmi_ExtFree := True;
End;

{ Reinitialise l etat DPMI et, si la case "DPMI" est cochee, alloue le     }
{ tampon "memoire etendue" separe. Appelee a chaque (re)demarrage de       }
{ l emulateur, comme Emu_EmsInit/Emu_MouseInit. }
Procedure Emu_DpmiInit(Var P: TEmulatorPanel);
Begin
 FillChar(EmuDpmi, SizeOf(EmuDpmi), 0);
 FillChar(DpmiCPU, SizeOf(DpmiCPU), 0);
 EmuDpmi.Active := OptionsDlg.Data.DosDPMI;
 If EmuDpmiExtMem <> Nil Then Begin
  Dispose(EmuDpmiExtMem);
  EmuDpmiExtMem := Nil;
 End;
 EmuDpmi.DosMemUsedOfs := EMU_DPMI_DOSMEM_START;
 If Not EmuDpmi.Active Then Exit;
 EmuDpmi.ExtCapBytes := LongInt(OptionsDlg.Data.DosDPMISize) * 1024;
 If EmuDpmi.ExtCapBytes > EMU_DPMI_EXT_CAP_KB * 1024 Then
  EmuDpmi.ExtCapBytes := EMU_DPMI_EXT_CAP_KB * 1024;
 If EmuDpmi.ExtCapBytes < 0 Then EmuDpmi.ExtCapBytes := 0;
 New(EmuDpmiExtMem);
 If EmuDpmiExtMem = Nil Then Begin
  EmuDpmi.Active := False;
  Exit;
 End;
 FillChar(EmuDpmiExtMem^, SizeOf(EmuDpmiExtMem^), 0);
 { Trampoline de commutation reel -> protege (voir Dpmi_Switch) : INT FBh, }
 { jamais rencontre par du logiciel DOS reel. }
 Emu_WriteByte(P.CPU, EMU_DPMI_STUB_SEG, EMU_DPMI_STUB_OFS,     $CD);
 Emu_WriteByte(P.CPU, EMU_DPMI_STUB_SEG, EMU_DPMI_STUB_OFS + 1, $FB);
End;

{ Gestionnaire du point d entree DPMI (voir DOC/DPMI.txt 3.2) - execute    }
{ quand le CLIENT (encore en mode reel, via Emu_StepOne) execute un CALL   }
{ FAR sur l adresse retournee par INT 2Fh AX=1687h (EMU_DPMI_STUB_SEG:OFS).}
{ Depile nous-memes le CS:IP de retour pousses par ce CALL FAR (plutot que }
{ de laisser un RETF les consommer) : on ne "revient" pas reellement, on   }
{ POURSUIT au meme point physique mais desormais interprete par Dpmi_Step  }
{ (voir le branchement dans la boucle principale, plus bas) - c est ce qui }
{ rend la transition coherente : Base(CS protege) = RealCS*16 et           }
{ EIP = RealIP, donc Base+EIP tombe exactement sur le meme octet physique  }
{ que RealCS:RealIP en mode reel. }
Procedure Dpmi_Switch(Var P: TEmulatorPanel);
Var
 RetIP, RetCS: Word;
 Want32: Boolean;
 CodeSel, DataSel, EsSel, SsSel: Word;
 CodeIdx: Integer;
Begin
 If Not EmuDpmi.Active Then Exit; { securite, ne devrait pas arriver }
 RetIP := Emu_PopWord(P.CPU);
 RetCS := Emu_PopWord(P.CPU);
 Want32 := P.CPU.Regs.AX <> 0;
 FillChar(DpmiCPU, SizeOf(DpmiCPU), 0);
 DpmiCPU.Is32Bit := Want32;
 DpmiCPU.RealCS := RetCS; DpmiCPU.RealIP := RetIP;
 DpmiCPU.RealSS := P.CPU.Segs.SS; DpmiCPU.RealSP := P.CPU.Regs.SP;
 CodeSel := Dpmi_SegToSel(RetCS);
 If Dpmi_SelToIdx(CodeSel, CodeIdx) Then Begin
  DpmiCPU.LDT[CodeIdx].AccessByte := $9A; { code lire/execute present DPL0 }
  DpmiCPU.LDT[CodeIdx].IsCode := True;
 End;
 DataSel := Dpmi_SegToSel(P.CPU.Segs.DS);
 EsSel := Dpmi_SegToSel(P.CPU.Segs.ES);
 SsSel := Dpmi_SegToSel(P.CPU.Segs.SS);
 DpmiCPU.SegSel[0] := EsSel;   { ES }
 DpmiCPU.SegSel[1] := CodeSel; { CS }
 DpmiCPU.SegSel[2] := SsSel;   { SS }
 DpmiCPU.SegSel[3] := DataSel; { DS }
 DpmiCPU.SegSel[4] := DataSel; { FS - alias de DS par defaut }
 DpmiCPU.SegSel[5] := DataSel; { GS - alias de DS par defaut }
 DpmiCPU.Reg := P.CPU.Regs;    { copie EAX..EDI/AX..DI (le meme record      }
                                { variant TEmuRegs) pour continuite - ESP    }
                                { reflete deja la pile APRES le pop ci-dessus}
 DpmiCPU.EIP := RetIP;
 DpmiCPU.Flags.s := P.CPU.Flags.s;
 Exclude(DpmiCPU.Flags.s, EFG_CF); { succes, voir DOC/DPMI.txt 3.2 }
 DpmiCPU.Active := True;
End;

{ --- Lire/ecrire la RealModeCallStructure de 50 octets (voir DOC/DPMI.txt }
{ 7.1) a l adresse lineaire donnee - utilisee par AX=0300h/0301h/0302h. --- }
Procedure Dpmi_ReadRMCall(Var P: TEmulatorPanel; LinAddr: LongInt;
 Var R: TDpmiRMCall);
Begin
 R.EDI  := Dpmi_ReadDWord(P, LinAddr);
 R.ESI  := Dpmi_ReadDWord(P, LinAddr + 4);
 R.EBP  := Dpmi_ReadDWord(P, LinAddr + 8);
 R.EBX  := Dpmi_ReadDWord(P, LinAddr + 16);
 R.EDX  := Dpmi_ReadDWord(P, LinAddr + 20);
 R.ECX  := Dpmi_ReadDWord(P, LinAddr + 24);
 R.EAX  := Dpmi_ReadDWord(P, LinAddr + 28);
 R.Flags := Dpmi_ReadWord(P, LinAddr + 32);
 R.ESeg := Dpmi_ReadWord(P, LinAddr + 34);
 R.DSeg := Dpmi_ReadWord(P, LinAddr + 36);
 R.FSeg := Dpmi_ReadWord(P, LinAddr + 38);
 R.GSeg := Dpmi_ReadWord(P, LinAddr + 40);
 R.IPw  := Dpmi_ReadWord(P, LinAddr + 42);
 R.CSw  := Dpmi_ReadWord(P, LinAddr + 44);
 R.SPw  := Dpmi_ReadWord(P, LinAddr + 46);
 R.SSw  := Dpmi_ReadWord(P, LinAddr + 48);
End;

Procedure Dpmi_WriteRMCall(Var P: TEmulatorPanel; LinAddr: LongInt;
 Const R: TDpmiRMCall);
Begin
 Dpmi_WriteDWord(P, LinAddr, R.EDI);
 Dpmi_WriteDWord(P, LinAddr + 4, R.ESI);
 Dpmi_WriteDWord(P, LinAddr + 8, R.EBP);
 Dpmi_WriteDWord(P, LinAddr + 16, R.EBX);
 Dpmi_WriteDWord(P, LinAddr + 20, R.EDX);
 Dpmi_WriteDWord(P, LinAddr + 24, R.ECX);
 Dpmi_WriteDWord(P, LinAddr + 28, R.EAX);
 Dpmi_WriteWord(P, LinAddr + 32, R.Flags);
 Dpmi_WriteWord(P, LinAddr + 34, R.ESeg);
 Dpmi_WriteWord(P, LinAddr + 36, R.DSeg);
 Dpmi_WriteWord(P, LinAddr + 38, R.FSeg);
 Dpmi_WriteWord(P, LinAddr + 40, R.GSeg);
 Dpmi_WriteWord(P, LinAddr + 42, R.IPw);
 Dpmi_WriteWord(P, LinAddr + 44, R.CSw);
 Dpmi_WriteWord(P, LinAddr + 46, R.SPw);
 Dpmi_WriteWord(P, LinAddr + 48, R.SSw);
End;

{ --- AX=0301h/0302h : "appeler une procedure mode reel" arbitraire (pas   }
{ un de nos vecteurs d interruption simules, voir AX=0300h/Emu_DoInt31 ci- }
{ dessous) - empile une fausse "adresse de retour" pointant sur un         }
{ marqueur (EMU_DPMI_RMCALL_SEG:OFS, jamais reellement execute puisque la  }
{ boucle ci-dessous s arrete DES QUE CS:IP l atteint), saute a TargetCS:IP,}
{ puis fait executer le coeur 8086 REEL (Emu_StepOne, pas Dpmi_Step) tant  }
{ que ce marqueur n est pas atteint - c est la seule facon pour du code    }
{ invite arbitraire (pas nos propres gestionnaires INT internes) de        }
{ s executer en reponse a un service DPMI. Bornee a 2 000 000 pas pour     }
{ eviter un blocage total de l IDE si le code appele ne retourne jamais    }
{ (boucle infinie ou bogue du programme teste). }
Procedure Dpmi_RunRealProc(Var P: TEmulatorPanel; TargetCS, TargetIP: Word;
 ViaIret: Boolean);
Var
 Iter: LongInt;
 TrPrevCS, TrPrevIP: Word;
 TrOp: Byte;
 TrSlot: Integer;
 TrAnnot, TrModName: String;
Begin
 If ViaIret Then Begin
  Emu_PushWord(P.CPU, 0);                    { FLAGS factice, ecrase par IRET}
  Emu_PushWord(P.CPU, EMU_DPMI_RMCALL_SEG);
  Emu_PushWord(P.CPU, EMU_DPMI_RMCALL_OFS);
 End Else Begin
  Emu_PushWord(P.CPU, EMU_DPMI_RMCALL_SEG);  { RETF proche : pop IP puis CS }
  Emu_PushWord(P.CPU, EMU_DPMI_RMCALL_OFS);
 End;
 P.CPU.Segs.CS := TargetCS;
 P.CPU.IP := TargetIP;
 Iter := 0;
 While ((P.CPU.Segs.CS <> EMU_DPMI_RMCALL_SEG) Or (P.CPU.IP <> EMU_DPMI_RMCALL_OFS))
    And (P.CPU.Fault = sfNone) And (Iter < 2000000) Do Begin
  { Diagnostic temporaire (2026-08-30, voir Win16_WndProcTraceOn) : meme    }
  { format exact que le journal pas-a-pas de WIN16RUN, pour rester lisible }
  { avec les memes outils/habitudes deja etablis pour ce chantier. }
  If Win16_WndProcTraceOn Then Begin
   TrPrevCS := P.CPU.Segs.CS;
   TrPrevIP := P.CPU.IP;
   TrOp := Emu_ReadByte(P.CPU, TrPrevCS, TrPrevIP);
   TrAnnot := '';
   If TrPrevCS = Win16_TrapSeg Then Begin
    TrSlot := TrPrevIP Div WIN16_TRAP_SLOT_SIZE;
    If (TrSlot >= 0) And (TrSlot < Win16_ImportSlotCount) Then Begin
     If Win16_ImportModIdx[TrSlot] = 1 Then TrModName := 'KERNEL'
     Else If Win16_ImportModIdx[TrSlot] = 2 Then TrModName := 'GDI'
     Else If Win16_ImportModIdx[TrSlot] = 3 Then TrModName := 'USER'
     Else TrModName := 'module#' + IntToStr(Win16_ImportModIdx[TrSlot]);
     If Win16_ImportIsOrd[TrSlot] Then
      TrAnnot := ' CALL ' + TrModName + '.' + IntToStr(Win16_ImportValue[TrSlot])
     Else
      TrAnnot := ' CALL ' + TrModName + '.(nom)';
    End;
   End;
   WriteLn(Win16_WndProcTraceFile, Iter, ': ', HexWord(TrPrevCS), ':',
    HexWord(TrPrevIP), ' op=', HexByte(TrOp),
    ' AX=', HexWord(P.CPU.Regs.AX), ' BX=', HexWord(P.CPU.Regs.BX),
    ' CX=', HexWord(P.CPU.Regs.CX), ' DX=', HexWord(P.CPU.Regs.DX),
    ' SI=', HexWord(P.CPU.Regs.SI), ' DI=', HexWord(P.CPU.Regs.DI),
    ' BP=', HexWord(P.CPU.Regs.BP), ' SP=', HexWord(P.CPU.Regs.SP),
    ' DS=', HexWord(P.CPU.Segs.DS), ' ES=', HexWord(P.CPU.Segs.ES),
    ' SS=', HexWord(P.CPU.Segs.SS), TrAnnot);
   If Win16_DebugMsg <> '' Then Begin
    WriteLn(Win16_WndProcTraceFile, '    DEBUG: ', Win16_DebugMsg);
    Win16_DebugMsg := '';
   End;
  End;
  Emu_StepOne(P);
  Inc(Iter);
 End;
 Dpmi_LastRunRealProcIter := Iter;
End;

{ --- INT 31h : services DPMI eux-memes, dispatches par Dpmi_Step (plus    }
{ bas) quand le client protege execute CD 31h - opere entierement sur      }
{ DpmiCPU (pas P.CPU, gele tant que DpmiCPU.Active - SAUF pendant          }
{ AX=0300h/0301h/0302h qui font ponctuellement "revivre" P.CPU pour        }
{ satisfaire l appel mode reel demande, voir Dpmi_RunRealProc). Couvre les }
{ services descripteurs (0000h-000Eh), memoire DOS basse (0100h-0102h),    }
{ memoire etendue (0500h-0503h/0604h), version (0400h) et appels/rappels   }
{ mode reel (0300h-0306h, ETAPE 3) - voir l en-tete de section pour la     }
{ portee des etapes ulterieures (0200h-0205h, exceptions, et le retour au  }
{ mode reel en fin de programme). --- }
Procedure Emu_DoInt31(Var P: TEmulatorPanel);
Var
 Sel, NewSel: Word;
 Idx: Integer;
 Base, Lim: LongInt;
 RealSeg: Word;
 H: Integer;
 LinAddr: LongInt;
 Sz: LongInt;
 RM: TDpmiRMCall;
 StructAddr: LongInt;
 IntNum: Byte;
 CbIdx: Integer;
Begin
 Exclude(DpmiCPU.Flags.s, EFG_CF);
 Case DpmiCPU.Reg.AX Of
  $0000: Begin
   If Dpmi_AllocLDT(DpmiCPU.Reg.CX, NewSel) Then DpmiCPU.Reg.AX := NewSel
   Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8011; End;
  End;
  $0001: Begin
   If Not Dpmi_FreeLDT(DpmiCPU.Reg.BX) Then Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022;
   End;
  End;
  $0002: Begin
   RealSeg := DpmiCPU.Reg.BX;
   NewSel := Dpmi_SegToSel(RealSeg);
   If NewSel = 0 Then Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8011;
   End Else DpmiCPU.Reg.AX := NewSel;
  End;
  $0003: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then
    DpmiCPU.Reg.AX := Byte(DpmiCPU.LDT[Idx].IsCode)
   Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $0006: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then Begin
    Base := DpmiCPU.LDT[Idx].Base;
    DpmiCPU.Reg.CX := Word((Base Shr 16) And $FFFF);
    DpmiCPU.Reg.DX := Word(Base And $FFFF);
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $0007: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then
    Dpmi_SetDescBase(DpmiCPU.Reg.BX,
     (LongInt(DpmiCPU.Reg.CX) Shl 16) Or DpmiCPU.Reg.DX)
   Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $0008: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then
    Dpmi_SetDescLimit(DpmiCPU.Reg.BX,
     (LongInt(DpmiCPU.Reg.CX) Shl 16) Or DpmiCPU.Reg.DX)
   Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $0009: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then Begin
    DpmiCPU.LDT[Idx].AccessByte := DpmiCPU.Reg.CL;
    DpmiCPU.LDT[Idx].FlagsByte := DpmiCPU.Reg.CH;
    DpmiCPU.LDT[Idx].IsCode := (DpmiCPU.Reg.CL And $18) = $18;
    DpmiCPU.LDT[Idx].Big := (DpmiCPU.Reg.CH And $40) <> 0;
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $000A: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then Begin
    If Dpmi_AllocLDT(1, NewSel) Then Begin
     Dpmi_SetDescBase(NewSel, DpmiCPU.LDT[Idx].Base);
     Dpmi_SetDescLimit(NewSel, DpmiCPU.LDT[Idx].Limit);
     DpmiCPU.Reg.AX := NewSel;
    End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8011; End;
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $000B: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then Begin
    Base := DpmiCPU.LDT[Idx].Base; Lim := DpmiCPU.LDT[Idx].Limit;
    LinAddr := Dpmi_LinAddr(DpmiCPU.SegSel[0], LongInt(DpmiCPU.Reg.DI));
    Dpmi_WriteWord(P, LinAddr, Word(Lim And $FFFF));
    Dpmi_WriteWord(P, LinAddr + 2, Word(Base And $FFFF));
    Dpmi_WriteByte(P, LinAddr + 4, Byte((Base Shr 16) And $FF));
    Dpmi_WriteByte(P, LinAddr + 5, DpmiCPU.LDT[Idx].AccessByte);
    Dpmi_WriteByte(P, LinAddr + 6,
     Byte((Lim Shr 16) And $0F) Or (DpmiCPU.LDT[Idx].FlagsByte And $F0));
    Dpmi_WriteByte(P, LinAddr + 7, Byte((Base Shr 24) And $FF));
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $000C: Begin
   If Dpmi_SelToIdx(DpmiCPU.Reg.BX, Idx) Then Begin
    LinAddr := Dpmi_LinAddr(DpmiCPU.SegSel[0], LongInt(DpmiCPU.Reg.DI));
    Lim := LongInt(Dpmi_ReadWord(P, LinAddr)) Or
     (LongInt(Dpmi_ReadByte(P, LinAddr + 6) And $0F) Shl 16);
    Base := LongInt(Dpmi_ReadWord(P, LinAddr + 2)) Or
     (LongInt(Dpmi_ReadByte(P, LinAddr + 4)) Shl 16) Or
     (LongInt(Dpmi_ReadByte(P, LinAddr + 7)) Shl 24);
    DpmiCPU.LDT[Idx].Base := Base;
    DpmiCPU.LDT[Idx].Limit := Lim;
    DpmiCPU.LDT[Idx].AccessByte := Dpmi_ReadByte(P, LinAddr + 5);
    DpmiCPU.LDT[Idx].FlagsByte := Dpmi_ReadByte(P, LinAddr + 6) And $F0;
    DpmiCPU.LDT[Idx].IsCode := (DpmiCPU.LDT[Idx].AccessByte And $18) = $18;
    DpmiCPU.LDT[Idx].Big := (DpmiCPU.LDT[Idx].FlagsByte And $40) <> 0;
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8022; End;
  End;
  $000D: Begin
   Idx := DpmiCPU.Reg.BX;
   If (Idx < 0) Or (Idx > EMU_DPMI_MAX_SEL) Or DpmiCPU.LDT[Idx].Present Then Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8011;
   End Else Begin
    FillChar(DpmiCPU.LDT[Idx], SizeOf(TDpmiDescriptor), 0);
    DpmiCPU.LDT[Idx].Present := True;
    DpmiCPU.LDT[Idx].AccessByte := $92;
    Inc(DpmiCPU.LDTCount);
    DpmiCPU.Reg.AX := Word((Idx Shl 3) Or 4);
   End;
  End;
  $000E: Begin
   If Dpmi_AllocLDT(1, NewSel) Then Begin
    Dpmi_SetDescBase(NewSel, 0);
    Dpmi_SetDescLimit(NewSel, -1); { alias 4 Go complet (limite = $FFFFFFFF, }
                                    { meme motif binaire que -1 en LongInt)  }
    DpmiCPU.Reg.AX := NewSel;
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8011; End;
  End;
  $0200: Begin
   { Obtenir le vecteur d interruption MODE REEL (la vraie IVT a            }
   { 0000:BL*4, partagee avec le coeur 8086 reel - voir DOC/DPMI.txt 6.1). }
   Idx := DpmiCPU.Reg.BL;
   DpmiCPU.Reg.CX := Emu_ReadWord(P.CPU, 0, Word(Idx) * 4 + 2);
   DpmiCPU.Reg.DX := Emu_ReadWord(P.CPU, 0, Word(Idx) * 4);
  End;
  $0201: Begin
   Idx := DpmiCPU.Reg.BL;
   Emu_WriteWord(P.CPU, 0, Word(Idx) * 4, DpmiCPU.Reg.DX);
   Emu_WriteWord(P.CPU, 0, Word(Idx) * 4 + 2, DpmiCPU.Reg.CX);
  End;
  $0202, $0204: Begin
   { Obtenir le gestionnaire d exception (0202h, BL=00h-1Fh) ou             }
   { d interruption (0204h, BL=00h-FFh) PROTEGE installe - meme table       }
   { DpmiCPU.IntSel/IntOfs pour les deux (comme la vraie IDT x86, qui ne     }
   { distingue pas exceptions et interruptions - voir DOC/DPMI.txt 6.3/6.5).}
   Idx := DpmiCPU.Reg.BL;
   DpmiCPU.Reg.CX := DpmiCPU.IntSel[Idx];
   DpmiCPU.Reg.EDX := DpmiCPU.IntOfs[Idx];
  End;
  $0203, $0205: Begin
   Idx := DpmiCPU.Reg.BL;
   DpmiCPU.IntSel[Idx] := DpmiCPU.Reg.CX;
   DpmiCPU.IntOfs[Idx] := DpmiCPU.Reg.EDX;
  End;
  $0100: Begin
   If Dpmi_AllocDosMem(DpmiCPU.Reg.BX, RealSeg, NewSel) Then Begin
    DpmiCPU.Reg.AX := RealSeg;
    DpmiCPU.Reg.DX := NewSel;
   End Else Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8013;
    DpmiCPU.Reg.BX := (EMU_DPMI_DOSMEM_CAP -
     (EmuDpmi.DosMemUsedOfs - EMU_DPMI_DOSMEM_START)) Shr 4;
   End;
  End;
  $0101: Dpmi_FreeLDT(DpmiCPU.Reg.DX); { la zone DOS basse elle-meme n est   }
                                        { recuperee que globalement, voir    }
                                        { le commentaire de tete de section  }
  $0102: Begin
   { Redimensionnement non supporte par ce bump allocator simplifie -       }
   { echoue proprement plutot que de fabriquer un resultat incorrect. }
   Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8013;
   DpmiCPU.Reg.BX := 0;
  End;
  $0300: Begin
   { Simuler un appel d interruption mode reel (voir DOC/DPMI.txt 7.1) :    }
   { BL=numero, ES:EDI=structure. Contrairement a 0301h/0302h ci-dessous,   }
   { aucune execution reelle de code invite n est necessaire : nos          }
   { interruptions DOS/BIOS/pilotes sont TOUTES gerees par du code Pascal    }
   { interne (Emu_DoInt) plutot que par du bytecode invite, donc un simple  }
   { appel direct suffit - couvre la quasi-totalite des besoins reels d un  }
   { client DPMI (appeler INT 21h/10h/16h/33h/2Fh depuis le mode protege).  }
   IntNum := DpmiCPU.Reg.BL;
   StructAddr := Dpmi_LinAddr(DpmiCPU.SegSel[0], LongInt(DpmiCPU.Reg.EDI));
   Dpmi_ReadRMCall(P, StructAddr, RM);
   P.CPU.Regs.EDI := RM.EDI; P.CPU.Regs.ESI := RM.ESI; P.CPU.Regs.EBP := RM.EBP;
   P.CPU.Regs.EBX := RM.EBX; P.CPU.Regs.EDX := RM.EDX; P.CPU.Regs.ECX := RM.ECX;
   P.CPU.Regs.EAX := RM.EAX;
   P.CPU.Segs.ES := RM.ESeg; P.CPU.Segs.DS := RM.DSeg;
   P.CPU.FS := RM.FSeg; P.CPU.GS := RM.GSeg;
   Emu_DoInt(P, IntNum);
   RM.EDI := P.CPU.Regs.EDI; RM.ESI := P.CPU.Regs.ESI; RM.EBP := P.CPU.Regs.EBP;
   RM.EBX := P.CPU.Regs.EBX; RM.EDX := P.CPU.Regs.EDX; RM.ECX := P.CPU.Regs.ECX;
   RM.EAX := P.CPU.Regs.EAX;
   RM.ESeg := P.CPU.Segs.ES; RM.DSeg := P.CPU.Segs.DS;
   RM.FSeg := P.CPU.FS; RM.GSeg := P.CPU.GS;
   { Reconstruit un mot FLAGS 16 bits minimal (CF/ZF, les bits que les       }
   { appelants DPMI verifient en pratique apres un appel DOS/BIOS) plutot   }
   { que de pretendre reconstituer les 16 bits reels avec exactitude. }
   RM.Flags := 0;
   If EFG_CF In P.CPU.Flags.s Then RM.Flags := RM.Flags Or 1;
   If EFG_ZF In P.CPU.Flags.s Then RM.Flags := RM.Flags Or $40;
   Dpmi_WriteRMCall(P, StructAddr, RM);
  End;
  $0301, $0302: Begin
   { Appeler une PROCEDURE mode reel arbitraire (CS:IP fournis dans la      }
   { structure, pas un numero de vecteur) - contrairement a 0300h, ceci     }
   { exige de reellement executer du code invite : voir Dpmi_RunRealProc. }
   StructAddr := Dpmi_LinAddr(DpmiCPU.SegSel[0], LongInt(DpmiCPU.Reg.EDI));
   Dpmi_ReadRMCall(P, StructAddr, RM);
   P.CPU.Regs.EDI := RM.EDI; P.CPU.Regs.ESI := RM.ESI; P.CPU.Regs.EBP := RM.EBP;
   P.CPU.Regs.EBX := RM.EBX; P.CPU.Regs.EDX := RM.EDX; P.CPU.Regs.ECX := RM.ECX;
   P.CPU.Regs.EAX := RM.EAX;
   P.CPU.Segs.ES := RM.ESeg; P.CPU.Segs.DS := RM.DSeg;
   P.CPU.FS := RM.FSeg; P.CPU.GS := RM.GSeg;
   P.CPU.Segs.SS := RM.SSw; P.CPU.Regs.SP := RM.SPw;
   Dpmi_RunRealProc(P, RM.CSw, RM.IPw, DpmiCPU.Reg.AX = $0302);
   RM.EDI := P.CPU.Regs.EDI; RM.ESI := P.CPU.Regs.ESI; RM.EBP := P.CPU.Regs.EBP;
   RM.EBX := P.CPU.Regs.EBX; RM.EDX := P.CPU.Regs.EDX; RM.ECX := P.CPU.Regs.ECX;
   RM.EAX := P.CPU.Regs.EAX;
   RM.ESeg := P.CPU.Segs.ES; RM.DSeg := P.CPU.Segs.DS;
   RM.FSeg := P.CPU.FS; RM.GSeg := P.CPU.GS;
   RM.SSw := P.CPU.Segs.SS; RM.SPw := P.CPU.Regs.SP;
   RM.Flags := 0;
   If EFG_CF In P.CPU.Flags.s Then RM.Flags := RM.Flags Or 1;
   If EFG_ZF In P.CPU.Flags.s Then RM.Flags := RM.Flags Or $40;
   Dpmi_WriteRMCall(P, StructAddr, RM);
  End;
  $0303: Begin
   { Allouer un rappel mode reel (voir DOC/DPMI.txt 7.4) : DS:ESI=          }
   { gestionnaire protege. L ALLOCATION est fonctionnelle (le client obtient}
   { une adresse mode reel CX:DX valide et distincte a chaque appel), mais  }
   { l INVOCATION reelle depuis du code mode reel externe (IRQ materielle,  }
   { TSR) n est pas encore cablee : elle exigerait la commutation retour au }
   { mode reel, prevue pour une etape ulterieure (voir l en-tete de section)}
   CbIdx := -1;
   For Idx := 0 To EMU_DPMI_MAX_CALLBACK - 1 Do
    If Not DpmiCPU.CbUsed[Idx] Then Begin CbIdx := Idx; Break; End;
   If CbIdx < 0 Then Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8015;
   End Else Begin
    DpmiCPU.CbUsed[CbIdx] := True;
    DpmiCPU.CbPmSel[CbIdx] := DpmiCPU.SegSel[3];
    DpmiCPU.CbPmOfs[CbIdx] := DpmiCPU.Reg.ESI;
    DpmiCPU.CbRealSeg[CbIdx] := EMU_DPMI_STUB_SEG;
    DpmiCPU.CbRealOfs[CbIdx] := EMU_DPMI_STUB_OFS + 4 + CbIdx * 2;
    DpmiCPU.Reg.CX := DpmiCPU.CbRealSeg[CbIdx];
    DpmiCPU.Reg.DX := DpmiCPU.CbRealOfs[CbIdx];
   End;
  End;
  $0304: Begin
   CbIdx := -1;
   For Idx := 0 To EMU_DPMI_MAX_CALLBACK - 1 Do
    If DpmiCPU.CbUsed[Idx] And (DpmiCPU.CbRealSeg[Idx] = DpmiCPU.Reg.CX) And
       (DpmiCPU.CbRealOfs[Idx] = DpmiCPU.Reg.DX) Then Begin CbIdx := Idx; Break; End;
   If CbIdx >= 0 Then DpmiCPU.CbUsed[CbIdx] := False
   Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8024; End;
  End;
  $0305: Begin
   DpmiCPU.Reg.AX := 90;  { version DPMI 0.9 * 100 }
   DpmiCPU.Reg.BX := 1;   { bit0=1 : 32 bits supporte }
   DpmiCPU.Reg.CL := 3;   { 80386 }
   DpmiCPU.Reg.DH := 0; DpmiCPU.Reg.DL := $5A;
   DpmiCPU.Reg.SI := EMU_DPMI_MAX_CALLBACK;
  End;
  $0306: Begin
   { Adresses "pile de commutation" - sans objet dans ce modele d emulation }
   { (aucune vraie pile de commutation materielle a exposer) ; valeurs      }
   { plausibles mais non dereferencees par un client DPMI bien ecrit. }
   DpmiCPU.Reg.BX := 0; DpmiCPU.Reg.CX := $F000;
   DpmiCPU.Reg.SI := 0; DpmiCPU.Reg.DI := $F100;
  End;
  $0400: Begin
   DpmiCPU.Reg.AX := $005A; { version DPMI 0.90 (BH=0,BL=90 -> voir AH/AL   }
                             { ci-dessous, ordre different de 0305h) }
   DpmiCPU.Reg.AH := 0; DpmiCPU.Reg.AL := $5A;
   DpmiCPU.Reg.BX := 1; { bit0=1 : 32 bits supporte }
   DpmiCPU.Reg.CL := 3; { 386 }
   DpmiCPU.Reg.DX := 0;
  End;
  $0500: Begin
   LinAddr := Dpmi_LinAddr(DpmiCPU.SegSel[0], LongInt(DpmiCPU.Reg.DI));
   Sz := EmuDpmi.ExtCapBytes - EmuDpmi.UsedBytes;
   If Sz < 0 Then Sz := 0;
   Dpmi_WriteDWord(P, LinAddr, Sz);       { +00 memoire physique disponible }
   Dpmi_WriteDWord(P, LinAddr + 4, 0);    { +08 pages libres swap (aucun swap)}
   Dpmi_WriteDWord(P, LinAddr + 8, 0);
   Dpmi_WriteDWord(P, LinAddr + 12, 0);   { +10 pages swap lineaires libres }
   Dpmi_WriteDWord(P, LinAddr + 16, 0);
   Dpmi_WriteDWord(P, LinAddr + 20, 0);   { +18 taille max swap }
   Dpmi_WriteDWord(P, LinAddr + 24, 0);
   Dpmi_WriteDWord(P, LinAddr + 28, Sz);  { +20 espace execute disponible }
   Dpmi_WriteDWord(P, LinAddr + 32, 0);
   Dpmi_WriteDWord(P, LinAddr + 36, EmuDpmi.ExtCapBytes); { +28 espace total }
   Dpmi_WriteDWord(P, LinAddr + 40, 0);
   Dpmi_WriteDWord(P, LinAddr + 44, 0);
  End;
  $0501: Begin
   Sz := (LongInt(DpmiCPU.Reg.BX) Shl 16) Or DpmiCPU.Reg.CX;
   If Dpmi_ExtAlloc(Sz, H, LinAddr) Then Begin
    DpmiCPU.Reg.BX := Word((LinAddr Shr 16) And $FFFF);
    DpmiCPU.Reg.CX := Word(LinAddr And $FFFF);
    DpmiCPU.Reg.SI := Word((LongInt(H) Shr 16) And $FFFF);
    DpmiCPU.Reg.DI := Word(H And $FFFF);
   End Else Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8012; End;
  End;
  $0502: Begin
   H := (LongInt(DpmiCPU.Reg.SI) Shl 16) Or DpmiCPU.Reg.DI;
   If Not Dpmi_ExtFree(H) Then Begin
    Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8023;
   End;
  End;
  $0503: Begin
   { Redimensionnement non supporte par ce bump allocator simplifie (meme  }
   { limitation que AX=0102h - voir le commentaire correspondant). }
   Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8012;
  End;
  $0600, $0601, $0602, $0603: ; { verrouiller/deverrouiller memoire lineaire}
                                { - accepte sans effet (pas de pagination   }
                                { reelle dans cet emulateur) }
  $0604: Begin
   DpmiCPU.Reg.BX := 0; DpmiCPU.Reg.CX := 4096;
  End;
 Else
  Begin Include(DpmiCPU.Flags.s, EFG_CF); DpmiCPU.Reg.AX := $8001; End;
 End;
End;

{ ========================================================================= }
{ Dpmi_Step - decodeur/executeur d instructions 32 bits proteges (ETAPE 2). }
{ Sous-ensemble VOLONTAIREMENT borne (pas les ~256 opcodes x86 au complet) :}
{ ALU 6 voies (ADD/OR/ADC/SBB/AND/SUB/XOR/CMP, les 6 formes standard),      }
{ MOV, LEA, TEST, PUSH/POP (registre et immediat), INC/DEC, Jcc court et    }
{ proche, CALL/RET proches, INT (necessaire pour atteindre Emu_DoInt31),    }
{ groupe F6/F7 partiel (TEST/NOT/NEG), groupe FE/FF partiel (INC/DEC/CALL/  }
{ JMP indirects/PUSH). PAS encore geres (opcode inconnu = arret propre du   }
{ programme protege plutot qu une execution incorrecte silencieuse, voir    }
{ la branche Else finale) : chaines (MOVS/STOS/CMPS/SCAS/REP), decalages/   }
{ rotations (C0/C1/D0-D3), MUL/IMUL/DIV/IDIV, x87 FPU, adressage 16 bits    }
{ (seul l adressage 32 bits est decode par Dpmi_DecodeModRM - suffisant    }
{ pour du code DJGPP/DOS4GW plat, mais pas pour un segment de code "16      }
{ bits proteges" Borland qui utiliserait l adressage classique BX+SI...).   }
{ AUCUNE verification de limite de segment n est appliquee (pas d exception}
{ 0Dh GPF simulee) - portee delib. reduite a un CPU "de confiance". }
{ ========================================================================= }

Function Dpmi_FetchByte(Var P: TEmulatorPanel; Step: Integer): Byte;
Begin
 Dpmi_FetchByte := Dpmi_ReadByte(P,
  Dpmi_LinAddr(DpmiCPU.SegSel[1], DpmiCPU.EIP + Step));
End;

Function Dpmi_FetchWord(Var P: TEmulatorPanel; Step: Integer): Word;
Begin
 Dpmi_FetchWord := Dpmi_ReadWord(P,
  Dpmi_LinAddr(DpmiCPU.SegSel[1], DpmiCPU.EIP + Step));
End;

Function Dpmi_FetchDWord(Var P: TEmulatorPanel; Step: Integer): LongInt;
Begin
 Dpmi_FetchDWord := Dpmi_ReadDWord(P,
  Dpmi_LinAddr(DpmiCPU.SegSel[1], DpmiCPU.EIP + Step));
End;

{ Decode un octet ModR/M (+ eventuel SIB + deplacement) en adressage 32     }
{ bits uniquement (voir le commentaire de tete ci-dessus pour la portee).   }
{ DefSeg/HasOvr viennent du prefixe de segment eventuel de Dpmi_Step ;      }
{ l usage d EBP (ModRM direct ou base SIB) bascule le segment par defaut    }
{ vers SS SAUF si un prefixe de segment explicite est present (meme regle   }
{ que le vrai x86). }
Procedure Dpmi_DecodeModRM(Var P: TEmulatorPanel; ModRM: Byte;
 DefSeg: Word; HasOvr: Boolean; Var Op: TDpmiOperand);
Var
 Mode, RM, Sib, Scale, SIdx, SBase: Byte;
 Disp, EA: LongInt;
 Seg: Word;
 ExtraLen: Integer;
 StackBased: Boolean;
Begin
 Op.IsReg := False; Op.RegNum := 0; Op.LinAddr := 0; Op.Len := 1;
 Mode := (ModRM Shr 6) And 3;
 RM := ModRM And 7;
 If Mode = 3 Then Begin Op.IsReg := True; Op.RegNum := RM; Exit; End;
 Seg := DefSeg;
 ExtraLen := 0;
 StackBased := False;
 EA := 0;
 If RM = 4 Then Begin
  Sib := Dpmi_FetchByte(P, 1);
  Inc(ExtraLen);
  Scale := (Sib Shr 6) And 3;
  SIdx := (Sib Shr 3) And 7;
  SBase := Sib And 7;
  If SIdx <> 4 Then
   EA := Dpmi_GetReg32(DpmiCPU.Reg, SIdx) Shl Scale;
  If (SBase = 5) And (Mode = 0) Then Begin
   Disp := Dpmi_FetchDWord(P, 1 + ExtraLen);
   Inc(ExtraLen, 4);
   EA := EA + Disp;
  End Else Begin
   EA := EA + Dpmi_GetReg32(DpmiCPU.Reg, SBase);
   StackBased := (SBase = 4) Or (SBase = 5); { ESP ou EBP comme base }
  End;
 End Else If (RM = 5) And (Mode = 0) Then Begin
  Disp := Dpmi_FetchDWord(P, 1);
  Inc(ExtraLen, 4);
  EA := Disp;
 End Else Begin
  EA := Dpmi_GetReg32(DpmiCPU.Reg, RM);
  StackBased := (RM = 5); { EBP }
 End;
 Case Mode Of
  1: Begin
   Disp := Dpmi_FetchByte(P, 1 + ExtraLen);
   If (Disp And $80) <> 0 Then Disp := Disp Or LongInt($FFFFFF00);
   EA := EA + Disp;
   Inc(ExtraLen);
  End;
  2: Begin
   Disp := Dpmi_FetchDWord(P, 1 + ExtraLen);
   EA := EA + Disp;
   Inc(ExtraLen, 4);
  End;
 End;
 If StackBased And (Not HasOvr) Then Seg := DpmiCPU.SegSel[2]; { SS }
 Op.LinAddr := Dpmi_LinAddr(Seg, EA);
 Op.Len := 1 + ExtraLen;
End;

Function Dpmi_GetOp(Var P: TEmulatorPanel; Var Op: TDpmiOperand;
 Size: Byte): LongInt;
Begin
 Case Size Of
  1: If Op.IsReg Then Dpmi_GetOp := Dpmi_GetReg8(DpmiCPU.Reg, Op.RegNum)
     Else Dpmi_GetOp := Dpmi_ReadByte(P, Op.LinAddr);
  2: If Op.IsReg Then Dpmi_GetOp := Dpmi_GetReg16(DpmiCPU.Reg, Op.RegNum)
     Else Dpmi_GetOp := Dpmi_ReadWord(P, Op.LinAddr);
 Else If Op.IsReg Then Dpmi_GetOp := Dpmi_GetReg32(DpmiCPU.Reg, Op.RegNum)
      Else Dpmi_GetOp := Dpmi_ReadDWord(P, Op.LinAddr);
 End;
End;

Procedure Dpmi_PutOp(Var P: TEmulatorPanel; Var Op: TDpmiOperand;
 Size: Byte; V: LongInt);
Begin
 Case Size Of
  1: If Op.IsReg Then Dpmi_SetReg8(DpmiCPU.Reg, Op.RegNum, Byte(V))
     Else Dpmi_WriteByte(P, Op.LinAddr, Byte(V));
  2: If Op.IsReg Then Dpmi_SetReg16(DpmiCPU.Reg, Op.RegNum, Word(V))
     Else Dpmi_WriteWord(P, Op.LinAddr, Word(V));
 Else If Op.IsReg Then Dpmi_SetReg32(DpmiCPU.Reg, Op.RegNum, V)
      Else Dpmi_WriteDWord(P, Op.LinAddr, V);
 End;
End;

{ ALU generique 8/16/32 bits - meme algorithme (CF/OF via test de plage/    }
{ XOR de signe, SF/ZF/PF derives du resultat tronque) que Emu_AluByte/Word  }
{ (coeur 8086), mais operant directement sur DpmiCPU.Flags (independant de }
{ TEmuCPU). Reutilise P.CPU.ParityTable (deja peuplee par le coeur 8086)    }
{ plutot que de dupliquer la table. AluOp : 0=ADD 1=OR 2=ADC 3=SBB 4=AND    }
{ 5=SUB 6=XOR 7=CMP (5 et 7 identiques sauf que l appelant n ecrit pas le   }
{ resultat pour CMP/TEST, voir Dpmi_AluForm). }
Function Dpmi_Alu(Var P: TEmulatorPanel; AluOp: Byte; A, B: LongInt;
 Size: Byte): LongInt;
Var
 UA, UB: LongWord;
 R, MaxU: Int64;
 Res: LongInt;
 SignBit: LongWord;
 OldCF: Integer;
Begin
 Case Size Of
  1: Begin UA := Byte(A); UB := Byte(B); SignBit := $80; MaxU := $FF; End;
  2: Begin UA := Word(A); UB := Word(B); SignBit := $8000; MaxU := $FFFF; End;
 Else Begin
   UA := LongWord(A); UB := LongWord(B);
   SignBit := $80000000; MaxU := $FFFFFFFF;
  End;
 End;
 OldCF := 0;
 If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
 Case AluOp Of
  0: R := Int64(UA) + UB;
  1: R := Int64(UA) Or UB;
  2: R := Int64(UA) + UB + OldCF;
  3: R := Int64(UA) - UB - OldCF;
  4: R := Int64(UA) And UB;
  5, 7: R := Int64(UA) - UB;
  6: R := Int64(UA) Xor UB;
 Else R := 0;
 End;
 Case Size Of
  1: Res := LongInt(Byte(R And $FF));
  2: Res := LongInt(Word(R And $FFFF));
 Else Res := LongInt(LongWord(R And $FFFFFFFF));
 End;
 Case AluOp Of
  0, 2: Begin
   If R > MaxU Then Include(DpmiCPU.Flags.s, EFG_CF)
   Else Exclude(DpmiCPU.Flags.s, EFG_CF);
   If ((UA Xor LongWord(Res)) And (UB Xor LongWord(Res)) And SignBit) <> 0
    Then Include(DpmiCPU.Flags.s, EFG_OF) Else Exclude(DpmiCPU.Flags.s, EFG_OF);
  End;
  3, 5, 7: Begin
   If R < 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
   Else Exclude(DpmiCPU.Flags.s, EFG_CF);
   If ((UA Xor UB) And (UA Xor LongWord(Res)) And SignBit) <> 0
    Then Include(DpmiCPU.Flags.s, EFG_OF) Else Exclude(DpmiCPU.Flags.s, EFG_OF);
  End;
  1, 4, 6: Begin
   Exclude(DpmiCPU.Flags.s, EFG_CF); Exclude(DpmiCPU.Flags.s, EFG_OF);
  End;
 End;
 If (LongWord(Res) And SignBit) <> 0 Then Include(DpmiCPU.Flags.s, EFG_SF)
 Else Exclude(DpmiCPU.Flags.s, EFG_SF);
 If Res = 0 Then Include(DpmiCPU.Flags.s, EFG_ZF)
 Else Exclude(DpmiCPU.Flags.s, EFG_ZF);
 If P.CPU.ParityTable[Byte(Res And $FF)] Then Include(DpmiCPU.Flags.s, EFG_PF)
 Else Exclude(DpmiCPU.Flags.s, EFG_PF);
 Dpmi_Alu := Res;
End;

Function Dpmi_TestCond(CC: Byte): Boolean;
Var Res: Boolean;
Begin
 Res := False;
 Case CC And $E Of
  $0: Res := EFG_OF In DpmiCPU.Flags.s;
  $2: Res := EFG_CF In DpmiCPU.Flags.s;
  $4: Res := EFG_ZF In DpmiCPU.Flags.s;
  $6: Res := (EFG_CF In DpmiCPU.Flags.s) Or (EFG_ZF In DpmiCPU.Flags.s);
  $8: Res := EFG_SF In DpmiCPU.Flags.s;
  $A: Res := EFG_PF In DpmiCPU.Flags.s;
  $C: Res := (EFG_SF In DpmiCPU.Flags.s) <> (EFG_OF In DpmiCPU.Flags.s);
  $E: Res := ((EFG_SF In DpmiCPU.Flags.s) <> (EFG_OF In DpmiCPU.Flags.s))
          Or (EFG_ZF In DpmiCPU.Flags.s);
 End;
 If (CC And 1) <> 0 Then Res := Not Res;
 Dpmi_TestCond := Res;
End;

Procedure Dpmi_Push32(Var P: TEmulatorPanel; V: LongInt);
Begin
 DpmiCPU.Reg.ESP := DpmiCPU.Reg.ESP - 4;
 Dpmi_WriteDWord(P, Dpmi_LinAddr(DpmiCPU.SegSel[2], DpmiCPU.Reg.ESP), V);
End;

Function Dpmi_Pop32(Var P: TEmulatorPanel): LongInt;
Begin
 Dpmi_Pop32 := Dpmi_ReadDWord(P, Dpmi_LinAddr(DpmiCPU.SegSel[2], DpmiCPU.Reg.ESP));
 DpmiCPU.Reg.ESP := DpmiCPU.Reg.ESP + 4;
End;

Procedure Dpmi_Push16(Var P: TEmulatorPanel; V: Word);
Begin
 DpmiCPU.Reg.ESP := DpmiCPU.Reg.ESP - 2;
 Dpmi_WriteWord(P, Dpmi_LinAddr(DpmiCPU.SegSel[2], DpmiCPU.Reg.ESP), V);
End;

Function Dpmi_Pop16(Var P: TEmulatorPanel): Word;
Begin
 Dpmi_Pop16 := Dpmi_ReadWord(P, Dpmi_LinAddr(DpmiCPU.SegSel[2], DpmiCPU.Reg.ESP));
 DpmiCPU.Reg.ESP := DpmiCPU.Reg.ESP + 2;
End;

{ Les 6 formes standard d un opcode ALU compact (00h-3Dh, voir Dpmi_Step) : }
{ 0=Eb,Gb 1=Ev,Gv 2=Gb,Eb 3=Gv,Ev 4=AL,Ib 5=eAX,Iz. Pour AluOp=7 (CMP), le   }
{ resultat n est jamais ecrit (seuls les drapeaux comptent). }
Procedure Dpmi_AluForm(Var P: TEmulatorPanel; AluOp, Form, OpSize: Byte;
 DefSeg: Word; HasOvr: Boolean);
Var
 ModRM, Reg: Byte;
 Op: TDpmiOperand;
 A, B, Res, Imm: LongInt;
Begin
 Case Form Of
  0, 1: Begin
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If Form = 0 Then Begin
    A := Dpmi_GetOp(P, Op, 1); B := Dpmi_GetReg8(DpmiCPU.Reg, Reg);
    Res := Dpmi_Alu(P, AluOp, A, B, 1);
    If AluOp <> 7 Then Dpmi_PutOp(P, Op, 1, Res);
   End Else Begin
    A := Dpmi_GetOp(P, Op, OpSize);
    If OpSize = 2 Then B := Dpmi_GetReg16(DpmiCPU.Reg, Reg)
    Else B := Dpmi_GetReg32(DpmiCPU.Reg, Reg);
    Res := Dpmi_Alu(P, AluOp, A, B, OpSize);
    If AluOp <> 7 Then Dpmi_PutOp(P, Op, OpSize, Res);
   End;
  End;
  2, 3: Begin
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If Form = 2 Then Begin
    A := Dpmi_GetReg8(DpmiCPU.Reg, Reg); B := Dpmi_GetOp(P, Op, 1);
    Res := Dpmi_Alu(P, AluOp, A, B, 1);
    If AluOp <> 7 Then Dpmi_SetReg8(DpmiCPU.Reg, Reg, Byte(Res));
   End Else Begin
    If OpSize = 2 Then A := Dpmi_GetReg16(DpmiCPU.Reg, Reg)
    Else A := Dpmi_GetReg32(DpmiCPU.Reg, Reg);
    B := Dpmi_GetOp(P, Op, OpSize);
    Res := Dpmi_Alu(P, AluOp, A, B, OpSize);
    If AluOp <> 7 Then Begin
     If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, Reg, Word(Res))
     Else Dpmi_SetReg32(DpmiCPU.Reg, Reg, Res);
    End;
   End;
  End;
  4: Begin
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   Res := Dpmi_Alu(P, AluOp, DpmiCPU.Reg.AL, Imm, 1);
   If AluOp <> 7 Then DpmiCPU.Reg.AL := Byte(Res);
  End;
  5: Begin
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2);
    Res := Dpmi_Alu(P, AluOp, DpmiCPU.Reg.AX, Imm, 2);
    If AluOp <> 7 Then DpmiCPU.Reg.AX := Word(Res);
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4);
    Res := Dpmi_Alu(P, AluOp, DpmiCPU.Reg.EAX, Imm, 4);
    If AluOp <> 7 Then DpmiCPU.Reg.EAX := Res;
   End;
  End;
 End;
End;

{ Invoque le gestionnaire d exception/interruption PROTEGE installe par le }
{ client (AX=0203h/0205h, voir DpmiCPU.IntSel/IntOfs) pour le vecteur Num -}
{ empile une trame d interruption minimale (EFLAGS, CS, EIP) sur la pile   }
{ PROTEGEE du client (SS:ESP) puis saute au gestionnaire, qui doit se      }
{ terminer par IRET/IRETD (voir Dpmi_Step, opcode CFh) pour reprendre au   }
{ point d interruption. Aucun changement de niveau de privilege n est      }
{ simule (anneau unique dans ce modele - voir le commentaire de tete pres  }
{ de TDpmiLDT). }
Procedure Dpmi_FireProtectedHandler(Var P: TEmulatorPanel; Num: Byte);
Begin
 Dpmi_Push32(P, DpmiCPU.Flags.Abs);
 Dpmi_Push32(P, LongInt(DpmiCPU.SegSel[1]));
 Dpmi_Push32(P, DpmiCPU.EIP);
 DpmiCPU.SegSel[1] := DpmiCPU.IntSel[Num];
 DpmiCPU.EIP := DpmiCPU.IntOfs[Num];
End;

{ Forwarde un INT Num execute DIRECTEMENT par le client protege (sans       }
{ passer par AX=0300h) vers le coeur 8086 REEL (Emu_DoInt), pour le cas ou  }
{ aucun gestionnaire protege n a ete installe (voir Dpmi_FireProtectedHandler}
{ ci-dessus, prioritaire) - couvre les programmes qui appellent INT 21h/    }
{ 10h/16h/etc. directement en confiance plutot que via le service AX=0300h  }
{ officiellement documente. LIMITATION ASSUMEE : les selecteurs ES/DS/FS/GS }
{ protege sont traduits en "segment reel" par simple division de leur BASE  }
{ lineaire par 16 (Base Div 16) - exact pour tout selecteur cree par        }
{ Dpmi_SegToSel (le cas courant : alias par defaut des segments reels au    }
{ moment de la commutation, voir Dpmi_Switch), mais approximatif pour un    }
{ selecteur personnalise dont la base ne serait pas un multiple de 16 ou    }
{ pointerait au-dela du premier Mo (memoire etendue DPMI, sans equivalent   }
{ reel) - un programme DPMI correct utilise de toute facon AX=0300h avec sa }
{ propre traduction pour les appels necessitant un pointeur reel valide     }
{ (voir DOC/DPMI.txt 10.3), donc cette limitation ne touche en pratique que }
{ les appels "de confiance" sans pointeur (ex. INT 21h AH=4Ch Exit). }
Procedure Dpmi_ForwardIntToReal(Var P: TEmulatorPanel; Num: Byte);
Begin
 P.CPU.Regs := DpmiCPU.Reg;
 P.CPU.Segs.ES := Word(Dpmi_SelBase(DpmiCPU.SegSel[0]) Div 16);
 P.CPU.Segs.DS := Word(Dpmi_SelBase(DpmiCPU.SegSel[3]) Div 16);
 P.CPU.FS := Word(Dpmi_SelBase(DpmiCPU.SegSel[4]) Div 16);
 P.CPU.GS := Word(Dpmi_SelBase(DpmiCPU.SegSel[5]) Div 16);
 { Force le chemin "handler interne direct" dans Emu_DoInt (voir             }
 { Emu_IntIsHooked) : cet appel simule un service reel de facon SYNCHRONE    }
 { (le resultat est relu immediatement dans Regs/Flags ci-dessous) - un      }
 { chainage reel via Emu_FireHwInt sauterait CS:IP vers un gestionnaire      }
 { reel-mode qui ne serait jamais reellement execute (le stepper DPMI fait   }
 { avancer DpmiCPU.EIP, pas P.CPU.IP, tant que le mode protege est actif),   }
 { perdant silencieusement le resultat. }
 P.CPU.Segs.CS := EMU_DEFAULT_IVT_SEG;
 Emu_DoInt(P, Num);
 DpmiCPU.Reg := P.CPU.Regs;
 If EFG_CF In P.CPU.Flags.s Then Include(DpmiCPU.Flags.s, EFG_CF)
 Else Exclude(DpmiCPU.Flags.s, EFG_CF);
End;

{ Execute une seule instruction protegee. Ne fait rien si DpmiCPU.Active   }
{ est faux (securite - ne devrait pas etre appelee dans ce cas, voir le    }
{ branchement dans la boucle principale). }
Procedure Dpmi_Step(Var P: TEmulatorPanel);
Var
 B, ModRM, Reg, Sub: Byte;
 OpSize: Byte;
 DefSeg: Word;
 HasOvr: Boolean;
 Op: TDpmiOperand;
 A, Imm, Res, Target, OldCF: LongInt;
 Op2: Byte;
Begin
 If Not DpmiCPU.Active Then Exit;
 HasOvr := False; DefSeg := DpmiCPU.SegSel[3]; { DS par defaut }
 If DpmiCPU.Is32Bit Then OpSize := 4 Else OpSize := 2;
 Repeat
  B := Dpmi_FetchByte(P, 0);
  Case B Of
   $66: Begin
    If OpSize = 2 Then OpSize := 4 Else OpSize := 2;
    Inc(DpmiCPU.EIP);
   End;
   $26: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[0]; Inc(DpmiCPU.EIP); End;
   $2E: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[1]; Inc(DpmiCPU.EIP); End;
   $36: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[2]; Inc(DpmiCPU.EIP); End;
   $3E: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[3]; Inc(DpmiCPU.EIP); End;
   $64: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[4]; Inc(DpmiCPU.EIP); End;
   $65: Begin HasOvr := True; DefSeg := DpmiCPU.SegSel[5]; Inc(DpmiCPU.EIP); End;
   $67, $F0, $F2, $F3: Inc(DpmiCPU.EIP); { taille d adresse/LOCK/REP - voir  }
                                         { le commentaire de tete (portee)   }
  Else Break;
  End;
 Until False;
 B := Dpmi_FetchByte(P, 0);
 Inc(DpmiCPU.EIP);
 If (B < $40) And ((B And 7) <= 5) And (B <> $0F) Then
  Dpmi_AluForm(P, B Shr 3, B And 7, OpSize, DefSeg, HasOvr)
 Else Case B Of
  $0F: Begin
   Op2 := Dpmi_FetchByte(P, 0);
   Inc(DpmiCPU.EIP);
   Case Op2 Of
    $80..$8F: Begin
     Target := Dpmi_FetchDWord(P, 0);
     Inc(DpmiCPU.EIP, 4);
     If Dpmi_TestCond(Op2 And $F) Then DpmiCPU.EIP := DpmiCPU.EIP + Target;
    End;
   Else Begin
    P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False;
   End;
   End;
  End;
  $40..$47: Begin { INC reg32/16 }
   OldCF := 0; If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
   If OpSize = 2 Then
    Res := Dpmi_Alu(P, 0, Dpmi_GetReg16(DpmiCPU.Reg, B And 7), 1, 2)
   Else
    Res := Dpmi_Alu(P, 0, Dpmi_GetReg32(DpmiCPU.Reg, B And 7), 1, 4);
   If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, B And 7, Word(Res))
   Else Dpmi_SetReg32(DpmiCPU.Reg, B And 7, Res);
   If OldCF <> 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
   Else Exclude(DpmiCPU.Flags.s, EFG_CF);
  End;
  $48..$4F: Begin { DEC reg32/16 }
   OldCF := 0; If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
   If OpSize = 2 Then
    Res := Dpmi_Alu(P, 5, Dpmi_GetReg16(DpmiCPU.Reg, B And 7), 1, 2)
   Else
    Res := Dpmi_Alu(P, 5, Dpmi_GetReg32(DpmiCPU.Reg, B And 7), 1, 4);
   If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, B And 7, Word(Res))
   Else Dpmi_SetReg32(DpmiCPU.Reg, B And 7, Res);
   If OldCF <> 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
   Else Exclude(DpmiCPU.Flags.s, EFG_CF);
  End;
  $50..$57: Begin { PUSH reg }
   If OpSize = 2 Then Dpmi_Push16(P, Dpmi_GetReg16(DpmiCPU.Reg, B And 7))
   Else Dpmi_Push32(P, Dpmi_GetReg32(DpmiCPU.Reg, B And 7));
  End;
  $58..$5F: Begin { POP reg }
   If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, B And 7, Dpmi_Pop16(P))
   Else Dpmi_SetReg32(DpmiCPU.Reg, B And 7, Dpmi_Pop32(P));
  End;
  $68: Begin { PUSH Iz }
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2); Dpmi_Push16(P, Word(Imm));
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4); Dpmi_Push32(P, Imm);
   End;
  End;
  $6A: Begin { PUSH Ib (signe) }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   If (Imm And $80) <> 0 Then Imm := Imm Or LongInt($FFFFFF00);
   If OpSize = 2 Then Dpmi_Push16(P, Word(Imm)) Else Dpmi_Push32(P, Imm);
  End;
  $70..$7F: Begin { Jcc rel8 }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   If (Imm And $80) <> 0 Then Imm := Imm Or LongInt($FFFFFF00);
   If Dpmi_TestCond(B And $F) Then DpmiCPU.EIP := DpmiCPU.EIP + Imm;
  End;
  $80, $81, $83: Begin { groupe ALU immediat : Eb,Ib / Ev,Iz / Ev,Ib(signe) }
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If B = $80 Then Begin
    A := Dpmi_GetOp(P, Op, 1);
    Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
    Res := Dpmi_Alu(P, Reg, A, Imm, 1);
    If Reg <> 7 Then Dpmi_PutOp(P, Op, 1, Res);
   End Else Begin
    A := Dpmi_GetOp(P, Op, OpSize);
    If B = $81 Then Begin
     If OpSize = 2 Then Begin Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2); End
     Else Begin Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4); End;
    End Else Begin
     Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
     If (Imm And $80) <> 0 Then Imm := Imm Or LongInt($FFFFFF00);
    End;
    Res := Dpmi_Alu(P, Reg, A, Imm, OpSize);
    If Reg <> 7 Then Dpmi_PutOp(P, Op, OpSize, Res);
   End;
  End;
  $84, $85: Begin { TEST Eb,Gb / Ev,Gv }
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If B = $84 Then
    Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 1), Dpmi_GetReg8(DpmiCPU.Reg, Reg), 1)
   Else If OpSize = 2 Then
    Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 2), Dpmi_GetReg16(DpmiCPU.Reg, Reg), 2)
   Else
    Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 4), Dpmi_GetReg32(DpmiCPU.Reg, Reg), 4);
  End;
  $88, $89, $8A, $8B: Begin { MOV }
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   Case B Of
    $88: Dpmi_PutOp(P, Op, 1, Dpmi_GetReg8(DpmiCPU.Reg, Reg));
    $89: If OpSize = 2 Then Dpmi_PutOp(P, Op, 2, Dpmi_GetReg16(DpmiCPU.Reg, Reg))
         Else Dpmi_PutOp(P, Op, 4, Dpmi_GetReg32(DpmiCPU.Reg, Reg));
    $8A: Dpmi_SetReg8(DpmiCPU.Reg, Reg, Byte(Dpmi_GetOp(P, Op, 1)));
    $8B: If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, Reg, Word(Dpmi_GetOp(P, Op, 2)))
         Else Dpmi_SetReg32(DpmiCPU.Reg, Reg, Dpmi_GetOp(P, Op, 4));
   End;
  End;
  $8D: Begin { LEA Gv,M }
   ModRM := Dpmi_FetchByte(P, 0);
   Reg := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   { L adresse lineaire calculee inclut la base du selecteur - LEA ne doit  }
   { charger que le DEPLACEMENT (offset dans le segment), pas l adresse     }
   { lineaire absolue : on retranche donc la base du selecteur de donnees   }
   { effectif utilise par Dpmi_DecodeModRM. }
   Res := Op.LinAddr - Dpmi_SelBase(DefSeg);
   If OpSize = 2 Then Dpmi_SetReg16(DpmiCPU.Reg, Reg, Word(Res))
   Else Dpmi_SetReg32(DpmiCPU.Reg, Reg, Res);
  End;
  $90: ; { NOP }
  $A8: Begin { TEST AL,Ib }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   Dpmi_Alu(P, 4, DpmiCPU.Reg.AL, Imm, 1);
  End;
  $A9: Begin { TEST eAX,Iz }
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2);
    Dpmi_Alu(P, 4, DpmiCPU.Reg.AX, Imm, 2);
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4);
    Dpmi_Alu(P, 4, DpmiCPU.Reg.EAX, Imm, 4);
   End;
  End;
  $B0..$B7: Begin { MOV reg8,Ib }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   Dpmi_SetReg8(DpmiCPU.Reg, B And 7, Byte(Imm));
  End;
  $B8..$BF: Begin { MOV reg32/16,Iz/Iw }
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2);
    Dpmi_SetReg16(DpmiCPU.Reg, B And 7, Word(Imm));
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4);
    Dpmi_SetReg32(DpmiCPU.Reg, B And 7, Imm);
   End;
  End;
  $C2: Begin { RET Iw (proche) }
   Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2);
   If OpSize = 2 Then DpmiCPU.EIP := Dpmi_Pop16(P) Else DpmiCPU.EIP := Dpmi_Pop32(P);
   DpmiCPU.Reg.ESP := DpmiCPU.Reg.ESP + Imm;
  End;
  $C3: Begin { RET (proche) }
   If OpSize = 2 Then DpmiCPU.EIP := Dpmi_Pop16(P) Else DpmiCPU.EIP := Dpmi_Pop32(P);
  End;
  $C6: Begin { MOV Eb,Ib }
   ModRM := Dpmi_FetchByte(P, 0);
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   Dpmi_PutOp(P, Op, 1, Imm);
  End;
  $C7: Begin { MOV Ev,Iz }
   ModRM := Dpmi_FetchByte(P, 0);
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2); Dpmi_PutOp(P, Op, 2, Imm);
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4); Dpmi_PutOp(P, Op, 4, Imm);
   End;
  End;
  $C9: Begin { LEAVE }
   DpmiCPU.Reg.ESP := DpmiCPU.Reg.EBP;
   DpmiCPU.Reg.EBP := Dpmi_Pop32(P);
  End;
  $CF: Begin { IRET/IRETD - retour d un gestionnaire d exception/interruption}
             { protege (voir Dpmi_FireProtectedHandler) ou d un rappel mode  }
             { reel invoque via Dpmi_RunRealProc(..., ViaIret=True). }
   If OpSize = 2 Then Begin
    DpmiCPU.EIP := Dpmi_Pop16(P);
    DpmiCPU.SegSel[1] := Dpmi_Pop16(P);
    DpmiCPU.Flags.Base := Dpmi_Pop16(P);
   End Else Begin
    DpmiCPU.EIP := Dpmi_Pop32(P);
    DpmiCPU.SegSel[1] := Word(Dpmi_Pop32(P));
    DpmiCPU.Flags.Abs := Dpmi_Pop32(P);
   End;
  End;
  $CC: Begin { INT 3 (exception 3, Breakpoint - voir DOC/DPMI.txt 6.3) }
   If DpmiCPU.IntSel[3] <> 0 Then Dpmi_FireProtectedHandler(P, 3)
   Else Begin
    P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False; { aucun          }
     { gestionnaire installe : arret propre, voir le commentaire de tete    }
     { de section (pas de debogueur protege simule dans cet emulateur). }
   End;
  End;
  $CD: Begin { INT Ib }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   If Imm = $31 Then Emu_DoInt31(P)  { toujours le service DPMI, jamais       }
                                      { redirigeable par le client (voir     }
                                      { DOC/DPMI.txt) }
   Else If DpmiCPU.IntSel[Byte(Imm)] <> 0 Then
    Dpmi_FireProtectedHandler(P, Byte(Imm))
   Else
    Dpmi_ForwardIntToReal(P, Byte(Imm));
  End;
  $E8: Begin { CALL rel32/rel16 (proche) }
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0);
    If (Imm And $8000) <> 0 Then Imm := Imm Or LongInt($FFFF0000);
    Inc(DpmiCPU.EIP, 2);
    Dpmi_Push16(P, Word(DpmiCPU.EIP));
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0);
    Inc(DpmiCPU.EIP, 4);
    Dpmi_Push32(P, DpmiCPU.EIP);
   End;
   DpmiCPU.EIP := DpmiCPU.EIP + Imm;
  End;
  $E9: Begin { JMP rel32/rel16 (proche) }
   If OpSize = 2 Then Begin
    Imm := Dpmi_FetchWord(P, 0);
    If (Imm And $8000) <> 0 Then Imm := Imm Or LongInt($FFFF0000);
    Inc(DpmiCPU.EIP, 2);
   End Else Begin
    Imm := Dpmi_FetchDWord(P, 0);
    Inc(DpmiCPU.EIP, 4);
   End;
   DpmiCPU.EIP := DpmiCPU.EIP + Imm;
  End;
  $EB: Begin { JMP rel8 }
   Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
   If (Imm And $80) <> 0 Then Imm := Imm Or LongInt($FFFFFF00);
   DpmiCPU.EIP := DpmiCPU.EIP + Imm;
  End;
  $F6, $F7: Begin { groupe TEST/NOT/NEG (partiel, voir tete de section) }
   ModRM := Dpmi_FetchByte(P, 0);
   Sub := (ModRM Shr 3) And 7;
   If B = $F6 Then Begin
    Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
    Inc(DpmiCPU.EIP, Op.Len);
    Case Sub Of
     0, 1: Begin
      Imm := Dpmi_FetchByte(P, 0); Inc(DpmiCPU.EIP);
      Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 1), Imm, 1);
     End;
     2: Dpmi_PutOp(P, Op, 1, Not Dpmi_GetOp(P, Op, 1));
     3: Dpmi_PutOp(P, Op, 1, Dpmi_Alu(P, 5, 0, Dpmi_GetOp(P, Op, 1), 1));
    Else Begin P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False; End;
    End;
   End Else Begin
    Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
    Inc(DpmiCPU.EIP, Op.Len);
    Case Sub Of
     0, 1: Begin
      If OpSize = 2 Then Begin
       Imm := Dpmi_FetchWord(P, 0); Inc(DpmiCPU.EIP, 2);
       Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 2), Imm, 2);
      End Else Begin
       Imm := Dpmi_FetchDWord(P, 0); Inc(DpmiCPU.EIP, 4);
       Dpmi_Alu(P, 4, Dpmi_GetOp(P, Op, 4), Imm, 4);
      End;
     End;
     2: Dpmi_PutOp(P, Op, OpSize, Not Dpmi_GetOp(P, Op, OpSize));
     3: Dpmi_PutOp(P, Op, OpSize, Dpmi_Alu(P, 5, 0, Dpmi_GetOp(P, Op, OpSize), OpSize));
    Else Begin P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False; End;
    End;
   End;
  End;
  $FE, $FF: Begin { groupe INC/DEC/CALL/JMP indirects/PUSH (partiel) }
   ModRM := Dpmi_FetchByte(P, 0);
   Sub := (ModRM Shr 3) And 7;
   Dpmi_DecodeModRM(P, ModRM, DefSeg, HasOvr, Op);
   Inc(DpmiCPU.EIP, Op.Len);
   If B = $FE Then Begin
    OldCF := 0; If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
    If Sub = 0 Then Dpmi_PutOp(P, Op, 1, Dpmi_Alu(P, 0, Dpmi_GetOp(P, Op, 1), 1, 1))
    Else If Sub = 1 Then Dpmi_PutOp(P, Op, 1, Dpmi_Alu(P, 5, Dpmi_GetOp(P, Op, 1), 1, 1))
    Else Begin P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False; End;
    If OldCF <> 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
    Else Exclude(DpmiCPU.Flags.s, EFG_CF);
   End Else Case Sub Of
    0: Begin
     OldCF := 0; If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
     Dpmi_PutOp(P, Op, OpSize, Dpmi_Alu(P, 0, Dpmi_GetOp(P, Op, OpSize), 1, OpSize));
     If OldCF <> 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
     Else Exclude(DpmiCPU.Flags.s, EFG_CF);
    End;
    1: Begin
     OldCF := 0; If EFG_CF In DpmiCPU.Flags.s Then OldCF := 1;
     Dpmi_PutOp(P, Op, OpSize, Dpmi_Alu(P, 5, Dpmi_GetOp(P, Op, OpSize), 1, OpSize));
     If OldCF <> 0 Then Include(DpmiCPU.Flags.s, EFG_CF)
     Else Exclude(DpmiCPU.Flags.s, EFG_CF);
    End;
    2: Begin { CALL near indirect }
     Target := Dpmi_GetOp(P, Op, OpSize);
     If OpSize = 2 Then Dpmi_Push16(P, Word(DpmiCPU.EIP)) Else Dpmi_Push32(P, DpmiCPU.EIP);
     DpmiCPU.EIP := Target;
    End;
    4: DpmiCPU.EIP := Dpmi_GetOp(P, Op, OpSize); { JMP near indirect }
    6: If OpSize = 2 Then Dpmi_Push16(P, Word(Dpmi_GetOp(P, Op, 2)))
       Else Dpmi_Push32(P, Dpmi_GetOp(P, Op, 4)); { PUSH Ev }
   Else Begin P.CPU.Fault := sfInvalidCode; DpmiCPU.Active := False; End;
   End;
  End;
 Else Begin
  { Opcode non reconnu par ce sous-ensemble (voir le commentaire de tete de}
  { section) : arreter proprement plutot que de continuer avec un etat CPU}
  { incorrect - honnete plutot que fabrique. }
  P.CPU.Fault := sfInvalidCode;
  DpmiCPU.Active := False;
 End;
 End;
End;

{ --- INT 2Fh AX=7A00h : verification d installation IPX ; AX=4300h/4310h  }
{ : verification d installation XMS et adresse du point d entree. Toute    }
{ autre sous-fonction (ou si le service correspondant n est pas configure) }
{ suit le meme comportement generique que les autres interruptions non    }
{ gerees - voir Emu_DoInt. --- }
Procedure Emu_DoInt2F(Var P: TEmulatorPanel);
Var IvtOfs, IvtSeg: Word;
 { --- Presse-papiers WINOLDAP (Windows 95, Stage 6, AX=17xxh) --- }
 ClipHandled: Boolean;
 ClipSize: LongInt;
 ClipHMem: LongInt;
 ClipPtr: PClipByteArr;
 ClipI: LongInt;
Begin
 If EmuIpx.Active And (P.CPU.Regs.AX = $7A00) Then Begin
  P.CPU.Regs.AL := $FF;
  P.CPU.Segs.ES := EmuIpx.StubSeg;
  P.CPU.Regs.DI := EmuIpx.StubOfs;
  Exit;
 End;
 If EmuXms.Active And (P.CPU.Regs.AX = $4300) Then Begin
  P.CPU.Regs.AL := $80;
  Exit;
 End;
 If EmuXms.Active And (P.CPU.Regs.AX = $4310) Then Begin
  P.CPU.Segs.ES := EmuXms.StubSeg;
  P.CPU.Regs.BX := EmuXms.StubOfs;
  Exit;
 End;
 If EmuMscdexActive And (P.CPU.Regs.AH = $15) Then Begin
  Emu_DoMscdex(P);
  Exit;
 End;
 If EmuDpmi.Active And (P.CPU.Regs.AX = $1687) And (Not DpmiCPU.Active) Then Begin
  { Detection DPMI (voir DOC/DPMI.txt 3.1) - ES:DI = trampoline de          }
  { commutation, voir Emu_DpmiInit/Dpmi_Switch. }
  P.CPU.Regs.AX := 0;          { present, aucune erreur }
  P.CPU.Regs.BX := 1;          { bit0=1 : 32 bits supporte }
  P.CPU.Regs.CL := 3;          { processeur : 80386 }
  P.CPU.Regs.DH := 0; P.CPU.Regs.DL := $5A;  { version DPMI 0.90 }
  P.CPU.Regs.SI := 1;          { paragraphes requis pour le "commutateur"   }
                                { (notre trampoline tient dans un seul) }
  P.CPU.Segs.ES := EMU_DPMI_STUB_SEG;
  P.CPU.Regs.DI := EMU_DPMI_STUB_OFS;
  Exit;
 End;
 If (OptionsDlg.Data.DosType = DOS_TYPE_OS2) And (P.CPU.Regs.AX = $4010) Then Begin
  { AX=4010h : detection de l hote OS/2 2.0+ (DOC/DOS_FOR_OS2_PROGRAMMING.  }
  { txt section "INT 2Fh/AX=4010h") - seulement actif si DosType=OS/2 ;     }
  { sinon ce bloc n est pas atteint et le code tombe dans le chainage IVT   }
  { generique plus bas, qui laisse AX INCHANGE (=4010h) si rien n est       }
  { accroche - EXACTEMENT le comportement documente pour "OS/2 absent",     }
  { donc aucune garde supplementaire n est necessaire pour ce cas. Warp 3   }
  { est connu pour rendre AX=0000h (pas une autre valeur non-4010h          }
  { quelconque) - suivre cette convention plutot qu une autre. BX = version }
  { packee BL=majeur/BH=mineur, meme ordre que AX=3306h (le document ne     }
  { precise pas explicitement l ordre pour 4010h ; choix par coherence      }
  { avec 3306h, voir le case $33/AL=6 de Emu_DoInt21). }
  P.CPU.Regs.AX := 0;
  P.CPU.Regs.BL := EMU_OS2_VER_MAJOR;
  P.CPU.Regs.BH := EMU_OS2_VER_MINOR;
  Exit;
 End;
 If (OptionsDlg.Data.DosType = DOS_TYPE_WIN95) Then Begin
  { Detection Windows 95/98 (DOC/DOS_FOR_WINDOWS95_PROGRAMMING.txt          }
  { section 2/15) - 4 sous-appels, tous gardes par DosType=Windows 95 ;     }
  { sinon ce bloc entier n est pas atteint et le code tombe dans le         }
  { chainage IVT generique plus bas, qui laisse AX INCHANGE - exactement    }
  { le comportement "Windows absent" attendu pour tout autre DosType. }
  If P.CPU.Regs.AX = $1600 Then Begin
   { AX=1600h : presence du mode Windows 386 etendu - l appelant teste       }
   { "test al,7Fh", donc n importe quel bit non nul dans les 7 bits bas      }
   { suffit ; $03 est une valeur plausible couramment observee. }
   P.CPU.Regs.AL := $03;
   Exit;
  End;
  If P.CPU.Regs.AX = $160A Then Begin
   { AX=160Ah : identifier version et type Windows - AX=0000h si pris en    }
   { charge, BX=BH.BL (ordre INVERSE de 4010h/3306h : le document le         }
   { precise explicitement), CX=0002h (mode standard - ne pas laisser        }
   { entendre un support VxD/enhanced-mode complet qui n existe pas dans     }
   { ce chantier). BH.BL=04.03 (Windows 95B/OSR2), coherent avec la          }
   { version DOS 7.10 rapportee par AH=30h/AX=3306h (EMU_WIN95_VER_MAJOR/    }
   { MINOR). }
   P.CPU.Regs.AX := 0;
   P.CPU.Regs.BH := 4;
   P.CPU.Regs.BL := 3;
   P.CPU.Regs.CX := 2;
   Exit;
  End;
  If P.CPU.Regs.AX = $1680 Then Begin
   { AX=1680h : ceder le reste du quantum de la VM - simple point de         }
   { cession dans une boucle d attente cooperative (document, section 15) ; }
   { rien a emuler reellement, un retour immediat suffit. }
   Exit;
  End;
  If P.CPU.Regs.AX = $1684 Then Begin
   { AX=1684h : obtenir le point d entree API d un VxD (BX=identifiant) -    }
   { aucun VxD reel n existe dans cet emulateur : repondre honnetement       }
   { "absent" (ES:DI=0000:0000) plutot que fabriquer un point d entree,      }
   { meme discipline que le reste de la session. }
   P.CPU.Segs.ES := 0;
   P.CPU.Regs.DI := 0;
   Exit;
  End;
  { Pont presse-papiers WINOLDAP (Stage 6, AX=1700h-170Ah) - premiere        }
  { ressource Win32 PARTAGEE ecrite (pas seulement lue) par ce fichier ;     }
  { discipline stricte "toujours refermer, meme apres une erreur             }
  { intermediaire" exigee par le document, respectee dans chaque bloc via    }
  { une seule sortie par Exit APRES avoir pose AX, jamais de branche qui      }
  { sauterait le 1708h en cas d echec partiel (voir 1703h/1705h : on ferme    }
  { implicitement en laissant le programme DOS appeler 1708h lui-meme,        }
  { exactement comme le montre l exemple Turbo Pascal du document - cette     }
  { fonction ne fait qu UN SEUL appel Win32 par invocation, jamais de          }
  { sequence Open+Empty+Set interne qui risquerait de laisser le              }
  { presse-papiers ouvert si REELEMENT LFN71 s interrompait au milieu). }
  If P.CPU.Regs.AX = $1700 Then Begin
   { Version WINOLDAP plausible (la couche est anterieure a Windows 95,      }
   { voir le document - lignee 3.1x). Convention volontairement DIFFERENTE   }
   { du reste (pas de garde CX/DX, juste ecraser AX puisque le document       }
   { precise explicitement que ce test ne suit PAS la convention AL=FFh       }
   { habituelle des autres services multiplex). }
   P.CPU.Regs.AL := 3;
   P.CPU.Regs.AH := 11;
   Exit;
  End;
  If P.CPU.Regs.AX = $1701 Then Begin
   {$IFDEF WINDOWS}
   If Win_OpenClipboard(0) Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   {$ELSE}
   P.CPU.Regs.AX := 0;
   {$ENDIF}
   Exit;
  End;
  If P.CPU.Regs.AX = $1702 Then Begin
   {$IFDEF WINDOWS}
   If Win_EmptyClipboard Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   {$ELSE}
   P.CPU.Regs.AX := 0;
   {$ENDIF}
   Exit;
  End;
  If P.CPU.Regs.AX = $1703 Then Begin
   { DX=format (seul 07h, texte OEM, est pris en charge - "le format         }
   { conseille a un programme DOS" selon le document), ES:BX->donnees,       }
   { SI:CX=taille 32 bits (SI=mot haut). SI<>0 (taille >64Ko) refuse          }
   { proprement plutot que de tronquer silencieusement. }
   ClipHandled := False;
   {$IFDEF WINDOWS}
   If (P.CPU.Regs.DX = $0007) And (P.CPU.Regs.SI = 0) And (P.CPU.Regs.CX > 0) Then Begin
    ClipSize := P.CPU.Regs.CX;
    ClipHMem := Win_GlobalAlloc(GMEM_MOVEABLE_WINOLDAP, ClipSize);
    If ClipHMem <> 0 Then Begin
     ClipPtr := PClipByteArr(Win_GlobalLock(ClipHMem));
     If ClipPtr <> Nil Then Begin
      For ClipI := 0 To ClipSize - 1 Do
       ClipPtr^[ClipI] := Emu_ClipOemToAnsi(Emu_ReadByte(P.CPU, P.CPU.Segs.ES,
        Word(P.CPU.Regs.BX + ClipI)));
      Win_GlobalUnlock(ClipHMem);
      If Win_SetClipboardData(CF_TEXT_WINOLDAP, ClipHMem) <> 0 Then
       ClipHandled := True;
     End;
    End;
   End;
   {$ENDIF}
   If ClipHandled Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   Exit;
  End;
  If P.CPU.Regs.AX = $1704 Then Begin
   { Taille dans DX:AX, arrondie a un multiple de 32 (comportement           }
   { documente de WINOLDAP) - 0 si le format demande n est pas present ou    }
   { n est pas 07h (seul format reellement gere par 1703h/1705h ici). }
   ClipSize := 0;
   {$IFDEF WINDOWS}
   If P.CPU.Regs.DX = $0007 Then Begin
    ClipHMem := Win_GetClipboardData(CF_TEXT_WINOLDAP);
    If ClipHMem <> 0 Then Begin
     ClipSize := Win_GlobalSize(ClipHMem);
     ClipSize := ((ClipSize + 31) Div 32) * 32;
    End;
   End;
   {$ENDIF}
   P.CPU.Regs.AX := Word(ClipSize And $FFFF);
   P.CPU.Regs.DX := Word((ClipSize Shr 16) And $FFFF);
   Exit;
  End;
  If P.CPU.Regs.AX = $1705 Then Begin
   ClipHandled := False;
   {$IFDEF WINDOWS}
   If P.CPU.Regs.DX = $0007 Then Begin
    ClipHMem := Win_GetClipboardData(CF_TEXT_WINOLDAP);
    If ClipHMem <> 0 Then Begin
     ClipSize := Win_GlobalSize(ClipHMem);
     If ClipSize > SizeOf(TClipByteArr) Then ClipSize := SizeOf(TClipByteArr);
     ClipPtr := PClipByteArr(Win_GlobalLock(ClipHMem));
     If (ClipPtr <> Nil) And (ClipSize > 0) Then Begin
      For ClipI := 0 To ClipSize - 1 Do
       Emu_WriteByte(P.CPU, P.CPU.Segs.ES, Word(P.CPU.Regs.BX + ClipI),
        Emu_ClipAnsiToOem(ClipPtr^[ClipI]));
      Win_GlobalUnlock(ClipHMem);
      ClipHandled := True;
     End;
    End;
   End;
   {$ENDIF}
   If ClipHandled Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   Exit;
  End;
  If P.CPU.Regs.AX = $1708 Then Begin
   {$IFDEF WINDOWS}
   If Win_CloseClipboard Then P.CPU.Regs.AX := 1 Else P.CPU.Regs.AX := 0;
   {$ELSE}
   P.CPU.Regs.AX := 0;
   {$ENDIF}
   Exit;
  End;
  If P.CPU.Regs.AX = $1709 Then Begin
   { Compaction : gestion memoire historique WINOLDAP hors de portee (voir   }
   { le document) - rendre SI:CX (taille demandee) tel quel en DX:AX,        }
   { comme si l espace demande etait toujours disponible ; une application   }
   { texte ordinaire se contente de toute facon de verifier 1704h. }
   P.CPU.Regs.AX := P.CPU.Regs.CX;
   P.CPU.Regs.DX := P.CPU.Regs.SI;
   Exit;
  End;
  If P.CPU.Regs.AX = $170A Then Begin
   { Capacites d affichage GDI - passerelle hors de portee de ce chantier    }
   { presse-papiers (le document la classe lui-meme a part, section          }
   { suivante) ; 0 = propriete inconnue plutot qu une valeur fabriquee. }
   P.CPU.Regs.AX := 0;
   Exit;
  End;
 End;
 IvtOfs := Emu_ReadWord(P.CPU, 0, Word($2F) * 4);
 IvtSeg := Emu_ReadWord(P.CPU, 0, Word($2F) * 4 + 2);
 If IvtSeg <> 0 Then Emu_FireHwInt(P, $2F);
 If IvtOfs = IvtOfs Then ; { evite un avertissement }
End;

{ Vrai si le programme invite a REELLEMENT remplace le vecteur Num (via     }
{ INT 21h AH=25h) par le sien - dans ce cas Emu_DoInt doit chainer pour de   }
{ bon (Emu_FireHwInt : push Flags/CS/IP, saut reel) plutot que d appeler     }
{ directement le handler interne. Faux si l IVT pointe encore sur notre     }
{ trampoline par defaut (Emu_DefaultVectorsInit, jamais modifie par         }
{ l invite) OU si l appel provient d un rappel explicite de l invite VERS ce}
{ meme trampoline (motif de chainage classique "pushf ; call far [ancien_   }
{ vecteur]" - a ce moment CS=EMU_DEFAULT_IVT_SEG puisqu on execute déjà le   }
{ trampoline). Dans les deux cas : executer le handler interne directement, }
{ jamais reboucler sur l IVT - une relecture de l IVT a cet instant pourrait}
{ pointer vers le gestionnaire de l invite lui-meme (s il a REELLEMENT      }
{ installe le sien), causant une recursion infinie au lieu d un simple      }
{ retour au handler par defaut. }
Function Emu_IntIsHooked(Var P: TEmulatorPanel; Num: Byte): Boolean;
Var IvtOfs, IvtSeg: Word;
Begin
 If P.CPU.Segs.CS = EMU_DEFAULT_IVT_SEG Then Begin
  Emu_IntIsHooked := False;
  Exit;
 End;
 IvtOfs := Emu_ReadWord(P.CPU, 0, Word(Num) * 4);
 IvtSeg := Emu_ReadWord(P.CPU, 0, Word(Num) * 4 + 2);
 Emu_IntIsHooked := (IvtSeg <> EMU_DEFAULT_IVT_SEG) Or
                     (IvtOfs <> Word(EMU_DEFAULT_IVT_OFS0 + Word(Num) * 4));
End;

Procedure Emu_DoInt(Var P: TEmulatorPanel; Num: Byte);
Var LogF: Text;
 IvtSeg, IvtOfs: Word;
Begin
 { Journal EMU21.LOG : voir Options > Emulateur > DOS: Debug              }
 { (Dlg.Data.DosLogInt21) - desactive par defaut, ecrire ici INCONDITION- }
 { NELLEMENT sur CHAQUE interruption coute cher (I/O disque a chaque       }
 { appel systeme du programme emule). }
 If OptionsDlg.Data.DosLogInt21 Then Begin
  {$I-}
  Assign(LogF, 'EMU21.LOG'); Append(LogF);
  If IOResult <> 0 Then Begin Assign(LogF,'EMU21.LOG'); Rewrite(LogF); End;
  WriteLn(LogF, '  >> INT ', HexByte(Num), ' AH=', HexByte(P.CPU.Regs.AH),
    ' AL=', HexByte(P.CPU.Regs.AL),
    ' CS:IP=', HexWord(P.CPU.Segs.CS), ':', HexWord(P.CPU.IP));
  Close(LogF);
  {$I+} If IOResult <> 0 Then ;
 End;
 { Activites observees (Deboguer > Activites observees) - comptage         }
 { INDEPENDANT du dispatch ci-dessous (fonctionne meme si l invite a        }
 { reellement hooke le vecteur et que Emu_FireHwInt est appele a la place   }
 { du handler interne - on veut savoir que L INVITE a declenche l           }
 { interruption, peu importe qui la traite au final). }
 Case Num Of
  $10: Inc(EmuActInt10);
  $21: Inc(EmuActInt21);
  $22: Inc(EmuActInt22);
  $23: Inc(EmuActInt23);
  $24: Inc(EmuActInt24);
  $25: Inc(EmuActInt25);
  $28: Inc(EmuActInt28);
  $33: Begin
   Inc(EmuActInt33);
   If P.CPU.Regs.AX = 0 Then EmuActMouseTest := True;
  End;
 End;
 { Services BIOS/DOS de base geres par stubs internes PAR DEFAUT - mais un   }
 { programme invite qui a REELLEMENT installe son propre gestionnaire via    }
 { INT 21h AH=25h (Emu_IntIsHooked) est desormais chaine pour de bon plutot  }
 { qu ignore, voir Emu_DefaultVectorsInit/Emu_IntIsHooked ci-dessus. }
 Case Num Of
  $08: If Emu_IntIsHooked(P, $08) Then Emu_FireHwInt(P, $08); { voir Emu_DefaultVectorsInit }
       { : le tic minuterie reel (compteur 0040:006C) est deja gere ailleurs }
       { par Emu_TimerTick/Emu_ServiceIrqs (tirage materiel direct, PAS via  }
       { cette instruction "INT 8" logicielle explicite - extremement rare  }
       { en pratique) - donc RIEN a faire de plus ici si non hooke, sans     }
       { quoi Emu_FireHwInt sauterait dans notre PROPRE trampoline "INT      }
       { 8;IRET" et se rappellerait indefiniment (contrairement aux autres   }
       { entrees Always ci-dessous, qui ont toutes un Emu_DoIntXX interne    }
       { distinct de leur propre trampoline). }
  $10: If Emu_IntIsHooked(P, $10) Then Emu_FireHwInt(P, $10) Else Emu_DoInt10(P);
  $11:
   { AH=00 (et autres) : equipment list dans AX.
     Bit 0 = floppy installe, bits 5-4 = video initial (11b=80x25 color),
     bits 7-6 = nb FDD-1, bits 9-8 = nb serial. Valeur PC standard
     1 FDD + 80x25 color = $0021. }
   If Emu_IntIsHooked(P, $11) Then Emu_FireHwInt(P, $11)
   Else Begin
    Case Emu_FloppyCount Of
     0: P.CPU.Regs.AX := $0020;   { aucun floppy }
     2: P.CPU.Regs.AX := $0061;   { 2 floppies   }
    Else
     P.CPU.Regs.AX := $0021;      { 1 floppy (defaut) }
    End;
   End;
  $12:
   { Memory size en KB (640). }
   If Emu_IntIsHooked(P, $12) Then Emu_FireHwInt(P, $12) Else P.CPU.Regs.AX := 640;
  $13: If Emu_IntIsHooked(P, $13) Then Emu_FireHwInt(P, $13) Else Emu_DoInt13(P);
  $16: If Emu_IntIsHooked(P, $16) Then Emu_FireHwInt(P, $16) Else Emu_DoInt16(P);
  $1A: If Emu_IntIsHooked(P, $1A) Then Emu_FireHwInt(P, $1A) Else Emu_DoInt1A(P);
  $20: If Emu_IntIsHooked(P, $20) Then Emu_FireHwInt(P, $20) Else P.CPU.Fault := sfEndProgram;
  $27: If Emu_IntIsHooked(P, $27) Then Emu_FireHwInt(P, $27) Else P.CPU.Fault := sfEndProgram;
  $21: If Emu_IntIsHooked(P, $21) Then Emu_FireHwInt(P, $21) Else Emu_DoInt21(P);
  $2F: If Emu_IntIsHooked(P, $2F) Then Emu_FireHwInt(P, $2F) Else Emu_DoInt2F(P);
  $15: Begin
   { N intercepter reellement que AH=C2h (BIOS souris PS/2) et seulement    }
   { si la case "Souris BIOS PS/2" est cochee (EmuMousePS2Active) - toute   }
   { autre sous-fonction ou tout autre etat de la case suit le meme         }
   { comportement generique que les autres interruptions non gerees        }
   { (branche Else), SAUF AH=C0h/88h/90h/91h pour la classe materiel AT+    }
   { (voir Emu_DoInt15AT ci-dessous) : les nombreux autres services         }
   { INT 15h (A20, E820, clavier etendu, etc.) restent hors de portee de    }
   { cet emulateur. }
   If (P.CPU.Regs.AH = $C2) And EmuMousePS2Active Then Begin
    If Emu_IntIsHooked(P, $15) Then Emu_FireHwInt(P, $15) Else Emu_DoInt15C2(P);
   End
   { TopView (Options > Emulateur > DOS: OS > TopView) : AH=10h/11h/12h,    }
   { voir Emu_DoInt15Tv - meme principe que AH=C2h ci-dessus (gate par la   }
   { case a cocher, chainage prioritaire si le programme invite a deja      }
   { hooke INT 15h lui-meme). }
   Else If (OptionsDlg.Data.DosTopView) And
    ((P.CPU.Regs.AH = $10) Or (P.CPU.Regs.AH = $11) Or (P.CPU.Regs.AH = $12)) Then Begin
    If Emu_IntIsHooked(P, $15) Then Emu_FireHwInt(P, $15) Else Emu_DoInt15Tv(P);
   End
   { Services materiel AT+ (Get System Configuration/Get Extended Memory    }
   { Size/Device Busy/Interrupt Complete) - gate sur Emu_IsATClassHw comme   }
   { les 8259A/8042/FDC deja gates de la meme facon ailleurs : un PC/XT/     }
   { PCjr/clone PC anterieur n a jamais eu ces fonctions, un vrai AT/PS2/    }
   { Compaq Deskpro 386 les a toujours. Voir Emu_DoInt15AT pour le detail.  }
   Else If Emu_IsATClassHw And
    ((P.CPU.Regs.AH = $C0) Or (P.CPU.Regs.AH = $88) Or
     (P.CPU.Regs.AH = $90) Or (P.CPU.Regs.AH = $91)) Then Begin
    If Emu_IntIsHooked(P, $15) Then Emu_FireHwInt(P, $15) Else Emu_DoInt15AT(P);
   End
   Else Begin
    { BOGUE REEL (trouve 2026-08-22 en investiguant le blocage BOOT/IO.SYS) }
    { Cette branche utilisait auparavant une lecture BRUTE de l IVT          }
    { (IvtSeg<>0) au lieu de Emu_IntIsHooked comme les AUTRES vecteurs de     }
    { cette Case - or Emu_DefaultVectorsInit installe maintenant TOUJOURS    }
    { un trampoline par defaut pour $15 (voir son en-tete, meme famille que  }
    { le bogue $08 deja documente) : avec une lecture brute, IvtSeg est      }
    { desormais TOUJOURS non nul (notre propre trampoline), donc TOUJOURS    }
    { Emu_FireHwInt - qui saute dans ce meme trampoline "CD 15;CF", ce qui    }
    { re-declenche Emu_DoInt($15) et boucle indefiniment (recursion          }
    { infinie). Emu_IntIsHooked distingue correctement "pointe vers NOTRE    }
    { propre trampoline par defaut" (non hooke, gerer ici) de "pointe        }
    { ailleurs" (vraiment hooke par l invite, chainer pour de bon) - motif   }
    { deja utilise par tous les autres vecteurs ci-dessus. }
    If Emu_IntIsHooked(P, $15) Then Emu_FireHwInt(P, $15)
    Else Begin
     { Un vrai BIOS repond TOUJOURS a INT 15h - meme "non supporte" (CF=1,   }
     { AH=86h) - pour toute sous-fonction hors de portee de cet emulateur :  }
     { un appelant qui teste JC apres INT 15h/AH=C0h (config systeme, tres   }
     { courant au demarrage MS-DOS) attend une reponse definitive, pas un    }
     { CF perime d une instruction anterieure sans rapport. }
     Include(P.CPU.Flags.s, EFG_CF);
     P.CPU.Regs.AH := $86;
    End;
   End;
  End;
  $33: Begin
   { N intercepter reellement que si la case "Souris" est cochee            }
   { (EmuMouseActive) - sinon, comportement identique a toute autre         }
   { interruption non geree (branche Else) : une vraie machine sans pilote  }
   { souris charge ne repond pas non plus sur ce vecteur (le "test d        }
   { installation" AX=0000h d un programme invite echouerait alors          }
   { legitimement, exactement comme sur une vraie machine). }
   If EmuMouseActive Then Begin
    If Emu_IntIsHooked(P, $33) Then Emu_FireHwInt(P, $33) Else Emu_DoInt33(P);
   End
   Else Begin
    IvtOfs := Emu_ReadWord(P.CPU, 0, Word($33) * 4);
    IvtSeg := Emu_ReadWord(P.CPU, 0, Word($33) * 4 + 2);
    If IvtSeg <> 0 Then Emu_FireHwInt(P, $33);
    If IvtOfs = IvtOfs Then ;
   End;
  End;
  $FC: If EmuMouseCallPending Then Emu_MouseCont(P); { continuation interne  }
       { de l upcall gestionnaire souris/callback BIOS PS/2 - voir           }
       { Emu_MouseCont. Jamais atteint par du logiciel DOS reel. }
  $FB: If EmuDpmi.Active Then Dpmi_Switch(P); { trampoline de commutation    }
       { reel -> protege DPMI, voir Dpmi_Switch/Emu_DpmiInit. Jamais         }
       { atteint par du logiciel DOS reel. }
  $60: Begin
   { N intercepter reellement que si la case "Reseau LAN" est cochee       }
   { (EmuPkt.Active) - sinon, comportement identique a toute autre         }
   { interruption non geree (branche Else) : une vraie machine sans        }
   { pilote de paquets charge ne repond pas non plus sur ce vecteur. }
   If EmuPkt.Active Then Begin
    If Emu_IntIsHooked(P, $60) Then Emu_FireHwInt(P, $60) Else Emu_DoInt60(P);
   End
   Else Begin
    IvtOfs := Emu_ReadWord(P.CPU, 0, Word($60) * 4);
    IvtSeg := Emu_ReadWord(P.CPU, 0, Word($60) * 4 + 2);
    If IvtSeg <> 0 Then Emu_FireHwInt(P, $60);
    If IvtOfs = IvtOfs Then ;
   End;
  End;
  $FD: If EmuPkt.Cont.Pending Then Emu_PktCont(P); { continuation interne  }
       { du protocole d upcall recepteur/as_send_pkt du pilote de paquets  }
       { - voir Emu_PktCont. Jamais atteint par du logiciel DOS reel. }
  $FE: If EmuXms.Active Then Emu_DoIntFE(P); { point d entree XMM du       }
       { pilote XMS, atteint uniquement via le trampoline installe par     }
       { Emu_XmsInit (jamais un vrai numero d interruption DOS/BIOS,       }
       { contrairement a $60/$7A - pas de repli generique necessaire). }
  $F8: Begin
   { Chantier Windows 16 bits, Stage 3 : point d entree de trappe KERNEL/   }
   { USER/GDI - jamais un vrai numero d interruption DOS/BIOS/Windows      }
   { (comme $FC/$FD/$FE ci-dessus), atteint UNIQUEMENT via les thunks      }
   { CD F8 <slot:Word> CB ecrits par Win16_ResolveImportSlot (Stage 2).    }
   { L index de slot suit immediatement l opcode INT dans le flux           }
   { d instructions (P.CPU.IP y pointe deja - Emu_StepOne a deja avance    }
   { IP au-dela de "CD F8" avant d appeler Emu_DoInt, meme convention que   }
   { tout autre INT). PAS besoin d avancer IP nous-memes au-dela du slot :  }
   { Win16_DispatchCall termine TOUJOURS par un retour synthetique complet }
   { (depile lui-meme l adresse de retour et ECRASE P.CPU.IP avec elle) -  }
   { le CB final du thunk n est donc JAMAIS reellement execute, pur filet  }
   { de securite si jamais atteint par erreur. }
   Win16_DispatchCall(P, Emu_ReadWord(P.CPU, P.CPU.Segs.CS, P.CPU.IP));
  End;
  $67: Begin
   { N intercepter reellement que si la case "EMS" est cochee (EmuEms.     }
   { Active) - sinon, comportement identique a toute autre interruption    }
   { non geree (branche Else) : une vraie machine sans gestionnaire EMS    }
   { charge ne repond pas non plus sur ce vecteur. }
   If EmuEms.Active Then Begin
    If Emu_IntIsHooked(P, $67) Then Emu_FireHwInt(P, $67) Else Emu_DoInt67(P);
   End
   Else Begin
    IvtOfs := Emu_ReadWord(P.CPU, 0, Word($67) * 4);
    IvtSeg := Emu_ReadWord(P.CPU, 0, Word($67) * 4 + 2);
    If IvtSeg <> 0 Then Emu_FireHwInt(P, $67);
    If IvtOfs = IvtOfs Then ;
   End;
  End;
  $7A: Begin
   { N intercepter reellement que si la case "Reseau Novell NetWare" est   }
   { cochee (EmuIpx.Active) - sinon, se comporter EXACTEMENT comme pour    }
   { toute autre interruption non geree (branche Else ci-dessous) : une    }
   { vraie machine sans pilote IPX charge ne repond pas non plus sur ce    }
   { vecteur. }
   If EmuIpx.Active Then Begin
    If Emu_IntIsHooked(P, $7A) Then Emu_FireHwInt(P, $7A) Else Emu_DoInt7A(P);
   End
   Else Begin
    IvtOfs := Emu_ReadWord(P.CPU, 0, Word($7A) * 4);
    IvtSeg := Emu_ReadWord(P.CPU, 0, Word($7A) * 4 + 2);
    If IvtSeg <> 0 Then Emu_FireHwInt(P, $7A);
    If IvtOfs = IvtOfs Then ;
   End;
  End;
  Else Begin
   { Pour les autres INT, si l application a installe un ISR
     via INT 21h AH=25h, on saute dedans. Sinon on ignore. }
   IvtOfs := Emu_ReadWord(P.CPU, 0, Word(Num) * 4);
   IvtSeg := Emu_ReadWord(P.CPU, 0, Word(Num) * 4 + 2);
   If IvtSeg <> 0 Then Emu_FireHwInt(P, Num);
   { Compatibilite : si IvtSeg=0, on ignore silencieusement. }
   If IvtOfs = IvtOfs Then ;  { dummy pour eviter warning hint }
  End;
 End;
End;

{ Pousse FLAGS+CS+IP, charge IVT[Num] dans CS:IP, masque IF.
  Utilise pour les vraies IRQ mat?rielles et redirection INT vers ISR. }
Procedure Emu_FireHwInt(Var P: TEmulatorPanel; Num: Byte);
Var
 NewIP, NewCS: Word;
Begin
 NewIP := Emu_ReadWord(P.CPU, 0, Word(Num) * 4);
 NewCS := Emu_ReadWord(P.CPU, 0, Word(Num) * 4 + 2);
 { Vecteur invalide : segment 0 (zone IVT/PSP) ou tout-zero. }
 If NewCS = 0 Then Exit;
 Emu_PushWord(P.CPU, P.CPU.Flags.Base);
 Emu_PushWord(P.CPU, P.CPU.Segs.CS);
 Emu_PushWord(P.CPU, P.CPU.IP);
 Exclude(P.CPU.Flags.s, EFG_IF);
 Exclude(P.CPU.Flags.s, EFG_TF);
 P.CPU.Segs.CS := NewCS;
 P.CPU.IP := NewIP;
End;

{ Ecrit le trampoline "vecteur par defaut" pour l interruption Num (voir     }
{ EMU_DEFAULT_IVT_SEG/EMU_DEFAULT_IVT_OFS0 et Emu_IntIsHooked) : le vrai      }
{ code INT Num ; IRET a $F000:$0300+Num*4, ET l entree IVT correspondante    }
{ pointant dessus - exactement ce qu un vrai DOS/BIOS ferait au demarrage    }
{ pour chaque vecteur qu il gere. Un programme invite qui appelle AH=35h     }
{ AVANT d installer son propre AH=25h recupere donc cette adresse comme      }
{ "ancien vecteur", ce qui permet un chainage reel (pushf ; call far         }
{ [ancien_vecteur]) - voir Emu_IntIsHooked pour la reception cote Emu_DoInt. }
Procedure Emu_WriteDefaultVector(Var P: TEmulatorPanel; Num: Byte);
Var Ofs: Word;
Begin
 Ofs := EMU_DEFAULT_IVT_OFS0 + Word(Num) * 4;
 Emu_WriteByte(P.CPU, EMU_DEFAULT_IVT_SEG, Ofs,     $CD); { INT }
 Emu_WriteByte(P.CPU, EMU_DEFAULT_IVT_SEG, Ofs + 1, Num);
 Emu_WriteByte(P.CPU, EMU_DEFAULT_IVT_SEG, Ofs + 2, $CF); { IRET }
 Emu_WriteWord(P.CPU, 0, Word(Num) * 4,     Ofs);
 Emu_WriteWord(P.CPU, 0, Word(Num) * 4 + 2, EMU_DEFAULT_IVT_SEG);
End;

{ Initialise, au demarrage d une session DOS (voir ShowEmulatorPanel), les   }
{ trampolines par defaut de TOUTES les interruptions dotees d un handler     }
{ interne dans Emu_DoInt - les 10 toujours actives, PLUS les 5 dependant     }
{ d une case a cocher materiel/reseau (Souris BIOS PS/2, Souris, Reseau LAN, }
{ EMS, Novell IPX) mais SEULEMENT si celle-ci est effectivement active :     }
{ si le materiel n est pas emule, une vraie machine ne repondrait pas non    }
{ plus sur ce vecteur, donc ne PAS y ecrire de trampoline (sinon un          }
{ programme invite testant AH=35h croirait a tort qu un gestionnaire est     }
{ deja installe). Doit etre appele APRES les Emu_XxxInit correspondants      }
{ (qui positionnent les .Active) et APRES Emu_LoadProgram (zone reservee     }
{ $F000, jamais utilisee par le programme charge). }
Procedure Emu_DefaultVectorsInit(Var P: TEmulatorPanel);
Const
 { BOGUE REEL (2026-08-18) : $08 (IRQ0/minuterie) manquait de cette liste -   }
 { voir [[project-devenv]], enquete NC3. Emu_MakeIntrAddr remplit l IVT       }
 { entiere au demarrage avec des valeurs PLACEHOLDER (Tbl[I]:=I+1, PAS de     }
 { vraies adresses) - pour $08 cela donne littéralement offset=9/segment=0.  }
 { Un vrai DOS/BIOS installe TOUJOURS un gestionnaire reel (non nul) pour    }
 { $08 des le demarrage ; un programme invite qui LIT ce vecteur (usage      }
 { legitime et courant, ex. pour le chainer soi-meme) s attend donc a une    }
 { adresse valide. NCMAIN.EXE (Norton Commander 3) copie ce vecteur puis     }
 { saute au travers plus tard (JMP FAR [ptr]) - avec segment=0 celui-ci      }
 { plante immediatement (CS=0000, deja documente comme "fin de programme"    }
 { generique) - AVANT d atteindre sa boucle d evenements normale (panneau/   }
 { barre de boutons jamais affiches). Reproduit A L IDENTIQUE avec DOSBox    }
 { source verifie (dos_execute.cpp, aucune mise a zero de la memoire a       }
 { l allocation) : un vrai DOS/DOSBox aurait simplement fourni un vecteur    }
 { $08 valide des le depart, contrairement a cet emulateur avant ce          }
 { correctif. }
 { BOGUE REEL (2026-08-22, meme famille que le bogue $08 ci-dessus) : $15  }
 { (INT 15h) etait EXCLU de cette liste et seulement rendu par defaut si   }
 { Souris BIOS PS/2 ou TopView etait actif - hors un vrai DOS lit et       }
 { SAUVEGARDE systematiquement ce vecteur au demarrage (pour le chainer    }
 { plus tard, motif universel de tout hook BIOS), meme quand aucun des     }
 { deux ne concerne l appel. Avec le placeholder ($0000:offset), ce        }
 { chainage ulterieur saute dans le vide (confirme via BOOT/IO.SYS reel :  }
 { MS-DOS 6.22 sauve le vecteur $15 tot au demarrage puis y chaine depuis  }
 { son propre gestionnaire AH=C0h, atterrissant sur le placeholder).       }
 { $15 rejoint donc la liste inconditionnelle ; la case Souris BIOS PS2/   }
 { TopView continue de determiner CE QUE repond notre trampoline (voir     }
 { Emu_DoInt, Case $15 - reponse "non supporte" CF=1/AH=86h en dehors de   }
 { AH=C2h/10h-12h), pas SI un vecteur existe. }
 Always: Array[0..11] Of Byte =
  ($08,$10,$11,$12,$13,$15,$16,$1A,$20,$21,$27,$2F);
Var I: Integer;
Begin
 For I := 0 To 11 Do Emu_WriteDefaultVector(P, Always[I]);
 If EmuMouseActive    Then Emu_WriteDefaultVector(P, $33);
 If EmuPkt.Active     Then Emu_WriteDefaultVector(P, $60);
 If EmuEms.Active     Then Emu_WriteDefaultVector(P, $67);
 If EmuIpx.Active     Then Emu_WriteDefaultVector(P, $7A);
End;

{ Tentative de trap divide-by-zero via INT 0. Si l application a installe
  un handler (TP4 le fait pour afficher "Runtime error 200"), on dispatche.
  Sinon on signale une faute pour arreter l emulation proprement.
  Le caller doit avoir DEJA avance IP au-dela du DIV. }
Procedure Emu_Div0Trap(Var P: TEmulatorPanel);
Begin
 { Le vecteur par defaut pointe vers notre propre trampoline F000:0300 ;
   il ne faut pas le traiter comme un handler invite, sinon INT 0 se
   rappelle indefiniment via le trampoline. }
 If Emu_IntIsHooked(P, 0) Then
  Emu_FireHwInt(P, 0)
 Else
  P.CPU.Fault := sfDivision0;
End;

{ Capture du tout premier DIV/0 pour diagnostic. NoOp si deja fait. }
Procedure Emu_Div0Snapshot(Var P: TEmulatorPanel; OpByte, SubOp: Byte;
 Divisor: LongInt; PreIP: Word);
Begin
 If EmuDiv0Caught Then Exit;
 EmuDiv0Caught := True;
 EmuDiv0CS := P.CPU.Segs.CS; EmuDiv0IP := PreIP;
 EmuDiv0Op := OpByte; EmuDiv0SubOp := SubOp; EmuDiv0Div := Divisor;
 EmuDiv0AX := P.CPU.Regs.AX; EmuDiv0DX := P.CPU.Regs.DX;
 EmuDiv0BX := P.CPU.Regs.BX; EmuDiv0CX := P.CPU.Regs.CX;
 EmuDiv0SI := P.CPU.Regs.SI; EmuDiv0DI := P.CPU.Regs.DI;
 EmuDiv0BP := P.CPU.Regs.BP;
 EmuDiv0DS := P.CPU.Segs.DS; EmuDiv0ES := P.CPU.Segs.ES;
 EmuDiv0SS := P.CPU.Segs.SS; EmuDiv0SP := P.CPU.Regs.SP;
End;

{ Initialiser la BIOS Data Area minimale a 0040:0000. }
Procedure Emu_InitBDA(Var P: TEmulatorPanel);
Var I: Integer; EqLo: Byte; EqWord: Word; SerialCount, ParallelCount: Byte;
Begin
 { Etat machine ANSI.SYS remis a neuf pour cette session (voir             }
 { EmuVScr_AnsiFeed) - NE PAS confondre avec EmuVScr_Clear, qui efface      }
 { l ecran sur un ESC[2J du programme invite mais doit preserver les        }
 { attributs de couleur en cours (comportement reel d un terminal ANSI). }
 P.AnsiState := 0;
 P.AnsiNParam := 0;
 P.AnsiBold := False;
 P.AnsiSaveX := 0;
 P.AnsiSaveY := 0;
 { Compteurs "Activites observees" (Deboguer > Activites observees) remis  }
 { a zero pour cette nouvelle session DOS. }
 EmuActVramB800 := 0; EmuActVramB000 := 0; EmuActVramA000 := 0;
 EmuActInt10 := 0; EmuActBiosId := False;
 EmuActInt21 := 0; EmuActInt22 := 0; EmuActInt23 := 0;
 EmuActInt24 := 0; EmuActInt25 := 0; EmuActInt28 := 0;
 EmuActMouseTest := False; EmuActInt33 := 0;
 For I := 0 To $FF Do Emu_WriteByte(P.CPU, $40, I, 0);
 { Equipement word (0040:0010), octet de poids faible :
   bits 7-6 = nb FDD - 1, bits 5-4 = video (11b=80x25 color),
   bit 0 = floppy installe. }
 Case Emu_FloppyCount Of
  0: EqLo := $20;
  2: EqLo := $61;
 Else
  EqLo := $21;
 End;
 { Table des ports COM (0040:0000-0007) et LPT (0040:0008-000D) - un vrai   }
 { BIOS y inscrit l adresse de base de chaque port reellement present, et   }
 { 0000h pour un port absent. COM2/COM4 et LPT1/LPT2 sont desormais de vrais}
 { ports emules (voir Emu_PortRead/Emu_PortWrite) ; COM1/COM3/LPT3 restent  }
 { absents (0), non demandes. }
 Emu_WriteWord(P.CPU, $40, $00, 0);      { COM1 : absent }
 Emu_WriteWord(P.CPU, $40, $02, $2F8);   { COM2 }
 Emu_WriteWord(P.CPU, $40, $04, 0);      { COM3 : absent }
 Emu_WriteWord(P.CPU, $40, $06, $2E8);   { COM4 }
 Emu_WriteWord(P.CPU, $40, $08, $3BC);   { LPT1 }
 Emu_WriteWord(P.CPU, $40, $0A, $278);   { LPT2 }
 Emu_WriteWord(P.CPU, $40, $0C, 0);      { LPT3 : absent }
 { Octet de poids fort du mot equipement (bits 9-11 = nb ports serie,       }
 { bits 14-15 = nb ports paralleles, plafonne a 3 par le format reel) -     }
 { jamais rempli auparavant (restait a 0 quel que soit le materiel emule,   }
 { donc invisible pour tout logiciel qui consulte l equipement plutot que   }
 { de sonder les ports directement). Compte honnete du nombre d entrees non }
 { nulles ci-dessus plutot qu une supposition de contigu?te depuis COM1/    }
 { LPT1 - voir le commentaire de TEmuUART/TEmuLPT pour le choix des ports   }
 { reellement implantes. }
 SerialCount := 2;   { COM2 + COM4 }
 ParallelCount := 2; { LPT1 + LPT2 }
 EqWord := Word(EqLo) Or (Word(SerialCount And $07) Shl 9)
                      Or (Word(ParallelCount And $03) Shl 14);
 Emu_WriteWord(P.CPU, $40, $10, EqWord);
 { Adresse de base des ports du controleur CRT (0040:0063) : 03D4h pour  }
 { les cartes couleur (CGA/EGA/Graphics Solution), 03B4h en monochrome.  }
 { De nombreux logiciels (dont GSDEMO1.COM) sondent ce mot pour valider  }
 { la presence d une carte avant de programmer les ports directement.    }
 Emu_WriteWord(P.CPU, $40, $63, $3D4);
 Emu_WriteByte(P.CPU, $40, $13, $80);
 Emu_WriteByte(P.CPU, $40, $14, $02);
 Emu_WriteByte(P.CPU, $40, $1A, $1E);
 Emu_WriteByte(P.CPU, $40, $1B, $00);
 Emu_WriteByte(P.CPU, $40, $1C, $1E);
 Emu_WriteByte(P.CPU, $40, $1D, $00);
 Emu_WriteByte(P.CPU, $40, $49, $03);
 Emu_WriteByte(P.CPU, $40, $4A, $50);
 Emu_WriteByte(P.CPU, $40, $84, $18);
 { Octet ID materiel ROM BIOS (F000:FFFE) - voir DosHardwareBiosId. Reflete }
 { maintenant reellement le "Materiel" choisi dans Options > Emulateur >    }
 { DOS: Materiel, au lieu de rester a zero (jamais lu par aucun logiciel    }
 { invite avant ce correctif). }
 Emu_WriteByte(P.CPU, $F000, $FFFE, DosHardwareBiosId(OptionsDlg.Data.DosHardware));
 EmuTickCounter  := 0;
 EmuStepsPerTick := 5000;
 EmuStepsToTick  := EmuStepsPerTick;
 EmuIrqPending   := 0;
 EmuVideo.StatusRetrace := 0;
 EmuVideo.VRetraceAcc   := 0;
 { Etat materiel volatil (8259A/8255A/UART/LPT/NE2000) remis a neuf pour    }
 { cette session, comme EmuIrqPending ci-dessus - a la difference de la     }
 { CMOS (EmuCMOS_Reg), qui persiste deliberement comme une vraie pile       }
 { CMOS. Vecteurs par defaut reels ($08 maitre, $70 esclave, memes valeurs  }
 { qu un vrai BIOS programme au demarrage). }
 Emu_PIC_Reset(EmuPICMaster, $08);
 Emu_PIC_Reset(EmuPICSlave, $70);
 FillChar(EmuPPI, SizeOf(EmuPPI), 0);
 FillChar(EmuLPT1, SizeOf(EmuLPT1), 0);
 FillChar(EmuLPT2, SizeOf(EmuLPT2), 0);
 Emu_UART_Init(EmuCOM2);
 Emu_UART_Init(EmuCOM4);
 Emu_NE2000_Init(EmuNE2000);
 Emu_8042_Init;
 FillChar(EmuST506, SizeOf(EmuST506), 0);
 Emu_ATA_Init(EmuATA[0], 0);
 Emu_ATA_Init(EmuATA[1], 1);
 FillChar(EmuSCSI, SizeOf(EmuSCSI), 0);
 FillChar(EmuFDC, SizeOf(EmuFDC), 0);
 Emu_Tv_Init(P);
 { DOS demarre l application avec IF=1 (interruptions activees). }
 Include(P.CPU.Flags.s, EFG_IF);
End;

{ Pousse une touche dans le buffer clavier BIOS 0040:001E. }
Procedure Emu_PushBiosKey(Var P: TEmulatorPanel; ScanCode, AsciiCh: Byte);
Var
 Tail, Head, NewTail: Word;
 LogF: Text;
Begin
 {$I-}
 Assign(LogF, 'EMUKEY.LOG'); Append(LogF);
 If IOResult <> 0 Then Begin Assign(LogF,'EMUKEY.LOG'); Rewrite(LogF); End;
 WriteLn(LogF, 'PushBiosKey scan=', HexByte(ScanCode), ' ascii=',
   HexByte(AsciiCh));
 Close(LogF);
 {$I+} If IOResult <> 0 Then ;
 Tail := Emu_ReadWord(P.CPU, $40, $1C);
 Head := Emu_ReadWord(P.CPU, $40, $1A);
 NewTail := Tail + 2;
 If NewTail >= $3E Then NewTail := $1E;
 If NewTail = Head Then Exit;
 Emu_WriteByte(P.CPU, $40, Tail, AsciiCh);
 Emu_WriteByte(P.CPU, $40, Tail + 1, ScanCode);
 Emu_WriteWord(P.CPU, $40, $1C, NewTail);
End;

Function Emu_BiosHasKey(Var P: TEmulatorPanel): Boolean;
Begin
 Emu_BiosHasKey := Emu_ReadWord(P.CPU, $40, $1A) <>
                   Emu_ReadWord(P.CPU, $40, $1C);
End;

Function Emu_BiosPopKey(Var P: TEmulatorPanel): Word;
Var
 Head, NewHead: Word;
 W: Word;
Begin
 Head := Emu_ReadWord(P.CPU, $40, $1A);
 W := Emu_ReadWord(P.CPU, $40, Head);
 NewHead := Head + 2;
 If NewHead >= $3E Then NewHead := $1E;
 Emu_WriteWord(P.CPU, $40, $1A, NewHead);
 Emu_BiosPopKey := W;
End;

{ Tick d horloge 18.2 Hz : incremente compteur 0040:006C-006F et
  arme l IRQ 0 (timer). Appelee tous les EmuStepsPerTick instructions. }
Procedure Emu_TimerTick(Var P: TEmulatorPanel);
Var
 Counter: LongInt;
 Lo, Hi: Word;
Begin
 Inc(EmuTickCounter);
 Lo := Emu_ReadWord(P.CPU, $40, $6C);
 Hi := Emu_ReadWord(P.CPU, $40, $6E);
 Counter := (LongInt(Hi) Shl 16) Or Lo;
 Inc(Counter);
 Emu_WriteWord(P.CPU, $40, $6C, Word(Counter And $FFFF));
 Emu_WriteWord(P.CPU, $40, $6E, Word((Counter Shr 16) And $FFFF));
 EmuIrqPending := EmuIrqPending Or $01;
 If OptionsDlg.Data.DosTopView Then Begin
  Emu_Tv_ServiceSound;  { SOUND (1019h) - avance la file de notes }
  Emu_Tv_ServiceTimers; { TIMER TopView - avance les compteurs actifs }
 End;
End;

{ Verifier les IRQ en attente et tirer la plus prioritaire si IF=1. }
Procedure Emu_ServiceIrqs(Var P: TEmulatorPanel);
Begin
 If Not (EFG_IF In P.CPU.Flags.s) Then Exit;
 { TopView BEGINC/ENDC (INT 15h AX=101Bh/101Ch) : "desactive les           }
 { changements de tache" - la seule chose qui pourrait faire changer de    }
 { contexte dans cet emulateur mono-tache est une IRQ, donc gater          }
 { reellement leur livraison ici est une implementation fidele et non un   }
 { simple suivi d etat (voir le commentaire de perimetre pres de TVOT_*). }
 If EmuTvCritical Then Exit;
 If EmuIrqPending = 0 Then Exit;
 { Gate sur l IMR du 8259A maitre (OUT 21h) uniquement, PAS sur son ISR :   }
 { voir le commentaire de TEmuPICChip - un IRQ masque reste en attente     }
 { (pas perdu) jusqu a ce que le logiciel invite le demasque explicitement.}
 If ((EmuIrqPending And $01) <> 0) And ((EmuPICMaster.IMR And $01) = 0) Then Begin
   EmuIrqPending := EmuIrqPending And Not Byte($01);
   EmuPICMaster.ISR := EmuPICMaster.ISR Or $01;
   Emu_FireHwInt(P, Byte(EmuPICMaster.VectorBase + 0));
   Exit;
 End;
 If ((EmuIrqPending And $02) <> 0) And ((EmuPICMaster.IMR And $02) = 0) Then Begin
   EmuIrqPending := EmuIrqPending And Not Byte($02);
   EmuPICMaster.ISR := EmuPICMaster.ISR Or $02;
   Emu_FireHwInt(P, Byte(EmuPICMaster.VectorBase + 1));
   Exit;
 End;
End;

{ Workaround emulateur DOS : reparer une TextRec d'Input dont l'init
  RTL n'a pas ete executee correctement (BufPtr.seg=0, BufSize=0/2).
  Detecte a l'entree d'un Crt_Read (FAR proc): l'argument 1 sur la pile
  pointe vers la TextRec. Si BufPtr.seg = 0, on initialise un buffer de
  128 octets pointant sur le buffer inline (TextRec[+128]). }
Procedure Emu_FixupInputTextRec(Var P: TEmulatorPanel);
Var
 ArgOfs, ArgSeg: Word;
 BufPtrSeg, ModeW: Word;
Begin
 { Lire l'argument 1 (FAR ptr vers TextRec) sur la pile a SS:[SP+2..5]. }
 ArgOfs := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, P.CPU.Regs.SP + 2);
 ArgSeg := Emu_ReadWord(P.CPU, P.CPU.Segs.SS, P.CPU.Regs.SP + 4);
 If ArgSeg = 0 Then Exit;
 { Verifier que la cible ressemble a une TextRec : Mode @+2 dans
   $D7B0..$D7B3 (fmClosed/Input/Output/InOut). }
 ModeW := Emu_ReadWord(P.CPU, ArgSeg, ArgOfs + 2);
 If (ModeW < $D7B0) Or (ModeW > $D7B3) Then Exit;
 BufPtrSeg := Emu_ReadWord(P.CPU, ArgSeg, ArgOfs + 14);
 If BufPtrSeg <> 0 Then Exit;
 { TextRec semble non initialisee : poser BufPtr -> @TextRec.Buffer (offset
   +128 dans la TextRec), BufSize=128, vider BufPos/BufEnd. }
 Emu_WriteWord(P.CPU, ArgSeg, ArgOfs + 4,  128);             { BufSize  }
 Emu_WriteWord(P.CPU, ArgSeg, ArgOfs + 8,  0);               { BufPos   }
 Emu_WriteWord(P.CPU, ArgSeg, ArgOfs + 10, 0);               { BufEnd   }
 Emu_WriteWord(P.CPU, ArgSeg, ArgOfs + 12, ArgOfs + 128);    { BufPtr.O }
 Emu_WriteWord(P.CPU, ArgSeg, ArgOfs + 14, ArgSeg);          { BufPtr.S }
End;

{ --- Executer une instruction 8086 --- }

{$PUSH}{$Q-}{$R-}
Procedure Emu_StepOne(Var P: TEmulatorPanel);
Var
 OpCode, ModRM, AluOp: Byte;
 Imm8: Byte;
 Imm16: Word;
 Op: TEmuOperand;
 V8, R8, S8: Byte;
 V16, R16, S16: Word;
 V32, R32, S32: LongInt;
 Disp8: ShortInt;
 Disp16: Integer;
 MulRes: LongInt;
 NewIP, NewCS: Word;
 SubOp: Byte;
 RepPrefix: Byte;
 Cnt: LongInt;
 Inc16: Integer;
 SIL, DIL: LongInt;   { pointeurs SI/DI de travail pour les operations       }
                       { string - 32 bits (ESI/EDI) si AddrSize32, sinon 16  }
                       { bits, voir le bloc $A4..$A7/$AA..$AF plus bas.      }
 OpSel: Byte;          { sauvegarde du 2e octet d opcode $0F avant reemploi  }
                       { de Imm8 comme valeur immediate (SHLD/SHRD/groupe 8) }
 ShCnt: Byte;          { compte de decalage SHLD/SHRD }
 ScanI: Integer;       { index de bit BSF/BSR }
 MulRes64: Int64;      { produit signe 32x32 complet, pour CF/OF d IMUL 32 bits }
 CpuVendStr: String;   { chaine d identification CPUID a 12 caracteres, voir $A2 }
 ResetSegOvr: Boolean;
 LogF_Dbg: Text;
 Imm8_Dbg: Byte;
 Imm16_Dbg, V16_Dbg, Ofs_Dbg: Word;
 I_Dbg: Integer;
 InstructionIP: Word;
 DecPreserveCF: Boolean;
Begin
 If P.CPU.Fault <> sfNone Then Exit;
 InstructionIP := P.CPU.IP;
 If (OptionsDlg.Data.DosLogDiag Or OptionsDlg.Data.DosLogInt13) And
   (((P.CPU.Segs.CS = $14F1) And (P.CPU.IP >= $007E) And
    (P.CPU.IP <= $0084)) Or
    ((P.CPU.Segs.CS = $9000) And (P.CPU.IP <= $0700))) And
    (EmuSITraceCount < 2000) Then Begin
  {$I-} Assign(LogF_Dbg, 'EMUSI.LOG'); Append(LogF_Dbg);
  If IOResult <> 0 Then Begin Assign(LogF_Dbg, 'EMUSI.LOG'); Rewrite(LogF_Dbg); End;
  WriteLn(LogF_Dbg, HexWord(P.CPU.Segs.CS), ':', HexWord(P.CPU.IP),
   ' Bytes=', HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, P.CPU.IP)), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+1))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+2))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+3))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+4))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+5))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+6))), ' ',
              HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.CS, Word(P.CPU.IP+7))),
   ' AX=', HexWord(P.CPU.Regs.AX),
   ' BX=', HexWord(P.CPU.Regs.BX),
   ' CX=', HexWord(P.CPU.Regs.CX),
   ' DX=', HexWord(P.CPU.Regs.DX),
   ' SI=', HexWord(P.CPU.Regs.SI),
   ' DI=', HexWord(P.CPU.Regs.DI),
   ' BP=', HexWord(P.CPU.Regs.BP),
   ' SP=', HexWord(P.CPU.Regs.SP),
   ' DS=', HexWord(P.CPU.Segs.DS),
   ' ES=', HexWord(P.CPU.Segs.ES),
   ' SS=', HexWord(P.CPU.Segs.SS),
   ' ZF=', Ord(EFG_ZF In P.CPU.Flags.s),
   ' CF=', Ord(EFG_CF In P.CPU.Flags.s));
  Close(LogF_Dbg); {$I+} If IOResult <> 0 Then ;
  Inc(EmuSITraceCount);
 End;
 RepPrefix := 0;
 { Workaround : a l'entree de Crt_Read, reparer la TextRec d'Input si elle
   n'a pas ete initialisee par le RTL (BufPtr.seg=0). Cas BOWLING.EXE. }
 If (P.CPU.Segs.CS = $017D) And (P.CPU.IP = $039F) Then
  Emu_FixupInputTextRec(P);
 If (P.CPU.Segs.CS = $017D) And (P.CPU.IP = $039F) And (EmuTraceCnt = 0) Then
  EmuTraceCnt := 50000;
 If EmuTraceCnt > 0 Then Begin
  Dec(EmuTraceCnt);
  { Ne pas tracer le retro-IP sur INT 16h vide pour eviter
    de remplir le log avec la meme ligne. }
  If Not ((P.CPU.Segs.CS = $017D) And (P.CPU.IP = $0328)) Then Begin
   {$I-} Assign(LogF_Dbg, 'EMUSTEP.LOG'); Append(LogF_Dbg);
   If IOResult <> 0 Then Begin Assign(LogF_Dbg,'EMUSTEP.LOG'); Rewrite(LogF_Dbg); End;
   WriteLn(LogF_Dbg, HexWord(P.CPU.Segs.CS),':',HexWord(P.CPU.IP),
     ' Op=', HexByte(Emu_FetchByte(P.CPU, 0)),
     ' AX=', HexWord(P.CPU.Regs.AX),
     ' SP=', HexWord(P.CPU.Regs.SP),
     ' BX=', HexWord(P.CPU.Regs.BX),
     ' DI=', HexWord(P.CPU.Regs.DI),
     ' ES=', HexWord(P.CPU.Segs.ES),
     ' FL=', HexWord(P.CPU.Flags.Base));
   Close(LogF_Dbg); {$I+} If IOResult <> 0 Then ;
  End;
 End;
 ResetSegOvr := False;
 { BOGUE REEL (2026-08-24, trouve en investiguant le blocage BOOT/           }
 { chardev_entry - un pointeur de table de dispatch legitime (SI apres      }
 { mov si,18[bp]) se retrouvait dereference via le mauvais segment) :        }
 { P.CPU.HasSegOvr n etait remis a False qu APRES l execution de certains    }
 { opcodes precis (voir les 2 "If ResetSegOvr Then P.CPU.HasSegOvr :=        }
 { False" plus bas, un dans le groupe ALU, un en fin de dispatch commun) -   }
 { or plusieurs chemins (CALL near/CALL FAR/JMP near/JMP FAR du groupe 5     }
 { $FF, et d autres instructions de controle de flux ailleurs) sortent via   }
 { Exit AVANT d atteindre l un ou l autre de ces points, sautant donc ce      }
 { nettoyage. Consequence reelle observee : "CS:JMP FAR [ptr]" (prefixe 2E,  }
 { HasSegOvr:=True, SegOvr:=CS AVANT le saut) suivi d un JMP FAR reel         }
 { laissait HasSegOvr actif pour l instruction SUIVANTE, meme apres un        }
 { changement de CS - une instruction sans le moindre prefixe (ex: "MOV      }
 { SI,[BP+12h]", adressage base sur BP donc segment par defaut SS) se         }
 { retrouvait donc dereferencee via l ANCIEN segment CS (celui d avant le     }
 { saut) au lieu de SS, lisant une donnee totalement non liee. Un vrai        }
 { processeur 8086 n applique jamais un prefixe de segment au-dela de          }
 { l instruction qu il precede immediatement - remettre HasSegOvr a False     }
 { ICI, inconditionnellement, avant meme d absorber les prefixes de la        }
 { PROCHAINE instruction, garantit cette regle quel que soit le chemin de     }
 { sortie (Exit anticipe ou fin de dispatch commune) emprunte par              }
 { l instruction PRECEDENTE - les 2 resets conditionnels existants plus bas   }
 { restent inoffensifs (HasSegOvr est deja False a ce moment dans les cas     }
 { qu ils couvrent) et ne sont pas retires pour limiter l etendue du          }
 { correctif. }
 P.CPU.HasSegOvr := False;
 { Meme discipline que HasSegOvr ci-dessus, pour OperandSize32 (prefixe $66)  }
 { - voir sa declaration dans TEmuCPU. }
 P.CPU.OperandSize32 := False;
 { Meme discipline, pour AddrSize32 (prefixe $67) - voir sa declaration      }
 { dans TEmuCPU. }
 P.CPU.AddrSize32 := False;
 { Diagnostic cibl? : dump instruction + DS:[offset teste] a 0EB7:01B7
   pour identifier la variable RTM TP4 testee a 0 (cause Halt(1)) - voir     }
 { Options > Emulateur > DOS: Debug (DosLogDiag) pour activer/desactiver. }
 If OptionsDlg.Data.DosLogDiag And (P.CPU.Segs.CS = $0EB7) And
    (P.CPU.IP = $01B7) And (Not EmuOvrDumped) Then Begin
  EmuOvrDumped := True;
  {$I-} Assign(LogF_Dbg, 'EMUDIAG.LOG'); Rewrite(LogF_Dbg);
  If IOResult = 0 Then Begin
   WriteLn(LogF_Dbg, 'HALT-DIAG @0EB7:01B7  DS=', HexWord(P.CPU.Segs.DS),
     ' SS:SP=', HexWord(P.CPU.Segs.SS), ':', HexWord(P.CPU.Regs.SP),
     ' BP=', HexWord(P.CPU.Regs.BP));
   { Decoder l instruction A1 ww ww : MOV AX, [DS:imm16] }
   Imm8_Dbg := Emu_ReadByte(P.CPU, $0EB7, $01B7);
   Imm16_Dbg := Emu_ReadWord(P.CPU, $0EB7, $01B8);
   WriteLn(LogF_Dbg, 'Opcode=', HexByte(Imm8_Dbg), ' ofs16=', HexWord(Imm16_Dbg));
   If Imm8_Dbg = $A1 Then Begin
    V16_Dbg := Emu_ReadWord(P.CPU, P.CPU.Segs.DS, Imm16_Dbg);
    WriteLn(LogF_Dbg, 'MOV AX, [DS:', HexWord(Imm16_Dbg), ']  -> ',
      HexWord(V16_Dbg));
   End;
   { Dumper bytes de l instruction et qq voisines }
   Write(LogF_Dbg, '0EB7:01B0..01F0 :');
   For I_Dbg := 0 To $40 Do Begin
    If (I_Dbg And 15) = 0 Then Begin
     WriteLn(LogF_Dbg);
     Write(LogF_Dbg, ' ', HexWord(Word($01B0 + I_Dbg)), ': ');
    End;
    Write(LogF_Dbg, HexByte(Emu_ReadByte(P.CPU, $0EB7, Word($01B0 + I_Dbg))), ' ');
   End;
   WriteLn(LogF_Dbg);
   { Dumper bytes du DGROUP autour de l offset teste }
   If Imm8_Dbg = $A1 Then Begin
    Ofs_Dbg := Word(Imm16_Dbg And $FFF0);
    WriteLn(LogF_Dbg, 'DS=', HexWord(P.CPU.Segs.DS), ' offset zone ',
      HexWord(Ofs_Dbg), '..', HexWord(Word(Ofs_Dbg + $3F)), ':');
    For I_Dbg := 0 To $3F Do Begin
     If (I_Dbg And 15) = 0 Then Begin
      WriteLn(LogF_Dbg);
      Write(LogF_Dbg, ' ', HexWord(Word(Ofs_Dbg + I_Dbg)), ': ');
     End;
     Write(LogF_Dbg, HexByte(Emu_ReadByte(P.CPU, P.CPU.Segs.DS,
       Word(Ofs_Dbg + I_Dbg))), ' ');
    End;
    WriteLn(LogF_Dbg);
   End;
   Close(LogF_Dbg);
  End;
  {$I+} If IOResult <> 0 Then ;
 End;
 { Boucle pour absorber prefixes de segment et REP/REPNE en serie }
 Repeat
  OpCode := Emu_FetchByte(P.CPU, 0);
  Case OpCode Of
   $26: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.ES;
              ResetSegOvr := True; Inc(P.CPU.IP); End;
   $2E: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.CS;
              ResetSegOvr := True; Inc(P.CPU.IP); End;
   $36: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.SS;
              ResetSegOvr := True; Inc(P.CPU.IP); End;
   $3E: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.DS;
              ResetSegOvr := True; Inc(P.CPU.IP); End;
   $64: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.DS;
              ResetSegOvr := True; Inc(P.CPU.IP); End; { FS -> traite comme DS }
   $65: Begin P.CPU.HasSegOvr := True; P.CPU.SegOvr := P.CPU.Segs.DS;
              ResetSegOvr := True; Inc(P.CPU.IP); End; { GS -> traite comme DS }
   $66: Begin P.CPU.OperandSize32 := True; Inc(P.CPU.IP); End;
        { BOGUE REEL CORRIGE (2026-08-24, HIMEM.SYS utilise reellement des    }
        { instructions 32 bits en mode reel pour verifier la memoire         }
        { etendue) : ce prefixe etait auparavant simplement CONSOMME ET      }
        { IGNORE (voir OperandSize32 en tete de fonction et son utilisation   }
        { dans les opcodes $50-$5F/$89/$8B/etc plus bas), faisant executer    }
        { silencieusement une instruction 32 bits comme si elle etait 16      }
        { bits (mauvaise largeur de registre/pile, resultats faux sans la     }
        { moindre erreur signalee). }
   $67: Begin P.CPU.AddrSize32 := True; Inc(P.CPU.IP); End;
        { BOGUE REEL CORRIGE (2026-08-24, retro-ingenierie directe du vrai    }
        { HIMEM.SYS 3.10 extrait du VHD : ce prefixe etait auparavant         }
        { simplement CONSOMME ET IGNORE, alors que la routine "unreal mode"   }
        { de copie memoire etendue de HIMEM.SYS (celle qui produit le message }
        { "XMS non fiable" en cas d echec) l utilise REELLEMENT sur REP       }
        { MOVSW/MOVSD via ESI/EDI 32 bits - voir AddrSize32 dans TEmuCPU. }
   $F0: Inc(P.CPU.IP); { LOCK - monoprocesseur reel-mode, deja traite   }
                        { comme un simple prefixe ignore par le coeur    }
                        { 32 bits protege, voir Dpmi_Step ($67,$F0,$F2,  }
                        { $F3 Inc(DpmiCPU.EIP)) - meme convention ici.  }
   $F2: Begin RepPrefix := $F2; Inc(P.CPU.IP); End;
   $F3: Begin RepPrefix := $F3; Inc(P.CPU.IP); End;
   Else
    Break;
  End;
 Until False;
 { ALU r/m,r ; r,r/m ; AL/AX,imm : opcodes 00..3D par groupes de 8.
   Dans chaque groupe de 8 (0x00..0x07, 0x08..0x0F, ...), seuls les
   indices 0..5 sont des operations ALU ; les indices 6 et 7 sont
   reserves aux instructions de segment (PUSH/POP ES/CS/SS/DS) ou
   aux prefixes de segment et ajustements decimaux. }
 If (OpCode <= $3D) And ((OpCode And 6) <> 6) Then Begin
  AluOp := (OpCode Shr 3) And 7;
  Case OpCode And 7 Of
   0: Begin { ALU rm8, r8 }
       ModRM := Emu_FetchByte(P.CPU, 1);
       Emu_DecodeModRM(P.CPU, ModRM, Op);
       V8 := Emu_GetOpByte(P.CPU, Op);
       S8 := Emu_GetReg8(P.CPU, (ModRM Shr 3) And 7);
       R8 := Emu_AluByte(P.CPU, AluOp, V8, S8);
       If AluOp <> 7 Then Emu_PutOpByte(P.CPU, Op, R8);
       Inc(P.CPU.IP, 1 + Op.Len);
      End;
   1: Begin { ALU rm16, r16 (rm32, r32 si OperandSize32 - 2026-08-24, HIMEM.SYS) }
       ModRM := Emu_FetchByte(P.CPU, 1);
       Emu_DecodeModRM(P.CPU, ModRM, Op);
       If P.CPU.OperandSize32 Then Begin
        V32 := Emu_GetOpDWord(P.CPU, Op);
        S32 := Emu_GetReg32(P.CPU, (ModRM Shr 3) And 7);
        R32 := Emu_AluDWord(P.CPU, AluOp, V32, S32);
        If AluOp <> 7 Then Emu_PutOpDWord(P.CPU, Op, R32);
       End Else Begin
        V16 := Emu_GetOpWord(P.CPU, Op);
        S16 := Emu_GetReg16(P.CPU, (ModRM Shr 3) And 7);
        R16 := Emu_AluWord(P.CPU, AluOp, V16, S16);
        If AluOp <> 7 Then Emu_PutOpWord(P.CPU, Op, R16);
       End;
       Inc(P.CPU.IP, 1 + Op.Len);
      End;
   2: Begin { ALU r8, rm8 }
       ModRM := Emu_FetchByte(P.CPU, 1);
       Emu_DecodeModRM(P.CPU, ModRM, Op);
       S8 := Emu_GetOpByte(P.CPU, Op);
       V8 := Emu_GetReg8(P.CPU, (ModRM Shr 3) And 7);
       R8 := Emu_AluByte(P.CPU, AluOp, V8, S8);
       If AluOp <> 7 Then
        Emu_SetReg8(P.CPU, (ModRM Shr 3) And 7, R8);
       Inc(P.CPU.IP, 1 + Op.Len);
      End;
   3: Begin { ALU r16, rm16 (r32, rm32 si OperandSize32) }
       ModRM := Emu_FetchByte(P.CPU, 1);
       Emu_DecodeModRM(P.CPU, ModRM, Op);
       If P.CPU.OperandSize32 Then Begin
        S32 := Emu_GetOpDWord(P.CPU, Op);
        V32 := Emu_GetReg32(P.CPU, (ModRM Shr 3) And 7);
        R32 := Emu_AluDWord(P.CPU, AluOp, V32, S32);
        If AluOp <> 7 Then
         Emu_SetReg32(P.CPU, (ModRM Shr 3) And 7, R32);
       End Else Begin
        S16 := Emu_GetOpWord(P.CPU, Op);
        V16 := Emu_GetReg16(P.CPU, (ModRM Shr 3) And 7);
        R16 := Emu_AluWord(P.CPU, AluOp, V16, S16);
        If AluOp <> 7 Then
         Emu_SetReg16(P.CPU, (ModRM Shr 3) And 7, R16);
       End;
       Inc(P.CPU.IP, 1 + Op.Len);
      End;
   4: Begin { ALU AL, imm8 }
       Imm8 := Emu_FetchByte(P.CPU, 1);
       R8 := Emu_AluByte(P.CPU, AluOp, P.CPU.Regs.AL, Imm8);
       If AluOp <> 7 Then P.CPU.Regs.AL := R8;
       Inc(P.CPU.IP, 2);
      End;
   5: Begin { ALU AX, imm16 (EAX, imm32 si OperandSize32) }
       If P.CPU.OperandSize32 Then Begin
        V32 := Emu_FetchWord(P.CPU, 1) Or (LongInt(Emu_FetchWord(P.CPU, 3)) Shl 16);
        R32 := Emu_AluDWord(P.CPU, AluOp, P.CPU.Regs.EAX, V32);
        If AluOp <> 7 Then P.CPU.Regs.EAX := R32;
        Inc(P.CPU.IP, 5);
       End Else Begin
        Imm16 := Emu_FetchWord(P.CPU, 1);
        R16 := Emu_AluWord(P.CPU, AluOp, P.CPU.Regs.AX, Imm16);
        If AluOp <> 7 Then P.CPU.Regs.AX := R16;
        Inc(P.CPU.IP, 3);
       End;
      End;
  End;
  If ResetSegOvr Then P.CPU.HasSegOvr := False;
  Exit;
 End;
 Case OpCode Of
  $90: { NOP }
   Inc(P.CPU.IP);
  $F4: { HLT }
   Begin
    P.CPU.Fault := sfHLT;
    Inc(P.CPU.IP);
   End;
  $9B: { FWAIT/WAIT : ignore }
   Inc(P.CPU.IP);
  $27: { DAA - Decimal Adjust after Addition }
   Begin
    V8 := P.CPU.Regs.AL;
    R16 := 0; { reutilise comme drapeau old_CF }
    If EFG_CF In P.CPU.Flags.s Then R16 := 1;
    If ((V8 And $0F) > 9) Or (EFG_AF In P.CPU.Flags.s) Then Begin
     If (Word(V8) + 6) > $FF Then Include(P.CPU.Flags.s, EFG_CF);
     V8 := Byte(V8 + 6);
     Include(P.CPU.Flags.s, EFG_AF);
    End Else
     Exclude(P.CPU.Flags.s, EFG_AF);
    If (V8 > $9F) Or (R16 = 1) Then Begin
     V8 := Byte(V8 + $60);
     Include(P.CPU.Flags.s, EFG_CF);
    End Else
     Exclude(P.CPU.Flags.s, EFG_CF);
    P.CPU.Regs.AL := V8;
    Emu_SetSFB(P.CPU, V8); Emu_SetZFB(P.CPU, V8); Emu_SetPF(P.CPU, V8);
    Inc(P.CPU.IP);
   End;
  $2F: { DAS - Decimal Adjust after Subtraction }
   Begin
    V8 := P.CPU.Regs.AL;
    R16 := 0;
    If EFG_CF In P.CPU.Flags.s Then R16 := 1;
    If ((V8 And $0F) > 9) Or (EFG_AF In P.CPU.Flags.s) Then Begin
     If V8 < 6 Then Include(P.CPU.Flags.s, EFG_CF);
     V8 := Byte(V8 - 6);
     Include(P.CPU.Flags.s, EFG_AF);
    End Else
     Exclude(P.CPU.Flags.s, EFG_AF);
    If (V8 > $9F) Or (R16 = 1) Then Begin
     V8 := Byte(V8 - $60);
     Include(P.CPU.Flags.s, EFG_CF);
    End;
    P.CPU.Regs.AL := V8;
    Emu_SetSFB(P.CPU, V8); Emu_SetZFB(P.CPU, V8); Emu_SetPF(P.CPU, V8);
    Inc(P.CPU.IP);
   End;
  $37: { AAA - ASCII Adjust after Addition }
   Begin
    If ((P.CPU.Regs.AL And $0F) > 9) Or (EFG_AF In P.CPU.Flags.s) Then Begin
     P.CPU.Regs.AL := Byte(P.CPU.Regs.AL + 6);
     P.CPU.Regs.AH := Byte(P.CPU.Regs.AH + 1);
     Include(P.CPU.Flags.s, EFG_AF);
     Include(P.CPU.Flags.s, EFG_CF);
    End Else Begin
     Exclude(P.CPU.Flags.s, EFG_AF);
     Exclude(P.CPU.Flags.s, EFG_CF);
    End;
    P.CPU.Regs.AL := P.CPU.Regs.AL And $0F;
    Inc(P.CPU.IP);
   End;
  $3F: { AAS - ASCII Adjust after Subtraction }
   Begin
    If ((P.CPU.Regs.AL And $0F) > 9) Or (EFG_AF In P.CPU.Flags.s) Then Begin
     P.CPU.Regs.AL := Byte(P.CPU.Regs.AL - 6);
     P.CPU.Regs.AH := Byte(P.CPU.Regs.AH - 1);
     Include(P.CPU.Flags.s, EFG_AF);
     Include(P.CPU.Flags.s, EFG_CF);
    End Else Begin
     Exclude(P.CPU.Flags.s, EFG_AF);
     Exclude(P.CPU.Flags.s, EFG_CF);
    End;
    P.CPU.Regs.AL := P.CPU.Regs.AL And $0F;
    Inc(P.CPU.IP);
   End;
  $D4: { AAM - ASCII Adjust after Multiply ; imm8 = base (typiquement 10) }
   Begin
    Imm8 := Emu_FetchByte(P.CPU, 1);
    If Imm8 = 0 Then Begin
     { #DE divide error : signaler en faute }
     P.CPU.Fault := sfInvalidCode;
     Inc(P.CPU.IP, 2);
    End Else Begin
     P.CPU.Regs.AH := P.CPU.Regs.AL Div Imm8;
     P.CPU.Regs.AL := P.CPU.Regs.AL Mod Imm8;
     Emu_SetSFB(P.CPU, P.CPU.Regs.AL);
     Emu_SetZFB(P.CPU, P.CPU.Regs.AL);
     Emu_SetPF(P.CPU, P.CPU.Regs.AL);
     Inc(P.CPU.IP, 2);
    End;
   End;
  $D5: { AAD - ASCII Adjust before Division ; imm8 = base }
   Begin
    Imm8 := Emu_FetchByte(P.CPU, 1);
    P.CPU.Regs.AL := Byte(P.CPU.Regs.AL + (P.CPU.Regs.AH * Imm8));
    P.CPU.Regs.AH := 0;
    Emu_SetSFB(P.CPU, P.CPU.Regs.AL);
    Emu_SetZFB(P.CPU, P.CPU.Regs.AL);
    Emu_SetPF(P.CPU, P.CPU.Regs.AL);
    Inc(P.CPU.IP, 2);
   End;
  $D8, $D9, $DA, $DB, $DC, $DD, $DE, $DF:
   { Instructions FPU 80x87. Strategie : on simule un 8086 SANS 8087.
     Sur ce CPU, les ESC sont des NOP (le bus laisse pendre). Sur 286+
     avec EM=1, ESC declenche INT 7 (Coprocessor Not Available). On
     dispatche INT 7 uniquement si EmuFpuTrap est actif ET que l app
     a installe un handler (IVT[7] segment != 0). Sinon NOP strict :
     pas d ecriture memoire, pas de modif registre. Cela laisse le
     test FPU classique (FSTCW [mem] avec mem precharge a une signature)
     conclure correctement "pas de FPU". }
   Begin
    SubOp := OpCode;  { recuperer pour log }
    ModRM := Emu_FetchByte(P.CPU, 1);
    Emu_DecodeModRM(P.CPU, ModRM, Op);
    { Diagnostic : loguer les 50 premiers ESC opcodes vus. }
    If EmuFpuLogged < 50 Then Begin
     Inc(EmuFpuLogged);
     {$I-}
     Assign(LogF_Dbg, 'EMUFPU.LOG'); Append(LogF_Dbg);
     If IOResult <> 0 Then Begin Assign(LogF_Dbg,'EMUFPU.LOG'); Rewrite(LogF_Dbg); End;
     Write(LogF_Dbg, '#', EmuFpuLogged, ' at ',
      HexWord(P.CPU.Segs.CS), ':', HexWord(P.CPU.IP),
      ' op=', HexByte(SubOp), ' modrm=', HexByte(ModRM));
     { Identifier les instructions cles. }
     Case SubOp Of
      $DB: If ModRM = $E3 Then Write(LogF_Dbg, ' (FNINIT)');
      $DF: If ModRM = $E0 Then Write(LogF_Dbg, ' (FNSTSW AX)');
      $DD: If (ModRM Shr 6) <> 3 Then Begin
            Case (ModRM Shr 3) And 7 Of
             7: Write(LogF_Dbg, ' (FNSTSW mem)');
            End;
           End;
      $D9: If (ModRM Shr 6) <> 3 Then Begin
            Case (ModRM Shr 3) And 7 Of
             5: Write(LogF_Dbg, ' (FLDCW mem)');
             7: Write(LogF_Dbg, ' (FNSTCW mem)');
            End;
           End;
     End;
     WriteLn(LogF_Dbg);
     Close(LogF_Dbg);
     {$I+} If IOResult <> 0 Then ;
    End;
    { INT 7 dispatch optionnel (mode 286+ EM=1). Off par defaut car
      les programmes 8086 (TP4 1987) n ont pas de handler INT 7. }
    If EmuFpuTrap Then Begin
     If Emu_ReadWord(P.CPU, 0, 7 * 4 + 2) <> 0 Then Begin
      Emu_FireHwInt(P, 7);
      Exit;  { IP a deja ete mis a jour par FireHwInt }
     End;
    End;
    Inc(P.CPU.IP, 1 + Op.Len);
   End;
  $CD: { INT imm8 }
   Begin
    Imm8 := Emu_FetchByte(P.CPU, 1);
    Inc(P.CPU.IP, 2);
    Emu_DoInt(P, Imm8);
   End;
  $CC: { INT 3 (1 octet, vecteur fixe 3) - deja gere par le coeur 32     }
       { bits protege (Dpmi_Step), manquait ici pour le coeur reel-mode. }
   Begin
    Inc(P.CPU.IP, 1);
    Emu_DoInt(P, 3);
   End;
  $CE: { INTO : declenche INT 4 (Overflow) SEULEMENT si OF=1, sinon      }
       { simple NOP - reelement absent jusqu ici (retombait dans l Else  }
       { generique de fin de dispatch, qui fixe P.CPU.Fault:=sfInvalidCode }
       { et arrete l emulation a tort des qu un programme reel l utilise). }
   Begin
    Inc(P.CPU.IP, 1);
    If EFG_OF In P.CPU.Flags.s Then Emu_DoInt(P, 4);
   End;
  $F1: { INT1/ICEBP (non documente, tous les 8086+ reels) : opcode a 1    }
       { octet qui declenche INT 1 comme un point d arret materiel -      }
       { meme famille d oubli que $CE ci-dessus. }
   Begin
    Inc(P.CPU.IP, 1);
    Emu_DoInt(P, 1);
   End;
  $D6: { SETALC/SALC (non documente, tous les 8086+ reels - l utilisateur }
       { a specifiquement demande cet opcode) : AL := $FF si CF=1, sinon  }
       { AL := $00. Aucun ModRM, aucun fanion modifie. }
   Begin
    Inc(P.CPU.IP, 1);
    If EFG_CF In P.CPU.Flags.s Then P.CPU.Regs.AL := $FF
                                Else P.CPU.Regs.AL := $00;
   End;
  $C3: { RET near }
   P.CPU.IP := Emu_PopWord(P.CPU);
  $CB: { RET far }
   Begin
    P.CPU.IP := Emu_PopWord(P.CPU);
    P.CPU.Segs.CS := Emu_PopWord(P.CPU);
   End;
  $C2: { RET near + pop imm16 }
   Begin
    Imm16 := Emu_FetchWord(P.CPU, 1);
    P.CPU.IP := Emu_PopWord(P.CPU);
    P.CPU.Regs.SP := P.CPU.Regs.SP + Imm16;
   End;
  $CA: { RET far + pop imm16 }
   Begin
    Imm16 := Emu_FetchWord(P.CPU, 1);
    P.CPU.IP := Emu_PopWord(P.CPU);
    P.CPU.Segs.CS := Emu_PopWord(P.CPU);
    P.CPU.Regs.SP := P.CPU.Regs.SP + Imm16;
   End;
  $CF: { IRET : pop IP, CS, FLAGS }
   Begin
    P.CPU.IP := Emu_PopWord(P.CPU);
    P.CPU.Segs.CS := Emu_PopWord(P.CPU);
    P.CPU.Flags.Base := Emu_PopWord(P.CPU);
   End;
  $B0..$B7: { MOV r8,imm8 }
   Begin
    Imm8 := Emu_FetchByte(P.CPU, 1);
