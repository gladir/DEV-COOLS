{ --- Gerer une touche dans le gestionnaire de configurations --- }

Procedure HandleConfigManagerKey(
 Var CM: TConfigurationManager; Key: Word);
Begin
 If Not CM.Visible Then Exit;
 Case Key Of
  $48: { Fleche haut }
   If CM.SelectedRow > 0 Then Begin
    Dec(CM.SelectedRow);
    CM.NeedRepaint := True;
   End;
  $50: { Fleche bas }
   Begin
    Inc(CM.SelectedRow);
    CM.NeedRepaint := True;
   End;
  $001B: { Echap }
   CM.Visible := False;
 End;
End;

