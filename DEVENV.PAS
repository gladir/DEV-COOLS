  If (Key = #27) Or (Key = #13) Then CloseDialog(Dlg.Base);
 End Else If EvtType = Ord(EV_MOUSE_DOWN) Then Begin
  If DialogButtonHitTest(Dlg.Base, MX, MY) = 0 Then
   CloseDialog(Dlg.Base);
 End;
