  Else
   EmuVScr_WriteStr(P, '[Limite 1000000 instructions atteinte]');
  P.CurFg := OldFg;
  P.CurBg := OldBg;
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  EmuVScr_WriteStr(P, 'Appuyez sur Echap pour fermer.');
  P.Running := False;
  P.Fault := sfEndProgram;
  P.StatusMsg := 'Emulateur Z80 : ' + IntToStr(Steps) + ' instr.';
  Exit;
 End;
 If Is6809 Then Begin
  { ----- Emulateur 6809 (CoCo3, Dragon, Thomson) ----- }
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  P.CurFg := 14;
  EmuVScr_WriteStr(P, 'Chargement du binaire ' + CPUName + '...');
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  P.CurFg := 7;
  FillChar(M6809_Mem, SizeOf(M6809_Mem), 0);
  M6809_Panel := @P;
  EntryAddr16 := $4000;
  Loaded := False;
  If TargetCPU = '-CCOCO3' Then Begin
   M6809_Variant := 0;
   { Reset etat ROM avant chargement }
   Coco3_RomLoaded := False;
   Coco3_RomMode := 0;
   { Detection : .PAK = cartouche brute, sinon DECB }
   If (Pos('.PAK', UpCaseStr(BinaryPath)) > 0) Or
      (Pos('.ROM', UpCaseStr(BinaryPath)) > 0) Then
    Loaded := Coco3_LoadPAK(BinaryPath, EntryAddr16)
   Else
    Loaded := M6809_LoadDECB(BinaryPath, EntryAddr16);
  End
  Else If TargetCPU = '-CDRAGON32' Then Begin
   M6809_Variant := 1;
   Loaded := M6809_LoadDECB(BinaryPath, EntryAddr16);
  End
  Else If TargetCPU = '-CDRAGON64' Then Begin
   M6809_Variant := 2;
   Loaded := M6809_LoadDECB(BinaryPath, EntryAddr16);
  End
  Else If TargetCPU = '-CTO7' Then Begin
   M6809_Variant := 3;
   Loaded := M6809_LoadThomsonBin(BinaryPath, EntryAddr16);
  End
  Else If TargetCPU = '-CTO8' Then Begin
   M6809_Variant := 4;
   Loaded := M6809_LoadThomsonBin(BinaryPath, EntryAddr16);
  End
  Else If TargetCPU = '-CMO5' Then Begin
   M6809_Variant := 5;
   Loaded := M6809_LoadThomsonBin(BinaryPath, EntryAddr16);
  End;
  If Not Loaded Then Begin
   P.CurFg := 12;
   EmuVScr_WriteStr(P,
    'Erreur : impossible de charger ' + BinaryPath);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   P.CurFg := OldFg;
   P.Running := False;
   P.Fault := sfEndProgram;
   P.StatusMsg := 'Echec chargement binaire 6809';
   Exit;
  End;
  { Activer Coco3 AVANT M6809_Reset pour eviter l ecrasement des
    vecteurs $FFFE/$FFFF par la sentinelle.
    Mode hardware uniquement pour les cartouches .PAK et ROMs .ROM ;
    les programmes Pascal/ASM compiles utilisent l emulateur 6809
    textuel comme avant. }
  If (TargetCPU = '-CCOCO3') And
     ((Pos('.PAK', UpCaseStr(BinaryPath)) > 0) Or
      (Pos('.ROM', UpCaseStr(BinaryPath)) > 0)) Then
    Coco3_Active := True;
  M6809_Reset(EntryAddr16);
  If OptionsDlg.Data.EmuShowDebugMessages Then Begin
   P.CurFg := 10;
   EmuVScr_WriteStr(P, 'Programme charge (PC=$' +
    M68K_HexN(M6809_PC, 4) + ')');
   P.CurFg := 7;
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  End;
  Steps := 0;
  If (TargetCPU = '-CCOCO3') And Coco3_Active Then Coco3_InitState;
  If (TargetCPU = '-CCOCO3') And Coco3_Active Then Begin
   { ----- Stage 1 (2026-08-15) : charge puis rend la main immediatement -   }
   { meme motif que NES/A2600/C64, l execution reelle (trame par trame,     }
   { ~60 Hz) est desormais pilotee par l idle-tick de MainLoop via           }
   { StepEmulator/Coco3_RunOneFrame, PAS par une boucle interne ici. Ne      }
   { s applique qu au mode materiel .PAK/.ROM (Coco3_Active=True) - le mode  }
   { "programme 6809 texte compile" (Pascal/ASM) reste sur l ancien chemin   }
   { bloquant ci-dessous (branche Else), comme Dragon32/64/TO7/TO8/MO5.     }
   EmuDbg.Active := True;
   EmuDbg.CPU    := EDC_6809;
   Coco3_FrameNo := 0;
   Coco3_FBFirst := True;
   FillChar(Coco3_FBPrev, SizeOf(Coco3_FBPrev), $FF);
   Coco3Async_KeyEsc := False;
   Coco3Async_LastFrameTS := 0;
   EmuHasFocus := True;
   EmuLastActiveState := True;
   { Premier rendu pour afficher le panneau }
   DrawEmulatorPanel(P);
   P.Loaded := True;
   Exit;
  End Else Begin
   While (Not M6809_Halted) And (Steps < 1000000) Do Begin
    M6809_Step;
    Inc(Steps);
    If M6809_PC = 0 Then Begin
     M6809_Halted := True;
     M6809_ExitCode := 0;
    End;
   End;
  End;
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  P.CurFg := 11;
  If M6809_Halted Then
   EmuVScr_WriteStr(P, '[Fin 6809 : ' +
    IntToStr(Steps) + ' instructions, code=' +
    IntToStr(M6809_ExitCode) + ']')
  Else
   EmuVScr_WriteStr(P, '[Limite 1000000 instructions atteinte]');
  P.CurFg := OldFg;
  P.CurBg := OldBg;
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  EmuVScr_WriteStr(P, 'Appuyez sur Echap pour fermer.');
  P.Running := False;
  P.Fault := sfEndProgram;
  P.StatusMsg := 'Emulateur 6809 : ' + IntToStr(Steps) + ' instr.';
  Exit;
 End;
 If IsELF64 Then Begin
  { ----- Emulateur Linux ELF64 x86-64 ----- }
  ELF64_Panel := @P;
  Loaded := Emu_LoadELF64(BinaryPath, Args);
  If Not Loaded Then Begin
   P.CurFg := 12;
   EmuVScr_WriteStr(P, 'Erreur : binaire ELF64 invalide ou illisible.');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   P.CurFg := 7;
   EmuVScr_WriteStr(P,
    'Seuls les executables statiques ELF64 x86-64 (ET_EXEC, sans');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P,
    'interpreteur dynamique) sont pris en charge pour le moment.');
   P.CurFg := OldFg; P.CurBg := OldBg;
   P.Running := False;
   P.Fault := sfEndProgram;
   P.StatusMsg := 'Echec de chargement ELF64';
   Exit;
  End;
  If OptionsDlg.Data.EmuShowDebugMessages Then Begin
   P.CurFg := 10;
   EmuVScr_WriteStr(P, 'Binaire ELF64 charge : ' +
    IntToStr(ELF64_SegCount) + ' segment(s) PT_LOAD, ' +
    IntToStr(LongInt(ELF64_LoadTop - ELF64_LoadBase)) + ' octets d''image.');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   P.CurFg := 7;
   EmuVScr_WriteStr(P, 'Point d''entree   : 0x' + HexQWord(ELF64_EntryPoint));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'Pile initiale RSP: 0x' + HexQWord(ELF64_Reg[REG_RSP]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'Debut du tas brk : 0x' + HexQWord(ELF64_BrkStart));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  End;
  { Executer le programme : boucle bornee, comme les autres emulateurs   }
  { integres (M6809, 6502...). S arrete des qu une instruction inconnue  }
  { ou un SYSCALL (dispatche a l etape suivante de la feuille de route)  }
  { est rencontree.                                                      }
  Steps := 0;
  While (Not ELF64_Halted) And (Steps < 5000000) Do Begin
   Elf64_Step;
   Inc(Steps);
  End;
  If ELF64_Halted Then Begin
   P.CurFg := 11;
   EmuVScr_WriteStr(P, '[' + ELF64_HaltReason + ']');
  End Else Begin
   P.CurFg := 12;
   EmuVScr_WriteStr(P, '[Limite de ' + IntToStr(Steps) + ' instructions atteinte]');
  End;
  EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
  If OptionsDlg.Data.EmuShowDebugMessages Then Begin
   P.CurFg := 7;
   EmuVScr_WriteStr(P, IntToStr(Steps) + ' instruction(s) executee(s).');
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'RIP : 0x' + HexQWord(ELF64_RIP) +
    '   RAX : 0x' + HexQWord(ELF64_Reg[REG_RAX]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'RSP : 0x' + HexQWord(ELF64_Reg[REG_RSP]) +
    '   RDI : 0x' + HexQWord(ELF64_Reg[REG_RDI]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'RCX : 0x' + HexQWord(ELF64_Reg[REG_RCX]) +
    '   RDX : 0x' + HexQWord(ELF64_Reg[REG_RDX]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'RSI : 0x' + HexQWord(ELF64_Reg[REG_RSI]) +
    '   RBX : 0x' + HexQWord(ELF64_Reg[REG_RBX]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   EmuVScr_WriteStr(P, 'RBP : 0x' + HexQWord(ELF64_Reg[REG_RBP]));
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   If ELF64_LastBadRIP <> 0 Then Begin
    EmuVScr_WriteStr(P, 'Adresse de l''instruction en cause : 0x' +
     HexQWord(ELF64_LastBadRIP));
    EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   End;
   EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   { Historique des dernieres adresses executees (etat 7d : diagnostic    }
   { leger avant un vrai debogueur pas-a-pas) - aide a retracer le chemin }
   { d execution ayant mene a l arret, notamment un saut errant. Affiche   }
   { en cas d arret anormal (ELF64_LastBadRIP <> 0, mis a jour par tous    }
   { les points d arret d erreur) OU quand la limite d instructions est    }
   { atteinte (Not ELF64_Halted a ce point - utile pour diagnostiquer une  }
   { veritable boucle infinie) - PAS lors d une fin de programme normale   }
   { (sys_exit), sinon ce bruit de diagnostic masque le resultat reel      }
   { affiche par le programme invite juste au-dessus.                     }
   If (ELF64_LastBadRIP <> 0) Or (Not ELF64_Halted) Then Begin
    EmuVScr_WriteStr(P, 'Historique RIP / RSP (plus ancien -> plus recent) :');
    EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
    If ELF64_TraceCount < 60 Then TraceN := ELF64_TraceCount Else TraceN := 60;
    For TraceI := TraceN - 1 DownTo 0 Do Begin
     TraceLine := 'RIP=0x' +
      HexQWord(ELF64_TraceRIP[(ELF64_TraceCount - 1 - TraceI) And 1023]) +
      '  RSP=0x' +
      HexQWord(ELF64_TraceRSP[(ELF64_TraceCount - 1 - TraceI) And 1023]);
     EmuVScr_WriteStr(P, TraceLine);
     EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
    End;
    EmuVScr_PutChar(P, #13); EmuVScr_PutChar(P, #10);
   End;
  End;
  P.CurFg := 7;
  EmuVScr_WriteStr(P, 'Appuyez sur Echap pour fermer.');
  P.CurFg := OldFg; P.CurBg := OldBg;
  P.Running := False;
  P.Fault := sfEndProgram;
  P.StatusMsg := ELF64_HaltReason;
  Exit;
 End;
 If Not IsX86 Then Begin
