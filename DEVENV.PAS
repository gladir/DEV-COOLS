 GetStartPageSelectedItem := SP.SelectedItem;
End;

{ --- Detecter une directive Delphi APPTYPE dans un fichier .pas ---      }
{ EXTENSION (2026-08-08) : demande explicite de l utilisateur - un .pas     }
{ contenant la directive Delphi dollar-APPTYPE CONSOLE ou dollar-APPTYPE      }
{ GUI (jamais reconnue par TPCW32/fpc, syntaxe Turbo Pascal/FreePascal)         }
{ doit etre compile par DELPHI.PAS (DELPHI.exe) plutot que le compilateur          }
{ Pascal habituel - recherche SIMPLE, LIGNE PAR LIGNE, insensible a la               }
{ casse, EXACTEMENT comme la directive apparaitrait dans le source                     }
{ (typiquement dans un commentaire directive, jamais ailleurs en pratique). }
Function FileContainsAppType(Const FileName: String): Boolean;
Var
 F: Text;
 Line: String;
Begin
 FileContainsAppType := False;
 {$I-}
 Assign(F, FileName);
 Reset(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 While Not Eof(F) Do Begin
  ReadLn(F, Line);
  If Pos('$APPTYPE', UpCaseStr(Line)) > 0 Then Begin
   FileContainsAppType := True;
   Break;
  End;
 End;
 Close(F);
End;

{ --- Detecter une syntaxe VAX Pascal (DEC) dans un fichier .pas ---      }
{ EXTENSION (2026-08-08) : demande explicite de l utilisateur - un .pas     }
{ employant des extensions VAX Pascal historiques (DEC/VMS) jamais               }
{ reconnues par TPCW32/fpc NI par DELPHI.PAS doit etre compile par                  }
{ VAXPCW32.PAS (VAXPCW32.exe) plutot que l un ou l autre. TROIS marqueurs           }
{ INDEPENDANTS suffisent chacun a eux seuls (recherche SIMPLE, LIGNE PAR         }
{ LIGNE, insensible a la casse pour VARYING/SYS-dollar - MEME discipline           }
{ que FileContainsAppType ci-dessus) : le mot-cle VARYING (type chaine             }
{ VMS a longueur variable, ex. "s1 : varying [80] of char"), l operateur            }
{ de concatenation "||" (distinct du "+" standard) et le prefixe des                    }
{ appels aux services systeme VMS "SYS$" (ex. SYS$CREMBX - N IMPORTE                }
{ QUEL appel SYS$..., pas seulement celui-la). PRIORITE sur $APPTYPE :          }
{ verifiee EN PREMIER par l appelant, un .pas VAX Pascal reel n a de toute            }
{ facon aucune raison de contenir AUSSI une directive Delphi. }
Function FileContainsVaxPascal(Const FileName: String): Boolean;
Var
 F: Text;
 Line, UpLine: String;
Begin
 FileContainsVaxPascal := False;
 {$I-}
 Assign(F, FileName);
 Reset(F);
 {$I+}
 If IOResult <> 0 Then Exit;
 While Not Eof(F) Do Begin
  ReadLn(F, Line);
  UpLine := UpCaseStr(Line);
  If (Pos('VARYING', UpLine) > 0) Or
     (Pos('||', Line) > 0) Or
     (Pos('SYS$', UpLine) > 0) Then Begin
   FileContainsVaxPascal := True;
   Break;
  End;
 End;
 Close(F);
End;

{ --- Demarrer la compilation et l execution --- }

Procedure HandleStartDebugging;
Var
 SourceFile: String;
 Ext: String;
 CmdLine: String;
 TempFile: String;
 ExitCode: Integer;
 ExeName: String;
 BaseName: String;
 SrcDir: String;
 I: Integer;
 EffectiveCPU: String;
Begin
 { BOGUE REEL signale par l utilisateur (2026-08-02) : F5 recompilait      }
 { TOUJOURS le contenu SUR DISQUE du fichier actif, jamais le tampon         }
 { EN MEMOIRE de l editeur - modifier le source puis F5 sans avoir fait       }
 { Ctrl+S auparavant produisait donc TOUJOURS l ancien resultat (le            }
 { compilateur externe, invoque plus bas via ExecuteCompiler, lit le             }
 { fichier depuis le disque, jamais le tampon de l editeur). Corrige en           }
 { sauvegardant TOUTES les fenetres modifiees ICI, EXACTEMENT comme               }
 { Visual Studio le fait par defaut avant une compilation (MEME fonction          }
 { SaveAllWindows deja utilisee par "Enregistrer tout", Ctrl+Maj+S). }
 SaveAllWindows;
 { Determiner le fichier source a compiler }
 SourceFile := '';
 If Opts.SourceFile <> '' Then
  SourceFile := Opts.SourceFile
 Else If EditorReady And (WinMgr.ActiveIdx >= 0) Then
  SourceFile := WinMgr.Windows[WinMgr.ActiveIdx].FileName;
 If SourceFile = '' Then Begin
  AppendOutput(OutputPanel,
   'Erreur : aucun fichier source ouvert.',
   Ord(OTK_BUILD));
  Exit;
 End;
 { Determiner l extension }
 Ext := LowerCaseStr(ExtractFileExt(SourceFile));
 { Extraire le repertoire du fichier source }
 SrcDir := ExtractFilePath(SourceFile);
 { Preparer le panneau de sortie }
 ClearOutput(OutputPanel, Ord(OTK_BUILD));
 ClearErrors(ErrorList);
 TempFile := '_buildout.tmp';
 { Calculer le nom de base sans extension }
 BaseName := ExtractFileName(SourceFile);
 For I := Length(BaseName) DownTo 1 Do
  If BaseName[I] = '.' Then Begin
   BaseName := Copy(BaseName, 1, I - 1);
   Break;
  End;
 {$IFDEF WINDOWS}
 ExeName := SrcDir + BaseName + '.exe';
 {$ELSE}
 ExeName := SrcDir + BaseName;
 {$ENDIF}
 If (Ext = '.pas') Or (Ext = '.pp') Or (Ext = '.lpr')
    Or (Ext = '.dpr') Then Begin
  { EXTENSION (2026-08-08) : un .pas employant une syntaxe VAX Pascal          }
  { (voir la note d en-tete complete de FileContainsVaxPascal) est                }
  { compile par VAXPCW32.PAS plutot que TPCW32/fpc OU DELPHI.PAS - demande        }
  { explicite de l utilisateur, VERIFIEE EN PREMIER (avant $APPTYPE) pour           }
  { que la priorite reste sans ambiguite. SEUL .pas est concerne, MEME                }
  { discipline que $APPTYPE ci-dessous. }
  If (Ext = '.pas') And FileContainsVaxPascal(SourceFile) Then Begin
   { Compilation VAX Pascal (VARYING/||/SYS$ detectes) -> VAXPCW32.exe }
   CmdLine := FindCompiler('VAXPCW32');
   If CmdLine = '' Then Begin
    AppendOutput(OutputPanel,
     'Erreur : compilateur VAX Pascal non trouve (VAXPCW32.exe).',
     Ord(OTK_BUILD));
    Exit;
   End;
   CmdLine := CmdLine + ' ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else
  { EXTENSION (2026-08-08) : un .pas contenant la directive Delphi         }
  { $APPTYPE (voir la note d en-tete complete de FileContainsAppType) est       }
  { compile par DELPHI.PAS plutot que TPCW32/fpc - demande explicite de           }
  { l utilisateur. SEUL .pas est concerne : .pp/.lpr/.dpr (syntaxe                  }
  { FreePascal/Lazarus) continuent d utiliser TPCW32/fpc sans exception. }
  If (Ext = '.pas') And FileContainsAppType(SourceFile) Then Begin
   { Compilation Delphi (directive $APPTYPE detectee) -> DELPHI.exe }
   CmdLine := FindCompiler('DELPHI');
   If CmdLine = '' Then Begin
    AppendOutput(OutputPanel,
     'Erreur : compilateur Delphi non trouve (DELPHI.exe).',
     Ord(OTK_BUILD));
    Exit;
   End;
   CmdLine := CmdLine + ' ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else Begin
  { Compilation Pascal avec Free Pascal }
  DetectTPCCompiler(TPCContext);
  If TPCContext.CompilerFound Then Begin
   CmdLine := TPCContext.CompilerPath + ' ' + SourceFile;
   { Si un projet est charge, utiliser sa plateforme cible }
   If SolutionLoaded And (CurrentProject.Info.TargetCPU <> '') Then
    CmdLine := CmdLine + ' ' + CurrentProject.Info.TargetCPU;

   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine,
    Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else Begin
   { Aucun compilateur interne trouve, essayer fpc }
   CmdLine := 'fpc -Mtp ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine,
    Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End;
  End;
  { Pour toute cible non-Windows, lancer le panneau emulateur :
    pour 8086 (-CD/-CP) il execute reellement le binaire,
    pour les autres il affiche un panneau d information. }
  If SolutionLoaded And
     (CurrentProject.Info.TargetCPU <> '') And
     (CurrentProject.Info.TargetCPU <> '-CW32') And
     (CurrentProject.Info.TargetCPU <> '-CW') Then Begin
   { Pour les cibles 68000, TPCW32 produit directement un binaire :
     -CAMIGA   -> .exe (Amiga Hunk)
     -CATARIST -> .prg (Atari ST)
     -C68000   -> .prg }
   If (CurrentProject.Info.TargetCPU = '-CATARIST') Or
      (CurrentProject.Info.TargetCPU = '-C68000') Then
    ExeName := SrcDir + BaseName + '.prg';
   { Pour AMIGA, l extension par defaut est deja .exe -> conserver ExeName. }
   { Cible Cray-1 : TPCW32 produit un binaire COS Absolute .abs. }
   If CurrentProject.Info.TargetCPU = '-CCRAY1' Then
    ExeName := SrcDir + BaseName + '.abs';
   { Cibles 6502 retro : extension specifique au format }
   If CurrentProject.Info.TargetCPU = '-CAPPLEII' Then
    ExeName := SrcDir + BaseName + '.bin';
   If CurrentProject.Info.TargetCPU = '-CC64' Then
    ExeName := SrcDir + BaseName + '.prg';
   If (CurrentProject.Info.TargetCPU = '-CATARI400') Or
      (CurrentProject.Info.TargetCPU = '-CATARI800') Then
    ExeName := SrcDir + BaseName + '.xex';
   If CurrentProject.Info.TargetCPU = '-CNES' Then
    ExeName := SrcDir + BaseName + '.nes';
   If CurrentProject.Info.TargetCPU = '-CATARI2600' Then
    ExeName := SrcDir + BaseName + '.a26';
   If CurrentProject.Info.TargetCPU = '-CCOCO3' Then
    ExeName := SrcDir + BaseName + '.bin';
   If (CurrentProject.Info.TargetCPU = '-CDRAGON32') Or
      (CurrentProject.Info.TargetCPU = '-CDRAGON64') Then
    ExeName := SrcDir + BaseName + '.bin';
   If (CurrentProject.Info.TargetCPU = '-CTO7') Or
      (CurrentProject.Info.TargetCPU = '-CTO8') Or
      (CurrentProject.Info.TargetCPU = '-CMO5') Then
    ExeName := SrcDir + BaseName + '.bin';
   If CurrentProject.Info.TargetCPU = '-CTRS80' Then
    ExeName := SrcDir + BaseName + '.cmd';
   If CurrentProject.Info.TargetCPU = '-CMSX' Then
    ExeName := SrcDir + BaseName + '.com';
   If CurrentProject.Info.TargetCPU = '-CADAM' Then
    ExeName := SrcDir + BaseName + '.com';
   CreateEmulatorTab(ExeName,
    CurrentProject.Info.TargetCPU, '');
  End;
 End
 Else If (Ext = '.cs') Then Begin
  { Compilation C# }
  DetectCSCCompiler(CSCContext);
  If CSCContext.CompilerFound Then Begin
   CmdLine := CSCContext.CompilerPath + ' ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
   AppendOutput(OutputPanel, '> ' + CmdLine,
    Ord(OTK_BUILD));
   ExitCode := ExecuteCompiler(CmdLine, TempFile);
   ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
   CleanupTempFile(TempFile);
  End Else Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur C# non trouve.',
    Ord(OTK_BUILD));
   Exit;
  End;
 End
 Else If (Ext = '.vb') Then Begin
  { Compilation VB.NET -> VBNCW32.exe }
  CmdLine := FindCompiler('VBNCW32');
  If CmdLine = '' Then Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur VB.NET non trouve (VBNCW32.exe).',
    Ord(OTK_BUILD));
   Exit;
  End;
  CmdLine := CmdLine + ' ' + SourceFile;
  AppendOutput(OutputPanel,
   '------ Build started: ' + SourceFile + ' ------',
   Ord(OTK_BUILD));
  AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
  { BOGUE REEL (2026-08-08) : ce bloc executait ICI son PROPRE           }
  { "Execution de ExeName..." (If ExitCode=0 Then ...) EN PLUS de celui         }
  { du bloc COMMUN en fin de fonction (qui s applique a TOUTES les             }
  { extensions, MEME apres compilation reussie) - une compilation reussie        }
  { lancait donc le programme compile DEUX FOIS (une ici, une dans le bloc         }
  { commun, puisque ExitCode redevient celui, generalement 0, du PROGRAMME          }
  { EXECUTE ICI plutot que celui du COMPILATEUR). Supprime, MEME discipline         }
  { que .java/.psp/.c/.ada/.abap/.awk/.py/.pas/.pli (aucune duplication). }
  ExitCode := ExecuteCompiler(CmdLine, TempFile);
  ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
  CleanupTempFile(TempFile);
 End
 Else If (Ext = '.bas') Or (Ext = '.frm') Then Begin
  { Compilation Visual Basic 6 (.bas/.frm, EXTENSION 2026-08-08 pour        }
  { .frm - meme compilateur, demande explicite de l utilisateur : "F5 sur    }
  { .frm devrait utiliser le compilateur Visual Basic") -> VBCW32.exe }
  CmdLine := FindCompiler('VBCW32');
  If CmdLine = '' Then Begin
   AppendOutput(OutputPanel,
    'Erreur : compilateur VB 6 non trouve (VBCW32.exe).',
    Ord(OTK_BUILD));
   Exit;
  End;
  CmdLine := CmdLine + ' ' + SourceFile;
  AppendOutput(OutputPanel,
   '------ Build started: ' + SourceFile + ' ------',
   Ord(OTK_BUILD));
  AppendOutput(OutputPanel, '> ' + CmdLine, Ord(OTK_BUILD));
  { BOGUE REEL (2026-08-08) : MEME duplication que .vb ci-dessus (voir sa   }
  { note d en-tete complete) - "Execution de ExeName..." EN PLUS du bloc        }
  { COMMUN en fin de fonction lancait CALCULATOR.exe DEUX FOIS (symptome         }
  { signale par l utilisateur : "il ouvre une deuxieme fois... apres que        }
  { j ai ferme la premiere calculatrice" - le ExitCode de la PREMIERE               }
  { execution, 0 a la fermeture normale, faisait croire au bloc commun a          }
  { une COMPILATION reussie qu il fallait ENCORE executer). Supprime. }
  ExitCode := ExecuteCompiler(CmdLine, TempFile);
  ReadOutputFile(TempFile, OutputPanel, Ord(OTK_BUILD));
  CleanupTempFile(TempFile);
 End
 Else If (Ext = '.adb') Or (Ext = '.ads') Or (Ext = '.ada') Then Begin
  { Compilation Ada }
  DetectADACCompiler(ADACContext);
  If ADACContext.CompilerFound Then Begin
   CmdLine := ADACContext.CompilerPath + ' ' + SourceFile;
   AppendOutput(OutputPanel,
    '------ Build started: ' + SourceFile + ' ------',
    Ord(OTK_BUILD));
