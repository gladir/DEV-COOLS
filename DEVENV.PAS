 { Raccourcis clavier globaux (touches speciales uniquement) - sauf       }
 { quand Norton Commander a le focus : il reutilise lui-meme F1..F10          }
 { (menu deroulant F9, Copier F5, etc., NC.PAS) et doit les recevoir en          }
 { priorite plutot que de les voir absorbes ici par les raccourcis du          }
 { debogueur (BOGUE REEL 2026-08-09 : F9 n atteignait jamais                     }
 { HandleNCommanderEvent a cause de ce court-circuit). }
 If (Ev.Kind = EV_KEY_DOWN) And
    Not (TermVisible And TerminalHasFocus And (ActiveShell = SK_NCOMMANDER))
    Then Begin
  Case Ev.KeyCode Of
   $6B: Begin { Alt+F4 : quitter }
    TryQuit;
    Exit;
   End;
   $2D: Begin { Alt+X : quitter }
    TryQuit;
    Exit;
   End;
   $3B: Begin { F1 : Documentation en ligne }
    OpenHelpFile('DEVENV.HLP', '');
    Exit;
   End;
   $3F: Begin { F5 : reprendre l emulateur en pause, sinon comportement    }
              { d origine (continuer le debogueur en pause, sinon demarrer) }
    If Not EmuPanel_TryResume Then Begin
     If EmuDbg.Paused Then EmuDbg_Continue
     Else HandleStartDebugging;
    End;
    Exit;
   End;
   $40: Begin { F6 : generer la solution }
    HandleStartDebugging;
    Exit;
   End;
   $43: Begin { F9 : basculer point d arret machine si emulateur actif }
    If EmuDbg.Active Or EmuDbg.Paused Then Begin
     EmuDbg_ToggleBPAtPC;
     FullRepaintNeeded := True;
    End;
    Exit;
   End;
   $44: Begin { F10 : pas a pas principal (Step Over) }
    If EmuDbg.Paused Then EmuDbg_StepOver;
    Exit;
   End;
   $85: Begin { F11 : pas a pas detaille (Step Into) }
    If EmuDbg.Paused Then EmuDbg_StepInto;
    Exit;
   End;
   $87: Begin { Shift+F11 : pas a pas sortant (Step Out) }
    If EmuDbg.Paused Then EmuDbg_StepOut;
    Exit;
   End;
   $58: Begin { Shift+F5 : arreter l emulateur actif, puis le debogueur }
    EmuPanel_Stop;
    If EmuDbg.Active Or EmuDbg.Paused Then EmuDbg_Stop
    Else StopDebugging(BPMgr, OutputPanel);
    Exit;
   End;
   $62: Begin { Ctrl+F5 : demarrer sans debogage }
