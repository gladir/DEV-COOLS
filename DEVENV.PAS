 { Dpmi_AllocDosMem) - zone scratch dediee, largement apres tous les       }
 { autres trampolines de $F000 pour eviter toute collision. }
 EMU_DPMI_DOSMEM_SEG    = $F000;
 EMU_DPMI_DOSMEM_START  = $1000; { offset de debut (paragraphe $100) }
 EMU_DPMI_DOSMEM_CAP    = $8000; { plafond ~32 Ko, largement suffisant pour }
                                  { les tampons de transfert mode reel usuels}
 EMU_DPMI_MAX_SEL       = 255;   { nombre d entrees LDT logicielles }
 EMU_DPMI_MAX_HANDLE    = 32;    { poignees de memoire etendue DPMI }
 EMU_DPMI_MAX_CALLBACK  = 16;    { rappels mode reel (AX=0303h) }
 EMU_DPMI_EXT_BASE      = $100000; { 1 Mo - debut de la "memoire etendue"   }
 { --- TopView (Options > Emulateur > DOS: OS > TopView, INT 15h AH=10h/    }
 { 11h/12h - voir DOC/TOPVIEW_PROGRAMMING.txt et Emu_Tv*) - dernier bloc    }
 { encore libre de $F000 : le bump allocator DPMI ci-dessus va jusqu a      }
 { l offset $9000 (=$1000+$8000), donc $9000..$FFFF (28 Ko) est le seul     }
 { intervalle restant qui ne recouvre PHYSIQUEMENT rien d autre (un autre   }
 { segment proche comme $F800 semblerait "libre" a tort : $F800:0000 =      }
 { adresse physique $F8000, qui EST DEJA a l interieur de la plage DPMI     }
 { ci-dessus puisque $F000:9000 = $F9000 > $F8000 - donc rester sur LE MEME }
 { segment $F000, seulement a un offset plus eleve, est le choix sur.       }
 { Les poignees d objet (HANDLE/ISOBJ/GETBUF...) sont chacune un SEGMENT    }
 { DISTINCT, decalage toujours nul - fidele a la convention historique      }
 { documentee ("plusieurs appels anciens n utilisent que le segment du      }
 { handle, le decalage etant implicitement nul") ET indispensable pour      }
 { GETBUF, qui ne recoit reellement QUE le segment en entree : deux objets  }
 { qui partageraient le meme segment seraient impossibles a distinguer.     }
 { Chaque segment ne coute que 16 octets physiques (un paragraphe), donc    }
 { TV_MAX_OBJECTS(64) segments consecutifs ne consomment que 1 Ko - places  }
 { juste apres la pile privee ci-dessous, toujours dans la meme fenetre de  }
 { 28 Ko libre. }
 EMU_TV_SEG        = $F000;
 EMU_TV_WINBUF_OFS = $9000; { tampons virtuels des fenetres, TV_MAX_WINDOWS x TV_WINBUF_SIZE }
 TV_MAX_WINDOWS    = 4;
 TV_WINBUF_SIZE    = $1000; { 4096o, largement assez pour 80x25x2=4000o }
 EMU_TV_HEAP_OFS   = $D000; { tas GETMEM/PUTMEM, TV_HEAP_SIZE octets }
 TV_HEAP_SIZE      = $2000; { 8192o }
 EMU_TV_STACK_OFS  = $F000; { pile privee OSTACK/USTACK, TV_STACK_SIZE octets }
 TV_STACK_SIZE     = $100;  { 256o - fin de zone reelle a $F000:F100 = physique $FF100 }
 EMU_TV_HANDLE_SEG_BASE = $FF10; { physique $FF100, contigu a la pile ci-dessus }
 TV_MAX_OBJECTS    = 64;    { -> segments $FF10..$FF4F, physique $FF100..$FF500 }
 TV_MAX_BITS       = 16;    { GETBIT/FREEBIT/SETBIT }
 TV_MAX_INJECT     = 8;     { file LIFO d injections PGMINT en attente }
 TV_MAX_SOUNDS     = 32;    { file de sons SOUND (AX=1019h) }
                                    { DPMI (voir EmuDpmiExtMem) }
 EMU_DPMI_EXT_CAP_KB    = 65536;   { plafond 64 Mo, comme EMU_XMS_CAP_KB }

 { Plafond materiel arbitraire du tampon "memoire etendue" XMS, independant}
 { de la taille configuree par l utilisateur (DosXMSSize) qui ne peut que  }
 { l approcher par le bas - voir Emu_XmsInit. 64 Mo est tres genereux pour }
 { du logiciel DOS d epoque tout en restant une allocation triviale sur    }
 { une machine hote moderne. }
 EMU_XMS_CAP_KB       = 65536; { 64 Mo }

 { Plafond du tampon "memoire expansee" EMS - 32 Mo correspond au maximum  }
 { reellement supporte par la specification LIM/Microsoft EMS 4.0 elle-    }
 { meme (voir Emu_EmsInit), contrairement au plafond XMS ci-dessus qui est }
 { un choix arbitraire (XMS n a pas de limite fixee par sa specification). }
 EMU_EMS_CAP_KB       = 32768; { 32 Mo }
 EMU_EMS_PAGE_SIZE    = 16384; { taille fixe d une page EMS (16 Ko), toutes}
                                { versions confondues                     }
 EMU_EMS_MAX_HANDLES  = 64;    { plafond de poignees ouvertes simultanement}
 EMU_EMS_FRAME_SEG    = $E000; { segment de la fenetre "page frame" (4    }
                                { emplacements de 16 Ko = 64 Ko), choix    }
                                { historiquement courant, hors de portee   }
                                { de la VRAM ($A000-$BFFF) et de nos stubs }
                                { internes ($F000, voir IPX/Packet Driver/ }
                                { XMS)                                    }

 { UMB (Options > Emulateur > DOS: OS > "UMB", 2026-08-30, demande          }
 { explicite de l utilisateur) - RECHERCHE PREALABLE (agent Explore) :      }
 { contrairement a une hypothese initiale, les segments $C000 et $D000 ne   }
 { sont PAS de simples offsets a l interieur du segment $F000 (comme les    }
 { tampons TopView) mais de VRAIS segments autonomes, entierement libres et }
 { non interceptes nulle part dans Emu_ReadByte/Emu_WriteByte (a la         }
 { difference de $A000/$B000/$B800 rediriges vers la VRAM et $E000 = cadre  }
 { EMS) - de la vraie RAM emulee ordinaire, executable, sans aucun risque   }
 { de collision. $D000 sert ici a l allocateur UMB EXECUTE PAR LE           }
 { PROGRAMME (INT 2Fh/AH=10h-12h ci-dessous) ; $C000 est reserve            }
 { SEPAREMENT a LOADHIGH/LH (TermCmd_LOADHIGH, pres de TermCmd_LOADFIX) -   }
 { deux segments DISTINCTS et jamais partages, pour eviter tout probleme    }
 { d ordonnancement entre le chargement du programme (avant Emu_XmsInit)    }
 { et la reinitialisation de l etat XMS (Emu_XmsInit s execute APRES le     }
 { chargement et remet EmuXms.UmbInUse a zero - si LOADHIGH utilisait le    }
 { meme segment que l allocateur XMS, cette reinitialisation effacerait a   }
 { tort la reservation de LOADHIGH). }
 EMU_UMB_SEG          = $D000; { unique bloc UMB gere par AH=10h/11h/12h   }
 EMU_UMB_SIZE_PARAS   = $1000; { 64 Ko en paragraphes (4096 = 65536/16)    }

 { INT 21h AH=52h ("list of lists"/SYSVARS) - voir Emu_DoInt21 case $52 :  }
 { BOGUE REEL (2026-08-24, trouve en investiguant DOS=HIGH qui echoue      }
 { toujours sur le vrai boot MS-DOS 6.22 une fois les 2 bogues precedents  }
 { corriges - HIMEM.SYS appelle bien AH=52h puis parcourt la chaine des    }
 { pilotes de peripherique residents [ES:BX+22h] pour verifier qu aucun    }
 { gestionnaire XMS n est deja installe (recherche du nom "XMSXXXX0"),     }
 { AVANT de s installer lui-meme - ce handler renvoyait juste ES:BX=       }
 { 0040:0100 (une adresse arbitraire dans la zone de donnees BIOS, SANS     }
 { aucune structure reelle derriere) donc HIMEM.SYS lisait des octets       }
 { totalement non lies et abandonnait silencieusement son installation.    }
 { Corrige en placant une VRAIE mini-structure : une "liste de listes"      }
 { presque entierement a zero (champs non implementes = 0, inoffensif pour }
 { un pilote qui ne s interesse qu a la chaine de peripheriques) SAUF le    }
 { champ "pointeur vers l en-tete NUL" a l offset $22 (disposition standard}
 { et stable DOS 3.x-6.x, tres documentee) qui pointe vers un VRAI en-tete }
 { de pilote NUL minimal (chainage FFFF:FFFF = fin de chaine, nom NUL      }
 { complete d espaces) - exactement ce qu un parcours de chaine reel       }
 { trouve sur un vrai MS-DOS fraichement demarre (NUL est toujours le      }
 { premier maillon), avant }
 { l installation de tout pilote DEVICE= supplementaire. Emplacement       }
 { choisi dans le segment $F000 ($F600/$F640) - au-dela de toute la fenetre}
 { deja utilisee par TopView ($9000-$F4FF), donc sans collision. }
 EMU_LOL_SEG        = $F000;
 EMU_LOL_OFS        = $F600; { "liste de listes" (SYSVARS), 48 octets reserves }
 EMU_LOL_NULDEV_OFS = $F640; { en-tete du pilote NUL (18 octets), pointe par   }
                              { EMU_LOL_OFS+$22 }

 { INT 15h AH=C0h ("Get System Configuration Parameters") - voir                }
 { Emu_DoInt15AT case $C0 : BOGUE REEL (2026-08-24, trouve en poursuivant       }
 { l enquete DOS=HIGH/XMS - un WATCH pose sur l ecriture du VRAI mecanisme      }
 { d accrochage INT2Fh de DOS ("bios_i2f", documente dans le vrai source        }
 { MS-DOS 6.0 divulgue, msbdata.inc, comme "how the BIOS hooks int2f" - un      }
 { JMP FAR dont la cible est patchable) a montre que cette structure, bien      }
 { correctement initialisee tres tot au boot (etape 533), etait ECRASEE par     }
 { du remplissage sans rapport a l etape 19574 - BIEN AVANT que HIMEM.SYS ne    }
 { s execute (~etape 247780) - via une ecriture provenant de ce handler ici.    }
 { Le vrai BIOS ne recoit JAMAIS ES:BX du programme appelant pour cette         }
 { fonction : il retourne ES:BX pointant vers SA PROPRE table interne (en ROM   }
 { sur un vrai PC) - l appelant ne les initialise donc JAMAIS avant l appel,     }
 { et ce handler ecrivait ses 10 octets de reponse directement A TRAVERS le     }
 { contenu ARBITRAIRE (jamais destine a etre une adresse) que ES:BX contenait   }
 { par hasard au moment de l appel - dans ce cas precis, ES:BX valait           }
 { 0070:0005, exactement l adresse du mecanisme bios_i2f reel de DOS, detruit   }
 { par cette ecriture non voulue. Corrige en ecrivant la table a un            }
 { emplacement FIXE et reserve du segment $F000 (meme convention que les       }
 { autres stubs de ce fichier), puis en ne renvoyant QUE ES:BX pointant vers    }
 { CET emplacement - jamais d ecriture a l adresse fournie par l appelant. }
 EMU_SYSCONF_SEG = $F000;
 EMU_SYSCONF_OFS = $F660; { table de 10 octets (longueur+8), au-dela de       }
                           { EMU_LOL_NULDEV_OFS+18=$F652, donc sans collision }

