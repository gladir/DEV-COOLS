{ Recalcule Visible pour tous les noeuds de l arbre a partir de l etat    }
{ Expanded de leur parent direct (les noeuds de niveau 0 - les groupes -  }
{ restent toujours visibles) - centralise ici pour etre appelable a la    }
{ fois a la construction de l arbre et chaque fois qu un groupe est       }
{ deplie/replie par un clic (auparavant Expanded changeait bien mais      }
{ Visible restait fige a True pour tout le monde depuis AddNode, ce qui   }
{ ne posait pas de probleme visible tant qu il n y avait que 3 groupes    }
{ toujours deplies, mais deviendrait un arbre bien trop long une fois le  }
{ groupe Emulateur - 15 elements - ajoute s il restait toujours deplie).  }
{ Construit la liste (List) des index de Dlg.Categories dont Visible=True,}
{ dans l ordre d affichage, et renvoie leur nombre - sert de base au      }
{ defilement de l arbre (une ligne visible a l ecran = un element de      }
{ cette liste, pas un index brut dans Categories[]).                      }
Function BuildOptionsVisibleList(Var Dlg: TOptionsDialog;
 Var List: TOptVisList): Integer;
Var
 I, N: Integer;
Begin
 N := 0;
 For I := 0 To Dlg.CategoryCount - 1 Do
  If Dlg.Categories[I].Visible Then Begin
   List[N] := I;
   Inc(N);
  End;
 BuildOptionsVisibleList := N;
End;

{ Ajuste Dlg.ScrollTop si besoin pour que Dlg.SelectedCategory reste      }
{ visible a l ecran - appelee apres une navigation clavier (fleches),     }
{ puisqu un Page Up/Down ou une simple fleche peut deplacer la selection  }
{ hors de la fenetre de defilement actuelle sans passer par un clic.      }
Procedure EnsureOptionsCategoryVisible(Var Dlg: TOptionsDialog);
Var
 VisList: TOptVisList;
 VisCount, Pos, NodesFit, TreeY, TreeBottom: Integer;
Begin
 VisCount := BuildOptionsVisibleList(Dlg, VisList);
 Pos := 0;
 While (Pos < VisCount) And (VisList[Pos] <> Dlg.SelectedCategory) Do
  Inc(Pos);
 If Pos >= VisCount Then Exit;
 TreeY := Dlg.Base.Y + DLG_TITLE_HEIGHT + 1;
 TreeBottom := Dlg.Base.Y + Dlg.Base.Height - DLG_PADDING -
  DLG_BUTTON_HEIGHT - DLG_PADDING;
 NodesFit := (TreeBottom - TreeY) Div OPT_TREE_NODE_HEIGHT;
 If NodesFit < 1 Then NodesFit := 1;
 If Pos < Dlg.ScrollTop Then Dlg.ScrollTop := Pos;
 If Pos >= Dlg.ScrollTop + NodesFit Then
  Dlg.ScrollTop := Pos - NodesFit + 1;
End;

Procedure UpdateOptionsTreeVisibility(Var Dlg: TOptionsDialog);
Var
 I: Integer;
Begin
 For I := 0 To Dlg.CategoryCount - 1 Do
  If (Dlg.Categories[I].Level = 0) Or (Dlg.Categories[I].ParentIdx < 0) Then
   Dlg.Categories[I].Visible := True
  Else
   Dlg.Categories[I].Visible :=
    Dlg.Categories[Dlg.Categories[I].ParentIdx].Expanded;
End;

{ --- Construire l arbre de categories --- }

Procedure BuildOptionsCategoryTree(Var Dlg: TOptionsDialog);
Var
 I: Integer;

 Procedure AddNode(AName: String; AParent, ALevel: Integer;
  AExpanded: Boolean; ACat: TOptionCategory);
 Begin
  If Dlg.CategoryCount >= MAX_OPT_CATEGORIES Then Exit;
  I := Dlg.CategoryCount;
  InitOptCategoryNode(Dlg.Categories[I]);
  Dlg.Categories[I].Name := AName;
  Dlg.Categories[I].ParentIdx := AParent;
  Dlg.Categories[I].Level := ALevel;
  Dlg.Categories[I].Expanded := AExpanded;
  Dlg.Categories[I].Visible := True;
  Dlg.Categories[I].Category := ACat;
  Inc(Dlg.CategoryCount);
 End;

Begin
 Dlg.CategoryCount := 0;
 { Environnement (index 0) }
 AddNode('Environnement', -1, 0, True, OC_ENV_GENERAL);
 AddNode('General', 0, 1, False, OC_ENV_GENERAL);
 AddNode('Polices et couleurs', 0, 1, False, OC_ENV_FONTS);
 AddNode('Clavier', 0, 1, False, OC_ENV_KEYBOARD);
 AddNode('Demarrage', 0, 1, False, OC_ENV_STARTUP);
 AddNode('Enregistrement auto', 0, 1, False, OC_ENV_AUTOSAVE);
 { Editeur de texte (index 6) }
 AddNode('Editeur de texte', -1, 0, True, OC_EDITOR_GENERAL);
 AddNode('General', 6, 1, False, OC_EDITOR_GENERAL);
 AddNode('Tabulations', 6, 1, False, OC_EDITOR_TABS);
 AddNode('Defilement', 6, 1, False, OC_EDITOR_SCROLL);
 AddNode('IntelliSense', 6, 1, False, OC_EDITOR_INTELLISENSE);
 AddNode('Mise en forme', 6, 1, False, OC_EDITOR_FORMAT);
 { Projets et solutions (index 12) }
 AddNode('Projets et solutions', -1, 0, True, OC_PROJ_GENERAL);
 AddNode('General', 12, 1, False, OC_PROJ_GENERAL);
 AddNode('Build et execution', 12, 1, False, OC_PROJ_BUILD);
 { Debogage (index 15) -- utilise le dernier slot disponible }
 { Note : 16 noeuds au total = MAX_OPT_CATEGORIES }
 { Emulateur (index 15) - replie par defaut (voir                        }
 { UpdateOptionsTreeVisibility) pour que l arbre garde a peu pres sa      }
 { hauteur d origine tant que l utilisateur ne le deplie pas explicitement.}
 AddNode('Emulateur', -1, 0, False, OC_EMU_NES);
 AddNode('General', 15, 1, False, OC_EMU_GENERAL);
 AddNode('NES', 15, 1, False, OC_EMU_NES);
 AddNode('DOS: Materiel', 15, 1, False, OC_EMU_DOS_HW);
 AddNode('DOS: OS', 15, 1, False, OC_EMU_DOS_OS);
 AddNode('DOS: Logiciel', 15, 1, False, OC_EMU_DOS_SW);
 AddNode('Linux x86-64', 15, 1, False, OC_EMU_LINUX);
 AddNode('Amiga', 15, 1, False, OC_EMU_AMIGA);
 AddNode('Atari ST', 15, 1, False, OC_EMU_ATARIST);
 AddNode('Commodore 64', 15, 1, False, OC_EMU_C64);
 AddNode('Apple II', 15, 1, False, OC_EMU_APPLEII);
 AddNode('Atari 400', 15, 1, False, OC_EMU_ATARI400);
 AddNode('Atari 800', 15, 1, False, OC_EMU_ATARI800);
 AddNode('Atari 2600', 15, 1, False, OC_EMU_ATARI2600);
 AddNode('MSX', 15, 1, False, OC_EMU_MSX);
 AddNode('TRS80', 15, 1, False, OC_EMU_TRS80);
 AddNode('Adam', 15, 1, False, OC_EMU_ADAM);
