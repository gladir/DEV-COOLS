                                 { precision/l arrondi reel ne sont pas   }
                                 { appliques - limitation connue).        }
 ELF64_FpuC0     : Boolean;     { fanions de condition x87 (resultat des }
 ELF64_FpuC2     : Boolean;     { comparaisons FCOM/FUCOM, exposes via   }
