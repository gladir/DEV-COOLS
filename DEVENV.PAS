               Emu_ReadDWordL(P.CPU, Emu_DataSeg(P.CPU), SIL))
             Else
              Emu_WriteDWord(P.CPU, P.CPU.Segs.ES, Word(DIL),
               Emu_ReadDWord(P.CPU, Emu_DataSeg(P.CPU), Word(SIL)));
             SIL := SIL + Inc16 * 4;
             DIL := DIL + Inc16 * 4;
            End Else Begin
             If P.CPU.AddrSize32 Then
