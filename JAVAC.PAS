  SrcLen     : LongInt;
  Toks       : Array Of TToken;
  NToks      : LongInt;
  TokCap     : LongInt;
  P          : LongInt;    { index du jeton courant }

  { Arbre syntaxique }
  Nodes      : Array Of TNode;
  NNodes     : LongInt;

{ ============================================================================
  UTILITAIRES
  ============================================================================ }

Function LowerStr(Const S : String) : String;
Var I : LongInt; R : String;
Begin
  R := S;
  For I := 1 To Length(R) Do If (R[I] >= 'A') And (R[I] <= 'Z') Then R[I] := Chr(Ord(R[I]) + 32);
  LowerStr := R;
End;

Function IStr(V : Int64) : String;
Var S : String;
Begin
  Str(V, S);
  IStr := S;
End;

Function HexStr2(V : LongInt) : String;
Const Digs : String = '0123456789ABCDEF';
Begin
  HexStr2 := Digs[((V Shr 4) And 15) + 1] + Digs[(V And 15) + 1];
End;

Function IsDigit(C : Char) : Boolean;
Begin
  IsDigit := (C >= '0') And (C <= '9');
End;

Function IsIdStart(C : Char) : Boolean;
Begin
  IsIdStart := ((C >= 'a') And (C <= 'z')) Or ((C >= 'A') And (C <= 'Z')) Or
               (C = '_') Or (C = '$') Or (Ord(C) >= 128);
End;

Function IsIdChar(C : Char) : Boolean;
Begin
  IsIdChar := IsIdStart(C) Or IsDigit(C);
End;

Function HexVal(C : Char) : LongInt;
Begin
  If (C >= '0') And (C <= '9') Then HexVal := Ord(C) - 48
  Else If (C >= 'a') And (C <= 'f') Then HexVal := Ord(C) - 87
  Else If (C >= 'A') And (C <= 'F') Then HexVal := Ord(C) - 55
  Else HexVal := -1;
End;

Function FileExists(Const Fn : String) : Boolean;
Var F : File;
Begin
  Assign(F, Fn);
  Reset(F, 1);
  If IOResult = 0 Then Begin Close(F); FileExists := True; End
  Else FileExists := False;
  If IOResult <> 0 Then ;
End;

{ Remplace toutes les occurrences de Old par New dans S }
Function ReplaceAll(Const S, Old, New : String) : String;
Var R : String; I, L : LongInt;
Begin
  R := '';
  L := Length(Old);
  I := 1;
  While I <= Length(S) Do Begin
    If (L > 0) And (Copy(S, I, L) = Old) Then Begin
      R := R + New;
      Inc(I, L);
    End
    Else Begin
      R := R + S[I];
      Inc(I);
    End;
  End;
  ReplaceAll := R;
End;

Function LastPos(C : Char; Const S : String) : LongInt;
Var I : LongInt;
Begin
  I := Length(S);
  While (I > 0) And (S[I] <> C) Do Dec(I);
  LastPos := I;
End;

Function StartsWith(Const S, Prefix : String) : Boolean;
Begin
  StartsWith := Copy(S, 1, Length(Prefix)) = Prefix;
End;

{ Ajoute un point de code Unicode en "modified UTF-8" (format du .class) }
Procedure AppendMUtf8(Var S : String; Cp : LongInt);
Begin
  If Cp = 0 Then S := S + Chr($C0) + Chr($80)
  Else If Cp < $80 Then S := S + Chr(Cp)
  Else If Cp < $800 Then
    S := S + Chr($C0 Or (Cp Shr 6)) + Chr($80 Or (Cp And $3F))
  Else If Cp < $10000 Then
    S := S + Chr($E0 Or (Cp Shr 12)) + Chr($80 Or ((Cp Shr 6) And $3F)) +
             Chr($80 Or (Cp And $3F))
  Else Begin
    Cp := Cp - $10000;
    AppendMUtf8(S, $D800 + (Cp Shr 10));
    AppendMUtf8(S, $DC00 + (Cp And $3FF));
  End;
End;

{ Position codee : ligne dans les 20 bits bas, colonne (1..2047) au-dessus }
Function PosLine(Pos : LongInt) : LongInt;
Begin PosLine := Pos And $FFFFF; End;

Function PosCol(Pos : LongInt) : LongInt;
Begin PosCol := (Pos Shr 20) And $7FF; End;

Function MakePos(Line, Col : LongInt) : LongInt;
Begin
  If Col > 2047 Then Col := 2047;
  If Col < 0 Then Col := 0;
  MakePos := (Line And $FFFFF) Or (Col Shl 20);
End;

{ Affiche la ligne de source fautive (relue depuis le fichier) puis un curseur ^ a la colonne }
Procedure ShowSrcLine(Const Fn : String; Pos : LongInt);
Var F : Text; S, Pad : String; K, Line, Col, I : LongInt;
Begin
  Line := PosLine(Pos);
  Col := PosCol(Pos);
  If (Line <= 0) Or (Fn = '') Then Exit;
  Assign(F, Fn);
  Reset(F);
  If IOResult <> 0 Then Exit;
  K := 0;
  S := '';
  While (K < Line) And Not Eof(F) Do Begin
    ReadLn(F, S);
    Inc(K);
  End;
  Close(F);
  If K = Line Then Begin
    WriteLn(S);
    If Col > 0 Then Begin
      { un espace par caractere (les tabulations sont conservees, les suites UTF-8 comptent pour un) }
      Pad := '';
      For I := 1 To Col - 1 Do Begin
        If I > Length(S) Then Break;
        If S[I] = #9 Then Pad := Pad + #9
        Else If (Ord(S[I]) And $C0) <> $80 Then Pad := Pad + ' ';
      End;
      WriteLn(Pad, '^');
    End;
  End;
  If IOResult <> 0 Then ;
End;

Procedure ErrSummary;
Begin
  If ErrCount = 1 Then WriteLn('1 erreur') Else WriteLn(ErrCount, ' erreurs');
  If (OptMaxErrs > 0) And (ErrCount > OptMaxErrs) Then
    WriteLn('seules les ', OptMaxErrs, ' premieres erreurs sont affichees (-Xmaxerrs pour en afficher plus)');
End;

{ Diagnostics : affichage direct, ou mise en tampon (analyse lexicale et syntaxique d'un fichier) puis
  affichage trie par position }
Type
  TDiag = Record
    Pos  : LongInt;
    Msg  : String;
    IsWarn : Boolean;
    Show : Boolean;
    FileN : String;
  End;

Var
  DiagBuf : Array Of TDiag;
  NDiag   : LongInt;
  DiagBuffering : Boolean;

Procedure PrintDiag(Const Fn : String; Pos : LongInt; Const Msg : String; IsWarn : Boolean);
Var Kind : String;
Begin
  If IsWarn Then Kind := 'avertissement' Else Kind := 'erreur';
  If PosLine(Pos) > 0 Then Begin
    WriteLn(Fn, ':', PosLine(Pos), ': ', Kind, ': ', Msg);
    ShowSrcLine(Fn, Pos);
  End
  Else WriteLn(Fn, ': ', Kind, ': ', Msg);
End;

Procedure PostDiag(Pos : LongInt; Const Msg : String; IsWarn : Boolean; Show : Boolean);
Begin
  If Not Show Then Exit;
  If DiagBuffering Then Begin
    If NDiag >= Length(DiagBuf) Then SetLength(DiagBuf, NDiag * 2 + 16);
    DiagBuf[NDiag].Pos := Pos; DiagBuf[NDiag].Msg := Msg; DiagBuf[NDiag].IsWarn := IsWarn;
    DiagBuf[NDiag].FileN := CurFile;
    Inc(NDiag);
  End
  Else PrintDiag(CurFile, Pos, Msg, IsWarn);
End;

{ Affiche les diagnostics en tampon, tries par ligne puis colonne (tri stable) }
Procedure FlushDiags;
Var I, J : LongInt; T : TDiag;
Begin
  For I := 1 To NDiag - 1 Do Begin
    T := DiagBuf[I];
    J := I - 1;
    While (J >= 0) And ((PosLine(DiagBuf[J].Pos) > PosLine(T.Pos)) Or
          ((PosLine(DiagBuf[J].Pos) = PosLine(T.Pos)) And (PosCol(DiagBuf[J].Pos) > PosCol(T.Pos)))) Do Begin
      DiagBuf[J + 1] := DiagBuf[J];
      Dec(J);
    End;
    DiagBuf[J + 1] := T;
  End;
  For I := 0 To NDiag - 1 Do PrintDiag(DiagBuf[I].FileN, DiagBuf[I].Pos, DiagBuf[I].Msg, DiagBuf[I].IsWarn);
  NDiag := 0;
  DiagBuffering := False;
End;

Var LexErrLine : LongInt;     { ligne de la derniere erreur lexicale }

{ Erreurs et avertissements }
Procedure Err(Line : LongInt; Const Msg : String);
Begin
  Inc(ErrCount);
  PostDiag(Line, Msg, False, (OptMaxErrs <= 0) Or (ErrCount <= OptMaxErrs));
End;

Procedure Warn(Line : LongInt; Const Msg : String);
Begin
  Inc(WarnCount);
  PostDiag(Line, Msg, True, (OptMaxWarns <= 0) Or (WarnCount <= OptMaxWarns));
End;

{ Avertissements -Xlint : affiches si la categorie est active ; sinon, pour deprecation et unchecked,
  on retient le fichier pour la note finale "utilise une API obsolete" }
Var
  DeprFiles, UncFiles : Array Of String;
  NDeprFiles, NUncFiles : LongInt;
  OptNoWarn : Boolean;

Procedure NoteDeprFile(Const F : String);
Var I : LongInt;
Begin
  For I := 0 To NDeprFiles - 1 Do If DeprFiles[I] = F Then Exit;
  SetLength(DeprFiles, NDeprFiles + 1);
  DeprFiles[NDeprFiles] := F;
  Inc(NDeprFiles);
End;

Procedure NoteUncFile(Const F : String);
Var I : LongInt;
Begin
  For I := 0 To NUncFiles - 1 Do If UncFiles[I] = F Then Exit;
  SetLength(UncFiles, NUncFiles + 1);
  UncFiles[NUncFiles] := F;
  Inc(NUncFiles);
End;

Procedure LintWarn(Cat, Pos : LongInt; Const Tag, Msg : String);
Begin
  If (OptLint And Cat) <> 0 Then Warn(Pos, '[' + Tag + '] ' + Msg)
  Else If Cat = LINT_DEPRECATION Then NoteDeprFile(CurFile)
  Else If Cat = LINT_UNCHECKED Then NoteUncFile(CurFile);
End;

Procedure Fatal(Line : LongInt; Const Msg : String);
Begin
  Err(Line, Msg);
  FlushDiags;
  ErrSummary;
  Halt(1);
End;

Procedure Internal(Const Msg : String);
Begin
  WriteLn(CurFile, ': erreur interne: ', Msg);
  Halt(2);
End;

{ ============================================================================
  TABLE DE HACHAGE CHAINE -> ENTIER (internement)
  ============================================================================ }

Type
  TStrMap = Record
    Keys  : Array Of String;
    Vals  : Array Of LongInt;
    Nexts : Array Of LongInt;
    Heads : Array Of LongInt;
    Count : LongInt;
    HSize : LongInt;
  End;

Function StrHash(Const S : String) : LongInt;
Var I : LongInt; H : Int64;
Begin
  H := 5381;
  For I := 1 To Length(S) Do
    H := (H * 33 + Ord(S[I])) And $7FFFFFFF;
  StrHash := H;
End;

Procedure MapInit(Var M : TStrMap; HSize : LongInt);
Var I : LongInt;
Begin
  M.Count := 0;
  M.HSize := HSize;
  SetLength(M.Heads, HSize);
  For I := 0 To HSize - 1 Do M.Heads[I] := -1;
  SetLength(M.Keys, 0);
  SetLength(M.Vals, 0);
  SetLength(M.Nexts, 0);
End;

Function MapFind(Var M : TStrMap; Const K : String) : LongInt;
Var I : LongInt;
Begin
  MapFind := -1;
  If M.HSize = 0 Then Exit;
  I := M.Heads[StrHash(K) Mod M.HSize];
  While I >= 0 Do Begin
    If M.Keys[I] = K Then Begin MapFind := M.Vals[I]; Exit; End;
    I := M.Nexts[I];
  End;
End;

Procedure MapPut(Var M : TStrMap; Const K : String; V : LongInt);
Var H, I : LongInt;
Begin
  H := StrHash(K) Mod M.HSize;
  I := M.Heads[H];
  While I >= 0 Do Begin
    If M.Keys[I] = K Then Begin M.Vals[I] := V; Exit; End;
    I := M.Nexts[I];
  End;
  If M.Count >= Length(M.Keys) Then Begin
    SetLength(M.Keys, M.Count * 2 + 64);
    SetLength(M.Vals, M.Count * 2 + 64);
    SetLength(M.Nexts, M.Count * 2 + 64);
  End;
  M.Keys[M.Count] := K;
  M.Vals[M.Count] := V;
  M.Nexts[M.Count] := M.Heads[H];
  M.Heads[H] := M.Count;
  Inc(M.Count);
End;

{ ----- tampons d'octets ---------------------------------------------------- }

Type
  TBuf = Record
    D : Array Of Byte;
    N : LongInt;
  End;

Procedure BInit(Var B : TBuf);
Begin
  B.N := 0;
  If Length(B.D) = 0 Then SetLength(B.D, 256);
End;

Procedure BEnsure(Var B : TBuf; Extra : LongInt);
Begin
  If B.N + Extra > Length(B.D) Then SetLength(B.D, (B.N + Extra) * 2 + 64);
End;

Procedure B1(Var B : TBuf; V : LongInt);
Begin
  BEnsure(B, 1);
  B.D[B.N] := V And $FF;
  Inc(B.N);
End;

Procedure B2(Var B : TBuf; V : LongInt);
Begin
  BEnsure(B, 2);
  B.D[B.N] := (V Shr 8) And $FF;
  B.D[B.N + 1] := V And $FF;
  Inc(B.N, 2);
End;

Procedure B4(Var B : TBuf; V : Int64);
Begin
  BEnsure(B, 4);
  B.D[B.N] := (V Shr 24) And $FF;
  B.D[B.N + 1] := (V Shr 16) And $FF;
  B.D[B.N + 2] := (V Shr 8) And $FF;
  B.D[B.N + 3] := V And $FF;
  Inc(B.N, 4);
End;

Procedure B8(Var B : TBuf; V : Int64);
Begin
  B4(B, (V Shr 32) And $FFFFFFFF);
  B4(B, V And $FFFFFFFF);
End;

Procedure BStr(Var B : TBuf; Const S : String);
Var I : LongInt;
Begin
  BEnsure(B, Length(S));
  For I := 1 To Length(S) Do Begin
    B.D[B.N] := Ord(S[I]);
    Inc(B.N);
  End;
End;

Procedure BAppend(Var B : TBuf; Var Src : TBuf);
Var I : LongInt;
Begin
  BEnsure(B, Src.N);
  For I := 0 To Src.N - 1 Do B.D[B.N + I] := Src.D[I];
  Inc(B.N, Src.N);
End;

Procedure BPatch2(Var B : TBuf; Pos, V : LongInt);
Begin
  B.D[Pos] := (V Shr 8) And $FF;
  B.D[Pos + 1] := V And $FF;
End;

Procedure BPatch4(Var B : TBuf; Pos : LongInt; V : Int64);
Begin
  B.D[Pos] := (V Shr 24) And $FF;
  B.D[Pos + 1] := (V Shr 16) And $FF;
  B.D[Pos + 2] := (V Shr 8) And $FF;
  B.D[Pos + 3] := V And $FF;
End;

