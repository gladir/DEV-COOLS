Type
  TToken = Record
    Kind : Byte;
    Line : LongInt;
    Str  : String;
    Num  : Int64;
    Dbl  : Double;
    Aux  : LongInt;     { base du litteral entier, ou 1 si debordement decimal }
    Adj  : Boolean;     { jeton colle au suivant (pour les '>') }
    Col  : Integer;     { colonne (1 = premier octet de la ligne) }
    EndCol : Integer;   { colonne juste apres le jeton }
  End;

  TNode = Record
    Kind : Word;
    Line : LongInt;
    A, B, C, D, E, Next : LongInt;
    Mods : LongInt;
    Aux  : LongInt;
    N    : Int64;
    S    : String;
    Typ  : LongInt;
    Sym  : LongInt;
    Ann  : LongInt;     { annotations de la declaration (chaine de N_ANNOT) }
    Dflt : LongInt;     { valeur par defaut d'un element d'annotation }
    Att  : Byte;
    CK   : Byte;
    CI   : Int64;
    CD   : Double;
    CS   : String;
  End;

  TDblBits = Record
    Case Byte Of
      0 : (D : Double);
      1 : (I : Int64);
      2 : (S : Single; Dummy : LongInt);
      3 : (L : LongInt; H : LongInt);
  End;

Var
  { Etat global du compilateur }
