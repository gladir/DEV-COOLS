{ ============================================================================
  3. TYPES, SYMBOLES ET BIBLIOTHEQUE STANDARD
  ============================================================================ }

Const
  TY_NONE    = 0;     { erreur / inconnu }
  TY_VOID    = 1;
  TY_BOOLEAN = 2;
  TY_BYTE    = 3;
  TY_CHAR    = 4;
  TY_SHORT   = 5;
  TY_INT     = 6;
  TY_LONG    = 7;
  TY_FLOAT   = 8;
  TY_DOUBLE  = 9;
  TY_NULL    = 10;
  TY_FIRSTDYN = 11;

  TYK_PRIM  = 1;
  TYK_CLASS = 2;
  TYK_ARRAY = 3;
  TYK_TVAR  = 4;
  TYK_ANY   = 5;      { reference inconnue (inference incomplete) }
  TYK_WILD  = 6;      { joker ? / ? extends T / ? super T : uniquement comme argument de type (Cls = 0, 1, 2) }

  MAXTARGS = 4;

Type
  TTypeRec = Record
    Kind  : Byte;
    Cls   : LongInt;
    Elem  : LongInt;
    NArgs : LongInt;
    Args  : Array[0..MAXTARGS - 1] Of LongInt;
    TV    : LongInt;
    Outer : LongInt;     { type englobant parametre d'une classe interne (Outer<T>.Inner), ou 0 }
  End;

  TTVarRec = Record
    Name  : String;
    Bound : LongInt;
    Ty    : LongInt;
    Extra : Array Of LongInt;      { bornes supplementaires (T extends A & B & C) }
  End;

  TFieldRec = Record
    Name       : String;
    Owner      : LongInt;
    Flags      : LongInt;
    Typ        : LongInt;
    Next       : LongInt;
    CK         : Byte;
    CI         : Int64;
    CD         : Double;
    CS         : String;
    ConstState : Byte;     { 0 non evaluee, 1 en cours, 2 faite }
    Decl       : LongInt;  { noeud N_VARDECL }
    ConstInit  : LongInt;  { expression d'initialisation }
  End;

  TMethRec = Record
    Name    : String;
    Owner   : LongInt;
    Flags   : LongInt;
    NPar    : LongInt;
    Par     : Array Of LongInt;
    ParNames: Array Of String;
    Ret     : LongInt;
    TPar    : Array Of LongInt;
    Desc    : String;
    Next    : LongInt;
    Decl    : LongInt;
    Varargs : Boolean;
    Lambda  : LongInt;     { >= 0 si methode synthetique issue d'une lambda }
    Bridge  : LongInt;     { methode ciblee par un pont }
    Synth   : LongInt;     { genre de methode generee (0 = normale) }
    PreLoc  : Array Of LongInt;   { parametres synthetiques en tete }
    PostLoc : Array Of LongInt;   { parametres synthetiques en queue }
    BodyN   : LongInt;     { noeud du corps pour les methodes synthetiques }
    Thr     : Array Of LongInt;   { classes des exceptions declarees (throws) }
    ThrVar  : Array Of LongInt;   { en parallele : variable de type declaree dans throws (throws X), sinon 0 }
  End;

  TClassRec = Record
    Name, Simple : String;
    Flags        : LongInt;
    Super        : LongInt;
    Ifaces       : Array Of LongInt;
    Permits      : Array Of LongInt;   { classes permises (classe scellee), explicites ou deduites }
    PermitsState : Byte;               { 0 non calcule, 2 calcule }
    TPars        : Array Of LongInt;
    Outer        : LongInt;
    IsSrc        : Boolean;
    Loaded       : Byte;
    LibLine      : LongInt;
    FirstField, LastField, FirstMeth, LastMeth : LongInt;
    Decl         : LongInt;
    Nested       : Array Of LongInt;
    HdrState     : Byte;
    MemState     : Byte;
    IsInner      : Boolean;       { possede this$0 }
    InStatic     : Boolean;       { declaree dans un contexte statique }
    Caps         : Array Of LongInt;   { variables locales capturees }
    CapFields    : Array Of LongInt;   { champs val$x correspondants }
    ThisField    : LongInt;       { champ this$0 ou -1 }
    CU           : LongInt;
    AnonCount    : LongInt;
    LocalCount   : LongInt;
    TopClass     : LongInt;
    Ctx          : LongInt;       { contexte de declaration (classe locale) }
    EnumCount    : LongInt;
    HasAssert    : Boolean;
    Lowered      : Boolean;
    InnerList    : Array Of LongInt;   { classes imbriquees directes (pour InnerClasses) }
    NewSites     : Array Of LongInt;   { classes locales instanciees depuis ce contexte }
    ClsCtx       : LongInt;
    AnonCtor     : LongInt;
  End;

  TCURec = Record
    Pkg, FileName : String;
    Imports       : LongInt;
    Root          : LongInt;
    Explicit      : Boolean;      { donne sur la ligne de commande (sinon charge implicitement) }
    Preview       : Boolean;      { utilise une fonctionnalite en apercu }
    ModName       : String;       { module (mode --module-source-path), sinon vide }
  End;

Var
  NCPath   : LongInt;
  ExtMemo  : TStrMap;
  Types    : Array Of TTypeRec;
  NTypes   : LongInt;
  TypeMap  : TStrMap;
  TVars    : Array Of TTVarRec;
  NTVars   : LongInt;

  Classes  : Array Of TClassRec;
  NClasses : LongInt;
  ClassMap : TStrMap;
  LibIndex : TStrMap;
