BEGIN
  MODE P = STRUCT(INT x1, INT y1);
  INT x := 10;
  x := 42;
  INT z := 0;
  99 =: z;
  INT a := 5; INT b := 5;
  BOOL same := a IS b;
  BOOL diff := a ISNT b;
  REF INT p := NIL;
  BOOL isnil := p IS NIL;
  BOOL notnil := p ISNT NIL;
  p := a;
  BOOL isa := p IS a;
  INT viap := p;
  p := b;
  b := 77;
  INT viap3 := p;
  HEAP INT h := 31;
  INT hv := h;
  h := 32;
  INT hv2 := h;
  HEAP INT hh;
  INT hhv := hh;
  INT c := 10;
  c +:= 5;
  INT c1 := c;
  c -:= 2;
  INT c2 := c;
  c *:= 3;
  INT c3 := c;
  c /:= 2;
  INT c4 := c;
  c %:= 4;
  INT c5 := c;
  INT d := 17;
  d %*:= 5;
  REAL r := 1.5;
  r +:= 2;
  REAL r1 := r;
  r *:= 2;
  r -:= 1;
  REAL r2 := r;
  r /:= 4;
  REAL r3 := r;
  INT m := 0; INT n := 0;
  m := 100;
  n := m;
  INT q := 0; INT w := 0;
  w := q := 7;
  P pt := P(1, 2);
  y1 OF pt := 9;
  INT ptv := y1 OF pt;
  P pt2 := P(0, 0);
  pt2 := pt;
  INT p2y := y1 OF pt2;
  HEAP P hq := P(3, 4);
  INT hx := x1 OF hq;
  INT acc := 0;
  FOR i TO 10 DO acc +:= i OD;
  INT br := 0;
  IF acc > 50 THEN br := 1 ELSE br := 2 FI;
  INT cntw := 0;
  WHILE cntw < 7 DO cntw +:= 1 OD
END
