BEGIN
  [1:2,1:3] INT m := ((1, 2, 3), (4, 5, 6));
  [0:1,1:2,1:2] INT c := (((1, 2), (3, 4)), ((5, 6), (7, 8)));
  print((m[1,1], space, m[1,3], space, m[2,1], space, m[2,3], space, c[0,1,2], space, c[1,2,1], space, c[1,2,2], newline));
  [,] INT idr = ((10, 20), (30, 40));
  print((idr[2,1], space, 1 UPB idr, space, 2 UPB idr, newline));
  PROC s2 = ([,] INT t) INT : t[2, 2];
  print((s2(((1, 2), (3, 4))), newline))
END
