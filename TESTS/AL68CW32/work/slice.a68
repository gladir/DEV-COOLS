BEGIN
  BEGIN
  [1:3,1:4] INT m;
  FOR i FROM 1 TO 3 DO FOR j FROM 1 TO 4 DO m[i, j] := 10 * i + j OD OD;
  INT a := m[2, 3];
  INT b := m[2:3, 1][2];
  INT c := m[2, 2:4][3];
  INT d := m[1:2, 3:4][2, 1];
  INT e := UPB m[2:3, 2:4];
  INT f := 2 UPB m[2:3, 2:4];
  INT g := m[:, 2][3];
  INT h := UPB m[:, 2];
  [1:4] INT row := m[3, :];
  INT k := row[4];
  [3:5] INT z := (7, 8, 9);
  INT zz := z[3:4][2];
  print((a, space, b, space, c, space, d, space, e, space, f, space, g, space, h, space, k, space, zz, newline))
END;
  BEGIN
  [1:3,1:4] INT m;
  FOR i FROM 1 TO 3 DO FOR j FROM 1 TO 4 DO m[i, j] := 10 * i + j OD OD;
  [1:3] INT col := m[:, 2];
  print((col[1], space, col[2], space, col[3], newline));
  [1:2,1:2] INT sub := m[2:3, 3:4];
  print((sub[1,1], space, sub[1,2], space, sub[2,1], space, sub[2,2], newline));
  [1:3,1:4] INT cp := m;
  m[1,1] := 99;
  print((cp[1,1], space, cp[3,4], space, m[1,1], newline));
  [1:3] INT tgt;
  tgt := m[:, 4];
  print((tgt[1], space, tgt[2], space, tgt[3], newline))
  END
END
