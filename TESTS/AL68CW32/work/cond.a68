BEGIN
  INT c := 2;
  INT a := IF TRUE THEN 42 ELSE 0 FI;
  INT b := IF FALSE THEN 1 ELSE 99 FI;
  INT d := IF c = 1 THEN 10 ELIF c = 2 THEN 20 ELIF c = 3 THEN 30 ELSE 0 FI;
  INT e := 2;
  INT f := CASE e IN 10, 20, 30 ESAC;
  INT g := 9;
  INT h := CASE g IN 10, 20, 30 OUT 99 ESAC;
  BOOL p := TRUE;
  INT i := (p | 42 | 0);
  INT k := 2;
  INT l := (k | 10, 20, 30 | 0);
  INT m := 5;
  INT n := (m | 10, 20 | 99);
  INT o := 3;
  INT r := IF o > 2 THEN o * 10 ELSE o FI;
  INT s := 1; INT t := 2;
  INT u := CASE s IN 7 OUSE t IN 8, 9 ESAC;
  INT s2 := 2;
  INT u2 := CASE s2 IN 7 OUSE t IN 8, 9 ESAC;
  REAL x := IF p THEN 1 ELSE 2.5 FI;
  INT w := (p | 1 | 2) + 5;
  INT z := (NOT p | 1 |: p | 2 | 3)
END
