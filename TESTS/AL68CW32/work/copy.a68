BEGIN
  [1:5] INT g := (1, 2, 3, 4, 5);
  PROC mod = ([] INT a) INT : BEGIN INT s := 0; FOR i FROM LWB a TO UPB a DO s +:= a[i] OD; s END;
  INT s1 := mod(g);
  [1:2,1:3] INT m := ((1,2,3),(4,5,6));
  PROC tot = ([,] INT t) INT :
    BEGIN INT s := 0; FOR i FROM 1 TO 2 DO FOR j FROM 1 TO 3 DO s +:= t[i, j] * (10 * i + j) OD OD; s END;
  INT s2 := tot(m);
  INT s3 := mod(g[2:4]);
  INT s4 := mod(m[:, 2]);
  INT s5 := mod((7, 8, 9));
  print((s1, space, s2, space, s3, space, s4, space, s5, newline));
  STRING a := "abc";
  STRING b := a;
  b[1] := "X";
  STRING c = a;
  a[2] := "Y";
  print((a, space, b, space, c, newline));
  STRING lit := "hello";
  lit[1] := "J";
  STRING lit2 := "hello";
  print((lit, space, lit2, newline));
  CHAR ch := "z";
  STRING fromch := ch;
  ch := "q";
  print((fromch, newline))
END
