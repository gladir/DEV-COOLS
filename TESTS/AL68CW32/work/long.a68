BEGIN
  LONG INT a := 123456789012345;
  LONG INT b = 1000000007;
  print((a, space, b, newline));
  print((a + b, space, a - b, space, a * b, newline));
  print((a OVER b, space, a MOD b, newline));
  print((-a, space, ABS (-a), space, SIGN (-a), newline));
  LONG INT f := 1;
  FOR i TO 20 DO f := f * i OD;
  print((f, newline));
  print((a > b, a < b, a = a, a /= b, newline));
  INT s = SHORTEN (a OVER 1000000000000);
  print((s, space, a / b, newline));
  a +:= 5; a *:= 2;
  print((a, space, a + 1, space, 1 + a, newline));
  LONG INT p = LENG 2 ** 62;
  print((p, space, ODD p, newline));
  LONG INT q := -9000000000;
  print((q OVER 7, space, q MOD 7, space, q % 7, newline));
  LONG INT x, y;
  read((x, y));
  print((x + y, newline));
  [1:3] LONG INT arr := (1, 2, 3000000000);
  FOR i TO 3 DO arr[i] *:= arr[i] OD;
  print((arr, newline));
  STRUCT (INT n, LONG INT big, REAL r) st := (1, 99999999999, 2.5);
  print((st, newline));
  PROC fact2 = (LONG INT n) LONG INT : IF n < 2 THEN 1 ELSE n * fact2(n - 1) FI;
  print((fact2(25), newline));
  LONG REAL lr = 1.5;
  SHORT INT si = 7;
  LONG BITS lb = 16rFF;
  BITS bb = 16rF0F0 AND 16r0FF0;
  print((lr, space, si, space, lb, space, bb, newline));
  print((16rFFFFFFFF, space, 2r1010, space, 8r777, newline));
  UNION (INT, LONG INT) u := 5000000000;
  CASE u IN (LONG INT l): print(("long", l, newline)), (INT i): print(("int", i, newline)) ESAC;
  print((max int, space, long max int, space, int width, space, bits width, newline))
END
