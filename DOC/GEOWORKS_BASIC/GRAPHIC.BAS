10 @START: CLS
20 PRINT "GEOBASIC 2.0": PRINT
30 FOR X=1 TO 5: PRINT X, X*X: NEXT X
40 SETCOL 1+16*5
50 RECT 20,100,120,140
60 SETCOL 255: FRECT 140,100,260,140
70 SETCOL 1: LINE 10,160 TO 300,190
80 PATTERN 10: SETCOL 1+16*2: RECT 200,20,300,60
90 COLRECT 1,9,10,11
100 POINT 5,5: IF TESTPT(5,5) THEN PRINT "TESTPT OK"
110 DEF FNABC(X)=X*3: BB=FNABC(10): PRINT "FN=";BB
120 I=0: WHILE I<3: I=I+1: PRINT "W";I: LOOP
130 REPEAT: I=I-1: UNTIL I=0
140 SETPOS 8,180: PRINT "SETPOS ";I
150 ONERR @ERR
160 X=SQR(-1)
170 PRINT "not reached": END
180 @ERR: SYSINFO 6,E: PRINT "ERR=";E
190 END
