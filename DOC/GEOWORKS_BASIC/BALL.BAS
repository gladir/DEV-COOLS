10 REM Balle rebondissante avec PROCESS (interruption periodique)
20 CLS: X=160: Y=100: DX=4: DY=3
30 PRINT "BALL - click to quit"
40 PROCESS @MOVE,2
50 BUTTON @QUIT
60 MAINLOOP
70 END
100 @MOVE: SETCOL 16: RECT X-5,Y-5,X+5,Y+5
110 X=X+DX: Y=Y+DY
120 IF X<10 OR X>309 THEN DX=-DX
130 IF Y<20 OR Y>189 THEN DY=-DY
140 SETCOL 16*2: RECT X-5,Y-5,X+5,Y+5
150 RETURN
200 @QUIT: END
